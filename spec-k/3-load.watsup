;;
;; Loading a definition: the axioms that are executed
;;
;;

;;; KORE also holds what symbolic execution and proofs use: properties of
;;; symbols, simplification rules, ensures clauses. Loading takes from every
;;; axiom what its form and attributes give: a rewrite rule, an equation, a
;;; subsort, an overload; a property gives nothing. The rules, and the
;;; equations of each symbol, come out in the order they are tried, as the
;;; LLVM backend sorts them when it reads them (matching/Parser.scala). Simplifications and non-executable axioms are kept with their
;;; attributes and skipped where rules and equations are tried ($runs).

var KD : kdefinition
var SH : map<sortid, hookid>
var AM : map<symid, kalias>
var SK : map<varid, kore>
var EM : map<symid, (nat, clause)*>

;; Attributes

dec $attr_name(kattr) : text
def $attr_name(KATTR text sort* kore*) = text

dec $has_attr(text, kattr*) : bool
  hint(prose_in %1 "has the attribute" %0)
def $has_attr(text, kattr*) = text <- $attr_name(kattr)*

dec $attr_named(text, kattr*) : kattr?
  hint(prose_in "the attribute" %0 "of" %1)
def $attr_named(text, eps) = eps
def $attr_named(text, (KATTR text_h sort* kore*) :: kattr_t*)
  = KATTR text_h sort* kore*
  -- if text_h = text
def $attr_named(text, (KATTR text_h sort* kore*) :: kattr_t*)
  = $attr_named(text, kattr_t*)
  -- if text_h =/= text

;; Whether a clause is run: simplifications and non-executable axioms are for
;; symbolic execution and proofs (matching/Parser.scala)

dec $runs(kattr*) : bool
def $runs(kattr*)
  = ~$has_attr("simplification", kattr*) /\ ~$has_attr("non-executable", kattr*)

;; Priorities, as rulePriority in the LLVM backend's matching/Parser.scala
;; (a smaller number is tried first). cool and cool-like only occur on rewrite
;; rules and only count outside --search mode.

dec $priority(kattr*) : nat
  hint(prose_in "the priority given by" %0)
def $priority(kattr*) = 200
  -- if $has_attr("owise", kattr*)
def $priority(kattr*) = 150
  -- if ~$has_attr("owise", kattr*) /\ $has_attr("cool", kattr*)
def $priority(kattr*) = 100
  -- if ~$has_attr("owise", kattr*) /\ ~$has_attr("cool", kattr*)
  -- if $has_attr("cool-like", kattr*)
def $priority(kattr*) = n
  -- if ~$has_attr("owise", kattr*) /\ ~$has_attr("cool", kattr*)
  -- if ~$has_attr("cool-like", kattr*)
  -- if (KATTR "priority" sort* ([KSTR text])) = $attr_named("priority", kattr*)
  -- if i = $string_to_int(text)
  -- if n = $nat_of(i)
def $priority(kattr*) = 50
  -- otherwise

;; Stable sort by priority: for each priority, smallest first, the entries
;; with that priority in their order, which is the order of the KORE file, as
;; the LLVM backend sorts axioms stably by priority.

dec $if_priority<X>(nat, nat, X) : X*
def $if_priority<X>(n_p, n, X) = [ X ]
  -- if n = n_p
def $if_priority<X>(n_p, n, X) = eps
  -- otherwise

dec $by_priorities<X>(nat*, (nat, X)*) : X*
def $by_priorities<X>(eps, (n, X)*) = eps
def $by_priorities<X>(n_h :: n_t*, (n, X)*)
  = $concat_<X>($if_priority<X>(n_h, n, X)*) ++ $by_priorities<X>(n_t*, (n, X)*)

dec $sort_by_priority<X>((nat, X)*) : X*
  hint(prose_in %0 "in the order of their priorities")
def $sort_by_priority<X>((n, X)*) = $by_priorities<X>(n_p*, (n, X)*)
  -- if `{ n_p* `} = $union_set<nat>(`{ n* `}, `{ eps `})

;; Subsorts: the transitive closure of the subsort relation (kompile does not
;; always close it, as in LAMBDA)

var SM : map<sort, sort*>

dec $direct_supersorts(map<sort, sort*>, sort) : sort*
  hint(prose_in "the direct supersorts of" %1)
def $direct_supersorts(SM, sort) = sort_s*
  -- if (sort_s*) = $find_map<sort, sort*>(SM, sort)
def $direct_supersorts(SM, sort) = eps
  -- otherwise

dec $supersort_map(subsort*) : map<sort, sort*>
def $supersort_map(eps) = $empty_map<sort, sort*>
def $supersort_map((sort_a '<' sort_b) :: subsort_t*)
  = $update_map<sort, sort*>(SM, sort_a,
                             sort_b :: $direct_supersorts(SM, sort_a))
  -- if SM = $supersort_map(subsort_t*)

dec $reachable(map<sort, sort*>, sort*, sort*) : sort*
def $reachable(SM, eps, sort_s*) = sort_s*
def $reachable(SM, sort_h :: sort_t*, sort_s*)
  = $reachable(SM, sort_t*, sort_s*)
  -- if sort_h <- sort_s*
def $reachable(SM, sort_h :: sort_t*, sort_s*)
  = $reachable(SM, $direct_supersorts(SM, sort_h) ++ sort_t*,
               sort_s* ++ [ sort_h ])
  -- if ~(sort_h <- sort_s*)

dec $subsorts_from(map<sort, sort*>, sort) : subsort*
def $subsorts_from(SM, sort) = (sort '<' sort_u)*
  -- if sort_u* = $reachable(SM, $direct_supersorts(SM, sort), eps)

dec $close_subsorts(subsort*) : subsort*
  hint(prose_in "the transitive closure of" %0)
def $close_subsorts(subsort*) = $concat_<subsort>($subsorts_from(SM, sort_a)*)
  -- if SM = $supersort_map(subsort*)
  -- if `{ (sort_a ':' sort_b*)* `} = SM

;; Symbols

;; A hook comes before the equations of a function, as the LLVM backend calls
;; the hook

;; The hooks of K's modules of domain values (INT, BOOL, STRING, BYTES, FLOAT,
;; and the KRYPTO plugin) are computed by the K runtime (RUNTIME), but for
;; the lazy ones and the conversions between strings and tokens of any sort;
;; the hooks on K terms are specified (HOOKED)

dec $hook_module(hookid) : text
def $hook_module(hookid) = $string_substr(hookid, 0, i)
  -- if i = $string_find(hookid, ".", 0)
  -- if $(i >= 0)
def $hook_module(hookid) = hookid
  -- if $string_find(hookid, ".", 0) = -1

;; Hooks whose arguments are evaluated lazily (create_hardcoded_hook of the
;; LLVM backend); they are specified (6.2-eval)

dec $is_lazy(hookid) : bool
def $is_lazy(hookid) = hookid <- [ "BOOL.and", "BOOL.andThen", "BOOL.or",
                                   "BOOL.orElse", "BOOL.implies", "KEQUAL.ite" ]

dec $is_runtime(hookid) : bool
def $is_runtime(hookid)
  = $hook_module(hookid) <- [ "INT", "BOOL", "STRING", "BYTES", "FLOAT",
                              "KRYPTO" ]
    /\ ~$is_lazy(hookid)
    /\ ~(hookid <- [ "STRING.token2string", "STRING.string2token" ])

dec $kind_by_attrs(kattr*) : symkind
def $kind_by_attrs(kattr*) = RUNTIME hookid
  -- if (KATTR "hook" sort* ([KSTR hookid])) = $attr_named("hook", kattr*)
  -- if $is_runtime(hookid)
def $kind_by_attrs(kattr*) = HOOKED hookid
  -- if (KATTR "hook" sort* ([KSTR hookid])) = $attr_named("hook", kattr*)
  -- if ~$is_runtime(hookid)
def $kind_by_attrs(kattr*) = FUNCTION
  -- if ~$has_attr("hook", kattr*)
  -- if $has_attr("function", kattr*)
def $kind_by_attrs(kattr*) = ANYWHERE
  -- if ~$has_attr("hook", kattr*) /\ ~$has_attr("function", kattr*)
  -- if $has_attr("anywhere", kattr*)
def $kind_by_attrs(kattr*) = BINDER
  -- if ~$has_attr("hook", kattr*) /\ ~$has_attr("function", kattr*)
  -- if ~$has_attr("anywhere", kattr*) /\ $has_attr("binder", kattr*)
def $kind_by_attrs(kattr*) = CONSTRUCTOR
  -- if ~$has_attr("hook", kattr*) /\ ~$has_attr("function", kattr*)
  -- if ~$has_attr("anywhere", kattr*) /\ ~$has_attr("binder", kattr*)


dec $fresh_generator(symid, ksymdecl) : pair<sort, symid>*
def $fresh_generator(symid, KSYMBOL sortid_p* sort_a* '->' sort kattr*)
  = [ sort ':' symid ]
  -- if $has_attr("freshGenerator", kattr*)
def $fresh_generator(symid, ksymdecl) = eps
  -- otherwise

dec $fresh_generators(map<symid, ksymdecl>) : map<sort, symid>
def $fresh_generators(`{ (symid ':' ksymdecl)* `})
  = `{ $concat_<pair<sort, symid>>($fresh_generator(symid, ksymdecl)*) `}

;; Sorts: the hook of each hooked sort, e.g. "INT.Int" of SortInt

dec $sort_hook_entry(sortid, kattr*) : pair<sortid, hookid>*
def $sort_hook_entry(sortid, kattr*) = [ sortid ':' hookid ]
  -- if (KATTR "hook" sort* ([KSTR hookid])) = $attr_named("hook", kattr*)
def $sort_hook_entry(sortid, kattr*) = eps
  -- otherwise

dec $sort_hooks(map<sortid, kattr*>) : map<sortid, hookid>
def $sort_hooks(`{ (sortid ':' kattr*)* `})
  = `{ $concat_<pair<sortid, hookid>>($sort_hook_entry(sortid, kattr*)*) `}

dec $sort_hook(map<sortid, hookid>, sort) : text
def $sort_hook(SH, SORT sortid sort*) = hookid
  -- if hookid = $find_map<sortid, hookid>(SH, sortid)
def $sort_hook(SH, sort) = ""
  -- otherwise

dec $symdecls(map<symid, ksymdecl>) : map<symid, symdecl>
def $symdecls(`{ (symid ':' (KSYMBOL sortid_p* sort_a* '->' sort kattr*))* `})
  = `{ (symid ':' (SYMBOL sortid_p* sort_a* '->' sort $kind_by_attrs(kattr*)))* `}

;; Domain values \dv{S}("text"), by the hook of S; those of other sorts stay
;; text

dec $literal(text, sort, text) : pattern
def $literal("INT.Int", sort, text) = INT i
  -- if i = $string_to_int(text)
def $literal("BOOL.Bool", sort, "true") = BOOL true
def $literal("BOOL.Bool", sort, "false") = BOOL false
def $literal("STRING.String", sort, text) = STRING text
def $literal("FLOAT.Float", sort, text) = FLOAT text_f
  -- if text_f = $float_literal(text)
def $literal("BYTES.Bytes", sort, text) = BYTES $string_to_bytes(text)
def $literal("KVAR.KVar", sort, text) = DV sort text
def $literal("", sort, text) = DV sort text

;; Aliases: an application f(p1, ..., pn) of an alias f(X1, ..., Xn) := body
;; is body with Xi := pi, as Parser.scala expands them

dec $subst_kore(map<varid, kore>, kore) : kore
def $subst_kore(SK, KVAR varid sort) = kore
  -- if (kore) = $find_map<varid, kore>(SK, varid)
def $subst_kore(SK, KVAR varid sort) = KVAR varid sort
  -- if eps = $find_map<varid, kore>(SK, varid)
def $subst_kore(SK, KSETVAR varid sort) = kore
  -- if (kore) = $find_map<varid, kore>(SK, varid)
def $subst_kore(SK, KSETVAR varid sort) = KSETVAR varid sort
  -- if eps = $find_map<varid, kore>(SK, varid)
def $subst_kore(SK, KAPP symid sort* kore*) = KAPP symid sort* $subst_kore(SK, kore)*
def $subst_kore(SK, KML text sort* kore*) = KML text sort* $subst_kore(SK, kore)*
def $subst_kore(SK, KSTR text) = KSTR text

dec $expand_aliases(map<symid, kalias>, kore) : kore
def $expand_aliases(AM, KAPP symid sort* kore*)
  = $expand_aliases(AM, $subst_kore(`{ (varid ':' kore_e)* `}, kore_b))
  -- if (ALIAS varid* ':=' kore_b) = $find_map<symid, kalias>(AM, symid)
  -- if kore_e* = $expand_aliases(AM, kore)*
def $expand_aliases(AM, KAPP symid sort* kore*)
  = KAPP symid sort* $expand_aliases(AM, kore)*
  -- if eps = $find_map<symid, kalias>(AM, symid)
def $expand_aliases(AM, KML text sort* kore*)
  = KML text sort* $expand_aliases(AM, kore)*
def $expand_aliases(AM, kore) = kore
  -- otherwise

dec $expand_axiom(kdefinition, kaxiom) : kaxiom
def $expand_axiom(KD, AXIOM kore kattr*)
  = AXIOM $expand_aliases(KD.KALIASES, kore) kattr*

;; \left-assoc{}(f(a, b, c)) is f(f(a, b), c), \right-assoc{}(f(a, b, c)) is
;; f(a, f(b, c))

dec $left_assoc(symid, sort*, kore, kore*) : kore
def $left_assoc(symid, sort*, kore_a, eps) = kore_a
def $left_assoc(symid, sort*, kore_a, kore_h :: kore_t*)
  = $left_assoc(symid, sort*, KAPP symid sort* ([kore_a, kore_h]), kore_t*)

dec $right_assoc(symid, sort*, kore*) : kore
def $right_assoc(symid, sort*, eps) = KAPP symid sort* eps
def $right_assoc(symid, sort*, [ kore ]) = kore
def $right_assoc(symid, sort*, kore_h :: kore_t*)
  = KAPP symid sort* ([kore_h, $right_assoc(symid, sort*, kore_t*)])
  -- if $(|kore_t*| > 0)

;; Patterns of rules, equations, the initial term, and the K runtime's answers
;; (6.2-eval), by the hooks of the sorts. A variable named Var'Bang... is a
;; fresh variable !X of a function equation.

dec $pattern(map<sortid, hookid>, kore) : pattern
  hint(prose_in "the pattern" %1 "stands for")
def $pattern(SH, KVAR varid sort) = FRESH sort
  -- if $string_find(varid, "Var'Bang", 0) = 0
def $pattern(SH, KVAR varid sort) = VAR varid sort
  -- if $string_find(varid, "Var'Bang", 0) =/= 0
def $pattern(SH, KML "dv" ([sort]) ([KSTR text]))
  = $literal($sort_hook(SH, sort), sort, text)
def $pattern(SH, KAPP symid sort* kore*) = APP symid sort* $pattern(SH, kore)*
def $pattern(SH, KML "and" ([sort]) ([kore_1, kore_2]))
  = AND sort $pattern(SH, kore_1) $pattern(SH, kore_2)
def $pattern(SH, KML "or" ([sort]) ([kore_1, kore_2]))
  = OR sort $pattern(SH, kore_1) $pattern(SH, kore_2)
;; a longer \or is read from the right
def $pattern(SH, KML "or" ([sort]) (kore_h :: kore_t*))
  = OR sort $pattern(SH, kore_h) $pattern(SH, KML "or" ([sort]) kore_t*)
  -- if $(|kore_t*| > 1)
def $pattern(SH, KML "left-assoc" eps ([KAPP symid sort* (kore_h :: kore_t*)]))
  = $pattern(SH, $left_assoc(symid, sort*, kore_h, kore_t*))
def $pattern(SH, KML "right-assoc" eps ([KAPP symid sort* kore*]))
  = $pattern(SH, $right_assoc(symid, sort*, kore*))

;; Conditions: the predicates of a rule or an equation

dec $is_predicate(kore) : bool
def $is_predicate(KML "and" sort* kore*) = $forall_($is_predicate(kore)*)
def $is_predicate(KML text sort* kore*) = true
  -- if text <- [ "top", "not", "in", "ceil", "equals" ]
def $is_predicate(kore) = false
  -- otherwise

syntax condition =
  | REQUIRES kore         ;; the requires clause
  | ARGUMENT varid kore   ;; the argument X of an equation has this pattern

;; The requires clause is \equals(c, true); \in(X, p) gives the pattern of an
;; equation's argument X. The \not kompile adds to owise ones is dropped, as
;; Parser.scala: they are tried last by priority instead.

dec $conditions(kore) : condition*
def $conditions(KML "top" sort* eps) = eps
def $conditions(KML "not" sort* kore*) = eps
def $conditions(KML "equals" sort* ([kore_c, KML "dv" sort_b* ([KSTR "true"])]))
  = [ REQUIRES kore_c ]
def $conditions(KML "in" sort* ([KVAR varid sort_x, kore_p]))
  = [ ARGUMENT varid kore_p ]
def $conditions(KML "and" sort* kore*)
  = $concat_<condition>($conditions(kore)*)

dec $requires_of(condition) : kore*
def $requires_of(REQUIRES kore) = [ kore ]
def $requires_of(ARGUMENT varid kore) = eps

dec $requires(map<sortid, hookid>, condition*) : pattern?
  hint(prose_in "the requires clause of" %1)
def $requires(SH, condition*) = eps
  -- if eps = $concat_<kore>($requires_of(condition)*)
def $requires(SH, condition*) = $pattern(SH, kore)
  -- if [ kore ] = $concat_<kore>($requires_of(condition)*)

dec $argument_pattern(condition, kore) : kore*
def $argument_pattern(ARGUMENT varid_c kore_p, KVAR varid sort) = [ kore_p ]
  -- if varid_c = varid
def $argument_pattern(condition, kore) = eps
  -- otherwise

dec $argument(condition*, kore) : kore
def $argument(condition*, kore) = kore
  -- if eps = $concat_<kore>($argument_pattern(condition, kore)*)
def $argument(condition*, kore) = kore_p
  -- if kore_p :: kore_t* = $concat_<kore>($argument_pattern(condition, kore)*)

dec $arguments(map<sortid, hookid>, condition*, kore*) : pattern*
def $arguments(SH, condition*, eps) = eps
def $arguments(SH, condition*, kore_h :: kore_t*)
  = $pattern(SH, $argument(condition*, kore_h))
    :: $arguments(SH, condition*, kore_t*)

;; A side of a rule, \and(pattern, predicate) in either order: on the left,
;; the predicate holds the requires clause; on the right, the ensures clause.

dec $split_side(kore) : (kore, kore*)
def $split_side(KML "and" sort* ([kore_1, kore_2])) = (kore_1, [ kore_2 ])
  -- if ~$is_predicate(kore_1) /\ $is_predicate(kore_2)
def $split_side(KML "and" sort* ([kore_1, kore_2])) = (kore_2, [ kore_1 ])
  -- if $is_predicate(kore_1) /\ ~$is_predicate(kore_2)
def $split_side(kore) = (kore, eps)
  -- otherwise

dec $side_conditions(kore*) : condition*
def $side_conditions(kore*) = $concat_<condition>($conditions(kore)*)

;; The ensures clause is not used, as in the LLVM backend

dec $without_ensures(kore) : kore
def $without_ensures(kore) = kore_p
  -- if (kore_p, kore_e*) = $split_side(kore)

;; A rewrite rule: \rewrites(\and(lhs, requires), \and(rhs, ensures)), a
;; clause with the one left-hand side

dec $rule(map<sortid, hookid>, kore, kore) : clause
def $rule(SH, kore_l, kore_r)
  = CLAUSE ([ $pattern(SH, kore_p) ]) '=>' $pattern(SH, $without_ensures(kore_r))
      'requires' $requires(SH, $side_conditions(kore_c*))
  -- if (kore_p, kore_c*) = $split_side(kore_l)

;; An equation f(args) = rhs under conditions, a clause with a left-hand side
;; per argument. Those of a hooked symbol are kept too, and not used: the hook
;; computes it (6.2-eval).

dec $equation(map<sortid, hookid>, kore*, kore, kore) : clause
def $equation(SH, kore_a*, kore_c, kore_r)
  = CLAUSE $arguments(SH, condition*, kore_a*)
      '=>' $pattern(SH, $without_ensures(kore_r))
      'requires' $requires(SH, condition*)
  -- if condition* = $conditions(kore_c)

;; What an axiom gives to each part of the definition, by its form and its
;; attributes. Other axioms are properties, which are not used to run; so are
;; the clauses that are not run. Clauses come with their priority.

;;; a rewrite rule

dec $rule_of(map<sortid, hookid>, kaxiom) : (nat, clause)*
def $rule_of(SH, AXIOM (KML "rewrites" sort* ([kore_l, kore_r])) kattr*)
  = [ ($priority(kattr*), $rule(SH, kore_l, kore_r)) ]
  -- if $runs(kattr*)
def $rule_of(SH, kaxiom) = eps
  -- otherwise

;;; an equation \implies(conditions, \equals(f(args), rhs)) or
;;; \equals(f(args), rhs), with the symbol f it defines; an overload axiom is
;;; one of the more general symbol

dec $equation_of(map<sortid, hookid>, kaxiom) : (symid, (nat, clause))*
def $equation_of(SH,
    AXIOM (KML "implies" sort*
      ([kore_c, KML "equals" sort_e* ([KAPP symid sort_f* kore_a*, kore_r])]))
    kattr*)
  = [ (symid, ($priority(kattr*), $equation(SH, kore_a*, kore_c, kore_r))) ]
  -- if $runs(kattr*)
def $equation_of(SH,
    AXIOM (KML "equals" sort_e* ([KAPP symid sort_f* kore_a*, kore_r])) kattr*)
  = [ (symid, ($priority(kattr*),
               $equation(SH, kore_a*, KML "top" eps eps, kore_r))) ]
  -- if $runs(kattr*)
def $equation_of(SH, kaxiom) = eps
  -- otherwise

;;; a subsort, from the subsort attribute

dec $subsort_of(kaxiom) : subsort*
def $subsort_of(AXIOM kore kattr*) = [ sort_1 '<' sort_2 ]
  -- if (KATTR "subsort" ([sort_1, sort_2]) kore_s*)
       = $attr_named("subsort", kattr*)
def $subsort_of(kaxiom) = eps
  -- otherwise

;;; an overload, from the symbol-overload attribute

dec $overload_of(kaxiom) : overload*
def $overload_of(AXIOM kore kattr*) = [ symid_f '>' symid_g ]
  -- if (KATTR "symbol-overload" sort*
         ([KAPP symid_f sort_f* kore_f*, KAPP symid_g sort_g* kore_g*]))
       = $attr_named("symbol-overload", kattr*)
def $overload_of(kaxiom) = eps
  -- otherwise

;; Equations grouped by the symbol they define, in file order, and then each
;; group in the order of its priorities

dec $group_equations(map<symid, (nat, clause)*>, (symid, (nat, clause))*)
  : map<symid, (nat, clause)*>
def $group_equations(EM, eps) = EM
def $group_equations(EM, (symid, (n, clause)) :: (symid_t, (n_t, clause_t))*)
  = $group_equations(
      $add_map<symid, (nat, clause)*>(EM, symid, (n_e, clause_e)* ++ [ (n, clause) ]),
      (symid_t, (n_t, clause_t))*)
  -- if (n_e, clause_e)*
       = $deopt_<(nat, clause)*>($find_map<symid, (nat, clause)*>(EM, symid), eps)

dec $sorted_groups(map<symid, (nat, clause)*>) : map<symid, clause*>
def $sorted_groups(`{ (symid ':' (n, clause)*)* `})
  = `{ (symid ':' $sort_by_priority<clause>((n, clause)*))* `}

rule Load:
  KD ~> { SYMBOLS $symdecls(KD.KSYMBOLS),
          SORTHOOKS SH,
          SUBSORTS $close_subsorts($concat_<subsort>($subsort_of(kaxiom)*)),
          OVERLOADS $concat_<overload>($overload_of(kaxiom)*),
          RULES $sort_by_priority<clause>(
                  $concat_<(nat, clause)>($rule_of(SH, kaxiom)*)),
          EQUATIONS $sorted_groups($group_equations(
                      $empty_map<symid, (nat, clause)*>,
                      $concat_<(symid, (nat, clause))>($equation_of(SH, kaxiom)*))),
          FRESH $fresh_generators(KD.KSYMBOLS) }
  -- if SH = $sort_hooks(KD.KSORTS)
  -- if kaxiom_a* = KD.AXIOMS
  -- if kaxiom* = $expand_axiom(KD, kaxiom_a)*
