;;
;; Matching a pattern against a term
;;
;;

;;; As the LLVM backend's decision trees. A pattern that picks an element out
;;; of a collection may match in several ways; $match gives them all, in order.

var D : definition
var kind : symkind
var M : map<term, term>
var S : set<term>

syntax subst = map<varid, term>

;; Definition lookups

dec $find_symdecl(definition, symid) : symdecl?
  hint(prose_in "the declaration of symbol" %1)
def $find_symdecl(D, symid) = $find_map<symid, symdecl>(D.SYMBOLS, symid)

dec $kind_of(symdecl?) : symkind?
def $kind_of(eps) = eps
def $kind_of(sort_a* '->' sort kind) = kind

dec $hook_of_kind(symkind?) : hookid?
def $hook_of_kind(HOOKED hookid) = hookid
def $hook_of_kind(kind?) = eps
  -- otherwise

dec $hook_of(definition, symid) : hookid?
  hint(prose_in "the hook of symbol" %1)
def $hook_of(D, symid) = $hook_of_kind($kind_of($find_symdecl(D, symid)))

;; Subsorting: D.SUBSORTS, which $krun closes transitively before running
;; (kompile does not always, as in LAMBDA)

dec $is_subsort(definition, sort, sort) : bool
  hint(prose_true %1 "is a subsort of" %2)
def $is_subsort(D, sort_1, sort_2) = (sort_1 '<' sort_2) <- D.SUBSORTS

;; Transitive closure of a subsort relation (the relation is acyclic)

var SM : map<sort, sort*>

dec $direct_supersorts(map<sort, sort*>, sort) : sort*
  hint(prose_in "the direct supersorts of" %1)
def $direct_supersorts(SM, sort) = sort_s*
  -- if (sort_s*) = $find_map<sort, sort*>(SM, sort)
def $direct_supersorts(SM, sort) = eps
  -- otherwise

dec $supersort_map(subsort*) : map<sort, sort*>
def $supersort_map(eps) = $empty_map<sort, sort*>
def $supersort_map((sort_a '<' sort_b) :: subsort_t*)
  = $update_map<sort, sort*>(SM, sort_a,
                             sort_b :: $direct_supersorts(SM, sort_a))
  -- if SM = $supersort_map(subsort_t*)

dec $reachable(map<sort, sort*>, sort*, sort*) : sort*
def $reachable(SM, eps, sort_s*) = sort_s*
def $reachable(SM, sort_h :: sort_t*, sort_s*)
  = $reachable(SM, sort_t*, sort_s*)
  -- if sort_h <- sort_s*
def $reachable(SM, sort_h :: sort_t*, sort_s*)
  = $reachable(SM, $direct_supersorts(SM, sort_h) ++ sort_t*,
               sort_s* ++ [ sort_h ])
  -- if ~(sort_h <- sort_s*)

dec $subsorts_from(map<sort, sort*>, sort) : subsort*
def $subsorts_from(SM, sort) = (sort '<' sort_u)*
  -- if sort_u* = $reachable(SM, $direct_supersorts(SM, sort), eps)

dec $close_subsorts(subsort*) : subsort*
  hint(prose_in "the transitive closure of" %0)
def $close_subsorts(subsort*) = $concat_<subsort>($subsorts_from(SM, sort_a)*)
  -- if SM = $supersort_map(subsort*)
  -- if `{ (sort_a ':' sort_b*)* `} = SM

;; Equality of terms, as KEQUAL.eq: structural, except that maps and sets are
;; compared as sets of entries

dec $term_eq(term, term) : bool
dec $terms_eq(term*, term*) : bool
def $term_eq(APP symid sort* term*, APP symid' sort'* term'*)
  = symid = symid' /\ sort* = sort'* /\ $terms_eq(term*, term'*)
def $term_eq(MAP sort M, MAP sort' M')
  = sort = sort' /\ $eq_set<pair<term, term>>(M, M')
def $term_eq(SET sort S, SET sort' S') = sort = sort' /\ $eq_set<term>(S, S')
def $term_eq(LIST sort term*, LIST sort' term'*)
  = sort = sort' /\ $terms_eq(term*, term'*)
def $term_eq(RANGEMAP sort (RANGE i_s i_e term)*,
             RANGEMAP sort' (RANGE i_s' i_e' term')*)
  = sort = sort' /\ i_s* = i_s'* /\ i_e* = i_e'* /\ $terms_eq(term*, term'*)
def $term_eq(term_1, term_2) = term_1 = term_2
  -- otherwise
def $terms_eq(eps, eps) = true
def $terms_eq(term_h :: term_t*, term_h' :: term_t'*)
  = $term_eq(term_h, term_h') /\ $terms_eq(term_t*, term_t'*)
def $terms_eq(term*, term'*) = false
  -- otherwise

;; Building constructor terms: nested injections are composed,
;; inj{B,C}(inj{A,B}(t)) = inj{A,C}(t)

dec $construct(symid, sort*, term*) : term
def $construct("inj", ([sort_b, sort_c]),
               ([APP "inj" ([sort_a, sort_b']) ([term])]))
  = APP "inj" ([sort_a, sort_c]) ([term])
  -- if sort_b = sort_b'
def $construct(symid, sort*, term*) = APP symid sort* term*
  -- otherwise

;; Keys of map patterns and elements of set patterns are evaluated when their
;; variables are bound (e.g. #ContextLookup(IDS, I) |-> ADDR in KWasm);
;; otherwise the entries are tried in turn. The rules of Eval are in 4-eval.

relation Eval:
  definition subst |- pattern : res<term>
  hint(input %0 %1 %2)
  hint(prose_in "evaluating" %2 "under" %1)
  hint(prose_out %3)

var result : res<term>

;; Collection patterns: flattened into element patterns and at most one other
;; pattern, usually a variable, for the remaining elements

dec $collection_of_hook(hookid) : text?
dec $collection_of(definition, pattern) : text?
  hint(prose_in "the collection that" %1 "is built with")
def $collection_of(D, APP symid sort* pattern*) = $collection_of_hook(hookid)
  -- if hookid = $hook_of(D, symid)
def $collection_of(D, pattern) = eps
  -- otherwise

def $collection_of_hook("MAP.concat") = "MAP"
def $collection_of_hook("MAP.element") = "MAP"
def $collection_of_hook("MAP.unit") = "MAP"
def $collection_of_hook("SET.concat") = "SET"
def $collection_of_hook("SET.element") = "SET"
def $collection_of_hook("SET.unit") = "SET"
def $collection_of_hook("LIST.concat") = "LIST"
def $collection_of_hook("LIST.element") = "LIST"
def $collection_of_hook("LIST.unit") = "LIST"
def $collection_of_hook(hookid) = eps
  -- otherwise

dec $parts(definition, text, pattern) : pattern*
def $parts(D, t_c, APP symid sort* ([pattern_1, pattern_2]))
  = $parts(D, t_c, pattern_1) ++ $parts(D, t_c, pattern_2)
  -- if $hook_of(D, symid) = t_c ++ ".concat"
def $parts(D, t_c, APP symid sort* eps) = eps
  -- if $hook_of(D, symid) = t_c ++ ".unit"
def $parts(D, t_c, pattern) = [ pattern ]
  -- otherwise

dec $is_element(definition, text, pattern) : bool
def $is_element(D, t_c, APP symid sort* pattern*)
  = $hook_of(D, symid) = t_c ++ ".element"
def $is_element(D, t_c, pattern) = false
  -- otherwise

dec $elements(definition, text, pattern*) : pattern*
def $elements(D, t_c, eps) = eps
def $elements(D, t_c, pattern_h :: pattern_t*)
  = pattern_h :: $elements(D, t_c, pattern_t*)
  -- if $is_element(D, t_c, pattern_h)
def $elements(D, t_c, pattern_h :: pattern_t*) = $elements(D, t_c, pattern_t*)
  -- if ~$is_element(D, t_c, pattern_h)

dec $others(definition, text, pattern*) : pattern*
def $others(D, t_c, eps) = eps
def $others(D, t_c, pattern_h :: pattern_t*) = $others(D, t_c, pattern_t*)
  -- if $is_element(D, t_c, pattern_h)
def $others(D, t_c, pattern_h :: pattern_t*)
  = pattern_h :: $others(D, t_c, pattern_t*)
  -- if ~$is_element(D, t_c, pattern_h)

;; Injecting terms of the first sorts into the second sorts, where they differ

dec $coerce_all(sort*, sort*, term*) : term*
def $coerce_all(eps, eps, eps) = eps
def $coerce_all(sort_t :: sort_tt*, sort_p :: sort_pt*, term_h :: term_t*)
  = term_h :: $coerce_all(sort_tt*, sort_pt*, term_t*)
  -- if sort_t = sort_p
def $coerce_all(sort_t :: sort_tt*, sort_p :: sort_pt*, term_h :: term_t*)
  = $construct("inj", ([sort_t, sort_p]),
               ([term_h])) :: $coerce_all(sort_tt*, sort_pt*, term_t*)
  -- if sort_t =/= sort_p

;; An integer as a natural number, when it is not negative (hooks fail on a
;; negative length, index, or shift amount)

dec $nat_of(int) : nat?
def $nat_of(i) = n
  -- if i <: nat
  -- if n = i
def $nat_of(i) = eps
  -- otherwise

;; The element of a list at an index; a negative index counts from the end,
;; as in hook_LIST_get_null

dec $list_at(term*, int) : term?
def $list_at(term*, i) = term*[n]
  -- if n = $nat_of(i)
  -- if $(n < |term*|)
def $list_at(term*, i) = term*[n]
  -- if $(i < 0)
  -- if n = $nat_of($(|term*| + i))
def $list_at(term*, i) = eps
  -- otherwise

;; Matching: the ways a pattern matches a term, extending a substitution, in
;; the order the LLVM backend tries them

relation Match:
  definition subst |- pattern ~~ term : subst*
  hint(input %0 %1 %2 %3)
  hint(prose_in "the ways" %2 "matches" %3 "extending" %1)
  hint(prose_out %4)

relation Match_list:
  definition subst |- pattern* ~~ term* : subst*
  hint(input %0 %1 %2 %3)
  hint(prose_in "the ways" %2 "match" %3 "extending" %1)
  hint(prose_out %4)

relation Match_rest:
  definition subst |- pattern* ~~ term : subst*
  hint(input %0 %1 %2 %3)
  hint(prose_in "the ways the other parts" %2 "match what is left," %3)
  hint(prose_out %4)

relation Match_map:
  definition subst |- pattern* pattern* ~~ sort map<term, term> : subst*
  hint(input %0 %1 %2 %3 %4 %5)
  hint(prose_in "the ways the entries" %2 "and the other parts" %3 "match the map" %5)
  hint(prose_out %6)

relation Choose_map:
  definition subst |- pattern pattern pattern* pattern* ~~ sort map<term, term> (term, term)* : subst*
  hint(input %0 %1 %2 %3 %4 %5 %6 %7 %8)
  hint(prose_in "the ways the entry" %2 "|->" %3 "matches one of" %8)
  hint(prose_out %9)

relation Match_set:
  definition subst |- pattern* pattern* ~~ sort set<term> : subst*
  hint(input %0 %1 %2 %3 %4 %5)
  hint(prose_in "the ways the elements" %2 "and the other parts" %3 "match the set" %5)
  hint(prose_out %6)

relation Choose_set:
  definition subst |- pattern pattern* pattern* ~~ sort set<term> term* : subst*
  hint(input %0 %1 %2 %3 %4 %5 %6 %7)
  hint(prose_in "the ways the element" %2 "matches one of" %7)
  hint(prose_out %8)

relation Match_seq:
  definition subst |- pattern* ~~ sort term* : subst*
  hint(input %0 %1 %2 %3 %4)
  hint(prose_in "the ways" %2 "match the list" %4)
  hint(prose_out %5)

;;; Variables bind the term, or must agree with an earlier binding

rule Match/bind:
  D subst |- VAR varid sort ~~ term : [ $add_map<varid, term>(subst, varid, term) ]
  -- if eps = $find_map<varid, term>(subst, varid)

rule Match/bound:
  D subst |- VAR varid sort ~~ term : [ subst ]
  -- if term' = $find_map<varid, term>(subst, varid)
  -- if $term_eq(term', term)

;;; As-patterns: the term matches both sides

rule Match/and:
  D subst |- AND sort pattern_1 pattern_2 ~~ term : $concat_<subst>(subst_2**)
  -- Match: D subst |- pattern_1 ~~ term : subst_1*
  -- (Match: D subst_1 |- pattern_2 ~~ term : subst_2*)*

;;; Or-patterns: the ways the left side matches, then those of the right side,
;;; as the LLVM backend expands them into one row each (expandOr in
;;; matching/pattern/Pattern.scala)

rule Match/or:
  D subst |- OR sort pattern_1 pattern_2 ~~ term : subst_1* ++ subst_2*
  -- Match: D subst |- pattern_1 ~~ term : subst_1*
  -- Match: D subst |- pattern_2 ~~ term : subst_2*

;;; Domain values

rule Match/token:
  D subst |- DV sort t ~~ DV sort' t' : [ subst ]
  -- if sort = sort' /\ t = t'

rule Match/integer:
  D subst |- INT i ~~ INT i' : [ subst ]
  -- if i = i'

rule Match/boolean:
  D subst |- BOOL b ~~ BOOL b' : [ subst ]
  -- if b = b'

rule Match/string:
  D subst |- STRING t ~~ STRING t' : [ subst ]
  -- if t = t'

rule Match/float:
  D subst |- FLOAT t ~~ FLOAT t' : [ subst ]
  -- if t = t'

rule Match/bytes:
  D subst |- BYTES n* ~~ BYTES n'* : [ subst ]
  -- if n* = n'*

rule Match/mint:
  D subst |- MINT n_w n_v ~~ MINT n_w' n_v' : [ subst ]
  -- if n_w = n_w' /\ n_v = n_v'

;;; Injections into the same sort from a smaller sort:
;;; inj{A,C}(p) matches inj{B,C}(t) with B < A by matching p against inj{B,A}(t)

rule Match/injection:
  D subst |- APP "inj" ([sort_a, sort_c]) ([pattern]) ~~ APP "inj" ([sort_b, sort_c']) ([term]) : subst'*
  -- if sort_c = sort_c' /\ sort_a =/= sort_b
  -- if $is_subsort(D, sort_b, sort_a)
  -- Match: D subst |- pattern ~~ APP "inj" ([sort_b, sort_a]) ([term]) : subst'*

;;; Symbol applications with the same symbol and sort arguments

rule Match/application:
  D subst |- APP symid sort_p* pattern* ~~ APP symid' sort_t* term* : subst'*
  -- if symid = symid' /\ sort_p* = sort_t*
  -- Match_list: D subst |- pattern* ~~ term* : subst'*

;;; Overloads: f(p1, ..., pn) matches inj{B,S}(g(t1, ..., tn)) when g is a
;;; more specific overload of f, injecting each ti as needed (isValidOverload)

rule Match/overload:
  D subst |- APP symid_f sort_p* pattern* ~~ APP "inj" ([sort_b, sort_s]) ([APP symid_g sort_t* term*]) : subst'*
  -- if (symid_f '>' symid_g) <- D.OVERLOADS
  -- if (sort_f* '->' sort_rf kind_f) = $find_symdecl(D, symid_f)
  -- if (sort_g* '->' sort_rg kind_g) = $find_symdecl(D, symid_g)
  -- if sort_rf = sort_s /\ sort_rg = sort_b
  -- Match_list: D subst |- pattern* ~~ $coerce_all(sort_g*, sort_f*, term*) : subst'*

;;; Collection patterns against collection values

rule Match/map:
  D subst |- pattern ~~ MAP sort M : subst'*
  -- if "MAP" = $collection_of(D, pattern)
  -- if pattern_p* = $parts(D, "MAP", pattern)
  -- Match_map: D subst |- $elements(D, "MAP", pattern_p*) $others(D, "MAP", pattern_p*) ~~ sort M : subst'*

rule Match/set:
  D subst |- pattern ~~ SET sort S : subst'*
  -- if "SET" = $collection_of(D, pattern)
  -- if pattern_p* = $parts(D, "SET", pattern)
  -- Match_set: D subst |- $elements(D, "SET", pattern_p*) $others(D, "SET", pattern_p*) ~~ sort S : subst'*

rule Match/list:
  D subst |- pattern ~~ LIST sort term* : subst'*
  -- if "LIST" = $collection_of(D, pattern)
  -- Match_seq: D subst |- $parts(D, "LIST", pattern) ~~ sort term* : subst'*

;;; L[I <- V] on the left is a lookup: the element at index I, which must
;;; evaluate, matches V, and L matches the whole list (ListGetP in the LLVM
;;; backend's matching/Generator.scala; hook_LIST_get_null finds the element)

rule Match/list-update:
  D subst |- APP symid sort_p* ([pattern_f, pattern_k, pattern_v]) ~~ LIST sort term* : $concat_<subst>(subst_f**)
  -- if $hook_of(D, symid) = "LIST.update"
  -- Eval: D subst |- pattern_k : OK (INT i)
  -- if term_e = $list_at(term*, i)
  -- Match: D subst |- pattern_v ~~ term_e : subst_v*
  -- (Match: D subst_v |- pattern_f ~~ LIST sort term* : subst_f*)*

;;; Anything else fails

rule Match/fail:
  D subst |- pattern ~~ term : eps
  -- otherwise

;;; Arguments, left to right

rule Match_list/nil:
  D subst |- eps ~~ eps : [ subst ]

rule Match_list/cons:
  D subst |- (pattern_h :: pattern_t*) ~~ (term_h :: term_t*) : $concat_<subst>(subst_t**)
  -- Match: D subst |- pattern_h ~~ term_h : subst_h*
  -- (Match_list: D subst_h |- pattern_t* ~~ term_t* : subst_t*)*

rule Match_list/fail:
  D subst |- pattern* ~~ term* : eps
  -- otherwise

;;; The parts other than elements match what is left: nothing, or one pattern

rule Match_rest/empty-map:
  D subst |- eps ~~ MAP sort `{ eps `} : [ subst ]

rule Match_rest/empty-set:
  D subst |- eps ~~ SET sort `{ eps `} : [ subst ]

rule Match_rest/one:
  D subst |- ([ pattern ]) ~~ term : subst'*
  -- Match: D subst |- pattern ~~ term : subst'*

rule Match_rest/fail:
  D subst |- pattern* ~~ term : eps
  -- otherwise

;;; Maps: an element whose key evaluates is looked up; otherwise each entry
;;; is tried in turn

rule Match_map/rest:
  D subst |- eps pattern_o* ~~ sort M : subst'*
  -- Match_rest: D subst |- pattern_o* ~~ MAP sort M : subst'*

rule Match_map/lookup:
  D subst |- (APP symid sort_e* ([pattern_k, pattern_v]) :: pattern_e*) pattern_o* ~~ sort M : $concat_<subst>(subst_r**)
  -- Eval: D subst |- pattern_k : OK term_k
  -- if term_v = $find_map<term, term>(M, term_k)
  -- Match: D subst |- pattern_v ~~ term_v : subst_v*
  -- (Match_map: D subst_v |- pattern_e* pattern_o* ~~ sort $diff_set<pair<term, term>>(M, `{ term_k ':' term_v `}) : subst_r*)*

rule Match_map/absent:
  D subst |- (APP symid sort_e* ([pattern_k, pattern_v]) :: pattern_e*) pattern_o* ~~ sort M : eps
  -- Eval: D subst |- pattern_k : OK term_k
  -- if eps = $find_map<term, term>(M, term_k)

rule Match_map/choose:
  D subst |- (APP symid sort_e* ([pattern_k, pattern_v]) :: pattern_e*) pattern_o* ~~ sort `{ (term_k ':' term_v)* `} : subst'*
  -- Eval: D subst |- pattern_k : FAIL
  -- Choose_map: D subst |- pattern_k pattern_v pattern_e* pattern_o* ~~ sort `{ (term_k ':' term_v)* `} (term_k, term_v)* : subst'*

rule Choose_map/none:
  D subst |- pattern_k pattern_v pattern_e* pattern_o* ~~ sort M eps : eps

rule Choose_map/entry:
  D subst |- pattern_k pattern_v pattern_e* pattern_o* ~~ sort M ((term_k, term_v) :: (term_k', term_v')*) : $concat_<subst>(subst_r**) ++ subst_t*
  -- Match: D subst |- pattern_k ~~ term_k : subst_k*
  -- (Match: D subst_k |- pattern_v ~~ term_v : subst_v*)*
  -- if subst_kv* = $concat_<subst>(subst_v**)
  -- (Match_map: D subst_kv |- pattern_e* pattern_o* ~~ sort $diff_set<pair<term, term>>(M, `{ term_k ':' term_v `}) : subst_r*)*
  -- Choose_map: D subst |- pattern_k pattern_v pattern_e* pattern_o* ~~ sort M (term_k', term_v')* : subst_t*

;;; Sets: an element that evaluates is checked for membership; otherwise each
;;; element is tried in turn

rule Match_set/rest:
  D subst |- eps pattern_o* ~~ sort S : subst'*
  -- Match_rest: D subst |- pattern_o* ~~ SET sort S : subst'*

rule Match_set/member:
  D subst |- (APP symid sort_e* ([pattern]) :: pattern_e*) pattern_o* ~~ sort `{ term_s* `} : subst'*
  -- Eval: D subst |- pattern : OK term
  -- if term <- term_s*
  -- Match_set: D subst |- pattern_e* pattern_o* ~~ sort $diff_set<term>(`{ term_s* `}, `{ term `}) : subst'*

rule Match_set/absent:
  D subst |- (APP symid sort_e* ([pattern]) :: pattern_e*) pattern_o* ~~ sort `{ term_s* `} : eps
  -- Eval: D subst |- pattern : OK term
  -- if ~(term <- term_s*)

rule Match_set/choose:
  D subst |- (APP symid sort_e* ([pattern]) :: pattern_e*) pattern_o* ~~ sort `{ term_s* `} : subst'*
  -- Eval: D subst |- pattern : FAIL
  -- Choose_set: D subst |- pattern pattern_e* pattern_o* ~~ sort `{ term_s* `} term_s* : subst'*

rule Choose_set/none:
  D subst |- pattern pattern_e* pattern_o* ~~ sort S eps : eps

rule Choose_set/element:
  D subst |- pattern pattern_e* pattern_o* ~~ sort S (term_h :: term_t*) : $concat_<subst>(subst_r**) ++ subst_t*
  -- Match: D subst |- pattern ~~ term_h : subst_h*
  -- (Match_set: D subst_h |- pattern_e* pattern_o* ~~ sort $diff_set<term>(S, `{ term_h `}) : subst_r*)*
  -- Choose_set: D subst |- pattern pattern_e* pattern_o* ~~ sort S term_t* : subst_t*

;;; Lists: elements before the other part match the front, elements after it
;;; match the back, and the other part matches the list in between

rule Match_seq/end:
  D subst |- eps ~~ sort eps : [ subst ]

rule Match_seq/longer:
  D subst |- eps ~~ sort (term_h :: term_t*) : eps

rule Match_seq/element:
  D subst |- (APP symid sort_e* ([pattern]) :: pattern_t*) ~~ sort (term_h :: term_t*) : $concat_<subst>(subst_r**)
  -- if $hook_of(D, symid) = "LIST.element"
  -- Match: D subst |- pattern ~~ term_h : subst_h*
  -- (Match_seq: D subst_h |- pattern_t* ~~ sort term_t* : subst_r*)*

rule Match_seq/shorter:
  D subst |- (APP symid sort_e* ([pattern]) :: pattern_t*) ~~ sort eps : eps
  -- if $hook_of(D, symid) = "LIST.element"

rule Match_seq/middle:
  D subst |- (pattern_o :: pattern_t*) ~~ sort term* : $concat_<subst>(subst_r**)
  -- if ~$is_element(D, "LIST", pattern_o)
  -- if $(|term*| >= |pattern_t*|)
  -- if n_m = $(|term*| - |pattern_t*|)
  -- Match: D subst |- pattern_o ~~ LIST sort term*[0 : n_m] : subst_o*
  -- (Match_seq: D subst_o |- pattern_t* ~~ sort term*[n_m : |pattern_t*|] : subst_r*)*

rule Match_seq/too-short:
  D subst |- (pattern_o :: pattern_t*) ~~ sort term* : eps
  -- if ~$is_element(D, "LIST", pattern_o)
  -- if $(|term*| < |pattern_t*|)
