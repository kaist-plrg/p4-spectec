;;
;; Evaluation: building a term from a pattern and a substitution
;;
;;

;;; As create_term of the LLVM backend: bottom-up, evaluating each function
;;; symbol as soon as its term is built

var eqn : equation

;; Priorities, as rulePriority in the LLVM backend's matching/Parser.scala
;; (a smaller number is tried first). cool and cool-like only occur on rewrite
;; rules and only count outside --search mode.

dec $is_priority(attr) : bool
def $is_priority(PRIORITY n) = true
def $is_priority(attr) = false
  -- otherwise

dec $priority_value(attr*) : nat?
def $priority_value(eps) = eps
def $priority_value((PRIORITY n) :: attr_t*) = n
def $priority_value(attr_h :: attr_t*) = $priority_value(attr_t*)
  -- if ~$is_priority(attr_h)

dec $priority(attr*) : nat
  hint(prose_in "the priority given by" %0)
def $priority(attr*) = 200
  -- if OWISE <- attr*
def $priority(attr*) = 150
  -- if ~(OWISE <- attr*) /\ COOL <- attr*
def $priority(attr*) = 100
  -- if ~(OWISE <- attr*) /\ ~(COOL <- attr*) /\ COOLLIKE <- attr*
def $priority(attr*) = n
  -- if ~(OWISE <- attr*) /\ ~(COOL <- attr*) /\ ~(COOLLIKE <- attr*)
  -- if n = $priority_value(attr*)
def $priority(attr*) = 50
  -- otherwise

;; Stable sort by priority: for each priority, smallest first, the entries
;; with that priority in their order, which is the order of the KORE file, as
;; the LLVM backend sorts axioms stably by priority.

dec $if_priority<X>(nat, nat, X) : X*
def $if_priority<X>(n_p, n, X) = [ X ]
  -- if n = n_p
def $if_priority<X>(n_p, n, X) = eps
  -- otherwise

dec $by_priorities<X>(nat*, (nat, X)*) : X*
def $by_priorities<X>(eps, (n, X)*) = eps
def $by_priorities<X>(n_h :: n_t*, (n, X)*)
  = $concat_<X>($if_priority<X>(n_h, n, X)*) ++ $by_priorities<X>(n_t*, (n, X)*)

dec $sort_by_priority<X>((nat, X)*) : X*
def $sort_by_priority<X>((n, X)*) = $by_priorities<X>(n_p*, (n, X)*)
  -- if `{ n_p* `} = $union_set<nat>(`{ n* `}, `{ eps `})

;; Equations of a function symbol, in the order they are tried. The definition
;; groups equations by the symbol they define, in file order; $krun orders each
;; group by priority once (6-entry).

dec $prioritized(equation*) : (nat, equation)*
def $prioritized(eps) = eps
def $prioritized(
    (EQN symid pattern_a* '=' pattern_r 'requires' pattern_c? attr*) :: eqn_t*)
  = ($priority(attr*),
     EQN symid pattern_a* '=' pattern_r 'requires' pattern_c? attr*)
    :: $prioritized(eqn_t*)

dec $sorted_equations(map<symid, equation*>) : map<symid, equation*>
def $sorted_equations(`{ (symid ':' eqn*)* `})
  = `{ (symid ':' $sort_by_priority<equation>($prioritized(eqn*)))* `}

dec $equations_of(definition, symid) : equation*
  hint(prose_in "the equations of" %1 "in priority order")
def $equations_of(D, symid) = eqn*
  -- if (eqn*) = $find_map<symid, equation*>(D.EQUATIONS, symid)
def $equations_of(D, symid) = eps
  -- otherwise

;; Symbol lookups

dec $kind_of_symbol(definition, symid) : symkind?
def $kind_of_symbol(D, symid) = $kind_of($find_symdecl(D, symid))

dec $sort_of_decl(symdecl?) : sort?
def $sort_of_decl(eps) = eps
def $sort_of_decl(sort_a* '->' sort kind) = sort

dec $result_sort(definition, symid) : sort?
  hint(prose_in "the result sort of" %1)
def $result_sort(D, symid) = $sort_of_decl($find_symdecl(D, symid))

;; The result sort of an application of a parametric symbol, with its sort
;; parameters replaced by the sort arguments, e.g. MInt{Sort8} for
;; Int2MInt{Sort8}; hooks of MInt read the width from it

dec $lookup_param(sortid*, sort*, sortid) : sort?
def $lookup_param(sortid_h :: sortid_t*, sort_h :: sort_t*, sortid) = sort_h
  -- if sortid_h = sortid
def $lookup_param(sortid_h :: sortid_t*, sort_h :: sort_t*, sortid)
  = $lookup_param(sortid_t*, sort_t*, sortid)
  -- if sortid_h =/= sortid
def $lookup_param(sortid_p*, sort_a*, sortid) = eps
  -- otherwise

dec $sort_instance(sortid*, sort*, sort) : sort
def $sort_instance(sortid_p*, sort_a*, SORTVAR sortid) = sort
  -- if sort = $lookup_param(sortid_p*, sort_a*, sortid)
def $sort_instance(sortid_p*, sort_a*, SORT sortid sort_s*)
  = SORT sortid $sort_instance(sortid_p*, sort_a*, sort_s)*
def $sort_instance(sortid_p*, sort_a*, sort) = sort
  -- otherwise

dec $result_instance(definition, symid, sort*) : sort?
  hint(prose_in "the result sort of" %1 "applied with sorts" %2)
def $result_instance(D, symid, sort_a*)
  = $sort_instance(sortid_p*, sort_a*, sort_r)
  -- if sort_r = $result_sort(D, symid)
  -- if (sortid_p*) = $find_map<symid, sortid*>(D.PARAMS, symid)
def $result_instance(D, symid, sort_a*) = $result_sort(D, symid)
  -- if eps = $find_map<symid, sortid*>(D.PARAMS, symid)

;; Hooks whose arguments are evaluated lazily (create_hardcoded_hook): the
;; hook of the symbol, or "" for any other symbol

dec $lazy_hook(definition, symid) : text
def $lazy_hook(D, symid) = hookid
  -- if hookid = $hook_of(D, symid)
  -- if hookid <- [ "BOOL.and", "BOOL.andThen", "BOOL.or", "BOOL.orElse",
                   "BOOL.implies", "KEQUAL.ite" ]
def $lazy_hook(D, symid) = ""
  -- otherwise

;; Evaluation

relation Equation:
  definition |- equation* term* : res<(subst, pattern)>
  hint(input %0 %1 %2)
  hint(prose_in "the first of the equations" %1 "that applies to" %2)
  hint(prose_out %3)

relation Equation_applies:
  definition |- equation term* : res<subst>
  hint(input %0 %1 %2)
  hint(prose_in "the way" %1 "applies to" %2)
  hint(prose_out %3)

relation First_holding:
  definition |- subst* pattern? : res<subst>
  hint(input %0 %1 %2)
  hint(prose_in "the first of" %1 "under which" %2 "holds")
  hint(prose_out %3)

relation Holds:
  definition subst |- pattern?
  hint(input %0 %1 %2)
  hint(prose_true %2 "holds under" %1)
  hint(prose_false %2 "does not hold under" %1)

var found : res<(subst, pattern)>
var matched : res<subst>

dec $rhs_of(equation) : pattern
def $rhs_of(EQN symid pattern_a* '=' pattern_r 'requires' pattern_c? attr*)
  = pattern_r

;;; Variables and domain values

rule Eval/variable:
  D subst |- VAR varid sort : OK term
  -- if term = $find_map<varid, term>(subst, varid)

rule Eval/token:
  D subst |- DV sort t : OK (DV sort t)

rule Eval/integer:
  D subst |- INT i : OK (INT i)

rule Eval/boolean:
  D subst |- BOOL b : OK (BOOL b)

rule Eval/string:
  D subst |- STRING t : OK (STRING t)

rule Eval/float:
  D subst |- FLOAT t : OK (FLOAT t)

rule Eval/bytes:
  D subst |- BYTES n* : OK (BYTES n*)

rule Eval/mint:
  D subst |- MINT n_w n_v : OK (MINT n_w n_v)

;;; Lazy hooks: the second argument is evaluated only when the first does not
;;; decide

rule Eval/and-false:
  D subst |- APP symid sort* ([pattern_1, pattern_2]) : OK (BOOL false)
  -- if t = $lazy_hook(D, symid)
  -- if t = "BOOL.and" \/ t = "BOOL.andThen"
  -- Eval: D subst |- pattern_1 : OK (BOOL false)

rule Eval/or-true:
  D subst |- APP symid sort* ([pattern_1, pattern_2]) : OK (BOOL true)
  -- if t = $lazy_hook(D, symid)
  -- if t = "BOOL.or" \/ t = "BOOL.orElse"
  -- Eval: D subst |- pattern_1 : OK (BOOL true)

rule Eval/implies-true:
  D subst |- APP symid sort* ([pattern_1, pattern_2]) : OK (BOOL true)
  -- if t = $lazy_hook(D, symid)
  -- if t = "BOOL.implies"
  -- Eval: D subst |- pattern_1 : OK (BOOL false)

rule Eval/and-second:
  D subst |- APP symid sort* ([pattern_1, pattern_2]) : result
  -- if t = $lazy_hook(D, symid)
  -- if t = "BOOL.and" \/ t = "BOOL.andThen" \/ t = "BOOL.implies"
  -- Eval: D subst |- pattern_1 : OK (BOOL true)
  -- Eval: D subst |- pattern_2 : result

rule Eval/or-second:
  D subst |- APP symid sort* ([pattern_1, pattern_2]) : result
  -- if t = $lazy_hook(D, symid)
  -- if t = "BOOL.or" \/ t = "BOOL.orElse"
  -- Eval: D subst |- pattern_1 : OK (BOOL false)
  -- Eval: D subst |- pattern_2 : result

rule Eval/ite-then:
  D subst |- APP symid sort* ([pattern_c, pattern_t, pattern_e]) : result
  -- if "KEQUAL.ite" = $lazy_hook(D, symid)
  -- Eval: D subst |- pattern_c : OK (BOOL true)
  -- Eval: D subst |- pattern_t : result

rule Eval/ite-else:
  D subst |- APP symid sort* ([pattern_c, pattern_t, pattern_e]) : result
  -- if "KEQUAL.ite" = $lazy_hook(D, symid)
  -- Eval: D subst |- pattern_c : OK (BOOL false)
  -- Eval: D subst |- pattern_e : result

;;; Other symbols: arguments first, left to right, then the symbol

rule Eval/app:
  D subst |- APP symid sort* pattern* : result
  -- if "" = $lazy_hook(D, symid)
  -- (Eval: D subst |- pattern : OK term)*
  -- Apply: D |- symid sort* term* : result

;;; Anything else (an unbound variable, \and outside a left-hand side, a
;;; failing argument) fails

rule Eval/fail:
  D subst |- pattern : FAIL
  -- otherwise

;;; A symbol applied to evaluated arguments, by its kind

rule Apply/constructor:
  D |- symid sort* term* : OK $construct(symid, sort*, term*)
  -- if CONSTRUCTOR = $kind_of_symbol(D, symid)

rule Apply/binder:
  D |- symid sort* term* : OK $construct(symid, sort*, term*)
  -- if BINDER = $kind_of_symbol(D, symid)

rule Apply/hooked:
  D |- symid sort* term* : $hook(D, hookid, sort_r, term*)
  -- if HOOKED hookid = $kind_of_symbol(D, symid)
  -- if sort_r = $result_instance(D, symid, sort*)

;;; A function symbol is rewritten by its first equation that applies.
;;; Failing to evaluate the right-hand side does not fall back to later
;;; equations.

rule Apply/function:
  D |- symid sort* term* : result
  -- if FUNCTION = $kind_of_symbol(D, symid)
  -- Equation: D |- $equations_of(D, symid) term* : OK (subst, pattern_r)
  -- Eval: D subst |- pattern_r : result

;;; An anywhere symbol is rewritten by its first equation that applies, and
;;; stays a constructor when none does

rule Apply/anywhere:
  D |- symid sort* term* : result
  -- if ANYWHERE = $kind_of_symbol(D, symid)
  -- Equation: D |- $equations_of(D, symid) term* : OK (subst, pattern_r)
  -- Eval: D subst |- pattern_r : result

rule Apply/anywhere-none:
  D |- symid sort* term* : OK $construct(symid, sort*, term*)
  -- if ANYWHERE = $kind_of_symbol(D, symid)
  -- Equation: D |- $equations_of(D, symid) term* : FAIL

rule Apply/fail:
  D |- symid sort* term* : FAIL
  -- otherwise

;;; The first equation, in priority order, that applies to the arguments: its
;;; left-hand sides match them and its requires clause holds. It gives the
;;; substitution and the right-hand side.

rule Equation/none:
  D |- eps term* : FAIL

rule Equation/first:
  D |- (eqn_h :: eqn_t*) term* : OK (subst, $rhs_of(eqn_h))
  -- Equation_applies: D |- eqn_h term* : OK subst

rule Equation/next:
  D |- (eqn_h :: eqn_t*) term* : found
  -- Equation_applies: D |- eqn_h term* : FAIL
  -- Equation: D |- eqn_t* term* : found

rule Equation_applies:
  D |- (EQN symid pattern_a* '=' pattern_r 'requires' pattern_c? attr*) term* : matched
  -- First_holding: D |- $match_list(D, $empty_map<varid, term>, pattern_a*, term*) pattern_c? : matched

;;; Among the ways a left-hand side matches, in order, the first one under
;;; which the requires clause holds

rule First_holding/none:
  D |- eps pattern_c? : FAIL

rule First_holding/first:
  D |- (subst_h :: subst_t*) pattern_c? : OK subst_h
  -- Holds: D subst_h |- pattern_c?

rule First_holding/next:
  D |- (subst_h :: subst_t*) pattern_c? : matched
  -- Holds:/ D subst_h |- pattern_c?
  -- First_holding: D |- subst_t* pattern_c? : matched

;;; A requires clause holds when there is none, or it evaluates to true

rule Holds/none:
  D subst |- eps

rule Holds/true:
  D subst |- (pattern)
  -- Eval: D subst |- pattern : OK (BOOL true)
