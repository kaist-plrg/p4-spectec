;;
;; One rewrite step on the whole configuration
;;
;;

;;; The rewrite rules are clauses with one left-hand side, the configuration.
;;; A step tries them in the order they are loaded, by priority (6-load): the
;;; first rule that applies rewrites the configuration. Once a rule applies,
;;; failing to build its right-hand side is an error and does not fall back to
;;; later rules; so is a requires clause that cannot be evaluated. UNMATCH when
;;; no rule applies.

relation Step:
  definition |- term : applies<term>
  hint(input %0 %1)
  hint(prose_in "a rewrite step of" %1)
  hint(prose_out %2)

rule Step/rewrite:
  D |- term : OK term'
  -- First_clause: D |- D.RULES ([ term ]) : OK (subst, pattern_r)
  -- Eval: D subst |- pattern_r : OK term'

rule Step/error:
  D |- term : ERROR
  -- First_clause: D |- D.RULES ([ term ]) : OK (subst, pattern_r)
  -- Eval: D subst |- pattern_r : ERROR

rule Step/stuck:
  D |- term : UNMATCH
  -- First_clause: D |- D.RULES ([ term ]) : UNMATCH

rule Step/undefined:
  D |- term : ERROR
  -- First_clause: D |- D.RULES ([ term ]) : ERROR
