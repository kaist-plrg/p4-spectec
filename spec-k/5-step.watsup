;;
;; One rewrite step on the whole configuration
;;
;;

;;; Rules apply to the whole configuration, tried in priority order

syntax stepres =
  | STEP term   ;; the next configuration
  | STUCK       ;; no rule applies
  | ERROR       ;; a rule's requires clause or right-hand side cannot be
                ;; evaluated

dec $rule_with_priority(krule) : (nat, krule)*
def $rule_with_priority(
    RULE pattern_l '=>' pattern_r 'requires' pattern_c? attr*)
  = [ ($priority(attr*),
       RULE pattern_l '=>' pattern_r 'requires' pattern_c? attr*) ]
  -- if $runs(attr*)
def $rule_with_priority(
    RULE pattern_l '=>' pattern_r 'requires' pattern_c? attr*) = eps
  -- if ~$runs(attr*)

dec $rules_in_order(definition) : krule*
  hint(prose_in "the rewrite rules of" %0 "in the order they are tried")
def $rules_in_order(D)
  = $sort_by_priority<krule>($concat_<(nat, krule)>($rule_with_priority(krule)*))
  -- if krule* = D.RULES

relation Rule_applies:
  definition |- krule term : applies<subst>
  hint(input %0 %1 %2)
  hint(prose_in "the way" %1 "applies to" %2)
  hint(prose_out %3)

rule Rule_applies:
  D |- (RULE pattern_l '=>' pattern_r 'requires' pattern_c? attr*) term : matched
  -- Match: D (OK $empty_map<varid, term>) |- pattern_l ~~ term : way*
  -- First_holding: D |- way* pattern_c? : matched

dec $rhs_of_rule(krule) : pattern
def $rhs_of_rule(RULE pattern_l '=>' pattern_r 'requires' pattern_c? attr*)
  = pattern_r

dec $lhs_of_rule(krule) : pattern
def $lhs_of_rule(RULE pattern_l '=>' pattern_r 'requires' pattern_c? attr*)
  = pattern_l

;; A step tries the rules in order: the first rule whose left-hand side
;; matches and whose requires clause holds rewrites the configuration. Once a
;; rule applies, failing to build its right-hand side is an error and does not
;; fall back to later rules; so is a requires clause that cannot be evaluated.

relation Step:
  definition |- term krule* ~> stepres
  hint(input %0 %1 %2)
  hint(prose_in "a rewrite step of" %1 "by the rules" %2)
  hint(prose_out %3)

rule Step/stuck:
  D |- term eps ~> STUCK

rule Step/rewrite:
  D |- term (krule_h :: krule_t*) ~> STEP term'
  -- Rule_applies: D |- krule_h term : APPLIES subst
  -- Eval: D subst |- $rhs_of_rule(krule_h) : OK term'

rule Step/error:
  D |- term (krule_h :: krule_t*) ~> ERROR
  -- Rule_applies: D |- krule_h term : APPLIES subst
  -- Eval: D subst |- $rhs_of_rule(krule_h) : FAIL

rule Step/undefined:
  D |- term (krule_h :: krule_t*) ~> ERROR
  -- Rule_applies: D |- krule_h term : UNDEFINED

rule Step/next:
  D |- term (krule_h :: krule_t*) ~> stepres
  -- Rule_applies: D |- krule_h term : SKIPS
  -- Step: D |- term krule_t* ~> stepres
