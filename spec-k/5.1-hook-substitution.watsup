;;
;; Substitution of K variables (hook SUBSTITUTION)
;;

;;; Variables are domain values of the KVar sort sort_x

dec $is_binder(definition, symid) : bool
def $is_binder(D, symid) = true
  -- if (SYMBOL sortid_p* sort_a* '->' sort BINDER) = $find_symdecl(D, symid)
def $is_binder(D, symid) = false
  -- otherwise

dec $remove_text(text*, text) : text*
def $remove_text(eps, t) = eps
def $remove_text(t_h :: t_t*, t) = $remove_text(t_t*, t)
  -- if t_h = t
def $remove_text(t_h :: t_t*, t) = t_h :: $remove_text(t_t*, t)
  -- if t_h =/= t

;; The variables of sort sort_x free in a term: a binder hides its own

dec $free_vars(definition, sort, term) : text*
def $free_vars(D, sort_x, DV sort t) = [ t ]
  -- if sort = sort_x
def $free_vars(D, sort_x, APP symid sort* (DV sort_y t_y :: term*))
  = $remove_text($concat_<text>($free_vars(D, sort_x, term)*), t_y)
  -- if $is_binder(D, symid)
def $free_vars(D, sort_x, APP symid sort* term*)
  = $concat_<text>($free_vars(D, sort_x, term)*)
  -- if ~$is_binder(D, symid)
def $free_vars(D, sort_x, LIST sort term*)
  = $concat_<text>($free_vars(D, sort_x, term)*)
def $free_vars(D, sort_x, SET sort `{ term* `})
  = $concat_<text>($free_vars(D, sort_x, term)*)
def $free_vars(D, sort_x, MAP sort `{ (term_k ':' term_v)* `})
  = $concat_<text>($free_vars(D, sort_x, term_v)*)
def $free_vars(D, sort_x, term) = eps
  -- otherwise

;; The variables of sort sort_x in a term, free or bound: a binder adds its own

dec $all_vars(definition, sort, term) : text*
def $all_vars(D, sort_x, DV sort t) = [ t ]
  -- if sort = sort_x
def $all_vars(D, sort_x, APP symid sort* (DV sort_y t_y :: term*))
  = t_y :: $concat_<text>($all_vars(D, sort_x, term)*)
  -- if $is_binder(D, symid)
def $all_vars(D, sort_x, APP symid sort* term*)
  = $concat_<text>($all_vars(D, sort_x, term)*)
  -- if ~$is_binder(D, symid)
def $all_vars(D, sort_x, LIST sort term*)
  = $concat_<text>($all_vars(D, sort_x, term)*)
def $all_vars(D, sort_x, SET sort `{ term* `})
  = $concat_<text>($all_vars(D, sort_x, term)*)
def $all_vars(D, sort_x, MAP sort `{ (term_k ':' term_v)* `})
  = $concat_<text>($all_vars(D, sort_x, term_v)*)
def $all_vars(D, sort_x, term) = eps
  -- otherwise

;; A variable name not among the given ones, made by adding primes

dec $fresh_var(text, text*) : text
def $fresh_var(t, t_a*) = t ++ "'"
  -- if ~((t ++ "'") <- t_a*)
def $fresh_var(t, t_a*) = $fresh_var(t ++ "'", t_a*)
  -- if (t ++ "'") <- t_a*

;; Renaming the free occurrences of a variable

dec $rename(definition, sort, text, text, term) : term
def $rename(D, sort_x, t, t', DV sort t_o) = DV sort t'
  -- if sort = sort_x /\ t_o = t
def $rename(D, sort_x, t, t', DV sort t_o) = DV sort t_o
  -- if ~(sort = sort_x /\ t_o = t)
def $rename(D, sort_x, t, t', APP symid sort* (DV sort_y t_y :: term*))
  = APP symid sort* (DV sort_y t_y :: term*)
  -- if $is_binder(D, symid) /\ t_y = t
def $rename(D, sort_x, t, t', APP symid sort* (DV sort_y t_y :: term*))
  = APP symid sort* (DV sort_y t_y :: $rename(D, sort_x, t, t', term)*)
  -- if $is_binder(D, symid) /\ t_y =/= t
def $rename(D, sort_x, t, t', APP symid sort* term*)
  = APP symid sort* $rename(D, sort_x, t, t', term)*
  -- if ~$is_binder(D, symid)
def $rename(D, sort_x, t, t', LIST sort term*)
  = LIST sort $rename(D, sort_x, t, t', term)*
def $rename(D, sort_x, t, t', SET sort `{ term* `})
  = SET sort $sorted_set<term>(`{ $rename(D, sort_x, t, t', term)* `})
def $rename(D, sort_x, t, t', MAP sort `{ (term_k ':' term_v)* `})
  = MAP sort `{ (term_k ':' $rename(D, sort_x, t, t', term_v))* `}
def $rename(D, sort_x, t, t', term) = term
  -- otherwise

;; Putting V of sort sort_v where sort_s is expected: always with its
;; injection, even inj{S, S}(V), as hook_SUBSTITUTION_substOne does

dec $inject(sort, sort, term) : term
def $inject(sort_v, sort_s, term)
  = $construct("inj", ([sort_v, sort_s]), ([term]))

dec $is_var_occurrence(sort, text, term) : bool
def $is_var_occurrence(sort_x, t_x,
                       APP "inj" ([sort_x', sort_s]) ([DV sort_x'' t]))
  = true
  -- if sort_x' = sort_x /\ sort_x'' = sort_x /\ t = t_x
def $is_var_occurrence(sort_x, t_x, term) = false
  -- otherwise

;; Capture-avoiding substitution of V (of sort sort_v) for t_x (of sort sort_x).
;; It builds symbol applications with Apply, whose rules are in 6.2-eval.

dec $subst(definition, sort, text, sort, term, term) : res<term>
dec $subst_list(definition, sort, text, sort, term, term*) : res<term*>

;;; an occurrence of the variable, injected into the sort expected there
def $subst(D, sort_x, t_x, sort_v, term_v,
           APP "inj" ([sort_x', sort_s]) ([DV sort_x'' t]))
  = OK $inject(sort_v, sort_s, term_v)
  -- if sort_x' = sort_x /\ sort_x'' = sort_x /\ t = t_x
;;; a binder of the same variable hides it
def $subst(D, sort_x, t_x, sort_v, term_v,
           APP symid sort* (DV sort_y t_y :: term*))
  = OK (APP symid sort* (DV sort_y t_y :: term*))
  -- if $is_binder(D, symid) /\ t_y = t_x
;;; a binder of another variable that does not occur free in V
def $subst(D, sort_x, t_x, sort_v, term_v,
           APP symid sort* (DV sort_y t_y :: term*))
  = OK (APP symid sort* (DV sort_y t_y :: term'*))
  -- if $is_binder(D, symid) /\ t_y =/= t_x
  -- if ~(t_y <- $free_vars(D, sort_x, term_v))
  -- if OK term'* = $subst_list(D, sort_x, t_x, sort_v, term_v, term*)
;;; a binder of a variable that occurs free in V is renamed first, to a name
;;; not free in V and not used in the body, free or bound, so that renaming
;;; captures nothing
def $subst(D, sort_x, t_x, sort_v, term_v,
           APP symid sort* (DV sort_y t_y :: term*))
  = OK (APP symid sort* (DV sort_y t_y' :: term'*))
  -- if $is_binder(D, symid) /\ t_y =/= t_x
  -- if t_y <- $free_vars(D, sort_x, term_v)
  -- if t_y' = $fresh_var(t_y, $free_vars(D, sort_x, term_v)
                               ++ $concat_<text>($all_vars(D, sort_x, term)*))
  -- if OK term'* = $subst_list(D, sort_x, t_x, sort_v, term_v,
                                $rename(D, sort_x, t_y, t_y', term)*)
;;; other symbol applications, built again as evaluation builds them: the
;;; LLVM backend's substitution evaluates each function and anywhere symbol it
;;; rebuilds (runtime/meta/substitution.cpp), so a redex the substitution
;;; makes is reduced at once
def $subst(D, sort_x, t_x, sort_v, term_v, APP symid sort* term*)
  = result
  -- if ~$is_binder(D, symid)
  -- if ~$is_var_occurrence(sort_x, t_x, APP symid sort* term*)
  -- if OK term'* = $subst_list(D, sort_x, t_x, sort_v, term_v, term*)
  -- Apply: D |- symid sort* term'* : result
;;; domain values
def $subst(D, sort_x, t_x, sort_v, term_v, DV sort t) = OK (DV sort t)
;;; collections, as the LLVM backend's substitution goes into them
;;; (runtime/meta/substitution.cpp): each element of a list or a set, elements
;;; that become equal one element of the set, and each value of a map, but not
;;; its keys
def $subst(D, sort_x, t_x, sort_v, term_v, LIST sort term*) = OK (LIST sort term'*)
  -- if OK term'* = $subst_list(D, sort_x, t_x, sort_v, term_v, term*)
def $subst(D, sort_x, t_x, sort_v, term_v, SET sort `{ term* `})
  = OK (SET sort $sorted_set<term>(`{ term'* `}))
  -- if OK term'* = $subst_list(D, sort_x, t_x, sort_v, term_v, term*)
def $subst(D, sort_x, t_x, sort_v, term_v, MAP sort `{ (term_k ':' term_v')* `})
  = OK (MAP sort `{ (term_k ':' term_v'')* `})
  -- if OK term_v''* = $subst_list(D, sort_x, t_x, sort_v, term_v, term_v'*)
def $subst(D, sort_x, t_x, sort_v, term_v, term) = ERROR
  -- otherwise

def $subst_list(D, sort_x, t_x, sort_v, term_v, eps) = OK eps
def $subst_list(D, sort_x, t_x, sort_v, term_v, term_h :: term_t*)
  = OK (term_h' :: term_t'*)
  -- if OK term_h' = $subst(D, sort_x, t_x, sort_v, term_v, term_h)
  -- if OK term_t'* = $subst_list(D, sort_x, t_x, sort_v, term_v, term_t*)
def $subst_list(D, sort_x, t_x, sort_v, term_v, term*) = ERROR
  -- otherwise
