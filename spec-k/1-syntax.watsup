;;
;; K in P4-SpecTec: KORE, and the fragment of it that is executed
;;

;; Names, kept verbatim from KORE

syntax sortid = text  ;; e.g. "SortInt"
syntax symid = text   ;; e.g. "Lbl'UndsPlus'Int'Unds'"
syntax varid = text   ;; e.g. "VarX"
syntax hookid = text  ;; e.g. "INT.add"

;; Sorts

syntax sort =
  | SORT sortid sort*
  | SORTVAR sortid

;; Terms: ground terms; collections arise only by evaluation

syntax term =
  | APP symid sort* term*     ;; symbol application, including inj and kseq
  | DV sort text              ;; domain value of an unhooked sort, e.g. an Id
  | INT int
  | BOOL bool
  | STRING text
  | FLOAT text                ;; FLOAT.Float, in the backend's output format
  | BYTES nat*                ;; BYTES.Bytes, one nat per byte
  | MAP sort (map<term, term>)
  | SET sort (set<term>)
  | LIST sort term*

;; Patterns

syntax pattern =
  | VAR varid sort
  | AND sort pattern pattern        ;; \and, used as an as-pattern on the left
  | OR sort pattern pattern         ;; \or on the left: either side matches
  | APP symid sort* pattern*
  | DV sort text
  | INT int
  | BOOL bool
  | STRING text
  | FLOAT text
  | BYTES nat*

;; Symbols

syntax symkind =
  | CONSTRUCTOR
  | BINDER         ;; a constructor binding its first argument (binder)
  | FUNCTION       ;; defined by equations
  | ANYWHERE       ;; a constructor rewritten by its equations (anywhere)
  | HOOKED hookid  ;; a hook on K terms, specified (3.4); equations ignored
  | RUNTIME hookid ;; a hook of a domain module, by the K runtime (3.1)

syntax symdecl = sort* '->' sort symkind

;; Subsorts

syntax subsort = sort '<' sort

;; Overloads: the second symbol is a more specific version of the first

syntax overload = symid '>' symid

;; Attributes that affect execution

syntax attr =
  | OWISE
  | PRIORITY nat
  | COOL
  | COOLLIKE
  | SIMPLIFICATION  ;; for symbolic execution only, not run
  | NONEXECUTABLE   ;; not run

;; Rules and equations

syntax krule = RULE pattern '=>' pattern 'requires' pattern? attr*

syntax equation = EQN symid pattern* '=' pattern 'requires' pattern? attr*

;; Definitions

syntax definition =
  { SYMBOLS (map<symid, symdecl>),
    SUBSORTS subsort*,                  ;; closed under transitivity
    OVERLOADS overload*,
    RULES krule*,
    EQUATIONS (map<symid, equation*>),  ;; by the symbol defined, in file order
    PARAMS (map<symid, sortid*>),       ;; sort parameters of symbols
    FRESH (map<sort, symid>) }          ;; the freshGenerator of a sort, e.g. freshInt

;; KORE as kompile writes it, every axiom with its attributes; loading picks
;; the definition above from it (6-load)

syntax kore =
  | KVAR varid sort
  | KSETVAR varid sort      ;; a set variable, in properties only
  | KAPP symid sort* kore*  ;; application of a symbol or an alias
  | KML text sort* kore*    ;; a connective, e.g. "rewrites" for \rewrites
  | KSTR text               ;; a string, e.g. of a domain value \dv{S}("1")

syntax kattr = KATTR text sort* kore*  ;; e.g. owise{}(), priority{}("50")

syntax kaxiom = AXIOM kore kattr*

syntax ksymdecl = KSYMBOL sortid* sort* '->' sort kattr*  ;; with parameters

syntax kalias = ALIAS varid* ':=' kore  ;; alias f(X1, ..., Xn) := body

syntax kdefinition =
  { KSORTS (map<sortid, kattr*>),
    KSYMBOLS (map<symid, ksymdecl>),
    KALIASES (map<symid, kalias>),
    AXIOMS kaxiom* }               ;; in file order
