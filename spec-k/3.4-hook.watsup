;;
;; Hooks: built-in operations of hooked sorts
;;

;;; As the LLVM backend's hook runtime; lazy hooks (BOOL.and, KEQUAL.ite, ...)
;;; are in the evaluator (4-eval)

dec $in_list(term, term*) : bool
def $in_list(term, term_e*) = term <- term_e*

;; Membership under KEQUAL.eq, as hook_LIST_in compares elements

dec $in_terms(term, term*) : bool
def $in_terms(term, eps) = false
def $in_terms(term, term_h :: term_t*)
  = $term_eq(term, term_h) \/ $in_terms(term, term_t*)

;; Map concatenation fails on a duplicate key, as hook_MAP_concat does

dec $concat_map(map<term, term>, map<term, term>) : res<map<term, term>>
def $concat_map(M, `{ eps `}) = OK M
def $concat_map(M, `{ (term_k ':' term_v) :: (term_kt ':' term_vt)* `})
  = $concat_map(M', `{ (term_kt ':' term_vt)* `})
  -- if eps = $find_map<term, term>(M, term_k)
  -- if M' = $add_map<term, term>(M, term_k, term_v)
def $concat_map(M_1, M_2) = FAIL
  -- otherwise



dec $hook(definition, hookid, sort, term*) : res<term>
  hint(prose_in "the result of hook" %0 "on" %2)

;;; BOOL

def $hook(D, "BOOL.not", sort, ([BOOL b])) = OK (BOOL (~b))
def $hook(D, "BOOL.eq", sort, ([BOOL b_1, BOOL b_2])) = OK (BOOL $(b_1 = b_2))
def $hook(D, "BOOL.ne", sort, ([BOOL b_1, BOOL b_2])) = OK (BOOL $(b_1 =/= b_2))

;;; INT
;;; P4-SpecTec's / and \ truncate towards zero, as INT.tdiv and INT.tmod do;
;;; division by zero fails

def $hook(D, "INT.add", sort, ([INT i_1, INT i_2])) = OK (INT $(i_1 + i_2))
def $hook(D, "INT.sub", sort, ([INT i_1, INT i_2])) = OK (INT $(i_1 - i_2))
def $hook(D, "INT.mul", sort, ([INT i_1, INT i_2])) = OK (INT $(i_1 * i_2))
def $hook(D, "INT.tdiv", sort, ([INT i_1, INT i_2])) = OK (INT $(i_1 / i_2))
  -- if i_2 =/= 0
def $hook(D, "INT.tmod", sort, ([INT i_1, INT i_2])) = OK (INT $(i_1 \ i_2))
  -- if i_2 =/= 0
def $hook(D, "INT.eq", sort, ([INT i_1, INT i_2])) = OK (BOOL $(i_1 = i_2))
def $hook(D, "INT.ne", sort, ([INT i_1, INT i_2])) = OK (BOOL $(i_1 =/= i_2))
def $hook(D, "INT.lt", sort, ([INT i_1, INT i_2])) = OK (BOOL $(i_1 < i_2))
def $hook(D, "INT.le", sort, ([INT i_1, INT i_2])) = OK (BOOL $(i_1 <= i_2))
def $hook(D, "INT.gt", sort, ([INT i_1, INT i_2])) = OK (BOOL $(i_1 > i_2))
def $hook(D, "INT.ge", sort, ([INT i_1, INT i_2])) = OK (BOOL $(i_1 >= i_2))

def $hook(D, "INT.min", sort, ([INT i_1, INT i_2])) = OK (INT i_1)
  -- if $(i_1 <= i_2)
def $hook(D, "INT.min", sort, ([INT i_1, INT i_2])) = OK (INT i_2)
  -- if $(i_1 > i_2)
def $hook(D, "INT.max", sort, ([INT i_1, INT i_2])) = OK (INT i_1)
  -- if $(i_1 >= i_2)
def $hook(D, "INT.max", sort, ([INT i_1, INT i_2])) = OK (INT i_2)
  -- if $(i_1 < i_2)

;;; Euclidean remainder: the truncated remainder, made non-negative; Euclidean
;;; division leaves it, as hook_INT_ediv rounds down for a positive divisor
;;; and up for a negative one

def $hook(D, "INT.emod", sort, ([INT i_1, INT i_2])) = OK (INT $(i_1 \ i_2))
  -- if i_2 =/= 0
  -- if $((i_1 \ i_2) >= 0)
def $hook(D, "INT.emod", sort, ([INT i_1, INT i_2]))
  = OK (INT $((i_1 \ i_2) + i_2))
  -- if $(i_2 > 0)
  -- if $((i_1 \ i_2) < 0)
def $hook(D, "INT.emod", sort, ([INT i_1, INT i_2]))
  = OK (INT $((i_1 \ i_2) - i_2))
  -- if $(i_2 < 0)
  -- if $((i_1 \ i_2) < 0)
def $hook(D, "INT.ediv", sort, ([INT i_1, INT i_2]))
  = OK (INT $((i_1 - i_r) / i_2))
  -- if OK (INT i_r) = $hook(D, "INT.emod", sort, ([INT i_1, INT i_2]))

;;; Powers by repeated squaring; a negative exponent fails

dec $int_pow(int, nat) : int
def $int_pow(i, n) = 1
  -- if n = 0
def $int_pow(i, n) = $int_pow($(i * i), n_h)
  -- if $(n > 0) /\ $(n \ 2 = 0)
  -- if n_h = $(n / 2)
def $int_pow(i, n) = $(i * $int_pow($(i * i), n_h))
  -- if $(n \ 2 = 1)
  -- if n_h = $(n / 2)

def $hook(D, "INT.pow", sort, ([INT i_1, INT i_2])) = OK (INT $int_pow(i_1, n))
  -- if n = $nat_of(i_2)
def $hook(D, "INT.abs", sort, ([INT i])) = OK (INT i)
  -- if $(i >= 0)
def $hook(D, "INT.abs", sort, ([INT i])) = OK (INT $(- i))
  -- if $(i < 0)

;;; Bitwise operations work on two's complement and are builtins. A negative
;;; shift amount and the logarithm of a nonpositive number fail.

def $hook(D, "INT.and", sort, ([INT i_1, INT i_2]))
  = OK (INT $int_and(i_1, i_2))
def $hook(D, "INT.or", sort, ([INT i_1, INT i_2])) = OK (INT $int_or(i_1, i_2))
def $hook(D, "INT.xor", sort, ([INT i_1, INT i_2]))
  = OK (INT $int_xor(i_1, i_2))
def $hook(D, "INT.not", sort, ([INT i])) = OK (INT $int_not(i))
def $hook(D, "INT.shl", sort, ([INT i_1, INT i_2])) = OK (INT $int_shl(i_1, n))
  -- if n = $nat_of(i_2)
def $hook(D, "INT.shr", sort, ([INT i_1, INT i_2])) = OK (INT $int_shr(i_1, n))
  -- if n = $nat_of(i_2)
def $hook(D, "INT.log2", sort, ([INT i])) = OK (INT $int_log2(i))
  -- if $(i > 0)

;;; KEQUAL (#if is lazy and handled by the evaluator)

def $hook(D, "KEQUAL.eq", sort, ([term_1, term_2]))
  = OK (BOOL $term_eq(term_1, term_2))
def $hook(D, "KEQUAL.ne", sort, ([term_1, term_2]))
  = OK (BOOL (~$term_eq(term_1, term_2)))

;;; STRING
;;; Concatenation and comparison are P4-SpecTec's own; the others are builtins.
;;; Where the LLVM backend reports an error, the hook fails.

def $hook(D, "STRING.concat", sort, ([STRING t_1, STRING t_2]))
  = OK (STRING (t_1 ++ t_2))
def $hook(D, "STRING.eq", sort, ([STRING t_1, STRING t_2]))
  = OK (BOOL $(t_1 = t_2))
def $hook(D, "STRING.ne", sort, ([STRING t_1, STRING t_2]))
  = OK (BOOL $(t_1 =/= t_2))
def $hook(D, "STRING.length", sort, ([STRING t])) = OK (INT $string_length(t))
def $hook(D, "STRING.substr", sort, ([STRING t, INT i_1, INT i_2]))
  = OK (STRING $string_substr(t, i_1, i_2))
  -- if $(0 <= i_1) /\ $(i_1 <= i_2) /\ $(i_2 <= $string_length(t))
def $hook(D, "STRING.find", sort, ([STRING t_1, STRING t_2, INT i]))
  = OK (INT $string_find(t_1, t_2, i))
  -- if $(i >= 0)
def $hook(D, "STRING.findChar", sort, ([STRING t_1, STRING t_2, INT i]))
  = OK (INT $string_find_char(t_1, t_2, i))
  -- if $(i >= 0)
def $hook(D, "STRING.chr", sort, ([INT i])) = OK (STRING $string_chr(i))
  -- if $(0 <= i) /\ $(i <= 255)
def $hook(D, "STRING.int2string", sort, ([INT i]))
  = OK (STRING $int_to_string(i))
def $hook(D, "STRING.string2int", sort, ([STRING t])) = OK (INT i)
  -- if i = $string_to_int(t)
def $hook(D, "STRING.string2base", sort, ([STRING t, INT i_b])) = OK (INT i)
  -- if i = $string_to_base(t, i_b)

;;; Replacing: replaceAll replaces as many occurrences as the string has bytes

def $hook(D, "STRING.replace", sort,
          ([STRING t, STRING t_n, STRING t_r, INT i]))
  = OK (STRING $string_replace(t, t_n, t_r, n))
  -- if n = $nat_of(i)
def $hook(D, "STRING.replaceAll", sort, ([STRING t, STRING t_n, STRING t_r]))
  = OK (STRING $string_replace(t, t_n, t_r, n))
  -- if n = $nat_of($string_length(t))
def $hook(D, "STRING.replaceFirst", sort, ([STRING t, STRING t_n, STRING t_r]))
  = OK (STRING $string_replace(t, t_n, t_r, 1))
def $hook(D, "STRING.countAllOccurrences", sort, ([STRING t, STRING t_n]))
  = OK (INT $string_count(t, t_n))

;;; The text of a token, possibly under one injection, or of a string

def $hook(D, "STRING.token2string", sort, ([DV sort_t t])) = OK (STRING t)
def $hook(D, "STRING.token2string", sort,
          ([APP "inj" ([sort_1, sort_2]) ([DV sort_t t])]))
  = OK (STRING t)
def $hook(D, "STRING.token2string", sort, ([STRING t])) = OK (STRING t)

;;; A token of the result sort with the text of a string (String2KVar in
;;; substitution.md)

def $hook(D, "STRING.string2token", sort, ([STRING t])) = OK (DV sort t)

;;; BUFFER: a string buffer is its text so far

def $hook(D, "BUFFER.empty", sort, eps) = OK (STRING "")
def $hook(D, "BUFFER.concat", sort, ([STRING t_1, STRING t_2]))
  = OK (STRING (t_1 ++ t_2))
def $hook(D, "BUFFER.toString", sort, ([STRING t])) = OK (STRING t)

;;; LIST

def $hook(D, "LIST.unit", sort, eps) = OK (LIST sort eps)
def $hook(D, "LIST.element", sort, ([term])) = OK (LIST sort ([ term ]))
def $hook(D, "LIST.concat", sort, ([LIST sort_1 term_1*, LIST sort_2 term_2*]))
  = OK (LIST sort (term_1* ++ term_2*))
def $hook(D, "LIST.make", sort, ([INT i, term]))
  = OK (LIST sort $repeat_<term>(term, n))
  -- if n = $nat_of(i)
def $hook(D, "LIST.size", sort, ([LIST sort_l term*])) = OK (INT $(|term*|))
def $hook(D, "LIST.get", sort, ([LIST sort_l term*, INT i])) = OK term_e
  -- if term_e = $list_at(term*, i)
def $hook(D, "LIST.in", sort, ([term, LIST sort_l term_e*]))
  = OK (BOOL $in_terms(term, term_e*))
def $hook(D, "LIST.update", sort, ([LIST sort_l term*, INT i, term_v]))
  = OK (LIST sort_l (term*[0 : n] ++ [ term_v ] ++ term*[n_a : n_r]))
  -- if n = $nat_of(i)
  -- if $(n < |term*|)
  -- if n_a = $(n + 1)
  -- if n_r = $nat_of($(|term*| - n_a))

;;; MAP
;;; The result sort of the hooked symbol decides which map sort is built.

def $hook(D, "MAP.unit", sort, eps) = OK (MAP sort `{ eps `})
def $hook(D, "MAP.element", sort, ([term_k, term_v]))
  = OK (MAP sort `{ term_k ':' term_v `})
def $hook(D, "MAP.concat", sort, ([MAP sort_1 M_1, MAP sort_2 M_2]))
  = OK (MAP sort M)
  -- if OK M = $concat_map(M_1, M_2)
def $hook(D, "MAP.lookup", sort, ([MAP sort_m M, term_k])) = OK term_v
  -- if term_v = $find_map<term, term>(M, term_k)
def $hook(D, "MAP.keys", sort, ([MAP sort_m `{ (term_k ':' term_v)* `}]))
  = OK (SET sort `{ term_k* `})
def $hook(D, "MAP.update", sort, ([MAP sort_m M, term_k, term_v]))
  = OK (MAP sort_m $update_map<term, term>(M, term_k, term_v))
def $hook(D, "MAP.in_keys", sort, ([term_k, MAP sort_m M])) = OK (BOOL true)
  -- if term_v = $find_map<term, term>(M, term_k)
def $hook(D, "MAP.in_keys", sort, ([term_k, MAP sort_m M])) = OK (BOOL false)
  -- if eps = $find_map<term, term>(M, term_k)
def $hook(D, "MAP.lookupOrDefault", sort, ([MAP sort_m M, term_k, term_d]))
  = OK term_v
  -- if term_v = $find_map<term, term>(M, term_k)
def $hook(D, "MAP.lookupOrDefault", sort, ([MAP sort_m M, term_k, term_d]))
  = OK term_d
  -- if eps = $find_map<term, term>(M, term_k)
def $hook(D, "MAP.size", sort, ([MAP sort_m `{ (term_k ':' term_v)* `}]))
  = OK (INT $(|term_k*|))

;;; choice: the smallest element here, the first in its hash trie in the LLVM
;;; backend; they agree on a collection of one element

def $hook(D, "MAP.choice", sort, ([MAP sort_m `{ (term_k ':' term_v)* `}]))
  = OK term
  -- if `{ term :: term_t* `} = $union_set<term>(`{ term_k* `}, `{ eps `})

;;; SET

def $hook(D, "SET.unit", sort, eps) = OK (SET sort `{ eps `})
def $hook(D, "SET.element", sort, ([term])) = OK (SET sort `{ term `})
def $hook(D, "SET.concat", sort, ([SET sort_1 S_1, SET sort_2 S_2]))
  = OK (SET sort $union_set<term>(S_1, S_2))
def $hook(D, "SET.difference", sort, ([SET sort_1 S_1, SET sort_2 S_2]))
  = OK (SET sort_1 $diff_set<term>(S_1, S_2))
def $hook(D, "SET.intersection", sort, ([SET sort_1 S_1, SET sort_2 S_2]))
  = OK (SET sort_1 $intersect_set<term>(S_1, S_2))
def $hook(D, "SET.choice", sort, ([SET sort_s S])) = OK term
  -- if `{ term :: term_t* `} = $union_set<term>(S, `{ eps `})
def $hook(D, "SET.in", sort, ([term, SET sort_s `{ term_e* `}]))
  = OK (BOOL $in_list(term, term_e*))

;;; BYTES
;;; A list of bytes; conversions are builtins. A hook fails where the LLVM
;;; backend reports an error.

dec $is_big_endian(term) : bool
def $is_big_endian(APP "LblbigEndianBytes" eps eps) = true
def $is_big_endian(term) = false
  -- otherwise

dec $is_unsigned(term) : bool
def $is_unsigned(APP "LblunsignedBytes" eps eps) = true
def $is_unsigned(term) = false
  -- otherwise

def $hook(D, "BYTES.empty", sort, eps) = OK (BYTES eps)
def $hook(D, "BYTES.length", sort, ([BYTES n*])) = OK (INT $(|n*|))
def $hook(D, "BYTES.concat", sort, ([BYTES n_1*, BYTES n_2*]))
  = OK (BYTES (n_1* ++ n_2*))
def $hook(D, "BYTES.substr", sort, ([BYTES n*, INT i_s, INT i_e]))
  = OK (BYTES n*[n_s : n_l])
  -- if n_s = $nat_of(i_s)
  -- if n_e = $nat_of(i_e)
  -- if $(n_s <= n_e) /\ $(n_e <= |n*|)
  -- if n_l = $nat_of($(n_e - n_s))
def $hook(D, "BYTES.replaceAt", sort, ([BYTES n_d*, INT i, BYTES n_r*]))
  = OK (BYTES (n_d*[0 : n_s] ++ n_r* ++ n_d*[n_a : n_l]))
  -- if n_s = $nat_of(i)
  -- if n_a = $(n_s + |n_r*|)
  -- if $(n_a <= |n_d*|)
  -- if n_l = $nat_of($(|n_d*| - n_a))
def $hook(D, "BYTES.padRight", sort, ([BYTES n*, INT i_l, INT i_v]))
  = OK (BYTES n*)
  -- if n_l = $nat_of(i_l)
  -- if $(n_l <= |n*|)
def $hook(D, "BYTES.padRight", sort, ([BYTES n*, INT i_l, INT i_v]))
  = OK (BYTES (n* ++ $repeat_<nat>(n_v, n_p)))
  -- if n_l = $nat_of(i_l)
  -- if $(n_l > |n*|)
  -- if n_v = $nat_of(i_v)
  -- if $(n_v <= 255)
  -- if n_p = $nat_of($(n_l - |n*|))
def $hook(D, "BYTES.padLeft", sort, ([BYTES n*, INT i_l, INT i_v]))
  = OK (BYTES n*)
  -- if n_l = $nat_of(i_l)
  -- if $(n_l <= |n*|)
def $hook(D, "BYTES.padLeft", sort, ([BYTES n*, INT i_l, INT i_v]))
  = OK (BYTES ($repeat_<nat>(n_v, n_p) ++ n*))
  -- if n_l = $nat_of(i_l)
  -- if $(n_l > |n*|)
  -- if n_v = $nat_of(i_v)
  -- if $(n_v <= 255)
  -- if n_p = $nat_of($(n_l - |n*|))
def $hook(D, "BYTES.get", sort, ([BYTES n*, INT i])) = OK (INT n*[n_i])
  -- if n_i = $nat_of(i)
  -- if $(n_i < |n*|)
def $hook(D, "BYTES.update", sort, ([BYTES n*, INT i, INT i_v]))
  = OK (BYTES (n*[0 : n_i] ++ [ n_v ] ++ n*[n_a : n_l]))
  -- if n_i = $nat_of(i)
  -- if $(n_i < |n*|)
  -- if n_v = $nat_of(i_v)
  -- if $(n_v < 256)
  -- if n_a = $(n_i + 1)
  -- if n_l = $nat_of($(|n*| - n_a))
def $hook(D, "BYTES.memset", sort, ([BYTES n*, INT i_s, INT i_c, INT i_v]))
  = OK (BYTES (n*[0 : n_s] ++ $repeat_<nat>(n_v, n_c) ++ n*[n_a : n_l]))
  -- if n_s = $nat_of(i_s)
  -- if n_c = $nat_of(i_c)
  -- if n_a = $(n_s + n_c)
  -- if $(n_a <= |n*|)
  -- if $(-128 <= i_v) /\ $(i_v <= 127)
  -- if n_v = $nat_of($((i_v + 256) \ 256))
  -- if n_l = $nat_of($(|n*| - n_a))
def $hook(D, "BYTES.int2bytes", sort, ([INT i_l, INT i, term_e]))
  = OK (BYTES $int_to_bytes(n_l, i, $is_big_endian(term_e)))
  -- if n_l = $nat_of(i_l)
;;; a negative length counts by its absolute value, as hook_BYTES_int2bytes
;;; reads it with mpz_get_ui
def $hook(D, "BYTES.int2bytes", sort, ([INT i_l, INT i, term_e]))
  = OK (BYTES $int_to_bytes(n_l, i, $is_big_endian(term_e)))
  -- if $(i_l < 0)
  -- if n_l = $nat_of($(- i_l))
def $hook(D, "BYTES.bytes2int", sort, ([BYTES n*, term_e, term_s]))
  = OK (INT $bytes_to_int(n*, $is_big_endian(term_e), ~$is_unsigned(term_s)))
def $hook(D, "BYTES.string2bytes", sort, ([STRING t]))
  = OK (BYTES $string_to_bytes(t))
def $hook(D, "BYTES.bytes2string", sort, ([BYTES n*]))
  = OK (STRING $bytes_to_string(n*))

;;; FLOAT
;;; Text in the backend's output format; all operations are MPFR builtins.
;;; ==Float is numeric, unlike ==K.

def $hook(D, "FLOAT.add", sort, ([FLOAT t_1, FLOAT t_2]))
  = OK (FLOAT $float_add(t_1, t_2))
def $hook(D, "FLOAT.sub", sort, ([FLOAT t_1, FLOAT t_2]))
  = OK (FLOAT $float_sub(t_1, t_2))
def $hook(D, "FLOAT.mul", sort, ([FLOAT t_1, FLOAT t_2]))
  = OK (FLOAT $float_mul(t_1, t_2))
def $hook(D, "FLOAT.div", sort, ([FLOAT t_1, FLOAT t_2]))
  = OK (FLOAT $float_div(t_1, t_2))
def $hook(D, "FLOAT.min", sort, ([FLOAT t_1, FLOAT t_2]))
  = OK (FLOAT $float_min(t_1, t_2))
def $hook(D, "FLOAT.max", sort, ([FLOAT t_1, FLOAT t_2]))
  = OK (FLOAT $float_max(t_1, t_2))
def $hook(D, "FLOAT.neg", sort, ([FLOAT t])) = OK (FLOAT $float_neg(t))
def $hook(D, "FLOAT.abs", sort, ([FLOAT t])) = OK (FLOAT $float_abs(t))
def $hook(D, "FLOAT.ceil", sort, ([FLOAT t])) = OK (FLOAT $float_ceil(t))
def $hook(D, "FLOAT.floor", sort, ([FLOAT t])) = OK (FLOAT $float_floor(t))
def $hook(D, "FLOAT.trunc", sort, ([FLOAT t])) = OK (FLOAT $float_trunc(t))
def $hook(D, "FLOAT.root", sort, ([FLOAT t, INT i])) = OK (FLOAT t')
  -- if n = $nat_of(i)
  -- if t' = $float_root(t, n)
def $hook(D, "FLOAT.round", sort, ([FLOAT t, INT i_p, INT i_e]))
  = OK (FLOAT $float_round(t, n_p, n_e))
  -- if n_p = $nat_of(i_p)
  -- if n_e = $nat_of(i_e)
  -- if $(n_p >= 1) /\ $(n_e >= 1)
def $hook(D, "FLOAT.int2float", sort, ([INT i, INT i_p, INT i_e]))
  = OK (FLOAT $int_to_float(i, n_p, n_e))
  -- if n_p = $nat_of(i_p)
  -- if n_e = $nat_of(i_e)
  -- if $(n_p >= 1) /\ $(n_e >= 1)
def $hook(D, "FLOAT.float2int", sort, ([FLOAT t])) = OK (INT i)
  -- if i = $float_to_int(t)
def $hook(D, "FLOAT.maxValue", sort, ([INT i_p, INT i_e]))
  = OK (FLOAT $float_max_value(n_p, n_e))
  -- if n_p = $nat_of(i_p)
  -- if n_e = $nat_of(i_e)
  -- if $(n_p >= 1) /\ $(n_e >= 1)
def $hook(D, "FLOAT.precision", sort, ([FLOAT t]))
  = OK (INT $float_precision(t))
def $hook(D, "FLOAT.exponentBits", sort, ([FLOAT t]))
  = OK (INT $float_exponent_bits(t))
def $hook(D, "FLOAT.sign", sort, ([FLOAT t])) = OK (BOOL $float_sign(t))
def $hook(D, "FLOAT.isNaN", sort, ([FLOAT t])) = OK (BOOL $float_is_nan(t))
def $hook(D, "FLOAT.eq", sort, ([FLOAT t_1, FLOAT t_2]))
  = OK (BOOL $float_eq(t_1, t_2))
def $hook(D, "FLOAT.ne", sort, ([FLOAT t_1, FLOAT t_2]))
  = OK (BOOL (~$float_eq(t_1, t_2)))
def $hook(D, "FLOAT.lt", sort, ([FLOAT t_1, FLOAT t_2]))
  = OK (BOOL $float_lt(t_1, t_2))
def $hook(D, "FLOAT.le", sort, ([FLOAT t_1, FLOAT t_2]))
  = OK (BOOL $float_le(t_1, t_2))
def $hook(D, "FLOAT.gt", sort, ([FLOAT t_1, FLOAT t_2]))
  = OK (BOOL $float_gt(t_1, t_2))
def $hook(D, "FLOAT.ge", sort, ([FLOAT t_1, FLOAT t_2]))
  = OK (BOOL $float_ge(t_1, t_2))

;;; RANGEMAP

def $hook(D, "RANGEMAP.unit", sort, eps) = OK (RANGEMAP sort eps)
def $hook(D, "RANGEMAP.elementRng", sort, ([term_r, term_v]))
  = OK (RANGEMAP sort rangeitem*)
  -- if (i_s, i_e) = $range_bounds(term_r)
  -- if OK rangeitem* = $rm_insert(eps, i_s, i_e, term_v)
def $hook(D, "RANGEMAP.concat", sort,
          ([RANGEMAP sort_1 rangeitem_1*, RANGEMAP sort_2 rangeitem_2*]))
  = OK (RANGEMAP sort rangeitem*)
  -- if $disjoint(rangeitem_1*, rangeitem_2*)
  -- if OK rangeitem* = $rm_insert_all(rangeitem_1*, rangeitem_2*)
def $hook(D, "RANGEMAP.updateRng", sort,
          ([RANGEMAP sort_m rangeitem_m*, term_r, term_v]))
  = OK (RANGEMAP sort_m rangeitem*)
  -- if (i_s, i_e) = $range_bounds(term_r)
  -- if OK rangeitem* = $rm_insert(rangeitem_m*, i_s, i_e, term_v)
def $hook(D, "RANGEMAP.updateAll", sort,
          ([RANGEMAP sort_1 rangeitem_1*, RANGEMAP sort_2 rangeitem_2*]))
  = OK (RANGEMAP sort_1 rangeitem*)
  -- if OK rangeitem* = $rm_insert_all(rangeitem_1*, rangeitem_2*)
def $hook(D, "RANGEMAP.removeRng", sort,
          ([RANGEMAP sort_m rangeitem_m*, term_r]))
  = OK (RANGEMAP sort_m rangeitem*)
  -- if (i_s, i_e) = $range_bounds(term_r)
  -- if OK rangeitem* = $rm_remove_all(rangeitem_m*, [ (i_s, i_e) ])
def $hook(D, "RANGEMAP.removeAll", sort,
          ([RANGEMAP sort_m rangeitem_m*, SET sort_s `{ term* `}]))
  = OK (RANGEMAP sort_m rangeitem*)
  -- if OK (i_s, i_e)* = $set_ranges(term*)
  -- if OK rangeitem* = $rm_remove_all(rangeitem_m*, (i_s, i_e)*)
def $hook(D, "RANGEMAP.difference", sort,
          ([RANGEMAP sort_1 rangeitem_1*, RANGEMAP sort_2 rangeitem_2*]))
  = OK (RANGEMAP sort_1 rangeitem*)
  -- if OK rangeitem* = $rm_remove_all(rangeitem_1*,
                                       $agree(rangeitem_1*, rangeitem_2*))
def $hook(D, "RANGEMAP.inclusion", sort,
          ([RANGEMAP sort_1 rangeitem_1*, RANGEMAP sort_2 rangeitem_2*]))
  = OK (BOOL $($range_pairs(rangeitem_1*) = $agree(rangeitem_1*, rangeitem_2*)))
def $hook(D, "RANGEMAP.lookup", sort, ([RANGEMAP sort_m rangeitem*, term_k]))
  = OK term_v
  -- if i = $key_int(term_k)
  -- if (RANGE i_s i_e term_v) = $rm_lookup(rangeitem*, i)
def $hook(D, "RANGEMAP.lookupOrDefault", sort,
          ([RANGEMAP sort_m rangeitem*, term_k, term_d]))
  = OK term_v
  -- if i = $key_int(term_k)
  -- if (RANGE i_s i_e term_v) = $rm_lookup(rangeitem*, i)
def $hook(D, "RANGEMAP.lookupOrDefault", sort,
          ([RANGEMAP sort_m rangeitem*, term_k, term_d]))
  = OK term_d
  -- if i = $key_int(term_k)
  -- if eps = $rm_lookup(rangeitem*, i)
def $hook(D, "RANGEMAP.find_range", sort,
          ([RANGEMAP sort_m rangeitem*, term_k]))
  = OK $range_term(i_s, i_e)
  -- if i = $key_int(term_k)
  -- if (RANGE i_s i_e term_v) = $rm_lookup(rangeitem*, i)
def $hook(D, "RANGEMAP.in_keys", sort, ([term_k, RANGEMAP sort_m rangeitem*]))
  = OK (BOOL true)
  -- if i = $key_int(term_k)
  -- if (RANGE i_s i_e term_v) = $rm_lookup(rangeitem*, i)
def $hook(D, "RANGEMAP.in_keys", sort, ([term_k, RANGEMAP sort_m rangeitem*]))
  = OK (BOOL false)
  -- if i = $key_int(term_k)
  -- if eps = $rm_lookup(rangeitem*, i)
def $hook(D, "RANGEMAP.keys", sort, ([RANGEMAP sort_m (RANGE i_s i_e term)*]))
  = OK (SET sort `{ $range_key(i_s, i_e)* `})
def $hook(D, "RANGEMAP.keys_list", sort,
          ([RANGEMAP sort_m (RANGE i_s i_e term)*]))
  = OK (LIST sort $range_key(i_s, i_e)*)
def $hook(D, "RANGEMAP.values", sort, ([RANGEMAP sort_m (RANGE i_s i_e term)*]))
  = OK (LIST sort term*)
def $hook(D, "RANGEMAP.size", sort, ([RANGEMAP sort_m rangeitem*]))
  = OK (INT $(|rangeitem*|))
def $hook(D, "RANGEMAP.choice", sort,
          ([RANGEMAP sort_m ((RANGE i_s i_e term) :: rangeitem_t*)]))
  = OK $int_key(i_s)

;;; MINT
;;; Machine integers wrap around, as the LLVM instructions of
;;; create_hardcoded_hook; a hook fails where an instruction is undefined

dec $width(definition, sort) : nat?
  hint(prose_in "the width of" %1)
def $width(D, SORT sortid ([SORT sortid_w eps])) = n
  -- if n = $find_map<sortid, nat>(D.NATSORTS, sortid_w)
def $width(D, sort) = eps
  -- otherwise

;; i modulo 2^n_w, and an unsigned value read in two's complement

dec $wrap(nat, int) : nat
  hint(prose_in %1 "modulo 2 to the" %0)
def $wrap(n_w, i) = n
  -- if i_m = $int_pow(2, n_w)
  -- if n = $nat_of($(((i \ i_m) + i_m) \ i_m))

dec $signed(nat, nat) : int
  hint(prose_in "the" %0 "-bit value" %1 "in two's complement")
def $signed(n_w, n_v) = n_v
  -- if n_p = $nat_of($(n_w - 1))
  -- if $(n_v < $int_pow(2, n_p))
def $signed(n_w, n_v) = $(n_v - $int_pow(2, n_w))
  -- if n_p = $nat_of($(n_w - 1))
  -- if $(n_v >= $int_pow(2, n_p))

;; Powers modulo i_m, as hook_MINT_pow64 multiplies with wraparound

dec $pow_mod(int, nat, int) : int
def $pow_mod(i, n, i_m) = $(1 \ i_m)
  -- if n = 0
def $pow_mod(i, n, i_m) = $pow_mod($((i * i) \ i_m), n_h, i_m)
  -- if $(n > 0) /\ $(n \ 2 = 0)
  -- if n_h = $(n / 2)
def $pow_mod(i, n, i_m) = $((i * $pow_mod($((i * i) \ i_m), n_h, i_m)) \ i_m)
  -- if $(n \ 2 = 1)
  -- if n_h = $(n / 2)

;;; Conversions

def $hook(D, "MINT.integer", sort, ([INT i])) = OK (MINT n_w $wrap(n_w, i))
  -- if n_w = $width(D, sort)
def $hook(D, "MINT.uvalue", sort, ([MINT n_w n_v])) = OK (INT n_v)
def $hook(D, "MINT.svalue", sort, ([MINT n_w n_v])) = OK (INT $signed(n_w, n_v))
def $hook(D, "MINT.round", sort, ([MINT n_w n_v]))
  = OK (MINT n_o $wrap(n_o, n_v))
  -- if n_o = $width(D, sort)
def $hook(D, "MINT.sext", sort, ([MINT n_w n_v]))
  = OK (MINT n_o $wrap(n_o, $signed(n_w, n_v)))
  -- if n_o = $width(D, sort)

;;; Bytes, big-endian and unsigned (only MInt{256} is supported by the LLVM
;;; backend; only byte strings as long as the width were compared with it)

def $hook(D, "MINT.MInt2bytes", sort, ([MINT n_w n_v]))
  = OK (BYTES $int_to_bytes(n_b, n_v, true))
  -- if $(n_w \ 8 = 0)
  -- if n_b = $(n_w / 8)
def $hook(D, "MINT.bytes2MInt", sort, ([BYTES n*]))
  = OK (MINT n_w $wrap(n_w, $bytes_to_int(n*, true, false)))
  -- if n_w = $width(D, sort)

;;; Arithmetic and bitwise operations wrap around

def $hook(D, "MINT.add", sort, ([MINT n_w n_1, MINT n_w' n_2]))
  = OK (MINT n_w $wrap(n_w, $(n_1 + n_2)))
def $hook(D, "MINT.sub", sort, ([MINT n_w n_1, MINT n_w' n_2]))
  = OK (MINT n_w $wrap(n_w, $(n_1 - n_2)))
def $hook(D, "MINT.mul", sort, ([MINT n_w n_1, MINT n_w' n_2]))
  = OK (MINT n_w $wrap(n_w, $(n_1 * n_2)))
def $hook(D, "MINT.neg", sort, ([MINT n_w n_v]))
  = OK (MINT n_w $wrap(n_w, $(- n_v)))
def $hook(D, "MINT.pow", sort, ([MINT n_w n_1, MINT n_w' n_2]))
  = OK (MINT n_w $wrap(n_w, $pow_mod(n_1, n_2, $int_pow(2, n_w))))
def $hook(D, "MINT.and", sort, ([MINT n_w n_1, MINT n_w' n_2]))
  = OK (MINT n_w $wrap(n_w, $int_and(n_1, n_2)))
def $hook(D, "MINT.or", sort, ([MINT n_w n_1, MINT n_w' n_2]))
  = OK (MINT n_w $wrap(n_w, $int_or(n_1, n_2)))
def $hook(D, "MINT.xor", sort, ([MINT n_w n_1, MINT n_w' n_2]))
  = OK (MINT n_w $wrap(n_w, $int_xor(n_1, n_2)))
def $hook(D, "MINT.not", sort, ([MINT n_w n_v]))
  = OK (MINT n_w $wrap(n_w, $int_not(n_v)))

def $hook(D, "MINT.udiv", sort, ([MINT n_w n_1, MINT n_w' n_2]))
  = OK (MINT n_w $wrap(n_w, $(n_1 / n_2)))
  -- if n_2 =/= 0
def $hook(D, "MINT.urem", sort, ([MINT n_w n_1, MINT n_w' n_2]))
  = OK (MINT n_w $wrap(n_w, $(n_1 \ n_2)))
  -- if n_2 =/= 0

;;; Signed division truncates towards zero, and its remainder takes the sign
;;; of the dividend, as P4-SpecTec's / and \ do; the quotient must fit

def $hook(D, "MINT.sdiv", sort, ([MINT n_w n_1, MINT n_w' n_2]))
  = OK (MINT n_w $wrap(n_w, i_q))
  -- if i_1 = $signed(n_w, n_1)
  -- if i_2 = $signed(n_w, n_2)
  -- if i_2 =/= 0
  -- if i_q = $(i_1 / i_2)
  -- if $signed(n_w, $wrap(n_w, i_q)) = i_q
def $hook(D, "MINT.srem", sort, ([MINT n_w n_1, MINT n_w' n_2]))
  = OK (MINT n_w $wrap(n_w, $(i_1 \ i_2)))
  -- if i_1 = $signed(n_w, n_1)
  -- if i_2 = $signed(n_w, n_2)
  -- if i_2 =/= 0
  -- if i_q = $(i_1 / i_2)
  -- if $signed(n_w, $wrap(n_w, i_q)) = i_q

;;; Shifts by less than the width

def $hook(D, "MINT.shl", sort, ([MINT n_w n_1, MINT n_w' n_2]))
  = OK (MINT n_w $wrap(n_w, $int_shl(n_1, n_2)))
  -- if $(n_2 < n_w)
def $hook(D, "MINT.lshr", sort, ([MINT n_w n_1, MINT n_w' n_2]))
  = OK (MINT n_w $wrap(n_w, $int_shr(n_1, n_2)))
  -- if $(n_2 < n_w)
def $hook(D, "MINT.ashr", sort, ([MINT n_w n_1, MINT n_w' n_2]))
  = OK (MINT n_w $wrap(n_w, $int_shr($signed(n_w, n_1), n_2)))
  -- if $(n_2 < n_w)

;;; Comparisons, unsigned and signed

def $hook(D, "MINT.eq", sort, ([MINT n_w n_1, MINT n_w' n_2]))
  = OK (BOOL $(n_1 = n_2))
def $hook(D, "MINT.ne", sort, ([MINT n_w n_1, MINT n_w' n_2]))
  = OK (BOOL $(n_1 =/= n_2))
def $hook(D, "MINT.ult", sort, ([MINT n_w n_1, MINT n_w' n_2]))
  = OK (BOOL $(n_1 < n_2))
def $hook(D, "MINT.ule", sort, ([MINT n_w n_1, MINT n_w' n_2]))
  = OK (BOOL $(n_1 <= n_2))
def $hook(D, "MINT.ugt", sort, ([MINT n_w n_1, MINT n_w' n_2]))
  = OK (BOOL $(n_1 > n_2))
def $hook(D, "MINT.uge", sort, ([MINT n_w n_1, MINT n_w' n_2]))
  = OK (BOOL $(n_1 >= n_2))
def $hook(D, "MINT.slt", sort, ([MINT n_w n_1, MINT n_w' n_2]))
  = OK (BOOL $($signed(n_w, n_1) < $signed(n_w, n_2)))
def $hook(D, "MINT.sle", sort, ([MINT n_w n_1, MINT n_w' n_2]))
  = OK (BOOL $($signed(n_w, n_1) <= $signed(n_w, n_2)))
def $hook(D, "MINT.sgt", sort, ([MINT n_w n_1, MINT n_w' n_2]))
  = OK (BOOL $($signed(n_w, n_1) > $signed(n_w, n_2)))
def $hook(D, "MINT.sge", sort, ([MINT n_w n_1, MINT n_w' n_2]))
  = OK (BOOL $($signed(n_w, n_1) >= $signed(n_w, n_2)))

def $hook(D, "MINT.umin", sort, ([MINT n_w n_1, MINT n_w' n_2]))
  = OK (MINT n_w n_1)
  -- if $(n_1 <= n_2)
def $hook(D, "MINT.umin", sort, ([MINT n_w n_1, MINT n_w' n_2]))
  = OK (MINT n_w n_2)
  -- if $(n_1 > n_2)
def $hook(D, "MINT.umax", sort, ([MINT n_w n_1, MINT n_w' n_2]))
  = OK (MINT n_w n_1)
  -- if $(n_1 >= n_2)
def $hook(D, "MINT.umax", sort, ([MINT n_w n_1, MINT n_w' n_2]))
  = OK (MINT n_w n_2)
  -- if $(n_1 < n_2)
def $hook(D, "MINT.smin", sort, ([MINT n_w n_1, MINT n_w' n_2]))
  = OK (MINT n_w n_1)
  -- if $($signed(n_w, n_1) <= $signed(n_w, n_2))
def $hook(D, "MINT.smin", sort, ([MINT n_w n_1, MINT n_w' n_2]))
  = OK (MINT n_w n_2)
  -- if $($signed(n_w, n_1) > $signed(n_w, n_2))
def $hook(D, "MINT.smax", sort, ([MINT n_w n_1, MINT n_w' n_2]))
  = OK (MINT n_w n_1)
  -- if $($signed(n_w, n_1) >= $signed(n_w, n_2))
def $hook(D, "MINT.smax", sort, ([MINT n_w n_1, MINT n_w' n_2]))
  = OK (MINT n_w n_2)
  -- if $($signed(n_w, n_1) < $signed(n_w, n_2))

;;; Bytes and lists with machine-integer indices and sizes: the same as with
;;; integers, on the unsigned values

def $hook(D, "BYTES.lengthMInt", sort, ([BYTES n*]))
  = OK (MINT n_w $wrap(n_w, $(|n*|)))
  -- if n_w = $width(D, sort)
def $hook(D, "BYTES.getMInt", sort, ([BYTES n*, MINT n_w n_i]))
  = OK (MINT n_o $wrap(n_o, i_b))
  -- if OK (INT i_b) = $hook(D, "BYTES.get", sort, ([BYTES n*, INT n_i]))
  -- if n_o = $width(D, sort)
def $hook(D, "BYTES.updateMInt", sort,
          ([BYTES n*, MINT n_w n_i, MINT n_w' n_v]))
  = $hook(D, "BYTES.update", sort, ([BYTES n*, INT n_i, INT n_v]))
def $hook(D, "BYTES.substrMInt", sort,
          ([BYTES n*, MINT n_w n_s, MINT n_w' n_e]))
  = $hook(D, "BYTES.substr", sort, ([BYTES n*, INT n_s, INT n_e]))
def $hook(D, "BYTES.replaceAtMInt", sort,
          ([BYTES n*, MINT n_w n_i, BYTES n_r*]))
  = $hook(D, "BYTES.replaceAt", sort, ([BYTES n*, INT n_i, BYTES n_r*]))
def $hook(D, "BYTES.padRightMInt", sort,
          ([BYTES n*, MINT n_w n_l, MINT n_w' n_v]))
  = $hook(D, "BYTES.padRight", sort, ([BYTES n*, INT n_l, INT n_v]))
def $hook(D, "BYTES.padLeftMInt", sort,
          ([BYTES n*, MINT n_w n_l, MINT n_w' n_v]))
  = $hook(D, "BYTES.padLeft", sort, ([BYTES n*, INT n_l, INT n_v]))
def $hook(D, "LIST.sizeMInt", sort, ([LIST sort_l term*]))
  = OK (MINT n_w $wrap(n_w, $(|term*|)))
  -- if n_w = $width(D, sort)
def $hook(D, "LIST.getMInt", sort, ([LIST sort_l term*, MINT n_w n_i]))
  = $hook(D, "LIST.get", sort, ([LIST sort_l term*, INT n_i]))
def $hook(D, "LIST.updateMInt", sort,
          ([LIST sort_l term*, MINT n_w n_i, term_v]))
  = $hook(D, "LIST.update", sort, ([LIST sort_l term*, INT n_i, term_v]))

;;; SUBSTITUTION
;;; E[V / X], renaming binders so that V is not captured; bound names agree
;;; with the LLVM backend's only up to renaming

def $hook(D, "SUBSTITUTION.substOne", sort,
          ([term_e, APP "inj" ([sort_v, sort_k]) ([term_v]),
            APP "inj" ([sort_x, sort_k']) ([DV sort_x' t_x])]))
  = $subst(D, sort_x, t_x, sort_v, term_v, term_e)
  -- if sort_x = sort_x'

;;; Anything else is not supported (yet)

def $hook(D, hookid, sort, term*) = FAIL
  -- otherwise
