;;
;; Hooks on K terms: equality, tokens, string buffers, substitution
;;

;;; Hooks on domain values are computed by the K runtime (6.2-eval); the ones
;;; here and in 5.3-hook-collection take or give K terms. Lazy hooks (BOOL.and,
;;; KEQUAL.ite, ...) are in the evaluator (6.2-eval).

dec $hook(definition, hookid, sort, term*) : res<term>
  hint(prose_in "the result of hook" %0 "on" %2)

;;; KEQUAL (#if is lazy and handled by the evaluator). Terms are kept in one
;;; form: maps and sets with their elements in order, domain values as their
;;; text (1-syntax). So K's equality of terms is equality of values.

def $hook(D, "KEQUAL.eq", sort, ([term_1, term_2]))
  = OK (DV sort $bool_text(term_1 = term_2))
def $hook(D, "KEQUAL.ne", sort, ([term_1, term_2]))
  = OK (DV sort $bool_text(term_1 =/= term_2))

;;; The text of a token, possibly under one injection, or of a string, as a
;;; String

def $hook(D, "STRING.token2string", sort, ([DV sort_t t])) = OK (DV sort t)
def $hook(D, "STRING.token2string", sort,
          ([APP "inj" ([sort_1, sort_2]) ([DV sort_t t])]))
  = OK (DV sort t)

;;; A token of the result sort with the text of a string (String2KVar in
;;; substitution.md)

def $hook(D, "STRING.string2token", sort, ([DV sort_s t])) = OK (DV sort t)

;;; BUFFER: a string buffer is its text so far, a token of its sort

def $hook(D, "BUFFER.empty", sort, eps) = OK (DV sort "")
def $hook(D, "BUFFER.concat", sort, ([DV sort_1 t_1, DV sort_2 t_2]))
  = OK (DV sort_1 (t_1 ++ t_2))
def $hook(D, "BUFFER.toString", sort, ([DV sort_1 t])) = OK (DV sort t)

;;; KREFLECTION.printKORE (#unparseKORE): a term as KORE text, as the LLVM
;;; backend's printer writes it (runtime/util/ConfigurationPrinter.cpp): a
;;; symbol with its sort parameters and arguments, a domain value with its
;;; sort, and a collection as its unit, or its concatenation of elements under
;;; \left-assoc, with the symbols the definition hooks for its sort. Map and
;;; Set elements come in their order here, the order of the hash trie there
;;; (as for Set2List); a string buffer is escaped here, written raw there.

dec $cat_text(text*) : text
def $cat_text(eps) = ""
def $cat_text((t_h :: t_t*)) = t_h ++ $cat_text(t_t*)

;; Texts with a separator between them
dec $join_text(text, text*) : text
def $join_text(t_s, eps) = ""
def $join_text(t_s, (t_h :: t_t*)) = t_h ++ $cat_text((t_s ++ t_t)*)

dec $sort_text(sort) : text
def $sort_text(SORT sortid sort*) = sortid ++ "{" ++ $join_text(", ", $sort_text(sort)*) ++ "}"
def $sort_text(SORTVAR sortid) = sortid

dec $symbol_text(symid, sort*) : text
def $symbol_text(symid, sort*) = symid ++ "{" ++ $join_text(", ", $sort_text(sort)*) ++ "}"

;; The symbol with hook hookid and result sort sort: the unit, element, or
;; concatenation of a collection sort
dec $symbol_if(hookid, sort, symid, symdecl) : symid*
def $symbol_if(hookid, sort, symid, SYMBOL sortid_p* sort_a* '->' sort_r symkind)
  = [ symid ]
  -- if sort_r = sort /\ symkind = HOOKED hookid
def $symbol_if(hookid, sort, symid, SYMBOL sortid_p* sort_a* '->' sort_r symkind) = eps
  -- if ~(sort_r = sort /\ symkind = HOOKED hookid)

dec $hooked_symbol(definition, hookid, sort) : text
def $hooked_symbol(D, hookid, sort) = $symbol_text(symid_h, eps)
  -- if `{ (symid ':' symdecl)* `} = D.SYMBOLS
  -- if symid_h :: symid_t* = $concat_<symid>($symbol_if(hookid, sort, symid, symdecl)*)

;; A collection: its unit, or its elements, each under the element symbol, in
;; the concatenation; the hooks of unit, element, and concatenation name them
dec $collection_text(definition, hookid, hookid, hookid, sort, text*) : text
def $collection_text(D, hookid_u, hookid_e, hookid_c, sort, eps)
  = $hooked_symbol(D, hookid_u, sort) ++ "()"
def $collection_text(D, hookid_u, hookid_e, hookid_c, sort, (t_h :: t_t*))
  = "\\left-assoc{}(" ++ $hooked_symbol(D, hookid_c, sort) ++ "("
    ++ $join_text(",", (t_e ++ "(" ++ t ++ ")")*) ++ "))"
  -- if t_e = $hooked_symbol(D, hookid_e, sort)
  -- if t* = t_h :: t_t*

;; The width of an MInt sort
dec $mint_width(sort) : text?
def $mint_width(SORT "SortMInt" ([SORT sortid_w eps])) = $drop_prefix(sortid_w, "Sort")
def $mint_width(sort) = eps
  -- otherwise

;; The text of a domain value's literal: an MInt with the width of its sort
dec $literal_text(sort, text) : text
def $literal_text(sort, t) = t ++ "p" ++ t_w
  -- if t_w = $mint_width(sort)
def $literal_text(sort, t) = $kore_string(t)
  -- if eps = $mint_width(sort)

dec $kore_text(definition, term) : text
def $kore_text(D, APP symid sort* term*)
  = $symbol_text(symid, sort*) ++ "(" ++ $join_text(",", $kore_text(D, term)*) ++ ")"
def $kore_text(D, DV sort t) = "\\dv{" ++ $sort_text(sort) ++ "}(\"" ++ $literal_text(sort, t) ++ "\")"
def $kore_text(D, LIST sort term*)
  = $collection_text(D, "LIST.unit", "LIST.element", "LIST.concat", sort, $kore_text(D, term)*)
def $kore_text(D, SET sort `{ term* `})
  = $collection_text(D, "SET.unit", "SET.element", "SET.concat", sort, $kore_text(D, term)*)
def $kore_text(D, MAP sort `{ (term_k ':' term_v)* `})
  = $collection_text(D, "MAP.unit", "MAP.element", "MAP.concat", sort,
                     ($kore_text(D, term_k) ++ "," ++ $kore_text(D, term_v))*)
;; a range map by its ranges, each RangeMap:Range(start, end) and its value
def $kore_text(D, RANGEMAP sort (RANGE i_s i_e term)*)
  = $collection_text(D, "RANGEMAP.unit", "RANGEMAP.elementRng", "RANGEMAP.concat", sort,
                     ($kore_text(D, $range_term(i_s, i_e)) ++ "," ++ $kore_text(D, term))*)

def $hook(D, "KREFLECTION.printKORE", sort, ([term])) = OK (DV sort $kore_text(D, term))

;;; SUBSTITUTION
;;; E[V / X], renaming binders so that V is not captured; bound names agree
;;; with the LLVM backend's only up to renaming

def $hook(D, "SUBSTITUTION.substOne", sort,
          ([term_e, APP "inj" ([sort_v, sort_k]) ([term_v]),
            APP "inj" ([sort_x, sort_k']) ([DV sort_x' t_x])]))
  = $subst(D, sort_x, t_x, sort_v, term_v, term_e)
  -- if sort_x = sort_x'
