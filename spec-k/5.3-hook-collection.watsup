;;
;; Hooks of collections: lists, maps, and sets
;;

;;; The result sort of the hooked symbol, sort, is the sort of the collection
;;; a hook builds, or of the Int or Bool it gives. An Int argument is read
;;; from its text.

;;; LIST

def $hook(D, "LIST.unit", sort, eps) = OK (LIST sort eps)
def $hook(D, "LIST.element", sort, ([term])) = OK (LIST sort ([ term ]))
def $hook(D, "LIST.push", sort, ([term_v, LIST sort_l term*]))
  = OK (LIST sort (term_v :: term*))
def $hook(D, "LIST.concat", sort, ([LIST sort_1 term_1*, LIST sort_2 term_2*]))
  = OK (LIST sort (term_1* ++ term_2*))
def $hook(D, "LIST.make", sort, ([DV sort_i t_i, term]))
  = OK (LIST sort $repeat_<term>(term, n))
  -- if n = $nat_of($text_to_int(t_i))
def $hook(D, "LIST.size", sort, ([LIST sort_l term*]))
  = OK (DV sort $int_text($(|term*|)))
def $hook(D, "LIST.get", sort, ([LIST sort_l term*, DV sort_i t_i])) = OK term_e
  -- if term_e = $list_at(term*, $text_to_int(t_i))
def $hook(D, "LIST.in", sort, ([term, LIST sort_l term_e*]))
  = OK (DV sort $bool_text(term <- term_e*))
def $hook(D, "LIST.update", sort, ([LIST sort_l term*, DV sort_i t_i, term_v]))
  = OK (LIST sort (term*[0 : n] ++ [ term_v ] ++ term*[n_a : n_r]))
  -- if n = $nat_of($text_to_int(t_i))
  -- if $(n < |term*|)
  -- if n_a = $(n + 1)
  -- if n_r = $nat_of($(|term*| - n_a))
;; n_f elements off the front and n_b off the back
def $hook(D, "LIST.range", sort, ([LIST sort_l term*, DV sort_f t_f, DV sort_b t_b]))
  = OK (LIST sort term*[n_f : n])
  -- if n_f = $nat_of($text_to_int(t_f))
  -- if n_b = $nat_of($text_to_int(t_b))
  -- if n = $nat_of($(|term*| - n_f - n_b))
;; The elements from n on replaced by term_s*. Out of range fails, as K
;; documents; hook_LIST_updateAll does not check it when n is 0
def $hook(D, "LIST.updateAll", sort,
  ([LIST sort_l term*, DV sort_i t_i, LIST sort_s term_s*]))
  = OK (LIST sort (term*[0 : n] ++ term_s* ++ term*[n_a : n_r]))
  -- if n = $nat_of($text_to_int(t_i))
  -- if n_a = $(n + |term_s*|)
  -- if n_r = $nat_of($(|term*| - n_a))
;; n_l elements from n on replaced by term_v; out of range fails, as for
;; updateAll (hook_LIST_fill does not check it when n or n_l is 0)
def $hook(D, "LIST.fill", sort,
  ([LIST sort_l term*, DV sort_i t_i, DV sort_n t_n, term_v]))
  = OK (LIST sort (term*[0 : n] ++ $repeat_<term>(term_v, n_l) ++ term*[n_a : n_r]))
  -- if n = $nat_of($text_to_int(t_i))
  -- if n_l = $nat_of($text_to_int(t_n))
  -- if n_a = $(n + n_l)
  -- if n_r = $nat_of($(|term*| - n_a))

;; Machine-integer indices and sizes, of an MInt literal NpW of sort
;; MInt{SortW}: the index is the integer N, as the LLVM backend reads a 64-bit
;; one (a 256-bit one it cuts to 64 bits, which no list reaches)
def $hook(D, "LIST.getMInt", sort, ([LIST sort_l term*, DV sort_i t_i]))
  = $hook(D, "LIST.get", sort, ([LIST sort_l term*, DV sort_i $text_before(t_i, "p")]))
def $hook(D, "LIST.updateMInt", sort, ([LIST sort_l term*, DV sort_i t_i, term_v]))
  = $hook(D, "LIST.update", sort,
          ([LIST sort_l term*, DV sort_i $text_before(t_i, "p"), term_v]))
def $hook(D, "LIST.sizeMInt", sort, ([LIST sort_l term*]))
  = OK (DV sort ($int_text($(|term*|)) ++ "p" ++ $drop_prefix(sortid_w, "Sort")))
  -- if SORT sortid_m ([SORT sortid_w eps]) = sort

;;; MAP
;;; A map keeps its entries in order, as a set does, so that maps with the same
;;; entries are the same value, as K compares them (KEQUAL.eq in 5.2-hook).

def $hook(D, "MAP.unit", sort, eps) = OK (MAP sort `{ eps `})
def $hook(D, "MAP.element", sort, ([term_k, term_v]))
  = OK (MAP sort `{ term_k ':' term_v `})
;; Concatenation of maps with no key in common, as hook_MAP_concat fails on a
;; duplicate key
def $hook(D, "MAP.concat", sort, ([MAP sort_1 M_1, MAP sort_2 M_2]))
  = OK (MAP sort $union_set<pair<term, term>>(M_1, M_2))
  -- if `{ (term_k1 ':' term_v1)* `} = M_1
  -- if `{ (term_k2 ':' term_v2)* `} = M_2
  -- if $intersect_set<term>(`{ term_k1* `}, `{ term_k2* `}) = `{ eps `}
def $hook(D, "MAP.lookup", sort, ([MAP sort_m M, term_k])) = OK term_v
  -- if term_v = $find_map<term, term>(M, term_k)
def $hook(D, "MAP.keys", sort, ([MAP sort_m `{ (term_k ':' term_v)* `}]))
  = OK (SET sort `{ term_k* `})
def $hook(D, "MAP.update", sort, ([MAP sort_m M, term_k, term_v]))
  = OK (MAP sort $sorted_set<pair<term, term>>(
           $update_map<term, term>(M, term_k, term_v)))
def $hook(D, "MAP.in_keys", sort, ([term_k, MAP sort_m `{ (term_k' ':' term_v')* `}]))
  = OK (DV sort $bool_text(term_k <- term_k'*))
def $hook(D, "MAP.lookupOrDefault", sort, ([MAP sort_m M, term_k, term_d]))
  = OK term_v
  -- if term_v = $find_map<term, term>(M, term_k)
def $hook(D, "MAP.lookupOrDefault", sort, ([MAP sort_m M, term_k, term_d]))
  = OK term_d
  -- if eps = $find_map<term, term>(M, term_k)
;;; inclusion: whether the entries of the first are in the second, so true for
;;; equal maps, as in the LLVM backend; domains.md says "strict subset"

def $hook(D, "MAP.inclusion", sort, ([MAP sort_1 M_1, MAP sort_2 M_2]))
  = OK (DV sort $bool_text($diff_set<pair<term, term>>(M_1, M_2) = `{ eps `}))
def $hook(D, "MAP.size", sort, ([MAP sort_m `{ (term_k ':' term_v)* `}]))
  = OK (DV sort $int_text($(|term_k*|)))

;;; choice: the smallest element here, the first in its hash trie in the LLVM
;;; backend; they agree on a collection of one element

def $hook(D, "MAP.choice", sort, ([MAP sort_m `{ (term_k ':' term_v)* `}]))
  = OK term
  -- if `{ term :: term_t* `} = $sorted_set<term>(`{ term_k* `})

;;; Removing keys: M[K <- undef], removeAll(M, S); a key not in the map is
;;; left alone

dec $remove_keys(map<term, term>, term*) : map<term, term>
def $remove_keys(M, eps) = M
def $remove_keys(M, (term_k :: term*))
  = $remove_keys($diff_set<pair<term, term>>(M, `{ term_k ':' term_v `}), term*)
  -- if term_v = $find_map<term, term>(M, term_k)
def $remove_keys(M, (term_k :: term*)) = $remove_keys(M, term*)
  -- if eps = $find_map<term, term>(M, term_k)

def $hook(D, "MAP.remove", sort, ([MAP sort_m M, term_k]))
  = OK (MAP sort $remove_keys(M, ([ term_k ])))
def $hook(D, "MAP.removeAll", sort, ([MAP sort_m M, SET sort_s `{ term_s* `}]))
  = OK (MAP sort $remove_keys(M, term_s*))

;;; M1 -Map M2 takes off the entries of M1 that are in M2, key and value;
;;; updateMap(M1, M2) gives M2's value to a key in both

def $hook(D, "MAP.difference", sort, ([MAP sort_1 M_1, MAP sort_2 M_2]))
  = OK (MAP sort $diff_set<pair<term, term>>(M_1, M_2))
def $hook(D, "MAP.updateAll", sort, ([MAP sort_1 M_1, MAP sort_2 M_2]))
  = OK (MAP sort $union_set<pair<term, term>>($remove_keys(M_1, term_k*), M_2))
  -- if `{ (term_k ':' term_v)* `} = M_2

;;; keys_list, values: the keys and the values in the order of the map here,
;;; the order of its hash trie in the LLVM backend, as for Set2List

def $hook(D, "MAP.keys_list", sort, ([MAP sort_m `{ (term_k ':' term_v)* `}]))
  = OK (LIST sort term_k*)
def $hook(D, "MAP.values", sort, ([MAP sort_m `{ (term_k ':' term_v)* `}]))
  = OK (LIST sort term_v*)

;;; SET

def $hook(D, "SET.unit", sort, eps) = OK (SET sort `{ eps `})
def $hook(D, "SET.element", sort, ([term])) = OK (SET sort `{ term `})
def $hook(D, "SET.concat", sort, ([SET sort_1 S_1, SET sort_2 S_2]))
  = OK (SET sort $union_set<term>(S_1, S_2))
def $hook(D, "SET.inclusion", sort, ([SET sort_1 S_1, SET sort_2 S_2]))
  = OK (DV sort $bool_text($diff_set<term>(S_1, S_2) = `{ eps `}))
def $hook(D, "SET.difference", sort, ([SET sort_1 S_1, SET sort_2 S_2]))
  = OK (SET sort $diff_set<term>(S_1, S_2))
def $hook(D, "SET.intersection", sort, ([SET sort_1 S_1, SET sort_2 S_2]))
  = OK (SET sort $intersect_set<term>(S_1, S_2))
def $hook(D, "SET.choice", sort, ([SET sort_s S])) = OK term
  -- if `{ term :: term_t* `} = $sorted_set<term>(S)
def $hook(D, "SET.in", sort, ([term, SET sort_s `{ term_e* `}]))
  = OK (DV sort $bool_text(term <- term_e*))
def $hook(D, "SET.union", sort, ([SET sort_1 S_1, SET sort_2 S_2]))
  = OK (SET sort $union_set<term>(S_1, S_2))
def $hook(D, "SET.size", sort, ([SET sort_s `{ term* `}]))
  = OK (DV sort $int_text($(|term*|)))

;;; Set2List: the elements in the order of the set here, the order of its hash
;;; trie in the LLVM backend; they agree on a set of one element

def $hook(D, "SET.set2list", sort, ([SET sort_s `{ term* `}]))
  = OK (LIST sort term*)

;;; List2Set: the elements of the list, once each

def $hook(D, "SET.list2set", sort, ([LIST sort_l term*]))
  = OK (SET sort $sorted_set<term>(`{ term* `}))

;;; Any other hook on K terms is not supported (yet)

def $hook(D, hookid, sort, term*) = ERROR
  -- otherwise
