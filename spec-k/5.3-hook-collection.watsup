;;
;; Hooks of collections: lists, maps, sets, and range maps
;;

;;; The result sort of the hooked symbol, sort, is the sort of the collection
;;; a hook builds, or of the Int or Bool it gives. An Int argument is read
;;; from its text.

;;; LIST

def $hook(D, "LIST.unit", sort, eps) = OK (LIST sort eps)
def $hook(D, "LIST.element", sort, ([term])) = OK (LIST sort ([ term ]))
def $hook(D, "LIST.push", sort, ([term_v, LIST sort_l term*]))
  = OK (LIST sort (term_v :: term*))
def $hook(D, "LIST.concat", sort, ([LIST sort_1 term_1*, LIST sort_2 term_2*]))
  = OK (LIST sort (term_1* ++ term_2*))
def $hook(D, "LIST.make", sort, ([DV sort_i t_i, term]))
  = OK (LIST sort $repeat_<term>(term, n))
  -- if n = $nat_of($text_to_int(t_i))
def $hook(D, "LIST.size", sort, ([LIST sort_l term*]))
  = OK (DV sort $int_text($(|term*|)))
def $hook(D, "LIST.get", sort, ([LIST sort_l term*, DV sort_i t_i])) = OK term_e
  -- if term_e = $list_at(term*, $text_to_int(t_i))
def $hook(D, "LIST.in", sort, ([term, LIST sort_l term_e*]))
  = OK (DV sort $bool_text(term <- term_e*))
def $hook(D, "LIST.update", sort, ([LIST sort_l term*, DV sort_i t_i, term_v]))
  = OK (LIST sort (term*[0 : n] ++ [ term_v ] ++ term*[n_a : n_r]))
  -- if n = $nat_of($text_to_int(t_i))
  -- if $(n < |term*|)
  -- if n_a = $(n + 1)
  -- if n_r = $nat_of($(|term*| - n_a))
;; n_f elements off the front and n_b off the back
def $hook(D, "LIST.range", sort, ([LIST sort_l term*, DV sort_f t_f, DV sort_b t_b]))
  = OK (LIST sort term*[n_f : n])
  -- if n_f = $nat_of($text_to_int(t_f))
  -- if n_b = $nat_of($text_to_int(t_b))
  -- if n = $nat_of($(|term*| - n_f - n_b))
;; The elements from n on replaced by term_s*. Out of range fails, as K
;; documents; hook_LIST_updateAll does not check it when n is 0
def $hook(D, "LIST.updateAll", sort,
  ([LIST sort_l term*, DV sort_i t_i, LIST sort_s term_s*]))
  = OK (LIST sort (term*[0 : n] ++ term_s* ++ term*[n_a : n_r]))
  -- if n = $nat_of($text_to_int(t_i))
  -- if n_a = $(n + |term_s*|)
  -- if n_r = $nat_of($(|term*| - n_a))
;; n_l elements from n on replaced by term_v; out of range fails, as for
;; updateAll (hook_LIST_fill does not check it when n or n_l is 0)
def $hook(D, "LIST.fill", sort,
  ([LIST sort_l term*, DV sort_i t_i, DV sort_n t_n, term_v]))
  = OK (LIST sort (term*[0 : n] ++ $repeat_<term>(term_v, n_l) ++ term*[n_a : n_r]))
  -- if n = $nat_of($text_to_int(t_i))
  -- if n_l = $nat_of($text_to_int(t_n))
  -- if n_a = $(n + n_l)
  -- if n_r = $nat_of($(|term*| - n_a))

;; Machine-integer indices and sizes, of an MInt literal NpW of sort
;; MInt{SortW}: the index is the integer N, as the LLVM backend reads a 64-bit
;; one (a 256-bit one it cuts to 64 bits, which no list reaches)
def $hook(D, "LIST.getMInt", sort, ([LIST sort_l term*, DV sort_i t_i]))
  = $hook(D, "LIST.get", sort, ([LIST sort_l term*, DV sort_i $text_before(t_i, "p")]))
def $hook(D, "LIST.updateMInt", sort, ([LIST sort_l term*, DV sort_i t_i, term_v]))
  = $hook(D, "LIST.update", sort,
          ([LIST sort_l term*, DV sort_i $text_before(t_i, "p"), term_v]))
def $hook(D, "LIST.sizeMInt", sort, ([LIST sort_l term*]))
  = OK (DV sort ($int_text($(|term*|)) ++ "p" ++ $drop_prefix(sortid_w, "Sort")))
  -- if SORT sortid_m ([SORT sortid_w eps]) = sort

;;; MAP
;;; A map keeps its entries in order, as a set does, so that maps with the same
;;; entries are the same value, as K compares them (KEQUAL.eq in 5.2-hook).

def $hook(D, "MAP.unit", sort, eps) = OK (MAP sort `{ eps `})
def $hook(D, "MAP.element", sort, ([term_k, term_v]))
  = OK (MAP sort `{ term_k ':' term_v `})
;; Concatenation of maps with no key in common, as hook_MAP_concat fails on a
;; duplicate key
def $hook(D, "MAP.concat", sort, ([MAP sort_1 M_1, MAP sort_2 M_2]))
  = OK (MAP sort $union_set<pair<term, term>>(M_1, M_2))
  -- if `{ (term_k1 ':' term_v1)* `} = M_1
  -- if `{ (term_k2 ':' term_v2)* `} = M_2
  -- if $intersect_set<term>(`{ term_k1* `}, `{ term_k2* `}) = `{ eps `}
def $hook(D, "MAP.lookup", sort, ([MAP sort_m M, term_k])) = OK term_v
  -- if term_v = $find_map<term, term>(M, term_k)
def $hook(D, "MAP.keys", sort, ([MAP sort_m `{ (term_k ':' term_v)* `}]))
  = OK (SET sort `{ term_k* `})
def $hook(D, "MAP.update", sort, ([MAP sort_m M, term_k, term_v]))
  = OK (MAP sort $sorted_set<pair<term, term>>(
           $update_map<term, term>(M, term_k, term_v)))
def $hook(D, "MAP.in_keys", sort, ([term_k, MAP sort_m `{ (term_k' ':' term_v')* `}]))
  = OK (DV sort $bool_text(term_k <- term_k'*))
def $hook(D, "MAP.lookupOrDefault", sort, ([MAP sort_m M, term_k, term_d]))
  = OK term_v
  -- if term_v = $find_map<term, term>(M, term_k)
def $hook(D, "MAP.lookupOrDefault", sort, ([MAP sort_m M, term_k, term_d]))
  = OK term_d
  -- if eps = $find_map<term, term>(M, term_k)
;;; inclusion: whether the entries of the first are in the second, so true for
;;; equal maps, as in the LLVM backend; domains.md says "strict subset"

def $hook(D, "MAP.inclusion", sort, ([MAP sort_1 M_1, MAP sort_2 M_2]))
  = OK (DV sort $bool_text($diff_set<pair<term, term>>(M_1, M_2) = `{ eps `}))
def $hook(D, "MAP.size", sort, ([MAP sort_m `{ (term_k ':' term_v)* `}]))
  = OK (DV sort $int_text($(|term_k*|)))

;;; choice: the smallest element here, the first in its hash trie in the LLVM
;;; backend; they agree on a collection of one element

def $hook(D, "MAP.choice", sort, ([MAP sort_m `{ (term_k ':' term_v)* `}]))
  = OK term
  -- if `{ term :: term_t* `} = $sorted_set<term>(`{ term_k* `})

;;; Removing keys: M[K <- undef], removeAll(M, S); a key not in the map is
;;; left alone

dec $remove_keys(map<term, term>, term*) : map<term, term>
def $remove_keys(M, eps) = M
def $remove_keys(M, (term_k :: term*))
  = $remove_keys($diff_set<pair<term, term>>(M, `{ term_k ':' term_v `}), term*)
  -- if term_v = $find_map<term, term>(M, term_k)
def $remove_keys(M, (term_k :: term*)) = $remove_keys(M, term*)
  -- if eps = $find_map<term, term>(M, term_k)

def $hook(D, "MAP.remove", sort, ([MAP sort_m M, term_k]))
  = OK (MAP sort $remove_keys(M, ([ term_k ])))
def $hook(D, "MAP.removeAll", sort, ([MAP sort_m M, SET sort_s `{ term_s* `}]))
  = OK (MAP sort $remove_keys(M, term_s*))

;;; M1 -Map M2 takes off the entries of M1 that are in M2, key and value;
;;; updateMap(M1, M2) gives M2's value to a key in both

def $hook(D, "MAP.difference", sort, ([MAP sort_1 M_1, MAP sort_2 M_2]))
  = OK (MAP sort $diff_set<pair<term, term>>(M_1, M_2))
def $hook(D, "MAP.updateAll", sort, ([MAP sort_1 M_1, MAP sort_2 M_2]))
  = OK (MAP sort $union_set<pair<term, term>>($remove_keys(M_1, term_k*), M_2))
  -- if `{ (term_k ':' term_v)* `} = M_2

;;; keys_list, values: the keys and the values in the order of the map here,
;;; the order of its hash trie in the LLVM backend, as for Set2List

def $hook(D, "MAP.keys_list", sort, ([MAP sort_m `{ (term_k ':' term_v)* `}]))
  = OK (LIST sort term_k*)
def $hook(D, "MAP.values", sort, ([MAP sort_m `{ (term_k ':' term_v)* `}]))
  = OK (LIST sort term_v*)

;;; SET

def $hook(D, "SET.unit", sort, eps) = OK (SET sort `{ eps `})
def $hook(D, "SET.element", sort, ([term])) = OK (SET sort `{ term `})
def $hook(D, "SET.concat", sort, ([SET sort_1 S_1, SET sort_2 S_2]))
  = OK (SET sort $union_set<term>(S_1, S_2))
def $hook(D, "SET.inclusion", sort, ([SET sort_1 S_1, SET sort_2 S_2]))
  = OK (DV sort $bool_text($diff_set<term>(S_1, S_2) = `{ eps `}))
def $hook(D, "SET.difference", sort, ([SET sort_1 S_1, SET sort_2 S_2]))
  = OK (SET sort $diff_set<term>(S_1, S_2))
def $hook(D, "SET.intersection", sort, ([SET sort_1 S_1, SET sort_2 S_2]))
  = OK (SET sort $intersect_set<term>(S_1, S_2))
def $hook(D, "SET.choice", sort, ([SET sort_s S])) = OK term
  -- if `{ term :: term_t* `} = $sorted_set<term>(S)
def $hook(D, "SET.in", sort, ([term, SET sort_s `{ term_e* `}]))
  = OK (DV sort $bool_text(term <- term_e*))
def $hook(D, "SET.union", sort, ([SET sort_1 S_1, SET sort_2 S_2]))
  = OK (SET sort $union_set<term>(S_1, S_2))
def $hook(D, "SET.size", sort, ([SET sort_s `{ term* `}]))
  = OK (DV sort $int_text($(|term*|)))

;;; Set2List: the elements in the order of the set here, the order of its hash
;;; trie in the LLVM backend; they agree on a set of one element

def $hook(D, "SET.set2list", sort, ([SET sort_s `{ term* `}]))
  = OK (LIST sort term*)

;;; List2Set: the elements of the list, once each

def $hook(D, "SET.list2set", sort, ([LIST sort_l term*]))
  = OK (SET sort $sorted_set<term>(`{ term* `}))

;;; RANGEMAP: maps from ranges of Int keys, as domains.md and the LLVM backend
;;; have them (only Int keys, "due to limitations of the underlying ordering
;;; function"). Inserting cuts the ranges it overlaps and merges those it
;;; touches with the same value.

dec $imin(int, int) : int
def $imin(i_1, i_2) = i_1
  -- if $(i_1 <= i_2)
def $imin(i_1, i_2) = i_2
  -- if $(i_1 > i_2)

dec $imax(int, int) : int
def $imax(i_1, i_2) = i_1
  -- if $(i_1 >= i_2)
def $imax(i_1, i_2) = i_2
  -- if $(i_1 < i_2)

;; Whether a range overlaps [i_s, i_e)

dec $overlaps(int, int, rangeitem) : bool
def $overlaps(i_s, i_e, RANGE i_rs i_re term) = $(i_re > i_s) /\ $(i_e > i_rs)

;; The parts of [i_rs, i_re) outside [i_a, i_b), with value term

dec $left_part(int, int, term) : rangeitem*
def $left_part(i_rs, i_a, term) = [ RANGE i_rs i_a term ]
  -- if $(i_rs < i_a)
def $left_part(i_rs, i_a, term) = eps
  -- if $(i_rs >= i_a)

dec $right_part(int, int, term) : rangeitem*
def $right_part(i_b, i_re, term) = [ RANGE i_b i_re term ]
  -- if $(i_re > i_b)
def $right_part(i_b, i_re, term) = eps
  -- if $(i_re <= i_b)

dec $outside(int, int, int, int, term) : rangeitem*
def $outside(i_rs, i_re, i_a, i_b, term)
  = $left_part(i_rs, i_a, term) ++ $right_part(i_b, i_re, term)

;; Removing [i_s, i_e): the ranges it overlaps are cut outside it

dec $rm_remove(rangeitem*, int, int) : rangeitem*
def $rm_remove(eps, i_s, i_e) = eps
def $rm_remove((RANGE i_rs i_re term_r) :: rangeitem_t*, i_s, i_e)
  = $outside(i_rs, i_re, i_s, i_e, term_r) ++ $rm_remove(rangeitem_t*, i_s, i_e)
  -- if $overlaps(i_s, i_e, RANGE i_rs i_re term_r)
def $rm_remove((RANGE i_rs i_re term_r) :: rangeitem_t*, i_s, i_e)
  = (RANGE i_rs i_re term_r) :: $rm_remove(rangeitem_t*, i_s, i_e)
  -- if ~$overlaps(i_s, i_e, RANGE i_rs i_re term_r)

dec $rm_remove_all(rangeitem*, (int, int)*) : rangeitem*
def $rm_remove_all(rangeitem*, eps) = rangeitem*
def $rm_remove_all(rangeitem*, (i_s, i_e) :: (i_ts, i_te)*)
  = $rm_remove_all($rm_remove(rangeitem*, i_s, i_e), (i_ts, i_te)*)

;; Inserting [i_s, i_e) |-> term: the range removed, the new one placed by its
;; start, and the ranges it touches with the same value merged with it

dec $place(rangeitem*, rangeitem) : rangeitem*
def $place(eps, rangeitem) = [ rangeitem ]
def $place((RANGE i_rs i_re term_r) :: rangeitem_t*, RANGE i_s i_e term)
  = (RANGE i_s i_e term) :: (RANGE i_rs i_re term_r) :: rangeitem_t*
  -- if $(i_s < i_rs)
def $place((RANGE i_rs i_re term_r) :: rangeitem_t*, RANGE i_s i_e term)
  = (RANGE i_rs i_re term_r) :: $place(rangeitem_t*, RANGE i_s i_e term)
  -- if $(i_s >= i_rs)

dec $rm_insert(rangeitem*, int, int, term) : rangeitem*
  hint(prose_in %0 "with" %1 "to" %2 "mapped to" %3)
def $rm_insert(rangeitem*, i_s, i_e, term)
  = $merge_ranges($place($rm_remove(rangeitem*, i_s, i_e), RANGE i_s i_e term))

dec $rm_insert_all(rangeitem*, rangeitem*) : rangeitem*
def $rm_insert_all(rangeitem*, eps) = rangeitem*
def $rm_insert_all(rangeitem*, (RANGE i_s i_e term) :: rangeitem_t*)
  = $rm_insert_all($rm_insert(rangeitem*, i_s, i_e, term), rangeitem_t*)

dec $rm_lookup(rangeitem*, int) : rangeitem?
def $rm_lookup(eps, i) = eps
def $rm_lookup((RANGE i_s i_e term) :: rangeitem_t*, i) = RANGE i_s i_e term
  -- if $(i_s <= i) /\ $(i < i_e)
def $rm_lookup((RANGE i_s i_e term) :: rangeitem_t*, i) = $rm_lookup(rangeitem_t*, i)
  -- if ~($(i_s <= i) /\ $(i < i_e))

;; Concatenation requires that no ranges overlap

dec $overlaps_any(rangeitem*, int, int) : bool
def $overlaps_any(eps, i_s, i_e) = false
def $overlaps_any(rangeitem_h :: rangeitem_t*, i_s, i_e)
  = $overlaps(i_s, i_e, rangeitem_h) \/ $overlaps_any(rangeitem_t*, i_s, i_e)

dec $disjoint(rangeitem*, rangeitem*) : bool
def $disjoint(rangeitem*, eps) = true
def $disjoint(rangeitem*, (RANGE i_s i_e term) :: rangeitem_t*)
  = ~$overlaps_any(rangeitem*, i_s, i_e) /\ $disjoint(rangeitem*, rangeitem_t*)

;; Where two range maps agree: the overlaps of their ranges with equal values
;; (get_intersection_ranges of the LLVM backend)

dec $agree_one(rangeitem, rangeitem*) : (int, int)*
def $agree_one(rangeitem, eps) = eps
def $agree_one(RANGE i_s i_e term, (RANGE i_s' i_e' term') :: rangeitem_t*)
  = ($imax(i_s, i_s'), $imin(i_e, i_e')) :: $agree_one(RANGE i_s i_e term, rangeitem_t*)
  -- if $overlaps(i_s, i_e, RANGE i_s' i_e' term') /\ term = term'
def $agree_one(RANGE i_s i_e term, (RANGE i_s' i_e' term') :: rangeitem_t*)
  = $agree_one(RANGE i_s i_e term, rangeitem_t*)
  -- if ~($overlaps(i_s, i_e, RANGE i_s' i_e' term') /\ term = term')

dec $agree(rangeitem*, rangeitem*) : (int, int)*
def $agree(eps, rangeitem'*) = eps
def $agree(rangeitem_h :: rangeitem_t*, rangeitem'*)
  = $agree_one(rangeitem_h, rangeitem'*) ++ $agree(rangeitem_t*, rangeitem'*)

dec $range_pairs(rangeitem*) : (int, int)*
def $range_pairs((RANGE i_s i_e term)*) = (i_s, i_e)*

;; The ranges of a set of range keys; another element fails

dec $set_ranges(term*) : res<(int, int)*>
def $set_ranges(eps) = OK eps
def $set_ranges(term_h :: term_t*) = OK ((i_s, i_e) :: (i_ts, i_te)*)
  -- if (i_s, i_e) = $range_bounds(term_h)
  -- if OK (i_ts, i_te)* = $set_ranges(term_t*)
def $set_ranges(term*) = ERROR
  -- otherwise

;; An empty range [i_s, i_e), i_s >= i_e, given to insert or remove fails, as in
;; the LLVM backend; the ranges of a range map are never empty

def $hook(D, "RANGEMAP.unit", sort, eps) = OK (RANGEMAP sort eps)
def $hook(D, "RANGEMAP.elementRng", sort, ([term_r, term_v]))
  = OK (RANGEMAP sort $rm_insert(eps, i_s, i_e, term_v))
  -- if (i_s, i_e) = $range_bounds(term_r)
  -- if $(i_s < i_e)
def $hook(D, "RANGEMAP.concat", sort,
          ([RANGEMAP sort_1 rangeitem_1*, RANGEMAP sort_2 rangeitem_2*]))
  = OK (RANGEMAP sort $rm_insert_all(rangeitem_1*, rangeitem_2*))
  -- if $disjoint(rangeitem_1*, rangeitem_2*)
def $hook(D, "RANGEMAP.updateRng", sort, ([RANGEMAP sort_m rangeitem_m*, term_r, term_v]))
  = OK (RANGEMAP sort_m $rm_insert(rangeitem_m*, i_s, i_e, term_v))
  -- if (i_s, i_e) = $range_bounds(term_r)
  -- if $(i_s < i_e)
def $hook(D, "RANGEMAP.updateAll", sort,
          ([RANGEMAP sort_1 rangeitem_1*, RANGEMAP sort_2 rangeitem_2*]))
  = OK (RANGEMAP sort_1 $rm_insert_all(rangeitem_1*, rangeitem_2*))
def $hook(D, "RANGEMAP.removeRng", sort, ([RANGEMAP sort_m rangeitem_m*, term_r]))
  = OK (RANGEMAP sort_m $rm_remove(rangeitem_m*, i_s, i_e))
  -- if (i_s, i_e) = $range_bounds(term_r)
  -- if $(i_s < i_e)
def $hook(D, "RANGEMAP.removeAll", sort,
          ([RANGEMAP sort_m rangeitem_m*, SET sort_s `{ term* `}]))
  = OK (RANGEMAP sort_m $rm_remove_all(rangeitem_m*, (i_s, i_e)*))
  -- if OK (i_s, i_e)* = $set_ranges(term*)
  -- if $forall_($(i_s < i_e)*)
def $hook(D, "RANGEMAP.difference", sort,
          ([RANGEMAP sort_1 rangeitem_1*, RANGEMAP sort_2 rangeitem_2*]))
  = OK (RANGEMAP sort_1 $rm_remove_all(rangeitem_1*, $agree(rangeitem_1*, rangeitem_2*)))
def $hook(D, "RANGEMAP.inclusion", sort,
          ([RANGEMAP sort_1 rangeitem_1*, RANGEMAP sort_2 rangeitem_2*]))
  = OK (DV sort $bool_text($range_pairs(rangeitem_1*) = $agree(rangeitem_1*, rangeitem_2*)))
def $hook(D, "RANGEMAP.lookup", sort, ([RANGEMAP sort_m rangeitem*, term_k])) = OK term_v
  -- if i = $key_int(term_k)
  -- if (RANGE i_s i_e term_v) = $rm_lookup(rangeitem*, i)
def $hook(D, "RANGEMAP.lookupOrDefault", sort, ([RANGEMAP sort_m rangeitem*, term_k, term_d]))
  = OK term_v
  -- if i = $key_int(term_k)
  -- if (RANGE i_s i_e term_v) = $rm_lookup(rangeitem*, i)
def $hook(D, "RANGEMAP.lookupOrDefault", sort, ([RANGEMAP sort_m rangeitem*, term_k, term_d]))
  = OK term_d
  -- if i = $key_int(term_k)
  -- if eps = $rm_lookup(rangeitem*, i)
def $hook(D, "RANGEMAP.find_range", sort, ([RANGEMAP sort_m rangeitem*, term_k]))
  = OK $range_term(i_s, i_e)
  -- if i = $key_int(term_k)
  -- if (RANGE i_s i_e term_v) = $rm_lookup(rangeitem*, i)
def $hook(D, "RANGEMAP.in_keys", sort, ([term_k, RANGEMAP sort_m rangeitem*]))
  = OK (DV sort "true")
  -- if i = $key_int(term_k)
  -- if (RANGE i_s i_e term_v) = $rm_lookup(rangeitem*, i)
def $hook(D, "RANGEMAP.in_keys", sort, ([term_k, RANGEMAP sort_m rangeitem*]))
  = OK (DV sort "false")
  -- if i = $key_int(term_k)
  -- if eps = $rm_lookup(rangeitem*, i)
def $hook(D, "RANGEMAP.keys", sort, ([RANGEMAP sort_m (RANGE i_s i_e term)*]))
  = OK (SET sort $sorted_set<term>(`{ $range_key(i_s, i_e)* `}))
def $hook(D, "RANGEMAP.keys_list", sort, ([RANGEMAP sort_m (RANGE i_s i_e term)*]))
  = OK (LIST sort $range_key(i_s, i_e)*)
def $hook(D, "RANGEMAP.values", sort, ([RANGEMAP sort_m (RANGE i_s i_e term)*]))
  = OK (LIST sort term*)
def $hook(D, "RANGEMAP.size", sort, ([RANGEMAP sort_m rangeitem*]))
  = OK (DV sort $int_text($(|rangeitem*|)))
;; choice: the start of the first range, as hook_RANGEMAP_choice gives a key
def $hook(D, "RANGEMAP.choice", sort, ([RANGEMAP sort_m ((RANGE i_s i_e term) :: rangeitem_t*)]))
  = OK $int_key(i_s)

;;; Any other hook on K terms is not supported (yet)

def $hook(D, hookid, sort, term*) = ERROR
  -- otherwise
