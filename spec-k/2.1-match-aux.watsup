;;
;; Definition lookups, subsorts, and equality and construction of terms
;;

var D : definition
var kind : symkind
var M : map<term, term>
var S : set<term>

syntax subst = map<varid, term>

;; Definition lookups

dec $find_symdecl(definition, symid) : symdecl?
  hint(prose_in "the declaration of symbol" %1)
def $find_symdecl(D, symid) = $find_map<symid, symdecl>(D.SYMBOLS, symid)

dec $kind_of(symdecl?) : symkind?
def $kind_of(eps) = eps
def $kind_of(sort_a* '->' sort kind) = kind

dec $hook_of_kind(symkind?) : hookid?
def $hook_of_kind(HOOKED hookid) = hookid
def $hook_of_kind(kind?) = eps
  -- otherwise

dec $hook_of(definition, symid) : hookid?
  hint(prose_in "the hook of symbol" %1)
def $hook_of(D, symid) = $hook_of_kind($kind_of($find_symdecl(D, symid)))

;; Subsorting: D.SUBSORTS, which $krun closes transitively before running
;; (kompile does not always, as in LAMBDA)

dec $is_subsort(definition, sort, sort) : bool
  hint(prose_true %1 "is a subsort of" %2)
def $is_subsort(D, sort_1, sort_2) = (sort_1 '<' sort_2) <- D.SUBSORTS

;; Transitive closure of a subsort relation (the relation is acyclic)

var SM : map<sort, sort*>

dec $direct_supersorts(map<sort, sort*>, sort) : sort*
  hint(prose_in "the direct supersorts of" %1)
def $direct_supersorts(SM, sort) = sort_s*
  -- if (sort_s*) = $find_map<sort, sort*>(SM, sort)
def $direct_supersorts(SM, sort) = eps
  -- otherwise

dec $supersort_map(subsort*) : map<sort, sort*>
def $supersort_map(eps) = $empty_map<sort, sort*>
def $supersort_map((sort_a '<' sort_b) :: subsort_t*)
  = $update_map<sort, sort*>(SM, sort_a,
                             sort_b :: $direct_supersorts(SM, sort_a))
  -- if SM = $supersort_map(subsort_t*)

dec $reachable(map<sort, sort*>, sort*, sort*) : sort*
def $reachable(SM, eps, sort_s*) = sort_s*
def $reachable(SM, sort_h :: sort_t*, sort_s*)
  = $reachable(SM, sort_t*, sort_s*)
  -- if sort_h <- sort_s*
def $reachable(SM, sort_h :: sort_t*, sort_s*)
  = $reachable(SM, $direct_supersorts(SM, sort_h) ++ sort_t*,
               sort_s* ++ [ sort_h ])
  -- if ~(sort_h <- sort_s*)

dec $subsorts_from(map<sort, sort*>, sort) : subsort*
def $subsorts_from(SM, sort) = (sort '<' sort_u)*
  -- if sort_u* = $reachable(SM, $direct_supersorts(SM, sort), eps)

dec $close_subsorts(subsort*) : subsort*
  hint(prose_in "the transitive closure of" %0)
def $close_subsorts(subsort*) = $concat_<subsort>($subsorts_from(SM, sort_a)*)
  -- if SM = $supersort_map(subsort*)
  -- if `{ (sort_a ':' sort_b*)* `} = SM

;; Equality of terms, as KEQUAL.eq: structural, except that maps and sets are
;; compared as sets of entries

dec $term_eq(term, term) : bool
dec $terms_eq(term*, term*) : bool
def $term_eq(APP symid sort* term*, APP symid' sort'* term'*)
  = symid = symid' /\ sort* = sort'* /\ $terms_eq(term*, term'*)
def $term_eq(MAP sort M, MAP sort' M')
  = sort = sort' /\ $eq_set<pair<term, term>>(M, M')
def $term_eq(SET sort S, SET sort' S') = sort = sort' /\ $eq_set<term>(S, S')
def $term_eq(LIST sort term*, LIST sort' term'*)
  = sort = sort' /\ $terms_eq(term*, term'*)
def $term_eq(RANGEMAP sort (RANGE i_s i_e term)*,
             RANGEMAP sort' (RANGE i_s' i_e' term')*)
  = sort = sort' /\ i_s* = i_s'* /\ i_e* = i_e'* /\ $terms_eq(term*, term'*)
def $term_eq(term_1, term_2) = term_1 = term_2
  -- otherwise
def $terms_eq(eps, eps) = true
def $terms_eq(term_h :: term_t*, term_h' :: term_t'*)
  = $term_eq(term_h, term_h') /\ $terms_eq(term_t*, term_t'*)
def $terms_eq(term*, term'*) = false
  -- otherwise

;; Building constructor terms: nested injections are composed,
;; inj{B,C}(inj{A,B}(t)) = inj{A,C}(t)

dec $construct(symid, sort*, term*) : term
def $construct("inj", ([sort_b, sort_c]),
               ([APP "inj" ([sort_a, sort_b']) ([term])]))
  = APP "inj" ([sort_a, sort_c]) ([term])
  -- if sort_b = sort_b'
def $construct(symid, sort*, term*) = APP symid sort* term*
  -- otherwise
