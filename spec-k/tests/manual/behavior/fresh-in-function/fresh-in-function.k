// A fresh variable in a function equation (kast.md: a value distinct from
// any other generated by !X). krun gives the fresh value of a rule and the
// first fresh value of a function called on its right-hand side the same
// value, 0, 0, 1: the function reads the counter of the configuration the
// rule matched, before the rule takes its own value from it. The spec gives
// 0, -1, -2.
module FRESH-IN-FUNCTION
  imports INT
  imports LIST

  configuration <k> $PGM:Pgm </k>

  syntax Pgm ::= alongside(Int)
  syntax Int ::= fr(Int) [function]
  rule fr(_) => !_I:Int
  rule <k> alongside(N) => ListItem(!_X:Int) ListItem(fr(N)) ListItem(fr(N)) </k>
endmodule
