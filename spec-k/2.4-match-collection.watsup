;;
;; Matching collection patterns against maps, sets, and lists
;;

;;; The parts other than elements match what is left: nothing, or one pattern

rule Match_rest/empty-map:
  D (OK subst) |- eps ~~ MAP sort `{ eps `} : [ OK subst ]

rule Match_rest/empty-set:
  D (OK subst) |- eps ~~ SET sort `{ eps `} : [ OK subst ]

rule Match_rest/one:
  D (OK subst) |- ([ pattern ]) ~~ term : way*
  -- Match: D (OK subst) |- pattern ~~ term : way*

rule Match_rest/fail:
  D way |- pattern* ~~ term : eps
  -- otherwise

;;; Maps: an element whose key has its variables bound is looked up, and the
;;; match is stuck if the key cannot be evaluated; otherwise each entry is
;;; tried in turn

rule Match_map/rest:
  D (OK subst) |- eps pattern_o* ~~ sort M : way*
  -- Match_rest: D (OK subst) |- pattern_o* ~~ MAP sort M : way*

rule Match_map/lookup:
  D (OK subst) |- (APP symid sort_e* ([pattern_k, pattern_v]) :: pattern_e*) pattern_o* ~~ sort M : $concat_<way>(way_r**)
  -- if $bound(subst, pattern_k)
  -- Eval: D subst |- pattern_k : OK term_k
  -- if term_v = $find_map<term, term>(M, term_k)
  -- Match: D (OK subst) |- pattern_v ~~ term_v : way_v*
  -- (Match_map: D way_v |- pattern_e* pattern_o* ~~ sort $diff_set<pair<term, term>>(M, `{ term_k ':' term_v `}) : way_r*)*

rule Match_map/absent:
  D (OK subst) |- (APP symid sort_e* ([pattern_k, pattern_v]) :: pattern_e*) pattern_o* ~~ sort M : eps
  -- if $bound(subst, pattern_k)
  -- Eval: D subst |- pattern_k : OK term_k
  -- if eps = $find_map<term, term>(M, term_k)

rule Match_map/stuck:
  D (OK subst) |- (APP symid sort_e* ([pattern_k, pattern_v]) :: pattern_e*) pattern_o* ~~ sort M : [ FAIL ]
  -- if $bound(subst, pattern_k)
  -- Eval: D subst |- pattern_k : FAIL

rule Match_map/choose:
  D (OK subst) |- (APP symid sort_e* ([pattern_k, pattern_v]) :: pattern_e*) pattern_o* ~~ sort `{ (term_k ':' term_v)* `} : way*
  -- if ~$bound(subst, pattern_k)
  -- Choose_map: D (OK subst) |- pattern_k pattern_v pattern_e* pattern_o* ~~ sort `{ (term_k ':' term_v)* `} (term_k, term_v)* : way*

rule Choose_map/none:
  D (OK subst) |- pattern_k pattern_v pattern_e* pattern_o* ~~ sort M eps : eps

rule Choose_map/entry:
  D (OK subst) |- pattern_k pattern_v pattern_e* pattern_o* ~~ sort M ((term_k, term_v) :: (term_k', term_v')*) : $concat_<way>(way_r**) ++ way_t*
  -- Match: D (OK subst) |- pattern_k ~~ term_k : way_k*
  -- (Match: D way_k |- pattern_v ~~ term_v : way_v*)*
  -- if way_kv* = $concat_<way>(way_v**)
  -- (Match_map: D way_kv |- pattern_e* pattern_o* ~~ sort $diff_set<pair<term, term>>(M, `{ term_k ':' term_v `}) : way_r*)*
  -- Choose_map: D (OK subst) |- pattern_k pattern_v pattern_e* pattern_o* ~~ sort M (term_k', term_v')* : way_t*

;;; Sets: an element with its variables bound is checked for membership, as
;;; keys of maps are; otherwise each element is tried in turn

rule Match_set/rest:
  D (OK subst) |- eps pattern_o* ~~ sort S : way*
  -- Match_rest: D (OK subst) |- pattern_o* ~~ SET sort S : way*

rule Match_set/member:
  D (OK subst) |- (APP symid sort_e* ([pattern]) :: pattern_e*) pattern_o* ~~ sort `{ term_s* `} : way*
  -- if $bound(subst, pattern)
  -- Eval: D subst |- pattern : OK term
  -- if term <- term_s*
  -- Match_set: D (OK subst) |- pattern_e* pattern_o* ~~ sort $diff_set<term>(`{ term_s* `}, `{ term `}) : way*

rule Match_set/absent:
  D (OK subst) |- (APP symid sort_e* ([pattern]) :: pattern_e*) pattern_o* ~~ sort `{ term_s* `} : eps
  -- if $bound(subst, pattern)
  -- Eval: D subst |- pattern : OK term
  -- if ~(term <- term_s*)

rule Match_set/stuck:
  D (OK subst) |- (APP symid sort_e* ([pattern]) :: pattern_e*) pattern_o* ~~ sort S : [ FAIL ]
  -- if $bound(subst, pattern)
  -- Eval: D subst |- pattern : FAIL

rule Match_set/choose:
  D (OK subst) |- (APP symid sort_e* ([pattern]) :: pattern_e*) pattern_o* ~~ sort `{ term_s* `} : way*
  -- if ~$bound(subst, pattern)
  -- Choose_set: D (OK subst) |- pattern pattern_e* pattern_o* ~~ sort `{ term_s* `} term_s* : way*

rule Choose_set/none:
  D (OK subst) |- pattern pattern_e* pattern_o* ~~ sort S eps : eps

rule Choose_set/element:
  D (OK subst) |- pattern pattern_e* pattern_o* ~~ sort S (term_h :: term_t*) : $concat_<way>(way_r**) ++ way_t*
  -- Match: D (OK subst) |- pattern ~~ term_h : way_h*
  -- (Match_set: D way_h |- pattern_e* pattern_o* ~~ sort $diff_set<term>(S, `{ term_h `}) : way_r*)*
  -- Choose_set: D (OK subst) |- pattern pattern_e* pattern_o* ~~ sort S term_t* : way_t*

;;; Lists: elements before the other part match the front, elements after it
;;; match the back, and the other part matches the list in between

rule Match_seq/end:
  D (OK subst) |- eps ~~ sort eps : [ OK subst ]

rule Match_seq/longer:
  D (OK subst) |- eps ~~ sort (term_h :: term_t*) : eps

rule Match_seq/element:
  D (OK subst) |- (APP symid sort_e* ([pattern]) :: pattern_t*) ~~ sort (term_h :: term_t*) : $concat_<way>(way_r**)
  -- if $hook_of(D, symid) = "LIST.element"
  -- Match: D (OK subst) |- pattern ~~ term_h : way_h*
  -- (Match_seq: D way_h |- pattern_t* ~~ sort term_t* : way_r*)*

rule Match_seq/shorter:
  D (OK subst) |- (APP symid sort_e* ([pattern]) :: pattern_t*) ~~ sort eps : eps
  -- if $hook_of(D, symid) = "LIST.element"

rule Match_seq/middle:
  D (OK subst) |- (pattern_o :: pattern_t*) ~~ sort term* : $concat_<way>(way_r**)
  -- if ~$is_element(D, "LIST", pattern_o)
  -- if $(|term*| >= |pattern_t*|)
  -- if n_m = $(|term*| - |pattern_t*|)
  -- Match: D (OK subst) |- pattern_o ~~ LIST sort term*[0 : n_m] : way_o*
  -- (Match_seq: D way_o |- pattern_t* ~~ sort term*[n_m : |pattern_t*|] : way_r*)*

rule Match_seq/too-short:
  D (OK subst) |- (pattern_o :: pattern_t*) ~~ sort term* : eps
  -- if ~$is_element(D, "LIST", pattern_o)
  -- if $(|term*| < |pattern_t*|)
