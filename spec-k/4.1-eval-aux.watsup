;;
;; Equations in priority order, and symbol lookups
;;

var eqn : equation

;; Priorities, as rulePriority in the LLVM backend's matching/Parser.scala
;; (a smaller number is tried first). cool and cool-like only occur on rewrite
;; rules and only count outside --search mode.

dec $is_priority(attr) : bool
def $is_priority(PRIORITY n) = true
def $is_priority(attr) = false
  -- otherwise

dec $priority_value(attr*) : nat?
def $priority_value(eps) = eps
def $priority_value((PRIORITY n) :: attr_t*) = n
def $priority_value(attr_h :: attr_t*) = $priority_value(attr_t*)
  -- if ~$is_priority(attr_h)

dec $priority(attr*) : nat
  hint(prose_in "the priority given by" %0)
def $priority(attr*) = 200
  -- if OWISE <- attr*
def $priority(attr*) = 150
  -- if ~(OWISE <- attr*) /\ COOL <- attr*
def $priority(attr*) = 100
  -- if ~(OWISE <- attr*) /\ ~(COOL <- attr*) /\ COOLLIKE <- attr*
def $priority(attr*) = n
  -- if ~(OWISE <- attr*) /\ ~(COOL <- attr*) /\ ~(COOLLIKE <- attr*)
  -- if n = $priority_value(attr*)
def $priority(attr*) = 50
  -- otherwise

;; Stable sort by priority: for each priority, smallest first, the entries
;; with that priority in their order, which is the order of the KORE file, as
;; the LLVM backend sorts axioms stably by priority.

dec $if_priority<X>(nat, nat, X) : X*
def $if_priority<X>(n_p, n, X) = [ X ]
  -- if n = n_p
def $if_priority<X>(n_p, n, X) = eps
  -- otherwise

dec $by_priorities<X>(nat*, (nat, X)*) : X*
def $by_priorities<X>(eps, (n, X)*) = eps
def $by_priorities<X>(n_h :: n_t*, (n, X)*)
  = $concat_<X>($if_priority<X>(n_h, n, X)*) ++ $by_priorities<X>(n_t*, (n, X)*)

dec $sort_by_priority<X>((nat, X)*) : X*
def $sort_by_priority<X>((n, X)*) = $by_priorities<X>(n_p*, (n, X)*)
  -- if `{ n_p* `} = $union_set<nat>(`{ n* `}, `{ eps `})

;; Equations of a function symbol, in the order they are tried. The definition
;; groups equations by the symbol they define, in file order; $krun orders each
;; group by priority once (6-entry).

dec $prioritized(equation*) : (nat, equation)*
def $prioritized(eps) = eps
def $prioritized(
    (EQN symid pattern_a* '=' pattern_r 'requires' pattern_c? attr*) :: eqn_t*)
  = ($priority(attr*),
     EQN symid pattern_a* '=' pattern_r 'requires' pattern_c? attr*)
    :: $prioritized(eqn_t*)

dec $sorted_equations(map<symid, equation*>) : map<symid, equation*>
def $sorted_equations(`{ (symid ':' eqn*)* `})
  = `{ (symid ':' $sort_by_priority<equation>($prioritized(eqn*)))* `}

dec $equations_of(definition, symid) : equation*
  hint(prose_in "the equations of" %1 "in priority order")
def $equations_of(D, symid) = eqn*
  -- if (eqn*) = $find_map<symid, equation*>(D.EQUATIONS, symid)
def $equations_of(D, symid) = eps
  -- otherwise

;; Symbol lookups

dec $kind_of_symbol(definition, symid) : symkind?
def $kind_of_symbol(D, symid) = $kind_of($find_symdecl(D, symid))

dec $sort_of_decl(symdecl?) : sort?
def $sort_of_decl(eps) = eps
def $sort_of_decl(sort_a* '->' sort kind) = sort

dec $result_sort(definition, symid) : sort?
  hint(prose_in "the result sort of" %1)
def $result_sort(D, symid) = $sort_of_decl($find_symdecl(D, symid))

;; The result sort of an application of a parametric symbol, with its sort
;; parameters replaced by the sort arguments, e.g. MInt{Sort8} for
;; Int2MInt{Sort8}; hooks of MInt read the width from it

dec $lookup_param(sortid*, sort*, sortid) : sort?
def $lookup_param(sortid_h :: sortid_t*, sort_h :: sort_t*, sortid) = sort_h
  -- if sortid_h = sortid
def $lookup_param(sortid_h :: sortid_t*, sort_h :: sort_t*, sortid)
  = $lookup_param(sortid_t*, sort_t*, sortid)
  -- if sortid_h =/= sortid
def $lookup_param(sortid_p*, sort_a*, sortid) = eps
  -- otherwise

dec $sort_instance(sortid*, sort*, sort) : sort
def $sort_instance(sortid_p*, sort_a*, SORTVAR sortid) = sort
  -- if sort = $lookup_param(sortid_p*, sort_a*, sortid)
def $sort_instance(sortid_p*, sort_a*, SORT sortid sort_s*)
  = SORT sortid $sort_instance(sortid_p*, sort_a*, sort_s)*
def $sort_instance(sortid_p*, sort_a*, sort) = sort
  -- otherwise

dec $result_instance(definition, symid, sort*) : sort?
  hint(prose_in "the result sort of" %1 "applied with sorts" %2)
def $result_instance(D, symid, sort_a*)
  = $sort_instance(sortid_p*, sort_a*, sort_r)
  -- if sort_r = $result_sort(D, symid)
  -- if (sortid_p*) = $find_map<symid, sortid*>(D.PARAMS, symid)
def $result_instance(D, symid, sort_a*) = $result_sort(D, symid)
  -- if eps = $find_map<symid, sortid*>(D.PARAMS, symid)

;; Hooks whose arguments are evaluated lazily (create_hardcoded_hook): the
;; hook of the symbol, or "" for any other symbol

dec $lazy_hook(definition, symid) : text
def $lazy_hook(D, symid) = hookid
  -- if hookid = $hook_of(D, symid)
  -- if hookid <- [ "BOOL.and", "BOOL.andThen", "BOOL.or", "BOOL.orElse",
                   "BOOL.implies", "KEQUAL.ite" ]
def $lazy_hook(D, symid) = ""
  -- otherwise
