;;
;; Symbol lookups
;;

;; The equations of a symbol, in the order they are tried (6-load)

dec $equations_of(definition, symid) : clause*
  hint(prose_in "the equations of" %1)
def $equations_of(D, symid) = clause*
  -- if (clause*) = $find_map<symid, clause*>(D.EQUATIONS, symid)
def $equations_of(D, symid) = eps
  -- otherwise

;; Symbol lookups

dec $kind_of_symbol(definition, symid) : symkind?
def $kind_of_symbol(D, symid) = $kind_of($find_symdecl(D, symid))

dec $sort_of_decl(symdecl?) : sort?
def $sort_of_decl(eps) = eps
def $sort_of_decl(sort_a* '->' sort kind) = sort

dec $result_sort(definition, symid) : sort?
  hint(prose_in "the result sort of" %1)
def $result_sort(D, symid) = $sort_of_decl($find_symdecl(D, symid))

;; The result sort of an application of a parametric symbol, with its sort
;; parameters replaced by the sort arguments

dec $lookup_param(sortid*, sort*, sortid) : sort?
def $lookup_param(sortid_h :: sortid_t*, sort_h :: sort_t*, sortid) = sort_h
  -- if sortid_h = sortid
def $lookup_param(sortid_h :: sortid_t*, sort_h :: sort_t*, sortid)
  = $lookup_param(sortid_t*, sort_t*, sortid)
  -- if sortid_h =/= sortid
def $lookup_param(sortid_p*, sort_a*, sortid) = eps
  -- otherwise

dec $sort_instance(sortid*, sort*, sort) : sort
def $sort_instance(sortid_p*, sort_a*, SORTVAR sortid) = sort
  -- if sort = $lookup_param(sortid_p*, sort_a*, sortid)
def $sort_instance(sortid_p*, sort_a*, SORT sortid sort_s*)
  = SORT sortid $sort_instance(sortid_p*, sort_a*, sort_s)*
def $sort_instance(sortid_p*, sort_a*, sort) = sort
  -- otherwise

dec $result_instance(definition, symid, sort*) : sort?
  hint(prose_in "the result sort of" %1 "applied with sorts" %2)
def $result_instance(D, symid, sort_a*)
  = $sort_instance(sortid_p*, sort_a*, sort_r)
  -- if sort_r = $result_sort(D, symid)
  -- if (sortid_p*) = $find_map<symid, sortid*>(D.PARAMS, symid)
def $result_instance(D, symid, sort_a*) = $result_sort(D, symid)
  -- if eps = $find_map<symid, sortid*>(D.PARAMS, symid)

;; Hooks whose arguments are evaluated lazily (create_hardcoded_hook): the
;; hook of the symbol, or "" for any other symbol

dec $is_lazy(hookid) : bool
def $is_lazy(hookid) = hookid <- [ "BOOL.and", "BOOL.andThen", "BOOL.or",
                                   "BOOL.orElse", "BOOL.implies", "KEQUAL.ite" ]

dec $lazy_hook(definition, symid) : text
def $lazy_hook(D, symid) = hookid
  -- if hookid = $hook_of(D, symid)
  -- if $is_lazy(hookid)
def $lazy_hook(D, symid) = ""
  -- otherwise
