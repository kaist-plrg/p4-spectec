;;
;; Running a program: krun
;;
;;

;;; As the interpreter krun calls: evaluate the initial term, a call of
;;; initGeneratedTopCell, then rewrite until no rule applies or --depth

syntax runres =
  | FINAL nat term   ;; steps taken and the final configuration
  | ERROR nat term   ;; steps taken and the configuration where a step failed
  | INITFAIL         ;; the initial term cannot be evaluated

dec $run(definition, krule*, ruleindex, nat, nat?, term) : runres
  hint(prose_in "running from" %5 "after" %3 "steps")
dec $continue(definition, krule*, ruleindex, nat, nat?, term, stepres) : runres
def $run(D, krule*, ruleindex, n, n_max, term) = FINAL n term
  -- if n = n_max
def $run(D, krule*, ruleindex, n, n_max?, term)
  = $continue(D, krule*, ruleindex, n, n_max?, term,
              $step(D, $candidates(krule*, ruleindex, term), term))
  -- if n_max? =/= (n)

def $continue(D, krule*, ruleindex, n, n_max?, term, STUCK) = FINAL n term
def $continue(D, krule*, ruleindex, n, n_max?, term, ERROR) = ERROR n term
def $continue(D, krule*, ruleindex, n, n_max?, term, STEP term')
  = $run(D, krule*, ruleindex, $(n + 1), n_max?, term')

dec $krun(definition, pattern, nat?) : runres
  hint(prose_in "running" %1 "under" %0)
def $krun(D, pattern, n_max?)
  = $run(D', krule*, $index_rules(D', krule*), 0, n_max?, term)
  -- if D_s = D[ .SUBSORTS = $close_subsorts(D.SUBSORTS) ]
  -- if D' = D_s[ .EQUATIONS = $sorted_equations(D.EQUATIONS) ]
  -- if krule* = $rules_in_order(D')
  -- if OK term = $eval(D', $empty_map<varid, term>, pattern)
def $krun(D, pattern, n_max?) = INITFAIL
  -- if D_s = D[ .SUBSORTS = $close_subsorts(D.SUBSORTS) ]
  -- if D' = D_s[ .EQUATIONS = $sorted_equations(D.EQUATIONS) ]
  -- if FAIL = $eval(D', $empty_map<varid, term>, pattern)
