;;
;; Collection patterns, and helpers for matching them
;;

;; Collection patterns: flattened into element patterns and at most one other
;; pattern, usually a variable, for the remaining elements

dec $collection_of_hook(hookid) : text?
def $collection_of_hook("MAP.concat") = "MAP"
def $collection_of_hook("MAP.element") = "MAP"
def $collection_of_hook("MAP.unit") = "MAP"
def $collection_of_hook("SET.concat") = "SET"
def $collection_of_hook("SET.element") = "SET"
def $collection_of_hook("SET.unit") = "SET"
def $collection_of_hook("LIST.concat") = "LIST"
def $collection_of_hook("LIST.element") = "LIST"
def $collection_of_hook("LIST.unit") = "LIST"
def $collection_of_hook(hookid) = eps
  -- otherwise

dec $collection_of(definition, pattern) : text?
  hint(prose_in "the collection that" %1 "is built with")
def $collection_of(D, APP symid sort* pattern*) = $collection_of_hook(hookid)
  -- if hookid = $hook_of(D, symid)
def $collection_of(D, pattern) = eps
  -- otherwise

dec $parts(definition, text, pattern) : pattern*
def $parts(D, t_c, APP symid sort* ([pattern_1, pattern_2]))
  = $parts(D, t_c, pattern_1) ++ $parts(D, t_c, pattern_2)
  -- if $hook_of(D, symid) = t_c ++ ".concat"
def $parts(D, t_c, APP symid sort* eps) = eps
  -- if $hook_of(D, symid) = t_c ++ ".unit"
def $parts(D, t_c, pattern) = [ pattern ]
  -- otherwise

dec $is_element(definition, text, pattern) : bool
def $is_element(D, t_c, APP symid sort* pattern*)
  = $hook_of(D, symid) = t_c ++ ".element"
def $is_element(D, t_c, pattern) = false
  -- otherwise

dec $elements(definition, text, pattern*) : pattern*
def $elements(D, t_c, eps) = eps
def $elements(D, t_c, pattern_h :: pattern_t*)
  = pattern_h :: $elements(D, t_c, pattern_t*)
  -- if $is_element(D, t_c, pattern_h)
def $elements(D, t_c, pattern_h :: pattern_t*) = $elements(D, t_c, pattern_t*)
  -- if ~$is_element(D, t_c, pattern_h)

dec $others(definition, text, pattern*) : pattern*
def $others(D, t_c, eps) = eps
def $others(D, t_c, pattern_h :: pattern_t*) = $others(D, t_c, pattern_t*)
  -- if $is_element(D, t_c, pattern_h)
def $others(D, t_c, pattern_h :: pattern_t*)
  = pattern_h :: $others(D, t_c, pattern_t*)
  -- if ~$is_element(D, t_c, pattern_h)

;; Injecting terms of the first sorts into the second sorts, where they differ

dec $coerce_all(sort*, sort*, term*) : term*
def $coerce_all(eps, eps, eps) = eps
def $coerce_all(sort_t :: sort_tt*, sort_p :: sort_pt*, term_h :: term_t*)
  = term_h :: $coerce_all(sort_tt*, sort_pt*, term_t*)
  -- if sort_t = sort_p
def $coerce_all(sort_t :: sort_tt*, sort_p :: sort_pt*, term_h :: term_t*)
  = $construct("inj", ([sort_t, sort_p]),
               ([term_h])) :: $coerce_all(sort_tt*, sort_pt*, term_t*)
  -- if sort_t =/= sort_p

;; The element of a list at an index; a negative index counts from the end,
;; as in hook_LIST_get_null

dec $list_at(term*, int) : term?
def $list_at(term*, i) = term*[n]
  -- if n = $nat_of(i)
  -- if $(n < |term*|)
def $list_at(term*, i) = term*[n]
  -- if $(i < 0)
  -- if n = $nat_of($(|term*| + i))
def $list_at(term*, i) = eps
  -- otherwise

;;; Range maps (RANGEMAP, 5.3-hook-collection): keys and ranges as terms

;; A key is an Int injected into KItem; a range is RangeMap:Range(start, end)
;; of two keys, injected into KItem where a set holds it. The names are
;; written out, as inj is: SortInt and SortKItem are K's own sorts, and
;; RangeMap:Range is a constructor of domains.md with a fixed symbol and no
;; hook to find it by, unlike the unit, element, and concatenation of a
;; collection (5.2-hook).

dec $key_int(term) : int?
def $key_int(APP "inj" ([sort_a, sort_k]) ([DV sort_i t])) = $text_to_int(t)
def $key_int(term) = eps
  -- otherwise

dec $int_key(int) : term
def $int_key(i)
  = APP "inj" ([SORT "SortInt" eps, SORT "SortKItem" eps]) ([DV (SORT "SortInt" eps) $int_text(i)])

dec $range_term(int, int) : term
def $range_term(i_s, i_e) = APP "LblRangeMap'Coln'Range" eps ([$int_key(i_s), $int_key(i_e)])

dec $range_key(int, int) : term
def $range_key(i_s, i_e)
  = APP "inj" ([SORT "SortRange" eps, SORT "SortKItem" eps]) ([$range_term(i_s, i_e)])

dec $range_bounds(term) : (int, int)?
def $range_bounds(APP "LblRangeMap'Coln'Range" eps ([term_s, term_e])) = (i_s, i_e)
  -- if i_s = $key_int(term_s)
  -- if i_e = $key_int(term_e)
def $range_bounds(APP "inj" ([sort_r, sort_k]) ([term])) = $range_bounds(term)
def $range_bounds(term) = eps
  -- otherwise

;; The ranges of a range map with each run of adjacent ranges of one value
;; merged, as the LLVM backend's rangemap.h keeps them

dec $merge_ranges(rangeitem*) : rangeitem*
def $merge_ranges(eps) = eps
def $merge_ranges([ rangeitem ]) = [ rangeitem ]
def $merge_ranges((RANGE i_1 i_2 term_1) :: (RANGE i_3 i_4 term_2) :: rangeitem_t*)
  = $merge_ranges((RANGE i_1 i_4 term_1) :: rangeitem_t*)
  -- if i_2 = i_3 /\ term_1 = term_2
def $merge_ranges((RANGE i_1 i_2 term_1) :: (RANGE i_3 i_4 term_2) :: rangeitem_t*)
  = (RANGE i_1 i_2 term_1) :: $merge_ranges((RANGE i_3 i_4 term_2) :: rangeitem_t*)
  -- if ~(i_2 = i_3 /\ term_1 = term_2)
