;; A mismatch while evaluating rule outputs lets another rule path succeed

var n : nat
var m : nat

dec $p(nat) : nat
def $p(n) = 1
  -- if n = 0

relation S: nat |- nat
  hint(input %0)

rule S/a: n |- $p(n)
rule S/b: n |- 7
  -- if n =/= 0

relation Main: OK

rule Main: OK
  -- S: 3 |- m
  -- if nat_main = m
