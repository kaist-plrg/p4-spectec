;; An update guards every prefix of its path against its own target

syntax rec = { VALUES nat* }

var r : rec
var i : nat
var n : nat

dec $put(rec, nat, nat) : rec
def $put(r, i, n) = r[ .VALUES[i] = n ]
def $put(r, i, n) = r
  -- otherwise

dec $splice(nat*, nat, nat*) : nat*
def $splice(nat_base*, i, nat_new*) = nat_base*[[i : 2] = nat_new*]
def $splice(nat_base*, i, nat_new*) = eps
  -- otherwise

dec $main() : bool
def $main() = true
  -- if $put({ VALUES ([ 1, 2 ]) }, 1, 9) = { VALUES ([ 1, 9 ]) }
  -- if $put({ VALUES ([ 1, 2 ]) }, 2, 9) = { VALUES ([ 1, 2 ]) }
  -- if $splice([ 1, 2, 3 ], 1, [ 8, 9 ]) = [ 1, 8, 9 ]
  -- if $splice([ 1, 2, 3 ], 1, [ 8 ]) = eps
  -- if $splice([ 1, 2, 3 ], 2, [ 8, 9 ]) = eps
