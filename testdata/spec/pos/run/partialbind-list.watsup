;; List patterns: fixed length, cons, and the empty list

var x : nat
var y : nat

dec $two(nat*) : nat
def $two([ x, y ]) = $(x + y)
def $two(x*) = 0
  -- otherwise

dec $head(nat*) : nat
def $head(x :: y*) = x
def $head(eps) = 0

dec $main() : bool
def $main() = true
  -- if $two([ 1, 2 ]) = 3
  -- if $two([ 1, 2, 3 ]) = 0
  -- if $head([ 4, 5 ]) = 4
  -- if $head(eps) = 0
