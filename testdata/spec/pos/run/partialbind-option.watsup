;; Option patterns: a bound payload is compared, a binder payload is bound

syntax box = BOX nat nat?

var n : nat
var m : nat

dec $fst(box) : nat
def $fst(BOX n 3) = n
def $fst(BOX n m?) = 0
  -- otherwise

dec $snd(box) : nat
def $snd(BOX _ m) = m
def $snd(BOX _ eps) = 0

dec $main() : bool
def $main() = true
  -- if $fst(BOX 1 3) = 1
  -- if $fst(BOX 1 5) = 0
  -- if $fst(BOX 1 eps) = 0
  -- if $snd(BOX 1 7) = 7
  -- if $snd(BOX 1 eps) = 0
