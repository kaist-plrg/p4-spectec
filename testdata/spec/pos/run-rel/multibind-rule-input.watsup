;; A repeated binder in a rule input requires equal occurrences

syntax pair = (nat, nat)

var x : nat
var y : nat

relation Same: pair |- bool
  hint(input %0)

rule Same/eq:
  (x, x) |- true

rule Same/ne:
  (x, y) |- false
  -- if x =/= y

relation Main: OK

rule Main: OK
  -- Same: (1, 1) |- true
  -- Same: (1, 2) |- false
