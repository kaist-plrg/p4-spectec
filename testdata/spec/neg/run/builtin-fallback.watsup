var n : nat
builtin dec $max_nat(nat*) : nat
;; A builtin failure must not reach the pure fallback

dec $choose(nat) : nat
def $choose(n) = $max_nat([])
def $choose(n) = n
  -- otherwise

relation R: nat |- nat
  hint(input %0)
rule R/call: n |- $choose(n)

relation Main: OK

rule Main: OK
  -- R: 1 |- n_result
