;; A function clause may not use a relation premise that checks its output

syntax pair = (nat, nat)

var x : nat
var y : nat

relation Same: pair |- bool
  hint(input %0)

rule Same/eq:
  (x, x) |- true

rule Same/ne:
  (x, y) |- false
  -- if x =/= y

dec $main() : bool
def $main() = true
  -- Same: (1, 1) |- true
  -- Same: (1, 2) |- false
