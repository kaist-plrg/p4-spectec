;; A slice requires its end within the base; an empty slice at the end is allowed

var i : nat
var n : nat

dec $sub(nat*, nat, nat) : nat*
def $sub(nat_base*, i, n) = nat_base*[i : n]
def $sub(nat_base*, i, n) = [ 0 ]
  -- otherwise

dec $main() : bool
def $main() = true
  -- if $sub([ 1, 2, 3 ], 1, 2) = [ 2, 3 ]
  -- if $sub([ 1, 2, 3 ], 3, 0) = eps
  -- if $sub([ 1, 2, 3 ], 2, 2) = [ 0 ]
