;; Text indexing, slicing, and updates count characters, not bytes

var t : text
var i : nat

dec $char(text, nat) : text
def $char(t, i) = t[i]
def $char(t, i) = "?"
  -- otherwise

dec $set(text, nat, text) : text
def $set(t, i, t_new) = t[[i] = t_new]
def $set(t, i, t_new) = "?"
  -- otherwise

dec $main() : bool
def $main() = true
