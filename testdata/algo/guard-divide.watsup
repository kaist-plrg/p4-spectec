;; Division and remainder require a nonzero divisor

var n : nat
var m : nat
var i : int
var j : int

dec $div(nat, nat) : nat
def $div(n, m) = $(n / m)
def $div(n, m) = 0
  -- otherwise

dec $rem(int, int) : int
def $rem(i, j) = $(i \ j)
def $rem(i, j) = +0
  -- otherwise

dec $main() : bool
def $main() = true
  -- if $div(7, 2) = 3
  -- if $div(7, 0) = 0
  -- if $rem(+7, +2) = +1
  -- if $rem(+7, +0) = +0
