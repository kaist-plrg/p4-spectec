;; An unmatch in a premise falls through to the next clause or rule

var n : nat
var m : nat

;; Unmatches on zero
dec $pos(nat) : nat
def $pos(n) = n
  -- if $(n > 0)

;; Returns its input
relation Copy: nat |- nat
  hint(input %0)

rule Copy:
  n |- n

;; Holds below five
relation Small: |- nat
  hint(input %0)

rule Small:
  |- n
  -- if $(n < 5)

;; In the input of a relation premise
relation Rel: nat |- nat
  hint(input %0)

rule Rel/pos:
  n |- m
  -- Copy: $pos(n) |- m

rule Rel/zero:
  n |- 0
  -- if n = 0

;; In a positive or negated relation premise
relation Hold: nat |- bool
  hint(input %0)

rule Hold/true:
  n |- true
  -- Small: |- $pos(n)

rule Hold/false:
  n |- false
  -- Small:/ |- $pos(n)

rule Hold/zero:
  n |- false
  -- if n = 0

;; In a debug premise
dec $debug(nat) : bool
def $debug(n) = true
  -- debug $pos(n)
def $debug(n) = false
  -- otherwise

;; Adds two naturals
dec $add(nat, nat) : nat
def $add(n, m) = $(n + m)

;; In a call argument
dec $args(nat) : nat
def $args(n) = $add(1, $pos(n))
def $args(n) = 0
  -- otherwise

relation Main: OK

rule Main: OK
  -- Rel: 0 |- 0
  -- Rel: 1 |- 1
  -- Hold: 0 |- false
  -- Hold: 1 |- true
  -- Hold: 7 |- false
  -- if ~$debug(0) /\ $debug(1)
  -- if $args(0) = 0 /\ $args(1) = 2
