;; An unmatch in a component of a constructed value or a field access unmatches the clause

syntax pair = PAIR nat nat
syntax rec = { A nat, B nat }

var n : nat

dec $pos(nat) : nat
def $pos(n) = n
  -- if $(n > 0)

dec $record(nat) : rec
def $record(n) = { A n, B n }
  -- if $(n > 0)

dec $tuple(nat) : (nat, nat)
def $tuple(n) = (1, $pos(n))
def $tuple(n) = (0, 0)
  -- otherwise

dec $case(nat) : pair
def $case(n) = PAIR 1 $pos(n)
def $case(n) = PAIR 0 0
  -- otherwise

dec $struct(nat) : rec
def $struct(n) = { A 1, B $pos(n) }
def $struct(n) = { A 0, B 0 }
  -- otherwise

dec $dot(nat) : nat
def $dot(n) = $record(n).A
def $dot(n) = 0
  -- otherwise

dec $opt(nat) : nat?
def $opt(n) = $pos(n)
def $opt(n) = eps
  -- otherwise

dec $list(nat) : nat*
def $list(n) = [ 1, $pos(n) ]
def $list(n) = eps
  -- otherwise

relation Main: OK

rule Main: OK
  -- if $tuple(0) = (0, 0)
  -- if $case(0) = PAIR 0 0
  -- if $struct(0) = { A 0, B 0 }
  -- if $dot(0) = 0
  -- if $opt(0) = eps
  -- if $list(0) = eps
