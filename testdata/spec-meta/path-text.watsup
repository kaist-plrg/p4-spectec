;; Texts are indexed, sliced, and updated by slices, also under a field

syntax rec = { T text }

var t : text
var i : nat
var n : nat
var r : rec

dec $splice(text, nat, nat, text) : text
def $splice(t, i, n, t') = t[[i : n] = t']
def $splice(t, i, n, t') = ""
  -- otherwise

dec $splice_field(rec, nat, nat, text) : rec
def $splice_field(r, i, n, t) = r[ .T[i : n] = t ]
def $splice_field(r, i, n, t) = { T "" }
  -- otherwise

dec $char(text, nat) : text
def $char(t, i) = t[i]

dec $slice(text, nat, nat) : text
def $slice(t, i, n) = t[i : n]

relation Main: OK

rule Main: OK
  -- if $splice("abcd", 1, 2, "xy") = "axyd"
  -- if $splice("abcd", 3, 2, "xy") = ""
  -- if $splice_field({ T "abcd" }, 0, 1, "x") = { T "xbcd" }
  -- if $splice_field({ T "abcd" }, 0, 1, "xy") = { T "" }
  -- if $slice("abcd", 1, 2) = "bc"
  -- if $char("abcd", 2) = "c"
