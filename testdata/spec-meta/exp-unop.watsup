;; Unary plus and minus on naturals and integers

var n : nat
var i : int

dec $plus(int) : int
def $plus(i) = $(+i)

dec $plus_nat(nat) : nat
def $plus_nat(n) = $(+n)

dec $minus(nat) : int
def $minus(n) = $(-n)

relation Main: OK

rule Main: OK
  -- if $plus(-1) = -1
  -- if $plus_nat(2) = 2
  -- if $minus(2) = -2
