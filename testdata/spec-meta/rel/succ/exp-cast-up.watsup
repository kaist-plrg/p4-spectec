;; Upcasts cast the value inside an option and each tuple component

syntax rec = { A nat }

extern syntax opaque

var n : nat

;; Wraps a natural as an extern value
extern dec $opaque(nat) : opaque

;; Upcasts the value inside an option
dec $opt(nat?) : int?
def $opt(n?) = n?

;; Builds a tuple with a type parameter component
dec $pair<X>(nat, X) : (nat, X)
def $pair<X>(n, X) = (n, X)

;; Upcasts a tuple whose component has a type parameter type
dec $widen<X>(nat, X) : (int, X)
def $widen<X>(n, X) = $pair<X>(n, X)

relation Main: OK

rule Main: OK
  -- if $opt(1) = 1 /\ $opt(eps) = eps
  -- if $widen<bool>(1, true) = (1, true)
  -- if $widen<rec>(1, { A 2 }) = (1, { A 2 })
  -- if $widen<opaque>(1, $opaque(1)) = (1, $opaque(1))
