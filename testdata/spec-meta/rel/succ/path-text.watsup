;; A text under a field is updated by a slice

syntax rec = { T text }

var t : text
var i : nat
var n : nat
var r : rec

;; Replaces a slice of a text field
dec $splice_field(rec, nat, nat, text) : rec
def $splice_field(r, i, n, t) = r[ .T[i : n] = t ]
def $splice_field(r, i, n, t) = { T "" }
  -- otherwise

relation Main: OK

rule Main: OK
  -- if $splice_field({ T "abcd" }, 0, 1, "x") = { T "xbcd" }
  -- if $splice_field({ T "abcd" }, 0, 1, "xy") = { T "" }
