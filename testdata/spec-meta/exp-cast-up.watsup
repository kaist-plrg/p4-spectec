;; Upcasts of tuples and options cast each component

var n : nat
var i : int
var b : bool
var t : text

dec $tuple(nat, int, nat, bool, text) : (int, int, nat, bool, text)
def $tuple(n, i, n', b, t) = (n, i, n', b, t)

dec $opt(nat?) : int?
def $opt(n?) = n?

relation Main: OK

rule Main: OK
  -- if $tuple(1, -2, 3, true, "t") = (1, -2, 3, true, "t")
  -- if $opt(1) = 1 /\ $opt(eps) = eps
