\end{aligned}

\mathsf{matchPriority} \mathrel{::=} \left\{\mathsf{DELTA} \mathbb{N}, \mathsf{LARGEST\_WINS} \mathbb{B}\right\}

\mathsf{matchEntries} \mathrel{::=} \left\{\mathsf{SIZE} \mathbb{N}, \mathsf{CONST} \mathbb{B}\right\}

\begin{aligned}
\mathsf{matchMode} & \mathrel{::=} & \mathsf{NONE} \\
 & \mathrel{|} & \mathsf{LPM}\,\mathbb{N} \\
 & \mathrel{|} & \mathsf{PRI}
\end{aligned}

\mathsf{tableContext} \mathrel{::=} \left\{\mathsf{KEYS} {\mathsf{matchKey}}^{\ast}, \mathsf{ACTIONS} {\mathsf{matchAction}}^{\ast}, \mathsf{PRIORITIES} \mathsf{matchPriority}, \mathsf{ENTRIES} \mathsf{matchEntries}, \mathsf{MODE} \mathsf{matchMode}\right\}

\mathsf{TBLC} : \mathsf{tableContext}



\begin{aligned}
\mathsf{tableEntryState} & \mathrel{::=} & \mathsf{LPM}\,\mathbb{N} \\
 & \mathrel{|} & \mathsf{NON\_LPM}
\end{aligned}

\mathsf{TBLS} : \mathsf{tableEntryState}



