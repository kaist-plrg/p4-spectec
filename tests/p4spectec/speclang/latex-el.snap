\mathrm{bitacc\_range\_op}\left(\mathsf{value}, \mathsf{value}, \mathsf{value}\right) : \mathsf{value}

\mathrlap{\displaystyle \begin{array}{rcl}
\mathrm{bitacc\_range\_op}\left({\mathsf{integerValue}}_{\mathsf{b}}, {\mathsf{integerValue}}_{\mathsf{h}}, {\mathsf{integerValue}}_{\mathsf{l}}\right) & = & \mathsf{w}\,\mathsf{W}\,\mathsf{i} \\
\mathrlap{\displaystyle \quad\text{if}\,\begin{array}{r@{\quad}l}
{\scriptstyle\mathtt{(1)}} & {\mathsf{i}}_{\mathsf{b}} = \mathrm{int\_of\_integerValue}\left({\mathsf{integerValue}}_{\mathsf{b}}\right) \\
{\scriptstyle\mathtt{(2)}} & {\mathsf{i}}_{\mathsf{h}} = \mathrm{int\_of\_integerValue}\left({\mathsf{integerValue}}_{\mathsf{h}}\right) \\
{\scriptstyle\mathtt{(3)}} & {\mathsf{i}}_{\mathsf{l}} = \mathrm{int\_of\_integerValue}\left({\mathsf{integerValue}}_{\mathsf{l}}\right) \\
{\scriptstyle\mathtt{(4)}} & \mathsf{w} = {\mathsf{i}}_{\mathsf{h}} + 1 - {\mathsf{i}}_{\mathsf{l}} \\
{\scriptstyle\mathtt{(5)}} & \mathsf{i} = \mathrm{bitacc}\left({\mathsf{i}}_{\mathsf{b}}, {\mathsf{i}}_{\mathsf{h}}, {\mathsf{i}}_{\mathsf{l}}\right)
\end{array}}\smash{\hphantom{\begin{array}{r}
\mathrm{bitacc\_range\_op}\left({\mathsf{integerValue}}_{\mathsf{b}}, {\mathsf{integerValue}}_{\mathsf{h}}, {\mathsf{integerValue}}_{\mathsf{l}}\right)
\end{array}}} &  &
\end{array}}\smash{\hphantom{\begin{array}{l}
\begin{array}{rcl}
\mathrm{bitacc\_range\_op}\left({\mathsf{integerValue}}_{\mathsf{b}}, {\mathsf{integerValue}}_{\mathsf{h}}, {\mathsf{integerValue}}_{\mathsf{l}}\right) & = & \mathsf{w}\,\mathsf{W}\,\mathsf{i}
\end{array} \\
\quad\text{if}\,\begin{array}{r@{\quad}l}
{\scriptstyle\mathtt{(1)}} & {\mathsf{i}}_{\mathsf{b}} = \mathrm{int\_of\_integerValue}\left({\mathsf{integerValue}}_{\mathsf{b}}\right) \\
{\scriptstyle\mathtt{(2)}} & {\mathsf{i}}_{\mathsf{h}} = \mathrm{int\_of\_integerValue}\left({\mathsf{integerValue}}_{\mathsf{h}}\right) \\
{\scriptstyle\mathtt{(3)}} & {\mathsf{i}}_{\mathsf{l}} = \mathrm{int\_of\_integerValue}\left({\mathsf{integerValue}}_{\mathsf{l}}\right) \\
{\scriptstyle\mathtt{(4)}} & \mathsf{w} = {\mathsf{i}}_{\mathsf{h}} + 1 - {\mathsf{i}}_{\mathsf{l}} \\
{\scriptstyle\mathtt{(5)}} & \mathsf{i} = \mathrm{bitacc}\left({\mathsf{i}}_{\mathsf{b}}, {\mathsf{i}}_{\mathsf{h}}, {\mathsf{i}}_{\mathsf{l}}\right)
\end{array}
\end{array}}}



\mathrm{bitacc\_offset\_op}\left(\mathsf{value}, \mathsf{value}, \mathsf{value}\right) : \mathsf{value}

\mathrlap{\displaystyle \begin{array}{rcl}
\mathrm{bitacc\_offset\_op}\left({\mathsf{integerValue}}_{\mathsf{b}}, {\mathsf{integerValue}}_{\mathsf{l}}, {\mathsf{integerValue}}_{\mathsf{w}}\right) & = & \mathsf{w}\,\mathsf{W}\,\mathsf{i} \\
\mathrlap{\displaystyle \quad\text{if}\,\begin{array}{r@{\quad}l}
{\scriptstyle\mathtt{(1)}} & {\mathsf{i}}_{\mathsf{b}} = \mathrm{int\_of\_integerValue}\left({\mathsf{integerValue}}_{\mathsf{b}}\right) \\
{\scriptstyle\mathtt{(2)}} & {\mathsf{i}}_{\mathsf{l}} = \mathrm{int\_of\_integerValue}\left({\mathsf{integerValue}}_{\mathsf{l}}\right) \\
{\scriptstyle\mathtt{(3)}} & \mathsf{w} = \mathrm{nat\_of\_integerValue}\left({\mathsf{integerValue}}_{\mathsf{w}}\right) \\
{\scriptstyle\mathtt{(4)}} & {\mathsf{i}}_{\mathsf{h}} = {\mathsf{i}}_{\mathsf{l}} + \mathsf{w} - 1 \\
{\scriptstyle\mathtt{(5)}} & \mathsf{i} = \mathrm{bitacc}\left({\mathsf{i}}_{\mathsf{b}}, {\mathsf{i}}_{\mathsf{h}}, {\mathsf{i}}_{\mathsf{l}}\right)
\end{array}}\smash{\hphantom{\begin{array}{r}
\mathrm{bitacc\_offset\_op}\left({\mathsf{integerValue}}_{\mathsf{b}}, {\mathsf{integerValue}}_{\mathsf{l}}, {\mathsf{integerValue}}_{\mathsf{w}}\right)
\end{array}}} &  &
\end{array}}\smash{\hphantom{\begin{array}{l}
\begin{array}{rcl}
\mathrm{bitacc\_offset\_op}\left({\mathsf{integerValue}}_{\mathsf{b}}, {\mathsf{integerValue}}_{\mathsf{l}}, {\mathsf{integerValue}}_{\mathsf{w}}\right) & = & \mathsf{w}\,\mathsf{W}\,\mathsf{i}
