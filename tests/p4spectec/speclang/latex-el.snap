{\scriptstyle\mathtt{(6)}} & {\mathsf{i}}_{\mathsf{max}} = \mathrm{pow2}\left(\mathsf{w'}\right) \\
{\scriptstyle\mathtt{(7)}} & \mathsf{i''} = \mathrm{ite}\left\langle\mathbb{Z}\right\rangle\left(\mathsf{i'} < {\mathsf{i}}_{\mathsf{max}}, \mathsf{i'}, {\mathsf{i}}_{\mathsf{max}} - 1\right) \\
