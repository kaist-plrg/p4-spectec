\mathrm{reverse\_bytes\_of\_hex}\left(\mathbb{T}\right) : \mathbb{T}

\mathrm{reverse\_bytes\_of\_hex'}\left(\mathbb{T}\right) : \mathbb{T}

\mathrlap{\displaystyle \begin{array}{rcl}
\mathrm{reverse\_bytes\_of\_hex}\left(\mathsf{t}\right) & = & \texttt{"0x"} \mathbin{+\!\!+} \mathrm{reverse\_bytes\_of\_hex'}\left(\mathsf{t}\left[2 : {\mathsf{n}}_{\mathsf{len\_bytes}}\right]\right) \\
\mathrlap{\displaystyle \quad\text{if}\,\begin{array}{r@{\quad}l}
{\scriptstyle\mathtt{(1)}} & \mathsf{t}\left[0 : 2\right] = \texttt{"0x"} \\
{\scriptstyle\mathtt{(2)}} & {\mathsf{n}}_{\mathsf{len}} = \left|\mathsf{t}\right| \\
{\scriptstyle\mathtt{(3)}} & {\mathsf{n}}_{\mathsf{len\_bytes}} = {\mathsf{n}}_{\mathsf{len}} - 2
\end{array}}\smash{\hphantom{\begin{array}{r}
\mathrm{reverse\_bytes\_of\_hex}\left(\mathsf{t}\right)
\end{array}}} &  &
\end{array}}\smash{\hphantom{\begin{array}{l}
\begin{array}{rcl}
\mathrm{reverse\_bytes\_of\_hex}\left(\mathsf{t}\right) & = & \texttt{"0x"} \mathbin{+\!\!+} \mathrm{reverse\_bytes\_of\_hex'}\left(\mathsf{t}\left[2 : {\mathsf{n}}_{\mathsf{len\_bytes}}\right]\right)
\end{array} \\
\quad\text{if}\,\begin{array}{r@{\quad}l}
{\scriptstyle\mathtt{(1)}} & \mathsf{t}\left[0 : 2\right] = \texttt{"0x"} \\
{\scriptstyle\mathtt{(2)}} & {\mathsf{n}}_{\mathsf{len}} = \left|\mathsf{t}\right| \\
{\scriptstyle\mathtt{(3)}} & {\mathsf{n}}_{\mathsf{len\_bytes}} = {\mathsf{n}}_{\mathsf{len}} - 2
\end{array}
\end{array}}}

\begin{aligned}
\mathrm{reverse\_bytes\_of\_hex'}\left(\mathsf{t}\right) & = & \mathsf{t} \quad \text{if}\,\left|\mathsf{t}\right| \le 2
\end{aligned}

\mathrlap{\displaystyle \begin{array}{rcl}
\mathrm{reverse\_bytes\_of\_hex'}\left(\mathsf{t}\right) & = & {\mathsf{t}}_{\mathsf{bytes\_rev}} \mathbin{+\!\!+} {\mathsf{t}}_{\mathsf{byte}} \\
\mathrlap{\displaystyle \quad\text{if}\,\begin{array}{r@{\quad}l}
{\scriptstyle\mathtt{(1)}} & {\mathsf{n}}_{\mathsf{len}} = \left|\mathsf{t}\right| \\
{\scriptstyle\mathtt{(2)}} & {\mathsf{n}}_{\mathsf{len}} > 2 \\
{\scriptstyle\mathtt{(3)}} & {\mathsf{t}}_{\mathsf{byte}} = \mathsf{t}\left[0 : 2\right] \\
{\scriptstyle\mathtt{(4)}} & {\mathsf{n}}_{\mathsf{len\_bytes}} = {\mathsf{n}}_{\mathsf{len}} - 2 \\
{\scriptstyle\mathtt{(5)}} & {\mathsf{t}}_{\mathsf{bytes}} = \mathsf{t}\left[2 : {\mathsf{n}}_{\mathsf{len\_bytes}}\right] \\
{\scriptstyle\mathtt{(6)}} & {\mathsf{t}}_{\mathsf{bytes\_rev}} = \mathrm{reverse\_bytes\_of\_hex'}\left({\mathsf{t}}_{\mathsf{bytes}}\right)
\end{array}}\smash{\hphantom{\begin{array}{r}
\mathrm{reverse\_bytes\_of\_hex'}\left(\mathsf{t}\right)
\end{array}}} &  &
\end{array}}\smash{\hphantom{\begin{array}{l}
\begin{array}{rcl}
\mathrm{reverse\_bytes\_of\_hex'}\left(\mathsf{t}\right) & = & {\mathsf{t}}_{\mathsf{bytes\_rev}} \mathbin{+\!\!+} {\mathsf{t}}_{\mathsf{byte}}
