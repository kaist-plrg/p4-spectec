\end{array} \\
\quad\text{if}\,\left\{{\left({\mathsf{K}}_{\mathsf{c}}\,\mathbin{\mathtt{:}}\,{\mathsf{V}}_{\mathsf{c}}\right)}^{\ast}\right\} = \mathrm{adds\_map}\left\langle\mathsf{K}, \mathsf{V}\right\rangle\left(\left\{{\left({\mathsf{K}}_{\mathsf{a}}\,\mathbin{\mathtt{:}}\,{\mathsf{V}}_{\mathsf{a}}\right)}^{\ast}\right\}, {{\mathsf{K}}_{\mathsf{b}}}^{\ast}, {{\mathsf{V}}_{\mathsf{b}}}^{\ast}\right)
