\mathrm{sizeof\_minSizeInBits'}\left(\mathsf{HEADER\_STACK}\,\mathsf{typeIR}\,\left[{\mathsf{n}}_{\mathsf{size}}\right]\right) & = & \mathrm{sizeof\_minSizeInBits'}\left(\mathsf{typeIR}\right) \cdot {\mathsf{n}}_{\mathsf{size}}
\end{aligned}

\begin{aligned}
\mathrm{sizeof\_minSizeInBits'}\left(\mathsf{STRUCT}\,\mathsf{\_}\,\left\langle\mathsf{\_}\right\rangle\,\left\{{\left(\mathsf{\_}\,\mathsf{typeIR}\,\mathsf{\_}\,\mathbin{\mathtt{;}}\right)}^{\ast}\right\}\right) & = & \mathrm{sum\_nat}\left({\mathrm{sizeof\_minSizeInBits'}\left(\mathsf{typeIR}\right)}^{\ast}\right)
\end{aligned}

\begin{aligned}
\mathrm{sizeof\_minSizeInBits'}\left(\mathsf{HEADER}\,\mathsf{\_}\,\left\langle\mathsf{\_}\right\rangle\,\left\{{\left(\mathsf{\_}\,\mathsf{typeIR}\,\mathsf{\_}\,\mathbin{\mathtt{;}}\right)}^{\ast}\right\}\right) & = & \mathrm{sum\_nat}\left({\mathrm{sizeof\_minSizeInBits'}\left(\mathsf{typeIR}\right)}^{\ast}\right)
\end{aligned}

\begin{aligned}
\mathrm{sizeof\_minSizeInBits'}\left(\mathsf{HEADER\_UNION}\,\mathsf{\_}\,\left\langle\mathsf{\_}\right\rangle\,\left\{\epsilon\right\}\right) & = & 0
\end{aligned}

\mathrlap{\displaystyle \begin{array}{rcl}
