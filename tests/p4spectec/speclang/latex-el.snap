\begin{aligned}
\mathrm{default}\left(\mathsf{INT}\right) & = & \mathsf{D}\,0
\end{aligned}

\begin{aligned}
\mathrm{default}\left(\mathsf{BIT}\,\left\langle\mathsf{w}\right\rangle\right) & = & \mathsf{w}\,\mathsf{W}\,0
\end{aligned}

\begin{aligned}
