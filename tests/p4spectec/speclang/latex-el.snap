\end{aligned}

\begin{aligned}
\mathrm{compat\_range}\left(\mathsf{BIT}\,\left\langle{\mathsf{w}}_{\mathsf{l}}\right\rangle, \mathsf{BIT}\,\left\langle{\mathsf{w}}_{\mathsf{r}}\right\rangle\right) & = & {\mathsf{w}}_{\mathsf{l}} = {\mathsf{w}}_{\mathsf{r}}
\end{aligned}

\begin{aligned}
\mathrm{compat\_range}\left(\mathsf{TYPEDEF}\,\mathsf{\_}\,{\mathsf{typeIR}}_{\mathsf{l}}, {\mathsf{typeIR}}_{\mathsf{r}}\right) & = & \mathrm{compat\_range}\left({\mathsf{typeIR}}_{\mathsf{l}}, {\mathsf{typeIR}}_{\mathsf{r}}\right)
\end{aligned}

\mathrlap{\displaystyle \begin{array}{rcl}
\mathrm{compat\_range}\left({\mathsf{typeIR}}_{\mathsf{l}}, \mathsf{TYPEDEF}\,\mathsf{\_}\,{\mathsf{typeIR}}_{\mathsf{r}}\right) & = & \mathrm{compat\_range}\left({\mathsf{typeIR}}_{\mathsf{l}}, {\mathsf{typeIR}}_{\mathsf{r}}\right) \\
\mathrlap{\displaystyle \quad\text{if}\,\neg \left({\mathsf{typeIR}}_{\mathsf{l}} \mathrel{<:} \mathsf{typedefTypeIR}\right)}\smash{\hphantom{\begin{array}{r}
