{\definecolor{ellatexrulelabelbg}{rgb}{0.94,0.94,0.92}\fcolorbox{black}{ellatexrulelabelbg}{\scriptsize \texttt{ExternMethodTypeDef\_alpha}}} \\
{\displaystyle \frac{\begin{array}{r@{\quad}l}
{\scriptstyle\mathtt{(1)}} & \left({{\mathsf{typeParameterIR}}_{\mathsf{expl\_a}}}^{\ast}, {{\mathsf{typeParameterIR}}_{\mathsf{impl\_a}}}^{\ast}\right) \\
 & \quad\quad= \mathrm{typeParameterListIR\_of\_callableTypeDefIR}\left({\mathsf{externMethodTypeDefIR}}_{\mathsf{a}}\right) \\
{\scriptstyle\mathtt{(2)}} & \left({{\mathsf{typeParameterIR}}_{\mathsf{expl\_b}}}^{\ast}, {{\mathsf{typeParameterIR}}_{\mathsf{impl\_b}}}^{\ast}\right) \\
 & \quad\quad= \mathrm{typeParameterListIR\_of\_callableTypeDefIR}\left({\mathsf{externMethodTypeDefIR}}_{\mathsf{b}}\right) \\
{\scriptstyle\mathtt{(3)}} & \left|{{\mathsf{typeParameterIR}}_{\mathsf{expl\_a}}}^{\ast}\right| = \left|{{\mathsf{typeParameterIR}}_{\mathsf{expl\_b}}}^{\ast}\right| \\
{\scriptstyle\mathtt{(4)}} & \left|{{\mathsf{typeParameterIR}}_{\mathsf{impl\_a}}}^{\ast}\right| = \left|{{\mathsf{typeParameterIR}}_{\mathsf{impl\_b}}}^{\ast}\right| \\
{\scriptstyle\mathtt{(5)}} & {{\mathsf{typeParameterIR}}_{\mathsf{fresh}}}^{\ast} \\
 & \quad\quad= \mathrm{fresh\_typeIds}\left(\left|{{\mathsf{typeParameterIR}}_{\mathsf{expl\_a}}}^{\ast} \mathbin{+\!\!+} {{\mathsf{typeParameterIR}}_{\mathsf{impl\_a}}}^{\ast}\right|\right) \\
{\scriptstyle\mathtt{(6)}} & {{\mathsf{typeParameterIR}}_{\mathsf{a}}}^{\ast} = {{\mathsf{typeParameterIR}}_{\mathsf{expl\_a}}}^{\ast} \mathbin{+\!\!+} {{\mathsf{typeParameterIR}}_{\mathsf{impl\_a}}}^{\ast} \\
{\scriptstyle\mathtt{(7)}} & {\mathsf{theta}}_{\mathsf{a}} = \left\{{\left({\mathsf{typeParameterIR}}_{\mathsf{a}}\,\mathbin{\mathtt{:}}\,\left({\,}_{\mathsf{NAME}}\,{\mathsf{typeParameterIR}}_{\mathsf{fresh}}\right)\right)}^{\ast}\right\} \\
{\scriptstyle\mathtt{(8)}} & {\mathsf{externMethodTypeIR}}_{\mathsf{a}} \\
 & \quad\quad= \mathrm{callableTypeIR\_of\_callableTypeDefIR}\left({\mathsf{externMethodTypeDefIR}}_{\mathsf{a}}\right) \\
{\scriptstyle\mathtt{(9)}} & {\mathsf{externMethodTypeIR}}_{\mathsf{a\_subst}} \\
 & \quad\quad= \mathrm{subst\_callableTypeIR}\left({\mathsf{theta}}_{\mathsf{a}}, {\mathsf{externMethodTypeIR}}_{\mathsf{a}}\right) \\
{\scriptstyle\mathtt{(10)}} & {{\mathsf{typeParameterIR}}_{\mathsf{b}}}^{\ast} = {{\mathsf{typeParameterIR}}_{\mathsf{expl\_b}}}^{\ast} \mathbin{+\!\!+} {{\mathsf{typeParameterIR}}_{\mathsf{impl\_b}}}^{\ast} \\
{\scriptstyle\mathtt{(11)}} & {\mathsf{theta}}_{\mathsf{b}} = \left\{{\left({\mathsf{typeParameterIR}}_{\mathsf{b}}\,\mathbin{\mathtt{:}}\,\left({\,}_{\mathsf{NAME}}\,{\mathsf{typeParameterIR}}_{\mathsf{fresh}}\right)\right)}^{\ast}\right\} \\
{\scriptstyle\mathtt{(12)}} & {\mathsf{externMethodTypeIR}}_{\mathsf{b}} \\
 & \quad\quad= \mathrm{callableTypeIR\_of\_callableTypeDefIR}\left({\mathsf{externMethodTypeDefIR}}_{\mathsf{b}}\right) \\
{\scriptstyle\mathtt{(13)}} & {\mathsf{externMethodTypeIR}}_{\mathsf{b\_subst}} \\
 & \quad\quad= \mathrm{subst\_callableTypeIR}\left({\mathsf{theta}}_{\mathsf{b}}, {\mathsf{externMethodTypeIR}}_{\mathsf{b}}\right) \\
{\scriptstyle\mathtt{(14)}} & {\mathsf{externMethodTypeIR}}_{\mathsf{a\_subst}} \sim {\mathsf{externMethodTypeIR}}_{\mathsf{b\_subst}}
\end{array}}{{\mathsf{externMethodTypeDefIR}}_{\mathsf{a}} \sim {\mathsf{externMethodTypeDefIR}}_{\mathsf{b}}}}
\end{array}

\begin{aligned}
\mathsf{ctk} & \mathrel{::=} & \mathsf{LCTK} \\
 & \mathrel{|} & \mathsf{CTK} \\
 & \mathrel{|} & \mathsf{DYN}
\end{aligned}

\mathrm{join\_ctk}\left(\mathsf{ctk}, \mathsf{ctk}\right) : \mathsf{ctk}

\begin{aligned}
\mathrm{join\_ctk}\left(\mathsf{LCTK}, \mathsf{LCTK}\right) & = & \mathsf{LCTK}
\end{aligned}

\begin{aligned}
\mathrm{join\_ctk}\left(\mathsf{LCTK}, \mathsf{CTK}\right) & = & \mathsf{CTK}
\end{aligned}

\begin{aligned}
\mathrm{join\_ctk}\left(\mathsf{CTK}, \mathsf{LCTK}\right) & = & \mathsf{CTK}
\end{aligned}

\begin{aligned}
\mathrm{join\_ctk}\left(\mathsf{CTK}, \mathsf{CTK}\right) & = & \mathsf{CTK}
\end{aligned}

\begin{aligned}
\mathrm{join\_ctk}\left({\mathsf{ctk}}_{\mathsf{a}}, {\mathsf{ctk}}_{\mathsf{b}}\right) & = & \mathsf{DYN} \quad \text{if}\,\mathrm{otherwise}
\end{aligned}

\mathrm{joins\_ctk}\left({\mathsf{ctk}}^{\ast}\right) : \mathsf{ctk}

\begin{aligned}
\mathrm{joins\_ctk}\left(\epsilon\right) & = & \mathsf{LCTK}
\end{aligned}

\begin{aligned}
\mathrm{joins\_ctk}\left(\mathsf{ctk}\right) & = & \mathsf{ctk}
\end{aligned}

\begin{aligned}
\mathrm{joins\_ctk}\left({\mathsf{ctk}}_{\mathsf{a}} \mathbin{::} {\mathsf{ctk}}_{\mathsf{b}}\right) & = & \mathrm{join\_ctk}\left({\mathsf{ctk}}_{\mathsf{a}}, {\mathsf{ctk}}_{\mathsf{b}}\right)
\end{aligned}

\mathrlap{\displaystyle \begin{array}{rcl}
\mathrm{joins\_ctk}\left({\mathsf{ctk}}_{\mathsf{a}} \mathbin{::} {\mathsf{ctk}}_{\mathsf{b}} \mathbin{::} {{\mathsf{ctk}}_{\mathsf{c}}}^{\ast}\right) & = & \mathrm{joins\_ctk}\left({\mathsf{ctk}}_{\mathsf{d}} \mathbin{::} {{\mathsf{ctk}}_{\mathsf{c}}}^{\ast}\right) \\
\mathrlap{\displaystyle \quad\text{if}\,\begin{array}{r@{\quad}l}
{\scriptstyle\mathtt{(1)}} & {{\mathsf{ctk}}_{\mathsf{c}}}^{\ast} \ne \epsilon \\
{\scriptstyle\mathtt{(2)}} & {\mathsf{ctk}}_{\mathsf{d}} = \mathrm{join\_ctk}\left({\mathsf{ctk}}_{\mathsf{a}}, {\mathsf{ctk}}_{\mathsf{b}}\right)
\end{array}}\smash{\hphantom{\begin{array}{r}
\mathrm{joins\_ctk}\left({\mathsf{ctk}}_{\mathsf{a}} \mathbin{::} {\mathsf{ctk}}_{\mathsf{b}} \mathbin{::} {{\mathsf{ctk}}_{\mathsf{c}}}^{\ast}\right)
\end{array}}} &  &
\end{array}}\smash{\hphantom{\begin{array}{l}
\begin{array}{rcl}
\mathrm{joins\_ctk}\left({\mathsf{ctk}}_{\mathsf{a}} \mathbin{::} {\mathsf{ctk}}_{\mathsf{b}} \mathbin{::} {{\mathsf{ctk}}_{\mathsf{c}}}^{\ast}\right) & = & \mathrm{joins\_ctk}\left({\mathsf{ctk}}_{\mathsf{d}} \mathbin{::} {{\mathsf{ctk}}_{\mathsf{c}}}^{\ast}\right)
\end{array} \\
\quad\text{if}\,\begin{array}{r@{\quad}l}
{\scriptstyle\mathtt{(1)}} & {{\mathsf{ctk}}_{\mathsf{c}}}^{\ast} \ne \epsilon \\
{\scriptstyle\mathtt{(2)}} & {\mathsf{ctk}}_{\mathsf{d}} = \mathrm{join\_ctk}\left({\mathsf{ctk}}_{\mathsf{a}}, {\mathsf{ctk}}_{\mathsf{b}}\right)
\end{array}
\end{array}}}

\mathrm{pow2}\left(\mathbb{N}\right) : \mathbb{Z} \quad \text{builtin}

\mathrm{shl}\left(\mathbb{Z}, \mathbb{Z}\right) : \mathbb{Z} \quad \text{builtin}

\mathrm{shr}\left(\mathbb{Z}, \mathbb{Z}\right) : \mathbb{Z} \quad \text{builtin}

\mathrm{shr\_arith}\left(\mathbb{Z}, \mathbb{Z}, \mathbb{Z}\right) : \mathbb{Z} \quad \text{builtin}

