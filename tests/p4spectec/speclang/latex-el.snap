\mathrm{parameterListIR\_of\_methodDef}\left(\mathsf{controlApplyMethodDef}\right) & = & \mathrm{parameterListIR\_of\_controlApplyMethodDef}\left(\mathsf{controlApplyMethodDef}\right)
\end{aligned}

\begin{aligned}
\mathrm{parameterListIR\_of\_methodDef}\left(\mathsf{tableApplyMethodDef}\right) & = & \mathrm{parameterListIR\_of\_tableApplyMethodDef}\left(\mathsf{tableApplyMethodDef}\right)
\end{aligned}

\begin{aligned}
\mathrm{parameterListIR\_of\_callableDef}\left(\mathsf{methodDef}\right) & = & \mathrm{parameterListIR\_of\_methodDef}\left(\mathsf{methodDef}\right)
\end{aligned}



\begin{aligned}
\mathsf{actionCallee} & \mathrel{::=} & \mathsf{ACTION}\,\mathsf{cursor}\,\mathbin{\mathtt{.}}\,\mathsf{nameIR}\,\left(\mathsf{parameterListIR}\,\mathbin{\mathtt{\#}}\,{\mathsf{id}}^{\ast}\right)\,\mathsf{blockStatementIR}
\end{aligned}



\begin{aligned}
\mathsf{definedFunctionCallee} & \mathrel{::=} & \mathsf{FUNCTION}\,\mathsf{nameIR}\,\left\langle\mathsf{typeParameterListIR}\right\rangle\,\left(\mathsf{parameterListIR}\,\mathbin{\mathtt{\#}}\,{\mathsf{id}}^{\ast}\right)\,\mathsf{blockStatementIR}
\end{aligned}

\begin{aligned}
\mathsf{externFunctionCallee} & \mathrel{::=} & \mathsf{EXTERN\_FUNCTION}\,\mathsf{nameIR}\,\left\langle\mathsf{typeParameterListIR}\right\rangle\,\left(\mathsf{parameterListIR}\,\mathbin{\mathtt{\#}}\,{\mathsf{id}}^{\ast}\,\mathbin{\mathtt{\#}}\,{\mathsf{id}}^{\ast}\right)
\end{aligned}

\begin{aligned}
\mathsf{functionCallee} & \mathrel{::=} & \mathsf{definedFunctionCallee} \\
 & \mathrel{|} & \mathsf{externFunctionCallee}
\end{aligned}



\begin{aligned}
\mathsf{builtinIsValidMethodCallee} & \mathrel{::=} & \mathsf{BUILTIN\_IS\_VALID}\,\mathsf{storageReference}
\end{aligned}

\begin{aligned}
\mathsf{builtinSetValidMethodCallee} & \mathrel{::=} & \mathsf{BUILTIN\_SET\_VALID}\,\mathsf{storageReference}
\end{aligned}

\begin{aligned}
\mathsf{builtinSetInvalidMethodCallee} & \mathrel{::=} & \mathsf{BUILTIN\_SET\_INVALID}\,\mathsf{storageReference}
\end{aligned}

\begin{aligned}
\mathsf{builtinPushFrontMethodCallee} & \mathrel{::=} & \mathsf{BUILTIN\_PUSH\_FRONT}\,\mathsf{storageReference}
\end{aligned}

\begin{aligned}
\mathsf{builtinPopFrontMethodCallee} & \mathrel{::=} & \mathsf{BUILTIN\_POP\_FRONT}\,\mathsf{storageReference}
\end{aligned}

\begin{aligned}
\mathsf{builtinSizeMethodCallee} & \mathrel{::=} & \mathsf{BUILTIN\_SIZE\_OF}\,\mathsf{nameIR}\,\mathsf{typeIR}
\end{aligned}

\begin{aligned}
\mathsf{builtinMethodCallee} & \mathrel{::=} & \mathsf{builtinIsValidMethodCallee} \\
 & \mathrel{|} & \mathsf{builtinSetValidMethodCallee} \\
 & \mathrel{|} & \mathsf{builtinSetInvalidMethodCallee} \\
 & \mathrel{|} & \mathsf{builtinPushFrontMethodCallee} \\
 & \mathrel{|} & \mathsf{builtinPopFrontMethodCallee} \\
 & \mathrel{|} & \mathsf{builtinSizeMethodCallee}
\end{aligned}

\begin{aligned}
\mathsf{externMethodCallee} & \mathrel{::=} & \mathsf{EXTERN\_METHOD}\,\mathsf{objectId}\,\mathbin{\mathtt{.}}\,\mathsf{nameIR}\,\left\langle\mathsf{typeParameterListIR}\right\rangle\,\left(\mathsf{parameterListIR}\,\mathbin{\mathtt{\#}}\,{\mathsf{id}}^{\ast}\,\mathbin{\mathtt{\#}}\,{\mathsf{id}}^{\ast}\right)\,\left\{\mathsf{theta}\,\mathbin{\mathtt{;}}\,\mathsf{frame}\,\mathbin{\mathtt{;}}\,{\mathsf{blockStatementIR}}^{?}\right\}
\end{aligned}

\begin{aligned}
\mathsf{parserApplyMethodCallee} & \mathrel{::=} & \mathsf{PARSER}\,\mathsf{objectId}\,\mathbin{\mathtt{.}}\,\mathsf{APPLY}\,\left(\mathsf{parameterListIR}\,\mathbin{\mathtt{\#}}\,{\mathsf{id}}^{\ast}\right)\,\left\{\mathsf{theta}\,\mathbin{\mathtt{;}}\,\mathsf{frame}\,\mathbin{\mathtt{;}}\,\mathsf{parserLocalDeclarationListIR}\,\mathbin{\mathtt{;}}\,\mathsf{stateEnv}\right\}
\end{aligned}

\begin{aligned}
\mathsf{controlApplyMethodCallee} & \mathrel{::=} & \mathsf{CONTROL}\,\mathsf{objectId}\,\mathbin{\mathtt{.}}\,\mathsf{APPLY}\,\left(\mathsf{parameterListIR}\,\mathbin{\mathtt{\#}}\,{\mathsf{id}}^{\ast}\right)\,\left\{\mathsf{theta}\,\mathbin{\mathtt{;}}\,\mathsf{frame}\,\mathbin{\mathtt{;}}\,\mathsf{controlLocalDeclarationListIR}\,\mathbin{\mathtt{;}}\,\mathsf{actionDefEnv}\,\mathbin{\mathtt{;}}\,\mathsf{controlBodyIR}\right\}
\end{aligned}

\begin{aligned}
\mathsf{tableApplyMethodCallee} & \mathrel{::=} & \mathsf{TABLE}\,\mathsf{objectId}\,\mathbin{\mathtt{.}}\,\mathsf{APPLY}\,\left\{\mathsf{frame}\,\mathbin{\mathtt{;}}\,\mathsf{tableObjectProperty}\right\}
\end{aligned}

\begin{aligned}
\mathsf{methodCallee} & \mathrel{::=} & \mathsf{builtinMethodCallee} \\
 & \mathrel{|} & \mathsf{externMethodCallee} \\
 & \mathrel{|} & \mathsf{parserApplyMethodCallee} \\
 & \mathrel{|} & \mathsf{controlApplyMethodCallee} \\
 & \mathrel{|} & \mathsf{tableApplyMethodCallee}
\end{aligned}

\begin{aligned}
\mathsf{callee} & \mathrel{::=} & \mathsf{actionCallee} \\
 & \mathrel{|} & \mathsf{functionCallee} \\
 & \mathrel{|} & \mathsf{methodCallee}
\end{aligned}

\begin{aligned}
\mathsf{externObjectConstructorDef} & \mathrel{::=} & \mathsf{EXTERN}\,\mathsf{nameIR}\,\left\langle\mathsf{typeParameterListIR}\right\rangle\,\left(\mathsf{constructorParameterListIR}\right)\,\left\{\mathsf{externMethodPrototypeListIR}\right\}
\end{aligned}

\begin{aligned}
\mathsf{parserObjectConstructorDef} & \mathrel{::=} & \mathsf{PARSER}\,\left\langle\mathsf{typeParameterListIR}\right\rangle\,\left(\mathsf{parameterListIR}\right)\,\left(\mathsf{constructorParameterListIR}\right)\,\left\{\mathsf{parserLocalDeclarationListIR}\,\mathsf{parserStateListIR}\right\}
\end{aligned}

\begin{aligned}
\mathsf{controlObjectConstructorDef} & \mathrel{::=} & \mathsf{CONTROL}\,\left\langle\mathsf{typeParameterListIR}\right\rangle\,\left(\mathsf{parameterListIR}\right)\,\left(\mathsf{constructorParameterListIR}\right)\,\left\{\mathsf{controlLocalDeclarationListIR}\,\mathsf{APPLY}\,\mathsf{controlBodyIR}\right\}
\end{aligned}

\begin{aligned}
\mathsf{packageObjectConstructorDef} & \mathrel{::=} & \mathsf{PACKAGE}\,\left\langle\mathsf{typeParameterListIR}\right\rangle\,\left(\mathsf{constructorParameterListIR}\right)
\end{aligned}

\begin{aligned}
\mathsf{constructorDef} & \mathrel{::=} & \mathsf{externObjectConstructorDef} \\
 & \mathrel{|} & \mathsf{parserObjectConstructorDef} \\
 & \mathrel{|} & \mathsf{controlObjectConstructorDef} \\
 & \mathrel{|} & \mathsf{packageObjectConstructorDef}
\end{aligned}

\mathrm{parameterListIR\_of\_constructorDef}\left(\mathsf{constructorDef}\right) : {\mathsf{parameterIR}}^{\ast}

\begin{aligned}
\mathrm{parameterListIR\_of\_constructorDef}\left(\mathsf{EXTERN}\,\mathsf{\_}\,\left\langle\mathsf{\_}\right\rangle\,\left(\mathsf{constructorParameterListIR}\right)\,\left\{\mathsf{\_}\right\}\right) & = & \mathsf{constructorParameterListIR}
\end{aligned}

\begin{aligned}
\mathrm{parameterListIR\_of\_constructorDef}\left(\begin{array}{l}
\mathsf{PARSER}\,\left\langle\mathsf{\_}\right\rangle\,\left(\mathsf{\_}\right)\,\left(\mathsf{constructorParameterListIR}\right) \\
\left\{\mathsf{\_}\,\mathsf{\_}\right\}
\end{array}\right) & = & \mathsf{constructorParameterListIR}
\end{aligned}

\begin{aligned}
\mathrm{parameterListIR\_of\_constructorDef}\left(\begin{array}{l}
\mathsf{CONTROL}\,\left\langle\mathsf{\_}\right\rangle\,\left(\mathsf{\_}\right)\,\left(\mathsf{constructorParameterListIR}\right) \\
\left\{\mathsf{\_}\,\mathsf{APPLY}\,\mathsf{\_}\right\}
\end{array}\right) & = & \mathsf{constructorParameterListIR}
\end{aligned}

\begin{aligned}
\mathrm{parameterListIR\_of\_constructorDef}\left(\mathsf{PACKAGE}\,\left\langle\mathsf{\_}\right\rangle\,\left(\mathsf{constructorParameterListIR}\right)\right) & = & \mathsf{constructorParameterListIR}
\end{aligned}



\mathsf{objectState} \quad \text{external syntax}

\mathsf{externMethodDefEnv} \mathrel{::=} \mathsf{map}\left\langle\mathsf{callableId}, \mathsf{externMethodDef}\right\rangle

\mathrm{init\_objectState}\left(\mathsf{nameIR}, {\mathsf{typeIR}}^{\ast}, {\mathsf{id}}^{\ast}, {\mathsf{value}}^{\ast}\right) : \mathsf{objectState} \quad \text{external}

\begin{aligned}
\mathsf{externObject} & \mathrel{::=} & \mathsf{EXTERN}\,\mathsf{typeId}\,\left\langle\mathsf{theta}\right\rangle\,\left\{\mathsf{objectState}\,\mathsf{frame}\,\mathsf{externMethodDefEnv}\right\}
\end{aligned}



\begin{aligned}
\mathsf{parserObject} & \mathrel{::=} & \mathsf{PARSER}\,\left\langle\mathsf{theta}\right\rangle\,\left(\mathsf{parameterListIR}\right)\,\left\{\mathsf{frame}\,\mathsf{parserLocalDeclarationListIR}\,\mathsf{stateEnv}\right\}
\end{aligned}



\mathsf{actionDefEnv} \mathrel{::=} \mathsf{map}\left\langle\mathsf{callableId}, \mathsf{actionDef}\right\rangle

\begin{aligned}
\mathsf{controlObject} & \mathrel{::=} & \mathsf{CONTROL}\,\left\langle\mathsf{theta}\right\rangle\,\left(\mathsf{parameterListIR}\right)\,\left\{\mathsf{frame}\,\mathsf{controlLocalDeclarationListIR}\,\mathsf{actionDefEnv}\,\mathsf{controlBodyIR}\right\}
\end{aligned}



\begin{aligned}
\mathsf{packageObject} & \mathrel{::=} & \mathsf{PACKAGE}\,\left\langle\mathsf{theta}\right\rangle\,\left\{\mathsf{frame}\right\}
\end{aligned}



\mathsf{tableObjectProperty} \mathrel{::=} \left\{\mathsf{KEYS} \mathsf{tableKeysPropertyIR}, \mathsf{ACTIONS} \mathsf{tableActionsPropertyIR}, \mathsf{DEFAULT\_ACTION} \mathsf{tableDefaultActionPropertyIR}, \mathsf{ENTRIES} \mathsf{tableEntriesPropertyIR}, \mathsf{CUSTOMS} {\mathsf{tableCustomPropertyIR}}^{\ast}\right\}

\mathsf{TBL} : \mathsf{tableObjectProperty}

\begin{aligned}
\mathsf{tableObject} & \mathrel{::=} & \mathsf{TABLE}\,\mathsf{typeId}\,\left\{\mathsf{frame}\,\mathsf{tableObjectProperty}\right\}
\end{aligned}



\begin{aligned}
\mathsf{valueSetObject} & \mathrel{::=} & \mathsf{VALUE\_SET}\,\left\{{\mathsf{value}}^{\ast}\,\left(\mathbb{N}\right)\right\}
\end{aligned}

\begin{aligned}
\mathsf{object} & \mathrel{::=} & \mathsf{externObject} \\
 & \mathrel{|} & \mathsf{parserObject} \\
 & \mathrel{|} & \mathsf{controlObject} \\
 & \mathrel{|} & \mathsf{packageObject} \\
 & \mathrel{|} & \mathsf{tableObject} \\
 & \mathrel{|} & \mathsf{valueSetObject}
\end{aligned}

\mathsf{frame} \mathrel{::=} \mathsf{map}\left\langle\mathsf{id}, \mathsf{value}\right\rangle

\mathrm{empty\_frame}\left(\right) : \mathsf{frame}

\begin{aligned}
\mathrm{empty\_frame}\left(\right) & = & \mathrm{empty\_map}\left\langle\mathsf{id}, \mathsf{value}\right\rangle\left(\right)
\end{aligned}

\mathsf{stateEnv} \mathrel{::=} \mathsf{map}\left\langle\mathsf{id}, \mathsf{parserStateIR}\right\rangle

\mathrm{empty\_stateEnv}\left(\right) : \mathsf{stateEnv}

\begin{aligned}
\mathrm{empty\_stateEnv}\left(\right) & = & \mathrm{empty\_map}\left\langle\mathsf{id}, \mathsf{parserStateIR}\right\rangle\left(\right)
\end{aligned}

\mathsf{callableDefEnv} \mathrel{::=} \mathsf{map}\left\langle\mathsf{callableId}, \mathsf{callableDef}\right\rangle

\mathrm{empty\_callableDefEnv}\left(\right) : \mathsf{callableDefEnv}

\begin{aligned}
\mathrm{empty\_callableDefEnv}\left(\right) & = & \mathrm{empty\_map}\left\langle\mathsf{callableId}, \mathsf{callableDef}\right\rangle\left(\right)
\end{aligned}

\mathsf{constructorDefEnv} \mathrel{::=} \mathsf{map}\left\langle\mathsf{callableId}, \mathsf{constructorDef}\right\rangle

\mathrm{empty\_constructorDefEnv}\left(\right) : \mathsf{constructorDefEnv}

\begin{aligned}
\mathrm{empty\_constructorDefEnv}\left(\right) & = & \mathrm{empty\_map}\left\langle\mathsf{callableId}, \mathsf{constructorDef}\right\rangle\left(\right)
\end{aligned}



\mathsf{store} \mathrel{::=} \mathsf{map}\left\langle\mathsf{objectId}, \mathsf{object}\right\rangle

\mathsf{STO} : \mathsf{store}

\mathrm{empty\_store}\left(\right) : \mathsf{store}

\begin{aligned}
\mathrm{empty\_store}\left(\right) & = & \mathsf{store} \quad \text{if}\,\mathsf{store} = \mathrm{empty\_map}\left\langle\mathsf{objectId}, \mathsf{object}\right\rangle\left(\right)
\end{aligned}



\mathrm{add\_store}\left(\mathsf{store}, \mathsf{objectId}, \mathsf{object}\right) : \mathsf{store}

\mathrlap{\displaystyle \begin{array}{rcl}
\mathrm{add\_store}\left(\mathsf{store}, \mathsf{objectId}, \mathsf{object}\right) & = & \mathsf{store'} \\
\mathrlap{\displaystyle \quad\text{if}\,\begin{array}{r@{\quad}l}
{\scriptstyle\mathtt{(1)}} & \neg \mathrm{in\_set}\left\langle\mathsf{objectId}\right\rangle\left(\mathsf{objectId}, \mathrm{dom\_map}\left\langle\mathsf{objectId}, \mathsf{object}\right\rangle\left(\mathsf{store}\right)\right) \\
{\scriptstyle\mathtt{(2)}} & \mathsf{store'} = \mathrm{add\_map}\left\langle\mathsf{objectId}, \mathsf{object}\right\rangle\left(\mathsf{store}, \mathsf{objectId}, \mathsf{object}\right)
\end{array}}\smash{\hphantom{\begin{array}{r}
\mathrm{add\_store}\left(\mathsf{store}, \mathsf{objectId}, \mathsf{object}\right)
\end{array}}} &  &
\end{array}}\smash{\hphantom{\begin{array}{l}
\begin{array}{rcl}
\mathrm{add\_store}\left(\mathsf{store}, \mathsf{objectId}, \mathsf{object}\right) & = & \mathsf{store'}
\end{array} \\
\quad\text{if}\,\begin{array}{r@{\quad}l}
{\scriptstyle\mathtt{(1)}} & \neg \mathrm{in\_set}\left\langle\mathsf{objectId}\right\rangle\left(\mathsf{objectId}, \mathrm{dom\_map}\left\langle\mathsf{objectId}, \mathsf{object}\right\rangle\left(\mathsf{store}\right)\right) \\
{\scriptstyle\mathtt{(2)}} & \mathsf{store'} = \mathrm{add\_map}\left\langle\mathsf{objectId}, \mathsf{object}\right\rangle\left(\mathsf{store}, \mathsf{objectId}, \mathsf{object}\right)
\end{array}
\end{array}}}



\mathrm{find\_store}\left(\mathsf{store}, \mathsf{objectId}\right) : \mathsf{object}

\mathrlap{\displaystyle \begin{array}{rcl}
\mathrm{find\_store}\left(\mathsf{store}, \mathsf{objectId}\right) & = & \mathsf{object} \\
\mathrlap{\displaystyle \quad\text{if}\,\mathsf{object} = \mathrm{find\_map}\left\langle\mathsf{objectId}, \mathsf{object}\right\rangle\left(\mathsf{store}, \mathsf{objectId}\right)}\smash{\hphantom{\begin{array}{r}
\mathrm{find\_store}\left(\mathsf{store}, \mathsf{objectId}\right)
\end{array}}} &  &
\end{array}}\smash{\hphantom{\begin{array}{l}
\begin{array}{rcl}
\mathrm{find\_store}\left(\mathsf{store}, \mathsf{objectId}\right) & = & \mathsf{object}
\end{array} \\
\quad\text{if}\,\mathsf{object} = \mathrm{find\_map}\left\langle\mathsf{objectId}, \mathsf{object}\right\rangle\left(\mathsf{store}, \mathsf{objectId}\right)
\end{array}}}



\mathsf{globalInstLayer} \mathrel{::=} \left\{\mathsf{CONSTRUCTOR} \mathsf{constructorDefEnv}, \mathsf{TYPE} \mathsf{typeDefEnv}, \mathsf{CALLABLE} \mathsf{callableDefEnv}, \mathsf{FRAME} \mathsf{frame}\right\}



\mathsf{blockInstLayer} \mathrel{::=} \left\{\mathsf{TYPE} \mathsf{theta}, \mathsf{CALLABLE} \mathsf{callableDefEnv}, \mathsf{STATE} \mathsf{stateEnv}, \mathsf{FRAME} \mathsf{frame}\right\}



\mathsf{localInstLayer} \mathrel{::=} \left\{\mathsf{TYPE} \mathsf{theta}, \mathsf{FRAMES} {\mathsf{frame}}^{\ast}\right\}



\mathsf{instContext} \mathrel{::=} \left\{\mathsf{PATH} \mathsf{objectId}, \mathsf{GLOBAL} \mathsf{globalInstLayer}, \mathsf{BLOCK} \mathsf{blockInstLayer}, \mathsf{LOCAL} \mathsf{localInstLayer}\right\}

\mathsf{IC} : \mathsf{instContext}



\mathrm{empty\_instContext}\left(\right) : \mathsf{instContext}

\mathrlap{\displaystyle \begin{array}{rcl}
\mathrm{empty\_instContext}\left(\right) & = & \mathsf{IC} \\
\mathrlap{\displaystyle \quad\text{if}\,\begin{array}{r@{\quad}l}
{\scriptstyle\mathtt{(1)}} & \mathsf{globalInstLayer} \\
 & \quad\quad= \left\{\begin{array}{l}
\mathsf{CONSTRUCTOR} \mathrm{empty\_constructorDefEnv}\left(\right), \\
\quad\quad\mathsf{TYPE} \mathrm{empty\_typeDefEnv}\left(\right), \\
\quad\quad\mathsf{CALLABLE} \mathrm{empty\_callableDefEnv}\left(\right), \\
\quad\quad\mathsf{FRAME} \mathrm{empty\_frame}\left(\right)
\end{array}\right\} \\
{\scriptstyle\mathtt{(2)}} & \mathsf{blockInstLayer} \\
 & \quad\quad= \left\{\begin{array}{l}
\mathsf{TYPE} \mathrm{empty\_theta}\left(\right), \\
\quad\quad\mathsf{CALLABLE} \mathrm{empty\_callableDefEnv}\left(\right), \\
\quad\quad\mathsf{STATE} \mathrm{empty\_stateEnv}\left(\right), \\
\quad\quad\mathsf{FRAME} \mathrm{empty\_frame}\left(\right)
\end{array}\right\} \\
{\scriptstyle\mathtt{(3)}} & \mathsf{localInstLayer} = \left\{\mathsf{TYPE} \mathrm{empty\_theta}\left(\right), \mathsf{FRAMES} \left(\left[\mathrm{empty\_frame}\left(\right)\right]\right)\right\} \\
{\scriptstyle\mathtt{(4)}} & \mathsf{IC} \\
 & \quad\quad= \left\{\begin{array}{l}
\mathsf{PATH} \left(\left[\right]\right), \\
\quad\quad\mathsf{GLOBAL} \mathsf{globalInstLayer}, \\
\quad\quad\mathsf{BLOCK} \mathsf{blockInstLayer}, \\
\quad\quad\mathsf{LOCAL} \mathsf{localInstLayer}
\end{array}\right\}
\end{array}}\smash{\hphantom{\begin{array}{r}
\mathrm{empty\_instContext}\left(\right)
\end{array}}} &  &
\end{array}}\smash{\hphantom{\begin{array}{l}
\begin{array}{rcl}
\mathrm{empty\_instContext}\left(\right) & = & \mathsf{IC}
\end{array} \\
\quad\text{if}\,\begin{array}{r@{\quad}l}
{\scriptstyle\mathtt{(1)}} & \mathsf{globalInstLayer} \\
 & \quad\quad= \left\{\begin{array}{l}
\mathsf{CONSTRUCTOR} \mathrm{empty\_constructorDefEnv}\left(\right), \\
\quad\quad\mathsf{TYPE} \mathrm{empty\_typeDefEnv}\left(\right), \\
\quad\quad\mathsf{CALLABLE} \mathrm{empty\_callableDefEnv}\left(\right), \\
\quad\quad\mathsf{FRAME} \mathrm{empty\_frame}\left(\right)
\end{array}\right\} \\
{\scriptstyle\mathtt{(2)}} & \mathsf{blockInstLayer} \\
 & \quad\quad= \left\{\begin{array}{l}
\mathsf{TYPE} \mathrm{empty\_theta}\left(\right), \\
\quad\quad\mathsf{CALLABLE} \mathrm{empty\_callableDefEnv}\left(\right), \\
\quad\quad\mathsf{STATE} \mathrm{empty\_stateEnv}\left(\right), \\
\quad\quad\mathsf{FRAME} \mathrm{empty\_frame}\left(\right)
\end{array}\right\} \\
{\scriptstyle\mathtt{(3)}} & \mathsf{localInstLayer} = \left\{\mathsf{TYPE} \mathrm{empty\_theta}\left(\right), \mathsf{FRAMES} \left(\left[\mathrm{empty\_frame}\left(\right)\right]\right)\right\} \\
{\scriptstyle\mathtt{(4)}} & \mathsf{IC} \\
 & \quad\quad= \left\{\begin{array}{l}
\mathsf{PATH} \left(\left[\right]\right), \\
\quad\quad\mathsf{GLOBAL} \mathsf{globalInstLayer}, \\
\quad\quad\mathsf{BLOCK} \mathsf{blockInstLayer}, \\
\quad\quad\mathsf{LOCAL} \mathsf{localInstLayer}
\end{array}\right\}
\end{array}
\end{array}}}



\mathrm{enter\_i}\left(\mathsf{instContext}\right) : \mathsf{instContext}

\begin{aligned}
\mathrm{enter\_i}\left(\mathsf{IC}\right) & = & \mathsf{IC}\left[\mathsf{LOCAL}.\mathsf{FRAMES} = \mathrm{empty\_frame}\left(\right) \mathbin{::} {{\mathsf{IC}}_{\mathsf{LOCAL}}}_{\mathsf{FRAMES}}\right]
\end{aligned}

\mathrm{exit\_i}\left(\mathsf{instContext}\right) : \mathsf{instContext}

\begin{aligned}
\mathrm{exit\_i}\left(\mathsf{IC}\right) & = & \mathsf{IC}\left[\mathsf{LOCAL}.\mathsf{FRAMES} = {{\mathsf{frame}}_{\mathsf{t}}}^{\ast}\right] \quad \text{if}\,{{\mathsf{IC}}_{\mathsf{LOCAL}}}_{\mathsf{FRAMES}} = {\mathsf{frame}}_{\mathsf{h}} \mathbin{::} {{\mathsf{frame}}_{\mathsf{t}}}^{\ast}
\end{aligned}



\mathrm{enter\_path\_i}\left(\mathsf{instContext}, \mathsf{id}\right) : \mathsf{instContext}

\begin{aligned}
\mathrm{enter\_path\_i}\left(\mathsf{IC}, \mathsf{id}\right) & = & \mathsf{IC}\left[\mathsf{PATH} = {\mathsf{IC}}_{\mathsf{PATH}} \mathbin{+\!\!+} \mathsf{id}\right]
\end{aligned}



\mathrm{inherit\_i}\left(\mathsf{cursor}, \mathsf{instContext}\right) : \mathsf{instContext}

\mathrlap{\displaystyle \begin{array}{rcl}
\mathrm{inherit\_i}\left(\mathsf{GLOBAL}, \mathsf{IC}\right) & = & \mathsf{IC}\left[\mathsf{BLOCK} = \mathsf{blockInstLayer}\right]\left[\mathsf{LOCAL} = \mathsf{localInstLayer}\right] \\
\mathrlap{\displaystyle \quad\text{if}\,\begin{array}{r@{\quad}l}
{\scriptstyle\mathtt{(1)}} & \mathsf{blockInstLayer} \\
 & \quad\quad= \left\{\begin{array}{l}
\mathsf{TYPE} \mathrm{empty\_theta}\left(\right), \\
\quad\quad\mathsf{CALLABLE} \mathrm{empty\_callableDefEnv}\left(\right), \\
\quad\quad\mathsf{STATE} \mathrm{empty\_stateEnv}\left(\right), \\
\quad\quad\mathsf{FRAME} \mathrm{empty\_frame}\left(\right)
\end{array}\right\} \\
{\scriptstyle\mathtt{(2)}} & \mathsf{localInstLayer} = \left\{\mathsf{TYPE} \mathrm{empty\_theta}\left(\right), \mathsf{FRAMES} \left(\left[\mathrm{empty\_frame}\left(\right)\right]\right)\right\}
\end{array}}\smash{\hphantom{\begin{array}{r}
\mathrm{inherit\_i}\left(\mathsf{GLOBAL}, \mathsf{IC}\right)
\end{array}}} &  &
\end{array}}\smash{\hphantom{\begin{array}{l}
\begin{array}{rcl}
\mathrm{inherit\_i}\left(\mathsf{GLOBAL}, \mathsf{IC}\right) & = & \mathsf{IC}\left[\mathsf{BLOCK} = \mathsf{blockInstLayer}\right]\left[\mathsf{LOCAL} = \mathsf{localInstLayer}\right]
\end{array} \\
\quad\text{if}\,\begin{array}{r@{\quad}l}
{\scriptstyle\mathtt{(1)}} & \mathsf{blockInstLayer} \\
 & \quad\quad= \left\{\begin{array}{l}
\mathsf{TYPE} \mathrm{empty\_theta}\left(\right), \\
\quad\quad\mathsf{CALLABLE} \mathrm{empty\_callableDefEnv}\left(\right), \\
\quad\quad\mathsf{STATE} \mathrm{empty\_stateEnv}\left(\right), \\
\quad\quad\mathsf{FRAME} \mathrm{empty\_frame}\left(\right)
\end{array}\right\} \\
{\scriptstyle\mathtt{(2)}} & \mathsf{localInstLayer} = \left\{\mathsf{TYPE} \mathrm{empty\_theta}\left(\right), \mathsf{FRAMES} \left(\left[\mathrm{empty\_frame}\left(\right)\right]\right)\right\}
\end{array}
\end{array}}}

\mathrlap{\displaystyle \begin{array}{rcl}
\mathrm{inherit\_i}\left(\mathsf{BLOCK}, \mathsf{IC}\right) & = & \mathsf{IC}\left[\mathsf{LOCAL} = \mathsf{localInstLayer}\right] \\
\mathrlap{\displaystyle \quad\text{if}\,\mathsf{localInstLayer} = \left\{\mathsf{TYPE} \mathrm{empty\_theta}\left(\right), \mathsf{FRAMES} \left(\left[\mathrm{empty\_frame}\left(\right)\right]\right)\right\}}\smash{\hphantom{\begin{array}{r}
\mathrm{inherit\_i}\left(\mathsf{BLOCK}, \mathsf{IC}\right)
\end{array}}} &  &
\end{array}}\smash{\hphantom{\begin{array}{l}
\begin{array}{rcl}
\mathrm{inherit\_i}\left(\mathsf{BLOCK}, \mathsf{IC}\right) & = & \mathsf{IC}\left[\mathsf{LOCAL} = \mathsf{localInstLayer}\right]
\end{array} \\
\quad\text{if}\,\mathsf{localInstLayer} = \left\{\mathsf{TYPE} \mathrm{empty\_theta}\left(\right), \mathsf{FRAMES} \left(\left[\mathrm{empty\_frame}\left(\right)\right]\right)\right\}
\end{array}}}

\begin{aligned}
\mathrm{inherit\_i}\left(\mathsf{LOCAL}, \mathsf{IC}\right) & = & \mathsf{IC}
\end{aligned}



\mathrm{add\_var\_i}\left(\mathsf{cursor}, \mathsf{instContext}, \mathsf{id}, \mathsf{value}\right) : \mathsf{instContext}

\mathrm{add\_vars\_i}\left(\mathsf{cursor}, \mathsf{instContext}, {\mathsf{id}}^{\ast}, {\mathsf{value}}^{\ast}\right) : \mathsf{instContext}

\mathrlap{\displaystyle \begin{array}{rcl}
\mathrm{add\_var\_i}\left(\mathsf{GLOBAL}, \mathsf{IC}, \mathsf{id}, \mathsf{value}\right) & = & \mathsf{IC}\left[\mathsf{GLOBAL}.\mathsf{FRAME} = \mathsf{frame}\right] \\
\mathrlap{\displaystyle \quad\text{if}\,\begin{array}{r@{\quad}l}
{\scriptstyle\mathtt{(1)}} & \neg \mathrm{in\_set}\left\langle\mathsf{id}\right\rangle\left(\mathsf{id}, \mathrm{dom\_map}\left\langle\mathsf{id}, \mathsf{value}\right\rangle\left({{\mathsf{IC}}_{\mathsf{GLOBAL}}}_{\mathsf{FRAME}}\right)\right) \\
{\scriptstyle\mathtt{(2)}} & \mathsf{frame} = \mathrm{add\_map}\left\langle\mathsf{id}, \mathsf{value}\right\rangle\left({{\mathsf{IC}}_{\mathsf{GLOBAL}}}_{\mathsf{FRAME}}, \mathsf{id}, \mathsf{value}\right)
\end{array}}\smash{\hphantom{\begin{array}{r}
\mathrm{add\_var\_i}\left(\mathsf{GLOBAL}, \mathsf{IC}, \mathsf{id}, \mathsf{value}\right)
\end{array}}} &  &
\end{array}}\smash{\hphantom{\begin{array}{l}
\begin{array}{rcl}
