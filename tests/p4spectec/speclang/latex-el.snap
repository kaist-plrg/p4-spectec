\mathrm{lift\_p4programIR}\left(\mathsf{p4programIR}\right) : {\mathsf{p4program}}^{?}

\mathrm{unflatten\_p4program}\left({\mathsf{declaration}}^{\ast}\right) : \mathsf{p4program}

\mathrm{unflatten\_p4program'}\left(\mathsf{p4program}, {\mathsf{declaration}}^{\ast}\right) : \mathsf{p4program}

\begin{aligned}
\mathrm{unflatten\_p4program}\left({\mathsf{declaration}}^{\ast}\right) & = & \mathrm{unflatten\_p4program'}\left({\,}_{\mathsf{EMPTY}}, {\mathsf{declaration}}^{\ast}\right)
\end{aligned}

\begin{aligned}
\mathrm{unflatten\_p4program'}\left(\mathsf{p4program}, \epsilon\right) & = & \mathsf{p4program}
\end{aligned}

\begin{aligned}
\mathrm{unflatten\_p4program'}\left(\mathsf{p4program}, {\mathsf{declaration}}_{\mathsf{h}} \mathbin{::} {{\mathsf{declaration}}_{\mathsf{t}}}^{\ast}\right) & = & \mathrm{unflatten\_p4program'}\left(\mathsf{p4program}\,{\mathsf{declaration}}_{\mathsf{h}}, {{\mathsf{declaration}}_{\mathsf{t}}}^{\ast}\right)
\end{aligned}

\mathrlap{\displaystyle \begin{array}{rcl}
\mathrm{lift\_p4programIR}\left({\mathsf{declarationIR}}^{\ast}\,\mathbin{\mathtt{;}}\right) & = & \mathrm{unflatten\_p4program}\left({\mathsf{declaration}}^{\ast}\right) \\
\mathrlap{\displaystyle \quad\text{if}\,{\left(\left(\mathsf{declaration} = \mathrm{lift\_declarationIR}\left(\mathsf{declarationIR}\right)\right)\right)}^{\ast}}\smash{\hphantom{\begin{array}{r}
\mathrm{lift\_p4programIR}\left({\mathsf{declarationIR}}^{\ast}\,\mathbin{\mathtt{;}}\right)
\end{array}}} &  &
\end{array}}\smash{\hphantom{\begin{array}{l}
\begin{array}{rcl}
\mathrm{lift\_p4programIR}\left({\mathsf{declarationIR}}^{\ast}\,\mathbin{\mathtt{;}}\right) & = & \mathrm{unflatten\_p4program}\left({\mathsf{declaration}}^{\ast}\right)
\end{array} \\
\quad\text{if}\,{\left(\left(\mathsf{declaration} = \mathrm{lift\_declarationIR}\left(\mathsf{declarationIR}\right)\right)\right)}^{\ast}
\end{array}}}

\begin{aligned}
\mathsf{flow} & \mathrel{::=} & \mathsf{CONT} \\
 & \mathrel{|} & \mathsf{RET}
\end{aligned}

\mathsf{f} : \mathsf{flow}

\mathrm{join\_flow}\left(\mathsf{flow}, \mathsf{flow}\right) : \mathsf{flow}

\begin{aligned}
\mathrm{join\_flow}\left(\mathsf{RET}, \mathsf{RET}\right) & = & \mathsf{RET}
\end{aligned}

\begin{aligned}
\mathrm{join\_flow}\left({\mathsf{f}}_{\mathsf{a}}, {\mathsf{f}}_{\mathsf{b}}\right) & = & \mathsf{CONT} \quad \text{if}\,\mathrm{otherwise}
\end{aligned}

\begin{aligned}
\mathsf{loop} & \mathrel{::=} & \mathsf{IN} \\
 & \mathrel{|} & \mathsf{OUT}
\end{aligned}

\mathsf{l} : \mathsf{loop}



\begin{aligned}
\mathsf{varTypeIR} & \mathrel{::=} & \mathsf{direction}\,\mathsf{typeIR}\,\mathsf{ctk}\,{\mathsf{value}}^{?}
\end{aligned}

\mathsf{typeFrame} \mathrel{::=} \mathsf{map}\left\langle\mathsf{id}, \mathsf{varTypeIR}\right\rangle

\mathrm{empty\_typeFrame}\left(\right) : \mathsf{typeFrame}

\begin{aligned}
\mathrm{empty\_typeFrame}\left(\right) & = & \mathrm{empty\_map}\left\langle\mathsf{id}, \mathsf{varTypeIR}\right\rangle\left(\right)
\end{aligned}



\mathsf{typeDefEnv} \mathrel{::=} \mathsf{map}\left\langle\mathsf{typeId}, \mathsf{typeDefIR}\right\rangle

\mathrm{empty\_typeDefEnv}\left(\right) : \mathsf{typeDefEnv}

\begin{aligned}
\mathrm{empty\_typeDefEnv}\left(\right) & = & \mathrm{empty\_map}\left\langle\mathsf{typeId}, \mathsf{typeDefIR}\right\rangle\left(\right)
\end{aligned}



\mathsf{callableTypeDefEnv} \mathrel{::=} \mathsf{map}\left\langle\mathsf{callableId}, \mathsf{callableTypeDefIR}\right\rangle

\mathrm{empty\_callableTypeDefEnv}\left(\right) : \mathsf{callableTypeDefEnv}

\begin{aligned}
\mathrm{empty\_callableTypeDefEnv}\left(\right) & = & \mathrm{empty\_map}\left\langle\mathsf{callableId}, \mathsf{callableTypeDefIR}\right\rangle\left(\right)
\end{aligned}



\mathsf{constructorTypeDefEnv} \mathrel{::=} \mathsf{map}\left\langle\mathsf{constructorId}, \mathsf{constructorTypeDefIR}\right\rangle

\mathrm{empty\_constructorTypeDefEnv}\left(\right) : \mathsf{constructorTypeDefEnv}

\begin{aligned}
\mathrm{empty\_constructorTypeDefEnv}\left(\right) & = & \mathrm{empty\_map}\left\langle\mathsf{constructorId}, \mathsf{constructorTypeDefIR}\right\rangle\left(\right)
\end{aligned}



\mathsf{globalTypingLayer} \mathrel{::=} \left\{\mathsf{CONSTRUCTOR} \mathsf{constructorTypeDefEnv}, \mathsf{TYPE} \mathsf{typeDefEnv}, \mathsf{CALLABLE} \mathsf{callableTypeDefEnv}, \mathsf{FRAME} \mathsf{typeFrame}\right\}



\begin{aligned}
\mathsf{blockKind} & \mathrel{::=} & {\,}_{\mathsf{EMPTY}} \\
 & \mathrel{|} & \mathsf{EXTERN} \\
 & \mathrel{|} & \mathsf{PARSER} \\
 & \mathrel{|} & \mathsf{CONTROL} \\
 & \mathrel{|} & \mathsf{PACKAGE}
\end{aligned}

\mathsf{blockTypingLayer} \mathrel{::=} \left\{\mathsf{KIND} \mathsf{blockKind}, \mathsf{TYPE} \mathsf{typeDefEnv}, \mathsf{CALLABLE} \mathsf{callableTypeDefEnv}, \mathsf{FRAME} \mathsf{typeFrame}\right\}



\begin{aligned}
\mathsf{actionLocalKind} & \mathrel{::=} & \mathsf{ACTION}
\end{aligned}

\begin{aligned}
\mathsf{definedFunctionLocalKind} & \mathrel{::=} & \mathsf{FUNCTION}\,\mathbin{\mathtt{:}}\,\mathsf{typeIR}
\end{aligned}

\begin{aligned}
\mathsf{externFunctionLocalKind} & \mathrel{::=} & \mathsf{EXTERN\_FUNCTION}\,\mathbin{\mathtt{:}}\,\mathsf{typeIR}
\end{aligned}

\begin{aligned}
\mathsf{functionLocalKind} & \mathrel{::=} & \mathsf{definedFunctionLocalKind} \\
 & \mathrel{|} & \mathsf{externFunctionLocalKind}
\end{aligned}

\begin{aligned}
\mathsf{externMethodLocalKind} & \mathrel{::=} & \mathsf{EXTERN\_METHOD}\,\mathbin{\mathtt{:}}\,\mathsf{typeIR} \\
 & \mathrel{|} & \mathsf{EXTERN\_METHOD}\,\mathsf{ABSTRACT}\,\mathbin{\mathtt{:}}\,\mathsf{typeIR}
\end{aligned}

\begin{aligned}
\mathsf{methodLocalKind} & \mathrel{::=} & \mathsf{externMethodLocalKind} \\
 & \mathrel{|} & \mathsf{PARSER\_STATE} \\
 & \mathrel{|} & \mathsf{CONTROL\_APPLY\_METHOD} \\
 & \mathrel{|} & \mathsf{TABLE\_APPLY\_METHOD}
\end{aligned}

\begin{aligned}
\mathsf{localKind} & \mathrel{::=} & {\,}_{\mathsf{EMPTY}} \\
 & \mathrel{|} & \mathsf{actionLocalKind} \\
 & \mathrel{|} & \mathsf{functionLocalKind} \\
 & \mathrel{|} & \mathsf{methodLocalKind}
\end{aligned}

\mathsf{localTypingLayer} \mathrel{::=} \left\{\mathsf{KIND} \mathsf{localKind}, \mathsf{TYPE} \mathsf{typeDefEnv}, \mathsf{FRAMES} {\mathsf{typeFrame}}^{\ast}\right\}



\mathsf{typingContext} \mathrel{::=} \left\{\mathsf{CONTROL} \mathsf{flow}, \mathsf{LOOP} \mathsf{loop}, \mathsf{GLOBAL} \mathsf{globalTypingLayer}, \mathsf{BLOCK} \mathsf{blockTypingLayer}, \mathsf{LOCAL} \mathsf{localTypingLayer}\right\}

\mathsf{TC} : \mathsf{typingContext}



\mathrm{empty\_typingContext}\left(\right) : \mathsf{typingContext}

\mathrlap{\displaystyle \begin{array}{rcl}
\mathrm{empty\_typingContext}\left(\right) & = & \mathsf{TC} \\
\mathrlap{\displaystyle \quad\text{if}\,\begin{array}{r@{\quad}l}
{\scriptstyle\mathtt{(1)}} & \mathsf{globalTypingLayer} \\
 & \quad\quad= \left\{\begin{array}{l}
\mathsf{CONSTRUCTOR} \mathrm{empty\_constructorTypeDefEnv}\left(\right), \\
\quad\quad\mathsf{TYPE} \mathrm{empty\_typeDefEnv}\left(\right), \\
\quad\quad\mathsf{CALLABLE} \mathrm{empty\_callableTypeDefEnv}\left(\right), \\
\quad\quad\mathsf{FRAME} \mathrm{empty\_typeFrame}\left(\right)
\end{array}\right\} \\
{\scriptstyle\mathtt{(2)}} & \mathsf{blockTypingLayer} \\
 & \quad\quad= \left\{\begin{array}{l}
\mathsf{KIND} {\,}_{\mathsf{EMPTY}}, \\
\quad\quad\mathsf{TYPE} \mathrm{empty\_typeDefEnv}\left(\right), \\
\quad\quad\mathsf{CALLABLE} \mathrm{empty\_callableTypeDefEnv}\left(\right), \\
\quad\quad\mathsf{FRAME} \mathrm{empty\_typeFrame}\left(\right)
\end{array}\right\} \\
{\scriptstyle\mathtt{(3)}} & \mathsf{localTypingLayer} \\
 & \quad\quad= \left\{\begin{array}{l}
\mathsf{KIND} {\,}_{\mathsf{EMPTY}}, \\
\quad\quad\mathsf{TYPE} \mathrm{empty\_typeDefEnv}\left(\right), \\
\quad\quad\mathsf{FRAMES} \left(\left[\mathrm{empty\_typeFrame}\left(\right)\right]\right)
\end{array}\right\} \\
{\scriptstyle\mathtt{(4)}} & \mathsf{TC} \\
 & \quad\quad= \left\{\begin{array}{l}
\mathsf{CONTROL} \mathsf{CONT}, \\
\quad\quad\mathsf{LOOP} \mathsf{OUT}, \\
\quad\quad\mathsf{GLOBAL} \mathsf{globalTypingLayer}, \\
\quad\quad\mathsf{BLOCK} \mathsf{blockTypingLayer}, \\
\quad\quad\mathsf{LOCAL} \mathsf{localTypingLayer}
\end{array}\right\}
\end{array}}\smash{\hphantom{\begin{array}{r}
\mathrm{empty\_typingContext}\left(\right)
\end{array}}} &  &
\end{array}}\smash{\hphantom{\begin{array}{l}
\begin{array}{rcl}
\mathrm{empty\_typingContext}\left(\right) & = & \mathsf{TC}
\end{array} \\
\quad\text{if}\,\begin{array}{r@{\quad}l}
{\scriptstyle\mathtt{(1)}} & \mathsf{globalTypingLayer} \\
 & \quad\quad= \left\{\begin{array}{l}
\mathsf{CONSTRUCTOR} \mathrm{empty\_constructorTypeDefEnv}\left(\right), \\
\quad\quad\mathsf{TYPE} \mathrm{empty\_typeDefEnv}\left(\right), \\
\quad\quad\mathsf{CALLABLE} \mathrm{empty\_callableTypeDefEnv}\left(\right), \\
\quad\quad\mathsf{FRAME} \mathrm{empty\_typeFrame}\left(\right)
\end{array}\right\} \\
{\scriptstyle\mathtt{(2)}} & \mathsf{blockTypingLayer} \\
 & \quad\quad= \left\{\begin{array}{l}
\mathsf{KIND} {\,}_{\mathsf{EMPTY}}, \\
\quad\quad\mathsf{TYPE} \mathrm{empty\_typeDefEnv}\left(\right), \\
\quad\quad\mathsf{CALLABLE} \mathrm{empty\_callableTypeDefEnv}\left(\right), \\
\quad\quad\mathsf{FRAME} \mathrm{empty\_typeFrame}\left(\right)
\end{array}\right\} \\
{\scriptstyle\mathtt{(3)}} & \mathsf{localTypingLayer} \\
 & \quad\quad= \left\{\begin{array}{l}
\mathsf{KIND} {\,}_{\mathsf{EMPTY}}, \\
\quad\quad\mathsf{TYPE} \mathrm{empty\_typeDefEnv}\left(\right), \\
\quad\quad\mathsf{FRAMES} \left(\left[\mathrm{empty\_typeFrame}\left(\right)\right]\right)
\end{array}\right\} \\
{\scriptstyle\mathtt{(4)}} & \mathsf{TC} \\
 & \quad\quad= \left\{\begin{array}{l}
\mathsf{CONTROL} \mathsf{CONT}, \\
\quad\quad\mathsf{LOOP} \mathsf{OUT}, \\
\quad\quad\mathsf{GLOBAL} \mathsf{globalTypingLayer}, \\
\quad\quad\mathsf{BLOCK} \mathsf{blockTypingLayer}, \\
\quad\quad\mathsf{LOCAL} \mathsf{localTypingLayer}
\end{array}\right\}
\end{array}
\end{array}}}



\mathrm{bound}\left(\mathsf{cursor}, \mathsf{typingContext}\right) : \mathsf{bound}

\begin{aligned}
\mathrm{bound}\left(\mathsf{GLOBAL}, \mathsf{TC}\right) & = & \left\{\epsilon\right\}
\end{aligned}

\begin{aligned}
\mathrm{bound}\left(\mathsf{BLOCK}, \mathsf{TC}\right) & = & \mathrm{dom\_map}\left\langle\mathsf{typeId}, \mathsf{typeDefIR}\right\rangle\left({{\mathsf{TC}}_{\mathsf{BLOCK}}}_{\mathsf{TYPE}}\right)
\end{aligned}

\mathrlap{\displaystyle \begin{array}{rcl}
\mathrm{bound}\left(\mathsf{LOCAL}, \mathsf{TC}\right) & = & \mathrm{union\_set}\left\langle\mathsf{typeId}\right\rangle\left({\mathsf{B}}_{\mathsf{block}}, {\mathsf{B}}_{\mathsf{local}}\right) \\
\mathrlap{\displaystyle \quad\text{if}\,\begin{array}{r@{\quad}l}
{\scriptstyle\mathtt{(1)}} & {\mathsf{B}}_{\mathsf{block}} = \mathrm{bound}\left(\mathsf{BLOCK}, \mathsf{TC}\right) \\
{\scriptstyle\mathtt{(2)}} & {\mathsf{B}}_{\mathsf{local}} = \mathrm{dom\_map}\left\langle\mathsf{typeId}, \mathsf{typeDefIR}\right\rangle\left({{\mathsf{TC}}_{\mathsf{LOCAL}}}_{\mathsf{TYPE}}\right)
\end{array}}\smash{\hphantom{\begin{array}{r}
\mathrm{bound}\left(\mathsf{LOCAL}, \mathsf{TC}\right)
\end{array}}} &  &
\end{array}}\smash{\hphantom{\begin{array}{l}
\begin{array}{rcl}
\mathrm{bound}\left(\mathsf{LOCAL}, \mathsf{TC}\right) & = & \mathrm{union\_set}\left\langle\mathsf{typeId}\right\rangle\left({\mathsf{B}}_{\mathsf{block}}, {\mathsf{B}}_{\mathsf{local}}\right)
\end{array} \\
\quad\text{if}\,\begin{array}{r@{\quad}l}
{\scriptstyle\mathtt{(1)}} & {\mathsf{B}}_{\mathsf{block}} = \mathrm{bound}\left(\mathsf{BLOCK}, \mathsf{TC}\right) \\
{\scriptstyle\mathtt{(2)}} & {\mathsf{B}}_{\mathsf{local}} = \mathrm{dom\_map}\left\langle\mathsf{typeId}, \mathsf{typeDefIR}\right\rangle\left({{\mathsf{TC}}_{\mathsf{LOCAL}}}_{\mathsf{TYPE}}\right)
\end{array}
\end{array}}}



\mathrm{enter\_t}\left(\mathsf{typingContext}\right) : \mathsf{typingContext}

\begin{aligned}
\mathrm{enter\_t}\left(\mathsf{TC}\right) & = & \mathsf{TC}\left[\mathsf{LOCAL}.\mathsf{FRAMES} = \mathrm{empty\_typeFrame}\left(\right) \mathbin{::} {{\mathsf{TC}}_{\mathsf{LOCAL}}}_{\mathsf{FRAMES}}\right]
\end{aligned}

\mathrm{exit\_t}\left(\mathsf{typingContext}\right) : \mathsf{typingContext}

\mathrlap{\displaystyle \begin{array}{rcl}
\mathrm{exit\_t}\left(\mathsf{TC}\right) & = & \mathsf{TC}\left[\mathsf{LOCAL}.\mathsf{FRAMES} = {{\mathsf{typeFrame}}_{\mathsf{t}}}^{\ast}\right] \\
\mathrlap{\displaystyle \quad\text{if}\,{\mathsf{typeFrame}}_{\mathsf{h}} \mathbin{::} {{\mathsf{typeFrame}}_{\mathsf{t}}}^{\ast} = {{\mathsf{TC}}_{\mathsf{LOCAL}}}_{\mathsf{FRAMES}}}\smash{\hphantom{\begin{array}{r}
\mathrm{exit\_t}\left(\mathsf{TC}\right)
\end{array}}} &  &
\end{array}}\smash{\hphantom{\begin{array}{l}
\begin{array}{rcl}
\mathrm{exit\_t}\left(\mathsf{TC}\right) & = & \mathsf{TC}\left[\mathsf{LOCAL}.\mathsf{FRAMES} = {{\mathsf{typeFrame}}_{\mathsf{t}}}^{\ast}\right]
\end{array} \\
\quad\text{if}\,{\mathsf{typeFrame}}_{\mathsf{h}} \mathbin{::} {{\mathsf{typeFrame}}_{\mathsf{t}}}^{\ast} = {{\mathsf{TC}}_{\mathsf{LOCAL}}}_{\mathsf{FRAMES}}
\end{array}}}



\mathrm{join\_control\_t}\left(\mathsf{typingContext}, \mathsf{typingContext}\right) : \mathsf{flow}

\begin{aligned}
\mathrm{join\_control\_t}\left({\mathsf{TC}}_{\mathsf{a}}, {\mathsf{TC}}_{\mathsf{b}}\right) & = & \mathrm{join\_flow}\left({{\mathsf{TC}}_{\mathsf{a}}}_{\mathsf{CONTROL}}, {{\mathsf{TC}}_{\mathsf{b}}}_{\mathsf{CONTROL}}\right)
\end{aligned}

\mathrm{set\_control\_t}\left(\mathsf{typingContext}, \mathsf{flow}\right) : \mathsf{typingContext}

\begin{aligned}
\mathrm{set\_control\_t}\left(\mathsf{TC}, \mathsf{flow}\right) & = & \mathsf{TC}\left[\mathsf{CONTROL} = \mathsf{flow}\right]
\end{aligned}



\mathrm{enter\_loop\_t}\left(\mathsf{typingContext}\right) : \mathsf{typingContext}

\begin{aligned}
\mathrm{enter\_loop\_t}\left(\mathsf{TC}\right) & = & \mathsf{TC}\left[\mathsf{LOOP} = \mathsf{IN}\right]
\end{aligned}

\mathrm{set\_loop\_t}\left(\mathsf{typingContext}, \mathsf{loop}\right) : \mathsf{typingContext}

\begin{aligned}
\mathrm{set\_loop\_t}\left(\mathsf{TC}, \mathsf{loop}\right) & = & \mathsf{TC}\left[\mathsf{LOOP} = \mathsf{loop}\right]
\end{aligned}



\mathrm{add\_var\_t}\left(\mathsf{cursor}, \mathsf{typingContext}, \mathsf{id}, \mathsf{varTypeIR}\right) : \mathsf{typingContext}

\mathrm{add\_vars\_t}\left(\mathsf{cursor}, \mathsf{typingContext}, {\mathsf{id}}^{\ast}, {\mathsf{varTypeIR}}^{\ast}\right) : \mathsf{typingContext}

\mathrlap{\displaystyle \begin{array}{rcl}
\mathrm{add\_var\_t}\left(\mathsf{GLOBAL}, \mathsf{TC}, \mathsf{id}, \mathsf{varTypeIR}\right) & = & \mathsf{TC'} \\
\mathrlap{\displaystyle \quad\text{if}\,\begin{array}{r@{\quad}l}
{\scriptstyle\mathtt{(1)}} & \mathsf{typeFrame} = {{\mathsf{TC}}_{\mathsf{GLOBAL}}}_{\mathsf{FRAME}} \\
{\scriptstyle\mathtt{(2)}} & \neg \mathrm{in\_set}\left\langle\mathsf{id}\right\rangle\left(\mathsf{id}, \mathrm{dom\_map}\left\langle\mathsf{id}, \mathsf{varTypeIR}\right\rangle\left(\mathsf{typeFrame}\right)\right) \\
{\scriptstyle\mathtt{(3)}} & \mathsf{\_}\,\mathsf{typeIR}\,\mathsf{\_}\,\mathsf{\_} = \mathsf{varTypeIR} \\
{\scriptstyle\mathtt{(4)}} & {\mathsf{typeIR}}_{\mathsf{unroll}} = \mathrm{unroll\_typeIR}\left(\mathsf{typeIR}\right) \\
{\scriptstyle\mathtt{(5)}} & \left(\mathsf{id} = \texttt{"main"}\right) \Rightarrow \left({\mathsf{typeIR}}_{\mathsf{unroll}} \mathrel{<:} \mathsf{packageObjectTypeIR}\right) \\
{\scriptstyle\mathtt{(6)}} & {\mathsf{typeFrame}}_{\mathsf{update}} = \mathrm{add\_map}\left\langle\mathsf{nameIR}, \mathsf{varTypeIR}\right\rangle\left(\mathsf{typeFrame}, \mathsf{id}, \mathsf{varTypeIR}\right) \\
{\scriptstyle\mathtt{(7)}} & \mathsf{TC'} = \mathsf{TC}\left[\mathsf{GLOBAL}.\mathsf{FRAME} = {\mathsf{typeFrame}}_{\mathsf{update}}\right]
\end{array}}\smash{\hphantom{\begin{array}{r}
\mathrm{add\_var\_t}\left(\mathsf{GLOBAL}, \mathsf{TC}, \mathsf{id}, \mathsf{varTypeIR}\right)
\end{array}}} &  &
\end{array}}\smash{\hphantom{\begin{array}{l}
\begin{array}{rcl}
\mathrm{add\_var\_t}\left(\mathsf{GLOBAL}, \mathsf{TC}, \mathsf{id}, \mathsf{varTypeIR}\right) & = & \mathsf{TC'}
\end{array} \\
\quad\text{if}\,\begin{array}{r@{\quad}l}
{\scriptstyle\mathtt{(1)}} & \mathsf{typeFrame} = {{\mathsf{TC}}_{\mathsf{GLOBAL}}}_{\mathsf{FRAME}} \\
{\scriptstyle\mathtt{(2)}} & \neg \mathrm{in\_set}\left\langle\mathsf{id}\right\rangle\left(\mathsf{id}, \mathrm{dom\_map}\left\langle\mathsf{id}, \mathsf{varTypeIR}\right\rangle\left(\mathsf{typeFrame}\right)\right) \\
{\scriptstyle\mathtt{(3)}} & \mathsf{\_}\,\mathsf{typeIR}\,\mathsf{\_}\,\mathsf{\_} = \mathsf{varTypeIR} \\
{\scriptstyle\mathtt{(4)}} & {\mathsf{typeIR}}_{\mathsf{unroll}} = \mathrm{unroll\_typeIR}\left(\mathsf{typeIR}\right) \\
{\scriptstyle\mathtt{(5)}} & \left(\mathsf{id} = \texttt{"main"}\right) \Rightarrow \left({\mathsf{typeIR}}_{\mathsf{unroll}} \mathrel{<:} \mathsf{packageObjectTypeIR}\right) \\
{\scriptstyle\mathtt{(6)}} & {\mathsf{typeFrame}}_{\mathsf{update}} = \mathrm{add\_map}\left\langle\mathsf{nameIR}, \mathsf{varTypeIR}\right\rangle\left(\mathsf{typeFrame}, \mathsf{id}, \mathsf{varTypeIR}\right) \\
{\scriptstyle\mathtt{(7)}} & \mathsf{TC'} = \mathsf{TC}\left[\mathsf{GLOBAL}.\mathsf{FRAME} = {\mathsf{typeFrame}}_{\mathsf{update}}\right]
\end{array}
\end{array}}}

\mathrlap{\displaystyle \begin{array}{rcl}
\mathrm{add\_var\_t}\left(\mathsf{BLOCK}, \mathsf{TC}, \mathsf{id}, \mathsf{varTypeIR}\right) & = & \mathsf{TC'} \\
\mathrlap{\displaystyle \quad\text{if}\,\begin{array}{r@{\quad}l}
{\scriptstyle\mathtt{(1)}} & \mathsf{typeFrame} = {{\mathsf{TC}}_{\mathsf{BLOCK}}}_{\mathsf{FRAME}} \\
{\scriptstyle\mathtt{(2)}} & \neg \mathrm{in\_set}\left\langle\mathsf{id}\right\rangle\left(\mathsf{id}, \mathrm{dom\_map}\left\langle\mathsf{id}, \mathsf{varTypeIR}\right\rangle\left(\mathsf{typeFrame}\right)\right) \\
{\scriptstyle\mathtt{(3)}} & \mathsf{id} \ne \texttt{"main"} \\
{\scriptstyle\mathtt{(4)}} & {\mathsf{typeFrame}}_{\mathsf{update}} = \mathrm{add\_map}\left\langle\mathsf{nameIR}, \mathsf{varTypeIR}\right\rangle\left({{\mathsf{TC}}_{\mathsf{BLOCK}}}_{\mathsf{FRAME}}, \mathsf{id}, \mathsf{varTypeIR}\right) \\
{\scriptstyle\mathtt{(5)}} & \mathsf{TC'} = \mathsf{TC}\left[\mathsf{BLOCK}.\mathsf{FRAME} = {\mathsf{typeFrame}}_{\mathsf{update}}\right]
\end{array}}\smash{\hphantom{\begin{array}{r}
\mathrm{add\_var\_t}\left(\mathsf{BLOCK}, \mathsf{TC}, \mathsf{id}, \mathsf{varTypeIR}\right)
\end{array}}} &  &
\end{array}}\smash{\hphantom{\begin{array}{l}
\begin{array}{rcl}
\mathrm{add\_var\_t}\left(\mathsf{BLOCK}, \mathsf{TC}, \mathsf{id}, \mathsf{varTypeIR}\right) & = & \mathsf{TC'}
\end{array} \\
\quad\text{if}\,\begin{array}{r@{\quad}l}
{\scriptstyle\mathtt{(1)}} & \mathsf{typeFrame} = {{\mathsf{TC}}_{\mathsf{BLOCK}}}_{\mathsf{FRAME}} \\
{\scriptstyle\mathtt{(2)}} & \neg \mathrm{in\_set}\left\langle\mathsf{id}\right\rangle\left(\mathsf{id}, \mathrm{dom\_map}\left\langle\mathsf{id}, \mathsf{varTypeIR}\right\rangle\left(\mathsf{typeFrame}\right)\right) \\
{\scriptstyle\mathtt{(3)}} & \mathsf{id} \ne \texttt{"main"} \\
