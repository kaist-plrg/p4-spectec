{\scriptstyle\mathtt{(2)}} & \mathsf{matchEntries} = \left\{\mathsf{SIZE} 0, \mathsf{CONST} \mathsf{true}\right\}
\end{array}}\smash{\hphantom{\begin{array}{r}
