\end{array}}}

\begin{aligned}
\mathrm{default}\left(\mathsf{STRUCT}\,\mathsf{typeId}\,\left\langle\mathsf{\_}\right\rangle\,\left\{{\left(\mathsf{\_}\,{\mathsf{typeIR}}_{\mathsf{f}}\,{\mathsf{id}}_{\mathsf{f}}\,\mathbin{\mathtt{;}}\right)}^{\ast}\right\}\right) & = & \mathsf{STRUCT}\,\mathsf{typeId}\,\left\{{\left(\mathrm{default}\left({\mathsf{typeIR}}_{\mathsf{f}}\right)\,{\mathsf{id}}_{\mathsf{f}}\,\mathbin{\mathtt{;}}\right)}^{\ast}\right\}
\end{aligned}

\begin{aligned}
\mathrm{default}\left(\mathsf{HEADER}\,\mathsf{typeId}\,\left\langle\mathsf{\_}\right\rangle\,\left\{{\left(\mathsf{\_}\,{\mathsf{typeIR}}_{\mathsf{f}}\,{\mathsf{id}}_{\mathsf{f}}\,\mathbin{\mathtt{;}}\right)}^{\ast}\right\}\right) & = & \mathsf{HEADER}\,\mathsf{typeId}\,\left\{\mathsf{false}\,\mathbin{\mathtt{;}}\,{\left(\mathrm{default}\left({\mathsf{typeIR}}_{\mathsf{f}}\right)\,{\mathsf{id}}_{\mathsf{f}}\,\mathbin{\mathtt{;}}\right)}^{\ast}\right\}
\end{aligned}

\begin{aligned}
\mathrm{default}\left(\mathsf{HEADER\_UNION}\,\mathsf{typeId}\,\left\langle\mathsf{\_}\right\rangle\,\left\{{\left(\mathsf{\_}\,{\mathsf{typeIR}}_{\mathsf{f}}\,{\mathsf{id}}_{\mathsf{f}}\,\mathbin{\mathtt{;}}\right)}^{\ast}\right\}\right) & = & \mathsf{HEADER\_UNION}\,\mathsf{typeId}\,\left\{{\left(\mathrm{default}\left({\mathsf{typeIR}}_{\mathsf{f}}\right)\,{\mathsf{id}}_{\mathsf{f}}\,\mathbin{\mathtt{;}}\right)}^{\ast}\right\}
\end{aligned}

\begin{aligned}
\mathrm{default}\left(\mathsf{ENUM}\,\mathsf{typeId}\,\left\{{\mathsf{id}}_{\mathsf{f\_h}} \mathbin{::} \mathsf{\_}\right\}\right) & = & \mathsf{typeId}\,\mathbin{\mathtt{.}}\,{\mathsf{id}}_{\mathsf{f\_h}}
\end{aligned}

\mathrlap{\displaystyle \begin{array}{rcl}
\mathrm{default}\left(\mathsf{ENUM}\,\mathsf{typeId}\,\left\langle\mathsf{typeIR}\right\rangle\,\left\{{\left({\mathsf{nameIR}}_{\mathsf{field}}\,\mathbin{\mathtt{=}}\,{\mathsf{value}}_{\mathsf{field}}\,\mathbin{\mathtt{;}}\right)}^{\ast}\right\}\right) & = & \mathsf{typeId}\,\mathbin{\mathtt{.}}\,{\mathsf{id}}_{\mathsf{zero}}\,\mathbin{\mathtt{.}}\,{\mathsf{value}}_{\mathsf{zero}} \\
\mathrlap{\displaystyle \quad\text{if}\,\begin{array}{r@{\quad}l}
{\scriptstyle\mathtt{(1)}} & {\mathsf{value}}_{\mathsf{zero}} = \mathrm{cast\_int}\left(\mathsf{typeIR}, \mathsf{D}\,0\right) \\
{\scriptstyle\mathtt{(2)}} & {\mathsf{id}}_{\mathsf{zero}} = \mathrm{assoc\_}\left\langle\mathsf{value}, \mathsf{id}\right\rangle\left({\mathsf{value}}_{\mathsf{zero}}, {\left({\mathsf{value}}_{\mathsf{field}}, {\mathsf{nameIR}}_{\mathsf{field}}\right)}^{\ast}\right)
\end{array}}\smash{\hphantom{\begin{array}{r}
\mathrm{default}\left(\mathsf{ENUM}\,\mathsf{typeId}\,\left\langle\mathsf{typeIR}\right\rangle\,\left\{{\left({\mathsf{nameIR}}_{\mathsf{field}}\,\mathbin{\mathtt{=}}\,{\mathsf{value}}_{\mathsf{field}}\,\mathbin{\mathtt{;}}\right)}^{\ast}\right\}\right)
\end{array}}} &  &
\end{array}}\smash{\hphantom{\begin{array}{l}
\begin{array}{rcl}
\mathrm{default}\left(\mathsf{ENUM}\,\mathsf{typeId}\,\left\langle\mathsf{typeIR}\right\rangle\,\left\{{\left({\mathsf{nameIR}}_{\mathsf{field}}\,\mathbin{\mathtt{=}}\,{\mathsf{value}}_{\mathsf{field}}\,\mathbin{\mathtt{;}}\right)}^{\ast}\right\}\right) & = & \mathsf{typeId}\,\mathbin{\mathtt{.}}\,{\mathsf{id}}_{\mathsf{zero}}\,\mathbin{\mathtt{.}}\,{\mathsf{value}}_{\mathsf{zero}}
\end{array} \\
\quad\text{if}\,\begin{array}{r@{\quad}l}
{\scriptstyle\mathtt{(1)}} & {\mathsf{value}}_{\mathsf{zero}} = \mathrm{cast\_int}\left(\mathsf{typeIR}, \mathsf{D}\,0\right) \\
{\scriptstyle\mathtt{(2)}} & {\mathsf{id}}_{\mathsf{zero}} = \mathrm{assoc\_}\left\langle\mathsf{value}, \mathsf{id}\right\rangle\left({\mathsf{value}}_{\mathsf{zero}}, {\left({\mathsf{value}}_{\mathsf{field}}, {\mathsf{nameIR}}_{\mathsf{field}}\right)}^{\ast}\right)
\end{array}
\end{array}}}

\mathrlap{\displaystyle \begin{array}{rcl}
\mathrm{default}\left(\mathsf{ENUM}\,\mathsf{typeId}\,\left\langle\mathsf{typeIR}\right\rangle\,\left\{{\left({\mathsf{nameIR}}_{\mathsf{field}}\,\mathbin{\mathtt{=}}\,{\mathsf{value}}_{\mathsf{field}}\,\mathbin{\mathtt{;}}\right)}^{\ast}\right\}\right) & = & \mathsf{typeId}\,\mathbin{\mathtt{.}}\,{\mathsf{id}}_{\mathsf{zero}}\,\mathbin{\mathtt{.}}\,{\mathsf{value}}_{\mathsf{zero}} \\
\mathrlap{\displaystyle \quad\text{if}\,\begin{array}{r@{\quad}l}
{\scriptstyle\mathtt{(1)}} & {\mathsf{value}}_{\mathsf{zero}} = \mathrm{cast\_int}\left(\mathsf{typeIR}, \mathsf{D}\,0\right) \\
{\scriptstyle\mathtt{(2)}} & \epsilon = \mathrm{assoc\_}\left\langle\mathsf{value}, \mathsf{id}\right\rangle\left({\mathsf{value}}_{\mathsf{zero}}, {\left({\mathsf{value}}_{\mathsf{field}}, {\mathsf{nameIR}}_{\mathsf{field}}\right)}^{\ast}\right) \\
{\scriptstyle\mathtt{(3)}} & {\mathsf{id}}_{\mathsf{zero}} = \texttt{"\_\_UNSPECIFIED"}
\end{array}}\smash{\hphantom{\begin{array}{r}
\mathrm{default}\left(\mathsf{ENUM}\,\mathsf{typeId}\,\left\langle\mathsf{typeIR}\right\rangle\,\left\{{\left({\mathsf{nameIR}}_{\mathsf{field}}\,\mathbin{\mathtt{=}}\,{\mathsf{value}}_{\mathsf{field}}\,\mathbin{\mathtt{;}}\right)}^{\ast}\right\}\right)
\end{array}}} &  &
\end{array}}\smash{\hphantom{\begin{array}{l}
\begin{array}{rcl}
\mathrm{default}\left(\mathsf{ENUM}\,\mathsf{typeId}\,\left\langle\mathsf{typeIR}\right\rangle\,\left\{{\left({\mathsf{nameIR}}_{\mathsf{field}}\,\mathbin{\mathtt{=}}\,{\mathsf{value}}_{\mathsf{field}}\,\mathbin{\mathtt{;}}\right)}^{\ast}\right\}\right) & = & \mathsf{typeId}\,\mathbin{\mathtt{.}}\,{\mathsf{id}}_{\mathsf{zero}}\,\mathbin{\mathtt{.}}\,{\mathsf{value}}_{\mathsf{zero}}
\end{array} \\
\quad\text{if}\,\begin{array}{r@{\quad}l}
{\scriptstyle\mathtt{(1)}} & {\mathsf{value}}_{\mathsf{zero}} = \mathrm{cast\_int}\left(\mathsf{typeIR}, \mathsf{D}\,0\right) \\
{\scriptstyle\mathtt{(2)}} & \epsilon = \mathrm{assoc\_}\left\langle\mathsf{value}, \mathsf{id}\right\rangle\left({\mathsf{value}}_{\mathsf{zero}}, {\left({\mathsf{value}}_{\mathsf{field}}, {\mathsf{nameIR}}_{\mathsf{field}}\right)}^{\ast}\right) \\
{\scriptstyle\mathtt{(3)}} & {\mathsf{id}}_{\mathsf{zero}} = \texttt{"\_\_UNSPECIFIED"}
