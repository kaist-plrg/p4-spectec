{\scriptstyle\mathtt{(3)}} & \mathsf{typeParameterListOpt} = \mathrm{lift\_typeParameterListIR}\left({\mathsf{typeParameterIR}}^{\ast}\right) \\
{\scriptstyle\mathtt{(4)}} & \mathsf{parameterList} = \mathrm{lift\_parameterListIR}\left({\mathsf{parameterIR}}^{\ast}\right)
\end{array}
\end{array}}}



\mathrm{lift\_typeDeclarationIR}\left(\mathsf{typeDeclarationIR}\right) : {\mathsf{typeDeclaration}}^{?}

\begin{aligned}
