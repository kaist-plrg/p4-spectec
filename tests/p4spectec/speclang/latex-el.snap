\mathrm{match\_keysets}\left({\mathsf{setValue}}^{\ast}, {\mathsf{value}}^{\ast}\right) : \mathbb{B}

\mathrm{match\_keyset}\left(\mathsf{setValue}, \mathsf{value}\right) : \mathbb{B}

\begin{aligned}
\mathrm{match\_keysets}\left(\epsilon, \epsilon\right) & = & \mathsf{true}
\end{aligned}

\begin{aligned}
\mathrm{match\_keysets}\left(\mathsf{SET}\,\left\{\mathbin{\mathtt{...}}\right\}, {{\mathsf{value}}_{\mathsf{key}}}^{\ast}\right) & = & \mathsf{true}
\end{aligned}

\mathrlap{\displaystyle \begin{array}{rcl}
\mathrm{match\_keysets}\left(\mathsf{setValue}, {\mathsf{value}}_{\mathsf{key}}\right) & = & \mathrm{match\_keyset}\left(\mathsf{setValue}, {\mathsf{value}}_{\mathsf{key}}\right) \\
\mathrlap{\displaystyle \quad\text{if}\,\mathsf{setValue} \ne \mathsf{SET}\,\left\{\mathbin{\mathtt{...}}\right\}}\smash{\hphantom{\begin{array}{r}
\mathrm{match\_keysets}\left(\mathsf{setValue}, {\mathsf{value}}_{\mathsf{key}}\right)
\end{array}}} &  &
\end{array}}\smash{\hphantom{\begin{array}{l}
\begin{array}{rcl}
\mathrm{match\_keysets}\left(\mathsf{setValue}, {\mathsf{value}}_{\mathsf{key}}\right) & = & \mathrm{match\_keyset}\left(\mathsf{setValue}, {\mathsf{value}}_{\mathsf{key}}\right)
\end{array} \\
\quad\text{if}\,\mathsf{setValue} \ne \mathsf{SET}\,\left\{\mathbin{\mathtt{...}}\right\}
\end{array}}}

\mathrlap{\displaystyle \begin{array}{rcl}
\mathrm{match\_keysets}\left({\mathsf{setValue}}_{\mathsf{h}} \mathbin{::} {{\mathsf{setValue}}_{\mathsf{t}}}^{\ast}, {\mathsf{value}}_{\mathsf{key\_h}} \mathbin{::} {{\mathsf{value}}_{\mathsf{key\_t}}}^{\ast}\right) & = & \mathrm{match\_keysets}\left({{\mathsf{setValue}}_{\mathsf{t}}}^{\ast}, {{\mathsf{value}}_{\mathsf{key\_t}}}^{\ast}\right) \\
\mathrlap{\displaystyle \quad\text{if}\,\begin{array}{r@{\quad}l}
{\scriptstyle\mathtt{(1)}} & {{\mathsf{setValue}}_{\mathsf{t}}}^{\ast} \ne \epsilon \\
{\scriptstyle\mathtt{(2)}} & {{\mathsf{value}}_{\mathsf{key\_t}}}^{\ast} \ne \epsilon \\
{\scriptstyle\mathtt{(3)}} & \mathrm{match\_keyset}\left({\mathsf{setValue}}_{\mathsf{h}}, {\mathsf{value}}_{\mathsf{key\_h}}\right)
\end{array}}\smash{\hphantom{\begin{array}{r}
\mathrm{match\_keysets}\left({\mathsf{setValue}}_{\mathsf{h}} \mathbin{::} {{\mathsf{setValue}}_{\mathsf{t}}}^{\ast}, {\mathsf{value}}_{\mathsf{key\_h}} \mathbin{::} {{\mathsf{value}}_{\mathsf{key\_t}}}^{\ast}\right)
\end{array}}} &  &
\end{array}}\smash{\hphantom{\begin{array}{l}
\begin{array}{rcl}
\mathrm{match\_keysets}\left({\mathsf{setValue}}_{\mathsf{h}} \mathbin{::} {{\mathsf{setValue}}_{\mathsf{t}}}^{\ast}, {\mathsf{value}}_{\mathsf{key\_h}} \mathbin{::} {{\mathsf{value}}_{\mathsf{key\_t}}}^{\ast}\right) & = & \mathrm{match\_keysets}\left({{\mathsf{setValue}}_{\mathsf{t}}}^{\ast}, {{\mathsf{value}}_{\mathsf{key\_t}}}^{\ast}\right)
\end{array} \\
\quad\text{if}\,\begin{array}{r@{\quad}l}
{\scriptstyle\mathtt{(1)}} & {{\mathsf{setValue}}_{\mathsf{t}}}^{\ast} \ne \epsilon \\
{\scriptstyle\mathtt{(2)}} & {{\mathsf{value}}_{\mathsf{key\_t}}}^{\ast} \ne \epsilon \\
{\scriptstyle\mathtt{(3)}} & \mathrm{match\_keyset}\left({\mathsf{setValue}}_{\mathsf{h}}, {\mathsf{value}}_{\mathsf{key\_h}}\right)
\end{array}
\end{array}}}

\mathrlap{\displaystyle \begin{array}{rcl}
\mathrm{match\_keysets}\left({\mathsf{setValue}}_{\mathsf{h}} \mathbin{::} {{\mathsf{setValue}}_{\mathsf{t}}}^{\ast}, {\mathsf{value}}_{\mathsf{key\_h}} \mathbin{::} {{\mathsf{value}}_{\mathsf{key\_t}}}^{\ast}\right) & = & \mathsf{false} \\
\mathrlap{\displaystyle \quad\text{if}\,\begin{array}{r@{\quad}l}
{\scriptstyle\mathtt{(1)}} & {{\mathsf{setValue}}_{\mathsf{t}}}^{\ast} \ne \epsilon \\
{\scriptstyle\mathtt{(2)}} & {{\mathsf{value}}_{\mathsf{key\_t}}}^{\ast} \ne \epsilon \\
{\scriptstyle\mathtt{(3)}} & \neg \mathrm{match\_keyset}\left({\mathsf{setValue}}_{\mathsf{h}}, {\mathsf{value}}_{\mathsf{key\_h}}\right)
\end{array}}\smash{\hphantom{\begin{array}{r}
\mathrm{match\_keysets}\left({\mathsf{setValue}}_{\mathsf{h}} \mathbin{::} {{\mathsf{setValue}}_{\mathsf{t}}}^{\ast}, {\mathsf{value}}_{\mathsf{key\_h}} \mathbin{::} {{\mathsf{value}}_{\mathsf{key\_t}}}^{\ast}\right)
\end{array}}} &  &
\end{array}}\smash{\hphantom{\begin{array}{l}
\begin{array}{rcl}
\mathrm{match\_keysets}\left({\mathsf{setValue}}_{\mathsf{h}} \mathbin{::} {{\mathsf{setValue}}_{\mathsf{t}}}^{\ast}, {\mathsf{value}}_{\mathsf{key\_h}} \mathbin{::} {{\mathsf{value}}_{\mathsf{key\_t}}}^{\ast}\right) & = & \mathsf{false}
\end{array} \\
\quad\text{if}\,\begin{array}{r@{\quad}l}
