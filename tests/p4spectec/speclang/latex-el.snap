\mathrm{tableEntry\_lpm\_prefix}\left(\mathsf{value}\right) : \mathbb{N}

\mathrm{tableEntry\_lpm\_prefix'}\left(\mathsf{value}, \mathbb{N}\right) : \mathbb{N}

\begin{aligned}
\mathrm{tableEntry\_lpm\_prefix}\left(\mathsf{value}\right) & = & \mathrm{tableEntry\_lpm\_prefix'}\left(\mathsf{value}, 0\right)
\end{aligned}

\begin{aligned}
\mathrm{tableEntry\_lpm\_prefix'}\left(0\,\mathsf{W}\,\mathsf{\_}, {\mathsf{n}}_{\mathsf{prefix}}\right) & = & {\mathsf{n}}_{\mathsf{prefix}}
\end{aligned}

\mathrlap{\displaystyle \begin{array}{rcl}
\mathrm{tableEntry\_lpm\_prefix'}\left(\mathsf{w}\,\mathsf{W}\,\mathsf{n}, {\mathsf{n}}_{\mathsf{prefix}}\right) & = & \mathrm{tableEntry\_lpm\_prefix'}\left(\mathsf{value'}, {\mathsf{n}}_{\mathsf{prefix}} + 1\right) \\
\mathrlap{\displaystyle \quad\text{if}\,\begin{array}{r@{\quad}l}
{\scriptstyle\mathtt{(1)}} & \mathsf{w} > 0 \\
{\scriptstyle\mathtt{(2)}} & \mathsf{w'} = \mathsf{w} - 1 \\
{\scriptstyle\mathtt{(3)}} & \mathsf{n} \bmod 2 \ne 0 \\
{\scriptstyle\mathtt{(4)}} & \mathsf{n'} = \left(\mathsf{n} - 1\right) / 2 \\
{\scriptstyle\mathtt{(5)}} & \mathsf{value'} = \mathsf{w'}\,\mathsf{W}\,\mathsf{n'}
\end{array}}\smash{\hphantom{\begin{array}{r}
\mathrm{tableEntry\_lpm\_prefix'}\left(\mathsf{w}\,\mathsf{W}\,\mathsf{n}, {\mathsf{n}}_{\mathsf{prefix}}\right)
\end{array}}} &  &
