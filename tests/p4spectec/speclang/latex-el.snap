\begin{aligned}
\mathrm{resolve\_type\_alias}\left(\mathsf{PACKAGE}\,{\mathsf{nameIR}}_{\mathsf{alias}}\,\left\langle{{\mathsf{typeIR}}_{\mathsf{arg}}}^{\ast}\right\rangle\,\left\{\mathsf{\_}\right\}\right) & = & \left({\mathsf{nameIR}}_{\mathsf{alias}}, {{\mathsf{typeIR}}_{\mathsf{arg}}}^{\ast}\right)
