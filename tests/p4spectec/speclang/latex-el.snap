\begin{aligned}
\mathrm{default}\left(\mathsf{VARBIT}\,\left\langle\mathsf{w}\right\rangle\right) & = & \mathsf{w}\,\mathbin{\mathtt{.}}\,0\,\mathsf{V}\,0
