\quad\text{if}\,\mathsf{STO} = \mathrm{add\_map}\left\langle\mathsf{objectId}, \mathsf{object}\right\rangle\left({\mathsf{ARCH}}_{\mathsf{STORE}}, \mathsf{objectId}, \mathsf{object}\right)
\end{array}}}



