\quad\quad\mathsf{STATE} \mathrm{empty\_stateEnv}\left(\right), \\
\quad\quad\mathsf{FRAME} \mathrm{empty\_frame}\left(\right)
\end{array}\right\} \\
{\scriptstyle\mathtt{(2)}} & \mathsf{localEvalLayer} = \left\{\mathsf{TYPE} \mathrm{empty\_theta}\left(\right), \mathsf{FRAMES} \left(\left[\mathrm{empty\_frame}\left(\right)\right]\right)\right\}
\end{array}
\end{array}}}

\mathrlap{\displaystyle \begin{array}{rcl}
