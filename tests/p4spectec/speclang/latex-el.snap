\end{array}}\smash{\hphantom{\begin{array}{l}
\begin{array}{rcl}
\mathrm{write\_value\_from\_bits'}\left(\mathsf{ARRAY}\,\left[{\mathsf{value}}^{\ast}\right], {\mathsf{n}}_{\mathsf{var}}, {\mathsf{b}}^{\ast}\right) & = & \left(\mathsf{ARRAY}\,\left[{{\mathsf{value}}_{\mathsf{updated}}}^{\ast}\right], {{\mathsf{b}}_{\mathsf{rest}}}^{\ast}\right)
\end{array} \\
\quad\text{if}\,\left({{\mathsf{value}}_{\mathsf{updated}}}^{\ast}, {{\mathsf{b}}_{\mathsf{rest}}}^{\ast}\right) = \mathrm{write\_values\_from\_bits'}\left({\mathsf{value}}^{\ast}, {\mathsf{n}}_{\mathsf{var}}, {\mathsf{b}}^{\ast}\right)
\end{array}}}

\mathrlap{\displaystyle \begin{array}{rcl}
\mathrm{write\_value\_from\_bits'}\left(\mathsf{HEADER\_STACK}\,\left[{\mathsf{value}}^{\ast}\,\left({\mathsf{n}}_{\mathsf{idx}}\right)\right], {\mathsf{n}}_{\mathsf{var}}, {\mathsf{b}}^{\ast}\right) & = & \left(\mathsf{HEADER\_STACK}\,\left[{{\mathsf{value}}_{\mathsf{updated}}}^{\ast}\,\left({\mathsf{n}}_{\mathsf{idx}}\right)\right], {{\mathsf{b}}_{\mathsf{rest}}}^{\ast}\right) \\
\mathrlap{\displaystyle \quad\text{if}\,\left({{\mathsf{value}}_{\mathsf{updated}}}^{\ast}, {{\mathsf{b}}_{\mathsf{rest}}}^{\ast}\right) = \mathrm{write\_values\_from\_bits'}\left({\mathsf{value}}^{\ast}, {\mathsf{n}}_{\mathsf{var}}, {\mathsf{b}}^{\ast}\right)}\smash{\hphantom{\begin{array}{r}
\mathrm{write\_value\_from\_bits'}\left(\mathsf{HEADER\_STACK}\,\left[{\mathsf{value}}^{\ast}\,\left({\mathsf{n}}_{\mathsf{idx}}\right)\right], {\mathsf{n}}_{\mathsf{var}}, {\mathsf{b}}^{\ast}\right)
\end{array}}} &  &
\end{array}}\smash{\hphantom{\begin{array}{l}
\begin{array}{rcl}
\mathrm{write\_value\_from\_bits'}\left(\mathsf{HEADER\_STACK}\,\left[{\mathsf{value}}^{\ast}\,\left({\mathsf{n}}_{\mathsf{idx}}\right)\right], {\mathsf{n}}_{\mathsf{var}}, {\mathsf{b}}^{\ast}\right) & = & \left(\mathsf{HEADER\_STACK}\,\left[{{\mathsf{value}}_{\mathsf{updated}}}^{\ast}\,\left({\mathsf{n}}_{\mathsf{idx}}\right)\right], {{\mathsf{b}}_{\mathsf{rest}}}^{\ast}\right)
\end{array} \\
\quad\text{if}\,\left({{\mathsf{value}}_{\mathsf{updated}}}^{\ast}, {{\mathsf{b}}_{\mathsf{rest}}}^{\ast}\right) = \mathrm{write\_values\_from\_bits'}\left({\mathsf{value}}^{\ast}, {\mathsf{n}}_{\mathsf{var}}, {\mathsf{b}}^{\ast}\right)
\end{array}}}



\mathrm{write\_bits\_from\_value}\left(\mathsf{value}\right) : {\mathbb{B}}^{\ast}

\begin{aligned}
\mathrm{write\_bits\_from\_value}\left({\,}_{\mathsf{B}}\,\mathsf{b}\right) & = & \left[\mathsf{b}\right]
\end{aligned}

\begin{aligned}
\mathrm{write\_bits\_from\_value}\left(\mathsf{w}\,\mathsf{S}\,\mathsf{i}\right) & = & \mathrm{int\_to\_bits\_signed}\left(\mathsf{w}, \mathsf{i}\right)
\end{aligned}

\begin{aligned}
\mathrm{write\_bits\_from\_value}\left(\mathsf{w}\,\mathsf{W}\,\mathsf{i}\right) & = & \mathrm{int\_to\_bits\_unsigned}\left(\mathsf{w}, \mathsf{i}\right)
\end{aligned}

\begin{aligned}
\mathrm{write\_bits\_from\_value}\left(\mathsf{\_}\,\mathbin{\mathtt{.}}\,\mathsf{w}\,\mathsf{V}\,\mathsf{i}\right) & = & \mathrm{int\_to\_bits\_unsigned}\left(\mathsf{w}, \mathsf{i}\right)
\end{aligned}

\begin{aligned}
\mathrm{write\_bits\_from\_value}\left(\mathsf{ARRAY}\,\left[{{\mathsf{value}}_{\mathsf{element}}}^{\ast}\right]\right) & = & \mathrm{concat\_}\left\langle\mathbb{B}\right\rangle\left({\mathrm{write\_bits\_from\_value}\left({\mathsf{value}}_{\mathsf{element}}\right)}^{\ast}\right)
\end{aligned}

\begin{aligned}
\mathrm{write\_bits\_from\_value}\left(\mathsf{HEADER\_STACK}\,\left[{{\mathsf{value}}_{\mathsf{element}}}^{\ast}\,\left(\mathsf{\_}\right)\right]\right) & = & \mathrm{concat\_}\left\langle\mathbb{B}\right\rangle\left({\mathrm{write\_bits\_from\_value}\left({\mathsf{value}}_{\mathsf{element}}\right)}^{\ast}\right)
\end{aligned}

\begin{aligned}
\mathrm{write\_bits\_from\_value}\left(\mathsf{STRUCT}\,\mathsf{\_}\,\left\{{\left({\mathsf{value}}_{\mathsf{field}}\,{\mathsf{id}}_{\mathsf{field}}\,\mathbin{\mathtt{;}}\right)}^{\ast}\right\}\right) & = & \mathrm{concat\_}\left\langle\mathbb{B}\right\rangle\left({\mathrm{write\_bits\_from\_value}\left({\mathsf{value}}_{\mathsf{field}}\right)}^{\ast}\right)
\end{aligned}

\begin{aligned}
\mathrm{write\_bits\_from\_value}\left(\mathsf{HEADER}\,\mathsf{\_}\,\left\{\mathsf{true}\,\mathbin{\mathtt{;}}\,{\left({\mathsf{value}}_{\mathsf{field}}\,{\mathsf{id}}_{\mathsf{field}}\,\mathbin{\mathtt{;}}\right)}^{\ast}\right\}\right) & = & \mathrm{concat\_}\left\langle\mathbb{B}\right\rangle\left({\mathrm{write\_bits\_from\_value}\left({\mathsf{value}}_{\mathsf{field}}\right)}^{\ast}\right)
\end{aligned}

\begin{aligned}
\mathrm{write\_bits\_from\_value}\left(\mathsf{HEADER}\,\mathsf{\_}\,\left\{\mathsf{false}\,\mathbin{\mathtt{;}}\,\mathsf{\_}\right\}\right) & = & \epsilon
\end{aligned}

\begin{aligned}
\mathrm{write\_bits\_from\_value}\left(\mathsf{HEADER\_UNION}\,\mathsf{\_}\,\left\{{\left(\mathsf{value}\,\mathsf{id}\,\mathbin{\mathtt{;}}\right)}^{\ast}\right\}\right) & = & \mathrm{concat\_}\left\langle\mathbb{B}\right\rangle\left({\mathrm{write\_bits\_from\_value}\left(\mathsf{value}\right)}^{\ast}\right)
\end{aligned}

\begin{aligned}
\mathrm{write\_bits\_from\_value}\left(\mathsf{typeId}\,\mathbin{\mathtt{.}}\,\mathsf{id}\,\mathbin{\mathtt{.}}\,\mathsf{value}\right) & = & \mathrm{write\_bits\_from\_value}\left(\mathsf{value}\right)
\end{aligned}

