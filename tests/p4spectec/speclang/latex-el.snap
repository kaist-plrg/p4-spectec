\end{array} \\
\quad\text{if}\,\begin{array}{r@{\quad}l}
{\scriptstyle\mathtt{(1)}} & {\left({\mathsf{b}}_{\mathsf{pri}} = \mathrm{requires\_priority}\left(\mathsf{tableKeyIR}\right)\right)}^{\ast} \\
{\scriptstyle\mathtt{(2)}} & \neg \mathrm{exists\_}\left({{\mathsf{b}}_{\mathsf{pri}}}^{\ast}\right) \\
{\scriptstyle\mathtt{(3)}} & {\left({\mathsf{b}}_{\mathsf{lpm}} = \mathrm{is\_lpm\_key}\left(\mathsf{tableKeyIR}\right)\right)}^{\ast} \\
{\scriptstyle\mathtt{(4)}} & {\mathsf{tableKeyIR}}_{\mathsf{lpm}} = \mathrm{filter\_}\left\langle\mathsf{tableKeyIR}\right\rangle\left({\mathsf{tableKeyIR}}^{\ast}, {{\mathsf{b}}_{\mathsf{lpm}}}^{\ast}\right) \\
{\scriptstyle\mathtt{(5)}} & \mathsf{typedExpressionIR}\,\mathbin{\mathtt{\#}}\,\mathsf{\_}\,\mathbin{\mathtt{:}}\,\texttt{"lpm"}\,\mathsf{\_}\,\mathbin{\mathtt{;}} = {\mathsf{tableKeyIR}}_{\mathsf{lpm}} \\
