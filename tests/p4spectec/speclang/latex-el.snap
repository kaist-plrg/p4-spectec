{\scriptstyle\mathtt{(3)}} & \neg \mathrm{match\_keyset}\left({\mathsf{setValue}}_{\mathsf{h}}, {\mathsf{value}}_{\mathsf{key\_h}}\right)
\end{array}
\end{array}}}

\begin{aligned}
\mathrm{match\_keyset}\left(\mathsf{SET}\,\left\{\mathbin{\mathtt{...}}\right\}, {\mathsf{value}}_{\mathsf{key}}\right) & = & \mathsf{true}
\end{aligned}

\begin{aligned}
\mathrm{match\_keyset}\left(\mathsf{SET}\,\left\{\mathsf{value}\right\}, {\mathsf{value}}_{\mathsf{key}}\right) & = & \mathrm{bin\_eq}\left(\mathsf{value}, {\mathsf{value}}_{\mathsf{key}}\right)
\end{aligned}

\begin{aligned}
\mathrm{match\_keyset}\left(\mathsf{SET}\,\left\{{\mathsf{value}}^{\ast}\,\left(\mathsf{\_}\right)\right\}, {\mathsf{value}}_{\mathsf{key}}\right) & = & \mathrm{exists\_}\left({\mathrm{bin\_eq}\left(\mathsf{value}, {\mathsf{value}}_{\mathsf{key}}\right)}^{\ast}\right)
\end{aligned}

\begin{aligned}
\mathrm{match\_keyset}\left(\mathsf{SET}\,\left\{{\mathsf{value}}_{\mathsf{base}}\,\mathbin{\mathtt{\&\&\&}}\,{\mathsf{value}}_{\mathsf{mask}}\right\}, {\mathsf{value}}_{\mathsf{key}}\right) & = & \mathrm{bin\_eq}\left(\mathrm{bin\_band}\left({\mathsf{value}}_{\mathsf{base}}, {\mathsf{value}}_{\mathsf{mask}}\right), \mathrm{bin\_band}\left({\mathsf{value}}_{\mathsf{key}}, {\mathsf{value}}_{\mathsf{mask}}\right)\right)
\end{aligned}

\begin{aligned}
\mathrm{match\_keyset}\left(\mathsf{SET}\,\left\{{\mathsf{value}}_{\mathsf{base}}\,\mathbin{\mathtt{..}}\,{\mathsf{value}}_{\mathsf{limit}}\right\}, {\mathsf{value}}_{\mathsf{key}}\right) & = & \mathrm{bin\_le}\left({\mathsf{value}}_{\mathsf{base}}, {\mathsf{value}}_{\mathsf{key}}\right) \land \mathrm{bin\_le}\left({\mathsf{value}}_{\mathsf{key}}, {\mathsf{value}}_{\mathsf{limit}}\right)
\end{aligned}



\begin{aligned}
\mathsf{simpleKeysetExpressionResult} & \mathrel{::=} & \mathsf{continueResult}\left\langle\mathsf{setValue}\right\rangle \\
 & \mathrel{|} & \mathsf{abortResult}
