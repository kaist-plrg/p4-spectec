{\scriptstyle\mathtt{(6)}} & {\mathsf{EC}}_{\mathsf{1}} = \mathrm{copy\_e}\left(\mathsf{BLOCK}, {\mathsf{EC}}_{\mathsf{callee\_2}}, {\mathsf{EC}}_{\mathsf{0}}\right)
