\mathrm{un\_op}\left(\mathsf{unop}, \mathsf{value}\right) : \mathsf{value}



\mathrm{un\_bnot}\left(\mathsf{value}\right) : \mathsf{value}

\begin{aligned}
\mathrm{un\_bnot}\left(\mathsf{w}\,\mathsf{W}\,\mathsf{i}\right) & = & \mathsf{w}\,\mathsf{W}\,\mathsf{i''} \quad \text{if}\,\begin{array}{r@{\quad}l}
{\scriptstyle\mathtt{(1)}} & \mathsf{i'} = \mathrm{bneg}\left(\mathsf{i}\right) \\
{\scriptstyle\mathtt{(2)}} & \mathsf{i''} = \mathrm{ite}\left\langle\mathbb{Z}\right\rangle\left(\mathsf{i'} \ge 0, \mathsf{i'}, \mathrm{pow2}\left(\mathsf{w}\right) + \mathsf{i'}\right)
\end{array}
\end{aligned}

\begin{aligned}
\mathrm{un\_bnot}\left(\mathsf{w}\,\mathsf{S}\,\mathsf{i}\right) & = & \mathsf{w}\,\mathsf{S}\,\mathsf{i''} \quad \text{if}\,\begin{array}{r@{\quad}l}
{\scriptstyle\mathtt{(1)}} & \mathsf{i'} = \mathrm{bneg}\left(\mathsf{i}\right) \\
{\scriptstyle\mathtt{(2)}} & \mathsf{i''} = \mathrm{ite}\left\langle\mathbb{Z}\right\rangle\left(\mathsf{i'} \ge 0, \mathsf{i'}, \mathrm{pow2}\left(\mathsf{w}\right) + \mathsf{i'}\right)
\end{array}
\end{aligned}

\begin{aligned}
\mathrm{un\_op}\left(\mathbin{\mathtt{\sim{}}}, \mathsf{value}\right) & = & \mathrm{un\_bnot}\left(\mathsf{value}\right)
\end{aligned}



\mathrm{un\_lnot}\left(\mathsf{value}\right) : \mathsf{value}

\begin{aligned}
\mathrm{un\_lnot}\left({\,}_{\mathsf{B}}\,\mathsf{b}\right) & = & {\,}_{\mathsf{B}}\,\left(\neg \mathsf{b}\right)
\end{aligned}

\begin{aligned}
\mathrm{un\_op}\left(\mathbin{\mathtt{!}}, \mathsf{value}\right) & = & \mathrm{un\_lnot}\left(\mathsf{value}\right)
\end{aligned}



\mathrm{un\_plus}\left(\mathsf{value}\right) : \mathsf{value}

\begin{aligned}
\mathrm{un\_plus}\left(\mathsf{D}\,\mathsf{i}\right) & = & \mathsf{D}\,\mathsf{i}
\end{aligned}

\begin{aligned}
\mathrm{un\_plus}\left(\mathsf{w}\,\mathsf{W}\,\mathsf{i}\right) & = & \mathsf{w}\,\mathsf{W}\,\mathsf{i}
\end{aligned}

\begin{aligned}
\mathrm{un\_plus}\left(\mathsf{w}\,\mathsf{S}\,\mathsf{i}\right) & = & \mathsf{w}\,\mathsf{S}\,\mathsf{i}
\end{aligned}

\begin{aligned}
\mathrm{un\_op}\left(\mathbin{\mathtt{+}}, \mathsf{value}\right) & = & \mathrm{un\_plus}\left(\mathsf{value}\right)
\end{aligned}



\mathrm{un\_minus}\left(\mathsf{value}\right) : \mathsf{value}

\begin{aligned}
\mathrm{un\_minus}\left(\mathsf{D}\,\mathsf{i}\right) & = & \mathsf{D}\,\left(- \mathsf{i}\right)
\end{aligned}

\begin{aligned}
\mathrm{un\_minus}\left(\mathsf{w}\,\mathsf{W}\,\mathsf{i}\right) & = & \mathsf{w}\,\mathsf{W}\,\mathsf{i'} \quad \text{if}\,\mathsf{i'} = \mathrm{int\_to\_bitstr}\left(\mathsf{w}, \mathrm{pow2}\left(\mathsf{w}\right) - \mathsf{i}\right)
\end{aligned}

\begin{aligned}
\mathrm{un\_minus}\left(\mathsf{w}\,\mathsf{S}\,\mathsf{i}\right) & = & \mathsf{w}\,\mathsf{S}\,\mathsf{i'} \quad \text{if}\,\mathsf{i'} = \mathrm{int\_to\_bitstr}\left(\mathsf{w}, \mathrm{bitstr\_to\_int}\left(\mathsf{w}, - \mathsf{i}\right)\right)
\end{aligned}

\begin{aligned}
\mathrm{un\_op}\left(\mathbin{\mathtt{-}}, \mathsf{value}\right) & = & \mathrm{un\_minus}\left(\mathsf{value}\right)
\end{aligned}



