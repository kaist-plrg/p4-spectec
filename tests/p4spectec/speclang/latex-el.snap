{\scriptstyle\mathtt{(3)}} & \mathsf{i'} = \mathrm{ite}\left\langle\mathbb{Z}\right\rangle\left(\mathsf{i} < {\mathsf{i}}_{\mathsf{max}}, \mathsf{i}, {\mathsf{i}}_{\mathsf{max}} - 1\right)
\end{array}
