\begin{aligned}
\mathrm{sizeof\_minSizeInBits}\left(\mathsf{typeIR}\right) & = & \mathsf{D}\,\mathrm{sizeof\_minSizeInBits'}\left(\mathsf{typeIR}\right)
\end{aligned}

\begin{aligned}
\mathrm{sizeof\_minSizeInBits'}\left(\mathsf{BOOL}\right) & = & 1
\end{aligned}

\begin{aligned}
\mathrm{sizeof\_minSizeInBits'}\left(\mathsf{INT}\,\left\langle\mathsf{w}\right\rangle\right) & = & \mathsf{w}
\end{aligned}

\begin{aligned}
\mathrm{sizeof\_minSizeInBits'}\left(\mathsf{BIT}\,\left\langle\mathsf{w}\right\rangle\right) & = & \mathsf{w}
\end{aligned}

\begin{aligned}
\mathrm{sizeof\_minSizeInBits'}\left(\mathsf{VARBIT}\,\left\langle\mathsf{\_}\right\rangle\right) & = & 0
\end{aligned}

\begin{aligned}
\mathrm{sizeof\_minSizeInBits'}\left(\mathsf{TYPEDEF}\,\mathsf{\_}\,\mathsf{typeIR}\right) & = & \mathrm{sizeof\_minSizeInBits'}\left(\mathsf{typeIR}\right)
\end{aligned}

\begin{aligned}
\mathrm{sizeof\_minSizeInBits'}\left(\mathsf{TYPE}\,\mathsf{\_}\,\mathsf{typeIR}\right) & = & \mathrm{sizeof\_minSizeInBits'}\left(\mathsf{typeIR}\right)
\end{aligned}

\begin{aligned}
\mathrm{sizeof\_minSizeInBits'}\left(\mathsf{ENUM}\,\mathsf{\_}\,\left\langle\mathsf{typeIR}\right\rangle\,\left\{\mathsf{\_}\right\}\right) & = & \mathrm{sizeof\_minSizeInBits'}\left(\mathsf{typeIR}\right)
