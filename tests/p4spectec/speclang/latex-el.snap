\end{array} \\
\quad\text{if}\,\begin{array}{r@{\quad}l}
{\scriptstyle\mathtt{(1)}} & \mathsf{matchPriority} = \left\{\mathsf{DELTA} 1, \mathsf{LARGEST\_WINS} \mathsf{true}\right\} \\
{\scriptstyle\mathtt{(2)}} & \mathsf{matchEntries} = \left\{\mathsf{SIZE} 0, \mathsf{CONST} \mathsf{true}\right\}
\end{array}
\end{array}}}



