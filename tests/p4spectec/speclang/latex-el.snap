\mathsf{p}\,{\mathsf{EC}}_{\mathsf{0}}\,{\mathsf{ARCH}}_{\mathsf{0}} \\
\quad\quad\mathrel{\vdash} \mathsf{tableApplyMethodCallee}\,\mathbin{\mathtt{@}}\,\left\langle\mathsf{typeArgumentListIR}\right\rangle\,\left(\mathsf{argumentListIR}\right) \\
