\mathrm{is\_monomorphic\_typeDefIR}\left(\mathsf{typeDefIR}\right) : \mathbb{B}

\mathrm{is\_polymorphic\_typeDefIR}\left(\mathsf{typeDefIR}\right) : \mathbb{B}

\begin{aligned}
\mathrm{is\_monomorphic\_typeDefIR}\left(\mathsf{nameTypeDefIR}\right) & = & \mathsf{true}
\end{aligned}

\begin{aligned}
\mathrm{is\_monomorphic\_typeDefIR}\left(\mathsf{aliasTypeDefIR}\right) & = & \mathsf{true}
\end{aligned}

\begin{aligned}
\mathrm{is\_monomorphic\_typeDefIR}\left(\mathsf{enumTypeDefIR}\right) & = & \mathsf{true}
\end{aligned}

\begin{aligned}
\mathrm{is\_monomorphic\_typeDefIR}\left(\mathsf{tableObjectTypeDefIR}\right) & = & \mathsf{true}
\end{aligned}

\begin{aligned}
\mathrm{is\_monomorphic\_typeDefIR}\left(\mathsf{typeDefIR}\right) & = & \mathsf{false} \quad \text{if}\,\mathrm{otherwise}
\end{aligned}

\begin{aligned}
\mathrm{is\_polymorphic\_typeDefIR}\left(\mathsf{typeDefIR}\right) & = & \neg \mathrm{is\_monomorphic\_typeDefIR}\left(\mathsf{typeDefIR}\right)
\end{aligned}



\mathsf{typedExpressionIR} \quad \text{syntax}

\begin{aligned}
\mathsf{initializerIR} & \mathrel{::=} & \mathbin{\mathtt{=}}\,\mathsf{typedExpressionIR}
\end{aligned}

\begin{aligned}
\mathsf{constantInitializerIR} & \mathrel{::=} & \mathbin{\mathtt{=}}\,{\,}_{\mathsf{VALUE}}\,\mathsf{value}
\end{aligned}

\begin{aligned}
\mathsf{parameterInitializerIR} & \mathrel{::=} & \mathsf{initializerIR} \\
 & \mathrel{|} & \mathsf{constantInitializerIR}
\end{aligned}

\mathsf{parameterInitializerOptIR} \mathrel{::=} {\mathsf{parameterInitializerIR}}^{?}

\begin{aligned}
\mathsf{parameterIR} & \mathrel{::=} & \mathsf{annotationList}\,\mathsf{direction}\,\mathsf{typeIR}\,\mathsf{id}\,\mathsf{parameterInitializerOptIR}
\end{aligned}



\begin{aligned}
\mathsf{actionTypeIR} & \mathrel{::=} & \mathsf{annotationList}\,\mathsf{ACTION}\,\mathsf{nameIR}\,\left({\mathsf{parameterIR}}^{\ast}\right)
\end{aligned}



\begin{aligned}
\mathsf{definedFunctionTypeIR} & \mathrel{::=} & \mathsf{FUNCTION}\,\mathsf{nameIR}\,\left({\mathsf{parameterIR}}^{\ast}\right)\,\mathbin{\mathtt{:}}\,\mathsf{typeIR}
