\mathrlap{\displaystyle \quad\text{if}\,\begin{array}{r@{\quad}l}
{\scriptstyle\mathtt{(1)}} & \mathsf{w} > 0 \\
{\scriptstyle\mathtt{(2)}} & \mathsf{w'} = \mathsf{w} - 1 \\
{\scriptstyle\mathtt{(3)}} & \mathsf{n} \bmod 2 = 0 \\
{\scriptstyle\mathtt{(4)}} & \mathsf{value'} = \mathsf{w'}\,\mathsf{W}\,\left(\mathsf{n} / 2\right)
\end{array}}\smash{\hphantom{\begin{array}{r}
\mathrm{tableEntry\_lpm\_prefix'}\left(\mathsf{w}\,\mathsf{W}\,\mathsf{n}, 0\right)
\end{array}}} &  &
\end{array}}\smash{\hphantom{\begin{array}{l}
\begin{array}{rcl}
\mathrm{tableEntry\_lpm\_prefix'}\left(\mathsf{w}\,\mathsf{W}\,\mathsf{n}, 0\right) & = & \mathrm{tableEntry\_lpm\_prefix'}\left(\mathsf{value'}, 0\right)
\end{array} \\
\quad\text{if}\,\begin{array}{r@{\quad}l}
{\scriptstyle\mathtt{(1)}} & \mathsf{w} > 0 \\
{\scriptstyle\mathtt{(2)}} & \mathsf{w'} = \mathsf{w} - 1 \\
{\scriptstyle\mathtt{(3)}} & \mathsf{n} \bmod 2 = 0 \\
{\scriptstyle\mathtt{(4)}} & \mathsf{value'} = \mathsf{w'}\,\mathsf{W}\,\left(\mathsf{n} / 2\right)
\end{array}
\end{array}}}

