{\scriptstyle\mathtt{(4)}} & \mathsf{GLOBAL}\,\mathsf{IC}\,\mathsf{STO} \mathrel{\vdash} \mathsf{constructorDef}\,\left\langle\epsilon\right\rangle\,\left(\epsilon\,\mathbin{\mathtt{\#}}\,\epsilon\,\mathbin{\mathtt{\#}}\,\epsilon\right) : {\mathsf{STO}}_{\mathsf{1}}\,\mathsf{object} \\
