\mathsf{b} : \mathbb{B}

\mathsf{i} : \mathbb{Z}

\mathsf{n} : \mathbb{N}

\mathsf{w} : \mathbb{N}

\mathsf{t} : \mathbb{T}



\mathrm{ite}\left\langle\mathsf{X}\right\rangle\left(\mathbb{B}, \mathsf{X}, \mathsf{X}\right) : \mathsf{X}

\begin{aligned}
\mathrm{ite}\left\langle\mathsf{X}\right\rangle\left(\mathsf{true}, {\mathsf{X}}_{\mathsf{t}}, {\mathsf{X}}_{\mathsf{f}}\right) & = & {\mathsf{X}}_{\mathsf{t}}
\end{aligned}

\begin{aligned}
\mathrm{ite}\left\langle\mathsf{X}\right\rangle\left(\mathsf{false}, {\mathsf{X}}_{\mathsf{t}}, {\mathsf{X}}_{\mathsf{f}}\right) & = & {\mathsf{X}}_{\mathsf{f}}
\end{aligned}



\mathrm{sum\_nat}\left({\mathbb{N}}^{\ast}\right) : \mathbb{N} \quad \text{builtin}

\mathrm{max\_nat}\left({\mathbb{N}}^{\ast}\right) : \mathbb{N} \quad \text{builtin}

\mathrm{min\_nat}\left({\mathbb{N}}^{\ast}\right) : \mathbb{N} \quad \text{builtin}



\mathrm{sum\_int}\left({\mathbb{Z}}^{\ast}\right) : \mathbb{Z} \quad \text{builtin}

\mathrm{max\_int}\left({\mathbb{Z}}^{\ast}\right) : \mathbb{Z} \quad \text{builtin}

\mathrm{min\_int}\left({\mathbb{Z}}^{\ast}\right) : \mathbb{Z} \quad \text{builtin}



\mathrm{text\_to\_int}\left(\mathbb{T}\right) : \mathbb{Z} \quad \text{builtin}

\mathrm{int\_to\_text}\left(\mathbb{Z}\right) : \mathbb{T} \quad \text{builtin}

\mathrm{split\_text}\left(\mathbb{T}, \mathbb{T}\right) : {\mathbb{T}}^{\ast} \quad \text{builtin}

\mathrm{concat\_text}\left({\mathbb{T}}^{\ast}\right) : \mathbb{T}

\begin{aligned}
\mathrm{concat\_text}\left(\epsilon\right) & = & \texttt{""}
\end{aligned}

\begin{aligned}
\mathrm{concat\_text}\left({\mathsf{t}}_{\mathsf{h}} \mathbin{::} {{\mathsf{t}}_{\mathsf{t}}}^{\ast}\right) & = & {\mathsf{t}}_{\mathsf{h}} \mathbin{+\!\!+} \mathrm{concat\_text}\left({{\mathsf{t}}_{\mathsf{t}}}^{\ast}\right)
\end{aligned}

\mathrm{join\_text}\left({\mathbb{T}}^{\ast}, \mathbb{T}\right) : \mathbb{T}

\begin{aligned}
\mathrm{join\_text}\left(\epsilon, {\mathsf{t}}_{\mathsf{sep}}\right) & = & \texttt{""}
\end{aligned}

\begin{aligned}
\mathrm{join\_text}\left(\left[{\mathsf{t}}_{\mathsf{h}}\right], {\mathsf{t}}_{\mathsf{sep}}\right) & = & {\mathsf{t}}_{\mathsf{h}}
\end{aligned}

\begin{aligned}
\mathrm{join\_text}\left({\mathsf{t}}_{\mathsf{h1}} \mathbin{::} {\mathsf{t}}_{\mathsf{h2}} \mathbin{::} {{\mathsf{t}}_{\mathsf{t}}}^{\ast}, {\mathsf{t}}_{\mathsf{sep}}\right) & = & {\mathsf{t}}_{\mathsf{h1}} \mathbin{+\!\!+} {\mathsf{t}}_{\mathsf{sep}} \mathbin{+\!\!+} \mathrm{join\_text}\left({\mathsf{t}}_{\mathsf{h2}} \mathbin{::} {{\mathsf{t}}_{\mathsf{t}}}^{\ast}, {\mathsf{t}}_{\mathsf{sep}}\right)
\end{aligned}

\mathrm{replace\_text}\left(\mathbb{T}, \mathbb{T}, \mathbb{T}\right) : \mathbb{T}

\mathrm{replace\_text'}\left(\mathbb{N}, \mathbb{N}, \mathbb{T}, \mathbb{T}, \mathbb{T}\right) : \mathbb{T}

\begin{aligned}
\mathrm{replace\_text}\left(\mathsf{t}, {\mathsf{t}}_{\mathsf{old}}, {\mathsf{t}}_{\mathsf{new}}\right) & = & \mathrm{replace\_text'}\left(0, \left|\mathsf{t}\right|, \mathsf{t}, {\mathsf{t}}_{\mathsf{old}}, {\mathsf{t}}_{\mathsf{new}}\right)
\end{aligned}

\begin{aligned}
\mathrm{replace\_text'}\left({\mathsf{n}}_{\mathsf{len}}, {\mathsf{n}}_{\mathsf{len}}, \mathsf{t}, {\mathsf{t}}_{\mathsf{old}}, {\mathsf{t}}_{\mathsf{new}}\right) & = & \mathsf{t}
\end{aligned}

\mathrlap{\displaystyle \begin{array}{rcl}
\mathrm{replace\_text'}\left(\mathsf{n}, {\mathsf{n}}_{\mathsf{len}}, \mathsf{t}, {\mathsf{t}}_{\mathsf{old}}, {\mathsf{t}}_{\mathsf{new}}\right) & = & \mathrm{replace\_text'}\left(\mathsf{n} + 1, {\mathsf{n}}_{\mathsf{len}}, {\mathsf{t}}_{\mathsf{replaced}}, {\mathsf{t}}_{\mathsf{old}}, {\mathsf{t}}_{\mathsf{new}}\right) \\
\mathrlap{\displaystyle \quad\text{if}\,\begin{array}{r@{\quad}l}
{\scriptstyle\mathtt{(1)}} & \mathsf{n} < {\mathsf{n}}_{\mathsf{len}} \\
{\scriptstyle\mathtt{(2)}} & {\mathsf{t}}_{\mathsf{replaced}} = \mathrm{ite}\left\langle\mathbb{T}\right\rangle\left(\mathsf{t}\left[\mathsf{n}\right] = {\mathsf{t}}_{\mathsf{old}}, \mathsf{t}\left[\left[\mathsf{n}\right] = {\mathsf{t}}_{\mathsf{new}}\right], \mathsf{t}\right)
\end{array}}\smash{\hphantom{\begin{array}{r}
\mathrm{replace\_text'}\left(\mathsf{n}, {\mathsf{n}}_{\mathsf{len}}, \mathsf{t}, {\mathsf{t}}_{\mathsf{old}}, {\mathsf{t}}_{\mathsf{new}}\right)
\end{array}}} &  &
\end{array}}\smash{\hphantom{\begin{array}{l}
\begin{array}{rcl}
\mathrm{replace\_text'}\left(\mathsf{n}, {\mathsf{n}}_{\mathsf{len}}, \mathsf{t}, {\mathsf{t}}_{\mathsf{old}}, {\mathsf{t}}_{\mathsf{new}}\right) & = & \mathrm{replace\_text'}\left(\mathsf{n} + 1, {\mathsf{n}}_{\mathsf{len}}, {\mathsf{t}}_{\mathsf{replaced}}, {\mathsf{t}}_{\mathsf{old}}, {\mathsf{t}}_{\mathsf{new}}\right)
\end{array} \\
\quad\text{if}\,\begin{array}{r@{\quad}l}
{\scriptstyle\mathtt{(1)}} & \mathsf{n} < {\mathsf{n}}_{\mathsf{len}} \\
{\scriptstyle\mathtt{(2)}} & {\mathsf{t}}_{\mathsf{replaced}} = \mathrm{ite}\left\langle\mathbb{T}\right\rangle\left(\mathsf{t}\left[\mathsf{n}\right] = {\mathsf{t}}_{\mathsf{old}}, \mathsf{t}\left[\left[\mathsf{n}\right] = {\mathsf{t}}_{\mathsf{new}}\right], \mathsf{t}\right)
\end{array}
\end{array}}}

\mathrm{replace\_text\_except}\left(\mathbb{T}, \mathbb{T}, \mathbb{T}\right) : \mathbb{T}

\mathrm{replace\_text\_except'}\left(\mathbb{N}, \mathbb{N}, \mathbb{T}, \mathbb{T}, \mathbb{T}\right) : \mathbb{T}

\begin{aligned}
\mathrm{replace\_text\_except}\left(\mathsf{t}, {\mathsf{t}}_{\mathsf{old}}, {\mathsf{t}}_{\mathsf{new}}\right) & = & \mathrm{replace\_text\_except'}\left(0, \left|\mathsf{t}\right|, \mathsf{t}, {\mathsf{t}}_{\mathsf{old}}, {\mathsf{t}}_{\mathsf{new}}\right)
\end{aligned}

\begin{aligned}
\mathrm{replace\_text\_except'}\left({\mathsf{n}}_{\mathsf{len}}, {\mathsf{n}}_{\mathsf{len}}, \mathsf{t}, {\mathsf{t}}_{\mathsf{old}}, {\mathsf{t}}_{\mathsf{new}}\right) & = & \mathsf{t}
\end{aligned}

\mathrlap{\displaystyle \begin{array}{rcl}
\mathrm{replace\_text\_except'}\left(\mathsf{n}, {\mathsf{n}}_{\mathsf{len}}, \mathsf{t}, {\mathsf{t}}_{\mathsf{old}}, {\mathsf{t}}_{\mathsf{new}}\right) & = & \mathrm{replace\_text\_except'}\left(\mathsf{n} + 1, {\mathsf{n}}_{\mathsf{len}}, {\mathsf{t}}_{\mathsf{replaced}}, {\mathsf{t}}_{\mathsf{old}}, {\mathsf{t}}_{\mathsf{new}}\right) \\
\mathrlap{\displaystyle \quad\text{if}\,\begin{array}{r@{\quad}l}
{\scriptstyle\mathtt{(1)}} & \mathsf{n} < {\mathsf{n}}_{\mathsf{len}} \\
{\scriptstyle\mathtt{(2)}} & {\mathsf{t}}_{\mathsf{replaced}} = \mathrm{ite}\left\langle\mathbb{T}\right\rangle\left(\mathsf{t}\left[\mathsf{n}\right] = {\mathsf{t}}_{\mathsf{old}}, \mathsf{t}, \mathsf{t}\left[\left[\mathsf{n}\right] = {\mathsf{t}}_{\mathsf{new}}\right]\right)
\end{array}}\smash{\hphantom{\begin{array}{r}
\mathrm{replace\_text\_except'}\left(\mathsf{n}, {\mathsf{n}}_{\mathsf{len}}, \mathsf{t}, {\mathsf{t}}_{\mathsf{old}}, {\mathsf{t}}_{\mathsf{new}}\right)
\end{array}}} &  &
\end{array}}\smash{\hphantom{\begin{array}{l}
\begin{array}{rcl}
\mathrm{replace\_text\_except'}\left(\mathsf{n}, {\mathsf{n}}_{\mathsf{len}}, \mathsf{t}, {\mathsf{t}}_{\mathsf{old}}, {\mathsf{t}}_{\mathsf{new}}\right) & = & \mathrm{replace\_text\_except'}\left(\mathsf{n} + 1, {\mathsf{n}}_{\mathsf{len}}, {\mathsf{t}}_{\mathsf{replaced}}, {\mathsf{t}}_{\mathsf{old}}, {\mathsf{t}}_{\mathsf{new}}\right)
\end{array} \\
\quad\text{if}\,\begin{array}{r@{\quad}l}
{\scriptstyle\mathtt{(1)}} & \mathsf{n} < {\mathsf{n}}_{\mathsf{len}} \\
{\scriptstyle\mathtt{(2)}} & {\mathsf{t}}_{\mathsf{replaced}} = \mathrm{ite}\left\langle\mathbb{T}\right\rangle\left(\mathsf{t}\left[\mathsf{n}\right] = {\mathsf{t}}_{\mathsf{old}}, \mathsf{t}, \mathsf{t}\left[\left[\mathsf{n}\right] = {\mathsf{t}}_{\mathsf{new}}\right]\right)
\end{array}
\end{array}}}

\mathrm{strip\_prefix}\left(\mathbb{T}, \mathbb{T}\right) : \mathbb{T} \quad \text{builtin}

\mathrm{strip\_suffix}\left(\mathbb{T}, \mathbb{T}\right) : \mathbb{T} \quad \text{builtin}

\mathrm{strip\_all\_whitespace}\left(\mathbb{T}\right) : \mathbb{T} \quad \text{builtin}

\mathrm{starts\_with}\left(\mathbb{T}, \mathbb{T}\right) : \mathbb{B}

\begin{aligned}
\mathrm{starts\_with}\left(\mathsf{t}, {\mathsf{t}}_{\mathsf{prefix}}\right) & = & \mathsf{true} \quad \text{if}\,\mathsf{t}\left[0 : \left|{\mathsf{t}}_{\mathsf{prefix}}\right|\right] = {\mathsf{t}}_{\mathsf{prefix}}
\end{aligned}

\begin{aligned}
\mathrm{starts\_with}\left(\mathsf{t}, {\mathsf{t}}_{\mathsf{prefix}}\right) & = & \mathsf{false} \quad \text{if}\,\mathrm{otherwise}
\end{aligned}

\mathrm{ends\_with}\left(\mathbb{T}, \mathbb{T}\right) : \mathbb{B}

\begin{aligned}
\mathrm{ends\_with}\left(\mathsf{t}, {\mathsf{t}}_{\mathsf{suffix}}\right) & = & \mathsf{true} \quad \text{if}\,\begin{array}{r@{\quad}l}
{\scriptstyle\mathtt{(1)}} & \left|{\mathsf{t}}_{\mathsf{suffix}}\right| \le \left|\mathsf{t}\right| \\
{\scriptstyle\mathtt{(2)}} & {\mathsf{n}}_{\mathsf{start}} = \left|\mathsf{t}\right| - \left|{\mathsf{t}}_{\mathsf{suffix}}\right| \\
{\scriptstyle\mathtt{(3)}} & \mathsf{t}\left[{\mathsf{n}}_{\mathsf{start}} : \left|{\mathsf{t}}_{\mathsf{suffix}}\right|\right] = {\mathsf{t}}_{\mathsf{suffix}}
\end{array}
\end{aligned}

\begin{aligned}
\mathrm{ends\_with}\left(\mathsf{t}, {\mathsf{t}}_{\mathsf{suffix}}\right) & = & \mathsf{false} \quad \text{if}\,\mathrm{otherwise}
\end{aligned}

\mathrm{strip\_prefix\_rec}\left(\mathbb{T}, \mathbb{T}\right) : \mathbb{T}

\mathrlap{\displaystyle \begin{array}{rcl}
\mathrm{strip\_prefix\_rec}\left(\mathsf{t}, {\mathsf{t}}_{\mathsf{prefix}}\right) & = & \mathrm{strip\_prefix\_rec}\left({\mathsf{t}}_{\mathsf{stripped}}, {\mathsf{t}}_{\mathsf{prefix}}\right) \\
\mathrlap{\displaystyle \quad\text{if}\,\begin{array}{r@{\quad}l}
{\scriptstyle\mathtt{(1)}} & \mathrm{starts\_with}\left(\mathsf{t}, {\mathsf{t}}_{\mathsf{prefix}}\right) \\
{\scriptstyle\mathtt{(2)}} & {\mathsf{t}}_{\mathsf{stripped}} = \mathrm{strip\_prefix}\left(\mathsf{t}, {\mathsf{t}}_{\mathsf{prefix}}\right)
\end{array}}\smash{\hphantom{\begin{array}{r}
\mathrm{strip\_prefix\_rec}\left(\mathsf{t}, {\mathsf{t}}_{\mathsf{prefix}}\right)
\end{array}}} &  &
\end{array}}\smash{\hphantom{\begin{array}{l}
\begin{array}{rcl}
\mathrm{strip\_prefix\_rec}\left(\mathsf{t}, {\mathsf{t}}_{\mathsf{prefix}}\right) & = & \mathrm{strip\_prefix\_rec}\left({\mathsf{t}}_{\mathsf{stripped}}, {\mathsf{t}}_{\mathsf{prefix}}\right)
\end{array} \\
\quad\text{if}\,\begin{array}{r@{\quad}l}
{\scriptstyle\mathtt{(1)}} & \mathrm{starts\_with}\left(\mathsf{t}, {\mathsf{t}}_{\mathsf{prefix}}\right) \\
{\scriptstyle\mathtt{(2)}} & {\mathsf{t}}_{\mathsf{stripped}} = \mathrm{strip\_prefix}\left(\mathsf{t}, {\mathsf{t}}_{\mathsf{prefix}}\right)
\end{array}
\end{array}}}

\begin{aligned}
\mathrm{strip\_prefix\_rec}\left(\mathsf{t}, {\mathsf{t}}_{\mathsf{prefix}}\right) & = & \mathsf{t} \quad \text{if}\,\neg \mathrm{starts\_with}\left(\mathsf{t}, {\mathsf{t}}_{\mathsf{prefix}}\right)
\end{aligned}

\mathrm{strip\_suffix\_rec}\left(\mathbb{T}, \mathbb{T}\right) : \mathbb{T}

\mathrlap{\displaystyle \begin{array}{rcl}
\mathrm{strip\_suffix\_rec}\left(\mathsf{t}, {\mathsf{t}}_{\mathsf{suffix}}\right) & = & \mathrm{strip\_suffix\_rec}\left({\mathsf{t}}_{\mathsf{stripped}}, {\mathsf{t}}_{\mathsf{suffix}}\right) \\
\mathrlap{\displaystyle \quad\text{if}\,\begin{array}{r@{\quad}l}
{\scriptstyle\mathtt{(1)}} & \mathrm{ends\_with}\left(\mathsf{t}, {\mathsf{t}}_{\mathsf{suffix}}\right) \\
{\scriptstyle\mathtt{(2)}} & {\mathsf{t}}_{\mathsf{stripped}} = \mathrm{strip\_suffix}\left(\mathsf{t}, {\mathsf{t}}_{\mathsf{suffix}}\right)
\end{array}}\smash{\hphantom{\begin{array}{r}
\mathrm{strip\_suffix\_rec}\left(\mathsf{t}, {\mathsf{t}}_{\mathsf{suffix}}\right)
\end{array}}} &  &
\end{array}}\smash{\hphantom{\begin{array}{l}
\begin{array}{rcl}
\mathrm{strip\_suffix\_rec}\left(\mathsf{t}, {\mathsf{t}}_{\mathsf{suffix}}\right) & = & \mathrm{strip\_suffix\_rec}\left({\mathsf{t}}_{\mathsf{stripped}}, {\mathsf{t}}_{\mathsf{suffix}}\right)
\end{array} \\
\quad\text{if}\,\begin{array}{r@{\quad}l}
{\scriptstyle\mathtt{(1)}} & \mathrm{ends\_with}\left(\mathsf{t}, {\mathsf{t}}_{\mathsf{suffix}}\right) \\
{\scriptstyle\mathtt{(2)}} & {\mathsf{t}}_{\mathsf{stripped}} = \mathrm{strip\_suffix}\left(\mathsf{t}, {\mathsf{t}}_{\mathsf{suffix}}\right)
\end{array}
\end{array}}}

\begin{aligned}
\mathrm{strip\_suffix\_rec}\left(\mathsf{t}, {\mathsf{t}}_{\mathsf{suffix}}\right) & = & \mathsf{t} \quad \text{if}\,\neg \mathrm{ends\_with}\left(\mathsf{t}, {\mathsf{t}}_{\mathsf{suffix}}\right)
\end{aligned}

\mathrm{contains}\left(\mathbb{T}, \mathbb{T}\right) : \mathbb{B}

\mathrm{contains'}\left(\mathbb{N}, \mathbb{N}, \mathbb{T}, \mathbb{T}\right) : \mathbb{B}

\begin{aligned}
\mathrm{contains}\left(\mathsf{t}, {\mathsf{t}}_{\mathsf{c}}\right) & = & \mathrm{contains'}\left(0, \left|\mathsf{t}\right|, \mathsf{t}, {\mathsf{t}}_{\mathsf{c}}\right)
\end{aligned}

\begin{aligned}
\mathrm{contains'}\left({\mathsf{n}}_{\mathsf{len}}, {\mathsf{n}}_{\mathsf{len}}, \mathsf{t}, {\mathsf{t}}_{\mathsf{c}}\right) & = & \mathsf{false}
\end{aligned}

\begin{aligned}
\mathrm{contains'}\left(\mathsf{n}, {\mathsf{n}}_{\mathsf{len}}, \mathsf{t}, {\mathsf{t}}_{\mathsf{c}}\right) & = & \mathsf{true} \quad \text{if}\,\begin{array}{r@{\quad}l}
{\scriptstyle\mathtt{(1)}} & \mathsf{n} < {\mathsf{n}}_{\mathsf{len}} \\
{\scriptstyle\mathtt{(2)}} & \mathsf{t}\left[\mathsf{n}\right] = {\mathsf{t}}_{\mathsf{c}}
\end{array}
\end{aligned}

\begin{aligned}
\mathrm{contains'}\left(\mathsf{n}, {\mathsf{n}}_{\mathsf{len}}, \mathsf{t}, {\mathsf{t}}_{\mathsf{c}}\right) & = & \mathrm{contains'}\left(\mathsf{n} + 1, {\mathsf{n}}_{\mathsf{len}}, \mathsf{t}, {\mathsf{t}}_{\mathsf{c}}\right) \quad \text{if}\,\begin{array}{r@{\quad}l}
{\scriptstyle\mathtt{(1)}} & \mathsf{n} < {\mathsf{n}}_{\mathsf{len}} \\
{\scriptstyle\mathtt{(2)}} & \mathsf{t}\left[\mathsf{n}\right] \ne {\mathsf{t}}_{\mathsf{c}}
\end{array}
\end{aligned}



\mathrm{is\_some\_}\left\langle\mathsf{X}\right\rangle\left({\mathsf{X}}^{?}\right) : \mathbb{B}

\begin{aligned}
\mathrm{is\_some\_}\left\langle\mathsf{X}\right\rangle\left(\epsilon\right) & = & \mathsf{false}
\end{aligned}

\begin{aligned}
\mathrm{is\_some\_}\left\langle\mathsf{X}\right\rangle\left(\mathsf{X}\right) & = & \mathsf{true}
\end{aligned}

\mathrm{opt\_as\_seq\_}\left\langle\mathsf{X}\right\rangle\left({\mathsf{X}}^{?}\right) : {\mathsf{X}}^{\ast}

\begin{aligned}
\mathrm{opt\_as\_seq\_}\left\langle\mathsf{X}\right\rangle\left(\epsilon\right) & = & \epsilon
\end{aligned}

\begin{aligned}
\mathrm{opt\_as\_seq\_}\left\langle\mathsf{X}\right\rangle\left(\mathsf{X}\right) & = & \left[\mathsf{X}\right]
\end{aligned}



\mathrm{exists\_}\left({\mathbb{B}}^{\ast}\right) : \mathbb{B}

\begin{aligned}
\mathrm{exists\_}\left(\epsilon\right) & = & \mathsf{false}
\end{aligned}

\begin{aligned}
\mathrm{exists\_}\left({\mathsf{b}}_{\mathsf{h}} \mathbin{::} {{\mathsf{b}}_{\mathsf{t}}}^{\ast}\right) & = & {\mathsf{b}}_{\mathsf{h}} \lor \mathrm{exists\_}\left({{\mathsf{b}}_{\mathsf{t}}}^{\ast}\right)
\end{aligned}

\mathrm{forall\_}\left({\mathbb{B}}^{\ast}\right) : \mathbb{B}

\begin{aligned}
\mathrm{forall\_}\left(\epsilon\right) & = & \mathsf{true}
\end{aligned}

\begin{aligned}
\mathrm{forall\_}\left({\mathsf{b}}_{\mathsf{h}} \mathbin{::} {{\mathsf{b}}_{\mathsf{t}}}^{\ast}\right) & = & {\mathsf{b}}_{\mathsf{h}} \land \mathrm{forall\_}\left({{\mathsf{b}}_{\mathsf{t}}}^{\ast}\right)
\end{aligned}

\mathrm{init\_}\left(\mathbb{N}\right) : {\mathbb{N}}^{\ast}

\begin{aligned}
\mathrm{init\_}\left(0\right) & = & \epsilon
\end{aligned}

\begin{aligned}
\mathrm{init\_}\left(\mathsf{n}\right) & = & \mathsf{n'} \mathbin{::} \mathrm{init\_}\left(\mathsf{n'}\right) \quad \text{if}\,\begin{array}{r@{\quad}l}
{\scriptstyle\mathtt{(1)}} & \mathsf{n} \ne 0 \\
{\scriptstyle\mathtt{(2)}} & \mathsf{n'} = \mathsf{n} - 1
\end{array}
\end{aligned}

\mathrm{repeat\_}\left\langle\mathsf{X}\right\rangle\left(\mathsf{X}, \mathbb{N}\right) : {\mathsf{X}}^{\ast}

\begin{aligned}
\mathrm{repeat\_}\left\langle\mathsf{X}\right\rangle\left(\mathsf{X}, 0\right) & = & \epsilon
\end{aligned}

\begin{aligned}
\mathrm{repeat\_}\left\langle\mathsf{X}\right\rangle\left(\mathsf{X}, \mathsf{n}\right) & = & \mathsf{X} \mathbin{+\!\!+} \mathrm{repeat\_}\left\langle\mathsf{X}\right\rangle\left(\mathsf{X}, \mathsf{n'}\right) \quad \text{if}\,\begin{array}{r@{\quad}l}
{\scriptstyle\mathtt{(1)}} & \mathsf{n} \ne 0 \\
{\scriptstyle\mathtt{(2)}} & \mathsf{n'} = \mathsf{n} - 1
\end{array}
\end{aligned}

\mathrm{rev\_}\left\langle\mathsf{X}\right\rangle\left({\mathsf{X}}^{\ast}\right) : {\mathsf{X}}^{\ast} \quad \text{builtin}

\mathrm{concat\_}\left\langle\mathsf{X}\right\rangle\left({\left({\mathsf{X}}^{\ast}\right)}^{\ast}\right) : {\mathsf{X}}^{\ast} \quad \text{builtin}

\mathrm{partition\_}\left\langle\mathsf{X}\right\rangle\left({\mathsf{X}}^{\ast}, \mathbb{N}\right) : \left({\mathsf{X}}^{\ast}, {\mathsf{X}}^{\ast}\right) \quad \text{builtin}

\mathrm{filter\_}\left\langle\mathsf{X}\right\rangle\left({\mathsf{X}}^{\ast}, {\mathbb{B}}^{\ast}\right) : {\mathsf{X}}^{\ast}

\begin{aligned}
\mathrm{filter\_}\left\langle\mathsf{X}\right\rangle\left(\epsilon, \epsilon\right) & = & \epsilon
\end{aligned}

\begin{aligned}
\mathrm{filter\_}\left\langle\mathsf{X}\right\rangle\left({\mathsf{X}}_{\mathsf{h}} \mathbin{::} {{\mathsf{X}}_{\mathsf{t}}}^{\ast}, {\mathsf{b}}_{\mathsf{h}} \mathbin{::} {{\mathsf{b}}_{\mathsf{t}}}^{\ast}\right) & = & {\mathsf{X}}_{\mathsf{h}} \mathbin{::} \mathrm{filter\_}\left\langle\mathsf{X}\right\rangle\left({{\mathsf{X}}_{\mathsf{t}}}^{\ast}, {{\mathsf{b}}_{\mathsf{t}}}^{\ast}\right) \quad \text{if}\,{\mathsf{b}}_{\mathsf{h}}
\end{aligned}

\begin{aligned}
\mathrm{filter\_}\left\langle\mathsf{X}\right\rangle\left({\mathsf{X}}_{\mathsf{h}} \mathbin{::} {{\mathsf{X}}_{\mathsf{t}}}^{\ast}, {\mathsf{b}}_{\mathsf{h}} \mathbin{::} {{\mathsf{b}}_{\mathsf{t}}}^{\ast}\right) & = & \mathrm{filter\_}\left\langle\mathsf{X}\right\rangle\left({{\mathsf{X}}_{\mathsf{t}}}^{\ast}, {{\mathsf{b}}_{\mathsf{t}}}^{\ast}\right) \quad \text{if}\,\neg {\mathsf{b}}_{\mathsf{h}}
\end{aligned}

\mathrm{assoc\_}\left\langle\mathsf{X}, \mathsf{Y}\right\rangle\left(\mathsf{X}, {\left(\mathsf{X}, \mathsf{Y}\right)}^{\ast}\right) : {\mathsf{Y}}^{?} \quad \text{builtin}

\mathrm{sort\_}\left\langle\mathsf{X}\right\rangle\left({\left(\mathbb{N}, \mathsf{X}\right)}^{\ast}\right) : {\left(\mathbb{N}, \mathsf{X}\right)}^{\ast} \quad \text{builtin}

\mathrm{distinct\_}\left\langle\mathsf{K}\right\rangle\left({\mathsf{K}}^{\ast}\right) : \mathbb{B} \quad \text{builtin}



\begin{aligned}
\mathsf{set}\left\langle\mathsf{K}\right\rangle & \mathrel{::=} & \left\{{\mathsf{K}}^{\ast}\right\}
\end{aligned}

\mathrm{empty\_set}\left\langle\mathsf{K}\right\rangle\left(\right) : \mathsf{set}\left\langle\mathsf{K}\right\rangle

\begin{aligned}
\mathrm{empty\_set}\left\langle\mathsf{K}\right\rangle\left(\right) & = & \left\{\epsilon\right\}
\end{aligned}

\mathrm{in\_set}\left\langle\mathsf{K}\right\rangle\left(\mathsf{K}, \mathsf{set}\left\langle\mathsf{K}\right\rangle\right) : \mathbb{B}

\begin{aligned}
\mathrm{in\_set}\left\langle\mathsf{K}\right\rangle\left(\mathsf{K}, \left\{{{\mathsf{K}}_{\mathsf{e}}}^{\ast}\right\}\right) & = & \mathsf{K} \in {{\mathsf{K}}_{\mathsf{e}}}^{\ast}
\end{aligned}

\mathrm{intersect\_set}\left\langle\mathsf{K}\right\rangle\left(\mathsf{set}\left\langle\mathsf{K}\right\rangle, \mathsf{set}\left\langle\mathsf{K}\right\rangle\right) : \mathsf{set}\left\langle\mathsf{K}\right\rangle \quad \text{builtin}

\mathrm{union\_set}\left\langle\mathsf{K}\right\rangle\left(\mathsf{set}\left\langle\mathsf{K}\right\rangle, \mathsf{set}\left\langle\mathsf{K}\right\rangle\right) : \mathsf{set}\left\langle\mathsf{K}\right\rangle \quad \text{builtin}

\mathrm{unions\_set}\left\langle\mathsf{K}\right\rangle\left({\mathsf{set}\left\langle\mathsf{K}\right\rangle}^{\ast}\right) : \mathsf{set}\left\langle\mathsf{K}\right\rangle \quad \text{builtin}

\mathrm{diff\_set}\left\langle\mathsf{K}\right\rangle\left(\mathsf{set}\left\langle\mathsf{K}\right\rangle, \mathsf{set}\left\langle\mathsf{K}\right\rangle\right) : \mathsf{set}\left\langle\mathsf{K}\right\rangle \quad \text{builtin}

\mathrm{sub\_set}\left\langle\mathsf{K}\right\rangle\left(\mathsf{set}\left\langle\mathsf{K}\right\rangle, \mathsf{set}\left\langle\mathsf{K}\right\rangle\right) : \mathbb{B} \quad \text{builtin}

\mathrm{eq\_set}\left\langle\mathsf{K}\right\rangle\left(\mathsf{set}\left\langle\mathsf{K}\right\rangle, \mathsf{set}\left\langle\mathsf{K}\right\rangle\right) : \mathbb{B} \quad \text{builtin}



\begin{aligned}
\mathsf{pair}\left\langle\mathsf{K}, \mathsf{V}\right\rangle & \mathrel{::=} & \mathsf{K}\,\mathbin{\mathtt{:}}\,\mathsf{V}
\end{aligned}

\mathsf{map}\left\langle\mathsf{K}, \mathsf{V}\right\rangle \mathrel{::=} \mathsf{set}\left\langle\mathsf{pair}\left\langle\mathsf{K}, \mathsf{V}\right\rangle\right\rangle

\mathrm{empty\_map}\left\langle\mathsf{K}, \mathsf{V}\right\rangle\left(\right) : \mathsf{map}\left\langle\mathsf{K}, \mathsf{V}\right\rangle

\begin{aligned}
\mathrm{empty\_map}\left\langle\mathsf{K}, \mathsf{V}\right\rangle\left(\right) & = & \left\{\epsilon\right\}
\end{aligned}

\mathrm{dom\_map}\left\langle\mathsf{K}, \mathsf{V}\right\rangle\left(\mathsf{map}\left\langle\mathsf{K}, \mathsf{V}\right\rangle\right) : \mathsf{set}\left\langle\mathsf{K}\right\rangle

\begin{aligned}
\mathrm{dom\_map}\left\langle\mathsf{K}, \mathsf{V}\right\rangle\left(\left\{{\left(\mathsf{K}\,\mathbin{\mathtt{:}}\,\mathsf{V}\right)}^{\ast}\right\}\right) & = & \left\{{\mathsf{K}}^{\ast}\right\}
\end{aligned}

\mathrm{codom\_map}\left\langle\mathsf{K}, \mathsf{V}\right\rangle\left(\mathsf{map}\left\langle\mathsf{K}, \mathsf{V}\right\rangle\right) : \mathsf{set}\left\langle\mathsf{V}\right\rangle

\begin{aligned}
\mathrm{codom\_map}\left\langle\mathsf{K}, \mathsf{V}\right\rangle\left(\left\{{\left(\mathsf{K}\,\mathbin{\mathtt{:}}\,\mathsf{V}\right)}^{\ast}\right\}\right) & = & \left\{{\mathsf{V}}^{\ast}\right\}
\end{aligned}

