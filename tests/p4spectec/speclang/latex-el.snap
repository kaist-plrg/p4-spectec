\end{array}}}



\begin{aligned}
\mathrm{resolve\_constraint}\left(\mathsf{strictness}, \left\{\epsilon\right\}\right) & = & \left\{\epsilon\right\}
\end{aligned}

\mathrlap{\displaystyle \begin{array}{rcl}
\mathrm{resolve\_constraint}\left(\mathsf{strictness}, \left\{\left({\mathsf{typeId}}_{\mathsf{h}}\,\mathbin{\mathtt{:}}\,{\mathsf{infer}}_{\mathsf{h}}\right) \mathbin{::} {\left({\mathsf{typeId}}_{\mathsf{t}}\,\mathbin{\mathtt{:}}\,{\mathsf{infer}}_{\mathsf{t}}\right)}^{\ast}\right\}\right) & = & \left\{\left({\mathsf{typeId}}_{\mathsf{h}}\,\mathbin{\mathtt{:}}\,{\mathsf{typeIR}}_{\mathsf{h}}\right) \mathbin{::} {\left({\mathsf{typeId}}_{\mathsf{t}}\,\mathbin{\mathtt{:}}\,{\mathsf{typeIR}}_{\mathsf{t}}\right)}^{\ast}\right\} \\
\mathrlap{\displaystyle \quad\text{if}\,\begin{array}{r@{\quad}l}
{\scriptstyle\mathtt{(1)}} & \mathsf{KNOWN}\,\mathsf{AS}\,{\mathsf{typeIR}}_{\mathsf{h}} = {\mathsf{infer}}_{\mathsf{h}} \\
{\scriptstyle\mathtt{(2)}} & \left\{{\left({\mathsf{typeId}}_{\mathsf{t}}\,\mathbin{\mathtt{:}}\,{\mathsf{typeIR}}_{\mathsf{t}}\right)}^{\ast}\right\} \\
 & \quad\quad= \mathrm{resolve\_constraint}\left(\mathsf{strictness}, \left\{{\left({\mathsf{typeId}}_{\mathsf{t}}\,\mathbin{\mathtt{:}}\,{\mathsf{infer}}_{\mathsf{t}}\right)}^{\ast}\right\}\right)
\end{array}}\smash{\hphantom{\begin{array}{r}
\mathrm{resolve\_constraint}\left(\mathsf{strictness}, \left\{\left({\mathsf{typeId}}_{\mathsf{h}}\,\mathbin{\mathtt{:}}\,{\mathsf{infer}}_{\mathsf{h}}\right) \mathbin{::} {\left({\mathsf{typeId}}_{\mathsf{t}}\,\mathbin{\mathtt{:}}\,{\mathsf{infer}}_{\mathsf{t}}\right)}^{\ast}\right\}\right)
\end{array}}} &  &
\end{array}}\smash{\hphantom{\begin{array}{l}
\begin{array}{rcl}
\mathrm{resolve\_constraint}\left(\mathsf{strictness}, \left\{\left({\mathsf{typeId}}_{\mathsf{h}}\,\mathbin{\mathtt{:}}\,{\mathsf{infer}}_{\mathsf{h}}\right) \mathbin{::} {\left({\mathsf{typeId}}_{\mathsf{t}}\,\mathbin{\mathtt{:}}\,{\mathsf{infer}}_{\mathsf{t}}\right)}^{\ast}\right\}\right) & = & \left\{\left({\mathsf{typeId}}_{\mathsf{h}}\,\mathbin{\mathtt{:}}\,{\mathsf{typeIR}}_{\mathsf{h}}\right) \mathbin{::} {\left({\mathsf{typeId}}_{\mathsf{t}}\,\mathbin{\mathtt{:}}\,{\mathsf{typeIR}}_{\mathsf{t}}\right)}^{\ast}\right\}
\end{array} \\
\quad\text{if}\,\begin{array}{r@{\quad}l}
{\scriptstyle\mathtt{(1)}} & \mathsf{KNOWN}\,\mathsf{AS}\,{\mathsf{typeIR}}_{\mathsf{h}} = {\mathsf{infer}}_{\mathsf{h}} \\
{\scriptstyle\mathtt{(2)}} & \left\{{\left({\mathsf{typeId}}_{\mathsf{t}}\,\mathbin{\mathtt{:}}\,{\mathsf{typeIR}}_{\mathsf{t}}\right)}^{\ast}\right\} \\
 & \quad\quad= \mathrm{resolve\_constraint}\left(\mathsf{strictness}, \left\{{\left({\mathsf{typeId}}_{\mathsf{t}}\,\mathbin{\mathtt{:}}\,{\mathsf{infer}}_{\mathsf{t}}\right)}^{\ast}\right\}\right)
\end{array}
\end{array}}}

\mathrlap{\displaystyle \begin{array}{rcl}
\mathrm{resolve\_constraint}\left(\mathsf{strictness}, \left\{\left({\mathsf{typeId}}_{\mathsf{h}}\,\mathbin{\mathtt{:}}\,{\mathsf{infer}}_{\mathsf{h}}\right) \mathbin{::} {\left({\mathsf{typeId}}_{\mathsf{t}}\,\mathbin{\mathtt{:}}\,{\mathsf{infer}}_{\mathsf{t}}\right)}^{\ast}\right\}\right) & = & \left\{\left({\mathsf{typeId}}_{\mathsf{h}}\,\mathbin{\mathtt{:}}\,\mathsf{BOOL}\right) \mathbin{::} {\left({\mathsf{typeId}}_{\mathsf{t}}\,\mathbin{\mathtt{:}}\,{\mathsf{typeIR}}_{\mathsf{t}}\right)}^{\ast}\right\} \\
\mathrlap{\displaystyle \quad\text{if}\,\begin{array}{r@{\quad}l}
{\scriptstyle\mathtt{(1)}} & \mathsf{UNKNOWN} = {\mathsf{infer}}_{\mathsf{h}} \\
{\scriptstyle\mathtt{(2)}} & \mathrm{find\_map}\left\langle\mathsf{typeId}, \mathsf{strict}\right\rangle\left(\mathsf{strictness}, {\mathsf{typeId}}_{\mathsf{h}}\right) = \mathsf{LAX} \\
{\scriptstyle\mathtt{(3)}} & \left\{{\left({\mathsf{typeId}}_{\mathsf{t}}\,\mathbin{\mathtt{:}}\,{\mathsf{typeIR}}_{\mathsf{t}}\right)}^{\ast}\right\} \\
 & \quad\quad= \mathrm{resolve\_constraint}\left(\mathsf{strictness}, \left\{{\left({\mathsf{typeId}}_{\mathsf{t}}\,\mathbin{\mathtt{:}}\,{\mathsf{infer}}_{\mathsf{t}}\right)}^{\ast}\right\}\right)
\end{array}}\smash{\hphantom{\begin{array}{r}
\mathrm{resolve\_constraint}\left(\mathsf{strictness}, \left\{\left({\mathsf{typeId}}_{\mathsf{h}}\,\mathbin{\mathtt{:}}\,{\mathsf{infer}}_{\mathsf{h}}\right) \mathbin{::} {\left({\mathsf{typeId}}_{\mathsf{t}}\,\mathbin{\mathtt{:}}\,{\mathsf{infer}}_{\mathsf{t}}\right)}^{\ast}\right\}\right)
\end{array}}} &  &
\end{array}}\smash{\hphantom{\begin{array}{l}
\begin{array}{rcl}
\mathrm{resolve\_constraint}\left(\mathsf{strictness}, \left\{\left({\mathsf{typeId}}_{\mathsf{h}}\,\mathbin{\mathtt{:}}\,{\mathsf{infer}}_{\mathsf{h}}\right) \mathbin{::} {\left({\mathsf{typeId}}_{\mathsf{t}}\,\mathbin{\mathtt{:}}\,{\mathsf{infer}}_{\mathsf{t}}\right)}^{\ast}\right\}\right) & = & \left\{\left({\mathsf{typeId}}_{\mathsf{h}}\,\mathbin{\mathtt{:}}\,\mathsf{BOOL}\right) \mathbin{::} {\left({\mathsf{typeId}}_{\mathsf{t}}\,\mathbin{\mathtt{:}}\,{\mathsf{typeIR}}_{\mathsf{t}}\right)}^{\ast}\right\}
\end{array} \\
\quad\text{if}\,\begin{array}{r@{\quad}l}
