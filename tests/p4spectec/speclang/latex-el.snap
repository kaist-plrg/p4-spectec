\begin{aligned}
\mathrm{default}\left(\mathsf{TUPLE}\,\left\langle{\mathsf{typeIR}}^{\ast}\right\rangle\right) & = & \mathsf{TUPLE}\,\left({\mathrm{default}\left(\mathsf{typeIR}\right)}^{\ast}\right)
\end{aligned}

\mathrlap{\displaystyle \begin{array}{rcl}
\mathrm{default}\left(\mathsf{ARRAY}\,\mathsf{typeIR}\,\left[{\mathsf{n}}_{\mathsf{s}}\right]\right) & = & \mathsf{ARRAY}\,\left[{\mathsf{value}}^{\ast}\right] \\
\mathrlap{\displaystyle \quad\text{if}\,{\mathsf{value}}^{\ast} = \mathrm{repeat\_}\left\langle\mathsf{value}\right\rangle\left(\mathrm{default}\left(\mathsf{typeIR}\right), {\mathsf{n}}_{\mathsf{s}}\right)}\smash{\hphantom{\begin{array}{r}
\mathrm{default}\left(\mathsf{ARRAY}\,\mathsf{typeIR}\,\left[{\mathsf{n}}_{\mathsf{s}}\right]\right)
