{\scriptstyle\mathtt{(6)}} & \mathsf{typeIR} = \mathrm{type\_of\_typedExpressionIR}\left(\mathsf{typedExpressionIR}\right) \\
{\scriptstyle\mathtt{(7)}} & \mathsf{integerTypeIR} = \mathrm{unroll\_aliasTypeIR}\left(\mathsf{typeIR}\right) \\
{\scriptstyle\mathtt{(8)}} & \mathsf{n} = \mathrm{width\_of\_integerTypeIR}\left(\mathsf{integerTypeIR}\right)
\end{array}}\smash{\hphantom{\begin{array}{r}
