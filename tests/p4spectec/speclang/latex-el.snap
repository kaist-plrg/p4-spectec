\quad\quad= \mathrm{cast\_record\_field}\left({\mathsf{typeIR}}_{\mathsf{t\_field}}, {\mathsf{id}}_{\mathsf{t\_field}}, \left\{{\left({\mathsf{nameIR}}_{\mathsf{field}}\,\mathbin{\mathtt{:}}\,{\mathsf{value}}_{\mathsf{field}}\right)}^{\ast}\right\}\right)
\end{array}\right)\right)}^{\ast}}\smash{\hphantom{\begin{array}{r}
\mathrm{cast\_record}\left(\begin{array}{l}
\mathsf{HEADER}\,\mathsf{typeId}\,\left\langle\mathsf{\_}\right\rangle\,\left\{{\left(\mathsf{\_}\,{\mathsf{typeIR}}_{\mathsf{t\_field}}\,{\mathsf{id}}_{\mathsf{t\_field}}\,\mathbin{\mathtt{;}}\right)}^{\ast}\right\}, \\
\mathsf{RECORD}\,\left\{{\left({\mathsf{value}}_{\mathsf{field}}\,{\mathsf{nameIR}}_{\mathsf{field}}\,\mathbin{\mathtt{;}}\right)}^{\ast}\,\mathbin{\mathtt{,}}\,\mathbin{\mathtt{...}}\right\}
\end{array}\right)
\end{array}}} &  &
\end{array}}\smash{\hphantom{\begin{array}{l}
\begin{array}{rcl}
\mathrm{cast\_record}\left(\begin{array}{l}
\mathsf{HEADER}\,\mathsf{typeId}\,\left\langle\mathsf{\_}\right\rangle\,\left\{{\left(\mathsf{\_}\,{\mathsf{typeIR}}_{\mathsf{t\_field}}\,{\mathsf{id}}_{\mathsf{t\_field}}\,\mathbin{\mathtt{;}}\right)}^{\ast}\right\}, \\
\mathsf{RECORD}\,\left\{{\left({\mathsf{value}}_{\mathsf{field}}\,{\mathsf{nameIR}}_{\mathsf{field}}\,\mathbin{\mathtt{;}}\right)}^{\ast}\,\mathbin{\mathtt{,}}\,\mathbin{\mathtt{...}}\right\}
\end{array}\right) & = & \mathsf{HEADER}\,\mathsf{typeId}\,\left\{\mathsf{true}\,\mathbin{\mathtt{;}}\,{\left({\mathsf{value}}_{\mathsf{field\_cast}}\,{\mathsf{id}}_{\mathsf{t\_field}}\,\mathbin{\mathtt{;}}\right)}^{\ast}\right\}
\end{array} \\
\quad\text{if}\,{\left(\left(\begin{array}{l}
{\mathsf{value}}_{\mathsf{field\_cast}} \\
\quad\quad= \mathrm{cast\_record\_field}\left({\mathsf{typeIR}}_{\mathsf{t\_field}}, {\mathsf{id}}_{\mathsf{t\_field}}, \left\{{\left({\mathsf{nameIR}}_{\mathsf{field}}\,\mathbin{\mathtt{:}}\,{\mathsf{value}}_{\mathsf{field}}\right)}^{\ast}\right\}\right)
\end{array}\right)\right)}^{\ast}
\end{array}}}

\mathrlap{\displaystyle \begin{array}{rcl}
\mathrm{cast\_op}\left(\mathsf{typeIR}, \mathsf{recordValue}\right) & = & \mathrm{cast\_record}\left({\mathsf{typeIR}}_{\mathsf{unroll}}, \mathsf{recordValue}\right) \\
\mathrlap{\displaystyle \quad\text{if}\,{\mathsf{typeIR}}_{\mathsf{unroll}} = \mathrm{unroll\_typeIR}\left(\mathsf{typeIR}\right)}\smash{\hphantom{\begin{array}{r}
\mathrm{cast\_op}\left(\mathsf{typeIR}, \mathsf{recordValue}\right)
\end{array}}} &  &
\end{array}}\smash{\hphantom{\begin{array}{l}
\begin{array}{rcl}
\mathrm{cast\_op}\left(\mathsf{typeIR}, \mathsf{recordValue}\right) & = & \mathrm{cast\_record}\left({\mathsf{typeIR}}_{\mathsf{unroll}}, \mathsf{recordValue}\right)
\end{array} \\
\quad\text{if}\,{\mathsf{typeIR}}_{\mathsf{unroll}} = \mathrm{unroll\_typeIR}\left(\mathsf{typeIR}\right)
\end{array}}}



