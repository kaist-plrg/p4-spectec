\mathrm{is\_valid\_bitslice}\left(\mathsf{typeIR}, \mathbb{N}, \mathbb{N}\right) : \mathbb{B}

\begin{aligned}
\mathrm{is\_valid\_bitslice}\left(\mathsf{INT}, {\mathsf{n}}_{\mathsf{lo}}, {\mathsf{n}}_{\mathsf{hi}}\right) & = & {\mathsf{n}}_{\mathsf{lo}} \le {\mathsf{n}}_{\mathsf{hi}}
\end{aligned}

\mathrlap{\displaystyle \begin{array}{rcl}
\mathrm{is\_valid\_bitslice}\left(\mathsf{INT}\,\left\langle\mathsf{w}\right\rangle, {\mathsf{n}}_{\mathsf{lo}}, {\mathsf{n}}_{\mathsf{hi}}\right) & = & {\mathsf{n}}_{\mathsf{lo}} \le {\mathsf{n}}_{\mathsf{hi}} \land {\mathsf{n}}_{\mathsf{hi}} \le \mathsf{w} \land {\mathsf{w}}_{\mathsf{slice}} \le \mathsf{w} \\
\mathrlap{\displaystyle \quad\text{if}\,{\mathsf{w}}_{\mathsf{slice}} = {\mathsf{n}}_{\mathsf{hi}} - {\mathsf{n}}_{\mathsf{lo}} + 1}\smash{\hphantom{\begin{array}{r}
\mathrm{is\_valid\_bitslice}\left(\mathsf{INT}\,\left\langle\mathsf{w}\right\rangle, {\mathsf{n}}_{\mathsf{lo}}, {\mathsf{n}}_{\mathsf{hi}}\right)
\end{array}}} &  &
\end{array}}\smash{\hphantom{\begin{array}{l}
\begin{array}{rcl}
\mathrm{is\_valid\_bitslice}\left(\mathsf{INT}\,\left\langle\mathsf{w}\right\rangle, {\mathsf{n}}_{\mathsf{lo}}, {\mathsf{n}}_{\mathsf{hi}}\right) & = & {\mathsf{n}}_{\mathsf{lo}} \le {\mathsf{n}}_{\mathsf{hi}} \land {\mathsf{n}}_{\mathsf{hi}} \le \mathsf{w} \land {\mathsf{w}}_{\mathsf{slice}} \le \mathsf{w}
\end{array} \\
\quad\text{if}\,{\mathsf{w}}_{\mathsf{slice}} = {\mathsf{n}}_{\mathsf{hi}} - {\mathsf{n}}_{\mathsf{lo}} + 1
\end{array}}}

\mathrlap{\displaystyle \begin{array}{rcl}
