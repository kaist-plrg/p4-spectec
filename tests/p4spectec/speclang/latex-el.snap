\mathrm{is\_defaultable\_typeIR}\left(\mathsf{typeIR}\right) : \mathbb{B} \quad \text{table}

\begin{aligned}
\mathrm{is\_defaultable\_typeIR}\left(\mathsf{BOOL}\right) & \mapsto & \mathsf{true} \\
\mathrm{is\_defaultable\_typeIR}\left(\mathsf{ERROR}\right) & \mapsto & \mathsf{true} \\
\mathrm{is\_defaultable\_typeIR}\left(\mathsf{STRING}\right) & \mapsto & \mathsf{true} \\
\mathrm{is\_defaultable\_typeIR}\left(\mathsf{integerTypeIR}\right) & \mapsto & \mathsf{true} \\
\mathrm{is\_defaultable\_typeIR}\left(\mathsf{TYPEDEF}\,\mathsf{\_}\,\mathsf{typeIR}\right) & \mapsto & \mathrm{is\_defaultable\_typeIR}\left(\mathsf{typeIR}\right) \\
\mathrm{is\_defaultable\_typeIR}\left(\mathsf{TYPE}\,\mathsf{\_}\,\mathsf{typeIR}\right) & \mapsto & \mathrm{is\_defaultable\_typeIR}\left(\mathsf{typeIR}\right) \\
\mathrm{is\_defaultable\_typeIR}\left(\mathsf{TUPLE}\,\left\langle{\mathsf{typeIR}}^{\ast}\right\rangle\right) & \mapsto & \mathrm{forall\_}\left({\mathrm{is\_defaultable\_typeIR}\left(\mathsf{typeIR}\right)}^{\ast}\right) \\
\mathrm{is\_defaultable\_typeIR}\left(\mathsf{ARRAY}\,\mathsf{typeIR}\,\left[\mathsf{\_}\right]\right) & \mapsto & \mathrm{is\_defaultable\_typeIR}\left(\mathsf{typeIR}\right) \\
\mathrm{is\_defaultable\_typeIR}\left(\mathsf{HEADER\_STACK}\,\mathsf{typeIR}\,\left[\mathsf{\_}\right]\right) & \mapsto & \mathrm{is\_defaultable\_typeIR}\left(\mathsf{typeIR}\right) \\
\mathrm{is\_defaultable\_typeIR}\left(\mathsf{STRUCT}\,\mathsf{\_}\,\left\langle\mathsf{\_}\right\rangle\,\left\{{\left(\mathsf{\_}\,\mathsf{typeIR}\,\mathsf{\_}\,\mathbin{\mathtt{;}}\right)}^{\ast}\right\}\right) & \mapsto & \mathrm{forall\_}\left({\mathrm{is\_defaultable\_typeIR}\left(\mathsf{typeIR}\right)}^{\ast}\right) \\
\mathrm{is\_defaultable\_typeIR}\left(\mathsf{HEADER}\,\mathsf{\_}\,\left\langle\mathsf{\_}\right\rangle\,\left\{{\left(\mathsf{\_}\,\mathsf{typeIR}\,\mathsf{\_}\,\mathbin{\mathtt{;}}\right)}^{\ast}\right\}\right) & \mapsto & \mathrm{forall\_}\left({\mathrm{is\_defaultable\_typeIR}\left(\mathsf{typeIR}\right)}^{\ast}\right) \\
\mathrm{is\_defaultable\_typeIR}\left(\mathsf{HEADER\_UNION}\,\mathsf{\_}\,\left\langle\mathsf{\_}\right\rangle\,\left\{{\left(\mathsf{\_}\,\mathsf{typeIR}\,\mathsf{\_}\,\mathbin{\mathtt{;}}\right)}^{\ast}\right\}\right) & \mapsto & \mathrm{forall\_}\left({\mathrm{is\_defaultable\_typeIR}\left(\mathsf{typeIR}\right)}^{\ast}\right) \\
\mathrm{is\_defaultable\_typeIR}\left(\mathsf{ENUM}\,\mathsf{\_}\,\left\{\mathsf{\_}\right\}\right) & \mapsto & \mathsf{true} \\
\mathrm{is\_defaultable\_typeIR}\left(\mathsf{ENUM}\,\mathsf{\_}\,\left\langle\mathsf{typeIR}\right\rangle\,\left\{\mathsf{\_}\right\}\right) & \mapsto & \mathrm{is\_defaultable\_typeIR}\left(\mathsf{typeIR}\right) \\
\mathrm{is\_defaultable\_typeIR}\left(\mathsf{\_}\right) & \mapsto & \mathsf{false}
\end{aligned}



\mathrm{is\_equalable\_typeIR}\left(\mathsf{typeIR}\right) : \mathbb{B} \quad \text{table}

\begin{aligned}
\mathrm{is\_equalable\_typeIR}\left(\mathsf{VOID}\right) & \mapsto & \mathsf{false} \\
\mathrm{is\_equalable\_typeIR}\left({\,}_{\mathsf{NAME}}\,\mathsf{typeId}\right) & \mapsto & \mathsf{false} \\
\mathrm{is\_equalable\_typeIR}\left(\mathsf{TYPEDEF}\,\mathsf{\_}\,\mathsf{typeIR}\right) & \mapsto & \mathrm{is\_equalable\_typeIR}\left(\mathsf{typeIR}\right) \\
\mathrm{is\_equalable\_typeIR}\left(\mathsf{externObjectTypeIR}\right) & \mapsto & \mathsf{false} \\
\mathrm{is\_equalable\_typeIR}\left(\mathsf{parserObjectTypeIR}\right) & \mapsto & \mathsf{false} \\
\mathrm{is\_equalable\_typeIR}\left(\mathsf{controlObjectTypeIR}\right) & \mapsto & \mathsf{false} \\
