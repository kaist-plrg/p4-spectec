\mathrm{resolve\_type\_alias}\left(\mathsf{typeIR}\right) : \left(\mathsf{nameIR}, {\mathsf{typeIR}}^{\ast}\right)

\begin{aligned}
\mathrm{resolve\_type\_alias}\left(\mathsf{TYPEDEF}\,{\mathsf{nameIR}}_{\mathsf{alias}}\,{\mathsf{typeIR}}_{\mathsf{alias}}\right) & = & \mathrm{resolve\_type\_alias}\left({\mathsf{typeIR}}_{\mathsf{alias}}\right)
