{\scriptstyle\mathtt{(7)}} & {\mathsf{ARCH}}_{\mathsf{2}} = \mathrm{add\_object\_e}\left({\mathsf{ARCH}}_{\mathsf{1}}, {\mathsf{objectId}}_{\mathsf{object}}, \mathsf{object}\right)
