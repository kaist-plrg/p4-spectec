\mathrlap{\displaystyle \quad\text{if}\,\mathsf{STO} = \mathrm{add\_map}\left\langle\mathsf{objectId}, \mathsf{object}\right\rangle\left({\mathsf{ARCH}}_{\mathsf{STORE}}, \mathsf{objectId}, \mathsf{object}\right)}\smash{\hphantom{\begin{array}{r}
\mathrm{add\_object\_e}\left(\mathsf{ARCH}, \mathsf{objectId}, \mathsf{object}\right)
