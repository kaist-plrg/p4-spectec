\end{array} \\
\quad\text{if}\,\neg \left({\mathsf{typeIR}}_{\mathsf{l}} \mathrel{<:} \mathsf{typedefTypeIR}\right)
\end{array}}}

\begin{aligned}
\mathrm{compat\_range}\left(\mathsf{\_}, \mathsf{\_}\right) & = & \mathsf{false} \quad \text{if}\,\mathrm{otherwise}
