\mathrm{band}\left(\mathbb{Z}, \mathbb{Z}\right) : \mathbb{Z} \quad \text{builtin}

\mathrm{bxor}\left(\mathbb{Z}, \mathbb{Z}\right) : \mathbb{Z} \quad \text{builtin}

\mathrm{bor}\left(\mathbb{Z}, \mathbb{Z}\right) : \mathbb{Z} \quad \text{builtin}

