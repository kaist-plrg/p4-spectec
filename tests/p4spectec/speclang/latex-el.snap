{\scriptstyle\mathtt{(1)}} & \mathsf{p}\,\mathsf{TC}\,\mathsf{actctxt} \mathrel{\vdash} {\mathsf{parameterIR}}_{\mathsf{h}}\,\mathbin{\mathtt{@}}\,{\mathsf{argumentIR}}_{\mathsf{h}} : {\mathsf{argumentIR}}_{\mathsf{h\_cast}} \\
{\scriptstyle\mathtt{(2)}} & \mathsf{p}\,\mathsf{TC}\,\mathsf{actctxt} \mathrel{\vdash} {{\mathsf{parameterIR}}_{\mathsf{t}}}^{\ast}\,\mathbin{\mathtt{@}}\,{{\mathsf{argumentIR}}_{\mathsf{t}}}^{\ast} : {{\mathsf{argumentIR}}_{\mathsf{t\_cast}}}^{\ast}
\end{array}}{\begin{array}{l}
\mathsf{p}\,\mathsf{TC}\,\mathsf{actctxt} \\
\quad\quad\mathrel{\vdash} \left({\mathsf{parameterIR}}_{\mathsf{h}} \mathbin{::} {{\mathsf{parameterIR}}_{\mathsf{t}}}^{\ast}\right)\,\mathbin{\mathtt{@}}\,\left({\mathsf{argumentIR}}_{\mathsf{h}} \mathbin{::} {{\mathsf{argumentIR}}_{\mathsf{t}}}^{\ast}\right) \\
\quad\quad\quad\quad: \left({\mathsf{argumentIR}}_{\mathsf{h\_cast}} \mathbin{::} {{\mathsf{argumentIR}}_{\mathsf{t\_cast}}}^{\ast}\right)
\end{array}}}
\end{array}
\end{gathered}

\begin{aligned}
\mathsf{strict} & \mathrel{::=} & \mathsf{STRICT} \\
 & \mathrel{|} & \mathsf{LAX}
\end{aligned}

\mathsf{strictness} \mathrel{::=} \mathsf{map}\left\langle\mathsf{typeId}, \mathsf{strict}\right\rangle

\mathrm{empty\_strictness}\left({\mathsf{typeId}}^{\ast}\right) : \mathsf{strictness}

\begin{aligned}
\mathrm{empty\_strictness}\left({\mathsf{typeId}}^{\ast}\right) & = & \left\{{\left(\mathsf{typeId}\,\mathbin{\mathtt{:}}\,\mathsf{STRICT}\right)}^{\ast}\right\}
\end{aligned}

\begin{aligned}
\mathsf{infer} & \mathrel{::=} & \mathsf{KNOWN}\,\mathsf{AS}\,\mathsf{typeIR} \\
 & \mathrel{|} & \mathsf{UNKNOWN}
\end{aligned}

\mathsf{constraint} \mathrel{::=} \mathsf{map}\left\langle\mathsf{typeId}, \mathsf{infer}\right\rangle

\mathrm{empty\_constraint}\left({\mathsf{typeId}}^{\ast}\right) : \mathsf{constraint}

\begin{aligned}
\mathrm{empty\_constraint}\left({\mathsf{typeId}}^{\ast}\right) & = & \left\{{\left(\mathsf{typeId}\,\mathbin{\mathtt{:}}\,\mathsf{UNKNOWN}\right)}^{\ast}\right\}
\end{aligned}

\mathsf{inference} \mathrel{::=} \mathsf{map}\left\langle\mathsf{typeId}, \mathsf{typeIR}\right\rangle



\mathrm{infer}\left({\mathsf{typeId}}^{\ast}, {\mathsf{parameterIR}}^{\ast}, {\mathsf{parameterIR}}^{\ast}, {\mathsf{argumentIR}}^{\ast}\right) : \mathsf{inference}

\mathrm{infer\_pair}\left(\mathsf{constraint}, \mathsf{parameterIR}, \mathsf{argumentIR}\right) : \mathsf{constraint}

\mathrm{resolve\_inference}\left(\mathsf{inference}\right) : \mathsf{inference}

\mathrm{resolve\_inference'}\left(\mathsf{typeIR}\right) : \mathsf{typeIR}

\mathrm{gen\_constraint}\left(\mathsf{constraint}, {\mathsf{typeIR}}^{\ast}, {\mathsf{typeIR}}^{\ast}\right) : \mathsf{constraint}

\mathrm{gen\_constraint\_pair}\left(\mathsf{constraint}, \mathsf{typeIR}, \mathsf{typeIR}\right) : \mathsf{constraint}

\mathrm{merge\_constraint}\left(\mathsf{constraint}, \mathsf{constraint}\right) : \mathsf{constraint}

\mathrm{merge\_constraint'}\left(\mathsf{constraint}, \mathsf{constraint}, {\mathsf{typeId}}^{\ast}, \mathsf{constraint}\right) : \mathsf{constraint}

\mathrm{merge\_constraints}\left(\mathsf{constraint}, {\mathsf{constraint}}^{\ast}\right) : \mathsf{constraint}

\mathrm{resolve\_constraint}\left(\mathsf{strictness}, \mathsf{constraint}\right) : \mathsf{inference}



\begin{aligned}
\mathrm{infer}\left(\epsilon, {\mathsf{parameterIR}}^{\ast}, {{\mathsf{parameterIR}}_{\mathsf{optional}}}^{\ast}, {\mathsf{argumentIR}}^{\ast}\right) & = & \mathrm{empty\_map}\left\langle\mathsf{typeId}, \mathsf{typeIR}\right\rangle\left(\right)
\end{aligned}

\mathrlap{\displaystyle \begin{array}{rcl}
\mathrm{infer}\left({{\mathsf{typeId}}_{\mathsf{infer}}}^{\ast}, {\mathsf{parameterIR}}^{\ast}, {{\mathsf{parameterIR}}_{\mathsf{optional}}}^{\ast}, {\mathsf{argumentIR}}^{\ast}\right) & = & {\mathsf{inference}}_{\mathsf{resolved}} \\
\mathrlap{\displaystyle \quad\text{if}\,\begin{array}{r@{\quad}l}
{\scriptstyle\mathtt{(1)}} & {{\mathsf{typeId}}_{\mathsf{infer}}}^{\ast} \ne \epsilon \\
{\scriptstyle\mathtt{(2)}} & {\mathsf{strictness}}_{\mathsf{init}} = \mathrm{empty\_strictness}\left({{\mathsf{typeId}}_{\mathsf{infer}}}^{\ast}\right) \\
{\scriptstyle\mathtt{(3)}} & \mathsf{B} = \mathrm{free\_parameterIRs}\left({\mathsf{parameterIR}}^{\ast}\right) \\
{\scriptstyle\mathtt{(4)}} & {\mathsf{B}}_{\mathsf{optional}} = \mathrm{free\_parameterIRs}\left({{\mathsf{parameterIR}}_{\mathsf{optional}}}^{\ast}\right) \\
{\scriptstyle\mathtt{(5)}} & \left\{{{\mathsf{typeId}}_{\mathsf{free}}}^{\ast}\right\} = \mathrm{diff\_set}\left\langle\mathsf{typeId}\right\rangle\left({\mathsf{B}}_{\mathsf{optional}}, \mathsf{B}\right) \\
{\scriptstyle\mathtt{(6)}} & {\mathsf{strict}}^{\ast} = \mathrm{repeat\_}\left\langle\mathsf{strict}\right\rangle\left(\mathsf{LAX}, \left|{{\mathsf{typeId}}_{\mathsf{free}}}^{\ast}\right|\right) \\
{\scriptstyle\mathtt{(7)}} & \mathsf{strictness} \\
 & \quad\quad= \mathrm{adds\_map}\left\langle\mathsf{typeId}, \mathsf{strict}\right\rangle\left({\mathsf{strictness}}_{\mathsf{init}}, {{\mathsf{typeId}}_{\mathsf{free}}}^{\ast}, {\mathsf{strict}}^{\ast}\right) \\
{\scriptstyle\mathtt{(8)}} & {\mathsf{constraint}}_{\mathsf{init}} = \mathrm{empty\_constraint}\left({{\mathsf{typeId}}_{\mathsf{infer}}}^{\ast}\right) \\
{\scriptstyle\mathtt{(9)}} & {\left(\left({\mathsf{constraint}}_{\mathsf{pair}} = \mathrm{infer\_pair}\left({\mathsf{constraint}}_{\mathsf{init}}, \mathsf{parameterIR}, \mathsf{argumentIR}\right)\right)\right)}^{\ast} \\
{\scriptstyle\mathtt{(10)}} & {\mathsf{constraint}}_{\mathsf{inferred}} = \mathrm{merge\_constraints}\left({\mathsf{constraint}}_{\mathsf{init}}, {{\mathsf{constraint}}_{\mathsf{pair}}}^{\ast}\right) \\
{\scriptstyle\mathtt{(11)}} & \mathsf{inference} = \mathrm{resolve\_constraint}\left(\mathsf{strictness}, {\mathsf{constraint}}_{\mathsf{inferred}}\right) \\
{\scriptstyle\mathtt{(12)}} & {\mathsf{inference}}_{\mathsf{resolved}} = \mathrm{resolve\_inference}\left(\mathsf{inference}\right)
\end{array}}\smash{\hphantom{\begin{array}{r}
\mathrm{infer}\left({{\mathsf{typeId}}_{\mathsf{infer}}}^{\ast}, {\mathsf{parameterIR}}^{\ast}, {{\mathsf{parameterIR}}_{\mathsf{optional}}}^{\ast}, {\mathsf{argumentIR}}^{\ast}\right)
\end{array}}} &  &
\end{array}}\smash{\hphantom{\begin{array}{l}
\begin{array}{rcl}
\mathrm{infer}\left({{\mathsf{typeId}}_{\mathsf{infer}}}^{\ast}, {\mathsf{parameterIR}}^{\ast}, {{\mathsf{parameterIR}}_{\mathsf{optional}}}^{\ast}, {\mathsf{argumentIR}}^{\ast}\right) & = & {\mathsf{inference}}_{\mathsf{resolved}}
\end{array} \\
\quad\text{if}\,\begin{array}{r@{\quad}l}
{\scriptstyle\mathtt{(1)}} & {{\mathsf{typeId}}_{\mathsf{infer}}}^{\ast} \ne \epsilon \\
{\scriptstyle\mathtt{(2)}} & {\mathsf{strictness}}_{\mathsf{init}} = \mathrm{empty\_strictness}\left({{\mathsf{typeId}}_{\mathsf{infer}}}^{\ast}\right) \\
{\scriptstyle\mathtt{(3)}} & \mathsf{B} = \mathrm{free\_parameterIRs}\left({\mathsf{parameterIR}}^{\ast}\right) \\
{\scriptstyle\mathtt{(4)}} & {\mathsf{B}}_{\mathsf{optional}} = \mathrm{free\_parameterIRs}\left({{\mathsf{parameterIR}}_{\mathsf{optional}}}^{\ast}\right) \\
{\scriptstyle\mathtt{(5)}} & \left\{{{\mathsf{typeId}}_{\mathsf{free}}}^{\ast}\right\} = \mathrm{diff\_set}\left\langle\mathsf{typeId}\right\rangle\left({\mathsf{B}}_{\mathsf{optional}}, \mathsf{B}\right) \\
{\scriptstyle\mathtt{(6)}} & {\mathsf{strict}}^{\ast} = \mathrm{repeat\_}\left\langle\mathsf{strict}\right\rangle\left(\mathsf{LAX}, \left|{{\mathsf{typeId}}_{\mathsf{free}}}^{\ast}\right|\right) \\
{\scriptstyle\mathtt{(7)}} & \mathsf{strictness} \\
 & \quad\quad= \mathrm{adds\_map}\left\langle\mathsf{typeId}, \mathsf{strict}\right\rangle\left({\mathsf{strictness}}_{\mathsf{init}}, {{\mathsf{typeId}}_{\mathsf{free}}}^{\ast}, {\mathsf{strict}}^{\ast}\right) \\
{\scriptstyle\mathtt{(8)}} & {\mathsf{constraint}}_{\mathsf{init}} = \mathrm{empty\_constraint}\left({{\mathsf{typeId}}_{\mathsf{infer}}}^{\ast}\right) \\
{\scriptstyle\mathtt{(9)}} & {\left(\left({\mathsf{constraint}}_{\mathsf{pair}} = \mathrm{infer\_pair}\left({\mathsf{constraint}}_{\mathsf{init}}, \mathsf{parameterIR}, \mathsf{argumentIR}\right)\right)\right)}^{\ast} \\
{\scriptstyle\mathtt{(10)}} & {\mathsf{constraint}}_{\mathsf{inferred}} = \mathrm{merge\_constraints}\left({\mathsf{constraint}}_{\mathsf{init}}, {{\mathsf{constraint}}_{\mathsf{pair}}}^{\ast}\right) \\
{\scriptstyle\mathtt{(11)}} & \mathsf{inference} = \mathrm{resolve\_constraint}\left(\mathsf{strictness}, {\mathsf{constraint}}_{\mathsf{inferred}}\right) \\
{\scriptstyle\mathtt{(12)}} & {\mathsf{inference}}_{\mathsf{resolved}} = \mathrm{resolve\_inference}\left(\mathsf{inference}\right)
\end{array}
\end{array}}}

\mathrlap{\displaystyle \begin{array}{rcl}
