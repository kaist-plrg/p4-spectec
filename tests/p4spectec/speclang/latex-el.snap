\mathsf{globalEvalLayer} \mathrel{::=} \mathsf{globalInstLayer}



\mathsf{blockEvalLayer} \mathrel{::=} \mathsf{blockInstLayer}



\mathsf{localEvalLayer} \mathrel{::=} \mathsf{localInstLayer}



\mathsf{evalContext} \mathrel{::=} \left\{\mathsf{GLOBAL} \mathsf{globalEvalLayer}, \mathsf{BLOCK} \mathsf{blockEvalLayer}, \mathsf{LOCAL} \mathsf{localEvalLayer}\right\}

\mathsf{EC} : \mathsf{evalContext}



\mathrm{enter\_e}\left(\mathsf{evalContext}\right) : \mathsf{evalContext}

\begin{aligned}
\mathrm{enter\_e}\left(\mathsf{EC}\right) & = & \mathsf{EC}\left[\mathsf{LOCAL}.\mathsf{FRAMES} = \mathrm{empty\_frame}\left(\right) \mathbin{::} {{\mathsf{EC}}_{\mathsf{LOCAL}}}_{\mathsf{FRAMES}}\right]
\end{aligned}

\mathrm{exit\_e}\left(\mathsf{evalContext}\right) : \mathsf{evalContext}

\begin{aligned}
\mathrm{exit\_e}\left(\mathsf{EC}\right) & = & \mathsf{EC}\left[\mathsf{LOCAL}.\mathsf{FRAMES} = {{\mathsf{frame}}_{\mathsf{t}}}^{\ast}\right] \quad \text{if}\,{{\mathsf{EC}}_{\mathsf{LOCAL}}}_{\mathsf{FRAMES}} = {\mathsf{frame}}_{\mathsf{h}} \mathbin{::} {{\mathsf{frame}}_{\mathsf{t}}}^{\ast}
\end{aligned}



\mathrm{inherit\_e}\left(\mathsf{cursor}, \mathsf{evalContext}\right) : \mathsf{evalContext}

\mathrlap{\displaystyle \begin{array}{rcl}
\mathrm{inherit\_e}\left(\mathsf{GLOBAL}, \mathsf{EC}\right) & = & \mathsf{EC}\left[\mathsf{BLOCK} = \mathsf{blockEvalLayer}\right]\left[\mathsf{LOCAL} = \mathsf{localEvalLayer}\right] \\
\mathrlap{\displaystyle \quad\text{if}\,\begin{array}{r@{\quad}l}
