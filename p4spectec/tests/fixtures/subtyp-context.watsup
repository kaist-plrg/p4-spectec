;; Type membership depends on local and global type/function bindings

dec $test_subtyp_context : bool
def $test_subtyp_context
  = $subtyp(C_global, VAR "A" eps, NAT 1)
    /\ ~$subtyp(C_local, VAR "A" eps, NAT 1)
    /\ $subtyp(C_local, VAR "A" eps, TEXT "x")
    /\ $subtyp(C_value, VAR "A" eps, TEXT "x")
    /\ $subtyp(C_func_global, FUNC eps eps NAT, FUNC "f")
    /\ ~$subtyp(C_func_local, FUNC eps eps NAT, FUNC "f")
    /\ $subtyp(C_func_local, FUNC eps eps TEXT, FUNC "f")
  -- if C_global = $load_typdef($empty_ctx, "A", DEF eps '->' (ALIAS NAT))
  -- if C_local = $add_typ(C_global, "A", DEF eps '->' (ALIAS TEXT))
  -- if C_value = $add_varr(C_local, "x" eps, NAT 0)
  -- if C_func_global = $load_funcdef(C_global, "f", EXT "f" eps eps NAT)
  -- if C_func_local = $add_func(C_func_global, "f", EXT "f" eps eps TEXT)
