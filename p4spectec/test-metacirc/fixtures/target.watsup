syntax choice = A | B
extern syntax opaque
var n : nat
var b : bool

extern dec $host<X>(X) : X
builtin dec $builtin<X>(X) : X

dec $identity<X>(X) : X
def $identity<X>(X) = X

dec $apply(def $f<X>(X) : X, nat) : nat
def $apply(def $f, n) = $f<nat>(n)

tbl dec $lookup(choice) : bool
tbl def $lookup =
  | A => true
  | B => false

dec $fallback(nat) : nat
def $fallback(0) = 1
def $fallback(n) = n
  -- otherwise

relation Split: nat ':' nat '->' nat
  hint(input %0 %2)
rule Split/zero: n_l ':' n_r '->' n_r
  -- if n_l = 0
rule Split/other: n_l ':' $(n_l + n_r) '->' n_r
  -- otherwise

relation Use: nat '->' nat
  hint(input %0)
rule Use: n '->' n_out
  -- Split: n ':' n_out '->' n
  -- debug n_out

relation Check: CHECK nat
  hint(input %0)
rule Check: CHECK n
  -- if n = 0

relation Positive: nat '|-' nat
  hint(input %0)
rule Positive: n '|-' n
  -- Check: CHECK n

relation Negative: nat '|-' nat
  hint(input %0)
rule Negative: n '|-' n
  -- Check:/ CHECK n
