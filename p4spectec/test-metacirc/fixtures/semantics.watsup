dec $check_signatures : bool
def $check_signatures
  = b_same /\ ~b_param /\ ~b_ret /\ b_poly /\ ~b_nested /\ b_higher
  -- if b_same = $equiv_func_typ($empty_ctx, FUNC eps NAT INT, FUNC eps NAT INT)
  -- if b_param = $equiv_func_typ($empty_ctx, FUNC eps NAT INT, FUNC eps INT INT)
  -- if b_ret = $equiv_func_typ($empty_ctx, FUNC eps NAT INT, FUNC eps NAT NAT)
  -- if b_poly = $equiv_func_typ($empty_ctx, FUNC "A" (VAR "A" eps) (VAR "A" eps), FUNC "B" (VAR "B" eps) (VAR "B" eps))
  ;; Native structural equivalence excludes nested function types
  -- if b_nested = $equiv_func_typ($empty_ctx, FUNC eps (FUNC eps NAT INT) NAT, FUNC eps (FUNC eps NAT INT) NAT)
  -- if typ_higher = $func_typ(EXT "f" eps ((EXP NAT) ++ (FUN "g" ':' "X" (EXP (VAR "X" eps)) '->' (VAR "X" eps))) INT)
  -- if typ_expect = FUNC eps (NAT ++ (FUNC "X" (VAR "X" eps) (VAR "X" eps))) INT
  -- if b_higher = $(typ_higher = typ_expect)

dec $check_capture : bool
def $check_capture
  = $(typ_param = typ_param_expect) /\ $(typ_ret = typ_ret_expect) /\ ~$(tparam = "B")
  -- if theta = `{ ("A" ':' (VAR "B" eps)) `}
  -- if FUNC tparam typ_param typ_ret = $subst_typ(theta, FUNC "B" (VAR "A" eps) (VAR "B" eps))
  -- if typ_param_expect = VAR "B" eps
  -- if typ_ret_expect = VAR tparam eps

dec $check_membership : bool
def $check_membership = b_poly /\ ~b_param /\ ~b_ret
  -- if C = $load($empty_ctx, EXTFUNC "f" "A" (EXP (VAR "A" eps)) ':' (VAR "A" eps))
  -- if b_poly = $subtyp(C, FUNC "B" (VAR "B" eps) (VAR "B" eps), FUNC "f")
  -- if b_param = $subtyp(C, FUNC "B" NAT (VAR "B" eps), FUNC "f")
  -- if b_ret = $subtyp(C, FUNC "B" (VAR "B" eps) NAT, FUNC "f")

dec $check_call : bool
def $check_call = $(valres = valres_expect) /\ $(valres' = valres_expect)
  -- if C = $add_typ($empty_ctx, "A", DEF eps '->' (ALIAS NAT))
  -- if C' = $load_funcdef(C, "f", DEF "X" eps BOOL '->' (eps '=' (SUB (NAT 1) (VAR "X" eps)) '-' eps) eps)
  -- Eval_exp: C' |- CALL "f" (VAR "A" eps) eps : valres
  -- Eval_exp: C' |- CALL "f" NAT eps : valres'
  -- if valres_expect = OK (BOOL true)

dec $check_slice : bool
def $check_slice = $(valres = valres_expect) /\ $(valres_multi = valres_multi_expect) /\ $(valres_empty = valres_empty_expect) /\ $(valres_len = valres_fail) /\ $(valres_scalar = valres_fail)
  -- Eval_exp: $empty_ctx |- UPD (LIST (NAT 1)) (SLICE ROOT (NAT 0) (NAT 1)) (LIST (NAT 3)) : valres
  -- if valres_expect = OK (LIST (NAT 3))
  -- Eval_exp: $empty_ctx |- UPD (LIST ((NAT 1) ++ (NAT 2) ++ (NAT 3))) (SLICE ROOT (NAT 1) (NAT 2)) (LIST ((NAT 8) ++ (NAT 9))) : valres_multi
  -- if valres_multi_expect = OK (LIST ((NAT 1) ++ (NAT 8) ++ (NAT 9)))
  -- Eval_exp: $empty_ctx |- UPD (LIST (NAT 1)) (SLICE ROOT (NAT 0) (NAT 0)) (LIST eps) : valres_empty
  -- if valres_empty_expect = OK (LIST (NAT 1))
  -- Eval_exp: $empty_ctx |- UPD (LIST (NAT 1)) (SLICE ROOT (NAT 0) (NAT 1)) (LIST eps) : valres_len
  -- Eval_exp: $empty_ctx |- UPD (LIST (NAT 1)) (SLICE ROOT (NAT 0) (NAT 1)) (NAT 3) : valres_scalar
  -- if valres_fail = FAIL
