    -- (Guard_rul: AC |- rulAL_else : rulAL_else_guard)?{rulAL_else <- rulAL_else?, rulAL_else_guard <- rulAL_else_guard?}
    -- (if (elsGroupAL_guard = id_else ':' rulAL_else_guard))?{elsGroupAL_guard <- elsGroupAL_guard?, id_else <- id_else?, rulAL_else_guard <- rulAL_else_guard?}
    -- if (definedRelDefnAL_guard = REL id ':' typ_in*{typ_in <- typ_in*} '->' typ_out*{typ_out <- typ_out*} '=' rulGroupAL_guard*{rulGroupAL_guard <- rulGroupAL_guard*} elsGroupAL_guard?{elsGroupAL_guard <- elsGroupAL_guard?})

  rulegroup func

    rule extern: AC |- externFuncDefn as defnAL : externFuncDefn as defnAL

    rule builtin: AC |- builtinFuncDefn as defnAL : builtinFuncDefn as defnAL

    rule table: AC |- tableFuncDefnAL as defnAL : tableFuncDefnAL_guard as defnAL
    -- if (TABLEFUNC id param*{param <- param*} ':' typ '=' tblRowAL*{tblRowAL <- tblRowAL*} = tableFuncDefnAL)
    -- (Guard_tblRow: AC |- tblRowAL : tblRowAL_guard)*{tblRowAL <- tblRowAL*, tblRowAL_guard <- tblRowAL_guard*}
    -- if (tableFuncDefnAL_guard = TABLEFUNC id param*{param <- param*} ':' typ '=' tblRowAL_guard*{tblRowAL_guard <- tblRowAL_guard*})

    rule defined: AC |- definedFuncDefnAL as defnAL : definedFuncDefnAL_guard as defnAL
    -- if (FUNC id tparam*{tparam <- tparam*} param*{param <- param*} ':' typ '=' clauseAL*{clauseAL <- clauseAL*} elsClauseAL?{elsClauseAL <- elsClauseAL?} = definedFuncDefnAL)
    -- if (AC_func = $add_tparams(AC, tparam*{tparam <- tparam*}))
    -- (Guard_clause: AC_func |- clauseAL : clauseAL_guard)*{clauseAL <- clauseAL*, clauseAL_guard <- clauseAL_guard*}
    -- (Guard_clause: AC_func |- elsClauseAL : elsClauseAL_guard)?{elsClauseAL <- elsClauseAL?, elsClauseAL_guard <- elsClauseAL_guard?}
    -- if (definedFuncDefnAL_guard = FUNC id tparam*{tparam <- tparam*} param*{param <- param*} ':' typ '=' clauseAL_guard*{clauseAL_guard <- clauseAL_guard*} elsClauseAL_guard?{elsClauseAL_guard <- elsClauseAL_guard?})

relation Exp_pure: |- typedExp

  rulegroup literal

    rule literal: |- literalExp as exp '#' _typ

  rulegroup variable

    rule variable: |- varExp as exp '#' _typ

  rulegroup unary

    rule unary: |- UN _unOp typedExp as exp '#' _typ
    -- if Exp_pure: |- typedExp holds

  rulegroup binary

    rule binary: |- BIN _binOp typedExp_l typedExp_r as exp '#' _typ
    -- if Exp_pure: |- typedExp_l holds
    -- if Exp_pure: |- typedExp_r holds

  rulegroup compare

    rule compare: |- CMP _cmpOp typedExp_l typedExp_r as exp '#' _typ
    -- if Exp_pure: |- typedExp_l holds
    -- if Exp_pure: |- typedExp_r holds

  rulegroup upcast

    rule upcast: |- UPCAST _typ typedExp as exp '#' _typ'
    -- if Exp_pure: |- typedExp holds

  rulegroup downcast

    rule downcast: |- DOWNCAST _typ typedExp as exp '#' _typ'
    -- if Exp_pure: |- typedExp holds

  rulegroup subtype

    rule subtype: |- SUB typedExp _typ as exp '#' _typ'
    -- if Exp_pure: |- typedExp holds

  rulegroup match

    rule match: |- MATCH typedExp _pat as exp '#' _typ
    -- if Exp_pure: |- typedExp holds

  rulegroup tuple

    rule tuple: |- TUP typedExp*{typedExp <- typedExp*} as exp '#' _typ
    -- (if Exp_pure: |- typedExp holds)*{typedExp <- typedExp*}

  rulegroup case

    rule case: |- INJ _mixop typedExp*{typedExp <- typedExp*} as exp '#' _typ
    -- (if Exp_pure: |- typedExp holds)*{typedExp <- typedExp*}

  rulegroup struct

    rule struct: |- STR expField*{expField <- expField*} as exp '#' _typ
    -- (if (_atom typedExp = expField))*{_atom <- _atom*, expField <- expField*, typedExp <- typedExp*}
    -- (if Exp_pure: |- typedExp holds)*{typedExp <- typedExp*}

  rulegroup opt

    rule opt: |- OPT typedExp?{typedExp <- typedExp?} as exp '#' _typ
    -- (if Exp_pure: |- typedExp holds)?{typedExp <- typedExp?}

  rulegroup list

    rule list: |- LIST typedExp*{typedExp <- typedExp*} as exp '#' _typ
    -- (if Exp_pure: |- typedExp holds)*{typedExp <- typedExp*}

  rulegroup cons

    rule cons: |- CONS typedExp_h typedExp_t as exp '#' _typ
    -- if Exp_pure: |- typedExp_h holds
    -- if Exp_pure: |- typedExp_t holds

  rulegroup concat

    rule concat: |- CAT typedExp_l typedExp_r as exp '#' _typ
    -- if Exp_pure: |- typedExp_l holds
    -- if Exp_pure: |- typedExp_r holds

  rulegroup mem

    rule mem: |- MEM typedExp_l typedExp_r as exp '#' _typ
    -- if Exp_pure: |- typedExp_l holds
    -- if Exp_pure: |- typedExp_r holds

  rulegroup len

    rule len: |- LEN typedExp as exp '#' _typ
    -- if Exp_pure: |- typedExp holds

  rulegroup dot

    rule dot: |- DOT typedExp _atom as exp '#' _typ
    -- if Exp_pure: |- typedExp holds

  rulegroup idx

    rule idx: |- IDX typedExp_b typedExp_i as exp '#' _typ
    -- if Exp_pure: |- typedExp_b holds
    -- if Exp_pure: |- typedExp_i holds

  rulegroup slice

    rule slice: |- SLICE typedExp_b typedExp_i typedExp_n as exp '#' _typ
    -- if Exp_pure: |- typedExp_b holds
    -- if Exp_pure: |- typedExp_i holds
    -- if Exp_pure: |- typedExp_n holds

  rulegroup upd

    rule upd: |- UPD typedExp_b typedPath typedExp_f as exp '#' _typ
    -- if Exp_pure: |- typedExp_b holds
    -- if Path_pure: |- typedPath holds
    -- if Exp_pure: |- typedExp_f holds

  rulegroup iter

    rule iter: |- ITER typedExp _expIter as exp '#' _typ
    -- if Exp_pure: |- typedExp holds

relation Path_pure: |- typedPath

  rulegroup root

    rule root: |- ROOT as path '#' _typ

  rulegroup idx

    rule idx: |- IDX typedPath typedExp_i as path '#' _typ
    -- if Path_pure: |- typedPath holds
    -- if Exp_pure: |- typedExp_i holds

  rulegroup slice

    rule slice: |- SLICE typedPath typedExp_i typedExp_n as path '#' _typ
    -- if Path_pure: |- typedPath holds
    -- if Exp_pure: |- typedExp_i holds
    -- if Exp_pure: |- typedExp_n holds

  rulegroup dot

    rule dot: |- DOT typedPath _atom as path '#' _typ
    -- if Path_pure: |- typedPath holds

relation Prem_pure: |- premAL

  rulegroup let

    rule let: |- LET _typedExp '=' typedExp_r as premAL
    -- if Exp_pure: |- typedExp_r holds

  rulegroup iter

    rule iter: |- ITER premAL _premIterAL as premAL
    -- if Prem_pure: |- premAL holds

  rulegroup dbg

    rule dbg: |- DEBUG typedExp as premAL
    -- if Exp_pure: |- typedExp holds

relation Otherwise_pure: |- defnAL

  rulegroup typ

    rule typ: |- typDefn as defnAL

  rulegroup rel

    rule extern: |- externRelDefnAL as defnAL

    rule none: |- REL _id ':' _typ*{_typ <- _typ*} '->' _typ'*{_typ' <- _typ'*} '=' _rulGroupAL*{_rulGroupAL <- _rulGroupAL*} ?() as defnAL

    rule else: |- REL _id ':' _typ*{_typ <- _typ*} '->' _typ'*{_typ' <- _typ'*} '=' _rulGroupAL*{_rulGroupAL <- _rulGroupAL*} ?(elsGroupAL) as defnAL
    -- if (_id' ':' rulAL = elsGroupAL)
    -- if (_id'' ':' _typedExp*{_typedExp <- _typedExp*} '->' typedExp_out*{typedExp_out <- typedExp_out*} '-' premAL*{premAL <- premAL*} = rulAL)
    -- (if Prem_pure: |- premAL holds)*{premAL <- premAL*}
    -- (if Exp_pure: |- typedExp_out holds)*{typedExp_out <- typedExp_out*}

  rulegroup func

    rule extern: |- externFuncDefn as defnAL

    rule builtin: |- builtinFuncDefn as defnAL

    rule table: |- tableFuncDefnAL as defnAL

    rule none: |- FUNC _id _tparam*{_tparam <- _tparam*} _param*{_param <- _param*} ':' _typ '=' _clauseAL*{_clauseAL <- _clauseAL*} ?() as defnAL

    rule else: |- FUNC _id _tparam*{_tparam <- _tparam*} _param*{_param <- _param*} ':' _typ '=' _clauseAL*{_clauseAL <- _clauseAL*} ?(elsClauseAL) as defnAL
    -- if (_arg*{_arg <- _arg*} '=' typedExp '-' premAL*{premAL <- premAL*} = elsClauseAL)
    -- (if Prem_pure: |- premAL holds)*{premAL <- premAL*}
    -- if Exp_pure: |- typedExp holds

def $free_varis_exp(typedExp) : vari* =

  clause 0 : (literalExp as exp '#' _typ) = []

  clause 1 : (VAR id as exp '#' typ) = [id typ []]

  clause 2 : (UN _unOp typedExp as exp '#' _typ) = $free_varis_exp(typedExp)

  clause 3 : (BIN _binOp typedExp_l typedExp_r as exp '#' _typ) = $free_varis_exps([typedExp_l, typedExp_r])

  clause 4 : (CMP _cmpOp typedExp_l typedExp_r as exp '#' _typ) = $free_varis_exps([typedExp_l, typedExp_r])

  clause 5 : (UPCAST _typ typedExp as exp '#' _typ') = $free_varis_exp(typedExp)

  clause 6 : (DOWNCAST _typ typedExp as exp '#' _typ') = $free_varis_exp(typedExp)

  clause 7 : (SUB typedExp _typ as exp '#' _typ') = $free_varis_exp(typedExp)

  clause 8 : (MATCH typedExp _pat as exp '#' _typ) = $free_varis_exp(typedExp)

  clause 9 : (TUP typedExp*{typedExp <- typedExp*} as exp '#' _typ) = $free_varis_exps(typedExp*{typedExp <- typedExp*})

  clause 10 : (INJ _mixop typedExp*{typedExp <- typedExp*} as exp '#' _typ) = $free_varis_exps(typedExp*{typedExp <- typedExp*})

  clause 11 : (STR expField*{expField <- expField*} as exp '#' _typ) = $free_varis_exps(typedExp*{typedExp <- typedExp*})
  -- (if (_atom typedExp = expField))*{_atom <- _atom*, expField <- expField*, typedExp <- typedExp*}

  clause 12 : (OPT ?() as exp '#' _typ) = []

  clause 13 : (OPT ?(typedExp) as exp '#' _typ) = $free_varis_exp(typedExp)

  clause 14 : (LIST typedExp*{typedExp <- typedExp*} as exp '#' _typ) = $free_varis_exps(typedExp*{typedExp <- typedExp*})

  clause 15 : (CONS typedExp_h typedExp_t as exp '#' _typ) = $free_varis_exps([typedExp_h, typedExp_t])

  clause 16 : (CAT typedExp_l typedExp_r as exp '#' _typ) = $free_varis_exps([typedExp_l, typedExp_r])

  clause 17 : (MEM typedExp_l typedExp_r as exp '#' _typ) = $free_varis_exps([typedExp_l, typedExp_r])

  clause 18 : (LEN typedExp as exp '#' _typ) = $free_varis_exp(typedExp)

  clause 19 : (DOT typedExp _atom as exp '#' _typ) = $free_varis_exp(typedExp)

  clause 20 : (IDX typedExp_b typedExp_i as exp '#' _typ) = $free_varis_exps([typedExp_b, typedExp_i])

  clause 21 : (SLICE typedExp_b typedExp_i typedExp_n as exp '#' _typ) = $free_varis_exps([typedExp_b, typedExp_i, typedExp_n])

  clause 22 : (UPD typedExp_b typedPath typedExp_f as exp '#' _typ) = $free_varis_exp(typedExp_b) ++ $free_varis_path(typedPath) ++ $free_varis_exp(typedExp_f)

  clause 23 : (CALL _id _targ*{_targ <- _targ*} arg*{arg <- arg*} as exp '#' _typ) = $free_varis_args(arg*{arg <- arg*})

  clause 24 : (ITER typedExp iter _vari*{_vari <- _vari*} as exp '#' _typ) = vari_iter*{vari_iter <- vari_iter*}
  -- if (vari*{vari <- vari*} = $free_varis_exp(typedExp))
  -- (if (vari_iter = $iterate_vari(vari, [iter])))*{vari <- vari*, vari_iter <- vari_iter*}

def $free_varis_exps(typedExp*) : vari* =

  clause 0 : ([]) = []

  clause 1 : (typedExp_h :: typedExp_t*{typedExp_t <- typedExp_t*}) = $free_varis_exp(typedExp_h) ++ $free_varis_exps(typedExp_t*{typedExp_t <- typedExp_t*})

def $free_varis_path(typedPath) : vari* =

  clause 0 : (ROOT as path '#' _typ) = []

  clause 1 : (IDX typedPath typedExp_i as path '#' _typ) = $free_varis_path(typedPath) ++ $free_varis_exp(typedExp_i)

  clause 2 : (SLICE typedPath typedExp_i typedExp_n as path '#' _typ) = $free_varis_path(typedPath) ++ $free_varis_exps([typedExp_i, typedExp_n])

  clause 3 : (DOT typedPath _atom as path '#' _typ) = $free_varis_path(typedPath)

def $free_varis_arg(arg) : vari* =

  clause 0 : (EXP typedExp as arg) = $free_varis_exp(typedExp)

  clause 1 : (funArg as arg) = []

def $free_varis_args(arg*) : vari* =

  clause 0 : ([]) = []

  clause 1 : (arg_h :: arg_t*{arg_t <- arg_t*}) = $free_varis_arg(arg_h) ++ $free_varis_args(arg_t*{arg_t <- arg_t*})

def $free_varis_premIL(premIL) : vari* =

  clause 0 : (REL _id ':' typedExp*{typedExp <- typedExp*} `( _inputHint `) as premIL) = $free_varis_exps(typedExp*{typedExp <- typedExp*})

  clause 1 : (IF typedExp as premIL) = $free_varis_exp(typedExp)

  clause 2 : (IFHOLD _id ':' typedExp*{typedExp <- typedExp*} as premIL) = $free_varis_exps(typedExp*{typedExp <- typedExp*})

  clause 3 : (IFNOTHOLD _id ':' typedExp*{typedExp <- typedExp*} as premIL) = $free_varis_exps(typedExp*{typedExp <- typedExp*})

  clause 4 : (ITER premIL iter _vari*{_vari <- _vari*} as premIL) = vari_iter*{vari_iter <- vari_iter*}
  -- if (vari*{vari <- vari*} = $free_varis_premIL(premIL))
  -- (if (vari_iter = $iterate_vari(vari, [iter])))*{vari <- vari*, vari_iter <- vari_iter*}

  clause 5 : (DEBUG typedExp as premIL) = $free_varis_exp(typedExp)

def $free_varis_premILs(premIL*) : vari* =

  clause 0 : ([]) = []

  clause 1 : (premIL_h :: premIL_t*{premIL_t <- premIL_t*}) = $free_varis_premIL(premIL_h) ++ $free_varis_premILs(premIL_t*{premIL_t <- premIL_t*})

def $free_varis_rulIL(rulIL) : vari* =

  clause 0 : (_id ':' typedExp*{typedExp <- typedExp*} '-' premIL*{premIL <- premIL*}) = $free_varis_exps(typedExp*{typedExp <- typedExp*}) ++ $free_varis_premILs(premIL*{premIL <- premIL*})

def $free_varis_clauseIL(clauseIL) : vari* =

  clause 0 : (arg*{arg <- arg*} '=' typedExp '-' premIL*{premIL <- premIL*}) = $free_varis_args(arg*{arg <- arg*}) ++ $free_varis_exp(typedExp) ++ $free_varis_premILs(premIL*{premIL <- premIL*})

def $free_varis_tblRowIL(tblRowIL) : vari* =

  clause 0 : (arg*{arg <- arg*} '=' typedExp) = $free_varis_args(arg*{arg <- arg*}) ++ $free_varis_exp(typedExp)

def $iter_exp(typedExp, vari, iter*) : typedExp =

  clause 0 : (typedExp, _vari, []) = typedExp

  clause 1 : (typedExp, vari, iter_h :: iter_t*{iter_t <- iter_t*}) = $iter_exp(typedExp_iter, vari_iter, iter_t*{iter_t <- iter_t*})
  -- if (_exp '#' typ = typedExp)
  -- if (iterExp = ITER typedExp iter_h [vari])
  -- if (typedExp_iter = iterExp as exp '#' ITER typ iter_h)
  -- if (vari_iter = $iterate_vari(vari, [iter_h]))

def $exp_of_vari(vari) : typedExp =

  clause 0 : (id typ iter*{iter <- iter*}) = $iter_exp(typedExp, id typ [], iter*{iter <- iter*})
  -- if (varExp = VAR id)
  -- if (typedExp = varExp as exp '#' typ)

def $is_bound_vari(vari*, vari) : bool =

  clause 0 : ([], _vari) = false

  clause 1 : (vari_h :: _vari*{_vari <- _vari*}, vari) = true
  -- if (id _typ _iter*{_iter <- _iter*} = vari)
  -- if (id _typ' _iter'*{_iter' <- _iter'*} = vari_h)
  -- if $is_prefix_dim(vari_h, vari)

  clause 2 : (vari_h :: vari_t*{vari_t <- vari_t*}, vari) = $is_bound_vari(vari_t*{vari_t <- vari_t*}, vari)
  -- if (id _typ _iter*{_iter <- _iter*} = vari)
  -- if (id_h _typ' _iter'*{_iter' <- _iter'*} = vari_h)
  -- if ((id_h =/= id) \/ ~$is_prefix_dim(vari_h, vari))

def $is_bound_varis(algoCtx, iterCtx, vari*) : bool =

  clause 0 : (AC, IC, vari*{vari <- vari*}) = $forall_($is_bound_vari(AC.BOUND, $iterate_vari(vari, iter*{iter <- iter*}))*{vari <- vari*})
  -- if (iter _vari*{_vari <- _vari*}*{_vari* <- _vari**, iter <- iter*} = IC)

def $is_bound_exp(algoCtx, typedExp) : bool =

  clause 0 : (AC, typedExp) = $forall_(id <- id_bound*{id_bound <- id_bound*}*{id <- id*})
  -- if (id*{id <- id*} = $ids_of_varis($free_varis_exp(typedExp)))
  -- if (id_bound*{id_bound <- id_bound*} = $ids_of_varis(AC.BOUND))

syntax occ = map<id, id*>

syntax renamer = {USED id*, SEEN id*, OCC occ}

var R : renamer

def $init_renamer(id*, vari*) : renamer =

  clause 0 : (id_used*{id_used <- id_used*}, []) = {USED id_used*{id_used <- id_used*}, SEEN [], OCC $empty_map<id, id*>}

  clause 1 : (id_used*{id_used <- id_used*}, vari_h :: vari_t*{vari_t <- vari_t*}) = R[OCC = occ]
  -- if (id_h _typ _iter*{_iter <- _iter*} = vari_h)
  -- if ~id_h <- $ids_of_varis(vari_t*{vari_t <- vari_t*})
  -- if (R = $init_renamer(id_used*{id_used <- id_used*}, vari_t*{vari_t <- vari_t*}))
  -- if (occ = $add_map<id, id*>(R.OCC, id_h, []))

  clause 2 : (id_used*{id_used <- id_used*}, vari_h :: vari_t*{vari_t <- vari_t*}) = $init_renamer(id_used*{id_used <- id_used*}, vari_t*{vari_t <- vari_t*})
  -- if vari_h <- vari_t*{vari_t <- vari_t*}

def $rename_exp(renamer, typedExp) : (renamer, typedExp) =

  clause 0 : (R, VAR id as exp '#' typ) = (R, VAR id as exp '#' typ)
  -- if (`{ id_bind ':' _id*{_id <- _id*}*{_id* <- _id**, id_bind <- id_bind*} `} = R.OCC)
  -- if ~id <- id_bind*{id_bind <- id_bind*}

  clause 1 : (R, VAR id as exp '#' typ) = (R_multi, VAR id as exp '#' typ)
  -- if (?(id_later*{id_later <- id_later*}) = $find_map<id, id*>(R.OCC, id))
  -- if ~id <- R.SEEN
  -- if (R_multi = R[SEEN = R.SEEN ++ [id]])

  clause 2 : (R, VAR id as exp '#' typ) = (R_multi, VAR id_fresh as exp '#' typ)
  -- if (?(id_later*{id_later <- id_later*}) = $find_map<id, id*>(R.OCC, id))
  -- if id <- R.SEEN
  -- if ((id_used*{id_used <- id_used*}, id_fresh) = $fresh_id(R.USED))
  -- if (occ = $add_map<id, id*>(R.OCC, id, id_later*{id_later <- id_later*} ++ [id_fresh]))
  -- if (R_multi = {USED id_used*{id_used <- id_used*}, SEEN R.SEEN, OCC occ})

  clause 3 : (R, UPCAST typ_sup typedExp as exp '#' typ) = (R_multi, UPCAST typ_sup typedExp_multi as exp '#' typ)
  -- if ((R_multi, typedExp_multi) = $rename_exp(R, typedExp))

  clause 4 : (R, TUP typedExp*{typedExp <- typedExp*} as exp '#' typ) = (R_multi, TUP typedExp_multi*{typedExp_multi <- typedExp_multi*} as exp '#' typ)
  -- if ((R_multi, typedExp_multi*{typedExp_multi <- typedExp_multi*}) = $rename_exps(R, typedExp*{typedExp <- typedExp*}))

  clause 5 : (R, INJ mixop typedExp*{typedExp <- typedExp*} as exp '#' typ) = (R_multi, INJ mixop typedExp_multi*{typedExp_multi <- typedExp_multi*} as exp '#' typ)
  -- if ((R_multi, typedExp_multi*{typedExp_multi <- typedExp_multi*}) = $rename_exps(R, typedExp*{typedExp <- typedExp*}))

  clause 6 : (R, STR expField*{expField <- expField*} as exp '#' typ) = (R_multi, STR expField_multi*{expField_multi <- expField_multi*} as exp '#' typ)
  -- (if (atom typedExp = expField))*{atom <- atom*, expField <- expField*, typedExp <- typedExp*}
  -- if ((R_multi, typedExp_multi*{typedExp_multi <- typedExp_multi*}) = $rename_exps(R, typedExp*{typedExp <- typedExp*}))
  -- (if (expField_multi = atom typedExp_multi))*{atom <- atom*, expField_multi <- expField_multi*, typedExp_multi <- typedExp_multi*}

  clause 7 : (R, OPT ?() as exp '#' typ) = (R, OPT ?() as exp '#' typ)

  clause 8 : (R, OPT ?(typedExp) as exp '#' typ) = (R_multi, OPT ?(typedExp_multi) as exp '#' typ)
  -- if ((R_multi, typedExp_multi) = $rename_exp(R, typedExp))

  clause 9 : (R, LIST typedExp*{typedExp <- typedExp*} as exp '#' typ) = (R_multi, LIST typedExp_multi*{typedExp_multi <- typedExp_multi*} as exp '#' typ)
  -- if ((R_multi, typedExp_multi*{typedExp_multi <- typedExp_multi*}) = $rename_exps(R, typedExp*{typedExp <- typedExp*}))

  clause 10 : (R, CONS typedExp_h typedExp_t as exp '#' typ) = (R_t, CONS typedExp_h_multi typedExp_t_multi as exp '#' typ)
  -- if ((R_h, typedExp_h_multi) = $rename_exp(R, typedExp_h))
  -- if ((R_t, typedExp_t_multi) = $rename_exp(R_h, typedExp_t))

  clause 11 : (R, ITER typedExp iter vari*{vari <- vari*} as exp '#' typ) = (R_multi, ITER typedExp_multi iter vari_occ*{vari_occ <- vari_occ*} as exp '#' typ)
  -- if ((R_multi, typedExp_multi) = $rename_exp(R, typedExp))
  -- if (id_free*{id_free <- id_free*} = $ids_of_varis($free_varis_exp(typedExp_multi)))
  -- (if (vari_rename*{vari_rename <- vari_rename*} = $rename_iter_vari(R_multi.OCC, vari, id_free*{id_free <- id_free*})))*{vari <- vari*, vari_rename* <- vari_rename**}
  -- if (vari_occ*{vari_occ <- vari_occ*} = $concat_<vari>(vari_rename*{vari_rename <- vari_rename*}*{vari_rename* <- vari_rename**}))

  clause 12 : (R, typedExp) = (R, typedExp)
  -- if (exp '#' _typ = typedExp)
  -- if ((((((((~exp <: varExp /\ ~exp <: upCastExp) /\ ~exp <: tupExp) /\ ~exp <: injExp) /\ ~exp <: strExp) /\ ~exp <: optExp) /\ ~exp <: listExp) /\ ~exp <: consExp) /\ ~exp <: iterExp)

def $rename_exps(renamer, typedExp*) : (renamer, typedExp*) =

  clause 0 : (R, []) = (R, [])

  clause 1 : (R, typedExp_h :: typedExp_t*{typedExp_t <- typedExp_t*}) = (R_t, typedExp_h_multi :: typedExp_t_multi*{typedExp_t_multi <- typedExp_t_multi*})
  -- if ((R_h, typedExp_h_multi) = $rename_exp(R, typedExp_h))
  -- if ((R_t, typedExp_t_multi*{typedExp_t_multi <- typedExp_t_multi*}) = $rename_exps(R_h, typedExp_t*{typedExp_t <- typedExp_t*}))

def $rename_iter_vari(occ, vari, id*) : vari* =

  clause 0 : (occ, id typ iter*{iter <- iter*}, id_free*{id_free <- id_free*}) = id_occ typ iter*{iter <- iter*}*{id_occ <- id_occ*}
  -- if (?(id_later*{id_later <- id_later*}) = $find_map<id, id*>(occ, id))
  -- if (id_occ*{id_occ <- id_occ*} = $intersect_<id>(id :: id_later*{id_later <- id_later*}, id_free*{id_free <- id_free*}))

  clause -1 : (_occ, vari, _id*{_id <- _id*}) = [vari]

def $rename_arg(renamer, arg) : (renamer, arg) =

  clause 0 : (R, EXP typedExp as arg) = (R_multi, EXP typedExp_multi as arg)
  -- if ((R_multi, typedExp_multi) = $rename_exp(R, typedExp))

  clause 1 : (R, FUN id as arg) = (R, FUN id as arg)

def $rename_args(renamer, arg*) : (renamer, arg*) =

  clause 0 : (R, []) = (R, [])

  clause 1 : (R, arg_h :: arg_t*{arg_t <- arg_t*}) = (R_t, arg_h_multi :: arg_t_multi*{arg_t_multi <- arg_t_multi*})
  -- if ((R_h, arg_h_multi) = $rename_arg(R, arg_h))
  -- if ((R_t, arg_t_multi*{arg_t_multi <- arg_t_multi*}) = $rename_args(R_h, arg_t*{arg_t <- arg_t*}))

def $sideconds_multi(iterCtx, vari*, renamer) : premAL* =

  clause 0 : (IC, vari_bind*{vari_bind <- vari_bind*}, R) = $concat_<premAL>(premAL_eq*{premAL_eq <- premAL_eq*}*{premAL_eq* <- premAL_eq**})
  -- if (`{ id_bind ':' id_later*{id_later <- id_later*}*{id_bind <- id_bind*, id_later* <- id_later**} `} = R.OCC)
  -- (if (vari_first = $select_varis(vari_bind*{vari_bind <- vari_bind*}, [id_bind])[0]))*{id_bind <- id_bind*, vari_first <- vari_first*}
  -- (if (premAL_eq*{premAL_eq <- premAL_eq*} = $sideconds_multi_binder(IC, vari_first, id_later*{id_later <- id_later*})))*{id_later* <- id_later**, premAL_eq* <- premAL_eq**, vari_first <- vari_first*}

def $sideconds_multi_binder(iterCtx, vari, id*) : premAL* =

  clause 0 : (IC, vari, id_later*{id_later <- id_later*}) = $sidecond_multi_binder(IC, vari, id_later)*{id_later <- id_later*}

def $sidecond_multi_binder(iterCtx, vari, id) : premAL =

  clause 0 : (IC, id_first typ iter*{iter <- iter*}, id_later) = $iterate_prem(premAL_cmp, premIterAL*{premIterAL <- premIterAL*})
  -- if (typedExp_first = VAR id_first as exp '#' typ)
  -- if (typedExp_later = VAR id_later as exp '#' typ)
  -- if (typedExp_cmp = CMP EQ as cmpOp typedExp_first typedExp_later as exp '#' BOOL as typ)
  -- if (premAL_cmp = IF typedExp_cmp as premAL)
  -- if (IC_inner = iter []*{iter <- iter*})
  -- if (iter_outer _vari*{_vari <- _vari*}*{_vari* <- _vari**, iter_outer <- iter_outer*} = IC)
  -- if (IC_outer = iter_outer []*{iter_outer <- iter_outer*})
  -- if (vari_first = id_first typ [])
  -- if (vari_later = id_later typ [])
  -- if (IC_cmp = $add_iterated(IC_inner ++ IC_outer, [vari_first, vari_later]))
  -- if (premIterAL*{premIterAL <- premIterAL*} = $prem_iters(IC_cmp, [id_first, id_later], []))

def $sidecond_partial(iterCtx, vari, typedExp) : premAL =

  clause 0 : (IC, vari_d, typedExp_check) = $iterate_prem(IF typedExp_check as premAL, premIterAL*{premIterAL <- premIterAL*})
  -- if (id_d _typ _iter*{_iter <- _iter*} = vari_d)
  -- if (premIterAL*{premIterAL <- premIterAL*} = $prem_iters($add_iterated(IC, [vari_d]), [id_d], []))

def $prem_let_partial(iterCtx, vari, typedExp, typedExp) : premAL =

  clause 0 : (IC, vari_d, typedExp_l, typedExp_r) = $iterate_prem(LET typedExp_l '=' typedExp_r as premAL, premIterAL*{premIterAL <- premIterAL*})
  -- if (id_d _typ _iter*{_iter <- _iter*} = vari_d)
  -- if (vari_l*{vari_l <- vari_l*} = $free_varis_exp(typedExp_l))
  -- if (vari_bind*{vari_bind <- vari_bind*} = $shallowest_varis(vari_l*{vari_l <- vari_l*}))
  -- if (IC_bind = $add_iterated(IC, vari_d :: vari_bind*{vari_bind <- vari_bind*}))
  -- if (premIterAL*{premIterAL <- premIterAL*} = $prem_iters(IC_bind, [id_d], $ids_of_varis(vari_bind*{vari_bind <- vari_bind*})))

def $is_singleton_typ(tdenv, typ) : bool =

  clause 0 : (tdenv, typ) = true
  -- if (OK VAR id targ*{targ <- targ*} as typRes = $expand_typ(tdenv, typ))
  -- if (?(TYP _id tparam*{tparam <- tparam*} '=' VARIANT typCase*{typCase <- typCase*} as typDef) = $find_map<id, typDef>(tdenv, id))
  -- if (|typCase*{typCase <- typCase*}| = 1)
  -- if (|tparam*{tparam <- tparam*}| = |targ*{targ <- targ*}|)

  clause -1 : (_tdenv, _typ) = false

def $is_irrefutable(tdenv, typedExp) : bool =

  clause 0 : (_tdenv, varExp as exp '#' _typ) = true

  clause 1 : (tdenv, TUP typedExp*{typedExp <- typedExp*} as exp '#' _typ) = $forall_($is_irrefutable(tdenv, typedExp)*{typedExp <- typedExp*})

  clause 2 : (tdenv, INJ _mixop typedExp*{typedExp <- typedExp*} as exp '#' typ) = ($is_singleton_typ(tdenv, typ) /\ $forall_($is_irrefutable(tdenv, typedExp)*{typedExp <- typedExp*}))

  clause 3 : (tdenv, STR expField*{expField <- expField*} as exp '#' _typ) = $forall_($is_irrefutable(tdenv, typedExp)*{typedExp <- typedExp*})
  -- (if (_atom typedExp = expField))*{_atom <- _atom*, expField <- expField*, typedExp <- typedExp*}

  clause 4 : (tdenv, ITER typedExp _expIter as exp '#' _typ) = $is_irrefutable(tdenv, typedExp)

  clause 5 : (_tdenv, exp '#' _typ) = false
  -- if ((((~exp <: varExp /\ ~exp <: tupExp) /\ ~exp <: injExp) /\ ~exp <: strExp) /\ ~exp <: iterExp)

def $variant_cases(tdenv, typ) : typCase* =

  clause 0 : (tdenv, VAR id _targ*{_targ <- _targ*}) = typCase*{typCase <- typCase*}
  -- if (?(TYP _id _tparam*{_tparam <- _tparam*} '=' VARIANT typCase*{typCase <- typCase*} as typDef) = $find_map<id, typDef>(tdenv, id))

def $covered_cases(tdenv, typedExp) : typCase* =

  clause 0 : (tdenv, varExp as exp '#' typ) = $variant_cases(tdenv, typ)

  clause 1 : (tdenv, UPCAST _typ typedExp as exp '#' _typ') = $covered_cases(tdenv, typedExp)

  clause 2 : (tdenv, INJ mixop typedExp*{typedExp <- typedExp*} as exp '#' _typ) = [mixop typ*{typ <- typ*}]
  -- if $forall_($is_irrefutable(tdenv, typedExp)*{typedExp <- typedExp*})
  -- (if (_exp '#' typ = typedExp))*{_exp <- _exp*, typ <- typ*, typedExp <- typedExp*}

def $is_wildcard_exp(typedExp) : bool =

  clause 0 : (VAR id as exp '#' _typ) = true
  -- if (|id| > 0)
  -- if (id[0 : 1] = "_")

  clause -1 : (_typedExp) = false

def $shares_case(typCase*, typCase*) : bool =

  clause 0 : (typCase_a*{typCase_a <- typCase_a*}, typCase_b*{typCase_b <- typCase_b*}) = $exists_(typCase_a <- typCase_b*{typCase_b <- typCase_b*}*{typCase_a <- typCase_a*})

def $overlaps(typCase**, typCase**) : bool =

  clause 0 : (typCase_a*{typCase_a <- typCase_a*}*{typCase_a* <- typCase_a**}, typCase_b*{typCase_b <- typCase_b*}*{typCase_b* <- typCase_b**}) = $forall_(b_share*{b_share <- b_share*})
  -- (if (b_share = $shares_case(typCase_a*{typCase_a <- typCase_a*}, typCase_b*{typCase_b <- typCase_b*})))*{b_share <- b_share*, typCase_a* <- typCase_a**, typCase_b* <- typCase_b**}

def $is_exclusive(typCase***) : bool =

  clause 0 : ([]) = true

  clause 1 : (typCase_h*{typCase_h <- typCase_h*}*{typCase_h* <- typCase_h**} :: typCase_t*{typCase_t <- typCase_t*}*{typCase_t* <- typCase_t**}*{typCase_t** <- typCase_t***}) = (~$exists_(b_overlap*{b_overlap <- b_overlap*}) /\ $is_exclusive(typCase_t*{typCase_t <- typCase_t*}*{typCase_t* <- typCase_t**}*{typCase_t** <- typCase_t***}))
  -- (if (b_overlap = $overlaps(typCase_h*{typCase_h <- typCase_h*}*{typCase_h* <- typCase_h**}, typCase_t*{typCase_t <- typCase_t*}*{typCase_t* <- typCase_t**})))*{b_overlap <- b_overlap*, typCase_t** <- typCase_t***}

def $prepend_each(typCase, typCase**) : typCase** =

  clause 0 : (typCase, typCase_rest*{typCase_rest <- typCase_rest*}*{typCase_rest* <- typCase_rest**}) = typCase :: typCase_rest*{typCase_rest <- typCase_rest*}*{typCase_rest* <- typCase_rest**}

def $combinations(typCase**) : typCase** =

  clause 0 : ([]) = [[]]

  clause 1 : (typCase_h*{typCase_h <- typCase_h*} :: typCase_t*{typCase_t <- typCase_t*}*{typCase_t* <- typCase_t**}) = $concat_<typCase*>(typCase_comb*{typCase_comb <- typCase_comb*}*{typCase_comb* <- typCase_comb**}*{typCase_comb** <- typCase_comb***})
  -- if (typCase_rest*{typCase_rest <- typCase_rest*}*{typCase_rest* <- typCase_rest**} = $combinations(typCase_t*{typCase_t <- typCase_t*}*{typCase_t* <- typCase_t**}))
  -- (if (typCase_comb*{typCase_comb <- typCase_comb*}*{typCase_comb* <- typCase_comb**} = $prepend_each(typCase_h, typCase_rest*{typCase_rest <- typCase_rest*}*{typCase_rest* <- typCase_rest**})))*{typCase_comb** <- typCase_comb***, typCase_h <- typCase_h*}

def $is_covered(typCase***, typCase*) : bool =

  clause 0 : (typCase_row*{typCase_row <- typCase_row*}*{typCase_row* <- typCase_row**}*{typCase_row** <- typCase_row***}, typCase*{typCase <- typCase*}) = $exists_(b_cover*{b_cover <- b_cover*})
  -- (if (b_cover = $forall_(typCase <- typCase_row*{typCase_row <- typCase_row*}*{typCase <- typCase*, typCase_row* <- typCase_row**})))*{b_cover <- b_cover*, typCase_row** <- typCase_row***}

def $exp_len(typedExp) : typedExp =

  clause 0 : (typedExp) = LEN typedExp as exp '#' NAT as typ

def $exp_none(typedExp) : typedExp =

  clause 0 : (typedExp) = CMP EQ as cmpOp typedExp typedExp_none as exp '#' BOOL as typ
  -- if (_exp '#' typ = typedExp)
  -- if (optExp_none = OPT ?())
  -- if (typedExp_none = optExp_none as exp '#' typ)

def $exp_zero(tdenv, typ) : typedExp =

  clause 0 : (tdenv, typ) = NAT 0 as exp '#' NAT as typ
  -- if (OK NAT as typ as typRes = $expand_typ(tdenv, typ))

  clause 1 : (tdenv, typ) = INT 0 as int as exp '#' INT as typ
  -- if (OK INT as typ as typRes = $expand_typ(tdenv, typ))

def $sidecond_cmp(cmpOp, typedExp, typedExp) : premAL =

  clause 0 : (cmpOp, typedExp_l, typedExp_r) = IF typedExp_cmp as premAL
  -- if (cmpOpExp = CMP cmpOp typedExp_l typedExp_r)
  -- if (typedExp_cmp = cmpOpExp as exp '#' BOOL as typ)

def $sidecond_iter(iter, vari, vari) : premAL =

  clause 0 : (STAR, vari_a, vari_b) = $sidecond_cmp(EQ as cmpOp, typedExp_a_len, typedExp_b_len)
  -- if (typedExp_a = $exp_of_vari($iterate_vari(vari_a, [STAR])))
  -- if (typedExp_a_len = $exp_len(typedExp_a))
  -- if (typedExp_b = $exp_of_vari($iterate_vari(vari_b, [STAR])))
  -- if (typedExp_b_len = $exp_len(typedExp_b))

  clause 1 : (QUEST, vari_a, vari_b) = IF typedExp as premAL
  -- if (typedExp_a = $exp_of_vari($iterate_vari(vari_a, [QUEST])))
  -- if (typedExp_a_none = $exp_none(typedExp_a))
  -- if (typedExp_b = $exp_of_vari($iterate_vari(vari_b, [QUEST])))
  -- if (typedExp_b_none = $exp_none(typedExp_b))
  -- if (binOpExp = BIN EQUIV as binOp typedExp_a_none typedExp_b_none)
  -- if (typedExp = binOpExp as exp '#' BOOL as typ)

def $sideconds_iter(iter, vari*) : premAL* =

  clause 0 : (_iter, []) = []

  clause 1 : (_iter, [_vari]) = []

  clause 2 : (iter, vari_a :: vari_b :: vari_t*{vari_t <- vari_t*}) = premAL_ab :: premAL_t*{premAL_t <- premAL_t*}
  -- if (premAL_ab = $sidecond_iter(iter, vari_a, vari_b))
  -- if (premAL_t*{premAL_t <- premAL_t*} = $sideconds_iter(iter, vari_b :: vari_t*{vari_t <- vari_t*}))

def $access_exp(typedExp, typedPath) : typedExp =

  clause 0 : (typedExp_b, rootPath as path '#' _typ) = typedExp_b

  clause 1 : (typedExp_b, idxPath as path '#' typ) = idxAccExp as exp '#' typ
  -- if (IDX typedPath typedExp_i = idxPath)
  -- if (typedExp_p = $access_exp(typedExp_b, typedPath))
  -- if (idxAccExp = IDX typedExp_p typedExp_i)

  clause 2 : (typedExp_b, slicePath as path '#' typ) = sliceAccExp as exp '#' typ
  -- if (SLICE typedPath typedExp_i typedExp_n = slicePath)
  -- if (typedExp_p = $access_exp(typedExp_b, typedPath))
  -- if (sliceAccExp = SLICE typedExp_p typedExp_i typedExp_n)

  clause 3 : (typedExp_b, dotPath as path '#' typ) = dotAccExp as exp '#' typ
  -- if (DOT typedPath atom = dotPath)
  -- if (typedExp_p = $access_exp(typedExp_b, typedPath))
  -- if (dotAccExp = DOT typedExp_p atom)

def $sideconds_replace(tdenv, typedPath, typedExp) : premAL* =

  clause 0 : (tdenv, slicePath as path '#' _typ, typedExp_f) = [premAL_len]
  -- if (SLICE _typedPath _typedExp typedExp_n = slicePath)
  -- if (typedExp_len = $exp_len(typedExp_f))
  -- if (premAL_len = $sidecond_cmp(EQ as cmpOp, typedExp_len, typedExp_n))

  clause 1 : (tdenv, idxPath as path '#' _typ, typedExp_f) = [premAL_len]
  -- if (IDX _path '#' typ_b _typedExp = idxPath)
  -- if (OK TEXT as typ as typRes = $expand_typ(tdenv, typ_b))
  -- if (typedExp_len = $exp_len(typedExp_f))
  -- if (premAL_len = $sidecond_cmp(EQ as cmpOp, typedExp_len, NAT 1 as exp '#' NAT as typ))

  clause -1 : (_tdenv, _typedPath, _typedExp) = []

syntax varr =
   | id iter* (from varr)

syntax venv = map<varr, val>

syntax renv = map<id, relDefnAL>

syntax fenv = map<id, funcDefnAL>

syntax fnenv = map<id, id>

syntax globalLayer = {TYP tdenv, REL renv, FUNC fenv}

syntax localLayer = {TYP tdenv, FUNC fnenv, VAL venv}

def $empty_globalLayer : globalLayer =

  clause 0 :  = {TYP $empty_map<id, typDef>, REL $empty_map<id, relDefnAL>, FUNC $empty_map<id, funcDefnAL>}

def $empty_localLayer : localLayer =

  clause 0 :  = {TYP $empty_map<id, typDef>, FUNC $empty_map<id, id>, VAL $empty_map<varr, val>}

syntax ctx = {GLOBAL globalLayer, LOCAL localLayer}

def $empty_ctx : ctx =

  clause 0 :  = {GLOBAL $empty_globalLayer, LOCAL $empty_localLayer}

var C : ctx

def $load_ctx(ctx, specAL) : ctx =

  clause 0 : (C, externTypDefn as defnAL :: defnAL_t*{defnAL_t <- defnAL_t*}) = $load_ctx(C_load, defnAL_t*{defnAL_t <- defnAL_t*})
  -- if (EXTTYP id = externTypDefn)
  -- if (tdenv_update = $add_map<id, typDef>(C.GLOBAL.TYP, id, externTypDefn as typDef))
  -- if (C_load = C[GLOBAL.TYP = tdenv_update])

  clause 1 : (C, definedTypDefn as defnAL :: defnAL_t*{defnAL_t <- defnAL_t*}) = $load_ctx(C_load, defnAL_t*{defnAL_t <- defnAL_t*})
  -- if (TYP id _tparam*{_tparam <- _tparam*} '=' _deftyp = definedTypDefn)
  -- if (tdenv_update = $add_map<id, typDef>(C.GLOBAL.TYP, id, definedTypDefn as typDef))
  -- if (C_load = C[GLOBAL.TYP = tdenv_update])

  clause 2 : (C, externRelDefnAL as defnAL :: defnAL_t*{defnAL_t <- defnAL_t*}) = $load_ctx(C_load, defnAL_t*{defnAL_t <- defnAL_t*})
  -- if (EXTREL id ':' _typ*{_typ <- _typ*} '->' _typ'*{_typ' <- _typ'*} = externRelDefnAL)
  -- if (renv_update = $add_map<id, relDefnAL>(C.GLOBAL.REL, id, externRelDefnAL as relDefnAL))
  -- if (C_load = C[GLOBAL.REL = renv_update])

  clause 3 : (C, definedRelDefnAL as defnAL :: defnAL_t*{defnAL_t <- defnAL_t*}) = $load_ctx(C_load, defnAL_t*{defnAL_t <- defnAL_t*})
  -- if (REL id ':' _typ*{_typ <- _typ*} '->' _typ'*{_typ' <- _typ'*} '=' _rulGroupAL*{_rulGroupAL <- _rulGroupAL*} _elsGroupAL?{_elsGroupAL <- _elsGroupAL?} = definedRelDefnAL)
  -- if (renv_update = $add_map<id, relDefnAL>(C.GLOBAL.REL, id, definedRelDefnAL as relDefnAL))
  -- if (C_load = C[GLOBAL.REL = renv_update])

  clause 4 : (C, externFuncDefn as defnAL :: defnAL_t*{defnAL_t <- defnAL_t*}) = $load_ctx(C_load, defnAL_t*{defnAL_t <- defnAL_t*})
  -- if (EXTFUNC id _tparam*{_tparam <- _tparam*} _param*{_param <- _param*} ':' _typ = externFuncDefn)
  -- if (fenv_update = $add_map<id, funcDefnAL>(C.GLOBAL.FUNC, id, externFuncDefn as funcDefnAL))
  -- if (C_load = C[GLOBAL.FUNC = fenv_update])

  clause 5 : (C, builtinFuncDefn as defnAL :: defnAL_t*{defnAL_t <- defnAL_t*}) = $load_ctx(C_load, defnAL_t*{defnAL_t <- defnAL_t*})
  -- if (BUILTINFUNC id _tparam*{_tparam <- _tparam*} _param*{_param <- _param*} ':' _typ = builtinFuncDefn)
  -- if (fenv_update = $add_map<id, funcDefnAL>(C.GLOBAL.FUNC, id, builtinFuncDefn as funcDefnAL))
  -- if (C_load = C[GLOBAL.FUNC = fenv_update])

  clause 6 : (C, tableFuncDefnAL as defnAL :: defnAL_t*{defnAL_t <- defnAL_t*}) = $load_ctx(C_load, defnAL_t*{defnAL_t <- defnAL_t*})
  -- if (TABLEFUNC id _param*{_param <- _param*} ':' _typ '=' _tblRowAL*{_tblRowAL <- _tblRowAL*} = tableFuncDefnAL)
  -- if (fenv_update = $add_map<id, funcDefnAL>(C.GLOBAL.FUNC, id, tableFuncDefnAL as funcDefnAL))
  -- if (C_load = C[GLOBAL.FUNC = fenv_update])

  clause 7 : (C, definedFuncDefnAL as defnAL :: defnAL_t*{defnAL_t <- defnAL_t*}) = $load_ctx(C_load, defnAL_t*{defnAL_t <- defnAL_t*})
  -- if (FUNC id _tparam*{_tparam <- _tparam*} _param*{_param <- _param*} ':' _typ '=' _clauseAL*{_clauseAL <- _clauseAL*} _elsClauseAL?{_elsClauseAL <- _elsClauseAL?} = definedFuncDefnAL)
  -- if (fenv_update = $add_map<id, funcDefnAL>(C.GLOBAL.FUNC, id, definedFuncDefnAL as funcDefnAL))
  -- if (C_load = C[GLOBAL.FUNC = fenv_update])

  clause 8 : (C, []) = C

def $add_varr(ctx, varr, val) : ctx =

  clause 0 : (C, varr, val) = C[LOCAL.VAL = venv_update]
  -- if (venv_update = $add_map<varr, val>(C.LOCAL.VAL, varr, val))

def $add_varis(ctx, vari*, val*) : ctx =

  clause 0 : (C, vari*{vari <- vari*}, val*{val <- val*}) = C[LOCAL.VAL = venv_update]
  -- (if (id _typ iter*{iter <- iter*} = vari))*{_typ <- _typ*, id <- id*, iter* <- iter**, vari <- vari*}
  -- if (venv_update = $adds_map<varr, val>(C.LOCAL.VAL, id iter*{iter <- iter*}*{id <- id*, iter* <- iter**}, val*{val <- val*}))

def $add_func(ctx, id, id) : ctx =

  clause 0 : (C, id, id_global) = C[LOCAL.FUNC = fnenv_update]
  -- if (fnenv_update = $add_map<id, id>(C.LOCAL.FUNC, id, id_global))

def $find_vari(ctx, vari) : val? =

  clause 0 : (C, vari) = ?(val)
  -- if (id _typ iter*{iter <- iter*} = vari)
  -- if (?(val) = $find_map<varr, val>(C.LOCAL.VAL, id iter*{iter <- iter*}))

  clause -1 : (C, vari) = ?()

def $find_varr(ctx, varr) : val? =

  clause 0 : (C, varr) = $find_map<varr, val>(C.LOCAL.VAL, varr)

def $find_varis(ctx, vari*) : val*? =

  clause 0 : (C, vari*{vari <- vari*}) = ?(val*{val <- val*})
  -- (if (?(val) = $find_vari(C, vari)))*{val <- val*, vari <- vari*}

  clause -1 : (C, vari*{vari <- vari*}) = ?()

def $finds_vari(ctx*, vari) : val*? =

  clause 0 : (C*{C <- C*}, vari) = ?(val*{val <- val*})
  -- if (id _typ iter*{iter <- iter*} = vari)
  -- (if (?(val) = $find_map<varr, val>(C.LOCAL.VAL, id iter*{iter <- iter*})))*{C <- C*, val <- val*}

  clause -1 : (C*{C <- C*}, vari) = ?()

def $is_iter_on_var(typedExp) : varr? =

  clause 0 : (VAR id as exp '#' _typ) = ?(id [])

  clause 1 : (ITER typedExp expIter as exp '#' _typ) = ?(id iter*{iter <- iter*} ++ [iter_outer])
  -- if (?(id iter*{iter <- iter*}) = $is_iter_on_var(typedExp))
  -- if (iter_outer [id _typ' iter*{iter <- iter*}] = expIter)

  clause -1 : (_typedExp) = ?()

def $find_typ(ctx, id) : typDef? =

  clause 0 : (C, id) = ?(typDef)
  -- if (?(typDef) = $find_map<id, typDef>(C.LOCAL.TYP, id))

  clause 1 : (C, id) = $find_map<id, typDef>(C.GLOBAL.TYP, id)
  -- if (?() = $find_map<id, typDef>(C.LOCAL.TYP, id))

def $find_func_param(ctx, id) : id? =

  clause 0 : (C, id) = $find_map<id, id>(C.LOCAL.FUNC, id)

def $resolve_func_param(ctx, id) : id =

  clause 0 : (C, id) = $deopt_<id>($find_func_param(C, id), id)

def $find_func(ctx, id) : funcDefnAL? =

  clause 0 : (C, id) = $find_map<id, funcDefnAL>(C.GLOBAL.FUNC, id)

def $find_rel(ctx, id) : relDefnAL? =

  clause 0 : (C, id) = $find_map<id, relDefnAL>(C.GLOBAL.REL, id)

syntax subOptRes =
   | OK ctx? (from ok<ctx?>)
   | ERROR (from error)

def $sub_opt(ctx, vari*) : subOptRes =

  clause 0 : (C, []) = ERROR as subOptRes

  clause 1 : (C, vari*{vari <- vari*}) = OK ?(C_sub) as subOptRes
  -- if (vari*{vari <- vari*} =/= [])
  -- (if (vari_iter = $iterate_vari(vari, [QUEST])))*{vari <- vari*, vari_iter <- vari_iter*}
  -- (if (?(OPT ?(val)) = $find_vari(C, vari_iter)))*{val <- val*, vari_iter <- vari_iter*}
  -- if (C_sub = $add_varis(C, vari*{vari <- vari*}, val*{val <- val*}))

  clause 2 : (C, vari*{vari <- vari*}) = OK ?() as subOptRes
  -- if (vari*{vari <- vari*} =/= [])
  -- (if (vari_iter = $iterate_vari(vari, [QUEST])))*{vari <- vari*, vari_iter <- vari_iter*}
  -- (if (?(OPT ?()) = $find_vari(C, vari_iter)))*{vari_iter <- vari_iter*}

  clause -1 : (C, vari*{vari <- vari*}) = ERROR as subOptRes

syntax subListRes =
   | OK ctx* (from ok<ctx*>)
   | ERROR (from error)

def $sub_list(ctx, vari*) : subListRes =

  clause 0 : (C, vari*{vari <- vari*}) = OK C_sub*{C_sub <- C_sub*} as subListRes
  -- (if (vari_iter = $iterate_vari(vari, [STAR])))*{vari <- vari*, vari_iter <- vari_iter*}
  -- (if (?(LIST val*{val <- val*}) = $find_vari(C, vari_iter)))*{val* <- val**, vari_iter <- vari_iter*}
  -- if $forall_((|val*{val <- val*}| = |val*{val <- val*}*{val* <- val**}[0]|)*{val* <- val**})
  -- if (val_trans*{val_trans <- val_trans*}*{val_trans* <- val_trans**} = $transpose_<val>(val*{val <- val*}*{val* <- val**}))
  -- (if (C_sub = $add_varis(C, vari*{vari <- vari*}, val_trans*{val_trans <- val_trans*})))*{C_sub <- C_sub*, val_trans* <- val_trans**}

  clause -1 : (C, vari*{vari <- vari*}) = ERROR as subListRes

syntax funcRes =
   | OK val (from ok<val>)
   | ERROR (from error)
   | UNMATCH (from unmatch)

extern relation Call_extern_func: |- id `< typ* `> `( val* `) : funcRes

extern relation Call_builtin_func: |- id `< typ* `> `( val* `) : funcRes

syntax relRes =
   | OK val* (from ok<val*>)
   | ERROR (from error)
   | UNMATCH (from unmatch)

extern relation Call_extern_rel: |- id `( val* `) : relRes

syntax expRes =
   | OK val (from ok<val>)
   | ERROR (from error)
   | UNMATCH (from unmatch)

relation Eval_exp: ctx |- typedExp : expRes

  rulegroup literal

    rule boolean: C |- BOOL b as exp '#' _typ : OK BOOL b as expRes

    rule number: C |- num as exp '#' _typ : OK num as val as expRes

    rule string: C |- TEXT t as exp '#' _typ : OK TEXT t as expRes

  rulegroup variable

    rule variable: C |- VAR id as exp '#' _typ : OK val as expRes
    -- if (?(val) = $find_varr(C, id []))

  rulegroup unary

    rule boolean-operand-failure: C |- UN NOT as unOp typedExp as exp '#' _typ : failure as expRes
    -- Eval_exp: C |- typedExp : failure as expRes

    rule boolean-succ: C |- UN NOT as unOp typedExp as exp '#' _typ : OK BOOL b_res as expRes
    -- Eval_exp: C |- typedExp : OK BOOL b as expRes
    -- if (b_res = ~b)

    rule number-operand-failure: C |- UN numUnOp as unOp typedExp as exp '#' _typ : failure as expRes
    -- Eval_exp: C |- typedExp : failure as expRes

    rule number-succ: C |- UN numUnOp as unOp typedExp as exp '#' _typ : OK val_res as expRes
    -- Eval_exp: C |- typedExp : OK num as val as expRes
    -- if (val_res = $numUnOp(numUnOp, num))

  rulegroup binary

    rule boolean-left-failure: C |- BIN boolBinOp as binOp typedExp_l typedExp_r as exp '#' _typ : failure as expRes
    -- Eval_exp: C |- typedExp_l : failure as expRes

    rule boolean-right-failure: C |- BIN boolBinOp as binOp typedExp_l typedExp_r as exp '#' _typ : failure as expRes
    -- Eval_exp: C |- typedExp_l : OK BOOL b_l as expRes
    -- Eval_exp: C |- typedExp_r : failure as expRes

    rule boolean-succ: C |- BIN boolBinOp as binOp typedExp_l typedExp_r as exp '#' _typ : OK BOOL b_res as expRes
    -- Eval_exp: C |- typedExp_l : OK BOOL b_l as expRes
    -- Eval_exp: C |- typedExp_r : OK BOOL b_r as expRes
    -- if (b_res = $boolBinOp(boolBinOp, b_l, b_r))

    rule number-left-failure: C |- BIN numBinOp as binOp typedExp_l typedExp_r as exp '#' _typ : failure as expRes
    -- Eval_exp: C |- typedExp_l : failure as expRes

    rule number-right-failure: C |- BIN numBinOp as binOp typedExp_l typedExp_r as exp '#' _typ : failure as expRes
    -- Eval_exp: C |- typedExp_l : OK num_l as val as expRes
    -- Eval_exp: C |- typedExp_r : failure as expRes

    rule number-succ: C |- BIN numBinOp as binOp typedExp_l typedExp_r as exp '#' _typ : numBinOpRes as expRes
    -- Eval_exp: C |- typedExp_l : OK num_l as val as expRes
    -- Eval_exp: C |- typedExp_r : OK num_r as val as expRes
    -- if (numBinOpRes = $numBinOp(numBinOp, num_l, num_r))

  rulegroup compare

    rule poly-left-failure: C |- CMP polyCmpOp as cmpOp typedExp_l typedExp_r as exp '#' _typ : failure as expRes
    -- Eval_exp: C |- typedExp_l : failure as expRes

    rule poly-right-failure: C |- CMP polyCmpOp as cmpOp typedExp_l typedExp_r as exp '#' _typ : failure as expRes
    -- Eval_exp: C |- typedExp_l : OK val_l as expRes
    -- Eval_exp: C |- typedExp_r : failure as expRes

    rule poly-succ: C |- CMP polyCmpOp as cmpOp typedExp_l typedExp_r as exp '#' _typ : OK BOOL b_res as expRes
    -- Eval_exp: C |- typedExp_l : OK val_l as expRes
    -- Eval_exp: C |- typedExp_r : OK val_r as expRes
    -- if (b_res = $polyCmpOp(polyCmpOp, val_l, val_r))

    rule number-left-failure: C |- CMP numCmpOp as cmpOp typedExp_l typedExp_r as exp '#' _typ : failure as expRes
    -- Eval_exp: C |- typedExp_l : failure as expRes

    rule number-right-failure: C |- CMP numCmpOp as cmpOp typedExp_l typedExp_r as exp '#' _typ : failure as expRes
    -- Eval_exp: C |- typedExp_l : OK num_l as val as expRes
    -- Eval_exp: C |- typedExp_r : failure as expRes

    rule number-succ: C |- CMP numCmpOp as cmpOp typedExp_l typedExp_r as exp '#' _typ : OK BOOL b_res as expRes
    -- Eval_exp: C |- typedExp_l : OK num_l as val as expRes
    -- Eval_exp: C |- typedExp_r : OK num_r as val as expRes
    -- if (OK b_res as numCmpRes = $numCmpOp(numCmpOp, num_l, num_r))

  rulegroup upcast

    rule operand-failure: C |- UPCAST typ typedExp as exp '#' _typ : failure as expRes
    -- Eval_exp: C |- typedExp : failure as expRes

    rule succ: C |- UPCAST typ typedExp as exp '#' _typ : castRes as expRes
    -- Eval_exp: C |- typedExp : OK val as expRes
    -- if (castRes = $upcast(C, typ, val))

  rulegroup downcast

    rule operand-failure: C |- DOWNCAST typ typedExp as exp '#' _typ : failure as expRes
    -- Eval_exp: C |- typedExp : failure as expRes

    rule succ: C |- DOWNCAST typ typedExp as exp '#' _typ : castRes as expRes
    -- Eval_exp: C |- typedExp : OK val as expRes
    -- if (castRes = $downcast(C, typ, val))

  rulegroup subtype

    rule operand-failure: C |- SUB typedExp typ as exp '#' _typ : failure as expRes
    -- Eval_exp: C |- typedExp : failure as expRes

    rule succ: C |- SUB typedExp typ as exp '#' _typ : OK BOOL b as expRes
    -- Eval_exp: C |- typedExp : OK val as expRes
    -- if (`{ id_local ':' typDef_local*{id_local <- id_local*, typDef_local <- typDef_local*} `} = C.LOCAL.TYP)
    -- if (tdenv = $adds_map<id, typDef>(C.GLOBAL.TYP, id_local*{id_local <- id_local*}, typDef_local*{typDef_local <- typDef_local*}))
    -- if (OK b as subtypRes = $subtyp(C.GLOBAL.FUNC, tdenv, typ, val))

  rulegroup match

    rule operand-failure: C |- MATCH typedExp pat as exp '#' _typ : failure as expRes
    -- Eval_exp: C |- typedExp : failure as expRes

    rule succ: C |- MATCH typedExp pat as exp '#' _typ : OK BOOL b_matches as expRes
    -- Eval_exp: C |- typedExp : OK val as expRes
    -- if (b_matches = $matches(val, pat))

  rulegroup tuple

    rule expressions-failure: C |- TUP typedExp*{typedExp <- typedExp*} as exp '#' _typ : failure as expRes
    -- Eval_exps: C |- typedExp*{typedExp <- typedExp*} : failure as expsRes

    rule succ: C |- TUP typedExp*{typedExp <- typedExp*} as exp '#' _typ : OK TUP val*{val <- val*} as expRes
    -- Eval_exps: C |- typedExp*{typedExp <- typedExp*} : OK val*{val <- val*} as expsRes

  rulegroup case

    rule expressions-failure: C |- INJ mixop typedExp*{typedExp <- typedExp*} as exp '#' _typ : failure as expRes
    -- Eval_exps: C |- typedExp*{typedExp <- typedExp*} : failure as expsRes

    rule succ: C |- INJ mixop typedExp*{typedExp <- typedExp*} as exp '#' _typ : OK INJ mixop val*{val <- val*} as expRes
    -- Eval_exps: C |- typedExp*{typedExp <- typedExp*} : OK val*{val <- val*} as expsRes

  rulegroup struct

    rule expressions-failure: C |- STR expField*{expField <- expField*} as exp '#' _typ : failure as expRes
    -- (if (atom typedExp = expField))*{atom <- atom*, expField <- expField*, typedExp <- typedExp*}
    -- Eval_exps: C |- typedExp*{typedExp <- typedExp*} : failure as expsRes

    rule succ: C |- STR expField*{expField <- expField*} as exp '#' _typ : OK STR valField*{valField <- valField*} as expRes
    -- (if (atom typedExp = expField))*{atom <- atom*, expField <- expField*, typedExp <- typedExp*}
    -- Eval_exps: C |- typedExp*{typedExp <- typedExp*} : OK val*{val <- val*} as expsRes
    -- (if (valField = atom val))*{atom <- atom*, val <- val*, valField <- valField*}

  rulegroup opt

    rule succ-none: C |- OPT ?() as exp '#' _typ : OK OPT ?() as expRes

    rule operand-failure: C |- OPT ?(typedExp) as exp '#' _typ : failure as expRes
    -- Eval_exp: C |- typedExp : failure as expRes

    rule succ-some: C |- OPT ?(typedExp) as exp '#' _typ : OK OPT ?(val) as expRes
    -- Eval_exp: C |- typedExp : OK val as expRes

  rulegroup list

    rule expressions-failure: C |- LIST typedExp*{typedExp <- typedExp*} as exp '#' _typ : failure as expRes
    -- Eval_exps: C |- typedExp*{typedExp <- typedExp*} : failure as expsRes

    rule succ: C |- LIST typedExp*{typedExp <- typedExp*} as exp '#' _typ : OK LIST val*{val <- val*} as expRes
    -- Eval_exps: C |- typedExp*{typedExp <- typedExp*} : OK val*{val <- val*} as expsRes

  rulegroup cons

    rule head-failure: C |- CONS typedExp_h typedExp_t as exp '#' _typ : failure as expRes
    -- Eval_exp: C |- typedExp_h : failure as expRes

    rule tail-failure: C |- CONS typedExp_h typedExp_t as exp '#' _typ : failure as expRes
    -- Eval_exp: C |- typedExp_h : OK val_h as expRes
    -- Eval_exp: C |- typedExp_t : failure as expRes

    rule succ: C |- CONS typedExp_h typedExp_t as exp '#' _typ : OK LIST val_h :: val_t*{val_t <- val_t*} as expRes
    -- Eval_exp: C |- typedExp_h : OK val_h as expRes
    -- Eval_exp: C |- typedExp_t : OK LIST val_t*{val_t <- val_t*} as expRes

  rulegroup concat

    rule left-failure: C |- CAT typedExp_l typedExp_r as exp '#' _typ : failure as expRes
    -- Eval_exp: C |- typedExp_l : failure as expRes

    rule list-right-failure: C |- CAT typedExp_l typedExp_r as exp '#' _typ : failure as expRes
    -- Eval_exp: C |- typedExp_l : OK LIST val_l*{val_l <- val_l*} as expRes
    -- Eval_exp: C |- typedExp_r : failure as expRes

    rule list-succ: C |- CAT typedExp_l typedExp_r as exp '#' _typ : OK LIST val_res*{val_res <- val_res*} as expRes
    -- Eval_exp: C |- typedExp_l : OK LIST val_l*{val_l <- val_l*} as expRes
    -- Eval_exp: C |- typedExp_r : OK LIST val_r*{val_r <- val_r*} as expRes
    -- if (val_res*{val_res <- val_res*} = val_l*{val_l <- val_l*} ++ val_r*{val_r <- val_r*})

    rule text-right-failure: C |- CAT typedExp_l typedExp_r as exp '#' _typ : failure as expRes
    -- Eval_exp: C |- typedExp_l : OK TEXT text_l as expRes
    -- Eval_exp: C |- typedExp_r : failure as expRes

    rule text-succ: C |- CAT typedExp_l typedExp_r as exp '#' _typ : OK TEXT t_res as expRes
    -- Eval_exp: C |- typedExp_l : OK TEXT t_l as expRes
    -- Eval_exp: C |- typedExp_r : OK TEXT t_r as expRes
    -- if (t_res = t_l ++ t_r)

  rulegroup mem

    rule elem-failure: C |- MEM typedExp_e typedExp_s as exp '#' _typ : failure as expRes
    -- Eval_exp: C |- typedExp_e : failure as expRes

    rule list-failure: C |- MEM typedExp_e typedExp_s as exp '#' _typ : failure as expRes
    -- Eval_exp: C |- typedExp_e : OK val_e as expRes
    -- Eval_exp: C |- typedExp_s : failure as expRes

    rule succ: C |- MEM typedExp_e typedExp_s as exp '#' _typ : OK BOOL b_mem as expRes
    -- Eval_exp: C |- typedExp_e : OK val_e as expRes
    -- Eval_exp: C |- typedExp_s : OK LIST val*{val <- val*} as expRes
    -- if (b_mem = $exists_((val_e = val)*{val <- val*}))

  rulegroup len

    rule operand-failure: C |- LEN typedExp as exp '#' _typ : failure as expRes
    -- Eval_exp: C |- typedExp : failure as expRes

    rule text: C |- LEN typedExp as exp '#' _typ : OK NAT n as val as expRes
    -- Eval_exp: C |- typedExp : OK TEXT t as expRes
    -- if (n = |t|)

    rule list: C |- LEN typedExp as exp '#' _typ : OK NAT n as val as expRes
    -- Eval_exp: C |- typedExp : OK LIST val*{val <- val*} as expRes
    -- if (n = |val*{val <- val*}|)

  rulegroup dot

    rule operand-failure: C |- DOT typedExp atom as exp '#' _typ : failure as expRes
    -- Eval_exp: C |- typedExp : failure as expRes

    rule succ: C |- DOT typedExp atom as exp '#' typ : pathRes as expRes
    -- Eval_exp: C |- typedExp : OK val as expRes
    -- if (_exp '#' typ_b = typedExp)
    -- if (typedPath = DOT ROOT as path '#' typ_b atom as path '#' typ)
    -- Eval_path_acc: C |- val typedPath : pathRes

  rulegroup idx

    rule base-failure: C |- IDX typedExp_b typedExp_i as exp '#' _typ : failure as expRes
    -- Eval_exp: C |- typedExp_b : failure as expRes

    rule succ: C |- IDX typedExp_b typedExp_i as exp '#' typ : pathRes as expRes
    -- Eval_exp: C |- typedExp_b : OK val_b as expRes
    -- if (_exp '#' typ_b = typedExp_b)
    -- if (typedPath = IDX ROOT as path '#' typ_b typedExp_i as path '#' typ)
    -- Eval_path_acc: C |- val_b typedPath : pathRes

  rulegroup slice

    rule base-failure: C |- SLICE typedExp_b typedExp_i typedExp_n as exp '#' _typ : failure as expRes
    -- Eval_exp: C |- typedExp_b : failure as expRes

    rule succ: C |- SLICE typedExp_b typedExp_i typedExp_n as exp '#' typ : pathRes as expRes
    -- Eval_exp: C |- typedExp_b : OK val_b as expRes
    -- if (_exp '#' typ_b = typedExp_b)
    -- if (typedPath = SLICE ROOT as path '#' typ_b typedExp_i typedExp_n as path '#' typ)
    -- Eval_path_acc: C |- val_b typedPath : pathRes

  rulegroup upd

    rule base-failure: C |- UPD typedExp_b typedPath typedExp_f as exp '#' _typ : failure as expRes
    -- Eval_exp: C |- typedExp_b : failure as expRes

    rule value-failure: C |- UPD typedExp_b typedPath typedExp_f as exp '#' _typ : failure as expRes
    -- Eval_exp: C |- typedExp_b : OK val_b as expRes
    -- Eval_exp: C |- typedExp_f : failure as expRes

    rule succ: C |- UPD typedExp_b typedPath typedExp_f as exp '#' _typ : pathRes as expRes
    -- Eval_exp: C |- typedExp_b : OK val_b as expRes
    -- Eval_exp: C |- typedExp_f : OK val_f as expRes
    -- Eval_path_upd: C |- val_b typedPath := val_f : pathRes

  rulegroup call

    rule arguments-failure: C |- CALL id targ*{targ <- targ*} arg*{arg <- arg*} as exp '#' _typ : failure as expRes
    -- Eval_targs: C |- targ*{targ <- targ*} : OK typ_input*{typ_input <- typ_input*} as typsRes
    -- Eval_args: C |- arg*{arg <- arg*} : failure as argsRes

    rule succ: C |- CALL id targ*{targ <- targ*} arg*{arg <- arg*} as exp '#' _typ : funcRes as expRes
    -- Eval_targs: C |- targ*{targ <- targ*} : OK typ_input*{typ_input <- typ_input*} as typsRes
    -- Eval_args: C |- arg*{arg <- arg*} : OK val_input*{val_input <- val_input*} as argsRes
    -- Call_func: C |- id `< typ_input*{typ_input <- typ_input*} `> `( val_input*{val_input <- val_input*} `) : funcRes

  rulegroup iter

    rule simple: C |- iterExp as exp '#' typ : OK val as expRes
    -- if (?(varr) = $is_iter_on_var(iterExp as exp '#' typ))
    -- if (?(val) = $find_varr(C, varr))

    rule opt-body-failure: C |- iterExp as exp '#' typ : failure as expRes
    -- if (?() = $is_iter_on_var(iterExp as exp '#' typ))
    -- if (ITER typedExp QUEST vari*{vari <- vari*} = iterExp)
    -- if (OK C_sub?{C_sub <- C_sub?} as subOptRes = $sub_opt(C, vari*{vari <- vari*}))
    -- Eval_exp_maybe: C_sub?{C_sub <- C_sub?} |- typedExp : failure as expOptRes

    rule opt-succ: C |- iterExp as exp '#' typ : OK OPT val?{val <- val?} as expRes
    -- if (?() = $is_iter_on_var(iterExp as exp '#' typ))
    -- if (ITER typedExp QUEST vari*{vari <- vari*} = iterExp)
    -- if (OK C_sub?{C_sub <- C_sub?} as subOptRes = $sub_opt(C, vari*{vari <- vari*}))
    -- Eval_exp_maybe: C_sub?{C_sub <- C_sub?} |- typedExp : OK val?{val <- val?} as expOptRes

    rule list-body-failure: C |- iterExp as exp '#' typ : failure as expRes
    -- if (?() = $is_iter_on_var(iterExp as exp '#' typ))
    -- if (ITER typedExp STAR vari*{vari <- vari*} = iterExp)
    -- if (OK C_sub*{C_sub <- C_sub*} as subListRes = $sub_list(C, vari*{vari <- vari*}))
    -- Eval_exp_each: C_sub*{C_sub <- C_sub*} |- typedExp : failure as expsRes

    rule list-succ: C |- iterExp as exp '#' typ : OK LIST val*{val <- val*} as expRes
    -- if (?() = $is_iter_on_var(iterExp as exp '#' typ))
    -- if (ITER typedExp STAR vari*{vari <- vari*} = iterExp)
    -- if (OK C_sub*{C_sub <- C_sub*} as subListRes = $sub_list(C, vari*{vari <- vari*}))
    -- Eval_exp_each: C_sub*{C_sub <- C_sub*} |- typedExp : OK val*{val <- val*} as expsRes

  elsegroup

  rulegroup error

    rule error: C |- typedExp : ERROR as expRes

syntax expsRes =
   | OK val* (from ok<val*>)
   | ERROR (from error)
   | UNMATCH (from unmatch)

relation Eval_exps: ctx |- typedExp* : expsRes

  rulegroup

    rule nil: C |- [] : OK [] as expsRes

    rule head-failure: C |- typedExp_h :: typedExp_t*{typedExp_t <- typedExp_t*} : failure as expsRes
    -- Eval_exp: C |- typedExp_h : failure as expRes

    rule tail-failure: C |- typedExp_h :: typedExp_t*{typedExp_t <- typedExp_t*} : failure as expsRes
    -- Eval_exp: C |- typedExp_h : OK val_h as expRes
    -- Eval_exps: C |- typedExp_t*{typedExp_t <- typedExp_t*} : failure as expsRes

    rule cons-succ: C |- typedExp_h :: typedExp_t*{typedExp_t <- typedExp_t*} : OK val_h :: val_t*{val_t <- val_t*} as expsRes
    -- Eval_exp: C |- typedExp_h : OK val_h as expRes
    -- Eval_exps: C |- typedExp_t*{typedExp_t <- typedExp_t*} : OK val_t*{val_t <- val_t*} as expsRes

syntax expOptRes =
   | OK val? (from ok<val?>)
   | ERROR (from error)
   | UNMATCH (from unmatch)

relation Eval_exp_maybe: ctx? |- typedExp : expOptRes

  rulegroup

    rule none: ?() |- typedExp : OK ?() as expOptRes

    rule failure: ?(C) |- typedExp : failure as expOptRes
    -- Eval_exp: C |- typedExp : failure as expRes

    rule some: ?(C) |- typedExp : OK ?(val) as expOptRes
    -- Eval_exp: C |- typedExp : OK val as expRes

relation Eval_exp_each: ctx* |- typedExp : expsRes

  rulegroup

    rule nil: [] |- typedExp : OK [] as expsRes

    rule head-failure: C_h :: C_t*{C_t <- C_t*} |- typedExp : failure as expsRes
    -- Eval_exp: C_h |- typedExp : failure as expRes

    rule tail-failure: C_h :: C_t*{C_t <- C_t*} |- typedExp : failure as expsRes
    -- Eval_exp: C_h |- typedExp : OK val_h as expRes
    -- Eval_exp_each: C_t*{C_t <- C_t*} |- typedExp : failure as expsRes

    rule cons-succ: C_h :: C_t*{C_t <- C_t*} |- typedExp : OK val_h :: val_t*{val_t <- val_t*} as expsRes
    -- Eval_exp: C_h |- typedExp : OK val_h as expRes
    -- Eval_exp_each: C_t*{C_t <- C_t*} |- typedExp : OK val_t*{val_t <- val_t*} as expsRes

syntax pathRes =
   | OK val (from ok<val>)
   | ERROR (from error)
   | UNMATCH (from unmatch)

relation Eval_path_acc: ctx |- val typedPath : pathRes

  rulegroup root

    rule root: C |- val_b ROOT as path '#' _typ : OK val_b as pathRes

  rulegroup idx

    rule path-failure: C |- val_b IDX typedPath typedExp_i as path '#' _typ : failure as pathRes
    -- Eval_path_acc: C |- val_b typedPath : failure as pathRes

    rule list-index-failure: C |- val_b IDX typedPath typedExp_i as path '#' _typ : failure as pathRes
    -- Eval_path_acc: C |- val_b typedPath : OK LIST val*{val <- val*} as pathRes
    -- Eval_exp: C |- typedExp_i : failure as expRes

    rule list-succ: C |- val_b IDX typedPath typedExp_i as path '#' _typ : OK val_idx as pathRes
    -- Eval_path_acc: C |- val_b typedPath : OK LIST val*{val <- val*} as pathRes
    -- Eval_exp: C |- typedExp_i : OK NAT n as val as expRes
    -- if (val_idx = val*{val <- val*}[n])

    rule text-index-failure: C |- val_b IDX typedPath typedExp_i as path '#' _typ : failure as pathRes
    -- Eval_path_acc: C |- val_b typedPath : OK TEXT t as pathRes
    -- Eval_exp: C |- typedExp_i : failure as expRes

    rule text-succ: C |- val_b IDX typedPath typedExp_i as path '#' _typ : OK TEXT t_idx as pathRes
    -- Eval_path_acc: C |- val_b typedPath : OK TEXT t as pathRes
    -- Eval_exp: C |- typedExp_i : OK NAT n as val as expRes
    -- if (t_idx = t[n])

  rulegroup slice

    rule path-failure: C |- val_b SLICE typedPath typedExp_i typedExp_n as path '#' _typ : failure as pathRes
    -- Eval_path_acc: C |- val_b typedPath : failure as pathRes

    rule text-index-failure: C |- val_b SLICE typedPath typedExp_i typedExp_n as path '#' _typ : failure as pathRes
    -- Eval_path_acc: C |- val_b typedPath : OK TEXT t as pathRes
    -- Eval_exp: C |- typedExp_i : failure as expRes

    rule text-length-failure: C |- val_b SLICE typedPath typedExp_i typedExp_n as path '#' _typ : failure as pathRes
    -- Eval_path_acc: C |- val_b typedPath : OK TEXT t as pathRes
    -- Eval_exp: C |- typedExp_i : OK NAT n_i as val as expRes
    -- Eval_exp: C |- typedExp_n : failure as expRes

    rule text-succ: C |- val_b SLICE typedPath typedExp_i typedExp_n as path '#' _typ : OK val_slice as pathRes
    -- Eval_path_acc: C |- val_b typedPath : OK TEXT t as pathRes
    -- Eval_exp: C |- typedExp_i : OK NAT n_i as val as expRes
    -- Eval_exp: C |- typedExp_n : OK NAT n_n as val as expRes
    -- if (val_slice = TEXT t[n_i : n_n])

    rule list-index-failure: C |- val_b SLICE typedPath typedExp_i typedExp_n as path '#' _typ : failure as pathRes
    -- Eval_path_acc: C |- val_b typedPath : OK LIST val*{val <- val*} as pathRes
    -- Eval_exp: C |- typedExp_i : failure as expRes

    rule list-length-failure: C |- val_b SLICE typedPath typedExp_i typedExp_n as path '#' _typ : failure as pathRes
    -- Eval_path_acc: C |- val_b typedPath : OK LIST val*{val <- val*} as pathRes
    -- Eval_exp: C |- typedExp_i : OK NAT n_i as val as expRes
    -- Eval_exp: C |- typedExp_n : failure as expRes

    rule list-succ: C |- val_b SLICE typedPath typedExp_i typedExp_n as path '#' _typ : OK val_slice as pathRes
    -- Eval_path_acc: C |- val_b typedPath : OK LIST val*{val <- val*} as pathRes
    -- Eval_exp: C |- typedExp_i : OK NAT n_i as val as expRes
    -- Eval_exp: C |- typedExp_n : OK NAT n_n as val as expRes
    -- if (val_slice = LIST val*{val <- val*}[n_i : n_n])

  rulegroup dot

    rule path-failure: C |- val_b DOT typedPath atom as path '#' _typ : failure as pathRes
    -- Eval_path_acc: C |- val_b typedPath : failure as pathRes

    rule succ: C |- val_b DOT typedPath atom as path '#' _typ : OK val as pathRes
    -- Eval_path_acc: C |- val_b typedPath : OK STR valField*{valField <- valField*} as pathRes
    -- (if (atom_field val_field = valField))*{atom_field <- atom_field*, valField <- valField*, val_field <- val_field*}
    -- if (?(val) = $assoc_<atom, val>(atom, (atom_field, val_field)*{atom_field <- atom_field*, val_field <- val_field*}))

  elsegroup

  rulegroup error

    rule error: C |- val typedPath : ERROR as pathRes

relation Eval_path_upd: ctx |- val typedPath := val : pathRes

  rulegroup root

    rule root: C |- val_b ROOT as path '#' _typ := val_n : OK val_n as pathRes

  rulegroup idx

    rule path-failure: C |- val_b IDX typedPath typedExp_i as path '#' _typ := val_n : failure as pathRes
    -- Eval_path_acc: C |- val_b typedPath : failure as pathRes

    rule list-index-failure: C |- val_b IDX typedPath typedExp_i as path '#' _typ := val_n : failure as pathRes
    -- Eval_path_acc: C |- val_b typedPath : OK LIST val*{val <- val*} as pathRes
    -- Eval_exp: C |- typedExp_i : failure as expRes

    rule list-succ: C |- val_b IDX typedPath typedExp_i as path '#' _typ := val_n : pathRes
    -- Eval_path_acc: C |- val_b typedPath : OK LIST val*{val <- val*} as pathRes
    -- Eval_exp: C |- typedExp_i : OK NAT n_target as val as expRes
    -- if (val_upd = LIST val*{val <- val*}[[n_target] = val_n])
    -- Eval_path_upd: C |- val_b typedPath := val_upd : pathRes

    rule text-index-failure: C |- val_b IDX typedPath typedExp_i as path '#' _typ := val_n : failure as pathRes
    -- Eval_path_acc: C |- val_b typedPath : OK TEXT t as pathRes
    -- Eval_exp: C |- typedExp_i : failure as expRes

    rule text-succ: C |- val_b IDX typedPath typedExp_i as path '#' _typ := TEXT t_n : pathRes
    -- Eval_path_acc: C |- val_b typedPath : OK TEXT t as pathRes
    -- Eval_exp: C |- typedExp_i : OK NAT n_target as val as expRes
    -- if (val_upd = TEXT t[[n_target] = t_n])
    -- Eval_path_upd: C |- val_b typedPath := val_upd : pathRes

  rulegroup slice

    rule path-failure: C |- val_b SLICE typedPath typedExp_i typedExp_n as path '#' _typ := val_n : failure as pathRes
    -- Eval_path_acc: C |- val_b typedPath : failure as pathRes

    rule text-index-failure: C |- val_b SLICE typedPath typedExp_i typedExp_n as path '#' _typ := val_n : failure as pathRes
    -- Eval_path_acc: C |- val_b typedPath : OK TEXT t as pathRes
    -- Eval_exp: C |- typedExp_i : failure as expRes

    rule text-length-failure: C |- val_b SLICE typedPath typedExp_i typedExp_n as path '#' _typ := val_n : failure as pathRes
    -- Eval_path_acc: C |- val_b typedPath : OK TEXT t as pathRes
    -- Eval_exp: C |- typedExp_i : OK NAT n_i as val as expRes
    -- Eval_exp: C |- typedExp_n : failure as expRes

    rule text-succ: C |- val_b SLICE typedPath typedExp_i typedExp_n as path '#' _typ := TEXT t_n : pathRes
    -- Eval_path_acc: C |- val_b typedPath : OK TEXT t as pathRes
    -- Eval_exp: C |- typedExp_i : OK NAT n_i as val as expRes
    -- Eval_exp: C |- typedExp_n : OK NAT n_n as val as expRes
    -- if (val_upd = TEXT t[[n_i : n_n] = t_n])
    -- Eval_path_upd: C |- val_b typedPath := val_upd : pathRes

    rule list-index-failure: C |- val_b SLICE typedPath typedExp_i typedExp_n as path '#' _typ := val_n : failure as pathRes
    -- Eval_path_acc: C |- val_b typedPath : OK LIST val*{val <- val*} as pathRes
    -- Eval_exp: C |- typedExp_i : failure as expRes

    rule list-length-failure: C |- val_b SLICE typedPath typedExp_i typedExp_n as path '#' _typ := val_n : failure as pathRes
    -- Eval_path_acc: C |- val_b typedPath : OK LIST val*{val <- val*} as pathRes
    -- Eval_exp: C |- typedExp_i : OK NAT n_i as val as expRes
    -- Eval_exp: C |- typedExp_n : failure as expRes

    rule list-succ: C |- val_b SLICE typedPath typedExp_i typedExp_n as path '#' _typ := LIST val_n*{val_n <- val_n*} : pathRes
    -- Eval_path_acc: C |- val_b typedPath : OK LIST val*{val <- val*} as pathRes
    -- Eval_exp: C |- typedExp_i : OK NAT n_i as val as expRes
    -- Eval_exp: C |- typedExp_n : OK NAT n_n as val as expRes
    -- if (val_upd = LIST val*{val <- val*}[[n_i : n_n] = val_n*{val_n <- val_n*}])
    -- Eval_path_upd: C |- val_b typedPath := val_upd : pathRes

  rulegroup dot

    rule path-failure: C |- val_b DOT typedPath atom as path '#' _typ := val_n : failure as pathRes
    -- Eval_path_acc: C |- val_b typedPath : failure as pathRes

    rule succ: C |- val_b DOT typedPath atom as path '#' _typ := val_n : pathRes
    -- Eval_path_acc: C |- val_b typedPath : OK STR valField*{valField <- valField*} as pathRes
    -- (if (atom_field val_field = valField))*{atom_field <- atom_field*, valField <- valField*, val_field <- val_field*}
