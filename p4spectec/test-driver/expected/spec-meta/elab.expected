    -- Eval_path_upd: C |- val_b typedPath := val_upd : pathRes

  elsegroup

  rulegroup error

    rule error: C |- val_b typedPath := val_n : ERROR as pathRes

relation Eval_targs: ctx |- targ* : typsRes

