  rulegroup rel

    rule extern: AC |- externRelDefnAL as defnAL : externRelDefnAL as defnAL

    rule defined: AC |- definedRelDefnAL as defnAL : definedRelDefnAL_guard as defnAL
    -- if (REL id ':' typ_in*{typ_in <- typ_in*} '->' typ_out*{typ_out <- typ_out*} '=' rulGroupAL*{rulGroupAL <- rulGroupAL*} elsGroupAL?{elsGroupAL <- elsGroupAL?} = definedRelDefnAL)
