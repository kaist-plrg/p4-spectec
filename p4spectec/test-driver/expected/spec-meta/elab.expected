    -- if (tableFuncDefnAL = TABLEFUNC id param*{param <- param*} ':' typ '=' tblRowAL*{tblRowAL <- tblRowAL*})

    rule defined: AC |- definedFuncDefnIL as defnIL : definedFuncDefnAL as defnAL
    -- if (FUNC id tparam*{tparam <- tparam*} param*{param <- param*} ':' typ '=' clauseIL*{clauseIL <- clauseIL*} elsClauseIL?{elsClauseIL <- elsClauseIL?} = definedFuncDefnIL)
    -- if (AC_func = $add_tparams(AC, tparam*{tparam <- tparam*}))
    -- (Algo_clause: AC_func |- clauseIL : clauseAL)*{clauseAL <- clauseAL*, clauseIL <- clauseIL*}
