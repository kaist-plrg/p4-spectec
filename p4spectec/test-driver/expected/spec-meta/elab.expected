    -- (Guard_rul: AC |- rulAL : rulAL_guard)*{rulAL <- rulAL*, rulAL_guard <- rulAL_guard*}*{rulAL* <- rulAL**, rulAL_guard* <- rulAL_guard**}
    -- (if (rulGroupAL_guard = id_group ':' rulAL_guard*{rulAL_guard <- rulAL_guard*}))*{id_group <- id_group*, rulAL_guard* <- rulAL_guard**, rulGroupAL_guard <- rulGroupAL_guard*}
