    -- (if (rulGroupAL = id_group ':' rulAL*{rulAL <- rulAL*}))*{id_group <- id_group*, rulAL* <- rulAL**, rulGroupAL <- rulGroupAL*}
    -- (if (id_else ':' rulIL_else = elsGroupIL))?{elsGroupIL <- elsGroupIL?, id_else <- id_else?, rulIL_else <- rulIL_else?}
    -- (Algo_rul: AC inputHint |- rulIL_else : rulAL_else)?{rulAL_else <- rulAL_else?, rulIL_else <- rulIL_else?}
    -- (if (elsGroupAL = id_else ':' rulAL_else))?{elsGroupAL <- elsGroupAL?, id_else <- id_else?, rulAL_else <- rulAL_else?}
    -- if (definedRelDefnAL = REL id ':' typ_in*{typ_in <- typ_in*} '->' typ_out*{typ_out <- typ_out*} '=' rulGroupAL*{rulGroupAL <- rulGroupAL*} elsGroupAL?{elsGroupAL <- elsGroupAL?})

  rulegroup func

    rule extern: AC |- externFuncDefn as defnIL : externFuncDefn as defnAL

    rule builtin: AC |- builtinFuncDefn as defnIL : builtinFuncDefn as defnAL

    rule table: AC |- tableFuncDefnIL as defnIL : tableFuncDefnAL as defnAL
    -- if (TABLEFUNC id param*{param <- param*} ':' typ '=' tblRowIL*{tblRowIL <- tblRowIL*} = tableFuncDefnIL)
    -- if (EXP typ_param as param*{typ_param <- typ_param*} = param*{param <- param*})
    -- (Algo_tblRow: AC |- tblRowIL : tblRowAL)*{tblRowAL <- tblRowAL*, tblRowIL <- tblRowIL*}
