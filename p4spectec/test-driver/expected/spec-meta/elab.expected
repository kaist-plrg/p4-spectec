syntax argRes =
   | OK val (from ok<val>)
   | ERROR (from error)
   | UNMATCH (from unmatch)

relation Eval_arg: ctx |- arg : argRes

  rulegroup exp

    rule exp: C |- EXP typedExp as arg : argRes
    -- Eval_exp: C |- typedExp : argRes as expRes

  rulegroup fun

    rule fun: C |- FUN id as arg : OK FUNC id_global as argRes
    -- if (id_global = $resolve_func_param(C, id))

  elsegroup

  rulegroup error

    rule error: C |- arg : ERROR as argRes

syntax argsRes =
   | OK val* (from ok<val*>)
   | ERROR (from error)
   | UNMATCH (from unmatch)

relation Eval_args: ctx |- arg* : argsRes

  rulegroup

    rule nil: C |- [] : OK [] as argsRes

    rule head-failure: C |- arg_h :: arg_t*{arg_t <- arg_t*} : failure as argsRes
    -- Eval_arg: C |- arg_h : failure as argRes

    rule tail-failure: C |- arg_h :: arg_t*{arg_t <- arg_t*} : failure as argsRes
