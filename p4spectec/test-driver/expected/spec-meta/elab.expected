relation Eval_rul: ctx |- rulAL `( val* `) : relRes

  rulegroup

    rule premises-failure: C |- _id ':' typedExp*{typedExp <- typedExp*} '->' _typedExp*{_typedExp <- _typedExp*} '-' premAL*{premAL <- premAL*} `( val*{val <- val*} `) : failure as relRes
