var b : bool

var i : int

var n : nat

var t : text

def $ite<X>(bool, X, X) : X =

  clause 0 : (true, X_t, X_f) = X_t

  clause 1 : (false, X_t, X_f) = X_f

def $deopt_<X>(X?, X) : X =

  clause 0 : (?(), X_d) = X_d

  clause 1 : (?(X), X_d) = X

def $exists_(bool*) : bool =

  clause 0 : ([]) = false

  clause 1 : (b_h :: b_t*{b_t <- b_t*}) = (b_h \/ $exists_(b_t*{b_t <- b_t*}))

def $forall_(bool*) : bool =

  clause 0 : ([]) = true

  clause 1 : (b_h :: b_t*{b_t <- b_t*}) = (b_h /\ $forall_(b_t*{b_t <- b_t*}))

def $repeat_<X>(X, nat) : X* =

  clause 0 : (X, 0) = []

  clause 1 : (X, n) = [X] ++ $repeat_<X>(X, n')
  -- if (n =/= 0)
  -- if (n' as int = (n - 1))

builtin def $concat_<X>(X**) : X*

builtin def $assoc_<X, Y>(X, (X, Y)*) : Y?

def $transpose_<X>(X**) : X** =

  clause 0 : ([]) = []

  clause 1 : ([] :: X_t*{X_t <- X_t*}*{X_t* <- X_t**}) = []
  -- if $forall_((X_t*{X_t <- X_t*} = [])*{X_t* <- X_t**})

  clause 2 : (X_h :: X_t*{X_t <- X_t*}*{X_h <- X_h*, X_t* <- X_t**}) = X_h*{X_h <- X_h*} :: X_trans*{X_trans <- X_trans*}*{X_trans* <- X_trans**}
  -- if (X_h*{X_h <- X_h*} =/= [])
  -- if (X_trans*{X_trans <- X_trans*}*{X_trans* <- X_trans**} = $transpose_<X>(X_t*{X_t <- X_t*}*{X_t* <- X_t**}))

def $intersect_<X>(X*, X*) : X* =

  clause 0 : ([], _X*{_X <- _X*}) = []

  clause 1 : (X_h :: X_t*{X_t <- X_t*}, X_in*{X_in <- X_in*}) = X_h :: $intersect_<X>(X_t*{X_t <- X_t*}, X_in*{X_in <- X_in*})
  -- if X_h <- X_in*{X_in <- X_in*}

  clause 2 : (X_h :: X_t*{X_t <- X_t*}, X_in*{X_in <- X_in*}) = $intersect_<X>(X_t*{X_t <- X_t*}, X_in*{X_in <- X_in*})
  -- if ~X_h <- X_in*{X_in <- X_in*}

syntax set<K> =
   | `{ K* `} (from set<K>)

syntax pair<K, V> =
   | K ':' V (from pair<K, V>)

syntax map<K, V> = set<pair<K, V>>

def $empty_map<K, V> : map<K, V> =

  clause 0 :  = `{ [] `}

builtin def $find_map<K, V>(map<K, V>, K) : V?

builtin def $add_map<K, V>(map<K, V>, K, V) : map<K, V>

def $adds_map<K, V>(map<K, V>, K*, V*) : map<K, V> =

  clause 0 : (`{ K ':' V*{K <- K*, V <- V*} `}, [], []) = `{ K ':' V*{K <- K*, V <- V*} `}

  clause 1 : (`{ K ':' V*{K <- K*, V <- V*} `}, K_h :: K_t*{K_t <- K_t*}, V_h :: V_t*{V_t <- V_t*}) = $adds_map<K, V>($add_map<K, V>(`{ K ':' V*{K <- K*, V <- V*} `}, K_h, V_h), K_t*{K_t <- K_t*}, V_t*{V_t <- V_t*})

syntax id = text

syntax atom = text

syntax mixop = atom**

syntax num =
   | NAT nat (from num)
   | INT int (from num)

syntax numtyp =
   | NAT (from numtyp)
   | INT (from numtyp)

syntax optyp =
   | BOOL (from optyp)
   | NAT (from numtyp)
   | INT (from numtyp)
   | TEXT (from optyp)

syntax typ =
   | BOOL (from optyp)
   | NAT (from numtyp)
   | INT (from numtyp)
   | TEXT (from optyp)
   | VAR id targ* (from typ)
   | TUP typ* (from typ)
   | ITER typ iter (from typ)
   | FUNC tparam* typ* typ (from typ)

syntax deftyp =
   | ALIAS typ (from deftyp)
   | STRUCT typField* (from deftyp)
   | VARIANT typCase* (from deftyp)

syntax typField =
   | atom typ (from typField)

syntax typCase =
   | mixop typ* (from typCase)

syntax iter =
   | QUEST (from iter)
   | STAR (from iter)

syntax vari =
   | id typ iter* (from vari)

syntax boolUnOp =
   | NOT (from boolUnOp)

syntax numUnOp =
   | PLUS (from numUnOp)
   | MINUS (from numUnOp)

syntax unOp =
   | NOT (from boolUnOp)
   | PLUS (from numUnOp)
   | MINUS (from numUnOp)

syntax boolBinOp =
   | AND (from boolBinOp)
   | OR (from boolBinOp)
   | IMPL (from boolBinOp)
   | EQUIV (from boolBinOp)

syntax numBinOp =
   | ADD (from numBinOp)
   | SUB (from numBinOp)
   | MUL (from numBinOp)
   | DIV (from numBinOp)
   | MOD (from numBinOp)
   | POW (from numBinOp)

syntax binOp =
   | AND (from boolBinOp)
   | OR (from boolBinOp)
   | IMPL (from boolBinOp)
   | EQUIV (from boolBinOp)
   | ADD (from numBinOp)
   | SUB (from numBinOp)
   | MUL (from numBinOp)
   | DIV (from numBinOp)
   | MOD (from numBinOp)
   | POW (from numBinOp)

syntax numCmpOp =
   | LT (from numCmpOp)
   | GT (from numCmpOp)
   | LE (from numCmpOp)
   | GE (from numCmpOp)

syntax polyCmpOp =
   | EQ (from polyCmpOp)
   | NE (from polyCmpOp)

syntax cmpOp =
   | EQ (from polyCmpOp)
   | NE (from polyCmpOp)
   | LT (from numCmpOp)
   | GT (from numCmpOp)
   | LE (from numCmpOp)
   | GE (from numCmpOp)

syntax listPat =
   | CONS (from listPat)
   | FIXED nat (from listPat)
   | NIL (from listPat)

syntax optPat =
   | SOME (from optPat)
   | NONE (from optPat)

syntax pat =
   | INJ mixop (from pat)
   | CONS (from listPat)
   | FIXED nat (from listPat)
   | NIL (from listPat)
   | SOME (from optPat)
   | NONE (from optPat)

syntax typedExp =
   | exp '#' typ (from typedExp)

syntax literalExp =
   | BOOL bool (from literalExp)
   | NAT nat (from num)
   | INT int (from num)
   | TEXT text (from literalExp)

syntax varExp =
   | VAR id (from varExp)

syntax unOpExp =
   | UN unOp typedExp (from unOpExp)

syntax binOpExp =
   | BIN binOp typedExp typedExp (from binOpExp)

syntax cmpOpExp =
   | CMP cmpOp typedExp typedExp (from cmpOpExp)

syntax opExp =
   | UN unOp typedExp (from unOpExp)
   | BIN binOp typedExp typedExp (from binOpExp)
   | CMP cmpOp typedExp typedExp (from cmpOpExp)

syntax upCastExp =
   | UPCAST typ typedExp (from upCastExp)

syntax downCastExp =
   | DOWNCAST typ typedExp (from downCastExp)

syntax castExp =
   | UPCAST typ typedExp (from upCastExp)
   | DOWNCAST typ typedExp (from downCastExp)

syntax subExp =
   | SUB typedExp typ (from subExp)

syntax matchExp =
   | MATCH typedExp pat (from matchExp)

syntax tupExp =
   | TUP typedExp* (from tupExp)

syntax injExp =
   | INJ expCase (from injExp)

syntax strExp =
   | STR expField* (from strExp)

syntax optExp =
   | OPT typedExp? (from optExp)

syntax listExp =
   | LIST typedExp* (from listExp)

syntax consExp =
   | CONS typedExp typedExp (from consExp)

syntax catExp =
   | CAT typedExp typedExp (from catExp)

syntax memExp =
   | MEM typedExp typedExp (from memExp)

syntax lenExp =
   | LEN typedExp (from lenExp)

syntax dotAccExp =
   | DOT typedExp atom (from dotAccExp)

syntax idxAccExp =
   | IDX typedExp typedExp (from idxAccExp)

syntax sliceAccExp =
   | SLICE typedExp typedExp typedExp (from sliceAccExp)

syntax accExp =
   | DOT typedExp atom (from dotAccExp)
   | IDX typedExp typedExp (from idxAccExp)
   | SLICE typedExp typedExp typedExp (from sliceAccExp)

syntax updExp =
   | UPD typedExp typedPath typedExp (from updExp)

syntax callExp =
   | CALL id targ* arg* (from callExp)

syntax iterExp =
   | ITER typedExp expIter (from iterExp)

syntax exp =
   | BOOL bool (from literalExp)
   | NAT nat (from num)
   | INT int (from num)
   | TEXT text (from literalExp)
   | VAR id (from varExp)
   | UN unOp typedExp (from unOpExp)
   | BIN binOp typedExp typedExp (from binOpExp)
   | CMP cmpOp typedExp typedExp (from cmpOpExp)
   | UPCAST typ typedExp (from upCastExp)
   | DOWNCAST typ typedExp (from downCastExp)
   | SUB typedExp typ (from subExp)
   | MATCH typedExp pat (from matchExp)
   | TUP typedExp* (from tupExp)
   | INJ expCase (from injExp)
   | STR expField* (from strExp)
   | OPT typedExp? (from optExp)
   | LIST typedExp* (from listExp)
   | CONS typedExp typedExp (from consExp)
   | CAT typedExp typedExp (from catExp)
   | MEM typedExp typedExp (from memExp)
   | LEN typedExp (from lenExp)
   | DOT typedExp atom (from dotAccExp)
   | IDX typedExp typedExp (from idxAccExp)
   | SLICE typedExp typedExp typedExp (from sliceAccExp)
   | UPD typedExp typedPath typedExp (from updExp)
   | CALL id targ* arg* (from callExp)
   | ITER typedExp expIter (from iterExp)

syntax expCase =
   | mixop typedExp* (from expCase)

syntax expField =
   | atom typedExp (from expField)

syntax expIter =
   | iter vari* (from expIter)

syntax typedPath =
   | path '#' typ (from typedPath)

syntax rootPath =
   | ROOT (from rootPath)

syntax idxPath =
   | IDX typedPath typedExp (from idxPath)

syntax slicePath =
   | SLICE typedPath typedExp typedExp (from slicePath)

syntax dotPath =
   | DOT typedPath atom (from dotPath)

syntax path =
   | ROOT (from rootPath)
   | IDX typedPath typedExp (from idxPath)
   | SLICE typedPath typedExp typedExp (from slicePath)
   | DOT typedPath atom (from dotPath)

syntax targ = typ

syntax expArg =
   | EXP typedExp (from expArg)

syntax funArg =
   | FUN id (from funArg)

syntax arg =
   | EXP typedExp (from expArg)
   | FUN id (from funArg)

syntax tparam = id

syntax expParam =
   | EXP typ (from expParam)

syntax funParam =
   | FUN id ':' tparam* param* '->' typ (from funParam)

syntax param =
   | EXP typ (from expParam)
   | FUN id ':' tparam* param* '->' typ (from funParam)

syntax ifPrem =
   | IF typedExp (from ifPrem)

syntax ifHoldPrem =
   | IFHOLD id ':' typedExp* (from ifHoldPrem)

syntax ifNotHoldPrem =
   | IFNOTHOLD id ':' typedExp* (from ifNotHoldPrem)

syntax debugPrem =
   | DEBUG typedExp (from debugPrem)

syntax externTypDefn =
   | EXTTYP id (from externTypDefn)

syntax definedTypDefn =
   | TYP id tparam* '=' deftyp (from definedTypDefn)

syntax typDefn =
   | EXTTYP id (from externTypDefn)
   | TYP id tparam* '=' deftyp (from definedTypDefn)

syntax externFuncDefn =
   | EXTFUNC id tparam* param* ':' typ (from externFuncDefn)

syntax builtinFuncDefn =
   | BUILTINFUNC id tparam* param* ':' typ (from builtinFuncDefn)

syntax inputHint = nat*

syntax premIterIL =
   | iter vari* (from premIterIL)

syntax relPremIL =
   | REL id ':' typedExp* `( inputHint `) (from relPremIL)

syntax iterPremIL =
   | ITER premIL premIterIL (from iterPremIL)

syntax premIL =
   | REL id ':' typedExp* `( inputHint `) (from relPremIL)
   | IF typedExp (from ifPrem)
   | IFHOLD id ':' typedExp* (from ifHoldPrem)
   | IFNOTHOLD id ':' typedExp* (from ifNotHoldPrem)
   | ITER premIL premIterIL (from iterPremIL)
   | DEBUG typedExp (from debugPrem)

syntax externRelDefnIL =
   | EXTREL id ':' typ* `( inputHint `) (from externRelDefnIL)

syntax rulIL =
   | id ':' typedExp* '-' premIL* (from rulIL)

syntax rulGroupIL =
   | id ':' rulIL* (from rulGroupIL)

syntax elsGroupIL =
   | id ':' rulIL (from elsGroupIL)

syntax definedRelDefnIL =
   | REL id ':' typ* `( inputHint `) '=' rulGroupIL* elsGroupIL? (from definedRelDefnIL)

syntax relDefnIL =
   | EXTREL id ':' typ* `( inputHint `) (from externRelDefnIL)
   | REL id ':' typ* `( inputHint `) '=' rulGroupIL* elsGroupIL? (from definedRelDefnIL)

syntax tblRowIL =
   | arg* '=' typedExp (from tblRowIL)

syntax tableFuncDefnIL =
   | TABLEFUNC id param* ':' typ '=' tblRowIL* (from tableFuncDefnIL)

syntax clauseIL =
   | arg* '=' typedExp '-' premIL* (from clauseIL)

syntax elsClauseIL = clauseIL

syntax definedFuncDefnIL =
   | FUNC id tparam* param* ':' typ '=' clauseIL* elsClauseIL? (from definedFuncDefnIL)

syntax funcDefnIL =
   | EXTFUNC id tparam* param* ':' typ (from externFuncDefn)
   | BUILTINFUNC id tparam* param* ':' typ (from builtinFuncDefn)
   | TABLEFUNC id param* ':' typ '=' tblRowIL* (from tableFuncDefnIL)
   | FUNC id tparam* param* ':' typ '=' clauseIL* elsClauseIL? (from definedFuncDefnIL)

syntax defnIL =
   | EXTTYP id (from externTypDefn)
   | TYP id tparam* '=' deftyp (from definedTypDefn)
   | EXTREL id ':' typ* `( inputHint `) (from externRelDefnIL)
   | REL id ':' typ* `( inputHint `) '=' rulGroupIL* elsGroupIL? (from definedRelDefnIL)
   | EXTFUNC id tparam* param* ':' typ (from externFuncDefn)
   | BUILTINFUNC id tparam* param* ':' typ (from builtinFuncDefn)
   | TABLEFUNC id param* ':' typ '=' tblRowIL* (from tableFuncDefnIL)
   | FUNC id tparam* param* ':' typ '=' clauseIL* elsClauseIL? (from definedFuncDefnIL)

syntax specIL = defnIL*

syntax premIterAL =
   | iter '<-' vari* '->' vari* (from premIterAL)

syntax relPremAL =
   | REL id ':' typedExp* '->' typedExp* (from relPremAL)

syntax letPremAL =
   | LET typedExp '=' typedExp (from letPremAL)

syntax iterPremAL =
   | ITER premAL premIterAL (from iterPremAL)

syntax premAL =
   | REL id ':' typedExp* '->' typedExp* (from relPremAL)
   | IF typedExp (from ifPrem)
   | IFHOLD id ':' typedExp* (from ifHoldPrem)
   | IFNOTHOLD id ':' typedExp* (from ifNotHoldPrem)
   | LET typedExp '=' typedExp (from letPremAL)
   | ITER premAL premIterAL (from iterPremAL)
   | DEBUG typedExp (from debugPrem)

syntax externRelDefnAL =
   | EXTREL id ':' typ* '->' typ* (from externRelDefnAL)

syntax rulAL =
   | id ':' typedExp* '->' typedExp* '-' premAL* (from rulAL)

syntax rulGroupAL =
   | id ':' rulAL* (from rulGroupAL)

syntax elsGroupAL =
   | id ':' rulAL (from elsGroupAL)

syntax definedRelDefnAL =
   | REL id ':' typ* '->' typ* '=' rulGroupAL* elsGroupAL? (from definedRelDefnAL)

syntax relDefnAL =
   | EXTREL id ':' typ* '->' typ* (from externRelDefnAL)
   | REL id ':' typ* '->' typ* '=' rulGroupAL* elsGroupAL? (from definedRelDefnAL)

syntax tblRowAL =
   | arg* '=' typedExp '-' premAL* (from tblRowAL)

syntax tableFuncDefnAL =
   | TABLEFUNC id param* ':' typ '=' tblRowAL* (from tableFuncDefnAL)

syntax clauseAL =
   | arg* '=' typedExp '-' premAL* (from clauseAL)

syntax elsClauseAL = clauseAL

syntax definedFuncDefnAL =
   | FUNC id tparam* param* ':' typ '=' clauseAL* elsClauseAL? (from definedFuncDefnAL)

syntax funcDefnAL =
   | EXTFUNC id tparam* param* ':' typ (from externFuncDefn)
   | BUILTINFUNC id tparam* param* ':' typ (from builtinFuncDefn)
   | TABLEFUNC id param* ':' typ '=' tblRowAL* (from tableFuncDefnAL)
   | FUNC id tparam* param* ':' typ '=' clauseAL* elsClauseAL? (from definedFuncDefnAL)

syntax defnAL =
   | EXTTYP id (from externTypDefn)
   | TYP id tparam* '=' deftyp (from definedTypDefn)
   | EXTREL id ':' typ* '->' typ* (from externRelDefnAL)
   | REL id ':' typ* '->' typ* '=' rulGroupAL* elsGroupAL? (from definedRelDefnAL)
   | EXTFUNC id tparam* param* ':' typ (from externFuncDefn)
   | BUILTINFUNC id tparam* param* ':' typ (from builtinFuncDefn)
   | TABLEFUNC id param* ':' typ '=' tblRowAL* (from tableFuncDefnAL)
   | FUNC id tparam* param* ':' typ '=' clauseAL* elsClauseAL? (from definedFuncDefnAL)

syntax specAL = defnAL*

extern syntax json

syntax val =
   | BOOL bool (from val)
   | NAT nat (from num)
   | INT int (from num)
   | TEXT text (from val)
   | STR valField* (from val)
   | INJ valCase (from val)
   | TUP val* (from val)
   | OPT val? (from val)
   | LIST val* (from val)
   | FUNC id (from val)
   | EXT json (from val)

syntax valField =
   | atom val (from valField)

syntax valCase =
   | mixop val* (from valCase)

def $fresh(id*, id) : id =

  clause 0 : (id_used*{id_used <- id_used*}, id) = id
  -- if ~id <- id_used*{id_used <- id_used*}

  clause 1 : (id_used*{id_used <- id_used*}, id) = $fresh(id_used*{id_used <- id_used*}, id ++ "'")
  -- if id <- id_used*{id_used <- id_used*}

def $ids_of_varis(vari*) : id* =

  clause 0 : (id _typ _iter*{_iter <- _iter*}*{_iter* <- _iter**, _typ <- _typ*, id <- id*}) = id*{id <- id*}

def $select_varis(vari*, id*) : vari* =

  clause 0 : ([], _id*{_id <- _id*}) = []

  clause 1 : (vari_h :: vari_t*{vari_t <- vari_t*}, id*{id <- id*}) = vari_h :: $select_varis(vari_t*{vari_t <- vari_t*}, id*{id <- id*})
  -- if (id_h _typ _iter*{_iter <- _iter*} = vari_h)
  -- if id_h <- id*{id <- id*}

  clause 2 : (vari_h :: vari_t*{vari_t <- vari_t*}, id*{id <- id*}) = $select_varis(vari_t*{vari_t <- vari_t*}, id*{id <- id*})
  -- if (id_h _typ _iter*{_iter <- _iter*} = vari_h)
  -- if ~id_h <- id*{id <- id*}

def $drop_varis(vari*, id*) : vari* =

  clause 0 : ([], _id*{_id <- _id*}) = []

  clause 1 : (vari_h :: vari_t*{vari_t <- vari_t*}, id*{id <- id*}) = $drop_varis(vari_t*{vari_t <- vari_t*}, id*{id <- id*})
  -- if (id_h _typ _iter*{_iter <- _iter*} = vari_h)
  -- if id_h <- id*{id <- id*}

  clause 2 : (vari_h :: vari_t*{vari_t <- vari_t*}, id*{id <- id*}) = vari_h :: $drop_varis(vari_t*{vari_t <- vari_t*}, id*{id <- id*})
  -- if (id_h _typ _iter*{_iter <- _iter*} = vari_h)
  -- if ~id_h <- id*{id <- id*}

def $iterate_vari(vari, iter*) : vari =

  clause 0 : (id typ iter*{iter <- iter*}, iter_add*{iter_add <- iter_add*}) = id typ iter*{iter <- iter*} ++ iter_add*{iter_add <- iter_add*}

def $is_prefix_dim(vari, vari) : bool =

  clause 0 : (_id typ_a iter_a*{iter_a <- iter_a*}, _id' typ_b iter_b*{iter_b <- iter_b*}) = true
  -- if (typ_a = typ_b)
  -- if (|iter_a*{iter_a <- iter_a*}| <= |iter_b*{iter_b <- iter_b*}|)
  -- if (iter_a*{iter_a <- iter_a*} = iter_b*{iter_b <- iter_b*}[0 : |iter_a*{iter_a <- iter_a*}|])

  clause -1 : (_vari, _vari') = false

def $shallowest_vari(vari, vari*) : vari =

  clause 0 : (vari, []) = vari

  clause 1 : (vari, vari_h :: vari_t*{vari_t <- vari_t*}) = $shallowest_vari(vari_h, vari_t*{vari_t <- vari_t*})
  -- if $is_prefix_dim(vari_h, vari)

  clause 2 : (vari, vari_h :: vari_t*{vari_t <- vari_t*}) = $shallowest_vari(vari, vari_t*{vari_t <- vari_t*})
  -- if ~$is_prefix_dim(vari_h, vari)

def $shallowest_varis(vari*) : vari* =

  clause 0 : ([]) = []

  clause 1 : (vari_h :: vari_t*{vari_t <- vari_t*}) = vari_min :: $shallowest_varis(vari_rest*{vari_rest <- vari_rest*})
  -- if (id_h _typ _iter*{_iter <- _iter*} = vari_h)
  -- if (vari_same*{vari_same <- vari_same*} = $select_varis(vari_t*{vari_t <- vari_t*}, [id_h]))
  -- if (vari_rest*{vari_rest <- vari_rest*} = $drop_varis(vari_t*{vari_t <- vari_t*}, [id_h]))
  -- if (vari_min = $shallowest_vari(vari_h, vari_same*{vari_same <- vari_same*}))

syntax typDef =
   | EXTTYP id (from externTypDefn)
   | TYP id tparam* '=' deftyp (from definedTypDefn)
   | PARAM (from typDef)

syntax tdenv = map<id, typDef>

syntax ok<X> =
   | OK X (from ok<X>)

syntax error =
   | ERROR (from error)

syntax unmatch =
   | UNMATCH (from unmatch)

syntax failure =
   | ERROR (from error)
   | UNMATCH (from unmatch)

syntax unitRes =
   | OK (from unitRes)
   | ERROR (from error)

syntax theta = map<id, typ>

def $theta_of_tdenv(tdenv) : theta =

  clause 0 : (`{ [] `}) = $empty_map<id, typ>

  clause 1 : (`{ id_h ':' typDef_h :: id_t ':' typDef_t*{id_t <- id_t*, typDef_t <- typDef_t*} `}) = $add_map<id, typ>(theta_t, id_h, typ_h)
  -- if (typDef_h = TYP _id [] '=' ALIAS typ_h as typDef)
  -- if (theta_t = $theta_of_tdenv(`{ id_t ':' typDef_t*{id_t <- id_t*, typDef_t <- typDef_t*} `}))

  clause 2 : (`{ id_h ':' typDef_h :: id_t ':' typDef_t*{id_t <- id_t*, typDef_t <- typDef_t*} `}) = $theta_of_tdenv(`{ id_t ':' typDef_t*{id_t <- id_t*, typDef_t <- typDef_t*} `})
  -- if (typDef_h = PARAM)

  clause 3 : (`{ id_h ':' EXTTYP _id as typDef :: id_t ':' typDef_t*{id_t <- id_t*, typDef_t <- typDef_t*} `}) = $theta_of_tdenv(`{ id_t ':' typDef_t*{id_t <- id_t*, typDef_t <- typDef_t*} `})

  clause 4 : (`{ id_h ':' TYP _id tparam*{tparam <- tparam*} '=' ALIAS typ as typDef :: id_t ':' typDef_t*{id_t <- id_t*, typDef_t <- typDef_t*} `}) = $theta_of_tdenv(`{ id_t ':' typDef_t*{id_t <- id_t*, typDef_t <- typDef_t*} `})
  -- if (tparam*{tparam <- tparam*} =/= [])

  clause 5 : (`{ id_h ':' TYP _id tparam*{tparam <- tparam*} '=' STRUCT typField*{typField <- typField*} as typDef :: id_t ':' typDef_t*{id_t <- id_t*, typDef_t <- typDef_t*} `}) = $theta_of_tdenv(`{ id_t ':' typDef_t*{id_t <- id_t*, typDef_t <- typDef_t*} `})

  clause 6 : (`{ id_h ':' TYP _id tparam*{tparam <- tparam*} '=' VARIANT typCase*{typCase <- typCase*} as typDef :: id_t ':' typDef_t*{id_t <- id_t*, typDef_t <- typDef_t*} `}) = $theta_of_tdenv(`{ id_t ':' typDef_t*{id_t <- id_t*, typDef_t <- typDef_t*} `})

def $ids_typ(typ) : id* =

  clause 0 : (VAR id typ*{typ <- typ*}) = [id] ++ $ids_typs(typ*{typ <- typ*})

  clause 1 : (TUP typ*{typ <- typ*}) = $ids_typs(typ*{typ <- typ*})

  clause 2 : (ITER typ iter) = $ids_typ(typ)

  clause 3 : (FUNC tparam*{tparam <- tparam*} typ*{typ <- typ*} typ_ret) = tparam*{tparam <- tparam*} ++ $ids_typs(typ*{typ <- typ*}) ++ $ids_typ(typ_ret)

  clause -1 : (typ) = []

def $ids_typs(typ*) : id* =

  clause 0 : ([]) = []

  clause 1 : (typ_h :: typ_t*{typ_t <- typ_t*}) = $ids_typ(typ_h) ++ $ids_typs(typ_t*{typ_t <- typ_t*})

def $fresh_ids(id*, id*) : id* =

  clause 0 : (id_used*{id_used <- id_used*}, []) = []

  clause 1 : (id_used*{id_used <- id_used*}, id_h :: id_t*{id_t <- id_t*}) = [id_fresh] ++ $fresh_ids([id_fresh] ++ id_used*{id_used <- id_used*}, id_t*{id_t <- id_t*})
  -- if (id_fresh = $fresh(id_used*{id_used <- id_used*}, id_h))

syntax typRes =
   | OK typ (from ok<typ>)
   | ERROR (from error)

syntax typsRes =
   | OK typ* (from ok<typ*>)
   | ERROR (from error)

def $subst_typ(theta, typ) : typRes =

  clause 0 : (theta, NAT as typ) = OK NAT as typ as typRes

  clause 1 : (theta, INT as typ) = OK INT as typ as typRes

  clause 2 : (theta, TEXT as typ) = OK TEXT as typ as typRes

  clause 3 : (theta, BOOL as typ) = OK BOOL as typ as typRes

  clause 4 : (theta, VAR id []) = OK typ as typRes
  -- if (?(typ) = $find_map<id, typ>(theta, id))

  clause 5 : (theta, VAR id targ*{targ <- targ*}) = OK VAR id targ_subst*{targ_subst <- targ_subst*} as typRes
  -- if (?() = $find_map<id, typ>(theta, id))
  -- if (OK targ_subst*{targ_subst <- targ_subst*} as typsRes = $subst_typs(theta, targ*{targ <- targ*}))

  clause 6 : (theta, TUP typ*{typ <- typ*}) = OK TUP typ_subst*{typ_subst <- typ_subst*} as typRes
  -- if (OK typ_subst*{typ_subst <- typ_subst*} as typsRes = $subst_typs(theta, typ*{typ <- typ*}))

  clause 7 : (theta, ITER typ iter) = OK ITER typ_subst iter as typRes
  -- if (OK typ_subst as typRes = $subst_typ(theta, typ))

  clause 8 : (theta, FUNC tparam*{tparam <- tparam*} typ*{typ <- typ*} typ_ret) = OK FUNC tparam_fresh*{tparam_fresh <- tparam_fresh*} typ_subst*{typ_subst <- typ_subst*} typ_ret_subst as typRes
  -- if (`{ id ':' typ_arg*{id <- id*, typ_arg <- typ_arg*} `} = theta)
  -- if (id_used*{id_used <- id_used*} = id*{id <- id*} ++ $ids_typs(typ_arg*{typ_arg <- typ_arg*}) ++ $ids_typ(FUNC tparam*{tparam <- tparam*} typ*{typ <- typ*} typ_ret))
  -- if (tparam_fresh*{tparam_fresh <- tparam_fresh*} = $fresh_ids(id_used*{id_used <- id_used*}, tparam*{tparam <- tparam*}))
  -- if (theta_fresh = `{ tparam ':' VAR tparam_fresh []*{tparam <- tparam*, tparam_fresh <- tparam_fresh*} `})
  -- if (OK typ_fresh*{typ_fresh <- typ_fresh*} as typsRes = $subst_typs(theta_fresh, typ*{typ <- typ*}))
  -- if (OK typ_subst*{typ_subst <- typ_subst*} as typsRes = $subst_typs(theta, typ_fresh*{typ_fresh <- typ_fresh*}))
  -- if (OK typ_ret_fresh as typRes = $subst_typ(theta_fresh, typ_ret))
  -- if (OK typ_ret_subst as typRes = $subst_typ(theta, typ_ret_fresh))

  clause -1 : (theta, typ) = ERROR as typRes

def $subst_typs(theta, typ*) : typsRes =

  clause 0 : (theta, []) = OK [] as typsRes

  clause 1 : (theta, typ_h :: typ_t*{typ_t <- typ_t*}) = OK typ_subst :: typ_t_subst*{typ_t_subst <- typ_t_subst*} as typsRes
  -- if (OK typ_subst as typRes = $subst_typ(theta, typ_h))
  -- if (OK typ_t_subst*{typ_t_subst <- typ_t_subst*} as typsRes = $subst_typs(theta, typ_t*{typ_t <- typ_t*}))

  clause -1 : (theta, typ*{typ <- typ*}) = ERROR as typsRes

def $expand_typ(tdenv, typ) : typRes =

  clause 0 : (tdenv, VAR id targ*{targ <- targ*}) = $expand_typ(tdenv, typ_subst)
  -- if (?(TYP _id tparam*{tparam <- tparam*} '=' ALIAS typ as typDef) = $find_map<id, typDef>(tdenv, id))
  -- if (theta = `{ tparam ':' targ*{targ <- targ*, tparam <- tparam*} `})
  -- if (OK typ_subst as typRes = $subst_typ(theta, typ))

  clause 1 : (tdenv, VAR id targ*{targ <- targ*}) = OK VAR id targ*{targ <- targ*} as typRes
  -- if (?(typDef) = $find_map<id, typDef>(tdenv, id))
  -- if (typDef = PARAM)
  -- if (targ*{targ <- targ*} = [])

  clause 2 : (tdenv, VAR id []) = OK VAR id [] as typRes
  -- if (?(EXTTYP _id as typDef) = $find_map<id, typDef>(tdenv, id))

  clause 3 : (tdenv, VAR id targ*{targ <- targ*}) = OK VAR id targ*{targ <- targ*} as typRes
  -- if (?(TYP _id tparam*{tparam <- tparam*} '=' STRUCT typField*{typField <- typField*} as typDef) = $find_map<id, typDef>(tdenv, id))
  -- if (|tparam*{tparam <- tparam*}| = |targ*{targ <- targ*}|)

  clause 4 : (tdenv, VAR id targ*{targ <- targ*}) = OK VAR id targ*{targ <- targ*} as typRes
  -- if (?(TYP _id tparam*{tparam <- tparam*} '=' VARIANT typCase*{typCase <- typCase*} as typDef) = $find_map<id, typDef>(tdenv, id))
  -- if (|tparam*{tparam <- tparam*}| = |targ*{targ <- targ*}|)

  clause 5 : (tdenv, BOOL as typ) = OK BOOL as typ as typRes

  clause 6 : (tdenv, NAT as typ) = OK NAT as typ as typRes

  clause 7 : (tdenv, INT as typ) = OK INT as typ as typRes

  clause 8 : (tdenv, TEXT as typ) = OK TEXT as typ as typRes

  clause 9 : (tdenv, TUP typ*{typ <- typ*}) = OK TUP typ*{typ <- typ*} as typRes

  clause 10 : (tdenv, ITER typ iter) = OK ITER typ iter as typRes

  clause 11 : (tdenv, FUNC tparam*{tparam <- tparam*} typ*{typ <- typ*} typ_ret) = OK FUNC tparam*{tparam <- tparam*} typ*{typ <- typ*} typ_ret as typRes

  clause -1 : (tdenv, typ) = ERROR as typRes

syntax equivRes =
   | OK bool (from ok<bool>)
   | ERROR (from error)

def $equiv_typ(tdenv, typ, typ) : equivRes =

  clause 0 : (tdenv, typ_l, typ_r) = $equiv_typ'(tdenv, typ_l_expand, typ_r_expand)
  -- if (OK typ_l_expand as typRes = $expand_typ(tdenv, typ_l))
  -- if (OK typ_r_expand as typRes = $expand_typ(tdenv, typ_r))

  clause -1 : (tdenv, typ_l, typ_r) = ERROR as equivRes

def $equiv_typs(tdenv, typ*, typ*) : equivRes =

  clause 0 : (tdenv, [], []) = OK true as equivRes

  clause 1 : (tdenv, typ_l :: typ_l_t*{typ_l_t <- typ_l_t*}, typ_r :: typ_r_t*{typ_r_t <- typ_r_t*}) = $equiv_typs(tdenv, typ_l_t*{typ_l_t <- typ_l_t*}, typ_r_t*{typ_r_t <- typ_r_t*})
  -- if (OK true as equivRes = $equiv_typ(tdenv, typ_l, typ_r))

  clause 2 : (tdenv, typ_l :: typ_l_t*{typ_l_t <- typ_l_t*}, typ_r :: typ_r_t*{typ_r_t <- typ_r_t*}) = equivRes
  -- if (equivRes = $equiv_typ(tdenv, typ_l, typ_r))
  -- if (equivRes =/= OK true as equivRes)

  clause 3 : (tdenv, [], typ_r :: typ_r_t*{typ_r_t <- typ_r_t*}) = OK false as equivRes

  clause 4 : (tdenv, typ_l :: typ_l_t*{typ_l_t <- typ_l_t*}, []) = OK false as equivRes

def $equiv_typ'(tdenv, typ, typ) : equivRes =

  clause 0 : (tdenv, BOOL as typ, BOOL as typ) = OK true as equivRes

  clause 1 : (tdenv, NAT as typ, NAT as typ) = OK true as equivRes

  clause 2 : (tdenv, INT as typ, INT as typ) = OK true as equivRes

  clause 3 : (tdenv, TEXT as typ, TEXT as typ) = OK true as equivRes

  clause 4 : (tdenv, VAR id_l targ_l*{targ_l <- targ_l*}, VAR id_r targ_r*{targ_r <- targ_r*}) = $equiv_typs(tdenv, targ_l*{targ_l <- targ_l*}, targ_r*{targ_r <- targ_r*})
  -- if (id_l = id_r)

  clause 5 : (tdenv, TUP typ_l*{typ_l <- typ_l*}, TUP typ_r*{typ_r <- typ_r*}) = $equiv_typs(tdenv, typ_l*{typ_l <- typ_l*}, typ_r*{typ_r <- typ_r*})

  clause 6 : (tdenv, ITER typ_l iter_l, ITER typ_r iter_r) = $equiv_typ(tdenv, typ_l, typ_r)
  -- if (iter_l = iter_r)

  clause -1 : (tdenv, typ_l, typ_r) = OK false as equivRes

def $equiv_func_typ(tdenv, typ, typ) : equivRes =

  clause 0 : (tdenv, FUNC tparam_l*{tparam_l <- tparam_l*} typ_l*{typ_l <- typ_l*} typ_ret_l, FUNC tparam_r*{tparam_r <- tparam_r*} typ_r*{typ_r <- typ_r*} typ_ret_r) = $equiv_typs(tdenv_fresh, typ_l_subst*{typ_l_subst <- typ_l_subst*} ++ [typ_ret_l_subst], typ_r_subst*{typ_r_subst <- typ_r_subst*} ++ [typ_ret_r_subst])
  -- if (|tparam_l*{tparam_l <- tparam_l*}| = |tparam_r*{tparam_r <- tparam_r*}|)
  -- if (|typ_l*{typ_l <- typ_l*}| = |typ_r*{typ_r <- typ_r*}|)
  -- if (`{ id ':' typDef*{id <- id*, typDef <- typDef*} `} = tdenv)
  -- if (id_used*{id_used <- id_used*} = id*{id <- id*} ++ $ids_typ(FUNC tparam_l*{tparam_l <- tparam_l*} typ_l*{typ_l <- typ_l*} typ_ret_l) ++ $ids_typ(FUNC tparam_r*{tparam_r <- tparam_r*} typ_r*{typ_r <- typ_r*} typ_ret_r))
  -- if (tparam_fresh*{tparam_fresh <- tparam_fresh*} = $fresh_ids(id_used*{id_used <- id_used*}, tparam_l*{tparam_l <- tparam_l*}))
  -- if (theta_l = `{ tparam_l ':' VAR tparam_fresh []*{tparam_fresh <- tparam_fresh*, tparam_l <- tparam_l*} `})
  -- if (theta_r = `{ tparam_r ':' VAR tparam_fresh []*{tparam_fresh <- tparam_fresh*, tparam_r <- tparam_r*} `})
  -- if (OK typ_l_subst*{typ_l_subst <- typ_l_subst*} as typsRes = $subst_typs(theta_l, typ_l*{typ_l <- typ_l*}))
  -- if (OK typ_r_subst*{typ_r_subst <- typ_r_subst*} as typsRes = $subst_typs(theta_r, typ_r*{typ_r <- typ_r*}))
  -- if (OK typ_ret_l_subst as typRes = $subst_typ(theta_l, typ_ret_l))
  -- if (OK typ_ret_r_subst as typRes = $subst_typ(theta_r, typ_ret_r))
  -- if (tdenv_fresh = $adds_map<id, typDef>(tdenv, tparam_fresh*{tparam_fresh <- tparam_fresh*}, $repeat_<typDef>(PARAM, |tparam_fresh*{tparam_fresh <- tparam_fresh*}|)))

  clause 1 : (tdenv, FUNC tparam_l*{tparam_l <- tparam_l*} typ_l*{typ_l <- typ_l*} typ_ret_l, FUNC tparam_r*{tparam_r <- tparam_r*} typ_r*{typ_r <- typ_r*} typ_ret_r) = OK false as equivRes
  -- if ((|tparam_l*{tparam_l <- tparam_l*}| =/= |tparam_r*{tparam_r <- tparam_r*}|) \/ (|typ_l*{typ_l <- typ_l*}| =/= |typ_r*{typ_r <- typ_r*}|))

  clause -1 : (tdenv, typ_l, typ_r) = ERROR as equivRes

syntax algoCtx = {TYP tdenv, BOUND vari*, USED id*}

var AC : algoCtx

def $empty_algoCtx : algoCtx =

  clause 0 :  = {TYP $empty_map<id, typDef>, BOUND [], USED []}

def $load_algoCtx(algoCtx, specIL) : algoCtx =

  clause 0 : (AC, externTypDefn as defnIL :: defnIL_t*{defnIL_t <- defnIL_t*}) = $load_algoCtx(AC_load, defnIL_t*{defnIL_t <- defnIL_t*})
  -- if (EXTTYP id = externTypDefn)
  -- if (tdenv_update = $add_map<id, typDef>(AC.TYP, id, externTypDefn as typDef))
  -- if (AC_load = AC[TYP = tdenv_update])

  clause 1 : (AC, definedTypDefn as defnIL :: defnIL_t*{defnIL_t <- defnIL_t*}) = $load_algoCtx(AC_load, defnIL_t*{defnIL_t <- defnIL_t*})
  -- if (TYP id _tparam*{_tparam <- _tparam*} '=' _deftyp = definedTypDefn)
  -- if (tdenv_update = $add_map<id, typDef>(AC.TYP, id, definedTypDefn as typDef))
  -- if (AC_load = AC[TYP = tdenv_update])

  clause 2 : (AC, relDefnIL as defnIL :: defnIL_t*{defnIL_t <- defnIL_t*}) = $load_algoCtx(AC, defnIL_t*{defnIL_t <- defnIL_t*})

  clause 3 : (AC, funcDefnIL as defnIL :: defnIL_t*{defnIL_t <- defnIL_t*}) = $load_algoCtx(AC, defnIL_t*{defnIL_t <- defnIL_t*})

  clause 4 : (AC, []) = AC

def $add_bound(algoCtx, vari*) : algoCtx =

  clause 0 : (AC, vari*{vari <- vari*}) = AC[BOUND = AC.BOUND ++ vari*{vari <- vari*}]

def $add_used(algoCtx, id*) : algoCtx =

  clause 0 : (AC, id*{id <- id*}) = AC[USED = AC.USED ++ id*{id <- id*}]

def $add_tparams(algoCtx, tparam*) : algoCtx =

  clause 0 : (AC, tparam*{tparam <- tparam*}) = AC[TYP = tdenv]
  -- if (typDef*{typDef <- typDef*} = $repeat_<typDef>(PARAM, |tparam*{tparam <- tparam*}|))
  -- if (tdenv = $adds_map<id, typDef>(AC.TYP, tparam*{tparam <- tparam*}, typDef*{typDef <- typDef*}))

def $fresh_id(id*) : (id*, id) =

  clause 0 : (id_used*{id_used <- id_used*}) = (id_used*{id_used <- id_used*} ++ [id_fresh], id_fresh)
  -- if (id_fresh = $fresh(id_used*{id_used <- id_used*}, "fresh"))

syntax iterCtx = premIterIL*

var IC : iterCtx

def $add_iterated(iterCtx, vari*) : iterCtx =

  clause 0 : ([], _vari*{_vari <- _vari*}) = []

  clause 1 : (iter vari*{vari <- vari*} :: IC, vari_new*{vari_new <- vari_new*}) = iter vari*{vari <- vari*} ++ vari_add*{vari_add <- vari_add*} :: IC_outer
  -- if (vari_add*{vari_add <- vari_add*} = $drop_varis(vari_new*{vari_new <- vari_new*}, $ids_of_varis(vari*{vari <- vari*})))
  -- (if (vari_lift = $iterate_vari(vari_new, [iter])))*{vari_lift <- vari_lift*, vari_new <- vari_new*}
  -- if (IC_outer = $add_iterated(IC, vari_lift*{vari_lift <- vari_lift*}))

def $prem_iters(iterCtx, id*, id*) : premIterAL* =

  clause 0 : ([], _id*{_id <- _id*}, _id'*{_id' <- _id'*}) = []

  clause 1 : (iter vari*{vari <- vari*} :: IC, id_read*{id_read <- id_read*}, id_bind*{id_bind <- id_bind*}) = premIterAL_inner :: premIterAL_outer*{premIterAL_outer <- premIterAL_outer*}
  -- if (vari_read*{vari_read <- vari_read*} = $select_varis(vari*{vari <- vari*}, id_read*{id_read <- id_read*}))
  -- if (vari_bind*{vari_bind <- vari_bind*} = $select_varis(vari*{vari <- vari*}, id_bind*{id_bind <- id_bind*}))
  -- if (premIterAL_inner = iter '<-' vari_read*{vari_read <- vari_read*} '->' vari_bind*{vari_bind <- vari_bind*})
  -- if (premIterAL_outer*{premIterAL_outer <- premIterAL_outer*} = $prem_iters(IC, id_read*{id_read <- id_read*}, id_bind*{id_bind <- id_bind*}))

def $iterate_prem(premAL, premIterAL*) : premAL =

  clause 0 : (premAL, []) = premAL

  clause 1 : (premAL, premIterAL :: premIterAL_t*{premIterAL_t <- premIterAL_t*}) = $iterate_prem(ITER premAL premIterAL as premAL, premIterAL_t*{premIterAL_t <- premIterAL_t*})

def $split_inputs<X>(inputHint, X*) : (X*, X*) =

  clause 0 : (n*{n <- n*}, X*{X <- X*}) = $split_inputs_from<X>(n*{n <- n*}, 0, X*{X <- X*})
  -- if $forall_((n < |X*{X <- X*}|)*{n <- n*})

def $split_inputs_from<X>(inputHint, nat, X*) : (X*, X*) =

  clause 0 : (_inputHint, _n, []) = ([], [])

  clause 1 : (n*{n <- n*}, n_pos, X_h :: X_t*{X_t <- X_t*}) = (X_h :: X_in*{X_in <- X_in*}, X_out*{X_out <- X_out*})
  -- if n_pos <- n*{n <- n*}
  -- if ((X_in*{X_in <- X_in*}, X_out*{X_out <- X_out*}) = $split_inputs_from<X>(n*{n <- n*}, (n_pos + 1), X_t*{X_t <- X_t*}))

  clause 2 : (n*{n <- n*}, n_pos, X_h :: X_t*{X_t <- X_t*}) = (X_in*{X_in <- X_in*}, X_h :: X_out*{X_out <- X_out*})
  -- if ~n_pos <- n*{n <- n*}
  -- if ((X_in*{X_in <- X_in*}, X_out*{X_out <- X_out*}) = $split_inputs_from<X>(n*{n <- n*}, (n_pos + 1), X_t*{X_t <- X_t*}))

relation Collectbind_exp: algoCtx |- typedExp : vari*

  rulegroup variable

    rule bound: AC |- VAR id as exp '#' _typ : []
    -- if id <- $ids_of_varis(AC.BOUND)

    rule binder: AC |- VAR id as exp '#' typ : [id typ []]
    -- if ~id <- $ids_of_varis(AC.BOUND)

  rulegroup upcast

    rule upcast: AC |- UPCAST _typ typedExp as exp '#' _typ' : vari*{vari <- vari*}
    -- Collectbind_exp: AC |- typedExp : vari*{vari <- vari*}

  rulegroup tuple

    rule tuple: AC |- TUP typedExp*{typedExp <- typedExp*} as exp '#' _typ : vari*{vari <- vari*}
    -- Collectbind_exps: AC |- typedExp*{typedExp <- typedExp*} : vari*{vari <- vari*}

  rulegroup case

    rule case: AC |- INJ _mixop typedExp*{typedExp <- typedExp*} as exp '#' _typ : vari*{vari <- vari*}
    -- Collectbind_exps: AC |- typedExp*{typedExp <- typedExp*} : vari*{vari <- vari*}

  rulegroup struct

    rule struct: AC |- STR expField*{expField <- expField*} as exp '#' _typ : vari*{vari <- vari*}
    -- (if (_atom typedExp = expField))*{_atom <- _atom*, expField <- expField*, typedExp <- typedExp*}
    -- Collectbind_exps: AC |- typedExp*{typedExp <- typedExp*} : vari*{vari <- vari*}

  rulegroup opt

    rule none: AC |- OPT ?() as exp '#' _typ : []

    rule some: AC |- OPT ?(typedExp) as exp '#' _typ : vari*{vari <- vari*}
    -- Collectbind_exp: AC |- typedExp : vari*{vari <- vari*}

  rulegroup list

    rule list: AC |- LIST typedExp*{typedExp <- typedExp*} as exp '#' _typ : vari*{vari <- vari*}
    -- Collectbind_exps: AC |- typedExp*{typedExp <- typedExp*} : vari*{vari <- vari*}

  rulegroup cons

    rule cons: AC |- CONS typedExp_h typedExp_t as exp '#' _typ : vari*{vari <- vari*}
    -- Collectbind_exps: AC |- [typedExp_h, typedExp_t] : vari*{vari <- vari*}

  rulegroup iter

    rule iter: AC |- ITER typedExp iter _vari*{_vari <- _vari*} as exp '#' _typ : vari_iter*{vari_iter <- vari_iter*}
    -- Collectbind_exp: AC |- typedExp : vari*{vari <- vari*}
    -- (if (vari_iter = $iterate_vari(vari, [iter])))*{vari <- vari*, vari_iter <- vari_iter*}

  rulegroup noninvertible

    rule noninvertible: AC |- typedExp : []
    -- if (exp '#' _typ = typedExp)
    -- if ((((((((~exp <: varExp /\ ~exp <: upCastExp) /\ ~exp <: tupExp) /\ ~exp <: injExp) /\ ~exp <: strExp) /\ ~exp <: optExp) /\ ~exp <: listExp) /\ ~exp <: consExp) /\ ~exp <: iterExp)
    -- if (id*{id <- id*} = $ids_of_varis($free_varis_exp(typedExp)))
    -- if $forall_(id <- $ids_of_varis(AC.BOUND)*{id <- id*})

relation Collectbind_exps: algoCtx |- typedExp* : vari*

  rulegroup

    rule nil: AC |- [] : []

    rule cons: AC |- typedExp_h :: typedExp_t*{typedExp_t <- typedExp_t*} : vari_h*{vari_h <- vari_h*} ++ vari_t*{vari_t <- vari_t*}
    -- Collectbind_exp: AC |- typedExp_h : vari_h*{vari_h <- vari_h*}
    -- Collectbind_exps: AC |- typedExp_t*{typedExp_t <- typedExp_t*} : vari_t*{vari_t <- vari_t*}

relation Collectbind_arg: algoCtx |- arg : vari*

  rulegroup exp

    rule exp: AC |- EXP typedExp as arg : vari*{vari <- vari*}
    -- Collectbind_exp: AC |- typedExp : vari*{vari <- vari*}

  rulegroup fun

    rule fun: AC |- funArg as arg : []

relation Collectbind_args: algoCtx |- arg* : vari*

  rulegroup

    rule nil: AC |- [] : []

    rule cons: AC |- arg_h :: arg_t*{arg_t <- arg_t*} : vari_h*{vari_h <- vari_h*} ++ vari_t*{vari_t <- vari_t*}
    -- Collectbind_arg: AC |- arg_h : vari_h*{vari_h <- vari_h*}
    -- Collectbind_args: AC |- arg_t*{arg_t <- arg_t*} : vari_t*{vari_t <- vari_t*}

relation Multibind_exps: algoCtx iterCtx |- typedExp* : algoCtx typedExp* premAL*

  rulegroup

    rule : AC IC |- typedExp*{typedExp <- typedExp*} : AC_multi typedExp_multi*{typedExp_multi <- typedExp_multi*} premAL_eq*{premAL_eq <- premAL_eq*}
    -- Collectbind_exps: AC |- typedExp*{typedExp <- typedExp*} : vari_bind*{vari_bind <- vari_bind*}
    -- if (R = $init_renamer(AC.USED, vari_bind*{vari_bind <- vari_bind*}))
    -- if ((R_multi, typedExp_multi*{typedExp_multi <- typedExp_multi*}) = $rename_exps(R, typedExp*{typedExp <- typedExp*}))
    -- if (premAL_eq*{premAL_eq <- premAL_eq*} = $sideconds_multi(IC, vari_bind*{vari_bind <- vari_bind*}, R_multi))
    -- if (AC_multi = AC[USED = R_multi.USED])

relation Multibind_args: algoCtx |- arg* : algoCtx arg* premAL*

  rulegroup

    rule : AC |- arg*{arg <- arg*} : AC_multi arg_multi*{arg_multi <- arg_multi*} premAL_eq*{premAL_eq <- premAL_eq*}
    -- Collectbind_args: AC |- arg*{arg <- arg*} : vari_bind*{vari_bind <- vari_bind*}
    -- if (R = $init_renamer(AC.USED, vari_bind*{vari_bind <- vari_bind*}))
    -- if ((R_multi, arg_multi*{arg_multi <- arg_multi*}) = $rename_args(R, arg*{arg <- arg*}))
