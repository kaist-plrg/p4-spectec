    -- Assign_exps: C |- typedExp*{typedExp <- typedExp*} := val*{val <- val*} : OK C' as assignRes
    -- Eval_prems: C' |- premAL*{premAL <- premAL*} : OK C'' as premRes
    -- Eval_exps: C'' |- typedExp_out*{typedExp_out <- typedExp_out*} : relRes as expsRes

  elsegroup

  rulegroup error

    rule error: C |- rulAL `( val*{val <- val*} `) : ERROR as relRes

relation Eval_ruls: ctx |- rulAL* `( val* `) : relRes

  rulegroup

    rule nil: C |- [] `( val*{val <- val*} `) : UNMATCH as relRes

    rule unmatch: C |- rulAL_h :: rulAL_t*{rulAL_t <- rulAL_t*} `( val*{val <- val*} `) : relRes
