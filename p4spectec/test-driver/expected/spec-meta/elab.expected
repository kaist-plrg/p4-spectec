    -- Eval_arg: C |- arg_h : OK val_h as argRes
    -- Eval_args: C |- arg_t*{arg_t <- arg_t*} : OK val_t*{val_t <- val_t*} as argsRes

syntax premRes =
   | OK ctx (from ok<ctx>)
   | ERROR (from error)
   | UNMATCH (from unmatch)

relation Eval_prem: ctx |- premAL : premRes

  rulegroup relpr

    rule expressions-failure: C |- REL id ':' typedExp*{typedExp <- typedExp*} '->' typedExp_out*{typedExp_out <- typedExp_out*} as premAL : failure as premRes
    -- Eval_exps: C |- typedExp*{typedExp <- typedExp*} : failure as expsRes

    rule call-failure: C |- REL id ':' typedExp*{typedExp <- typedExp*} '->' typedExp_out*{typedExp_out <- typedExp_out*} as premAL : failure as premRes
    -- Eval_exps: C |- typedExp*{typedExp <- typedExp*} : OK val*{val <- val*} as expsRes
    -- Call_rel: C |- id `( val*{val <- val*} `) : failure as relRes

    rule succ: C |- REL id ':' typedExp*{typedExp <- typedExp*} '->' typedExp_out*{typedExp_out <- typedExp_out*} as premAL : OK C_assign as premRes
    -- Eval_exps: C |- typedExp*{typedExp <- typedExp*} : OK val*{val <- val*} as expsRes
    -- Call_rel: C |- id `( val*{val <- val*} `) : OK val_out*{val_out <- val_out*} as relRes
    -- Assign_exps: C |- typedExp_out*{typedExp_out <- typedExp_out*} := val_out*{val_out <- val_out*} : OK C_assign as assignRes

  rulegroup ifpr

    rule cond-failure: C |- IF typedExp as premAL : failure as premRes
    -- Eval_exp: C |- typedExp : failure as expRes

    rule succ-false: C |- IF typedExp as premAL : UNMATCH as premRes
    -- Eval_exp: C |- typedExp : OK BOOL false as expRes

    rule succ-true: C |- IF typedExp as premAL : OK C as premRes
    -- Eval_exp: C |- typedExp : OK BOOL true as expRes

  rulegroup ifholdpr

    rule expressions-failure: C |- IFHOLD id ':' typedExp*{typedExp <- typedExp*} as premAL : failure as premRes
    -- Eval_exps: C |- typedExp*{typedExp <- typedExp*} : failure as expsRes

    rule call-failure: C |- IFHOLD id ':' typedExp*{typedExp <- typedExp*} as premAL : failure as premRes
    -- Eval_exps: C |- typedExp*{typedExp <- typedExp*} : OK val_input*{val_input <- val_input*} as expsRes
    -- Call_rel: C |- id `( val_input*{val_input <- val_input*} `) : failure as relRes

    rule succ: C |- IFHOLD id ':' typedExp*{typedExp <- typedExp*} as premAL : OK C as premRes
    -- Eval_exps: C |- typedExp*{typedExp <- typedExp*} : OK val_input*{val_input <- val_input*} as expsRes
    -- Call_rel: C |- id `( val_input*{val_input <- val_input*} `) : OK [] as relRes

  rulegroup ifnotholdpr

    rule expressions-failure: C |- IFNOTHOLD id ':' typedExp*{typedExp <- typedExp*} as premAL : failure as premRes
    -- Eval_exps: C |- typedExp*{typedExp <- typedExp*} : failure as expsRes

    rule error: C |- IFNOTHOLD id ':' typedExp*{typedExp <- typedExp*} as premAL : ERROR as premRes
    -- Eval_exps: C |- typedExp*{typedExp <- typedExp*} : OK val_input*{val_input <- val_input*} as expsRes
    -- Call_rel: C |- id `( val_input*{val_input <- val_input*} `) : ERROR as relRes

    rule succ-unmatch: C |- IFNOTHOLD id ':' typedExp*{typedExp <- typedExp*} as premAL : UNMATCH as premRes
    -- Eval_exps: C |- typedExp*{typedExp <- typedExp*} : OK val_input*{val_input <- val_input*} as expsRes
    -- Call_rel: C |- id `( val_input*{val_input <- val_input*} `) : OK val_out*{val_out <- val_out*} as relRes

    rule succ-ok: C |- IFNOTHOLD id ':' typedExp*{typedExp <- typedExp*} as premAL : OK C as premRes
    -- Eval_exps: C |- typedExp*{typedExp <- typedExp*} : OK val_input*{val_input <- val_input*} as expsRes
    -- Call_rel: C |- id `( val_input*{val_input <- val_input*} `) : UNMATCH as relRes

  rulegroup letpr

    rule right-failure: C |- LET typedExp_l '=' typedExp_r as premAL : failure as premRes
    -- Eval_exp: C |- typedExp_r : failure as expRes

    rule succ: C |- LET typedExp_l '=' typedExp_r as premAL : OK C_assign as premRes
    -- Eval_exp: C |- typedExp_r : OK val_r as expRes
    -- Assign_exp: C |- typedExp_l := val_r : OK C_assign as assignRes

  rulegroup iterpr-opt

    rule body-failure: C |- ITER premAL QUEST '<-' vari_bound*{vari_bound <- vari_bound*} '->' _vari*{_vari <- _vari*} as premAL : failure as premRes
    -- if (OK C_sub?{C_sub <- C_sub?} as subOptRes = $sub_opt(C, vari_bound*{vari_bound <- vari_bound*}))
    -- Eval_prem_maybe: C_sub?{C_sub <- C_sub?} |- premAL : failure as premOptRes

    rule succ-none: C |- ITER premAL QUEST '<-' vari_bound*{vari_bound <- vari_bound*} '->' vari_bind*{vari_bind <- vari_bind*} as premAL : OK C_res as premRes
