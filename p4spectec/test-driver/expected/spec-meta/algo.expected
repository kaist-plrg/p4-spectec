  -- let typRes = $subst_typ(theta, typ)
  -- if typRes <: ok<typ>
  -- let OK typ_subst = typRes as ok<typ>

  clause 3 : (C, typ, val) = OK val as castRes
  -- if typ matches VAR % %
  -- let VAR id targ*{targ <- targ*} = typ
  -- let typDef'?{typDef' <- typDef'?} = $find_typ(C, id)
  -- if typDef'?{typDef' <- typDef'?} matches (_)
  -- let ?(typDef) = typDef'?{typDef' <- typDef'?}
