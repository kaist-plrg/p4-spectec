def $ruls_of_rulgroup(rulGroupAL) : rulAL* =

  clause 0 : (id ':' rulAL*{rulAL <- rulAL*}) = rulAL*{rulAL <- rulAL*}

def $ruls_of_rulgroups(rulGroupAL*) : rulAL* =

  clause 0 : (rulGroupAL*{rulGroupAL <- rulGroupAL*}) = []
  -- if rulGroupAL*{rulGroupAL <- rulGroupAL*} matches []

  clause 1 : (rulGroupAL*{rulGroupAL <- rulGroupAL*}) = $ruls_of_rulgroup(rulGroupAL_h) ++ $ruls_of_rulgroups(rulGroupAL_t*{rulGroupAL_t <- rulGroupAL_t*})
  -- if rulGroupAL*{rulGroupAL <- rulGroupAL*} matches _ :: _
  -- let rulGroupAL_h :: rulGroupAL_t*{rulGroupAL_t <- rulGroupAL_t*} = rulGroupAL*{rulGroupAL <- rulGroupAL*}

def $rul_of_elsgroup(elsGroupAL) : rulAL =

  clause 0 : (id ':' rulAL) = rulAL

