  -- let VARIANT typCase*{typCase <- typCase*} = deftyp
  -- let `{ id_local ':' typDef_local*{id_local <- id_local*, typDef_local <- typDef_local*} `} = C.LOCAL.TYP
  -- let tdenv = $adds_map<id, typDef>(C.GLOBAL.TYP, id_local*{id_local <- id_local*}, typDef_local*{typDef_local <- typDef_local*})
  -- if (OK true as subtypRes = $subtyp(C.GLOBAL.FUNC, tdenv, VAR id targ*{targ <- targ*}, val))

  clause 4 : (C, typ, val) = OK val as castRes
  -- if typ matches VAR % %
  -- let VAR id targ*{targ <- targ*} = typ
  -- let typDef'?{typDef' <- typDef'?} = $find_typ(C, id)
  -- if typDef'?{typDef' <- typDef'?} matches (_)
  -- let ?(typDef) = typDef'?{typDef' <- typDef'?}
  -- if typDef <: definedTypDefn
  -- let TYP _id tparam*{tparam <- tparam*} '=' deftyp = typDef as definedTypDefn
  -- if deftyp matches STRUCT %
  -- let STRUCT typField*{typField <- typField*} = deftyp
  -- let `{ id_local ':' typDef_local*{id_local <- id_local*, typDef_local <- typDef_local*} `} = C.LOCAL.TYP
  -- let tdenv = $adds_map<id, typDef>(C.GLOBAL.TYP, id_local*{id_local <- id_local*}, typDef_local*{typDef_local <- typDef_local*})
  -- if (OK true as subtypRes = $subtyp(C.GLOBAL.FUNC, tdenv, VAR id targ*{targ <- targ*}, val))

  clause 5 : (C, typ, val) = OK EXT json as castRes
  -- if typ matches VAR % %
  -- let VAR id targ*{targ <- targ*} = typ
  -- if targ*{targ <- targ*} matches []
  -- if val matches EXT %
  -- let EXT json = val
  -- let typDef'?{typDef' <- typDef'?} = $find_typ(C, id)
  -- if typDef'?{typDef' <- typDef'?} matches (_)
  -- let ?(typDef) = typDef'?{typDef' <- typDef'?}
  -- if typDef <: externTypDefn
  -- let EXTTYP _id = typDef as externTypDefn

  clause 6 : (C, typ', val') = OK TUP val_cast*{val_cast <- val_cast*} as castRes
  -- if typ' matches TUP %
  -- let TUP typ*{typ <- typ*} = typ'
  -- if val' matches TUP %
  -- let TUP val*{val <- val*} = val'
  -- let castsRes = $downcasts(C, typ*{typ <- typ*}, val*{val <- val*})
  -- if castsRes <: ok<val*>
  -- let OK val_cast*{val_cast <- val_cast*} = castsRes as ok<val*>

  clause 7 : (C, typ', val) = OK OPT ?() as castRes
