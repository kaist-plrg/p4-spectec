def $upto_from(nat, nat) : nat* =

  clause 0 : (n_from, n) = []
  -- if (n_from >= n)

  clause 1 : (n_from, n) = n_from :: $upto_from((n_from + 1), n)
  -- if (n_from < n)

def $upto(nat) : nat* =

  clause 0 : (n) = $upto_from(0, n)

