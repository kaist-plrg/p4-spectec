def $premILs_of(premPart*) : premIL* =

  clause 0 : (premPart*{premPart <- premPart*}) = []
  -- if premPart*{premPart <- premPart*} matches []

  clause 1 : (premPart'*{premPart' <- premPart'*}) = premIL :: $premILs_of(premPart_t*{premPart_t <- premPart_t*})
  -- if premPart'*{premPart' <- premPart'*} matches _ :: _
  -- let premPart :: premPart_t*{premPart_t <- premPart_t*} = premPart'*{premPart' <- premPart'*}
  -- if premPart matches PREM %
  -- let PREM premIL = premPart

  clause 2 : (premPart'*{premPart' <- premPart'*}) = $premILs_of(premPart_t*{premPart_t <- premPart_t*})
  -- if premPart'*{premPart' <- premPart'*} matches _ :: _
  -- let premPart :: premPart_t*{premPart_t <- premPart_t*} = premPart'*{premPart' <- premPart'*}
  -- if premPart matches DECLARE

  clause 3 : (premPart'*{premPart' <- premPart'*}) = $premILs_of(premPart_t*{premPart_t <- premPart_t*})
  -- if premPart'*{premPart' <- premPart'*} matches _ :: _
  -- let premPart :: premPart_t*{premPart_t <- premPart_t*} = premPart'*{premPart' <- premPart'*}
  -- if premPart matches ELSE

def $count_otherwise(premPart*) : nat =

  clause 0 : (premPart*{premPart <- premPart*}) = 0
  -- if premPart*{premPart <- premPart*} matches []

  clause 1 : (premPart'*{premPart' <- premPart'*}) = ($count_otherwise(premPart_t*{premPart_t <- premPart_t*}) + 1)
  -- if premPart'*{premPart' <- premPart'*} matches _ :: _
  -- let premPart :: premPart_t*{premPart_t <- premPart_t*} = premPart'*{premPart' <- premPart'*}
  -- if premPart matches ELSE

  clause 2 : (premPart*{premPart <- premPart*}) = $count_otherwise(premPart_t*{premPart_t <- premPart_t*})
  -- if premPart*{premPart <- premPart*} matches _ :: _
  -- let premPart_h :: premPart_t*{premPart_t <- premPart_t*} = premPart*{premPart <- premPart*}
  -- if (premPart_h =/= ELSE)

