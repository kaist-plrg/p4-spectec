  clause 8 : (C, typ', val'') = OK OPT ?(val_cast) as castRes
  -- if typ' matches ITER % %
  -- let ITER typ iter = typ'
  -- if iter matches QUEST
  -- if val'' matches OPT %
  -- let OPT val'?{val' <- val'?} = val''
  -- if val'?{val' <- val'?} matches (_)
  -- let ?(val) = val'?{val' <- val'?}
  -- let castRes = $downcast(C, typ, val)
  -- if castRes <: ok<val>
  -- let OK val_cast = castRes as ok<val>

  clause 9 : (C, typ', val') = OK LIST val_cast*{val_cast <- val_cast*} as castRes
  -- if typ' matches ITER % %
  -- let ITER typ iter = typ'
  -- if iter matches STAR
  -- if val' matches LIST %
  -- let LIST val*{val <- val*} = val'
  -- let castsRes = $downcasts(C, $repeat_<typ>(typ, |val*{val <- val*}|), val*{val <- val*})
  -- if castsRes <: ok<val*>
  -- let OK val_cast*{val_cast <- val_cast*} = castsRes as ok<val*>

  clause 10 : (C, typ, val) = OK BOOL b as castRes
  -- if typ <: optyp
  -- let optyp = typ as optyp
  -- if optyp matches BOOL
  -- if val matches BOOL %
  -- let BOOL b = val

  clause 11 : (C, typ, val) = OK TEXT t as castRes
  -- if typ <: optyp
  -- let optyp = typ as optyp
  -- if optyp matches TEXT
  -- if val matches TEXT %
  -- let TEXT t = val

  clause 12 : (C, typ, val) = OK num as val as castRes
  -- if typ <: numtyp
  -- let numtyp = typ as numtyp
  -- if numtyp matches INT
  -- if val <: num
  -- let num = val as num

  clause 13 : (C, typ', val) = OK FUNC id as castRes
  -- if typ' matches FUNC % % %
  -- let FUNC tparam*{tparam <- tparam*} typ*{typ <- typ*} typ_ret = typ'
  -- if val matches FUNC %
  -- let FUNC id = val
  -- let `{ id_local ':' typDef_local*{id_local <- id_local*, typDef_local <- typDef_local*} `} = C.LOCAL.TYP
  -- let tdenv = $adds_map<id, typDef>(C.GLOBAL.TYP, id_local*{id_local <- id_local*}, typDef_local*{typDef_local <- typDef_local*})
  -- if (OK true as subtypRes = $subtyp(C.GLOBAL.FUNC, tdenv, FUNC tparam*{tparam <- tparam*} typ*{typ <- typ*} typ_ret, FUNC id))

  clause -1 : (C, typ, val) = ERROR as castRes

def $downcasts(ctx, typ*, val*) : castsRes =

  clause 0 : (C, typ*{typ <- typ*}, val*{val <- val*}) = OK [] as castsRes
  -- if typ*{typ <- typ*} matches []
  -- if val*{val <- val*} matches []

  clause 1 : (C, typ*{typ <- typ*}, val*{val <- val*}) = OK val_cast :: val_t_cast*{val_t_cast <- val_t_cast*} as castsRes
  -- if typ*{typ <- typ*} matches _ :: _
  -- let typ_h :: typ_t*{typ_t <- typ_t*} = typ*{typ <- typ*}
  -- if val*{val <- val*} matches _ :: _
  -- let val_h :: val_t*{val_t <- val_t*} = val*{val <- val*}
  -- let castRes = $downcast(C, typ_h, val_h)
  -- if castRes <: ok<val>
  -- let OK val_cast = castRes as ok<val>
  -- let castsRes = $downcasts(C, typ_t*{typ_t <- typ_t*}, val_t*{val_t <- val_t*})
  -- if castsRes <: ok<val*>
  -- let OK val_t_cast*{val_t_cast <- val_t_cast*} = castsRes as ok<val*>

  clause -1 : (C, typ*{typ <- typ*}, val*{val <- val*}) = ERROR as castsRes

syntax assignRes =
   | OK ctx (from ok<ctx>)
   | ERROR (from error)

