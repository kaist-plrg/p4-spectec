def $numUnOp(numUnOp, num) : val =

  clause 0 : (numUnOp, num) = NAT n as val
  -- if numUnOp matches PLUS
  -- if num matches NAT %
  -- let NAT n = num

  clause 1 : (numUnOp, num) = INT i as val
  -- if numUnOp matches PLUS
  -- if num matches INT %
  -- let INT i = num

  clause 2 : (numUnOp, num) = INT -n as int as val
  -- if numUnOp matches MINUS
  -- if num matches NAT %
  -- let NAT n = num

  clause 3 : (numUnOp, num) = INT -i as val
  -- if numUnOp matches MINUS
  -- if num matches INT %
  -- let INT i = num

def $boolBinOp(boolBinOp, bool, bool) : bool =

  clause 0 : (boolBinOp, b_l, b_r) = (b_l /\ b_r)
  -- if boolBinOp matches AND

  clause 1 : (boolBinOp, b_l, b_r) = (b_l \/ b_r)
  -- if boolBinOp matches OR

  clause 2 : (boolBinOp, b_l, b_r) = (b_l => b_r)
  -- if boolBinOp matches IMPL

  clause 3 : (boolBinOp, b_l, b_r) = (b_l <=> b_r)
  -- if boolBinOp matches EQUIV

syntax numBinOpRes =
   | OK val (from ok<val>)
   | ERROR (from error)

def $numBinOp(numBinOp, num, num) : numBinOpRes =

  clause 0 : (numBinOp, num, num') = OK NAT (n_l + n_r) as val as numBinOpRes
  -- if numBinOp matches ADD
  -- if num matches NAT %
  -- let NAT n_l = num
  -- if num' matches NAT %
  -- let NAT n_r = num'

  clause 1 : (numBinOp, num, num') = OK INT (i_l + i_r) as val as numBinOpRes
  -- if numBinOp matches ADD
  -- if num matches INT %
  -- let INT i_l = num
  -- if num' matches INT %
  -- let INT i_r = num'

  clause 2 : (numBinOp, num, num') = OK INT (n_l - n_r) as val as numBinOpRes
  -- if numBinOp matches SUB
  -- if num matches NAT %
  -- let NAT n_l = num
  -- if num' matches NAT %
  -- let NAT n_r = num'

  clause 3 : (numBinOp, num, num') = OK INT (i_l - i_r) as val as numBinOpRes
  -- if numBinOp matches SUB
  -- if num matches INT %
  -- let INT i_l = num
  -- if num' matches INT %
  -- let INT i_r = num'

  clause 4 : (numBinOp, num, num') = OK NAT (n_l * n_r) as val as numBinOpRes
  -- if numBinOp matches MUL
  -- if num matches NAT %
  -- let NAT n_l = num
  -- if num' matches NAT %
  -- let NAT n_r = num'

  clause 5 : (numBinOp, num, num') = OK INT (i_l * i_r) as val as numBinOpRes
  -- if numBinOp matches MUL
  -- if num matches INT %
  -- let INT i_l = num
  -- if num' matches INT %
  -- let INT i_r = num'

  clause 6 : (numBinOp, num, num') = OK NAT (n_l / n_r) as val as numBinOpRes
  -- if numBinOp matches DIV
  -- if num matches NAT %
  -- let NAT n_l = num
  -- if num' matches NAT %
  -- let NAT n_r = num'
  -- if (n_r =/= 0)

  clause 7 : (numBinOp, num, num') = OK INT (i_l / i_r) as val as numBinOpRes
  -- if numBinOp matches DIV
  -- if num matches INT %
  -- let INT i_l = num
  -- if num' matches INT %
  -- let INT i_r = num'
  -- if (i_r =/= +0)

  clause 8 : (numBinOp, num, num') = OK NAT (n_l \ n_r) as val as numBinOpRes
  -- if numBinOp matches MOD
  -- if num matches NAT %
  -- let NAT n_l = num
  -- if num' matches NAT %
  -- let NAT n_r = num'
  -- if (n_r =/= 0)

  clause 9 : (numBinOp, num, num') = OK INT (i_l \ i_r) as val as numBinOpRes
  -- if numBinOp matches MOD
  -- if num matches INT %
  -- let INT i_l = num
  -- if num' matches INT %
  -- let INT i_r = num'
  -- if (i_r =/= +0)

  clause -1 : (numBinOp, num_l, num_r) = ERROR as numBinOpRes

def $polyCmpOp(polyCmpOp, val, val) : bool =

  clause 0 : (polyCmpOp, val_l, val_r) = (val_l = val_r)
  -- if polyCmpOp matches EQ

  clause 1 : (polyCmpOp, val_l, val_r) = (val_l =/= val_r)
  -- if polyCmpOp matches NE

syntax numCmpRes =
   | OK bool (from ok<bool>)
   | ERROR (from error)

def $numCmpOp(numCmpOp, num, num) : numCmpRes =

  clause 0 : (numCmpOp, num, num') = OK (n_l < n_r) as numCmpRes
  -- if numCmpOp matches LT
  -- if num matches NAT %
  -- let NAT n_l = num
  -- if num' matches NAT %
  -- let NAT n_r = num'

  clause 1 : (numCmpOp, num, num') = OK (i_l < i_r) as numCmpRes
  -- if numCmpOp matches LT
  -- if num matches INT %
  -- let INT i_l = num
  -- if num' matches INT %
  -- let INT i_r = num'

  clause 2 : (numCmpOp, num, num') = OK (n_l > n_r) as numCmpRes
  -- if numCmpOp matches GT
  -- if num matches NAT %
  -- let NAT n_l = num
  -- if num' matches NAT %
  -- let NAT n_r = num'

  clause 3 : (numCmpOp, num, num') = OK (i_l > i_r) as numCmpRes
  -- if numCmpOp matches GT
  -- if num matches INT %
  -- let INT i_l = num
  -- if num' matches INT %
  -- let INT i_r = num'

  clause 4 : (numCmpOp, num, num') = OK (n_l <= n_r) as numCmpRes
  -- if numCmpOp matches LE
  -- if num matches NAT %
  -- let NAT n_l = num
  -- if num' matches NAT %
  -- let NAT n_r = num'

  clause 5 : (numCmpOp, num, num') = OK (i_l <= i_r) as numCmpRes
  -- if numCmpOp matches LE
  -- if num matches INT %
  -- let INT i_l = num
  -- if num' matches INT %
  -- let INT i_r = num'

  clause 6 : (numCmpOp, num, num') = OK (n_l >= n_r) as numCmpRes
  -- if numCmpOp matches GE
  -- if num matches NAT %
  -- let NAT n_l = num
  -- if num' matches NAT %
  -- let NAT n_r = num'

  clause 7 : (numCmpOp, num, num') = OK (i_l >= i_r) as numCmpRes
  -- if numCmpOp matches GE
  -- if num matches INT %
  -- let INT i_l = num
  -- if num' matches INT %
  -- let INT i_r = num'

  clause -1 : (numCmpOp, num_l, num_r) = ERROR as numCmpRes

def $matches(val, pat) : bool =

  clause 0 : (val', pat) = (mixop_v = mixop_p)
  -- if val' matches INJ %
  -- let INJ mixop_v val*{val <- val*} = val'
  -- if pat matches INJ %
  -- let INJ mixop_p = pat

  clause 1 : (val', pat) = (|val*{val <- val*}| > 0)
  -- if val' matches LIST %
  -- let LIST val*{val <- val*} = val'
  -- if pat <: listPat
  -- let listPat = pat as listPat
  -- if listPat matches CONS

  clause 2 : (val', pat) = (|val*{val <- val*}| = n)
  -- if val' matches LIST %
  -- let LIST val*{val <- val*} = val'
  -- if pat <: listPat
  -- let listPat = pat as listPat
  -- if listPat matches FIXED %
  -- let FIXED n = listPat

  clause 3 : (val', pat) = (|val*{val <- val*}| = 0)
  -- if val' matches LIST %
  -- let LIST val*{val <- val*} = val'
  -- if pat <: listPat
  -- let listPat = pat as listPat
  -- if listPat matches NIL

  clause 4 : (val', pat) = (val?{val <- val?} =/= ?())
  -- if val' matches OPT %
  -- let OPT val?{val <- val?} = val'
  -- if pat <: optPat
  -- let optPat = pat as optPat
  -- if optPat matches SOME

  clause 5 : (val', pat) = (val?{val <- val?} = ?())
  -- if val' matches OPT %
  -- let OPT val?{val <- val?} = val'
  -- if pat <: optPat
  -- let optPat = pat as optPat
  -- if optPat matches NONE

  clause -1 : (val, pat) = false

syntax subtypRes =
   | OK bool (from ok<bool>)
   | ERROR (from error)

def $subtyp(fenv, tdenv, typ, val) : subtypRes =

  clause 0 : (fenv, tdenv, typ, val) = OK true as subtypRes
  -- if typ <: optyp
  -- let optyp = typ as optyp
  -- if optyp matches BOOL
  -- if val matches BOOL %
  -- let BOOL b = val

  clause 1 : (fenv, tdenv, typ, val) = OK true as subtypRes
  -- if typ <: numtyp
  -- let numtyp = typ as numtyp
  -- if numtyp matches NAT
  -- if val <: num
  -- let num = val as num
  -- if num matches NAT %
  -- let NAT n = num

  clause 2 : (fenv, tdenv, typ, val) = OK (i >= 0 as int) as subtypRes
  -- if typ <: numtyp
  -- let numtyp = typ as numtyp
  -- if numtyp matches NAT
  -- if val <: num
  -- let num = val as num
  -- if num matches INT %
  -- let INT i = num

  clause 3 : (fenv, tdenv, typ, val) = OK true as subtypRes
  -- if typ <: numtyp
  -- let numtyp = typ as numtyp
  -- if numtyp matches INT
  -- if val <: num
  -- let num = val as num

  clause 4 : (fenv, tdenv, typ, val) = OK true as subtypRes
  -- if typ <: optyp
  -- let optyp = typ as optyp
  -- if optyp matches TEXT
  -- if val matches TEXT %
  -- let TEXT t = val

  clause 5 : (fenv, tdenv, typ, val) = $subtyp_var(fenv, tdenv, id, targ*{targ <- targ*}, val)
  -- if typ matches VAR % %
  -- let VAR id targ*{targ <- targ*} = typ

  clause 6 : (fenv, tdenv, typ', val') = $subtyps(fenv, tdenv, typ*{typ <- typ*}, val*{val <- val*})
  -- if typ' matches TUP %
  -- let TUP typ*{typ <- typ*} = typ'
  -- if val' matches TUP %
  -- let TUP val*{val <- val*} = val'

  clause 7 : (fenv, tdenv, typ', val'') = $subtyp(fenv, tdenv, typ, val)
  -- if typ' matches ITER % %
  -- let ITER typ iter = typ'
  -- if iter matches QUEST
  -- if val'' matches OPT %
  -- let OPT val'?{val' <- val'?} = val''
  -- if val'?{val' <- val'?} matches (_)
  -- let ?(val) = val'?{val' <- val'?}

  clause 8 : (fenv, tdenv, typ', val) = OK true as subtypRes
  -- if typ' matches ITER % %
  -- let ITER typ iter = typ'
  -- if iter matches QUEST
  -- if (val = OPT ?())

  clause 9 : (fenv, tdenv, typ', val') = $subtyp_list(fenv, tdenv, typ, val*{val <- val*})
  -- if typ' matches ITER % %
  -- let ITER typ iter = typ'
  -- if iter matches STAR
  -- if val' matches LIST %
  -- let LIST val*{val <- val*} = val'

  clause 10 : (fenv, tdenv, typ', val) = $subtyp_func(fenv, tdenv, FUNC tparam*{tparam <- tparam*} typ*{typ <- typ*} typ_ret, id)
  -- if typ' matches FUNC % % %
  -- let FUNC tparam*{tparam <- tparam*} typ*{typ <- typ*} typ_ret = typ'
  -- if val matches FUNC %
  -- let FUNC id = val

  clause -1 : (fenv, tdenv, typ, val) = OK false as subtypRes

def $subtyp_var(fenv, tdenv, id, typ*, val) : subtypRes =

  clause 0 : (fenv, tdenv, id, targ*{targ <- targ*}, val) = $subtyp_def(fenv, tdenv, typDef, targ*{targ <- targ*}, val)
  -- let typDef'?{typDef' <- typDef'?} = $find_map<id, typDef>(tdenv, id)
  -- if typDef'?{typDef' <- typDef'?} matches (_)
  -- let ?(typDef) = typDef'?{typDef' <- typDef'?}

  clause -1 : (fenv, tdenv, id, targ*{targ <- targ*}, val) = ERROR as subtypRes

def $subtyp_def(fenv, tdenv, typDef, typ*, val) : subtypRes =

  clause 0 : (fenv, tdenv, typDef, typ*{typ <- typ*}, val) = $subtyp_extern(val)
  -- if typDef <: externTypDefn
  -- let EXTTYP _id = typDef as externTypDefn
  -- if typ*{typ <- typ*} matches []

  clause 1 : (fenv, tdenv, typDef, targ*{targ <- targ*}, val) = $subtyp(fenv, tdenv, typ_subst, val)
  -- if typDef <: definedTypDefn
  -- let TYP _id tparam*{tparam <- tparam*} '=' deftyp = typDef as definedTypDefn
  -- if deftyp matches ALIAS %
  -- let ALIAS typ = deftyp
  -- if (|targ*{targ <- targ*}| = |tparam*{tparam <- tparam*}|)
  -- let theta = `{ tparam ':' targ*{targ <- targ*, tparam <- tparam*} `}
  -- let typRes = $subst_typ(theta, typ)
  -- if typRes <: ok<typ>
  -- let OK typ_subst = typRes as ok<typ>

  clause 2 : (fenv, tdenv, typDef, targ*{targ <- targ*}, val) = $subtyp_variant(fenv, tdenv, theta, typCase*{typCase <- typCase*}, val)
  -- if typDef <: definedTypDefn
  -- let TYP _id tparam*{tparam <- tparam*} '=' deftyp = typDef as definedTypDefn
  -- if deftyp matches VARIANT %
  -- let VARIANT typCase*{typCase <- typCase*} = deftyp
  -- if (|targ*{targ <- targ*}| = |tparam*{tparam <- tparam*}|)
  -- let theta = `{ tparam ':' targ*{targ <- targ*, tparam <- tparam*} `}

  clause 3 : (fenv, tdenv, typDef, targ*{targ <- targ*}, val) = $subtyp_struct(fenv, tdenv, theta, typField*{typField <- typField*}, val)
  -- if typDef <: definedTypDefn
  -- let TYP _id tparam*{tparam <- tparam*} '=' deftyp = typDef as definedTypDefn
  -- if deftyp matches STRUCT %
  -- let STRUCT typField*{typField <- typField*} = deftyp
  -- if (|targ*{targ <- targ*}| = |tparam*{tparam <- tparam*}|)
  -- let theta = `{ tparam ':' targ*{targ <- targ*, tparam <- tparam*} `}

  clause -1 : (fenv, tdenv, typDef, targ*{targ <- targ*}, val) = ERROR as subtypRes

def $subtyp_extern(val) : subtypRes =

  clause 0 : (val) = OK true as subtypRes
  -- if val matches EXT %
  -- let EXT json = val

  clause -1 : (val) = OK false as subtypRes

def $subtyp_variant(fenv, tdenv, theta, typCase*, val) : subtypRes =

  clause 0 : (fenv, tdenv, theta, typCase*{typCase <- typCase*}, val') = $subtyp_case(fenv, tdenv, theta, typ_case_found*{typ_case_found <- typ_case_found*}, val*{val <- val*})
  -- if val' matches INJ %
  -- let INJ mixop val*{val <- val*} = val'
  -- (let mixop_case typ_case*{typ_case <- typ_case*} = typCase)*{typCase <- typCase*, mixop_case -> mixop_case*, typ_case* -> typ_case**}
  -- let typ*{typ <- typ*}?{typ* <- typ*?} = $assoc_<mixop, typ*>(mixop, (mixop_case, typ_case*{typ_case <- typ_case*})*{mixop_case <- mixop_case*, typ_case* <- typ_case**})
  -- if typ*{typ <- typ*}?{typ* <- typ*?} matches (_)
  -- let ?(typ_case_found*{typ_case_found <- typ_case_found*}) = typ*{typ <- typ*}?{typ* <- typ*?}

  clause -1 : (fenv, tdenv, theta, typCase*{typCase <- typCase*}, val) = OK false as subtypRes

def $subtyp_struct(fenv, tdenv, theta, typField*, val) : subtypRes =

  clause 0 : (fenv, tdenv, theta, typField*{typField <- typField*}, val) = $subtyp_case(fenv, tdenv, theta, typ_field*{typ_field <- typ_field*}, val_field*{val_field <- val_field*})
  -- if val matches STR %
  -- let STR valField*{valField <- valField*} = val
  -- (let atom typ_field = typField)*{typField <- typField*, atom -> atom*, typ_field -> typ_field*}
  -- (let atom' val_field = valField)*{valField <- valField*, atom' -> atom'*, val_field -> val_field*}
  -- if (|atom*{atom <- atom*}| = |atom'*{atom' <- atom'*}|)
  -- (if (atom' = atom))*{atom <- atom*, atom' <- atom'*}

  clause -1 : (fenv, tdenv, theta, typField*{typField <- typField*}, val) = OK false as subtypRes

def $subtyp_case(fenv, tdenv, theta, typ*, val*) : subtypRes =

  clause 0 : (fenv, tdenv, theta, typ*{typ <- typ*}, val*{val <- val*}) = $subtyps(fenv, tdenv, typ_subst*{typ_subst <- typ_subst*}, val*{val <- val*})
  -- let typsRes = $subst_typs(theta, typ*{typ <- typ*})
  -- if typsRes <: ok<typ*>
  -- let OK typ_subst*{typ_subst <- typ_subst*} = typsRes as ok<typ*>

  clause -1 : (fenv, tdenv, theta, typ*{typ <- typ*}, val*{val <- val*}) = ERROR as subtypRes

def $subtyps(fenv, tdenv, typ*, val*) : subtypRes =

  clause 0 : (fenv, tdenv, typ*{typ <- typ*}, val*{val <- val*}) = OK true as subtypRes
  -- if typ*{typ <- typ*} matches []
  -- if val*{val <- val*} matches []

  clause 1 : (fenv, tdenv, typ*{typ <- typ*}, val*{val <- val*}) = $subtyps(fenv, tdenv, typ_t*{typ_t <- typ_t*}, val_t*{val_t <- val_t*})
  -- if typ*{typ <- typ*} matches _ :: _
  -- let typ_h :: typ_t*{typ_t <- typ_t*} = typ*{typ <- typ*}
  -- if val*{val <- val*} matches _ :: _
  -- let val_h :: val_t*{val_t <- val_t*} = val*{val <- val*}
  -- if (OK true as subtypRes = $subtyp(fenv, tdenv, typ_h, val_h))

  clause 2 : (fenv, tdenv, typ*{typ <- typ*}, val*{val <- val*}) = subtypRes
  -- if typ*{typ <- typ*} matches _ :: _
  -- let typ_h :: typ_t*{typ_t <- typ_t*} = typ*{typ <- typ*}
  -- if val*{val <- val*} matches _ :: _
  -- let val_h :: val_t*{val_t <- val_t*} = val*{val <- val*}
  -- let subtypRes = $subtyp(fenv, tdenv, typ_h, val_h)
  -- if (subtypRes =/= OK true as subtypRes)

  clause 3 : (fenv, tdenv, typ*{typ <- typ*}, val*{val <- val*}) = OK false as subtypRes
  -- if typ*{typ <- typ*} matches []
  -- if val*{val <- val*} matches _ :: _
  -- let val_h :: val_t*{val_t <- val_t*} = val*{val <- val*}

  clause 4 : (fenv, tdenv, typ*{typ <- typ*}, val*{val <- val*}) = OK false as subtypRes
  -- if typ*{typ <- typ*} matches _ :: _
  -- let typ_h :: typ_t*{typ_t <- typ_t*} = typ*{typ <- typ*}
  -- if val*{val <- val*} matches []

def $subtyp_list(fenv, tdenv, typ, val*) : subtypRes =

  clause 0 : (fenv, tdenv, typ, val*{val <- val*}) = OK true as subtypRes
  -- if val*{val <- val*} matches []

  clause 1 : (fenv, tdenv, typ, val*{val <- val*}) = $subtyp_list(fenv, tdenv, typ, val_t*{val_t <- val_t*})
  -- if val*{val <- val*} matches _ :: _
  -- let val_h :: val_t*{val_t <- val_t*} = val*{val <- val*}
  -- if (OK true as subtypRes = $subtyp(fenv, tdenv, typ, val_h))

  clause 2 : (fenv, tdenv, typ, val*{val <- val*}) = subtypRes
  -- if val*{val <- val*} matches _ :: _
  -- let val_h :: val_t*{val_t <- val_t*} = val*{val <- val*}
  -- let subtypRes = $subtyp(fenv, tdenv, typ, val_h)
  -- if (subtypRes =/= OK true as subtypRes)

def $subtyp_func(fenv, tdenv, typ, id) : subtypRes =

  clause 0 : (fenv, tdenv, typ, id) = $equiv_func_typ(tdenv, typ, $func_typ(funcDefnAL)) as subtypRes
  -- let funcDefnAL'?{funcDefnAL' <- funcDefnAL'?} = $find_map<id, funcDefnAL>(fenv, id)
  -- if funcDefnAL'?{funcDefnAL' <- funcDefnAL'?} matches (_)
  -- let ?(funcDefnAL) = funcDefnAL'?{funcDefnAL' <- funcDefnAL'?}

  clause -1 : (fenv, tdenv, typ, id) = ERROR as subtypRes

def $param_typ(param) : typ =

  clause 0 : (param) = typ
  -- if param <: expParam
  -- let EXP typ = param as expParam

  clause 1 : (param') = FUNC tparam*{tparam <- tparam*} $param_typ(param)*{param <- param*} typ
  -- if param' <: funParam
  -- let FUN id ':' tparam*{tparam <- tparam*} param*{param <- param*} '->' typ = param' as funParam

def $func_typ(funcDefnAL) : typ =

  clause 0 : (funcDefnAL) = FUNC tparam*{tparam <- tparam*} $param_typ(param)*{param <- param*} typ
  -- if funcDefnAL <: externFuncDefn
  -- let EXTFUNC id tparam*{tparam <- tparam*} param*{param <- param*} ':' typ = funcDefnAL as externFuncDefn

  clause 1 : (funcDefnAL) = FUNC tparam*{tparam <- tparam*} $param_typ(param)*{param <- param*} typ
  -- if funcDefnAL <: builtinFuncDefn
  -- let BUILTINFUNC id tparam*{tparam <- tparam*} param*{param <- param*} ':' typ = funcDefnAL as builtinFuncDefn

  clause 2 : (funcDefnAL) = FUNC [] $param_typ(param)*{param <- param*} typ
  -- if funcDefnAL <: tableFuncDefnAL
  -- let TABLEFUNC _id param*{param <- param*} ':' typ '=' tblRowAL*{tblRowAL <- tblRowAL*} = funcDefnAL as tableFuncDefnAL

  clause 3 : (funcDefnAL) = FUNC tparam*{tparam <- tparam*} $param_typ(param)*{param <- param*} typ
  -- if funcDefnAL <: definedFuncDefnAL
  -- let FUNC _id tparam*{tparam <- tparam*} param*{param <- param*} ':' typ '=' clauseAL*{clauseAL <- clauseAL*} elsClauseAL?{elsClauseAL <- elsClauseAL?} = funcDefnAL as definedFuncDefnAL

syntax castRes =
   | OK val (from ok<val>)
   | ERROR (from error)

syntax castsRes =
   | OK val* (from ok<val*>)
   | ERROR (from error)

def $upcast(ctx, typ, val) : castRes =

  clause 0 : (C, typ, val) = OK INT i as val as castRes
  -- if typ <: numtyp
  -- let numtyp = typ as numtyp
  -- if numtyp matches INT
  -- if val <: num
  -- let num = val as num
  -- if num matches INT %
  -- let INT i = num

  clause 1 : (C, typ, val) = OK INT n as int as val as castRes
  -- if typ <: numtyp
  -- let numtyp = typ as numtyp
  -- if numtyp matches INT
  -- if val <: num
  -- let num = val as num
  -- if num matches NAT %
  -- let NAT n = num

  clause 2 : (C, typ', val) = $upcast(C, typ_subst, val)
