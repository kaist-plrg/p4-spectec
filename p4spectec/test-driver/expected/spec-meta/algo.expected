  -- let INJ mixop val*{val <- val*} = val'
  -- (let mixop_case typ_case*{typ_case <- typ_case*} FROM _typOrigin = typCase)*{typCase <- typCase*, _typOrigin -> _typOrigin*, mixop_case -> mixop_case*, typ_case* -> typ_case**}
