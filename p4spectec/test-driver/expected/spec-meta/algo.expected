var b : bool

var i : int

var n : nat

var t : text

def $ite<X>(bool, X, X) : X =

  clause 0 : (b, X_t, X_f) = X_t
  -- if (b = true)

  clause 1 : (b, X_t, X_f) = X_f
  -- if (b = false)

def $deopt_<X>(X?, X) : X =

  clause 0 : (X?{X <- X?}, X_d) = X_d
  -- if X?{X <- X?} matches ()

  clause 1 : (X'?{X' <- X'?}, X_d) = X
  -- if X'?{X' <- X'?} matches (_)
  -- let ?(X) = X'?{X' <- X'?}

def $exists_(bool*) : bool =

  clause 0 : (b*{b <- b*}) = false
  -- if b*{b <- b*} matches []

  clause 1 : (b*{b <- b*}) = (b_h \/ $exists_(b_t*{b_t <- b_t*}))
  -- if b*{b <- b*} matches _ :: _
  -- let b_h :: b_t*{b_t <- b_t*} = b*{b <- b*}

def $forall_(bool*) : bool =

  clause 0 : (b*{b <- b*}) = true
  -- if b*{b <- b*} matches []

  clause 1 : (b*{b <- b*}) = (b_h /\ $forall_(b_t*{b_t <- b_t*}))
  -- if b*{b <- b*} matches _ :: _
  -- let b_h :: b_t*{b_t <- b_t*} = b*{b <- b*}

def $repeat_<X>(X, nat) : X* =

  clause 0 : (X, n) = []
  -- if (n = 0)

  clause 1 : (X, n) = [X] ++ $repeat_<X>(X, n')
  -- if (n =/= 0)
  -- let i = (n - 1)
  -- if i <: nat
  -- let n' = i as nat

builtin def $concat_<X>(X**) : X*

builtin def $assoc_<X, Y>(X, (X, Y)*) : Y?

def $transpose_<X>(X**) : X** =

  clause 0 : (X*{X <- X*}*{X* <- X**}) = []
  -- if X*{X <- X*}*{X* <- X**} matches []

  clause 1 : (X'*{X' <- X'*}*{X'* <- X'**}) = []
  -- if X'*{X' <- X'*}*{X'* <- X'**} matches _ :: _
  -- let X*{X <- X*} :: X_t*{X_t <- X_t*}*{X_t* <- X_t**} = X'*{X' <- X'*}*{X'* <- X'**}
  -- if X*{X <- X*} matches []
  -- if $forall_((X_t*{X_t <- X_t*} = [])*{X_t* <- X_t**})

  clause 2 : (X*{X <- X*}*{X* <- X**}) = X_h*{X_h <- X_h*} :: X_trans*{X_trans <- X_trans*}*{X_trans* <- X_trans**}
  -- (if X*{X <- X*} matches _ :: _)*{X* <- X**}
  -- (let X_h :: X_t*{X_t <- X_t*} = X*{X <- X*})*{X* <- X**, X_h -> X_h*, X_t* -> X_t**}
  -- if (X_h*{X_h <- X_h*} =/= [])
  -- let X_trans*{X_trans <- X_trans*}*{X_trans* <- X_trans**} = $transpose_<X>(X_t*{X_t <- X_t*}*{X_t* <- X_t**})

def $intersect_<X>(X*, X*) : X* =

  clause 0 : (X*{X <- X*}, _X*{_X <- _X*}) = []
  -- if X*{X <- X*} matches []

  clause 1 : (X*{X <- X*}, X_in*{X_in <- X_in*}) = X_h :: $intersect_<X>(X_t*{X_t <- X_t*}, X_in*{X_in <- X_in*})
  -- if X*{X <- X*} matches _ :: _
  -- let X_h :: X_t*{X_t <- X_t*} = X*{X <- X*}
  -- if X_h <- X_in*{X_in <- X_in*}

  clause 2 : (X*{X <- X*}, X_in*{X_in <- X_in*}) = $intersect_<X>(X_t*{X_t <- X_t*}, X_in*{X_in <- X_in*})
  -- if X*{X <- X*} matches _ :: _
  -- let X_h :: X_t*{X_t <- X_t*} = X*{X <- X*}
  -- if ~X_h <- X_in*{X_in <- X_in*}

syntax set<K> =
   | `{ K* `} (from set<K>)

syntax pair<K, V> =
   | K ':' V (from pair<K, V>)

syntax map<K, V> = set<pair<K, V>>

def $empty_map<K, V> : map<K, V> =

  clause 0 :  = `{ [] `}

builtin def $find_map<K, V>(map<K, V>, K) : V?

builtin def $add_map<K, V>(map<K, V>, K, V) : map<K, V>

def $adds_map<K, V>(map<K, V>, K*, V*) : map<K, V> =

  clause 0 : (`{ K ':' V*{K <- K*, V <- V*} `}, K'*{K' <- K'*}, V'*{V' <- V'*}) = `{ K ':' V*{K <- K*, V <- V*} `}
  -- if K'*{K' <- K'*} matches []
  -- if V'*{V' <- V'*} matches []

  clause 1 : (`{ K ':' V*{K <- K*, V <- V*} `}, K'*{K' <- K'*}, V'*{V' <- V'*}) = $adds_map<K, V>($add_map<K, V>(`{ K ':' V*{K <- K*, V <- V*} `}, K_h, V_h), K_t*{K_t <- K_t*}, V_t*{V_t <- V_t*})
  -- if K'*{K' <- K'*} matches _ :: _
  -- let K_h :: K_t*{K_t <- K_t*} = K'*{K' <- K'*}
  -- if V'*{V' <- V'*} matches _ :: _
  -- let V_h :: V_t*{V_t <- V_t*} = V'*{V' <- V'*}

syntax id = text

syntax atom = text

syntax num =
   | NAT nat (from num)
   | INT int (from num)

syntax numtyp =
   | NAT (from numtyp)
   | INT (from numtyp)

syntax iter =
   | QUEST (from iter)
   | STAR (from iter)

syntax tparam = id

syntax boolUnOp =
   | NOT (from boolUnOp)

syntax numUnOp =
   | PLUS (from numUnOp)
   | MINUS (from numUnOp)

syntax unOp =
   | NOT (from boolUnOp)
   | PLUS (from numUnOp)
   | MINUS (from numUnOp)

syntax boolBinOp =
   | AND (from boolBinOp)
   | OR (from boolBinOp)
   | IMPL (from boolBinOp)
   | EQUIV (from boolBinOp)

syntax numBinOp =
   | ADD (from numBinOp)
   | SUB (from numBinOp)
   | MUL (from numBinOp)
   | DIV (from numBinOp)
   | MOD (from numBinOp)
   | POW (from numBinOp)

syntax binOp =
   | AND (from boolBinOp)
   | OR (from boolBinOp)
   | IMPL (from boolBinOp)
   | EQUIV (from boolBinOp)
   | ADD (from numBinOp)
   | SUB (from numBinOp)
   | MUL (from numBinOp)
   | DIV (from numBinOp)
   | MOD (from numBinOp)
   | POW (from numBinOp)

syntax numCmpOp =
   | LT (from numCmpOp)
   | GT (from numCmpOp)
   | LE (from numCmpOp)
   | GE (from numCmpOp)

syntax polyCmpOp =
   | EQ (from polyCmpOp)
   | NE (from polyCmpOp)

syntax cmpOp =
   | EQ (from polyCmpOp)
   | NE (from polyCmpOp)
   | LT (from numCmpOp)
   | GT (from numCmpOp)
   | LE (from numCmpOp)
   | GE (from numCmpOp)

syntax mixop =
   | ARG (from mixop)
   | ATOM atom (from mixop)
   | BRACK atom mixop atom (from mixop)
   | INFIX mixop atom mixop (from mixop)
   | SEQ mixop* (from mixop)

syntax optyp =
   | BOOL (from optyp)
   | NAT (from numtyp)
   | INT (from numtyp)
   | TEXT (from optyp)

syntax typ =
   | BOOL (from optyp)
   | NAT (from numtyp)
   | INT (from numtyp)
   | TEXT (from optyp)
   | VAR id targ* (from typ)
   | TUP typ* (from typ)
   | ITER typ iter (from typ)
   | FUNC tparam* typ* typ (from typ)

syntax deftyp =
   | ALIAS typ (from deftyp)
   | STRUCT typField* (from deftyp)
   | VARIANT typCase* (from deftyp)

syntax typField =
   | atom typ (from typField)

syntax typCase =
   | mixop typ* (from typCase)

syntax vari =
   | id typ iter* (from vari)

syntax listPat =
   | CONS (from listPat)
   | FIXED nat (from listPat)
   | NIL (from listPat)

syntax optPat =
   | SOME (from optPat)
   | NONE (from optPat)

syntax pat =
   | INJ mixop (from pat)
   | CONS (from listPat)
   | FIXED nat (from listPat)
   | NIL (from listPat)
   | SOME (from optPat)
   | NONE (from optPat)

syntax typedExp =
   | exp '#' typ (from typedExp)

syntax literalExp =
   | BOOL bool (from literalExp)
   | NAT nat (from num)
   | INT int (from num)
   | TEXT text (from literalExp)

syntax varExp =
   | VAR id (from varExp)

syntax unOpExp =
   | UN unOp typedExp (from unOpExp)

syntax binOpExp =
   | BIN binOp typedExp typedExp (from binOpExp)

syntax cmpOpExp =
   | CMP cmpOp typedExp typedExp (from cmpOpExp)

syntax opExp =
   | UN unOp typedExp (from unOpExp)
   | BIN binOp typedExp typedExp (from binOpExp)
   | CMP cmpOp typedExp typedExp (from cmpOpExp)

syntax upCastExp =
   | UPCAST typ typedExp (from upCastExp)

syntax downCastExp =
   | DOWNCAST typ typedExp (from downCastExp)

syntax castExp =
   | UPCAST typ typedExp (from upCastExp)
   | DOWNCAST typ typedExp (from downCastExp)

syntax subExp =
   | SUB typedExp typ (from subExp)

syntax matchExp =
   | MATCH typedExp pat (from matchExp)

syntax tupExp =
   | TUP typedExp* (from tupExp)

syntax injExp =
   | INJ expCase (from injExp)

syntax strExp =
   | STR expField* (from strExp)

syntax optExp =
   | OPT typedExp? (from optExp)

syntax listExp =
   | LIST typedExp* (from listExp)

syntax consExp =
   | CONS typedExp typedExp (from consExp)

syntax catExp =
   | CAT typedExp typedExp (from catExp)

syntax memExp =
   | MEM typedExp typedExp (from memExp)

syntax lenExp =
   | LEN typedExp (from lenExp)

syntax dotAccExp =
   | DOT typedExp atom (from dotAccExp)

syntax idxAccExp =
   | IDX typedExp typedExp (from idxAccExp)

syntax sliceAccExp =
   | SLICE typedExp typedExp typedExp (from sliceAccExp)

syntax accExp =
   | DOT typedExp atom (from dotAccExp)
   | IDX typedExp typedExp (from idxAccExp)
   | SLICE typedExp typedExp typedExp (from sliceAccExp)

syntax updExp =
   | UPD typedExp typedPath typedExp (from updExp)

syntax callExp =
   | CALL id targ* arg* (from callExp)

syntax iterExp =
   | ITER typedExp expIter (from iterExp)

syntax exp =
   | BOOL bool (from literalExp)
   | NAT nat (from num)
   | INT int (from num)
   | TEXT text (from literalExp)
   | VAR id (from varExp)
   | UN unOp typedExp (from unOpExp)
   | BIN binOp typedExp typedExp (from binOpExp)
   | CMP cmpOp typedExp typedExp (from cmpOpExp)
   | UPCAST typ typedExp (from upCastExp)
   | DOWNCAST typ typedExp (from downCastExp)
   | SUB typedExp typ (from subExp)
   | MATCH typedExp pat (from matchExp)
   | TUP typedExp* (from tupExp)
   | INJ expCase (from injExp)
   | STR expField* (from strExp)
   | OPT typedExp? (from optExp)
   | LIST typedExp* (from listExp)
   | CONS typedExp typedExp (from consExp)
   | CAT typedExp typedExp (from catExp)
   | MEM typedExp typedExp (from memExp)
   | LEN typedExp (from lenExp)
   | DOT typedExp atom (from dotAccExp)
   | IDX typedExp typedExp (from idxAccExp)
   | SLICE typedExp typedExp typedExp (from sliceAccExp)
   | UPD typedExp typedPath typedExp (from updExp)
   | CALL id targ* arg* (from callExp)
   | ITER typedExp expIter (from iterExp)

syntax expCase =
   | mixop typedExp* (from expCase)

syntax expField =
   | atom typedExp (from expField)

syntax expIter =
   | iter vari* (from expIter)

syntax typedPath =
   | path '#' typ (from typedPath)

syntax rootPath =
   | ROOT (from rootPath)

syntax idxPath =
   | IDX typedPath typedExp (from idxPath)

syntax slicePath =
   | SLICE typedPath typedExp typedExp (from slicePath)

syntax dotPath =
   | DOT typedPath atom (from dotPath)

syntax path =
   | ROOT (from rootPath)
   | IDX typedPath typedExp (from idxPath)
   | SLICE typedPath typedExp typedExp (from slicePath)
   | DOT typedPath atom (from dotPath)

syntax targ = typ

syntax expArg =
   | EXP typedExp (from expArg)

syntax funArg =
   | FUN id (from funArg)

syntax arg =
   | EXP typedExp (from expArg)
   | FUN id (from funArg)

syntax expParam =
   | EXP typ (from expParam)

syntax funParam =
   | FUN id ':' tparam* param* '->' typ (from funParam)

syntax param =
   | EXP typ (from expParam)
   | FUN id ':' tparam* param* '->' typ (from funParam)

syntax ifPrem =
   | IF typedExp (from ifPrem)

syntax ifHoldPrem =
   | IFHOLD id ':' typedExp* (from ifHoldPrem)

syntax ifNotHoldPrem =
   | IFNOTHOLD id ':' typedExp* (from ifNotHoldPrem)

syntax debugPrem =
   | DEBUG typedExp (from debugPrem)

syntax externTypDefn =
   | EXTTYP id (from externTypDefn)

syntax definedTypDefn =
   | TYP id tparam* '=' deftyp (from definedTypDefn)

syntax typDefn =
   | EXTTYP id (from externTypDefn)
   | TYP id tparam* '=' deftyp (from definedTypDefn)

syntax externFuncDefn =
   | EXTFUNC id tparam* param* ':' typ (from externFuncDefn)

syntax builtinFuncDefn =
   | BUILTINFUNC id tparam* param* ':' typ (from builtinFuncDefn)

syntax inputHint = nat*

syntax premIterIL =
   | iter vari* (from premIterIL)

syntax relPremIL =
   | REL id ':' typedExp* `( inputHint `) (from relPremIL)

syntax iterPremIL =
   | ITER premIL premIterIL (from iterPremIL)

syntax premIL =
   | REL id ':' typedExp* `( inputHint `) (from relPremIL)
   | IF typedExp (from ifPrem)
   | IFHOLD id ':' typedExp* (from ifHoldPrem)
   | IFNOTHOLD id ':' typedExp* (from ifNotHoldPrem)
   | ITER premIL premIterIL (from iterPremIL)
   | DEBUG typedExp (from debugPrem)

syntax externRelDefnIL =
   | EXTREL id ':' typ* `( inputHint `) (from externRelDefnIL)

syntax rulIL =
   | id ':' typedExp* '-' premIL* (from rulIL)

syntax rulGroupIL =
   | id ':' rulIL* (from rulGroupIL)

syntax elsGroupIL =
   | id ':' rulIL (from elsGroupIL)

syntax definedRelDefnIL =
   | REL id ':' typ* `( inputHint `) '=' rulGroupIL* elsGroupIL? (from definedRelDefnIL)

syntax relDefnIL =
   | EXTREL id ':' typ* `( inputHint `) (from externRelDefnIL)
   | REL id ':' typ* `( inputHint `) '=' rulGroupIL* elsGroupIL? (from definedRelDefnIL)

syntax tblRowIL =
   | arg* '=' typedExp (from tblRowIL)

syntax tableFuncDefnIL =
   | TABLEFUNC id param* ':' typ '=' tblRowIL* (from tableFuncDefnIL)

syntax clauseIL =
   | arg* '=' typedExp '-' premIL* (from clauseIL)

syntax elsClauseIL = clauseIL

syntax definedFuncDefnIL =
   | FUNC id tparam* param* ':' typ '=' clauseIL* elsClauseIL? (from definedFuncDefnIL)

syntax funcDefnIL =
   | EXTFUNC id tparam* param* ':' typ (from externFuncDefn)
   | BUILTINFUNC id tparam* param* ':' typ (from builtinFuncDefn)
   | TABLEFUNC id param* ':' typ '=' tblRowIL* (from tableFuncDefnIL)
   | FUNC id tparam* param* ':' typ '=' clauseIL* elsClauseIL? (from definedFuncDefnIL)

syntax defnIL =
   | EXTTYP id (from externTypDefn)
   | TYP id tparam* '=' deftyp (from definedTypDefn)
   | EXTREL id ':' typ* `( inputHint `) (from externRelDefnIL)
   | REL id ':' typ* `( inputHint `) '=' rulGroupIL* elsGroupIL? (from definedRelDefnIL)
   | EXTFUNC id tparam* param* ':' typ (from externFuncDefn)
   | BUILTINFUNC id tparam* param* ':' typ (from builtinFuncDefn)
   | TABLEFUNC id param* ':' typ '=' tblRowIL* (from tableFuncDefnIL)
   | FUNC id tparam* param* ':' typ '=' clauseIL* elsClauseIL? (from definedFuncDefnIL)

syntax specIL = defnIL*

syntax premIterAL =
   | iter '<-' vari* '->' vari* (from premIterAL)

syntax relPremAL =
   | REL id ':' typedExp* '->' typedExp* (from relPremAL)

syntax letPremAL =
   | LET typedExp '=' typedExp (from letPremAL)

syntax iterPremAL =
   | ITER premAL premIterAL (from iterPremAL)

syntax premAL =
   | REL id ':' typedExp* '->' typedExp* (from relPremAL)
   | IF typedExp (from ifPrem)
   | IFHOLD id ':' typedExp* (from ifHoldPrem)
   | IFNOTHOLD id ':' typedExp* (from ifNotHoldPrem)
   | LET typedExp '=' typedExp (from letPremAL)
   | ITER premAL premIterAL (from iterPremAL)
   | DEBUG typedExp (from debugPrem)

syntax externRelDefnAL =
   | EXTREL id ':' typ* '->' typ* (from externRelDefnAL)

syntax rulAL =
   | id ':' typedExp* '->' typedExp* '-' premAL* (from rulAL)

syntax rulGroupAL =
   | id ':' rulAL* (from rulGroupAL)

syntax elsGroupAL =
   | id ':' rulAL (from elsGroupAL)

syntax definedRelDefnAL =
   | REL id ':' typ* '->' typ* '=' rulGroupAL* elsGroupAL? (from definedRelDefnAL)

syntax relDefnAL =
   | EXTREL id ':' typ* '->' typ* (from externRelDefnAL)
   | REL id ':' typ* '->' typ* '=' rulGroupAL* elsGroupAL? (from definedRelDefnAL)

syntax tblRowAL =
   | arg* '=' typedExp '-' premAL* (from tblRowAL)

syntax tableFuncDefnAL =
   | TABLEFUNC id param* ':' typ '=' tblRowAL* (from tableFuncDefnAL)

syntax clauseAL =
   | arg* '=' typedExp '-' premAL* (from clauseAL)

syntax elsClauseAL = clauseAL

syntax definedFuncDefnAL =
   | FUNC id tparam* param* ':' typ '=' clauseAL* elsClauseAL? (from definedFuncDefnAL)

syntax funcDefnAL =
   | EXTFUNC id tparam* param* ':' typ (from externFuncDefn)
   | BUILTINFUNC id tparam* param* ':' typ (from builtinFuncDefn)
   | TABLEFUNC id param* ':' typ '=' tblRowAL* (from tableFuncDefnAL)
   | FUNC id tparam* param* ':' typ '=' clauseAL* elsClauseAL? (from definedFuncDefnAL)

syntax defnAL =
   | EXTTYP id (from externTypDefn)
   | TYP id tparam* '=' deftyp (from definedTypDefn)
   | EXTREL id ':' typ* '->' typ* (from externRelDefnAL)
   | REL id ':' typ* '->' typ* '=' rulGroupAL* elsGroupAL? (from definedRelDefnAL)
   | EXTFUNC id tparam* param* ':' typ (from externFuncDefn)
   | BUILTINFUNC id tparam* param* ':' typ (from builtinFuncDefn)
   | TABLEFUNC id param* ':' typ '=' tblRowAL* (from tableFuncDefnAL)
   | FUNC id tparam* param* ':' typ '=' clauseAL* elsClauseAL? (from definedFuncDefnAL)

syntax specAL = defnAL*

extern syntax json

syntax val =
   | BOOL bool (from val)
   | NAT nat (from num)
   | INT int (from num)
   | TEXT text (from val)
   | STR valField* (from val)
   | INJ valCase (from val)
   | TUP val* (from val)
   | OPT val? (from val)
   | LIST val* (from val)
   | FUNC id (from val)
   | EXT json (from val)

syntax valField =
   | atom val (from valField)

syntax valCase =
   | mixop val* (from valCase)

def $fresh(id*, id) : id =

  clause 0 : (id_used*{id_used <- id_used*}, id) = id
  -- if ~id <- id_used*{id_used <- id_used*}

  clause 1 : (id_used*{id_used <- id_used*}, id) = $fresh(id_used*{id_used <- id_used*}, id ++ "'")
  -- if id <- id_used*{id_used <- id_used*}

def $ids_of_varis(vari*) : id* =

  clause 0 : (id _typ _iter*{_iter <- _iter*}*{_iter* <- _iter**, _typ <- _typ*, id <- id*}) = id*{id <- id*}

def $select_varis(vari*, id*) : vari* =

  clause 0 : (vari*{vari <- vari*}, _id*{_id <- _id*}) = []
  -- if vari*{vari <- vari*} matches []

  clause 1 : (vari*{vari <- vari*}, id*{id <- id*}) = vari_h :: $select_varis(vari_t*{vari_t <- vari_t*}, id*{id <- id*})
  -- if vari*{vari <- vari*} matches _ :: _
  -- let vari_h :: vari_t*{vari_t <- vari_t*} = vari*{vari <- vari*}
  -- let id_h _typ _iter*{_iter <- _iter*} = vari_h
  -- if id_h <- id*{id <- id*}

  clause 2 : (vari*{vari <- vari*}, id*{id <- id*}) = $select_varis(vari_t*{vari_t <- vari_t*}, id*{id <- id*})
  -- if vari*{vari <- vari*} matches _ :: _
  -- let vari_h :: vari_t*{vari_t <- vari_t*} = vari*{vari <- vari*}
  -- let id_h _typ _iter*{_iter <- _iter*} = vari_h
  -- if ~id_h <- id*{id <- id*}

def $drop_varis(vari*, id*) : vari* =

  clause 0 : (vari*{vari <- vari*}, _id*{_id <- _id*}) = []
  -- if vari*{vari <- vari*} matches []

  clause 1 : (vari*{vari <- vari*}, id*{id <- id*}) = $drop_varis(vari_t*{vari_t <- vari_t*}, id*{id <- id*})
  -- if vari*{vari <- vari*} matches _ :: _
  -- let vari_h :: vari_t*{vari_t <- vari_t*} = vari*{vari <- vari*}
  -- let id_h _typ _iter*{_iter <- _iter*} = vari_h
  -- if id_h <- id*{id <- id*}

  clause 2 : (vari*{vari <- vari*}, id*{id <- id*}) = vari_h :: $drop_varis(vari_t*{vari_t <- vari_t*}, id*{id <- id*})
  -- if vari*{vari <- vari*} matches _ :: _
  -- let vari_h :: vari_t*{vari_t <- vari_t*} = vari*{vari <- vari*}
  -- let id_h _typ _iter*{_iter <- _iter*} = vari_h
  -- if ~id_h <- id*{id <- id*}

def $iterate_vari(vari, iter*) : vari =

  clause 0 : (id typ iter*{iter <- iter*}, iter_add*{iter_add <- iter_add*}) = id typ iter*{iter <- iter*} ++ iter_add*{iter_add <- iter_add*}

def $is_prefix_dim(vari, vari) : bool =

  clause 0 : (_id typ_a iter_a*{iter_a <- iter_a*}, _id' typ_b iter_b*{iter_b <- iter_b*}) = true
  -- if (typ_a = typ_b)
  -- if (|iter_a*{iter_a <- iter_a*}| <= |iter_b*{iter_b <- iter_b*}|)
  -- if ((0 + |iter_a*{iter_a <- iter_a*}|) <= |iter_b*{iter_b <- iter_b*}|)
  -- if (iter_a*{iter_a <- iter_a*} = iter_b*{iter_b <- iter_b*}[0 : |iter_a*{iter_a <- iter_a*}|])

  clause -1 : (_vari, _vari') = false

def $shallowest_vari(vari, vari*) : vari =

  clause 0 : (vari, vari'*{vari' <- vari'*}) = vari
  -- if vari'*{vari' <- vari'*} matches []

  clause 1 : (vari, vari'*{vari' <- vari'*}) = $shallowest_vari(vari_h, vari_t*{vari_t <- vari_t*})
  -- if vari'*{vari' <- vari'*} matches _ :: _
  -- let vari_h :: vari_t*{vari_t <- vari_t*} = vari'*{vari' <- vari'*}
  -- if $is_prefix_dim(vari_h, vari)

  clause 2 : (vari, vari'*{vari' <- vari'*}) = $shallowest_vari(vari, vari_t*{vari_t <- vari_t*})
  -- if vari'*{vari' <- vari'*} matches _ :: _
  -- let vari_h :: vari_t*{vari_t <- vari_t*} = vari'*{vari' <- vari'*}
  -- if ~$is_prefix_dim(vari_h, vari)

def $shallowest_varis(vari*) : vari* =

  clause 0 : (vari*{vari <- vari*}) = []
  -- if vari*{vari <- vari*} matches []

  clause 1 : (vari*{vari <- vari*}) = vari_min :: $shallowest_varis(vari_rest*{vari_rest <- vari_rest*})
  -- if vari*{vari <- vari*} matches _ :: _
  -- let vari_h :: vari_t*{vari_t <- vari_t*} = vari*{vari <- vari*}
  -- let id_h _typ _iter*{_iter <- _iter*} = vari_h
  -- let vari_same*{vari_same <- vari_same*} = $select_varis(vari_t*{vari_t <- vari_t*}, [id_h])
  -- let vari_rest*{vari_rest <- vari_rest*} = $drop_varis(vari_t*{vari_t <- vari_t*}, [id_h])
  -- let vari_min = $shallowest_vari(vari_h, vari_same*{vari_same <- vari_same*})

syntax typDef =
   | EXTTYP id (from externTypDefn)
   | TYP id tparam* '=' deftyp (from definedTypDefn)
   | PARAM (from typDef)

syntax tdenv = map<id, typDef>

syntax ok<X> =
   | OK X (from ok<X>)

syntax error =
   | ERROR (from error)

syntax unmatch =
   | UNMATCH (from unmatch)

syntax failure =
   | ERROR (from error)
   | UNMATCH (from unmatch)

syntax unitRes =
   | OK (from unitRes)
   | ERROR (from error)

syntax theta = map<id, typ>

def $theta_of_tdenv(tdenv) : theta =

  clause 0 : (set<pair<id, typDef>>) = $empty_map<id, typ>
  -- if (set<pair<id, typDef>> = `{ [] `})

  clause 1 : (`{ pair<id, typDef>*{pair<id, typDef> <- pair<id, typDef>*} `}) = $add_map<id, typ>(theta_t, id_h, typ_h)
  -- if pair<id, typDef>*{pair<id, typDef> <- pair<id, typDef>*} matches _ :: _
  -- let id_h ':' typDef_h :: id_t ':' typDef_t*{id_t <- id_t*, typDef_t <- typDef_t*} = pair<id, typDef>*{pair<id, typDef> <- pair<id, typDef>*}
  -- let typDef = typDef_h
  -- if typDef <: definedTypDefn
  -- let TYP _id tparam*{tparam <- tparam*} '=' deftyp = typDef as definedTypDefn
  -- if tparam*{tparam <- tparam*} matches []
  -- if deftyp matches ALIAS %
  -- let ALIAS typ_h = deftyp
  -- let theta_t = $theta_of_tdenv(`{ id_t ':' typDef_t*{id_t <- id_t*, typDef_t <- typDef_t*} `})

  clause 2 : (`{ pair<id, typDef>*{pair<id, typDef> <- pair<id, typDef>*} `}) = $theta_of_tdenv(`{ id_t ':' typDef_t*{id_t <- id_t*, typDef_t <- typDef_t*} `})
  -- if pair<id, typDef>*{pair<id, typDef> <- pair<id, typDef>*} matches _ :: _
  -- let id_h ':' typDef_h :: id_t ':' typDef_t*{id_t <- id_t*, typDef_t <- typDef_t*} = pair<id, typDef>*{pair<id, typDef> <- pair<id, typDef>*}
  -- if (typDef_h = PARAM)

  clause 3 : (`{ pair<id, typDef>*{pair<id, typDef> <- pair<id, typDef>*} `}) = $theta_of_tdenv(`{ id_t ':' typDef_t*{id_t <- id_t*, typDef_t <- typDef_t*} `})
  -- if pair<id, typDef>*{pair<id, typDef> <- pair<id, typDef>*} matches _ :: _
  -- let id_h ':' typDef :: id_t ':' typDef_t*{id_t <- id_t*, typDef_t <- typDef_t*} = pair<id, typDef>*{pair<id, typDef> <- pair<id, typDef>*}
  -- if typDef <: externTypDefn
  -- let EXTTYP _id = typDef as externTypDefn

  clause 4 : (`{ pair<id, typDef>*{pair<id, typDef> <- pair<id, typDef>*} `}) = $theta_of_tdenv(`{ id_t ':' typDef_t*{id_t <- id_t*, typDef_t <- typDef_t*} `})
  -- if pair<id, typDef>*{pair<id, typDef> <- pair<id, typDef>*} matches _ :: _
  -- let id_h ':' typDef :: id_t ':' typDef_t*{id_t <- id_t*, typDef_t <- typDef_t*} = pair<id, typDef>*{pair<id, typDef> <- pair<id, typDef>*}
  -- if typDef <: definedTypDefn
  -- let TYP _id tparam*{tparam <- tparam*} '=' deftyp = typDef as definedTypDefn
  -- if deftyp matches ALIAS %
  -- let ALIAS typ = deftyp
  -- if (tparam*{tparam <- tparam*} =/= [])

  clause 5 : (`{ pair<id, typDef>*{pair<id, typDef> <- pair<id, typDef>*} `}) = $theta_of_tdenv(`{ id_t ':' typDef_t*{id_t <- id_t*, typDef_t <- typDef_t*} `})
  -- if pair<id, typDef>*{pair<id, typDef> <- pair<id, typDef>*} matches _ :: _
  -- let id_h ':' typDef :: id_t ':' typDef_t*{id_t <- id_t*, typDef_t <- typDef_t*} = pair<id, typDef>*{pair<id, typDef> <- pair<id, typDef>*}
  -- if typDef <: definedTypDefn
  -- let TYP _id tparam*{tparam <- tparam*} '=' deftyp = typDef as definedTypDefn
  -- if deftyp matches STRUCT %
  -- let STRUCT typField*{typField <- typField*} = deftyp

  clause 6 : (`{ pair<id, typDef>*{pair<id, typDef> <- pair<id, typDef>*} `}) = $theta_of_tdenv(`{ id_t ':' typDef_t*{id_t <- id_t*, typDef_t <- typDef_t*} `})
  -- if pair<id, typDef>*{pair<id, typDef> <- pair<id, typDef>*} matches _ :: _
  -- let id_h ':' typDef :: id_t ':' typDef_t*{id_t <- id_t*, typDef_t <- typDef_t*} = pair<id, typDef>*{pair<id, typDef> <- pair<id, typDef>*}
  -- if typDef <: definedTypDefn
  -- let TYP _id tparam*{tparam <- tparam*} '=' deftyp = typDef as definedTypDefn
  -- if deftyp matches VARIANT %
  -- let VARIANT typCase*{typCase <- typCase*} = deftyp

def $ids_typ(typ) : id* =

  clause 0 : (typ') = [id] ++ $ids_typs(typ*{typ <- typ*})
  -- if typ' matches VAR % %
  -- let VAR id typ*{typ <- typ*} = typ'

  clause 1 : (typ') = $ids_typs(typ*{typ <- typ*})
  -- if typ' matches TUP %
  -- let TUP typ*{typ <- typ*} = typ'

  clause 2 : (typ') = $ids_typ(typ)
  -- if typ' matches ITER % %
  -- let ITER typ iter = typ'

  clause 3 : (typ') = tparam*{tparam <- tparam*} ++ $ids_typs(typ*{typ <- typ*}) ++ $ids_typ(typ_ret)
  -- if typ' matches FUNC % % %
  -- let FUNC tparam*{tparam <- tparam*} typ*{typ <- typ*} typ_ret = typ'

  clause -1 : (typ) = []

def $ids_typs(typ*) : id* =

  clause 0 : (typ*{typ <- typ*}) = []
  -- if typ*{typ <- typ*} matches []

  clause 1 : (typ*{typ <- typ*}) = $ids_typ(typ_h) ++ $ids_typs(typ_t*{typ_t <- typ_t*})
  -- if typ*{typ <- typ*} matches _ :: _
  -- let typ_h :: typ_t*{typ_t <- typ_t*} = typ*{typ <- typ*}

def $fresh_ids(id*, id*) : id* =

  clause 0 : (id_used*{id_used <- id_used*}, id*{id <- id*}) = []
  -- if id*{id <- id*} matches []

  clause 1 : (id_used*{id_used <- id_used*}, id*{id <- id*}) = [id_fresh] ++ $fresh_ids([id_fresh] ++ id_used*{id_used <- id_used*}, id_t*{id_t <- id_t*})
  -- if id*{id <- id*} matches _ :: _
  -- let id_h :: id_t*{id_t <- id_t*} = id*{id <- id*}
  -- let id_fresh = $fresh(id_used*{id_used <- id_used*}, id_h)

syntax typRes =
   | OK typ (from ok<typ>)
   | ERROR (from error)

syntax typsRes =
   | OK typ* (from ok<typ*>)
   | ERROR (from error)

def $subst_typ(theta, typ) : typRes =

  clause 0 : (theta, typ) = OK NAT as typ as typRes
  -- if typ <: numtyp
  -- let numtyp = typ as numtyp
  -- if numtyp matches NAT

  clause 1 : (theta, typ) = OK INT as typ as typRes
  -- if typ <: numtyp
  -- let numtyp = typ as numtyp
  -- if numtyp matches INT

  clause 2 : (theta, typ) = OK TEXT as typ as typRes
  -- if typ <: optyp
  -- let optyp = typ as optyp
  -- if optyp matches TEXT

  clause 3 : (theta, typ) = OK BOOL as typ as typRes
  -- if typ <: optyp
  -- let optyp = typ as optyp
  -- if optyp matches BOOL

  clause 4 : (theta, typ') = OK typ as typRes
  -- if typ' matches VAR % %
  -- let VAR id targ*{targ <- targ*} = typ'
  -- if targ*{targ <- targ*} matches []
  -- let typ''?{typ'' <- typ''?} = $find_map<id, typ>(theta, id)
  -- if typ''?{typ'' <- typ''?} matches (_)
  -- let ?(typ) = typ''?{typ'' <- typ''?}

  clause 5 : (theta, typ) = OK VAR id targ_subst*{targ_subst <- targ_subst*} as typRes
  -- if typ matches VAR % %
  -- let VAR id targ*{targ <- targ*} = typ
  -- if (?() = $find_map<id, typ>(theta, id))
  -- let typsRes = $subst_typs(theta, targ*{targ <- targ*})
  -- if typsRes <: ok<typ*>
  -- let OK targ_subst*{targ_subst <- targ_subst*} = typsRes as ok<typ*>

  clause 6 : (theta, typ') = OK TUP typ_subst*{typ_subst <- typ_subst*} as typRes
  -- if typ' matches TUP %
  -- let TUP typ*{typ <- typ*} = typ'
  -- let typsRes = $subst_typs(theta, typ*{typ <- typ*})
  -- if typsRes <: ok<typ*>
  -- let OK typ_subst*{typ_subst <- typ_subst*} = typsRes as ok<typ*>

  clause 7 : (theta, typ') = OK ITER typ_subst iter as typRes
  -- if typ' matches ITER % %
  -- let ITER typ iter = typ'
  -- let typRes = $subst_typ(theta, typ)
  -- if typRes <: ok<typ>
  -- let OK typ_subst = typRes as ok<typ>

  clause 8 : (theta, typ') = OK FUNC tparam_fresh*{tparam_fresh <- tparam_fresh*} typ_subst*{typ_subst <- typ_subst*} typ_ret_subst as typRes
  -- if typ' matches FUNC % % %
  -- let FUNC tparam*{tparam <- tparam*} typ*{typ <- typ*} typ_ret = typ'
  -- let `{ id ':' typ_arg*{id <- id*, typ_arg <- typ_arg*} `} = theta
  -- let id_used*{id_used <- id_used*} = id*{id <- id*} ++ $ids_typs(typ_arg*{typ_arg <- typ_arg*}) ++ $ids_typ(FUNC tparam*{tparam <- tparam*} typ*{typ <- typ*} typ_ret)
  -- let tparam_fresh*{tparam_fresh <- tparam_fresh*} = $fresh_ids(id_used*{id_used <- id_used*}, tparam*{tparam <- tparam*})
  -- if (|tparam*{tparam <- tparam*}| = |tparam_fresh*{tparam_fresh <- tparam_fresh*}|)
  -- let theta_fresh = `{ tparam ':' VAR tparam_fresh []*{tparam <- tparam*, tparam_fresh <- tparam_fresh*} `}
  -- let typsRes = $subst_typs(theta_fresh, typ*{typ <- typ*})
  -- if typsRes <: ok<typ*>
  -- let OK typ_fresh*{typ_fresh <- typ_fresh*} = typsRes as ok<typ*>
  -- let typsRes' = $subst_typs(theta, typ_fresh*{typ_fresh <- typ_fresh*})
  -- if typsRes' <: ok<typ*>
  -- let OK typ_subst*{typ_subst <- typ_subst*} = typsRes' as ok<typ*>
  -- let typRes = $subst_typ(theta_fresh, typ_ret)
  -- if typRes <: ok<typ>
  -- let OK typ_ret_fresh = typRes as ok<typ>
  -- let typRes' = $subst_typ(theta, typ_ret_fresh)
  -- if typRes' <: ok<typ>
  -- let OK typ_ret_subst = typRes' as ok<typ>

  clause -1 : (theta, typ) = ERROR as typRes

def $subst_typs(theta, typ*) : typsRes =

  clause 0 : (theta, typ*{typ <- typ*}) = OK [] as typsRes
  -- if typ*{typ <- typ*} matches []

  clause 1 : (theta, typ*{typ <- typ*}) = OK typ_subst :: typ_t_subst*{typ_t_subst <- typ_t_subst*} as typsRes
  -- if typ*{typ <- typ*} matches _ :: _
  -- let typ_h :: typ_t*{typ_t <- typ_t*} = typ*{typ <- typ*}
  -- let typRes = $subst_typ(theta, typ_h)
  -- if typRes <: ok<typ>
  -- let OK typ_subst = typRes as ok<typ>
  -- let typsRes = $subst_typs(theta, typ_t*{typ_t <- typ_t*})
  -- if typsRes <: ok<typ*>
  -- let OK typ_t_subst*{typ_t_subst <- typ_t_subst*} = typsRes as ok<typ*>

  clause -1 : (theta, typ*{typ <- typ*}) = ERROR as typsRes

def $expand_typ(tdenv, typ) : typRes =

  clause 0 : (tdenv, typ') = $expand_typ(tdenv, typ_subst)
  -- if typ' matches VAR % %
  -- let VAR id targ*{targ <- targ*} = typ'
  -- let typDef'?{typDef' <- typDef'?} = $find_map<id, typDef>(tdenv, id)
  -- if typDef'?{typDef' <- typDef'?} matches (_)
  -- let ?(typDef) = typDef'?{typDef' <- typDef'?}
  -- if typDef <: definedTypDefn
  -- let TYP _id tparam*{tparam <- tparam*} '=' deftyp = typDef as definedTypDefn
  -- if deftyp matches ALIAS %
  -- let ALIAS typ = deftyp
  -- if (|targ*{targ <- targ*}| = |tparam*{tparam <- tparam*}|)
  -- let theta = `{ tparam ':' targ*{targ <- targ*, tparam <- tparam*} `}
  -- let typRes = $subst_typ(theta, typ)
  -- if typRes <: ok<typ>
  -- let OK typ_subst = typRes as ok<typ>

  clause 1 : (tdenv, typ) = OK VAR id targ*{targ <- targ*} as typRes
  -- if typ matches VAR % %
  -- let VAR id targ*{targ <- targ*} = typ
  -- let typDef'?{typDef' <- typDef'?} = $find_map<id, typDef>(tdenv, id)
  -- if typDef'?{typDef' <- typDef'?} matches (_)
  -- let ?(typDef) = typDef'?{typDef' <- typDef'?}
  -- if (typDef = PARAM)
  -- if (targ*{targ <- targ*} = [])

  clause 2 : (tdenv, typ) = OK VAR id [] as typRes
  -- if typ matches VAR % %
  -- let VAR id targ*{targ <- targ*} = typ
  -- if targ*{targ <- targ*} matches []
  -- let typDef'?{typDef' <- typDef'?} = $find_map<id, typDef>(tdenv, id)
  -- if typDef'?{typDef' <- typDef'?} matches (_)
  -- let ?(typDef) = typDef'?{typDef' <- typDef'?}
  -- if typDef <: externTypDefn
  -- let EXTTYP _id = typDef as externTypDefn

  clause 3 : (tdenv, typ) = OK VAR id targ*{targ <- targ*} as typRes
  -- if typ matches VAR % %
  -- let VAR id targ*{targ <- targ*} = typ
  -- let typDef'?{typDef' <- typDef'?} = $find_map<id, typDef>(tdenv, id)
  -- if typDef'?{typDef' <- typDef'?} matches (_)
  -- let ?(typDef) = typDef'?{typDef' <- typDef'?}
  -- if typDef <: definedTypDefn
  -- let TYP _id tparam*{tparam <- tparam*} '=' deftyp = typDef as definedTypDefn
  -- if deftyp matches STRUCT %
  -- let STRUCT typField*{typField <- typField*} = deftyp
  -- if (|tparam*{tparam <- tparam*}| = |targ*{targ <- targ*}|)

  clause 4 : (tdenv, typ) = OK VAR id targ*{targ <- targ*} as typRes
  -- if typ matches VAR % %
  -- let VAR id targ*{targ <- targ*} = typ
  -- let typDef'?{typDef' <- typDef'?} = $find_map<id, typDef>(tdenv, id)
  -- if typDef'?{typDef' <- typDef'?} matches (_)
  -- let ?(typDef) = typDef'?{typDef' <- typDef'?}
  -- if typDef <: definedTypDefn
  -- let TYP _id tparam*{tparam <- tparam*} '=' deftyp = typDef as definedTypDefn
  -- if deftyp matches VARIANT %
  -- let VARIANT typCase*{typCase <- typCase*} = deftyp
  -- if (|tparam*{tparam <- tparam*}| = |targ*{targ <- targ*}|)

  clause 5 : (tdenv, typ) = OK BOOL as typ as typRes
  -- if typ <: optyp
  -- let optyp = typ as optyp
  -- if optyp matches BOOL

  clause 6 : (tdenv, typ) = OK NAT as typ as typRes
  -- if typ <: numtyp
  -- let numtyp = typ as numtyp
  -- if numtyp matches NAT

  clause 7 : (tdenv, typ) = OK INT as typ as typRes
  -- if typ <: numtyp
  -- let numtyp = typ as numtyp
  -- if numtyp matches INT

  clause 8 : (tdenv, typ) = OK TEXT as typ as typRes
  -- if typ <: optyp
  -- let optyp = typ as optyp
  -- if optyp matches TEXT

  clause 9 : (tdenv, typ') = OK TUP typ*{typ <- typ*} as typRes
  -- if typ' matches TUP %
  -- let TUP typ*{typ <- typ*} = typ'

  clause 10 : (tdenv, typ') = OK ITER typ iter as typRes
  -- if typ' matches ITER % %
  -- let ITER typ iter = typ'

  clause 11 : (tdenv, typ') = OK FUNC tparam*{tparam <- tparam*} typ*{typ <- typ*} typ_ret as typRes
  -- if typ' matches FUNC % % %
  -- let FUNC tparam*{tparam <- tparam*} typ*{typ <- typ*} typ_ret = typ'

  clause -1 : (tdenv, typ) = ERROR as typRes

syntax equivRes =
   | OK bool (from ok<bool>)
   | ERROR (from error)

def $equiv_typ(tdenv, typ, typ) : equivRes =

  clause 0 : (tdenv, typ_l, typ_r) = $equiv_typ'(tdenv, typ_l_expand, typ_r_expand)
  -- let typRes = $expand_typ(tdenv, typ_l)
  -- if typRes <: ok<typ>
  -- let OK typ_l_expand = typRes as ok<typ>
  -- let typRes' = $expand_typ(tdenv, typ_r)
  -- if typRes' <: ok<typ>
  -- let OK typ_r_expand = typRes' as ok<typ>

  clause -1 : (tdenv, typ_l, typ_r) = ERROR as equivRes

def $equiv_typs(tdenv, typ*, typ*) : equivRes =

  clause 0 : (tdenv, typ*{typ <- typ*}, typ'*{typ' <- typ'*}) = OK true as equivRes
  -- if typ*{typ <- typ*} matches []
  -- if typ'*{typ' <- typ'*} matches []

  clause 1 : (tdenv, typ*{typ <- typ*}, typ'*{typ' <- typ'*}) = $equiv_typs(tdenv, typ_l_t*{typ_l_t <- typ_l_t*}, typ_r_t*{typ_r_t <- typ_r_t*})
  -- if typ*{typ <- typ*} matches _ :: _
  -- let typ_l :: typ_l_t*{typ_l_t <- typ_l_t*} = typ*{typ <- typ*}
  -- if typ'*{typ' <- typ'*} matches _ :: _
  -- let typ_r :: typ_r_t*{typ_r_t <- typ_r_t*} = typ'*{typ' <- typ'*}
  -- if (OK true as equivRes = $equiv_typ(tdenv, typ_l, typ_r))

  clause 2 : (tdenv, typ*{typ <- typ*}, typ'*{typ' <- typ'*}) = equivRes
  -- if typ*{typ <- typ*} matches _ :: _
  -- let typ_l :: typ_l_t*{typ_l_t <- typ_l_t*} = typ*{typ <- typ*}
  -- if typ'*{typ' <- typ'*} matches _ :: _
  -- let typ_r :: typ_r_t*{typ_r_t <- typ_r_t*} = typ'*{typ' <- typ'*}
  -- let equivRes = $equiv_typ(tdenv, typ_l, typ_r)
  -- if (equivRes =/= OK true as equivRes)

  clause 3 : (tdenv, typ*{typ <- typ*}, typ'*{typ' <- typ'*}) = OK false as equivRes
  -- if typ*{typ <- typ*} matches []
  -- if typ'*{typ' <- typ'*} matches _ :: _
  -- let typ_r :: typ_r_t*{typ_r_t <- typ_r_t*} = typ'*{typ' <- typ'*}

  clause 4 : (tdenv, typ*{typ <- typ*}, typ'*{typ' <- typ'*}) = OK false as equivRes
  -- if typ*{typ <- typ*} matches _ :: _
  -- let typ_l :: typ_l_t*{typ_l_t <- typ_l_t*} = typ*{typ <- typ*}
  -- if typ'*{typ' <- typ'*} matches []

def $equiv_typ'(tdenv, typ, typ) : equivRes =

  clause 0 : (tdenv, typ, typ') = OK true as equivRes
  -- if typ <: optyp
  -- let optyp = typ as optyp
  -- if optyp matches BOOL
  -- if typ' <: optyp
  -- let optyp' = typ' as optyp
  -- if optyp' matches BOOL

  clause 1 : (tdenv, typ, typ') = OK true as equivRes
  -- if typ <: numtyp
  -- let numtyp = typ as numtyp
  -- if numtyp matches NAT
  -- if typ' <: numtyp
  -- let numtyp' = typ' as numtyp
  -- if numtyp' matches NAT

  clause 2 : (tdenv, typ, typ') = OK true as equivRes
  -- if typ <: numtyp
  -- let numtyp = typ as numtyp
  -- if numtyp matches INT
  -- if typ' <: numtyp
  -- let numtyp' = typ' as numtyp
  -- if numtyp' matches INT

  clause 3 : (tdenv, typ, typ') = OK true as equivRes
  -- if typ <: optyp
  -- let optyp = typ as optyp
  -- if optyp matches TEXT
  -- if typ' <: optyp
  -- let optyp' = typ' as optyp
  -- if optyp' matches TEXT

  clause 4 : (tdenv, typ, typ') = $equiv_typs(tdenv, targ_l*{targ_l <- targ_l*}, targ_r*{targ_r <- targ_r*})
  -- if typ matches VAR % %
  -- let VAR id_l targ_l*{targ_l <- targ_l*} = typ
  -- if typ' matches VAR % %
  -- let VAR id_r targ_r*{targ_r <- targ_r*} = typ'
  -- if (id_l = id_r)

  clause 5 : (tdenv, typ, typ') = $equiv_typs(tdenv, typ_l*{typ_l <- typ_l*}, typ_r*{typ_r <- typ_r*})
  -- if typ matches TUP %
  -- let TUP typ_l*{typ_l <- typ_l*} = typ
  -- if typ' matches TUP %
  -- let TUP typ_r*{typ_r <- typ_r*} = typ'

  clause 6 : (tdenv, typ, typ') = $equiv_typ(tdenv, typ_l, typ_r)
  -- if typ matches ITER % %
  -- let ITER typ_l iter_l = typ
  -- if typ' matches ITER % %
  -- let ITER typ_r iter_r = typ'
  -- if (iter_l = iter_r)

  clause -1 : (tdenv, typ_l, typ_r) = OK false as equivRes

def $equiv_func_typ(tdenv, typ, typ) : equivRes =

  clause 0 : (tdenv, typ, typ') = $equiv_typs(tdenv_fresh, typ_l_subst*{typ_l_subst <- typ_l_subst*} ++ [typ_ret_l_subst], typ_r_subst*{typ_r_subst <- typ_r_subst*} ++ [typ_ret_r_subst])
  -- if typ matches FUNC % % %
  -- let FUNC tparam_l*{tparam_l <- tparam_l*} typ_l*{typ_l <- typ_l*} typ_ret_l = typ
  -- if typ' matches FUNC % % %
  -- let FUNC tparam_r*{tparam_r <- tparam_r*} typ_r*{typ_r <- typ_r*} typ_ret_r = typ'
  -- if (|tparam_l*{tparam_l <- tparam_l*}| = |tparam_r*{tparam_r <- tparam_r*}|)
  -- if (|typ_l*{typ_l <- typ_l*}| = |typ_r*{typ_r <- typ_r*}|)
  -- let `{ id ':' typDef*{id <- id*, typDef <- typDef*} `} = tdenv
  -- let id_used*{id_used <- id_used*} = id*{id <- id*} ++ $ids_typ(FUNC tparam_l*{tparam_l <- tparam_l*} typ_l*{typ_l <- typ_l*} typ_ret_l) ++ $ids_typ(FUNC tparam_r*{tparam_r <- tparam_r*} typ_r*{typ_r <- typ_r*} typ_ret_r)
  -- let tparam_fresh*{tparam_fresh <- tparam_fresh*} = $fresh_ids(id_used*{id_used <- id_used*}, tparam_l*{tparam_l <- tparam_l*})
  -- if (|tparam_fresh*{tparam_fresh <- tparam_fresh*}| = |tparam_l*{tparam_l <- tparam_l*}|)
  -- let theta_l = `{ tparam_l ':' VAR tparam_fresh []*{tparam_fresh <- tparam_fresh*, tparam_l <- tparam_l*} `}
  -- let theta_r = `{ tparam_r ':' VAR tparam_fresh []*{tparam_fresh <- tparam_fresh*, tparam_r <- tparam_r*} `}
  -- let typsRes = $subst_typs(theta_l, typ_l*{typ_l <- typ_l*})
  -- if typsRes <: ok<typ*>
  -- let OK typ_l_subst*{typ_l_subst <- typ_l_subst*} = typsRes as ok<typ*>
  -- let typsRes' = $subst_typs(theta_r, typ_r*{typ_r <- typ_r*})
  -- if typsRes' <: ok<typ*>
  -- let OK typ_r_subst*{typ_r_subst <- typ_r_subst*} = typsRes' as ok<typ*>
  -- let typRes = $subst_typ(theta_l, typ_ret_l)
  -- if typRes <: ok<typ>
  -- let OK typ_ret_l_subst = typRes as ok<typ>
  -- let typRes' = $subst_typ(theta_r, typ_ret_r)
  -- if typRes' <: ok<typ>
  -- let OK typ_ret_r_subst = typRes' as ok<typ>
  -- let tdenv_fresh = $adds_map<id, typDef>(tdenv, tparam_fresh*{tparam_fresh <- tparam_fresh*}, $repeat_<typDef>(PARAM, |tparam_fresh*{tparam_fresh <- tparam_fresh*}|))

  clause 1 : (tdenv, typ, typ') = OK false as equivRes
  -- if typ matches FUNC % % %
  -- let FUNC tparam_l*{tparam_l <- tparam_l*} typ_l*{typ_l <- typ_l*} typ_ret_l = typ
  -- if typ' matches FUNC % % %
  -- let FUNC tparam_r*{tparam_r <- tparam_r*} typ_r*{typ_r <- typ_r*} typ_ret_r = typ'
  -- if ((|tparam_l*{tparam_l <- tparam_l*}| =/= |tparam_r*{tparam_r <- tparam_r*}|) \/ (|typ_l*{typ_l <- typ_l*}| =/= |typ_r*{typ_r <- typ_r*}|))

  clause -1 : (tdenv, typ_l, typ_r) = ERROR as equivRes

syntax algoCtx = {TYP tdenv, BOUND vari*, USED id*}

var AC : algoCtx

def $empty_algoCtx : algoCtx =

  clause 0 :  = {TYP $empty_map<id, typDef>, BOUND [], USED []}

def $load_algoCtx(algoCtx, specIL) : algoCtx =

  clause 0 : (AC, defnIL'*{defnIL' <- defnIL'*}) = $load_algoCtx(AC_load, defnIL_t*{defnIL_t <- defnIL_t*})
  -- if defnIL'*{defnIL' <- defnIL'*} matches _ :: _
  -- let defnIL :: defnIL_t*{defnIL_t <- defnIL_t*} = defnIL'*{defnIL' <- defnIL'*}
  -- if defnIL <: externTypDefn
  -- let externTypDefn = defnIL as externTypDefn
  -- let EXTTYP id = externTypDefn
  -- let tdenv_update = $add_map<id, typDef>(AC.TYP, id, externTypDefn as typDef)
  -- let AC_load = AC[TYP = tdenv_update]

  clause 1 : (AC, defnIL'*{defnIL' <- defnIL'*}) = $load_algoCtx(AC_load, defnIL_t*{defnIL_t <- defnIL_t*})
  -- if defnIL'*{defnIL' <- defnIL'*} matches _ :: _
  -- let defnIL :: defnIL_t*{defnIL_t <- defnIL_t*} = defnIL'*{defnIL' <- defnIL'*}
  -- if defnIL <: definedTypDefn
  -- let definedTypDefn = defnIL as definedTypDefn
  -- let TYP id _tparam*{_tparam <- _tparam*} '=' _deftyp = definedTypDefn
  -- let tdenv_update = $add_map<id, typDef>(AC.TYP, id, definedTypDefn as typDef)
  -- let AC_load = AC[TYP = tdenv_update]

  clause 2 : (AC, defnIL'*{defnIL' <- defnIL'*}) = $load_algoCtx(AC, defnIL_t*{defnIL_t <- defnIL_t*})
  -- if defnIL'*{defnIL' <- defnIL'*} matches _ :: _
  -- let defnIL :: defnIL_t*{defnIL_t <- defnIL_t*} = defnIL'*{defnIL' <- defnIL'*}
  -- if defnIL <: relDefnIL
  -- let relDefnIL = defnIL as relDefnIL

  clause 3 : (AC, defnIL'*{defnIL' <- defnIL'*}) = $load_algoCtx(AC, defnIL_t*{defnIL_t <- defnIL_t*})
  -- if defnIL'*{defnIL' <- defnIL'*} matches _ :: _
  -- let defnIL :: defnIL_t*{defnIL_t <- defnIL_t*} = defnIL'*{defnIL' <- defnIL'*}
  -- if defnIL <: funcDefnIL
  -- let funcDefnIL = defnIL as funcDefnIL

  clause 4 : (AC, defnIL*{defnIL <- defnIL*}) = AC
  -- if defnIL*{defnIL <- defnIL*} matches []

def $add_bound(algoCtx, vari*) : algoCtx =

  clause 0 : (AC, vari*{vari <- vari*}) = AC[BOUND = AC.BOUND ++ vari*{vari <- vari*}]

def $add_used(algoCtx, id*) : algoCtx =

  clause 0 : (AC, id*{id <- id*}) = AC[USED = AC.USED ++ id*{id <- id*}]

def $add_tparams(algoCtx, tparam*) : algoCtx =

  clause 0 : (AC, tparam*{tparam <- tparam*}) = AC[TYP = tdenv]
  -- let typDef*{typDef <- typDef*} = $repeat_<typDef>(PARAM, |tparam*{tparam <- tparam*}|)
  -- let tdenv = $adds_map<id, typDef>(AC.TYP, tparam*{tparam <- tparam*}, typDef*{typDef <- typDef*})

def $fresh_id(id*) : (id*, id) =

  clause 0 : (id_used*{id_used <- id_used*}) = (id_used*{id_used <- id_used*} ++ [id_fresh], id_fresh)
  -- let id_fresh = $fresh(id_used*{id_used <- id_used*}, "fresh")

syntax iterCtx = premIterIL*

var IC : iterCtx

def $add_iterated(iterCtx, vari*) : iterCtx =

  clause 0 : (premIterIL*{premIterIL <- premIterIL*}, _vari*{_vari <- _vari*}) = []
  -- if premIterIL*{premIterIL <- premIterIL*} matches []

  clause 1 : (premIterIL*{premIterIL <- premIterIL*}, vari_new*{vari_new <- vari_new*}) = iter vari*{vari <- vari*} ++ vari_add*{vari_add <- vari_add*} :: IC_outer
  -- if premIterIL*{premIterIL <- premIterIL*} matches _ :: _
  -- let iter vari*{vari <- vari*} :: IC = premIterIL*{premIterIL <- premIterIL*}
  -- let vari_add*{vari_add <- vari_add*} = $drop_varis(vari_new*{vari_new <- vari_new*}, $ids_of_varis(vari*{vari <- vari*}))
  -- (let vari_lift = $iterate_vari(vari_new, [iter]))*{vari_new <- vari_new*, vari_lift -> vari_lift*}
  -- let IC_outer = $add_iterated(IC, vari_lift*{vari_lift <- vari_lift*})

def $prem_iters(iterCtx, id*, id*) : premIterAL* =

  clause 0 : (premIterIL*{premIterIL <- premIterIL*}, _id*{_id <- _id*}, _id'*{_id' <- _id'*}) = []
  -- if premIterIL*{premIterIL <- premIterIL*} matches []

  clause 1 : (premIterIL*{premIterIL <- premIterIL*}, id_read*{id_read <- id_read*}, id_bind*{id_bind <- id_bind*}) = premIterAL_inner :: premIterAL_outer*{premIterAL_outer <- premIterAL_outer*}
  -- if premIterIL*{premIterIL <- premIterIL*} matches _ :: _
  -- let iter vari*{vari <- vari*} :: IC = premIterIL*{premIterIL <- premIterIL*}
  -- let vari_read*{vari_read <- vari_read*} = $select_varis(vari*{vari <- vari*}, id_read*{id_read <- id_read*})
  -- let vari_bind*{vari_bind <- vari_bind*} = $select_varis(vari*{vari <- vari*}, id_bind*{id_bind <- id_bind*})
  -- let premIterAL_inner = iter '<-' vari_read*{vari_read <- vari_read*} '->' vari_bind*{vari_bind <- vari_bind*}
  -- let premIterAL_outer*{premIterAL_outer <- premIterAL_outer*} = $prem_iters(IC, id_read*{id_read <- id_read*}, id_bind*{id_bind <- id_bind*})

def $iterate_prem(premAL, premIterAL*) : premAL =

  clause 0 : (premAL, premIterAL*{premIterAL <- premIterAL*}) = premAL
  -- if premIterAL*{premIterAL <- premIterAL*} matches []

  clause 1 : (premAL, premIterAL'*{premIterAL' <- premIterAL'*}) = $iterate_prem(ITER premAL premIterAL as premAL, premIterAL_t*{premIterAL_t <- premIterAL_t*})
  -- if premIterAL'*{premIterAL' <- premIterAL'*} matches _ :: _
  -- let premIterAL :: premIterAL_t*{premIterAL_t <- premIterAL_t*} = premIterAL'*{premIterAL' <- premIterAL'*}

def $split_inputs<X>(inputHint, X*) : (X*, X*) =

  clause 0 : (n*{n <- n*}, X*{X <- X*}) = $split_inputs_from<X>(n*{n <- n*}, 0, X*{X <- X*})
  -- if $forall_((n < |X*{X <- X*}|)*{n <- n*})

def $split_inputs_from<X>(inputHint, nat, X*) : (X*, X*) =

  clause 0 : (_inputHint, _n, X*{X <- X*}) = ([], [])
  -- if X*{X <- X*} matches []

  clause 1 : (n*{n <- n*}, n_pos, X*{X <- X*}) = (X_h :: X_in*{X_in <- X_in*}, X_out*{X_out <- X_out*})
  -- if X*{X <- X*} matches _ :: _
  -- let X_h :: X_t*{X_t <- X_t*} = X*{X <- X*}
  -- if n_pos <- n*{n <- n*}
  -- let (X_in*{X_in <- X_in*}, X_out*{X_out <- X_out*}) = $split_inputs_from<X>(n*{n <- n*}, (n_pos + 1), X_t*{X_t <- X_t*})

  clause 2 : (n*{n <- n*}, n_pos, X*{X <- X*}) = (X_in*{X_in <- X_in*}, X_h :: X_out*{X_out <- X_out*})
  -- if X*{X <- X*} matches _ :: _
  -- let X_h :: X_t*{X_t <- X_t*} = X*{X <- X*}
  -- if ~n_pos <- n*{n <- n*}
  -- let (X_in*{X_in <- X_in*}, X_out*{X_out <- X_out*}) = $split_inputs_from<X>(n*{n <- n*}, (n_pos + 1), X_t*{X_t <- X_t*})

