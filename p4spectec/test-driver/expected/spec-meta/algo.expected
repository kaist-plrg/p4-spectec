syntax subListRes =
   | OK ctx* (from ok<ctx*>)
   | ERROR (from error)

def $sub_list(ctx, vari*) : subListRes =

  clause 0 : (C, vari*{vari <- vari*}) = OK C_sub*{C_sub <- C_sub*} as subListRes
  -- (let vari_iter = $iterate_vari(vari, [STAR]))*{vari <- vari*, vari_iter -> vari_iter*}
