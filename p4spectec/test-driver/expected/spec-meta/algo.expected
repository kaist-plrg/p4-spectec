def $ruls_of_rulgroup(rulGroup) : rul* =

  clause 0 : (id ':' rul*{rul <- rul*}) = rul*{rul <- rul*}

def $ruls_of_rulgroups(rulGroup*) : rul* =

  clause 0 : (rulGroup*{rulGroup <- rulGroup*}) = []
  -- if rulGroup*{rulGroup <- rulGroup*} matches []

  clause 1 : (rulGroup*{rulGroup <- rulGroup*}) = $ruls_of_rulgroup(rulGroup_h) ++ $ruls_of_rulgroups(rulGroup_t*{rulGroup_t <- rulGroup_t*})
  -- if rulGroup*{rulGroup <- rulGroup*} matches _ :: _
  -- let rulGroup_h :: rulGroup_t*{rulGroup_t <- rulGroup_t*} = rulGroup*{rulGroup <- rulGroup*}

def $rul_of_elsgroup(elsGroup) : rul =

  clause 0 : (id ':' rul) = rul

