def $sideconds_multi_binder(iterCtx, vari, id*) : premAL* =

  clause 0 : (IC, vari, id_later*{id_later <- id_later*}) = $sidecond_multi_binder(IC, vari, id_later)*{id_later <- id_later*}

def $sidecond_multi_binder(iterCtx, vari, id) : premAL =

  clause 0 : (IC, id_first typ iter*{iter <- iter*}, id_later) = $iterate_prem(premAL_cmp, premIterAL*{premIterAL <- premIterAL*})
  -- let typedExp_first = VAR id_first as exp '#' typ
