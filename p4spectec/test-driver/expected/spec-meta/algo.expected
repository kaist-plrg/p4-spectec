    -- if Prem_pure: |- premAL holds
    -- the relation holds

  rulegroup dbg

   match

    (signature) |- DEBUG typedExp as premAL
    |- premAL
    -- if premAL <: debugPrem
    -- let DEBUG typedExp = premAL as debugPrem

   paths

    rulepath dbg
    -- if Exp_pure: |- typedExp holds
    -- the relation holds

relation Otherwise_pure: |- defnAL

  rulegroup typ

   match

    (signature) |- typDefn as defnAL
    |- defnAL
    -- if defnAL <: typDefn
    -- let typDefn = defnAL as typDefn

   paths

    rulepath typ
    -- the relation holds

  rulegroup rel

   match

    (signature) |- defnAL
    |- defnAL

   paths

    rulepath extern
    -- let defnAL' = defnAL
    -- if defnAL' <: externRelDefnAL
    -- let externRelDefnAL = defnAL' as externRelDefnAL
    -- the relation holds

    rulepath none
    -- let defnAL' = defnAL
    -- if defnAL' <: definedRelDefnAL
    -- let REL _id ':' _typ*{_typ <- _typ*} '->' _typ'*{_typ' <- _typ'*} '=' _rulGroupAL*{_rulGroupAL <- _rulGroupAL*} elsGroupAL'?{elsGroupAL' <- elsGroupAL'?} = defnAL' as definedRelDefnAL
    -- if elsGroupAL'?{elsGroupAL' <- elsGroupAL'?} matches ()
    -- the relation holds

    rulepath else
    -- let defnAL' = defnAL
    -- if defnAL' <: definedRelDefnAL
    -- let REL _id ':' _typ*{_typ <- _typ*} '->' _typ'*{_typ' <- _typ'*} '=' _rulGroupAL*{_rulGroupAL <- _rulGroupAL*} elsGroupAL'?{elsGroupAL' <- elsGroupAL'?} = defnAL' as definedRelDefnAL
    -- if elsGroupAL'?{elsGroupAL' <- elsGroupAL'?} matches (_)
    -- let ?(elsGroupAL) = elsGroupAL'?{elsGroupAL' <- elsGroupAL'?}
    -- let _id' ':' rulAL = elsGroupAL
    -- let _id'' ':' _typedExp*{_typedExp <- _typedExp*} '->' typedExp_out*{typedExp_out <- typedExp_out*} '-' premAL*{premAL <- premAL*} = rulAL
    -- (if Prem_pure: |- premAL holds)*{premAL <- premAL*}
    -- (if Exp_pure: |- typedExp_out holds)*{typedExp_out <- typedExp_out*}
    -- the relation holds

  rulegroup func

   match

    (signature) |- defnAL
    |- defnAL

   paths

    rulepath extern
    -- let defnAL' = defnAL
    -- if defnAL' <: externFuncDefn
    -- let externFuncDefn = defnAL' as externFuncDefn
    -- the relation holds

    rulepath builtin
    -- let defnAL' = defnAL
    -- if defnAL' <: builtinFuncDefn
    -- let builtinFuncDefn = defnAL' as builtinFuncDefn
    -- the relation holds

    rulepath table
    -- let defnAL' = defnAL
    -- if defnAL' <: tableFuncDefnAL
    -- let tableFuncDefnAL = defnAL' as tableFuncDefnAL
    -- the relation holds

    rulepath none
    -- let defnAL' = defnAL
    -- if defnAL' <: definedFuncDefnAL
    -- let FUNC _id _tparam*{_tparam <- _tparam*} _param*{_param <- _param*} ':' _typ '=' _clauseAL*{_clauseAL <- _clauseAL*} elsClauseAL'?{elsClauseAL' <- elsClauseAL'?} = defnAL' as definedFuncDefnAL
    -- if elsClauseAL'?{elsClauseAL' <- elsClauseAL'?} matches ()
    -- the relation holds

    rulepath else
    -- let defnAL' = defnAL
    -- if defnAL' <: definedFuncDefnAL
    -- let FUNC _id _tparam*{_tparam <- _tparam*} _param*{_param <- _param*} ':' _typ '=' _clauseAL*{_clauseAL <- _clauseAL*} elsClauseAL'?{elsClauseAL' <- elsClauseAL'?} = defnAL' as definedFuncDefnAL
    -- if elsClauseAL'?{elsClauseAL' <- elsClauseAL'?} matches (_)
    -- let ?(elsClauseAL) = elsClauseAL'?{elsClauseAL' <- elsClauseAL'?}
    -- let _arg*{_arg <- _arg*} '=' typedExp '-' premAL*{premAL <- premAL*} = elsClauseAL
    -- (if Prem_pure: |- premAL holds)*{premAL <- premAL*}
    -- if Exp_pure: |- typedExp holds
    -- the relation holds

def $iter_exp(typedExp, vari, iter*) : typedExp =

  clause 0 : (typedExp, _vari, iter*{iter <- iter*}) = typedExp
  -- if iter*{iter <- iter*} matches []

  clause 1 : (typedExp, vari, iter*{iter <- iter*}) = $iter_exp(typedExp_iter, vari_iter, iter_t*{iter_t <- iter_t*})
  -- if iter*{iter <- iter*} matches _ :: _
  -- let iter_h :: iter_t*{iter_t <- iter_t*} = iter*{iter <- iter*}
  -- let _exp '#' typ = typedExp
  -- let iterExp = ITER typedExp iter_h [vari]
  -- let typedExp_iter = iterExp as exp '#' ITER typ iter_h
  -- let vari_iter = $iterate_vari(vari, [iter_h])

def $exp_of_vari(vari) : typedExp =

  clause 0 : (id typ iter*{iter <- iter*}) = $iter_exp(typedExp, id typ [], iter*{iter <- iter*})
  -- let varExp = VAR id
  -- let typedExp = varExp as exp '#' typ

def $is_bound_vari(vari*, vari) : bool =

  clause 0 : (vari*{vari <- vari*}, _vari) = false
  -- if vari*{vari <- vari*} matches []

  clause 1 : (vari'*{vari' <- vari'*}, vari) = true
  -- if vari'*{vari' <- vari'*} matches _ :: _
  -- let vari_h :: _vari*{_vari <- _vari*} = vari'*{vari' <- vari'*}
  -- let id _typ _iter*{_iter <- _iter*} = vari
  -- let id' _typ' _iter'*{_iter' <- _iter'*} = vari_h
  -- if (id' = id)
  -- if $is_prefix_dim(vari_h, vari)

  clause 2 : (vari'*{vari' <- vari'*}, vari) = $is_bound_vari(vari_t*{vari_t <- vari_t*}, vari)
  -- if vari'*{vari' <- vari'*} matches _ :: _
  -- let vari_h :: vari_t*{vari_t <- vari_t*} = vari'*{vari' <- vari'*}
  -- let id _typ _iter*{_iter <- _iter*} = vari
  -- let id_h _typ' _iter'*{_iter' <- _iter'*} = vari_h
  -- if ((id_h =/= id) \/ ~$is_prefix_dim(vari_h, vari))

def $is_bound_varis(algoCtx, iterCtx, vari*) : bool =

  clause 0 : (AC, IC, vari*{vari <- vari*}) = $forall_($is_bound_vari(AC.BOUND, $iterate_vari(vari, iter*{iter <- iter*}))*{vari <- vari*})
  -- let iter _vari*{_vari <- _vari*}*{_vari* <- _vari**, iter <- iter*} = IC

def $is_bound_exp(algoCtx, typedExp) : bool =

  clause 0 : (AC, typedExp) = $forall_(id <- id_bound*{id_bound <- id_bound*}*{id <- id*})
  -- let id*{id <- id*} = $ids_of_varis($free_varis_exp(typedExp))
  -- let id_bound*{id_bound <- id_bound*} = $ids_of_varis(AC.BOUND)

syntax occ = map<id, id*>

syntax renamer = {USED id*, SEEN id*, OCC occ}

var R : renamer

def $init_renamer(id*, vari*) : renamer =

  clause 0 : (id_used*{id_used <- id_used*}, vari*{vari <- vari*}) = {USED id_used*{id_used <- id_used*}, SEEN [], OCC $empty_map<id, id*>}
  -- if vari*{vari <- vari*} matches []

  clause 1 : (id_used*{id_used <- id_used*}, vari*{vari <- vari*}) = R[OCC = occ]
  -- if vari*{vari <- vari*} matches _ :: _
  -- let vari_h :: vari_t*{vari_t <- vari_t*} = vari*{vari <- vari*}
  -- let id_h _typ _iter*{_iter <- _iter*} = vari_h
  -- if ~id_h <- $ids_of_varis(vari_t*{vari_t <- vari_t*})
  -- let R = $init_renamer(id_used*{id_used <- id_used*}, vari_t*{vari_t <- vari_t*})
  -- let occ = $add_map<id, id*>(R.OCC, id_h, [])

  clause 2 : (id_used*{id_used <- id_used*}, vari*{vari <- vari*}) = $init_renamer(id_used*{id_used <- id_used*}, vari_t*{vari_t <- vari_t*})
  -- if vari*{vari <- vari*} matches _ :: _
  -- let vari_h :: vari_t*{vari_t <- vari_t*} = vari*{vari <- vari*}
  -- if vari_h <- vari_t*{vari_t <- vari_t*}

def $rename_exp(renamer, typedExp) : (renamer, typedExp) =

  clause 0 : (R, exp '#' typ) = (R, VAR id as exp '#' typ)
  -- if exp <: varExp
  -- let VAR id = exp as varExp
  -- let `{ id_bind ':' _id*{_id <- _id*}*{_id* <- _id**, id_bind <- id_bind*} `} = R.OCC
  -- if ~id <- id_bind*{id_bind <- id_bind*}

  clause 1 : (R, exp '#' typ) = (R_multi, VAR id as exp '#' typ)
  -- if exp <: varExp
  -- let VAR id = exp as varExp
  -- let id'*{id' <- id'*}?{id'* <- id'*?} = $find_map<id, id*>(R.OCC, id)
  -- if id'*{id' <- id'*}?{id'* <- id'*?} matches (_)
  -- let ?(id_later*{id_later <- id_later*}) = id'*{id' <- id'*}?{id'* <- id'*?}
  -- if ~id <- R.SEEN
  -- let R_multi = R[SEEN = R.SEEN ++ [id]]

  clause 2 : (R, exp '#' typ) = (R_multi, VAR id_fresh as exp '#' typ)
  -- if exp <: varExp
  -- let VAR id = exp as varExp
  -- let id'*{id' <- id'*}?{id'* <- id'*?} = $find_map<id, id*>(R.OCC, id)
  -- if id'*{id' <- id'*}?{id'* <- id'*?} matches (_)
  -- let ?(id_later*{id_later <- id_later*}) = id'*{id' <- id'*}?{id'* <- id'*?}
  -- if id <- R.SEEN
  -- let (id_used*{id_used <- id_used*}, id_fresh) = $fresh_id(R.USED)
  -- let occ = $add_map<id, id*>(R.OCC, id, id_later*{id_later <- id_later*} ++ [id_fresh])
  -- let R_multi = {USED id_used*{id_used <- id_used*}, SEEN R.SEEN, OCC occ}

  clause 3 : (R, exp '#' typ) = (R_multi, UPCAST typ_sup typedExp_multi as exp '#' typ)
  -- if exp <: upCastExp
  -- let UPCAST typ_sup typedExp = exp as upCastExp
  -- let (R_multi, typedExp_multi) = $rename_exp(R, typedExp)

  clause 4 : (R, exp '#' typ) = (R_multi, TUP typedExp_multi*{typedExp_multi <- typedExp_multi*} as exp '#' typ)
  -- if exp <: tupExp
  -- let TUP typedExp*{typedExp <- typedExp*} = exp as tupExp
  -- let (R_multi, typedExp_multi*{typedExp_multi <- typedExp_multi*}) = $rename_exps(R, typedExp*{typedExp <- typedExp*})

  clause 5 : (R, exp '#' typ) = (R_multi, INJ mixop typedExp_multi*{typedExp_multi <- typedExp_multi*} as exp '#' typ)
  -- if exp <: injExp
  -- let INJ mixop typedExp*{typedExp <- typedExp*} = exp as injExp
  -- let (R_multi, typedExp_multi*{typedExp_multi <- typedExp_multi*}) = $rename_exps(R, typedExp*{typedExp <- typedExp*})

  clause 6 : (R, exp '#' typ) = (R_multi, STR expField_multi*{expField_multi <- expField_multi*} as exp '#' typ)
  -- if exp <: strExp
  -- let STR expField*{expField <- expField*} = exp as strExp
  -- (let atom typedExp = expField)*{expField <- expField*, atom -> atom*, typedExp -> typedExp*}
  -- let (R_multi, typedExp_multi*{typedExp_multi <- typedExp_multi*}) = $rename_exps(R, typedExp*{typedExp <- typedExp*})
  -- if (|atom*{atom <- atom*}| = |typedExp_multi*{typedExp_multi <- typedExp_multi*}|)
  -- (let expField_multi = atom typedExp_multi)*{atom <- atom*, typedExp_multi <- typedExp_multi*, expField_multi -> expField_multi*}

  clause 7 : (R, exp '#' typ) = (R, OPT ?() as exp '#' typ)
  -- if (exp = OPT ?() as exp)

  clause 8 : (R, exp '#' typ) = (R_multi, OPT ?(typedExp_multi) as exp '#' typ)
  -- if exp <: optExp
  -- let OPT typedExp'?{typedExp' <- typedExp'?} = exp as optExp
  -- if typedExp'?{typedExp' <- typedExp'?} matches (_)
  -- let ?(typedExp) = typedExp'?{typedExp' <- typedExp'?}
  -- let (R_multi, typedExp_multi) = $rename_exp(R, typedExp)

  clause 9 : (R, exp '#' typ) = (R_multi, LIST typedExp_multi*{typedExp_multi <- typedExp_multi*} as exp '#' typ)
  -- if exp <: listExp
  -- let LIST typedExp*{typedExp <- typedExp*} = exp as listExp
  -- let (R_multi, typedExp_multi*{typedExp_multi <- typedExp_multi*}) = $rename_exps(R, typedExp*{typedExp <- typedExp*})

  clause 10 : (R, exp '#' typ) = (R_t, CONS typedExp_h_multi typedExp_t_multi as exp '#' typ)
  -- if exp <: consExp
  -- let CONS typedExp_h typedExp_t = exp as consExp
  -- let (R_h, typedExp_h_multi) = $rename_exp(R, typedExp_h)
  -- let (R_t, typedExp_t_multi) = $rename_exp(R_h, typedExp_t)

  clause 11 : (R, exp '#' typ) = (R_multi, ITER typedExp_multi iter vari_occ*{vari_occ <- vari_occ*} as exp '#' typ)
  -- if exp <: iterExp
  -- let ITER typedExp iter vari*{vari <- vari*} = exp as iterExp
  -- let (R_multi, typedExp_multi) = $rename_exp(R, typedExp)
  -- let id_free*{id_free <- id_free*} = $ids_of_varis($free_varis_exp(typedExp_multi))
  -- (let vari_rename*{vari_rename <- vari_rename*} = $rename_iter_vari(R_multi.OCC, vari, id_free*{id_free <- id_free*}))*{vari <- vari*, vari_rename* -> vari_rename**}
  -- let vari_occ*{vari_occ <- vari_occ*} = $concat_<vari>(vari_rename*{vari_rename <- vari_rename*}*{vari_rename* <- vari_rename**})

  clause 12 : (R, typedExp) = (R, typedExp)
  -- let exp '#' _typ = typedExp
  -- if ((((((((~exp <: varExp /\ ~exp <: upCastExp) /\ ~exp <: tupExp) /\ ~exp <: injExp) /\ ~exp <: strExp) /\ ~exp <: optExp) /\ ~exp <: listExp) /\ ~exp <: consExp) /\ ~exp <: iterExp)

def $rename_exps(renamer, typedExp*) : (renamer, typedExp*) =

  clause 0 : (R, typedExp*{typedExp <- typedExp*}) = (R, [])
  -- if typedExp*{typedExp <- typedExp*} matches []

  clause 1 : (R, typedExp*{typedExp <- typedExp*}) = (R_t, typedExp_h_multi :: typedExp_t_multi*{typedExp_t_multi <- typedExp_t_multi*})
  -- if typedExp*{typedExp <- typedExp*} matches _ :: _
  -- let typedExp_h :: typedExp_t*{typedExp_t <- typedExp_t*} = typedExp*{typedExp <- typedExp*}
  -- let (R_h, typedExp_h_multi) = $rename_exp(R, typedExp_h)
  -- let (R_t, typedExp_t_multi*{typedExp_t_multi <- typedExp_t_multi*}) = $rename_exps(R_h, typedExp_t*{typedExp_t <- typedExp_t*})

def $rename_iter_vari(occ, vari, id*) : vari* =

  clause 0 : (occ, id typ iter*{iter <- iter*}, id_free*{id_free <- id_free*}) = id_occ typ iter*{iter <- iter*}*{id_occ <- id_occ*}
  -- let id'*{id' <- id'*}?{id'* <- id'*?} = $find_map<id, id*>(occ, id)
  -- if id'*{id' <- id'*}?{id'* <- id'*?} matches (_)
  -- let ?(id_later*{id_later <- id_later*}) = id'*{id' <- id'*}?{id'* <- id'*?}
  -- let id_occ*{id_occ <- id_occ*} = $intersect_<id>(id :: id_later*{id_later <- id_later*}, id_free*{id_free <- id_free*})

  clause -1 : (_occ, vari, _id*{_id <- _id*}) = [vari]

def $rename_arg(renamer, arg) : (renamer, arg) =

  clause 0 : (R, arg) = (R_multi, EXP typedExp_multi as arg)
  -- if arg <: expArg
  -- let EXP typedExp = arg as expArg
  -- let (R_multi, typedExp_multi) = $rename_exp(R, typedExp)

  clause 1 : (R, arg) = (R, FUN id as arg)
  -- if arg <: funArg
  -- let FUN id = arg as funArg

def $rename_args(renamer, arg*) : (renamer, arg*) =

  clause 0 : (R, arg*{arg <- arg*}) = (R, [])
  -- if arg*{arg <- arg*} matches []

  clause 1 : (R, arg*{arg <- arg*}) = (R_t, arg_h_multi :: arg_t_multi*{arg_t_multi <- arg_t_multi*})
  -- if arg*{arg <- arg*} matches _ :: _
  -- let arg_h :: arg_t*{arg_t <- arg_t*} = arg*{arg <- arg*}
  -- let (R_h, arg_h_multi) = $rename_arg(R, arg_h)
  -- let (R_t, arg_t_multi*{arg_t_multi <- arg_t_multi*}) = $rename_args(R_h, arg_t*{arg_t <- arg_t*})

def $sideconds_multi(iterCtx, vari*, renamer) : premAL* =

  clause 0 : (IC, vari_bind*{vari_bind <- vari_bind*}, R) = $concat_<premAL>(premAL_eq*{premAL_eq <- premAL_eq*}*{premAL_eq* <- premAL_eq**})
  -- let `{ id_bind ':' id_later*{id_later <- id_later*}*{id_bind <- id_bind*, id_later* <- id_later**} `} = R.OCC
