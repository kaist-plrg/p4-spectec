  -- let TYP _id _tparam*{_tparam <- _tparam*} '=' deftyp = typDef as definedTypDefn
  -- if deftyp matches VARIANT %
  -- let VARIANT typCase*{typCase <- typCase*} = deftyp

syntax cases = mixop*

syntax rowCases = cases*

syntax combination = mixop*

def $cases_typ(tdenv, typ) : cases =

  clause 0 : (tdenv, typ) = mixop*{mixop <- mixop*}
  -- let typRes = $expand_typ(tdenv, typ)
  -- if typRes <: ok<typ>
