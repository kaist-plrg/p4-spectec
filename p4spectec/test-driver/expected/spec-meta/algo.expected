  -- if deftyp matches VARIANT %
  -- let VARIANT mixop _typ*{_typ <- _typ*}*{_typ* <- _typ**, mixop <- mixop*} = deftyp

def $cases_exp(tdenv, typedExp) : cases =

  clause 0 : (tdenv, exp '#' typ) = $cases_typ(tdenv, typ)
  -- if exp <: varExp
  -- let varExp = exp as varExp

  clause 1 : (tdenv, exp '#' _typ') = $cases_exp(tdenv, typedExp)
  -- if exp <: upCastExp
  -- let UPCAST _typ typedExp = exp as upCastExp

  clause 2 : (tdenv, exp '#' _typ) = [mixop]
  -- if exp <: injExp
  -- let INJ mixop _typedExp*{_typedExp <- _typedExp*} = exp as injExp

def $is_overlapping_cases(cases, cases) : bool =

  clause 0 : (mixop_a*{mixop_a <- mixop_a*}, mixop_b*{mixop_b <- mixop_b*}) = $exists_(mixop_a <- mixop_b*{mixop_b <- mixop_b*}*{mixop_a <- mixop_a*})

def $is_overlapping_rows(rowCases, rowCases) : bool =

  clause 0 : (mixop_a*{mixop_a <- mixop_a*}*{mixop_a* <- mixop_a**}, mixop_b*{mixop_b <- mixop_b*}*{mixop_b* <- mixop_b**}) = $forall_(b_share*{b_share <- b_share*})
  -- if (|mixop_a*{mixop_a <- mixop_a*}*{mixop_a* <- mixop_a**}| = |mixop_b*{mixop_b <- mixop_b*}*{mixop_b* <- mixop_b**}|)
  -- (let b_share = $is_overlapping_cases(mixop_a*{mixop_a <- mixop_a*}, mixop_b*{mixop_b <- mixop_b*}))*{mixop_a* <- mixop_a**, mixop_b* <- mixop_b**, b_share -> b_share*}

def $is_exclusive_rows(rowCases*) : bool =

  clause 0 : (rowCases*{rowCases <- rowCases*}) = true
  -- if rowCases*{rowCases <- rowCases*} matches []

  clause 1 : (mixop*{mixop <- mixop*}*{mixop* <- mixop**}*{mixop** <- mixop***}) = (~$exists_(b_overlap*{b_overlap <- b_overlap*}) /\ $is_exclusive_rows(mixop_t*{mixop_t <- mixop_t*}*{mixop_t* <- mixop_t**}*{mixop_t** <- mixop_t***}))
  -- if mixop*{mixop <- mixop*}*{mixop* <- mixop**}*{mixop** <- mixop***} matches _ :: _
  -- let mixop_h*{mixop_h <- mixop_h*}*{mixop_h* <- mixop_h**} :: mixop_t*{mixop_t <- mixop_t*}*{mixop_t* <- mixop_t**}*{mixop_t** <- mixop_t***} = mixop*{mixop <- mixop*}*{mixop* <- mixop**}*{mixop** <- mixop***}
  -- (let b_overlap = $is_overlapping_rows(mixop_h*{mixop_h <- mixop_h*}*{mixop_h* <- mixop_h**}, mixop_t*{mixop_t <- mixop_t*}*{mixop_t* <- mixop_t**}))*{mixop_t** <- mixop_t***, b_overlap -> b_overlap*}

def $combinations_cases(cases*) : combination* =

  clause 0 : (cases*{cases <- cases*}) = [mixop_none*{mixop_none <- mixop_none*}]
  -- if cases*{cases <- cases*} matches []
  -- let mixop_none*{mixop_none <- mixop_none*} = []

  clause 1 : (mixop*{mixop <- mixop*}*{mixop* <- mixop**}) = $concat_<mixop*>(mixop_comb*{mixop_comb <- mixop_comb*}*{mixop_comb* <- mixop_comb**}*{mixop_comb** <- mixop_comb***})
  -- if mixop*{mixop <- mixop*}*{mixop* <- mixop**} matches _ :: _
  -- let mixop_h*{mixop_h <- mixop_h*} :: mixop_t*{mixop_t <- mixop_t*}*{mixop_t* <- mixop_t**} = mixop*{mixop <- mixop*}*{mixop* <- mixop**}
  -- let mixop_rest*{mixop_rest <- mixop_rest*}*{mixop_rest* <- mixop_rest**} = $combinations_cases(mixop_t*{mixop_t <- mixop_t*}*{mixop_t* <- mixop_t**})
  -- (let mixop_comb*{mixop_comb <- mixop_comb*}*{mixop_comb* <- mixop_comb**} = $prepend_combinations(mixop_h, mixop_rest*{mixop_rest <- mixop_rest*}*{mixop_rest* <- mixop_rest**}))*{mixop_h <- mixop_h*, mixop_comb** -> mixop_comb***}

def $prepend_combinations(mixop, combination*) : combination* =

  clause 0 : (mixop, mixop_rest*{mixop_rest <- mixop_rest*}*{mixop_rest* <- mixop_rest**}) = mixop :: mixop_rest*{mixop_rest <- mixop_rest*}*{mixop_rest* <- mixop_rest**}

def $is_covered_combination(rowCases*, combination) : bool =

  clause 0 : (mixop_row*{mixop_row <- mixop_row*}*{mixop_row* <- mixop_row**}*{mixop_row** <- mixop_row***}, mixop*{mixop <- mixop*}) = $exists_(b_cover*{b_cover <- b_cover*})
  -- (if (|mixop*{mixop <- mixop*}| = |mixop_row*{mixop_row <- mixop_row*}*{mixop_row* <- mixop_row**}|))*{mixop_row** <- mixop_row***}
  -- (let b_cover = $forall_(mixop <- mixop_row*{mixop_row <- mixop_row*}*{mixop <- mixop*, mixop_row* <- mixop_row**}))*{mixop_row** <- mixop_row***, b_cover -> b_cover*}

