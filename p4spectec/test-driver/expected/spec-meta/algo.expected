syntax assignRes =
   | OK ctx (from ok<ctx>)
   | ERROR (from error)

relation Assign_exp: ctx |- typedExp := val : assignRes

  rulegroup variable

   match

    (signature) C |- VAR id as exp '#' _typ := val : %
