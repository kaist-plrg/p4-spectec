  clause 8 : (C, defnAL*{defnAL <- defnAL*}) = C
  -- if defnAL*{defnAL <- defnAL*} matches []

def $add_varr(ctx, varr, val) : ctx =

  clause 0 : (C, varr, val) = C[LOCAL.VAL = venv_update]
  -- let venv_update = $add_map<varr, val>(C.LOCAL.VAL, varr, val)

def $add_varis(ctx, vari*, val*) : ctx =

  clause 0 : (C, vari*{vari <- vari*}, val*{val <- val*}) = C[LOCAL.VAL = venv_update]
  -- (let id _typ iter*{iter <- iter*} = vari)*{vari <- vari*, _typ -> _typ*, id -> id*, iter* -> iter**}
  -- let venv_update = $adds_map<varr, val>(C.LOCAL.VAL, id iter*{iter <- iter*}*{id <- id*, iter* <- iter**}, val*{val <- val*})

def $add_func(ctx, id, id) : ctx =

  clause 0 : (C, id, id_global) = C[LOCAL.FUNC = fnenv_update]
  -- let fnenv_update = $add_map<id, id>(C.LOCAL.FUNC, id, id_global)

def $find_vari(ctx, vari) : val? =

  clause 0 : (C, vari) = ?(val)
  -- let id _typ iter*{iter <- iter*} = vari
  -- let val'?{val' <- val'?} = $find_map<varr, val>(C.LOCAL.VAL, id iter*{iter <- iter*})
  -- if val'?{val' <- val'?} matches (_)
  -- let ?(val) = val'?{val' <- val'?}

  clause -1 : (C, vari) = ?()

def $find_varr(ctx, varr) : val? =

  clause 0 : (C, varr) = $find_map<varr, val>(C.LOCAL.VAL, varr)

def $find_varis(ctx, vari*) : val*? =

  clause 0 : (C, vari*{vari <- vari*}) = ?(val*{val <- val*})
  -- (let val'?{val' <- val'?} = $find_vari(C, vari))*{vari <- vari*, val'? -> val'?*}
  -- (if val'?{val' <- val'?} matches (_))*{val'? <- val'?*}
  -- (let ?(val) = val'?{val' <- val'?})*{val'? <- val'?*, val -> val*}

  clause -1 : (C, vari*{vari <- vari*}) = ?()

def $finds_vari(ctx*, vari) : val*? =

  clause 0 : (C*{C <- C*}, vari) = ?(val*{val <- val*})
  -- let id _typ iter*{iter <- iter*} = vari
  -- (let val'?{val' <- val'?} = $find_map<varr, val>(C.LOCAL.VAL, id iter*{iter <- iter*}))*{C <- C*, val'? -> val'?*}
  -- (if val'?{val' <- val'?} matches (_))*{val'? <- val'?*}
  -- (let ?(val) = val'?{val' <- val'?})*{val'? <- val'?*, val -> val*}

  clause -1 : (C*{C <- C*}, vari) = ?()

def $is_iter_on_var(typedExp) : varr? =

  clause 0 : (exp '#' _typ) = ?(id [])
  -- if exp <: varExp
  -- let VAR id = exp as varExp

  clause 1 : (exp '#' _typ) = ?(id iter*{iter <- iter*} ++ [iter_outer])
  -- if exp <: iterExp
  -- let ITER typedExp expIter = exp as iterExp
  -- let varr?{varr <- varr?} = $is_iter_on_var(typedExp)
  -- if varr?{varr <- varr?} matches (_)
  -- let ?(id iter*{iter <- iter*}) = varr?{varr <- varr?}
  -- let iter_outer vari*{vari <- vari*} = expIter
  -- if vari*{vari <- vari*} matches [ _/1 ]
  -- let [id' _typ' iter'*{iter' <- iter'*}] = vari*{vari <- vari*}
  -- if (id' = id)
  -- if (iter'*{iter' <- iter'*} = iter*{iter <- iter*})

  clause -1 : (_typedExp) = ?()

def $find_typ(ctx, id) : typDef? =

  clause 0 : (C, id) = ?(typDef)
  -- let typDef'?{typDef' <- typDef'?} = $find_map<id, typDef>(C.LOCAL.TYP, id)
  -- if typDef'?{typDef' <- typDef'?} matches (_)
  -- let ?(typDef) = typDef'?{typDef' <- typDef'?}

  clause 1 : (C, id) = $find_map<id, typDef>(C.GLOBAL.TYP, id)
  -- if (?() = $find_map<id, typDef>(C.LOCAL.TYP, id))

def $find_func_param(ctx, id) : id? =

  clause 0 : (C, id) = $find_map<id, id>(C.LOCAL.FUNC, id)

def $resolve_func_param(ctx, id) : id =

  clause 0 : (C, id) = $deopt_<id>($find_func_param(C, id), id)

def $find_func(ctx, id) : funcDefnAL? =

  clause 0 : (C, id) = $find_map<id, funcDefnAL>(C.GLOBAL.FUNC, id)

def $find_rel(ctx, id) : relDefnAL? =

  clause 0 : (C, id) = $find_map<id, relDefnAL>(C.GLOBAL.REL, id)

syntax subOptRes =
   | OK ctx? (from ok<ctx?>)
   | ERROR (from error)

def $sub_opt(ctx, vari*) : subOptRes =

  clause 0 : (C, vari*{vari <- vari*}) = ERROR as subOptRes
  -- if vari*{vari <- vari*} matches []

  clause 1 : (C, vari*{vari <- vari*}) = OK ?(C_sub) as subOptRes
  -- if (vari*{vari <- vari*} =/= [])
  -- (let vari_iter = $iterate_vari(vari, [QUEST]))*{vari <- vari*, vari_iter -> vari_iter*}
  -- (let val'''?{val''' <- val'''?} = $find_vari(C, vari_iter))*{vari_iter <- vari_iter*, val'''? -> val'''?*}
  -- (if val'''?{val''' <- val'''?} matches (_))*{val'''? <- val'''?*}
  -- (let ?(val'') = val'''?{val''' <- val'''?})*{val'''? <- val'''?*, val'' -> val''*}
  -- (if val'' matches OPT %)*{val'' <- val''*}
  -- (let OPT val'?{val' <- val'?} = val'')*{val'' <- val''*, val'? -> val'?*}
  -- (if val'?{val' <- val'?} matches (_))*{val'? <- val'?*}
  -- (let ?(val) = val'?{val' <- val'?})*{val'? <- val'?*, val -> val*}
  -- let C_sub = $add_varis(C, vari*{vari <- vari*}, val*{val <- val*})

  clause 2 : (C, vari*{vari <- vari*}) = OK ?() as subOptRes
  -- if (vari*{vari <- vari*} =/= [])
  -- (let vari_iter = $iterate_vari(vari, [QUEST]))*{vari <- vari*, vari_iter -> vari_iter*}
  -- (if (?(OPT ?()) = $find_vari(C, vari_iter)))*{vari_iter <- vari_iter*}

  clause -1 : (C, vari*{vari <- vari*}) = ERROR as subOptRes

syntax subListRes =
   | OK ctx* (from ok<ctx*>)
   | ERROR (from error)

def $sub_list(ctx, vari*) : subListRes =

  clause 0 : (C, vari*{vari <- vari*}) = OK C_sub*{C_sub <- C_sub*} as subListRes
  -- (let vari_iter = $iterate_vari(vari, [STAR]))*{vari <- vari*, vari_iter -> vari_iter*}
  -- (let val''?{val'' <- val''?} = $find_vari(C, vari_iter))*{vari_iter <- vari_iter*, val''? -> val''?*}
  -- (if val''?{val'' <- val''?} matches (_))*{val''? <- val''?*}
  -- (let ?(val') = val''?{val'' <- val''?})*{val''? <- val''?*, val' -> val'*}
  -- (if val' matches LIST %)*{val' <- val'*}
  -- (let LIST val*{val <- val*} = val')*{val' <- val'*, val* -> val**}
  -- (if (0 < |val*{val <- val*}*{val* <- val**}|))*{val* <- val**}
  -- if $forall_((|val*{val <- val*}| = |val*{val <- val*}*{val* <- val**}[0]|)*{val* <- val**})
  -- let val_trans*{val_trans <- val_trans*}*{val_trans* <- val_trans**} = $transpose_<val>(val*{val <- val*}*{val* <- val**})
  -- (let C_sub = $add_varis(C, vari*{vari <- vari*}, val_trans*{val_trans <- val_trans*}))*{val_trans* <- val_trans**, C_sub -> C_sub*}

  clause -1 : (C, vari*{vari <- vari*}) = ERROR as subListRes

syntax funcRes =
   | OK val (from ok<val>)
   | ERROR (from error)
   | UNMATCH (from unmatch)

extern relation Call_extern_func: |- id `< typ* `> `( val* `) : funcRes

extern relation Call_builtin_func: |- id `< typ* `> `( val* `) : funcRes

syntax relRes =
   | OK val* (from ok<val*>)
   | ERROR (from error)
   | UNMATCH (from unmatch)

extern relation Call_extern_rel: |- id `( val* `) : relRes

