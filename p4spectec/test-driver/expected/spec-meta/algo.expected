syntax typElabRes =
   | OK typ (from ok<typ>)
   | FAIL (from fail)

relation Elab_plainTyp: elabCtx |- plainTypEL : typElabRes

  rulegroup prim

   match

    (signature) EC |- plainTypEL : %
    EC |- plainTypEL : %

   paths

    rulepath boolean
    -- if (plainTypEL = BOOL)
    -- output: % |- % : OK BOOL as typ as typElabRes

    rulepath number
    -- let plainTypEL' = plainTypEL
    -- if plainTypEL' <: numtyp
    -- let numtyp = plainTypEL' as numtyp
    -- output: % |- % : OK numtyp as typ as typElabRes

    rulepath string
    -- if (plainTypEL = TEXT)
    -- output: % |- % : OK TEXT as typ as typElabRes

  rulegroup named

   match

    (signature) EC |- VAR id plainTypEL*{plainTypEL <- plainTypEL*} : %
    EC |- plainTypEL' : %
    -- if plainTypEL' matches VAR % %
    -- let VAR id plainTypEL*{plainTypEL <- plainTypEL*} = plainTypEL'

   paths

    rulepath named
    -- let typDef'?{typDef' <- typDef'?} = $find_map<id, typDef>(EC.TYP, id)
    -- if typDef'?{typDef' <- typDef'?} matches (_)
    -- let ?(typDef) = typDef'?{typDef' <- typDef'?}
    -- let tparam*{tparam <- tparam*} = $tparams_of_typDef(typDef)
    -- if (|tparam*{tparam <- tparam*}| = |plainTypEL*{plainTypEL <- plainTypEL*}|)
    -- (Elab_plainTyp: EC |- plainTypEL : typElabRes)*{plainTypEL <- plainTypEL*, typElabRes -> typElabRes*}
    -- (if typElabRes <: ok<typ>)*{typElabRes <- typElabRes*}
    -- (let OK typ = typElabRes as ok<typ>)*{typElabRes <- typElabRes*, typ -> typ*}
    -- output: % |- % : OK VAR id typ*{typ <- typ*} as typElabRes

  rulegroup paren

   match

    (signature) EC |- PAREN plainTypEL : %
    EC |- plainTypEL' : %
    -- if plainTypEL' matches PAREN %
    -- let PAREN plainTypEL = plainTypEL'

   paths

    rulepath paren
    -- Elab_plainTyp: EC |- plainTypEL : typElabRes
    -- output: % |- % : typElabRes

