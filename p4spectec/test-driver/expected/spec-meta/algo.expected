  -- (if val' matches LIST %)*{val' <- val'*}
  -- (let LIST val*{val <- val*} = val')*{val' <- val'*, val* -> val**}
  -- (if (0 < |val*{val <- val*}*{val* <- val**}|))*{val* <- val**}
  -- if $forall_((|val*{val <- val*}| = |val*{val <- val*}*{val* <- val**}[0]|)*{val* <- val**})
  -- let val_trans*{val_trans <- val_trans*}*{val_trans* <- val_trans**} = $transpose_<val>(val*{val <- val*}*{val* <- val**})
  -- (let C' = $add_varis(C, vari*{vari <- vari*}, val_trans*{val_trans <- val_trans*}))*{val_trans* <- val_trans**, C' -> C'*}

  clause -1 : (C, vari*{vari <- vari*}) = ERROR as subListRes

syntax funcRes =
   | OK val (from ok<val>)
   | ERROR (from error)
   | UNMATCH (from unmatch)

extern relation Call_extern_func: |- id `< typ* `> `( val* `) : funcRes

extern relation Call_builtin_func: |- id `< typ* `> `( val* `) : funcRes

syntax relRes =
   | OK val* (from ok<val*>)
   | ERROR (from error)
   | UNMATCH (from unmatch)

extern relation Call_extern_rel: |- id `( val* `) : relRes

