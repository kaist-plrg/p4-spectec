def $is_irrefutable_exp(tdenv, typedExp) : bool =

  clause 0 : (_tdenv, exp '#' _typ) = true
  -- if exp <: varExp
  -- let varExp = exp as varExp

  clause 1 : (tdenv, exp '#' _typ) = $forall_($is_irrefutable_exp(tdenv, typedExp)*{typedExp <- typedExp*})
  -- if exp <: tupExp
  -- let TUP typedExp*{typedExp <- typedExp*} = exp as tupExp

  clause 2 : (tdenv, exp '#' typ) = ($is_singleton_typ(tdenv, typ) /\ $forall_($is_irrefutable_exp(tdenv, typedExp)*{typedExp <- typedExp*}))
  -- if exp <: injExp
  -- let INJ _mixop typedExp*{typedExp <- typedExp*} = exp as injExp

  clause 3 : (tdenv, exp '#' _typ) = $forall_($is_irrefutable_exp(tdenv, typedExp)*{typedExp <- typedExp*})
  -- if exp <: strExp
  -- let STR expField*{expField <- expField*} = exp as strExp
  -- (let _atom typedExp = expField)*{expField <- expField*, _atom -> _atom*, typedExp -> typedExp*}

  clause 4 : (tdenv, exp '#' _typ) = $is_irrefutable_exp(tdenv, typedExp)
  -- if exp <: iterExp
  -- let ITER typedExp _expIter = exp as iterExp

  clause 5 : (_tdenv, exp '#' _typ) = false
  -- if ((((~exp <: varExp /\ ~exp <: tupExp) /\ ~exp <: injExp) /\ ~exp <: strExp) /\ ~exp <: iterExp)

def $is_singleton_typ(tdenv, typ) : bool =

  clause 0 : (tdenv, typ) = (|typCase*{typCase <- typCase*}| = 1)
  -- let typRes = $expand_typ(tdenv, typ)
