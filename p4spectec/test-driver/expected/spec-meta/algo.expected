  -- if deftyp matches ALIAS %
  -- let ALIAS typ = deftyp
  -- if (|targ*{targ <- targ*}| = |tparam*{tparam <- tparam*}|)
  -- let theta = `{ tparam ':' targ*{targ <- targ*, tparam <- tparam*} `}
  -- let typRes = $subst_typ(theta, typ)
  -- if typRes <: ok<typ>
  -- let OK typ_subst = typRes as ok<typ>

  clause 1 : (tdenv, typ) = OK VAR id targ*{targ <- targ*} as typRes
  -- if typ matches VAR % %
  -- let VAR id targ*{targ <- targ*} = typ
  -- let typDef'?{typDef' <- typDef'?} = $find_map<id, typDef>(tdenv, id)
  -- if typDef'?{typDef' <- typDef'?} matches (_)
  -- let ?(typDef) = typDef'?{typDef' <- typDef'?}
  -- if (typDef = PARAM)
  -- if (targ*{targ <- targ*} = [])

  clause 2 : (tdenv, typ) = OK VAR id [] as typRes
  -- if typ matches VAR % %
  -- let VAR id targ*{targ <- targ*} = typ
  -- if targ*{targ <- targ*} matches []
  -- let typDef'?{typDef' <- typDef'?} = $find_map<id, typDef>(tdenv, id)
  -- if typDef'?{typDef' <- typDef'?} matches (_)
  -- let ?(typDef) = typDef'?{typDef' <- typDef'?}
  -- if typDef <: externTypDefn
  -- let EXTTYP _id = typDef as externTypDefn

  clause 3 : (tdenv, typ) = OK VAR id targ*{targ <- targ*} as typRes
  -- if typ matches VAR % %
  -- let VAR id targ*{targ <- targ*} = typ
  -- let typDef'?{typDef' <- typDef'?} = $find_map<id, typDef>(tdenv, id)
  -- if typDef'?{typDef' <- typDef'?} matches (_)
  -- let ?(typDef) = typDef'?{typDef' <- typDef'?}
  -- if typDef matches DEFINING %
  -- let DEFINING tparam*{tparam <- tparam*} = typDef
  -- if (|tparam*{tparam <- tparam*}| = |targ*{targ <- targ*}|)

  clause 4 : (tdenv, typ) = OK VAR id targ*{targ <- targ*} as typRes
  -- if typ matches VAR % %
  -- let VAR id targ*{targ <- targ*} = typ
  -- let typDef'?{typDef' <- typDef'?} = $find_map<id, typDef>(tdenv, id)
  -- if typDef'?{typDef' <- typDef'?} matches (_)
  -- let ?(typDef) = typDef'?{typDef' <- typDef'?}
  -- if typDef <: definedTypDefn
  -- let TYP _id tparam*{tparam <- tparam*} '=' deftyp = typDef as definedTypDefn
  -- if deftyp matches STRUCT %
  -- let STRUCT typField*{typField <- typField*} = deftyp
  -- if (|tparam*{tparam <- tparam*}| = |targ*{targ <- targ*}|)

  clause 5 : (tdenv, typ) = OK VAR id targ*{targ <- targ*} as typRes
  -- if typ matches VAR % %
  -- let VAR id targ*{targ <- targ*} = typ
  -- let typDef'?{typDef' <- typDef'?} = $find_map<id, typDef>(tdenv, id)
  -- if typDef'?{typDef' <- typDef'?} matches (_)
  -- let ?(typDef) = typDef'?{typDef' <- typDef'?}
  -- if typDef <: definedTypDefn
  -- let TYP _id tparam*{tparam <- tparam*} '=' deftyp = typDef as definedTypDefn
  -- if deftyp matches VARIANT %
  -- let VARIANT typCase*{typCase <- typCase*} = deftyp
  -- if (|tparam*{tparam <- tparam*}| = |targ*{targ <- targ*}|)

  clause 6 : (tdenv, typ) = OK BOOL as typ as typRes
  -- if typ <: optyp
  -- let optyp = typ as optyp
  -- if optyp matches BOOL

  clause 7 : (tdenv, typ) = OK NAT as typ as typRes
  -- if typ <: numtyp
  -- let numtyp = typ as numtyp
  -- if numtyp matches NAT

  clause 8 : (tdenv, typ) = OK INT as typ as typRes
  -- if typ <: numtyp
  -- let numtyp = typ as numtyp
  -- if numtyp matches INT

  clause 9 : (tdenv, typ) = OK TEXT as typ as typRes
  -- if typ <: optyp
  -- let optyp = typ as optyp
  -- if optyp matches TEXT

  clause 10 : (tdenv, typ') = OK TUP typ*{typ <- typ*} as typRes
  -- if typ' matches TUP %
  -- let TUP typ*{typ <- typ*} = typ'

  clause 11 : (tdenv, typ') = OK ITER typ iter as typRes
  -- if typ' matches ITER % %
  -- let ITER typ iter = typ'

  clause 12 : (tdenv, typ') = OK FUNC tparam*{tparam <- tparam*} typ*{typ <- typ*} typ_ret as typRes
  -- if typ' matches FUNC % % %
  -- let FUNC tparam*{tparam <- tparam*} typ*{typ <- typ*} typ_ret = typ'

  clause -1 : (tdenv, typ) = ERROR as typRes

syntax equivRes =
   | OK bool (from ok<bool>)
   | ERROR (from error)

def $equiv_typ(tdenv, typ, typ) : equivRes =

  clause 0 : (tdenv, typ_l, typ_r) = $equiv_typ'(tdenv, typ_l_expand, typ_r_expand)
  -- let typRes = $expand_typ(tdenv, typ_l)
  -- if typRes <: ok<typ>
  -- let OK typ_l_expand = typRes as ok<typ>
  -- let typRes' = $expand_typ(tdenv, typ_r)
  -- if typRes' <: ok<typ>
  -- let OK typ_r_expand = typRes' as ok<typ>

  clause -1 : (tdenv, typ_l, typ_r) = ERROR as equivRes

def $equiv_typs(tdenv, typ*, typ*) : equivRes =

  clause 0 : (tdenv, typ*{typ <- typ*}, typ'*{typ' <- typ'*}) = OK true as equivRes
  -- if typ*{typ <- typ*} matches []
  -- if typ'*{typ' <- typ'*} matches []

  clause 1 : (tdenv, typ*{typ <- typ*}, typ'*{typ' <- typ'*}) = $equiv_typs(tdenv, typ_l_t*{typ_l_t <- typ_l_t*}, typ_r_t*{typ_r_t <- typ_r_t*})
  -- if typ*{typ <- typ*} matches _ :: _
  -- let typ_l :: typ_l_t*{typ_l_t <- typ_l_t*} = typ*{typ <- typ*}
  -- if typ'*{typ' <- typ'*} matches _ :: _
  -- let typ_r :: typ_r_t*{typ_r_t <- typ_r_t*} = typ'*{typ' <- typ'*}
  -- if (OK true as equivRes = $equiv_typ(tdenv, typ_l, typ_r))

  clause 2 : (tdenv, typ*{typ <- typ*}, typ'*{typ' <- typ'*}) = equivRes
  -- if typ*{typ <- typ*} matches _ :: _
  -- let typ_l :: typ_l_t*{typ_l_t <- typ_l_t*} = typ*{typ <- typ*}
  -- if typ'*{typ' <- typ'*} matches _ :: _
  -- let typ_r :: typ_r_t*{typ_r_t <- typ_r_t*} = typ'*{typ' <- typ'*}
  -- let equivRes = $equiv_typ(tdenv, typ_l, typ_r)
  -- if (equivRes =/= OK true as equivRes)

  clause 3 : (tdenv, typ*{typ <- typ*}, typ'*{typ' <- typ'*}) = OK false as equivRes
  -- if typ*{typ <- typ*} matches []
  -- if typ'*{typ' <- typ'*} matches _ :: _
  -- let typ_r :: typ_r_t*{typ_r_t <- typ_r_t*} = typ'*{typ' <- typ'*}

  clause 4 : (tdenv, typ*{typ <- typ*}, typ'*{typ' <- typ'*}) = OK false as equivRes
  -- if typ*{typ <- typ*} matches _ :: _
  -- let typ_l :: typ_l_t*{typ_l_t <- typ_l_t*} = typ*{typ <- typ*}
  -- if typ'*{typ' <- typ'*} matches []

def $equiv_typ'(tdenv, typ, typ) : equivRes =

  clause 0 : (tdenv, typ, typ') = OK true as equivRes
  -- if typ <: optyp
  -- let optyp = typ as optyp
  -- if optyp matches BOOL
  -- if typ' <: optyp
  -- let optyp' = typ' as optyp
  -- if optyp' matches BOOL

  clause 1 : (tdenv, typ, typ') = OK true as equivRes
  -- if typ <: numtyp
  -- let numtyp = typ as numtyp
  -- if numtyp matches NAT
  -- if typ' <: numtyp
  -- let numtyp' = typ' as numtyp
  -- if numtyp' matches NAT

  clause 2 : (tdenv, typ, typ') = OK true as equivRes
  -- if typ <: numtyp
  -- let numtyp = typ as numtyp
  -- if numtyp matches INT
  -- if typ' <: numtyp
  -- let numtyp' = typ' as numtyp
  -- if numtyp' matches INT

  clause 3 : (tdenv, typ, typ') = OK true as equivRes
  -- if typ <: optyp
  -- let optyp = typ as optyp
  -- if optyp matches TEXT
  -- if typ' <: optyp
  -- let optyp' = typ' as optyp
  -- if optyp' matches TEXT

  clause 4 : (tdenv, typ, typ') = $equiv_typs(tdenv, targ_l*{targ_l <- targ_l*}, targ_r*{targ_r <- targ_r*})
  -- if typ matches VAR % %
  -- let VAR id_l targ_l*{targ_l <- targ_l*} = typ
  -- if typ' matches VAR % %
  -- let VAR id_r targ_r*{targ_r <- targ_r*} = typ'
  -- if (id_l = id_r)

  clause 5 : (tdenv, typ, typ') = $equiv_typs(tdenv, typ_l*{typ_l <- typ_l*}, typ_r*{typ_r <- typ_r*})
  -- if typ matches TUP %
  -- let TUP typ_l*{typ_l <- typ_l*} = typ
  -- if typ' matches TUP %
  -- let TUP typ_r*{typ_r <- typ_r*} = typ'

  clause 6 : (tdenv, typ, typ') = $equiv_typ(tdenv, typ_l, typ_r)
  -- if typ matches ITER % %
  -- let ITER typ_l iter_l = typ
  -- if typ' matches ITER % %
  -- let ITER typ_r iter_r = typ'
  -- if (iter_l = iter_r)

  clause -1 : (tdenv, typ_l, typ_r) = OK false as equivRes

def $equiv_func_typ(tdenv, typ, typ) : equivRes =

  clause 0 : (tdenv, typ, typ') = $equiv_typs(tdenv_fresh, typ_l_subst*{typ_l_subst <- typ_l_subst*} ++ [typ_ret_l_subst], typ_r_subst*{typ_r_subst <- typ_r_subst*} ++ [typ_ret_r_subst])
  -- if typ matches FUNC % % %
  -- let FUNC tparam_l*{tparam_l <- tparam_l*} typ_l*{typ_l <- typ_l*} typ_ret_l = typ
  -- if typ' matches FUNC % % %
  -- let FUNC tparam_r*{tparam_r <- tparam_r*} typ_r*{typ_r <- typ_r*} typ_ret_r = typ'
  -- if (|tparam_l*{tparam_l <- tparam_l*}| = |tparam_r*{tparam_r <- tparam_r*}|)
  -- if (|typ_l*{typ_l <- typ_l*}| = |typ_r*{typ_r <- typ_r*}|)
  -- let `{ id ':' typDef*{id <- id*, typDef <- typDef*} `} = tdenv
  -- let id_used*{id_used <- id_used*} = id*{id <- id*} ++ $ids_typ(FUNC tparam_l*{tparam_l <- tparam_l*} typ_l*{typ_l <- typ_l*} typ_ret_l) ++ $ids_typ(FUNC tparam_r*{tparam_r <- tparam_r*} typ_r*{typ_r <- typ_r*} typ_ret_r)
  -- let tparam_fresh*{tparam_fresh <- tparam_fresh*} = $fresh_ids(id_used*{id_used <- id_used*}, tparam_l*{tparam_l <- tparam_l*})
  -- if (|tparam_fresh*{tparam_fresh <- tparam_fresh*}| = |tparam_l*{tparam_l <- tparam_l*}|)
  -- let theta_l = `{ tparam_l ':' VAR tparam_fresh []*{tparam_fresh <- tparam_fresh*, tparam_l <- tparam_l*} `}
  -- let theta_r = `{ tparam_r ':' VAR tparam_fresh []*{tparam_fresh <- tparam_fresh*, tparam_r <- tparam_r*} `}
  -- let typsRes = $subst_typs(theta_l, typ_l*{typ_l <- typ_l*})
  -- if typsRes <: ok<typ*>
  -- let OK typ_l_subst*{typ_l_subst <- typ_l_subst*} = typsRes as ok<typ*>
  -- let typsRes' = $subst_typs(theta_r, typ_r*{typ_r <- typ_r*})
  -- if typsRes' <: ok<typ*>
  -- let OK typ_r_subst*{typ_r_subst <- typ_r_subst*} = typsRes' as ok<typ*>
  -- let typRes = $subst_typ(theta_l, typ_ret_l)
  -- if typRes <: ok<typ>
  -- let OK typ_ret_l_subst = typRes as ok<typ>
  -- let typRes' = $subst_typ(theta_r, typ_ret_r)
  -- if typRes' <: ok<typ>
  -- let OK typ_ret_r_subst = typRes' as ok<typ>
  -- let tdenv_fresh = $adds_map<id, typDef>(tdenv, tparam_fresh*{tparam_fresh <- tparam_fresh*}, $repeat_<typDef>(PARAM, |tparam_fresh*{tparam_fresh <- tparam_fresh*}|))

  clause 1 : (tdenv, typ, typ') = OK false as equivRes
  -- if typ matches FUNC % % %
  -- let FUNC tparam_l*{tparam_l <- tparam_l*} typ_l*{typ_l <- typ_l*} typ_ret_l = typ
  -- if typ' matches FUNC % % %
  -- let FUNC tparam_r*{tparam_r <- tparam_r*} typ_r*{typ_r <- typ_r*} typ_ret_r = typ'
  -- if ((|tparam_l*{tparam_l <- tparam_l*}| =/= |tparam_r*{tparam_r <- tparam_r*}|) \/ (|typ_l*{typ_l <- typ_l*}| =/= |typ_r*{typ_r <- typ_r*}|))

  clause -1 : (tdenv, typ_l, typ_r) = ERROR as equivRes

def $free_varis_exp(typedExp) : vari* =

  clause 0 : (exp '#' _typ) = []
  -- if exp <: literalExp
  -- let literalExp = exp as literalExp

  clause 1 : (exp '#' typ) = [id typ []]
  -- if exp <: varExp
  -- let VAR id = exp as varExp

  clause 2 : (exp '#' _typ) = $free_varis_exp(typedExp)
  -- if exp <: unOpExp
  -- let UN _unOp typedExp = exp as unOpExp

  clause 3 : (exp '#' _typ) = $free_varis_exps([typedExp_l, typedExp_r])
  -- if exp <: binOpExp
  -- let BIN _binOp typedExp_l typedExp_r = exp as binOpExp

  clause 4 : (exp '#' _typ) = $free_varis_exps([typedExp_l, typedExp_r])
  -- if exp <: cmpOpExp
  -- let CMP _cmpOp typedExp_l typedExp_r = exp as cmpOpExp

  clause 5 : (exp '#' _typ') = $free_varis_exp(typedExp)
  -- if exp <: upCastExp
  -- let UPCAST _typ typedExp = exp as upCastExp

  clause 6 : (exp '#' _typ') = $free_varis_exp(typedExp)
  -- if exp <: downCastExp
  -- let DOWNCAST _typ typedExp = exp as downCastExp

  clause 7 : (exp '#' _typ') = $free_varis_exp(typedExp)
  -- if exp <: subExp
  -- let SUB typedExp _typ = exp as subExp

  clause 8 : (exp '#' _typ) = $free_varis_exp(typedExp)
  -- if exp <: matchExp
  -- let MATCH typedExp _pat = exp as matchExp

  clause 9 : (exp '#' _typ) = $free_varis_exps(typedExp*{typedExp <- typedExp*})
  -- if exp <: tupExp
  -- let TUP typedExp*{typedExp <- typedExp*} = exp as tupExp

  clause 10 : (exp '#' _typ) = $free_varis_exps(typedExp*{typedExp <- typedExp*})
  -- if exp <: injExp
  -- let INJ _mixop typedExp*{typedExp <- typedExp*} = exp as injExp

  clause 11 : (exp '#' _typ) = $free_varis_exps(typedExp*{typedExp <- typedExp*})
  -- if exp <: strExp
  -- let STR expField*{expField <- expField*} = exp as strExp
  -- (let _atom typedExp = expField)*{expField <- expField*, _atom -> _atom*, typedExp -> typedExp*}

  clause 12 : (exp '#' _typ) = []
  -- if (exp = OPT ?() as exp)

  clause 13 : (exp '#' _typ) = $free_varis_exp(typedExp)
  -- if exp <: optExp
  -- let OPT typedExp'?{typedExp' <- typedExp'?} = exp as optExp
  -- if typedExp'?{typedExp' <- typedExp'?} matches (_)
  -- let ?(typedExp) = typedExp'?{typedExp' <- typedExp'?}

  clause 14 : (exp '#' _typ) = $free_varis_exps(typedExp*{typedExp <- typedExp*})
  -- if exp <: listExp
  -- let LIST typedExp*{typedExp <- typedExp*} = exp as listExp

  clause 15 : (exp '#' _typ) = $free_varis_exps([typedExp_h, typedExp_t])
  -- if exp <: consExp
  -- let CONS typedExp_h typedExp_t = exp as consExp

  clause 16 : (exp '#' _typ) = $free_varis_exps([typedExp_l, typedExp_r])
  -- if exp <: catExp
  -- let CAT typedExp_l typedExp_r = exp as catExp

  clause 17 : (exp '#' _typ) = $free_varis_exps([typedExp_l, typedExp_r])
  -- if exp <: memExp
  -- let MEM typedExp_l typedExp_r = exp as memExp

  clause 18 : (exp '#' _typ) = $free_varis_exp(typedExp)
  -- if exp <: lenExp
  -- let LEN typedExp = exp as lenExp

  clause 19 : (exp '#' _typ) = $free_varis_exp(typedExp)
  -- if exp <: dotAccExp
  -- let DOT typedExp _atom = exp as dotAccExp

  clause 20 : (exp '#' _typ) = $free_varis_exps([typedExp_b, typedExp_i])
  -- if exp <: idxAccExp
  -- let IDX typedExp_b typedExp_i = exp as idxAccExp

  clause 21 : (exp '#' _typ) = $free_varis_exps([typedExp_b, typedExp_i, typedExp_n])
  -- if exp <: sliceAccExp
  -- let SLICE typedExp_b typedExp_i typedExp_n = exp as sliceAccExp

  clause 22 : (exp '#' _typ) = $free_varis_exp(typedExp_b) ++ $free_varis_path(typedPath) ++ $free_varis_exp(typedExp_f)
  -- if exp <: updExp
  -- let UPD typedExp_b typedPath typedExp_f = exp as updExp

  clause 23 : (exp '#' _typ) = $free_varis_args(arg*{arg <- arg*})
  -- if exp <: callExp
  -- let CALL _id _targ*{_targ <- _targ*} arg*{arg <- arg*} = exp as callExp

  clause 24 : (exp '#' _typ) = vari_iter*{vari_iter <- vari_iter*}
  -- if exp <: iterExp
  -- let ITER typedExp iter _vari*{_vari <- _vari*} = exp as iterExp
  -- let vari*{vari <- vari*} = $free_varis_exp(typedExp)
  -- (let vari_iter = $iterate_vari(vari, [iter]))*{vari <- vari*, vari_iter -> vari_iter*}

def $free_varis_exps(typedExp*) : vari* =

  clause 0 : (typedExp*{typedExp <- typedExp*}) = []
  -- if typedExp*{typedExp <- typedExp*} matches []

  clause 1 : (typedExp*{typedExp <- typedExp*}) = $free_varis_exp(typedExp_h) ++ $free_varis_exps(typedExp_t*{typedExp_t <- typedExp_t*})
  -- if typedExp*{typedExp <- typedExp*} matches _ :: _
  -- let typedExp_h :: typedExp_t*{typedExp_t <- typedExp_t*} = typedExp*{typedExp <- typedExp*}

def $free_varis_path(typedPath) : vari* =

  clause 0 : (path '#' _typ) = []
  -- if path <: rootPath
  -- let rootPath = path as rootPath
  -- if rootPath matches ROOT

  clause 1 : (path '#' _typ) = $free_varis_path(typedPath) ++ $free_varis_exp(typedExp_i)
  -- if path <: idxPath
  -- let IDX typedPath typedExp_i = path as idxPath

  clause 2 : (path '#' _typ) = $free_varis_path(typedPath) ++ $free_varis_exps([typedExp_i, typedExp_n])
  -- if path <: slicePath
  -- let SLICE typedPath typedExp_i typedExp_n = path as slicePath

  clause 3 : (path '#' _typ) = $free_varis_path(typedPath)
  -- if path <: dotPath
  -- let DOT typedPath _atom = path as dotPath

def $free_varis_arg(arg) : vari* =

  clause 0 : (arg) = $free_varis_exp(typedExp)
  -- if arg <: expArg
  -- let EXP typedExp = arg as expArg

  clause 1 : (arg) = []
  -- if arg <: funArg
  -- let funArg = arg as funArg

def $free_varis_args(arg*) : vari* =

  clause 0 : (arg*{arg <- arg*}) = []
  -- if arg*{arg <- arg*} matches []

  clause 1 : (arg*{arg <- arg*}) = $free_varis_arg(arg_h) ++ $free_varis_args(arg_t*{arg_t <- arg_t*})
  -- if arg*{arg <- arg*} matches _ :: _
  -- let arg_h :: arg_t*{arg_t <- arg_t*} = arg*{arg <- arg*}

def $free_varis_premIL(premIL) : vari* =

  clause 0 : (premIL) = $free_varis_exps(typedExp*{typedExp <- typedExp*})
  -- if premIL <: relPremIL
  -- let REL _id ':' typedExp*{typedExp <- typedExp*} `( _inputHint `) = premIL as relPremIL

  clause 1 : (premIL) = $free_varis_exp(typedExp)
  -- if premIL <: ifPrem
  -- let IF typedExp = premIL as ifPrem

  clause 2 : (premIL) = $free_varis_exps(typedExp*{typedExp <- typedExp*})
  -- if premIL <: ifHoldPrem
  -- let IFHOLD _id ':' typedExp*{typedExp <- typedExp*} = premIL as ifHoldPrem

  clause 3 : (premIL) = $free_varis_exps(typedExp*{typedExp <- typedExp*})
  -- if premIL <: ifNotHoldPrem
  -- let IFNOTHOLD _id ':' typedExp*{typedExp <- typedExp*} = premIL as ifNotHoldPrem

  clause 4 : (premIL') = vari_iter*{vari_iter <- vari_iter*}
  -- if premIL' <: iterPremIL
  -- let ITER premIL iter _vari*{_vari <- _vari*} = premIL' as iterPremIL
  -- let vari*{vari <- vari*} = $free_varis_premIL(premIL)
  -- (let vari_iter = $iterate_vari(vari, [iter]))*{vari <- vari*, vari_iter -> vari_iter*}

  clause 5 : (premIL) = $free_varis_exp(typedExp)
  -- if premIL <: debugPrem
  -- let DEBUG typedExp = premIL as debugPrem

def $free_varis_premILs(premIL*) : vari* =

  clause 0 : (premIL*{premIL <- premIL*}) = []
  -- if premIL*{premIL <- premIL*} matches []

  clause 1 : (premIL*{premIL <- premIL*}) = $free_varis_premIL(premIL_h) ++ $free_varis_premILs(premIL_t*{premIL_t <- premIL_t*})
  -- if premIL*{premIL <- premIL*} matches _ :: _
  -- let premIL_h :: premIL_t*{premIL_t <- premIL_t*} = premIL*{premIL <- premIL*}

def $free_varis_rulIL(rulIL) : vari* =

  clause 0 : (_id ':' typedExp*{typedExp <- typedExp*} '-' premIL*{premIL <- premIL*}) = $free_varis_exps(typedExp*{typedExp <- typedExp*}) ++ $free_varis_premILs(premIL*{premIL <- premIL*})

def $free_varis_clauseIL(clauseIL) : vari* =

  clause 0 : (arg*{arg <- arg*} '=' typedExp '-' premIL*{premIL <- premIL*}) = $free_varis_args(arg*{arg <- arg*}) ++ $free_varis_exp(typedExp) ++ $free_varis_premILs(premIL*{premIL <- premIL*})

def $free_varis_tblRowIL(tblRowIL) : vari* =

  clause 0 : (arg*{arg <- arg*} '=' typedExp) = $free_varis_args(arg*{arg <- arg*}) ++ $free_varis_exp(typedExp)

def $is_sub_iter(iter, iter) : bool =

  clause 0 : (iter, iter') = true
  -- if (iter = iter')

  clause 1 : (iter, iter') = true
  -- if iter matches QUEST
  -- if iter' matches STAR

  clause -1 : (iter_l, iter_r) = false

def $is_iter_sub(typ, iter) : bool =

  clause 0 : (typ, iter_r) = $is_sub_iter(iter_l, iter_r)
  -- if typ matches ITER % %
  -- let ITER _typ iter_l = typ

  clause -1 : (typ, iter) = false

def $is_equiv_case(tdenv, typCase, typCase) : bool =

  clause 0 : (tdenv, mixop typ_l*{typ_l <- typ_l*} FROM _typOrigin, mixop' typ_r*{typ_r <- typ_r*} FROM _typOrigin') = b
  -- if (mixop = mixop')
  -- let equivRes = $equiv_typs(tdenv, typ_l*{typ_l <- typ_l*}, typ_r*{typ_r <- typ_r*})
  -- let b = (equivRes = OK true as equivRes)

  clause -1 : (tdenv, typCase_l, typCase_r) = false

def $has_equiv_case(tdenv, typCase, typCase*) : bool =

  clause 0 : (tdenv, typCase, typCase_r*{typCase_r <- typCase_r*}) = $exists_(b*{b <- b*})
  -- let b*{b <- b*} = $is_equiv_case(tdenv, typCase, typCase_r)*{typCase_r <- typCase_r*}

def $inst_cases(tdenv, id, targ*) : typCase*? =

  clause 0 : (tdenv, id, targ*{targ <- targ*}) = ?(typCase_inst*{typCase_inst <- typCase_inst*})
  -- let typDef'?{typDef' <- typDef'?} = $find_map<id, typDef>(tdenv, id)
  -- if typDef'?{typDef' <- typDef'?} matches (_)
  -- let ?(typDef) = typDef'?{typDef' <- typDef'?}
  -- if typDef <: definedTypDefn
  -- let TYP _id tparam*{tparam <- tparam*} '=' deftyp = typDef as definedTypDefn
  -- if deftyp matches VARIANT %
  -- let VARIANT typCase*{typCase <- typCase*} = deftyp
  -- if (|tparam*{tparam <- tparam*}| = |targ*{targ <- targ*}|)
  -- let theta = `{ tparam ':' targ*{targ <- targ*, tparam <- tparam*} `}
  -- (let mixop typ_case*{typ_case <- typ_case*} FROM id_origin targ_origin*{targ_origin <- targ_origin*} = typCase)*{typCase <- typCase*, id_origin -> id_origin*, mixop -> mixop*, targ_origin* -> targ_origin**, typ_case* -> typ_case**}
  -- (let typsRes = $subst_typs(theta, typ_case*{typ_case <- typ_case*}))*{typ_case* <- typ_case**, typsRes -> typsRes*}
  -- (if typsRes <: ok<typ*>)*{typsRes <- typsRes*}
  -- (let OK typ_case_inst*{typ_case_inst <- typ_case_inst*} = typsRes as ok<typ*>)*{typsRes <- typsRes*, typ_case_inst* -> typ_case_inst**}
  -- (let typsRes' = $subst_typs(theta, targ_origin*{targ_origin <- targ_origin*}))*{targ_origin* <- targ_origin**, typsRes' -> typsRes'*}
  -- (if typsRes' <: ok<typ*>)*{typsRes' <- typsRes'*}
  -- (let OK targ_origin_inst*{targ_origin_inst <- targ_origin_inst*} = typsRes' as ok<typ*>)*{typsRes' <- typsRes'*, targ_origin_inst* -> targ_origin_inst**}
  -- let typCase_inst*{typCase_inst <- typCase_inst*} = mixop typ_case_inst*{typ_case_inst <- typ_case_inst*} FROM id_origin targ_origin_inst*{targ_origin_inst <- targ_origin_inst*}*{id_origin <- id_origin*, mixop <- mixop*, targ_origin_inst* <- targ_origin_inst**, typ_case_inst* <- typ_case_inst**}

  clause -1 : (tdenv, id, targ*{targ <- targ*}) = ?()

def $sub_typ(tdenv, typ, typ) : equivRes =

  clause 0 : (tdenv, typ_l, typ_r) = $sub_typ'(tdenv, typ_l_expand, typ_r_expand)
  -- let typRes = $expand_typ(tdenv, typ_l)
  -- if typRes <: ok<typ>
  -- let OK typ_l_expand = typRes as ok<typ>
  -- let typRes' = $expand_typ(tdenv, typ_r)
  -- if typRes' <: ok<typ>
  -- let OK typ_r_expand = typRes' as ok<typ>

  clause -1 : (tdenv, typ_l, typ_r) = ERROR as equivRes

def $sub_typs(tdenv, typ*, typ*) : equivRes =

  clause 0 : (tdenv, typ*{typ <- typ*}, typ'*{typ' <- typ'*}) = OK true as equivRes
  -- if typ*{typ <- typ*} matches []
  -- if typ'*{typ' <- typ'*} matches []

  clause 1 : (tdenv, typ*{typ <- typ*}, typ'*{typ' <- typ'*}) = $sub_typs(tdenv, typ_l_t*{typ_l_t <- typ_l_t*}, typ_r_t*{typ_r_t <- typ_r_t*})
  -- if typ*{typ <- typ*} matches _ :: _
  -- let typ_l :: typ_l_t*{typ_l_t <- typ_l_t*} = typ*{typ <- typ*}
  -- if typ'*{typ' <- typ'*} matches _ :: _
  -- let typ_r :: typ_r_t*{typ_r_t <- typ_r_t*} = typ'*{typ' <- typ'*}
  -- if (OK true as equivRes = $sub_typ(tdenv, typ_l, typ_r))

  clause 2 : (tdenv, typ*{typ <- typ*}, typ'*{typ' <- typ'*}) = equivRes
  -- if typ*{typ <- typ*} matches _ :: _
  -- let typ_l :: typ_l_t*{typ_l_t <- typ_l_t*} = typ*{typ <- typ*}
  -- if typ'*{typ' <- typ'*} matches _ :: _
  -- let typ_r :: typ_r_t*{typ_r_t <- typ_r_t*} = typ'*{typ' <- typ'*}
  -- let equivRes = $sub_typ(tdenv, typ_l, typ_r)
  -- if (equivRes =/= OK true as equivRes)

  clause 3 : (tdenv, typ*{typ <- typ*}, typ'*{typ' <- typ'*}) = OK false as equivRes
  -- if typ*{typ <- typ*} matches []
  -- if typ'*{typ' <- typ'*} matches _ :: _
  -- let typ_r :: typ_r_t*{typ_r_t <- typ_r_t*} = typ'*{typ' <- typ'*}

  clause 4 : (tdenv, typ*{typ <- typ*}, typ'*{typ' <- typ'*}) = OK false as equivRes
  -- if typ*{typ <- typ*} matches _ :: _
  -- let typ_l :: typ_l_t*{typ_l_t <- typ_l_t*} = typ*{typ <- typ*}
  -- if typ'*{typ' <- typ'*} matches []

def $sub_typ'(tdenv, typ, typ) : equivRes =

  clause 0 : (tdenv, typ_l, typ_r) = OK true as equivRes
  -- if (OK true as equivRes = $equiv_typ'(tdenv, typ_l, typ_r))

  clause 1 : (tdenv, typ_l, typ_r) = $sub_typ''(tdenv, typ_l, typ_r)
  -- if (OK false as equivRes = $equiv_typ'(tdenv, typ_l, typ_r))

  clause -1 : (tdenv, typ_l, typ_r) = ERROR as equivRes

def $sub_typ''(tdenv, typ, typ) : equivRes =

  clause 0 : (tdenv, typ, typ') = OK true as equivRes
  -- if typ <: numtyp
  -- let numtyp = typ as numtyp
  -- if numtyp matches NAT
  -- if typ' <: numtyp
  -- let numtyp' = typ' as numtyp
  -- if numtyp' matches INT

  clause 1 : (tdenv, typ, typ') = OK b as equivRes
  -- if typ matches VAR % %
  -- let VAR id_l targ_l*{targ_l <- targ_l*} = typ
  -- if typ' matches VAR % %
  -- let VAR id_r targ_r*{targ_r <- targ_r*} = typ'
  -- let typCase*{typCase <- typCase*}?{typCase* <- typCase*?} = $inst_cases(tdenv, id_l, targ_l*{targ_l <- targ_l*})
  -- if typCase*{typCase <- typCase*}?{typCase* <- typCase*?} matches (_)
  -- let ?(typCase_l*{typCase_l <- typCase_l*}) = typCase*{typCase <- typCase*}?{typCase* <- typCase*?}
  -- let typCase'*{typCase' <- typCase'*}?{typCase'* <- typCase'*?} = $inst_cases(tdenv, id_r, targ_r*{targ_r <- targ_r*})
  -- if typCase'*{typCase' <- typCase'*}?{typCase'* <- typCase'*?} matches (_)
