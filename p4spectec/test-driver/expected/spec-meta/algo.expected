  clause -1 : (C, vari*{vari <- vari*}) = ERROR as subListRes

syntax funcRes =
   | OK val (from ok<val>)
   | ERROR (from error)
   | UNMATCH (from unmatch)

extern relation Call_extern_func: |- id `< typ* `> `( val* `) : funcRes

extern relation Call_builtin_func: |- id `< typ* `> `( val* `) : funcRes

syntax relRes =
   | OK val* (from ok<val*>)
   | ERROR (from error)
   | UNMATCH (from unmatch)

extern relation Call_extern_rel: |- id `( val* `) : relRes

syntax expRes =
   | OK val (from ok<val>)
   | ERROR (from error)
   | UNMATCH (from unmatch)

