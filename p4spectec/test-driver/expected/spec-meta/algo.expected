syntax varr =
   | id iter* (from varr)

syntax venv = map<varr, val>

syntax renv = map<id, relDefnAL>

syntax fenv = map<id, funcDefnAL>

syntax fnenv = map<id, id>

syntax globalLayer = {TYP tdenv, REL renv, FUNC fenv}

syntax localLayer = {TYP tdenv, FUNC fnenv, VAL venv}

def $empty_globalLayer : globalLayer =

  clause 0 :  = {TYP $empty_map<id, typDef>, REL $empty_map<id, relDefnAL>, FUNC $empty_map<id, funcDefnAL>}

def $empty_localLayer : localLayer =

  clause 0 :  = {TYP $empty_map<id, typDef>, FUNC $empty_map<id, id>, VAL $empty_map<varr, val>}

syntax ctx = {GLOBAL globalLayer, LOCAL localLayer}

def $empty_ctx : ctx =

  clause 0 :  = {GLOBAL $empty_globalLayer, LOCAL $empty_localLayer}

var C : ctx

