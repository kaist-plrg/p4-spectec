syntax fail =
   | FAIL (from fail)

syntax notTyp =
   | mixop typ* (from notTyp)

syntax relKind =
   | EXTERN (from relKind)
   | DEFINED (from relKind)

syntax relSig =
   | relKind notTyp `( inputHint `) (from relSig)

syntax funcKind =
   | EXTERN (from funcKind)
   | BUILTIN (from funcKind)
   | TABLE (from funcKind)
   | DEFINED (from funcKind)

syntax funcSig =
   | funcKind tparam* param* ':' typ (from funcSig)

syntax menv = map<id, typ>

syntax rsigenv = map<id, relSig>

syntax fsigenv = map<id, funcSig>

syntax body =
   | RULES rulGroupIL* elsGroupIL? (from body)
   | CLAUSES clauseIL* elsClauseIL? (from body)
   | ROWS tblRowIL* (from body)

syntax bodyenv = map<id, body>

syntax elabCtx = {TYP tdenv, VAR menv, REL rsigenv, FUNC fsigenv, BODY bodyenv}

var EC : elabCtx

def $empty_elabCtx : elabCtx =

  clause 0 :  = {TYP $empty_map<id, typDef>, VAR menv_prim, REL $empty_map<id, relSig>, FUNC $empty_map<id, funcSig>, BODY $empty_map<id, body>}
