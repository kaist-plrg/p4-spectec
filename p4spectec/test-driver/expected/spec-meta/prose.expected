relation Shallowbind_exp: AC |- (exp' '#' typ')

1. Case analysis on exp'

  1. Case (% has type varExp, let varExp = %)

    1. Group variable: AC |- ((varExp as exp) '#' typ')

      1. The relation holds

  2. Case (% has type upCastExp, let (UPCAST typ typedExp) = %)

    1. Group upcast: AC |- (((UPCAST typ typedExp) as exp) '#' typ')

      1. (Let (exp '#' _typ) be typedExp)

      2. Check (((exp has type varExp) \/ (exp has type injExp)))

        1. If (Shallowbind_exp: AC |- typedExp) holds, then

          1. The relation holds

        1. Else Dangling

  3. Case (% has type injExp, let (INJ (mixop (typedExp)*{typedExp <- typedExp*})) = %)

    1. Group case: AC |- (((INJ (mixop (typedExp)*{typedExp <- typedExp*})) as exp) '#' typ')

      1. Check ($forall_(($is_irrefutable_exp(AC.TYP, typedExp))*{typedExp <- typedExp*}))

        1. The relation holds

1. Else Dangling

relation Shallowbind_arg: AC |- arg

1. Check ((arg has type expArg))

  1. (Let (EXP typedExp) be (arg as expArg))

  2. Group exp: AC |- ((EXP typedExp) as arg)

    1. If (Shallowbind_exp: AC |- typedExp) holds, then

      1. The relation holds

    1. Else Dangling

relation Shallowbind_args: AC |- (arg)*{arg <- arg*}

1. Group : AC |- (arg)*{arg <- arg*}

  1. If (Shallowbind_arg: AC |- arg)*{arg <- arg*} holds, then

    1. (Multibind_args: AC |- (arg)*{arg <- arg*} : _AC (_arg)*{_arg <- _arg*} (premAL)*{premAL <- premAL*})

    2. Check (((premAL)*{premAL <- premAL*} matches pattern []))

      1. The relation holds

  1. Else Dangling

