        5. (Let definedFuncDefnAL_guard be (FUNC id (tparam)*{tparam <- tparam*} (param)*{param <- param*} ':' typ '=' (clauseAL_guard)*{clauseAL_guard <- clauseAL_guard*} (elsClauseAL_guard)?{elsClauseAL_guard <- elsClauseAL_guard?}))

        6. Result in: % |- % : (definedFuncDefnAL_guard as defnAL)

