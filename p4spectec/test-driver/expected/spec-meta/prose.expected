relation Collectbind_args: AC |- (arg)*{arg <- arg*} : %

1. Group : AC |- (arg)*{arg <- arg*} : %

  1. Case analysis on (arg)*{arg <- arg*} (total)

    1. Case (% matches pattern [])

      1. Result in: % |- % : []

    2. Case (% matches pattern _ :: _)

      1. (Let arg_h :: (arg_t)*{arg_t <- arg_t*} be (arg)*{arg <- arg*})

      2. (Collectbind_arg: AC |- arg_h : (vari_h)*{vari_h <- vari_h*})

      3. (Collectbind_args: AC |- (arg_t)*{arg_t <- arg_t*} : (vari_t)*{vari_t <- vari_t*})

      4. Result in: % |- % : (vari_h)*{vari_h <- vari_h*} ++ (vari_t)*{vari_t <- vari_t*}

relation Multibind_exps: AC IC |- (typedExp)*{typedExp <- typedExp*} : % % %

1. Group : AC IC |- (typedExp)*{typedExp <- typedExp*} : % % %

  1. (Collectbind_exps: AC |- (typedExp)*{typedExp <- typedExp*} : (vari_bind)*{vari_bind <- vari_bind*})

  2. (Let R be $init_renamer(AC.USED, (vari_bind)*{vari_bind <- vari_bind*}))

  3. (Let (R_multi, (typedExp_multi)*{typedExp_multi <- typedExp_multi*}) be $rename_exps(R, (typedExp)*{typedExp <- typedExp*}))

  4. (Let (premAL_eq)*{premAL_eq <- premAL_eq*} be $sideconds_multi(IC, (vari_bind)*{vari_bind <- vari_bind*}, R_multi))

  5. (Let AC_multi be AC[USED = R_multi.USED])

  6. Result in: % % |- % : AC_multi (typedExp_multi)*{typedExp_multi <- typedExp_multi*} (premAL_eq)*{premAL_eq <- premAL_eq*}

relation Multibind_args: AC |- (arg)*{arg <- arg*} : % % %

1. Group : AC |- (arg)*{arg <- arg*} : % % %

  1. (Collectbind_args: AC |- (arg)*{arg <- arg*} : (vari_bind)*{vari_bind <- vari_bind*})

  2. (Let R be $init_renamer(AC.USED, (vari_bind)*{vari_bind <- vari_bind*}))

  3. (Let (R_multi, (arg_multi)*{arg_multi <- arg_multi*}) be $rename_args(R, (arg)*{arg <- arg*}))

  4. (Let (premAL_eq)*{premAL_eq <- premAL_eq*} be $sideconds_multi([], (vari_bind)*{vari_bind <- vari_bind*}, R_multi))

  5. (Let AC_multi be AC[USED = R_multi.USED])

  6. Result in: % |- % : AC_multi (arg_multi)*{arg_multi <- arg_multi*} (premAL_eq)*{premAL_eq <- premAL_eq*}

relation Partialbind_exp: AC IC_prem |- IC typedExp : % % % %

1. Group : AC IC_prem |- IC typedExp : % % % %

  1. Case analysis on $decomposes(AC, typedExp) (total)

    1. Case false

      1. (Let (vari_read)*{vari_read <- vari_read*} be $free_varis_exp(typedExp))

      2. Check ($is_bound(AC, IC ++ IC_prem, (vari_read)*{vari_read <- vari_read*}))

        1. (Let (_exp '#' typ) be typedExp)

        2. (Let (AC_fresh, vari_d) be $fresh_vari(AC, IC ++ IC_prem, typ))

        3. (Let typedExp_d be $exp_of_vari(vari_d))

        4. (Let typedExp_check be ((CMP ((EQ) as cmpop) typedExp_d typedExp) '#' ((BOOL) as typ)))

        5. (Let (id_d _typ (_iter)*{_iter <- _iter*}) be vari_d)

        6. (Let (id_read)*{id_read <- id_read*} be $ids_of_varis((vari_read)*{vari_read <- vari_read*}))

        7. (Let IC_d be $add_iterated(IC ++ IC_prem, [vari_d]))

        8. (Let (premIterAL)*{premIterAL <- premIterAL*} be $prem_iters(IC_d, id_d :: (id_read)*{id_read <- id_read*}, []))

        9. (Let premAL_check be $iterate_prem(((IF typedExp_check) as premAL), (premIterAL)*{premIterAL <- premIterAL*}))

        10. (Let IC_fresh be $add_iterated(IC, [vari_d]))

        11. Result in: % % |- % % : AC_fresh IC_fresh typedExp_d [premAL_check]

    2. Case true

      1. (Partialbind_exp_decomposed: AC IC_prem |- IC typedExp : AC_part IC_part typedExp_part (premAL)*{premAL <- premAL*})

      2. Result in: % % |- % % : AC_part IC_part typedExp_part (premAL)*{premAL <- premAL*}

relation Partialbind_exp_decomposed: AC IC_prem |- IC (exp '#' typ) : % % % %

1. Case analysis on exp

  1. Case (% matches pattern VAR %, let (VAR id) = %)

    1. Group variable: AC IC_prem |- IC ((VAR id) '#' typ) : % % % %

      1. Result in: % % |- % % : AC IC ((VAR id) '#' typ) []

  2. Case (% matches pattern UPCAST % %, let (UPCAST typ' typedExp) = %)

    1. Group upcast: AC IC_prem |- IC ((UPCAST typ' typedExp) '#' typ) : % % % %

      1. (Partialbind_exp: AC IC_prem |- IC typedExp : AC_sub IC_sub typedExp_sub (premAL)*{premAL <- premAL*})

      2. (Let (_exp '#' typ_sub) be typedExp_sub)

      3. (Let (AC_fresh, vari_d) be $fresh_vari(AC_sub, IC_sub ++ IC_prem, typ))

      4. (Let typedExp_d be $exp_of_vari(vari_d))

      5. (Let typedExp_check be ((SUB typedExp_d typ_sub) '#' ((BOOL) as typ)))

      6. (Let typedExp_down be ((DOWNCAST typ_sub typedExp_d) '#' typ_sub))

      7. (Let premAL_check be $sidecond_partial(IC_sub ++ IC_prem, vari_d, typedExp_check))

      8. (Let premAL_let be $let_partial(IC_sub ++ IC_prem, vari_d, typedExp_sub, typedExp_down))

      9. (Let IC_fresh be $add_iterated(IC_sub, [vari_d]))

      10. Result in: % % |- % % : AC_fresh IC_fresh typedExp_d premAL_check :: premAL_let :: (premAL)*{premAL <- premAL*}

  3. Case (% matches pattern TUP %, let (TUP (typedExp)*{typedExp <- typedExp*}) = %)

    1. Group tuple: AC IC_prem |- IC ((TUP (typedExp)*{typedExp <- typedExp*}) '#' typ) : % % % %

      1. (Partialbind_exps: AC IC_prem |- IC (typedExp)*{typedExp <- typedExp*} : AC_sub IC_sub (typedExp_part)*{typedExp_part <- typedExp_part*} (premAL)*{premAL <- premAL*})

      2. Result in: % % |- % % : AC_sub IC_sub ((TUP (typedExp_part)*{typedExp_part <- typedExp_part*}) '#' typ) (premAL)*{premAL <- premAL*}

  4. Case (% matches pattern INJ %, let (INJ (mixop (typedExp)*{typedExp <- typedExp*})) = %)

    1. Group case: AC IC_prem |- IC ((INJ (mixop (typedExp)*{typedExp <- typedExp*})) '#' typ) : % % % %

      1. (Partialbind_exps: AC IC_prem |- IC (typedExp)*{typedExp <- typedExp*} : AC_sub IC_sub (typedExp_part)*{typedExp_part <- typedExp_part*} (premAL)*{premAL <- premAL*})

      2. (Let typedExp_case be ((INJ (mixop (typedExp_part)*{typedExp_part <- typedExp_part*})) '#' typ))

      3. (Let (AC_fresh, vari_d) be $fresh_vari(AC_sub, IC_sub ++ IC_prem, typ))

      4. (Let typedExp_d be $exp_of_vari(vari_d))

      5. (Let typedExp_check be ((MATCH typedExp_d (INJ mixop)) '#' ((BOOL) as typ)))

      6. (Let premAL_check be $sidecond_partial(IC_sub ++ IC_prem, vari_d, typedExp_check))

      7. (Let premAL_let be $let_partial(IC_sub ++ IC_prem, vari_d, typedExp_case, typedExp_d))

      8. (Let IC_fresh be $add_iterated(IC_sub, [vari_d]))

      9. Result in: % % |- % % : AC_fresh IC_fresh typedExp_d premAL_check :: premAL_let :: (premAL)*{premAL <- premAL*}

  5. Case (% matches pattern STR %, let (STR (expField)*{expField <- expField*}) = %)

    1. Group struct: AC IC_prem |- IC ((STR (expField)*{expField <- expField*}) '#' typ) : % % % %

      1. (Let (atom typedExp) be expField)*{expField <- expField*, atom -> atom*, typedExp -> typedExp*}

      2. (Partialbind_exps: AC IC_prem |- IC (typedExp)*{typedExp <- typedExp*} : AC_sub IC_sub (typedExp_part)*{typedExp_part <- typedExp_part*} (premAL)*{premAL <- premAL*})

      3. Check ((|(atom)*{atom <- atom*}| = |(typedExp_part)*{typedExp_part <- typedExp_part*}|))

        1. (Let expField_part be (atom typedExp_part))*{atom <- atom*, typedExp_part <- typedExp_part*, expField_part -> expField_part*}

        2. Result in: % % |- % % : AC_sub IC_sub ((STR (expField_part)*{expField_part <- expField_part*}) '#' typ) (premAL)*{premAL <- premAL*}

  6. Case (% matches pattern OPT %, let (OPT (typedExp')?{typedExp' <- typedExp'?}) = %)

    1. Check (((typedExp')?{typedExp' <- typedExp'?} matches pattern (_)))

      1. (Let ?(typedExp) be (typedExp')?{typedExp' <- typedExp'?})

      2. Group opt: AC IC_prem |- IC ((OPT ?(typedExp)) '#' typ) : % % % %

        1. (Partialbind_exp: AC IC_prem |- IC typedExp : AC_sub IC_sub typedExp_part (premAL)*{premAL <- premAL*})

        2. (Let typedExp_opt be ((OPT ?(typedExp_part)) '#' typ))

        3. (Let (AC_fresh, vari_d) be $fresh_vari(AC_sub, IC_sub ++ IC_prem, typ))

        4. (Let typedExp_d be $exp_of_vari(vari_d))

        5. (Let typedExp_check be ((MATCH typedExp_d ((SOME) as pat)) '#' ((BOOL) as typ)))

        6. (Let premAL_check be $sidecond_partial(IC_sub ++ IC_prem, vari_d, typedExp_check))

        7. (Let premAL_let be $let_partial(IC_sub ++ IC_prem, vari_d, typedExp_opt, typedExp_d))

        8. (Let IC_fresh be $add_iterated(IC_sub, [vari_d]))

        9. Result in: % % |- % % : AC_fresh IC_fresh typedExp_d premAL_check :: premAL_let :: (premAL)*{premAL <- premAL*}

  7. Case (% matches pattern LIST %, let (LIST (typedExp)*{typedExp <- typedExp*}) = %)

    1. Group list: AC IC_prem |- IC ((LIST (typedExp)*{typedExp <- typedExp*}) '#' typ) : % % % %

      1. (Partialbind_exps: AC IC_prem |- IC (typedExp)*{typedExp <- typedExp*} : AC_sub IC_sub (typedExp_part)*{typedExp_part <- typedExp_part*} (premAL)*{premAL <- premAL*})

      2. (Let typedExp_list be ((LIST (typedExp_part)*{typedExp_part <- typedExp_part*}) '#' typ))

      3. (Let (AC_fresh, vari_d) be $fresh_vari(AC_sub, IC_sub ++ IC_prem, typ))

      4. (Let typedExp_d be $exp_of_vari(vari_d))

      5. (Let n be |(typedExp)*{typedExp <- typedExp*}|)

      6. (Let typedExp_check be ((MATCH typedExp_d ((FIXED n) as pat)) '#' ((BOOL) as typ)))

      7. (Let premAL_check be $sidecond_partial(IC_sub ++ IC_prem, vari_d, typedExp_check))

      8. (Let premAL_let be $let_partial(IC_sub ++ IC_prem, vari_d, typedExp_list, typedExp_d))

      9. (Let IC_fresh be $add_iterated(IC_sub, [vari_d]))

      10. Result in: % % |- % % : AC_fresh IC_fresh typedExp_d premAL_check :: premAL_let :: (premAL)*{premAL <- premAL*}

  8. Case (% matches pattern CONS % %, let (CONS typedExp_h typedExp_t) = %)

    1. Group cons: AC IC_prem |- IC ((CONS typedExp_h typedExp_t) '#' typ) : % % % %

      1. (Partialbind_exp: AC IC_prem |- IC typedExp_h : AC_h IC_h typedExp_h_part (premAL_h)*{premAL_h <- premAL_h*})

      2. (Partialbind_exp: AC_h IC_prem |- IC_h typedExp_t : AC_t IC_t typedExp_t_part (premAL_t)*{premAL_t <- premAL_t*})

      3. (Let typedExp_cons be ((CONS typedExp_h_part typedExp_t_part) '#' typ))

      4. (Let (AC_fresh, vari_d) be $fresh_vari(AC_t, IC_t ++ IC_prem, typ))

      5. (Let typedExp_d be $exp_of_vari(vari_d))

      6. (Let typedExp_check be ((MATCH typedExp_d ((CONS) as pat)) '#' ((BOOL) as typ)))

      7. (Let premAL_check be $sidecond_partial(IC_t ++ IC_prem, vari_d, typedExp_check))

      8. (Let premAL_let be $let_partial(IC_t ++ IC_prem, vari_d, typedExp_cons, typedExp_d))

      9. (Let IC_fresh be $add_iterated(IC_t, [vari_d]))

      10. Result in: % % |- % % : AC_fresh IC_fresh typedExp_d premAL_check :: premAL_let :: (premAL_h)*{premAL_h <- premAL_h*} ++ (premAL_t)*{premAL_t <- premAL_t*}

  9. Case (% matches pattern ITER % %, let (ITER typedExp (iter (vari)*{vari <- vari*})) = %)

    1. Group iter: AC IC_prem |- IC ((ITER typedExp (iter (vari)*{vari <- vari*})) '#' typ) : % % % %

      1. (Partialbind_exp: AC IC_prem |- (iter (vari)*{vari <- vari*}) :: IC typedExp : AC_sub (premIterIL)*{premIterIL <- premIterIL*} typedExp_part (premAL)*{premAL <- premAL*})

      2. Check (((premIterIL)*{premIterIL <- premIterIL*} matches pattern _ :: _))

        1. (Let (iter' (vari_iter)*{vari_iter <- vari_iter*}) :: IC_sub be (premIterIL)*{premIterIL <- premIterIL*})

        2. Check ((iter' = iter))

          1. (Let (vari')*{vari' <- vari'*} be $free_varis_exp(typedExp_part))

          2. (Let (id')*{id' <- id'*} be $ids_of_varis((vari')*{vari' <- vari'*}))

          3. (Let (vari_part)*{vari_part <- vari_part*} be $select_varis((vari_iter)*{vari_iter <- vari_iter*}, (id')*{id' <- id'*}))

          4. Result in: % % |- % % : AC_sub IC_sub ((ITER typedExp_part (iter (vari_part)*{vari_part <- vari_part*})) '#' typ) (premAL)*{premAL <- premAL*}

1. Else Dangling

relation Partialbind_exps: AC IC_prem |- IC (typedExp)*{typedExp <- typedExp*} : % % % %

1. Group : AC IC_prem |- IC (typedExp)*{typedExp <- typedExp*} : % % % %

  1. Case analysis on (typedExp)*{typedExp <- typedExp*} (total)

    1. Case (% matches pattern [])

      1. Result in: % % |- % % : AC IC [] []

    2. Case (% matches pattern _ :: _)

      1. (Let typedExp_h :: (typedExp_t)*{typedExp_t <- typedExp_t*} be (typedExp)*{typedExp <- typedExp*})

      2. (Partialbind_exp: AC IC_prem |- IC typedExp_h : AC_h IC_h typedExp_h_part (premAL_h)*{premAL_h <- premAL_h*})

      3. (Partialbind_exps: AC_h IC_prem |- IC_h (typedExp_t)*{typedExp_t <- typedExp_t*} : AC_t IC_t (typedExp_t_part)*{typedExp_t_part <- typedExp_t_part*} (premAL_t)*{premAL_t <- premAL_t*})

      4. Result in: % % |- % % : AC_t IC_t typedExp_h_part :: (typedExp_t_part)*{typedExp_t_part <- typedExp_t_part*} (premAL_h)*{premAL_h <- premAL_h*} ++ (premAL_t)*{premAL_t <- premAL_t*}

relation Partialbind_arg: AC |- arg : % % %

1. Case analysis on arg (total)

  1. Case (% matches pattern EXP %, let (EXP typedExp) = %)

    1. Group exp: AC |- (EXP typedExp) : % % %

      1. (Partialbind_exp: AC [] |- [] typedExp : AC_part _IC typedExp_part (premAL)*{premAL <- premAL*})

      2. Result in: % |- % : AC_part (EXP typedExp_part) (premAL)*{premAL <- premAL*}

  2. Case (% matches pattern FUN %, let (FUN id) = %)

    1. Group fun: AC |- (FUN id) : % % %

      1. Result in: % |- % : AC (FUN id) []

relation Partialbind_args: AC |- (arg')*{arg' <- arg'*} : % % %

1. Group : AC |- (arg')*{arg' <- arg'*} : % % %

  1. Case analysis on (arg')*{arg' <- arg'*} (total)

    1. Case (% matches pattern [])

      1. Result in: % |- % : AC [] []

    2. Case (% matches pattern _ :: _)

      1. (Let arg_h :: (arg_t)*{arg_t <- arg_t*} be (arg')*{arg' <- arg'*})

      2. (Partialbind_arg: AC |- arg_h : AC_h arg_h_part (premAL_h)*{premAL_h <- premAL_h*})

      3. (Partialbind_args: AC_h |- (arg_t)*{arg_t <- arg_t*} : AC_t (arg_t_part)*{arg_t_part <- arg_t_part*} (premAL_t)*{premAL_t <- premAL_t*})

      4. (Let (arg)*{arg <- arg*} be arg_h_part :: (arg_t_part)*{arg_t_part <- arg_t_part*})

      5. (Let (premAL)*{premAL <- premAL*} be (premAL_h)*{premAL_h <- premAL_h*} ++ (premAL_t)*{premAL_t <- premAL_t*})

      6. Result in: % |- % : AC_t (arg)*{arg <- arg*} (premAL)*{premAL <- premAL*}

relation Bind_exps: AC IC |- (typedExp)*{typedExp <- typedExp*} : % % %

1. Group : AC IC |- (typedExp)*{typedExp <- typedExp*} : % % %

  1. (Multibind_exps: AC IC |- (typedExp)*{typedExp <- typedExp*} : AC_multi (typedExp_multi)*{typedExp_multi <- typedExp_multi*} (premAL_eq)*{premAL_eq <- premAL_eq*})

  2. (Partialbind_exps: AC_multi IC |- [] (typedExp_multi)*{typedExp_multi <- typedExp_multi*} : AC_part _IC (typedExp_part)*{typedExp_part <- typedExp_part*} (premAL_part)*{premAL_part <- premAL_part*})

  3. (Collectbind_exps: AC_multi |- (typedExp_multi)*{typedExp_multi <- typedExp_multi*} : (vari_bind)*{vari_bind <- vari_bind*})

  4. (Let ((iter (_vari)*{_vari <- _vari*}))*{_vari* <- _vari**, iter <- iter*} be IC)

  5. (Let vari be $iterate_vari(vari_bind, (iter)*{iter <- iter*}))*{vari_bind <- vari_bind*, vari -> vari*}

  6. (Let AC_bound be $add_bound(AC_part, (vari)*{vari <- vari*}))

  7. Result in: % % |- % : AC_bound (typedExp_part)*{typedExp_part <- typedExp_part*} (premAL_part)*{premAL_part <- premAL_part*} ++ (premAL_eq)*{premAL_eq <- premAL_eq*}

relation Bind_args: AC |- (arg)*{arg <- arg*} : % % %

1. Group : AC |- (arg)*{arg <- arg*} : % % %

  1. (Multibind_args: AC |- (arg)*{arg <- arg*} : AC_multi (arg_multi)*{arg_multi <- arg_multi*} (premAL_eq)*{premAL_eq <- premAL_eq*})

  2. (Partialbind_args: AC_multi |- (arg_multi)*{arg_multi <- arg_multi*} : AC_part (arg_part)*{arg_part <- arg_part*} (premAL_part)*{premAL_part <- premAL_part*})

  3. (Collectbind_args: AC_multi |- (arg_multi)*{arg_multi <- arg_multi*} : (vari_bind)*{vari_bind <- vari_bind*})

  4. (Let AC_bound be $add_bound(AC_part, (vari_bind)*{vari_bind <- vari_bind*}))

  5. Result in: % |- % : AC_bound (arg_part)*{arg_part <- arg_part*} (premAL_part)*{premAL_part <- premAL_part*} ++ (premAL_eq)*{premAL_eq <- premAL_eq*}

relation Algo_prem: AC IC |- premIL' : % %

1. Case analysis on premIL' (total)

  1. Case (% has type relPremIL, let relPremIL = %)

    1. Group rel: AC IC |- (relPremIL as premIL) : % %

      1. (Let (REL id ':' (typedExp)*{typedExp <- typedExp*} `( inputHint `)) be relPremIL)

      2. (Let ((typedExp_in)*{typedExp_in <- typedExp_in*}, (typedExp_out)*{typedExp_out <- typedExp_out*}) be $split_inputs<typedExp>(inputHint, (typedExp)*{typedExp <- typedExp*}))

      3. (Let (vari_in)*{vari_in <- vari_in*} be $free_varis_exps((typedExp_in)*{typedExp_in <- typedExp_in*}))

      4. Check ($is_bound(AC, IC, (vari_in)*{vari_in <- vari_in*}))

        1. (Bind_exps: AC IC |- (typedExp_out)*{typedExp_out <- typedExp_out*} : AC_bound (typedExp_out_part)*{typedExp_out_part <- typedExp_out_part*} (premAL_bind)*{premAL_bind <- premAL_bind*})

        2. (Let (id_read)*{id_read <- id_read*} be $ids_of_varis((vari_in)*{vari_in <- vari_in*}))

        3. (Let (vari_out)*{vari_out <- vari_out*} be $free_varis_exps((typedExp_out_part)*{typedExp_out_part <- typedExp_out_part*}))

        4. (Let (vari_bind)*{vari_bind <- vari_bind*} be $shallowest_varis((vari_out)*{vari_out <- vari_out*}))

        5. (Let IC_bind be $add_iterated(IC, (vari_bind)*{vari_bind <- vari_bind*}))

        6. (Let (id')*{id' <- id'*} be $ids_of_varis((vari_bind)*{vari_bind <- vari_bind*}))

        7. (Let (premIterAL)*{premIterAL <- premIterAL*} be $prem_iters(IC_bind, (id_read)*{id_read <- id_read*}, (id')*{id' <- id'*}))

        8. If (Iter_sourced: |- (premIterAL)*{premIterAL <- premIterAL*}) holds, then

          1. (Let relPremAL be (REL id ':' (typedExp_in)*{typedExp_in <- typedExp_in*} '->' (typedExp_out_part)*{typedExp_out_part <- typedExp_out_part*}))

          2. (Let premAL_rel be $iterate_prem((relPremAL as premAL), (premIterAL)*{premIterAL <- premIterAL*}))

          3. (Let (premAL)*{premAL <- premAL*} be premAL_rel :: (premAL_bind)*{premAL_bind <- premAL_bind*})

          4. Result in: % % |- % : AC_bound (premAL)*{premAL <- premAL*}

        8. Else Dangling

  2. Case (% has type ifPrem, let ifPrem = %)

    1. Group cond: AC IC |- (ifPrem as premIL) : % %

      1. (Let (IF typedExp) be ifPrem)

      2. Block (2 arms)

      Arm 1:

        1. (Let (vari)*{vari <- vari*} be $free_varis_exp(typedExp))

        2. If ($is_bound(AC, IC, (vari)*{vari <- vari*})), then

          1. (Let (id'')*{id'' <- id''*} be $ids_of_varis((vari)*{vari <- vari*}))

          2. (Let (premIterAL)*{premIterAL <- premIterAL*} be $prem_iters(IC, (id'')*{id'' <- id''*}, []))

          3. (Let premAL_if be $iterate_prem((ifPrem as premAL), (premIterAL)*{premIterAL <- premIterAL*}))

          4. Result in: % % |- % : AC [premAL_if]

        2. Else Dangling

      Arm 2:

        1. (Let (exp '#' _typ) be typedExp)

        2. Check ((exp matches pattern CMP % % %))

          1. (Let (CMP cmpop typedExp_l typedExp_r) be exp)

          2. Check ((cmpop has type polyCmpop))

            1. (Let polyCmpop be (cmpop as polyCmpop))

            2. Check ((polyCmpop matches pattern EQ))

              1. (Collectbind_exp: AC |- typedExp_l : (vari_l)*{vari_l <- vari_l*})

              2. Case analysis on (vari_l)*{vari_l <- vari_l*} (total)

                1. Case (% matches pattern _ :: _)

                  1. (Collectbind_exp: AC |- typedExp_r : (vari)*{vari <- vari*})

                  2. Check (((vari)*{vari <- vari*} matches pattern []))

                    1. (Algo_let: AC IC |- typedExp_l '=' typedExp_r : AC_bound (premAL)*{premAL <- premAL*})

                    2. Result in: % % |- % : AC_bound (premAL)*{premAL <- premAL*}

                2. Case (% matches pattern [])

                  1. (Collectbind_exp: AC |- typedExp_r : (vari_r)*{vari_r <- vari_r*})

                  2. Check (((vari_r)*{vari_r <- vari_r*} matches pattern _ :: _))

                    1. (Algo_let: AC IC |- typedExp_r '=' typedExp_l : AC_bound (premAL)*{premAL <- premAL*})

                    2. Result in: % % |- % : AC_bound (premAL)*{premAL <- premAL*}

  3. Case (% has type ifHoldPrem, let ifHoldPrem = %)

    1. Group ifhold: AC IC |- (ifHoldPrem as premIL) : % %

      1. (Let (IFHOLD id ':' (typedExp)*{typedExp <- typedExp*}) be ifHoldPrem)

      2. (Let (vari_read)*{vari_read <- vari_read*} be $free_varis_exps((typedExp)*{typedExp <- typedExp*}))

      3. Check ($is_bound(AC, IC, (vari_read)*{vari_read <- vari_read*}))

        1. (Let (id''')*{id''' <- id'''*} be $ids_of_varis((vari_read)*{vari_read <- vari_read*}))

        2. (Let (premIterAL)*{premIterAL <- premIterAL*} be $prem_iters(IC, (id''')*{id''' <- id'''*}, []))

        3. (Let premAL_hold be $iterate_prem((ifHoldPrem as premAL), (premIterAL)*{premIterAL <- premIterAL*}))

        4. Result in: % % |- % : AC [premAL_hold]

  4. Case (% has type ifNotHoldPrem, let ifNotHoldPrem = %)

    1. Group ifnothold: AC IC |- (ifNotHoldPrem as premIL) : % %

      1. (Let (IFNOTHOLD id ':' (typedExp)*{typedExp <- typedExp*}) be ifNotHoldPrem)

      2. (Let (vari_read)*{vari_read <- vari_read*} be $free_varis_exps((typedExp)*{typedExp <- typedExp*}))

      3. Check ($is_bound(AC, IC, (vari_read)*{vari_read <- vari_read*}))

        1. (Let (id'''')*{id'''' <- id''''*} be $ids_of_varis((vari_read)*{vari_read <- vari_read*}))

        2. (Let (premIterAL)*{premIterAL <- premIterAL*} be $prem_iters(IC, (id'''')*{id'''' <- id''''*}, []))

        3. (Let premAL_hold be $iterate_prem((ifNotHoldPrem as premAL), (premIterAL)*{premIterAL <- premIterAL*}))

        4. Result in: % % |- % : AC [premAL_hold]

  5. Case (% has type iterPremIL, let (ITER premIL premIterIL) = %)

    1. Group iter: AC IC |- ((ITER premIL premIterIL) as premIL) : % %

      1. (Let IC_iter be premIterIL :: IC)

      2. (Algo_prem: AC IC_iter |- premIL : AC_prem (premAL)*{premAL <- premAL*})

      3. Result in: % % |- % : AC_prem (premAL)*{premAL <- premAL*}

  6. Case (% has type debugPrem, let debugPrem = %)

    1. Group dbg: AC IC |- (debugPrem as premIL) : % %

      1. (Let (DEBUG typedExp) be debugPrem)

      2. (Let (vari)*{vari <- vari*} be $free_varis_exp(typedExp))

      3. Check ($is_bound(AC, IC, (vari)*{vari <- vari*}))

        1. (Let (id''''')*{id''''' <- id'''''*} be $ids_of_varis((vari)*{vari <- vari*}))

        2. (Let (premIterAL)*{premIterAL <- premIterAL*} be $prem_iters(IC, (id''''')*{id''''' <- id'''''*}, []))

        3. (Let premAL_debug be $iterate_prem((debugPrem as premAL), (premIterAL)*{premIterAL <- premIterAL*}))

        4. Result in: % % |- % : AC [premAL_debug]

relation Algo_let: AC IC |- typedExp_l '=' typedExp_r : % %

1. Group : AC IC |- typedExp_l '=' typedExp_r : % %

  1. (Bind_exps: AC IC |- [typedExp_l] : AC_bound (typedExp)*{typedExp <- typedExp*} (premAL_bind)*{premAL_bind <- premAL_bind*})

  2. Check (((typedExp)*{typedExp <- typedExp*} matches pattern [ _/1 ]))

    1. (Let [typedExp_l_part] be (typedExp)*{typedExp <- typedExp*})

    2. (Let (vari_r)*{vari_r <- vari_r*} be $free_varis_exp(typedExp_r))

    3. Check ($is_bound(AC, IC, (vari_r)*{vari_r <- vari_r*}))

      1. (Let (vari_l)*{vari_l <- vari_l*} be $free_varis_exp(typedExp_l_part))

      2. (Let (vari_bind)*{vari_bind <- vari_bind*} be $shallowest_varis((vari_l)*{vari_l <- vari_l*}))

      3. (Let IC_bind be $add_iterated(IC, (vari_bind)*{vari_bind <- vari_bind*}))

      4. (Let (id)*{id <- id*} be $ids_of_varis((vari_r)*{vari_r <- vari_r*}))

      5. (Let (id')*{id' <- id'*} be $ids_of_varis((vari_bind)*{vari_bind <- vari_bind*}))

      6. (Let (premIterAL)*{premIterAL <- premIterAL*} be $prem_iters(IC_bind, (id)*{id <- id*}, (id')*{id' <- id'*}))

      7. If (Iter_sourced: |- (premIterAL)*{premIterAL <- premIterAL*}) holds, then

        1. (Let premAL_let be $iterate_prem(((LET typedExp_l_part '=' typedExp_r) as premAL), (premIterAL)*{premIterAL <- premIterAL*}))

        2. Result in: % % |- % '=' % : AC_bound premAL_let :: (premAL_bind)*{premAL_bind <- premAL_bind*}

      7. Else Dangling

relation Algo_prems: AC |- (premIL)*{premIL <- premIL*} : % %

1. Group : AC |- (premIL)*{premIL <- premIL*} : % %

  1. Case analysis on (premIL)*{premIL <- premIL*} (total)

    1. Case (% matches pattern [])

      1. Result in: % |- % : AC []

    2. Case (% matches pattern _ :: _)

      1. (Let premIL_h :: (premIL_t)*{premIL_t <- premIL_t*} be (premIL)*{premIL <- premIL*})

      2. (Let IC be [])

      3. (Algo_prem: AC IC |- premIL_h : AC_h (premAL_h)*{premAL_h <- premAL_h*})

      4. (Algo_prems: AC_h |- (premIL_t)*{premIL_t <- premIL_t*} : AC_t (premAL_t)*{premAL_t <- premAL_t*})

      5. Result in: % |- % : AC_t (premAL_h)*{premAL_h <- premAL_h*} ++ (premAL_t)*{premAL_t <- premAL_t*}

relation Algo_tblRow: AC |- tblRowIL : %

1. Group : AC |- tblRowIL : %

  1. (Let ((arg)*{arg <- arg*} '=' typedExp) be tblRowIL)

  2. (Let (vari)*{vari <- vari*} be $free_varis_tblRowIL(tblRowIL))

  3. (Let (id_used)*{id_used <- id_used*} be $ids_of_varis((vari)*{vari <- vari*}))

  4. (Let AC_row be $add_used(AC, (id_used)*{id_used <- id_used*}))

  5. (Collectbind_args: AC_row |- (arg)*{arg <- arg*} : (vari_bind)*{vari_bind <- vari_bind*})

  6. (Let renamer be $init_renamer([], (vari_bind)*{vari_bind <- vari_bind*}))

  7. (Let (`{ ((id_bind ':' (_id)*{_id <- _id*}))*{_id* <- _id**, id_bind <- id_bind*} `}) be renamer.OCC)

  8. Check ((|(id_bind)*{id_bind <- id_bind*}| = |(vari_bind)*{vari_bind <- vari_bind*}|))

    1. (Bind_args: AC_row |- (arg)*{arg <- arg*} : AC_body (arg_part)*{arg_part <- arg_part*} (premAL)*{premAL <- premAL*})

    2. (Let (vari_body)*{vari_body <- vari_body*} be $free_varis_exp(typedExp))

    3. Check ($is_bound(AC_body, [], (vari_body)*{vari_body <- vari_body*}))

      1. Result in: % |- % : ((arg_part)*{arg_part <- arg_part*} '=' typedExp '-' (premAL)*{premAL <- premAL*})

relation TblRows_cover: AC (typ)*{typ <- typ*} |- (tblRowIL)*{tblRowIL <- tblRowIL*}

1. Group : AC (typ)*{typ <- typ*} |- (tblRowIL)*{tblRowIL <- tblRowIL*}

  1. (Let (typCase)*{typCase <- typCase*} be $variant_cases(AC.TYP, typ))*{typ <- typ*, typCase* -> typCase**}

  2. Check ((|(tblRowIL)*{tblRowIL <- tblRowIL*}| > 0))

    1. (Let i be (|(tblRowIL)*{tblRowIL <- tblRowIL*}| - 1))

    2. Check ((i has type nat))

      1. (Let n_init be (i as nat))

      2. Check ((n_init < |(tblRowIL)*{tblRowIL <- tblRowIL*}|))

        1. (Let ((arg)*{arg <- arg*} '=' _typedExp) be (tblRowIL)*{tblRowIL <- tblRowIL*}[n_init])

        2. Check ((arg matches pattern EXP %))*{arg <- arg*}

          1. (Let (EXP typedExp_last) be arg)*{arg <- arg*, typedExp_last -> typedExp_last*}

          2. Case analysis on $forall_(($is_wildcard_exp(typedExp_last))*{typedExp_last <- typedExp_last*}) (total)

            1. Case true

              1. Check (((0 + n_init) <= |(tblRowIL)*{tblRowIL <- tblRowIL*}|))

                1. (Let (((arg')*{arg' <- arg'*} '=' _typedExp'))*{_typedExp' <- _typedExp'*, arg'* <- arg'**} be (tblRowIL)*{tblRowIL <- tblRowIL*}[0 : n_init])

                2. Check ((arg' matches pattern EXP %))*{arg' <- arg'*}*{arg'* <- arg'**}

                  1. (Let (EXP typedExp) be arg')*{arg' <- arg'*, typedExp -> typedExp*}*{arg'* <- arg'**, typedExp* -> typedExp**}

                  2. (Let (typCase_row)*{typCase_row <- typCase_row*} be $covered_cases(AC.TYP, typedExp))*{typedExp <- typedExp*, typCase_row* -> typCase_row**}*{typedExp* <- typedExp**, typCase_row** -> typCase_row***}

                  3. Check ($is_exclusive((((typCase_row)*{typCase_row <- typCase_row*})*{typCase_row* <- typCase_row**})*{typCase_row** <- typCase_row***}))

                    1. The relation holds

            2. Case false

              1. (Let (((arg')*{arg' <- arg'*} '=' _typedExp'))*{_typedExp' <- _typedExp'*, arg'* <- arg'**} be (tblRowIL)*{tblRowIL <- tblRowIL*})

              2. Check ((arg' matches pattern EXP %))*{arg' <- arg'*}*{arg'* <- arg'**}

                1. (Let (EXP typedExp) be arg')*{arg' <- arg'*, typedExp -> typedExp*}*{arg'* <- arg'**, typedExp* -> typedExp**}

                2. (Let (typCase_row)*{typCase_row <- typCase_row*} be $covered_cases(AC.TYP, typedExp))*{typedExp <- typedExp*, typCase_row* -> typCase_row**}*{typedExp* <- typedExp**, typCase_row** -> typCase_row***}

                3. Check ($is_exclusive((((typCase_row)*{typCase_row <- typCase_row*})*{typCase_row* <- typCase_row**})*{typCase_row** <- typCase_row***}))

                  1. (Let ((typCase_comb)*{typCase_comb <- typCase_comb*})*{typCase_comb* <- typCase_comb**} be $combinations(((typCase)*{typCase <- typCase*})*{typCase* <- typCase**}))

                  2. Check ($forall_(($is_covered((((typCase_row)*{typCase_row <- typCase_row*})*{typCase_row* <- typCase_row**})*{typCase_row** <- typCase_row***}, (typCase_comb)*{typCase_comb <- typCase_comb*}))*{typCase_comb* <- typCase_comb**}))

                    1. The relation holds

relation Algo_rul: AC inputHint |- rulIL : %

1. Group : AC inputHint |- rulIL : %

  1. (Let (id ':' (typedExp)*{typedExp <- typedExp*} '-' (premIL)*{premIL <- premIL*}) be rulIL)

  2. (Let (vari)*{vari <- vari*} be $free_varis_rulIL(rulIL))

  3. (Let (id_used)*{id_used <- id_used*} be $ids_of_varis((vari)*{vari <- vari*}))

  4. (Let AC_rul be $add_used(AC, (id_used)*{id_used <- id_used*}))

  5. (Let ((typedExp_in)*{typedExp_in <- typedExp_in*}, (typedExp_out)*{typedExp_out <- typedExp_out*}) be $split_inputs<typedExp>(inputHint, (typedExp)*{typedExp <- typedExp*}))

  6. (Bind_exps: AC_rul [] |- (typedExp_in)*{typedExp_in <- typedExp_in*} : AC_in (typedExp_in_part)*{typedExp_in_part <- typedExp_in_part*} (premAL_bind)*{premAL_bind <- premAL_bind*})

  7. (Algo_prems: AC_in |- (premIL)*{premIL <- premIL*} : AC_body (premAL)*{premAL <- premAL*})

  8. (Let (vari_out)*{vari_out <- vari_out*} be $free_varis_exps((typedExp_out)*{typedExp_out <- typedExp_out*}))

  9. Check ($is_bound(AC_body, [], (vari_out)*{vari_out <- vari_out*}))

    1. (Let rulAL be (id ':' (typedExp_in_part)*{typedExp_in_part <- typedExp_in_part*} '->' (typedExp_out)*{typedExp_out <- typedExp_out*} '-' (premAL_bind)*{premAL_bind <- premAL_bind*} ++ (premAL)*{premAL <- premAL*}))

    2. Result in: % % |- % : rulAL

relation Algo_clause: AC |- clauseIL : %

1. Group : AC |- clauseIL : %

  1. (Let ((arg)*{arg <- arg*} '=' typedExp '-' (premIL)*{premIL <- premIL*}) be clauseIL)

  2. (Let (vari)*{vari <- vari*} be $free_varis_clauseIL(clauseIL))

  3. (Let (id_used)*{id_used <- id_used*} be $ids_of_varis((vari)*{vari <- vari*}))

  4. (Let AC_clause be $add_used(AC, (id_used)*{id_used <- id_used*}))

  5. (Bind_args: AC_clause |- (arg)*{arg <- arg*} : AC_arg (arg_part)*{arg_part <- arg_part*} (premAL_arg)*{premAL_arg <- premAL_arg*})

  6. (Algo_prems: AC_arg |- (premIL)*{premIL <- premIL*} : AC_body (premAL)*{premAL <- premAL*})

  7. (Let (vari_body)*{vari_body <- vari_body*} be $free_varis_exp(typedExp))

  8. Check ($is_bound(AC_body, [], (vari_body)*{vari_body <- vari_body*}))

    1. (Let clauseAL be ((arg_part)*{arg_part <- arg_part*} '=' typedExp '-' (premAL_arg)*{premAL_arg <- premAL_arg*} ++ (premAL)*{premAL <- premAL*}))

    2. Result in: % |- % : clauseAL

relation Algo_def: AC |- defnIL : %

1. Block (3 arms)

Arm 1:

  1. If let typDefn of type typDefn be defnIL, then

    1. Group typ: AC |- (typDefn as defnIL) : %

      1. Result in: % |- % : (typDefn as defnAL)

  1. Else Dangling

Arm 2:

  1. Group rel: AC |- defnIL : %

    1. Case analysis on defnIL

      1. Case (% has type externRelDefnIL, let externRelDefnIL = %)

        1. (Let (EXTREL id ':' (typ)*{typ <- typ*} `( inputHint `)) be externRelDefnIL)

        2. (Let ((typ_in)*{typ_in <- typ_in*}, (typ_out)*{typ_out <- typ_out*}) be $split_inputs<typ>(inputHint, (typ)*{typ <- typ*}))

        3. (Let externRelDefnAL be (EXTREL id ':' (typ_in)*{typ_in <- typ_in*} '->' (typ_out)*{typ_out <- typ_out*}))

        4. Result in: % |- % : (externRelDefnAL as defnAL)

      2. Case (% has type definedRelDefnIL, let definedRelDefnIL = %)

        1. (Let (REL id ':' (typ)*{typ <- typ*} `( inputHint `) '=' (rulGroupIL)*{rulGroupIL <- rulGroupIL*} (elsGroupIL)?{elsGroupIL <- elsGroupIL?}) be definedRelDefnIL)

        2. (Let ((typ_in)*{typ_in <- typ_in*}, (typ_out)*{typ_out <- typ_out*}) be $split_inputs<typ>(inputHint, (typ)*{typ <- typ*}))

        3. (Let (id_group ':' (rulIL)*{rulIL <- rulIL*}) be rulGroupIL)*{rulGroupIL <- rulGroupIL*, id_group -> id_group*, rulIL* -> rulIL**}

        4. (Algo_rul: AC inputHint |- rulIL : rulAL)*{rulIL <- rulIL*, rulAL -> rulAL*}*{rulIL* <- rulIL**, rulAL* -> rulAL**}

        5. (Let rulGroupAL be (id_group ':' (rulAL)*{rulAL <- rulAL*}))*{id_group <- id_group*, rulAL* <- rulAL**, rulGroupAL -> rulGroupAL*}

        6. (Let (id_else ':' rulIL_else) be elsGroupIL)?{elsGroupIL <- elsGroupIL?, id_else -> id_else?, rulIL_else -> rulIL_else?}

        7. (Algo_rul: AC inputHint |- rulIL_else : rulAL_else)?{rulIL_else <- rulIL_else?, rulAL_else -> rulAL_else?}

        8. (Let elsGroupAL be (id_else ':' rulAL_else))?{id_else <- id_else?, rulAL_else <- rulAL_else?, elsGroupAL -> elsGroupAL?}

        9. (Let definedRelDefnAL be (REL id ':' (typ_in)*{typ_in <- typ_in*} '->' (typ_out)*{typ_out <- typ_out*} '=' (rulGroupAL)*{rulGroupAL <- rulGroupAL*} (elsGroupAL)?{elsGroupAL <- elsGroupAL?}))

        10. Result in: % |- % : (definedRelDefnAL as defnAL)

    1. Else Dangling

Arm 3:

  1. Group func: AC |- defnIL : %

    1. Case analysis on defnIL

      1. Case (% has type externFuncDefn, let externFuncDefn = %)

        1. Result in: % |- % : (externFuncDefn as defnAL)

      2. Case (% has type builtinFuncDefn, let builtinFuncDefn = %)

        1. Result in: % |- % : (builtinFuncDefn as defnAL)

      3. Case (% has type tableFuncDefnIL, let tableFuncDefnIL = %)

        1. (Let (TABLEFUNC id (param)*{param <- param*} ':' typ '=' (tblRowIL)*{tblRowIL <- tblRowIL*}) be tableFuncDefnIL)

        2. Check ((param matches pattern EXP %))*{param <- param*}

          1. (Let (EXP typ_param) be param)*{param <- param*, typ_param -> typ_param*}

          2. (Let ((arg)*{arg <- arg*} '=' _typedExp) be tblRowIL)*{tblRowIL <- tblRowIL*, _typedExp -> _typedExp*, arg* -> arg**}

          3. Check ((|(arg)*{arg <- arg*}| = |(param)*{param <- param*}|))*{arg* <- arg**}

            1. (Algo_tblRow: AC |- tblRowIL : tblRowAL)*{tblRowIL <- tblRowIL*, tblRowAL -> tblRowAL*}

            2. If (TblRows_cover: AC (typ_param)*{typ_param <- typ_param*} |- (tblRowIL)*{tblRowIL <- tblRowIL*}) holds, then

              1. (Let tableFuncDefnAL be (TABLEFUNC id (param)*{param <- param*} ':' typ '=' (tblRowAL)*{tblRowAL <- tblRowAL*}))

              2. Result in: % |- % : (tableFuncDefnAL as defnAL)

            2. Else Dangling

      4. Case (% has type definedFuncDefnIL, let definedFuncDefnIL = %)

        1. (Let (FUNC id (tparam)*{tparam <- tparam*} (param)*{param <- param*} ':' typ '=' (clauseIL)*{clauseIL <- clauseIL*} (elsClauseIL)?{elsClauseIL <- elsClauseIL?}) be definedFuncDefnIL)

        2. (Let AC_func be $add_tparams(AC, (tparam)*{tparam <- tparam*}))

        3. (Algo_clause: AC_func |- clauseIL : clauseAL)*{clauseIL <- clauseIL*, clauseAL -> clauseAL*}

        4. (Algo_clause: AC_func |- elsClauseIL : elsClauseAL)?{elsClauseIL <- elsClauseIL?, elsClauseAL -> elsClauseAL?}

        5. (Let definedFuncDefnAL be (FUNC id (tparam)*{tparam <- tparam*} (param)*{param <- param*} ':' typ '=' (clauseAL)*{clauseAL <- clauseAL*} (elsClauseAL)?{elsClauseAL <- elsClauseAL?}))

        6. Result in: % |- % : (definedFuncDefnAL as defnAL)

    1. Else Dangling

relation Guard_exp: AC |- (exp '#' typ') : %

1. Block (2 arms)

Arm 1:

  1. Group literal: AC |- (exp '#' typ') : %

    1. Case analysis on exp

      1. Case (% matches pattern BOOL %)

        1. Result in: % |- % : []

      2. Case (% has type num)

        1. Result in: % |- % : []

      3. Case (% matches pattern TEXT %)

        1. Result in: % |- % : []

    1. Else Dangling

Arm 2:

  1. Case analysis on exp

    1. Case (% matches pattern VAR %, let (VAR id) = %)

      1. Group variable: AC |- ((VAR id) '#' typ') : %

        1. Result in: % |- % : []

    2. Case (% matches pattern UN % %, let (UN unop typedExp) = %)

      1. Group unary: AC |- ((UN unop typedExp) '#' typ') : %

        1. (Guard_exp: AC |- typedExp : (premAL)*{premAL <- premAL*})

        2. Result in: % |- % : (premAL)*{premAL <- premAL*}

    3. Case (% matches pattern BIN % % %, let (BIN binop typedExp_l typedExp_r) = %)

      1. Group binary: AC |- ((BIN binop typedExp_l typedExp_r) '#' typ') : %

        1. Case analysis on binop is in [((DIV) as binop), ((MOD) as binop)] (total)

          1. Case false

            1. (Guard_exps: AC |- [typedExp_l, typedExp_r] : (premAL)*{premAL <- premAL*})

            2. Result in: % |- % : (premAL)*{premAL <- premAL*}

          2. Case true

            1. (Guard_exps: AC |- [typedExp_l, typedExp_r] : (premAL_operand)*{premAL_operand <- premAL_operand*})

            2. (Let (_exp '#' typ_r) be typedExp_r)

            3. (Let typedExp_zero be $exp_zero(AC.TYP, typ_r))

            4. (Let premAL_div be $sidecond_cmp(((NE) as cmpop), typedExp_r, typedExp_zero))

            5. (Let (premAL)*{premAL <- premAL*} be (premAL_operand)*{premAL_operand <- premAL_operand*} ++ [premAL_div])

            6. Result in: % |- % : (premAL)*{premAL <- premAL*}

    4. Case (% matches pattern CMP % % %, let (CMP cmpop typedExp_l typedExp_r) = %)

      1. Group compare: AC |- ((CMP cmpop typedExp_l typedExp_r) '#' typ') : %

        1. (Guard_exps: AC |- [typedExp_l, typedExp_r] : (premAL)*{premAL <- premAL*})

        2. Result in: % |- % : (premAL)*{premAL <- premAL*}

    5. Case (% matches pattern UPCAST % %, let (UPCAST typ typedExp) = %)

      1. Group upcast: AC |- ((UPCAST typ typedExp) '#' typ') : %

        1. (Guard_exp: AC |- typedExp : (premAL)*{premAL <- premAL*})

        2. Result in: % |- % : (premAL)*{premAL <- premAL*}

    6. Case (% matches pattern DOWNCAST % %, let (DOWNCAST typ typedExp) = %)

      1. Group downcast: AC |- ((DOWNCAST typ typedExp) '#' typ') : %

        1. (Guard_exp: AC |- typedExp : (premAL)*{premAL <- premAL*})

        2. Result in: % |- % : (premAL)*{premAL <- premAL*}

    7. Case (% matches pattern SUB % %, let (SUB typedExp typ) = %)

      1. Group subtype: AC |- ((SUB typedExp typ) '#' typ') : %

        1. (Guard_exp: AC |- typedExp : (premAL)*{premAL <- premAL*})

        2. Result in: % |- % : (premAL)*{premAL <- premAL*}

    8. Case (% matches pattern MATCH % %, let (MATCH typedExp pat) = %)

      1. Group match: AC |- ((MATCH typedExp pat) '#' typ') : %

        1. (Guard_exp: AC |- typedExp : (premAL)*{premAL <- premAL*})

        2. Result in: % |- % : (premAL)*{premAL <- premAL*}

    9. Case (% matches pattern TUP %, let (TUP (typedExp)*{typedExp <- typedExp*}) = %)

      1. Group tuple: AC |- ((TUP (typedExp)*{typedExp <- typedExp*}) '#' typ') : %

        1. (Guard_exps: AC |- (typedExp)*{typedExp <- typedExp*} : (premAL)*{premAL <- premAL*})

        2. Result in: % |- % : (premAL)*{premAL <- premAL*}

    10. Case (% matches pattern INJ %, let (INJ (mixop (typedExp)*{typedExp <- typedExp*})) = %)

      1. Group case: AC |- ((INJ (mixop (typedExp)*{typedExp <- typedExp*})) '#' typ') : %

        1. (Guard_exps: AC |- (typedExp)*{typedExp <- typedExp*} : (premAL)*{premAL <- premAL*})

        2. Result in: % |- % : (premAL)*{premAL <- premAL*}

    11. Case (% matches pattern STR %, let (STR (expField)*{expField <- expField*}) = %)

      1. Group struct: AC |- ((STR (expField)*{expField <- expField*}) '#' typ') : %

        1. (Let (_atom typedExp) be expField)*{expField <- expField*, _atom -> _atom*, typedExp -> typedExp*}

        2. (Guard_exps: AC |- (typedExp)*{typedExp <- typedExp*} : (premAL)*{premAL <- premAL*})

        3. Result in: % |- % : (premAL)*{premAL <- premAL*}

    12. Case (% matches pattern OPT %, let (OPT (typedExp')?{typedExp' <- typedExp'?}) = %)

      1. Group opt: AC |- ((OPT (typedExp')?{typedExp' <- typedExp'?}) '#' typ') : %

        1. Case analysis on (typedExp')?{typedExp' <- typedExp'?} (total)

          1. Case (% matches pattern ())

            1. Result in: % |- % : []

          2. Case (% matches pattern (_))

            1. (Let ?(typedExp) be (typedExp')?{typedExp' <- typedExp'?})

            2. (Guard_exp: AC |- typedExp : (premAL)*{premAL <- premAL*})

            3. Result in: % |- % : (premAL)*{premAL <- premAL*}

    13. Case (% matches pattern LIST %, let (LIST (typedExp)*{typedExp <- typedExp*}) = %)

      1. Group list: AC |- ((LIST (typedExp)*{typedExp <- typedExp*}) '#' typ') : %

        1. (Guard_exps: AC |- (typedExp)*{typedExp <- typedExp*} : (premAL)*{premAL <- premAL*})

        2. Result in: % |- % : (premAL)*{premAL <- premAL*}

    14. Case (% matches pattern CONS % %, let (CONS typedExp_h typedExp_t) = %)

      1. Group cons: AC |- ((CONS typedExp_h typedExp_t) '#' typ') : %

        1. (Guard_exps: AC |- [typedExp_h, typedExp_t] : (premAL)*{premAL <- premAL*})

        2. Result in: % |- % : (premAL)*{premAL <- premAL*}

    15. Case (% matches pattern CAT % %, let (CAT typedExp_l typedExp_r) = %)

      1. Group concat: AC |- ((CAT typedExp_l typedExp_r) '#' typ') : %

        1. (Guard_exps: AC |- [typedExp_l, typedExp_r] : (premAL)*{premAL <- premAL*})

        2. Result in: % |- % : (premAL)*{premAL <- premAL*}

    16. Case (% matches pattern MEM % %, let (MEM typedExp_l typedExp_r) = %)

      1. Group mem: AC |- ((MEM typedExp_l typedExp_r) '#' typ') : %

        1. (Guard_exps: AC |- [typedExp_l, typedExp_r] : (premAL)*{premAL <- premAL*})

        2. Result in: % |- % : (premAL)*{premAL <- premAL*}

    17. Case (% matches pattern LEN %, let (LEN typedExp) = %)

      1. Group len: AC |- ((LEN typedExp) '#' typ') : %

        1. (Guard_exp: AC |- typedExp : (premAL)*{premAL <- premAL*})

        2. Result in: % |- % : (premAL)*{premAL <- premAL*}

    18. Case (% matches pattern DOT % %, let (DOT typedExp atom) = %)

      1. Group dot: AC |- ((DOT typedExp atom) '#' typ') : %

        1. (Guard_exp: AC |- typedExp : (premAL)*{premAL <- premAL*})

        2. Result in: % |- % : (premAL)*{premAL <- premAL*}

    19. Case (% matches pattern IDX % %, let (IDX typedExp_b typedExp_i) = %)

      1. Group idx: AC |- ((IDX typedExp_b typedExp_i) '#' typ') : %

        1. (Guard_exps: AC |- [typedExp_b, typedExp_i] : (premAL_operand)*{premAL_operand <- premAL_operand*})

        2. (Let typedExp_len be $exp_len(typedExp_b))

        3. (Let premAL_idx be $sidecond_cmp(((LT) as cmpop), typedExp_i, typedExp_len))

        4. (Let (premAL)*{premAL <- premAL*} be (premAL_operand)*{premAL_operand <- premAL_operand*} ++ [premAL_idx])

        5. Result in: % |- % : (premAL)*{premAL <- premAL*}

    20. Case (% matches pattern SLICE % % %, let (SLICE typedExp_b typedExp_i typedExp_n) = %)

      1. Group slice: AC |- ((SLICE typedExp_b typedExp_i typedExp_n) '#' typ') : %

        1. (Guard_exps: AC |- [typedExp_b, typedExp_i, typedExp_n] : (premAL_operand)*{premAL_operand <- premAL_operand*})

        2. (Let typedExp_end be ((BIN ((ADD) as binop) typedExp_i typedExp_n) '#' ((NAT) as typ)))

        3. (Let typedExp_len be $exp_len(typedExp_b))

        4. (Let premAL_slice be $sidecond_cmp(((LE) as cmpop), typedExp_end, typedExp_len))

        5. (Let (premAL)*{premAL <- premAL*} be (premAL_operand)*{premAL_operand <- premAL_operand*} ++ [premAL_slice])

        6. Result in: % |- % : (premAL)*{premAL <- premAL*}

    21. Case (% matches pattern UPD % % %, let (UPD typedExp_b typedPath typedExp_f) = %)

      1. Group upd: AC |- ((UPD typedExp_b typedPath typedExp_f) '#' typ') : %

        1. (Let typedExp_acc be $access_exp(typedExp_b, typedPath))

        2. (Guard_exp: AC |- typedExp_acc : (premAL_acc)*{premAL_acc <- premAL_acc*})

        3. (Guard_exp: AC |- typedExp_f : (premAL_f)*{premAL_f <- premAL_f*})

        4. (Let (premAL_rep)*{premAL_rep <- premAL_rep*} be $sideconds_replace(AC.TYP, typedPath, typedExp_f))

        5. (Let (premAL)*{premAL <- premAL*} be (premAL_acc)*{premAL_acc <- premAL_acc*} ++ (premAL_f)*{premAL_f <- premAL_f*} ++ (premAL_rep)*{premAL_rep <- premAL_rep*})

        6. Result in: % |- % : (premAL)*{premAL <- premAL*}

    22. Case (% matches pattern CALL % % %, let (CALL id (targ)*{targ <- targ*} (arg)*{arg <- arg*}) = %)

      1. Group call: AC |- ((CALL id (targ)*{targ <- targ*} (arg)*{arg <- arg*}) '#' typ') : %

        1. (Guard_args: AC |- (arg)*{arg <- arg*} : (premAL)*{premAL <- premAL*})

        2. Result in: % |- % : (premAL)*{premAL <- premAL*}

    23. Case (% matches pattern ITER % %, let (ITER typedExp (iter (vari)*{vari <- vari*})) = %)

      1. Group iter: AC |- ((ITER typedExp (iter (vari)*{vari <- vari*})) '#' typ') : %

        1. (Let (premAL_src)*{premAL_src <- premAL_src*} be $sideconds_iter(iter, (vari)*{vari <- vari*}))

        2. (Guard_exp: AC |- typedExp : (premAL_body)*{premAL_body <- premAL_body*})

        3. (Let premAL_body_iter be ((ITER premAL_body (iter '<-' (vari)*{vari <- vari*} '->' [])) as premAL))*{premAL_body <- premAL_body*, premAL_body_iter -> premAL_body_iter*}

        4. (Let (premAL)*{premAL <- premAL*} be (premAL_src)*{premAL_src <- premAL_src*} ++ (premAL_body_iter)*{premAL_body_iter <- premAL_body_iter*})

        5. Result in: % |- % : (premAL)*{premAL <- premAL*}

  1. Else Dangling

relation Guard_exps: AC |- (typedExp)*{typedExp <- typedExp*} : %

1. Group : AC |- (typedExp)*{typedExp <- typedExp*} : %

  1. Case analysis on (typedExp)*{typedExp <- typedExp*} (total)

    1. Case (% matches pattern [])

      1. Result in: % |- % : []

    2. Case (% matches pattern _ :: _)

      1. (Let typedExp_h :: (typedExp_t)*{typedExp_t <- typedExp_t*} be (typedExp)*{typedExp <- typedExp*})

      2. (Guard_exp: AC |- typedExp_h : (premAL_h)*{premAL_h <- premAL_h*})

      3. (Guard_exps: AC |- (typedExp_t)*{typedExp_t <- typedExp_t*} : (premAL_t)*{premAL_t <- premAL_t*})

      4. (Let (premAL)*{premAL <- premAL*} be (premAL_h)*{premAL_h <- premAL_h*} ++ (premAL_t)*{premAL_t <- premAL_t*})

      5. Result in: % |- % : (premAL)*{premAL <- premAL*}

relation Guard_arg: AC |- arg : %

1. Case analysis on arg (total)

  1. Case (% matches pattern EXP %, let (EXP typedExp) = %)

    1. Group exp: AC |- (EXP typedExp) : %

      1. (Guard_exp: AC |- typedExp : (premAL)*{premAL <- premAL*})

      2. Result in: % |- % : (premAL)*{premAL <- premAL*}

  2. Case (% matches pattern FUN %, let (FUN id) = %)

    1. Group fun: AC |- (FUN id) : %

      1. Result in: % |- % : []

relation Guard_args: AC |- (arg)*{arg <- arg*} : %

1. Group : AC |- (arg)*{arg <- arg*} : %

  1. Case analysis on (arg)*{arg <- arg*} (total)

    1. Case (% matches pattern [])

      1. Result in: % |- % : []

    2. Case (% matches pattern _ :: _)

      1. (Let arg_h :: (arg_t)*{arg_t <- arg_t*} be (arg)*{arg <- arg*})

      2. (Guard_arg: AC |- arg_h : (premAL_h)*{premAL_h <- premAL_h*})

      3. (Guard_args: AC |- (arg_t)*{arg_t <- arg_t*} : (premAL_t)*{premAL_t <- premAL_t*})

      4. (Let (premAL)*{premAL <- premAL*} be (premAL_h)*{premAL_h <- premAL_h*} ++ (premAL_t)*{premAL_t <- premAL_t*})

      5. Result in: % |- % : (premAL)*{premAL <- premAL*}

relation Guard_prem: AC |- premAL' : %

1. Case analysis on premAL' (total)

  1. Case (% has type relPremAL, let (REL id ':' (typedExp_in)*{typedExp_in <- typedExp_in*} '->' (typedExp)*{typedExp <- typedExp*}) = %)

    1. Group rel: AC |- ((REL id ':' (typedExp_in)*{typedExp_in <- typedExp_in*} '->' (typedExp)*{typedExp <- typedExp*}) as premAL) : %

      1. (Guard_exps: AC |- (typedExp_in)*{typedExp_in <- typedExp_in*} : (premAL)*{premAL <- premAL*})

      2. Result in: % |- % : (premAL)*{premAL <- premAL*}

  2. Case (% has type ifPrem, let (IF typedExp) = %)

    1. Group cond: AC |- ((IF typedExp) as premAL) : %

      1. (Guard_exp: AC |- typedExp : (premAL)*{premAL <- premAL*})

      2. Result in: % |- % : (premAL)*{premAL <- premAL*}

  3. Case (% has type ifHoldPrem, let (IFHOLD id ':' (typedExp)*{typedExp <- typedExp*}) = %)

    1. Group ifhold: AC |- ((IFHOLD id ':' (typedExp)*{typedExp <- typedExp*}) as premAL) : %

      1. (Guard_exps: AC |- (typedExp)*{typedExp <- typedExp*} : (premAL)*{premAL <- premAL*})

      2. Result in: % |- % : (premAL)*{premAL <- premAL*}

  4. Case (% has type ifNotHoldPrem, let (IFNOTHOLD id ':' (typedExp)*{typedExp <- typedExp*}) = %)

    1. Group ifnothold: AC |- ((IFNOTHOLD id ':' (typedExp)*{typedExp <- typedExp*}) as premAL) : %

      1. (Guard_exps: AC |- (typedExp)*{typedExp <- typedExp*} : (premAL)*{premAL <- premAL*})

      2. Result in: % |- % : (premAL)*{premAL <- premAL*}

  5. Case (% has type letPremAL, let (LET typedExp '=' typedExp_r) = %)

    1. Group let: AC |- ((LET typedExp '=' typedExp_r) as premAL) : %

      1. (Guard_exp: AC |- typedExp_r : (premAL)*{premAL <- premAL*})

      2. Result in: % |- % : (premAL)*{premAL <- premAL*}

  6. Case (% has type iterPremAL, let (ITER premAL (iter '<-' (vari_src)*{vari_src <- vari_src*} '->' (vari)*{vari <- vari*})) = %)

    1. Group iter: AC |- ((ITER premAL (iter '<-' (vari_src)*{vari_src <- vari_src*} '->' (vari)*{vari <- vari*})) as premAL) : %

      1. (Let (premAL_src)*{premAL_src <- premAL_src*} be $sideconds_iter(iter, (vari_src)*{vari_src <- vari_src*}))

      2. (Guard_prem: AC |- premAL : (premAL_body)*{premAL_body <- premAL_body*})

      3. (Let premAL_body_iter be ((ITER premAL_body (iter '<-' (vari_src)*{vari_src <- vari_src*} '->' [])) as premAL))*{premAL_body <- premAL_body*, premAL_body_iter -> premAL_body_iter*}

      4. (Let (premAL_guard)*{premAL_guard <- premAL_guard*} be (premAL_src)*{premAL_src <- premAL_src*} ++ (premAL_body_iter)*{premAL_body_iter <- premAL_body_iter*})

      5. Result in: % |- % : (premAL_guard)*{premAL_guard <- premAL_guard*}

  7. Case (% has type debugPrem, let (DEBUG typedExp) = %)

    1. Group dbg: AC |- ((DEBUG typedExp) as premAL) : %

      1. (Guard_exp: AC |- typedExp : (premAL)*{premAL <- premAL*})

      2. Result in: % |- % : (premAL)*{premAL <- premAL*}

relation Guard_prems: AC |- (premAL')*{premAL' <- premAL'*} : %

1. Group : AC |- (premAL')*{premAL' <- premAL'*} : %

  1. Case analysis on (premAL')*{premAL' <- premAL'*} (total)

    1. Case (% matches pattern [])

      1. Result in: % |- % : []

    2. Case (% matches pattern _ :: _)

      1. (Let premAL_h :: (premAL_t)*{premAL_t <- premAL_t*} be (premAL')*{premAL' <- premAL'*})

      2. (Guard_prem: AC |- premAL_h : (premAL_guard)*{premAL_guard <- premAL_guard*})

      3. (Guard_prems: AC |- (premAL_t)*{premAL_t <- premAL_t*} : (premAL_t_guard)*{premAL_t_guard <- premAL_t_guard*})

      4. (Let (premAL)*{premAL <- premAL*} be (premAL_guard)*{premAL_guard <- premAL_guard*} ++ [premAL_h] ++ (premAL_t_guard)*{premAL_t_guard <- premAL_t_guard*})

      5. Result in: % |- % : (premAL)*{premAL <- premAL*}

relation Guard_rul: AC |- rulAL : %

1. Group : AC |- rulAL : %

  1. (Let (id ':' (typedExp_in)*{typedExp_in <- typedExp_in*} '->' (typedExp_out)*{typedExp_out <- typedExp_out*} '-' (premAL)*{premAL <- premAL*}) be rulAL)

  2. (Guard_prems: AC |- (premAL)*{premAL <- premAL*} : (premAL_guard)*{premAL_guard <- premAL_guard*})

  3. (Guard_exps: AC |- (typedExp_out)*{typedExp_out <- typedExp_out*} : (premAL_out)*{premAL_out <- premAL_out*})

  4. (Let rulAL_guard be (id ':' (typedExp_in)*{typedExp_in <- typedExp_in*} '->' (typedExp_out)*{typedExp_out <- typedExp_out*} '-' (premAL_guard)*{premAL_guard <- premAL_guard*} ++ (premAL_out)*{premAL_out <- premAL_out*}))

  5. Result in: % |- % : rulAL_guard

relation Guard_clause: AC |- clauseAL : %

1. Group : AC |- clauseAL : %

  1. (Let ((arg)*{arg <- arg*} '=' typedExp '-' (premAL)*{premAL <- premAL*}) be clauseAL)

  2. (Guard_prems: AC |- (premAL)*{premAL <- premAL*} : (premAL_guard)*{premAL_guard <- premAL_guard*})

  3. (Guard_exp: AC |- typedExp : (premAL_out)*{premAL_out <- premAL_out*})

  4. (Let clauseAL_guard be ((arg)*{arg <- arg*} '=' typedExp '-' (premAL_guard)*{premAL_guard <- premAL_guard*} ++ (premAL_out)*{premAL_out <- premAL_out*}))

  5. Result in: % |- % : clauseAL_guard

relation Guard_tblRow: AC |- tblRowAL : %

1. Group : AC |- tblRowAL : %

  1. (Let ((arg)*{arg <- arg*} '=' typedExp '-' (premAL)*{premAL <- premAL*}) be tblRowAL)

  2. (Guard_prems: AC |- (premAL)*{premAL <- premAL*} : (premAL_guard)*{premAL_guard <- premAL_guard*})

  3. (Guard_exp: AC |- typedExp : (premAL_out)*{premAL_out <- premAL_out*})

  4. (Let tblRowAL_guard be ((arg)*{arg <- arg*} '=' typedExp '-' (premAL_guard)*{premAL_guard <- premAL_guard*} ++ (premAL_out)*{premAL_out <- premAL_out*}))

