      2. Case (% has type definedRelDefnAL, let definedRelDefnAL = %)

        1. (Let (REL id ':' (typ_in)*{typ_in <- typ_in*} '->' (typ_out)*{typ_out <- typ_out*} '=' (rulGroupAL)*{rulGroupAL <- rulGroupAL*} (elsGroupAL)?{elsGroupAL <- elsGroupAL?}) be definedRelDefnAL)

        2. (Let (id_group ':' (rulAL)*{rulAL <- rulAL*}) be rulGroupAL)*{rulGroupAL <- rulGroupAL*, id_group -> id_group*, rulAL* -> rulAL**}

        3. (Guard_rul: AC |- rulAL : rulAL_guard)*{rulAL <- rulAL*, rulAL_guard -> rulAL_guard*}*{rulAL* <- rulAL**, rulAL_guard* -> rulAL_guard**}

        4. (Let rulGroupAL_guard be (id_group ':' (rulAL_guard)*{rulAL_guard <- rulAL_guard*}))*{id_group <- id_group*, rulAL_guard* <- rulAL_guard**, rulGroupAL_guard -> rulGroupAL_guard*}

        5. (Let (id_else ':' rulAL_else) be elsGroupAL)?{elsGroupAL <- elsGroupAL?, id_else -> id_else?, rulAL_else -> rulAL_else?}

        6. (Guard_rul: AC |- rulAL_else : rulAL_else_guard)?{rulAL_else <- rulAL_else?, rulAL_else_guard -> rulAL_else_guard?}

        7. (Let elsGroupAL_guard be (id_else ':' rulAL_else_guard))?{id_else <- id_else?, rulAL_else_guard <- rulAL_else_guard?, elsGroupAL_guard -> elsGroupAL_guard?}

        8. (Let definedRelDefnAL_guard be (REL id ':' (typ_in)*{typ_in <- typ_in*} '->' (typ_out)*{typ_out <- typ_out*} '=' (rulGroupAL_guard)*{rulGroupAL_guard <- rulGroupAL_guard*} (elsGroupAL_guard)?{elsGroupAL_guard <- elsGroupAL_guard?}))

        9. Result in: % |- % : (definedRelDefnAL_guard as defnAL)

    1. Else Dangling

Arm 3:

