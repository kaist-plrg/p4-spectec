          4. (Let iterExp_part be (ITER typedExp_part (iter (vari_part)*{vari_part <- vari_part*})))

          5. Result in: % % |- % : AC_sub IC_sub ((iterExp_part as exp) '#' typ) (premAL)*{premAL <- premAL*}

1. Else Dangling

