    1. Return $free_varis_exp(typedExp)

  3. Case (% has type ifHoldPrem, let (IFHOLD _id ':' (typedExp)*{typedExp <- typedExp*}) = %)

    1. Return $free_varis_exps((typedExp)*{typedExp <- typedExp*})

  4. Case (% has type ifNotHoldPrem, let (IFNOTHOLD _id ':' (typedExp)*{typedExp <- typedExp*}) = %)

    1. Return $free_varis_exps((typedExp)*{typedExp <- typedExp*})

  5. Case (% has type iterPremIL, let (ITER premIL (iter (_vari)*{_vari <- _vari*})) = %)

    1. (Let (vari)*{vari <- vari*} be $free_varis_premIL(premIL))

    2. (Let vari_iter be $iterate_vari(vari, [iter]))*{vari <- vari*, vari_iter -> vari_iter*}

    3. Return (vari_iter)*{vari_iter <- vari_iter*}

  6. Case (% has type debugPrem, let (DEBUG typedExp) = %)

    1. Return $free_varis_exp(typedExp)

def $free_varis_premILs((premIL)*{premIL <- premIL*})

1. Case analysis on (premIL)*{premIL <- premIL*} (total)

  1. Case (% matches pattern [])

    1. Return []

  2. Case (% matches pattern _ :: _)

    1. (Let premIL_h :: (premIL_t)*{premIL_t <- premIL_t*} be (premIL)*{premIL <- premIL*})

    2. (Let (vari)*{vari <- vari*} be $free_varis_premIL(premIL_h))

    3. (Let (vari')*{vari' <- vari'*} be $free_varis_premILs((premIL_t)*{premIL_t <- premIL_t*}))

    4. Return (vari)*{vari <- vari*} ++ (vari')*{vari' <- vari'*}

def $free_varis_rulIL((_id ':' (typedExp)*{typedExp <- typedExp*} '-' (premIL)*{premIL <- premIL*}))

1. (Let (vari)*{vari <- vari*} be $free_varis_exps((typedExp)*{typedExp <- typedExp*}))

2. (Let (vari')*{vari' <- vari'*} be $free_varis_premILs((premIL)*{premIL <- premIL*}))

3. Return (vari)*{vari <- vari*} ++ (vari')*{vari' <- vari'*}

def $free_varis_clauseIL(((arg)*{arg <- arg*} '=' typedExp '-' (premIL)*{premIL <- premIL*}))

1. (Let (vari)*{vari <- vari*} be $free_varis_args((arg)*{arg <- arg*}))

2. (Let (vari')*{vari' <- vari'*} be $free_varis_exp(typedExp))

3. (Let (vari'')*{vari'' <- vari''*} be $free_varis_premILs((premIL)*{premIL <- premIL*}))

4. Return (vari)*{vari <- vari*} ++ (vari')*{vari' <- vari'*} ++ (vari'')*{vari'' <- vari''*}

def $free_varis_tblRowIL(((arg)*{arg <- arg*} '=' typedExp))

1. (Let (vari)*{vari <- vari*} be $free_varis_args((arg)*{arg <- arg*}))

2. (Let (vari')*{vari' <- vari'*} be $free_varis_exp(typedExp))

3. Return (vari)*{vari <- vari*} ++ (vari')*{vari' <- vari'*}

def $iter_exp(typedExp, vari, (iter)*{iter <- iter*})

1. Case analysis on (iter)*{iter <- iter*} (total)

  1. Case (% matches pattern [])

    1. Return typedExp

  2. Case (% matches pattern _ :: _)

    1. (Let iter_h :: (iter_t)*{iter_t <- iter_t*} be (iter)*{iter <- iter*})

    2. (Let (_exp '#' typ) be typedExp)

    3. (Let typedExp_iter be ((ITER typedExp (iter_h [vari])) '#' (ITER typ iter_h)))

    4. (Let vari_iter be $iterate_vari(vari, [iter_h]))

    5. Return $iter_exp(typedExp_iter, vari_iter, (iter_t)*{iter_t <- iter_t*})

def $exp_of_vari((id typ (iter)*{iter <- iter*}))

1. Return $iter_exp(((VAR id) '#' typ), (id typ []), (iter)*{iter <- iter*})

syntax occ = map<id, id*>

syntax renamer = {USED id*, SEEN id*, OCC occ}

var R : renamer

def $init_renamer((id_used)*{id_used <- id_used*}, (vari)*{vari <- vari*})

1. Case analysis on (vari)*{vari <- vari*} (total)

  1. Case (% matches pattern [])

    1. Return {USED (id_used)*{id_used <- id_used*}, SEEN [], OCC $empty_map<id, id*>}

  2. Case (% matches pattern _ :: _)

    1. (Let vari_h :: (vari_t)*{vari_t <- vari_t*} be (vari)*{vari <- vari*})

    2. Block (2 arms)

    Arm 1:

      1. (Let (id_h _typ (_iter)*{_iter <- _iter*}) be vari_h)

      2. If (~id_h is in $ids_of_varis((vari_t)*{vari_t <- vari_t*})), then

        1. (Let R be $init_renamer((id_used)*{id_used <- id_used*}, (vari_t)*{vari_t <- vari_t*}))

        2. (Let occ be $add_map<id, id*>(R.OCC, id_h, []))

        3. Return R[OCC = occ]

      2. Else Dangling

    Arm 2:

      1. Check (vari_h is in (vari_t)*{vari_t <- vari_t*})

        1. Return $init_renamer((id_used)*{id_used <- id_used*}, (vari_t)*{vari_t <- vari_t*})

def $rename_exp(R, typedExp'')

1. (Let (exp '#' typ) be typedExp'')

2. Case analysis on exp

  1. Case (% matches pattern VAR %, let (VAR id) = %)

    1. (Let ((id')*{id' <- id'*})?{id'* <- id'*?} be $find_map<id, id*>(R.OCC, id))

    2. If ((((id')*{id' <- id'*})?{id'* <- id'*?} matches pattern (_))), then

      1. (Let ?((id_later)*{id_later <- id_later*}) be ((id')*{id' <- id'*})?{id'* <- id'*?})

      2. Case analysis on id is in R.SEEN (total)

        1. Case false

          1. (Let R_multi be R[SEEN = R.SEEN ++ [id]])

          2. Return (R_multi, ((VAR id) '#' typ))

        2. Case true

          1. (Let ((id_used)*{id_used <- id_used*}, id_fresh) be $fresh_id(R.USED))

          2. (Let occ be $add_map<id, id*>(R.OCC, id, (id_later)*{id_later <- id_later*} ++ [id_fresh]))

          3. (Let R_multi be {USED (id_used)*{id_used <- id_used*}, SEEN R.SEEN, OCC occ})

          4. Return (R_multi, ((VAR id_fresh) '#' typ))

  2. Case (% matches pattern UPCAST % %, let (UPCAST typ_sup typedExp) = %)

    1. (Let (R_multi, typedExp_multi) be $rename_exp(R, typedExp))

    2. Return (R_multi, ((UPCAST typ_sup typedExp_multi) '#' typ))

  3. Case (% matches pattern TUP %, let (TUP (typedExp)*{typedExp <- typedExp*}) = %)

    1. (Let (R_multi, (typedExp_multi)*{typedExp_multi <- typedExp_multi*}) be $rename_exps(R, (typedExp)*{typedExp <- typedExp*}))

    2. Return (R_multi, ((TUP (typedExp_multi)*{typedExp_multi <- typedExp_multi*}) '#' typ))

  4. Case (% matches pattern INJ %, let (INJ (mixop (typedExp)*{typedExp <- typedExp*})) = %)

    1. (Let (R_multi, (typedExp_multi)*{typedExp_multi <- typedExp_multi*}) be $rename_exps(R, (typedExp)*{typedExp <- typedExp*}))

    2. Return (R_multi, ((INJ (mixop (typedExp_multi)*{typedExp_multi <- typedExp_multi*})) '#' typ))

  5. Case (% matches pattern STR %, let (STR (expField)*{expField <- expField*}) = %)

    1. (Let (atom typedExp) be expField)*{expField <- expField*, atom -> atom*, typedExp -> typedExp*}

    2. (Let (R_multi, (typedExp_multi)*{typedExp_multi <- typedExp_multi*}) be $rename_exps(R, (typedExp)*{typedExp <- typedExp*}))

    3. If ((|(atom)*{atom <- atom*}| = |(typedExp_multi)*{typedExp_multi <- typedExp_multi*}|)), then

      1. (Let expField_multi be (atom typedExp_multi))*{atom <- atom*, typedExp_multi <- typedExp_multi*, expField_multi -> expField_multi*}

      2. Return (R_multi, ((STR (expField_multi)*{expField_multi <- expField_multi*}) '#' typ))

  6. Case (% matches pattern OPT %, let (OPT (typedExp')?{typedExp' <- typedExp'?}) = %)

    1. If (((typedExp')?{typedExp' <- typedExp'?} matches pattern (_))), then

      1. (Let ?(typedExp) be (typedExp')?{typedExp' <- typedExp'?})

      2. (Let (R_multi, typedExp_multi) be $rename_exp(R, typedExp))

      3. Return (R_multi, ((OPT ?(typedExp_multi)) '#' typ))

  7. Case (% matches pattern LIST %, let (LIST (typedExp)*{typedExp <- typedExp*}) = %)

    1. (Let (R_multi, (typedExp_multi)*{typedExp_multi <- typedExp_multi*}) be $rename_exps(R, (typedExp)*{typedExp <- typedExp*}))

    2. Return (R_multi, ((LIST (typedExp_multi)*{typedExp_multi <- typedExp_multi*}) '#' typ))

  8. Case (% matches pattern CONS % %, let (CONS typedExp_h typedExp_t) = %)

    1. (Let (R_h, typedExp_h_multi) be $rename_exp(R, typedExp_h))

    2. (Let (R_t, typedExp_t_multi) be $rename_exp(R_h, typedExp_t))

    3. Return (R_t, ((CONS typedExp_h_multi typedExp_t_multi) '#' typ))

  9. Case (% matches pattern ITER % %, let (ITER typedExp (iter (vari)*{vari <- vari*})) = %)

    1. (Let (R_multi, typedExp_multi) be $rename_exp(R, typedExp))

    2. (Let (vari')*{vari' <- vari'*} be $free_varis_exp(typedExp_multi))

    3. (Let (id_free)*{id_free <- id_free*} be $ids_of_varis((vari')*{vari' <- vari'*}))

    4. (Let (vari_rename)*{vari_rename <- vari_rename*} be $rename_iter_vari(R_multi.OCC, vari, (id_free)*{id_free <- id_free*}))*{vari <- vari*, vari_rename* -> vari_rename**}

    5. (Let (vari_occ)*{vari_occ <- vari_occ*} be $concat_<vari>(((vari_rename)*{vari_rename <- vari_rename*})*{vari_rename* <- vari_rename**}))

    6. Return (R_multi, ((ITER typedExp_multi (iter (vari_occ)*{vari_occ <- vari_occ*})) '#' typ))

3. Otherwise,

  1. Return (R, typedExp'')

def $rename_exps(R, (typedExp)*{typedExp <- typedExp*})

1. Case analysis on (typedExp)*{typedExp <- typedExp*} (total)

  1. Case (% matches pattern [])

    1. Return (R, [])

  2. Case (% matches pattern _ :: _)

    1. (Let typedExp_h :: (typedExp_t)*{typedExp_t <- typedExp_t*} be (typedExp)*{typedExp <- typedExp*})

    2. (Let (R_h, typedExp_h_multi) be $rename_exp(R, typedExp_h))

    3. (Let (R_t, (typedExp_t_multi)*{typedExp_t_multi <- typedExp_t_multi*}) be $rename_exps(R_h, (typedExp_t)*{typedExp_t <- typedExp_t*}))

    4. Return (R_t, typedExp_h_multi :: (typedExp_t_multi)*{typedExp_t_multi <- typedExp_t_multi*})

def $rename_iter_vari(occ, vari, (id_free)*{id_free <- id_free*})

1. (Let (id typ (iter)*{iter <- iter*}) be vari)

2. (Let ((id')*{id' <- id'*})?{id'* <- id'*?} be $find_map<id, id*>(occ, id))

3. If ((((id')*{id' <- id'*})?{id'* <- id'*?} matches pattern (_))), then

  1. (Let ?((id_later)*{id_later <- id_later*}) be ((id')*{id' <- id'*})?{id'* <- id'*?})

  2. (Let (id_occ)*{id_occ <- id_occ*} be $intersect_<id>(id :: (id_later)*{id_later <- id_later*}, (id_free)*{id_free <- id_free*}))

  3. Return ((id_occ typ (iter)*{iter <- iter*}))*{id_occ <- id_occ*}

4. Otherwise,

  1. Return [vari]

def $rename_arg(R, arg)

1. Case analysis on arg (total)

  1. Case (% matches pattern EXP %, let (EXP typedExp) = %)

    1. (Let (R_multi, typedExp_multi) be $rename_exp(R, typedExp))

    2. Return (R_multi, (EXP typedExp_multi))

  2. Case (% matches pattern FUN %, let (FUN id) = %)

    1. Return (R, (FUN id))

def $rename_args(R, (arg)*{arg <- arg*})

1. Case analysis on (arg)*{arg <- arg*} (total)

  1. Case (% matches pattern [])

    1. Return (R, [])

  2. Case (% matches pattern _ :: _)

    1. (Let arg_h :: (arg_t)*{arg_t <- arg_t*} be (arg)*{arg <- arg*})

    2. (Let (R_h, arg_h_multi) be $rename_arg(R, arg_h))

    3. (Let (R_t, (arg_t_multi)*{arg_t_multi <- arg_t_multi*}) be $rename_args(R_h, (arg_t)*{arg_t <- arg_t*}))

    4. Return (R_t, arg_h_multi :: (arg_t_multi)*{arg_t_multi <- arg_t_multi*})

def $is_invertible(typedExp)

1. (Let (exp '#' _typ) be typedExp)

2. Case analysis on exp

  1. Case (% matches pattern VAR %)

    1. Return true

  2. Case (% matches pattern UPCAST % %)

    1. Return true

  3. Case (% matches pattern TUP %)

    1. Return true

  4. Case (% matches pattern INJ %)

    1. Return true

  5. Case (% matches pattern STR %)

    1. Return true

  6. Case (% matches pattern OPT %)

    1. Return true

  7. Case (% matches pattern LIST %)

    1. Return true

  8. Case (% matches pattern CONS % %)

    1. Return true

  9. Case (% matches pattern ITER % %)

    1. Return true

3. Otherwise,

  1. Return false

def $sideconds_multi(IC, (vari_bind)*{vari_bind <- vari_bind*}, R)

1. (Let (`{ ((id_bind ':' (id_later)*{id_later <- id_later*}))*{id_bind <- id_bind*, id_later* <- id_later**} `}) be R.OCC)

2. Check ((0 < |$select_varis((vari_bind)*{vari_bind <- vari_bind*}, [id_bind])|))*{id_bind <- id_bind*}

  1. (Let (vari)*{vari <- vari*} be $select_varis((vari_bind)*{vari_bind <- vari_bind*}, [id_bind]))*{id_bind <- id_bind*, vari* -> vari**}

  2. (Let vari_first be (vari)*{vari <- vari*}[0])*{vari* <- vari**, vari_first -> vari_first*}

  3. (Let (premAL_eq)*{premAL_eq <- premAL_eq*} be $sideconds_multi_binder(IC, vari_first, (id_later)*{id_later <- id_later*}))*{id_later* <- id_later**, vari_first <- vari_first*, premAL_eq* -> premAL_eq**}

  4. Return $concat_<premAL>(((premAL_eq)*{premAL_eq <- premAL_eq*})*{premAL_eq* <- premAL_eq**})

def $sideconds_multi_binder(IC, vari, (id_later)*{id_later <- id_later*})

1. Return ($sidecond_multi_binder(IC, vari, id_later))*{id_later <- id_later*}

def $sidecond_multi_binder(IC, (id_first typ (iter)*{iter <- iter*}), id_later)

1. (Let typedExp_first be ((VAR id_first) '#' typ))

2. (Let typedExp_later be ((VAR id_later) '#' typ))

3. (Let typedExp_cmp be ((CMP ((EQ) as cmpop) typedExp_first typedExp_later) '#' ((BOOL) as typ)))

4. (Let premAL_cmp be ((IF typedExp_cmp) as premAL))

5. (Let IC_inner be ((iter []))*{iter <- iter*})

6. (Let ((iter_outer (_vari)*{_vari <- _vari*}))*{_vari* <- _vari**, iter_outer <- iter_outer*} be IC)

7. (Let IC_outer be ((iter_outer []))*{iter_outer <- iter_outer*})

8. (Let vari_first be (id_first typ []))

9. (Let vari_later be (id_later typ []))

10. (Let IC_cmp be $add_iterated(IC_inner ++ IC_outer, [vari_first, vari_later]))

11. (Let (premIterAL)*{premIterAL <- premIterAL*} be $prem_iters(IC_cmp, [id_first, id_later], []))

12. Return $iterate_prem(premAL_cmp, (premIterAL)*{premIterAL <- premIterAL*})

def $fresh_vari(AC, IC, typ)

1. (Let ((id_used)*{id_used <- id_used*}, id_fresh) be $fresh_id(AC.USED))

2. (Let AC_used be AC[USED = (id_used)*{id_used <- id_used*}])

3. (Let vari_fresh be (id_fresh typ []))

4. (Let ((iter (_vari)*{_vari <- _vari*}))*{_vari* <- _vari**, iter <- iter*} be IC)

5. (Let vari be $iterate_vari(vari_fresh, (iter)*{iter <- iter*}))

6. (Let AC_fresh be $add_bound(AC_used, [vari]))

7. Return (AC_fresh, vari_fresh)

def $decomposes(AC, typedExp)

1. (Let (vari)*{vari <- vari*} be $free_varis_exp(typedExp))

2. (Let (id)*{id <- id*} be $ids_of_varis((vari)*{vari <- vari*}))

3. (Let (id_bound)*{id_bound <- id_bound*} be $ids_of_varis(AC.BOUND))

4. (Let bool be $forall_((id is in (id_bound)*{id_bound <- id_bound*})*{id <- id*}))

5. Return ~bool

def $sidecond_partial(IC, vari_d, typedExp_check)

1. (Let (id_d _typ (_iter)*{_iter <- _iter*}) be vari_d)

2. (Let iterCtx be $add_iterated(IC, [vari_d]))

3. (Let (premIterAL)*{premIterAL <- premIterAL*} be $prem_iters(iterCtx, [id_d], []))

4. Return $iterate_prem(((IF typedExp_check) as premAL), (premIterAL)*{premIterAL <- premIterAL*})

def $let_partial(IC, vari_d, typedExp_l, typedExp_r)

1. (Let (id_d _typ (_iter)*{_iter <- _iter*}) be vari_d)

2. (Let (vari_l)*{vari_l <- vari_l*} be $free_varis_exp(typedExp_l))

3. (Let (vari_bind)*{vari_bind <- vari_bind*} be $shallowest_varis((vari_l)*{vari_l <- vari_l*}))

4. (Let IC_bind be $add_iterated(IC, vari_d :: (vari_bind)*{vari_bind <- vari_bind*}))

5. (Let (id)*{id <- id*} be $ids_of_varis((vari_bind)*{vari_bind <- vari_bind*}))

6. (Let (premIterAL)*{premIterAL <- premIterAL*} be $prem_iters(IC_bind, [id_d], (id)*{id <- id*}))

7. Return $iterate_prem(((LET typedExp_l '=' typedExp_r) as premAL), (premIterAL)*{premIterAL <- premIterAL*})

def $split_inputs<X>((n)*{n <- n*}, (X)*{X <- X*})

1. Check ($forall_(((n < |(X)*{X <- X*}|))*{n <- n*}))

  1. Return $split_inputs_from<X>((n)*{n <- n*}, 0, (X)*{X <- X*})

def $split_inputs_from<X>(inputHint, n', (X)*{X <- X*})

1. Block (2 arms)

Arm 1:

  1. If (((X)*{X <- X*} matches pattern [])), then

    1. Return ([], [])

  1. Else Dangling

Arm 2:

  1. (Let (n)*{n <- n*} be inputHint)

  2. Check (((X)*{X <- X*} matches pattern _ :: _))

    1. (Let X_h :: (X_t)*{X_t <- X_t*} be (X)*{X <- X*})

    2. Case analysis on n' is in (n)*{n <- n*} (total)

      1. Case true

        1. (Let ((X_in)*{X_in <- X_in*}, (X_out)*{X_out <- X_out*}) be $split_inputs_from<X>((n)*{n <- n*}, (n' + 1), (X_t)*{X_t <- X_t*}))

        2. Return (X_h :: (X_in)*{X_in <- X_in*}, (X_out)*{X_out <- X_out*})

      2. Case false

        1. (Let ((X_in)*{X_in <- X_in*}, (X_out)*{X_out <- X_out*}) be $split_inputs_from<X>((n)*{n <- n*}, (n' + 1), (X_t)*{X_t <- X_t*}))

        2. Return ((X_in)*{X_in <- X_in*}, X_h :: (X_out)*{X_out <- X_out*})

def $is_singleton_typ(tdenv, typ)

1. (Let typRes be $expand_typ(tdenv, typ))

2. If let (OK typ') of type ok<typ> be typRes, then

  1. If let (VAR id (targ)*{targ <- targ*}) be typ' matching pattern VAR % %, then

    1. (Let (typDef')?{typDef' <- typDef'?} be $find_map<id, typDef>(tdenv, id))

    2. If (((typDef')?{typDef' <- typDef'?} matches pattern (_))), then

      1. (Let ?(typDef) be (typDef')?{typDef' <- typDef'?})

      2. If let (TYP _id (tparam)*{tparam <- tparam*} '=' deftyp) of type definedTypDefn be typDef, then

        1. If let (VARIANT (typCase)*{typCase <- typCase*}) be deftyp matching pattern VARIANT %, then

          1. If ((|(typCase)*{typCase <- typCase*}| = 1)), then

            1. If ((|(tparam)*{tparam <- tparam*}| = |(targ)*{targ <- targ*}|)), then

              1. Return true

3. Otherwise,

  1. Return false

def $is_irrefutable(tdenv, typedExp')

1. (Let (exp '#' typ) be typedExp')

2. Case analysis on exp

  1. Case (% matches pattern VAR %)

    1. Return true

  2. Case (% matches pattern TUP %, let (TUP (typedExp)*{typedExp <- typedExp*}) = %)

    1. (Let bool be $is_irrefutable(tdenv, typedExp))*{typedExp <- typedExp*, bool -> bool*}

    2. Return $forall_((bool)*{bool <- bool*})

  3. Case (% matches pattern INJ %, let (INJ (_mixop (typedExp)*{typedExp <- typedExp*})) = %)

    1. (Let bool' be $is_singleton_typ(tdenv, typ))

    2. (Let bool''' be $is_irrefutable(tdenv, typedExp))*{typedExp <- typedExp*, bool''' -> bool'''*}

    3. (Let bool'' be $forall_((bool''')*{bool''' <- bool'''*}))

    4. Return (bool' /\ bool'')

  4. Case (% matches pattern STR %, let (STR (expField)*{expField <- expField*}) = %)

    1. (Let (_atom typedExp) be expField)*{expField <- expField*, _atom -> _atom*, typedExp -> typedExp*}

    2. (Let bool'''' be $is_irrefutable(tdenv, typedExp))*{typedExp <- typedExp*, bool'''' -> bool''''*}

    3. Return $forall_((bool'''')*{bool'''' <- bool''''*})

  5. Case (% matches pattern ITER % %, let (ITER typedExp _expIter) = %)

    1. Return $is_irrefutable(tdenv, typedExp)

3. Otherwise,

  1. Return false

def $variant_cases(tdenv, typ)

1. Check ((typ matches pattern VAR % %))

  1. (Let (VAR id (_targ)*{_targ <- _targ*}) be typ)

  2. (Let (typDef')?{typDef' <- typDef'?} be $find_map<id, typDef>(tdenv, id))

  3. Check (((typDef')?{typDef' <- typDef'?} matches pattern (_)))

    1. (Let ?(typDef) be (typDef')?{typDef' <- typDef'?})

    2. Check ((typDef has type definedTypDefn))

      1. (Let (TYP _id (_tparam)*{_tparam <- _tparam*} '=' deftyp) be (typDef as definedTypDefn))

      2. Check ((deftyp matches pattern VARIANT %))

        1. (Let (VARIANT (typCase)*{typCase <- typCase*}) be deftyp)

        2. Return (typCase)*{typCase <- typCase*}

def $covered_cases(tdenv, (exp '#' typ'))

1. Case analysis on exp

  1. Case (% matches pattern VAR %)

    1. Return $variant_cases(tdenv, typ')

  2. Case (% matches pattern UPCAST % %, let (UPCAST _typ typedExp) = %)

    1. Return $covered_cases(tdenv, typedExp)

  3. Case (% matches pattern INJ %, let (INJ (mixop (typedExp)*{typedExp <- typedExp*})) = %)

    1. Check ($forall_(($is_irrefutable(tdenv, typedExp))*{typedExp <- typedExp*}))

      1. (Let (_exp '#' typ) be typedExp)*{typedExp <- typedExp*, _exp -> _exp*, typ -> typ*}

      2. Return [(mixop (typ)*{typ <- typ*})]

1. Else Dangling

def $is_wildcard_exp(typedExp)

1. (Let (exp '#' _typ) be typedExp)

2. If let (VAR id) be exp matching pattern VAR %, then

  1. If ((|id| > 0)), then

    1. If (((0 + 1) <= |id|)), then

      1. If ((id[0 : 1] = "_")), then

        1. Return true

3. Otherwise,

  1. Return false

def $shares_case((typCase_a)*{typCase_a <- typCase_a*}, (typCase_b)*{typCase_b <- typCase_b*})

1. Return $exists_((typCase_a is in (typCase_b)*{typCase_b <- typCase_b*})*{typCase_a <- typCase_a*})

def $overlaps(((typCase_a)*{typCase_a <- typCase_a*})*{typCase_a* <- typCase_a**}, ((typCase_b)*{typCase_b <- typCase_b*})*{typCase_b* <- typCase_b**})

1. Check ((|((typCase_a)*{typCase_a <- typCase_a*})*{typCase_a* <- typCase_a**}| = |((typCase_b)*{typCase_b <- typCase_b*})*{typCase_b* <- typCase_b**}|))

  1. (Let b_share be $shares_case((typCase_a)*{typCase_a <- typCase_a*}, (typCase_b)*{typCase_b <- typCase_b*}))*{typCase_a* <- typCase_a**, typCase_b* <- typCase_b**, b_share -> b_share*}

  2. Return $forall_((b_share)*{b_share <- b_share*})

def $is_exclusive((((typCase)*{typCase <- typCase*})*{typCase* <- typCase**})*{typCase** <- typCase***})

1. Case analysis on (((typCase)*{typCase <- typCase*})*{typCase* <- typCase**})*{typCase** <- typCase***} (total)

  1. Case (% matches pattern [])

    1. Return true

  2. Case (% matches pattern _ :: _)

    1. (Let ((typCase_h)*{typCase_h <- typCase_h*})*{typCase_h* <- typCase_h**} :: (((typCase_t)*{typCase_t <- typCase_t*})*{typCase_t* <- typCase_t**})*{typCase_t** <- typCase_t***} be (((typCase)*{typCase <- typCase*})*{typCase* <- typCase**})*{typCase** <- typCase***})

    2. (Let b_overlap be $overlaps(((typCase_h)*{typCase_h <- typCase_h*})*{typCase_h* <- typCase_h**}, ((typCase_t)*{typCase_t <- typCase_t*})*{typCase_t* <- typCase_t**}))*{typCase_t** <- typCase_t***, b_overlap -> b_overlap*}

    3. (Let bool be $exists_((b_overlap)*{b_overlap <- b_overlap*}))

    4. (Let bool' be $is_exclusive((((typCase_t)*{typCase_t <- typCase_t*})*{typCase_t* <- typCase_t**})*{typCase_t** <- typCase_t***}))

    5. Return (~bool /\ bool')

def $prepend_each(typCase, ((typCase_rest)*{typCase_rest <- typCase_rest*})*{typCase_rest* <- typCase_rest**})

1. Return (typCase :: (typCase_rest)*{typCase_rest <- typCase_rest*})*{typCase_rest* <- typCase_rest**}

def $combinations(((typCase)*{typCase <- typCase*})*{typCase* <- typCase**})

1. Case analysis on ((typCase)*{typCase <- typCase*})*{typCase* <- typCase**} (total)

  1. Case (% matches pattern [])

    1. Return [[]]

  2. Case (% matches pattern _ :: _)

    1. (Let (typCase_h)*{typCase_h <- typCase_h*} :: ((typCase_t)*{typCase_t <- typCase_t*})*{typCase_t* <- typCase_t**} be ((typCase)*{typCase <- typCase*})*{typCase* <- typCase**})

    2. (Let ((typCase_rest)*{typCase_rest <- typCase_rest*})*{typCase_rest* <- typCase_rest**} be $combinations(((typCase_t)*{typCase_t <- typCase_t*})*{typCase_t* <- typCase_t**}))

    3. (Let ((typCase_comb)*{typCase_comb <- typCase_comb*})*{typCase_comb* <- typCase_comb**} be $prepend_each(typCase_h, ((typCase_rest)*{typCase_rest <- typCase_rest*})*{typCase_rest* <- typCase_rest**}))*{typCase_h <- typCase_h*, typCase_comb** -> typCase_comb***}

    4. Return $concat_<typCase*>((((typCase_comb)*{typCase_comb <- typCase_comb*})*{typCase_comb* <- typCase_comb**})*{typCase_comb** <- typCase_comb***})

def $is_covered((((typCase_row)*{typCase_row <- typCase_row*})*{typCase_row* <- typCase_row**})*{typCase_row** <- typCase_row***}, (typCase)*{typCase <- typCase*})

1. Check ((|(typCase)*{typCase <- typCase*}| = |((typCase_row)*{typCase_row <- typCase_row*})*{typCase_row* <- typCase_row**}|))*{typCase_row** <- typCase_row***}

  1. (Let b_cover be $forall_((typCase is in (typCase_row)*{typCase_row <- typCase_row*})*{typCase <- typCase*, typCase_row* <- typCase_row**}))*{typCase_row** <- typCase_row***, b_cover -> b_cover*}

  2. Return $exists_((b_cover)*{b_cover <- b_cover*})

def $exp_len(typedExp)

1. Return ((LEN typedExp) '#' ((NAT) as typ))

def $sidecond_cmp(cmpop, typedExp_l, typedExp_r)

1. Return ((IF ((CMP cmpop typedExp_l typedExp_r) '#' ((BOOL) as typ))) as premAL)

def $exp_zero(tdenv, typ)

1. Block (2 arms)

Arm 1:

  1. If ((((OK ((NAT) as typ)) as typRes) = $expand_typ(tdenv, typ))), then

    1. Return (((NAT 0) as exp) '#' ((NAT) as typ))

  1. Else Dangling

Arm 2:

  1. Check ((((OK ((INT) as typ)) as typRes) = $expand_typ(tdenv, typ)))

    1. Return (((INT (0 as int)) as exp) '#' ((INT) as typ))

def $sidecond_iter(iter, vari_a, vari_b)

1. Case analysis on iter (total)

  1. Case (% matches pattern STAR)

    1. (Let vari' be $iterate_vari(vari_a, [(STAR)]))

    2. (Let typedExp_a be $exp_of_vari(vari'))

    3. (Let vari be $iterate_vari(vari_b, [(STAR)]))

    4. (Let typedExp_b be $exp_of_vari(vari))

    5. (Let typedExp be $exp_len(typedExp_a))

    6. (Let typedExp' be $exp_len(typedExp_b))

    7. Return $sidecond_cmp(((EQ) as cmpop), typedExp, typedExp')

  2. Case (% matches pattern QUEST)

    1. (Let vari''' be $iterate_vari(vari_a, [(QUEST)]))

    2. (Let typedExp_a be $exp_of_vari(vari'''))

    3. (Let vari'' be $iterate_vari(vari_b, [(QUEST)]))

    4. (Let typedExp_b be $exp_of_vari(vari''))

    5. (Let (_exp '#' typ_opt) be typedExp_a)

    6. (Let typedExp_none_a be ((CMP ((EQ) as cmpop) typedExp_a ((OPT ?()) '#' typ_opt)) '#' ((BOOL) as typ)))

    7. (Let typedExp_none_b be ((CMP ((EQ) as cmpop) typedExp_b ((OPT ?()) '#' typ_opt)) '#' ((BOOL) as typ)))

    8. Return ((IF ((BIN ((EQUIV) as binop) typedExp_none_a typedExp_none_b) '#' ((BOOL) as typ))) as premAL)

def $sideconds_iter(iter, (vari')*{vari' <- vari'*})

1. Case analysis on (vari')*{vari' <- vari'*}

  1. Case (% matches pattern [])

    1. Return []

  2. Case (% matches pattern [ _/1 ])

    1. Return []

  3. Case (% matches pattern _ :: _)

    1. (Let vari_a :: (vari)*{vari <- vari*} be (vari')*{vari' <- vari'*})

    2. Check (((vari)*{vari <- vari*} matches pattern _ :: _))

      1. (Let vari_b :: (vari_t)*{vari_t <- vari_t*} be (vari)*{vari <- vari*})

      2. (Let premAL_ab be $sidecond_iter(iter, vari_a, vari_b))

      3. (Let (premAL_t)*{premAL_t <- premAL_t*} be $sideconds_iter(iter, vari_b :: (vari_t)*{vari_t <- vari_t*}))

      4. Return premAL_ab :: (premAL_t)*{premAL_t <- premAL_t*}

1. Else Dangling

def $access_exp(typedExp_b, (path '#' typ))

1. Case analysis on path (total)

  1. Case (% matches pattern ROOT)

    1. Return typedExp_b

  2. Case (% matches pattern IDX % %, let (IDX typedPath typedExp_i) = %)

    1. (Let typedExp_p be $access_exp(typedExp_b, typedPath))

    2. Return ((IDX typedExp_p typedExp_i) '#' typ)

  3. Case (% matches pattern SLICE % % %, let (SLICE typedPath typedExp_i typedExp_n) = %)

    1. (Let typedExp_p be $access_exp(typedExp_b, typedPath))

    2. Return ((SLICE typedExp_p typedExp_i typedExp_n) '#' typ)

  4. Case (% matches pattern DOT % %, let (DOT typedPath atom) = %)

    1. (Let typedExp_p be $access_exp(typedExp_b, typedPath))

    2. Return ((DOT typedExp_p atom) '#' typ)

def $sideconds_replace(tdenv, typedPath, typedExp_f)

1. (Let (path '#' _typ) be typedPath)

2. Case analysis on path

  1. Case (% matches pattern SLICE % % %, let (SLICE _typedPath _typedExp typedExp_n) = %)

    1. (Let typedExp_len be $exp_len(typedExp_f))

    2. (Let premAL_len be $sidecond_cmp(((EQ) as cmpop), typedExp_len, typedExp_n))

    3. Return [premAL_len]

  2. Case (% matches pattern IDX % %, let (IDX (_path '#' typ_b) _typedExp) = %)

    1. If ((((OK ((TEXT) as typ)) as typRes) = $expand_typ(tdenv, typ_b))), then

      1. (Let typedExp_len be $exp_len(typedExp_f))

      2. (Let premAL_len be $sidecond_cmp(((EQ) as cmpop), typedExp_len, (((NAT 1) as exp) '#' ((NAT) as typ))))

      3. Return [premAL_len]

3. Otherwise,

  1. Return []

syntax venv = map<varr, val>

syntax renv = map<id, relDefnAL>

syntax fenv = map<id, funcDefnAL>

syntax fnenv = map<id, id>

syntax globalLayer = {TYP tdenv, REL renv, FUNC fenv}

syntax localLayer = {TYP tdenv, FUNC fnenv, VAL venv}

def $empty_globalLayer

1. Return {TYP $empty_map<id, typDef>, REL $empty_map<id, relDefnAL>, FUNC $empty_map<id, funcDefnAL>}

def $empty_localLayer

1. Return {TYP $empty_map<id, typDef>, FUNC $empty_map<id, id>, VAL $empty_map<varr, val>}

syntax ctx = {GLOBAL globalLayer, LOCAL localLayer}

def $empty_ctx

1. Return {GLOBAL $empty_globalLayer, LOCAL $empty_localLayer}

var C : ctx

def $load_ctx(C, (defnAL')*{defnAL' <- defnAL'*})

1. Case analysis on (defnAL')*{defnAL' <- defnAL'*} (total)

  1. Case (% matches pattern _ :: _)

    1. (Let defnAL :: (defnAL_t)*{defnAL_t <- defnAL_t*} be (defnAL')*{defnAL' <- defnAL'*})

    2. Case analysis on defnAL (total)

      1. Case (% has type externTypDefn, let externTypDefn = %)

        1. (Let (EXTTYP id) be externTypDefn)

        2. (Let tdenv_update be $add_map<id, typDef>(C.GLOBAL.TYP, id, (externTypDefn as typDef)))

        3. (Let C' be C[GLOBAL.TYP = tdenv_update])

        4. Return $load_ctx(C', (defnAL_t)*{defnAL_t <- defnAL_t*})

      2. Case (% has type definedTypDefn, let definedTypDefn = %)

        1. (Let (TYP id (_tparam)*{_tparam <- _tparam*} '=' _deftyp) be definedTypDefn)

        2. (Let tdenv_update be $add_map<id, typDef>(C.GLOBAL.TYP, id, (definedTypDefn as typDef)))

        3. (Let C' be C[GLOBAL.TYP = tdenv_update])

        4. Return $load_ctx(C', (defnAL_t)*{defnAL_t <- defnAL_t*})

      3. Case (% has type externRelDefnAL, let externRelDefnAL = %)

        1. (Let (EXTREL id ':' (_typ)*{_typ <- _typ*} '->' (_typ')*{_typ' <- _typ'*}) be externRelDefnAL)

        2. (Let renv_update be $add_map<id, relDefnAL>(C.GLOBAL.REL, id, (externRelDefnAL as relDefnAL)))

        3. (Let C' be C[GLOBAL.REL = renv_update])

        4. Return $load_ctx(C', (defnAL_t)*{defnAL_t <- defnAL_t*})

      4. Case (% has type definedRelDefnAL, let definedRelDefnAL = %)

        1. (Let (REL id ':' (_typ)*{_typ <- _typ*} '->' (_typ')*{_typ' <- _typ'*} '=' (_rulGroupAL)*{_rulGroupAL <- _rulGroupAL*} (_elsGroupAL)?{_elsGroupAL <- _elsGroupAL?}) be definedRelDefnAL)

        2. (Let renv_update be $add_map<id, relDefnAL>(C.GLOBAL.REL, id, (definedRelDefnAL as relDefnAL)))

        3. (Let C' be C[GLOBAL.REL = renv_update])

        4. Return $load_ctx(C', (defnAL_t)*{defnAL_t <- defnAL_t*})

      5. Case (% has type externFuncDefn, let externFuncDefn = %)

        1. (Let (EXTFUNC id (_tparam)*{_tparam <- _tparam*} (_param)*{_param <- _param*} ':' _typ) be externFuncDefn)

        2. (Let fenv_update be $add_map<id, funcDefnAL>(C.GLOBAL.FUNC, id, (externFuncDefn as funcDefnAL)))

        3. (Let C' be C[GLOBAL.FUNC = fenv_update])

        4. Return $load_ctx(C', (defnAL_t)*{defnAL_t <- defnAL_t*})

      6. Case (% has type builtinFuncDefn, let builtinFuncDefn = %)

        1. (Let (BUILTINFUNC id (_tparam)*{_tparam <- _tparam*} (_param)*{_param <- _param*} ':' _typ) be builtinFuncDefn)

        2. (Let fenv_update be $add_map<id, funcDefnAL>(C.GLOBAL.FUNC, id, (builtinFuncDefn as funcDefnAL)))

        3. (Let C' be C[GLOBAL.FUNC = fenv_update])

        4. Return $load_ctx(C', (defnAL_t)*{defnAL_t <- defnAL_t*})

      7. Case (% has type tableFuncDefnAL, let tableFuncDefnAL = %)

        1. (Let (TABLEFUNC id (_param)*{_param <- _param*} ':' _typ '=' (_tblRowAL)*{_tblRowAL <- _tblRowAL*}) be tableFuncDefnAL)

        2. (Let fenv_update be $add_map<id, funcDefnAL>(C.GLOBAL.FUNC, id, (tableFuncDefnAL as funcDefnAL)))

        3. (Let C' be C[GLOBAL.FUNC = fenv_update])

        4. Return $load_ctx(C', (defnAL_t)*{defnAL_t <- defnAL_t*})

      8. Case (% has type definedFuncDefnAL, let definedFuncDefnAL = %)

        1. (Let (FUNC id (_tparam)*{_tparam <- _tparam*} (_param)*{_param <- _param*} ':' _typ '=' (_clauseAL)*{_clauseAL <- _clauseAL*} (_elsClauseAL)?{_elsClauseAL <- _elsClauseAL?}) be definedFuncDefnAL)

        2. (Let fenv_update be $add_map<id, funcDefnAL>(C.GLOBAL.FUNC, id, (definedFuncDefnAL as funcDefnAL)))

        3. (Let C' be C[GLOBAL.FUNC = fenv_update])

        4. Return $load_ctx(C', (defnAL_t)*{defnAL_t <- defnAL_t*})

  2. Case (% matches pattern [])

    1. Return C

def $add_varr(C, varr, val)

1. (Let venv_update be $add_map<varr, val>(C.LOCAL.VAL, varr, val))

2. Return C[LOCAL.VAL = venv_update]

def $add_varis(C, (vari)*{vari <- vari*}, (val)*{val <- val*})

1. (Let (id _typ (iter)*{iter <- iter*}) be vari)*{vari <- vari*, _typ -> _typ*, id -> id*, iter* -> iter**}

2. (Let venv_update be $adds_map<varr, val>(C.LOCAL.VAL, ((id (iter)*{iter <- iter*}))*{id <- id*, iter* <- iter**}, (val)*{val <- val*}))

3. Return C[LOCAL.VAL = venv_update]

def $add_func(C, id, id_global)

1. (Let fnenv_update be $add_map<id, id>(C.LOCAL.FUNC, id, id_global))

2. Return C[LOCAL.FUNC = fnenv_update]

def $find_vari(C, vari)

1. (Let (id _typ (iter)*{iter <- iter*}) be vari)

2. (Let (val')?{val' <- val'?} be $find_map<varr, val>(C.LOCAL.VAL, (id (iter)*{iter <- iter*})))

3. If (((val')?{val' <- val'?} matches pattern (_))), then

  1. (Let ?(val) be (val')?{val' <- val'?})

  2. Return ?(val)

4. Otherwise,

  1. Return ?()

def $find_varr(C, varr)

1. Return $find_map<varr, val>(C.LOCAL.VAL, varr)

def $find_varis(C, (vari)*{vari <- vari*})

1. (Let (val')?{val' <- val'?} be $find_vari(C, vari))*{vari <- vari*, val'? -> val'?*}

2. If (((val')?{val' <- val'?} matches pattern (_)))*{val'? <- val'?*}, then

  1. (Let ?(val) be (val')?{val' <- val'?})*{val'? <- val'?*, val -> val*}

  2. Return ?((val)*{val <- val*})

3. Otherwise,

  1. Return ?()

def $finds_vari((C)*{C <- C*}, vari)

1. (Let (id _typ (iter)*{iter <- iter*}) be vari)

2. (Let (val')?{val' <- val'?} be $find_map<varr, val>(C.LOCAL.VAL, (id (iter)*{iter <- iter*})))*{C <- C*, val'? -> val'?*}

3. If (((val')?{val' <- val'?} matches pattern (_)))*{val'? <- val'?*}, then

  1. (Let ?(val) be (val')?{val' <- val'?})*{val'? <- val'?*, val -> val*}

  2. Return ?((val)*{val <- val*})

4. Otherwise,

  1. Return ?()

def $find_typ(C, id)

1. Block (2 arms)

Arm 1:

  1. (Let (typDef')?{typDef' <- typDef'?} be $find_map<id, typDef>(C.LOCAL.TYP, id))

  2. If (((typDef')?{typDef' <- typDef'?} matches pattern (_))), then

    1. (Let ?(typDef) be (typDef')?{typDef' <- typDef'?})

    2. Return ?(typDef)

  2. Else Dangling

Arm 2:

  1. Check (($find_map<id, typDef>(C.LOCAL.TYP, id) matches pattern ()))

    1. Return $find_map<id, typDef>(C.GLOBAL.TYP, id)

def $find_func_param(C, id)

1. Return $find_map<id, id>(C.LOCAL.FUNC, id)

def $resolve_func_param(C, id)

1. (Let (id')?{id' <- id'?} be $find_func_param(C, id))

2. Return $deopt_<id>((id')?{id' <- id'?}, id)

def $find_func(C, id)

1. Return $find_map<id, funcDefnAL>(C.GLOBAL.FUNC, id)

def $find_rel(C, id)

1. Return $find_map<id, relDefnAL>(C.GLOBAL.REL, id)

syntax subOptRes =
   | OK ctx? (from ok<ctx?>)
   | ERROR (from error)

def $sub_opt(C, (vari)*{vari <- vari*})

1. Case analysis on (vari)*{vari <- vari*} (total)

  1. Case (% matches pattern [])

    1. Return ((ERROR) as subOptRes)

  2. Case (% matches pattern _ :: _)

    1. (Let vari_iter be $iterate_vari(vari, [(QUEST)]))*{vari <- vari*, vari_iter -> vari_iter*}

    2. Block (2 arms)

    Arm 1:

      1. (Let (val''')?{val''' <- val'''?} be $find_vari(C, vari_iter))*{vari_iter <- vari_iter*, val'''? -> val'''?*}

      2. If (((val''')?{val''' <- val'''?} matches pattern (_)))*{val'''? <- val'''?*}, then

        1. (Let ?(val'') be (val''')?{val''' <- val'''?})*{val'''? <- val'''?*, val'' -> val''*}

        2. If ((val'' matches pattern OPT %))*{val'' <- val''*}, then

          1. (Let (OPT (val')?{val' <- val'?}) be val'')*{val'' <- val''*, val'? -> val'?*}

          2. If (((val')?{val' <- val'?} matches pattern (_)))*{val'? <- val'?*}, then

            1. (Let ?(val) be (val')?{val' <- val'?})*{val'? <- val'?*, val -> val*}

            2. (Let C_sub be $add_varis(C, (vari)*{vari <- vari*}, (val)*{val <- val*}))

            3. Return ((OK ?(C_sub)) as subOptRes)

    Arm 2:

      1. If ((?((OPT ?())) = $find_vari(C, vari_iter)))*{vari_iter <- vari_iter*}, then

        1. Return ((OK ?()) as subOptRes)

2. Otherwise,

  1. Return ((ERROR) as subOptRes)

syntax subListRes =
   | OK ctx* (from ok<ctx*>)
   | ERROR (from error)

def $sub_list(C, (vari)*{vari <- vari*})

1. (Let vari_iter be $iterate_vari(vari, [(STAR)]))*{vari <- vari*, vari_iter -> vari_iter*}

2. (Let (val'')?{val'' <- val''?} be $find_vari(C, vari_iter))*{vari_iter <- vari_iter*, val''? -> val''?*}

3. If (((val'')?{val'' <- val''?} matches pattern (_)))*{val''? <- val''?*}, then

  1. (Let ?(val') be (val'')?{val'' <- val''?})*{val''? <- val''?*, val' -> val'*}

  2. If ((val' matches pattern LIST %))*{val' <- val'*}, then

    1. (Let (LIST (val)*{val <- val*}) be val')*{val' <- val'*, val* -> val**}

    2. If ((0 < |((val)*{val <- val*})*{val* <- val**}|))*{val* <- val**}, then

      1. If ($forall_(((|(val)*{val <- val*}| = |((val)*{val <- val*})*{val* <- val**}[0]|))*{val* <- val**})), then

        1. (Let ((val_trans)*{val_trans <- val_trans*})*{val_trans* <- val_trans**} be $transpose_<val>(((val)*{val <- val*})*{val* <- val**}))

        2. (Let C' be $add_varis(C, (vari)*{vari <- vari*}, (val_trans)*{val_trans <- val_trans*}))*{val_trans* <- val_trans**, C' -> C'*}

        3. Return ((OK (C')*{C' <- C'*}) as subListRes)

4. Otherwise,

  1. Return ((ERROR) as subListRes)

syntax funcRes =
   | OK val (from ok<val>)
   | ERROR (from error)
   | UNMATCH (from unmatch)

extern relation Call_extern_func: |- id `< (typ)*{typ <- typ*} `> `( (val)*{val <- val*} `) : %

extern relation Call_builtin_func: |- id `< (typ)*{typ <- typ*} `> `( (val)*{val <- val*} `) : %

syntax relRes =
   | OK val* (from ok<val*>)
   | ERROR (from error)
   | UNMATCH (from unmatch)

extern relation Call_extern_rel: |- id `( (val)*{val <- val*} `) : %

syntax expRes =
   | OK val (from ok<val>)
   | ERROR (from error)
   | UNMATCH (from unmatch)

relation Eval_exp: C |- typedExp' : %

1. (Let (exp '#' typ') be typedExp')

2. Block (2 arms)

Arm 1:

  1. Group literal: C |- (exp '#' typ') : %

    1. Case analysis on exp

      1. Case (% matches pattern BOOL %, let (BOOL b) = %)

        1. Result in: % |- % : ((OK (BOOL b)) as expRes)

      2. Case (% has type num, let num = %)

        1. Result in: % |- % : ((OK (num as val)) as expRes)

      3. Case (% matches pattern TEXT %, let (TEXT t) = %)

        1. Result in: % |- % : ((OK (TEXT t)) as expRes)

Arm 2:

  1. Case analysis on exp

    1. Case (% matches pattern VAR %, let (VAR id) = %)

      1. Group variable: C |- ((VAR id) '#' typ') : %

        1. (Let (val')?{val' <- val'?} be $find_varr(C, (id [])))

        2. If (((val')?{val' <- val'?} matches pattern (_))), then

          1. (Let ?(val) be (val')?{val' <- val'?})

          2. Result in: % |- % : ((OK val) as expRes)

    2. Case (% matches pattern UN % %, let (UN unop typedExp) = %)

      1. Group unary: C |- ((UN unop typedExp) '#' typ') : %

        1. Block (2 arms)

        Arm 1:

          1. If ((unop = ((NOT) as unop))), then

            1. (Eval_exp: C |- typedExp : expRes)

            2. Case analysis on expRes (total)

              1. Case (% has type failure, let failure = %)

                1. Result in: % |- % : (failure as expRes)

              2. Case (% has type ok<val>, let (OK val) = %)

                1. If let (BOOL b) be val matching pattern BOOL %, then

                  1. (Let b_res be ~b)

                  2. Result in: % |- % : ((OK (BOOL b_res)) as expRes)

        Arm 2:

          1. If let numUnop of type numUnop be unop, then

            1. (Eval_exp: C |- typedExp : expRes)

            2. Case analysis on expRes (total)

              1. Case (% has type failure, let failure = %)

                1. Result in: % |- % : (failure as expRes)

              2. Case (% has type ok<val>, let (OK val) = %)

                1. If let num of type num be val, then

                  1. (Let val_res be $numUnop(numUnop, num))

                  2. Result in: % |- % : ((OK val_res) as expRes)

    3. Case (% matches pattern BIN % % %, let (BIN binop typedExp_l typedExp_r) = %)

      1. Group binary: C |- ((BIN binop typedExp_l typedExp_r) '#' typ') : %

        1. Case analysis on binop (total)

          1. Case (% has type boolBinop, let boolBinop = %)

            1. (Eval_exp: C |- typedExp_l : expRes)

            2. Case analysis on expRes (total)

              1. Case (% has type failure, let failure = %)

                1. Result in: % |- % : (failure as expRes)

              2. Case (% has type ok<val>, let (OK val) = %)

                1. If let (BOOL b_l) be val matching pattern BOOL %, then

                  1. (Eval_exp: C |- typedExp_r : expRes')

                  2. Case analysis on expRes' (total)

                    1. Case (% has type failure, let failure = %)

                      1. Result in: % |- % : (failure as expRes)

                    2. Case (% has type ok<val>, let (OK val') = %)

                      1. If let (BOOL b_r) be val' matching pattern BOOL %, then

                        1. (Let b_res be $boolBinop(boolBinop, b_l, b_r))

                        2. Result in: % |- % : ((OK (BOOL b_res)) as expRes)

          2. Case (% has type numBinop, let numBinop = %)

            1. (Eval_exp: C |- typedExp_l : expRes)

            2. Case analysis on expRes (total)

              1. Case (% has type failure, let failure = %)

                1. Result in: % |- % : (failure as expRes)

              2. Case (% has type ok<val>, let (OK val) = %)

                1. If let num_l of type num be val, then

                  1. (Eval_exp: C |- typedExp_r : expRes')

                  2. Case analysis on expRes' (total)

                    1. Case (% has type failure, let failure = %)

                      1. Result in: % |- % : (failure as expRes)

                    2. Case (% has type ok<val>, let (OK val') = %)

                      1. If let num_r of type num be val', then

                        1. (Let numBinopRes be $numBinop(numBinop, num_l, num_r))

                        2. Result in: % |- % : (numBinopRes as expRes)

    4. Case (% matches pattern CMP % % %, let (CMP cmpop typedExp_l typedExp_r) = %)

      1. Group compare: C |- ((CMP cmpop typedExp_l typedExp_r) '#' typ') : %

        1. Case analysis on cmpop (total)

          1. Case (% has type polyCmpop, let polyCmpop = %)

            1. (Eval_exp: C |- typedExp_l : expRes)

            2. Case analysis on expRes (total)

              1. Case (% has type failure, let failure = %)

                1. Result in: % |- % : (failure as expRes)

              2. Case (% has type ok<val>, let (OK val_l) = %)

                1. (Eval_exp: C |- typedExp_r : expRes')

                2. Case analysis on expRes' (total)

                  1. Case (% has type failure, let failure = %)

                    1. Result in: % |- % : (failure as expRes)

                  2. Case (% has type ok<val>, let (OK val_r) = %)

                    1. (Let b_res be $polyCmpop(polyCmpop, val_l, val_r))

                    2. Result in: % |- % : ((OK (BOOL b_res)) as expRes)

          2. Case (% has type numCmpop, let numCmpop = %)

            1. (Eval_exp: C |- typedExp_l : expRes)

            2. Case analysis on expRes (total)

              1. Case (% has type failure, let failure = %)

                1. Result in: % |- % : (failure as expRes)

              2. Case (% has type ok<val>, let (OK val) = %)

                1. If let num_l of type num be val, then

                  1. (Eval_exp: C |- typedExp_r : expRes')

                  2. Case analysis on expRes' (total)

                    1. Case (% has type failure, let failure = %)

                      1. Result in: % |- % : (failure as expRes)

                    2. Case (% has type ok<val>, let (OK val') = %)

                      1. If let num_r of type num be val', then

                        1. (Let numCmpRes be $numCmpop(numCmpop, num_l, num_r))

                        2. If let (OK b_res) of type ok<bool> be numCmpRes, then

                          1. Result in: % |- % : ((OK (BOOL b_res)) as expRes)

    5. Case (% matches pattern UPCAST % %, let (UPCAST typ typedExp) = %)

      1. Group upcast: C |- ((UPCAST typ typedExp) '#' typ') : %

        1. (Eval_exp: C |- typedExp : expRes)

        2. Case analysis on expRes (total)

          1. Case (% has type failure, let failure = %)

            1. Result in: % |- % : (failure as expRes)

          2. Case (% has type ok<val>, let (OK val) = %)

            1. (Let castRes be $upcast(C, typ, val))

            2. Result in: % |- % : (castRes as expRes)

    6. Case (% matches pattern DOWNCAST % %, let (DOWNCAST typ typedExp) = %)

      1. Group downcast: C |- ((DOWNCAST typ typedExp) '#' typ') : %

        1. (Eval_exp: C |- typedExp : expRes)

        2. Case analysis on expRes (total)

          1. Case (% has type failure, let failure = %)

            1. Result in: % |- % : (failure as expRes)

          2. Case (% has type ok<val>, let (OK val) = %)

            1. (Let castRes be $downcast(C, typ, val))

            2. Result in: % |- % : (castRes as expRes)

    7. Case (% matches pattern SUB % %, let (SUB typedExp typ) = %)

      1. Group subtype: C |- ((SUB typedExp typ) '#' typ') : %

        1. (Eval_exp: C |- typedExp : expRes)

        2. Case analysis on expRes (total)

          1. Case (% has type failure, let failure = %)

            1. Result in: % |- % : (failure as expRes)

          2. Case (% has type ok<val>, let (OK val) = %)

            1. (Let (`{ ((id_local ':' typDef_local))*{id_local <- id_local*, typDef_local <- typDef_local*} `}) be C.LOCAL.TYP)

            2. (Let tdenv be $adds_map<id, typDef>(C.GLOBAL.TYP, (id_local)*{id_local <- id_local*}, (typDef_local)*{typDef_local <- typDef_local*}))

            3. (Let subtypRes be $subtyp(C.GLOBAL.FUNC, tdenv, typ, val))

            4. If let (OK b) of type ok<bool> be subtypRes, then

              1. Result in: % |- % : ((OK (BOOL b)) as expRes)

    8. Case (% matches pattern MATCH % %, let (MATCH typedExp pat) = %)

      1. Group match: C |- ((MATCH typedExp pat) '#' typ') : %

        1. (Eval_exp: C |- typedExp : expRes)

        2. Case analysis on expRes (total)

          1. Case (% has type failure, let failure = %)

            1. Result in: % |- % : (failure as expRes)

          2. Case (% has type ok<val>, let (OK val) = %)

            1. (Let b_matches be $matches(val, pat))

            2. Result in: % |- % : ((OK (BOOL b_matches)) as expRes)

    9. Case (% matches pattern TUP %, let (TUP (typedExp)*{typedExp <- typedExp*}) = %)

      1. Group tuple: C |- ((TUP (typedExp)*{typedExp <- typedExp*}) '#' typ') : %

        1. (Eval_exps: C |- (typedExp)*{typedExp <- typedExp*} : expsRes)

        2. Case analysis on expsRes (total)

          1. Case (% has type failure, let failure = %)

            1. Result in: % |- % : (failure as expRes)

          2. Case (% has type ok<val*>, let (OK (val)*{val <- val*}) = %)

            1. Result in: % |- % : ((OK (TUP (val)*{val <- val*})) as expRes)

    10. Case (% matches pattern INJ %, let (INJ (mixop (typedExp)*{typedExp <- typedExp*})) = %)

      1. Group case: C |- ((INJ (mixop (typedExp)*{typedExp <- typedExp*})) '#' typ') : %

        1. (Eval_exps: C |- (typedExp)*{typedExp <- typedExp*} : expsRes)

        2. Case analysis on expsRes (total)

          1. Case (% has type failure, let failure = %)

            1. Result in: % |- % : (failure as expRes)

          2. Case (% has type ok<val*>, let (OK (val)*{val <- val*}) = %)

            1. Result in: % |- % : ((OK (INJ (mixop (val)*{val <- val*}))) as expRes)

    11. Case (% matches pattern STR %, let (STR (expField)*{expField <- expField*}) = %)

      1. Group struct: C |- ((STR (expField)*{expField <- expField*}) '#' typ') : %

        1. (Let (atom typedExp) be expField)*{expField <- expField*, atom -> atom*, typedExp -> typedExp*}

        2. (Eval_exps: C |- (typedExp)*{typedExp <- typedExp*} : expsRes)

        3. Case analysis on expsRes (total)

          1. Case (% has type failure, let failure = %)

            1. Result in: % |- % : (failure as expRes)

          2. Case (% has type ok<val*>, let (OK (val)*{val <- val*}) = %)

            1. If ((|(atom)*{atom <- atom*}| = |(val)*{val <- val*}|)), then

              1. (Let valField be (atom val))*{atom <- atom*, val <- val*, valField -> valField*}

              2. Result in: % |- % : ((OK (STR (valField)*{valField <- valField*})) as expRes)

    12. Case (% matches pattern OPT %, let (OPT (typedExp'')?{typedExp'' <- typedExp''?}) = %)

      1. Group opt: C |- ((OPT (typedExp'')?{typedExp'' <- typedExp''?}) '#' typ') : %

        1. Case analysis on (typedExp'')?{typedExp'' <- typedExp''?} (total)

          1. Case (% matches pattern ())

            1. Result in: % |- % : ((OK (OPT ?())) as expRes)

          2. Case (% matches pattern (_))

            1. (Let ?(typedExp) be (typedExp'')?{typedExp'' <- typedExp''?})

            2. (Eval_exp: C |- typedExp : expRes)

            3. Case analysis on expRes (total)

              1. Case (% has type failure, let failure = %)

                1. Result in: % |- % : (failure as expRes)

              2. Case (% has type ok<val>, let (OK val) = %)

                1. Result in: % |- % : ((OK (OPT ?(val))) as expRes)

    13. Case (% matches pattern LIST %, let (LIST (typedExp)*{typedExp <- typedExp*}) = %)

      1. Group list: C |- ((LIST (typedExp)*{typedExp <- typedExp*}) '#' typ') : %

        1. (Eval_exps: C |- (typedExp)*{typedExp <- typedExp*} : expsRes)

        2. Case analysis on expsRes (total)

          1. Case (% has type failure, let failure = %)

            1. Result in: % |- % : (failure as expRes)

          2. Case (% has type ok<val*>, let (OK (val)*{val <- val*}) = %)

            1. Result in: % |- % : ((OK (LIST (val)*{val <- val*})) as expRes)

    14. Case (% matches pattern CONS % %, let (CONS typedExp_h typedExp_t) = %)

      1. Group cons: C |- ((CONS typedExp_h typedExp_t) '#' typ') : %

        1. (Eval_exp: C |- typedExp_h : expRes)

        2. Case analysis on expRes (total)

          1. Case (% has type failure, let failure = %)

            1. Result in: % |- % : (failure as expRes)

          2. Case (% has type ok<val>, let (OK val_h) = %)

            1. (Eval_exp: C |- typedExp_t : expRes')

            2. Case analysis on expRes' (total)

              1. Case (% has type failure, let failure = %)

                1. Result in: % |- % : (failure as expRes)

              2. Case (% has type ok<val>, let (OK val) = %)

                1. If let (LIST (val_t)*{val_t <- val_t*}) be val matching pattern LIST %, then

                  1. Result in: % |- % : ((OK (LIST val_h :: (val_t)*{val_t <- val_t*})) as expRes)

    15. Case (% matches pattern CAT % %, let (CAT typedExp_l typedExp_r) = %)

      1. Group concat: C |- ((CAT typedExp_l typedExp_r) '#' typ') : %

        1. (Eval_exp: C |- typedExp_l : expRes)

        2. Case analysis on expRes (total)

          1. Case (% has type failure, let failure = %)

            1. Result in: % |- % : (failure as expRes)

          2. Case (% has type ok<val>, let (OK val) = %)

            1. Case analysis on val

              1. Case (% matches pattern LIST %, let (LIST (val_l)*{val_l <- val_l*}) = %)

                1. (Eval_exp: C |- typedExp_r : expRes')

                2. Case analysis on expRes' (total)

                  1. Case (% has type failure, let failure = %)

                    1. Result in: % |- % : (failure as expRes)

                  2. Case (% has type ok<val>, let (OK val') = %)

                    1. If let (LIST (val_r)*{val_r <- val_r*}) be val' matching pattern LIST %, then

                      1. (Let (val_res)*{val_res <- val_res*} be (val_l)*{val_l <- val_l*} ++ (val_r)*{val_r <- val_r*})

                      2. Result in: % |- % : ((OK (LIST (val_res)*{val_res <- val_res*})) as expRes)

              2. Case (% matches pattern TEXT %, let (TEXT text_l) = %)

                1. (Eval_exp: C |- typedExp_r : expRes')

                2. Case analysis on expRes' (total)

                  1. Case (% has type failure, let failure = %)

                    1. Result in: % |- % : (failure as expRes)

                  2. Case (% has type ok<val>, let (OK val') = %)

                    1. If let (TEXT t_r) be val' matching pattern TEXT %, then

                      1. (Let t_res be text_l ++ t_r)

                      2. Result in: % |- % : ((OK (TEXT t_res)) as expRes)

    16. Case (% matches pattern MEM % %, let (MEM typedExp_e typedExp_s) = %)

      1. Group mem: C |- ((MEM typedExp_e typedExp_s) '#' typ') : %

        1. (Eval_exp: C |- typedExp_e : expRes)

        2. Case analysis on expRes (total)

          1. Case (% has type failure, let failure = %)

            1. Result in: % |- % : (failure as expRes)

          2. Case (% has type ok<val>, let (OK val_e) = %)

            1. (Eval_exp: C |- typedExp_s : expRes')

            2. Case analysis on expRes' (total)

              1. Case (% has type failure, let failure = %)

                1. Result in: % |- % : (failure as expRes)

              2. Case (% has type ok<val>, let (OK val') = %)

                1. If let (LIST (val)*{val <- val*}) be val' matching pattern LIST %, then

                  1. (Let b_mem be $exists_(((val_e = val))*{val <- val*}))

                  2. Result in: % |- % : ((OK (BOOL b_mem)) as expRes)

    17. Case (% matches pattern LEN %, let (LEN typedExp) = %)

      1. Group len: C |- ((LEN typedExp) '#' typ') : %

        1. (Eval_exp: C |- typedExp : expRes)

        2. Case analysis on expRes (total)

          1. Case (% has type failure, let failure = %)

            1. Result in: % |- % : (failure as expRes)

          2. Case (% has type ok<val>, let (OK val') = %)

            1. Case analysis on val'

              1. Case (% matches pattern TEXT %, let (TEXT t) = %)

                1. (Let n be |t|)

                2. Result in: % |- % : ((OK ((NAT n) as val)) as expRes)

              2. Case (% matches pattern LIST %, let (LIST (val)*{val <- val*}) = %)

                1. (Let n be |(val)*{val <- val*}|)

                2. Result in: % |- % : ((OK ((NAT n) as val)) as expRes)

    18. Case (% matches pattern DOT % %, let (DOT typedExp atom) = %)

      1. Group dot: C |- ((DOT typedExp atom) '#' typ') : %

        1. (Eval_exp: C |- typedExp : expRes)

        2. Case analysis on expRes (total)

          1. Case (% has type failure, let failure = %)

            1. Result in: % |- % : (failure as expRes)

          2. Case (% has type ok<val>, let (OK val) = %)

            1. (Let (_exp '#' typ_b) be typedExp)

            2. (Let typedPath be ((DOT ((ROOT) '#' typ_b) atom) '#' typ'))

            3. (Eval_path_acc: C |- val typedPath : pathRes)

            4. Result in: % |- % : (pathRes as expRes)

    19. Case (% matches pattern IDX % %, let (IDX typedExp_b typedExp_i) = %)

      1. Group idx: C |- ((IDX typedExp_b typedExp_i) '#' typ') : %

        1. (Eval_exp: C |- typedExp_b : expRes)

        2. Case analysis on expRes (total)

          1. Case (% has type failure, let failure = %)

            1. Result in: % |- % : (failure as expRes)

          2. Case (% has type ok<val>, let (OK val_b) = %)

            1. (Let (_exp '#' typ_b) be typedExp_b)

            2. (Let typedPath be ((IDX ((ROOT) '#' typ_b) typedExp_i) '#' typ'))

            3. (Eval_path_acc: C |- val_b typedPath : pathRes)

            4. Result in: % |- % : (pathRes as expRes)

    20. Case (% matches pattern SLICE % % %, let (SLICE typedExp_b typedExp_i typedExp_n) = %)

      1. Group slice: C |- ((SLICE typedExp_b typedExp_i typedExp_n) '#' typ') : %

        1. (Eval_exp: C |- typedExp_b : expRes)

        2. Case analysis on expRes (total)

          1. Case (% has type failure, let failure = %)

            1. Result in: % |- % : (failure as expRes)

          2. Case (% has type ok<val>, let (OK val_b) = %)

            1. (Let (_exp '#' typ_b) be typedExp_b)

            2. (Let typedPath be ((SLICE ((ROOT) '#' typ_b) typedExp_i typedExp_n) '#' typ'))

            3. (Eval_path_acc: C |- val_b typedPath : pathRes)

            4. Result in: % |- % : (pathRes as expRes)

    21. Case (% matches pattern UPD % % %, let (UPD typedExp_b typedPath typedExp_f) = %)

      1. Group upd: C |- ((UPD typedExp_b typedPath typedExp_f) '#' typ') : %

        1. (Eval_exp: C |- typedExp_b : expRes)

        2. Case analysis on expRes (total)

          1. Case (% has type failure, let failure = %)

            1. Result in: % |- % : (failure as expRes)

          2. Case (% has type ok<val>, let (OK val_b) = %)

            1. (Eval_exp: C |- typedExp_f : expRes')

            2. Case analysis on expRes' (total)

              1. Case (% has type failure, let failure = %)

                1. Result in: % |- % : (failure as expRes)

              2. Case (% has type ok<val>, let (OK val_f) = %)

                1. (Eval_path_upd: C |- val_b typedPath := val_f : pathRes)

                2. Result in: % |- % : (pathRes as expRes)

    22. Case (% matches pattern CALL % % %, let (CALL id (targ)*{targ <- targ*} (arg)*{arg <- arg*}) = %)

      1. Group call: C |- ((CALL id (targ)*{targ <- targ*} (arg)*{arg <- arg*}) '#' typ') : %

        1. (Eval_targs: C |- (targ)*{targ <- targ*} : typsRes)

        2. If let (OK (typ_input)*{typ_input <- typ_input*}) of type ok<typ*> be typsRes, then

          1. (Eval_args: C |- (arg)*{arg <- arg*} : argsRes)

          2. Case analysis on argsRes (total)

            1. Case (% has type failure, let failure = %)

              1. Result in: % |- % : (failure as expRes)

            2. Case (% has type ok<val*>, let (OK (val_input)*{val_input <- val_input*}) = %)

              1. (Call_func: C |- id `< (typ_input)*{typ_input <- typ_input*} `> `( (val_input)*{val_input <- val_input*} `) : funcRes)

              2. Result in: % |- % : (funcRes as expRes)

    23. Case (% matches pattern ITER % %, let (ITER typedExp expIter) = %)

      1. Group iter: C |- ((ITER typedExp expIter) '#' typ') : %

        1. Block (2 arms)

        Arm 1:

          1. (Let (varr')?{varr' <- varr'?} be $is_iter_on_var(((ITER typedExp expIter) '#' typ')))

          2. If (((varr')?{varr' <- varr'?} matches pattern (_))), then

            1. (Let ?(varr) be (varr')?{varr' <- varr'?})

            2. (Let (val')?{val' <- val'?} be $find_varr(C, varr))

            3. If (((val')?{val' <- val'?} matches pattern (_))), then

              1. (Let ?(val) be (val')?{val' <- val'?})

              2. Result in: % |- % : ((OK val) as expRes)

        Arm 2:

          1. If (($is_iter_on_var(((ITER typedExp expIter) '#' typ')) matches pattern ())), then

            1. (Let (iter (vari)*{vari <- vari*}) be expIter)

            2. Case analysis on iter (total)

              1. Case (% matches pattern QUEST)

                1. (Let subOptRes be $sub_opt(C, (vari)*{vari <- vari*}))

                2. If let (OK (C_sub)?{C_sub <- C_sub?}) of type ok<ctx?> be subOptRes, then

                  1. (Eval_exp_maybe: (C_sub)?{C_sub <- C_sub?} |- typedExp : expOptRes)

                  2. Case analysis on expOptRes (total)

                    1. Case (% has type failure, let failure = %)

                      1. Result in: % |- % : (failure as expRes)

                    2. Case (% has type ok<val?>, let (OK (val)?{val <- val?}) = %)

                      1. Result in: % |- % : ((OK (OPT (val)?{val <- val?})) as expRes)

              2. Case (% matches pattern STAR)

                1. (Let subListRes be $sub_list(C, (vari)*{vari <- vari*}))

                2. If let (OK (C_sub)*{C_sub <- C_sub*}) of type ok<ctx*> be subListRes, then

                  1. (Eval_exp_each: (C_sub)*{C_sub <- C_sub*} |- typedExp : expsRes)

                  2. Case analysis on expsRes (total)

                    1. Case (% has type failure, let failure = %)

                      1. Result in: % |- % : (failure as expRes)

                    2. Case (% has type ok<val*>, let (OK (val)*{val <- val*}) = %)

                      1. Result in: % |- % : ((OK (LIST (val)*{val <- val*})) as expRes)

3. Otherwise,

  1. Group error: C |- typedExp' : %

    1. Result in: % |- % : ((ERROR) as expRes)

syntax expsRes =
   | OK val* (from ok<val*>)
   | ERROR (from error)
   | UNMATCH (from unmatch)

relation Eval_exps: C |- (typedExp)*{typedExp <- typedExp*} : %

1. Group : C |- (typedExp)*{typedExp <- typedExp*} : %

  1. Case analysis on (typedExp)*{typedExp <- typedExp*} (total)

    1. Case (% matches pattern [])

      1. Result in: % |- % : ((OK []) as expsRes)

    2. Case (% matches pattern _ :: _)

      1. (Let typedExp_h :: (typedExp_t)*{typedExp_t <- typedExp_t*} be (typedExp)*{typedExp <- typedExp*})

      2. (Eval_exp: C |- typedExp_h : expRes)

      3. Case analysis on expRes (total)

        1. Case (% has type failure, let failure = %)

          1. Result in: % |- % : (failure as expsRes)

        2. Case (% has type ok<val>, let (OK val_h) = %)

          1. (Eval_exps: C |- (typedExp_t)*{typedExp_t <- typedExp_t*} : expsRes)

          2. Case analysis on expsRes (total)

            1. Case (% has type failure, let failure = %)

              1. Result in: % |- % : (failure as expsRes)

            2. Case (% has type ok<val*>, let (OK (val_t)*{val_t <- val_t*}) = %)

              1. Result in: % |- % : ((OK val_h :: (val_t)*{val_t <- val_t*}) as expsRes)

syntax expOptRes =
   | OK val? (from ok<val?>)
   | ERROR (from error)
   | UNMATCH (from unmatch)

relation Eval_exp_maybe: (C')?{C' <- C'?} |- typedExp : %

1. Group : (C')?{C' <- C'?} |- typedExp : %

  1. Case analysis on (C')?{C' <- C'?} (total)

    1. Case (% matches pattern ())

      1. Result in: % |- % : ((OK ?()) as expOptRes)

    2. Case (% matches pattern (_))

      1. (Let ?(C) be (C')?{C' <- C'?})

      2. (Eval_exp: C |- typedExp : expRes)

      3. Case analysis on expRes (total)

        1. Case (% has type failure, let failure = %)

          1. Result in: % |- % : (failure as expOptRes)

        2. Case (% has type ok<val>, let (OK val) = %)

          1. Result in: % |- % : ((OK ?(val)) as expOptRes)

relation Eval_exp_each: (C)*{C <- C*} |- typedExp : %

1. Group : (C)*{C <- C*} |- typedExp : %

  1. Case analysis on (C)*{C <- C*} (total)

    1. Case (% matches pattern [])

      1. Result in: % |- % : ((OK []) as expsRes)

    2. Case (% matches pattern _ :: _)

      1. (Let C_h :: (C_t)*{C_t <- C_t*} be (C)*{C <- C*})

      2. (Eval_exp: C_h |- typedExp : expRes)

      3. Case analysis on expRes (total)

        1. Case (% has type failure, let failure = %)

          1. Result in: % |- % : (failure as expsRes)

        2. Case (% has type ok<val>, let (OK val_h) = %)

          1. (Eval_exp_each: (C_t)*{C_t <- C_t*} |- typedExp : expsRes)

          2. Case analysis on expsRes (total)

            1. Case (% has type failure, let failure = %)

              1. Result in: % |- % : (failure as expsRes)

            2. Case (% has type ok<val*>, let (OK (val_t)*{val_t <- val_t*}) = %)

              1. Result in: % |- % : ((OK val_h :: (val_t)*{val_t <- val_t*}) as expsRes)

syntax pathRes =
   | OK val (from ok<val>)
   | ERROR (from error)
   | UNMATCH (from unmatch)

relation Eval_path_acc: C |- val_b typedPath' : %

1. (Let (path '#' typ) be typedPath')

2. Case analysis on path (total)

  1. Case (% matches pattern ROOT)

    1. Group root: C |- val_b ((ROOT) '#' typ) : %

      1. Result in: % |- % % : ((OK val_b) as pathRes)

  2. Case (% matches pattern DOT % %, let (DOT typedPath atom) = %)

    1. Group dot: C |- val_b ((DOT typedPath atom) '#' typ) : %

      1. (Eval_path_acc: C |- val_b typedPath : pathRes)

      2. Case analysis on pathRes (total)

        1. Case (% has type failure, let failure = %)

          1. Result in: % |- % % : (failure as pathRes)

        2. Case (% has type ok<val>, let (OK val') = %)

          1. If let (STR (valField)*{valField <- valField*}) be val' matching pattern STR %, then

            1. (Let (atom_field val_field) be valField)*{valField <- valField*, atom_field -> atom_field*, val_field -> val_field*}

            2. (Let (val'')?{val'' <- val''?} be $assoc_<atom, val>(atom, ((atom_field, val_field))*{atom_field <- atom_field*, val_field <- val_field*}))

            3. If (((val'')?{val'' <- val''?} matches pattern (_))), then

              1. (Let ?(val) be (val'')?{val'' <- val''?})

              2. Result in: % |- % % : ((OK val) as pathRes)

  3. Case (% matches pattern IDX % %, let (IDX typedPath typedExp_i) = %)

    1. Group idx: C |- val_b ((IDX typedPath typedExp_i) '#' typ) : %

      1. (Eval_path_acc: C |- val_b typedPath : pathRes)

      2. Case analysis on pathRes (total)

        1. Case (% has type failure, let failure = %)

          1. Result in: % |- % % : (failure as pathRes)

        2. Case (% has type ok<val>, let (OK val') = %)

          1. Case analysis on val'

            1. Case (% matches pattern LIST %, let (LIST (val)*{val <- val*}) = %)

              1. (Eval_exp: C |- typedExp_i : expRes)

              2. Case analysis on expRes (total)

                1. Case (% has type failure, let failure = %)

                  1. Result in: % |- % % : (failure as pathRes)

                2. Case (% has type ok<val>, let (OK val'') = %)

                  1. If let num of type num be val'', then

                    1. If let (NAT n) be num matching pattern NAT %, then

                      1. If ((n < |(val)*{val <- val*}|)), then

                        1. (Let val_idx be (val)*{val <- val*}[n])

                        2. Result in: % |- % % : ((OK val_idx) as pathRes)

            2. Case (% matches pattern TEXT %, let (TEXT t) = %)

              1. (Eval_exp: C |- typedExp_i : expRes)

              2. Case analysis on expRes (total)

                1. Case (% has type failure, let failure = %)

                  1. Result in: % |- % % : (failure as pathRes)

                2. Case (% has type ok<val>, let (OK val) = %)

                  1. If let num of type num be val, then

                    1. If let (NAT n) be num matching pattern NAT %, then

                      1. If ((n < |t|)), then

                        1. (Let t_idx be t[n])

                        2. Result in: % |- % % : ((OK (TEXT t_idx)) as pathRes)

  4. Case (% matches pattern SLICE % % %, let (SLICE typedPath typedExp_i typedExp_n) = %)

    1. Group slice: C |- val_b ((SLICE typedPath typedExp_i typedExp_n) '#' typ) : %

      1. (Eval_path_acc: C |- val_b typedPath : pathRes)

      2. Case analysis on pathRes (total)

        1. Case (% has type failure, let failure = %)

          1. Result in: % |- % % : (failure as pathRes)

        2. Case (% has type ok<val>, let (OK val') = %)

          1. Case analysis on val'

            1. Case (% matches pattern TEXT %, let (TEXT t) = %)

              1. (Eval_exp: C |- typedExp_i : expRes)

              2. Case analysis on expRes (total)

                1. Case (% has type failure, let failure = %)

                  1. Result in: % |- % % : (failure as pathRes)

                2. Case (% has type ok<val>, let (OK val) = %)

                  1. If let num of type num be val, then

                    1. If let (NAT n_i) be num matching pattern NAT %, then

                      1. (Eval_exp: C |- typedExp_n : expRes')

                      2. Case analysis on expRes' (total)

                        1. Case (% has type failure, let failure = %)

                          1. Result in: % |- % % : (failure as pathRes)

                        2. Case (% has type ok<val>, let (OK val'') = %)

                          1. If let num' of type num be val'', then

                            1. If let (NAT n_n) be num' matching pattern NAT %, then

                              1. If (((n_i + n_n) <= |t|)), then

                                1. (Let val_slice be (TEXT t[n_i : n_n]))

                                2. Result in: % |- % % : ((OK val_slice) as pathRes)

            2. Case (% matches pattern LIST %, let (LIST (val)*{val <- val*}) = %)

              1. (Eval_exp: C |- typedExp_i : expRes)

              2. Case analysis on expRes (total)

                1. Case (% has type failure, let failure = %)

                  1. Result in: % |- % % : (failure as pathRes)

                2. Case (% has type ok<val>, let (OK val'') = %)

                  1. If let num of type num be val'', then

                    1. If let (NAT n_i) be num matching pattern NAT %, then

                      1. (Eval_exp: C |- typedExp_n : expRes')

                      2. Case analysis on expRes' (total)

                        1. Case (% has type failure, let failure = %)

                          1. Result in: % |- % % : (failure as pathRes)

                        2. Case (% has type ok<val>, let (OK val''') = %)

                          1. If let num' of type num be val''', then

                            1. If let (NAT n_n) be num' matching pattern NAT %, then

                              1. If (((n_i + n_n) <= |(val)*{val <- val*}|)), then

                                1. (Let val_slice be (LIST (val)*{val <- val*}[n_i : n_n]))

                                2. Result in: % |- % % : ((OK val_slice) as pathRes)

3. Otherwise,

  1. Group error: C |- val_b typedPath' : %

    1. Result in: % |- % % : ((ERROR) as pathRes)

relation Eval_path_upd: C |- val_b typedPath' := val_n' : %

1. (Let (path '#' typ) be typedPath')

2. Case analysis on path (total)

  1. Case (% matches pattern ROOT)

    1. Group root: C |- val_b ((ROOT) '#' typ) := val_n' : %

      1. Result in: % |- % % := % : ((OK val_n') as pathRes)

  2. Case (% matches pattern IDX % %, let (IDX typedPath typedExp_i) = %)

    1. Group idx: C |- val_b ((IDX typedPath typedExp_i) '#' typ) := val_n' : %

      1. Block (2 arms)

      Arm 1:

        1. (Eval_path_acc: C |- val_b typedPath : pathRes')

        2. Case analysis on pathRes' (total)

          1. Case (% has type failure, let failure = %)

            1. Result in: % |- % % := % : (failure as pathRes)

          2. Case (% has type ok<val>, let (OK val') = %)

            1. Case analysis on val'

              1. Case (% matches pattern LIST %, let (LIST (val)*{val <- val*}) = %)

                1. (Eval_exp: C |- typedExp_i : expRes)

                2. Case analysis on expRes (total)

                  1. Case (% has type failure, let failure = %)

                    1. Result in: % |- % % := % : (failure as pathRes)

                  2. Case (% has type ok<val>, let (OK val'') = %)

                    1. If let num of type num be val'', then

                      1. If let (NAT n_target) be num matching pattern NAT %, then

                        1. If ((n_target < |(val)*{val <- val*}|)), then

                          1. (Let val_upd be (LIST (val)*{val <- val*}[[n_target] = val_n']))

                          2. (Eval_path_upd: C |- val_b typedPath := val_upd : pathRes)

                          3. Result in: % |- % % := % : pathRes

              2. Case (% matches pattern TEXT %)

                1. (Eval_exp: C |- typedExp_i : expRes)

                2. If let failure of type failure be expRes, then

                  1. Result in: % |- % % := % : (failure as pathRes)

      Arm 2:

        1. If let (TEXT t_n) be val_n' matching pattern TEXT %, then

          1. (Eval_path_acc: C |- val_b typedPath : pathRes')

          2. If let (OK val) of type ok<val> be pathRes', then

            1. If let (TEXT t) be val matching pattern TEXT %, then

              1. (Eval_exp: C |- typedExp_i : expRes)

              2. If let (OK val') of type ok<val> be expRes, then

                1. If let num of type num be val', then

                  1. If let (NAT n_target) be num matching pattern NAT %, then

                    1. If ((n_target < |t|)), then

                      1. If ((|t_n| = 1)), then

                        1. (Let val_upd be (TEXT t[[n_target] = t_n]))

                        2. (Eval_path_upd: C |- val_b typedPath := val_upd : pathRes)

                        3. Result in: % |- % % := % : pathRes

  3. Case (% matches pattern SLICE % % %, let (SLICE typedPath typedExp_i typedExp_n) = %)

    1. Group slice: C |- val_b ((SLICE typedPath typedExp_i typedExp_n) '#' typ) := val_n' : %

      1. Block (4 arms)

      Arm 1:

        1. (Eval_path_acc: C |- val_b typedPath : pathRes)

        2. Case analysis on pathRes (total)

          1. Case (% has type failure, let failure = %)

            1. Result in: % |- % % := % : (failure as pathRes)

          2. Case (% has type ok<val>, let (OK val) = %)

            1. If ((val matches pattern TEXT %)), then

              1. (Eval_exp: C |- typedExp_i : expRes)

              2. Case analysis on expRes (total)

                1. Case (% has type failure, let failure = %)

                  1. Result in: % |- % % := % : (failure as pathRes)

                2. Case (% has type ok<val>, let (OK val') = %)

                  1. If let num of type num be val', then

                    1. If ((num matches pattern NAT %)), then

                      1. (Eval_exp: C |- typedExp_n : expRes')

                      2. If let failure of type failure be expRes', then

                        1. Result in: % |- % % := % : (failure as pathRes)

      Arm 2:

        1. If let (TEXT t_n) be val_n' matching pattern TEXT %, then

          1. (Eval_path_acc: C |- val_b typedPath : pathRes')

          2. If let (OK val) of type ok<val> be pathRes', then

            1. If let (TEXT t) be val matching pattern TEXT %, then

              1. (Eval_exp: C |- typedExp_i : expRes)

              2. If let (OK val') of type ok<val> be expRes, then

                1. If let num of type num be val', then

                  1. If let (NAT n_i) be num matching pattern NAT %, then

                    1. (Eval_exp: C |- typedExp_n : expRes')

                    2. If let (OK val'') of type ok<val> be expRes', then

                      1. If let num' of type num be val'', then

                        1. If let (NAT n_n) be num' matching pattern NAT %, then

                          1. If (((n_i + n_n) <= |t|)), then

                            1. If ((|t_n| = n_n)), then

                              1. (Let val_upd be (TEXT t[[n_i : n_n] = t_n]))

                              2. (Eval_path_upd: C |- val_b typedPath := val_upd : pathRes)

                              3. Result in: % |- % % := % : pathRes

      Arm 3:

        1. (Eval_path_acc: C |- val_b typedPath : pathRes)

        2. If let (OK val) of type ok<val> be pathRes, then

          1. If ((val matches pattern LIST %)), then

            1. (Eval_exp: C |- typedExp_i : expRes)

            2. Case analysis on expRes (total)

              1. Case (% has type failure, let failure = %)

                1. Result in: % |- % % := % : (failure as pathRes)

              2. Case (% has type ok<val>, let (OK val') = %)

                1. If let num of type num be val', then

                  1. If ((num matches pattern NAT %)), then

                    1. (Eval_exp: C |- typedExp_n : expRes')

                    2. If let failure of type failure be expRes', then

                      1. Result in: % |- % % := % : (failure as pathRes)

      Arm 4:

        1. If let (LIST (val_n)*{val_n <- val_n*}) be val_n' matching pattern LIST %, then

          1. (Eval_path_acc: C |- val_b typedPath : pathRes')

          2. If let (OK val') of type ok<val> be pathRes', then

            1. If let (LIST (val)*{val <- val*}) be val' matching pattern LIST %, then

              1. (Eval_exp: C |- typedExp_i : expRes)

              2. If let (OK val'') of type ok<val> be expRes, then

                1. If let num of type num be val'', then

                  1. If let (NAT n_i) be num matching pattern NAT %, then

                    1. (Eval_exp: C |- typedExp_n : expRes')

                    2. If let (OK val''') of type ok<val> be expRes', then

                      1. If let num' of type num be val''', then

                        1. If let (NAT n_n) be num' matching pattern NAT %, then

                          1. If (((n_i + n_n) <= |(val)*{val <- val*}|)), then

                            1. If ((|(val_n)*{val_n <- val_n*}| = n_n)), then

                              1. (Let val_upd be (LIST (val)*{val <- val*}[[n_i : n_n] = (val_n)*{val_n <- val_n*}]))

                              2. (Eval_path_upd: C |- val_b typedPath := val_upd : pathRes)

                              3. Result in: % |- % % := % : pathRes

  4. Case (% matches pattern DOT % %, let (DOT typedPath atom) = %)

    1. Group dot: C |- val_b ((DOT typedPath atom) '#' typ) := val_n' : %

      1. (Eval_path_acc: C |- val_b typedPath : pathRes')

      2. Case analysis on pathRes' (total)

        1. Case (% has type failure, let failure = %)

          1. Result in: % |- % % := % : (failure as pathRes)

        2. Case (% has type ok<val>, let (OK val) = %)

          1. If let (STR (valField)*{valField <- valField*}) be val matching pattern STR %, then

            1. (Let (atom_field val_field) be valField)*{valField <- valField*, atom_field -> atom_field*, val_field -> val_field*}

            2. (Let val'''' be $ite<val>((atom = atom_field), val_n', val_field))*{atom_field <- atom_field*, val_field <- val_field*, val'''' -> val''''*}

            3. (Let valField_new be (atom_field val''''))*{val'''' <- val''''*, atom_field <- atom_field*, valField_new -> valField_new*}

            4. (Let val_upd be (STR (valField_new)*{valField_new <- valField_new*}))

            5. (Eval_path_upd: C |- val_b typedPath := val_upd : pathRes)

            6. Result in: % |- % % := % : pathRes

3. Otherwise,

  1. Group error: C |- val_b typedPath' := val_n' : %

    1. Result in: % |- % % := % : ((ERROR) as pathRes)

relation Eval_targs: C |- (targ)*{targ <- targ*} : %

1. Group : C |- (targ)*{targ <- targ*} : %

  1. (Let theta be $theta_of_tdenv(C.LOCAL.TYP))

  2. (Let typsRes be $subst_typs(theta, (targ)*{targ <- targ*}))

  3. Result in: % |- % : typsRes

2. Otherwise,

  1. Group error: C |- (targ)*{targ <- targ*} : %

    1. Result in: % |- % : ((ERROR) as typsRes)

syntax argRes =
   | OK val (from ok<val>)
   | ERROR (from error)
   | UNMATCH (from unmatch)

relation Eval_arg: C |- arg : %

1. Case analysis on arg (total)

  1. Case (% matches pattern EXP %, let (EXP typedExp) = %)

    1. Group exp: C |- (EXP typedExp) : %

      1. (Eval_exp: C |- typedExp : expRes)

      2. If let argRes of type argRes be expRes, then

        1. Result in: % |- % : argRes

  2. Case (% matches pattern FUN %, let (FUN id) = %)

    1. Group fun: C |- (FUN id) : %

      1. (Let id_global be $resolve_func_param(C, id))

      2. Result in: % |- % : ((OK (FUNC id_global)) as argRes)

2. Otherwise,

  1. Group error: C |- arg : %

    1. Result in: % |- % : ((ERROR) as argRes)

syntax argsRes =
   | OK val* (from ok<val*>)
   | ERROR (from error)
   | UNMATCH (from unmatch)

relation Eval_args: C |- (arg)*{arg <- arg*} : %

1. Group : C |- (arg)*{arg <- arg*} : %

  1. Case analysis on (arg)*{arg <- arg*} (total)

    1. Case (% matches pattern [])

      1. Result in: % |- % : ((OK []) as argsRes)

    2. Case (% matches pattern _ :: _)

      1. (Let arg_h :: (arg_t)*{arg_t <- arg_t*} be (arg)*{arg <- arg*})

      2. (Eval_arg: C |- arg_h : argRes)

      3. Case analysis on argRes (total)

        1. Case (% has type failure, let failure = %)

          1. Result in: % |- % : (failure as argsRes)

        2. Case (% has type ok<val>, let (OK val_h) = %)

          1. (Eval_args: C |- (arg_t)*{arg_t <- arg_t*} : argsRes)

          2. Case analysis on argsRes (total)

            1. Case (% has type failure, let failure = %)

              1. Result in: % |- % : (failure as argsRes)

            2. Case (% has type ok<val*>, let (OK (val_t)*{val_t <- val_t*}) = %)

              1. Result in: % |- % : ((OK val_h :: (val_t)*{val_t <- val_t*}) as argsRes)

syntax premRes =
   | OK ctx (from ok<ctx>)
   | ERROR (from error)
   | UNMATCH (from unmatch)

relation Eval_prem: C |- premAL' : %

1. Case analysis on premAL' (total)

  1. Case (% has type relPremAL, let (REL id ':' (typedExp)*{typedExp <- typedExp*} '->' (typedExp_out)*{typedExp_out <- typedExp_out*}) = %)

    1. Group relpr: C |- ((REL id ':' (typedExp)*{typedExp <- typedExp*} '->' (typedExp_out)*{typedExp_out <- typedExp_out*}) as premAL) : %

      1. (Eval_exps: C |- (typedExp)*{typedExp <- typedExp*} : expsRes)

      2. Case analysis on expsRes (total)

        1. Case (% has type failure, let failure = %)

          1. Result in: % |- % : (failure as premRes)

        2. Case (% has type ok<val*>, let (OK (val)*{val <- val*}) = %)

          1. (Call_rel: C |- id `( (val)*{val <- val*} `) : relRes)

          2. Case analysis on relRes (total)

            1. Case (% has type failure, let failure = %)

              1. Result in: % |- % : (failure as premRes)

            2. Case (% has type ok<val*>, let (OK (val_out)*{val_out <- val_out*}) = %)

              1. (Assign_exps: C |- (typedExp_out)*{typedExp_out <- typedExp_out*} := (val_out)*{val_out <- val_out*} : assignRes)

              2. If let (OK C') of type ok<ctx> be assignRes, then

                1. Result in: % |- % : ((OK C') as premRes)

  2. Case (% has type ifPrem, let (IF typedExp) = %)

    1. Group ifpr: C |- ((IF typedExp) as premAL) : %

      1. (Eval_exp: C |- typedExp : expRes)

      2. Block (2 arms)

      Arm 1:

        1. If let failure of type failure be expRes, then

          1. Result in: % |- % : (failure as premRes)

      Arm 2:

        1. Case analysis on expRes

          1. Case (% = ((OK (BOOL false)) as expRes))

            1. Result in: % |- % : ((UNMATCH) as premRes)

          2. Case (% = ((OK (BOOL true)) as expRes))

            1. Result in: % |- % : ((OK C) as premRes)

  3. Case (% has type ifHoldPrem, let (IFHOLD id ':' (typedExp)*{typedExp <- typedExp*}) = %)

    1. Group ifholdpr: C |- ((IFHOLD id ':' (typedExp)*{typedExp <- typedExp*}) as premAL) : %

      1. (Eval_exps: C |- (typedExp)*{typedExp <- typedExp*} : expsRes)

      2. Case analysis on expsRes (total)

        1. Case (% has type failure, let failure = %)

          1. Result in: % |- % : (failure as premRes)

        2. Case (% has type ok<val*>, let (OK (val_input)*{val_input <- val_input*}) = %)

          1. (Call_rel: C |- id `( (val_input)*{val_input <- val_input*} `) : relRes)

          2. Block (2 arms)

          Arm 1:

            1. If let failure of type failure be relRes, then

              1. Result in: % |- % : (failure as premRes)

          Arm 2:

            1. If ((relRes = ((OK []) as relRes))), then

              1. Result in: % |- % : ((OK C) as premRes)

  4. Case (% has type ifNotHoldPrem, let (IFNOTHOLD id ':' (typedExp)*{typedExp <- typedExp*}) = %)

    1. Group ifnotholdpr: C |- ((IFNOTHOLD id ':' (typedExp)*{typedExp <- typedExp*}) as premAL) : %

      1. (Eval_exps: C |- (typedExp)*{typedExp <- typedExp*} : expsRes)

      2. Case analysis on expsRes (total)

        1. Case (% has type failure, let failure = %)

          1. Result in: % |- % : (failure as premRes)

        2. Case (% has type ok<val*>, let (OK (val_input)*{val_input <- val_input*}) = %)

          1. (Call_rel: C |- id `( (val_input)*{val_input <- val_input*} `) : relRes)

          2. Case analysis on relRes (total)

            1. Case (% has type error, let error = %)

              1. Result in: % |- % : ((ERROR) as premRes)

            2. Case (% has type ok<val*>)

              1. Result in: % |- % : ((UNMATCH) as premRes)

            3. Case (% has type unmatch, let unmatch = %)

              1. Result in: % |- % : ((OK C) as premRes)

  5. Case (% has type letPremAL, let (LET typedExp_l '=' typedExp_r) = %)

    1. Group letpr: C |- ((LET typedExp_l '=' typedExp_r) as premAL) : %

      1. (Eval_exp: C |- typedExp_r : expRes)

      2. Case analysis on expRes (total)

        1. Case (% has type failure, let failure = %)

          1. Result in: % |- % : (failure as premRes)

        2. Case (% has type ok<val>, let (OK val_r) = %)

          1. (Assign_exp: C |- typedExp_l := val_r : assignRes)

          2. If let (OK C') of type ok<ctx> be assignRes, then

            1. Result in: % |- % : ((OK C') as premRes)

  6. Case (% has type iterPremAL, let (ITER premAL premIterAL) = %)

    1. Block (2 arms)

    Arm 1:

      1. Group iterpr-opt: C |- ((ITER premAL premIterAL) as premAL) : %

        1. (Let (iter '<-' (vari_bound)*{vari_bound <- vari_bound*} '->' (_vari)*{_vari <- _vari*}) be premIterAL)

        2. If ((iter matches pattern QUEST)), then

          1. (Let subOptRes be $sub_opt(C, (vari_bound)*{vari_bound <- vari_bound*}))

          2. If let (OK (C_sub)?{C_sub <- C_sub?}) of type ok<ctx?> be subOptRes, then

            1. (Eval_prem_maybe: (C_sub)?{C_sub <- C_sub?} |- premAL : premOptRes)

            2. Block (2 arms)

            Arm 1:

              1. Case analysis on premOptRes (total)

                1. Case (% has type failure, let failure = %)

                  1. Result in: % |- % : (failure as premRes)

                2. Case (% has type ok<ctx?>, let (OK (C')?{C' <- C'?}) = %)

                  1. If (((C')?{C' <- C'?} matches pattern (_))), then

                    1. (Let ?(C_sub_res) be (C')?{C' <- C'?})

                    2. (Let (val)?{val <- val?} be $find_vari(C_sub_res, _vari))*{_vari <- _vari*, val? -> val?*}

                    3. If (((val)?{val <- val?} matches pattern (_)))*{val? <- val?*}, then

                      1. (Let ?(val_bind) be (val)?{val <- val?})*{val? <- val?*, val_bind -> val_bind*}

                      2. (Let vari_bind_iter be $iterate_vari(_vari, [(QUEST)]))*{_vari <- _vari*, vari_bind_iter -> vari_bind_iter*}

                      3. (Let C_res be $add_varis(C, (vari_bind_iter)*{vari_bind_iter <- vari_bind_iter*}, ((OPT ?(val_bind)))*{val_bind <- val_bind*}))

                      4. Result in: % |- % : ((OK C_res) as premRes)

            Arm 2:

              1. If ((premOptRes = ((OK ?()) as premOptRes))), then

                1. (Let vari_bind_iter be $iterate_vari(_vari, [(QUEST)]))*{_vari <- _vari*, vari_bind_iter -> vari_bind_iter*}

                2. (Let (val_bind)*{val_bind <- val_bind*} be $repeat_<val>((OPT ?()), |(_vari)*{_vari <- _vari*}|))

                3. (Let C_res be $add_varis(C, (vari_bind_iter)*{vari_bind_iter <- vari_bind_iter*}, (val_bind)*{val_bind <- val_bind*}))

                4. Result in: % |- % : ((OK C_res) as premRes)

    Arm 2:

      1. Group iterpr-list: C |- ((ITER premAL premIterAL) as premAL) : %

        1. (Let (iter '<-' (vari_bound)*{vari_bound <- vari_bound*} '->' (vari_bind)*{vari_bind <- vari_bind*}) be premIterAL)

        2. If ((iter matches pattern STAR)), then

          1. Block (2 arms)

          Arm 1:

            1. If ((((OK []) as subListRes) = $sub_list(C, (vari_bound)*{vari_bound <- vari_bound*}))), then

              1. (Let vari_bind_iter be $iterate_vari(vari_bind, [(STAR)]))*{vari_bind <- vari_bind*, vari_bind_iter -> vari_bind_iter*}

              2. (Let (val_bind)*{val_bind <- val_bind*} be $repeat_<val>((LIST []), |(vari_bind)*{vari_bind <- vari_bind*}|))

              3. (Let C_res be $add_varis(C, (vari_bind_iter)*{vari_bind_iter <- vari_bind_iter*}, (val_bind)*{val_bind <- val_bind*}))

              4. Result in: % |- % : ((OK C_res) as premRes)

          Arm 2:

            1. (Let subListRes be $sub_list(C, (vari_bound)*{vari_bound <- vari_bound*}))

            2. If let (OK (C_sub)*{C_sub <- C_sub*}) of type ok<ctx*> be subListRes, then

              1. If (((C_sub)*{C_sub <- C_sub*} matches pattern _ :: _)), then

                1. (Eval_prem_each: (C_sub)*{C_sub <- C_sub*} |- premAL : premIterRes)

                2. Case analysis on premIterRes (total)

                  1. Case (% has type failure, let failure = %)

                    1. Result in: % |- % : (failure as premRes)

                  2. Case (% has type ok<ctx*>, let (OK (C_sub_res)*{C_sub_res <- C_sub_res*}) = %)

                    1. (Let ((val)*{val <- val*})?{val* <- val*?} be $find_varis(C_sub_res, (vari_bind)*{vari_bind <- vari_bind*}))*{C_sub_res <- C_sub_res*, val*? -> val*?*}

                    2. If ((((val)*{val <- val*})?{val* <- val*?} matches pattern (_)))*{val*? <- val*?*}, then

                      1. (Let ?((val_sub_bind)*{val_sub_bind <- val_sub_bind*}) be ((val)*{val <- val*})?{val* <- val*?})*{val*? <- val*?*, val_sub_bind* -> val_sub_bind**}

                      2. (Let ((val_bind)*{val_bind <- val_bind*})*{val_bind* <- val_bind**} be $transpose_<val>(((val_sub_bind)*{val_sub_bind <- val_sub_bind*})*{val_sub_bind* <- val_sub_bind**}))

                      3. (Let val_res_bind be (LIST (val_bind)*{val_bind <- val_bind*}))*{val_bind* <- val_bind**, val_res_bind -> val_res_bind*}

                      4. (Let vari_bind_iter be $iterate_vari(vari_bind, [(STAR)]))*{vari_bind <- vari_bind*, vari_bind_iter -> vari_bind_iter*}

                      5. (Let C_res be $add_varis(C, (vari_bind_iter)*{vari_bind_iter <- vari_bind_iter*}, (val_res_bind)*{val_res_bind <- val_res_bind*}))

                      6. Result in: % |- % : ((OK C_res) as premRes)

  7. Case (% has type debugPrem, let (DEBUG typedExp) = %)

    1. Group dbg: C |- ((DEBUG typedExp) as premAL) : %

      1. (Eval_exp: C |- typedExp : expRes)

      2. Case analysis on expRes (total)

        1. Case (% has type failure, let failure = %)

          1. Result in: % |- % : (failure as premRes)

        2. Case (% has type ok<val>, let (OK val) = %)

          1. Debug: val

          2. Result in: % |- % : ((OK C) as premRes)

2. Otherwise,

  1. Group error: C |- premAL' : %

    1. Result in: % |- % : ((ERROR) as premRes)

relation Eval_prems: C |- (premAL)*{premAL <- premAL*} : %

1. Group : C |- (premAL)*{premAL <- premAL*} : %

  1. Case analysis on (premAL)*{premAL <- premAL*} (total)

    1. Case (% matches pattern [])

      1. Result in: % |- % : ((OK C) as premRes)

    2. Case (% matches pattern _ :: _)

      1. (Let premAL_h :: (premAL_t)*{premAL_t <- premAL_t*} be (premAL)*{premAL <- premAL*})

      2. (Eval_prem: C |- premAL_h : premRes')

      3. Case analysis on premRes' (total)

        1. Case (% has type failure, let failure = %)

          1. Result in: % |- % : (failure as premRes)

        2. Case (% has type ok<ctx>, let (OK C') = %)

          1. (Eval_prems: C' |- (premAL_t)*{premAL_t <- premAL_t*} : premRes)

          2. Result in: % |- % : premRes

syntax premOptRes =
   | OK ctx? (from ok<ctx?>)
   | ERROR (from error)
   | UNMATCH (from unmatch)

relation Eval_prem_maybe: (C')?{C' <- C'?} |- premAL : %

1. Group : (C')?{C' <- C'?} |- premAL : %

  1. Case analysis on (C')?{C' <- C'?} (total)

    1. Case (% matches pattern ())

      1. Result in: % |- % : ((OK ?()) as premOptRes)

    2. Case (% matches pattern (_))

      1. (Let ?(C) be (C')?{C' <- C'?})

      2. (Eval_prem: C |- premAL : premRes)

      3. Case analysis on premRes (total)

        1. Case (% has type failure, let failure = %)

          1. Result in: % |- % : (failure as premOptRes)

        2. Case (% has type ok<ctx>, let (OK C_res) = %)

          1. Result in: % |- % : ((OK ?(C_res)) as premOptRes)

syntax premIterRes =
   | OK ctx* (from ok<ctx*>)
   | ERROR (from error)
   | UNMATCH (from unmatch)

relation Eval_prem_each: (C)*{C <- C*} |- premAL : %

1. Group : (C)*{C <- C*} |- premAL : %

  1. Case analysis on (C)*{C <- C*} (total)

    1. Case (% matches pattern [])

      1. Result in: % |- % : ((OK []) as premIterRes)

    2. Case (% matches pattern _ :: _)

      1. (Let C_h :: (C_t)*{C_t <- C_t*} be (C)*{C <- C*})

      2. (Eval_prem: C_h |- premAL : premRes)

      3. Case analysis on premRes (total)

        1. Case (% has type failure, let failure = %)

          1. Result in: % |- % : (failure as premIterRes)

        2. Case (% has type ok<ctx>, let (OK C_res) = %)

          1. (Eval_prem_each: (C_t)*{C_t <- C_t*} |- premAL : premIterRes)

          2. Case analysis on premIterRes (total)

            1. Case (% has type failure, let failure = %)

              1. Result in: % |- % : (failure as premIterRes)

            2. Case (% has type ok<ctx*>, let (OK (C_t_res)*{C_t_res <- C_t_res*}) = %)

              1. Result in: % |- % : ((OK C_res :: (C_t_res)*{C_t_res <- C_t_res*}) as premIterRes)

relation Call_func: C |- id `< (typ)*{typ <- typ*} `> `( (val)*{val <- val*} `) : %

1. Group : C |- id `< (typ)*{typ <- typ*} `> `( (val)*{val <- val*} `) : %

  1. Block (3 arms)

  Arm 1:

    1. (Let id_global be $resolve_func_param(C, id))

    2. (Let (funcDefnAL')?{funcDefnAL' <- funcDefnAL'?} be $find_func(C, id_global))

    3. If (((funcDefnAL')?{funcDefnAL' <- funcDefnAL'?} matches pattern (_))), then

      1. (Let ?(funcDefnAL) be (funcDefnAL')?{funcDefnAL' <- funcDefnAL'?})

      2. Case analysis on funcDefnAL

        1. Case (% has type externFuncDefn, let (EXTFUNC id_func (_tparam)*{_tparam <- _tparam*} (_param)*{_param <- _param*} ':' _typ) = %)

          1. (Call_extern_func: |- id_func `< (typ)*{typ <- typ*} `> `( (val)*{val <- val*} `) : funcRes)

          2. Result in: % |- % `< % `> `( % `) : funcRes

        2. Case (% has type builtinFuncDefn, let (BUILTINFUNC id_func (_tparam)*{_tparam <- _tparam*} (_param)*{_param <- _param*} ':' _typ) = %)

          1. (Call_builtin_func: |- id_func `< (typ)*{typ <- typ*} `> `( (val)*{val <- val*} `) : funcRes)

          2. Result in: % |- % `< % `> `( % `) : funcRes

  Arm 2:

    1. If (((typ)*{typ <- typ*} matches pattern [])), then

      1. (Let id_global be $resolve_func_param(C, id))

      2. (Let (funcDefnAL')?{funcDefnAL' <- funcDefnAL'?} be $find_func(C, id_global))

      3. If (((funcDefnAL')?{funcDefnAL' <- funcDefnAL'?} matches pattern (_))), then

        1. (Let ?(funcDefnAL) be (funcDefnAL')?{funcDefnAL' <- funcDefnAL'?})

        2. If let tableFuncDefnAL of type tableFuncDefnAL be funcDefnAL, then

          1. (Call_table_func: C |- tableFuncDefnAL `( (val)*{val <- val*} `) : funcRes)

          2. Result in: % |- % `< % `> `( % `) : funcRes

  Arm 3:

    1. (Let id_global be $resolve_func_param(C, id))

    2. (Let (funcDefnAL')?{funcDefnAL' <- funcDefnAL'?} be $find_func(C, id_global))

    3. If (((funcDefnAL')?{funcDefnAL' <- funcDefnAL'?} matches pattern (_))), then

      1. (Let ?(funcDefnAL) be (funcDefnAL')?{funcDefnAL' <- funcDefnAL'?})

      2. If let definedFuncDefnAL of type definedFuncDefnAL be funcDefnAL, then

        1. (Call_defined_func: C |- definedFuncDefnAL `< (typ)*{typ <- typ*} `> `( (val)*{val <- val*} `) : funcRes)

        2. Result in: % |- % `< % `> `( % `) : funcRes

2. Otherwise,

  1. Group error: C |- id `< (typ)*{typ <- typ*} `> `( (val)*{val <- val*} `) : %

    1. Result in: % |- % `< % `> `( % `) : ((ERROR) as funcRes)

relation Call_rel: C |- id `( (val)*{val <- val*} `) : %

1. Group : C |- id `( (val)*{val <- val*} `) : %

  1. (Let (relDefnAL')?{relDefnAL' <- relDefnAL'?} be $find_rel(C, id))

  2. If (((relDefnAL')?{relDefnAL' <- relDefnAL'?} matches pattern (_))), then

    1. (Let ?(relDefnAL) be (relDefnAL')?{relDefnAL' <- relDefnAL'?})

    2. Case analysis on relDefnAL (total)

      1. Case (% has type externRelDefnAL, let (EXTREL id_rel ':' (_typ)*{_typ <- _typ*} '->' (_typ')*{_typ' <- _typ'*}) = %)

        1. (Call_extern_rel: |- id_rel `( (val)*{val <- val*} `) : relRes)

        2. Result in: % |- % `( % `) : relRes

      2. Case (% has type definedRelDefnAL, let definedRelDefnAL = %)

        1. (Call_defined_rel: C |- definedRelDefnAL `( (val)*{val <- val*} `) : relRes)

        2. Result in: % |- % `( % `) : relRes

2. Otherwise,

  1. Group error: C |- id `( (val)*{val <- val*} `) : %

    1. Result in: % |- % `( % `) : ((ERROR) as relRes)

def $numUnop(numUnop, num)

1. Case analysis on numUnop (total)

  1. Case (% matches pattern PLUS)

    1. Case analysis on num (total)

      1. Case (% matches pattern NAT %, let (NAT n) = %)

        1. Return ((NAT n) as val)

      2. Case (% matches pattern INT %, let (INT i) = %)

        1. Return ((INT i) as val)

  2. Case (% matches pattern MINUS)

    1. Case analysis on num (total)

      1. Case (% matches pattern NAT %, let (NAT n) = %)

        1. Return ((INT (-n as int)) as val)

      2. Case (% matches pattern INT %, let (INT i) = %)

        1. Return ((INT -i) as val)

def $boolBinop(boolBinop, b_l, b_r)

1. Case analysis on boolBinop (total)

  1. Case (% matches pattern AND)

    1. Return (b_l /\ b_r)

  2. Case (% matches pattern OR)

    1. Return (b_l \/ b_r)

  3. Case (% matches pattern IMPL)

    1. Return (b_l => b_r)

  4. Case (% matches pattern EQUIV)

    1. Return (b_l <=> b_r)

syntax numBinopRes =
   | OK val (from ok<val>)
   | ERROR (from error)

def $numBinop(numBinop, num, num')

1. Case analysis on numBinop

  1. Case (% matches pattern ADD)

    1. Case analysis on num (total)

      1. Case (% matches pattern NAT %, let (NAT n_l) = %)

        1. If let (NAT n_r) be num' matching pattern NAT %, then

          1. Return ((OK ((NAT (n_l + n_r)) as val)) as numBinopRes)

      2. Case (% matches pattern INT %, let (INT i_l) = %)

        1. If let (INT i_r) be num' matching pattern INT %, then

          1. Return ((OK ((INT (i_l + i_r)) as val)) as numBinopRes)

  2. Case (% matches pattern SUB)

    1. Case analysis on num (total)

      1. Case (% matches pattern NAT %, let (NAT n_l) = %)

        1. If let (NAT n_r) be num' matching pattern NAT %, then

          1. Return ((OK ((INT (n_l - n_r)) as val)) as numBinopRes)

      2. Case (% matches pattern INT %, let (INT i_l) = %)

        1. If let (INT i_r) be num' matching pattern INT %, then

          1. Return ((OK ((INT (i_l - i_r)) as val)) as numBinopRes)

  3. Case (% matches pattern MUL)

    1. Case analysis on num (total)

      1. Case (% matches pattern NAT %, let (NAT n_l) = %)

        1. If let (NAT n_r) be num' matching pattern NAT %, then

          1. Return ((OK ((NAT (n_l * n_r)) as val)) as numBinopRes)

      2. Case (% matches pattern INT %, let (INT i_l) = %)

        1. If let (INT i_r) be num' matching pattern INT %, then

          1. Return ((OK ((INT (i_l * i_r)) as val)) as numBinopRes)

  4. Case (% matches pattern DIV)

    1. Case analysis on num (total)

      1. Case (% matches pattern NAT %, let (NAT n_l) = %)

        1. If let (NAT n_r) be num' matching pattern NAT %, then

          1. If ((n_r =/= 0)), then

            1. Return ((OK ((NAT (n_l / n_r)) as val)) as numBinopRes)

      2. Case (% matches pattern INT %, let (INT i_l) = %)

        1. If let (INT i_r) be num' matching pattern INT %, then

          1. If ((i_r =/= +0)), then

            1. Return ((OK ((INT (i_l / i_r)) as val)) as numBinopRes)

  5. Case (% matches pattern MOD)

    1. Case analysis on num (total)

      1. Case (% matches pattern NAT %, let (NAT n_l) = %)

        1. If let (NAT n_r) be num' matching pattern NAT %, then

          1. If ((n_r =/= 0)), then

            1. Return ((OK ((NAT (n_l \ n_r)) as val)) as numBinopRes)

      2. Case (% matches pattern INT %, let (INT i_l) = %)

        1. If let (INT i_r) be num' matching pattern INT %, then

          1. If ((i_r =/= +0)), then

            1. Return ((OK ((INT (i_l \ i_r)) as val)) as numBinopRes)

2. Otherwise,

  1. Return ((ERROR) as numBinopRes)

def $polyCmpop(polyCmpop, val_l, val_r)

1. Case analysis on polyCmpop (total)

  1. Case (% matches pattern EQ)

    1. Return (val_l = val_r)

  2. Case (% matches pattern NE)

    1. Return (val_l =/= val_r)

syntax numCmpRes =
   | OK bool (from ok<bool>)
   | ERROR (from error)

def $numCmpop(numCmpop, num, num')

1. Case analysis on numCmpop (total)

  1. Case (% matches pattern LT)

    1. Case analysis on num (total)

      1. Case (% matches pattern NAT %, let (NAT n_l) = %)

        1. If let (NAT n_r) be num' matching pattern NAT %, then

          1. Return ((OK (n_l < n_r)) as numCmpRes)

      2. Case (% matches pattern INT %, let (INT i_l) = %)

        1. If let (INT i_r) be num' matching pattern INT %, then

          1. Return ((OK (i_l < i_r)) as numCmpRes)

  2. Case (% matches pattern GT)

    1. Case analysis on num (total)

      1. Case (% matches pattern NAT %, let (NAT n_l) = %)

        1. If let (NAT n_r) be num' matching pattern NAT %, then

          1. Return ((OK (n_l > n_r)) as numCmpRes)

      2. Case (% matches pattern INT %, let (INT i_l) = %)

        1. If let (INT i_r) be num' matching pattern INT %, then

          1. Return ((OK (i_l > i_r)) as numCmpRes)

  3. Case (% matches pattern LE)

    1. Case analysis on num (total)

      1. Case (% matches pattern NAT %, let (NAT n_l) = %)

        1. If let (NAT n_r) be num' matching pattern NAT %, then

          1. Return ((OK (n_l <= n_r)) as numCmpRes)

      2. Case (% matches pattern INT %, let (INT i_l) = %)

        1. If let (INT i_r) be num' matching pattern INT %, then

          1. Return ((OK (i_l <= i_r)) as numCmpRes)

  4. Case (% matches pattern GE)

    1. Case analysis on num (total)

      1. Case (% matches pattern NAT %, let (NAT n_l) = %)

        1. If let (NAT n_r) be num' matching pattern NAT %, then

          1. Return ((OK (n_l >= n_r)) as numCmpRes)

      2. Case (% matches pattern INT %, let (INT i_l) = %)

        1. If let (INT i_r) be num' matching pattern INT %, then

          1. Return ((OK (i_l >= i_r)) as numCmpRes)

2. Otherwise,

  1. Return ((ERROR) as numCmpRes)

def $matches(val', pat)

1. Case analysis on val'

  1. Case (% matches pattern INJ %, let (INJ (mixop_v (val)*{val <- val*})) = %)

    1. If let (INJ mixop_p) be pat matching pattern INJ %, then

      1. Return (mixop_v = mixop_p)

  2. Case (% matches pattern LIST %, let (LIST (val)*{val <- val*}) = %)

    1. If let listPat of type listPat be pat, then

      1. Case analysis on listPat (total)

        1. Case (% matches pattern CONS)

          1. Return (|(val)*{val <- val*}| > 0)

        2. Case (% matches pattern FIXED %, let (FIXED n) = %)

          1. Return (|(val)*{val <- val*}| = n)

        3. Case (% matches pattern NIL)

          1. Return (|(val)*{val <- val*}| = 0)

  3. Case (% matches pattern OPT %, let (OPT (val)?{val <- val?}) = %)

    1. If let optPat of type optPat be pat, then

      1. Case analysis on optPat (total)

        1. Case (% matches pattern SOME)

          1. Return ((val)?{val <- val?} =/= ?())

        2. Case (% matches pattern NONE)

          1. Return ((val)?{val <- val?} = ?())

2. Otherwise,

  1. Return false

syntax subtypRes =
   | OK bool (from ok<bool>)
   | ERROR (from error)

def $subtyp(fenv, tdenv, typ', val'')

1. Block (2 arms)

Arm 1:

  1. Case analysis on typ' (total)

    1. Case (% has type optyp, let optyp = %)

      1. Case analysis on optyp

        1. Case (% matches pattern BOOL)

          1. If ((val'' matches pattern BOOL %)), then

            1. Return ((OK true) as subtypRes)

        2. Case (% matches pattern TEXT)

          1. If ((val'' matches pattern TEXT %)), then

            1. Return ((OK true) as subtypRes)

    2. Case (% matches pattern VAR % %, let (VAR id (targ)*{targ <- targ*}) = %)

      1. Return $subtyp_var(fenv, tdenv, id, (targ)*{targ <- targ*}, val'')

    3. Case (% matches pattern TUP %, let (TUP (typ)*{typ <- typ*}) = %)

      1. If let (TUP (val)*{val <- val*}) be val'' matching pattern TUP %, then

        1. Return $subtyps(fenv, tdenv, (typ)*{typ <- typ*}, (val)*{val <- val*})

    4. Case (% matches pattern ITER % %, let (ITER typ iter) = %)

      1. Case analysis on iter (total)

        1. Case (% matches pattern QUEST)

          1. Block (2 arms)

          Arm 1:

            1. If let (OPT (val')?{val' <- val'?}) be val'' matching pattern OPT %, then

              1. If (((val')?{val' <- val'?} matches pattern (_))), then

                1. (Let ?(val) be (val')?{val' <- val'?})

                2. Return $subtyp(fenv, tdenv, typ, val)

          Arm 2:

            1. If ((val'' = (OPT ?()))), then

              1. Return ((OK true) as subtypRes)

        2. Case (% matches pattern STAR)

          1. If let (LIST (val)*{val <- val*}) be val'' matching pattern LIST %, then

            1. Return $subtyp_list(fenv, tdenv, typ, (val)*{val <- val*})

    5. Case (% matches pattern FUNC % % %, let (FUNC (tparam)*{tparam <- tparam*} (typ)*{typ <- typ*} typ_ret) = %)

      1. If let (FUNC id) be val'' matching pattern FUNC %, then

        1. Return $subtyp_func(fenv, tdenv, (FUNC (tparam)*{tparam <- tparam*} (typ)*{typ <- typ*} typ_ret), id)

Arm 2:

  1. If let numtyp of type numtyp be typ', then

    1. Case analysis on numtyp (total)

      1. Case (% matches pattern NAT)

        1. If let num of type num be val'', then

          1. Case analysis on num (total)

            1. Case (% matches pattern NAT %)

              1. Return ((OK true) as subtypRes)

            2. Case (% matches pattern INT %, let (INT i) = %)

              1. Return ((OK (i >= (0 as int))) as subtypRes)

      2. Case (% matches pattern INT)

        1. If ((val'' has type num)), then

          1. Return ((OK true) as subtypRes)

2. Otherwise,

  1. Return ((OK false) as subtypRes)

def $subtyp_var(fenv, tdenv, id, (targ)*{targ <- targ*}, val)

1. (Let (typDef')?{typDef' <- typDef'?} be $find_map<id, typDef>(tdenv, id))

2. If (((typDef')?{typDef' <- typDef'?} matches pattern (_))), then

  1. (Let ?(typDef) be (typDef')?{typDef' <- typDef'?})

  2. Return $subtyp_def(fenv, tdenv, typDef, (targ)*{targ <- targ*}, val)

3. Otherwise,

  1. Return ((ERROR) as subtypRes)

def $subtyp_def(fenv, tdenv, typDef, (typ')*{typ' <- typ'*}, val)

1. Case analysis on typDef

  1. Case (% has type externTypDefn)

    1. If (((typ')*{typ' <- typ'*} matches pattern [])), then

      1. Return $subtyp_extern(val)

  2. Case (% has type definedTypDefn, let (TYP _id (tparam)*{tparam <- tparam*} '=' deftyp) = %)

    1. Case analysis on deftyp (total)

      1. Case (% matches pattern ALIAS %, let (ALIAS typ) = %)

        1. If ((|(typ')*{typ' <- typ'*}| = |(tparam)*{tparam <- tparam*}|)), then

          1. (Let theta be (`{ ((tparam ':' typ'))*{typ' <- typ'*, tparam <- tparam*} `}))

          2. (Let typRes be $subst_typ(theta, typ))

          3. If let (OK typ_subst) of type ok<typ> be typRes, then

            1. Return $subtyp(fenv, tdenv, typ_subst, val)

      2. Case (% matches pattern VARIANT %, let (VARIANT (typCase)*{typCase <- typCase*}) = %)

        1. If ((|(typ')*{typ' <- typ'*}| = |(tparam)*{tparam <- tparam*}|)), then

          1. (Let theta be (`{ ((tparam ':' typ'))*{typ' <- typ'*, tparam <- tparam*} `}))

          2. Return $subtyp_variant(fenv, tdenv, theta, (typCase)*{typCase <- typCase*}, val)

      3. Case (% matches pattern STRUCT %, let (STRUCT (typField)*{typField <- typField*}) = %)

        1. If ((|(typ')*{typ' <- typ'*}| = |(tparam)*{tparam <- tparam*}|)), then

          1. (Let theta be (`{ ((tparam ':' typ'))*{typ' <- typ'*, tparam <- tparam*} `}))

          2. Return $subtyp_struct(fenv, tdenv, theta, (typField)*{typField <- typField*}, val)

2. Otherwise,

  1. Return ((ERROR) as subtypRes)

def $subtyp_extern(val)

1. If ((val matches pattern EXT %)), then

  1. Return ((OK true) as subtypRes)

2. Otherwise,

  1. Return ((OK false) as subtypRes)

def $subtyp_variant(fenv, tdenv, theta, (typCase)*{typCase <- typCase*}, val')

1. If let (INJ (mixop (val)*{val <- val*})) be val' matching pattern INJ %, then

  1. (Let (mixop_case (typ_case)*{typ_case <- typ_case*}) be typCase)*{typCase <- typCase*, mixop_case -> mixop_case*, typ_case* -> typ_case**}

  2. (Let ((typ)*{typ <- typ*})?{typ* <- typ*?} be $assoc_<mixop, typ*>(mixop, ((mixop_case, (typ_case)*{typ_case <- typ_case*}))*{mixop_case <- mixop_case*, typ_case* <- typ_case**}))

  3. If ((((typ)*{typ <- typ*})?{typ* <- typ*?} matches pattern (_))), then

    1. (Let ?((typ_case_found)*{typ_case_found <- typ_case_found*}) be ((typ)*{typ <- typ*})?{typ* <- typ*?})

    2. Return $subtyp_case(fenv, tdenv, theta, (typ_case_found)*{typ_case_found <- typ_case_found*}, (val)*{val <- val*})

2. Otherwise,

  1. Return ((OK false) as subtypRes)

def $subtyp_struct(fenv, tdenv, theta, (typField)*{typField <- typField*}, val)

1. If let (STR (valField)*{valField <- valField*}) be val matching pattern STR %, then

  1. (Let (atom typ_field) be typField)*{typField <- typField*, atom -> atom*, typ_field -> typ_field*}

  2. (Let (atom' val_field) be valField)*{valField <- valField*, atom' -> atom'*, val_field -> val_field*}

  3. If ((|(atom)*{atom <- atom*}| = |(atom')*{atom' <- atom'*}|)), then

    1. If ((atom' = atom))*{atom <- atom*, atom' <- atom'*}, then

      1. Return $subtyp_case(fenv, tdenv, theta, (typ_field)*{typ_field <- typ_field*}, (val_field)*{val_field <- val_field*})

2. Otherwise,

  1. Return ((OK false) as subtypRes)

def $subtyp_case(fenv, tdenv, theta, (typ)*{typ <- typ*}, (val)*{val <- val*})

1. (Let typsRes be $subst_typs(theta, (typ)*{typ <- typ*}))

2. If let (OK (typ_subst)*{typ_subst <- typ_subst*}) of type ok<typ*> be typsRes, then

  1. Return $subtyps(fenv, tdenv, (typ_subst)*{typ_subst <- typ_subst*}, (val)*{val <- val*})

3. Otherwise,

  1. Return ((ERROR) as subtypRes)

def $subtyps(fenv, tdenv, (typ)*{typ <- typ*}, (val)*{val <- val*})

1. Case analysis on (typ)*{typ <- typ*} (total)

  1. Case (% matches pattern [])

    1. Case analysis on (val)*{val <- val*} (total)

      1. Case (% matches pattern [])

        1. Return ((OK true) as subtypRes)

      2. Case (% matches pattern _ :: _)

        1. Return ((OK false) as subtypRes)

  2. Case (% matches pattern _ :: _)

    1. (Let typ_h :: (typ_t)*{typ_t <- typ_t*} be (typ)*{typ <- typ*})

    2. Case analysis on (val)*{val <- val*} (total)

      1. Case (% matches pattern _ :: _)

        1. (Let val_h :: (val_t)*{val_t <- val_t*} be (val)*{val <- val*})

        2. Block (2 arms)

        Arm 1:

          1. If ((((OK true) as subtypRes) = $subtyp(fenv, tdenv, typ_h, val_h))), then

            1. Return $subtyps(fenv, tdenv, (typ_t)*{typ_t <- typ_t*}, (val_t)*{val_t <- val_t*})

          1. Else Dangling

        Arm 2:

          1. (Let subtypRes be $subtyp(fenv, tdenv, typ_h, val_h))

          2. Check ((subtypRes =/= ((OK true) as subtypRes)))

            1. Return subtypRes

      2. Case (% matches pattern [])

        1. Return ((OK false) as subtypRes)

def $subtyp_list(fenv, tdenv, typ, (val)*{val <- val*})

1. Case analysis on (val)*{val <- val*} (total)

  1. Case (% matches pattern [])

    1. Return ((OK true) as subtypRes)

  2. Case (% matches pattern _ :: _)

    1. (Let val_h :: (val_t)*{val_t <- val_t*} be (val)*{val <- val*})

    2. Block (2 arms)

    Arm 1:

      1. If ((((OK true) as subtypRes) = $subtyp(fenv, tdenv, typ, val_h))), then

        1. Return $subtyp_list(fenv, tdenv, typ, (val_t)*{val_t <- val_t*})

      1. Else Dangling

    Arm 2:

      1. (Let subtypRes be $subtyp(fenv, tdenv, typ, val_h))

      2. Check ((subtypRes =/= ((OK true) as subtypRes)))

        1. Return subtypRes

def $subtyp_func(fenv, tdenv, typ, id)

1. (Let (funcDefnAL')?{funcDefnAL' <- funcDefnAL'?} be $find_map<id, funcDefnAL>(fenv, id))

2. If (((funcDefnAL')?{funcDefnAL' <- funcDefnAL'?} matches pattern (_))), then

  1. (Let ?(funcDefnAL) be (funcDefnAL')?{funcDefnAL' <- funcDefnAL'?})

  2. (Let typ' be $func_typ(funcDefnAL))

  3. (Let equivRes be $equiv_func_typ(tdenv, typ, typ'))

  4. Return (equivRes as subtypRes)

3. Otherwise,

  1. Return ((ERROR) as subtypRes)

def $param_typ(param')

1. Case analysis on param' (total)

  1. Case (% matches pattern EXP %, let (EXP typ) = %)

    1. Return typ

  2. Case (% matches pattern FUN % ':' % % '->' %, let (FUN id ':' (tparam)*{tparam <- tparam*} (param)*{param <- param*} '->' typ) = %)

    1. (Let typ' be $param_typ(param))*{param <- param*, typ' -> typ'*}

    2. Return (FUNC (tparam)*{tparam <- tparam*} (typ')*{typ' <- typ'*} typ)

def $func_typ(funcDefnAL)

1. Case analysis on funcDefnAL (total)

  1. Case (% has type externFuncDefn, let (EXTFUNC id (tparam)*{tparam <- tparam*} (param)*{param <- param*} ':' typ) = %)

    1. (Let typ' be $param_typ(param))*{param <- param*, typ' -> typ'*}

    2. Return (FUNC (tparam)*{tparam <- tparam*} (typ')*{typ' <- typ'*} typ)

  2. Case (% has type builtinFuncDefn, let (BUILTINFUNC id (tparam)*{tparam <- tparam*} (param)*{param <- param*} ':' typ) = %)

    1. (Let typ'' be $param_typ(param))*{param <- param*, typ'' -> typ''*}

    2. Return (FUNC (tparam)*{tparam <- tparam*} (typ'')*{typ'' <- typ''*} typ)

  3. Case (% has type tableFuncDefnAL, let (TABLEFUNC _id (param)*{param <- param*} ':' typ '=' (tblRowAL)*{tblRowAL <- tblRowAL*}) = %)

    1. (Let typ''' be $param_typ(param))*{param <- param*, typ''' -> typ'''*}

    2. Return (FUNC [] (typ''')*{typ''' <- typ'''*} typ)

  4. Case (% has type definedFuncDefnAL, let (FUNC _id (tparam)*{tparam <- tparam*} (param)*{param <- param*} ':' typ '=' (clauseAL)*{clauseAL <- clauseAL*} (elsClauseAL)?{elsClauseAL <- elsClauseAL?}) = %)

    1. (Let typ'''' be $param_typ(param))*{param <- param*, typ'''' -> typ''''*}

    2. Return (FUNC (tparam)*{tparam <- tparam*} (typ'''')*{typ'''' <- typ''''*} typ)

syntax castRes =
   | OK val (from ok<val>)
   | ERROR (from error)

syntax castsRes =
   | OK val* (from ok<val*>)
   | ERROR (from error)

def $upcast(C, typ', val'')

1. Block (2 arms)

Arm 1:

  1. Case analysis on typ'

    1. Case (% has type numtyp, let numtyp = %)

      1. Case analysis on numtyp (total)

        1. Case (% matches pattern INT)

          1. If let num of type num be val'', then

            1. Case analysis on num (total)

              1. Case (% matches pattern INT %, let (INT i) = %)

                1. Return ((OK ((INT i) as val)) as castRes)

              2. Case (% matches pattern NAT %, let (NAT n) = %)

                1. Return ((OK ((INT (n as int)) as val)) as castRes)

        2. Case (% matches pattern NAT)

          1. If let num of type num be val'', then

            1. If let (NAT n) be num matching pattern NAT %, then

              1. Return ((OK ((NAT n) as val)) as castRes)

    2. Case (% matches pattern VAR % %, let (VAR id (targ)*{targ <- targ*}) = %)

      1. Block (2 arms)

      Arm 1:

        1. (Let (typDef')?{typDef' <- typDef'?} be $find_typ(C, id))

        2. If (((typDef')?{typDef' <- typDef'?} matches pattern (_))), then

          1. (Let ?(typDef) be (typDef')?{typDef' <- typDef'?})

          2. If let (TYP _id (tparam)*{tparam <- tparam*} '=' deftyp) of type definedTypDefn be typDef, then

            1. Case analysis on deftyp (total)

              1. Case (% matches pattern ALIAS %, let (ALIAS typ) = %)

                1. If ((|(targ)*{targ <- targ*}| = |(tparam)*{tparam <- tparam*}|)), then

                  1. (Let theta be (`{ ((tparam ':' targ))*{targ <- targ*, tparam <- tparam*} `}))

                  2. (Let typRes be $subst_typ(theta, typ))

                  3. If let (OK typ_subst) of type ok<typ> be typRes, then

                    1. Return $upcast(C, typ_subst, val'')

              2. Case (% matches pattern VARIANT %)

                1. (Let (`{ ((id_local ':' typDef_local))*{id_local <- id_local*, typDef_local <- typDef_local*} `}) be C.LOCAL.TYP)

                2. (Let tdenv be $adds_map<id, typDef>(C.GLOBAL.TYP, (id_local)*{id_local <- id_local*}, (typDef_local)*{typDef_local <- typDef_local*}))

                3. If ((((OK true) as subtypRes) = $subtyp(C.GLOBAL.FUNC, tdenv, (VAR id (targ)*{targ <- targ*}), val''))), then

                  1. Return ((OK val'') as castRes)

              3. Case (% matches pattern STRUCT %)

                1. (Let (`{ ((id_local ':' typDef_local))*{id_local <- id_local*, typDef_local <- typDef_local*} `}) be C.LOCAL.TYP)

                2. (Let tdenv be $adds_map<id, typDef>(C.GLOBAL.TYP, (id_local)*{id_local <- id_local*}, (typDef_local)*{typDef_local <- typDef_local*}))

                3. If ((((OK true) as subtypRes) = $subtyp(C.GLOBAL.FUNC, tdenv, (VAR id (targ)*{targ <- targ*}), val''))), then

                  1. Return ((OK val'') as castRes)

      Arm 2:

        1. If (((targ)*{targ <- targ*} matches pattern [])), then

          1. If let (EXT json) be val'' matching pattern EXT %, then

            1. (Let (typDef')?{typDef' <- typDef'?} be $find_typ(C, id))

            2. If (((typDef')?{typDef' <- typDef'?} matches pattern (_))), then

              1. (Let ?(typDef) be (typDef')?{typDef' <- typDef'?})

              2. If ((typDef has type externTypDefn)), then

                1. Return ((OK (EXT json)) as castRes)

    3. Case (% matches pattern TUP %, let (TUP (typ)*{typ <- typ*}) = %)

      1. If let (TUP (val)*{val <- val*}) be val'' matching pattern TUP %, then

        1. (Let castsRes be $upcasts(C, (typ)*{typ <- typ*}, (val)*{val <- val*}))

        2. If let (OK (val_cast)*{val_cast <- val_cast*}) of type ok<val*> be castsRes, then

          1. Return ((OK (TUP (val_cast)*{val_cast <- val_cast*})) as castRes)

    4. Case (% matches pattern ITER % %, let (ITER typ iter) = %)

      1. Case analysis on iter (total)

        1. Case (% matches pattern QUEST)

          1. Block (2 arms)

          Arm 1:

            1. If ((val'' = (OPT ?()))), then

              1. Return ((OK (OPT ?())) as castRes)

          Arm 2:

            1. If let (OPT (val')?{val' <- val'?}) be val'' matching pattern OPT %, then

              1. If (((val')?{val' <- val'?} matches pattern (_))), then

                1. (Let ?(val) be (val')?{val' <- val'?})

                2. (Let castRes be $upcast(C, typ, val))

                3. If let (OK val_cast) of type ok<val> be castRes, then

                  1. Return ((OK (OPT ?(val_cast))) as castRes)

        2. Case (% matches pattern STAR)

          1. If let (LIST (val)*{val <- val*}) be val'' matching pattern LIST %, then

            1. (Let (typ'')*{typ'' <- typ''*} be $repeat_<typ>(typ, |(val)*{val <- val*}|))

            2. (Let castsRes be $upcasts(C, (typ'')*{typ'' <- typ''*}, (val)*{val <- val*}))

            3. If let (OK (val_cast)*{val_cast <- val_cast*}) of type ok<val*> be castsRes, then

              1. Return ((OK (LIST (val_cast)*{val_cast <- val_cast*})) as castRes)

    5. Case (% matches pattern FUNC % % %, let (FUNC (tparam)*{tparam <- tparam*} (typ)*{typ <- typ*} typ_ret) = %)

      1. If let (FUNC id) be val'' matching pattern FUNC %, then

        1. (Let (`{ ((id_local ':' typDef_local))*{id_local <- id_local*, typDef_local <- typDef_local*} `}) be C.LOCAL.TYP)

        2. (Let tdenv be $adds_map<id, typDef>(C.GLOBAL.TYP, (id_local)*{id_local <- id_local*}, (typDef_local)*{typDef_local <- typDef_local*}))

        3. If ((((OK true) as subtypRes) = $subtyp(C.GLOBAL.FUNC, tdenv, (FUNC (tparam)*{tparam <- tparam*} (typ)*{typ <- typ*} typ_ret), (FUNC id)))), then

          1. Return ((OK (FUNC id)) as castRes)

Arm 2:

  1. If let optyp of type optyp be typ', then

    1. Case analysis on optyp

      1. Case (% matches pattern BOOL)

        1. If let (BOOL b) be val'' matching pattern BOOL %, then

          1. Return ((OK (BOOL b)) as castRes)

      2. Case (% matches pattern TEXT)

        1. If let (TEXT t) be val'' matching pattern TEXT %, then

          1. Return ((OK (TEXT t)) as castRes)

2. Otherwise,

  1. Return ((ERROR) as castRes)

def $upcasts(C, (typ)*{typ <- typ*}, (val)*{val <- val*})

1. Case analysis on (typ)*{typ <- typ*} (total)

  1. Case (% matches pattern [])

    1. If (((val)*{val <- val*} matches pattern [])), then

      1. Return ((OK []) as castsRes)

  2. Case (% matches pattern _ :: _)

    1. (Let typ_h :: (typ_t)*{typ_t <- typ_t*} be (typ)*{typ <- typ*})

    2. If (((val)*{val <- val*} matches pattern _ :: _)), then

      1. (Let val_h :: (val_t)*{val_t <- val_t*} be (val)*{val <- val*})

      2. (Let castRes be $upcast(C, typ_h, val_h))

      3. If let (OK val_cast) of type ok<val> be castRes, then

        1. (Let castsRes be $upcasts(C, (typ_t)*{typ_t <- typ_t*}, (val_t)*{val_t <- val_t*}))

        2. If let (OK (val_t_cast)*{val_t_cast <- val_t_cast*}) of type ok<val*> be castsRes, then

          1. Return ((OK val_cast :: (val_t_cast)*{val_t_cast <- val_t_cast*}) as castsRes)

2. Otherwise,

  1. Return ((ERROR) as castsRes)

def $downcast(C, typ', val'')

1. Block (2 arms)

Arm 1:

  1. Case analysis on typ'

    1. Case (% has type numtyp, let numtyp = %)

      1. Case analysis on numtyp (total)

        1. Case (% matches pattern NAT)

          1. If let num of type num be val'', then

            1. Case analysis on num (total)

              1. Case (% matches pattern NAT %, let (NAT n) = %)

                1. Return ((OK ((NAT n) as val)) as castRes)

              2. Case (% matches pattern INT %, let (INT i) = %)

                1. If let n of type nat be i, then

                  1. Return ((OK ((NAT n) as val)) as castRes)

        2. Case (% matches pattern INT)

          1. If let num of type num be val'', then

            1. Return ((OK (num as val)) as castRes)

    2. Case (% matches pattern VAR % %, let (VAR id (targ)*{targ <- targ*}) = %)

      1. Block (2 arms)

      Arm 1:

        1. (Let (typDef')?{typDef' <- typDef'?} be $find_typ(C, id))

        2. If (((typDef')?{typDef' <- typDef'?} matches pattern (_))), then

          1. (Let ?(typDef) be (typDef')?{typDef' <- typDef'?})

          2. If let (TYP _id (tparam)*{tparam <- tparam*} '=' deftyp) of type definedTypDefn be typDef, then

            1. Case analysis on deftyp (total)

              1. Case (% matches pattern ALIAS %, let (ALIAS typ) = %)

                1. If ((|(targ)*{targ <- targ*}| = |(tparam)*{tparam <- tparam*}|)), then

                  1. (Let theta be (`{ ((tparam ':' targ))*{targ <- targ*, tparam <- tparam*} `}))

                  2. (Let typRes be $subst_typ(theta, typ))

                  3. If let (OK typ_subst) of type ok<typ> be typRes, then

                    1. Return $downcast(C, typ_subst, val'')

              2. Case (% matches pattern VARIANT %)

                1. (Let (`{ ((id_local ':' typDef_local))*{id_local <- id_local*, typDef_local <- typDef_local*} `}) be C.LOCAL.TYP)

                2. (Let tdenv be $adds_map<id, typDef>(C.GLOBAL.TYP, (id_local)*{id_local <- id_local*}, (typDef_local)*{typDef_local <- typDef_local*}))

                3. If ((((OK true) as subtypRes) = $subtyp(C.GLOBAL.FUNC, tdenv, (VAR id (targ)*{targ <- targ*}), val''))), then

                  1. Return ((OK val'') as castRes)

              3. Case (% matches pattern STRUCT %)

                1. (Let (`{ ((id_local ':' typDef_local))*{id_local <- id_local*, typDef_local <- typDef_local*} `}) be C.LOCAL.TYP)

                2. (Let tdenv be $adds_map<id, typDef>(C.GLOBAL.TYP, (id_local)*{id_local <- id_local*}, (typDef_local)*{typDef_local <- typDef_local*}))

                3. If ((((OK true) as subtypRes) = $subtyp(C.GLOBAL.FUNC, tdenv, (VAR id (targ)*{targ <- targ*}), val''))), then

                  1. Return ((OK val'') as castRes)

      Arm 2:

        1. If (((targ)*{targ <- targ*} matches pattern [])), then

          1. If let (EXT json) be val'' matching pattern EXT %, then

            1. (Let (typDef')?{typDef' <- typDef'?} be $find_typ(C, id))

            2. If (((typDef')?{typDef' <- typDef'?} matches pattern (_))), then

              1. (Let ?(typDef) be (typDef')?{typDef' <- typDef'?})

              2. If ((typDef has type externTypDefn)), then

                1. Return ((OK (EXT json)) as castRes)

    3. Case (% matches pattern TUP %, let (TUP (typ)*{typ <- typ*}) = %)

      1. If let (TUP (val)*{val <- val*}) be val'' matching pattern TUP %, then

        1. (Let castsRes be $downcasts(C, (typ)*{typ <- typ*}, (val)*{val <- val*}))

        2. If let (OK (val_cast)*{val_cast <- val_cast*}) of type ok<val*> be castsRes, then

          1. Return ((OK (TUP (val_cast)*{val_cast <- val_cast*})) as castRes)

    4. Case (% matches pattern ITER % %, let (ITER typ iter) = %)

      1. Case analysis on iter (total)

        1. Case (% matches pattern QUEST)

          1. Block (2 arms)

          Arm 1:

            1. If ((val'' = (OPT ?()))), then

              1. Return ((OK (OPT ?())) as castRes)

          Arm 2:

            1. If let (OPT (val')?{val' <- val'?}) be val'' matching pattern OPT %, then

              1. If (((val')?{val' <- val'?} matches pattern (_))), then

                1. (Let ?(val) be (val')?{val' <- val'?})

                2. (Let castRes be $downcast(C, typ, val))

                3. If let (OK val_cast) of type ok<val> be castRes, then

                  1. Return ((OK (OPT ?(val_cast))) as castRes)

        2. Case (% matches pattern STAR)

          1. If let (LIST (val)*{val <- val*}) be val'' matching pattern LIST %, then

            1. (Let (typ'')*{typ'' <- typ''*} be $repeat_<typ>(typ, |(val)*{val <- val*}|))

            2. (Let castsRes be $downcasts(C, (typ'')*{typ'' <- typ''*}, (val)*{val <- val*}))

            3. If let (OK (val_cast)*{val_cast <- val_cast*}) of type ok<val*> be castsRes, then

              1. Return ((OK (LIST (val_cast)*{val_cast <- val_cast*})) as castRes)

    5. Case (% matches pattern FUNC % % %, let (FUNC (tparam)*{tparam <- tparam*} (typ)*{typ <- typ*} typ_ret) = %)

      1. If let (FUNC id) be val'' matching pattern FUNC %, then

        1. (Let (`{ ((id_local ':' typDef_local))*{id_local <- id_local*, typDef_local <- typDef_local*} `}) be C.LOCAL.TYP)

        2. (Let tdenv be $adds_map<id, typDef>(C.GLOBAL.TYP, (id_local)*{id_local <- id_local*}, (typDef_local)*{typDef_local <- typDef_local*}))

        3. If ((((OK true) as subtypRes) = $subtyp(C.GLOBAL.FUNC, tdenv, (FUNC (tparam)*{tparam <- tparam*} (typ)*{typ <- typ*} typ_ret), (FUNC id)))), then

          1. Return ((OK (FUNC id)) as castRes)

Arm 2:

  1. If let optyp of type optyp be typ', then

    1. Case analysis on optyp

      1. Case (% matches pattern BOOL)

        1. If let (BOOL b) be val'' matching pattern BOOL %, then

          1. Return ((OK (BOOL b)) as castRes)

      2. Case (% matches pattern TEXT)

        1. If let (TEXT t) be val'' matching pattern TEXT %, then

          1. Return ((OK (TEXT t)) as castRes)

2. Otherwise,

  1. Return ((ERROR) as castRes)

def $downcasts(C, (typ)*{typ <- typ*}, (val)*{val <- val*})

1. Case analysis on (typ)*{typ <- typ*} (total)

  1. Case (% matches pattern [])

    1. If (((val)*{val <- val*} matches pattern [])), then

      1. Return ((OK []) as castsRes)

  2. Case (% matches pattern _ :: _)

    1. (Let typ_h :: (typ_t)*{typ_t <- typ_t*} be (typ)*{typ <- typ*})

    2. If (((val)*{val <- val*} matches pattern _ :: _)), then

      1. (Let val_h :: (val_t)*{val_t <- val_t*} be (val)*{val <- val*})

      2. (Let castRes be $downcast(C, typ_h, val_h))

      3. If let (OK val_cast) of type ok<val> be castRes, then

        1. (Let castsRes be $downcasts(C, (typ_t)*{typ_t <- typ_t*}, (val_t)*{val_t <- val_t*}))

        2. If let (OK (val_t_cast)*{val_t_cast <- val_t_cast*}) of type ok<val*> be castsRes, then

          1. Return ((OK val_cast :: (val_t_cast)*{val_t_cast <- val_t_cast*}) as castsRes)

2. Otherwise,

  1. Return ((ERROR) as castsRes)

syntax assignRes =
   | OK ctx (from ok<ctx>)
   | ERROR (from error)

relation Assign_exp: C |- typedExp'' := val''' : %

1. (Let (exp '#' typ) be typedExp'')

2. Case analysis on exp

  1. Case (% matches pattern VAR %, let (VAR id) = %)

    1. Group variable: C |- ((VAR id) '#' typ) := val''' : %

      1. (Let C' be $add_varr(C, (id []), val'''))

      2. Result in: % |- % := % : ((OK C') as assignRes)

  2. Case (% matches pattern TUP %, let (TUP (typedExp)*{typedExp <- typedExp*}) = %)

    1. If let (TUP (val)*{val <- val*}) be val''' matching pattern TUP %, then

      1. Group tup: C |- ((TUP (typedExp)*{typedExp <- typedExp*}) '#' typ) := (TUP (val)*{val <- val*}) : %

        1. (Assign_exps: C |- (typedExp)*{typedExp <- typedExp*} := (val)*{val <- val*} : assignRes)

        2. If let (OK C') of type ok<ctx> be assignRes, then

          1. Result in: % |- % := % : ((OK C') as assignRes)

  3. Case (% matches pattern INJ %, let (INJ (mixop (typedExp)*{typedExp <- typedExp*})) = %)

    1. If let (INJ (mixop' (val)*{val <- val*})) be val''' matching pattern INJ %, then

      1. If ((mixop = mixop')), then

        1. Group inj: C |- ((INJ (mixop (typedExp)*{typedExp <- typedExp*})) '#' typ) := (INJ (mixop (val)*{val <- val*})) : %

          1. (Assign_exps: C |- (typedExp)*{typedExp <- typedExp*} := (val)*{val <- val*} : assignRes)

          2. If let (OK C') of type ok<ctx> be assignRes, then

            1. Result in: % |- % := % : ((OK C') as assignRes)

  4. Case (% matches pattern STR %, let (STR (expField)*{expField <- expField*}) = %)

    1. If let (STR (valField)*{valField <- valField*}) be val''' matching pattern STR %, then

      1. Group str: C |- ((STR (expField)*{expField <- expField*}) '#' typ) := (STR (valField)*{valField <- valField*}) : %

        1. (Let (atom val) be valField)*{valField <- valField*, atom -> atom*, val -> val*}

        2. (Let (atom' typedExp) be expField)*{expField <- expField*, atom' -> atom'*, typedExp -> typedExp*}

        3. If ((|(atom)*{atom <- atom*}| = |(atom')*{atom' <- atom'*}|)), then

          1. If ((atom' = atom))*{atom <- atom*, atom' <- atom'*}, then

            1. (Assign_exps: C |- (typedExp)*{typedExp <- typedExp*} := (val)*{val <- val*} : assignRes)

            2. If let (OK C') of type ok<ctx> be assignRes, then

              1. Result in: % |- % := % : ((OK C') as assignRes)

  5. Case (% matches pattern OPT %, let (OPT (typedExp')?{typedExp' <- typedExp'?}) = %)

    1. If let (OPT (val')?{val' <- val'?}) be val''' matching pattern OPT %, then

      1. Group opt: C |- ((OPT (typedExp')?{typedExp' <- typedExp'?}) '#' typ) := (OPT (val')?{val' <- val'?}) : %

        1. Case analysis on (typedExp')?{typedExp' <- typedExp'?} (total)

          1. Case (% matches pattern (_))

            1. (Let ?(typedExp) be (typedExp')?{typedExp' <- typedExp'?})

            2. If (((val')?{val' <- val'?} matches pattern (_))), then

              1. (Let ?(val) be (val')?{val' <- val'?})

              2. (Assign_exp: C |- typedExp := val : assignRes)

              3. If let (OK C') of type ok<ctx> be assignRes, then

                1. Result in: % |- % := % : ((OK C') as assignRes)

          2. Case (% matches pattern ())

            1. If (((val')?{val' <- val'?} matches pattern ())), then

              1. Result in: % |- % := % : ((OK C) as assignRes)

  6. Case (% matches pattern LIST %, let (LIST (typedExp)*{typedExp <- typedExp*}) = %)

    1. If let (LIST (val)*{val <- val*}) be val''' matching pattern LIST %, then

      1. Group list: C |- ((LIST (typedExp)*{typedExp <- typedExp*}) '#' typ) := (LIST (val)*{val <- val*}) : %

        1. (Assign_exps: C |- (typedExp)*{typedExp <- typedExp*} := (val)*{val <- val*} : assignRes)

        2. If let (OK C') of type ok<ctx> be assignRes, then

          1. Result in: % |- % := % : ((OK C') as assignRes)

  7. Case (% matches pattern CONS % %, let (CONS typedExp_h typedExp_t) = %)

    1. If let (LIST (val)*{val <- val*}) be val''' matching pattern LIST %, then

      1. If (((val)*{val <- val*} matches pattern _ :: _)), then

        1. (Let val_h :: (val_t)*{val_t <- val_t*} be (val)*{val <- val*})

        2. Group cons: C |- ((CONS typedExp_h typedExp_t) '#' typ) := (LIST val_h :: (val_t)*{val_t <- val_t*}) : %

          1. (Assign_exp: C |- typedExp_h := val_h : assignRes)

          2. If let (OK C') of type ok<ctx> be assignRes, then

            1. (Assign_exp: C' |- typedExp_t := (LIST (val_t)*{val_t <- val_t*}) : assignRes')

            2. If let (OK C'') of type ok<ctx> be assignRes', then

              1. Result in: % |- % := % : ((OK C'') as assignRes)

  8. Case (% matches pattern ITER % %, let (ITER typedExp expIter) = %)

    1. Group iter: C |- ((ITER typedExp expIter) '#' typ) := val''' : %

      1. Block (3 arms)

      Arm 1:

        1. (Let (varr')?{varr' <- varr'?} be $is_iter_on_var(((ITER typedExp expIter) '#' typ)))

        2. If (((varr')?{varr' <- varr'?} matches pattern (_))), then

          1. (Let ?(varr) be (varr')?{varr' <- varr'?})

          2. (Let C' be $add_varr(C, varr, val'''))

          3. Result in: % |- % := % : ((OK C') as assignRes)

      Arm 2:

        1. If ((val''' = (OPT ?()))), then

          1. If (($is_iter_on_var(((ITER typedExp expIter) '#' typ)) matches pattern ())), then

            1. (Let (iter (vari)*{vari <- vari*}) be expIter)

            2. If ((iter matches pattern QUEST)), then

              1. (Let vari_iter be $iterate_vari(vari, [(QUEST)]))*{vari <- vari*, vari_iter -> vari_iter*}

              2. (Let (val_bind)*{val_bind <- val_bind*} be $repeat_<val>((OPT ?()), |(vari_iter)*{vari_iter <- vari_iter*}|))

              3. (Let C' be $add_varis(C, (vari_iter)*{vari_iter <- vari_iter*}, (val_bind)*{val_bind <- val_bind*}))

              4. Result in: % |- % := % : ((OK C') as assignRes)

      Arm 3:

        1. Case analysis on val'''

          1. Case (% matches pattern OPT %, let (OPT (val')?{val' <- val'?}) = %)

            1. If (((val')?{val' <- val'?} matches pattern (_))), then

              1. (Let ?(val) be (val')?{val' <- val'?})

              2. If (($is_iter_on_var(((ITER typedExp expIter) '#' typ)) matches pattern ())), then

                1. (Let (iter (vari)*{vari <- vari*}) be expIter)

                2. If ((iter matches pattern QUEST)), then

                  1. (Assign_exp: C |- typedExp := val : assignRes)

                  2. If let (OK C') of type ok<ctx> be assignRes, then

                    1. (Let vari_iter be $iterate_vari(vari, [(QUEST)]))*{vari <- vari*, vari_iter -> vari_iter*}

                    2. (Let (val'')?{val'' <- val''?} be $find_vari(C', vari))*{vari <- vari*, val''? -> val''?*}

                    3. If (((val'')?{val'' <- val''?} matches pattern (_)))*{val''? <- val''?*}, then

                      1. (Let ?(val_sub) be (val'')?{val'' <- val''?})*{val''? <- val''?*, val_sub -> val_sub*}

                      2. (Let C'' be $add_varis(C', (vari_iter)*{vari_iter <- vari_iter*}, ((OPT ?(val_sub)))*{val_sub <- val_sub*}))

                      3. Result in: % |- % := % : ((OK C'') as assignRes)

          2. Case (% matches pattern LIST %, let (LIST (val)*{val <- val*}) = %)

            1. If (($is_iter_on_var(((ITER typedExp expIter) '#' typ)) matches pattern ())), then

              1. (Let (iter (vari)*{vari <- vari*}) be expIter)

              2. If ((iter matches pattern STAR)), then

                1. (Let C_local be C[LOCAL.VAL = $empty_map<varr, val>])

                2. (Assign_exp: C_local |- typedExp := val : assignRes)*{val <- val*, assignRes -> assignRes*}

                3. If ((assignRes has type ok<ctx>))*{assignRes <- assignRes*}, then

                  1. (Let (OK C_sub) be (assignRes as ok<ctx>))*{assignRes <- assignRes*, C_sub -> C_sub*}

                  2. (Let vari_iter be $iterate_vari(vari, [(STAR)]))*{vari <- vari*, vari_iter -> vari_iter*}

                  3. (Let ((val')*{val' <- val'*})?{val'* <- val'*?} be $finds_vari((C_sub)*{C_sub <- C_sub*}, vari))*{vari <- vari*, val'*? -> val'*?*}

                  4. If ((((val')*{val' <- val'*})?{val'* <- val'*?} matches pattern (_)))*{val'*? <- val'*?*}, then

                    1. (Let ?((val_sub)*{val_sub <- val_sub*}) be ((val')*{val' <- val'*})?{val'* <- val'*?})*{val'*? <- val'*?*, val_sub* -> val_sub**}

                    2. (Let val_bind be (LIST (val_sub)*{val_sub <- val_sub*}))*{val_sub* <- val_sub**, val_bind -> val_bind*}

                    3. (Let C' be $add_varis(C, (vari_iter)*{vari_iter <- vari_iter*}, (val_bind)*{val_bind <- val_bind*}))

                    4. Result in: % |- % := % : ((OK C') as assignRes)

3. Otherwise,

  1. Group error: C |- typedExp'' := val''' : %

    1. Result in: % |- % := % : ((ERROR) as assignRes)

