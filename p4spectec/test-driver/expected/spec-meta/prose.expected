      14. (Let IC_fresh be $add_iterated(IC_t, [vari_d]))

      15. (Let (premAL_part)*{premAL_part <- premAL_part*} be premAL_check :: premAL_let :: (premAL_h)*{premAL_h <- premAL_h*} ++ (premAL_t)*{premAL_t <- premAL_t*})

      16. Result in: % % |- % : AC_fresh IC_fresh typedExp_d (premAL_part)*{premAL_part <- premAL_part*}

  9. Case (% has type iterExp, let iterExp = %)

