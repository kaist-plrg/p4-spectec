  3. Case (% matches pattern SLICE % % %, let (SLICE typedPath typedExp_i typedExp_n) = %)

    1. (Let (vari'')*{vari'' <- vari''*} be $free_varis_path(typedPath))

    2. (Let (vari''')*{vari''' <- vari'''*} be $free_varis_exps([typedExp_i, typedExp_n]))

    3. Return (vari'')*{vari'' <- vari''*} ++ (vari''')*{vari''' <- vari'''*}

  4. Case (% matches pattern DOT % %, let (DOT typedPath _atom) = %)

