    Arm 1:

      1. If ((((OK true) as subtypRes) = $subtyp(fenv, tdenv, typ, val_h))), then

        1. Return $subtyp_list(fenv, tdenv, typ, (val_t)*{val_t <- val_t*})

      1. Else Dangling

    Arm 2:

      1. (Let subtypRes be $subtyp(fenv, tdenv, typ, val_h))

      2. Check ((subtypRes =/= ((OK true) as subtypRes)))

        1. Return subtypRes

def $subtyp_func(fenv, tdenv, typ, id)

1. (Let (funcDefnAL')?{funcDefnAL' <- funcDefnAL'?} be $find_map<id, funcDefnAL>(fenv, id))

2. If (((funcDefnAL')?{funcDefnAL' <- funcDefnAL'?} matches pattern (_))), then

