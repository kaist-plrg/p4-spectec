relation Partialbind_exp: AC IC |- typedExp : % % % %

1. Group : AC IC |- typedExp : % % % %

  1. Case analysis on $is_bound_exp(AC, typedExp) (total)

    1. Case true

      1. (Let (vari_read)*{vari_read <- vari_read*} be $free_varis_exp(typedExp))

      2. Check ($is_bound_varis(AC, IC, (vari_read)*{vari_read <- vari_read*}))

        1. (Let (_exp '#' typ) be typedExp)

        2. (Let ((id_used)*{id_used <- id_used*}, id_d) be $fresh_id(AC.USED))

        3. (Let AC_fresh be AC[USED = (id_used)*{id_used <- id_used*}])

        4. (Let vari_d be (id_d typ []))

        5. (Let typedExp_d be $exp_of_vari(vari_d))

        6. (Let cmpOpExp be (CMP ((EQ) as cmpOp) typedExp_d typedExp))

        7. (Let typedExp_check be ((cmpOpExp as exp) '#' ((BOOL) as typ)))

        8. (Let (id_read)*{id_read <- id_read*} be $ids_of_varis((vari_read)*{vari_read <- vari_read*}))

        9. (Let IC_d be $add_iterated(IC, [vari_d]))

        10. (Let (premIterAL)*{premIterAL <- premIterAL*} be $prem_iters(IC_d, id_d :: (id_read)*{id_read <- id_read*}, []))

        11. (Let premAL_check be $iterate_prem(((IF typedExp_check) as premAL), (premIterAL)*{premIterAL <- premIterAL*}))

        12. (Let IC_fresh be $add_iterated(IC, [vari_d]))

        13. Result in: % % |- % : AC_fresh IC_fresh typedExp_d [premAL_check]

    2. Case false

      1. (Partialbind_binder_exp: AC IC |- typedExp : AC_part IC_part typedExp_part (premAL)*{premAL <- premAL*})

      2. Result in: % % |- % : AC_part IC_part typedExp_part (premAL)*{premAL <- premAL*}

