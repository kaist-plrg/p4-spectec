      4. Case (% has type definedFuncDefnAL, let definedFuncDefnAL = %)

        1. (Let (FUNC id (tparam)*{tparam <- tparam*} (param)*{param <- param*} ':' typ '=' (clauseAL)*{clauseAL <- clauseAL*} (elsClauseAL)?{elsClauseAL <- elsClauseAL?}) be definedFuncDefnAL)

