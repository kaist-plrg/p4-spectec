def $free_varis_exp((exp '#' typ))

1. Block (2 arms)

Arm 1:

  1. Case analysis on exp (total)

    1. Case (% matches pattern BOOL %)

      1. Return []

    2. Case (% has type num)

      1. Return []

    3. Case (% matches pattern TEXT %)

      1. Return []

    4. Case (% matches pattern VAR %, let (VAR id) = %)

      1. Return [(id typ [])]

    5. Case (% matches pattern UN % %, let (UN _unop typedExp) = %)

      1. Return $free_varis_exp(typedExp)

    6. Case (% matches pattern BIN % % %, let (BIN _binop typedExp_l typedExp_r) = %)

      1. Return $free_varis_exps([typedExp_l, typedExp_r])

    7. Case (% matches pattern CMP % % %, let (CMP _cmpop typedExp_l typedExp_r) = %)

      1. Return $free_varis_exps([typedExp_l, typedExp_r])

    8. Case (% matches pattern UPCAST % %, let (UPCAST _typ typedExp) = %)

      1. Return $free_varis_exp(typedExp)

    9. Case (% matches pattern DOWNCAST % %, let (DOWNCAST _typ typedExp) = %)

      1. Return $free_varis_exp(typedExp)

    10. Case (% matches pattern SUB % %, let (SUB typedExp _typ) = %)

      1. Return $free_varis_exp(typedExp)

    11. Case (% matches pattern MATCH % %, let (MATCH typedExp _pat) = %)

      1. Return $free_varis_exp(typedExp)

    12. Case (% matches pattern TUP %, let (TUP (typedExp)*{typedExp <- typedExp*}) = %)

      1. Return $free_varis_exps((typedExp)*{typedExp <- typedExp*})

    13. Case (% matches pattern INJ %, let (INJ (_mixop (typedExp)*{typedExp <- typedExp*})) = %)

      1. Return $free_varis_exps((typedExp)*{typedExp <- typedExp*})

    14. Case (% matches pattern STR %, let (STR (expField)*{expField <- expField*}) = %)

      1. (Let (_atom typedExp) be expField)*{expField <- expField*, _atom -> _atom*, typedExp -> typedExp*}

      2. Return $free_varis_exps((typedExp)*{typedExp <- typedExp*})

    15. Case (% matches pattern OPT %, let (OPT (typedExp')?{typedExp' <- typedExp'?}) = %)

      1. If (((typedExp')?{typedExp' <- typedExp'?} matches pattern (_))), then

        1. (Let ?(typedExp) be (typedExp')?{typedExp' <- typedExp'?})

        2. Return $free_varis_exp(typedExp)

      1. Else Dangling

    16. Case (% matches pattern LIST %, let (LIST (typedExp)*{typedExp <- typedExp*}) = %)

      1. Return $free_varis_exps((typedExp)*{typedExp <- typedExp*})

    17. Case (% matches pattern CONS % %, let (CONS typedExp_h typedExp_t) = %)

      1. Return $free_varis_exps([typedExp_h, typedExp_t])

    18. Case (% matches pattern CAT % %, let (CAT typedExp_l typedExp_r) = %)

      1. Return $free_varis_exps([typedExp_l, typedExp_r])

    19. Case (% matches pattern MEM % %, let (MEM typedExp_l typedExp_r) = %)

      1. Return $free_varis_exps([typedExp_l, typedExp_r])

    20. Case (% matches pattern LEN %, let (LEN typedExp) = %)

      1. Return $free_varis_exp(typedExp)

    21. Case (% matches pattern DOT % %, let (DOT typedExp _atom) = %)

      1. Return $free_varis_exp(typedExp)

    22. Case (% matches pattern IDX % %, let (IDX typedExp_b typedExp_i) = %)

      1. Return $free_varis_exps([typedExp_b, typedExp_i])

    23. Case (% matches pattern SLICE % % %, let (SLICE typedExp_b typedExp_i typedExp_n) = %)

      1. Return $free_varis_exps([typedExp_b, typedExp_i, typedExp_n])

    24. Case (% matches pattern UPD % % %, let (UPD typedExp_b typedPath typedExp_f) = %)

      1. (Let (vari')*{vari' <- vari'*} be $free_varis_exp(typedExp_b))

      2. (Let (vari'')*{vari'' <- vari''*} be $free_varis_path(typedPath))

      3. (Let (vari''')*{vari''' <- vari'''*} be $free_varis_exp(typedExp_f))

      4. Return (vari')*{vari' <- vari'*} ++ (vari'')*{vari'' <- vari''*} ++ (vari''')*{vari''' <- vari'''*}

    25. Case (% matches pattern CALL % % %, let (CALL _id (_targ)*{_targ <- _targ*} (arg)*{arg <- arg*}) = %)

      1. Return $free_varis_args((arg)*{arg <- arg*})

    26. Case (% matches pattern ITER % %, let (ITER typedExp (iter (_vari)*{_vari <- _vari*})) = %)

      1. (Let (vari)*{vari <- vari*} be $free_varis_exp(typedExp))

      2. (Let vari_iter be $iterate_vari(vari, [iter]))*{vari <- vari*, vari_iter -> vari_iter*}

      3. Return (vari_iter)*{vari_iter <- vari_iter*}

Arm 2:

  1. Check ((exp = (OPT ?())))

    1. Return []

def $free_varis_exps((typedExp)*{typedExp <- typedExp*})

1. Case analysis on (typedExp)*{typedExp <- typedExp*} (total)

  1. Case (% matches pattern [])

    1. Return []

  2. Case (% matches pattern _ :: _)

    1. (Let typedExp_h :: (typedExp_t)*{typedExp_t <- typedExp_t*} be (typedExp)*{typedExp <- typedExp*})

    2. (Let (vari)*{vari <- vari*} be $free_varis_exp(typedExp_h))

    3. (Let (vari')*{vari' <- vari'*} be $free_varis_exps((typedExp_t)*{typedExp_t <- typedExp_t*}))

    4. Return (vari)*{vari <- vari*} ++ (vari')*{vari' <- vari'*}

