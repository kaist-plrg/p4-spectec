    2. Return (FUNC (tparam)*{tparam <- tparam*} (typ'')*{typ'' <- typ''*} typ)

  3. Case (% has type tableFuncDefnAL, let (TABLEFUNC _id (param)*{param <- param*} ':' typ '=' (tblRowAL)*{tblRowAL <- tblRowAL*}) = %)

    1. (Let typ''' be $param_typ(param))*{param <- param*, typ''' -> typ'''*}

    2. Return (FUNC [] (typ''')*{typ''' <- typ'''*} typ)

  4. Case (% has type definedFuncDefnAL, let (FUNC _id (tparam)*{tparam <- tparam*} (param)*{param <- param*} ':' typ '=' (clauseAL)*{clauseAL <- clauseAL*} (elsClauseAL)?{elsClauseAL <- elsClauseAL?}) = %)

    1. (Let typ'''' be $param_typ(param))*{param <- param*, typ'''' -> typ''''*}

    2. Return (FUNC (tparam)*{tparam <- tparam*} (typ'''')*{typ'''' <- typ''''*} typ)

syntax castRes =
   | OK val (from ok<val>)
   | ERROR (from error)

syntax castsRes =
   | OK val* (from ok<val*>)
   | ERROR (from error)

def $upcast(C, typ', val'')

1. Block (2 arms)

Arm 1:

  1. Case analysis on typ'

    1. Case (% has type numtyp, let numtyp = %)

      1. Case analysis on numtyp (total)

        1. Case (% matches pattern INT)

          1. If let num of type num be val'', then

            1. Case analysis on num (total)

              1. Case (% matches pattern INT %, let (INT i) = %)

                1. Return ((OK ((INT i) as val)) as castRes)

              2. Case (% matches pattern NAT %, let (NAT n) = %)

                1. Return ((OK ((INT (n as int)) as val)) as castRes)

        2. Case (% matches pattern NAT)

          1. If let num of type num be val'', then

            1. If let (NAT n) be num matching pattern NAT %, then

              1. Return ((OK ((NAT n) as val)) as castRes)

    2. Case (% matches pattern VAR % %, let (VAR id (targ)*{targ <- targ*}) = %)

      1. Block (2 arms)

      Arm 1:

        1. (Let (typDef')?{typDef' <- typDef'?} be $find_typ(C, id))

        2. If (((typDef')?{typDef' <- typDef'?} matches pattern (_))), then

          1. (Let ?(typDef) be (typDef')?{typDef' <- typDef'?})

          2. If let (TYP _id (tparam)*{tparam <- tparam*} '=' deftyp) of type definedTypDefn be typDef, then

            1. Case analysis on deftyp (total)

              1. Case (% matches pattern ALIAS %, let (ALIAS typ) = %)

                1. If ((|(targ)*{targ <- targ*}| = |(tparam)*{tparam <- tparam*}|)), then

                  1. (Let theta be (`{ ((tparam ':' targ))*{targ <- targ*, tparam <- tparam*} `}))

                  2. (Let typRes be $subst_typ(theta, typ))

                  3. If let (OK typ_subst) of type ok<typ> be typRes, then

                    1. Return $upcast(C, typ_subst, val'')

              2. Case (% matches pattern VARIANT %)

                1. (Let (`{ ((id_local ':' typDef_local))*{id_local <- id_local*, typDef_local <- typDef_local*} `}) be C.LOCAL.TYP)

                2. (Let tdenv be $adds_map<id, typDef>(C.GLOBAL.TYP, (id_local)*{id_local <- id_local*}, (typDef_local)*{typDef_local <- typDef_local*}))

                3. If ((((OK true) as subtypRes) = $subtyp(C.GLOBAL.FUNC, tdenv, (VAR id (targ)*{targ <- targ*}), val''))), then

                  1. Return ((OK val'') as castRes)

              3. Case (% matches pattern STRUCT %)

                1. (Let (`{ ((id_local ':' typDef_local))*{id_local <- id_local*, typDef_local <- typDef_local*} `}) be C.LOCAL.TYP)

                2. (Let tdenv be $adds_map<id, typDef>(C.GLOBAL.TYP, (id_local)*{id_local <- id_local*}, (typDef_local)*{typDef_local <- typDef_local*}))

                3. If ((((OK true) as subtypRes) = $subtyp(C.GLOBAL.FUNC, tdenv, (VAR id (targ)*{targ <- targ*}), val''))), then

                  1. Return ((OK val'') as castRes)

      Arm 2:

        1. If (((targ)*{targ <- targ*} matches pattern [])), then

          1. If let (EXT json) be val'' matching pattern EXT %, then

            1. (Let (typDef')?{typDef' <- typDef'?} be $find_typ(C, id))

            2. If (((typDef')?{typDef' <- typDef'?} matches pattern (_))), then

              1. (Let ?(typDef) be (typDef')?{typDef' <- typDef'?})

              2. If ((typDef has type externTypDefn)), then

                1. Return ((OK (EXT json)) as castRes)

    3. Case (% matches pattern TUP %, let (TUP (typ)*{typ <- typ*}) = %)

      1. If let (TUP (val)*{val <- val*}) be val'' matching pattern TUP %, then

        1. (Let castsRes be $upcasts(C, (typ)*{typ <- typ*}, (val)*{val <- val*}))

        2. If let (OK (val_cast)*{val_cast <- val_cast*}) of type ok<val*> be castsRes, then

          1. Return ((OK (TUP (val_cast)*{val_cast <- val_cast*})) as castRes)

    4. Case (% matches pattern ITER % %, let (ITER typ iter) = %)

      1. Case analysis on iter (total)

        1. Case (% matches pattern QUEST)

          1. Block (2 arms)

          Arm 1:

            1. If ((val'' = (OPT ?()))), then

              1. Return ((OK (OPT ?())) as castRes)

          Arm 2:

            1. If let (OPT (val')?{val' <- val'?}) be val'' matching pattern OPT %, then

              1. If (((val')?{val' <- val'?} matches pattern (_))), then

                1. (Let ?(val) be (val')?{val' <- val'?})

                2. (Let castRes be $upcast(C, typ, val))

                3. If let (OK val_cast) of type ok<val> be castRes, then

                  1. Return ((OK (OPT ?(val_cast))) as castRes)

        2. Case (% matches pattern STAR)

          1. If let (LIST (val)*{val <- val*}) be val'' matching pattern LIST %, then

            1. (Let (typ'')*{typ'' <- typ''*} be $repeat_<typ>(typ, |(val)*{val <- val*}|))

            2. (Let castsRes be $upcasts(C, (typ'')*{typ'' <- typ''*}, (val)*{val <- val*}))

            3. If let (OK (val_cast)*{val_cast <- val_cast*}) of type ok<val*> be castsRes, then

              1. Return ((OK (LIST (val_cast)*{val_cast <- val_cast*})) as castRes)

    5. Case (% matches pattern FUNC % % %, let (FUNC (tparam)*{tparam <- tparam*} (typ)*{typ <- typ*} typ_ret) = %)

      1. If let (FUNC id) be val'' matching pattern FUNC %, then

        1. (Let (`{ ((id_local ':' typDef_local))*{id_local <- id_local*, typDef_local <- typDef_local*} `}) be C.LOCAL.TYP)

        2. (Let tdenv be $adds_map<id, typDef>(C.GLOBAL.TYP, (id_local)*{id_local <- id_local*}, (typDef_local)*{typDef_local <- typDef_local*}))

        3. If ((((OK true) as subtypRes) = $subtyp(C.GLOBAL.FUNC, tdenv, (FUNC (tparam)*{tparam <- tparam*} (typ)*{typ <- typ*} typ_ret), (FUNC id)))), then

          1. Return ((OK (FUNC id)) as castRes)

Arm 2:

  1. If let optyp of type optyp be typ', then

    1. Case analysis on optyp

      1. Case (% matches pattern BOOL)

        1. If let (BOOL b) be val'' matching pattern BOOL %, then

          1. Return ((OK (BOOL b)) as castRes)

      2. Case (% matches pattern TEXT)

        1. If let (TEXT t) be val'' matching pattern TEXT %, then

          1. Return ((OK (TEXT t)) as castRes)

2. Otherwise,

  1. Return ((ERROR) as castRes)

def $upcasts(C, (typ)*{typ <- typ*}, (val)*{val <- val*})

1. Case analysis on (typ)*{typ <- typ*} (total)

  1. Case (% matches pattern [])

    1. If (((val)*{val <- val*} matches pattern [])), then

      1. Return ((OK []) as castsRes)

  2. Case (% matches pattern _ :: _)

    1. (Let typ_h :: (typ_t)*{typ_t <- typ_t*} be (typ)*{typ <- typ*})

    2. If (((val)*{val <- val*} matches pattern _ :: _)), then

      1. (Let val_h :: (val_t)*{val_t <- val_t*} be (val)*{val <- val*})

      2. (Let castRes be $upcast(C, typ_h, val_h))

      3. If let (OK val_cast) of type ok<val> be castRes, then

        1. (Let castsRes be $upcasts(C, (typ_t)*{typ_t <- typ_t*}, (val_t)*{val_t <- val_t*}))

        2. If let (OK (val_t_cast)*{val_t_cast <- val_t_cast*}) of type ok<val*> be castsRes, then

          1. Return ((OK val_cast :: (val_t_cast)*{val_t_cast <- val_t_cast*}) as castsRes)

2. Otherwise,

  1. Return ((ERROR) as castsRes)

def $downcast(C, typ', val'')

1. Block (2 arms)

Arm 1:

  1. Case analysis on typ'

    1. Case (% has type numtyp, let numtyp = %)

      1. Case analysis on numtyp (total)

        1. Case (% matches pattern NAT)

          1. If let num of type num be val'', then

            1. Case analysis on num (total)

              1. Case (% matches pattern NAT %, let (NAT n) = %)

                1. Return ((OK ((NAT n) as val)) as castRes)

              2. Case (% matches pattern INT %, let (INT i) = %)

                1. If let n of type nat be i, then

                  1. Return ((OK ((NAT n) as val)) as castRes)

        2. Case (% matches pattern INT)

          1. If let num of type num be val'', then

            1. Return ((OK (num as val)) as castRes)

    2. Case (% matches pattern VAR % %, let (VAR id (targ)*{targ <- targ*}) = %)

      1. Block (2 arms)

      Arm 1:

        1. (Let (typDef')?{typDef' <- typDef'?} be $find_typ(C, id))

        2. If (((typDef')?{typDef' <- typDef'?} matches pattern (_))), then

          1. (Let ?(typDef) be (typDef')?{typDef' <- typDef'?})

          2. If let (TYP _id (tparam)*{tparam <- tparam*} '=' deftyp) of type definedTypDefn be typDef, then

            1. Case analysis on deftyp (total)

              1. Case (% matches pattern ALIAS %, let (ALIAS typ) = %)

                1. If ((|(targ)*{targ <- targ*}| = |(tparam)*{tparam <- tparam*}|)), then

                  1. (Let theta be (`{ ((tparam ':' targ))*{targ <- targ*, tparam <- tparam*} `}))

                  2. (Let typRes be $subst_typ(theta, typ))

                  3. If let (OK typ_subst) of type ok<typ> be typRes, then

                    1. Return $downcast(C, typ_subst, val'')

              2. Case (% matches pattern VARIANT %)

                1. (Let (`{ ((id_local ':' typDef_local))*{id_local <- id_local*, typDef_local <- typDef_local*} `}) be C.LOCAL.TYP)

                2. (Let tdenv be $adds_map<id, typDef>(C.GLOBAL.TYP, (id_local)*{id_local <- id_local*}, (typDef_local)*{typDef_local <- typDef_local*}))

                3. If ((((OK true) as subtypRes) = $subtyp(C.GLOBAL.FUNC, tdenv, (VAR id (targ)*{targ <- targ*}), val''))), then

                  1. Return ((OK val'') as castRes)

              3. Case (% matches pattern STRUCT %)

                1. (Let (`{ ((id_local ':' typDef_local))*{id_local <- id_local*, typDef_local <- typDef_local*} `}) be C.LOCAL.TYP)

                2. (Let tdenv be $adds_map<id, typDef>(C.GLOBAL.TYP, (id_local)*{id_local <- id_local*}, (typDef_local)*{typDef_local <- typDef_local*}))

                3. If ((((OK true) as subtypRes) = $subtyp(C.GLOBAL.FUNC, tdenv, (VAR id (targ)*{targ <- targ*}), val''))), then

                  1. Return ((OK val'') as castRes)

      Arm 2:

        1. If (((targ)*{targ <- targ*} matches pattern [])), then

          1. If let (EXT json) be val'' matching pattern EXT %, then

            1. (Let (typDef')?{typDef' <- typDef'?} be $find_typ(C, id))

            2. If (((typDef')?{typDef' <- typDef'?} matches pattern (_))), then

              1. (Let ?(typDef) be (typDef')?{typDef' <- typDef'?})

              2. If ((typDef has type externTypDefn)), then

                1. Return ((OK (EXT json)) as castRes)

    3. Case (% matches pattern TUP %, let (TUP (typ)*{typ <- typ*}) = %)

      1. If let (TUP (val)*{val <- val*}) be val'' matching pattern TUP %, then

        1. (Let castsRes be $downcasts(C, (typ)*{typ <- typ*}, (val)*{val <- val*}))

        2. If let (OK (val_cast)*{val_cast <- val_cast*}) of type ok<val*> be castsRes, then

          1. Return ((OK (TUP (val_cast)*{val_cast <- val_cast*})) as castRes)

    4. Case (% matches pattern ITER % %, let (ITER typ iter) = %)

      1. Case analysis on iter (total)

        1. Case (% matches pattern QUEST)

          1. Block (2 arms)

          Arm 1:

            1. If ((val'' = (OPT ?()))), then

              1. Return ((OK (OPT ?())) as castRes)

          Arm 2:

            1. If let (OPT (val')?{val' <- val'?}) be val'' matching pattern OPT %, then

              1. If (((val')?{val' <- val'?} matches pattern (_))), then

                1. (Let ?(val) be (val')?{val' <- val'?})

                2. (Let castRes be $downcast(C, typ, val))

                3. If let (OK val_cast) of type ok<val> be castRes, then

                  1. Return ((OK (OPT ?(val_cast))) as castRes)

        2. Case (% matches pattern STAR)

          1. If let (LIST (val)*{val <- val*}) be val'' matching pattern LIST %, then

            1. (Let (typ'')*{typ'' <- typ''*} be $repeat_<typ>(typ, |(val)*{val <- val*}|))

            2. (Let castsRes be $downcasts(C, (typ'')*{typ'' <- typ''*}, (val)*{val <- val*}))

            3. If let (OK (val_cast)*{val_cast <- val_cast*}) of type ok<val*> be castsRes, then

              1. Return ((OK (LIST (val_cast)*{val_cast <- val_cast*})) as castRes)

    5. Case (% matches pattern FUNC % % %, let (FUNC (tparam)*{tparam <- tparam*} (typ)*{typ <- typ*} typ_ret) = %)

      1. If let (FUNC id) be val'' matching pattern FUNC %, then

        1. (Let (`{ ((id_local ':' typDef_local))*{id_local <- id_local*, typDef_local <- typDef_local*} `}) be C.LOCAL.TYP)

        2. (Let tdenv be $adds_map<id, typDef>(C.GLOBAL.TYP, (id_local)*{id_local <- id_local*}, (typDef_local)*{typDef_local <- typDef_local*}))

        3. If ((((OK true) as subtypRes) = $subtyp(C.GLOBAL.FUNC, tdenv, (FUNC (tparam)*{tparam <- tparam*} (typ)*{typ <- typ*} typ_ret), (FUNC id)))), then

          1. Return ((OK (FUNC id)) as castRes)

Arm 2:

  1. If let optyp of type optyp be typ', then

    1. Case analysis on optyp

      1. Case (% matches pattern BOOL)

        1. If let (BOOL b) be val'' matching pattern BOOL %, then

          1. Return ((OK (BOOL b)) as castRes)

      2. Case (% matches pattern TEXT)

        1. If let (TEXT t) be val'' matching pattern TEXT %, then

          1. Return ((OK (TEXT t)) as castRes)

2. Otherwise,

  1. Return ((ERROR) as castRes)

def $downcasts(C, (typ)*{typ <- typ*}, (val)*{val <- val*})

1. Case analysis on (typ)*{typ <- typ*} (total)

  1. Case (% matches pattern [])

    1. If (((val)*{val <- val*} matches pattern [])), then

      1. Return ((OK []) as castsRes)

  2. Case (% matches pattern _ :: _)

    1. (Let typ_h :: (typ_t)*{typ_t <- typ_t*} be (typ)*{typ <- typ*})

    2. If (((val)*{val <- val*} matches pattern _ :: _)), then

      1. (Let val_h :: (val_t)*{val_t <- val_t*} be (val)*{val <- val*})

      2. (Let castRes be $downcast(C, typ_h, val_h))

      3. If let (OK val_cast) of type ok<val> be castRes, then

        1. (Let castsRes be $downcasts(C, (typ_t)*{typ_t <- typ_t*}, (val_t)*{val_t <- val_t*}))

        2. If let (OK (val_t_cast)*{val_t_cast <- val_t_cast*}) of type ok<val*> be castsRes, then

          1. Return ((OK val_cast :: (val_t_cast)*{val_t_cast <- val_t_cast*}) as castsRes)

2. Otherwise,

  1. Return ((ERROR) as castsRes)

syntax assignRes =
   | OK ctx (from ok<ctx>)
   | ERROR (from error)

relation Assign_exp: C |- typedExp'' := val''' : %

1. (Let (exp '#' typ) be typedExp'')

2. Case analysis on exp

  1. Case (% matches pattern VAR %, let (VAR id) = %)

    1. Group variable: C |- ((VAR id) '#' typ) := val''' : %

      1. (Let C' be $add_varr(C, (id []), val'''))

      2. Result in: % |- % := % : ((OK C') as assignRes)

  2. Case (% matches pattern TUP %, let (TUP (typedExp)*{typedExp <- typedExp*}) = %)

    1. If let (TUP (val)*{val <- val*}) be val''' matching pattern TUP %, then

      1. Group tup: C |- ((TUP (typedExp)*{typedExp <- typedExp*}) '#' typ) := (TUP (val)*{val <- val*}) : %

        1. (Assign_exps: C |- (typedExp)*{typedExp <- typedExp*} := (val)*{val <- val*} : assignRes)

        2. If let (OK C') of type ok<ctx> be assignRes, then

          1. Result in: % |- % := % : ((OK C') as assignRes)

  3. Case (% matches pattern INJ %, let (INJ (mixop (typedExp)*{typedExp <- typedExp*})) = %)

    1. If let (INJ (mixop' (val)*{val <- val*})) be val''' matching pattern INJ %, then

      1. If ((mixop = mixop')), then

        1. Group inj: C |- ((INJ (mixop (typedExp)*{typedExp <- typedExp*})) '#' typ) := (INJ (mixop (val)*{val <- val*})) : %

          1. (Assign_exps: C |- (typedExp)*{typedExp <- typedExp*} := (val)*{val <- val*} : assignRes)

          2. If let (OK C') of type ok<ctx> be assignRes, then

            1. Result in: % |- % := % : ((OK C') as assignRes)

  4. Case (% matches pattern STR %, let (STR (expField)*{expField <- expField*}) = %)

    1. If let (STR (valField)*{valField <- valField*}) be val''' matching pattern STR %, then

      1. Group str: C |- ((STR (expField)*{expField <- expField*}) '#' typ) := (STR (valField)*{valField <- valField*}) : %

        1. (Let (atom val) be valField)*{valField <- valField*, atom -> atom*, val -> val*}

        2. (Let (atom' typedExp) be expField)*{expField <- expField*, atom' -> atom'*, typedExp -> typedExp*}

        3. If ((|(atom)*{atom <- atom*}| = |(atom')*{atom' <- atom'*}|)), then

          1. If ((atom' = atom))*{atom <- atom*, atom' <- atom'*}, then

            1. (Assign_exps: C |- (typedExp)*{typedExp <- typedExp*} := (val)*{val <- val*} : assignRes)

            2. If let (OK C') of type ok<ctx> be assignRes, then

              1. Result in: % |- % := % : ((OK C') as assignRes)

  5. Case (% matches pattern OPT %, let (OPT (typedExp')?{typedExp' <- typedExp'?}) = %)

    1. If let (OPT (val')?{val' <- val'?}) be val''' matching pattern OPT %, then

      1. Group opt: C |- ((OPT (typedExp')?{typedExp' <- typedExp'?}) '#' typ) := (OPT (val')?{val' <- val'?}) : %

        1. Case analysis on (typedExp')?{typedExp' <- typedExp'?} (total)

          1. Case (% matches pattern (_))

            1. (Let ?(typedExp) be (typedExp')?{typedExp' <- typedExp'?})

            2. If (((val')?{val' <- val'?} matches pattern (_))), then

              1. (Let ?(val) be (val')?{val' <- val'?})

              2. (Assign_exp: C |- typedExp := val : assignRes)

              3. If let (OK C') of type ok<ctx> be assignRes, then

                1. Result in: % |- % := % : ((OK C') as assignRes)

          2. Case (% matches pattern ())

            1. If (((val')?{val' <- val'?} matches pattern ())), then

              1. Result in: % |- % := % : ((OK C) as assignRes)

  6. Case (% matches pattern LIST %, let (LIST (typedExp)*{typedExp <- typedExp*}) = %)

    1. If let (LIST (val)*{val <- val*}) be val''' matching pattern LIST %, then

      1. Group list: C |- ((LIST (typedExp)*{typedExp <- typedExp*}) '#' typ) := (LIST (val)*{val <- val*}) : %

        1. (Assign_exps: C |- (typedExp)*{typedExp <- typedExp*} := (val)*{val <- val*} : assignRes)

        2. If let (OK C') of type ok<ctx> be assignRes, then

          1. Result in: % |- % := % : ((OK C') as assignRes)

  7. Case (% matches pattern CONS % %, let (CONS typedExp_h typedExp_t) = %)

    1. If let (LIST (val)*{val <- val*}) be val''' matching pattern LIST %, then

      1. If (((val)*{val <- val*} matches pattern _ :: _)), then

        1. (Let val_h :: (val_t)*{val_t <- val_t*} be (val)*{val <- val*})

        2. Group cons: C |- ((CONS typedExp_h typedExp_t) '#' typ) := (LIST val_h :: (val_t)*{val_t <- val_t*}) : %

          1. (Assign_exp: C |- typedExp_h := val_h : assignRes)

          2. If let (OK C') of type ok<ctx> be assignRes, then

            1. (Assign_exp: C' |- typedExp_t := (LIST (val_t)*{val_t <- val_t*}) : assignRes')

            2. If let (OK C'') of type ok<ctx> be assignRes', then

              1. Result in: % |- % := % : ((OK C'') as assignRes)

  8. Case (% matches pattern ITER % %, let (ITER typedExp expIter) = %)

    1. Group iter: C |- ((ITER typedExp expIter) '#' typ) := val''' : %

      1. Block (3 arms)

      Arm 1:

        1. (Let (varr')?{varr' <- varr'?} be $is_iter_on_var(((ITER typedExp expIter) '#' typ)))

        2. If (((varr')?{varr' <- varr'?} matches pattern (_))), then

          1. (Let ?(varr) be (varr')?{varr' <- varr'?})

          2. (Let C' be $add_varr(C, varr, val'''))

          3. Result in: % |- % := % : ((OK C') as assignRes)

      Arm 2:

        1. If ((val''' = (OPT ?()))), then

          1. If (($is_iter_on_var(((ITER typedExp expIter) '#' typ)) matches pattern ())), then

            1. (Let (iter (vari)*{vari <- vari*}) be expIter)

            2. If ((iter matches pattern QUEST)), then

              1. (Let vari_iter be $iterate_vari((QUEST), vari))*{vari <- vari*, vari_iter -> vari_iter*}

              2. (Let (val_bind)*{val_bind <- val_bind*} be $repeat_<val>((OPT ?()), |(vari_iter)*{vari_iter <- vari_iter*}|))

              3. (Let C' be $add_varis(C, (vari_iter)*{vari_iter <- vari_iter*}, (val_bind)*{val_bind <- val_bind*}))

              4. Result in: % |- % := % : ((OK C') as assignRes)

      Arm 3:

        1. Case analysis on val'''

          1. Case (% matches pattern OPT %, let (OPT (val')?{val' <- val'?}) = %)

            1. If (((val')?{val' <- val'?} matches pattern (_))), then

              1. (Let ?(val) be (val')?{val' <- val'?})

              2. If (($is_iter_on_var(((ITER typedExp expIter) '#' typ)) matches pattern ())), then

                1. (Let (iter (vari)*{vari <- vari*}) be expIter)

                2. If ((iter matches pattern QUEST)), then

                  1. (Assign_exp: C |- typedExp := val : assignRes)

                  2. If let (OK C') of type ok<ctx> be assignRes, then

                    1. (Let vari_iter be $iterate_vari((QUEST), vari))*{vari <- vari*, vari_iter -> vari_iter*}

                    2. (Let (val'')?{val'' <- val''?} be $find_vari(C', vari))*{vari <- vari*, val''? -> val''?*}

                    3. If (((val'')?{val'' <- val''?} matches pattern (_)))*{val''? <- val''?*}, then

                      1. (Let ?(val_sub) be (val'')?{val'' <- val''?})*{val''? <- val''?*, val_sub -> val_sub*}

                      2. (Let C'' be $add_varis(C', (vari_iter)*{vari_iter <- vari_iter*}, ((OPT ?(val_sub)))*{val_sub <- val_sub*}))

                      3. Result in: % |- % := % : ((OK C'') as assignRes)

          2. Case (% matches pattern LIST %, let (LIST (val)*{val <- val*}) = %)

            1. If (($is_iter_on_var(((ITER typedExp expIter) '#' typ)) matches pattern ())), then

              1. (Let (iter (vari)*{vari <- vari*}) be expIter)

              2. If ((iter matches pattern STAR)), then

                1. (Let C_local be C[LOCAL.VAL = $empty_map<varr, val>])

                2. (Assign_exp: C_local |- typedExp := val : assignRes)*{val <- val*, assignRes -> assignRes*}

                3. If ((assignRes has type ok<ctx>))*{assignRes <- assignRes*}, then

                  1. (Let (OK C_sub) be (assignRes as ok<ctx>))*{assignRes <- assignRes*, C_sub -> C_sub*}

                  2. (Let vari_iter be $iterate_vari((STAR), vari))*{vari <- vari*, vari_iter -> vari_iter*}

                  3. (Let ((val')*{val' <- val'*})?{val'* <- val'*?} be $finds_vari((C_sub)*{C_sub <- C_sub*}, vari))*{vari <- vari*, val'*? -> val'*?*}

                  4. If ((((val')*{val' <- val'*})?{val'* <- val'*?} matches pattern (_)))*{val'*? <- val'*?*}, then

                    1. (Let ?((val_sub)*{val_sub <- val_sub*}) be ((val')*{val' <- val'*})?{val'* <- val'*?})*{val'*? <- val'*?*, val_sub* -> val_sub**}

                    2. (Let val_bind be (LIST (val_sub)*{val_sub <- val_sub*}))*{val_sub* <- val_sub**, val_bind -> val_bind*}

                    3. (Let C' be $add_varis(C, (vari_iter)*{vari_iter <- vari_iter*}, (val_bind)*{val_bind <- val_bind*}))

                    4. Result in: % |- % := % : ((OK C') as assignRes)

3. Otherwise,

  1. Group error: C |- typedExp'' := val''' : %

    1. Result in: % |- % := % : ((ERROR) as assignRes)

relation Assign_exps: C |- (typedExp)*{typedExp <- typedExp*} := (val)*{val <- val*} : %

1. Group : C |- (typedExp)*{typedExp <- typedExp*} := (val)*{val <- val*} : %

  1. Case analysis on (typedExp)*{typedExp <- typedExp*} (total)

    1. Case (% matches pattern [])

      1. If (((val)*{val <- val*} matches pattern [])), then

        1. Result in: % |- % := % : ((OK C) as assignRes)

    2. Case (% matches pattern _ :: _)

      1. (Let typedExp_h :: (typedExp_t)*{typedExp_t <- typedExp_t*} be (typedExp)*{typedExp <- typedExp*})

      2. If (((val)*{val <- val*} matches pattern _ :: _)), then

        1. (Let val_h :: (val_t)*{val_t <- val_t*} be (val)*{val <- val*})

        2. (Assign_exp: C |- typedExp_h := val_h : assignRes)

        3. If let (OK C') of type ok<ctx> be assignRes, then

          1. (Assign_exps: C' |- (typedExp_t)*{typedExp_t <- typedExp_t*} := (val_t)*{val_t <- val_t*} : assignRes')

          2. If let (OK C'') of type ok<ctx> be assignRes', then

            1. Result in: % |- % := % : ((OK C'') as assignRes)

2. Otherwise,

  1. Group error: C |- (typedExp)*{typedExp <- typedExp*} := (val)*{val <- val*} : %

    1. Result in: % |- % := % : ((ERROR) as assignRes)

relation Assign_arg: C |- arg := val : %

1. Case analysis on arg (total)

  1. Case (% matches pattern EXP %, let (EXP typedExp) = %)

    1. Group exp: C |- (EXP typedExp) := val : %

      1. (Assign_exp: C |- typedExp := val : assignRes)

      2. If let (OK C') of type ok<ctx> be assignRes, then

        1. Result in: % |- % := % : ((OK C') as assignRes)

  2. Case (% matches pattern FUN %, let (FUN id) = %)

    1. If let (FUNC id_global) be val matching pattern FUNC %, then

      1. Group fun: C |- (FUN id) := (FUNC id_global) : %

        1. (Let C' be $add_func(C, id, id_global))

        2. Result in: % |- % := % : ((OK C') as assignRes)

2. Otherwise,

  1. Group error: C |- arg := val : %

    1. Result in: % |- % := % : ((ERROR) as assignRes)

relation Assign_args: C |- (arg)*{arg <- arg*} := (val)*{val <- val*} : %

1. Group : C |- (arg)*{arg <- arg*} := (val)*{val <- val*} : %

  1. Case analysis on (arg)*{arg <- arg*} (total)

    1. Case (% matches pattern [])

      1. If (((val)*{val <- val*} matches pattern [])), then

        1. Result in: % |- % := % : ((OK C) as assignRes)

    2. Case (% matches pattern _ :: _)

      1. (Let arg_h :: (arg_t)*{arg_t <- arg_t*} be (arg)*{arg <- arg*})

      2. If (((val)*{val <- val*} matches pattern _ :: _)), then

        1. (Let val_h :: (val_t)*{val_t <- val_t*} be (val)*{val <- val*})

        2. (Assign_arg: C |- arg_h := val_h : assignRes)

        3. If let (OK C') of type ok<ctx> be assignRes, then

          1. (Assign_args: C' |- (arg_t)*{arg_t <- arg_t*} := (val_t)*{val_t <- val_t*} : assignRes')

          2. If let (OK C'') of type ok<ctx> be assignRes', then

            1. Result in: % |- % := % : ((OK C'') as assignRes)

2. Otherwise,

  1. Group error: C |- (arg)*{arg <- arg*} := (val)*{val <- val*} : %

    1. Result in: % |- % := % : ((ERROR) as assignRes)

relation Eval_clause: C |- clauseAL `( (val)*{val <- val*} `) : %

1. Group : C |- clauseAL `( (val)*{val <- val*} `) : %

  1. (Let ((arg)*{arg <- arg*} '=' typedExp_out '-' (premAL)*{premAL <- premAL*}) be clauseAL)

  2. (Assign_args: C |- (arg)*{arg <- arg*} := (val)*{val <- val*} : assignRes)

  3. If let (OK C') of type ok<ctx> be assignRes, then

    1. (Eval_prems: C' |- (premAL)*{premAL <- premAL*} : premRes)

    2. Case analysis on premRes (total)

      1. Case (% has type failure, let failure = %)

        1. Result in: % |- % `( % `) : (failure as funcRes)

      2. Case (% has type ok<ctx>, let (OK C'') = %)

        1. (Eval_exp: C'' |- typedExp_out : expRes)

        2. If let funcRes of type funcRes be expRes, then

          1. Result in: % |- % `( % `) : funcRes

2. Otherwise,

  1. Group error: C |- clauseAL `( (val)*{val <- val*} `) : %

    1. Result in: % |- % `( % `) : ((ERROR) as funcRes)

relation Eval_clauses: C |- (clauseAL)*{clauseAL <- clauseAL*} `( (val)*{val <- val*} `) : %

1. Group : C |- (clauseAL)*{clauseAL <- clauseAL*} `( (val)*{val <- val*} `) : %

  1. Case analysis on (clauseAL)*{clauseAL <- clauseAL*} (total)

    1. Case (% matches pattern [])

      1. Result in: % |- % `( % `) : ((UNMATCH) as funcRes)

    2. Case (% matches pattern _ :: _)

      1. (Let clauseAL_h :: (clauseAL_t)*{clauseAL_t <- clauseAL_t*} be (clauseAL)*{clauseAL <- clauseAL*})

      2. (Eval_clause: C |- clauseAL_h `( (val)*{val <- val*} `) : funcRes')

      3. Case analysis on funcRes'

        1. Case (% has type unmatch, let unmatch = %)

          1. (Eval_clauses: C |- (clauseAL_t)*{clauseAL_t <- clauseAL_t*} `( (val)*{val <- val*} `) : funcRes)

          2. Result in: % |- % `( % `) : funcRes

        2. Case (% has type ok<val>, let (OK val_out) = %)

          1. (Eval_clauses_on_ok: C |- (clauseAL_t)*{clauseAL_t <- clauseAL_t*} `( (val)*{val <- val*} `) : unitRes)

          2. If ((unitRes matches pattern OK)), then

            1. Result in: % |- % `( % `) : ((OK val_out) as funcRes)

2. Otherwise,

  1. Group error: C |- (clauseAL)*{clauseAL <- clauseAL*} `( (val)*{val <- val*} `) : %

    1. Result in: % |- % `( % `) : ((ERROR) as funcRes)

relation Eval_clauses_on_ok: C |- (clauseAL)*{clauseAL <- clauseAL*} `( (val)*{val <- val*} `) : %

1. Group : C |- (clauseAL)*{clauseAL <- clauseAL*} `( (val)*{val <- val*} `) : %

  1. Case analysis on (clauseAL)*{clauseAL <- clauseAL*} (total)

    1. Case (% matches pattern [])

      1. Result in: % |- % `( % `) : (OK)

    2. Case (% matches pattern _ :: _)

      1. (Let clauseAL_h :: (clauseAL_t)*{clauseAL_t <- clauseAL_t*} be (clauseAL)*{clauseAL <- clauseAL*})

      2. (Eval_clause: C |- clauseAL_h `( (val)*{val <- val*} `) : funcRes)

      3. Block (2 arms)

      Arm 1:

        1. If let unmatch of type unmatch be funcRes, then

          1. (Eval_clauses_on_ok: C |- (clauseAL_t)*{clauseAL_t <- clauseAL_t*} `( (val)*{val <- val*} `) : unitRes)

          2. Result in: % |- % `( % `) : unitRes

        1. Else Dangling

      Arm 2:

        1. Check ((funcRes =/= ((UNMATCH) as funcRes)))

          1. Result in: % |- % `( % `) : ((ERROR) as unitRes)

relation Eval_tblrow: C |- tblRowAL `( (val)*{val <- val*} `) : %

1. Group : C |- tblRowAL `( (val)*{val <- val*} `) : %

  1. (Let ((arg)*{arg <- arg*} '=' typedExp_out '-' (premAL)*{premAL <- premAL*}) be tblRowAL)

  2. (Let C_callee be C[LOCAL = $empty_localLayer])

  3. (Assign_args: C_callee |- (arg)*{arg <- arg*} := (val)*{val <- val*} : assignRes)

  4. If let (OK C_callee') of type ok<ctx> be assignRes, then

    1. (Eval_prems: C_callee' |- (premAL)*{premAL <- premAL*} : premRes)

    2. Case analysis on premRes (total)

      1. Case (% has type failure, let failure = %)

        1. Result in: % |- % `( % `) : (failure as funcRes)

      2. Case (% has type ok<ctx>, let (OK C_callee'') = %)

        1. (Eval_exp: C_callee'' |- typedExp_out : expRes)

        2. If let funcRes of type funcRes be expRes, then

          1. Result in: % |- % `( % `) : funcRes

2. Otherwise,

  1. Group error: C |- tblRowAL `( (val)*{val <- val*} `) : %

    1. Result in: % |- % `( % `) : ((ERROR) as funcRes)

relation Eval_tblrows: C |- (tblRowAL)*{tblRowAL <- tblRowAL*} `( (val)*{val <- val*} `) : %

1. Group : C |- (tblRowAL)*{tblRowAL <- tblRowAL*} `( (val)*{val <- val*} `) : %

  1. Case analysis on (tblRowAL)*{tblRowAL <- tblRowAL*} (total)

    1. Case (% matches pattern [])

      1. Result in: % |- % `( % `) : ((UNMATCH) as funcRes)

    2. Case (% matches pattern _ :: _)

      1. (Let tblRowAL_h :: (tblRowAL_t)*{tblRowAL_t <- tblRowAL_t*} be (tblRowAL)*{tblRowAL <- tblRowAL*})

      2. (Eval_tblrow: C |- tblRowAL_h `( (val)*{val <- val*} `) : funcRes')

      3. Block (2 arms)

      Arm 1:

        1. If let unmatch of type unmatch be funcRes', then

          1. (Eval_tblrows: C |- (tblRowAL_t)*{tblRowAL_t <- tblRowAL_t*} `( (val)*{val <- val*} `) : funcRes)

          2. Result in: % |- % `( % `) : funcRes

        1. Else Dangling

      Arm 2:

        1. Check ((funcRes' =/= ((UNMATCH) as funcRes)))

          1. Result in: % |- % `( % `) : funcRes'

relation Call_table_func: C |- tableFuncDefnAL `( (val)*{val <- val*} `) : %

1. Group : C |- tableFuncDefnAL `( (val)*{val <- val*} `) : %

  1. (Let (TABLEFUNC _id (_param)*{_param <- _param*} ':' _typ '=' (tblRowAL)*{tblRowAL <- tblRowAL*}) be tableFuncDefnAL)

  2. (Eval_tblrows: C |- (tblRowAL)*{tblRowAL <- tblRowAL*} `( (val)*{val <- val*} `) : funcRes)

  3. Result in: % |- % `( % `) : funcRes

relation Call_defined_func: C |- definedFuncDefnAL `< (typ)*{typ <- typ*} `> `( (val)*{val <- val*} `) : %

1. Group : C |- definedFuncDefnAL `< (typ)*{typ <- typ*} `> `( (val)*{val <- val*} `) : %

  1. (Let (FUNC _id (tparam)*{tparam <- tparam*} (_param)*{_param <- _param*} ':' _typ '=' (clauseAL)*{clauseAL <- clauseAL*} (elsClauseAL)?{elsClauseAL <- elsClauseAL?}) be definedFuncDefnAL)

  2. If ((|(tparam)*{tparam <- tparam*}| = |(typ)*{typ <- typ*}|)), then

    1. (Let tdenv be (`{ ((tparam ':' ((TYP tparam [] '=' (ALIAS typ)) as typDef)))*{tparam <- tparam*, typ <- typ*} `}))

    2. (Let C_callee be C[LOCAL = $empty_localLayer[TYP = tdenv]])

    3. (Eval_clauses: C_callee |- (clauseAL)*{clauseAL <- clauseAL*} `( (val)*{val <- val*} `) : funcRes')

    4. Block (2 arms)

    Arm 1:

      1. If let unmatch of type unmatch be funcRes', then

        1. (Eval_clause: C_callee |- elsClauseAL `( (val)*{val <- val*} `) : funcRes_els)?{elsClauseAL <- elsClauseAL?, funcRes_els -> funcRes_els?}

        2. (Let funcRes be $deopt_<funcRes>((funcRes_els)?{funcRes_els <- funcRes_els?}, ((UNMATCH) as funcRes)))

        3. Result in: % |- % `< % `> `( % `) : funcRes

    Arm 2:

      1. If ((funcRes' =/= ((UNMATCH) as funcRes))), then

        1. Result in: % |- % `< % `> `( % `) : funcRes'

2. Otherwise,

  1. Group error: C |- definedFuncDefnAL `< (typ)*{typ <- typ*} `> `( (val)*{val <- val*} `) : %

    1. Result in: % |- % `< % `> `( % `) : ((ERROR) as funcRes)

relation Eval_rul: C |- rulAL `( (val)*{val <- val*} `) : %

1. (Let (id ':' (typedExp)*{typedExp <- typedExp*} '->' (typedExp')*{typedExp' <- typedExp'*} '-' (premAL)*{premAL <- premAL*}) be rulAL)

2. Group : C |- (id ':' (typedExp)*{typedExp <- typedExp*} '->' (typedExp')*{typedExp' <- typedExp'*} '-' (premAL)*{premAL <- premAL*}) `( (val)*{val <- val*} `) : %

  1. (Assign_exps: C |- (typedExp)*{typedExp <- typedExp*} := (val)*{val <- val*} : assignRes)

  2. If let (OK C') of type ok<ctx> be assignRes, then

    1. (Eval_prems: C' |- (premAL)*{premAL <- premAL*} : premRes)

    2. Case analysis on premRes (total)

      1. Case (% has type failure, let failure = %)

        1. Result in: % |- % `( % `) : (failure as relRes)

      2. Case (% has type ok<ctx>, let (OK C'') = %)

        1. (Eval_exps: C'' |- (typedExp')*{typedExp' <- typedExp'*} : expsRes)

        2. If let relRes of type relRes be expsRes, then

          1. Result in: % |- % `( % `) : relRes

3. Otherwise,

  1. Group error: C |- rulAL `( (val)*{val <- val*} `) : %

    1. Result in: % |- % `( % `) : ((ERROR) as relRes)

relation Eval_ruls: C |- (rulAL)*{rulAL <- rulAL*} `( (val)*{val <- val*} `) : %

1. Group : C |- (rulAL)*{rulAL <- rulAL*} `( (val)*{val <- val*} `) : %

  1. Case analysis on (rulAL)*{rulAL <- rulAL*} (total)

    1. Case (% matches pattern [])

      1. Result in: % |- % `( % `) : ((UNMATCH) as relRes)

    2. Case (% matches pattern _ :: _)

      1. (Let rulAL_h :: (rulAL_t)*{rulAL_t <- rulAL_t*} be (rulAL)*{rulAL <- rulAL*})

      2. (Eval_rul: C |- rulAL_h `( (val)*{val <- val*} `) : relRes')

      3. Case analysis on relRes'

        1. Case (% has type unmatch, let unmatch = %)

          1. (Eval_ruls: C |- (rulAL_t)*{rulAL_t <- rulAL_t*} `( (val)*{val <- val*} `) : relRes)

          2. Result in: % |- % `( % `) : relRes

        2. Case (% has type ok<val*>, let (OK (val_out)*{val_out <- val_out*}) = %)

          1. (Eval_ruls_on_ok: C |- (rulAL_t)*{rulAL_t <- rulAL_t*} `( (val)*{val <- val*} `) : unitRes)

          2. If ((unitRes matches pattern OK)), then

            1. Result in: % |- % `( % `) : ((OK (val_out)*{val_out <- val_out*}) as relRes)

2. Otherwise,

  1. Group error: C |- (rulAL)*{rulAL <- rulAL*} `( (val)*{val <- val*} `) : %

    1. Result in: % |- % `( % `) : ((ERROR) as relRes)

relation Eval_ruls_on_ok: C |- (rulAL)*{rulAL <- rulAL*} `( (val)*{val <- val*} `) : %

1. Group : C |- (rulAL)*{rulAL <- rulAL*} `( (val)*{val <- val*} `) : %

  1. Case analysis on (rulAL)*{rulAL <- rulAL*} (total)

    1. Case (% matches pattern [])

      1. Result in: % |- % `( % `) : (OK)

    2. Case (% matches pattern _ :: _)

      1. (Let rulAL_h :: (rulAL_t)*{rulAL_t <- rulAL_t*} be (rulAL)*{rulAL <- rulAL*})

      2. (Eval_rul: C |- rulAL_h `( (val)*{val <- val*} `) : relRes)

      3. Block (2 arms)

      Arm 1:

        1. If let unmatch of type unmatch be relRes, then

          1. (Eval_ruls_on_ok: C |- (rulAL_t)*{rulAL_t <- rulAL_t*} `( (val)*{val <- val*} `) : unitRes)

          2. Result in: % |- % `( % `) : unitRes

        1. Else Dangling

      Arm 2:

        1. Check ((relRes =/= ((UNMATCH) as relRes)))

          1. Result in: % |- % `( % `) : ((ERROR) as unitRes)

relation Call_defined_rel: C |- definedRelDefnAL `( (val)*{val <- val*} `) : %

1. Group : C |- definedRelDefnAL `( (val)*{val <- val*} `) : %

  1. (Let (REL _id ':' (_typ)*{_typ <- _typ*} '->' (_typ')*{_typ' <- _typ'*} '=' (rulGroupAL)*{rulGroupAL <- rulGroupAL*} (elsGroupAL)?{elsGroupAL <- elsGroupAL?}) be definedRelDefnAL)

  2. (Let C_local be C[LOCAL = $empty_localLayer])

  3. (Let (rulAL)*{rulAL <- rulAL*} be $ruls_of_rulgroups((rulGroupAL)*{rulGroupAL <- rulGroupAL*}))

  4. (Eval_ruls: C_local |- (rulAL)*{rulAL <- rulAL*} `( (val)*{val <- val*} `) : relRes')

  5. Block (2 arms)

  Arm 1:

    1. If let unmatch of type unmatch be relRes', then

      1. (Let rulAL_els be $rul_of_elsgroup(elsGroupAL))?{elsGroupAL <- elsGroupAL?, rulAL_els -> rulAL_els?}

      2. (Eval_rul: C_local |- rulAL_els `( (val)*{val <- val*} `) : relRes_els)?{rulAL_els <- rulAL_els?, relRes_els -> relRes_els?}

      3. (Let relRes be $deopt_<relRes>((relRes_els)?{relRes_els <- relRes_els?}, ((UNMATCH) as relRes)))

      4. Result in: % |- % `( % `) : relRes

  Arm 2:

    1. If ((relRes' =/= ((UNMATCH) as relRes))), then

      1. Result in: % |- % `( % `) : relRes'

2. Otherwise,

  1. Group error: C |- definedRelDefnAL `( (val)*{val <- val*} `) : %

    1. Result in: % |- % `( % `) : ((ERROR) as relRes)

def $ruls_of_rulgroup((id ':' (rulAL)*{rulAL <- rulAL*}))

1. Return (rulAL)*{rulAL <- rulAL*}

def $ruls_of_rulgroups((rulGroupAL)*{rulGroupAL <- rulGroupAL*})

1. Case analysis on (rulGroupAL)*{rulGroupAL <- rulGroupAL*} (total)

  1. Case (% matches pattern [])

    1. Return []

  2. Case (% matches pattern _ :: _)

    1. (Let rulGroupAL_h :: (rulGroupAL_t)*{rulGroupAL_t <- rulGroupAL_t*} be (rulGroupAL)*{rulGroupAL <- rulGroupAL*})

    2. (Let (rulAL)*{rulAL <- rulAL*} be $ruls_of_rulgroup(rulGroupAL_h))

    3. (Let (rulAL')*{rulAL' <- rulAL'*} be $ruls_of_rulgroups((rulGroupAL_t)*{rulGroupAL_t <- rulGroupAL_t*}))

    4. Return (rulAL)*{rulAL <- rulAL*} ++ (rulAL')*{rulAL' <- rulAL'*}

def $rul_of_elsgroup((id ':' rulAL))

1. Return rulAL

relation Eval_AL: |- specAL : %

1. Group : |- specAL : %

  1. Debug: "entry-al"

  2. (Let C be $load_ctx($empty_ctx, specAL))

  3. Debug: "load complete"

  4. Debug: "into call"

  5. (Call_func: C |- "main" `< [] `> `( [] `) : funcRes)

  6. Check ((funcRes has type ok<val>))

    1. (Let (OK val) be (funcRes as ok<val>))

    2. Debug: val

    3. Result in: |- % : val
