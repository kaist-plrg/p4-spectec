relation Partialbind_exp: AC IC |- typedExp : % % % %

1. Case analysis on $is_bound_exp(AC, typedExp) (total)

  1. Case true

    1. (Let vari_read*{vari_read <- vari_read*} be $free_varis_exp(typedExp))

      1. If ($is_bound_varis(AC, IC, vari_read*{vari_read <- vari_read*})), then

        1. (Let _exp '#' typ be typedExp)

          1. (Let (id_used*{id_used <- id_used*}, id_d) be $fresh_id(AC.USED))

            1. (Let AC_fresh be AC[USED = id_used*{id_used <- id_used*}])

              1. (Let vari_d be id_d typ [])

                1. (Let typedExp_d be $exp_of_vari(vari_d))

                  1. (Let cmpOpExp be CMP EQ as cmpOp typedExp_d typedExp)

                    1. (Let typedExp_check be cmpOpExp as exp '#' BOOL as typ)

                      1. (Let id_read*{id_read <- id_read*} be $ids_of_varis(vari_read*{vari_read <- vari_read*}))

                        1. (Let IC_d be $add_iterated(IC, [vari_d]))

                          1. (Let premIterAL*{premIterAL <- premIterAL*} be $prem_iters(IC_d, id_d :: id_read*{id_read <- id_read*}, []))

                            1. (Let premAL_check be $iterate_prem(IF typedExp_check as premAL, premIterAL*{premIterAL <- premIterAL*}))

                              1. (Let IC_fresh be $add_iterated(IC, [vari_d]))

                                1. Result in: % % |- % : AC_fresh IC_fresh typedExp_d [premAL_check]

      1. Else Dangling

  2. Case false

    1. (Partialbind_binder_exp: AC IC |- typedExp : AC_part IC_part typedExp_part premAL*{premAL <- premAL*})

      1. Result in: % % |- % : AC_part IC_part typedExp_part premAL*{premAL <- premAL*}

relation Partialbind_binder_exp: AC IC |- exp '#' typ : % % % %

1. Case analysis on exp

  1. Case (% has type varExp)

    1. (Let varExp be exp as varExp)

      1. Result in: % % |- % : AC IC varExp as exp '#' typ []

  2. Case (% has type upCastExp)

    1. (Let upCastExp be exp as upCastExp)

      1. (Let UPCAST _typ typedExp be upCastExp)

        1. (Partialbind_exp: AC IC |- typedExp : AC_sub IC_sub typedExp_sub premAL*{premAL <- premAL*})

          1. (Let _exp '#' typ_sub be typedExp_sub)

            1. (Let (id_used*{id_used <- id_used*}, id_d) be $fresh_id(AC_sub.USED))

              1. (Let AC_fresh be AC_sub[USED = id_used*{id_used <- id_used*}])

                1. (Let vari_d be id_d typ [])

                  1. (Let typedExp_d be $exp_of_vari(vari_d))

                    1. (Let subExp be SUB typedExp_d typ_sub)

                      1. (Let typedExp_check be subExp as exp '#' BOOL as typ)

                        1. (Let premAL_check be $sidecond_partial(IC_sub, vari_d, typedExp_check))

                          1. (Let downCastExp be DOWNCAST typ_sub typedExp_d)

                            1. (Let typedExp_down be downCastExp as exp '#' typ_sub)

                              1. (Let premAL_let be $prem_let_partial(IC_sub, vari_d, typedExp_sub, typedExp_down))

                                1. (Let IC_fresh be $add_iterated(IC_sub, [vari_d]))

                                  1. (Let premAL_part*{premAL_part <- premAL_part*} be premAL_check :: premAL_let :: premAL*{premAL <- premAL*})

                                    1. Result in: % % |- % : AC_fresh IC_fresh typedExp_d premAL_part*{premAL_part <- premAL_part*}

  3. Case (% has type tupExp)

    1. (Let tupExp be exp as tupExp)

      1. (Let TUP typedExp*{typedExp <- typedExp*} be tupExp)

        1. (Partialbind_exps: AC IC |- typedExp*{typedExp <- typedExp*} : AC_sub IC_sub typedExp_part*{typedExp_part <- typedExp_part*} premAL*{premAL <- premAL*})

          1. (Let tupExp_part be TUP typedExp_part*{typedExp_part <- typedExp_part*})

            1. Result in: % % |- % : AC_sub IC_sub tupExp_part as exp '#' typ premAL*{premAL <- premAL*}

  4. Case (% has type injExp)

    1. (Let injExp be exp as injExp)

      1. (Let INJ mixop typedExp*{typedExp <- typedExp*} be injExp)

        1. (Partialbind_exps: AC IC |- typedExp*{typedExp <- typedExp*} : AC_sub IC_sub typedExp_part*{typedExp_part <- typedExp_part*} premAL*{premAL <- premAL*})

          1. (Let (id_used*{id_used <- id_used*}, id_d) be $fresh_id(AC_sub.USED))

            1. (Let AC_fresh be AC_sub[USED = id_used*{id_used <- id_used*}])

              1. (Let vari_d be id_d typ [])

                1. (Let typedExp_d be $exp_of_vari(vari_d))

                  1. (Let matchExp be MATCH typedExp_d INJ mixop)

                    1. (Let typedExp_check be matchExp as exp '#' BOOL as typ)

                      1. (Let premAL_check be $sidecond_partial(IC_sub, vari_d, typedExp_check))

                        1. (Let injExp_part be INJ mixop typedExp_part*{typedExp_part <- typedExp_part*})

                          1. (Let typedExp_case be injExp_part as exp '#' typ)

                            1. (Let premAL_let be $prem_let_partial(IC_sub, vari_d, typedExp_case, typedExp_d))

                              1. (Let IC_fresh be $add_iterated(IC_sub, [vari_d]))

                                1. (Let premAL_part*{premAL_part <- premAL_part*} be premAL_check :: premAL_let :: premAL*{premAL <- premAL*})

                                  1. Result in: % % |- % : AC_fresh IC_fresh typedExp_d premAL_part*{premAL_part <- premAL_part*}

  5. Case (% has type strExp)

    1. (Let strExp be exp as strExp)

      1. (Let STR expField*{expField <- expField*} be strExp)

        1. (Let atom typedExp be expField)*{expField <- expField*, atom -> atom*, typedExp -> typedExp*}

          1. (Partialbind_exps: AC IC |- typedExp*{typedExp <- typedExp*} : AC_sub IC_sub typedExp_part*{typedExp_part <- typedExp_part*} premAL*{premAL <- premAL*})

            1. If ((|atom*{atom <- atom*}| = |typedExp_part*{typedExp_part <- typedExp_part*}|)), then

              1. (Let expField_part be atom typedExp_part)*{atom <- atom*, typedExp_part <- typedExp_part*, expField_part -> expField_part*}

                1. (Let strExp_part be STR expField_part*{expField_part <- expField_part*})

                  1. Result in: % % |- % : AC_sub IC_sub strExp_part as exp '#' typ premAL*{premAL <- premAL*}

            1. Else Dangling

  6. Case (% has type optExp)

    1. (Let optExp be exp as optExp)

      1. (Let OPT typedExp'?{typedExp' <- typedExp'?} be optExp)

        1. If (typedExp'?{typedExp' <- typedExp'?} matches (_)), then

          1. (Let ?(typedExp) be typedExp'?{typedExp' <- typedExp'?})

            1. (Partialbind_exp: AC IC |- typedExp : AC_sub IC_sub typedExp_part premAL*{premAL <- premAL*})

              1. (Let (id_used*{id_used <- id_used*}, id_d) be $fresh_id(AC_sub.USED))

                1. (Let AC_fresh be AC_sub[USED = id_used*{id_used <- id_used*}])

                  1. (Let vari_d be id_d typ [])

                    1. (Let typedExp_d be $exp_of_vari(vari_d))

                      1. (Let matchExp be MATCH typedExp_d SOME as pat)

                        1. (Let typedExp_check be matchExp as exp '#' BOOL as typ)

                          1. (Let premAL_check be $sidecond_partial(IC_sub, vari_d, typedExp_check))

                            1. (Let optExp_part be OPT ?(typedExp_part))

                              1. (Let typedExp_opt be optExp_part as exp '#' typ)

                                1. (Let premAL_let be $prem_let_partial(IC_sub, vari_d, typedExp_opt, typedExp_d))

                                  1. (Let IC_fresh be $add_iterated(IC_sub, [vari_d]))

                                    1. (Let premAL_part*{premAL_part <- premAL_part*} be premAL_check :: premAL_let :: premAL*{premAL <- premAL*})

                                      1. Result in: % % |- % : AC_fresh IC_fresh typedExp_d premAL_part*{premAL_part <- premAL_part*}

        1. Else Dangling

  7. Case (% has type listExp)

    1. (Let listExp be exp as listExp)

      1. (Let LIST typedExp*{typedExp <- typedExp*} be listExp)

        1. (Partialbind_exps: AC IC |- typedExp*{typedExp <- typedExp*} : AC_sub IC_sub typedExp_part*{typedExp_part <- typedExp_part*} premAL*{premAL <- premAL*})

          1. (Let (id_used*{id_used <- id_used*}, id_d) be $fresh_id(AC_sub.USED))

            1. (Let AC_fresh be AC_sub[USED = id_used*{id_used <- id_used*}])

              1. (Let vari_d be id_d typ [])

                1. (Let typedExp_d be $exp_of_vari(vari_d))

                  1. (Let n be |typedExp*{typedExp <- typedExp*}|)

                    1. (Let matchExp be MATCH typedExp_d FIXED n as pat)

                      1. (Let typedExp_check be matchExp as exp '#' BOOL as typ)

                        1. (Let premAL_check be $sidecond_partial(IC_sub, vari_d, typedExp_check))

                          1. (Let listExp_part be LIST typedExp_part*{typedExp_part <- typedExp_part*})

                            1. (Let typedExp_list be listExp_part as exp '#' typ)

                              1. (Let premAL_let be $prem_let_partial(IC_sub, vari_d, typedExp_list, typedExp_d))

                                1. (Let IC_fresh be $add_iterated(IC_sub, [vari_d]))

                                  1. (Let premAL_part*{premAL_part <- premAL_part*} be premAL_check :: premAL_let :: premAL*{premAL <- premAL*})

                                    1. Result in: % % |- % : AC_fresh IC_fresh typedExp_d premAL_part*{premAL_part <- premAL_part*}

  8. Case (% has type consExp)

    1. (Let consExp be exp as consExp)

      1. (Let CONS typedExp_h typedExp_t be consExp)

        1. (Partialbind_exp: AC IC |- typedExp_h : AC_h IC_h typedExp_h_part premAL_h*{premAL_h <- premAL_h*})

          1. (Partialbind_exp: AC_h IC_h |- typedExp_t : AC_t IC_t typedExp_t_part premAL_t*{premAL_t <- premAL_t*})

            1. (Let (id_used*{id_used <- id_used*}, id_d) be $fresh_id(AC_t.USED))

              1. (Let AC_fresh be AC_t[USED = id_used*{id_used <- id_used*}])

                1. (Let vari_d be id_d typ [])

                  1. (Let typedExp_d be $exp_of_vari(vari_d))

                    1. (Let matchExp be MATCH typedExp_d CONS as pat)

                      1. (Let typedExp_check be matchExp as exp '#' BOOL as typ)

                        1. (Let premAL_check be $sidecond_partial(IC_t, vari_d, typedExp_check))

                          1. (Let consExp_part be CONS typedExp_h_part typedExp_t_part)

                            1. (Let typedExp_cons be consExp_part as exp '#' typ)

                              1. (Let premAL_let be $prem_let_partial(IC_t, vari_d, typedExp_cons, typedExp_d))

                                1. (Let IC_fresh be $add_iterated(IC_t, [vari_d]))

                                  1. (Let premAL_part*{premAL_part <- premAL_part*} be premAL_check :: premAL_let :: premAL_h*{premAL_h <- premAL_h*} ++ premAL_t*{premAL_t <- premAL_t*})

                                    1. Result in: % % |- % : AC_fresh IC_fresh typedExp_d premAL_part*{premAL_part <- premAL_part*}

  9. Case (% has type iterExp)

    1. (Let iterExp be exp as iterExp)

      1. (Let ITER typedExp iter vari*{vari <- vari*} be iterExp)

        1. (Let IC' be iter vari*{vari <- vari*} :: IC)

          1. (Partialbind_exp: AC IC' |- typedExp : AC_sub IC'' typedExp_part premAL*{premAL <- premAL*})

            1. (Let premIterIL*{premIterIL <- premIterIL*} be IC'')

              1. If (premIterIL*{premIterIL <- premIterIL*} matches _ :: _), then

                1. (Let iter' vari_iter*{vari_iter <- vari_iter*} :: IC_sub be premIterIL*{premIterIL <- premIterIL*})

                  1. If ((iter' = iter)), then

                    1. (Let vari_part*{vari_part <- vari_part*} be $select_varis(vari_iter*{vari_iter <- vari_iter*}, $ids_of_varis($free_varis_exp(typedExp_part))))

                      1. (Let iterExp_part be ITER typedExp_part iter vari_part*{vari_part <- vari_part*})

                        1. Result in: % % |- % : AC_sub IC_sub iterExp_part as exp '#' typ premAL*{premAL <- premAL*}

                  1. Else Dangling

              1. Else Dangling

1. Else Dangling

relation Partialbind_exps: AC IC |- typedExp'*{typedExp' <- typedExp'*} : % % % %

1. Case analysis on typedExp'*{typedExp' <- typedExp'*} (total)

  1. Case (% matches pattern [])

