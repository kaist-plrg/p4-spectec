        1. (Bind_exps: AC_rul [] |- typedExp_in*{typedExp_in <- typedExp_in*} : AC_in typedExp_in_part*{typedExp_in_part <- typedExp_in_part*} premAL_bind*{premAL_bind <- premAL_bind*})

          1. (Algo_prems: AC_in |- premIL*{premIL <- premIL*} : AC_body premAL*{premAL <- premAL*})

            1. (Let vari_out*{vari_out <- vari_out*} be $free_varis_exps(typedExp_out*{typedExp_out <- typedExp_out*}))

              1. If ($is_bound_varis(AC_body, [], vari_out*{vari_out <- vari_out*})), then

                1. (Let rulAL be id ':' typedExp_in_part*{typedExp_in_part <- typedExp_in_part*} '->' typedExp_out*{typedExp_out <- typedExp_out*} '-' premAL_bind*{premAL_bind <- premAL_bind*} ++ premAL*{premAL <- premAL*})

                  1. Result in: % % |- % : rulAL

              1. Else Dangling

