relation Algo_tblRow: AC |- tblRowIL : %

1. (Let arg*{arg <- arg*} '=' typedExp be tblRowIL)

  1. (Let id_used*{id_used <- id_used*} be $ids_of_varis($free_varis_tblRowIL(tblRowIL)))

    1. (Let AC_row be $add_used(AC, id_used*{id_used <- id_used*}))

      1. If (Shallowbind_args: AC_row |- arg*{arg <- arg*}) holds, then

        1. (Bind_args: AC_row |- arg*{arg <- arg*} : AC_body arg_part*{arg_part <- arg_part*} premAL*{premAL <- premAL*})

          1. (Let vari_body*{vari_body <- vari_body*} be $free_varis_exp(typedExp))

            1. If ($is_bound_varis(AC_body, [], vari_body*{vari_body <- vari_body*})), then

              1. (Let tblRowAL be arg_part*{arg_part <- arg_part*} '=' typedExp '-' premAL*{premAL <- premAL*})

                1. Result in: % |- % : tblRowAL

            1. Else Dangling

      1. Else Dangling

relation Cover_tblRows: AC typ*{typ <- typ*} |- tblRowIL*{tblRowIL <- tblRowIL*}

1. (Let cases_key be $cases_typ(AC.TYP, typ))*{typ <- typ*, cases_key -> cases_key*}

  1. (Let combination*{combination <- combination*} be $combinations_cases(cases_key*{cases_key <- cases_key*}))

    1. (Let arg*{arg <- arg*} '=' _typedExp be tblRowIL)*{tblRowIL <- tblRowIL*, _typedExp -> _typedExp*, arg* -> arg**}

      1. If (arg <: expArg)*{arg <- arg*}*{arg* <- arg**}, then

        1. (Let EXP typedExp be arg as expArg)*{arg <- arg*, typedExp -> typedExp*}*{arg* <- arg**, typedExp* -> typedExp**}

          1. (Let rowCases be $cases_exp(AC.TYP, typedExp)*{typedExp <- typedExp*})*{typedExp* <- typedExp**, rowCases -> rowCases*}

            1. If ((|tblRowIL*{tblRowIL <- tblRowIL*}| > 0)), then

              1. (Let i be (|tblRowIL*{tblRowIL <- tblRowIL*}| - 1))

                1. If (i <: nat), then

                  1. (Let n_last be i as nat)

                    1. If (((0 + n_last) <= |rowCases*{rowCases <- rowCases*}|)), then

                      1. If ($is_exclusive_rows(rowCases*{rowCases <- rowCases*}[0 : n_last])), then

                        1. If ((n_last < |rowCases*{rowCases <- rowCases*}|))*{combination <- combination*}, then

                          1. If (($forall_($is_covered_combination([rowCases*{rowCases <- rowCases*}[n_last]], combination)*{combination <- combination*}) \/ $is_exclusive_rows(rowCases*{rowCases <- rowCases*}))), then

                            1. If ($forall_($is_covered_combination(rowCases*{rowCases <- rowCases*}, combination)*{combination <- combination*})), then

                              1. The relation holds

                            1. Else Dangling

                          1. Else Dangling

                        1. Else Dangling

                      1. Else Dangling

                    1. Else Dangling

                1. Else Dangling

            1. Else Dangling

      1. Else Dangling

