          1. (Let vari_iter be $iterate_vari(vari, [iter]))*{vari <- vari*, vari_iter -> vari_iter*}

            1. Result in: % |- % : vari_iter*{vari_iter <- vari_iter*}

  1. Else Dangling

  2. If (((((((((~exp <: varExp /\ ~exp <: upCastExp) /\ ~exp <: tupExp) /\ ~exp <: injExp) /\ ~exp <: strExp) /\ ~exp <: optExp) /\ ~exp <: listExp) /\ ~exp <: consExp) /\ ~exp <: iterExp)), then

    1. (Let id*{id <- id*} be $ids_of_varis($free_varis_exp(typedExp'')))

      1. If ($forall_(id <- $ids_of_varis(AC.BOUND)*{id <- id*})), then

        1. Result in: % |- % : []

