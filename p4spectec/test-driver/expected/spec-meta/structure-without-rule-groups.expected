relation Bind_exps: AC IC |- typedExp*{typedExp <- typedExp*} : % % %

1. (Multibind_exps: AC IC |- typedExp*{typedExp <- typedExp*} : AC_multi typedExp_multi*{typedExp_multi <- typedExp_multi*} premAL_eq*{premAL_eq <- premAL_eq*})

  1. (Partialbind_exps: AC_multi IC |- typedExp_multi*{typedExp_multi <- typedExp_multi*} : AC_part _IC typedExp_part*{typedExp_part <- typedExp_part*} premAL_part*{premAL_part <- premAL_part*})

    1. (Collectbind_exps: AC_multi |- typedExp_multi*{typedExp_multi <- typedExp_multi*} : vari_bind*{vari_bind <- vari_bind*})

      1. (Let iter _vari*{_vari <- _vari*}*{_vari* <- _vari**, iter <- iter*} be IC)

        1. (Let AC_bound be $add_bound(AC_part, $iterate_vari(vari_bind, iter*{iter <- iter*})*{vari_bind <- vari_bind*}))

          1. Result in: % % |- % : AC_bound typedExp_part*{typedExp_part <- typedExp_part*} premAL_part*{premAL_part <- premAL_part*} ++ premAL_eq*{premAL_eq <- premAL_eq*}

relation Bind_args: AC |- arg*{arg <- arg*} : % % %

1. (Multibind_args: AC |- arg*{arg <- arg*} : AC_multi arg_multi*{arg_multi <- arg_multi*} premAL_eq*{premAL_eq <- premAL_eq*})

  1. (Partialbind_args: AC_multi |- arg_multi*{arg_multi <- arg_multi*} : AC_part arg_part*{arg_part <- arg_part*} premAL_part*{premAL_part <- premAL_part*})

    1. (Collectbind_args: AC_multi |- arg_multi*{arg_multi <- arg_multi*} : vari_bind*{vari_bind <- vari_bind*})

      1. (Let AC_bound be $add_bound(AC_part, vari_bind*{vari_bind <- vari_bind*}))

        1. Result in: % |- % : AC_bound arg_part*{arg_part <- arg_part*} premAL_part*{premAL_part <- premAL_part*} ++ premAL_eq*{premAL_eq <- premAL_eq*}

relation Shallowbind_exp: AC |- exp' '#' _typ'

1. Case analysis on exp'

  1. Case (% has type varExp)

    1. The relation holds

  2. Case (% has type upCastExp)

    1. (Let UPCAST _typ typedExp be exp' as upCastExp)

      1. (Let exp '#' _typ'' be typedExp)

        1. If ((exp <: varExp \/ exp <: injExp)), then

          1. If (Shallowbind_exp: AC |- typedExp) holds, then

            1. The relation holds

          1. Else Dangling

        1. Else Dangling

  3. Case (% has type injExp)

    1. (Let INJ _mixop typedExp*{typedExp <- typedExp*} be exp' as injExp)

      1. If ($forall_($is_irrefutable_exp(AC.TYP, typedExp)*{typedExp <- typedExp*})), then

        1. The relation holds

      1. Else Dangling

1. Else Dangling

relation Shallowbind_arg: AC |- arg

1. If (arg <: expArg), then

  1. (Let EXP typedExp be arg as expArg)

    1. If (Shallowbind_exp: AC |- typedExp) holds, then

      1. The relation holds

    1. Else Dangling

1. Else Dangling

