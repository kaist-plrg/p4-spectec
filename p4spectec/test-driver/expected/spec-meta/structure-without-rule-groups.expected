  1. Else Dangling

relation Algo_prem: AC IC |- premIL' : % %

1. Case analysis on premIL' (total)

  1. Case (% has type relPremIL)

    1. (Let relPremIL be premIL' as relPremIL)

      1. (Let REL id ':' typedExp*{typedExp <- typedExp*} `( inputHint `) be relPremIL)

        1. (Let (typedExp_in*{typedExp_in <- typedExp_in*}, typedExp_out*{typedExp_out <- typedExp_out*}) be $split_inputs<typedExp>(inputHint, typedExp*{typedExp <- typedExp*}))

          1. (Let vari_in*{vari_in <- vari_in*} be $free_varis_exps(typedExp_in*{typedExp_in <- typedExp_in*}))

            1. If ($is_bound_varis(AC, IC, vari_in*{vari_in <- vari_in*})), then

              1. (Bind_exps: AC IC |- typedExp_out*{typedExp_out <- typedExp_out*} : AC_bound typedExp_out_part*{typedExp_out_part <- typedExp_out_part*} premAL_bind*{premAL_bind <- premAL_bind*})

                1. (Let id_read*{id_read <- id_read*} be $ids_of_varis(vari_in*{vari_in <- vari_in*}))

                  1. (Let vari_out*{vari_out <- vari_out*} be $free_varis_exps(typedExp_out_part*{typedExp_out_part <- typedExp_out_part*}))

                    1. (Let vari_bind*{vari_bind <- vari_bind*} be $shallowest_varis(vari_out*{vari_out <- vari_out*}))

                      1. (Let IC_bind be $add_iterated(IC, vari_bind*{vari_bind <- vari_bind*}))

                        1. (Let premIterAL*{premIterAL <- premIterAL*} be $prem_iters(IC_bind, id_read*{id_read <- id_read*}, $ids_of_varis(vari_bind*{vari_bind <- vari_bind*})))

                          1. If (Iter_sourced: |- premIterAL*{premIterAL <- premIterAL*}) holds, then

                            1. (Let relPremAL be REL id ':' typedExp_in*{typedExp_in <- typedExp_in*} '->' typedExp_out_part*{typedExp_out_part <- typedExp_out_part*})

                              1. (Let premAL_rel be $iterate_prem(relPremAL as premAL, premIterAL*{premIterAL <- premIterAL*}))

                                1. (Let premAL*{premAL <- premAL*} be premAL_rel :: premAL_bind*{premAL_bind <- premAL_bind*})

                                  1. Result in: % % |- % : AC_bound premAL*{premAL <- premAL*}

                          1. Else Dangling

            1. Else Dangling

  2. Case (% has type ifPrem)

    1. (Let ifPrem be premIL' as ifPrem)

      1. (Let IF typedExp be ifPrem)

        1. (Let vari*{vari <- vari*} be $free_varis_exp(typedExp))

