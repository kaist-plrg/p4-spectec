var b : bool

var i : int

var n : nat

var t : text

def $ite<X>(b, X_t, X_f)

1. Case analysis on b (total)

  1. Case (% = true)

    1. Return X_t

  2. Case (% = false)

    1. Return X_f

def $deopt_<X>(X'?{X' <- X'?}, X_d)

1. Case analysis on X'?{X' <- X'?} (total)

  1. Case (% matches pattern ())

    1. Return X_d

  2. Case (% matches pattern (_))

    1. (Let ?(X) be X'?{X' <- X'?})

      1. Return X

def $exists_(b*{b <- b*})

1. Case analysis on b*{b <- b*} (total)

  1. Case (% matches pattern [])

    1. Return false

  2. Case (% matches pattern _ :: _)

    1. (Let b_h :: b_t*{b_t <- b_t*} be b*{b <- b*})

      1. Return (b_h \/ $exists_(b_t*{b_t <- b_t*}))

def $forall_(b*{b <- b*})

1. Case analysis on b*{b <- b*} (total)

  1. Case (% matches pattern [])

    1. Return true

  2. Case (% matches pattern _ :: _)

    1. (Let b_h :: b_t*{b_t <- b_t*} be b*{b <- b*})

      1. Return (b_h /\ $forall_(b_t*{b_t <- b_t*}))

def $repeat_<X>(X, n)

1. Case analysis on n (total)

  1. Case (% = 0)

    1. Return []

  2. Case (% =/= 0)

    1. (Let i be (n - 1))

      1. If (i <: nat), then

        1. (Let n' be i as nat)

          1. Return [X] ++ $repeat_<X>(X, n')

      1. Else Dangling

builtin def $concat_<X>(X*{X <- X*}*{X* <- X**})

builtin def $assoc_<X, Y>(X, (X, Y)*{(X, Y) <- (X, Y)*})

def $transpose_<X>(X'*{X' <- X'*}*{X'* <- X'**})

1. Case analysis on X'*{X' <- X'*}*{X'* <- X'**} (total)

  1. Case (% matches pattern [])

    1. Return []

  2. Case (% matches pattern _ :: _)

    1. (Let X*{X <- X*} :: X_t*{X_t <- X_t*}*{X_t* <- X_t**} be X'*{X' <- X'*}*{X'* <- X'**})

      1. If (X*{X <- X*} matches []), then

        1. If ($forall_((X_t*{X_t <- X_t*} = [])*{X_t* <- X_t**})), then

          1. Return []

        1. Else Dangling

      1. Else Dangling

2. If (X'*{X' <- X'*} matches _ :: _)*{X'* <- X'**}, then

  1. (Let X_h :: X_t*{X_t <- X_t*} be X'*{X' <- X'*})*{X'* <- X'**, X_h -> X_h*, X_t* -> X_t**}

    1. If (X_h*{X_h <- X_h*} matches _ :: _), then

      1. (Let X_trans*{X_trans <- X_trans*}*{X_trans* <- X_trans**} be $transpose_<X>(X_t*{X_t <- X_t*}*{X_t* <- X_t**}))

        1. Return X_h*{X_h <- X_h*} :: X_trans*{X_trans <- X_trans*}*{X_trans* <- X_trans**}

    1. Else Dangling

2. Else Dangling

def $intersect_<X>(X*{X <- X*}, X'*{X' <- X'*})

1. Case analysis on X*{X <- X*} (total)

  1. Case (% matches pattern [])

    1. Return []

  2. Case (% matches pattern _ :: _)

    1. (Let X_h :: X_t*{X_t <- X_t*} be X*{X <- X*})

      1. Case analysis on X_h <- X'*{X' <- X'*} (total)

        1. Case true

          1. Return X_h :: $intersect_<X>(X_t*{X_t <- X_t*}, X'*{X' <- X'*})

        2. Case false

          1. Return $intersect_<X>(X_t*{X_t <- X_t*}, X'*{X' <- X'*})

syntax set<K> =
   | `{ K* `} (from set<K>)

syntax pair<K, V> =
   | K ':' V (from pair<K, V>)

syntax map<K, V> = set<pair<K, V>>

def $empty_map<K, V>

1. Return `{ [] `}

builtin def $find_map<K, V>(map<K, V>, K)

builtin def $add_map<K, V>(map<K, V>, K, V)

def $adds_map<K, V>(`{ K ':' V*{K <- K*, V <- V*} `}, K'*{K' <- K'*}, V'*{V' <- V'*})

1. Case analysis on K'*{K' <- K'*} (total)

  1. Case (% matches pattern [])

    1. If (V'*{V' <- V'*} matches []), then

      1. Return `{ K ':' V*{K <- K*, V <- V*} `}

    1. Else Dangling

  2. Case (% matches pattern _ :: _)

    1. (Let K_h :: K_t*{K_t <- K_t*} be K'*{K' <- K'*})

      1. If (V'*{V' <- V'*} matches _ :: _), then

        1. (Let V_h :: V_t*{V_t <- V_t*} be V'*{V' <- V'*})

          1. Return $adds_map<K, V>($add_map<K, V>(`{ K ':' V*{K <- K*, V <- V*} `}, K_h, V_h), K_t*{K_t <- K_t*}, V_t*{V_t <- V_t*})

      1. Else Dangling

syntax id = text

syntax atom = text

syntax mixop = atom**

syntax num =
   | NAT nat (from num)
   | INT int (from num)

syntax numtyp =
   | NAT (from numtyp)
   | INT (from numtyp)

syntax optyp =
   | BOOL (from optyp)
   | NAT (from numtyp)
   | INT (from numtyp)
   | TEXT (from optyp)

syntax typ =
   | BOOL (from optyp)
   | NAT (from numtyp)
   | INT (from numtyp)
   | TEXT (from optyp)
   | VAR id targ* (from typ)
   | TUP typ* (from typ)
   | ITER typ iter (from typ)
   | FUNC tparam* typ* typ (from typ)

syntax deftyp =
   | ALIAS typ (from deftyp)
   | STRUCT typField* (from deftyp)
   | VARIANT typCase* (from deftyp)

syntax typField =
   | atom typ (from typField)

syntax typCase =
   | mixop typ* (from typCase)

syntax iter =
   | QUEST (from iter)
   | STAR (from iter)

syntax vari =
   | id typ iter* (from vari)

syntax boolUnOp =
   | NOT (from boolUnOp)

syntax numUnOp =
   | PLUS (from numUnOp)
   | MINUS (from numUnOp)

syntax unOp =
   | NOT (from boolUnOp)
   | PLUS (from numUnOp)
   | MINUS (from numUnOp)

syntax boolBinOp =
   | AND (from boolBinOp)
   | OR (from boolBinOp)
   | IMPL (from boolBinOp)
   | EQUIV (from boolBinOp)

syntax numBinOp =
   | ADD (from numBinOp)
   | SUB (from numBinOp)
   | MUL (from numBinOp)
   | DIV (from numBinOp)
   | MOD (from numBinOp)
   | POW (from numBinOp)

syntax binOp =
   | AND (from boolBinOp)
   | OR (from boolBinOp)
   | IMPL (from boolBinOp)
   | EQUIV (from boolBinOp)
   | ADD (from numBinOp)
   | SUB (from numBinOp)
   | MUL (from numBinOp)
   | DIV (from numBinOp)
   | MOD (from numBinOp)
   | POW (from numBinOp)

syntax numCmpOp =
   | LT (from numCmpOp)
   | GT (from numCmpOp)
   | LE (from numCmpOp)
   | GE (from numCmpOp)

syntax polyCmpOp =
   | EQ (from polyCmpOp)
   | NE (from polyCmpOp)

syntax cmpOp =
   | EQ (from polyCmpOp)
   | NE (from polyCmpOp)
   | LT (from numCmpOp)
   | GT (from numCmpOp)
   | LE (from numCmpOp)
   | GE (from numCmpOp)

syntax listPat =
   | CONS (from listPat)
   | FIXED nat (from listPat)
   | NIL (from listPat)

syntax optPat =
   | SOME (from optPat)
   | NONE (from optPat)

syntax pat =
   | INJ mixop (from pat)
   | CONS (from listPat)
   | FIXED nat (from listPat)
   | NIL (from listPat)
   | SOME (from optPat)
   | NONE (from optPat)

syntax typedExp =
   | exp '#' typ (from typedExp)

syntax literalExp =
   | BOOL bool (from literalExp)
   | NAT nat (from num)
   | INT int (from num)
   | TEXT text (from literalExp)

syntax varExp =
   | VAR id (from varExp)

syntax unOpExp =
   | UN unOp typedExp (from unOpExp)

syntax binOpExp =
   | BIN binOp typedExp typedExp (from binOpExp)

syntax cmpOpExp =
   | CMP cmpOp typedExp typedExp (from cmpOpExp)

syntax opExp =
   | UN unOp typedExp (from unOpExp)
   | BIN binOp typedExp typedExp (from binOpExp)
   | CMP cmpOp typedExp typedExp (from cmpOpExp)

syntax upCastExp =
   | UPCAST typ typedExp (from upCastExp)

syntax downCastExp =
   | DOWNCAST typ typedExp (from downCastExp)

syntax castExp =
   | UPCAST typ typedExp (from upCastExp)
   | DOWNCAST typ typedExp (from downCastExp)

syntax subExp =
   | SUB typedExp typ (from subExp)

syntax matchExp =
   | MATCH typedExp pat (from matchExp)

syntax tupExp =
   | TUP typedExp* (from tupExp)

syntax injExp =
   | INJ expCase (from injExp)

syntax strExp =
   | STR expField* (from strExp)

syntax optExp =
   | OPT typedExp? (from optExp)

syntax listExp =
   | LIST typedExp* (from listExp)

syntax consExp =
   | CONS typedExp typedExp (from consExp)

syntax catExp =
   | CAT typedExp typedExp (from catExp)

syntax memExp =
   | MEM typedExp typedExp (from memExp)

syntax lenExp =
   | LEN typedExp (from lenExp)

syntax dotAccExp =
   | DOT typedExp atom (from dotAccExp)

syntax idxAccExp =
   | IDX typedExp typedExp (from idxAccExp)

syntax sliceAccExp =
   | SLICE typedExp typedExp typedExp (from sliceAccExp)

syntax accExp =
   | DOT typedExp atom (from dotAccExp)
   | IDX typedExp typedExp (from idxAccExp)
   | SLICE typedExp typedExp typedExp (from sliceAccExp)

syntax updExp =
   | UPD typedExp typedPath typedExp (from updExp)

syntax callExp =
   | CALL id targ* arg* (from callExp)

syntax iterExp =
   | ITER typedExp expIter (from iterExp)

syntax exp =
   | BOOL bool (from literalExp)
   | NAT nat (from num)
   | INT int (from num)
   | TEXT text (from literalExp)
   | VAR id (from varExp)
   | UN unOp typedExp (from unOpExp)
   | BIN binOp typedExp typedExp (from binOpExp)
   | CMP cmpOp typedExp typedExp (from cmpOpExp)
   | UPCAST typ typedExp (from upCastExp)
   | DOWNCAST typ typedExp (from downCastExp)
   | SUB typedExp typ (from subExp)
   | MATCH typedExp pat (from matchExp)
   | TUP typedExp* (from tupExp)
   | INJ expCase (from injExp)
   | STR expField* (from strExp)
   | OPT typedExp? (from optExp)
   | LIST typedExp* (from listExp)
   | CONS typedExp typedExp (from consExp)
   | CAT typedExp typedExp (from catExp)
   | MEM typedExp typedExp (from memExp)
   | LEN typedExp (from lenExp)
   | DOT typedExp atom (from dotAccExp)
   | IDX typedExp typedExp (from idxAccExp)
   | SLICE typedExp typedExp typedExp (from sliceAccExp)
   | UPD typedExp typedPath typedExp (from updExp)
   | CALL id targ* arg* (from callExp)
   | ITER typedExp expIter (from iterExp)

syntax expCase =
   | mixop typedExp* (from expCase)

syntax expField =
   | atom typedExp (from expField)

syntax expIter =
   | iter vari* (from expIter)

syntax typedPath =
   | path '#' typ (from typedPath)

syntax rootPath =
   | ROOT (from rootPath)

syntax idxPath =
   | IDX typedPath typedExp (from idxPath)

syntax slicePath =
   | SLICE typedPath typedExp typedExp (from slicePath)

syntax dotPath =
   | DOT typedPath atom (from dotPath)

syntax path =
   | ROOT (from rootPath)
   | IDX typedPath typedExp (from idxPath)
   | SLICE typedPath typedExp typedExp (from slicePath)
   | DOT typedPath atom (from dotPath)

syntax targ = typ

syntax expArg =
   | EXP typedExp (from expArg)

syntax funArg =
   | FUN id (from funArg)

syntax arg =
   | EXP typedExp (from expArg)
   | FUN id (from funArg)

syntax tparam = id

syntax expParam =
   | EXP typ (from expParam)

syntax funParam =
   | FUN id ':' tparam* param* '->' typ (from funParam)

syntax param =
   | EXP typ (from expParam)
   | FUN id ':' tparam* param* '->' typ (from funParam)

syntax ifPrem =
   | IF typedExp (from ifPrem)

syntax ifHoldPrem =
   | IFHOLD id ':' typedExp* (from ifHoldPrem)

syntax ifNotHoldPrem =
   | IFNOTHOLD id ':' typedExp* (from ifNotHoldPrem)

syntax debugPrem =
   | DEBUG typedExp (from debugPrem)

syntax externTypDefn =
   | EXTTYP id (from externTypDefn)

syntax definedTypDefn =
   | TYP id tparam* '=' deftyp (from definedTypDefn)

syntax typDefn =
   | EXTTYP id (from externTypDefn)
   | TYP id tparam* '=' deftyp (from definedTypDefn)

syntax externFuncDefn =
   | EXTFUNC id tparam* param* ':' typ (from externFuncDefn)

syntax builtinFuncDefn =
   | BUILTINFUNC id tparam* param* ':' typ (from builtinFuncDefn)

syntax premIter =
   | iter '<-' vari* '->' vari* (from premIter)

syntax relPrem =
   | REL id ':' typedExp* '->' typedExp* (from relPrem)

syntax letPrem =
   | LET typedExp '=' typedExp (from letPrem)

syntax iterPrem =
   | ITER prem premIter (from iterPrem)

syntax prem =
   | REL id ':' typedExp* '->' typedExp* (from relPrem)
   | IF typedExp (from ifPrem)
   | IFHOLD id ':' typedExp* (from ifHoldPrem)
   | IFNOTHOLD id ':' typedExp* (from ifNotHoldPrem)
   | LET typedExp '=' typedExp (from letPrem)
   | ITER prem premIter (from iterPrem)
   | DEBUG typedExp (from debugPrem)

syntax externRelDefn =
   | EXTREL id ':' typ* '->' typ* (from externRelDefn)

syntax rul =
   | id ':' typedExp* '->' typedExp* '-' prem* (from rul)

syntax rulGroup =
   | id ':' rul* (from rulGroup)

syntax elsGroup =
   | id ':' rul (from elsGroup)

syntax definedRelDefn =
   | REL id ':' typ* '->' typ* '=' rulGroup* elsGroup? (from definedRelDefn)

syntax relDefn =
   | EXTREL id ':' typ* '->' typ* (from externRelDefn)
   | REL id ':' typ* '->' typ* '=' rulGroup* elsGroup? (from definedRelDefn)

syntax tblRow =
   | arg* '=' typedExp '-' prem* (from tblRow)

syntax tableFuncDefn =
   | TABLEFUNC id param* ':' typ '=' tblRow* (from tableFuncDefn)

syntax clause =
   | arg* '=' typedExp '-' prem* (from clause)

syntax elsClause = clause

syntax definedFuncDefn =
   | FUNC id tparam* param* ':' typ '=' clause* elsClause? (from definedFuncDefn)

syntax funcDefn =
   | EXTFUNC id tparam* param* ':' typ (from externFuncDefn)
   | BUILTINFUNC id tparam* param* ':' typ (from builtinFuncDefn)
   | TABLEFUNC id param* ':' typ '=' tblRow* (from tableFuncDefn)
   | FUNC id tparam* param* ':' typ '=' clause* elsClause? (from definedFuncDefn)

syntax defn =
   | EXTTYP id (from externTypDefn)
   | TYP id tparam* '=' deftyp (from definedTypDefn)
   | EXTREL id ':' typ* '->' typ* (from externRelDefn)
   | REL id ':' typ* '->' typ* '=' rulGroup* elsGroup? (from definedRelDefn)
   | EXTFUNC id tparam* param* ':' typ (from externFuncDefn)
   | BUILTINFUNC id tparam* param* ':' typ (from builtinFuncDefn)
   | TABLEFUNC id param* ':' typ '=' tblRow* (from tableFuncDefn)
   | FUNC id tparam* param* ':' typ '=' clause* elsClause? (from definedFuncDefn)

syntax spec = defn*

extern syntax json

syntax val =
   | BOOL bool (from val)
   | NAT nat (from num)
   | INT int (from num)
   | TEXT text (from val)
   | STR valField* (from val)
   | INJ valCase (from val)
   | TUP val* (from val)
   | OPT val? (from val)
   | LIST val* (from val)
   | FUNC id (from val)
   | EXT json (from val)

syntax valField =
   | atom val (from valField)

syntax valCase =
   | mixop val* (from valCase)

def $fresh(id_used*{id_used <- id_used*}, id)

1. Case analysis on id <- id_used*{id_used <- id_used*} (total)

  1. Case false

    1. Return id

  2. Case true

    1. Return $fresh(id_used*{id_used <- id_used*}, id ++ "'")

def $ids_of_varis(id _typ _iter*{_iter <- _iter*}*{_iter* <- _iter**, _typ <- _typ*, id <- id*})

1. Return id*{id <- id*}

def $select_varis(vari*{vari <- vari*}, id*{id <- id*})

1. Case analysis on vari*{vari <- vari*} (total)

  1. Case (% matches pattern [])

    1. Return []

  2. Case (% matches pattern _ :: _)

    1. (Let vari_h :: vari_t*{vari_t <- vari_t*} be vari*{vari <- vari*})

      1. (Let id_h _typ _iter*{_iter <- _iter*} be vari_h)

        1. Case analysis on id_h <- id*{id <- id*} (total)

          1. Case true

            1. Return vari_h :: $select_varis(vari_t*{vari_t <- vari_t*}, id*{id <- id*})

          2. Case false

            1. Return $select_varis(vari_t*{vari_t <- vari_t*}, id*{id <- id*})

def $drop_varis(vari*{vari <- vari*}, id*{id <- id*})

1. Case analysis on vari*{vari <- vari*} (total)

  1. Case (% matches pattern [])

    1. Return []

  2. Case (% matches pattern _ :: _)

    1. (Let vari_h :: vari_t*{vari_t <- vari_t*} be vari*{vari <- vari*})

      1. (Let id_h _typ _iter*{_iter <- _iter*} be vari_h)

        1. Case analysis on id_h <- id*{id <- id*} (total)

          1. Case true

            1. Return $drop_varis(vari_t*{vari_t <- vari_t*}, id*{id <- id*})

          2. Case false

            1. Return vari_h :: $drop_varis(vari_t*{vari_t <- vari_t*}, id*{id <- id*})

def $iterate_vari(id typ iter*{iter <- iter*}, iter_add*{iter_add <- iter_add*})

1. Return id typ iter*{iter <- iter*} ++ iter_add*{iter_add <- iter_add*}

def $is_prefix_dim(vari, vari')

1. (Let _id typ_a iter_a*{iter_a <- iter_a*} be vari)

  1. (Let _id' typ_b iter_b*{iter_b <- iter_b*} be vari')

    1. If ((typ_a = typ_b)), then

      1. If ((|iter_a*{iter_a <- iter_a*}| <= |iter_b*{iter_b <- iter_b*}|)), then

        1. If (((0 + |iter_a*{iter_a <- iter_a*}|) <= |iter_b*{iter_b <- iter_b*}|)), then

          1. If ((iter_a*{iter_a <- iter_a*} = iter_b*{iter_b <- iter_b*}[0 : |iter_a*{iter_a <- iter_a*}|])), then

            1. Return true

2. Otherwise,

  1. Return false

def $shallowest_vari(vari, vari'*{vari' <- vari'*})

1. Case analysis on vari'*{vari' <- vari'*} (total)

  1. Case (% matches pattern [])

    1. Return vari

  2. Case (% matches pattern _ :: _)

    1. (Let vari_h :: vari_t*{vari_t <- vari_t*} be vari'*{vari' <- vari'*})

      1. Case analysis on $is_prefix_dim(vari_h, vari) (total)

        1. Case true

          1. Return $shallowest_vari(vari_h, vari_t*{vari_t <- vari_t*})

        2. Case false

          1. Return $shallowest_vari(vari, vari_t*{vari_t <- vari_t*})

def $shallowest_varis(vari*{vari <- vari*})

1. Case analysis on vari*{vari <- vari*} (total)

  1. Case (% matches pattern [])

    1. Return []

  2. Case (% matches pattern _ :: _)

    1. (Let vari_h :: vari_t*{vari_t <- vari_t*} be vari*{vari <- vari*})

      1. (Let id_h _typ _iter*{_iter <- _iter*} be vari_h)

        1. (Let vari_same*{vari_same <- vari_same*} be $select_varis(vari_t*{vari_t <- vari_t*}, [id_h]))

          1. (Let vari_rest*{vari_rest <- vari_rest*} be $drop_varis(vari_t*{vari_t <- vari_t*}, [id_h]))

            1. (Let vari_min be $shallowest_vari(vari_h, vari_same*{vari_same <- vari_same*}))

              1. Return vari_min :: $shallowest_varis(vari_rest*{vari_rest <- vari_rest*})

syntax typDef =
   | EXTTYP id (from externTypDefn)
   | TYP id tparam* '=' deftyp (from definedTypDefn)
   | PARAM (from typDef)

syntax tdenv = map<id, typDef>

syntax ok<X> =
   | OK X (from ok<X>)

syntax error =
   | ERROR (from error)

syntax unmatch =
   | UNMATCH (from unmatch)

syntax failure =
   | ERROR (from error)
   | UNMATCH (from unmatch)

syntax unitRes =
   | OK (from unitRes)
   | ERROR (from error)

syntax theta = map<id, typ>

def $theta_of_tdenv(set<pair<id, typDef>>)

1. If ((set<pair<id, typDef>> = `{ [] `})), then

  1. Return $empty_map<id, typ>

1. Else Dangling

2. (Let `{ pair<id, typDef>*{pair<id, typDef> <- pair<id, typDef>*} `} be set<pair<id, typDef>>)

  1. If (pair<id, typDef>*{pair<id, typDef> <- pair<id, typDef>*} matches _ :: _), then

    1. (Let id_h ':' typDef_h :: id_t ':' typDef_t*{id_t <- id_t*, typDef_t <- typDef_t*} be pair<id, typDef>*{pair<id, typDef> <- pair<id, typDef>*})

      1. Case analysis on typDef_h (total)

        1. Case (% has type definedTypDefn)

          1. (Let TYP _id tparam*{tparam <- tparam*} '=' deftyp be typDef_h as definedTypDefn)

            1. If (tparam*{tparam <- tparam*} matches []), then

              1. If (deftyp matches ALIAS %), then

                1. (Let ALIAS typ_h be deftyp)

                  1. (Let theta_t be $theta_of_tdenv(`{ id_t ':' typDef_t*{id_t <- id_t*, typDef_t <- typDef_t*} `}))

                    1. Return $add_map<id, typ>(theta_t, id_h, typ_h)

              1. Else Dangling

            1. Else Dangling

            2. Case analysis on deftyp (total)

              1. Case (% matches pattern ALIAS %)

                1. If (tparam*{tparam <- tparam*} matches _ :: _), then

                  1. Return $theta_of_tdenv(`{ id_t ':' typDef_t*{id_t <- id_t*, typDef_t <- typDef_t*} `})

                1. Else Dangling

              2. Case (% matches pattern STRUCT %)

                1. Return $theta_of_tdenv(`{ id_t ':' typDef_t*{id_t <- id_t*, typDef_t <- typDef_t*} `})

              3. Case (% matches pattern VARIANT %)

                1. Return $theta_of_tdenv(`{ id_t ':' typDef_t*{id_t <- id_t*, typDef_t <- typDef_t*} `})

        2. Case (% matches pattern PARAM)

          1. Return $theta_of_tdenv(`{ id_t ':' typDef_t*{id_t <- id_t*, typDef_t <- typDef_t*} `})

        3. Case (% has type externTypDefn)

          1. Return $theta_of_tdenv(`{ id_t ':' typDef_t*{id_t <- id_t*, typDef_t <- typDef_t*} `})

  1. Else Dangling

def $ids_typ(typ')

1. Case analysis on typ'

  1. Case (% matches pattern VAR % %)

    1. (Let VAR id typ*{typ <- typ*} be typ')

      1. Return [id] ++ $ids_typs(typ*{typ <- typ*})

  2. Case (% matches pattern TUP %)

    1. (Let TUP typ*{typ <- typ*} be typ')

      1. Return $ids_typs(typ*{typ <- typ*})

  3. Case (% matches pattern ITER % %)

    1. (Let ITER typ iter be typ')

      1. Return $ids_typ(typ)

  4. Case (% matches pattern FUNC % % %)

    1. (Let FUNC tparam*{tparam <- tparam*} typ*{typ <- typ*} typ_ret be typ')

      1. Return tparam*{tparam <- tparam*} ++ $ids_typs(typ*{typ <- typ*}) ++ $ids_typ(typ_ret)

2. Otherwise,

  1. Return []

def $ids_typs(typ*{typ <- typ*})

1. Case analysis on typ*{typ <- typ*} (total)

  1. Case (% matches pattern [])

    1. Return []

  2. Case (% matches pattern _ :: _)

    1. (Let typ_h :: typ_t*{typ_t <- typ_t*} be typ*{typ <- typ*})

      1. Return $ids_typ(typ_h) ++ $ids_typs(typ_t*{typ_t <- typ_t*})

def $fresh_ids(id_used*{id_used <- id_used*}, id*{id <- id*})

1. Case analysis on id*{id <- id*} (total)

  1. Case (% matches pattern [])

    1. Return []

  2. Case (% matches pattern _ :: _)

    1. (Let id_h :: id_t*{id_t <- id_t*} be id*{id <- id*})

      1. (Let id_fresh be $fresh(id_used*{id_used <- id_used*}, id_h))

        1. Return [id_fresh] ++ $fresh_ids([id_fresh] ++ id_used*{id_used <- id_used*}, id_t*{id_t <- id_t*})

syntax typRes =
   | OK typ (from ok<typ>)
   | ERROR (from error)

syntax typsRes =
   | OK typ* (from ok<typ*>)
   | ERROR (from error)

def $subst_typ(theta, typ')

1. Case analysis on typ'

  1. Case (% has type numtyp)

    1. (Let numtyp be typ' as numtyp)

      1. Case analysis on numtyp (total)

        1. Case (% matches pattern NAT)

          1. Return OK NAT as typ as typRes

        2. Case (% matches pattern INT)

          1. Return OK INT as typ as typRes

  2. Case (% matches pattern VAR % %)

    1. (Let VAR id targ*{targ <- targ*} be typ')

      1. If (targ*{targ <- targ*} matches []), then

        1. (Let typ''?{typ'' <- typ''?} be $find_map<id, typ>(theta, id))

          1. If (typ''?{typ'' <- typ''?} matches (_)), then

            1. (Let ?(typ) be typ''?{typ'' <- typ''?})

              1. Return OK typ as typRes

      2. If ($find_map<id, typ>(theta, id) matches ()), then

        1. (Let typsRes be $subst_typs(theta, targ*{targ <- targ*}))

          1. If (typsRes <: ok<typ*>), then

            1. (Let OK targ_subst*{targ_subst <- targ_subst*} be typsRes as ok<typ*>)

              1. Return OK VAR id targ_subst*{targ_subst <- targ_subst*} as typRes

  3. Case (% matches pattern TUP %)

    1. (Let TUP typ*{typ <- typ*} be typ')

      1. (Let typsRes be $subst_typs(theta, typ*{typ <- typ*}))

        1. If (typsRes <: ok<typ*>), then

          1. (Let OK typ_subst*{typ_subst <- typ_subst*} be typsRes as ok<typ*>)

            1. Return OK TUP typ_subst*{typ_subst <- typ_subst*} as typRes

  4. Case (% matches pattern ITER % %)

    1. (Let ITER typ iter be typ')

      1. (Let typRes be $subst_typ(theta, typ))

        1. If (typRes <: ok<typ>), then

          1. (Let OK typ_subst be typRes as ok<typ>)

            1. Return OK ITER typ_subst iter as typRes

  5. Case (% matches pattern FUNC % % %)

    1. (Let FUNC tparam*{tparam <- tparam*} typ*{typ <- typ*} typ_ret be typ')

      1. (Let `{ id ':' typ_arg*{id <- id*, typ_arg <- typ_arg*} `} be theta)

        1. (Let id_used*{id_used <- id_used*} be id*{id <- id*} ++ $ids_typs(typ_arg*{typ_arg <- typ_arg*}) ++ $ids_typ(FUNC tparam*{tparam <- tparam*} typ*{typ <- typ*} typ_ret))

          1. (Let tparam_fresh*{tparam_fresh <- tparam_fresh*} be $fresh_ids(id_used*{id_used <- id_used*}, tparam*{tparam <- tparam*}))

            1. If ((|tparam*{tparam <- tparam*}| = |tparam_fresh*{tparam_fresh <- tparam_fresh*}|)), then

              1. (Let theta_fresh be `{ tparam ':' VAR tparam_fresh []*{tparam <- tparam*, tparam_fresh <- tparam_fresh*} `})

                1. (Let typsRes be $subst_typs(theta_fresh, typ*{typ <- typ*}))

                  1. If (typsRes <: ok<typ*>), then

                    1. (Let OK typ_fresh*{typ_fresh <- typ_fresh*} be typsRes as ok<typ*>)

                      1. (Let typsRes' be $subst_typs(theta, typ_fresh*{typ_fresh <- typ_fresh*}))

                        1. If (typsRes' <: ok<typ*>), then

                          1. (Let OK typ_subst*{typ_subst <- typ_subst*} be typsRes' as ok<typ*>)

                            1. (Let typRes be $subst_typ(theta_fresh, typ_ret))

                              1. If (typRes <: ok<typ>), then

                                1. (Let OK typ_ret_fresh be typRes as ok<typ>)

                                  1. (Let typRes' be $subst_typ(theta, typ_ret_fresh))

                                    1. If (typRes' <: ok<typ>), then

                                      1. (Let OK typ_ret_subst be typRes' as ok<typ>)

                                        1. Return OK FUNC tparam_fresh*{tparam_fresh <- tparam_fresh*} typ_subst*{typ_subst <- typ_subst*} typ_ret_subst as typRes

2. If (typ' <: optyp), then

  1. (Let optyp be typ' as optyp)

    1. Case analysis on optyp

      1. Case (% matches pattern TEXT)

        1. Return OK TEXT as typ as typRes

      2. Case (% matches pattern BOOL)

        1. Return OK BOOL as typ as typRes

3. Otherwise,

  1. Return ERROR as typRes

def $subst_typs(theta, typ*{typ <- typ*})

1. Case analysis on typ*{typ <- typ*} (total)

  1. Case (% matches pattern [])

    1. Return OK [] as typsRes

  2. Case (% matches pattern _ :: _)

    1. (Let typ_h :: typ_t*{typ_t <- typ_t*} be typ*{typ <- typ*})

      1. (Let typRes be $subst_typ(theta, typ_h))

        1. If (typRes <: ok<typ>), then

          1. (Let OK typ_subst be typRes as ok<typ>)

            1. (Let typsRes be $subst_typs(theta, typ_t*{typ_t <- typ_t*}))

              1. If (typsRes <: ok<typ*>), then

                1. (Let OK typ_t_subst*{typ_t_subst <- typ_t_subst*} be typsRes as ok<typ*>)

                  1. Return OK typ_subst :: typ_t_subst*{typ_t_subst <- typ_t_subst*} as typsRes

2. Otherwise,

  1. Return ERROR as typsRes

def $expand_typ(tdenv, typ')

1. Case analysis on typ' (total)

  1. Case (% matches pattern VAR % %)

    1. (Let VAR id targ*{targ <- targ*} be typ')

      1. (Let typDef'?{typDef' <- typDef'?} be $find_map<id, typDef>(tdenv, id))

        1. If (typDef'?{typDef' <- typDef'?} matches (_)), then

          1. (Let ?(typDef) be typDef'?{typDef' <- typDef'?})

            1. Case analysis on typDef

              1. Case (% has type definedTypDefn)

                1. (Let TYP _id tparam*{tparam <- tparam*} '=' deftyp be typDef as definedTypDefn)

                  1. If (deftyp matches ALIAS %), then

                    1. (Let ALIAS typ be deftyp)

                      1. If ((|targ*{targ <- targ*}| = |tparam*{tparam <- tparam*}|)), then

                        1. (Let theta be `{ tparam ':' targ*{targ <- targ*, tparam <- tparam*} `})

                          1. (Let typRes be $subst_typ(theta, typ))

                            1. If (typRes <: ok<typ>), then

                              1. (Let OK typ_subst be typRes as ok<typ>)

                                1. Return $expand_typ(tdenv, typ_subst)

              2. Case (% matches pattern PARAM)

                1. If (targ*{targ <- targ*} matches []), then

                  1. Return OK VAR id targ*{targ <- targ*} as typRes

      2. If (targ*{targ <- targ*} matches []), then

        1. (Let typDef'?{typDef' <- typDef'?} be $find_map<id, typDef>(tdenv, id))

          1. If (typDef'?{typDef' <- typDef'?} matches (_)), then

            1. (Let ?(typDef) be typDef'?{typDef' <- typDef'?})

              1. If (typDef <: externTypDefn), then

                1. Return OK VAR id [] as typRes

      3. (Let typDef'?{typDef' <- typDef'?} be $find_map<id, typDef>(tdenv, id))

        1. If (typDef'?{typDef' <- typDef'?} matches (_)), then

          1. (Let ?(typDef) be typDef'?{typDef' <- typDef'?})

            1. If (typDef <: definedTypDefn), then

              1. (Let TYP _id tparam*{tparam <- tparam*} '=' deftyp be typDef as definedTypDefn)

                1. Case analysis on deftyp

                  1. Case (% matches pattern STRUCT %)

                    1. If ((|tparam*{tparam <- tparam*}| = |targ*{targ <- targ*}|)), then

                      1. Return OK VAR id targ*{targ <- targ*} as typRes

                  2. Case (% matches pattern VARIANT %)

                    1. If ((|tparam*{tparam <- tparam*}| = |targ*{targ <- targ*}|)), then

                      1. Return OK VAR id targ*{targ <- targ*} as typRes

  2. Case (% has type optyp)

    1. (Let optyp be typ' as optyp)

      1. Case analysis on optyp

        1. Case (% matches pattern BOOL)

          1. Return OK BOOL as typ as typRes

        2. Case (% matches pattern TEXT)

          1. Return OK TEXT as typ as typRes

  3. Case (% matches pattern TUP %)

    1. (Let TUP typ*{typ <- typ*} be typ')

      1. Return OK TUP typ*{typ <- typ*} as typRes

  4. Case (% matches pattern ITER % %)

    1. (Let ITER typ iter be typ')

      1. Return OK ITER typ iter as typRes

  5. Case (% matches pattern FUNC % % %)

    1. (Let FUNC tparam*{tparam <- tparam*} typ*{typ <- typ*} typ_ret be typ')

      1. Return OK FUNC tparam*{tparam <- tparam*} typ*{typ <- typ*} typ_ret as typRes

2. If (typ' <: numtyp), then

  1. (Let numtyp be typ' as numtyp)

    1. Case analysis on numtyp (total)

      1. Case (% matches pattern NAT)

        1. Return OK NAT as typ as typRes

      2. Case (% matches pattern INT)

        1. Return OK INT as typ as typRes

3. Otherwise,

  1. Return ERROR as typRes

syntax equivRes =
   | OK bool (from ok<bool>)
   | ERROR (from error)

def $equiv_typ(tdenv, typ_l, typ_r)

1. (Let typRes be $expand_typ(tdenv, typ_l))

  1. If (typRes <: ok<typ>), then

    1. (Let OK typ_l_expand be typRes as ok<typ>)

      1. (Let typRes' be $expand_typ(tdenv, typ_r))

        1. If (typRes' <: ok<typ>), then

          1. (Let OK typ_r_expand be typRes' as ok<typ>)

            1. Return $equiv_typ'(tdenv, typ_l_expand, typ_r_expand)

2. Otherwise,

  1. Return ERROR as equivRes

def $equiv_typs(tdenv, typ*{typ <- typ*}, typ'*{typ' <- typ'*})

1. Case analysis on typ*{typ <- typ*} (total)

  1. Case (% matches pattern [])

    1. Case analysis on typ'*{typ' <- typ'*} (total)

      1. Case (% matches pattern [])

        1. Return OK true as equivRes

      2. Case (% matches pattern _ :: _)

        1. Return OK false as equivRes

  2. Case (% matches pattern _ :: _)

    1. (Let typ_l :: typ_l_t*{typ_l_t <- typ_l_t*} be typ*{typ <- typ*})

      1. Case analysis on typ'*{typ' <- typ'*} (total)

        1. Case (% matches pattern _ :: _)

          1. (Let typ_r :: typ_r_t*{typ_r_t <- typ_r_t*} be typ'*{typ' <- typ'*})

            1. If ((OK true as equivRes = $equiv_typ(tdenv, typ_l, typ_r))), then

              1. Return $equiv_typs(tdenv, typ_l_t*{typ_l_t <- typ_l_t*}, typ_r_t*{typ_r_t <- typ_r_t*})

            1. Else Dangling

            2. (Let equivRes be $equiv_typ(tdenv, typ_l, typ_r))

              1. If ((equivRes =/= OK true as equivRes)), then

                1. Return equivRes

              1. Else Dangling

        2. Case (% matches pattern [])

          1. Return OK false as equivRes

def $equiv_typ'(tdenv, typ, typ')

1. Case analysis on typ

  1. Case (% has type optyp)

    1. (Let optyp be typ as optyp)

      1. Case analysis on optyp

        1. Case (% matches pattern BOOL)

          1. If (typ' <: optyp), then

            1. (Let optyp' be typ' as optyp)

              1. If (optyp' matches BOOL), then

                1. Return OK true as equivRes

        2. Case (% matches pattern TEXT)

          1. If (typ' <: optyp), then

            1. (Let optyp' be typ' as optyp)

              1. If (optyp' matches TEXT), then

                1. Return OK true as equivRes

  2. Case (% matches pattern VAR % %)

    1. (Let VAR id_l targ_l*{targ_l <- targ_l*} be typ)

      1. If (typ' matches VAR % %), then

        1. (Let VAR id_r targ_r*{targ_r <- targ_r*} be typ')

          1. If ((id_l = id_r)), then

            1. Return $equiv_typs(tdenv, targ_l*{targ_l <- targ_l*}, targ_r*{targ_r <- targ_r*})

  3. Case (% matches pattern TUP %)

    1. (Let TUP typ_l*{typ_l <- typ_l*} be typ)

      1. If (typ' matches TUP %), then

        1. (Let TUP typ_r*{typ_r <- typ_r*} be typ')

          1. Return $equiv_typs(tdenv, typ_l*{typ_l <- typ_l*}, typ_r*{typ_r <- typ_r*})

  4. Case (% matches pattern ITER % %)

    1. (Let ITER typ_l iter_l be typ)

      1. If (typ' matches ITER % %), then

        1. (Let ITER typ_r iter_r be typ')

          1. If ((iter_l = iter_r)), then

            1. Return $equiv_typ(tdenv, typ_l, typ_r)

2. If (typ <: numtyp), then

  1. (Let numtyp be typ as numtyp)

    1. Case analysis on numtyp (total)

      1. Case (% matches pattern NAT)

        1. If (typ' <: numtyp), then

          1. (Let numtyp' be typ' as numtyp)

            1. If (numtyp' matches NAT), then

              1. Return OK true as equivRes

      2. Case (% matches pattern INT)

        1. If (typ' <: numtyp), then

          1. (Let numtyp' be typ' as numtyp)

            1. If (numtyp' matches INT), then

              1. Return OK true as equivRes

3. Otherwise,

  1. Return OK false as equivRes

def $equiv_func_typ(tdenv, typ, typ')

1. If (typ matches FUNC % % %), then

  1. (Let FUNC tparam_l*{tparam_l <- tparam_l*} typ_l*{typ_l <- typ_l*} typ_ret_l be typ)

    1. If (typ' matches FUNC % % %), then

      1. (Let FUNC tparam_r*{tparam_r <- tparam_r*} typ_r*{typ_r <- typ_r*} typ_ret_r be typ')

        1. If ((|tparam_l*{tparam_l <- tparam_l*}| = |tparam_r*{tparam_r <- tparam_r*}|)), then

          1. If ((|typ_l*{typ_l <- typ_l*}| = |typ_r*{typ_r <- typ_r*}|)), then

            1. (Let `{ id ':' typDef*{id <- id*, typDef <- typDef*} `} be tdenv)

              1. (Let id_used*{id_used <- id_used*} be id*{id <- id*} ++ $ids_typ(FUNC tparam_l*{tparam_l <- tparam_l*} typ_l*{typ_l <- typ_l*} typ_ret_l) ++ $ids_typ(FUNC tparam_r*{tparam_r <- tparam_r*} typ_r*{typ_r <- typ_r*} typ_ret_r))

                1. (Let tparam_fresh*{tparam_fresh <- tparam_fresh*} be $fresh_ids(id_used*{id_used <- id_used*}, tparam_l*{tparam_l <- tparam_l*}))

                  1. If ((|tparam_fresh*{tparam_fresh <- tparam_fresh*}| = |tparam_l*{tparam_l <- tparam_l*}|)), then

                    1. (Let theta_l be `{ tparam_l ':' VAR tparam_fresh []*{tparam_fresh <- tparam_fresh*, tparam_l <- tparam_l*} `})

                      1. (Let theta_r be `{ tparam_r ':' VAR tparam_fresh []*{tparam_fresh <- tparam_fresh*, tparam_r <- tparam_r*} `})

                        1. (Let typsRes be $subst_typs(theta_l, typ_l*{typ_l <- typ_l*}))

                          1. If (typsRes <: ok<typ*>), then

                            1. (Let OK typ_l_subst*{typ_l_subst <- typ_l_subst*} be typsRes as ok<typ*>)

                              1. (Let typsRes' be $subst_typs(theta_r, typ_r*{typ_r <- typ_r*}))

                                1. If (typsRes' <: ok<typ*>), then

                                  1. (Let OK typ_r_subst*{typ_r_subst <- typ_r_subst*} be typsRes' as ok<typ*>)

                                    1. (Let typRes be $subst_typ(theta_l, typ_ret_l))

                                      1. If (typRes <: ok<typ>), then

                                        1. (Let OK typ_ret_l_subst be typRes as ok<typ>)

                                          1. (Let typRes' be $subst_typ(theta_r, typ_ret_r))

                                            1. If (typRes' <: ok<typ>), then

                                              1. (Let OK typ_ret_r_subst be typRes' as ok<typ>)

                                                1. (Let tdenv_fresh be $adds_map<id, typDef>(tdenv, tparam_fresh*{tparam_fresh <- tparam_fresh*}, $repeat_<typDef>(PARAM, |tparam_fresh*{tparam_fresh <- tparam_fresh*}|)))

                                                  1. Return $equiv_typs(tdenv_fresh, typ_l_subst*{typ_l_subst <- typ_l_subst*} ++ [typ_ret_l_subst], typ_r_subst*{typ_r_subst <- typ_r_subst*} ++ [typ_ret_r_subst])

        2. If (((|tparam_l*{tparam_l <- tparam_l*}| =/= |tparam_r*{tparam_r <- tparam_r*}|) \/ (|typ_l*{typ_l <- typ_l*}| =/= |typ_r*{typ_r <- typ_r*}|))), then

          1. Return OK false as equivRes

2. Otherwise,

  1. Return ERROR as equivRes

syntax varr =
   | id iter* (from varr)

syntax venv = map<varr, val>

syntax renv = map<id, relDefn>

syntax fenv = map<id, funcDefn>

syntax fnenv = map<id, id>

syntax globalLayer = {TYP tdenv, REL renv, FUNC fenv}

syntax localLayer = {TYP tdenv, FUNC fnenv, VAL venv}

def $empty_globalLayer

1. Return {TYP $empty_map<id, typDef>, REL $empty_map<id, relDefn>, FUNC $empty_map<id, funcDefn>}

def $empty_localLayer

1. Return {TYP $empty_map<id, typDef>, FUNC $empty_map<id, id>, VAL $empty_map<varr, val>}

syntax ctx = {GLOBAL globalLayer, LOCAL localLayer}

def $empty_ctx

1. Return {GLOBAL $empty_globalLayer, LOCAL $empty_localLayer}

var C : ctx

def $load_ctx(C, defn'*{defn' <- defn'*})

1. Case analysis on defn'*{defn' <- defn'*} (total)

  1. Case (% matches pattern _ :: _)

    1. (Let defn :: defn_t*{defn_t <- defn_t*} be defn'*{defn' <- defn'*})

      1. Case analysis on defn (total)

        1. Case (% has type externTypDefn)

          1. (Let externTypDefn be defn as externTypDefn)

            1. (Let EXTTYP id be externTypDefn)

              1. (Let tdenv_update be $add_map<id, typDef>(C.GLOBAL.TYP, id, externTypDefn as typDef))

                1. (Let C_load be C[GLOBAL.TYP = tdenv_update])

                  1. Return $load_ctx(C_load, defn_t*{defn_t <- defn_t*})

        2. Case (% has type definedTypDefn)

          1. (Let definedTypDefn be defn as definedTypDefn)

            1. (Let TYP id _tparam*{_tparam <- _tparam*} '=' _deftyp be definedTypDefn)

              1. (Let tdenv_update be $add_map<id, typDef>(C.GLOBAL.TYP, id, definedTypDefn as typDef))

                1. (Let C_load be C[GLOBAL.TYP = tdenv_update])

                  1. Return $load_ctx(C_load, defn_t*{defn_t <- defn_t*})

        3. Case (% has type externRelDefn)

          1. (Let externRelDefn be defn as externRelDefn)

            1. (Let EXTREL id ':' _typ*{_typ <- _typ*} '->' _typ'*{_typ' <- _typ'*} be externRelDefn)

              1. (Let renv_update be $add_map<id, relDefn>(C.GLOBAL.REL, id, externRelDefn as relDefn))

                1. (Let C_load be C[GLOBAL.REL = renv_update])

                  1. Return $load_ctx(C_load, defn_t*{defn_t <- defn_t*})

        4. Case (% has type definedRelDefn)

          1. (Let definedRelDefn be defn as definedRelDefn)

            1. (Let REL id ':' _typ*{_typ <- _typ*} '->' _typ'*{_typ' <- _typ'*} '=' _rulGroup*{_rulGroup <- _rulGroup*} _elsGroup?{_elsGroup <- _elsGroup?} be definedRelDefn)

              1. (Let renv_update be $add_map<id, relDefn>(C.GLOBAL.REL, id, definedRelDefn as relDefn))

                1. (Let C_load be C[GLOBAL.REL = renv_update])

                  1. Return $load_ctx(C_load, defn_t*{defn_t <- defn_t*})

        5. Case (% has type externFuncDefn)

          1. (Let externFuncDefn be defn as externFuncDefn)

            1. (Let EXTFUNC id _tparam*{_tparam <- _tparam*} _param*{_param <- _param*} ':' _typ be externFuncDefn)

              1. (Let fenv_update be $add_map<id, funcDefn>(C.GLOBAL.FUNC, id, externFuncDefn as funcDefn))

                1. (Let C_load be C[GLOBAL.FUNC = fenv_update])

                  1. Return $load_ctx(C_load, defn_t*{defn_t <- defn_t*})

        6. Case (% has type builtinFuncDefn)

          1. (Let builtinFuncDefn be defn as builtinFuncDefn)

            1. (Let BUILTINFUNC id _tparam*{_tparam <- _tparam*} _param*{_param <- _param*} ':' _typ be builtinFuncDefn)

              1. (Let fenv_update be $add_map<id, funcDefn>(C.GLOBAL.FUNC, id, builtinFuncDefn as funcDefn))

                1. (Let C_load be C[GLOBAL.FUNC = fenv_update])

                  1. Return $load_ctx(C_load, defn_t*{defn_t <- defn_t*})

        7. Case (% has type tableFuncDefn)

          1. (Let tableFuncDefn be defn as tableFuncDefn)

            1. (Let TABLEFUNC id _param*{_param <- _param*} ':' _typ '=' _tblRow*{_tblRow <- _tblRow*} be tableFuncDefn)

              1. (Let fenv_update be $add_map<id, funcDefn>(C.GLOBAL.FUNC, id, tableFuncDefn as funcDefn))

                1. (Let C_load be C[GLOBAL.FUNC = fenv_update])

                  1. Return $load_ctx(C_load, defn_t*{defn_t <- defn_t*})

        8. Case (% has type definedFuncDefn)

          1. (Let definedFuncDefn be defn as definedFuncDefn)

            1. (Let FUNC id _tparam*{_tparam <- _tparam*} _param*{_param <- _param*} ':' _typ '=' _clause*{_clause <- _clause*} _elsClause?{_elsClause <- _elsClause?} be definedFuncDefn)

              1. (Let fenv_update be $add_map<id, funcDefn>(C.GLOBAL.FUNC, id, definedFuncDefn as funcDefn))

                1. (Let C_load be C[GLOBAL.FUNC = fenv_update])

                  1. Return $load_ctx(C_load, defn_t*{defn_t <- defn_t*})

  2. Case (% matches pattern [])

    1. Return C

def $add_varr(C, varr, val)

1. (Let venv_update be $add_map<varr, val>(C.LOCAL.VAL, varr, val))

  1. Return C[LOCAL.VAL = venv_update]

def $add_varis(C, vari*{vari <- vari*}, val*{val <- val*})

1. (Let id _typ iter*{iter <- iter*} be vari)*{vari <- vari*, _typ -> _typ*, id -> id*, iter* -> iter**}

  1. (Let venv_update be $adds_map<varr, val>(C.LOCAL.VAL, id iter*{iter <- iter*}*{id <- id*, iter* <- iter**}, val*{val <- val*}))

    1. Return C[LOCAL.VAL = venv_update]

def $add_func(C, id, id_global)

1. (Let fnenv_update be $add_map<id, id>(C.LOCAL.FUNC, id, id_global))

  1. Return C[LOCAL.FUNC = fnenv_update]

def $find_vari(C, vari)

1. (Let id _typ iter*{iter <- iter*} be vari)

  1. (Let val'?{val' <- val'?} be $find_map<varr, val>(C.LOCAL.VAL, id iter*{iter <- iter*}))

    1. If (val'?{val' <- val'?} matches (_)), then

      1. (Let ?(val) be val'?{val' <- val'?})

        1. Return ?(val)

2. Otherwise,

  1. Return ?()

def $find_varr(C, varr)

1. Return $find_map<varr, val>(C.LOCAL.VAL, varr)

def $find_varis(C, vari*{vari <- vari*})

1. (Let val'?{val' <- val'?} be $find_vari(C, vari))*{vari <- vari*, val'? -> val'?*}

  1. If (val'?{val' <- val'?} matches (_))*{val'? <- val'?*}, then

    1. (Let ?(val) be val'?{val' <- val'?})*{val'? <- val'?*, val -> val*}

      1. Return ?(val*{val <- val*})

2. Otherwise,

  1. Return ?()

def $finds_vari(C*{C <- C*}, vari)

1. (Let id _typ iter*{iter <- iter*} be vari)

  1. (Let val'?{val' <- val'?} be $find_map<varr, val>(C.LOCAL.VAL, id iter*{iter <- iter*}))*{C <- C*, val'? -> val'?*}

    1. If (val'?{val' <- val'?} matches (_))*{val'? <- val'?*}, then

      1. (Let ?(val) be val'?{val' <- val'?})*{val'? <- val'?*, val -> val*}

        1. Return ?(val*{val <- val*})

2. Otherwise,

  1. Return ?()

def $is_iter_on_var(typedExp')

1. (Let exp '#' _typ be typedExp')

  1. Case analysis on exp

    1. Case (% has type varExp)

      1. (Let VAR id be exp as varExp)

        1. Return ?(id [])

    2. Case (% has type iterExp)

      1. (Let ITER typedExp expIter be exp as iterExp)

        1. (Let varr?{varr <- varr?} be $is_iter_on_var(typedExp))

          1. If (varr?{varr <- varr?} matches (_)), then

            1. (Let ?(id iter*{iter <- iter*}) be varr?{varr <- varr?})

              1. (Let iter_outer vari*{vari <- vari*} be expIter)

                1. If (vari*{vari <- vari*} matches [ _/1 ]), then

                  1. (Let [id' _typ' iter'*{iter' <- iter'*}] be vari*{vari <- vari*})

                    1. If ((id' = id)), then

                      1. If ((iter'*{iter' <- iter'*} = iter*{iter <- iter*})), then

                        1. Return ?(id iter*{iter <- iter*} ++ [iter_outer])

2. Otherwise,

  1. Return ?()

def $find_typ(C, id)

1. (Let typDef'?{typDef' <- typDef'?} be $find_map<id, typDef>(C.LOCAL.TYP, id))

  1. If (typDef'?{typDef' <- typDef'?} matches (_)), then

    1. (Let ?(typDef) be typDef'?{typDef' <- typDef'?})

      1. Return ?(typDef)

  1. Else Dangling

2. If ($find_map<id, typDef>(C.LOCAL.TYP, id) matches ()), then

  1. Return $find_map<id, typDef>(C.GLOBAL.TYP, id)

2. Else Dangling

def $find_func_param(C, id)

1. Return $find_map<id, id>(C.LOCAL.FUNC, id)

def $resolve_func_param(C, id)

1. Return $deopt_<id>($find_func_param(C, id), id)

def $find_func(C, id)

1. Return $find_map<id, funcDefn>(C.GLOBAL.FUNC, id)

def $find_rel(C, id)

1. Return $find_map<id, relDefn>(C.GLOBAL.REL, id)

syntax subOptRes =
   | OK ctx? (from ok<ctx?>)
   | ERROR (from error)

def $sub_opt(C, vari*{vari <- vari*})

1. Case analysis on vari*{vari <- vari*} (total)

  1. Case (% matches pattern [])

    1. Return ERROR as subOptRes

  2. Case (% matches pattern _ :: _)

    1. (Let vari_iter be $iterate_vari(vari, [QUEST]))*{vari <- vari*, vari_iter -> vari_iter*}

      1. (Let val'''?{val''' <- val'''?} be $find_vari(C, vari_iter))*{vari_iter <- vari_iter*, val'''? -> val'''?*}

        1. If (val'''?{val''' <- val'''?} matches (_))*{val'''? <- val'''?*}, then

          1. (Let ?(val'') be val'''?{val''' <- val'''?})*{val'''? <- val'''?*, val'' -> val''*}

            1. If (val'' matches OPT %)*{val'' <- val''*}, then

              1. (Let OPT val'?{val' <- val'?} be val'')*{val'' <- val''*, val'? -> val'?*}

                1. If (val'?{val' <- val'?} matches (_))*{val'? <- val'?*}, then

                  1. (Let ?(val) be val'?{val' <- val'?})*{val'? <- val'?*, val -> val*}

                    1. (Let C_sub be $add_varis(C, vari*{vari <- vari*}, val*{val <- val*}))

                      1. Return OK ?(C_sub) as subOptRes

      2. If ((?(OPT ?()) = $find_vari(C, vari_iter)))*{vari_iter <- vari_iter*}, then

        1. Return OK ?() as subOptRes

2. Otherwise,

  1. Return ERROR as subOptRes

syntax subListRes =
   | OK ctx* (from ok<ctx*>)
   | ERROR (from error)

def $sub_list(C, vari*{vari <- vari*})

1. (Let vari_iter be $iterate_vari(vari, [STAR]))*{vari <- vari*, vari_iter -> vari_iter*}

  1. (Let val''?{val'' <- val''?} be $find_vari(C, vari_iter))*{vari_iter <- vari_iter*, val''? -> val''?*}

    1. If (val''?{val'' <- val''?} matches (_))*{val''? <- val''?*}, then

      1. (Let ?(val') be val''?{val'' <- val''?})*{val''? <- val''?*, val' -> val'*}

        1. If (val' matches LIST %)*{val' <- val'*}, then

          1. (Let LIST val*{val <- val*} be val')*{val' <- val'*, val* -> val**}

            1. If ((0 < |val*{val <- val*}*{val* <- val**}|))*{val* <- val**}, then

              1. If ($forall_((|val*{val <- val*}| = |val*{val <- val*}*{val* <- val**}[0]|)*{val* <- val**})), then

                1. (Let val_trans*{val_trans <- val_trans*}*{val_trans* <- val_trans**} be $transpose_<val>(val*{val <- val*}*{val* <- val**}))

                  1. (Let C_sub be $add_varis(C, vari*{vari <- vari*}, val_trans*{val_trans <- val_trans*}))*{val_trans* <- val_trans**, C_sub -> C_sub*}

                    1. Return OK C_sub*{C_sub <- C_sub*} as subListRes

2. Otherwise,

  1. Return ERROR as subListRes

syntax funcRes =
   | OK val (from ok<val>)
   | ERROR (from error)
   | UNMATCH (from unmatch)

extern relation Call_extern_func: |- id `< typ*{typ <- typ*} `> `( val*{val <- val*} `) : %

extern relation Call_builtin_func: |- id `< typ*{typ <- typ*} `> `( val*{val <- val*} `) : %

syntax relRes =
   | OK val* (from ok<val*>)
   | ERROR (from error)
   | UNMATCH (from unmatch)

extern relation Call_extern_rel: |- id `( val*{val <- val*} `) : %

syntax expRes =
   | OK val (from ok<val>)
   | ERROR (from error)
   | UNMATCH (from unmatch)

relation Eval_exp: C |- typedExp' : %

1. (Let exp '#' typ' be typedExp')

  1. Case analysis on exp (total)

    1. Case (% has type literalExp)

      1. (Let literalExp be exp as literalExp)

        1. Case analysis on literalExp

          1. Case (% matches pattern BOOL %)

            1. (Let BOOL b be literalExp)

              1. Result in: % |- % : OK BOOL b as expRes

          2. Case (% matches pattern TEXT %)

            1. (Let TEXT t be literalExp)

              1. Result in: % |- % : OK TEXT t as expRes

    2. Case (% has type varExp)

      1. (Let VAR id be exp as varExp)

        1. (Let val'?{val' <- val'?} be $find_varr(C, id []))

          1. If (val'?{val' <- val'?} matches (_)), then

            1. (Let ?(val) be val'?{val' <- val'?})

              1. Result in: % |- % : OK val as expRes

    3. Case (% has type unOpExp)

      1. (Let UN unOp typedExp be exp as unOpExp)

        1. If ((unOp = NOT as unOp)), then

          1. (Eval_exp: C |- typedExp : expRes)

            1. Case analysis on expRes (total)

              1. Case (% has type failure)

                1. (Let failure be expRes as failure)

                  1. Result in: % |- % : failure as expRes

              2. Case (% has type ok<val>)

                1. (Let OK val be expRes as ok<val>)

                  1. If (val matches BOOL %), then

                    1. (Let BOOL b be val)

                      1. (Let b_res be ~b)

                        1. Result in: % |- % : OK BOOL b_res as expRes

        2. If (unOp <: numUnOp), then

          1. (Let numUnOp be unOp as numUnOp)

            1. (Eval_exp: C |- typedExp : expRes)

              1. Case analysis on expRes (total)

                1. Case (% has type failure)

                  1. (Let failure be expRes as failure)

                    1. Result in: % |- % : failure as expRes

                2. Case (% has type ok<val>)

                  1. (Let OK val be expRes as ok<val>)

                    1. If (val <: num), then

                      1. (Let num be val as num)

                        1. (Let val_res be $numUnOp(numUnOp, num))

                          1. Result in: % |- % : OK val_res as expRes

    4. Case (% has type binOpExp)

      1. (Let BIN binOp typedExp_l typedExp_r be exp as binOpExp)

        1. Case analysis on binOp (total)

          1. Case (% has type boolBinOp)

            1. (Let boolBinOp be binOp as boolBinOp)

              1. (Eval_exp: C |- typedExp_l : expRes)

                1. Case analysis on expRes (total)

                  1. Case (% has type failure)

                    1. (Let failure be expRes as failure)

                      1. Result in: % |- % : failure as expRes

                  2. Case (% has type ok<val>)

                    1. (Let OK val be expRes as ok<val>)

                      1. If (val matches BOOL %), then

                        1. (Let BOOL b_l be val)

                          1. (Eval_exp: C |- typedExp_r : expRes')

                            1. Case analysis on expRes' (total)

                              1. Case (% has type failure)

                                1. (Let failure be expRes' as failure)

                                  1. Result in: % |- % : failure as expRes

                              2. Case (% has type ok<val>)

                                1. (Let OK val' be expRes' as ok<val>)

                                  1. If (val' matches BOOL %), then

                                    1. (Let BOOL b_r be val')

                                      1. (Let b_res be $boolBinOp(boolBinOp, b_l, b_r))

                                        1. Result in: % |- % : OK BOOL b_res as expRes

          2. Case (% has type numBinOp)

            1. (Let numBinOp be binOp as numBinOp)

              1. (Eval_exp: C |- typedExp_l : expRes)

                1. Case analysis on expRes (total)

                  1. Case (% has type failure)

                    1. (Let failure be expRes as failure)

                      1. Result in: % |- % : failure as expRes

                  2. Case (% has type ok<val>)

                    1. (Let OK val be expRes as ok<val>)

                      1. If (val <: num), then

                        1. (Let num_l be val as num)

                          1. (Eval_exp: C |- typedExp_r : expRes')

                            1. Case analysis on expRes' (total)

                              1. Case (% has type failure)

                                1. (Let failure be expRes' as failure)

                                  1. Result in: % |- % : failure as expRes

                              2. Case (% has type ok<val>)

                                1. (Let OK val' be expRes' as ok<val>)

                                  1. If (val' <: num), then

                                    1. (Let num_r be val' as num)

                                      1. (Let numBinOpRes be $numBinOp(numBinOp, num_l, num_r))

                                        1. Result in: % |- % : numBinOpRes as expRes

    5. Case (% has type cmpOpExp)

      1. (Let CMP cmpOp typedExp_l typedExp_r be exp as cmpOpExp)

        1. Case analysis on cmpOp (total)

          1. Case (% has type polyCmpOp)

            1. (Let polyCmpOp be cmpOp as polyCmpOp)

              1. (Eval_exp: C |- typedExp_l : expRes)

                1. Case analysis on expRes (total)

                  1. Case (% has type failure)

                    1. (Let failure be expRes as failure)

                      1. Result in: % |- % : failure as expRes

                  2. Case (% has type ok<val>)

                    1. (Let OK val_l be expRes as ok<val>)

                      1. (Eval_exp: C |- typedExp_r : expRes')

                        1. Case analysis on expRes' (total)

                          1. Case (% has type failure)

                            1. (Let failure be expRes' as failure)

                              1. Result in: % |- % : failure as expRes

                          2. Case (% has type ok<val>)

                            1. (Let OK val_r be expRes' as ok<val>)

                              1. (Let b_res be $polyCmpOp(polyCmpOp, val_l, val_r))

                                1. Result in: % |- % : OK BOOL b_res as expRes

          2. Case (% has type numCmpOp)

            1. (Let numCmpOp be cmpOp as numCmpOp)

              1. (Eval_exp: C |- typedExp_l : expRes)

                1. Case analysis on expRes (total)

                  1. Case (% has type failure)

                    1. (Let failure be expRes as failure)

                      1. Result in: % |- % : failure as expRes

                  2. Case (% has type ok<val>)

                    1. (Let OK val be expRes as ok<val>)

                      1. If (val <: num), then

                        1. (Let num_l be val as num)

                          1. (Eval_exp: C |- typedExp_r : expRes')

                            1. Case analysis on expRes' (total)

                              1. Case (% has type failure)

                                1. (Let failure be expRes' as failure)

                                  1. Result in: % |- % : failure as expRes

                              2. Case (% has type ok<val>)

                                1. (Let OK val' be expRes' as ok<val>)

                                  1. If (val' <: num), then

                                    1. (Let num_r be val' as num)

                                      1. (Let numCmpRes be $numCmpOp(numCmpOp, num_l, num_r))

                                        1. If (numCmpRes <: ok<bool>), then

                                          1. (Let OK b_res be numCmpRes as ok<bool>)

                                            1. Result in: % |- % : OK BOOL b_res as expRes

    6. Case (% has type upCastExp)

      1. (Let UPCAST typ typedExp be exp as upCastExp)

        1. (Eval_exp: C |- typedExp : expRes)

          1. Case analysis on expRes (total)

            1. Case (% has type failure)

              1. (Let failure be expRes as failure)

                1. Result in: % |- % : failure as expRes

            2. Case (% has type ok<val>)

              1. (Let OK val be expRes as ok<val>)

                1. (Let castRes be $upcast(C, typ, val))

                  1. Result in: % |- % : castRes as expRes

    7. Case (% has type downCastExp)

      1. (Let DOWNCAST typ typedExp be exp as downCastExp)

        1. (Eval_exp: C |- typedExp : expRes)

          1. Case analysis on expRes (total)

            1. Case (% has type failure)

              1. (Let failure be expRes as failure)

                1. Result in: % |- % : failure as expRes

            2. Case (% has type ok<val>)

              1. (Let OK val be expRes as ok<val>)

                1. (Let castRes be $downcast(C, typ, val))

                  1. Result in: % |- % : castRes as expRes

    8. Case (% has type subExp)

      1. (Let SUB typedExp typ be exp as subExp)

        1. (Eval_exp: C |- typedExp : expRes)

          1. Case analysis on expRes (total)

            1. Case (% has type failure)

              1. (Let failure be expRes as failure)

                1. Result in: % |- % : failure as expRes

            2. Case (% has type ok<val>)

              1. (Let OK val be expRes as ok<val>)

                1. (Let `{ id_local ':' typDef_local*{id_local <- id_local*, typDef_local <- typDef_local*} `} be C.LOCAL.TYP)

                  1. (Let tdenv be $adds_map<id, typDef>(C.GLOBAL.TYP, id_local*{id_local <- id_local*}, typDef_local*{typDef_local <- typDef_local*}))

                    1. (Let subtypRes be $subtyp(C.GLOBAL.FUNC, tdenv, typ, val))

                      1. If (subtypRes <: ok<bool>), then

                        1. (Let OK b be subtypRes as ok<bool>)

                          1. Result in: % |- % : OK BOOL b as expRes

    9. Case (% has type matchExp)

      1. (Let MATCH typedExp pat be exp as matchExp)

        1. (Eval_exp: C |- typedExp : expRes)

          1. Case analysis on expRes (total)

            1. Case (% has type failure)

              1. (Let failure be expRes as failure)

                1. Result in: % |- % : failure as expRes

            2. Case (% has type ok<val>)

              1. (Let OK val be expRes as ok<val>)

                1. (Let b_matches be $matches(val, pat))

                  1. Result in: % |- % : OK BOOL b_matches as expRes

    10. Case (% has type tupExp)

      1. (Let TUP typedExp*{typedExp <- typedExp*} be exp as tupExp)

        1. (Eval_exps: C |- typedExp*{typedExp <- typedExp*} : expsRes)

          1. Case analysis on expsRes (total)

            1. Case (% has type failure)

              1. (Let failure be expsRes as failure)

                1. Result in: % |- % : failure as expRes

            2. Case (% has type ok<val*>)

              1. (Let OK val*{val <- val*} be expsRes as ok<val*>)

                1. Result in: % |- % : OK TUP val*{val <- val*} as expRes

    11. Case (% has type injExp)

      1. (Let INJ mixop typedExp*{typedExp <- typedExp*} be exp as injExp)

        1. (Eval_exps: C |- typedExp*{typedExp <- typedExp*} : expsRes)

          1. Case analysis on expsRes (total)

            1. Case (% has type failure)

              1. (Let failure be expsRes as failure)

                1. Result in: % |- % : failure as expRes

            2. Case (% has type ok<val*>)

              1. (Let OK val*{val <- val*} be expsRes as ok<val*>)

                1. Result in: % |- % : OK INJ mixop val*{val <- val*} as expRes

    12. Case (% has type strExp)

      1. (Let STR expField*{expField <- expField*} be exp as strExp)

        1. (Let atom typedExp be expField)*{expField <- expField*, atom -> atom*, typedExp -> typedExp*}

          1. (Eval_exps: C |- typedExp*{typedExp <- typedExp*} : expsRes)

            1. Case analysis on expsRes (total)

              1. Case (% has type failure)

                1. (Let failure be expsRes as failure)

                  1. Result in: % |- % : failure as expRes

              2. Case (% has type ok<val*>)

                1. (Let OK val*{val <- val*} be expsRes as ok<val*>)

                  1. If ((|atom*{atom <- atom*}| = |val*{val <- val*}|)), then

                    1. (Let valField be atom val)*{atom <- atom*, val <- val*, valField -> valField*}

                      1. Result in: % |- % : OK STR valField*{valField <- valField*} as expRes

    13. Case (% has type optExp)

      1. (Let OPT typedExp''?{typedExp'' <- typedExp''?} be exp as optExp)

        1. Case analysis on typedExp''?{typedExp'' <- typedExp''?} (total)

          1. Case (% matches pattern ())

            1. Result in: % |- % : OK OPT ?() as expRes

          2. Case (% matches pattern (_))

            1. (Let ?(typedExp) be typedExp''?{typedExp'' <- typedExp''?})

              1. (Eval_exp: C |- typedExp : expRes)

                1. Case analysis on expRes (total)

                  1. Case (% has type failure)

                    1. (Let failure be expRes as failure)

                      1. Result in: % |- % : failure as expRes

                  2. Case (% has type ok<val>)

                    1. (Let OK val be expRes as ok<val>)

                      1. Result in: % |- % : OK OPT ?(val) as expRes

    14. Case (% has type listExp)

      1. (Let LIST typedExp*{typedExp <- typedExp*} be exp as listExp)

        1. (Eval_exps: C |- typedExp*{typedExp <- typedExp*} : expsRes)

          1. Case analysis on expsRes (total)

            1. Case (% has type failure)

              1. (Let failure be expsRes as failure)

                1. Result in: % |- % : failure as expRes

            2. Case (% has type ok<val*>)

              1. (Let OK val*{val <- val*} be expsRes as ok<val*>)

                1. Result in: % |- % : OK LIST val*{val <- val*} as expRes

    15. Case (% has type consExp)

      1. (Let CONS typedExp_h typedExp_t be exp as consExp)

        1. (Eval_exp: C |- typedExp_h : expRes)

          1. Case analysis on expRes (total)

            1. Case (% has type failure)

              1. (Let failure be expRes as failure)

                1. Result in: % |- % : failure as expRes

            2. Case (% has type ok<val>)

              1. (Let OK val_h be expRes as ok<val>)

                1. (Eval_exp: C |- typedExp_t : expRes')

                  1. Case analysis on expRes' (total)

                    1. Case (% has type failure)

                      1. (Let failure be expRes' as failure)

                        1. Result in: % |- % : failure as expRes

                    2. Case (% has type ok<val>)

                      1. (Let OK val be expRes' as ok<val>)

                        1. If (val matches LIST %), then

                          1. (Let LIST val_t*{val_t <- val_t*} be val)

                            1. Result in: % |- % : OK LIST val_h :: val_t*{val_t <- val_t*} as expRes

    16. Case (% has type catExp)

      1. (Let CAT typedExp_l typedExp_r be exp as catExp)

        1. (Eval_exp: C |- typedExp_l : expRes)

          1. Case analysis on expRes (total)

            1. Case (% has type failure)

              1. (Let failure be expRes as failure)

                1. Result in: % |- % : failure as expRes

            2. Case (% has type ok<val>)

              1. (Let OK val be expRes as ok<val>)

                1. Case analysis on val

                  1. Case (% matches pattern LIST %)

                    1. (Let LIST val_l*{val_l <- val_l*} be val)

                      1. (Eval_exp: C |- typedExp_r : expRes')

                        1. Case analysis on expRes' (total)

                          1. Case (% has type failure)

                            1. (Let failure be expRes' as failure)

                              1. Result in: % |- % : failure as expRes

                          2. Case (% has type ok<val>)

                            1. (Let OK val' be expRes' as ok<val>)

                              1. If (val' matches LIST %), then

                                1. (Let LIST val_r*{val_r <- val_r*} be val')

                                  1. (Let val_res*{val_res <- val_res*} be val_l*{val_l <- val_l*} ++ val_r*{val_r <- val_r*})

                                    1. Result in: % |- % : OK LIST val_res*{val_res <- val_res*} as expRes

                  2. Case (% matches pattern TEXT %)

                    1. (Let TEXT text_l be val)

                      1. (Eval_exp: C |- typedExp_r : expRes')

                        1. Case analysis on expRes' (total)

                          1. Case (% has type failure)

                            1. (Let failure be expRes' as failure)

                              1. Result in: % |- % : failure as expRes

                          2. Case (% has type ok<val>)

                            1. (Let OK val' be expRes' as ok<val>)

                              1. If (val' matches TEXT %), then

                                1. (Let TEXT t_r be val')

                                  1. (Let t_res be text_l ++ t_r)

                                    1. Result in: % |- % : OK TEXT t_res as expRes

    17. Case (% has type memExp)

      1. (Let MEM typedExp_e typedExp_s be exp as memExp)

        1. (Eval_exp: C |- typedExp_e : expRes)

          1. Case analysis on expRes (total)

            1. Case (% has type failure)

              1. (Let failure be expRes as failure)

                1. Result in: % |- % : failure as expRes

            2. Case (% has type ok<val>)

              1. (Let OK val_e be expRes as ok<val>)

                1. (Eval_exp: C |- typedExp_s : expRes')

                  1. Case analysis on expRes' (total)

                    1. Case (% has type failure)

                      1. (Let failure be expRes' as failure)

                        1. Result in: % |- % : failure as expRes

                    2. Case (% has type ok<val>)

                      1. (Let OK val' be expRes' as ok<val>)

                        1. If (val' matches LIST %), then

                          1. (Let LIST val*{val <- val*} be val')

                            1. (Let b_mem be $exists_((val_e = val)*{val <- val*}))

                              1. Result in: % |- % : OK BOOL b_mem as expRes

    18. Case (% has type lenExp)

      1. (Let LEN typedExp be exp as lenExp)

        1. (Eval_exp: C |- typedExp : expRes)

          1. Case analysis on expRes (total)

            1. Case (% has type failure)

              1. (Let failure be expRes as failure)

                1. Result in: % |- % : failure as expRes

            2. Case (% has type ok<val>)

              1. (Let OK val' be expRes as ok<val>)

                1. Case analysis on val'

                  1. Case (% matches pattern TEXT %)

                    1. (Let TEXT t be val')

                      1. (Let n be |t|)

                        1. Result in: % |- % : OK NAT n as val as expRes

                  2. Case (% matches pattern LIST %)

                    1. (Let LIST val*{val <- val*} be val')

                      1. (Let n be |val*{val <- val*}|)

                        1. Result in: % |- % : OK NAT n as val as expRes

    19. Case (% has type dotAccExp)

      1. (Let DOT typedExp atom be exp as dotAccExp)

        1. (Eval_exp: C |- typedExp : expRes)

          1. Case analysis on expRes (total)

            1. Case (% has type failure)

              1. (Let failure be expRes as failure)

                1. Result in: % |- % : failure as expRes

            2. Case (% has type ok<val>)

              1. (Let OK val be expRes as ok<val>)

                1. (Let _exp '#' typ_b be typedExp)

                  1. (Let typedPath be DOT ROOT as path '#' typ_b atom as path '#' typ')

                    1. (Eval_path_acc: C |- val typedPath : pathRes)

                      1. Result in: % |- % : pathRes as expRes

    20. Case (% has type idxAccExp)

      1. (Let IDX typedExp_b typedExp_i be exp as idxAccExp)

        1. (Eval_exp: C |- typedExp_b : expRes)

          1. Case analysis on expRes (total)

            1. Case (% has type failure)

              1. (Let failure be expRes as failure)

                1. Result in: % |- % : failure as expRes

            2. Case (% has type ok<val>)

              1. (Let OK val_b be expRes as ok<val>)

                1. (Let _exp '#' typ_b be typedExp_b)

                  1. (Let typedPath be IDX ROOT as path '#' typ_b typedExp_i as path '#' typ')

                    1. (Eval_path_acc: C |- val_b typedPath : pathRes)

                      1. Result in: % |- % : pathRes as expRes

    21. Case (% has type sliceAccExp)

      1. (Let SLICE typedExp_b typedExp_i typedExp_n be exp as sliceAccExp)

        1. (Eval_exp: C |- typedExp_b : expRes)

          1. Case analysis on expRes (total)

            1. Case (% has type failure)

              1. (Let failure be expRes as failure)

                1. Result in: % |- % : failure as expRes

            2. Case (% has type ok<val>)

              1. (Let OK val_b be expRes as ok<val>)

                1. (Let _exp '#' typ_b be typedExp_b)

                  1. (Let typedPath be SLICE ROOT as path '#' typ_b typedExp_i typedExp_n as path '#' typ')

                    1. (Eval_path_acc: C |- val_b typedPath : pathRes)

                      1. Result in: % |- % : pathRes as expRes

    22. Case (% has type updExp)

      1. (Let UPD typedExp_b typedPath typedExp_f be exp as updExp)

        1. (Eval_exp: C |- typedExp_b : expRes)

          1. Case analysis on expRes (total)

            1. Case (% has type failure)

              1. (Let failure be expRes as failure)

                1. Result in: % |- % : failure as expRes

            2. Case (% has type ok<val>)

              1. (Let OK val_b be expRes as ok<val>)

                1. (Eval_exp: C |- typedExp_f : expRes')

                  1. Case analysis on expRes' (total)

                    1. Case (% has type failure)

                      1. (Let failure be expRes' as failure)

                        1. Result in: % |- % : failure as expRes

                    2. Case (% has type ok<val>)

                      1. (Let OK val_f be expRes' as ok<val>)

                        1. (Eval_path_upd: C |- val_b typedPath := val_f : pathRes)

                          1. Result in: % |- % : pathRes as expRes

    23. Case (% has type callExp)

      1. (Let CALL id targ*{targ <- targ*} arg*{arg <- arg*} be exp as callExp)

        1. (Eval_targs: C |- targ*{targ <- targ*} : typsRes)

          1. If (typsRes <: ok<typ*>), then

            1. (Let OK typ_input*{typ_input <- typ_input*} be typsRes as ok<typ*>)

              1. (Eval_args: C |- arg*{arg <- arg*} : argsRes)

                1. Case analysis on argsRes (total)

                  1. Case (% has type failure)

                    1. (Let failure be argsRes as failure)

                      1. Result in: % |- % : failure as expRes

                  2. Case (% has type ok<val*>)

                    1. (Let OK val_input*{val_input <- val_input*} be argsRes as ok<val*>)

                      1. (Call_func: C |- id `< typ_input*{typ_input <- typ_input*} `> `( val_input*{val_input <- val_input*} `) : callFuncRes)

                        1. Result in: % |- % : callFuncRes as expRes

    24. Case (% has type iterExp)

      1. (Let iterExp be exp as iterExp)

        1. (Let varr'?{varr' <- varr'?} be $is_iter_on_var(iterExp as exp '#' typ'))

          1. If (varr'?{varr' <- varr'?} matches (_)), then

            1. (Let ?(varr) be varr'?{varr' <- varr'?})

              1. (Let val'?{val' <- val'?} be $find_varr(C, varr))

                1. If (val'?{val' <- val'?} matches (_)), then

                  1. (Let ?(val) be val'?{val' <- val'?})

                    1. Result in: % |- % : OK val as expRes

        2. If ($is_iter_on_var(iterExp as exp '#' typ') matches ()), then

          1. (Let ITER typedExp iter vari*{vari <- vari*} be iterExp)

            1. Case analysis on iter (total)

              1. Case (% matches pattern QUEST)

                1. (Let subOptRes be $sub_opt(C, vari*{vari <- vari*}))

                  1. If (subOptRes <: ok<ctx?>), then

                    1. (Let OK C_sub?{C_sub <- C_sub?} be subOptRes as ok<ctx?>)

                      1. (Eval_exp_maybe: C_sub?{C_sub <- C_sub?} |- typedExp : expOptRes)

                        1. Case analysis on expOptRes (total)

                          1. Case (% has type failure)

                            1. (Let failure be expOptRes as failure)

                              1. Result in: % |- % : failure as expRes

                          2. Case (% has type ok<val?>)

                            1. (Let OK val?{val <- val?} be expOptRes as ok<val?>)

                              1. Result in: % |- % : OK OPT val?{val <- val?} as expRes

              2. Case (% matches pattern STAR)

                1. (Let subListRes be $sub_list(C, vari*{vari <- vari*}))

                  1. If (subListRes <: ok<ctx*>), then

                    1. (Let OK C_sub*{C_sub <- C_sub*} be subListRes as ok<ctx*>)

                      1. (Eval_exp_each: C_sub*{C_sub <- C_sub*} |- typedExp : expsRes)

                        1. Case analysis on expsRes (total)

                          1. Case (% has type failure)

                            1. (Let failure be expsRes as failure)

                              1. Result in: % |- % : failure as expRes

                          2. Case (% has type ok<val*>)

                            1. (Let OK val*{val <- val*} be expsRes as ok<val*>)

                              1. Result in: % |- % : OK LIST val*{val <- val*} as expRes

  2. If (exp <: num), then

    1. (Let num be exp as num)

      1. Result in: % |- % : OK num as val as expRes

2. Otherwise,

  1. Result in: % |- % : ERROR as expRes

syntax expsRes =
   | OK val* (from ok<val*>)
   | ERROR (from error)
   | UNMATCH (from unmatch)

relation Eval_exps: C |- typedExp*{typedExp <- typedExp*} : %

1. Case analysis on typedExp*{typedExp <- typedExp*} (total)

  1. Case (% matches pattern [])

    1. Result in: % |- % : OK [] as expsRes

  2. Case (% matches pattern _ :: _)

    1. (Let typedExp_h :: typedExp_t*{typedExp_t <- typedExp_t*} be typedExp*{typedExp <- typedExp*})

      1. (Eval_exp: C |- typedExp_h : expRes)

        1. Case analysis on expRes (total)

          1. Case (% has type failure)

            1. (Let failure be expRes as failure)

              1. Result in: % |- % : failure as expsRes

          2. Case (% has type ok<val>)

            1. (Let OK val_h be expRes as ok<val>)

              1. (Eval_exps: C |- typedExp_t*{typedExp_t <- typedExp_t*} : expsRes)

                1. Case analysis on expsRes (total)

                  1. Case (% has type failure)

                    1. (Let failure be expsRes as failure)

                      1. Result in: % |- % : failure as expsRes

                  2. Case (% has type ok<val*>)

                    1. (Let OK val_t*{val_t <- val_t*} be expsRes as ok<val*>)

                      1. Result in: % |- % : OK val_h :: val_t*{val_t <- val_t*} as expsRes

syntax expOptRes =
   | OK val? (from ok<val?>)
   | ERROR (from error)
   | UNMATCH (from unmatch)

relation Eval_exp_maybe: C'?{C' <- C'?} |- typedExp : %

1. Case analysis on C'?{C' <- C'?} (total)

  1. Case (% matches pattern ())

    1. Result in: % |- % : OK ?() as expOptRes

  2. Case (% matches pattern (_))

    1. (Let ?(C) be C'?{C' <- C'?})

      1. (Eval_exp: C |- typedExp : expRes)

        1. Case analysis on expRes (total)

          1. Case (% has type failure)

            1. (Let failure be expRes as failure)

              1. Result in: % |- % : failure as expOptRes

          2. Case (% has type ok<val>)

            1. (Let OK val be expRes as ok<val>)

              1. Result in: % |- % : OK ?(val) as expOptRes

relation Eval_exp_each: C*{C <- C*} |- typedExp : %

1. Case analysis on C*{C <- C*} (total)

  1. Case (% matches pattern [])

    1. Result in: % |- % : OK [] as expsRes

  2. Case (% matches pattern _ :: _)

    1. (Let C_h :: C_t*{C_t <- C_t*} be C*{C <- C*})

      1. (Eval_exp: C_h |- typedExp : expRes)

        1. Case analysis on expRes (total)

          1. Case (% has type failure)

            1. (Let failure be expRes as failure)

              1. Result in: % |- % : failure as expsRes

          2. Case (% has type ok<val>)

            1. (Let OK val_h be expRes as ok<val>)

              1. (Eval_exp_each: C_t*{C_t <- C_t*} |- typedExp : expsRes)

                1. Case analysis on expsRes (total)

                  1. Case (% has type failure)

                    1. (Let failure be expsRes as failure)

                      1. Result in: % |- % : failure as expsRes

                  2. Case (% has type ok<val*>)

                    1. (Let OK val_t*{val_t <- val_t*} be expsRes as ok<val*>)

                      1. Result in: % |- % : OK val_h :: val_t*{val_t <- val_t*} as expsRes

syntax pathRes =
   | OK val (from ok<val>)
   | ERROR (from error)
   | UNMATCH (from unmatch)

relation Eval_path_acc: C |- val_b typedPath' : %

1. (Let path '#' _typ be typedPath')

  1. Case analysis on path (total)

    1. Case (% has type rootPath)

      1. (Let rootPath be path as rootPath)

        1. Result in: % |- % % : OK val_b as pathRes

    2. Case (% has type idxPath)

      1. (Let IDX typedPath typedExp_i be path as idxPath)

        1. (Eval_path_acc: C |- val_b typedPath : pathRes)

          1. Case analysis on pathRes (total)

            1. Case (% has type failure)

              1. (Let failure be pathRes as failure)

                1. Result in: % |- % % : failure as pathRes

            2. Case (% has type ok<val>)

              1. (Let OK val' be pathRes as ok<val>)

                1. Case analysis on val'

                  1. Case (% matches pattern LIST %)

                    1. (Let LIST val*{val <- val*} be val')

                      1. (Eval_exp: C |- typedExp_i : expRes)

                        1. Case analysis on expRes (total)

                          1. Case (% has type failure)

                            1. (Let failure be expRes as failure)

                              1. Result in: % |- % % : failure as pathRes

                          2. Case (% has type ok<val>)

                            1. (Let OK val'' be expRes as ok<val>)

                              1. If (val'' <: num), then

                                1. (Let num be val'' as num)

                                  1. If (num matches NAT %), then

                                    1. (Let NAT n be num)

                                      1. If ((n < |val*{val <- val*}|)), then

                                        1. (Let val_idx be val*{val <- val*}[n])

                                          1. Result in: % |- % % : OK val_idx as pathRes

                  2. Case (% matches pattern TEXT %)

                    1. (Let TEXT t be val')

                      1. (Eval_exp: C |- typedExp_i : expRes)

                        1. Case analysis on expRes (total)

                          1. Case (% has type failure)

                            1. (Let failure be expRes as failure)

                              1. Result in: % |- % % : failure as pathRes

                          2. Case (% has type ok<val>)

                            1. (Let OK val be expRes as ok<val>)

                              1. If (val <: num), then

                                1. (Let num be val as num)

                                  1. If (num matches NAT %), then

                                    1. (Let NAT n be num)

                                      1. If ((n < |t|)), then

                                        1. (Let t_idx be t[n])

                                          1. Result in: % |- % % : OK TEXT t_idx as pathRes

    3. Case (% has type slicePath)

      1. (Let SLICE typedPath typedExp_i typedExp_n be path as slicePath)

        1. (Eval_path_acc: C |- val_b typedPath : pathRes)

          1. Case analysis on pathRes (total)

            1. Case (% has type failure)

              1. (Let failure be pathRes as failure)

                1. Result in: % |- % % : failure as pathRes

            2. Case (% has type ok<val>)

              1. (Let OK val' be pathRes as ok<val>)

                1. Case analysis on val'

                  1. Case (% matches pattern TEXT %)

                    1. (Let TEXT t be val')

                      1. (Eval_exp: C |- typedExp_i : expRes)

                        1. Case analysis on expRes (total)

                          1. Case (% has type failure)

                            1. (Let failure be expRes as failure)

                              1. Result in: % |- % % : failure as pathRes

                          2. Case (% has type ok<val>)

                            1. (Let OK val be expRes as ok<val>)

                              1. If (val <: num), then

                                1. (Let num be val as num)

                                  1. If (num matches NAT %), then

                                    1. (Let NAT n_i be num)

                                      1. (Eval_exp: C |- typedExp_n : expRes')

                                        1. Case analysis on expRes' (total)

                                          1. Case (% has type failure)

                                            1. (Let failure be expRes' as failure)

                                              1. Result in: % |- % % : failure as pathRes

                                          2. Case (% has type ok<val>)

                                            1. (Let OK val'' be expRes' as ok<val>)

                                              1. If (val'' <: num), then

                                                1. (Let num' be val'' as num)

                                                  1. If (num' matches NAT %), then

                                                    1. (Let NAT n_n be num')

                                                      1. If (((n_i + n_n) <= |t|)), then

                                                        1. (Let val_slice be TEXT t[n_i : n_n])

                                                          1. Result in: % |- % % : OK val_slice as pathRes

                  2. Case (% matches pattern LIST %)

                    1. (Let LIST val*{val <- val*} be val')

                      1. (Eval_exp: C |- typedExp_i : expRes)

                        1. Case analysis on expRes (total)

                          1. Case (% has type failure)

                            1. (Let failure be expRes as failure)

                              1. Result in: % |- % % : failure as pathRes

                          2. Case (% has type ok<val>)

                            1. (Let OK val'' be expRes as ok<val>)

                              1. If (val'' <: num), then

                                1. (Let num be val'' as num)

                                  1. If (num matches NAT %), then

                                    1. (Let NAT n_i be num)

                                      1. (Eval_exp: C |- typedExp_n : expRes')

                                        1. Case analysis on expRes' (total)

                                          1. Case (% has type failure)

                                            1. (Let failure be expRes' as failure)

                                              1. Result in: % |- % % : failure as pathRes

                                          2. Case (% has type ok<val>)

                                            1. (Let OK val''' be expRes' as ok<val>)

                                              1. If (val''' <: num), then

                                                1. (Let num' be val''' as num)

                                                  1. If (num' matches NAT %), then

                                                    1. (Let NAT n_n be num')

                                                      1. If (((n_i + n_n) <= |val*{val <- val*}|)), then

                                                        1. (Let val_slice be LIST val*{val <- val*}[n_i : n_n])

                                                          1. Result in: % |- % % : OK val_slice as pathRes

    4. Case (% has type dotPath)

      1. (Let DOT typedPath atom be path as dotPath)

        1. (Eval_path_acc: C |- val_b typedPath : pathRes)

          1. Case analysis on pathRes (total)

            1. Case (% has type failure)

              1. (Let failure be pathRes as failure)

                1. Result in: % |- % % : failure as pathRes

            2. Case (% has type ok<val>)

              1. (Let OK val' be pathRes as ok<val>)

                1. If (val' matches STR %), then

                  1. (Let STR valField*{valField <- valField*} be val')

                    1. (Let atom_field val_field be valField)*{valField <- valField*, atom_field -> atom_field*, val_field -> val_field*}

                      1. (Let val''?{val'' <- val''?} be $assoc_<atom, val>(atom, (atom_field, val_field)*{atom_field <- atom_field*, val_field <- val_field*}))

                        1. If (val''?{val'' <- val''?} matches (_)), then

                          1. (Let ?(val) be val''?{val'' <- val''?})

                            1. Result in: % |- % % : OK val as pathRes

2. Otherwise,

  1. Result in: % |- % % : ERROR as pathRes

relation Eval_path_upd: C |- val_b typedPath' := val_n' : %

1. (Let path '#' _typ be typedPath')

  1. Case analysis on path (total)

    1. Case (% has type rootPath)

      1. (Let rootPath be path as rootPath)

        1. Result in: % |- % % := % : OK val_n' as pathRes

    2. Case (% has type idxPath)

      1. (Let IDX typedPath typedExp_i be path as idxPath)

        1. (Eval_path_acc: C |- val_b typedPath : pathRes')

          1. Case analysis on pathRes' (total)

            1. Case (% has type failure)

              1. (Let failure be pathRes' as failure)

                1. Result in: % |- % % := % : failure as pathRes

            2. Case (% has type ok<val>)

              1. (Let OK val' be pathRes' as ok<val>)

                1. Case analysis on val'

                  1. Case (% matches pattern LIST %)

                    1. (Let LIST val*{val <- val*} be val')

                      1. (Eval_exp: C |- typedExp_i : expRes)

                        1. Case analysis on expRes (total)

                          1. Case (% has type failure)

                            1. (Let failure be expRes as failure)

                              1. Result in: % |- % % := % : failure as pathRes

                          2. Case (% has type ok<val>)

                            1. (Let OK val'' be expRes as ok<val>)

                              1. If (val'' <: num), then

                                1. (Let num be val'' as num)

                                  1. If (num matches NAT %), then

                                    1. (Let NAT n_target be num)

                                      1. If ((n_target < |val*{val <- val*}|)), then

                                        1. (Let val_upd be LIST val*{val <- val*}[[n_target] = val_n'])

                                          1. (Eval_path_upd: C |- val_b typedPath := val_upd : pathRes)

                                            1. Result in: % |- % % := % : pathRes

                  2. Case (% matches pattern TEXT %)

                    1. (Eval_exp: C |- typedExp_i : expRes)

                      1. If (expRes <: failure), then

                        1. (Let failure be expRes as failure)

                          1. Result in: % |- % % := % : failure as pathRes

        2. If (val_n' matches TEXT %), then

          1. (Let TEXT t_n be val_n')

            1. (Eval_path_acc: C |- val_b typedPath : pathRes')

              1. If (pathRes' <: ok<val>), then

                1. (Let OK val be pathRes' as ok<val>)

                  1. If (val matches TEXT %), then

                    1. (Let TEXT t be val)

                      1. (Eval_exp: C |- typedExp_i : expRes)

                        1. If (expRes <: ok<val>), then

                          1. (Let OK val' be expRes as ok<val>)

                            1. If (val' <: num), then

                              1. (Let num be val' as num)

                                1. If (num matches NAT %), then

                                  1. (Let NAT n_target be num)

                                    1. If ((n_target < |t|)), then

                                      1. If ((|t_n| = 1)), then

                                        1. (Let val_upd be TEXT t[[n_target] = t_n])

                                          1. (Eval_path_upd: C |- val_b typedPath := val_upd : pathRes)

                                            1. Result in: % |- % % := % : pathRes

    3. Case (% has type slicePath)

      1. (Let SLICE typedPath typedExp_i typedExp_n be path as slicePath)

        1. (Eval_path_acc: C |- val_b typedPath : pathRes)

          1. Case analysis on pathRes (total)

            1. Case (% has type failure)

              1. (Let failure be pathRes as failure)

                1. Result in: % |- % % := % : failure as pathRes

            2. Case (% has type ok<val>)

              1. (Let OK val be pathRes as ok<val>)

                1. If (val matches TEXT %), then

                  1. (Eval_exp: C |- typedExp_i : expRes)

                    1. Case analysis on expRes (total)

                      1. Case (% has type failure)

                        1. (Let failure be expRes as failure)

                          1. Result in: % |- % % := % : failure as pathRes

                      2. Case (% has type ok<val>)

                        1. (Let OK val' be expRes as ok<val>)

                          1. If (val' <: num), then

                            1. (Let num be val' as num)

                              1. If (num matches NAT %), then

                                1. (Eval_exp: C |- typedExp_n : expRes')

                                  1. If (expRes' <: failure), then

                                    1. (Let failure be expRes' as failure)

                                      1. Result in: % |- % % := % : failure as pathRes

        2. If (val_n' matches TEXT %), then

          1. (Let TEXT t_n be val_n')

            1. (Eval_path_acc: C |- val_b typedPath : pathRes')

              1. If (pathRes' <: ok<val>), then

                1. (Let OK val be pathRes' as ok<val>)

                  1. If (val matches TEXT %), then

                    1. (Let TEXT t be val)

                      1. (Eval_exp: C |- typedExp_i : expRes)

                        1. If (expRes <: ok<val>), then

                          1. (Let OK val' be expRes as ok<val>)

                            1. If (val' <: num), then

                              1. (Let num be val' as num)

                                1. If (num matches NAT %), then

                                  1. (Let NAT n_i be num)

                                    1. (Eval_exp: C |- typedExp_n : expRes')

                                      1. If (expRes' <: ok<val>), then

                                        1. (Let OK val'' be expRes' as ok<val>)

                                          1. If (val'' <: num), then

                                            1. (Let num' be val'' as num)

                                              1. If (num' matches NAT %), then

                                                1. (Let NAT n_n be num')

                                                  1. If (((n_i + n_n) <= |t|)), then

                                                    1. If ((|t_n| = n_n)), then

                                                      1. (Let val_upd be TEXT t[[n_i : n_n] = t_n])

                                                        1. (Eval_path_upd: C |- val_b typedPath := val_upd : pathRes)

                                                          1. Result in: % |- % % := % : pathRes

        3. (Eval_path_acc: C |- val_b typedPath : pathRes)

          1. If (pathRes <: ok<val>), then

            1. (Let OK val be pathRes as ok<val>)

              1. If (val matches LIST %), then

                1. (Eval_exp: C |- typedExp_i : expRes)

                  1. Case analysis on expRes (total)

                    1. Case (% has type failure)

                      1. (Let failure be expRes as failure)

                        1. Result in: % |- % % := % : failure as pathRes

                    2. Case (% has type ok<val>)

                      1. (Let OK val' be expRes as ok<val>)

                        1. If (val' <: num), then

                          1. (Let num be val' as num)

                            1. If (num matches NAT %), then

                              1. (Eval_exp: C |- typedExp_n : expRes')

                                1. If (expRes' <: failure), then

                                  1. (Let failure be expRes' as failure)

                                    1. Result in: % |- % % := % : failure as pathRes

        4. If (val_n' matches LIST %), then

          1. (Let LIST val_n*{val_n <- val_n*} be val_n')

            1. (Eval_path_acc: C |- val_b typedPath : pathRes')

              1. If (pathRes' <: ok<val>), then

                1. (Let OK val' be pathRes' as ok<val>)

                  1. If (val' matches LIST %), then

                    1. (Let LIST val*{val <- val*} be val')

                      1. (Eval_exp: C |- typedExp_i : expRes)

                        1. If (expRes <: ok<val>), then

                          1. (Let OK val'' be expRes as ok<val>)

                            1. If (val'' <: num), then

                              1. (Let num be val'' as num)

                                1. If (num matches NAT %), then

                                  1. (Let NAT n_i be num)

                                    1. (Eval_exp: C |- typedExp_n : expRes')

                                      1. If (expRes' <: ok<val>), then

                                        1. (Let OK val''' be expRes' as ok<val>)

                                          1. If (val''' <: num), then

                                            1. (Let num' be val''' as num)

                                              1. If (num' matches NAT %), then

                                                1. (Let NAT n_n be num')

                                                  1. If (((n_i + n_n) <= |val*{val <- val*}|)), then

                                                    1. If ((|val_n*{val_n <- val_n*}| = n_n)), then

                                                      1. (Let val_upd be LIST val*{val <- val*}[[n_i : n_n] = val_n*{val_n <- val_n*}])

                                                        1. (Eval_path_upd: C |- val_b typedPath := val_upd : pathRes)

                                                          1. Result in: % |- % % := % : pathRes

    4. Case (% has type dotPath)

      1. (Let DOT typedPath atom be path as dotPath)

        1. (Eval_path_acc: C |- val_b typedPath : pathRes')

          1. Case analysis on pathRes' (total)

            1. Case (% has type failure)

              1. (Let failure be pathRes' as failure)

                1. Result in: % |- % % := % : failure as pathRes

            2. Case (% has type ok<val>)

              1. (Let OK val be pathRes' as ok<val>)

                1. If (val matches STR %), then

                  1. (Let STR valField*{valField <- valField*} be val)

                    1. (Let atom_field val_field be valField)*{valField <- valField*, atom_field -> atom_field*, val_field -> val_field*}

                      1. (Let valField_new be atom_field $ite<val>((atom = atom_field), val_n', val_field))*{atom_field <- atom_field*, val_field <- val_field*, valField_new -> valField_new*}

                        1. (Let val_upd be STR valField_new*{valField_new <- valField_new*})

                          1. (Eval_path_upd: C |- val_b typedPath := val_upd : pathRes)

                            1. Result in: % |- % % := % : pathRes

2. Otherwise,

  1. Result in: % |- % % := % : ERROR as pathRes

relation Eval_targs: C |- targ*{targ <- targ*} : %

1. (Let theta be $theta_of_tdenv(C.LOCAL.TYP))

  1. (Let typsRes be $subst_typs(theta, targ*{targ <- targ*}))

    1. Result in: % |- % : typsRes

2. Otherwise,

  1. Result in: % |- % : ERROR as typsRes

syntax argRes =
   | OK val (from ok<val>)
   | ERROR (from error)
   | UNMATCH (from unmatch)

relation Eval_arg: C |- arg : %

1. Case analysis on arg (total)

  1. Case (% has type expArg)

    1. (Let EXP typedExp be arg as expArg)

      1. (Eval_exp: C |- typedExp : expRes)

        1. If (expRes <: argRes), then

          1. (Let argRes be expRes as argRes)

            1. Result in: % |- % : argRes

  2. Case (% has type funArg)

    1. (Let FUN id be arg as funArg)

      1. (Let id_global be $resolve_func_param(C, id))

        1. Result in: % |- % : OK FUNC id_global as argRes

2. Otherwise,

  1. Result in: % |- % : ERROR as argRes

syntax argsRes =
   | OK val* (from ok<val*>)
   | ERROR (from error)
   | UNMATCH (from unmatch)

relation Eval_args: C |- arg*{arg <- arg*} : %

1. Case analysis on arg*{arg <- arg*} (total)

  1. Case (% matches pattern [])

    1. Result in: % |- % : OK [] as argsRes

  2. Case (% matches pattern _ :: _)

    1. (Let arg_h :: arg_t*{arg_t <- arg_t*} be arg*{arg <- arg*})

      1. (Eval_arg: C |- arg_h : argRes)

        1. Case analysis on argRes (total)

          1. Case (% has type failure)

            1. (Let failure be argRes as failure)

              1. Result in: % |- % : failure as argsRes

          2. Case (% has type ok<val>)

            1. (Let OK val_h be argRes as ok<val>)

              1. (Eval_args: C |- arg_t*{arg_t <- arg_t*} : argsRes)

                1. Case analysis on argsRes (total)

                  1. Case (% has type failure)

                    1. (Let failure be argsRes as failure)

                      1. Result in: % |- % : failure as argsRes

                  2. Case (% has type ok<val*>)

                    1. (Let OK val_t*{val_t <- val_t*} be argsRes as ok<val*>)

                      1. Result in: % |- % : OK val_h :: val_t*{val_t <- val_t*} as argsRes

syntax premRes =
   | OK ctx (from ok<ctx>)
   | ERROR (from error)
   | UNMATCH (from unmatch)

relation Eval_prem: C |- prem' : %

1. Case analysis on prem' (total)

  1. Case (% has type relPrem)

    1. (Let REL id ':' typedExp*{typedExp <- typedExp*} '->' typedExp_out*{typedExp_out <- typedExp_out*} be prem' as relPrem)

      1. (Eval_exps: C |- typedExp*{typedExp <- typedExp*} : expsRes)

        1. Case analysis on expsRes (total)

          1. Case (% has type failure)

            1. (Let failure be expsRes as failure)

              1. Result in: % |- % : failure as premRes

          2. Case (% has type ok<val*>)

            1. (Let OK val*{val <- val*} be expsRes as ok<val*>)

              1. (Call_rel: C |- id `( val*{val <- val*} `) : relRes)

                1. Case analysis on relRes (total)

                  1. Case (% has type failure)

                    1. (Let failure be relRes as failure)

                      1. Result in: % |- % : failure as premRes

                  2. Case (% has type ok<val*>)

                    1. (Let OK val_out*{val_out <- val_out*} be relRes as ok<val*>)

                      1. (Assign_exps: C |- typedExp_out*{typedExp_out <- typedExp_out*} := val_out*{val_out <- val_out*} : assignRes)

                        1. If (assignRes <: ok<ctx>), then

                          1. (Let OK C_assign be assignRes as ok<ctx>)

                            1. Result in: % |- % : OK C_assign as premRes

  2. Case (% has type ifPrem)

    1. (Let IF typedExp be prem' as ifPrem)

      1. (Eval_exp: C |- typedExp : expRes)

        1. If (expRes <: failure), then

          1. (Let failure be expRes as failure)

            1. Result in: % |- % : failure as premRes

        2. Case analysis on expRes

          1. Case (% = OK BOOL false as expRes)

            1. Result in: % |- % : UNMATCH as premRes

          2. Case (% = OK BOOL true as expRes)

            1. Result in: % |- % : OK C as premRes

  3. Case (% has type ifHoldPrem)

    1. (Let IFHOLD id ':' typedExp*{typedExp <- typedExp*} be prem' as ifHoldPrem)

      1. (Eval_exps: C |- typedExp*{typedExp <- typedExp*} : expsRes)

        1. Case analysis on expsRes (total)

          1. Case (% has type failure)

            1. (Let failure be expsRes as failure)

              1. Result in: % |- % : failure as premRes

          2. Case (% has type ok<val*>)

            1. (Let OK val_input*{val_input <- val_input*} be expsRes as ok<val*>)

              1. (Call_rel: C |- id `( val_input*{val_input <- val_input*} `) : relRes)

                1. If (relRes <: failure), then

                  1. (Let failure be relRes as failure)

                    1. Result in: % |- % : failure as premRes

                2. If ((relRes = OK [] as relRes)), then

                  1. Result in: % |- % : OK C as premRes

  4. Case (% has type ifNotHoldPrem)

    1. (Let IFNOTHOLD id ':' typedExp*{typedExp <- typedExp*} be prem' as ifNotHoldPrem)

      1. (Eval_exps: C |- typedExp*{typedExp <- typedExp*} : expsRes)

        1. Case analysis on expsRes (total)

          1. Case (% has type failure)

            1. (Let failure be expsRes as failure)

              1. Result in: % |- % : failure as premRes

          2. Case (% has type ok<val*>)

            1. (Let OK val_input*{val_input <- val_input*} be expsRes as ok<val*>)

              1. (Call_rel: C |- id `( val_input*{val_input <- val_input*} `) : relRes)

                1. Case analysis on relRes (total)

                  1. Case (% has type error)

                    1. (Let error be relRes as error)

                      1. Result in: % |- % : ERROR as premRes

                  2. Case (% has type ok<val*>)

                    1. Result in: % |- % : UNMATCH as premRes

                  3. Case (% has type unmatch)

                    1. (Let unmatch be relRes as unmatch)

                      1. Result in: % |- % : OK C as premRes

  5. Case (% has type letPrem)

    1. (Let LET typedExp_l '=' typedExp_r be prem' as letPrem)

      1. (Eval_exp: C |- typedExp_r : expRes)

        1. Case analysis on expRes (total)

          1. Case (% has type failure)

            1. (Let failure be expRes as failure)

              1. Result in: % |- % : failure as premRes

          2. Case (% has type ok<val>)

            1. (Let OK val_r be expRes as ok<val>)

              1. (Assign_exp: C |- typedExp_l := val_r : assignRes)

                1. If (assignRes <: ok<ctx>), then

                  1. (Let OK C_assign be assignRes as ok<ctx>)

                    1. Result in: % |- % : OK C_assign as premRes

  6. Case (% has type iterPrem)

    1. (Let ITER prem iter '<-' vari_bound*{vari_bound <- vari_bound*} '->' vari*{vari <- vari*} be prem' as iterPrem)

      1. Case analysis on iter (total)

        1. Case (% matches pattern QUEST)

          1. (Let subOptRes be $sub_opt(C, vari_bound*{vari_bound <- vari_bound*}))

            1. If (subOptRes <: ok<ctx?>), then

              1. (Let OK C_sub?{C_sub <- C_sub?} be subOptRes as ok<ctx?>)

                1. (Eval_prem_maybe: C_sub?{C_sub <- C_sub?} |- prem : premOptRes)

                  1. Case analysis on premOptRes (total)

                    1. Case (% has type failure)

                      1. (Let failure be premOptRes as failure)

                        1. Result in: % |- % : failure as premRes

                    2. Case (% has type ok<ctx?>)

                      1. (Let OK C'?{C' <- C'?} be premOptRes as ok<ctx?>)

                        1. If (C'?{C' <- C'?} matches (_)), then

                          1. (Let ?(C_sub_res) be C'?{C' <- C'?})

                            1. (Let val?{val <- val?} be $find_vari(C_sub_res, vari))*{vari <- vari*, val? -> val?*}

                              1. If (val?{val <- val?} matches (_))*{val? <- val?*}, then

                                1. (Let ?(val_bind) be val?{val <- val?})*{val? <- val?*, val_bind -> val_bind*}

                                  1. (Let vari_bind_iter be $iterate_vari(vari, [QUEST]))*{vari <- vari*, vari_bind_iter -> vari_bind_iter*}

                                    1. (Let C_res be $add_varis(C, vari_bind_iter*{vari_bind_iter <- vari_bind_iter*}, OPT ?(val_bind)*{val_bind <- val_bind*}))

                                      1. Result in: % |- % : OK C_res as premRes

                  2. If ((premOptRes = OK ?() as premOptRes)), then

                    1. (Let vari_bind_iter be $iterate_vari(vari, [QUEST]))*{vari <- vari*, vari_bind_iter -> vari_bind_iter*}

                      1. (Let val_bind*{val_bind <- val_bind*} be $repeat_<val>(OPT ?(), |vari*{vari <- vari*}|))

                        1. (Let C_res be $add_varis(C, vari_bind_iter*{vari_bind_iter <- vari_bind_iter*}, val_bind*{val_bind <- val_bind*}))

                          1. Result in: % |- % : OK C_res as premRes

        2. Case (% matches pattern STAR)

          1. If ((OK [] as subListRes = $sub_list(C, vari_bound*{vari_bound <- vari_bound*}))), then

            1. (Let vari_bind_iter be $iterate_vari(vari, [STAR]))*{vari <- vari*, vari_bind_iter -> vari_bind_iter*}

              1. (Let val_bind*{val_bind <- val_bind*} be $repeat_<val>(LIST [], |vari*{vari <- vari*}|))

                1. (Let C_res be $add_varis(C, vari_bind_iter*{vari_bind_iter <- vari_bind_iter*}, val_bind*{val_bind <- val_bind*}))

                  1. Result in: % |- % : OK C_res as premRes

          2. (Let subListRes be $sub_list(C, vari_bound*{vari_bound <- vari_bound*}))

            1. If (subListRes <: ok<ctx*>), then

              1. (Let OK C_sub*{C_sub <- C_sub*} be subListRes as ok<ctx*>)

                1. If (C_sub*{C_sub <- C_sub*} matches _ :: _), then

                  1. (Eval_prem_each: C_sub*{C_sub <- C_sub*} |- prem : premIterRes)

                    1. Case analysis on premIterRes (total)

                      1. Case (% has type failure)

                        1. (Let failure be premIterRes as failure)

                          1. Result in: % |- % : failure as premRes

                      2. Case (% has type ok<ctx*>)

                        1. (Let OK C_sub_res*{C_sub_res <- C_sub_res*} be premIterRes as ok<ctx*>)

                          1. (Let val*{val <- val*}?{val* <- val*?} be $find_varis(C_sub_res, vari*{vari <- vari*}))*{C_sub_res <- C_sub_res*, val*? -> val*?*}

                            1. If (val*{val <- val*}?{val* <- val*?} matches (_))*{val*? <- val*?*}, then

                              1. (Let ?(val_sub_bind*{val_sub_bind <- val_sub_bind*}) be val*{val <- val*}?{val* <- val*?})*{val*? <- val*?*, val_sub_bind* -> val_sub_bind**}

                                1. (Let val_bind*{val_bind <- val_bind*}*{val_bind* <- val_bind**} be $transpose_<val>(val_sub_bind*{val_sub_bind <- val_sub_bind*}*{val_sub_bind* <- val_sub_bind**}))

                                  1. (Let val_res_bind be LIST val_bind*{val_bind <- val_bind*})*{val_bind* <- val_bind**, val_res_bind -> val_res_bind*}

                                    1. (Let vari_bind_iter be $iterate_vari(vari, [STAR]))*{vari <- vari*, vari_bind_iter -> vari_bind_iter*}

                                      1. (Let C_res be $add_varis(C, vari_bind_iter*{vari_bind_iter <- vari_bind_iter*}, val_res_bind*{val_res_bind <- val_res_bind*}))

                                        1. Result in: % |- % : OK C_res as premRes

  7. Case (% has type debugPrem)

    1. (Let DEBUG typedExp be prem' as debugPrem)

      1. (Eval_exp: C |- typedExp : expRes)

        1. Case analysis on expRes (total)

          1. Case (% has type failure)

            1. (Let failure be expRes as failure)

              1. Result in: % |- % : failure as premRes

          2. Case (% has type ok<val>)

            1. (Let OK val be expRes as ok<val>)

              1. Debug: val

              2. Result in: % |- % : OK C as premRes

2. Otherwise,

  1. Result in: % |- % : ERROR as premRes

relation Eval_prems: C |- prem*{prem <- prem*} : %

1. Case analysis on prem*{prem <- prem*} (total)

  1. Case (% matches pattern [])

    1. Result in: % |- % : OK C as premRes

  2. Case (% matches pattern _ :: _)

    1. (Let prem_h :: prem_t*{prem_t <- prem_t*} be prem*{prem <- prem*})

      1. (Eval_prem: C |- prem_h : premRes')

        1. Case analysis on premRes' (total)

          1. Case (% has type failure)

            1. (Let failure be premRes' as failure)

              1. Result in: % |- % : failure as premRes

          2. Case (% has type ok<ctx>)

            1. (Let OK C_h be premRes' as ok<ctx>)

              1. (Eval_prems: C_h |- prem_t*{prem_t <- prem_t*} : premRes)

                1. Result in: % |- % : premRes

syntax premOptRes =
   | OK ctx? (from ok<ctx?>)
   | ERROR (from error)
   | UNMATCH (from unmatch)

relation Eval_prem_maybe: C'?{C' <- C'?} |- prem : %

1. Case analysis on C'?{C' <- C'?} (total)

  1. Case (% matches pattern ())

    1. Result in: % |- % : OK ?() as premOptRes

  2. Case (% matches pattern (_))

    1. (Let ?(C) be C'?{C' <- C'?})

      1. (Eval_prem: C |- prem : premRes)

        1. Case analysis on premRes (total)

          1. Case (% has type failure)

            1. (Let failure be premRes as failure)

              1. Result in: % |- % : failure as premOptRes

          2. Case (% has type ok<ctx>)

            1. (Let OK C_res be premRes as ok<ctx>)

              1. Result in: % |- % : OK ?(C_res) as premOptRes

syntax premIterRes =
   | OK ctx* (from ok<ctx*>)
   | ERROR (from error)
   | UNMATCH (from unmatch)

relation Eval_prem_each: C*{C <- C*} |- prem : %

1. Case analysis on C*{C <- C*} (total)

  1. Case (% matches pattern [])

    1. Result in: % |- % : OK [] as premIterRes

  2. Case (% matches pattern _ :: _)

    1. (Let C_h :: C_t*{C_t <- C_t*} be C*{C <- C*})

      1. (Eval_prem: C_h |- prem : premRes)

        1. Case analysis on premRes (total)

          1. Case (% has type failure)

            1. (Let failure be premRes as failure)

              1. Result in: % |- % : failure as premIterRes

          2. Case (% has type ok<ctx>)

            1. (Let OK C_res be premRes as ok<ctx>)

              1. (Eval_prem_each: C_t*{C_t <- C_t*} |- prem : premIterRes)

                1. Case analysis on premIterRes (total)

                  1. Case (% has type failure)

                    1. (Let failure be premIterRes as failure)

                      1. Result in: % |- % : failure as premIterRes

                  2. Case (% has type ok<ctx*>)

                    1. (Let OK C_t_res*{C_t_res <- C_t_res*} be premIterRes as ok<ctx*>)

                      1. Result in: % |- % : OK C_res :: C_t_res*{C_t_res <- C_t_res*} as premIterRes

syntax callFuncRes =
   | OK val (from ok<val>)
   | ERROR (from error)

relation Call_func: C |- id `< typ*{typ <- typ*} `> `( val*{val <- val*} `) : %

1. (Let id_global be $resolve_func_param(C, id))

  1. (Let funcDefn'?{funcDefn' <- funcDefn'?} be $find_func(C, id_global))

    1. If (funcDefn'?{funcDefn' <- funcDefn'?} matches (_)), then

      1. (Let ?(funcDefn) be funcDefn'?{funcDefn' <- funcDefn'?})

        1. Case analysis on funcDefn

          1. Case (% has type externFuncDefn)

            1. (Let EXTFUNC id_func _tparam*{_tparam <- _tparam*} _param*{_param <- _param*} ':' _typ be funcDefn as externFuncDefn)

              1. (Call_extern_func: |- id_func `< typ*{typ <- typ*} `> `( val*{val <- val*} `) : funcRes)

                1. If (funcRes <: ok<val>), then

                  1. (Let OK val_out be funcRes as ok<val>)

                    1. Result in: % |- % `< % `> `( % `) : OK val_out as callFuncRes

          2. Case (% has type builtinFuncDefn)

            1. (Let BUILTINFUNC id_func _tparam*{_tparam <- _tparam*} _param*{_param <- _param*} ':' _typ be funcDefn as builtinFuncDefn)

              1. (Call_builtin_func: |- id_func `< typ*{typ <- typ*} `> `( val*{val <- val*} `) : funcRes)

                1. If (funcRes <: ok<val>), then

                  1. (Let OK val_out be funcRes as ok<val>)

                    1. Result in: % |- % `< % `> `( % `) : OK val_out as callFuncRes

2. If (typ*{typ <- typ*} matches []), then

  1. (Let id_global be $resolve_func_param(C, id))

    1. (Let funcDefn'?{funcDefn' <- funcDefn'?} be $find_func(C, id_global))

      1. If (funcDefn'?{funcDefn' <- funcDefn'?} matches (_)), then

        1. (Let ?(funcDefn) be funcDefn'?{funcDefn' <- funcDefn'?})

          1. If (funcDefn <: tableFuncDefn), then

            1. (Let tableFuncDefn be funcDefn as tableFuncDefn)

              1. (Call_table_func: C |- tableFuncDefn `( val*{val <- val*} `) : callFuncRes)

                1. Result in: % |- % `< % `> `( % `) : callFuncRes

3. (Let id_global be $resolve_func_param(C, id))

  1. (Let funcDefn'?{funcDefn' <- funcDefn'?} be $find_func(C, id_global))

    1. If (funcDefn'?{funcDefn' <- funcDefn'?} matches (_)), then

      1. (Let ?(funcDefn) be funcDefn'?{funcDefn' <- funcDefn'?})

        1. If (funcDefn <: definedFuncDefn), then

          1. (Let definedFuncDefn be funcDefn as definedFuncDefn)

            1. (Call_defined_func: C |- definedFuncDefn `< typ*{typ <- typ*} `> `( val*{val <- val*} `) : callFuncRes)

              1. Result in: % |- % `< % `> `( % `) : callFuncRes

4. Otherwise,

  1. Result in: % |- % `< % `> `( % `) : ERROR as callFuncRes

relation Call_rel: C |- id `( val*{val <- val*} `) : %

1. (Let relDefn'?{relDefn' <- relDefn'?} be $find_rel(C, id))

  1. If (relDefn'?{relDefn' <- relDefn'?} matches (_)), then

    1. (Let ?(relDefn) be relDefn'?{relDefn' <- relDefn'?})

      1. Case analysis on relDefn (total)

        1. Case (% has type externRelDefn)

          1. (Let EXTREL id_rel ':' _typ*{_typ <- _typ*} '->' _typ'*{_typ' <- _typ'*} be relDefn as externRelDefn)

            1. (Call_extern_rel: |- id_rel `( val*{val <- val*} `) : relRes)

              1. Result in: % |- % `( % `) : relRes

        2. Case (% has type definedRelDefn)

          1. (Let definedRelDefn be relDefn as definedRelDefn)

            1. (Call_defined_rel: C |- definedRelDefn `( val*{val <- val*} `) : relRes)

              1. Result in: % |- % `( % `) : relRes

2. Otherwise,

  1. Result in: % |- % `( % `) : ERROR as relRes

def $numUnOp(numUnOp, num)

1. Case analysis on numUnOp (total)

  1. Case (% matches pattern PLUS)

    1. Case analysis on num (total)

      1. Case (% matches pattern NAT %)

        1. (Let NAT n be num)

          1. Return NAT n as val

      2. Case (% matches pattern INT %)

        1. (Let INT i be num)

          1. Return INT i as val

  2. Case (% matches pattern MINUS)

    1. Case analysis on num (total)

      1. Case (% matches pattern NAT %)

        1. (Let NAT n be num)

          1. Return INT -n as int as val

      2. Case (% matches pattern INT %)

        1. (Let INT i be num)

          1. Return INT -i as val

def $boolBinOp(boolBinOp, b_l, b_r)

1. Case analysis on boolBinOp (total)

  1. Case (% matches pattern AND)

    1. Return (b_l /\ b_r)

  2. Case (% matches pattern OR)

    1. Return (b_l \/ b_r)

  3. Case (% matches pattern IMPL)

    1. Return (b_l => b_r)

  4. Case (% matches pattern EQUIV)

    1. Return (b_l <=> b_r)

syntax numBinOpRes =
   | OK val (from ok<val>)
   | ERROR (from error)

def $numBinOp(numBinOp, num, num')

1. Case analysis on numBinOp

  1. Case (% matches pattern ADD)

    1. Case analysis on num (total)

      1. Case (% matches pattern NAT %)

        1. (Let NAT n_l be num)

          1. If (num' matches NAT %), then

            1. (Let NAT n_r be num')

              1. Return OK NAT (n_l + n_r) as val as numBinOpRes

      2. Case (% matches pattern INT %)

        1. (Let INT i_l be num)

          1. If (num' matches INT %), then

            1. (Let INT i_r be num')

              1. Return OK INT (i_l + i_r) as val as numBinOpRes

  2. Case (% matches pattern SUB)

    1. Case analysis on num (total)

      1. Case (% matches pattern NAT %)

        1. (Let NAT n_l be num)

          1. If (num' matches NAT %), then

            1. (Let NAT n_r be num')

              1. Return OK INT (n_l - n_r) as val as numBinOpRes

      2. Case (% matches pattern INT %)

        1. (Let INT i_l be num)

          1. If (num' matches INT %), then

            1. (Let INT i_r be num')

              1. Return OK INT (i_l - i_r) as val as numBinOpRes

  3. Case (% matches pattern MUL)

    1. Case analysis on num (total)

      1. Case (% matches pattern NAT %)

        1. (Let NAT n_l be num)

          1. If (num' matches NAT %), then

            1. (Let NAT n_r be num')

              1. Return OK NAT (n_l * n_r) as val as numBinOpRes

      2. Case (% matches pattern INT %)

        1. (Let INT i_l be num)

          1. If (num' matches INT %), then

            1. (Let INT i_r be num')

              1. Return OK INT (i_l * i_r) as val as numBinOpRes

  4. Case (% matches pattern DIV)

    1. Case analysis on num (total)

      1. Case (% matches pattern NAT %)

        1. (Let NAT n_l be num)

          1. If (num' matches NAT %), then

            1. (Let NAT n_r be num')

              1. If ((n_r =/= 0)), then

                1. Return OK NAT (n_l / n_r) as val as numBinOpRes

      2. Case (% matches pattern INT %)

        1. (Let INT i_l be num)

          1. If (num' matches INT %), then

            1. (Let INT i_r be num')

              1. If ((i_r =/= +0)), then

                1. Return OK INT (i_l / i_r) as val as numBinOpRes

  5. Case (% matches pattern MOD)

    1. Case analysis on num (total)

      1. Case (% matches pattern NAT %)

        1. (Let NAT n_l be num)

          1. If (num' matches NAT %), then

            1. (Let NAT n_r be num')

              1. If ((n_r =/= 0)), then

                1. Return OK NAT (n_l \ n_r) as val as numBinOpRes

      2. Case (% matches pattern INT %)

        1. (Let INT i_l be num)

          1. If (num' matches INT %), then

            1. (Let INT i_r be num')

              1. If ((i_r =/= +0)), then

                1. Return OK INT (i_l \ i_r) as val as numBinOpRes

2. Otherwise,

  1. Return ERROR as numBinOpRes

def $polyCmpOp(polyCmpOp, val_l, val_r)

1. Case analysis on polyCmpOp (total)

  1. Case (% matches pattern EQ)

    1. Return (val_l = val_r)

  2. Case (% matches pattern NE)

    1. Return (val_l =/= val_r)

syntax numCmpRes =
   | OK bool (from ok<bool>)
   | ERROR (from error)

def $numCmpOp(numCmpOp, num, num')

1. Case analysis on numCmpOp (total)

  1. Case (% matches pattern LT)

    1. Case analysis on num (total)

      1. Case (% matches pattern NAT %)

        1. (Let NAT n_l be num)

          1. If (num' matches NAT %), then

            1. (Let NAT n_r be num')

              1. Return OK (n_l < n_r) as numCmpRes

      2. Case (% matches pattern INT %)

        1. (Let INT i_l be num)

          1. If (num' matches INT %), then

            1. (Let INT i_r be num')

              1. Return OK (i_l < i_r) as numCmpRes

  2. Case (% matches pattern GT)

    1. Case analysis on num (total)

      1. Case (% matches pattern NAT %)

        1. (Let NAT n_l be num)

          1. If (num' matches NAT %), then

            1. (Let NAT n_r be num')

              1. Return OK (n_l > n_r) as numCmpRes

      2. Case (% matches pattern INT %)

        1. (Let INT i_l be num)

          1. If (num' matches INT %), then

            1. (Let INT i_r be num')

              1. Return OK (i_l > i_r) as numCmpRes

  3. Case (% matches pattern LE)

    1. Case analysis on num (total)

      1. Case (% matches pattern NAT %)

        1. (Let NAT n_l be num)

          1. If (num' matches NAT %), then

            1. (Let NAT n_r be num')

              1. Return OK (n_l <= n_r) as numCmpRes

      2. Case (% matches pattern INT %)

        1. (Let INT i_l be num)

          1. If (num' matches INT %), then

            1. (Let INT i_r be num')

              1. Return OK (i_l <= i_r) as numCmpRes

  4. Case (% matches pattern GE)

    1. Case analysis on num (total)

      1. Case (% matches pattern NAT %)

        1. (Let NAT n_l be num)

          1. If (num' matches NAT %), then

            1. (Let NAT n_r be num')

              1. Return OK (n_l >= n_r) as numCmpRes

      2. Case (% matches pattern INT %)

        1. (Let INT i_l be num)

          1. If (num' matches INT %), then

            1. (Let INT i_r be num')

              1. Return OK (i_l >= i_r) as numCmpRes

2. Otherwise,

  1. Return ERROR as numCmpRes

def $matches(val', pat)

1. Case analysis on val'

  1. Case (% matches pattern INJ %)

    1. (Let INJ mixop_v val*{val <- val*} be val')

      1. If (pat matches INJ %), then

        1. (Let INJ mixop_p be pat)

          1. Return (mixop_v = mixop_p)

  2. Case (% matches pattern LIST %)

    1. (Let LIST val*{val <- val*} be val')

      1. If (pat <: listPat), then

        1. (Let listPat be pat as listPat)

          1. Case analysis on listPat (total)

            1. Case (% matches pattern CONS)

              1. Return (|val*{val <- val*}| > 0)

            2. Case (% matches pattern FIXED %)

              1. (Let FIXED n be listPat)

                1. Return (|val*{val <- val*}| = n)

            3. Case (% matches pattern NIL)

              1. Return (|val*{val <- val*}| = 0)

  3. Case (% matches pattern OPT %)

    1. (Let OPT val?{val <- val?} be val')

      1. If (pat <: optPat), then

        1. (Let optPat be pat as optPat)

          1. Case analysis on optPat (total)

            1. Case (% matches pattern SOME)

              1. Return (val?{val <- val?} =/= ?())

            2. Case (% matches pattern NONE)

              1. Return (val?{val <- val?} = ?())

2. Otherwise,

  1. Return false

syntax subtypRes =
   | OK bool (from ok<bool>)
   | ERROR (from error)

def $subtyp(fenv, tdenv, typ', val'')

1. Case analysis on typ' (total)

  1. Case (% has type optyp)

    1. (Let optyp be typ' as optyp)

      1. Case analysis on optyp

        1. Case (% matches pattern BOOL)

          1. If (val'' matches BOOL %), then

            1. Return OK true as subtypRes

        2. Case (% matches pattern TEXT)

          1. If (val'' matches TEXT %), then

            1. Return OK true as subtypRes

  2. Case (% matches pattern VAR % %)

    1. (Let VAR id targ*{targ <- targ*} be typ')

      1. Return $subtyp_var(fenv, tdenv, id, targ*{targ <- targ*}, val'')

  3. Case (% matches pattern TUP %)

    1. (Let TUP typ*{typ <- typ*} be typ')

      1. If (val'' matches TUP %), then

        1. (Let TUP val*{val <- val*} be val'')

          1. Return $subtyps(fenv, tdenv, typ*{typ <- typ*}, val*{val <- val*})

  4. Case (% matches pattern ITER % %)

    1. (Let ITER typ iter be typ')

      1. Case analysis on iter (total)

        1. Case (% matches pattern QUEST)

          1. If (val'' matches OPT %), then

            1. (Let OPT val'?{val' <- val'?} be val'')

              1. If (val'?{val' <- val'?} matches (_)), then

                1. (Let ?(val) be val'?{val' <- val'?})

                  1. Return $subtyp(fenv, tdenv, typ, val)

          2. If ((val'' = OPT ?())), then

            1. Return OK true as subtypRes

        2. Case (% matches pattern STAR)

          1. If (val'' matches LIST %), then

            1. (Let LIST val*{val <- val*} be val'')

              1. Return $subtyp_list(fenv, tdenv, typ, val*{val <- val*})

  5. Case (% matches pattern FUNC % % %)

    1. (Let FUNC tparam*{tparam <- tparam*} typ*{typ <- typ*} typ_ret be typ')

      1. If (val'' matches FUNC %), then

        1. (Let FUNC id be val'')

          1. Return $subtyp_func(fenv, tdenv, FUNC tparam*{tparam <- tparam*} typ*{typ <- typ*} typ_ret, id)

2. If (typ' <: numtyp), then

  1. (Let numtyp be typ' as numtyp)

    1. Case analysis on numtyp (total)

      1. Case (% matches pattern NAT)

        1. If (val'' <: num), then

          1. (Let num be val'' as num)

            1. Case analysis on num (total)

              1. Case (% matches pattern NAT %)

                1. Return OK true as subtypRes

              2. Case (% matches pattern INT %)

                1. (Let INT i be num)

                  1. Return OK (i >= 0 as int) as subtypRes

      2. Case (% matches pattern INT)

        1. If (val'' <: num), then

          1. Return OK true as subtypRes

3. Otherwise,

  1. Return OK false as subtypRes

def $subtyp_var(fenv, tdenv, id, targ*{targ <- targ*}, val)

1. (Let typDef'?{typDef' <- typDef'?} be $find_map<id, typDef>(tdenv, id))

  1. If (typDef'?{typDef' <- typDef'?} matches (_)), then

    1. (Let ?(typDef) be typDef'?{typDef' <- typDef'?})

      1. Return $subtyp_def(fenv, tdenv, typDef, targ*{targ <- targ*}, val)

2. Otherwise,

  1. Return ERROR as subtypRes

def $subtyp_def(fenv, tdenv, typDef, typ'*{typ' <- typ'*}, val)

1. Case analysis on typDef

  1. Case (% has type externTypDefn)

    1. If (typ'*{typ' <- typ'*} matches []), then

      1. Return $subtyp_extern(val)

  2. Case (% has type definedTypDefn)

    1. (Let TYP _id tparam*{tparam <- tparam*} '=' deftyp be typDef as definedTypDefn)

      1. Case analysis on deftyp (total)

        1. Case (% matches pattern ALIAS %)

          1. (Let ALIAS typ be deftyp)

            1. If ((|typ'*{typ' <- typ'*}| = |tparam*{tparam <- tparam*}|)), then

              1. (Let theta be `{ tparam ':' typ'*{typ' <- typ'*, tparam <- tparam*} `})

                1. (Let typRes be $subst_typ(theta, typ))

                  1. If (typRes <: ok<typ>), then

                    1. (Let OK typ_subst be typRes as ok<typ>)

                      1. Return $subtyp(fenv, tdenv, typ_subst, val)

        2. Case (% matches pattern VARIANT %)

          1. (Let VARIANT typCase*{typCase <- typCase*} be deftyp)

            1. If ((|typ'*{typ' <- typ'*}| = |tparam*{tparam <- tparam*}|)), then

              1. (Let theta be `{ tparam ':' typ'*{typ' <- typ'*, tparam <- tparam*} `})

                1. Return $subtyp_variant(fenv, tdenv, theta, typCase*{typCase <- typCase*}, val)

        3. Case (% matches pattern STRUCT %)

          1. (Let STRUCT typField*{typField <- typField*} be deftyp)

            1. If ((|typ'*{typ' <- typ'*}| = |tparam*{tparam <- tparam*}|)), then

              1. (Let theta be `{ tparam ':' typ'*{typ' <- typ'*, tparam <- tparam*} `})

                1. Return $subtyp_struct(fenv, tdenv, theta, typField*{typField <- typField*}, val)

2. Otherwise,

  1. Return ERROR as subtypRes

def $subtyp_extern(val)

1. If (val matches EXT %), then

  1. Return OK true as subtypRes

2. Otherwise,

  1. Return OK false as subtypRes

def $subtyp_variant(fenv, tdenv, theta, typCase*{typCase <- typCase*}, val')

1. If (val' matches INJ %), then

  1. (Let INJ mixop val*{val <- val*} be val')

    1. (Let mixop_case typ_case*{typ_case <- typ_case*} be typCase)*{typCase <- typCase*, mixop_case -> mixop_case*, typ_case* -> typ_case**}

      1. (Let typ*{typ <- typ*}?{typ* <- typ*?} be $assoc_<mixop, typ*>(mixop, (mixop_case, typ_case*{typ_case <- typ_case*})*{mixop_case <- mixop_case*, typ_case* <- typ_case**}))

        1. If (typ*{typ <- typ*}?{typ* <- typ*?} matches (_)), then

          1. (Let ?(typ_case_found*{typ_case_found <- typ_case_found*}) be typ*{typ <- typ*}?{typ* <- typ*?})

            1. Return $subtyp_case(fenv, tdenv, theta, typ_case_found*{typ_case_found <- typ_case_found*}, val*{val <- val*})

2. Otherwise,

  1. Return OK false as subtypRes

def $subtyp_struct(fenv, tdenv, theta, typField*{typField <- typField*}, val)

1. If (val matches STR %), then

  1. (Let STR valField*{valField <- valField*} be val)

    1. (Let atom typ_field be typField)*{typField <- typField*, atom -> atom*, typ_field -> typ_field*}

      1. (Let atom' val_field be valField)*{valField <- valField*, atom' -> atom'*, val_field -> val_field*}

        1. If ((|atom*{atom <- atom*}| = |atom'*{atom' <- atom'*}|)), then

          1. If ((atom' = atom))*{atom <- atom*, atom' <- atom'*}, then

            1. Return $subtyp_case(fenv, tdenv, theta, typ_field*{typ_field <- typ_field*}, val_field*{val_field <- val_field*})

2. Otherwise,

  1. Return OK false as subtypRes

def $subtyp_case(fenv, tdenv, theta, typ*{typ <- typ*}, val*{val <- val*})

1. (Let typsRes be $subst_typs(theta, typ*{typ <- typ*}))

  1. If (typsRes <: ok<typ*>), then

    1. (Let OK typ_subst*{typ_subst <- typ_subst*} be typsRes as ok<typ*>)

      1. Return $subtyps(fenv, tdenv, typ_subst*{typ_subst <- typ_subst*}, val*{val <- val*})

2. Otherwise,

  1. Return ERROR as subtypRes

def $subtyps(fenv, tdenv, typ*{typ <- typ*}, val*{val <- val*})

1. Case analysis on typ*{typ <- typ*} (total)

  1. Case (% matches pattern [])

    1. Case analysis on val*{val <- val*} (total)

      1. Case (% matches pattern [])

        1. Return OK true as subtypRes

      2. Case (% matches pattern _ :: _)

        1. Return OK false as subtypRes

  2. Case (% matches pattern _ :: _)

    1. (Let typ_h :: typ_t*{typ_t <- typ_t*} be typ*{typ <- typ*})

      1. Case analysis on val*{val <- val*} (total)

        1. Case (% matches pattern _ :: _)

          1. (Let val_h :: val_t*{val_t <- val_t*} be val*{val <- val*})

            1. If ((OK true as subtypRes = $subtyp(fenv, tdenv, typ_h, val_h))), then

              1. Return $subtyps(fenv, tdenv, typ_t*{typ_t <- typ_t*}, val_t*{val_t <- val_t*})

            1. Else Dangling

            2. (Let subtypRes be $subtyp(fenv, tdenv, typ_h, val_h))

              1. If ((subtypRes =/= OK true as subtypRes)), then

                1. Return subtypRes

              1. Else Dangling

        2. Case (% matches pattern [])

          1. Return OK false as subtypRes

def $subtyp_list(fenv, tdenv, typ, val*{val <- val*})

1. Case analysis on val*{val <- val*} (total)

  1. Case (% matches pattern [])

    1. Return OK true as subtypRes

  2. Case (% matches pattern _ :: _)

    1. (Let val_h :: val_t*{val_t <- val_t*} be val*{val <- val*})

      1. If ((OK true as subtypRes = $subtyp(fenv, tdenv, typ, val_h))), then

        1. Return $subtyp_list(fenv, tdenv, typ, val_t*{val_t <- val_t*})

      1. Else Dangling

      2. (Let subtypRes be $subtyp(fenv, tdenv, typ, val_h))

        1. If ((subtypRes =/= OK true as subtypRes)), then

          1. Return subtypRes

        1. Else Dangling

def $subtyp_func(fenv, tdenv, typ, id)

1. (Let funcDefn'?{funcDefn' <- funcDefn'?} be $find_map<id, funcDefn>(fenv, id))

  1. If (funcDefn'?{funcDefn' <- funcDefn'?} matches (_)), then

    1. (Let ?(funcDefn) be funcDefn'?{funcDefn' <- funcDefn'?})

      1. Return $equiv_func_typ(tdenv, typ, $func_typ(funcDefn)) as subtypRes

2. Otherwise,

  1. Return ERROR as subtypRes

def $param_typ(param')

1. Case analysis on param' (total)

  1. Case (% has type expParam)

    1. (Let EXP typ be param' as expParam)

      1. Return typ

  2. Case (% has type funParam)

    1. (Let FUN id ':' tparam*{tparam <- tparam*} param*{param <- param*} '->' typ be param' as funParam)

      1. Return FUNC tparam*{tparam <- tparam*} $param_typ(param)*{param <- param*} typ

def $func_typ(funcDefn)

1. Case analysis on funcDefn (total)

  1. Case (% has type externFuncDefn)

    1. (Let EXTFUNC id tparam*{tparam <- tparam*} param*{param <- param*} ':' typ be funcDefn as externFuncDefn)

      1. Return FUNC tparam*{tparam <- tparam*} $param_typ(param)*{param <- param*} typ

  2. Case (% has type builtinFuncDefn)

    1. (Let BUILTINFUNC id tparam*{tparam <- tparam*} param*{param <- param*} ':' typ be funcDefn as builtinFuncDefn)

      1. Return FUNC tparam*{tparam <- tparam*} $param_typ(param)*{param <- param*} typ

  3. Case (% has type tableFuncDefn)

    1. (Let TABLEFUNC _id param*{param <- param*} ':' typ '=' tblRow*{tblRow <- tblRow*} be funcDefn as tableFuncDefn)

      1. Return FUNC [] $param_typ(param)*{param <- param*} typ

  4. Case (% has type definedFuncDefn)

    1. (Let FUNC _id tparam*{tparam <- tparam*} param*{param <- param*} ':' typ '=' clause*{clause <- clause*} elsClause?{elsClause <- elsClause?} be funcDefn as definedFuncDefn)

      1. Return FUNC tparam*{tparam <- tparam*} $param_typ(param)*{param <- param*} typ

syntax castRes =
   | OK val (from ok<val>)
   | ERROR (from error)

syntax castsRes =
   | OK val* (from ok<val*>)
   | ERROR (from error)

def $upcast(C, typ', val'')

1. Case analysis on typ'

  1. Case (% has type numtyp)

    1. (Let numtyp be typ' as numtyp)

      1. Case analysis on numtyp (total)

        1. Case (% matches pattern INT)

          1. If (val'' <: num), then

            1. (Let num be val'' as num)

              1. Case analysis on num (total)

                1. Case (% matches pattern INT %)

                  1. (Let INT i be num)

                    1. Return OK INT i as val as castRes

                2. Case (% matches pattern NAT %)

                  1. (Let NAT n be num)

                    1. Return OK INT n as int as val as castRes

        2. Case (% matches pattern NAT)

          1. If (val'' <: num), then

            1. (Let num be val'' as num)

              1. If (num matches NAT %), then

                1. (Let NAT n be num)

                  1. Return OK NAT n as val as castRes

  2. Case (% matches pattern VAR % %)

    1. (Let VAR id targ*{targ <- targ*} be typ')

      1. (Let typDef'?{typDef' <- typDef'?} be $find_typ(C, id))

        1. If (typDef'?{typDef' <- typDef'?} matches (_)), then

          1. (Let ?(typDef) be typDef'?{typDef' <- typDef'?})

            1. If (typDef <: definedTypDefn), then

              1. (Let TYP _id tparam*{tparam <- tparam*} '=' deftyp be typDef as definedTypDefn)

                1. Case analysis on deftyp (total)

                  1. Case (% matches pattern ALIAS %)

                    1. (Let ALIAS typ be deftyp)

                      1. If ((|targ*{targ <- targ*}| = |tparam*{tparam <- tparam*}|)), then

                        1. (Let theta be `{ tparam ':' targ*{targ <- targ*, tparam <- tparam*} `})

                          1. (Let typRes be $subst_typ(theta, typ))

                            1. If (typRes <: ok<typ>), then

                              1. (Let OK typ_subst be typRes as ok<typ>)

                                1. Return $upcast(C, typ_subst, val'')

                  2. Case (% matches pattern VARIANT %)

                    1. (Let `{ id_local ':' typDef_local*{id_local <- id_local*, typDef_local <- typDef_local*} `} be C.LOCAL.TYP)

                      1. (Let tdenv be $adds_map<id, typDef>(C.GLOBAL.TYP, id_local*{id_local <- id_local*}, typDef_local*{typDef_local <- typDef_local*}))

                        1. If ((OK true as subtypRes = $subtyp(C.GLOBAL.FUNC, tdenv, VAR id targ*{targ <- targ*}, val''))), then

                          1. Return OK val'' as castRes

                  3. Case (% matches pattern STRUCT %)

                    1. (Let `{ id_local ':' typDef_local*{id_local <- id_local*, typDef_local <- typDef_local*} `} be C.LOCAL.TYP)

                      1. (Let tdenv be $adds_map<id, typDef>(C.GLOBAL.TYP, id_local*{id_local <- id_local*}, typDef_local*{typDef_local <- typDef_local*}))

                        1. If ((OK true as subtypRes = $subtyp(C.GLOBAL.FUNC, tdenv, VAR id targ*{targ <- targ*}, val''))), then

                          1. Return OK val'' as castRes

      2. If (targ*{targ <- targ*} matches []), then

        1. If (val'' matches EXT %), then

          1. (Let EXT json be val'')

            1. (Let typDef'?{typDef' <- typDef'?} be $find_typ(C, id))

              1. If (typDef'?{typDef' <- typDef'?} matches (_)), then

                1. (Let ?(typDef) be typDef'?{typDef' <- typDef'?})

                  1. If (typDef <: externTypDefn), then

                    1. Return OK EXT json as castRes

  3. Case (% matches pattern TUP %)

    1. (Let TUP typ*{typ <- typ*} be typ')

      1. If (val'' matches TUP %), then

        1. (Let TUP val*{val <- val*} be val'')

          1. (Let castsRes be $upcasts(C, typ*{typ <- typ*}, val*{val <- val*}))

            1. If (castsRes <: ok<val*>), then

              1. (Let OK val_cast*{val_cast <- val_cast*} be castsRes as ok<val*>)

                1. Return OK TUP val_cast*{val_cast <- val_cast*} as castRes

  4. Case (% matches pattern ITER % %)

    1. (Let ITER typ iter be typ')

      1. Case analysis on iter (total)

        1. Case (% matches pattern QUEST)

          1. If ((val'' = OPT ?())), then

            1. Return OK OPT ?() as castRes

          2. If (val'' matches OPT %), then

            1. (Let OPT val'?{val' <- val'?} be val'')

              1. If (val'?{val' <- val'?} matches (_)), then

                1. (Let ?(val) be val'?{val' <- val'?})

                  1. (Let castRes be $upcast(C, typ, val))

                    1. If (castRes <: ok<val>), then

                      1. (Let OK val_cast be castRes as ok<val>)

                        1. Return OK OPT ?(val_cast) as castRes

        2. Case (% matches pattern STAR)

          1. If (val'' matches LIST %), then

            1. (Let LIST val*{val <- val*} be val'')

              1. (Let castsRes be $upcasts(C, $repeat_<typ>(typ, |val*{val <- val*}|), val*{val <- val*}))

                1. If (castsRes <: ok<val*>), then

                  1. (Let OK val_cast*{val_cast <- val_cast*} be castsRes as ok<val*>)

                    1. Return OK LIST val_cast*{val_cast <- val_cast*} as castRes

  5. Case (% matches pattern FUNC % % %)

    1. (Let FUNC tparam*{tparam <- tparam*} typ*{typ <- typ*} typ_ret be typ')

      1. If (val'' matches FUNC %), then

        1. (Let FUNC id be val'')

          1. (Let `{ id_local ':' typDef_local*{id_local <- id_local*, typDef_local <- typDef_local*} `} be C.LOCAL.TYP)

            1. (Let tdenv be $adds_map<id, typDef>(C.GLOBAL.TYP, id_local*{id_local <- id_local*}, typDef_local*{typDef_local <- typDef_local*}))

              1. If ((OK true as subtypRes = $subtyp(C.GLOBAL.FUNC, tdenv, FUNC tparam*{tparam <- tparam*} typ*{typ <- typ*} typ_ret, FUNC id))), then

                1. Return OK FUNC id as castRes

2. If (typ' <: optyp), then

  1. (Let optyp be typ' as optyp)

    1. Case analysis on optyp

      1. Case (% matches pattern BOOL)

        1. If (val'' matches BOOL %), then

          1. (Let BOOL b be val'')

            1. Return OK BOOL b as castRes

      2. Case (% matches pattern TEXT)

        1. If (val'' matches TEXT %), then

          1. (Let TEXT t be val'')

            1. Return OK TEXT t as castRes

3. Otherwise,

  1. Return ERROR as castRes

def $upcasts(C, typ*{typ <- typ*}, val*{val <- val*})

1. Case analysis on typ*{typ <- typ*} (total)

  1. Case (% matches pattern [])

    1. If (val*{val <- val*} matches []), then

      1. Return OK [] as castsRes

  2. Case (% matches pattern _ :: _)

    1. (Let typ_h :: typ_t*{typ_t <- typ_t*} be typ*{typ <- typ*})

      1. If (val*{val <- val*} matches _ :: _), then

        1. (Let val_h :: val_t*{val_t <- val_t*} be val*{val <- val*})

          1. (Let castRes be $upcast(C, typ_h, val_h))

            1. If (castRes <: ok<val>), then

              1. (Let OK val_cast be castRes as ok<val>)

                1. (Let castsRes be $upcasts(C, typ_t*{typ_t <- typ_t*}, val_t*{val_t <- val_t*}))

                  1. If (castsRes <: ok<val*>), then

                    1. (Let OK val_t_cast*{val_t_cast <- val_t_cast*} be castsRes as ok<val*>)

                      1. Return OK val_cast :: val_t_cast*{val_t_cast <- val_t_cast*} as castsRes

2. Otherwise,

  1. Return ERROR as castsRes

def $downcast(C, typ', val'')

1. Case analysis on typ'

  1. Case (% has type numtyp)

    1. (Let numtyp be typ' as numtyp)

      1. Case analysis on numtyp (total)

        1. Case (% matches pattern NAT)

          1. If (val'' <: num), then

            1. (Let num be val'' as num)

              1. Case analysis on num (total)

                1. Case (% matches pattern NAT %)

                  1. (Let NAT n be num)

                    1. Return OK NAT n as val as castRes

                2. Case (% matches pattern INT %)

                  1. (Let INT i be num)

                    1. If (i <: nat), then

                      1. (Let n be i as nat)

                        1. Return OK NAT n as val as castRes

        2. Case (% matches pattern INT)

          1. If (val'' <: num), then

            1. (Let num be val'' as num)

              1. Return OK num as val as castRes

  2. Case (% matches pattern VAR % %)

    1. (Let VAR id targ*{targ <- targ*} be typ')

      1. (Let typDef'?{typDef' <- typDef'?} be $find_typ(C, id))

        1. If (typDef'?{typDef' <- typDef'?} matches (_)), then

          1. (Let ?(typDef) be typDef'?{typDef' <- typDef'?})

            1. If (typDef <: definedTypDefn), then

              1. (Let TYP _id tparam*{tparam <- tparam*} '=' deftyp be typDef as definedTypDefn)

                1. Case analysis on deftyp (total)

                  1. Case (% matches pattern ALIAS %)

                    1. (Let ALIAS typ be deftyp)

                      1. If ((|targ*{targ <- targ*}| = |tparam*{tparam <- tparam*}|)), then

                        1. (Let theta be `{ tparam ':' targ*{targ <- targ*, tparam <- tparam*} `})

                          1. (Let typRes be $subst_typ(theta, typ))

                            1. If (typRes <: ok<typ>), then

                              1. (Let OK typ_subst be typRes as ok<typ>)

                                1. Return $downcast(C, typ_subst, val'')

                  2. Case (% matches pattern VARIANT %)

                    1. (Let `{ id_local ':' typDef_local*{id_local <- id_local*, typDef_local <- typDef_local*} `} be C.LOCAL.TYP)

                      1. (Let tdenv be $adds_map<id, typDef>(C.GLOBAL.TYP, id_local*{id_local <- id_local*}, typDef_local*{typDef_local <- typDef_local*}))

                        1. If ((OK true as subtypRes = $subtyp(C.GLOBAL.FUNC, tdenv, VAR id targ*{targ <- targ*}, val''))), then

                          1. Return OK val'' as castRes

                  3. Case (% matches pattern STRUCT %)

                    1. (Let `{ id_local ':' typDef_local*{id_local <- id_local*, typDef_local <- typDef_local*} `} be C.LOCAL.TYP)

                      1. (Let tdenv be $adds_map<id, typDef>(C.GLOBAL.TYP, id_local*{id_local <- id_local*}, typDef_local*{typDef_local <- typDef_local*}))

                        1. If ((OK true as subtypRes = $subtyp(C.GLOBAL.FUNC, tdenv, VAR id targ*{targ <- targ*}, val''))), then

                          1. Return OK val'' as castRes

      2. If (targ*{targ <- targ*} matches []), then

        1. If (val'' matches EXT %), then

          1. (Let EXT json be val'')

            1. (Let typDef'?{typDef' <- typDef'?} be $find_typ(C, id))

              1. If (typDef'?{typDef' <- typDef'?} matches (_)), then

                1. (Let ?(typDef) be typDef'?{typDef' <- typDef'?})

                  1. If (typDef <: externTypDefn), then

                    1. Return OK EXT json as castRes

  3. Case (% matches pattern TUP %)

    1. (Let TUP typ*{typ <- typ*} be typ')

      1. If (val'' matches TUP %), then

        1. (Let TUP val*{val <- val*} be val'')

          1. (Let castsRes be $downcasts(C, typ*{typ <- typ*}, val*{val <- val*}))

            1. If (castsRes <: ok<val*>), then

              1. (Let OK val_cast*{val_cast <- val_cast*} be castsRes as ok<val*>)

                1. Return OK TUP val_cast*{val_cast <- val_cast*} as castRes

  4. Case (% matches pattern ITER % %)

    1. (Let ITER typ iter be typ')

      1. Case analysis on iter (total)

        1. Case (% matches pattern QUEST)

          1. If ((val'' = OPT ?())), then

            1. Return OK OPT ?() as castRes

          2. If (val'' matches OPT %), then

            1. (Let OPT val'?{val' <- val'?} be val'')

              1. If (val'?{val' <- val'?} matches (_)), then

                1. (Let ?(val) be val'?{val' <- val'?})

                  1. (Let castRes be $downcast(C, typ, val))

                    1. If (castRes <: ok<val>), then

                      1. (Let OK val_cast be castRes as ok<val>)

                        1. Return OK OPT ?(val_cast) as castRes

        2. Case (% matches pattern STAR)

          1. If (val'' matches LIST %), then

            1. (Let LIST val*{val <- val*} be val'')

              1. (Let castsRes be $downcasts(C, $repeat_<typ>(typ, |val*{val <- val*}|), val*{val <- val*}))

                1. If (castsRes <: ok<val*>), then

                  1. (Let OK val_cast*{val_cast <- val_cast*} be castsRes as ok<val*>)

                    1. Return OK LIST val_cast*{val_cast <- val_cast*} as castRes

  5. Case (% matches pattern FUNC % % %)

    1. (Let FUNC tparam*{tparam <- tparam*} typ*{typ <- typ*} typ_ret be typ')

      1. If (val'' matches FUNC %), then

        1. (Let FUNC id be val'')

          1. (Let `{ id_local ':' typDef_local*{id_local <- id_local*, typDef_local <- typDef_local*} `} be C.LOCAL.TYP)

            1. (Let tdenv be $adds_map<id, typDef>(C.GLOBAL.TYP, id_local*{id_local <- id_local*}, typDef_local*{typDef_local <- typDef_local*}))

              1. If ((OK true as subtypRes = $subtyp(C.GLOBAL.FUNC, tdenv, FUNC tparam*{tparam <- tparam*} typ*{typ <- typ*} typ_ret, FUNC id))), then

                1. Return OK FUNC id as castRes

2. If (typ' <: optyp), then

  1. (Let optyp be typ' as optyp)

    1. Case analysis on optyp

      1. Case (% matches pattern BOOL)

        1. If (val'' matches BOOL %), then

          1. (Let BOOL b be val'')

            1. Return OK BOOL b as castRes

      2. Case (% matches pattern TEXT)

        1. If (val'' matches TEXT %), then

          1. (Let TEXT t be val'')

            1. Return OK TEXT t as castRes

3. Otherwise,

  1. Return ERROR as castRes

def $downcasts(C, typ*{typ <- typ*}, val*{val <- val*})

1. Case analysis on typ*{typ <- typ*} (total)

  1. Case (% matches pattern [])

    1. If (val*{val <- val*} matches []), then

      1. Return OK [] as castsRes

  2. Case (% matches pattern _ :: _)

    1. (Let typ_h :: typ_t*{typ_t <- typ_t*} be typ*{typ <- typ*})

      1. If (val*{val <- val*} matches _ :: _), then

        1. (Let val_h :: val_t*{val_t <- val_t*} be val*{val <- val*})

          1. (Let castRes be $downcast(C, typ_h, val_h))

            1. If (castRes <: ok<val>), then

              1. (Let OK val_cast be castRes as ok<val>)

                1. (Let castsRes be $downcasts(C, typ_t*{typ_t <- typ_t*}, val_t*{val_t <- val_t*}))

                  1. If (castsRes <: ok<val*>), then

                    1. (Let OK val_t_cast*{val_t_cast <- val_t_cast*} be castsRes as ok<val*>)

                      1. Return OK val_cast :: val_t_cast*{val_t_cast <- val_t_cast*} as castsRes

2. Otherwise,

  1. Return ERROR as castsRes

syntax assignRes =
   | OK ctx (from ok<ctx>)
   | ERROR (from error)

relation Assign_exp: C |- typedExp'' := val''' : %

1. (Let exp '#' typ be typedExp'')

  1. Case analysis on exp

    1. Case (% has type varExp)

      1. (Let VAR id be exp as varExp)

        1. (Let C_assign be $add_varr(C, id [], val'''))

          1. Result in: % |- % := % : OK C_assign as assignRes

    2. Case (% has type tupExp)

      1. (Let TUP typedExp*{typedExp <- typedExp*} be exp as tupExp)

        1. If (val''' matches TUP %), then

          1. (Let TUP val*{val <- val*} be val''')

            1. (Assign_exps: C |- typedExp*{typedExp <- typedExp*} := val*{val <- val*} : assignRes)

              1. If (assignRes <: ok<ctx>), then

                1. (Let OK C_assign be assignRes as ok<ctx>)

                  1. Result in: % |- % := % : OK C_assign as assignRes

    3. Case (% has type injExp)

      1. (Let INJ mixop typedExp*{typedExp <- typedExp*} be exp as injExp)

        1. If (val''' matches INJ %), then

          1. (Let INJ mixop' val*{val <- val*} be val''')

            1. If ((mixop = mixop')), then

              1. (Assign_exps: C |- typedExp*{typedExp <- typedExp*} := val*{val <- val*} : assignRes)

                1. If (assignRes <: ok<ctx>), then

                  1. (Let OK C_assign be assignRes as ok<ctx>)

                    1. Result in: % |- % := % : OK C_assign as assignRes

    4. Case (% has type strExp)

      1. (Let STR expField*{expField <- expField*} be exp as strExp)

        1. If (val''' matches STR %), then

          1. (Let STR valField*{valField <- valField*} be val''')

            1. (Let atom val be valField)*{valField <- valField*, atom -> atom*, val -> val*}

              1. (Let atom' typedExp be expField)*{expField <- expField*, atom' -> atom'*, typedExp -> typedExp*}

                1. If ((|atom*{atom <- atom*}| = |atom'*{atom' <- atom'*}|)), then

                  1. If ((atom' = atom))*{atom <- atom*, atom' <- atom'*}, then

                    1. (Assign_exps: C |- typedExp*{typedExp <- typedExp*} := val*{val <- val*} : assignRes)

                      1. If (assignRes <: ok<ctx>), then

                        1. (Let OK C_assign be assignRes as ok<ctx>)

                          1. Result in: % |- % := % : OK C_assign as assignRes

    5. Case (% has type optExp)

      1. (Let OPT typedExp'?{typedExp' <- typedExp'?} be exp as optExp)

        1. If (val''' matches OPT %), then

          1. (Let OPT val'?{val' <- val'?} be val''')

            1. Case analysis on typedExp'?{typedExp' <- typedExp'?} (total)

              1. Case (% matches pattern (_))

                1. (Let ?(typedExp) be typedExp'?{typedExp' <- typedExp'?})

                  1. If (val'?{val' <- val'?} matches (_)), then

                    1. (Let ?(val) be val'?{val' <- val'?})

                      1. (Assign_exp: C |- typedExp := val : assignRes)

                        1. If (assignRes <: ok<ctx>), then

                          1. (Let OK C_assign be assignRes as ok<ctx>)

                            1. Result in: % |- % := % : OK C_assign as assignRes

              2. Case (% matches pattern ())

                1. If (val'?{val' <- val'?} matches ()), then

                  1. Result in: % |- % := % : OK C as assignRes

    6. Case (% has type listExp)

      1. (Let LIST typedExp*{typedExp <- typedExp*} be exp as listExp)

        1. If (val''' matches LIST %), then

          1. (Let LIST val*{val <- val*} be val''')

            1. (Assign_exps: C |- typedExp*{typedExp <- typedExp*} := val*{val <- val*} : assignRes)

              1. If (assignRes <: ok<ctx>), then

                1. (Let OK C_assign be assignRes as ok<ctx>)

                  1. Result in: % |- % := % : OK C_assign as assignRes

    7. Case (% has type consExp)

      1. (Let CONS typedExp_h typedExp_t be exp as consExp)

        1. If (val''' matches LIST %), then

          1. (Let LIST val*{val <- val*} be val''')

            1. If (val*{val <- val*} matches _ :: _), then

              1. (Let val_h :: val_t*{val_t <- val_t*} be val*{val <- val*})

                1. (Assign_exp: C |- typedExp_h := val_h : assignRes)

                  1. If (assignRes <: ok<ctx>), then

                    1. (Let OK C_h be assignRes as ok<ctx>)

                      1. (Assign_exp: C_h |- typedExp_t := LIST val_t*{val_t <- val_t*} : assignRes')

                        1. If (assignRes' <: ok<ctx>), then

                          1. (Let OK C_t be assignRes' as ok<ctx>)

                            1. Result in: % |- % := % : OK C_t as assignRes

    8. Case (% has type iterExp)

      1. (Let iterExp be exp as iterExp)

        1. (Let varr'?{varr' <- varr'?} be $is_iter_on_var(iterExp as exp '#' typ))

          1. If (varr'?{varr' <- varr'?} matches (_)), then

            1. (Let ?(varr) be varr'?{varr' <- varr'?})

              1. (Let C_assign be $add_varr(C, varr, val'''))

                1. Result in: % |- % := % : OK C_assign as assignRes

        2. If ((val''' = OPT ?())), then

          1. If ($is_iter_on_var(iterExp as exp '#' typ) matches ()), then

            1. (Let ITER typedExp iter vari*{vari <- vari*} be iterExp)

              1. If (iter matches QUEST), then

                1. (Let vari_iter be $iterate_vari(vari, [QUEST]))*{vari <- vari*, vari_iter -> vari_iter*}

                  1. (Let val_bind*{val_bind <- val_bind*} be $repeat_<val>(OPT ?(), |vari_iter*{vari_iter <- vari_iter*}|))

                    1. (Let C_assign be $add_varis(C, vari_iter*{vari_iter <- vari_iter*}, val_bind*{val_bind <- val_bind*}))

                      1. Result in: % |- % := % : OK C_assign as assignRes

        3. Case analysis on val'''

          1. Case (% matches pattern OPT %)

            1. (Let OPT val'?{val' <- val'?} be val''')

              1. If (val'?{val' <- val'?} matches (_)), then

                1. (Let ?(val) be val'?{val' <- val'?})

                  1. If ($is_iter_on_var(iterExp as exp '#' typ) matches ()), then

                    1. (Let ITER typedExp iter vari*{vari <- vari*} be iterExp)

                      1. If (iter matches QUEST), then

                        1. (Assign_exp: C |- typedExp := val : assignRes)

                          1. If (assignRes <: ok<ctx>), then

                            1. (Let OK C_body be assignRes as ok<ctx>)

                              1. (Let vari_iter be $iterate_vari(vari, [QUEST]))*{vari <- vari*, vari_iter -> vari_iter*}

                                1. (Let val''?{val'' <- val''?} be $find_vari(C_body, vari))*{vari <- vari*, val''? -> val''?*}

                                  1. If (val''?{val'' <- val''?} matches (_))*{val''? <- val''?*}, then

                                    1. (Let ?(val_sub) be val''?{val'' <- val''?})*{val''? <- val''?*, val_sub -> val_sub*}

                                      1. (Let C_assign be $add_varis(C_body, vari_iter*{vari_iter <- vari_iter*}, OPT ?(val_sub)*{val_sub <- val_sub*}))

                                        1. Result in: % |- % := % : OK C_assign as assignRes

          2. Case (% matches pattern LIST %)

            1. (Let LIST val*{val <- val*} be val''')

              1. If ($is_iter_on_var(iterExp as exp '#' typ) matches ()), then

                1. (Let ITER typedExp iter vari*{vari <- vari*} be iterExp)

                  1. If (iter matches STAR), then

                    1. (Let C_local be C[LOCAL.VAL = $empty_map<varr, val>])

                      1. (Assign_exp: C_local |- typedExp := val : assignRes)*{val <- val*, assignRes -> assignRes*}

                        1. If (assignRes <: ok<ctx>)*{assignRes <- assignRes*}, then

                          1. (Let OK C_sub be assignRes as ok<ctx>)*{assignRes <- assignRes*, C_sub -> C_sub*}

                            1. (Let vari_iter be $iterate_vari(vari, [STAR]))*{vari <- vari*, vari_iter -> vari_iter*}

                              1. (Let val'*{val' <- val'*}?{val'* <- val'*?} be $finds_vari(C_sub*{C_sub <- C_sub*}, vari))*{vari <- vari*, val'*? -> val'*?*}

                                1. If (val'*{val' <- val'*}?{val'* <- val'*?} matches (_))*{val'*? <- val'*?*}, then

                                  1. (Let ?(val_sub*{val_sub <- val_sub*}) be val'*{val' <- val'*}?{val'* <- val'*?})*{val'*? <- val'*?*, val_sub* -> val_sub**}

                                    1. (Let val_bind be LIST val_sub*{val_sub <- val_sub*})*{val_sub* <- val_sub**, val_bind -> val_bind*}

                                      1. (Let C_assign be $add_varis(C, vari_iter*{vari_iter <- vari_iter*}, val_bind*{val_bind <- val_bind*}))

                                        1. Result in: % |- % := % : OK C_assign as assignRes

2. Otherwise,

  1. Result in: % |- % := % : ERROR as assignRes

relation Assign_exps: C |- typedExp*{typedExp <- typedExp*} := val*{val <- val*} : %

1. Case analysis on typedExp*{typedExp <- typedExp*} (total)

  1. Case (% matches pattern [])

    1. If (val*{val <- val*} matches []), then

      1. Result in: % |- % := % : OK C as assignRes

  2. Case (% matches pattern _ :: _)

    1. (Let typedExp_h :: typedExp_t*{typedExp_t <- typedExp_t*} be typedExp*{typedExp <- typedExp*})

      1. If (val*{val <- val*} matches _ :: _), then

        1. (Let val_h :: val_t*{val_t <- val_t*} be val*{val <- val*})

          1. (Assign_exp: C |- typedExp_h := val_h : assignRes)

            1. If (assignRes <: ok<ctx>), then

              1. (Let OK C_h be assignRes as ok<ctx>)

                1. (Assign_exps: C_h |- typedExp_t*{typedExp_t <- typedExp_t*} := val_t*{val_t <- val_t*} : assignRes')

                  1. If (assignRes' <: ok<ctx>), then

                    1. (Let OK C_t be assignRes' as ok<ctx>)

                      1. Result in: % |- % := % : OK C_t as assignRes

2. Otherwise,

  1. Result in: % |- % := % : ERROR as assignRes

relation Assign_arg: C |- arg := val : %

1. Case analysis on arg (total)

  1. Case (% has type expArg)

    1. (Let EXP typedExp be arg as expArg)

      1. (Assign_exp: C |- typedExp := val : assignRes)

        1. If (assignRes <: ok<ctx>), then

          1. (Let OK C_assign be assignRes as ok<ctx>)

            1. Result in: % |- % := % : OK C_assign as assignRes

  2. Case (% has type funArg)

    1. (Let FUN id be arg as funArg)

      1. If (val matches FUNC %), then

        1. (Let FUNC id_global be val)

          1. (Let C_assign be $add_func(C, id, id_global))

            1. Result in: % |- % := % : OK C_assign as assignRes

2. Otherwise,

  1. Result in: % |- % := % : ERROR as assignRes

relation Assign_args: C |- arg*{arg <- arg*} := val*{val <- val*} : %

1. Case analysis on arg*{arg <- arg*} (total)

  1. Case (% matches pattern [])

    1. If (val*{val <- val*} matches []), then

      1. Result in: % |- % := % : OK C as assignRes

  2. Case (% matches pattern _ :: _)

    1. (Let arg_h :: arg_t*{arg_t <- arg_t*} be arg*{arg <- arg*})

      1. If (val*{val <- val*} matches _ :: _), then

        1. (Let val_h :: val_t*{val_t <- val_t*} be val*{val <- val*})

          1. (Assign_arg: C |- arg_h := val_h : assignRes)

            1. If (assignRes <: ok<ctx>), then

              1. (Let OK C_h be assignRes as ok<ctx>)

                1. (Assign_args: C_h |- arg_t*{arg_t <- arg_t*} := val_t*{val_t <- val_t*} : assignRes')

                  1. If (assignRes' <: ok<ctx>), then

                    1. (Let OK C_t be assignRes' as ok<ctx>)

                      1. Result in: % |- % := % : OK C_t as assignRes

2. Otherwise,

  1. Result in: % |- % := % : ERROR as assignRes

syntax clauseRes =
   | OK val (from ok<val>)
   | ERROR (from error)
   | UNMATCH (from unmatch)

relation Eval_clause: C |- clause `( val*{val <- val*} `) : %

1. (Let arg*{arg <- arg*} '=' typedExp_out '-' prem*{prem <- prem*} be clause)

  1. (Assign_args: C |- arg*{arg <- arg*} := val*{val <- val*} : assignRes)

    1. If (assignRes <: ok<ctx>), then

      1. (Let OK C_assign be assignRes as ok<ctx>)

        1. (Eval_prems: C_assign |- prem*{prem <- prem*} : premRes)

          1. Case analysis on premRes (total)

            1. Case (% has type failure)

              1. (Let failure be premRes as failure)

                1. Result in: % |- % `( % `) : failure as clauseRes

            2. Case (% has type ok<ctx>)

              1. (Let OK C_prem be premRes as ok<ctx>)

                1. (Eval_exp: C_prem |- typedExp_out : expRes)

                  1. If (expRes <: clauseRes), then

                    1. (Let clauseRes be expRes as clauseRes)

                      1. Result in: % |- % `( % `) : clauseRes

2. Otherwise,

  1. Result in: % |- % `( % `) : ERROR as clauseRes

relation Eval_clauses: C |- clause*{clause <- clause*} `( val*{val <- val*} `) : %

1. Case analysis on clause*{clause <- clause*} (total)

  1. Case (% matches pattern [])

    1. Result in: % |- % `( % `) : UNMATCH as clauseRes

  2. Case (% matches pattern _ :: _)

    1. (Let clause_h :: clause_t*{clause_t <- clause_t*} be clause*{clause <- clause*})

      1. (Eval_clause: C |- clause_h `( val*{val <- val*} `) : clauseRes')

        1. Case analysis on clauseRes'

          1. Case (% has type unmatch)

            1. (Let unmatch be clauseRes' as unmatch)

              1. (Eval_clauses: C |- clause_t*{clause_t <- clause_t*} `( val*{val <- val*} `) : clauseRes)

                1. Result in: % |- % `( % `) : clauseRes

          2. Case (% has type ok<val>)

            1. (Let OK val_out be clauseRes' as ok<val>)

              1. (Eval_clauses_on_ok: C |- clause_t*{clause_t <- clause_t*} `( val*{val <- val*} `) : unitRes)

                1. If (unitRes matches OK), then

                  1. Result in: % |- % `( % `) : OK val_out as clauseRes

2. Otherwise,

  1. Result in: % |- % `( % `) : ERROR as clauseRes

relation Eval_clauses_on_ok: C |- clause*{clause <- clause*} `( val*{val <- val*} `) : %

1. Case analysis on clause*{clause <- clause*} (total)

  1. Case (% matches pattern [])

    1. Result in: % |- % `( % `) : OK

  2. Case (% matches pattern _ :: _)

    1. (Let clause_h :: clause_t*{clause_t <- clause_t*} be clause*{clause <- clause*})

      1. (Eval_clause: C |- clause_h `( val*{val <- val*} `) : clauseRes)

        1. If (clauseRes <: unmatch), then

          1. (Let unmatch be clauseRes as unmatch)

            1. (Eval_clauses_on_ok: C |- clause_t*{clause_t <- clause_t*} `( val*{val <- val*} `) : unitRes)

              1. Result in: % |- % `( % `) : unitRes

        1. Else Dangling

        2. If ((clauseRes =/= UNMATCH as clauseRes)), then

          1. Result in: % |- % `( % `) : ERROR as unitRes

        2. Else Dangling

syntax tblRowRes =
   | OK val (from ok<val>)
   | ERROR (from error)
   | UNMATCH (from unmatch)

relation Eval_tblrow: C |- tblRow `( val*{val <- val*} `) : %

1. (Let arg*{arg <- arg*} '=' typedExp_out '-' prem*{prem <- prem*} be tblRow)

  1. (Let C_callee be C[LOCAL = $empty_localLayer])

    1. (Assign_args: C_callee |- arg*{arg <- arg*} := val*{val <- val*} : assignRes)

      1. If (assignRes <: ok<ctx>), then

        1. (Let OK C_callee_assign be assignRes as ok<ctx>)

          1. (Eval_prems: C_callee_assign |- prem*{prem <- prem*} : premRes)

            1. Case analysis on premRes (total)

              1. Case (% has type failure)

                1. (Let failure be premRes as failure)

                  1. Result in: % |- % `( % `) : failure as tblRowRes

              2. Case (% has type ok<ctx>)

                1. (Let OK C_callee_prem be premRes as ok<ctx>)

                  1. (Eval_exp: C_callee_prem |- typedExp_out : expRes)

                    1. If (expRes <: tblRowRes), then

                      1. (Let tblRowRes be expRes as tblRowRes)

                        1. Result in: % |- % `( % `) : tblRowRes

2. Otherwise,

  1. Result in: % |- % `( % `) : ERROR as tblRowRes

relation Eval_tblrows: C |- tblRow*{tblRow <- tblRow*} `( val*{val <- val*} `) : %

1. Case analysis on tblRow*{tblRow <- tblRow*} (total)

  1. Case (% matches pattern [])

    1. Result in: % |- % `( % `) : UNMATCH as tblRowRes

  2. Case (% matches pattern _ :: _)

    1. (Let tblRow_h :: tblRow_t*{tblRow_t <- tblRow_t*} be tblRow*{tblRow <- tblRow*})

      1. (Eval_tblrow: C |- tblRow_h `( val*{val <- val*} `) : tblRowRes')

        1. If (tblRowRes' <: unmatch), then

          1. (Let unmatch be tblRowRes' as unmatch)

            1. (Eval_tblrows: C |- tblRow_t*{tblRow_t <- tblRow_t*} `( val*{val <- val*} `) : tblRowRes)

              1. Result in: % |- % `( % `) : tblRowRes

        1. Else Dangling

        2. If ((tblRowRes' =/= UNMATCH as tblRowRes)), then

          1. Result in: % |- % `( % `) : tblRowRes'

        2. Else Dangling

relation Call_table_func: C |- tableFuncDefn `( val*{val <- val*} `) : %

1. (Let TABLEFUNC _id _param*{_param <- _param*} ':' _typ '=' tblRow*{tblRow <- tblRow*} be tableFuncDefn)

  1. (Eval_tblrows: C |- tblRow*{tblRow <- tblRow*} `( val*{val <- val*} `) : tblRowRes)

    1. If (tblRowRes <: callFuncRes), then

      1. (Let callFuncRes be tblRowRes as callFuncRes)

        1. Result in: % |- % `( % `) : callFuncRes

    1. Else Dangling

relation Call_defined_func: C |- definedFuncDefn `< typ*{typ <- typ*} `> `( val*{val <- val*} `) : %

1. (Let FUNC _id tparam*{tparam <- tparam*} _param*{_param <- _param*} ':' _typ '=' clause*{clause <- clause*} elsClause?{elsClause <- elsClause?} be definedFuncDefn)

  1. If ((|tparam*{tparam <- tparam*}| = |typ*{typ <- typ*}|)), then

    1. (Let tdenv be `{ tparam ':' TYP tparam [] '=' ALIAS typ as typDef*{tparam <- tparam*, typ <- typ*} `})

      1. (Let C_callee be C[LOCAL = $empty_localLayer[TYP = tdenv]])

        1. (Eval_clauses: C_callee |- clause*{clause <- clause*} `( val*{val <- val*} `) : clauseRes)

          1. Case analysis on clauseRes (total)

            1. Case (% has type unmatch)

              1. (Let unmatch be clauseRes as unmatch)

                1. (Eval_clause: C_callee |- elsClause `( val*{val <- val*} `) : clauseRes_els)?{elsClause <- elsClause?, clauseRes_els -> clauseRes_els?}

                  1. If ((UNMATCH as clauseRes = $deopt_<clauseRes>(clauseRes_els?{clauseRes_els <- clauseRes_els?}, UNMATCH as clauseRes))), then

                    1. Result in: % |- % `< % `> `( % `) : ERROR as callFuncRes

                  2. (Let clauseRes' be $deopt_<clauseRes>(clauseRes_els?{clauseRes_els <- clauseRes_els?}, UNMATCH as clauseRes))

                    1. If (clauseRes' <: callFuncRes), then

                      1. (Let callFuncRes be clauseRes' as callFuncRes)

                        1. Result in: % |- % `< % `> `( % `) : callFuncRes

            2. Case (% has type callFuncRes)

              1. (Let callFuncRes be clauseRes as callFuncRes)

                1. Result in: % |- % `< % `> `( % `) : callFuncRes

2. Otherwise,

  1. Result in: % |- % `< % `> `( % `) : ERROR as callFuncRes

relation Eval_rul: C |- rul `( val*{val <- val*} `) : %

1. (Let _id ':' typedExp*{typedExp <- typedExp*} '->' typedExp'*{typedExp' <- typedExp'*} '-' prem*{prem <- prem*} be rul)

  1. (Assign_exps: C |- typedExp*{typedExp <- typedExp*} := val*{val <- val*} : assignRes)

    1. If (assignRes <: ok<ctx>), then

      1. (Let OK C_assign be assignRes as ok<ctx>)

        1. (Eval_prems: C_assign |- prem*{prem <- prem*} : premRes)

          1. Case analysis on premRes (total)

            1. Case (% has type failure)

              1. (Let failure be premRes as failure)

                1. Result in: % |- % `( % `) : failure as relRes

            2. Case (% has type ok<ctx>)

              1. (Let OK C_prem be premRes as ok<ctx>)

                1. (Eval_exps: C_prem |- typedExp'*{typedExp' <- typedExp'*} : expsRes)

                  1. If (expsRes <: relRes), then

                    1. (Let relRes be expsRes as relRes)

                      1. Result in: % |- % `( % `) : relRes

2. Otherwise,

  1. Result in: % |- % `( % `) : ERROR as relRes

relation Eval_ruls: C |- rul*{rul <- rul*} `( val*{val <- val*} `) : %

1. Case analysis on rul*{rul <- rul*} (total)

  1. Case (% matches pattern [])

    1. Result in: % |- % `( % `) : UNMATCH as relRes

  2. Case (% matches pattern _ :: _)

    1. (Let rul_h :: rul_t*{rul_t <- rul_t*} be rul*{rul <- rul*})

      1. (Eval_rul: C |- rul_h `( val*{val <- val*} `) : relRes')

        1. Case analysis on relRes'

          1. Case (% has type unmatch)

            1. (Let unmatch be relRes' as unmatch)

              1. (Eval_ruls: C |- rul_t*{rul_t <- rul_t*} `( val*{val <- val*} `) : relRes)

                1. Result in: % |- % `( % `) : relRes

          2. Case (% has type ok<val*>)

            1. (Let OK val_out*{val_out <- val_out*} be relRes' as ok<val*>)

              1. (Eval_ruls_on_ok: C |- rul_t*{rul_t <- rul_t*} `( val*{val <- val*} `) : unitRes)

                1. If (unitRes matches OK), then

                  1. Result in: % |- % `( % `) : OK val_out*{val_out <- val_out*} as relRes

2. Otherwise,

  1. Result in: % |- % `( % `) : ERROR as relRes

relation Eval_ruls_on_ok: C |- rul*{rul <- rul*} `( val*{val <- val*} `) : %

1. Case analysis on rul*{rul <- rul*} (total)

  1. Case (% matches pattern [])

    1. Result in: % |- % `( % `) : OK

  2. Case (% matches pattern _ :: _)

    1. (Let rul_h :: rul_t*{rul_t <- rul_t*} be rul*{rul <- rul*})

      1. (Eval_rul: C |- rul_h `( val*{val <- val*} `) : relRes)

        1. If (relRes <: unmatch), then

          1. (Let unmatch be relRes as unmatch)

            1. (Eval_ruls_on_ok: C |- rul_t*{rul_t <- rul_t*} `( val*{val <- val*} `) : unitRes)

              1. Result in: % |- % `( % `) : unitRes

        1. Else Dangling

        2. If ((relRes =/= UNMATCH as relRes)), then

          1. Result in: % |- % `( % `) : ERROR as unitRes

        2. Else Dangling

relation Call_defined_rel: C |- definedRelDefn `( val*{val <- val*} `) : %

1. (Let REL _id ':' _typ*{_typ <- _typ*} '->' _typ'*{_typ' <- _typ'*} '=' rulGroup*{rulGroup <- rulGroup*} elsGroup?{elsGroup <- elsGroup?} be definedRelDefn)

  1. (Let C_local be C[LOCAL = $empty_localLayer])

    1. (Let rul*{rul <- rul*} be $ruls_of_rulgroups(rulGroup*{rulGroup <- rulGroup*}))

      1. (Eval_ruls: C_local |- rul*{rul <- rul*} `( val*{val <- val*} `) : relRes')

        1. If (relRes' <: unmatch), then

          1. (Let unmatch be relRes' as unmatch)

            1. (Let rul_els be $rul_of_elsgroup(elsGroup))?{elsGroup <- elsGroup?, rul_els -> rul_els?}

              1. (Eval_rul: C_local |- rul_els `( val*{val <- val*} `) : relRes_els)?{rul_els <- rul_els?, relRes_els -> relRes_els?}

                1. (Let relRes be $deopt_<relRes>(relRes_els?{relRes_els <- relRes_els?}, UNMATCH as relRes))

                  1. Result in: % |- % `( % `) : relRes

        2. If ((relRes' =/= UNMATCH as relRes)), then

          1. Result in: % |- % `( % `) : relRes'

2. Otherwise,

  1. Result in: % |- % `( % `) : ERROR as relRes

def $ruls_of_rulgroup(id ':' rul*{rul <- rul*})

1. Return rul*{rul <- rul*}

def $ruls_of_rulgroups(rulGroup*{rulGroup <- rulGroup*})

1. Case analysis on rulGroup*{rulGroup <- rulGroup*} (total)

  1. Case (% matches pattern [])

    1. Return []

  2. Case (% matches pattern _ :: _)

    1. (Let rulGroup_h :: rulGroup_t*{rulGroup_t <- rulGroup_t*} be rulGroup*{rulGroup <- rulGroup*})

      1. Return $ruls_of_rulgroup(rulGroup_h) ++ $ruls_of_rulgroups(rulGroup_t*{rulGroup_t <- rulGroup_t*})

def $rul_of_elsgroup(id ':' rul)

1. Return rul

relation Eval_rel: spec |- id `( val*{val <- val*} `) : %

1. (Let C be $load_ctx($empty_ctx, spec))

  1. (Call_rel: C |- id `( val*{val <- val*} `) : relRes)

    1. If (relRes <: ok<val*>), then

      1. (Let OK val'*{val' <- val'*} be relRes as ok<val*>)

        1. Result in: % |- % `( % `) : val'*{val' <- val'*}

    1. Else Dangling

relation Eval_func: spec |- id `( val*{val <- val*} `) : %

1. (Let C be $load_ctx($empty_ctx, spec))

  1. (Call_func: C |- id `< [] `> `( val*{val <- val*} `) : callFuncRes)

    1. If (callFuncRes <: ok<val>), then

      1. (Let OK val' be callFuncRes as ok<val>)

        1. Result in: % |- % `( % `) : val'

    1. Else Dangling
