                1. Result in: % % |- % : AC [premAL_if]

          1. Else Dangling

        2. (Let exp '#' _typ be typedExp)

          1. If (exp <: cmpOpExp), then

            1. (Let CMP cmpOp typedExp_l typedExp_r be exp as cmpOpExp)

              1. If (cmpOp <: polyCmpOp), then

                1. (Let polyCmpOp be cmpOp as polyCmpOp)

                  1. If (polyCmpOp matches EQ), then

                    1. (Collectbind_exp: AC |- typedExp_l : vari_l*{vari_l <- vari_l*})

                      1. Case analysis on vari_l*{vari_l <- vari_l*} (total)

                        1. Case (% matches pattern _ :: _)

                          1. (Collectbind_exp: AC |- typedExp_r : vari*{vari <- vari*})

                            1. If (vari*{vari <- vari*} matches []), then

                              1. (Algo_let: AC IC |- typedExp_l '=' typedExp_r : AC_bound premAL*{premAL <- premAL*})

                                1. Result in: % % |- % : AC_bound premAL*{premAL <- premAL*}

                            1. Else Dangling

                        2. Case (% matches pattern [])

                          1. (Collectbind_exp: AC |- typedExp_r : vari_r*{vari_r <- vari_r*})

                            1. If (vari_r*{vari_r <- vari_r*} matches _ :: _), then

                              1. (Algo_let: AC IC |- typedExp_r '=' typedExp_l : AC_bound premAL*{premAL <- premAL*})

                                1. Result in: % % |- % : AC_bound premAL*{premAL <- premAL*}

                            1. Else Dangling

                  1. Else Dangling

              1. Else Dangling

          1. Else Dangling

  3. Case (% has type ifHoldPrem)

    1. (Let ifHoldPrem be premIL' as ifHoldPrem)

      1. (Let IFHOLD id ':' typedExp*{typedExp <- typedExp*} be ifHoldPrem)

        1. (Let vari_read*{vari_read <- vari_read*} be $free_varis_exps(typedExp*{typedExp <- typedExp*}))

