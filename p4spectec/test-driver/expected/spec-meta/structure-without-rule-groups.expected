            1. (Let premAL*{premAL <- premAL*} be premAL_h*{premAL_h <- premAL_h*} ++ premAL_t*{premAL_t <- premAL_t*})

              1. Result in: % % |- % : AC_t IC_t typedExp*{typedExp <- typedExp*} premAL*{premAL <- premAL*}

