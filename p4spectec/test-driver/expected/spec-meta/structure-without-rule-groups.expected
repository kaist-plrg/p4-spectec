1. If (Shallowbind_arg: AC |- arg)*{arg <- arg*} holds, then

  1. (Multibind_args: AC |- arg*{arg <- arg*} : _AC _arg*{_arg <- _arg*} premAL*{premAL <- premAL*})

    1. If (premAL*{premAL <- premAL*} matches []), then

      1. The relation holds

