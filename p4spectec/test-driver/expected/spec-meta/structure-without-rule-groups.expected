1. (Collectbind_exps: AC |- typedExp*{typedExp <- typedExp*} : vari_bind*{vari_bind <- vari_bind*})

  1. (Let R be $init_renamer(AC.USED, vari_bind*{vari_bind <- vari_bind*}))

    1. (Let (R_multi, typedExp_multi*{typedExp_multi <- typedExp_multi*}) be $rename_exps(R, typedExp*{typedExp <- typedExp*}))

