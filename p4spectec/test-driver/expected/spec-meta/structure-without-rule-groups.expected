      1. Return $iterate_prem(ITER premAL premIterAL as premAL, premIterAL_t*{premIterAL_t <- premIterAL_t*})

def $split_inputs<X>(n*{n <- n*}, X*{X <- X*})

1. If ($forall_((n < |X*{X <- X*}|)*{n <- n*})), then

  1. Return $split_inputs_from<X>(n*{n <- n*}, 0, X*{X <- X*})

1. Else Dangling

def $split_inputs_from<X>(inputHint, n', X*{X <- X*})

1. If (X*{X <- X*} matches []), then

  1. Return ([], [])

1. Else Dangling

2. (Let n*{n <- n*} be inputHint)

  1. If (X*{X <- X*} matches _ :: _), then

    1. (Let X_h :: X_t*{X_t <- X_t*} be X*{X <- X*})

