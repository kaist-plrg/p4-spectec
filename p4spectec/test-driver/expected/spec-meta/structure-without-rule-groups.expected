                1. Result in: % |- % : definedFuncDefnAL as defnAL

relation Guard_exp: AC |- exp '#' _typ' : %

1. Case analysis on exp (total)

  1. Case (% has type literalExp)

    1. Result in: % |- % : []

  2. Case (% has type varExp)

    1. Result in: % |- % : []

  3. Case (% has type unOpExp)

    1. (Let UN _unOp typedExp be exp as unOpExp)

      1. (Guard_exp: AC |- typedExp : premAL*{premAL <- premAL*})

        1. Result in: % |- % : premAL*{premAL <- premAL*}

  4. Case (% has type binOpExp)

    1. (Let BIN binOp typedExp_l typedExp_r be exp as binOpExp)

      1. Case analysis on binOp <- [DIV as binOp, MOD as binOp] (total)

        1. Case false

          1. (Guard_exps: AC |- [typedExp_l, typedExp_r] : premAL*{premAL <- premAL*})

            1. Result in: % |- % : premAL*{premAL <- premAL*}

        2. Case true

          1. (Guard_exps: AC |- [typedExp_l, typedExp_r] : premAL_operand*{premAL_operand <- premAL_operand*})

            1. (Let _exp '#' typ_r be typedExp_r)

              1. (Let typedExp_zero be $exp_zero(AC.TYP, typ_r))

                1. (Let premAL_div be $sidecond_cmp(NE as cmpOp, typedExp_r, typedExp_zero))

                  1. (Let premAL*{premAL <- premAL*} be premAL_operand*{premAL_operand <- premAL_operand*} ++ [premAL_div])

