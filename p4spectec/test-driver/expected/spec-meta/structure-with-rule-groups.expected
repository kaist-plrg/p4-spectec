2. Otherwise,

  1. Group error: C |- definedRelDefnAL `( val*{val <- val*} `) : %

    1. Result in: % |- % `( % `) : ERROR as relRes

def $ruls_of_rulgroup(id ':' rulAL*{rulAL <- rulAL*})

1. Return rulAL*{rulAL <- rulAL*}

def $ruls_of_rulgroups(rulGroupAL*{rulGroupAL <- rulGroupAL*})

1. Case analysis on rulGroupAL*{rulGroupAL <- rulGroupAL*} (total)

  1. Case (% matches pattern [])

    1. Return []

  2. Case (% matches pattern _ :: _)

    1. (Let rulGroupAL_h :: rulGroupAL_t*{rulGroupAL_t <- rulGroupAL_t*} be rulGroupAL*{rulGroupAL <- rulGroupAL*})

      1. Return $ruls_of_rulgroup(rulGroupAL_h) ++ $ruls_of_rulgroups(rulGroupAL_t*{rulGroupAL_t <- rulGroupAL_t*})

def $rul_of_elsgroup(id ':' rulAL)

1. Return rulAL

relation Algo_IL: |- defnIL*{defnIL <- defnIL*} : %

1. Group : |- defnIL*{defnIL <- defnIL*} : %

  1. (Let AC be $load_algoCtx($empty_algoCtx, defnIL*{defnIL <- defnIL*}))

    1. (Algo_def: AC |- defnIL : defnAL)*{defnIL <- defnIL*, defnAL -> defnAL*}

      1. (Guard_def: AC |- defnAL : defnAL_guard)*{defnAL <- defnAL*, defnAL_guard -> defnAL_guard*}

        1. If (Otherwise_pure: |- defnAL_guard)*{defnAL_guard <- defnAL_guard*} holds, then

          1. Result in: |- % : defnAL_guard*{defnAL_guard <- defnAL_guard*}

        1. Else Dangling

relation Eval_IL: |- specIL : %

1. Group : |- specIL : %

  1. (Algo_IL: |- specIL : specAL)

    1. (Eval_AL: |- specAL : val)

      1. Result in: |- % : val

relation Eval_AL: |- specAL : %

1. Group : |- specAL : %

  1. Debug: "entry-al"

  2. (Let C be $load_ctx($empty_ctx, specAL))

    1. Debug: "load complete"

    2. Debug: "into call"

    3. (Call_func: C |- "main" `< [] `> `( [] `) : funcRes)

      1. If (funcRes <: ok<val>), then

        1. (Let OK val be funcRes as ok<val>)

          1. Debug: val

          2. Result in: |- % : val

      1. Else Dangling
