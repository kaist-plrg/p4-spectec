relation Call_defined_rel: C |- definedRelDefnAL `( val*{val <- val*} `) : %

1. Group : C |- definedRelDefnAL `( val*{val <- val*} `) : %

  1. (Let REL _id ':' _typ*{_typ <- _typ*} '->' _typ'*{_typ' <- _typ'*} '=' rulGroupAL*{rulGroupAL <- rulGroupAL*} elsGroupAL?{elsGroupAL <- elsGroupAL?} be definedRelDefnAL)

    1. (Let C_local be C[LOCAL = $empty_localLayer])

      1. (Let rulAL*{rulAL <- rulAL*} be $ruls_of_rulgroups(rulGroupAL*{rulGroupAL <- rulGroupAL*}))

        1. (Eval_ruls: C_local |- rulAL*{rulAL <- rulAL*} `( val*{val <- val*} `) : relRes')

          1. If (relRes' <: unmatch), then

            1. (Let unmatch be relRes' as unmatch)

              1. (Let rulAL_els be $rul_of_elsgroup(elsGroupAL))?{elsGroupAL <- elsGroupAL?, rulAL_els -> rulAL_els?}

                1. (Eval_rul: C_local |- rulAL_els `( val*{val <- val*} `) : relRes_els)?{rulAL_els <- rulAL_els?, relRes_els -> relRes_els?}

                  1. (Let relRes be $deopt_<relRes>(relRes_els?{relRes_els <- relRes_els?}, UNMATCH as relRes))

