def $free_varis_exp(exp '#' typ)

1. Case analysis on exp (total)

  1. Case (% matches pattern BOOL %)

    1. Return []

  2. Case (% has type num)

    1. Return []

  3. Case (% matches pattern TEXT %)

    1. Return []

  4. Case (% matches pattern VAR %)

    1. (Let VAR id be exp)

      1. Return [id typ []]

  5. Case (% matches pattern UN % %)

    1. (Let UN _unop typedExp be exp)

      1. Return $free_varis_exp(typedExp)

  6. Case (% matches pattern BIN % % %)

    1. (Let BIN _binop typedExp_l typedExp_r be exp)

      1. Return $free_varis_exps([typedExp_l, typedExp_r])

  7. Case (% matches pattern CMP % % %)

    1. (Let CMP _cmpop typedExp_l typedExp_r be exp)

      1. Return $free_varis_exps([typedExp_l, typedExp_r])

  8. Case (% matches pattern UPCAST % %)

    1. (Let UPCAST _typ typedExp be exp)

      1. Return $free_varis_exp(typedExp)

  9. Case (% matches pattern DOWNCAST % %)

    1. (Let DOWNCAST _typ typedExp be exp)

      1. Return $free_varis_exp(typedExp)

  10. Case (% matches pattern SUB % %)

    1. (Let SUB typedExp _typ be exp)

      1. Return $free_varis_exp(typedExp)

  11. Case (% matches pattern MATCH % %)

    1. (Let MATCH typedExp _pat be exp)

      1. Return $free_varis_exp(typedExp)

  12. Case (% matches pattern TUP %)

    1. (Let TUP typedExp*{typedExp <- typedExp*} be exp)

      1. Return $free_varis_exps(typedExp*{typedExp <- typedExp*})

  13. Case (% matches pattern INJ %)

    1. (Let INJ _mixop typedExp*{typedExp <- typedExp*} be exp)

      1. Return $free_varis_exps(typedExp*{typedExp <- typedExp*})

  14. Case (% matches pattern STR %)

    1. (Let STR expField*{expField <- expField*} be exp)

      1. (Let _atom typedExp be expField)*{expField <- expField*, _atom -> _atom*, typedExp -> typedExp*}

        1. Return $free_varis_exps(typedExp*{typedExp <- typedExp*})

  15. Case (% matches pattern OPT %)

    1. (Let OPT typedExp'?{typedExp' <- typedExp'?} be exp)

      1. If (typedExp'?{typedExp' <- typedExp'?} matches (_)), then

        1. (Let ?(typedExp) be typedExp'?{typedExp' <- typedExp'?})

          1. Return $free_varis_exp(typedExp)

      1. Else Dangling

  16. Case (% matches pattern LIST %)

    1. (Let LIST typedExp*{typedExp <- typedExp*} be exp)

      1. Return $free_varis_exps(typedExp*{typedExp <- typedExp*})

  17. Case (% matches pattern CONS % %)

    1. (Let CONS typedExp_h typedExp_t be exp)

      1. Return $free_varis_exps([typedExp_h, typedExp_t])

  18. Case (% matches pattern CAT % %)

    1. (Let CAT typedExp_l typedExp_r be exp)

      1. Return $free_varis_exps([typedExp_l, typedExp_r])

  19. Case (% matches pattern MEM % %)

    1. (Let MEM typedExp_l typedExp_r be exp)

      1. Return $free_varis_exps([typedExp_l, typedExp_r])

  20. Case (% matches pattern LEN %)

    1. (Let LEN typedExp be exp)

      1. Return $free_varis_exp(typedExp)

  21. Case (% matches pattern DOT % %)

    1. (Let DOT typedExp _atom be exp)

      1. Return $free_varis_exp(typedExp)

  22. Case (% matches pattern IDX % %)

    1. (Let IDX typedExp_b typedExp_i be exp)

      1. Return $free_varis_exps([typedExp_b, typedExp_i])

  23. Case (% matches pattern SLICE % % %)

    1. (Let SLICE typedExp_b typedExp_i typedExp_n be exp)

      1. Return $free_varis_exps([typedExp_b, typedExp_i, typedExp_n])

  24. Case (% matches pattern UPD % % %)

    1. (Let UPD typedExp_b typedPath typedExp_f be exp)

      1. Return $free_varis_exp(typedExp_b) ++ $free_varis_path(typedPath) ++ $free_varis_exp(typedExp_f)

  25. Case (% matches pattern CALL % % %)

    1. (Let CALL _id _targ*{_targ <- _targ*} arg*{arg <- arg*} be exp)

      1. Return $free_varis_args(arg*{arg <- arg*})

  26. Case (% matches pattern ITER % %)

    1. (Let ITER typedExp iter _vari*{_vari <- _vari*} be exp)

      1. (Let vari*{vari <- vari*} be $free_varis_exp(typedExp))

        1. (Let vari_iter be $iterate_vari(vari, [iter]))*{vari <- vari*, vari_iter -> vari_iter*}

          1. Return vari_iter*{vari_iter <- vari_iter*}

2. If ((exp = OPT ?())), then

  1. Return []

2. Else Dangling

def $free_varis_exps(typedExp*{typedExp <- typedExp*})

1. Case analysis on typedExp*{typedExp <- typedExp*} (total)

  1. Case (% matches pattern [])

    1. Return []

  2. Case (% matches pattern _ :: _)

    1. (Let typedExp_h :: typedExp_t*{typedExp_t <- typedExp_t*} be typedExp*{typedExp <- typedExp*})

      1. Return $free_varis_exp(typedExp_h) ++ $free_varis_exps(typedExp_t*{typedExp_t <- typedExp_t*})

def $free_varis_path(path '#' _typ)

1. Case analysis on path (total)

  1. Case (% matches pattern ROOT)

    1. Return []

  2. Case (% matches pattern IDX % %)

    1. (Let IDX typedPath typedExp_i be path)

      1. Return $free_varis_path(typedPath) ++ $free_varis_exp(typedExp_i)

  3. Case (% matches pattern SLICE % % %)

    1. (Let SLICE typedPath typedExp_i typedExp_n be path)

      1. Return $free_varis_path(typedPath) ++ $free_varis_exps([typedExp_i, typedExp_n])

  4. Case (% matches pattern DOT % %)

    1. (Let DOT typedPath _atom be path)

      1. Return $free_varis_path(typedPath)

def $free_varis_arg(arg)

1. Case analysis on arg (total)

  1. Case (% matches pattern EXP %)

    1. (Let EXP typedExp be arg)

      1. Return $free_varis_exp(typedExp)

  2. Case (% matches pattern FUN %)

    1. Return []

def $free_varis_args(arg*{arg <- arg*})

1. Case analysis on arg*{arg <- arg*} (total)

  1. Case (% matches pattern [])

    1. Return []

  2. Case (% matches pattern _ :: _)

    1. (Let arg_h :: arg_t*{arg_t <- arg_t*} be arg*{arg <- arg*})

      1. Return $free_varis_arg(arg_h) ++ $free_varis_args(arg_t*{arg_t <- arg_t*})

def $free_varis_premIL(premIL')

1. Case analysis on premIL' (total)

  1. Case (% has type relPremIL)

    1. (Let REL _id ':' typedExp*{typedExp <- typedExp*} `( _inputHint `) be premIL' as relPremIL)

      1. Return $free_varis_exps(typedExp*{typedExp <- typedExp*})

  2. Case (% has type ifPrem)

    1. (Let IF typedExp be premIL' as ifPrem)

      1. Return $free_varis_exp(typedExp)

  3. Case (% has type ifHoldPrem)

    1. (Let IFHOLD _id ':' typedExp*{typedExp <- typedExp*} be premIL' as ifHoldPrem)

      1. Return $free_varis_exps(typedExp*{typedExp <- typedExp*})

  4. Case (% has type ifNotHoldPrem)

    1. (Let IFNOTHOLD _id ':' typedExp*{typedExp <- typedExp*} be premIL' as ifNotHoldPrem)

      1. Return $free_varis_exps(typedExp*{typedExp <- typedExp*})

  5. Case (% has type iterPremIL)

    1. (Let ITER premIL iter _vari*{_vari <- _vari*} be premIL' as iterPremIL)

      1. (Let vari*{vari <- vari*} be $free_varis_premIL(premIL))

        1. (Let vari_iter be $iterate_vari(vari, [iter]))*{vari <- vari*, vari_iter -> vari_iter*}

          1. Return vari_iter*{vari_iter <- vari_iter*}

  6. Case (% has type debugPrem)

    1. (Let DEBUG typedExp be premIL' as debugPrem)

      1. Return $free_varis_exp(typedExp)

def $free_varis_premILs(premIL*{premIL <- premIL*})

1. Case analysis on premIL*{premIL <- premIL*} (total)

  1. Case (% matches pattern [])

    1. Return []

  2. Case (% matches pattern _ :: _)

    1. (Let premIL_h :: premIL_t*{premIL_t <- premIL_t*} be premIL*{premIL <- premIL*})

      1. Return $free_varis_premIL(premIL_h) ++ $free_varis_premILs(premIL_t*{premIL_t <- premIL_t*})

def $free_varis_rulIL(_id ':' typedExp*{typedExp <- typedExp*} '-' premIL*{premIL <- premIL*})

1. Return $free_varis_exps(typedExp*{typedExp <- typedExp*}) ++ $free_varis_premILs(premIL*{premIL <- premIL*})

def $free_varis_clauseIL(arg*{arg <- arg*} '=' typedExp '-' premIL*{premIL <- premIL*})

1. Return $free_varis_args(arg*{arg <- arg*}) ++ $free_varis_exp(typedExp) ++ $free_varis_premILs(premIL*{premIL <- premIL*})

def $free_varis_tblRowIL(arg*{arg <- arg*} '=' typedExp)

1. Return $free_varis_args(arg*{arg <- arg*}) ++ $free_varis_exp(typedExp)

def $iter_exp(typedExp, vari, iter*{iter <- iter*})

1. Case analysis on iter*{iter <- iter*} (total)

  1. Case (% matches pattern [])

    1. Return typedExp

  2. Case (% matches pattern _ :: _)

    1. (Let iter_h :: iter_t*{iter_t <- iter_t*} be iter*{iter <- iter*})

      1. (Let _exp '#' typ be typedExp)

        1. (Let typedExp_iter be ITER typedExp iter_h [vari] '#' ITER typ iter_h)

          1. (Let vari_iter be $iterate_vari(vari, [iter_h]))

            1. Return $iter_exp(typedExp_iter, vari_iter, iter_t*{iter_t <- iter_t*})

def $exp_of_vari(id typ iter*{iter <- iter*})

1. Return $iter_exp(VAR id '#' typ, id typ [], iter*{iter <- iter*})

syntax occ = map<id, id*>

syntax renamer = {USED id*, SEEN id*, OCC occ}

var R : renamer

def $init_renamer(id_used*{id_used <- id_used*}, vari*{vari <- vari*})

1. Case analysis on vari*{vari <- vari*} (total)

  1. Case (% matches pattern [])

    1. Return {USED id_used*{id_used <- id_used*}, SEEN [], OCC $empty_map<id, id*>}

  2. Case (% matches pattern _ :: _)

    1. (Let vari_h :: vari_t*{vari_t <- vari_t*} be vari*{vari <- vari*})

      1. (Let id_h _typ _iter*{_iter <- _iter*} be vari_h)

        1. If (~id_h <- $ids_of_varis(vari_t*{vari_t <- vari_t*})), then

          1. (Let R be $init_renamer(id_used*{id_used <- id_used*}, vari_t*{vari_t <- vari_t*}))

            1. (Let occ be $add_map<id, id*>(R.OCC, id_h, []))

              1. Return R[OCC = occ]

        1. Else Dangling

      2. If (vari_h <- vari_t*{vari_t <- vari_t*}), then

        1. Return $init_renamer(id_used*{id_used <- id_used*}, vari_t*{vari_t <- vari_t*})

      2. Else Dangling

def $rename_exp(R, typedExp'')

1. (Let exp '#' typ be typedExp'')

  1. Case analysis on exp

    1. Case (% matches pattern VAR %)

      1. (Let VAR id be exp)

        1. (Let id'*{id' <- id'*}?{id'* <- id'*?} be $find_map<id, id*>(R.OCC, id))

          1. If (id'*{id' <- id'*}?{id'* <- id'*?} matches (_)), then

            1. (Let ?(id_later*{id_later <- id_later*}) be id'*{id' <- id'*}?{id'* <- id'*?})

              1. Case analysis on id <- R.SEEN (total)

                1. Case false

                  1. (Let R_multi be R[SEEN = R.SEEN ++ [id]])

                    1. Return (R_multi, VAR id '#' typ)

                2. Case true

                  1. (Let (id_used*{id_used <- id_used*}, id_fresh) be $fresh_id(R.USED))

                    1. (Let occ be $add_map<id, id*>(R.OCC, id, id_later*{id_later <- id_later*} ++ [id_fresh]))

                      1. (Let R_multi be {USED id_used*{id_used <- id_used*}, SEEN R.SEEN, OCC occ})

                        1. Return (R_multi, VAR id_fresh '#' typ)

    2. Case (% matches pattern UPCAST % %)

      1. (Let UPCAST typ_sup typedExp be exp)

        1. (Let (R_multi, typedExp_multi) be $rename_exp(R, typedExp))

          1. Return (R_multi, UPCAST typ_sup typedExp_multi '#' typ)

    3. Case (% matches pattern TUP %)

      1. (Let TUP typedExp*{typedExp <- typedExp*} be exp)

        1. (Let (R_multi, typedExp_multi*{typedExp_multi <- typedExp_multi*}) be $rename_exps(R, typedExp*{typedExp <- typedExp*}))

          1. Return (R_multi, TUP typedExp_multi*{typedExp_multi <- typedExp_multi*} '#' typ)

    4. Case (% matches pattern INJ %)

      1. (Let INJ mixop typedExp*{typedExp <- typedExp*} be exp)

        1. (Let (R_multi, typedExp_multi*{typedExp_multi <- typedExp_multi*}) be $rename_exps(R, typedExp*{typedExp <- typedExp*}))

          1. Return (R_multi, INJ mixop typedExp_multi*{typedExp_multi <- typedExp_multi*} '#' typ)

    5. Case (% matches pattern STR %)

      1. (Let STR expField*{expField <- expField*} be exp)

        1. (Let atom typedExp be expField)*{expField <- expField*, atom -> atom*, typedExp -> typedExp*}

          1. (Let (R_multi, typedExp_multi*{typedExp_multi <- typedExp_multi*}) be $rename_exps(R, typedExp*{typedExp <- typedExp*}))

            1. If ((|atom*{atom <- atom*}| = |typedExp_multi*{typedExp_multi <- typedExp_multi*}|)), then

              1. (Let expField_multi be atom typedExp_multi)*{atom <- atom*, typedExp_multi <- typedExp_multi*, expField_multi -> expField_multi*}

                1. Return (R_multi, STR expField_multi*{expField_multi <- expField_multi*} '#' typ)

    6. Case (% matches pattern OPT %)

      1. (Let OPT typedExp'?{typedExp' <- typedExp'?} be exp)

        1. If (typedExp'?{typedExp' <- typedExp'?} matches (_)), then

          1. (Let ?(typedExp) be typedExp'?{typedExp' <- typedExp'?})

            1. (Let (R_multi, typedExp_multi) be $rename_exp(R, typedExp))

              1. Return (R_multi, OPT ?(typedExp_multi) '#' typ)

    7. Case (% matches pattern LIST %)

      1. (Let LIST typedExp*{typedExp <- typedExp*} be exp)

        1. (Let (R_multi, typedExp_multi*{typedExp_multi <- typedExp_multi*}) be $rename_exps(R, typedExp*{typedExp <- typedExp*}))

          1. Return (R_multi, LIST typedExp_multi*{typedExp_multi <- typedExp_multi*} '#' typ)

    8. Case (% matches pattern CONS % %)

      1. (Let CONS typedExp_h typedExp_t be exp)

        1. (Let (R_h, typedExp_h_multi) be $rename_exp(R, typedExp_h))

          1. (Let (R_t, typedExp_t_multi) be $rename_exp(R_h, typedExp_t))

            1. Return (R_t, CONS typedExp_h_multi typedExp_t_multi '#' typ)

    9. Case (% matches pattern ITER % %)

      1. (Let ITER typedExp iter vari*{vari <- vari*} be exp)

        1. (Let (R_multi, typedExp_multi) be $rename_exp(R, typedExp))

          1. (Let id_free*{id_free <- id_free*} be $ids_of_varis($free_varis_exp(typedExp_multi)))

            1. (Let vari_rename*{vari_rename <- vari_rename*} be $rename_iter_vari(R_multi.OCC, vari, id_free*{id_free <- id_free*}))*{vari <- vari*, vari_rename* -> vari_rename**}

              1. (Let vari_occ*{vari_occ <- vari_occ*} be $concat_<vari>(vari_rename*{vari_rename <- vari_rename*}*{vari_rename* <- vari_rename**}))

                1. Return (R_multi, ITER typedExp_multi iter vari_occ*{vari_occ <- vari_occ*} '#' typ)

2. Otherwise,

  1. Return (R, typedExp'')

def $rename_exps(R, typedExp*{typedExp <- typedExp*})

1. Case analysis on typedExp*{typedExp <- typedExp*} (total)

  1. Case (% matches pattern [])

    1. Return (R, [])

  2. Case (% matches pattern _ :: _)

    1. (Let typedExp_h :: typedExp_t*{typedExp_t <- typedExp_t*} be typedExp*{typedExp <- typedExp*})

      1. (Let (R_h, typedExp_h_multi) be $rename_exp(R, typedExp_h))

        1. (Let (R_t, typedExp_t_multi*{typedExp_t_multi <- typedExp_t_multi*}) be $rename_exps(R_h, typedExp_t*{typedExp_t <- typedExp_t*}))

          1. Return (R_t, typedExp_h_multi :: typedExp_t_multi*{typedExp_t_multi <- typedExp_t_multi*})

def $rename_iter_vari(occ, vari, id_free*{id_free <- id_free*})

1. (Let id typ iter*{iter <- iter*} be vari)

  1. (Let id'*{id' <- id'*}?{id'* <- id'*?} be $find_map<id, id*>(occ, id))

    1. If (id'*{id' <- id'*}?{id'* <- id'*?} matches (_)), then

      1. (Let ?(id_later*{id_later <- id_later*}) be id'*{id' <- id'*}?{id'* <- id'*?})

        1. (Let id_occ*{id_occ <- id_occ*} be $intersect_<id>(id :: id_later*{id_later <- id_later*}, id_free*{id_free <- id_free*}))

          1. Return id_occ typ iter*{iter <- iter*}*{id_occ <- id_occ*}

2. Otherwise,

  1. Return [vari]

def $rename_arg(R, arg)

1. Case analysis on arg (total)

  1. Case (% matches pattern EXP %)

    1. (Let EXP typedExp be arg)

      1. (Let (R_multi, typedExp_multi) be $rename_exp(R, typedExp))

        1. Return (R_multi, EXP typedExp_multi)

  2. Case (% matches pattern FUN %)

    1. (Let FUN id be arg)

      1. Return (R, FUN id)

def $rename_args(R, arg*{arg <- arg*})

1. Case analysis on arg*{arg <- arg*} (total)

  1. Case (% matches pattern [])

    1. Return (R, [])

  2. Case (% matches pattern _ :: _)

    1. (Let arg_h :: arg_t*{arg_t <- arg_t*} be arg*{arg <- arg*})

      1. (Let (R_h, arg_h_multi) be $rename_arg(R, arg_h))

        1. (Let (R_t, arg_t_multi*{arg_t_multi <- arg_t_multi*}) be $rename_args(R_h, arg_t*{arg_t <- arg_t*}))

          1. Return (R_t, arg_h_multi :: arg_t_multi*{arg_t_multi <- arg_t_multi*})

def $is_invertible(typedExp)

1. (Let exp '#' _typ be typedExp)

  1. Case analysis on exp

    1. Case (% matches pattern VAR %)

      1. Return true

    2. Case (% matches pattern UPCAST % %)

      1. Return true

    3. Case (% matches pattern TUP %)

      1. Return true

    4. Case (% matches pattern INJ %)

      1. Return true

    5. Case (% matches pattern STR %)

      1. Return true

    6. Case (% matches pattern OPT %)

      1. Return true

    7. Case (% matches pattern LIST %)

      1. Return true

    8. Case (% matches pattern CONS % %)

      1. Return true

    9. Case (% matches pattern ITER % %)

      1. Return true

2. Otherwise,

  1. Return false

def $sideconds_multi(IC, vari_bind*{vari_bind <- vari_bind*}, R)

1. (Let `{ id_bind ':' id_later*{id_later <- id_later*}*{id_bind <- id_bind*, id_later* <- id_later**} `} be R.OCC)

  1. If ((0 < |$select_varis(vari_bind*{vari_bind <- vari_bind*}, [id_bind])|))*{id_bind <- id_bind*}, then

    1. (Let vari_first be $select_varis(vari_bind*{vari_bind <- vari_bind*}, [id_bind])[0])*{id_bind <- id_bind*, vari_first -> vari_first*}

      1. (Let premAL_eq*{premAL_eq <- premAL_eq*} be $sideconds_multi_binder(IC, vari_first, id_later*{id_later <- id_later*}))*{id_later* <- id_later**, vari_first <- vari_first*, premAL_eq* -> premAL_eq**}

        1. Return $concat_<premAL>(premAL_eq*{premAL_eq <- premAL_eq*}*{premAL_eq* <- premAL_eq**})

  1. Else Dangling

def $sideconds_multi_binder(IC, vari, id_later*{id_later <- id_later*})

1. Return $sidecond_multi_binder(IC, vari, id_later)*{id_later <- id_later*}

def $sidecond_multi_binder(IC, id_first typ iter*{iter <- iter*}, id_later)

1. (Let typedExp_first be VAR id_first '#' typ)

  1. (Let typedExp_later be VAR id_later '#' typ)

    1. (Let typedExp_cmp be CMP EQ as cmpop typedExp_first typedExp_later '#' BOOL as typ)

      1. (Let premAL_cmp be IF typedExp_cmp as premAL)

        1. (Let IC_inner be iter []*{iter <- iter*})

          1. (Let iter_outer _vari*{_vari <- _vari*}*{_vari* <- _vari**, iter_outer <- iter_outer*} be IC)

            1. (Let IC_outer be iter_outer []*{iter_outer <- iter_outer*})

              1. (Let vari_first be id_first typ [])

                1. (Let vari_later be id_later typ [])

                  1. (Let IC_cmp be $add_iterated(IC_inner ++ IC_outer, [vari_first, vari_later]))

                    1. (Let premIterAL*{premIterAL <- premIterAL*} be $prem_iters(IC_cmp, [id_first, id_later], []))

                      1. Return $iterate_prem(premAL_cmp, premIterAL*{premIterAL <- premIterAL*})

def $fresh_vari(AC, IC, typ)

1. (Let (id_used*{id_used <- id_used*}, id_fresh) be $fresh_id(AC.USED))

  1. (Let AC_used be AC[USED = id_used*{id_used <- id_used*}])

    1. (Let vari_fresh be id_fresh typ [])

      1. (Let iter _vari*{_vari <- _vari*}*{_vari* <- _vari**, iter <- iter*} be IC)

        1. (Let AC_fresh be $add_bound(AC_used, [$iterate_vari(vari_fresh, iter*{iter <- iter*})]))

          1. Return (AC_fresh, vari_fresh)

def $decomposes(AC, typedExp)

1. (Let id*{id <- id*} be $ids_of_varis($free_varis_exp(typedExp)))

  1. (Let id_bound*{id_bound <- id_bound*} be $ids_of_varis(AC.BOUND))

    1. Return ~$forall_(id <- id_bound*{id_bound <- id_bound*}*{id <- id*})

def $sidecond_partial(IC, vari_d, typedExp_check)

1. (Let id_d _typ _iter*{_iter <- _iter*} be vari_d)

  1. (Let premIterAL*{premIterAL <- premIterAL*} be $prem_iters($add_iterated(IC, [vari_d]), [id_d], []))

    1. Return $iterate_prem(IF typedExp_check as premAL, premIterAL*{premIterAL <- premIterAL*})

def $let_partial(IC, vari_d, typedExp_l, typedExp_r)

1. (Let id_d _typ _iter*{_iter <- _iter*} be vari_d)

  1. (Let vari_l*{vari_l <- vari_l*} be $free_varis_exp(typedExp_l))

    1. (Let vari_bind*{vari_bind <- vari_bind*} be $shallowest_varis(vari_l*{vari_l <- vari_l*}))

      1. (Let IC_bind be $add_iterated(IC, vari_d :: vari_bind*{vari_bind <- vari_bind*}))

        1. (Let premIterAL*{premIterAL <- premIterAL*} be $prem_iters(IC_bind, [id_d], $ids_of_varis(vari_bind*{vari_bind <- vari_bind*})))

          1. Return $iterate_prem(LET typedExp_l '=' typedExp_r as premAL, premIterAL*{premIterAL <- premIterAL*})

def $split_inputs<X>(n*{n <- n*}, X*{X <- X*})

1. If ($forall_((n < |X*{X <- X*}|)*{n <- n*})), then

  1. Return $split_inputs_from<X>(n*{n <- n*}, 0, X*{X <- X*})

1. Else Dangling

def $split_inputs_from<X>(inputHint, n', X*{X <- X*})

1. If (X*{X <- X*} matches []), then

  1. Return ([], [])

1. Else Dangling

2. (Let n*{n <- n*} be inputHint)

  1. If (X*{X <- X*} matches _ :: _), then

    1. (Let X_h :: X_t*{X_t <- X_t*} be X*{X <- X*})

      1. Case analysis on n' <- n*{n <- n*} (total)

        1. Case true

          1. (Let (X_in*{X_in <- X_in*}, X_out*{X_out <- X_out*}) be $split_inputs_from<X>(n*{n <- n*}, (n' + 1), X_t*{X_t <- X_t*}))

            1. Return (X_h :: X_in*{X_in <- X_in*}, X_out*{X_out <- X_out*})

        2. Case false

          1. (Let (X_in*{X_in <- X_in*}, X_out*{X_out <- X_out*}) be $split_inputs_from<X>(n*{n <- n*}, (n' + 1), X_t*{X_t <- X_t*}))

            1. Return (X_in*{X_in <- X_in*}, X_h :: X_out*{X_out <- X_out*})

  1. Else Dangling

def $is_singleton_typ(tdenv, typ)

1. (Let typRes be $expand_typ(tdenv, typ))

  1. If (typRes <: ok<typ>), then

    1. (Let OK typ' be typRes as ok<typ>)

      1. If (typ' matches VAR % %), then

        1. (Let VAR id targ*{targ <- targ*} be typ')

          1. (Let typDef'?{typDef' <- typDef'?} be $find_map<id, typDef>(tdenv, id))

            1. If (typDef'?{typDef' <- typDef'?} matches (_)), then

              1. (Let ?(typDef) be typDef'?{typDef' <- typDef'?})

                1. If (typDef <: definedTypDefn), then

                  1. (Let TYP _id tparam*{tparam <- tparam*} '=' deftyp be typDef as definedTypDefn)

                    1. If (deftyp matches VARIANT %), then

                      1. (Let VARIANT typCase*{typCase <- typCase*} be deftyp)

                        1. If ((|typCase*{typCase <- typCase*}| = 1)), then

                          1. If ((|tparam*{tparam <- tparam*}| = |targ*{targ <- targ*}|)), then

                            1. Return true

2. Otherwise,

  1. Return false

def $is_irrefutable(tdenv, typedExp')

1. (Let exp '#' typ be typedExp')

  1. Case analysis on exp

    1. Case (% matches pattern VAR %)

      1. Return true

    2. Case (% matches pattern TUP %)

      1. (Let TUP typedExp*{typedExp <- typedExp*} be exp)

        1. Return $forall_($is_irrefutable(tdenv, typedExp)*{typedExp <- typedExp*})

    3. Case (% matches pattern INJ %)

      1. (Let INJ _mixop typedExp*{typedExp <- typedExp*} be exp)

        1. Return ($is_singleton_typ(tdenv, typ) /\ $forall_($is_irrefutable(tdenv, typedExp)*{typedExp <- typedExp*}))

    4. Case (% matches pattern STR %)

      1. (Let STR expField*{expField <- expField*} be exp)

        1. (Let _atom typedExp be expField)*{expField <- expField*, _atom -> _atom*, typedExp -> typedExp*}

          1. Return $forall_($is_irrefutable(tdenv, typedExp)*{typedExp <- typedExp*})

    5. Case (% matches pattern ITER % %)

      1. (Let ITER typedExp _expIter be exp)

        1. Return $is_irrefutable(tdenv, typedExp)

2. Otherwise,

  1. Return false

def $variant_cases(tdenv, typ)

1. If (typ matches VAR % %), then

  1. (Let VAR id _targ*{_targ <- _targ*} be typ)

    1. (Let typDef'?{typDef' <- typDef'?} be $find_map<id, typDef>(tdenv, id))

      1. If (typDef'?{typDef' <- typDef'?} matches (_)), then

        1. (Let ?(typDef) be typDef'?{typDef' <- typDef'?})

          1. If (typDef <: definedTypDefn), then

            1. (Let TYP _id _tparam*{_tparam <- _tparam*} '=' deftyp be typDef as definedTypDefn)

              1. If (deftyp matches VARIANT %), then

                1. (Let VARIANT typCase*{typCase <- typCase*} be deftyp)

                  1. Return typCase*{typCase <- typCase*}

              1. Else Dangling

          1. Else Dangling

      1. Else Dangling

1. Else Dangling

def $covered_cases(tdenv, exp '#' typ')

1. Case analysis on exp

  1. Case (% matches pattern VAR %)

    1. Return $variant_cases(tdenv, typ')

  2. Case (% matches pattern UPCAST % %)

    1. (Let UPCAST _typ typedExp be exp)

      1. Return $covered_cases(tdenv, typedExp)

  3. Case (% matches pattern INJ %)

    1. (Let INJ mixop typedExp*{typedExp <- typedExp*} be exp)

      1. If ($forall_($is_irrefutable(tdenv, typedExp)*{typedExp <- typedExp*})), then

        1. (Let _exp '#' typ be typedExp)*{typedExp <- typedExp*, _exp -> _exp*, typ -> typ*}

          1. Return [mixop typ*{typ <- typ*}]

      1. Else Dangling

1. Else Dangling

def $is_wildcard_exp(typedExp)

1. (Let exp '#' _typ be typedExp)

  1. If (exp matches VAR %), then

    1. (Let VAR id be exp)

      1. If ((|id| > 0)), then

        1. If (((0 + 1) <= |id|)), then

          1. If ((id[0 : 1] = "_")), then

            1. Return true

2. Otherwise,

  1. Return false

def $shares_case(typCase_a*{typCase_a <- typCase_a*}, typCase_b*{typCase_b <- typCase_b*})

1. Return $exists_(typCase_a <- typCase_b*{typCase_b <- typCase_b*}*{typCase_a <- typCase_a*})

def $overlaps(typCase_a*{typCase_a <- typCase_a*}*{typCase_a* <- typCase_a**}, typCase_b*{typCase_b <- typCase_b*}*{typCase_b* <- typCase_b**})

1. If ((|typCase_a*{typCase_a <- typCase_a*}*{typCase_a* <- typCase_a**}| = |typCase_b*{typCase_b <- typCase_b*}*{typCase_b* <- typCase_b**}|)), then

  1. (Let b_share be $shares_case(typCase_a*{typCase_a <- typCase_a*}, typCase_b*{typCase_b <- typCase_b*}))*{typCase_a* <- typCase_a**, typCase_b* <- typCase_b**, b_share -> b_share*}

    1. Return $forall_(b_share*{b_share <- b_share*})

1. Else Dangling

def $is_exclusive(typCase*{typCase <- typCase*}*{typCase* <- typCase**}*{typCase** <- typCase***})

1. Case analysis on typCase*{typCase <- typCase*}*{typCase* <- typCase**}*{typCase** <- typCase***} (total)

  1. Case (% matches pattern [])

    1. Return true

  2. Case (% matches pattern _ :: _)

    1. (Let typCase_h*{typCase_h <- typCase_h*}*{typCase_h* <- typCase_h**} :: typCase_t*{typCase_t <- typCase_t*}*{typCase_t* <- typCase_t**}*{typCase_t** <- typCase_t***} be typCase*{typCase <- typCase*}*{typCase* <- typCase**}*{typCase** <- typCase***})

      1. (Let b_overlap be $overlaps(typCase_h*{typCase_h <- typCase_h*}*{typCase_h* <- typCase_h**}, typCase_t*{typCase_t <- typCase_t*}*{typCase_t* <- typCase_t**}))*{typCase_t** <- typCase_t***, b_overlap -> b_overlap*}

        1. Return (~$exists_(b_overlap*{b_overlap <- b_overlap*}) /\ $is_exclusive(typCase_t*{typCase_t <- typCase_t*}*{typCase_t* <- typCase_t**}*{typCase_t** <- typCase_t***}))

def $prepend_each(typCase, typCase_rest*{typCase_rest <- typCase_rest*}*{typCase_rest* <- typCase_rest**})

1. Return typCase :: typCase_rest*{typCase_rest <- typCase_rest*}*{typCase_rest* <- typCase_rest**}

def $combinations(typCase*{typCase <- typCase*}*{typCase* <- typCase**})

1. Case analysis on typCase*{typCase <- typCase*}*{typCase* <- typCase**} (total)

  1. Case (% matches pattern [])

    1. Return [[]]

  2. Case (% matches pattern _ :: _)

    1. (Let typCase_h*{typCase_h <- typCase_h*} :: typCase_t*{typCase_t <- typCase_t*}*{typCase_t* <- typCase_t**} be typCase*{typCase <- typCase*}*{typCase* <- typCase**})

      1. (Let typCase_rest*{typCase_rest <- typCase_rest*}*{typCase_rest* <- typCase_rest**} be $combinations(typCase_t*{typCase_t <- typCase_t*}*{typCase_t* <- typCase_t**}))

        1. (Let typCase_comb*{typCase_comb <- typCase_comb*}*{typCase_comb* <- typCase_comb**} be $prepend_each(typCase_h, typCase_rest*{typCase_rest <- typCase_rest*}*{typCase_rest* <- typCase_rest**}))*{typCase_h <- typCase_h*, typCase_comb** -> typCase_comb***}

          1. Return $concat_<typCase*>(typCase_comb*{typCase_comb <- typCase_comb*}*{typCase_comb* <- typCase_comb**}*{typCase_comb** <- typCase_comb***})

def $is_covered(typCase_row*{typCase_row <- typCase_row*}*{typCase_row* <- typCase_row**}*{typCase_row** <- typCase_row***}, typCase*{typCase <- typCase*})

1. If ((|typCase*{typCase <- typCase*}| = |typCase_row*{typCase_row <- typCase_row*}*{typCase_row* <- typCase_row**}|))*{typCase_row** <- typCase_row***}, then

  1. (Let b_cover be $forall_(typCase <- typCase_row*{typCase_row <- typCase_row*}*{typCase <- typCase*, typCase_row* <- typCase_row**}))*{typCase_row** <- typCase_row***, b_cover -> b_cover*}

    1. Return $exists_(b_cover*{b_cover <- b_cover*})

1. Else Dangling

def $exp_len(typedExp)

1. Return LEN typedExp '#' NAT as typ

def $sidecond_cmp(cmpop, typedExp_l, typedExp_r)

1. Return IF CMP cmpop typedExp_l typedExp_r '#' BOOL as typ as premAL

def $exp_zero(tdenv, typ)

1. If ((OK NAT as typ as typRes = $expand_typ(tdenv, typ))), then

  1. Return NAT 0 as exp '#' NAT as typ

1. Else Dangling

2. If ((OK INT as typ as typRes = $expand_typ(tdenv, typ))), then

  1. Return INT 0 as int as exp '#' INT as typ

2. Else Dangling

def $sidecond_iter(iter, vari_a, vari_b)

1. Case analysis on iter (total)

  1. Case (% matches pattern STAR)

    1. (Let typedExp_a be $exp_of_vari($iterate_vari(vari_a, [STAR])))

      1. (Let typedExp_b be $exp_of_vari($iterate_vari(vari_b, [STAR])))

        1. Return $sidecond_cmp(EQ as cmpop, $exp_len(typedExp_a), $exp_len(typedExp_b))

  2. Case (% matches pattern QUEST)

    1. (Let typedExp_a be $exp_of_vari($iterate_vari(vari_a, [QUEST])))

      1. (Let typedExp_b be $exp_of_vari($iterate_vari(vari_b, [QUEST])))

        1. (Let _exp '#' typ_opt be typedExp_a)

          1. (Let typedExp_none_a be CMP EQ as cmpop typedExp_a OPT ?() '#' typ_opt '#' BOOL as typ)

            1. (Let typedExp_none_b be CMP EQ as cmpop typedExp_b OPT ?() '#' typ_opt '#' BOOL as typ)

              1. Return IF BIN EQUIV as binop typedExp_none_a typedExp_none_b '#' BOOL as typ as premAL

def $sideconds_iter(iter, vari'*{vari' <- vari'*})

1. Case analysis on vari'*{vari' <- vari'*}

  1. Case (% matches pattern [])

    1. Return []

  2. Case (% matches pattern [ _/1 ])

    1. Return []

  3. Case (% matches pattern _ :: _)

    1. (Let vari_a :: vari*{vari <- vari*} be vari'*{vari' <- vari'*})

      1. If (vari*{vari <- vari*} matches _ :: _), then

        1. (Let vari_b :: vari_t*{vari_t <- vari_t*} be vari*{vari <- vari*})

          1. (Let premAL_ab be $sidecond_iter(iter, vari_a, vari_b))

            1. (Let premAL_t*{premAL_t <- premAL_t*} be $sideconds_iter(iter, vari_b :: vari_t*{vari_t <- vari_t*}))

              1. Return premAL_ab :: premAL_t*{premAL_t <- premAL_t*}

      1. Else Dangling

1. Else Dangling

def $access_exp(typedExp_b, path '#' typ)

1. Case analysis on path (total)

  1. Case (% matches pattern ROOT)

    1. Return typedExp_b

  2. Case (% matches pattern IDX % %)

    1. (Let IDX typedPath typedExp_i be path)

      1. (Let typedExp_p be $access_exp(typedExp_b, typedPath))

        1. Return IDX typedExp_p typedExp_i '#' typ

  3. Case (% matches pattern SLICE % % %)

    1. (Let SLICE typedPath typedExp_i typedExp_n be path)

      1. (Let typedExp_p be $access_exp(typedExp_b, typedPath))

        1. Return SLICE typedExp_p typedExp_i typedExp_n '#' typ

  4. Case (% matches pattern DOT % %)

    1. (Let DOT typedPath atom be path)

      1. (Let typedExp_p be $access_exp(typedExp_b, typedPath))

        1. Return DOT typedExp_p atom '#' typ

def $sideconds_replace(tdenv, typedPath, typedExp_f)

1. (Let path '#' _typ be typedPath)

  1. Case analysis on path

    1. Case (% matches pattern SLICE % % %)

      1. (Let SLICE _typedPath _typedExp typedExp_n be path)

        1. (Let typedExp_len be $exp_len(typedExp_f))

          1. (Let premAL_len be $sidecond_cmp(EQ as cmpop, typedExp_len, typedExp_n))

            1. Return [premAL_len]

    2. Case (% matches pattern IDX % %)

      1. (Let IDX _path '#' typ_b _typedExp be path)

        1. If ((OK TEXT as typ as typRes = $expand_typ(tdenv, typ_b))), then

          1. (Let typedExp_len be $exp_len(typedExp_f))

            1. (Let premAL_len be $sidecond_cmp(EQ as cmpop, typedExp_len, NAT 1 as exp '#' NAT as typ))

              1. Return [premAL_len]

2. Otherwise,

  1. Return []

syntax venv = map<varr, val>

syntax renv = map<id, relDefnAL>

syntax fenv = map<id, funcDefnAL>

syntax fnenv = map<id, id>

syntax globalLayer = {TYP tdenv, REL renv, FUNC fenv}

syntax localLayer = {TYP tdenv, FUNC fnenv, VAL venv}

def $empty_globalLayer

1. Return {TYP $empty_map<id, typDef>, REL $empty_map<id, relDefnAL>, FUNC $empty_map<id, funcDefnAL>}

def $empty_localLayer

1. Return {TYP $empty_map<id, typDef>, FUNC $empty_map<id, id>, VAL $empty_map<varr, val>}

syntax ctx = {GLOBAL globalLayer, LOCAL localLayer}

def $empty_ctx

1. Return {GLOBAL $empty_globalLayer, LOCAL $empty_localLayer}

var C : ctx

def $load_ctx(C, defnAL'*{defnAL' <- defnAL'*})

1. Case analysis on defnAL'*{defnAL' <- defnAL'*} (total)

  1. Case (% matches pattern _ :: _)

    1. (Let defnAL :: defnAL_t*{defnAL_t <- defnAL_t*} be defnAL'*{defnAL' <- defnAL'*})

      1. Case analysis on defnAL (total)

        1. Case (% has type externTypDefn)

          1. (Let externTypDefn be defnAL as externTypDefn)

            1. (Let EXTTYP id be externTypDefn)

              1. (Let tdenv_update be $add_map<id, typDef>(C.GLOBAL.TYP, id, externTypDefn as typDef))

                1. (Let C' be C[GLOBAL.TYP = tdenv_update])

                  1. Return $load_ctx(C', defnAL_t*{defnAL_t <- defnAL_t*})

        2. Case (% has type definedTypDefn)

          1. (Let definedTypDefn be defnAL as definedTypDefn)

            1. (Let TYP id _tparam*{_tparam <- _tparam*} '=' _deftyp be definedTypDefn)

              1. (Let tdenv_update be $add_map<id, typDef>(C.GLOBAL.TYP, id, definedTypDefn as typDef))

                1. (Let C' be C[GLOBAL.TYP = tdenv_update])

                  1. Return $load_ctx(C', defnAL_t*{defnAL_t <- defnAL_t*})

        3. Case (% has type externRelDefnAL)

          1. (Let externRelDefnAL be defnAL as externRelDefnAL)

            1. (Let EXTREL id ':' _typ*{_typ <- _typ*} '->' _typ'*{_typ' <- _typ'*} be externRelDefnAL)

              1. (Let renv_update be $add_map<id, relDefnAL>(C.GLOBAL.REL, id, externRelDefnAL as relDefnAL))

                1. (Let C' be C[GLOBAL.REL = renv_update])

                  1. Return $load_ctx(C', defnAL_t*{defnAL_t <- defnAL_t*})

        4. Case (% has type definedRelDefnAL)

          1. (Let definedRelDefnAL be defnAL as definedRelDefnAL)

            1. (Let REL id ':' _typ*{_typ <- _typ*} '->' _typ'*{_typ' <- _typ'*} '=' _rulGroupAL*{_rulGroupAL <- _rulGroupAL*} _elsGroupAL?{_elsGroupAL <- _elsGroupAL?} be definedRelDefnAL)

              1. (Let renv_update be $add_map<id, relDefnAL>(C.GLOBAL.REL, id, definedRelDefnAL as relDefnAL))

                1. (Let C' be C[GLOBAL.REL = renv_update])

                  1. Return $load_ctx(C', defnAL_t*{defnAL_t <- defnAL_t*})

        5. Case (% has type externFuncDefn)

          1. (Let externFuncDefn be defnAL as externFuncDefn)

            1. (Let EXTFUNC id _tparam*{_tparam <- _tparam*} _param*{_param <- _param*} ':' _typ be externFuncDefn)

              1. (Let fenv_update be $add_map<id, funcDefnAL>(C.GLOBAL.FUNC, id, externFuncDefn as funcDefnAL))

                1. (Let C' be C[GLOBAL.FUNC = fenv_update])

                  1. Return $load_ctx(C', defnAL_t*{defnAL_t <- defnAL_t*})

        6. Case (% has type builtinFuncDefn)

          1. (Let builtinFuncDefn be defnAL as builtinFuncDefn)

            1. (Let BUILTINFUNC id _tparam*{_tparam <- _tparam*} _param*{_param <- _param*} ':' _typ be builtinFuncDefn)

              1. (Let fenv_update be $add_map<id, funcDefnAL>(C.GLOBAL.FUNC, id, builtinFuncDefn as funcDefnAL))

                1. (Let C' be C[GLOBAL.FUNC = fenv_update])

                  1. Return $load_ctx(C', defnAL_t*{defnAL_t <- defnAL_t*})

        7. Case (% has type tableFuncDefnAL)

          1. (Let tableFuncDefnAL be defnAL as tableFuncDefnAL)

            1. (Let TABLEFUNC id _param*{_param <- _param*} ':' _typ '=' _tblRowAL*{_tblRowAL <- _tblRowAL*} be tableFuncDefnAL)

              1. (Let fenv_update be $add_map<id, funcDefnAL>(C.GLOBAL.FUNC, id, tableFuncDefnAL as funcDefnAL))

                1. (Let C' be C[GLOBAL.FUNC = fenv_update])

                  1. Return $load_ctx(C', defnAL_t*{defnAL_t <- defnAL_t*})

        8. Case (% has type definedFuncDefnAL)

          1. (Let definedFuncDefnAL be defnAL as definedFuncDefnAL)

            1. (Let FUNC id _tparam*{_tparam <- _tparam*} _param*{_param <- _param*} ':' _typ '=' _clauseAL*{_clauseAL <- _clauseAL*} _elsClauseAL?{_elsClauseAL <- _elsClauseAL?} be definedFuncDefnAL)

              1. (Let fenv_update be $add_map<id, funcDefnAL>(C.GLOBAL.FUNC, id, definedFuncDefnAL as funcDefnAL))

                1. (Let C' be C[GLOBAL.FUNC = fenv_update])

                  1. Return $load_ctx(C', defnAL_t*{defnAL_t <- defnAL_t*})

  2. Case (% matches pattern [])

    1. Return C

def $add_varr(C, varr, val)

1. (Let venv_update be $add_map<varr, val>(C.LOCAL.VAL, varr, val))

  1. Return C[LOCAL.VAL = venv_update]

def $add_varis(C, vari*{vari <- vari*}, val*{val <- val*})

1. (Let id _typ iter*{iter <- iter*} be vari)*{vari <- vari*, _typ -> _typ*, id -> id*, iter* -> iter**}

  1. (Let venv_update be $adds_map<varr, val>(C.LOCAL.VAL, id iter*{iter <- iter*}*{id <- id*, iter* <- iter**}, val*{val <- val*}))

    1. Return C[LOCAL.VAL = venv_update]

def $add_func(C, id, id_global)

1. (Let fnenv_update be $add_map<id, id>(C.LOCAL.FUNC, id, id_global))

  1. Return C[LOCAL.FUNC = fnenv_update]

def $find_vari(C, vari)

1. (Let id _typ iter*{iter <- iter*} be vari)

  1. (Let val'?{val' <- val'?} be $find_map<varr, val>(C.LOCAL.VAL, id iter*{iter <- iter*}))

    1. If (val'?{val' <- val'?} matches (_)), then

      1. (Let ?(val) be val'?{val' <- val'?})

        1. Return ?(val)

2. Otherwise,

  1. Return ?()

def $find_varr(C, varr)

1. Return $find_map<varr, val>(C.LOCAL.VAL, varr)

def $find_varis(C, vari*{vari <- vari*})

1. (Let val'?{val' <- val'?} be $find_vari(C, vari))*{vari <- vari*, val'? -> val'?*}

  1. If (val'?{val' <- val'?} matches (_))*{val'? <- val'?*}, then

    1. (Let ?(val) be val'?{val' <- val'?})*{val'? <- val'?*, val -> val*}

      1. Return ?(val*{val <- val*})

2. Otherwise,

  1. Return ?()

def $finds_vari(C*{C <- C*}, vari)

1. (Let id _typ iter*{iter <- iter*} be vari)

  1. (Let val'?{val' <- val'?} be $find_map<varr, val>(C.LOCAL.VAL, id iter*{iter <- iter*}))*{C <- C*, val'? -> val'?*}

    1. If (val'?{val' <- val'?} matches (_))*{val'? <- val'?*}, then

      1. (Let ?(val) be val'?{val' <- val'?})*{val'? <- val'?*, val -> val*}

        1. Return ?(val*{val <- val*})

2. Otherwise,

  1. Return ?()

def $find_typ(C, id)

1. (Let typDef'?{typDef' <- typDef'?} be $find_map<id, typDef>(C.LOCAL.TYP, id))

  1. If (typDef'?{typDef' <- typDef'?} matches (_)), then

    1. (Let ?(typDef) be typDef'?{typDef' <- typDef'?})

      1. Return ?(typDef)

  1. Else Dangling

2. If ($find_map<id, typDef>(C.LOCAL.TYP, id) matches ()), then

  1. Return $find_map<id, typDef>(C.GLOBAL.TYP, id)

2. Else Dangling

def $find_func_param(C, id)

1. Return $find_map<id, id>(C.LOCAL.FUNC, id)

def $resolve_func_param(C, id)

1. Return $deopt_<id>($find_func_param(C, id), id)

def $find_func(C, id)

1. Return $find_map<id, funcDefnAL>(C.GLOBAL.FUNC, id)

def $find_rel(C, id)

1. Return $find_map<id, relDefnAL>(C.GLOBAL.REL, id)

syntax subOptRes =
   | OK ctx? (from ok<ctx?>)
   | ERROR (from error)

def $sub_opt(C, vari*{vari <- vari*})

1. Case analysis on vari*{vari <- vari*} (total)

  1. Case (% matches pattern [])

    1. Return ERROR as subOptRes

  2. Case (% matches pattern _ :: _)

    1. (Let vari_iter be $iterate_vari(vari, [QUEST]))*{vari <- vari*, vari_iter -> vari_iter*}

      1. (Let val'''?{val''' <- val'''?} be $find_vari(C, vari_iter))*{vari_iter <- vari_iter*, val'''? -> val'''?*}

        1. If (val'''?{val''' <- val'''?} matches (_))*{val'''? <- val'''?*}, then

          1. (Let ?(val'') be val'''?{val''' <- val'''?})*{val'''? <- val'''?*, val'' -> val''*}

            1. If (val'' matches OPT %)*{val'' <- val''*}, then

              1. (Let OPT val'?{val' <- val'?} be val'')*{val'' <- val''*, val'? -> val'?*}

                1. If (val'?{val' <- val'?} matches (_))*{val'? <- val'?*}, then

                  1. (Let ?(val) be val'?{val' <- val'?})*{val'? <- val'?*, val -> val*}

                    1. (Let C_sub be $add_varis(C, vari*{vari <- vari*}, val*{val <- val*}))

                      1. Return OK ?(C_sub) as subOptRes

      2. If ((?(OPT ?()) = $find_vari(C, vari_iter)))*{vari_iter <- vari_iter*}, then

        1. Return OK ?() as subOptRes

2. Otherwise,

  1. Return ERROR as subOptRes

syntax subListRes =
   | OK ctx* (from ok<ctx*>)
   | ERROR (from error)

def $sub_list(C, vari*{vari <- vari*})

1. (Let vari_iter be $iterate_vari(vari, [STAR]))*{vari <- vari*, vari_iter -> vari_iter*}

  1. (Let val''?{val'' <- val''?} be $find_vari(C, vari_iter))*{vari_iter <- vari_iter*, val''? -> val''?*}

    1. If (val''?{val'' <- val''?} matches (_))*{val''? <- val''?*}, then

      1. (Let ?(val') be val''?{val'' <- val''?})*{val''? <- val''?*, val' -> val'*}

        1. If (val' matches LIST %)*{val' <- val'*}, then

          1. (Let LIST val*{val <- val*} be val')*{val' <- val'*, val* -> val**}

            1. If ((0 < |val*{val <- val*}*{val* <- val**}|))*{val* <- val**}, then

              1. If ($forall_((|val*{val <- val*}| = |val*{val <- val*}*{val* <- val**}[0]|)*{val* <- val**})), then

                1. (Let val_trans*{val_trans <- val_trans*}*{val_trans* <- val_trans**} be $transpose_<val>(val*{val <- val*}*{val* <- val**}))

                  1. (Let C' be $add_varis(C, vari*{vari <- vari*}, val_trans*{val_trans <- val_trans*}))*{val_trans* <- val_trans**, C' -> C'*}

                    1. Return OK C'*{C' <- C'*} as subListRes

2. Otherwise,

  1. Return ERROR as subListRes

syntax funcRes =
   | OK val (from ok<val>)
   | ERROR (from error)
   | UNMATCH (from unmatch)

extern relation Call_extern_func: |- id `< typ*{typ <- typ*} `> `( val*{val <- val*} `) : %

extern relation Call_builtin_func: |- id `< typ*{typ <- typ*} `> `( val*{val <- val*} `) : %

syntax relRes =
   | OK val* (from ok<val*>)
   | ERROR (from error)
   | UNMATCH (from unmatch)

extern relation Call_extern_rel: |- id `( val*{val <- val*} `) : %

syntax expRes =
   | OK val (from ok<val>)
   | ERROR (from error)
   | UNMATCH (from unmatch)

relation Eval_exp: C |- typedExp' : %

1. (Let exp '#' typ' be typedExp')

  1. Group literal: C |- exp '#' typ' : %

    1. Case analysis on exp

      1. Case (% matches pattern BOOL %)

        1. (Let BOOL b be exp)

          1. Result in: % |- % : OK BOOL b as expRes

      2. Case (% has type num)

        1. (Let num be exp as num)

          1. Result in: % |- % : OK num as val as expRes

      3. Case (% matches pattern TEXT %)

        1. (Let TEXT t be exp)

          1. Result in: % |- % : OK TEXT t as expRes

  2. Case analysis on exp

    1. Case (% matches pattern VAR %)

      1. (Let VAR id be exp)

        1. Group variable: C |- VAR id '#' typ' : %

          1. (Let val'?{val' <- val'?} be $find_varr(C, id []))

            1. If (val'?{val' <- val'?} matches (_)), then

              1. (Let ?(val) be val'?{val' <- val'?})

                1. Result in: % |- % : OK val as expRes

    2. Case (% matches pattern UN % %)

      1. (Let UN unop typedExp be exp)

        1. Group unary: C |- UN unop typedExp '#' typ' : %

          1. If ((unop = NOT as unop)), then

            1. (Eval_exp: C |- typedExp : expRes)

              1. Case analysis on expRes (total)

                1. Case (% has type failure)

                  1. (Let failure be expRes as failure)

                    1. Result in: % |- % : failure as expRes

                2. Case (% has type ok<val>)

                  1. (Let OK val be expRes as ok<val>)

                    1. If (val matches BOOL %), then

                      1. (Let BOOL b be val)

                        1. (Let b_res be ~b)

                          1. Result in: % |- % : OK BOOL b_res as expRes

          2. If (unop <: numUnop), then

            1. (Let numUnop be unop as numUnop)

              1. (Eval_exp: C |- typedExp : expRes)

                1. Case analysis on expRes (total)

                  1. Case (% has type failure)

                    1. (Let failure be expRes as failure)

                      1. Result in: % |- % : failure as expRes

                  2. Case (% has type ok<val>)

                    1. (Let OK val be expRes as ok<val>)

                      1. If (val <: num), then

                        1. (Let num be val as num)

                          1. (Let val_res be $numUnop(numUnop, num))

                            1. Result in: % |- % : OK val_res as expRes

    3. Case (% matches pattern BIN % % %)

      1. (Let BIN binop typedExp_l typedExp_r be exp)

        1. Group binary: C |- BIN binop typedExp_l typedExp_r '#' typ' : %

          1. Case analysis on binop (total)

            1. Case (% has type boolBinop)

              1. (Let boolBinop be binop as boolBinop)

                1. (Eval_exp: C |- typedExp_l : expRes)

                  1. Case analysis on expRes (total)

                    1. Case (% has type failure)

                      1. (Let failure be expRes as failure)

                        1. Result in: % |- % : failure as expRes

                    2. Case (% has type ok<val>)

                      1. (Let OK val be expRes as ok<val>)

                        1. If (val matches BOOL %), then

                          1. (Let BOOL b_l be val)

                            1. (Eval_exp: C |- typedExp_r : expRes')

                              1. Case analysis on expRes' (total)

                                1. Case (% has type failure)

                                  1. (Let failure be expRes' as failure)

                                    1. Result in: % |- % : failure as expRes

                                2. Case (% has type ok<val>)

                                  1. (Let OK val' be expRes' as ok<val>)

                                    1. If (val' matches BOOL %), then

                                      1. (Let BOOL b_r be val')

                                        1. (Let b_res be $boolBinop(boolBinop, b_l, b_r))

                                          1. Result in: % |- % : OK BOOL b_res as expRes

            2. Case (% has type numBinop)

              1. (Let numBinop be binop as numBinop)

                1. (Eval_exp: C |- typedExp_l : expRes)

                  1. Case analysis on expRes (total)

                    1. Case (% has type failure)

                      1. (Let failure be expRes as failure)

                        1. Result in: % |- % : failure as expRes

                    2. Case (% has type ok<val>)

                      1. (Let OK val be expRes as ok<val>)

                        1. If (val <: num), then

                          1. (Let num_l be val as num)

                            1. (Eval_exp: C |- typedExp_r : expRes')

                              1. Case analysis on expRes' (total)

                                1. Case (% has type failure)

                                  1. (Let failure be expRes' as failure)

                                    1. Result in: % |- % : failure as expRes

                                2. Case (% has type ok<val>)

                                  1. (Let OK val' be expRes' as ok<val>)

                                    1. If (val' <: num), then

                                      1. (Let num_r be val' as num)

                                        1. (Let numBinopRes be $numBinop(numBinop, num_l, num_r))

                                          1. Result in: % |- % : numBinopRes as expRes

    4. Case (% matches pattern CMP % % %)

      1. (Let CMP cmpop typedExp_l typedExp_r be exp)

        1. Group compare: C |- CMP cmpop typedExp_l typedExp_r '#' typ' : %

          1. Case analysis on cmpop (total)

            1. Case (% has type polyCmpop)

              1. (Let polyCmpop be cmpop as polyCmpop)

                1. (Eval_exp: C |- typedExp_l : expRes)

                  1. Case analysis on expRes (total)

                    1. Case (% has type failure)

                      1. (Let failure be expRes as failure)

                        1. Result in: % |- % : failure as expRes

                    2. Case (% has type ok<val>)

                      1. (Let OK val_l be expRes as ok<val>)

                        1. (Eval_exp: C |- typedExp_r : expRes')

                          1. Case analysis on expRes' (total)

                            1. Case (% has type failure)

                              1. (Let failure be expRes' as failure)

                                1. Result in: % |- % : failure as expRes

                            2. Case (% has type ok<val>)

                              1. (Let OK val_r be expRes' as ok<val>)

                                1. (Let b_res be $polyCmpop(polyCmpop, val_l, val_r))

                                  1. Result in: % |- % : OK BOOL b_res as expRes

            2. Case (% has type numCmpop)

              1. (Let numCmpop be cmpop as numCmpop)

                1. (Eval_exp: C |- typedExp_l : expRes)

                  1. Case analysis on expRes (total)

                    1. Case (% has type failure)

                      1. (Let failure be expRes as failure)

                        1. Result in: % |- % : failure as expRes

                    2. Case (% has type ok<val>)

                      1. (Let OK val be expRes as ok<val>)

                        1. If (val <: num), then

                          1. (Let num_l be val as num)

                            1. (Eval_exp: C |- typedExp_r : expRes')

                              1. Case analysis on expRes' (total)

                                1. Case (% has type failure)

                                  1. (Let failure be expRes' as failure)

                                    1. Result in: % |- % : failure as expRes

                                2. Case (% has type ok<val>)

                                  1. (Let OK val' be expRes' as ok<val>)

                                    1. If (val' <: num), then

                                      1. (Let num_r be val' as num)

                                        1. (Let numCmpRes be $numCmpop(numCmpop, num_l, num_r))

                                          1. If (numCmpRes <: ok<bool>), then

                                            1. (Let OK b_res be numCmpRes as ok<bool>)

                                              1. Result in: % |- % : OK BOOL b_res as expRes

    5. Case (% matches pattern UPCAST % %)

      1. (Let UPCAST typ typedExp be exp)

        1. Group upcast: C |- UPCAST typ typedExp '#' typ' : %

          1. (Eval_exp: C |- typedExp : expRes)

            1. Case analysis on expRes (total)

              1. Case (% has type failure)

                1. (Let failure be expRes as failure)

                  1. Result in: % |- % : failure as expRes

              2. Case (% has type ok<val>)

                1. (Let OK val be expRes as ok<val>)

                  1. (Let castRes be $upcast(C, typ, val))

                    1. Result in: % |- % : castRes as expRes

    6. Case (% matches pattern DOWNCAST % %)

      1. (Let DOWNCAST typ typedExp be exp)

        1. Group downcast: C |- DOWNCAST typ typedExp '#' typ' : %

          1. (Eval_exp: C |- typedExp : expRes)

            1. Case analysis on expRes (total)

              1. Case (% has type failure)

                1. (Let failure be expRes as failure)

                  1. Result in: % |- % : failure as expRes

              2. Case (% has type ok<val>)

                1. (Let OK val be expRes as ok<val>)

                  1. (Let castRes be $downcast(C, typ, val))

                    1. Result in: % |- % : castRes as expRes

    7. Case (% matches pattern SUB % %)

      1. (Let SUB typedExp typ be exp)

        1. Group subtype: C |- SUB typedExp typ '#' typ' : %

          1. (Eval_exp: C |- typedExp : expRes)

            1. Case analysis on expRes (total)

              1. Case (% has type failure)

                1. (Let failure be expRes as failure)

                  1. Result in: % |- % : failure as expRes

              2. Case (% has type ok<val>)

                1. (Let OK val be expRes as ok<val>)

                  1. (Let `{ id_local ':' typDef_local*{id_local <- id_local*, typDef_local <- typDef_local*} `} be C.LOCAL.TYP)

                    1. (Let tdenv be $adds_map<id, typDef>(C.GLOBAL.TYP, id_local*{id_local <- id_local*}, typDef_local*{typDef_local <- typDef_local*}))

                      1. (Let subtypRes be $subtyp(C.GLOBAL.FUNC, tdenv, typ, val))

                        1. If (subtypRes <: ok<bool>), then

                          1. (Let OK b be subtypRes as ok<bool>)

                            1. Result in: % |- % : OK BOOL b as expRes

    8. Case (% matches pattern MATCH % %)

      1. (Let MATCH typedExp pat be exp)

        1. Group match: C |- MATCH typedExp pat '#' typ' : %

          1. (Eval_exp: C |- typedExp : expRes)

            1. Case analysis on expRes (total)

              1. Case (% has type failure)

                1. (Let failure be expRes as failure)

                  1. Result in: % |- % : failure as expRes

              2. Case (% has type ok<val>)

                1. (Let OK val be expRes as ok<val>)

                  1. (Let b_matches be $matches(val, pat))

                    1. Result in: % |- % : OK BOOL b_matches as expRes

    9. Case (% matches pattern TUP %)

      1. (Let TUP typedExp*{typedExp <- typedExp*} be exp)

        1. Group tuple: C |- TUP typedExp*{typedExp <- typedExp*} '#' typ' : %

          1. (Eval_exps: C |- typedExp*{typedExp <- typedExp*} : expsRes)

            1. Case analysis on expsRes (total)

              1. Case (% has type failure)

                1. (Let failure be expsRes as failure)

                  1. Result in: % |- % : failure as expRes

              2. Case (% has type ok<val*>)

                1. (Let OK val*{val <- val*} be expsRes as ok<val*>)

                  1. Result in: % |- % : OK TUP val*{val <- val*} as expRes

    10. Case (% matches pattern INJ %)

      1. (Let INJ mixop typedExp*{typedExp <- typedExp*} be exp)

        1. Group case: C |- INJ mixop typedExp*{typedExp <- typedExp*} '#' typ' : %

          1. (Eval_exps: C |- typedExp*{typedExp <- typedExp*} : expsRes)

            1. Case analysis on expsRes (total)

              1. Case (% has type failure)

                1. (Let failure be expsRes as failure)

                  1. Result in: % |- % : failure as expRes

              2. Case (% has type ok<val*>)

                1. (Let OK val*{val <- val*} be expsRes as ok<val*>)

                  1. Result in: % |- % : OK INJ mixop val*{val <- val*} as expRes

    11. Case (% matches pattern STR %)

      1. (Let STR expField*{expField <- expField*} be exp)

        1. Group struct: C |- STR expField*{expField <- expField*} '#' typ' : %

          1. (Let atom typedExp be expField)*{expField <- expField*, atom -> atom*, typedExp -> typedExp*}

            1. (Eval_exps: C |- typedExp*{typedExp <- typedExp*} : expsRes)

              1. Case analysis on expsRes (total)

                1. Case (% has type failure)

                  1. (Let failure be expsRes as failure)

                    1. Result in: % |- % : failure as expRes

                2. Case (% has type ok<val*>)

                  1. (Let OK val*{val <- val*} be expsRes as ok<val*>)

                    1. If ((|atom*{atom <- atom*}| = |val*{val <- val*}|)), then

                      1. (Let valField be atom val)*{atom <- atom*, val <- val*, valField -> valField*}

                        1. Result in: % |- % : OK STR valField*{valField <- valField*} as expRes

    12. Case (% matches pattern OPT %)

      1. (Let OPT typedExp''?{typedExp'' <- typedExp''?} be exp)

        1. Group opt: C |- OPT typedExp''?{typedExp'' <- typedExp''?} '#' typ' : %

          1. Case analysis on typedExp''?{typedExp'' <- typedExp''?} (total)

            1. Case (% matches pattern ())

              1. Result in: % |- % : OK OPT ?() as expRes

            2. Case (% matches pattern (_))

              1. (Let ?(typedExp) be typedExp''?{typedExp'' <- typedExp''?})

                1. (Eval_exp: C |- typedExp : expRes)

                  1. Case analysis on expRes (total)

                    1. Case (% has type failure)

                      1. (Let failure be expRes as failure)

                        1. Result in: % |- % : failure as expRes

                    2. Case (% has type ok<val>)

                      1. (Let OK val be expRes as ok<val>)

                        1. Result in: % |- % : OK OPT ?(val) as expRes

    13. Case (% matches pattern LIST %)

      1. (Let LIST typedExp*{typedExp <- typedExp*} be exp)

        1. Group list: C |- LIST typedExp*{typedExp <- typedExp*} '#' typ' : %

          1. (Eval_exps: C |- typedExp*{typedExp <- typedExp*} : expsRes)

            1. Case analysis on expsRes (total)

              1. Case (% has type failure)

                1. (Let failure be expsRes as failure)

                  1. Result in: % |- % : failure as expRes

              2. Case (% has type ok<val*>)

                1. (Let OK val*{val <- val*} be expsRes as ok<val*>)

                  1. Result in: % |- % : OK LIST val*{val <- val*} as expRes

    14. Case (% matches pattern CONS % %)

      1. (Let CONS typedExp_h typedExp_t be exp)

        1. Group cons: C |- CONS typedExp_h typedExp_t '#' typ' : %

          1. (Eval_exp: C |- typedExp_h : expRes)

            1. Case analysis on expRes (total)

              1. Case (% has type failure)

                1. (Let failure be expRes as failure)

                  1. Result in: % |- % : failure as expRes

              2. Case (% has type ok<val>)

                1. (Let OK val_h be expRes as ok<val>)

                  1. (Eval_exp: C |- typedExp_t : expRes')

                    1. Case analysis on expRes' (total)

                      1. Case (% has type failure)

                        1. (Let failure be expRes' as failure)

                          1. Result in: % |- % : failure as expRes

                      2. Case (% has type ok<val>)

                        1. (Let OK val be expRes' as ok<val>)

                          1. If (val matches LIST %), then

                            1. (Let LIST val_t*{val_t <- val_t*} be val)

                              1. Result in: % |- % : OK LIST val_h :: val_t*{val_t <- val_t*} as expRes

    15. Case (% matches pattern CAT % %)

      1. (Let CAT typedExp_l typedExp_r be exp)

        1. Group concat: C |- CAT typedExp_l typedExp_r '#' typ' : %

          1. (Eval_exp: C |- typedExp_l : expRes)

            1. Case analysis on expRes (total)

              1. Case (% has type failure)

                1. (Let failure be expRes as failure)

                  1. Result in: % |- % : failure as expRes

              2. Case (% has type ok<val>)

                1. (Let OK val be expRes as ok<val>)

                  1. Case analysis on val

                    1. Case (% matches pattern LIST %)

                      1. (Let LIST val_l*{val_l <- val_l*} be val)

                        1. (Eval_exp: C |- typedExp_r : expRes')

                          1. Case analysis on expRes' (total)

                            1. Case (% has type failure)

                              1. (Let failure be expRes' as failure)

                                1. Result in: % |- % : failure as expRes

                            2. Case (% has type ok<val>)

                              1. (Let OK val' be expRes' as ok<val>)

                                1. If (val' matches LIST %), then

                                  1. (Let LIST val_r*{val_r <- val_r*} be val')

                                    1. (Let val_res*{val_res <- val_res*} be val_l*{val_l <- val_l*} ++ val_r*{val_r <- val_r*})

                                      1. Result in: % |- % : OK LIST val_res*{val_res <- val_res*} as expRes

                    2. Case (% matches pattern TEXT %)

                      1. (Let TEXT text_l be val)

                        1. (Eval_exp: C |- typedExp_r : expRes')

                          1. Case analysis on expRes' (total)

                            1. Case (% has type failure)

                              1. (Let failure be expRes' as failure)

                                1. Result in: % |- % : failure as expRes

                            2. Case (% has type ok<val>)

                              1. (Let OK val' be expRes' as ok<val>)

                                1. If (val' matches TEXT %), then

                                  1. (Let TEXT t_r be val')

                                    1. (Let t_res be text_l ++ t_r)

                                      1. Result in: % |- % : OK TEXT t_res as expRes

    16. Case (% matches pattern MEM % %)

      1. (Let MEM typedExp_e typedExp_s be exp)

        1. Group mem: C |- MEM typedExp_e typedExp_s '#' typ' : %

          1. (Eval_exp: C |- typedExp_e : expRes)

            1. Case analysis on expRes (total)

              1. Case (% has type failure)

                1. (Let failure be expRes as failure)

                  1. Result in: % |- % : failure as expRes

              2. Case (% has type ok<val>)

                1. (Let OK val_e be expRes as ok<val>)

                  1. (Eval_exp: C |- typedExp_s : expRes')

                    1. Case analysis on expRes' (total)

                      1. Case (% has type failure)

                        1. (Let failure be expRes' as failure)

                          1. Result in: % |- % : failure as expRes

                      2. Case (% has type ok<val>)

                        1. (Let OK val' be expRes' as ok<val>)

                          1. If (val' matches LIST %), then

                            1. (Let LIST val*{val <- val*} be val')

                              1. (Let b_mem be $exists_((val_e = val)*{val <- val*}))

                                1. Result in: % |- % : OK BOOL b_mem as expRes

    17. Case (% matches pattern LEN %)

      1. (Let LEN typedExp be exp)

        1. Group len: C |- LEN typedExp '#' typ' : %

          1. (Eval_exp: C |- typedExp : expRes)

            1. Case analysis on expRes (total)

              1. Case (% has type failure)

                1. (Let failure be expRes as failure)

                  1. Result in: % |- % : failure as expRes

              2. Case (% has type ok<val>)

                1. (Let OK val' be expRes as ok<val>)

                  1. Case analysis on val'

                    1. Case (% matches pattern TEXT %)

                      1. (Let TEXT t be val')

                        1. (Let n be |t|)

                          1. Result in: % |- % : OK NAT n as val as expRes

                    2. Case (% matches pattern LIST %)

                      1. (Let LIST val*{val <- val*} be val')

                        1. (Let n be |val*{val <- val*}|)

                          1. Result in: % |- % : OK NAT n as val as expRes

    18. Case (% matches pattern DOT % %)

      1. (Let DOT typedExp atom be exp)

        1. Group dot: C |- DOT typedExp atom '#' typ' : %

          1. (Eval_exp: C |- typedExp : expRes)

            1. Case analysis on expRes (total)

              1. Case (% has type failure)

                1. (Let failure be expRes as failure)

                  1. Result in: % |- % : failure as expRes

              2. Case (% has type ok<val>)

                1. (Let OK val be expRes as ok<val>)

                  1. (Let _exp '#' typ_b be typedExp)

                    1. (Let typedPath be DOT ROOT '#' typ_b atom '#' typ')

                      1. (Eval_path_acc: C |- val typedPath : pathRes)

                        1. Result in: % |- % : pathRes as expRes

    19. Case (% matches pattern IDX % %)

      1. (Let IDX typedExp_b typedExp_i be exp)

        1. Group idx: C |- IDX typedExp_b typedExp_i '#' typ' : %

          1. (Eval_exp: C |- typedExp_b : expRes)

            1. Case analysis on expRes (total)

              1. Case (% has type failure)

                1. (Let failure be expRes as failure)

                  1. Result in: % |- % : failure as expRes

              2. Case (% has type ok<val>)

                1. (Let OK val_b be expRes as ok<val>)

                  1. (Let _exp '#' typ_b be typedExp_b)

                    1. (Let typedPath be IDX ROOT '#' typ_b typedExp_i '#' typ')

                      1. (Eval_path_acc: C |- val_b typedPath : pathRes)

                        1. Result in: % |- % : pathRes as expRes

    20. Case (% matches pattern SLICE % % %)

      1. (Let SLICE typedExp_b typedExp_i typedExp_n be exp)

        1. Group slice: C |- SLICE typedExp_b typedExp_i typedExp_n '#' typ' : %

          1. (Eval_exp: C |- typedExp_b : expRes)

            1. Case analysis on expRes (total)

              1. Case (% has type failure)

                1. (Let failure be expRes as failure)

                  1. Result in: % |- % : failure as expRes

              2. Case (% has type ok<val>)

                1. (Let OK val_b be expRes as ok<val>)

                  1. (Let _exp '#' typ_b be typedExp_b)

                    1. (Let typedPath be SLICE ROOT '#' typ_b typedExp_i typedExp_n '#' typ')

                      1. (Eval_path_acc: C |- val_b typedPath : pathRes)

                        1. Result in: % |- % : pathRes as expRes

    21. Case (% matches pattern UPD % % %)

      1. (Let UPD typedExp_b typedPath typedExp_f be exp)

        1. Group upd: C |- UPD typedExp_b typedPath typedExp_f '#' typ' : %

          1. (Eval_exp: C |- typedExp_b : expRes)

            1. Case analysis on expRes (total)

              1. Case (% has type failure)

                1. (Let failure be expRes as failure)

                  1. Result in: % |- % : failure as expRes

              2. Case (% has type ok<val>)

                1. (Let OK val_b be expRes as ok<val>)

                  1. (Eval_exp: C |- typedExp_f : expRes')

                    1. Case analysis on expRes' (total)

                      1. Case (% has type failure)

                        1. (Let failure be expRes' as failure)

                          1. Result in: % |- % : failure as expRes

                      2. Case (% has type ok<val>)

                        1. (Let OK val_f be expRes' as ok<val>)

                          1. (Eval_path_upd: C |- val_b typedPath := val_f : pathRes)

                            1. Result in: % |- % : pathRes as expRes

    22. Case (% matches pattern CALL % % %)

      1. (Let CALL id targ*{targ <- targ*} arg*{arg <- arg*} be exp)

        1. Group call: C |- CALL id targ*{targ <- targ*} arg*{arg <- arg*} '#' typ' : %

          1. (Eval_targs: C |- targ*{targ <- targ*} : typsRes)

            1. If (typsRes <: ok<typ*>), then

              1. (Let OK typ_input*{typ_input <- typ_input*} be typsRes as ok<typ*>)

                1. (Eval_args: C |- arg*{arg <- arg*} : argsRes)

                  1. Case analysis on argsRes (total)

                    1. Case (% has type failure)

                      1. (Let failure be argsRes as failure)

                        1. Result in: % |- % : failure as expRes

                    2. Case (% has type ok<val*>)

                      1. (Let OK val_input*{val_input <- val_input*} be argsRes as ok<val*>)

                        1. (Call_func: C |- id `< typ_input*{typ_input <- typ_input*} `> `( val_input*{val_input <- val_input*} `) : funcRes)

                          1. Result in: % |- % : funcRes as expRes

    23. Case (% matches pattern ITER % %)

      1. (Let ITER typedExp expIter be exp)

        1. Group iter: C |- ITER typedExp expIter '#' typ' : %

          1. (Let varr'?{varr' <- varr'?} be $is_iter_on_var(ITER typedExp expIter '#' typ'))

            1. If (varr'?{varr' <- varr'?} matches (_)), then

              1. (Let ?(varr) be varr'?{varr' <- varr'?})

                1. (Let val'?{val' <- val'?} be $find_varr(C, varr))

                  1. If (val'?{val' <- val'?} matches (_)), then

                    1. (Let ?(val) be val'?{val' <- val'?})

                      1. Result in: % |- % : OK val as expRes

          2. If ($is_iter_on_var(ITER typedExp expIter '#' typ') matches ()), then

            1. (Let iter vari*{vari <- vari*} be expIter)

              1. Case analysis on iter (total)

                1. Case (% matches pattern QUEST)

                  1. (Let subOptRes be $sub_opt(C, vari*{vari <- vari*}))

                    1. If (subOptRes <: ok<ctx?>), then

                      1. (Let OK C_sub?{C_sub <- C_sub?} be subOptRes as ok<ctx?>)

                        1. (Eval_exp_maybe: C_sub?{C_sub <- C_sub?} |- typedExp : expOptRes)

                          1. Case analysis on expOptRes (total)

                            1. Case (% has type failure)

                              1. (Let failure be expOptRes as failure)

                                1. Result in: % |- % : failure as expRes

                            2. Case (% has type ok<val?>)

                              1. (Let OK val?{val <- val?} be expOptRes as ok<val?>)

                                1. Result in: % |- % : OK OPT val?{val <- val?} as expRes

                2. Case (% matches pattern STAR)

                  1. (Let subListRes be $sub_list(C, vari*{vari <- vari*}))

                    1. If (subListRes <: ok<ctx*>), then

                      1. (Let OK C_sub*{C_sub <- C_sub*} be subListRes as ok<ctx*>)

                        1. (Eval_exp_each: C_sub*{C_sub <- C_sub*} |- typedExp : expsRes)

                          1. Case analysis on expsRes (total)

                            1. Case (% has type failure)

                              1. (Let failure be expsRes as failure)

                                1. Result in: % |- % : failure as expRes

                            2. Case (% has type ok<val*>)

                              1. (Let OK val*{val <- val*} be expsRes as ok<val*>)

                                1. Result in: % |- % : OK LIST val*{val <- val*} as expRes

2. Otherwise,

  1. Group error: C |- typedExp' : %

    1. Result in: % |- % : ERROR as expRes

syntax expsRes =
   | OK val* (from ok<val*>)
   | ERROR (from error)
   | UNMATCH (from unmatch)

relation Eval_exps: C |- typedExp*{typedExp <- typedExp*} : %

1. Group : C |- typedExp*{typedExp <- typedExp*} : %

  1. Case analysis on typedExp*{typedExp <- typedExp*} (total)

    1. Case (% matches pattern [])

      1. Result in: % |- % : OK [] as expsRes

    2. Case (% matches pattern _ :: _)

      1. (Let typedExp_h :: typedExp_t*{typedExp_t <- typedExp_t*} be typedExp*{typedExp <- typedExp*})

        1. (Eval_exp: C |- typedExp_h : expRes)

          1. Case analysis on expRes (total)

            1. Case (% has type failure)

              1. (Let failure be expRes as failure)

                1. Result in: % |- % : failure as expsRes

            2. Case (% has type ok<val>)

              1. (Let OK val_h be expRes as ok<val>)

                1. (Eval_exps: C |- typedExp_t*{typedExp_t <- typedExp_t*} : expsRes)

                  1. Case analysis on expsRes (total)

                    1. Case (% has type failure)

                      1. (Let failure be expsRes as failure)

                        1. Result in: % |- % : failure as expsRes

                    2. Case (% has type ok<val*>)

                      1. (Let OK val_t*{val_t <- val_t*} be expsRes as ok<val*>)

                        1. Result in: % |- % : OK val_h :: val_t*{val_t <- val_t*} as expsRes

syntax expOptRes =
   | OK val? (from ok<val?>)
   | ERROR (from error)
   | UNMATCH (from unmatch)

relation Eval_exp_maybe: C'?{C' <- C'?} |- typedExp : %

1. Group : C'?{C' <- C'?} |- typedExp : %

  1. Case analysis on C'?{C' <- C'?} (total)

    1. Case (% matches pattern ())

      1. Result in: % |- % : OK ?() as expOptRes

    2. Case (% matches pattern (_))

      1. (Let ?(C) be C'?{C' <- C'?})

        1. (Eval_exp: C |- typedExp : expRes)

          1. Case analysis on expRes (total)

            1. Case (% has type failure)

              1. (Let failure be expRes as failure)

                1. Result in: % |- % : failure as expOptRes

            2. Case (% has type ok<val>)

              1. (Let OK val be expRes as ok<val>)

                1. Result in: % |- % : OK ?(val) as expOptRes

relation Eval_exp_each: C*{C <- C*} |- typedExp : %

1. Group : C*{C <- C*} |- typedExp : %

  1. Case analysis on C*{C <- C*} (total)

    1. Case (% matches pattern [])

      1. Result in: % |- % : OK [] as expsRes

    2. Case (% matches pattern _ :: _)

      1. (Let C_h :: C_t*{C_t <- C_t*} be C*{C <- C*})

        1. (Eval_exp: C_h |- typedExp : expRes)

          1. Case analysis on expRes (total)

            1. Case (% has type failure)

              1. (Let failure be expRes as failure)

                1. Result in: % |- % : failure as expsRes

            2. Case (% has type ok<val>)

              1. (Let OK val_h be expRes as ok<val>)

                1. (Eval_exp_each: C_t*{C_t <- C_t*} |- typedExp : expsRes)

                  1. Case analysis on expsRes (total)

                    1. Case (% has type failure)

                      1. (Let failure be expsRes as failure)

                        1. Result in: % |- % : failure as expsRes

                    2. Case (% has type ok<val*>)

                      1. (Let OK val_t*{val_t <- val_t*} be expsRes as ok<val*>)

                        1. Result in: % |- % : OK val_h :: val_t*{val_t <- val_t*} as expsRes

syntax pathRes =
   | OK val (from ok<val>)
   | ERROR (from error)
   | UNMATCH (from unmatch)

relation Eval_path_acc: C |- val_b typedPath' : %

1. (Let path '#' typ be typedPath')

  1. Case analysis on path (total)

    1. Case (% matches pattern ROOT)

      1. Group root: C |- val_b ROOT '#' typ : %

        1. Result in: % |- % % : OK val_b as pathRes

    2. Case (% matches pattern DOT % %)

      1. (Let DOT typedPath atom be path)

        1. Group dot: C |- val_b DOT typedPath atom '#' typ : %

          1. (Eval_path_acc: C |- val_b typedPath : pathRes)

            1. Case analysis on pathRes (total)

              1. Case (% has type failure)

                1. (Let failure be pathRes as failure)

                  1. Result in: % |- % % : failure as pathRes

              2. Case (% has type ok<val>)

                1. (Let OK val' be pathRes as ok<val>)

                  1. If (val' matches STR %), then

                    1. (Let STR valField*{valField <- valField*} be val')

                      1. (Let atom_field val_field be valField)*{valField <- valField*, atom_field -> atom_field*, val_field -> val_field*}

                        1. (Let val''?{val'' <- val''?} be $assoc_<atom, val>(atom, (atom_field, val_field)*{atom_field <- atom_field*, val_field <- val_field*}))

                          1. If (val''?{val'' <- val''?} matches (_)), then

                            1. (Let ?(val) be val''?{val'' <- val''?})

                              1. Result in: % |- % % : OK val as pathRes

    3. Case (% matches pattern IDX % %)

      1. (Let IDX typedPath typedExp_i be path)

        1. Group idx: C |- val_b IDX typedPath typedExp_i '#' typ : %

          1. (Eval_path_acc: C |- val_b typedPath : pathRes)

            1. Case analysis on pathRes (total)

              1. Case (% has type failure)

                1. (Let failure be pathRes as failure)

                  1. Result in: % |- % % : failure as pathRes

              2. Case (% has type ok<val>)

                1. (Let OK val' be pathRes as ok<val>)

                  1. Case analysis on val'

                    1. Case (% matches pattern LIST %)

                      1. (Let LIST val*{val <- val*} be val')

                        1. (Eval_exp: C |- typedExp_i : expRes)

                          1. Case analysis on expRes (total)

                            1. Case (% has type failure)

                              1. (Let failure be expRes as failure)

                                1. Result in: % |- % % : failure as pathRes

                            2. Case (% has type ok<val>)

                              1. (Let OK val'' be expRes as ok<val>)

                                1. If (val'' <: num), then

                                  1. (Let num be val'' as num)

                                    1. If (num matches NAT %), then

                                      1. (Let NAT n be num)

                                        1. If ((n < |val*{val <- val*}|)), then

                                          1. (Let val_idx be val*{val <- val*}[n])

                                            1. Result in: % |- % % : OK val_idx as pathRes

                    2. Case (% matches pattern TEXT %)

                      1. (Let TEXT t be val')

                        1. (Eval_exp: C |- typedExp_i : expRes)

                          1. Case analysis on expRes (total)

                            1. Case (% has type failure)

                              1. (Let failure be expRes as failure)

                                1. Result in: % |- % % : failure as pathRes

                            2. Case (% has type ok<val>)

                              1. (Let OK val be expRes as ok<val>)

                                1. If (val <: num), then

                                  1. (Let num be val as num)

                                    1. If (num matches NAT %), then

                                      1. (Let NAT n be num)

                                        1. If ((n < |t|)), then

                                          1. (Let t_idx be t[n])

                                            1. Result in: % |- % % : OK TEXT t_idx as pathRes

    4. Case (% matches pattern SLICE % % %)

      1. (Let SLICE typedPath typedExp_i typedExp_n be path)

        1. Group slice: C |- val_b SLICE typedPath typedExp_i typedExp_n '#' typ : %

          1. (Eval_path_acc: C |- val_b typedPath : pathRes)

            1. Case analysis on pathRes (total)

              1. Case (% has type failure)

                1. (Let failure be pathRes as failure)

                  1. Result in: % |- % % : failure as pathRes

              2. Case (% has type ok<val>)

                1. (Let OK val' be pathRes as ok<val>)

                  1. Case analysis on val'

                    1. Case (% matches pattern TEXT %)

                      1. (Let TEXT t be val')

                        1. (Eval_exp: C |- typedExp_i : expRes)

                          1. Case analysis on expRes (total)

                            1. Case (% has type failure)

                              1. (Let failure be expRes as failure)

                                1. Result in: % |- % % : failure as pathRes

                            2. Case (% has type ok<val>)

                              1. (Let OK val be expRes as ok<val>)

                                1. If (val <: num), then

                                  1. (Let num be val as num)

                                    1. If (num matches NAT %), then

                                      1. (Let NAT n_i be num)

                                        1. (Eval_exp: C |- typedExp_n : expRes')

                                          1. Case analysis on expRes' (total)

                                            1. Case (% has type failure)

                                              1. (Let failure be expRes' as failure)

                                                1. Result in: % |- % % : failure as pathRes

                                            2. Case (% has type ok<val>)

                                              1. (Let OK val'' be expRes' as ok<val>)

                                                1. If (val'' <: num), then

                                                  1. (Let num' be val'' as num)

                                                    1. If (num' matches NAT %), then

                                                      1. (Let NAT n_n be num')

                                                        1. If (((n_i + n_n) <= |t|)), then

                                                          1. (Let val_slice be TEXT t[n_i : n_n])

                                                            1. Result in: % |- % % : OK val_slice as pathRes

                    2. Case (% matches pattern LIST %)

                      1. (Let LIST val*{val <- val*} be val')

                        1. (Eval_exp: C |- typedExp_i : expRes)

                          1. Case analysis on expRes (total)

                            1. Case (% has type failure)

                              1. (Let failure be expRes as failure)

                                1. Result in: % |- % % : failure as pathRes

                            2. Case (% has type ok<val>)

                              1. (Let OK val'' be expRes as ok<val>)

                                1. If (val'' <: num), then

                                  1. (Let num be val'' as num)

                                    1. If (num matches NAT %), then

                                      1. (Let NAT n_i be num)

                                        1. (Eval_exp: C |- typedExp_n : expRes')

                                          1. Case analysis on expRes' (total)

                                            1. Case (% has type failure)

                                              1. (Let failure be expRes' as failure)

                                                1. Result in: % |- % % : failure as pathRes

                                            2. Case (% has type ok<val>)

                                              1. (Let OK val''' be expRes' as ok<val>)

                                                1. If (val''' <: num), then

                                                  1. (Let num' be val''' as num)

                                                    1. If (num' matches NAT %), then

                                                      1. (Let NAT n_n be num')

                                                        1. If (((n_i + n_n) <= |val*{val <- val*}|)), then

                                                          1. (Let val_slice be LIST val*{val <- val*}[n_i : n_n])

                                                            1. Result in: % |- % % : OK val_slice as pathRes

2. Otherwise,

  1. Group error: C |- val_b typedPath' : %

    1. Result in: % |- % % : ERROR as pathRes

relation Eval_path_upd: C |- val_b typedPath' := val_n' : %

1. (Let path '#' typ be typedPath')

  1. Case analysis on path (total)

    1. Case (% matches pattern ROOT)

      1. Group root: C |- val_b ROOT '#' typ := val_n' : %

        1. Result in: % |- % % := % : OK val_n' as pathRes

    2. Case (% matches pattern IDX % %)

      1. (Let IDX typedPath typedExp_i be path)

        1. Group idx: C |- val_b IDX typedPath typedExp_i '#' typ := val_n' : %

          1. (Eval_path_acc: C |- val_b typedPath : pathRes')

            1. Case analysis on pathRes' (total)

              1. Case (% has type failure)

                1. (Let failure be pathRes' as failure)

                  1. Result in: % |- % % := % : failure as pathRes

              2. Case (% has type ok<val>)

                1. (Let OK val' be pathRes' as ok<val>)

                  1. Case analysis on val'

                    1. Case (% matches pattern LIST %)

                      1. (Let LIST val*{val <- val*} be val')

                        1. (Eval_exp: C |- typedExp_i : expRes)

                          1. Case analysis on expRes (total)

                            1. Case (% has type failure)

                              1. (Let failure be expRes as failure)

                                1. Result in: % |- % % := % : failure as pathRes

                            2. Case (% has type ok<val>)

                              1. (Let OK val'' be expRes as ok<val>)

                                1. If (val'' <: num), then

                                  1. (Let num be val'' as num)

                                    1. If (num matches NAT %), then

                                      1. (Let NAT n_target be num)

                                        1. If ((n_target < |val*{val <- val*}|)), then

                                          1. (Let val_upd be LIST val*{val <- val*}[[n_target] = val_n'])

                                            1. (Eval_path_upd: C |- val_b typedPath := val_upd : pathRes)

                                              1. Result in: % |- % % := % : pathRes

                    2. Case (% matches pattern TEXT %)

                      1. (Eval_exp: C |- typedExp_i : expRes)

                        1. If (expRes <: failure), then

                          1. (Let failure be expRes as failure)

                            1. Result in: % |- % % := % : failure as pathRes

          2. If (val_n' matches TEXT %), then

            1. (Let TEXT t_n be val_n')

              1. (Eval_path_acc: C |- val_b typedPath : pathRes')

                1. If (pathRes' <: ok<val>), then

                  1. (Let OK val be pathRes' as ok<val>)

                    1. If (val matches TEXT %), then

                      1. (Let TEXT t be val)

                        1. (Eval_exp: C |- typedExp_i : expRes)

                          1. If (expRes <: ok<val>), then

                            1. (Let OK val' be expRes as ok<val>)

                              1. If (val' <: num), then

                                1. (Let num be val' as num)

                                  1. If (num matches NAT %), then

                                    1. (Let NAT n_target be num)

                                      1. If ((n_target < |t|)), then

                                        1. If ((|t_n| = 1)), then

                                          1. (Let val_upd be TEXT t[[n_target] = t_n])

                                            1. (Eval_path_upd: C |- val_b typedPath := val_upd : pathRes)

                                              1. Result in: % |- % % := % : pathRes

    3. Case (% matches pattern SLICE % % %)

      1. (Let SLICE typedPath typedExp_i typedExp_n be path)

        1. Group slice: C |- val_b SLICE typedPath typedExp_i typedExp_n '#' typ := val_n' : %

          1. (Eval_path_acc: C |- val_b typedPath : pathRes)

            1. Case analysis on pathRes (total)

              1. Case (% has type failure)

                1. (Let failure be pathRes as failure)

                  1. Result in: % |- % % := % : failure as pathRes

              2. Case (% has type ok<val>)

                1. (Let OK val be pathRes as ok<val>)

                  1. If (val matches TEXT %), then

                    1. (Eval_exp: C |- typedExp_i : expRes)

                      1. Case analysis on expRes (total)

                        1. Case (% has type failure)

                          1. (Let failure be expRes as failure)

                            1. Result in: % |- % % := % : failure as pathRes

                        2. Case (% has type ok<val>)

                          1. (Let OK val' be expRes as ok<val>)

                            1. If (val' <: num), then

                              1. (Let num be val' as num)

                                1. If (num matches NAT %), then

                                  1. (Eval_exp: C |- typedExp_n : expRes')

                                    1. If (expRes' <: failure), then

                                      1. (Let failure be expRes' as failure)

                                        1. Result in: % |- % % := % : failure as pathRes

          2. If (val_n' matches TEXT %), then

            1. (Let TEXT t_n be val_n')

              1. (Eval_path_acc: C |- val_b typedPath : pathRes')

                1. If (pathRes' <: ok<val>), then

                  1. (Let OK val be pathRes' as ok<val>)

                    1. If (val matches TEXT %), then

                      1. (Let TEXT t be val)

                        1. (Eval_exp: C |- typedExp_i : expRes)

                          1. If (expRes <: ok<val>), then

                            1. (Let OK val' be expRes as ok<val>)

                              1. If (val' <: num), then

                                1. (Let num be val' as num)

                                  1. If (num matches NAT %), then

                                    1. (Let NAT n_i be num)

                                      1. (Eval_exp: C |- typedExp_n : expRes')

                                        1. If (expRes' <: ok<val>), then

                                          1. (Let OK val'' be expRes' as ok<val>)

                                            1. If (val'' <: num), then

                                              1. (Let num' be val'' as num)

                                                1. If (num' matches NAT %), then

                                                  1. (Let NAT n_n be num')

                                                    1. If (((n_i + n_n) <= |t|)), then

                                                      1. If ((|t_n| = n_n)), then

                                                        1. (Let val_upd be TEXT t[[n_i : n_n] = t_n])

                                                          1. (Eval_path_upd: C |- val_b typedPath := val_upd : pathRes)

                                                            1. Result in: % |- % % := % : pathRes

          3. (Eval_path_acc: C |- val_b typedPath : pathRes)

            1. If (pathRes <: ok<val>), then

              1. (Let OK val be pathRes as ok<val>)

                1. If (val matches LIST %), then

                  1. (Eval_exp: C |- typedExp_i : expRes)

                    1. Case analysis on expRes (total)

                      1. Case (% has type failure)

                        1. (Let failure be expRes as failure)

                          1. Result in: % |- % % := % : failure as pathRes

                      2. Case (% has type ok<val>)

                        1. (Let OK val' be expRes as ok<val>)

                          1. If (val' <: num), then

                            1. (Let num be val' as num)

                              1. If (num matches NAT %), then

                                1. (Eval_exp: C |- typedExp_n : expRes')

                                  1. If (expRes' <: failure), then

                                    1. (Let failure be expRes' as failure)

                                      1. Result in: % |- % % := % : failure as pathRes

          4. If (val_n' matches LIST %), then

            1. (Let LIST val_n*{val_n <- val_n*} be val_n')

              1. (Eval_path_acc: C |- val_b typedPath : pathRes')

                1. If (pathRes' <: ok<val>), then

                  1. (Let OK val' be pathRes' as ok<val>)

                    1. If (val' matches LIST %), then

                      1. (Let LIST val*{val <- val*} be val')

                        1. (Eval_exp: C |- typedExp_i : expRes)

                          1. If (expRes <: ok<val>), then

                            1. (Let OK val'' be expRes as ok<val>)

                              1. If (val'' <: num), then

                                1. (Let num be val'' as num)

                                  1. If (num matches NAT %), then

                                    1. (Let NAT n_i be num)

                                      1. (Eval_exp: C |- typedExp_n : expRes')

                                        1. If (expRes' <: ok<val>), then

                                          1. (Let OK val''' be expRes' as ok<val>)

                                            1. If (val''' <: num), then

                                              1. (Let num' be val''' as num)

                                                1. If (num' matches NAT %), then

                                                  1. (Let NAT n_n be num')

                                                    1. If (((n_i + n_n) <= |val*{val <- val*}|)), then

                                                      1. If ((|val_n*{val_n <- val_n*}| = n_n)), then

                                                        1. (Let val_upd be LIST val*{val <- val*}[[n_i : n_n] = val_n*{val_n <- val_n*}])

                                                          1. (Eval_path_upd: C |- val_b typedPath := val_upd : pathRes)

                                                            1. Result in: % |- % % := % : pathRes

    4. Case (% matches pattern DOT % %)

      1. (Let DOT typedPath atom be path)

        1. Group dot: C |- val_b DOT typedPath atom '#' typ := val_n' : %

          1. (Eval_path_acc: C |- val_b typedPath : pathRes')

            1. Case analysis on pathRes' (total)

              1. Case (% has type failure)

                1. (Let failure be pathRes' as failure)

                  1. Result in: % |- % % := % : failure as pathRes

              2. Case (% has type ok<val>)

                1. (Let OK val be pathRes' as ok<val>)

                  1. If (val matches STR %), then

                    1. (Let STR valField*{valField <- valField*} be val)

                      1. (Let atom_field val_field be valField)*{valField <- valField*, atom_field -> atom_field*, val_field -> val_field*}

                        1. (Let valField_new be atom_field $ite<val>((atom = atom_field), val_n', val_field))*{atom_field <- atom_field*, val_field <- val_field*, valField_new -> valField_new*}

                          1. (Let val_upd be STR valField_new*{valField_new <- valField_new*})

                            1. (Eval_path_upd: C |- val_b typedPath := val_upd : pathRes)

                              1. Result in: % |- % % := % : pathRes

2. Otherwise,

  1. Group error: C |- val_b typedPath' := val_n' : %

    1. Result in: % |- % % := % : ERROR as pathRes

relation Eval_targs: C |- targ*{targ <- targ*} : %

1. Group : C |- targ*{targ <- targ*} : %

  1. (Let theta be $theta_of_tdenv(C.LOCAL.TYP))

    1. (Let typsRes be $subst_typs(theta, targ*{targ <- targ*}))

      1. Result in: % |- % : typsRes

2. Otherwise,

  1. Group error: C |- targ*{targ <- targ*} : %

    1. Result in: % |- % : ERROR as typsRes

syntax argRes =
   | OK val (from ok<val>)
   | ERROR (from error)
   | UNMATCH (from unmatch)

relation Eval_arg: C |- arg : %

1. Case analysis on arg (total)

  1. Case (% matches pattern EXP %)

    1. (Let EXP typedExp be arg)

      1. Group exp: C |- EXP typedExp : %

        1. (Eval_exp: C |- typedExp : expRes)

          1. If (expRes <: argRes), then

            1. (Let argRes be expRes as argRes)

              1. Result in: % |- % : argRes

  2. Case (% matches pattern FUN %)

    1. (Let FUN id be arg)

      1. Group fun: C |- FUN id : %

        1. (Let id_global be $resolve_func_param(C, id))

          1. Result in: % |- % : OK FUNC id_global as argRes

2. Otherwise,

  1. Group error: C |- arg : %

    1. Result in: % |- % : ERROR as argRes

syntax argsRes =
   | OK val* (from ok<val*>)
   | ERROR (from error)
   | UNMATCH (from unmatch)

relation Eval_args: C |- arg*{arg <- arg*} : %

1. Group : C |- arg*{arg <- arg*} : %

  1. Case analysis on arg*{arg <- arg*} (total)

    1. Case (% matches pattern [])

      1. Result in: % |- % : OK [] as argsRes

    2. Case (% matches pattern _ :: _)

      1. (Let arg_h :: arg_t*{arg_t <- arg_t*} be arg*{arg <- arg*})

        1. (Eval_arg: C |- arg_h : argRes)

          1. Case analysis on argRes (total)

            1. Case (% has type failure)

              1. (Let failure be argRes as failure)

                1. Result in: % |- % : failure as argsRes

            2. Case (% has type ok<val>)

              1. (Let OK val_h be argRes as ok<val>)

                1. (Eval_args: C |- arg_t*{arg_t <- arg_t*} : argsRes)

                  1. Case analysis on argsRes (total)

                    1. Case (% has type failure)

                      1. (Let failure be argsRes as failure)

                        1. Result in: % |- % : failure as argsRes

                    2. Case (% has type ok<val*>)

                      1. (Let OK val_t*{val_t <- val_t*} be argsRes as ok<val*>)

                        1. Result in: % |- % : OK val_h :: val_t*{val_t <- val_t*} as argsRes

syntax premRes =
   | OK ctx (from ok<ctx>)
   | ERROR (from error)
   | UNMATCH (from unmatch)

relation Eval_prem: C |- premAL' : %

1. Case analysis on premAL' (total)

  1. Case (% has type relPremAL)

    1. (Let REL id ':' typedExp*{typedExp <- typedExp*} '->' typedExp_out*{typedExp_out <- typedExp_out*} be premAL' as relPremAL)

      1. Group relpr: C |- REL id ':' typedExp*{typedExp <- typedExp*} '->' typedExp_out*{typedExp_out <- typedExp_out*} as premAL : %

        1. (Eval_exps: C |- typedExp*{typedExp <- typedExp*} : expsRes)

          1. Case analysis on expsRes (total)

            1. Case (% has type failure)

              1. (Let failure be expsRes as failure)

                1. Result in: % |- % : failure as premRes

            2. Case (% has type ok<val*>)

              1. (Let OK val*{val <- val*} be expsRes as ok<val*>)

                1. (Call_rel: C |- id `( val*{val <- val*} `) : relRes)

                  1. Case analysis on relRes (total)

                    1. Case (% has type failure)

                      1. (Let failure be relRes as failure)

                        1. Result in: % |- % : failure as premRes

                    2. Case (% has type ok<val*>)

                      1. (Let OK val_out*{val_out <- val_out*} be relRes as ok<val*>)

                        1. (Assign_exps: C |- typedExp_out*{typedExp_out <- typedExp_out*} := val_out*{val_out <- val_out*} : assignRes)

                          1. If (assignRes <: ok<ctx>), then

                            1. (Let OK C' be assignRes as ok<ctx>)

                              1. Result in: % |- % : OK C' as premRes

  2. Case (% has type ifPrem)

    1. (Let IF typedExp be premAL' as ifPrem)

      1. Group ifpr: C |- IF typedExp as premAL : %

        1. (Eval_exp: C |- typedExp : expRes)

          1. If (expRes <: failure), then

            1. (Let failure be expRes as failure)

              1. Result in: % |- % : failure as premRes

          2. Case analysis on expRes

            1. Case (% = OK BOOL false as expRes)

              1. Result in: % |- % : UNMATCH as premRes

            2. Case (% = OK BOOL true as expRes)

              1. Result in: % |- % : OK C as premRes

  3. Case (% has type ifHoldPrem)

    1. (Let IFHOLD id ':' typedExp*{typedExp <- typedExp*} be premAL' as ifHoldPrem)

      1. Group ifholdpr: C |- IFHOLD id ':' typedExp*{typedExp <- typedExp*} as premAL : %

        1. (Eval_exps: C |- typedExp*{typedExp <- typedExp*} : expsRes)

          1. Case analysis on expsRes (total)

            1. Case (% has type failure)

              1. (Let failure be expsRes as failure)

                1. Result in: % |- % : failure as premRes

            2. Case (% has type ok<val*>)

              1. (Let OK val_input*{val_input <- val_input*} be expsRes as ok<val*>)

                1. (Call_rel: C |- id `( val_input*{val_input <- val_input*} `) : relRes)

                  1. If (relRes <: failure), then

                    1. (Let failure be relRes as failure)

                      1. Result in: % |- % : failure as premRes

                  2. If ((relRes = OK [] as relRes)), then

                    1. Result in: % |- % : OK C as premRes

  4. Case (% has type ifNotHoldPrem)

    1. (Let IFNOTHOLD id ':' typedExp*{typedExp <- typedExp*} be premAL' as ifNotHoldPrem)

      1. Group ifnotholdpr: C |- IFNOTHOLD id ':' typedExp*{typedExp <- typedExp*} as premAL : %

        1. (Eval_exps: C |- typedExp*{typedExp <- typedExp*} : expsRes)

          1. Case analysis on expsRes (total)

            1. Case (% has type failure)

              1. (Let failure be expsRes as failure)

                1. Result in: % |- % : failure as premRes

            2. Case (% has type ok<val*>)

              1. (Let OK val_input*{val_input <- val_input*} be expsRes as ok<val*>)

                1. (Call_rel: C |- id `( val_input*{val_input <- val_input*} `) : relRes)

                  1. Case analysis on relRes (total)

                    1. Case (% has type error)

                      1. (Let error be relRes as error)

                        1. Result in: % |- % : ERROR as premRes

                    2. Case (% has type ok<val*>)

                      1. Result in: % |- % : UNMATCH as premRes

                    3. Case (% has type unmatch)

                      1. (Let unmatch be relRes as unmatch)

                        1. Result in: % |- % : OK C as premRes

  5. Case (% has type letPremAL)

    1. (Let LET typedExp_l '=' typedExp_r be premAL' as letPremAL)

      1. Group letpr: C |- LET typedExp_l '=' typedExp_r as premAL : %

        1. (Eval_exp: C |- typedExp_r : expRes)

          1. Case analysis on expRes (total)

            1. Case (% has type failure)

              1. (Let failure be expRes as failure)

                1. Result in: % |- % : failure as premRes

            2. Case (% has type ok<val>)

              1. (Let OK val_r be expRes as ok<val>)

                1. (Assign_exp: C |- typedExp_l := val_r : assignRes)

                  1. If (assignRes <: ok<ctx>), then

                    1. (Let OK C' be assignRes as ok<ctx>)

                      1. Result in: % |- % : OK C' as premRes

  6. Case (% has type iterPremAL)

    1. (Let ITER premAL premIterAL be premAL' as iterPremAL)

      1. Group iterpr-opt: C |- ITER premAL premIterAL as premAL : %

        1. (Let iter '<-' vari_bound*{vari_bound <- vari_bound*} '->' _vari*{_vari <- _vari*} be premIterAL)

          1. If (iter matches QUEST), then

            1. (Let subOptRes be $sub_opt(C, vari_bound*{vari_bound <- vari_bound*}))

              1. If (subOptRes <: ok<ctx?>), then

                1. (Let OK C_sub?{C_sub <- C_sub?} be subOptRes as ok<ctx?>)

                  1. (Eval_prem_maybe: C_sub?{C_sub <- C_sub?} |- premAL : premOptRes)

                    1. Case analysis on premOptRes (total)

                      1. Case (% has type failure)

                        1. (Let failure be premOptRes as failure)

                          1. Result in: % |- % : failure as premRes

                      2. Case (% has type ok<ctx?>)

                        1. (Let OK C'?{C' <- C'?} be premOptRes as ok<ctx?>)

                          1. If (C'?{C' <- C'?} matches (_)), then

                            1. (Let ?(C_sub_res) be C'?{C' <- C'?})

                              1. (Let val?{val <- val?} be $find_vari(C_sub_res, _vari))*{_vari <- _vari*, val? -> val?*}

                                1. If (val?{val <- val?} matches (_))*{val? <- val?*}, then

                                  1. (Let ?(val_bind) be val?{val <- val?})*{val? <- val?*, val_bind -> val_bind*}

                                    1. (Let vari_bind_iter be $iterate_vari(_vari, [QUEST]))*{_vari <- _vari*, vari_bind_iter -> vari_bind_iter*}

                                      1. (Let C_res be $add_varis(C, vari_bind_iter*{vari_bind_iter <- vari_bind_iter*}, OPT ?(val_bind)*{val_bind <- val_bind*}))

                                        1. Result in: % |- % : OK C_res as premRes

                    2. If ((premOptRes = OK ?() as premOptRes)), then

                      1. (Let vari_bind_iter be $iterate_vari(_vari, [QUEST]))*{_vari <- _vari*, vari_bind_iter -> vari_bind_iter*}

                        1. (Let val_bind*{val_bind <- val_bind*} be $repeat_<val>(OPT ?(), |_vari*{_vari <- _vari*}|))

                          1. (Let C_res be $add_varis(C, vari_bind_iter*{vari_bind_iter <- vari_bind_iter*}, val_bind*{val_bind <- val_bind*}))

                            1. Result in: % |- % : OK C_res as premRes

      2. Group iterpr-list: C |- ITER premAL premIterAL as premAL : %

        1. (Let iter '<-' vari_bound*{vari_bound <- vari_bound*} '->' vari_bind*{vari_bind <- vari_bind*} be premIterAL)

          1. If (iter matches STAR), then

            1. If ((OK [] as subListRes = $sub_list(C, vari_bound*{vari_bound <- vari_bound*}))), then

              1. (Let vari_bind_iter be $iterate_vari(vari_bind, [STAR]))*{vari_bind <- vari_bind*, vari_bind_iter -> vari_bind_iter*}

                1. (Let val_bind*{val_bind <- val_bind*} be $repeat_<val>(LIST [], |vari_bind*{vari_bind <- vari_bind*}|))

                  1. (Let C_res be $add_varis(C, vari_bind_iter*{vari_bind_iter <- vari_bind_iter*}, val_bind*{val_bind <- val_bind*}))

                    1. Result in: % |- % : OK C_res as premRes

            2. (Let subListRes be $sub_list(C, vari_bound*{vari_bound <- vari_bound*}))

              1. If (subListRes <: ok<ctx*>), then

                1. (Let OK C_sub*{C_sub <- C_sub*} be subListRes as ok<ctx*>)

                  1. If (C_sub*{C_sub <- C_sub*} matches _ :: _), then

                    1. (Eval_prem_each: C_sub*{C_sub <- C_sub*} |- premAL : premIterRes)

                      1. Case analysis on premIterRes (total)

                        1. Case (% has type failure)

                          1. (Let failure be premIterRes as failure)

                            1. Result in: % |- % : failure as premRes

                        2. Case (% has type ok<ctx*>)

                          1. (Let OK C_sub_res*{C_sub_res <- C_sub_res*} be premIterRes as ok<ctx*>)

                            1. (Let val*{val <- val*}?{val* <- val*?} be $find_varis(C_sub_res, vari_bind*{vari_bind <- vari_bind*}))*{C_sub_res <- C_sub_res*, val*? -> val*?*}

                              1. If (val*{val <- val*}?{val* <- val*?} matches (_))*{val*? <- val*?*}, then

                                1. (Let ?(val_sub_bind*{val_sub_bind <- val_sub_bind*}) be val*{val <- val*}?{val* <- val*?})*{val*? <- val*?*, val_sub_bind* -> val_sub_bind**}

                                  1. (Let val_bind*{val_bind <- val_bind*}*{val_bind* <- val_bind**} be $transpose_<val>(val_sub_bind*{val_sub_bind <- val_sub_bind*}*{val_sub_bind* <- val_sub_bind**}))

                                    1. (Let val_res_bind be LIST val_bind*{val_bind <- val_bind*})*{val_bind* <- val_bind**, val_res_bind -> val_res_bind*}

                                      1. (Let vari_bind_iter be $iterate_vari(vari_bind, [STAR]))*{vari_bind <- vari_bind*, vari_bind_iter -> vari_bind_iter*}

                                        1. (Let C_res be $add_varis(C, vari_bind_iter*{vari_bind_iter <- vari_bind_iter*}, val_res_bind*{val_res_bind <- val_res_bind*}))

                                          1. Result in: % |- % : OK C_res as premRes

  7. Case (% has type debugPrem)

    1. (Let DEBUG typedExp be premAL' as debugPrem)

      1. Group dbg: C |- DEBUG typedExp as premAL : %

        1. (Eval_exp: C |- typedExp : expRes)

          1. Case analysis on expRes (total)

            1. Case (% has type failure)

              1. (Let failure be expRes as failure)

                1. Result in: % |- % : failure as premRes

            2. Case (% has type ok<val>)

              1. (Let OK val be expRes as ok<val>)

                1. Debug: val

                2. Result in: % |- % : OK C as premRes

2. Otherwise,

  1. Group error: C |- premAL' : %

    1. Result in: % |- % : ERROR as premRes

relation Eval_prems: C |- premAL*{premAL <- premAL*} : %

1. Group : C |- premAL*{premAL <- premAL*} : %

  1. Case analysis on premAL*{premAL <- premAL*} (total)

    1. Case (% matches pattern [])

      1. Result in: % |- % : OK C as premRes

    2. Case (% matches pattern _ :: _)

      1. (Let premAL_h :: premAL_t*{premAL_t <- premAL_t*} be premAL*{premAL <- premAL*})

        1. (Eval_prem: C |- premAL_h : premRes')

          1. Case analysis on premRes' (total)

            1. Case (% has type failure)

              1. (Let failure be premRes' as failure)

                1. Result in: % |- % : failure as premRes

            2. Case (% has type ok<ctx>)

              1. (Let OK C' be premRes' as ok<ctx>)

                1. (Eval_prems: C' |- premAL_t*{premAL_t <- premAL_t*} : premRes)

                  1. Result in: % |- % : premRes

syntax premOptRes =
   | OK ctx? (from ok<ctx?>)
   | ERROR (from error)
   | UNMATCH (from unmatch)

relation Eval_prem_maybe: C'?{C' <- C'?} |- premAL : %

1. Group : C'?{C' <- C'?} |- premAL : %

  1. Case analysis on C'?{C' <- C'?} (total)

    1. Case (% matches pattern ())

      1. Result in: % |- % : OK ?() as premOptRes

    2. Case (% matches pattern (_))

      1. (Let ?(C) be C'?{C' <- C'?})

        1. (Eval_prem: C |- premAL : premRes)

          1. Case analysis on premRes (total)

            1. Case (% has type failure)

              1. (Let failure be premRes as failure)

                1. Result in: % |- % : failure as premOptRes

            2. Case (% has type ok<ctx>)

              1. (Let OK C_res be premRes as ok<ctx>)

                1. Result in: % |- % : OK ?(C_res) as premOptRes

syntax premIterRes =
   | OK ctx* (from ok<ctx*>)
   | ERROR (from error)
   | UNMATCH (from unmatch)

relation Eval_prem_each: C*{C <- C*} |- premAL : %

1. Group : C*{C <- C*} |- premAL : %

  1. Case analysis on C*{C <- C*} (total)

    1. Case (% matches pattern [])

      1. Result in: % |- % : OK [] as premIterRes

    2. Case (% matches pattern _ :: _)

      1. (Let C_h :: C_t*{C_t <- C_t*} be C*{C <- C*})

        1. (Eval_prem: C_h |- premAL : premRes)

          1. Case analysis on premRes (total)

            1. Case (% has type failure)

              1. (Let failure be premRes as failure)

                1. Result in: % |- % : failure as premIterRes

            2. Case (% has type ok<ctx>)

              1. (Let OK C_res be premRes as ok<ctx>)

                1. (Eval_prem_each: C_t*{C_t <- C_t*} |- premAL : premIterRes)

                  1. Case analysis on premIterRes (total)

                    1. Case (% has type failure)

                      1. (Let failure be premIterRes as failure)

                        1. Result in: % |- % : failure as premIterRes

                    2. Case (% has type ok<ctx*>)

                      1. (Let OK C_t_res*{C_t_res <- C_t_res*} be premIterRes as ok<ctx*>)

                        1. Result in: % |- % : OK C_res :: C_t_res*{C_t_res <- C_t_res*} as premIterRes

relation Call_func: C |- id `< typ*{typ <- typ*} `> `( val*{val <- val*} `) : %

1. Group : C |- id `< typ*{typ <- typ*} `> `( val*{val <- val*} `) : %

  1. (Let id_global be $resolve_func_param(C, id))

    1. (Let funcDefnAL'?{funcDefnAL' <- funcDefnAL'?} be $find_func(C, id_global))

      1. If (funcDefnAL'?{funcDefnAL' <- funcDefnAL'?} matches (_)), then

        1. (Let ?(funcDefnAL) be funcDefnAL'?{funcDefnAL' <- funcDefnAL'?})

          1. Case analysis on funcDefnAL

            1. Case (% has type externFuncDefn)

              1. (Let EXTFUNC id_func _tparam*{_tparam <- _tparam*} _param*{_param <- _param*} ':' _typ be funcDefnAL as externFuncDefn)

                1. (Call_extern_func: |- id_func `< typ*{typ <- typ*} `> `( val*{val <- val*} `) : funcRes)

                  1. Result in: % |- % `< % `> `( % `) : funcRes

            2. Case (% has type builtinFuncDefn)

              1. (Let BUILTINFUNC id_func _tparam*{_tparam <- _tparam*} _param*{_param <- _param*} ':' _typ be funcDefnAL as builtinFuncDefn)

                1. (Call_builtin_func: |- id_func `< typ*{typ <- typ*} `> `( val*{val <- val*} `) : funcRes)

                  1. Result in: % |- % `< % `> `( % `) : funcRes

  2. If (typ*{typ <- typ*} matches []), then

    1. (Let id_global be $resolve_func_param(C, id))

      1. (Let funcDefnAL'?{funcDefnAL' <- funcDefnAL'?} be $find_func(C, id_global))

        1. If (funcDefnAL'?{funcDefnAL' <- funcDefnAL'?} matches (_)), then

          1. (Let ?(funcDefnAL) be funcDefnAL'?{funcDefnAL' <- funcDefnAL'?})

            1. If (funcDefnAL <: tableFuncDefnAL), then

              1. (Let tableFuncDefnAL be funcDefnAL as tableFuncDefnAL)

                1. (Call_table_func: C |- tableFuncDefnAL `( val*{val <- val*} `) : funcRes)

                  1. Result in: % |- % `< % `> `( % `) : funcRes

  3. (Let id_global be $resolve_func_param(C, id))

    1. (Let funcDefnAL'?{funcDefnAL' <- funcDefnAL'?} be $find_func(C, id_global))

      1. If (funcDefnAL'?{funcDefnAL' <- funcDefnAL'?} matches (_)), then

        1. (Let ?(funcDefnAL) be funcDefnAL'?{funcDefnAL' <- funcDefnAL'?})

          1. If (funcDefnAL <: definedFuncDefnAL), then

            1. (Let definedFuncDefnAL be funcDefnAL as definedFuncDefnAL)

              1. (Call_defined_func: C |- definedFuncDefnAL `< typ*{typ <- typ*} `> `( val*{val <- val*} `) : funcRes)

                1. Result in: % |- % `< % `> `( % `) : funcRes

2. Otherwise,

  1. Group error: C |- id `< typ*{typ <- typ*} `> `( val*{val <- val*} `) : %

    1. Result in: % |- % `< % `> `( % `) : ERROR as funcRes

relation Call_rel: C |- id `( val*{val <- val*} `) : %

1. Group : C |- id `( val*{val <- val*} `) : %

  1. (Let relDefnAL'?{relDefnAL' <- relDefnAL'?} be $find_rel(C, id))

    1. If (relDefnAL'?{relDefnAL' <- relDefnAL'?} matches (_)), then

      1. (Let ?(relDefnAL) be relDefnAL'?{relDefnAL' <- relDefnAL'?})

        1. Case analysis on relDefnAL (total)

          1. Case (% has type externRelDefnAL)

            1. (Let EXTREL id_rel ':' _typ*{_typ <- _typ*} '->' _typ'*{_typ' <- _typ'*} be relDefnAL as externRelDefnAL)

              1. (Call_extern_rel: |- id_rel `( val*{val <- val*} `) : relRes)

                1. Result in: % |- % `( % `) : relRes

          2. Case (% has type definedRelDefnAL)

            1. (Let definedRelDefnAL be relDefnAL as definedRelDefnAL)

              1. (Call_defined_rel: C |- definedRelDefnAL `( val*{val <- val*} `) : relRes)

                1. Result in: % |- % `( % `) : relRes

2. Otherwise,

  1. Group error: C |- id `( val*{val <- val*} `) : %

    1. Result in: % |- % `( % `) : ERROR as relRes

def $numUnop(numUnop, num)

1. Case analysis on numUnop (total)

  1. Case (% matches pattern PLUS)

    1. Case analysis on num (total)

      1. Case (% matches pattern NAT %)

        1. (Let NAT n be num)

          1. Return NAT n as val

      2. Case (% matches pattern INT %)

        1. (Let INT i be num)

          1. Return INT i as val

  2. Case (% matches pattern MINUS)

    1. Case analysis on num (total)

      1. Case (% matches pattern NAT %)

        1. (Let NAT n be num)

          1. Return INT -n as int as val

      2. Case (% matches pattern INT %)

        1. (Let INT i be num)

          1. Return INT -i as val

def $boolBinop(boolBinop, b_l, b_r)

1. Case analysis on boolBinop (total)

  1. Case (% matches pattern AND)

    1. Return (b_l /\ b_r)

  2. Case (% matches pattern OR)

    1. Return (b_l \/ b_r)

  3. Case (% matches pattern IMPL)

    1. Return (b_l => b_r)

  4. Case (% matches pattern EQUIV)

    1. Return (b_l <=> b_r)

syntax numBinopRes =
   | OK val (from ok<val>)
   | ERROR (from error)

def $numBinop(numBinop, num, num')

1. Case analysis on numBinop

  1. Case (% matches pattern ADD)

    1. Case analysis on num (total)

      1. Case (% matches pattern NAT %)

        1. (Let NAT n_l be num)

          1. If (num' matches NAT %), then

            1. (Let NAT n_r be num')

              1. Return OK NAT (n_l + n_r) as val as numBinopRes

      2. Case (% matches pattern INT %)

        1. (Let INT i_l be num)

          1. If (num' matches INT %), then

            1. (Let INT i_r be num')

              1. Return OK INT (i_l + i_r) as val as numBinopRes

  2. Case (% matches pattern SUB)

    1. Case analysis on num (total)

      1. Case (% matches pattern NAT %)

        1. (Let NAT n_l be num)

          1. If (num' matches NAT %), then

            1. (Let NAT n_r be num')

              1. Return OK INT (n_l - n_r) as val as numBinopRes

      2. Case (% matches pattern INT %)

        1. (Let INT i_l be num)

          1. If (num' matches INT %), then

            1. (Let INT i_r be num')

              1. Return OK INT (i_l - i_r) as val as numBinopRes

  3. Case (% matches pattern MUL)

    1. Case analysis on num (total)

      1. Case (% matches pattern NAT %)

        1. (Let NAT n_l be num)

          1. If (num' matches NAT %), then

            1. (Let NAT n_r be num')

              1. Return OK NAT (n_l * n_r) as val as numBinopRes

      2. Case (% matches pattern INT %)

        1. (Let INT i_l be num)

          1. If (num' matches INT %), then

            1. (Let INT i_r be num')

              1. Return OK INT (i_l * i_r) as val as numBinopRes

  4. Case (% matches pattern DIV)

    1. Case analysis on num (total)

      1. Case (% matches pattern NAT %)

        1. (Let NAT n_l be num)

          1. If (num' matches NAT %), then

            1. (Let NAT n_r be num')

              1. If ((n_r =/= 0)), then

                1. Return OK NAT (n_l / n_r) as val as numBinopRes

      2. Case (% matches pattern INT %)

        1. (Let INT i_l be num)

          1. If (num' matches INT %), then

            1. (Let INT i_r be num')

              1. If ((i_r =/= +0)), then

                1. Return OK INT (i_l / i_r) as val as numBinopRes

  5. Case (% matches pattern MOD)

    1. Case analysis on num (total)

      1. Case (% matches pattern NAT %)

        1. (Let NAT n_l be num)

          1. If (num' matches NAT %), then

            1. (Let NAT n_r be num')

              1. If ((n_r =/= 0)), then

                1. Return OK NAT (n_l \ n_r) as val as numBinopRes

      2. Case (% matches pattern INT %)

        1. (Let INT i_l be num)

          1. If (num' matches INT %), then

            1. (Let INT i_r be num')

              1. If ((i_r =/= +0)), then

                1. Return OK INT (i_l \ i_r) as val as numBinopRes

2. Otherwise,

  1. Return ERROR as numBinopRes

def $polyCmpop(polyCmpop, val_l, val_r)

1. Case analysis on polyCmpop (total)

  1. Case (% matches pattern EQ)

    1. Return (val_l = val_r)

  2. Case (% matches pattern NE)

    1. Return (val_l =/= val_r)

syntax numCmpRes =
   | OK bool (from ok<bool>)
   | ERROR (from error)

def $numCmpop(numCmpop, num, num')

1. Case analysis on numCmpop (total)

  1. Case (% matches pattern LT)

    1. Case analysis on num (total)

      1. Case (% matches pattern NAT %)

        1. (Let NAT n_l be num)

          1. If (num' matches NAT %), then

            1. (Let NAT n_r be num')

              1. Return OK (n_l < n_r) as numCmpRes

      2. Case (% matches pattern INT %)

        1. (Let INT i_l be num)

          1. If (num' matches INT %), then

            1. (Let INT i_r be num')

              1. Return OK (i_l < i_r) as numCmpRes

  2. Case (% matches pattern GT)

    1. Case analysis on num (total)

      1. Case (% matches pattern NAT %)

        1. (Let NAT n_l be num)

          1. If (num' matches NAT %), then

            1. (Let NAT n_r be num')

              1. Return OK (n_l > n_r) as numCmpRes

      2. Case (% matches pattern INT %)

        1. (Let INT i_l be num)

          1. If (num' matches INT %), then

            1. (Let INT i_r be num')

              1. Return OK (i_l > i_r) as numCmpRes

  3. Case (% matches pattern LE)

    1. Case analysis on num (total)

      1. Case (% matches pattern NAT %)

        1. (Let NAT n_l be num)

          1. If (num' matches NAT %), then

            1. (Let NAT n_r be num')

              1. Return OK (n_l <= n_r) as numCmpRes

      2. Case (% matches pattern INT %)

        1. (Let INT i_l be num)

          1. If (num' matches INT %), then

            1. (Let INT i_r be num')

              1. Return OK (i_l <= i_r) as numCmpRes

  4. Case (% matches pattern GE)

    1. Case analysis on num (total)

      1. Case (% matches pattern NAT %)

        1. (Let NAT n_l be num)

          1. If (num' matches NAT %), then

            1. (Let NAT n_r be num')

              1. Return OK (n_l >= n_r) as numCmpRes

      2. Case (% matches pattern INT %)

        1. (Let INT i_l be num)

          1. If (num' matches INT %), then

            1. (Let INT i_r be num')

              1. Return OK (i_l >= i_r) as numCmpRes

2. Otherwise,

  1. Return ERROR as numCmpRes

def $matches(val', pat)

1. Case analysis on val'

  1. Case (% matches pattern INJ %)

    1. (Let INJ mixop_v val*{val <- val*} be val')

      1. If (pat matches INJ %), then

        1. (Let INJ mixop_p be pat)

          1. Return (mixop_v = mixop_p)

  2. Case (% matches pattern LIST %)

    1. (Let LIST val*{val <- val*} be val')

      1. If (pat <: listPat), then

        1. (Let listPat be pat as listPat)

          1. Case analysis on listPat (total)

            1. Case (% matches pattern CONS)

              1. Return (|val*{val <- val*}| > 0)

            2. Case (% matches pattern FIXED %)

              1. (Let FIXED n be listPat)

                1. Return (|val*{val <- val*}| = n)

            3. Case (% matches pattern NIL)

              1. Return (|val*{val <- val*}| = 0)

  3. Case (% matches pattern OPT %)

    1. (Let OPT val?{val <- val?} be val')

      1. If (pat <: optPat), then

        1. (Let optPat be pat as optPat)

          1. Case analysis on optPat (total)

            1. Case (% matches pattern SOME)

              1. Return (val?{val <- val?} =/= ?())

            2. Case (% matches pattern NONE)

              1. Return (val?{val <- val?} = ?())

2. Otherwise,

  1. Return false

syntax subtypRes =
   | OK bool (from ok<bool>)
   | ERROR (from error)

def $subtyp(fenv, tdenv, typ', val'')

1. Case analysis on typ' (total)

  1. Case (% has type optyp)

    1. (Let optyp be typ' as optyp)

      1. Case analysis on optyp

        1. Case (% matches pattern BOOL)

          1. If (val'' matches BOOL %), then

            1. Return OK true as subtypRes

        2. Case (% matches pattern TEXT)

          1. If (val'' matches TEXT %), then

            1. Return OK true as subtypRes

  2. Case (% matches pattern VAR % %)

    1. (Let VAR id targ*{targ <- targ*} be typ')

      1. Return $subtyp_var(fenv, tdenv, id, targ*{targ <- targ*}, val'')

  3. Case (% matches pattern TUP %)

    1. (Let TUP typ*{typ <- typ*} be typ')

      1. If (val'' matches TUP %), then

        1. (Let TUP val*{val <- val*} be val'')

          1. Return $subtyps(fenv, tdenv, typ*{typ <- typ*}, val*{val <- val*})

  4. Case (% matches pattern ITER % %)

    1. (Let ITER typ iter be typ')

      1. Case analysis on iter (total)

        1. Case (% matches pattern QUEST)

          1. If (val'' matches OPT %), then

            1. (Let OPT val'?{val' <- val'?} be val'')

              1. If (val'?{val' <- val'?} matches (_)), then

                1. (Let ?(val) be val'?{val' <- val'?})

                  1. Return $subtyp(fenv, tdenv, typ, val)

          2. If ((val'' = OPT ?())), then

            1. Return OK true as subtypRes

        2. Case (% matches pattern STAR)

          1. If (val'' matches LIST %), then

            1. (Let LIST val*{val <- val*} be val'')

              1. Return $subtyp_list(fenv, tdenv, typ, val*{val <- val*})

  5. Case (% matches pattern FUNC % % %)

    1. (Let FUNC tparam*{tparam <- tparam*} typ*{typ <- typ*} typ_ret be typ')

      1. If (val'' matches FUNC %), then

        1. (Let FUNC id be val'')

          1. Return $subtyp_func(fenv, tdenv, FUNC tparam*{tparam <- tparam*} typ*{typ <- typ*} typ_ret, id)

2. If (typ' <: numtyp), then

  1. (Let numtyp be typ' as numtyp)

    1. Case analysis on numtyp (total)

      1. Case (% matches pattern NAT)

        1. If (val'' <: num), then

          1. (Let num be val'' as num)

            1. Case analysis on num (total)

              1. Case (% matches pattern NAT %)

                1. Return OK true as subtypRes

              2. Case (% matches pattern INT %)

                1. (Let INT i be num)

                  1. Return OK (i >= 0 as int) as subtypRes

      2. Case (% matches pattern INT)

        1. If (val'' <: num), then

          1. Return OK true as subtypRes

3. Otherwise,

  1. Return OK false as subtypRes

def $subtyp_var(fenv, tdenv, id, targ*{targ <- targ*}, val)

1. (Let typDef'?{typDef' <- typDef'?} be $find_map<id, typDef>(tdenv, id))

  1. If (typDef'?{typDef' <- typDef'?} matches (_)), then

    1. (Let ?(typDef) be typDef'?{typDef' <- typDef'?})

      1. Return $subtyp_def(fenv, tdenv, typDef, targ*{targ <- targ*}, val)

2. Otherwise,

  1. Return ERROR as subtypRes

def $subtyp_def(fenv, tdenv, typDef, typ'*{typ' <- typ'*}, val)

1. Case analysis on typDef

  1. Case (% has type externTypDefn)

    1. If (typ'*{typ' <- typ'*} matches []), then

      1. Return $subtyp_extern(val)

  2. Case (% has type definedTypDefn)

    1. (Let TYP _id tparam*{tparam <- tparam*} '=' deftyp be typDef as definedTypDefn)

      1. Case analysis on deftyp (total)

        1. Case (% matches pattern ALIAS %)

          1. (Let ALIAS typ be deftyp)

            1. If ((|typ'*{typ' <- typ'*}| = |tparam*{tparam <- tparam*}|)), then

              1. (Let theta be `{ tparam ':' typ'*{typ' <- typ'*, tparam <- tparam*} `})

                1. (Let typRes be $subst_typ(theta, typ))

                  1. If (typRes <: ok<typ>), then

                    1. (Let OK typ_subst be typRes as ok<typ>)

                      1. Return $subtyp(fenv, tdenv, typ_subst, val)

        2. Case (% matches pattern VARIANT %)

          1. (Let VARIANT typCase*{typCase <- typCase*} be deftyp)

            1. If ((|typ'*{typ' <- typ'*}| = |tparam*{tparam <- tparam*}|)), then

              1. (Let theta be `{ tparam ':' typ'*{typ' <- typ'*, tparam <- tparam*} `})

                1. Return $subtyp_variant(fenv, tdenv, theta, typCase*{typCase <- typCase*}, val)

        3. Case (% matches pattern STRUCT %)

          1. (Let STRUCT typField*{typField <- typField*} be deftyp)

            1. If ((|typ'*{typ' <- typ'*}| = |tparam*{tparam <- tparam*}|)), then

              1. (Let theta be `{ tparam ':' typ'*{typ' <- typ'*, tparam <- tparam*} `})

                1. Return $subtyp_struct(fenv, tdenv, theta, typField*{typField <- typField*}, val)

2. Otherwise,

  1. Return ERROR as subtypRes

def $subtyp_extern(val)

1. If (val matches EXT %), then

  1. Return OK true as subtypRes

2. Otherwise,

  1. Return OK false as subtypRes

def $subtyp_variant(fenv, tdenv, theta, typCase*{typCase <- typCase*}, val')

1. If (val' matches INJ %), then

  1. (Let INJ mixop val*{val <- val*} be val')

    1. (Let mixop_case typ_case*{typ_case <- typ_case*} be typCase)*{typCase <- typCase*, mixop_case -> mixop_case*, typ_case* -> typ_case**}

      1. (Let typ*{typ <- typ*}?{typ* <- typ*?} be $assoc_<mixop, typ*>(mixop, (mixop_case, typ_case*{typ_case <- typ_case*})*{mixop_case <- mixop_case*, typ_case* <- typ_case**}))

        1. If (typ*{typ <- typ*}?{typ* <- typ*?} matches (_)), then

          1. (Let ?(typ_case_found*{typ_case_found <- typ_case_found*}) be typ*{typ <- typ*}?{typ* <- typ*?})

            1. Return $subtyp_case(fenv, tdenv, theta, typ_case_found*{typ_case_found <- typ_case_found*}, val*{val <- val*})

2. Otherwise,

  1. Return OK false as subtypRes

def $subtyp_struct(fenv, tdenv, theta, typField*{typField <- typField*}, val)

1. If (val matches STR %), then

  1. (Let STR valField*{valField <- valField*} be val)

    1. (Let atom typ_field be typField)*{typField <- typField*, atom -> atom*, typ_field -> typ_field*}

      1. (Let atom' val_field be valField)*{valField <- valField*, atom' -> atom'*, val_field -> val_field*}

        1. If ((|atom*{atom <- atom*}| = |atom'*{atom' <- atom'*}|)), then

          1. If ((atom' = atom))*{atom <- atom*, atom' <- atom'*}, then

            1. Return $subtyp_case(fenv, tdenv, theta, typ_field*{typ_field <- typ_field*}, val_field*{val_field <- val_field*})

2. Otherwise,

  1. Return OK false as subtypRes

def $subtyp_case(fenv, tdenv, theta, typ*{typ <- typ*}, val*{val <- val*})

1. (Let typsRes be $subst_typs(theta, typ*{typ <- typ*}))

  1. If (typsRes <: ok<typ*>), then

    1. (Let OK typ_subst*{typ_subst <- typ_subst*} be typsRes as ok<typ*>)

      1. Return $subtyps(fenv, tdenv, typ_subst*{typ_subst <- typ_subst*}, val*{val <- val*})

2. Otherwise,

  1. Return ERROR as subtypRes

def $subtyps(fenv, tdenv, typ*{typ <- typ*}, val*{val <- val*})

1. Case analysis on typ*{typ <- typ*} (total)

  1. Case (% matches pattern [])

    1. Case analysis on val*{val <- val*} (total)

      1. Case (% matches pattern [])

        1. Return OK true as subtypRes

      2. Case (% matches pattern _ :: _)

        1. Return OK false as subtypRes

  2. Case (% matches pattern _ :: _)

    1. (Let typ_h :: typ_t*{typ_t <- typ_t*} be typ*{typ <- typ*})

      1. Case analysis on val*{val <- val*} (total)

        1. Case (% matches pattern _ :: _)

          1. (Let val_h :: val_t*{val_t <- val_t*} be val*{val <- val*})

            1. If ((OK true as subtypRes = $subtyp(fenv, tdenv, typ_h, val_h))), then

              1. Return $subtyps(fenv, tdenv, typ_t*{typ_t <- typ_t*}, val_t*{val_t <- val_t*})

            1. Else Dangling

            2. (Let subtypRes be $subtyp(fenv, tdenv, typ_h, val_h))

              1. If ((subtypRes =/= OK true as subtypRes)), then

                1. Return subtypRes

              1. Else Dangling

        2. Case (% matches pattern [])

          1. Return OK false as subtypRes

def $subtyp_list(fenv, tdenv, typ, val*{val <- val*})

1. Case analysis on val*{val <- val*} (total)

  1. Case (% matches pattern [])

    1. Return OK true as subtypRes

  2. Case (% matches pattern _ :: _)

    1. (Let val_h :: val_t*{val_t <- val_t*} be val*{val <- val*})

      1. If ((OK true as subtypRes = $subtyp(fenv, tdenv, typ, val_h))), then

        1. Return $subtyp_list(fenv, tdenv, typ, val_t*{val_t <- val_t*})

      1. Else Dangling

      2. (Let subtypRes be $subtyp(fenv, tdenv, typ, val_h))

        1. If ((subtypRes =/= OK true as subtypRes)), then

          1. Return subtypRes

        1. Else Dangling

def $subtyp_func(fenv, tdenv, typ, id)

1. (Let funcDefnAL'?{funcDefnAL' <- funcDefnAL'?} be $find_map<id, funcDefnAL>(fenv, id))

  1. If (funcDefnAL'?{funcDefnAL' <- funcDefnAL'?} matches (_)), then

    1. (Let ?(funcDefnAL) be funcDefnAL'?{funcDefnAL' <- funcDefnAL'?})

      1. Return $equiv_func_typ(tdenv, typ, $func_typ(funcDefnAL)) as subtypRes

2. Otherwise,

  1. Return ERROR as subtypRes

def $param_typ(param')

1. Case analysis on param' (total)

  1. Case (% matches pattern EXP %)

    1. (Let EXP typ be param')

      1. Return typ

  2. Case (% matches pattern FUN % ':' % % '->' %)

    1. (Let FUN id ':' tparam*{tparam <- tparam*} param*{param <- param*} '->' typ be param')

      1. Return FUNC tparam*{tparam <- tparam*} $param_typ(param)*{param <- param*} typ

def $func_typ(funcDefnAL)

1. Case analysis on funcDefnAL (total)

  1. Case (% has type externFuncDefn)

    1. (Let EXTFUNC id tparam*{tparam <- tparam*} param*{param <- param*} ':' typ be funcDefnAL as externFuncDefn)

      1. Return FUNC tparam*{tparam <- tparam*} $param_typ(param)*{param <- param*} typ

  2. Case (% has type builtinFuncDefn)

    1. (Let BUILTINFUNC id tparam*{tparam <- tparam*} param*{param <- param*} ':' typ be funcDefnAL as builtinFuncDefn)

      1. Return FUNC tparam*{tparam <- tparam*} $param_typ(param)*{param <- param*} typ

  3. Case (% has type tableFuncDefnAL)

    1. (Let TABLEFUNC _id param*{param <- param*} ':' typ '=' tblRowAL*{tblRowAL <- tblRowAL*} be funcDefnAL as tableFuncDefnAL)

      1. Return FUNC [] $param_typ(param)*{param <- param*} typ

  4. Case (% has type definedFuncDefnAL)

    1. (Let FUNC _id tparam*{tparam <- tparam*} param*{param <- param*} ':' typ '=' clauseAL*{clauseAL <- clauseAL*} elsClauseAL?{elsClauseAL <- elsClauseAL?} be funcDefnAL as definedFuncDefnAL)

      1. Return FUNC tparam*{tparam <- tparam*} $param_typ(param)*{param <- param*} typ

syntax castRes =
   | OK val (from ok<val>)
   | ERROR (from error)

syntax castsRes =
   | OK val* (from ok<val*>)
   | ERROR (from error)

def $upcast(C, typ', val'')

1. Case analysis on typ'

  1. Case (% has type numtyp)

    1. (Let numtyp be typ' as numtyp)

      1. Case analysis on numtyp (total)

        1. Case (% matches pattern INT)

          1. If (val'' <: num), then

            1. (Let num be val'' as num)

              1. Case analysis on num (total)

                1. Case (% matches pattern INT %)

                  1. (Let INT i be num)

                    1. Return OK INT i as val as castRes

                2. Case (% matches pattern NAT %)

                  1. (Let NAT n be num)

                    1. Return OK INT n as int as val as castRes

        2. Case (% matches pattern NAT)

          1. If (val'' <: num), then

            1. (Let num be val'' as num)

              1. If (num matches NAT %), then

                1. (Let NAT n be num)

                  1. Return OK NAT n as val as castRes

  2. Case (% matches pattern VAR % %)

    1. (Let VAR id targ*{targ <- targ*} be typ')

      1. (Let typDef'?{typDef' <- typDef'?} be $find_typ(C, id))

        1. If (typDef'?{typDef' <- typDef'?} matches (_)), then

          1. (Let ?(typDef) be typDef'?{typDef' <- typDef'?})

            1. If (typDef <: definedTypDefn), then

              1. (Let TYP _id tparam*{tparam <- tparam*} '=' deftyp be typDef as definedTypDefn)

                1. Case analysis on deftyp (total)

                  1. Case (% matches pattern ALIAS %)

                    1. (Let ALIAS typ be deftyp)

                      1. If ((|targ*{targ <- targ*}| = |tparam*{tparam <- tparam*}|)), then

                        1. (Let theta be `{ tparam ':' targ*{targ <- targ*, tparam <- tparam*} `})

                          1. (Let typRes be $subst_typ(theta, typ))

                            1. If (typRes <: ok<typ>), then

                              1. (Let OK typ_subst be typRes as ok<typ>)

                                1. Return $upcast(C, typ_subst, val'')

                  2. Case (% matches pattern VARIANT %)

                    1. (Let `{ id_local ':' typDef_local*{id_local <- id_local*, typDef_local <- typDef_local*} `} be C.LOCAL.TYP)

                      1. (Let tdenv be $adds_map<id, typDef>(C.GLOBAL.TYP, id_local*{id_local <- id_local*}, typDef_local*{typDef_local <- typDef_local*}))

                        1. If ((OK true as subtypRes = $subtyp(C.GLOBAL.FUNC, tdenv, VAR id targ*{targ <- targ*}, val''))), then

                          1. Return OK val'' as castRes

                  3. Case (% matches pattern STRUCT %)

                    1. (Let `{ id_local ':' typDef_local*{id_local <- id_local*, typDef_local <- typDef_local*} `} be C.LOCAL.TYP)

                      1. (Let tdenv be $adds_map<id, typDef>(C.GLOBAL.TYP, id_local*{id_local <- id_local*}, typDef_local*{typDef_local <- typDef_local*}))

                        1. If ((OK true as subtypRes = $subtyp(C.GLOBAL.FUNC, tdenv, VAR id targ*{targ <- targ*}, val''))), then

                          1. Return OK val'' as castRes

      2. If (targ*{targ <- targ*} matches []), then

        1. If (val'' matches EXT %), then

          1. (Let EXT json be val'')

            1. (Let typDef'?{typDef' <- typDef'?} be $find_typ(C, id))

              1. If (typDef'?{typDef' <- typDef'?} matches (_)), then

                1. (Let ?(typDef) be typDef'?{typDef' <- typDef'?})

                  1. If (typDef <: externTypDefn), then

                    1. Return OK EXT json as castRes

  3. Case (% matches pattern TUP %)

    1. (Let TUP typ*{typ <- typ*} be typ')

      1. If (val'' matches TUP %), then

        1. (Let TUP val*{val <- val*} be val'')

          1. (Let castsRes be $upcasts(C, typ*{typ <- typ*}, val*{val <- val*}))

            1. If (castsRes <: ok<val*>), then

              1. (Let OK val_cast*{val_cast <- val_cast*} be castsRes as ok<val*>)

                1. Return OK TUP val_cast*{val_cast <- val_cast*} as castRes

  4. Case (% matches pattern ITER % %)

    1. (Let ITER typ iter be typ')

      1. Case analysis on iter (total)

        1. Case (% matches pattern QUEST)

          1. If ((val'' = OPT ?())), then

            1. Return OK OPT ?() as castRes

          2. If (val'' matches OPT %), then

            1. (Let OPT val'?{val' <- val'?} be val'')

              1. If (val'?{val' <- val'?} matches (_)), then

                1. (Let ?(val) be val'?{val' <- val'?})

                  1. (Let castRes be $upcast(C, typ, val))

                    1. If (castRes <: ok<val>), then

                      1. (Let OK val_cast be castRes as ok<val>)

                        1. Return OK OPT ?(val_cast) as castRes

        2. Case (% matches pattern STAR)

          1. If (val'' matches LIST %), then

            1. (Let LIST val*{val <- val*} be val'')

              1. (Let castsRes be $upcasts(C, $repeat_<typ>(typ, |val*{val <- val*}|), val*{val <- val*}))

                1. If (castsRes <: ok<val*>), then

                  1. (Let OK val_cast*{val_cast <- val_cast*} be castsRes as ok<val*>)

                    1. Return OK LIST val_cast*{val_cast <- val_cast*} as castRes

  5. Case (% matches pattern FUNC % % %)

    1. (Let FUNC tparam*{tparam <- tparam*} typ*{typ <- typ*} typ_ret be typ')

      1. If (val'' matches FUNC %), then

        1. (Let FUNC id be val'')

          1. (Let `{ id_local ':' typDef_local*{id_local <- id_local*, typDef_local <- typDef_local*} `} be C.LOCAL.TYP)

            1. (Let tdenv be $adds_map<id, typDef>(C.GLOBAL.TYP, id_local*{id_local <- id_local*}, typDef_local*{typDef_local <- typDef_local*}))

              1. If ((OK true as subtypRes = $subtyp(C.GLOBAL.FUNC, tdenv, FUNC tparam*{tparam <- tparam*} typ*{typ <- typ*} typ_ret, FUNC id))), then

                1. Return OK FUNC id as castRes

2. If (typ' <: optyp), then

  1. (Let optyp be typ' as optyp)

    1. Case analysis on optyp

      1. Case (% matches pattern BOOL)

        1. If (val'' matches BOOL %), then

          1. (Let BOOL b be val'')

            1. Return OK BOOL b as castRes

      2. Case (% matches pattern TEXT)

        1. If (val'' matches TEXT %), then

          1. (Let TEXT t be val'')

            1. Return OK TEXT t as castRes

3. Otherwise,

  1. Return ERROR as castRes

def $upcasts(C, typ*{typ <- typ*}, val*{val <- val*})

1. Case analysis on typ*{typ <- typ*} (total)

  1. Case (% matches pattern [])

    1. If (val*{val <- val*} matches []), then

      1. Return OK [] as castsRes

  2. Case (% matches pattern _ :: _)

    1. (Let typ_h :: typ_t*{typ_t <- typ_t*} be typ*{typ <- typ*})

      1. If (val*{val <- val*} matches _ :: _), then

        1. (Let val_h :: val_t*{val_t <- val_t*} be val*{val <- val*})

          1. (Let castRes be $upcast(C, typ_h, val_h))

            1. If (castRes <: ok<val>), then

              1. (Let OK val_cast be castRes as ok<val>)

                1. (Let castsRes be $upcasts(C, typ_t*{typ_t <- typ_t*}, val_t*{val_t <- val_t*}))

                  1. If (castsRes <: ok<val*>), then

                    1. (Let OK val_t_cast*{val_t_cast <- val_t_cast*} be castsRes as ok<val*>)

                      1. Return OK val_cast :: val_t_cast*{val_t_cast <- val_t_cast*} as castsRes

2. Otherwise,

  1. Return ERROR as castsRes

def $downcast(C, typ', val'')

1. Case analysis on typ'

  1. Case (% has type numtyp)

    1. (Let numtyp be typ' as numtyp)

      1. Case analysis on numtyp (total)

        1. Case (% matches pattern NAT)

          1. If (val'' <: num), then

            1. (Let num be val'' as num)

              1. Case analysis on num (total)

                1. Case (% matches pattern NAT %)

                  1. (Let NAT n be num)

                    1. Return OK NAT n as val as castRes

                2. Case (% matches pattern INT %)

                  1. (Let INT i be num)

                    1. If (i <: nat), then

                      1. (Let n be i as nat)

                        1. Return OK NAT n as val as castRes

        2. Case (% matches pattern INT)

          1. If (val'' <: num), then

            1. (Let num be val'' as num)

              1. Return OK num as val as castRes

  2. Case (% matches pattern VAR % %)

    1. (Let VAR id targ*{targ <- targ*} be typ')

      1. (Let typDef'?{typDef' <- typDef'?} be $find_typ(C, id))

        1. If (typDef'?{typDef' <- typDef'?} matches (_)), then

          1. (Let ?(typDef) be typDef'?{typDef' <- typDef'?})

            1. If (typDef <: definedTypDefn), then

              1. (Let TYP _id tparam*{tparam <- tparam*} '=' deftyp be typDef as definedTypDefn)

                1. Case analysis on deftyp (total)

                  1. Case (% matches pattern ALIAS %)

                    1. (Let ALIAS typ be deftyp)

                      1. If ((|targ*{targ <- targ*}| = |tparam*{tparam <- tparam*}|)), then

                        1. (Let theta be `{ tparam ':' targ*{targ <- targ*, tparam <- tparam*} `})

                          1. (Let typRes be $subst_typ(theta, typ))

                            1. If (typRes <: ok<typ>), then

                              1. (Let OK typ_subst be typRes as ok<typ>)

                                1. Return $downcast(C, typ_subst, val'')

                  2. Case (% matches pattern VARIANT %)

                    1. (Let `{ id_local ':' typDef_local*{id_local <- id_local*, typDef_local <- typDef_local*} `} be C.LOCAL.TYP)

                      1. (Let tdenv be $adds_map<id, typDef>(C.GLOBAL.TYP, id_local*{id_local <- id_local*}, typDef_local*{typDef_local <- typDef_local*}))

                        1. If ((OK true as subtypRes = $subtyp(C.GLOBAL.FUNC, tdenv, VAR id targ*{targ <- targ*}, val''))), then

                          1. Return OK val'' as castRes

                  3. Case (% matches pattern STRUCT %)

                    1. (Let `{ id_local ':' typDef_local*{id_local <- id_local*, typDef_local <- typDef_local*} `} be C.LOCAL.TYP)

                      1. (Let tdenv be $adds_map<id, typDef>(C.GLOBAL.TYP, id_local*{id_local <- id_local*}, typDef_local*{typDef_local <- typDef_local*}))

                        1. If ((OK true as subtypRes = $subtyp(C.GLOBAL.FUNC, tdenv, VAR id targ*{targ <- targ*}, val''))), then

                          1. Return OK val'' as castRes

      2. If (targ*{targ <- targ*} matches []), then

        1. If (val'' matches EXT %), then

          1. (Let EXT json be val'')

            1. (Let typDef'?{typDef' <- typDef'?} be $find_typ(C, id))

              1. If (typDef'?{typDef' <- typDef'?} matches (_)), then

                1. (Let ?(typDef) be typDef'?{typDef' <- typDef'?})

                  1. If (typDef <: externTypDefn), then

                    1. Return OK EXT json as castRes

  3. Case (% matches pattern TUP %)

    1. (Let TUP typ*{typ <- typ*} be typ')

      1. If (val'' matches TUP %), then

        1. (Let TUP val*{val <- val*} be val'')

          1. (Let castsRes be $downcasts(C, typ*{typ <- typ*}, val*{val <- val*}))

            1. If (castsRes <: ok<val*>), then

              1. (Let OK val_cast*{val_cast <- val_cast*} be castsRes as ok<val*>)

                1. Return OK TUP val_cast*{val_cast <- val_cast*} as castRes

  4. Case (% matches pattern ITER % %)

    1. (Let ITER typ iter be typ')

      1. Case analysis on iter (total)

        1. Case (% matches pattern QUEST)

          1. If ((val'' = OPT ?())), then

            1. Return OK OPT ?() as castRes

          2. If (val'' matches OPT %), then

            1. (Let OPT val'?{val' <- val'?} be val'')

              1. If (val'?{val' <- val'?} matches (_)), then

                1. (Let ?(val) be val'?{val' <- val'?})

                  1. (Let castRes be $downcast(C, typ, val))

                    1. If (castRes <: ok<val>), then

                      1. (Let OK val_cast be castRes as ok<val>)

                        1. Return OK OPT ?(val_cast) as castRes

        2. Case (% matches pattern STAR)

          1. If (val'' matches LIST %), then

            1. (Let LIST val*{val <- val*} be val'')

              1. (Let castsRes be $downcasts(C, $repeat_<typ>(typ, |val*{val <- val*}|), val*{val <- val*}))

                1. If (castsRes <: ok<val*>), then

                  1. (Let OK val_cast*{val_cast <- val_cast*} be castsRes as ok<val*>)

                    1. Return OK LIST val_cast*{val_cast <- val_cast*} as castRes

  5. Case (% matches pattern FUNC % % %)

    1. (Let FUNC tparam*{tparam <- tparam*} typ*{typ <- typ*} typ_ret be typ')

      1. If (val'' matches FUNC %), then

        1. (Let FUNC id be val'')

          1. (Let `{ id_local ':' typDef_local*{id_local <- id_local*, typDef_local <- typDef_local*} `} be C.LOCAL.TYP)

            1. (Let tdenv be $adds_map<id, typDef>(C.GLOBAL.TYP, id_local*{id_local <- id_local*}, typDef_local*{typDef_local <- typDef_local*}))

              1. If ((OK true as subtypRes = $subtyp(C.GLOBAL.FUNC, tdenv, FUNC tparam*{tparam <- tparam*} typ*{typ <- typ*} typ_ret, FUNC id))), then

                1. Return OK FUNC id as castRes

2. If (typ' <: optyp), then

  1. (Let optyp be typ' as optyp)

    1. Case analysis on optyp

      1. Case (% matches pattern BOOL)

        1. If (val'' matches BOOL %), then

          1. (Let BOOL b be val'')

            1. Return OK BOOL b as castRes

      2. Case (% matches pattern TEXT)

        1. If (val'' matches TEXT %), then

          1. (Let TEXT t be val'')

            1. Return OK TEXT t as castRes

3. Otherwise,

  1. Return ERROR as castRes

def $downcasts(C, typ*{typ <- typ*}, val*{val <- val*})

1. Case analysis on typ*{typ <- typ*} (total)

  1. Case (% matches pattern [])

    1. If (val*{val <- val*} matches []), then

      1. Return OK [] as castsRes

  2. Case (% matches pattern _ :: _)

    1. (Let typ_h :: typ_t*{typ_t <- typ_t*} be typ*{typ <- typ*})

      1. If (val*{val <- val*} matches _ :: _), then

        1. (Let val_h :: val_t*{val_t <- val_t*} be val*{val <- val*})

          1. (Let castRes be $downcast(C, typ_h, val_h))

            1. If (castRes <: ok<val>), then

              1. (Let OK val_cast be castRes as ok<val>)

                1. (Let castsRes be $downcasts(C, typ_t*{typ_t <- typ_t*}, val_t*{val_t <- val_t*}))

                  1. If (castsRes <: ok<val*>), then

                    1. (Let OK val_t_cast*{val_t_cast <- val_t_cast*} be castsRes as ok<val*>)

                      1. Return OK val_cast :: val_t_cast*{val_t_cast <- val_t_cast*} as castsRes

2. Otherwise,

  1. Return ERROR as castsRes

syntax assignRes =
   | OK ctx (from ok<ctx>)
   | ERROR (from error)

relation Assign_exp: C |- typedExp'' := val''' : %

1. (Let exp '#' typ be typedExp'')

  1. Case analysis on exp

    1. Case (% matches pattern VAR %)

      1. (Let VAR id be exp)

        1. Group variable: C |- VAR id '#' typ := val''' : %

          1. (Let C' be $add_varr(C, id [], val'''))

            1. Result in: % |- % := % : OK C' as assignRes

    2. Case (% matches pattern TUP %)

      1. (Let TUP typedExp*{typedExp <- typedExp*} be exp)

        1. If (val''' matches TUP %), then

          1. (Let TUP val*{val <- val*} be val''')

            1. Group tup: C |- TUP typedExp*{typedExp <- typedExp*} '#' typ := TUP val*{val <- val*} : %

              1. (Assign_exps: C |- typedExp*{typedExp <- typedExp*} := val*{val <- val*} : assignRes)

                1. If (assignRes <: ok<ctx>), then

                  1. (Let OK C' be assignRes as ok<ctx>)

                    1. Result in: % |- % := % : OK C' as assignRes

    3. Case (% matches pattern INJ %)

      1. (Let INJ mixop typedExp*{typedExp <- typedExp*} be exp)

        1. If (val''' matches INJ %), then

          1. (Let INJ mixop' val*{val <- val*} be val''')

            1. If ((mixop = mixop')), then

              1. Group inj: C |- INJ mixop typedExp*{typedExp <- typedExp*} '#' typ := INJ mixop val*{val <- val*} : %

                1. (Assign_exps: C |- typedExp*{typedExp <- typedExp*} := val*{val <- val*} : assignRes)

                  1. If (assignRes <: ok<ctx>), then

                    1. (Let OK C' be assignRes as ok<ctx>)

                      1. Result in: % |- % := % : OK C' as assignRes

    4. Case (% matches pattern STR %)

      1. (Let STR expField*{expField <- expField*} be exp)

        1. If (val''' matches STR %), then

          1. (Let STR valField*{valField <- valField*} be val''')

            1. Group str: C |- STR expField*{expField <- expField*} '#' typ := STR valField*{valField <- valField*} : %

              1. (Let atom val be valField)*{valField <- valField*, atom -> atom*, val -> val*}

                1. (Let atom' typedExp be expField)*{expField <- expField*, atom' -> atom'*, typedExp -> typedExp*}

                  1. If ((|atom*{atom <- atom*}| = |atom'*{atom' <- atom'*}|)), then

                    1. If ((atom' = atom))*{atom <- atom*, atom' <- atom'*}, then

                      1. (Assign_exps: C |- typedExp*{typedExp <- typedExp*} := val*{val <- val*} : assignRes)

                        1. If (assignRes <: ok<ctx>), then

                          1. (Let OK C' be assignRes as ok<ctx>)

                            1. Result in: % |- % := % : OK C' as assignRes

    5. Case (% matches pattern OPT %)

      1. (Let OPT typedExp'?{typedExp' <- typedExp'?} be exp)

        1. If (val''' matches OPT %), then

          1. (Let OPT val'?{val' <- val'?} be val''')

            1. Group opt: C |- OPT typedExp'?{typedExp' <- typedExp'?} '#' typ := OPT val'?{val' <- val'?} : %

              1. Case analysis on typedExp'?{typedExp' <- typedExp'?} (total)

                1. Case (% matches pattern (_))

                  1. (Let ?(typedExp) be typedExp'?{typedExp' <- typedExp'?})

                    1. If (val'?{val' <- val'?} matches (_)), then

                      1. (Let ?(val) be val'?{val' <- val'?})

                        1. (Assign_exp: C |- typedExp := val : assignRes)

                          1. If (assignRes <: ok<ctx>), then

                            1. (Let OK C' be assignRes as ok<ctx>)

                              1. Result in: % |- % := % : OK C' as assignRes

                2. Case (% matches pattern ())

                  1. If (val'?{val' <- val'?} matches ()), then

                    1. Result in: % |- % := % : OK C as assignRes

    6. Case (% matches pattern LIST %)

      1. (Let LIST typedExp*{typedExp <- typedExp*} be exp)

        1. If (val''' matches LIST %), then

          1. (Let LIST val*{val <- val*} be val''')

            1. Group list: C |- LIST typedExp*{typedExp <- typedExp*} '#' typ := LIST val*{val <- val*} : %

              1. (Assign_exps: C |- typedExp*{typedExp <- typedExp*} := val*{val <- val*} : assignRes)

                1. If (assignRes <: ok<ctx>), then

                  1. (Let OK C' be assignRes as ok<ctx>)

                    1. Result in: % |- % := % : OK C' as assignRes

    7. Case (% matches pattern CONS % %)

      1. (Let CONS typedExp_h typedExp_t be exp)

        1. If (val''' matches LIST %), then

          1. (Let LIST val*{val <- val*} be val''')

            1. If (val*{val <- val*} matches _ :: _), then

              1. (Let val_h :: val_t*{val_t <- val_t*} be val*{val <- val*})

                1. Group cons: C |- CONS typedExp_h typedExp_t '#' typ := LIST val_h :: val_t*{val_t <- val_t*} : %

                  1. (Assign_exp: C |- typedExp_h := val_h : assignRes)

                    1. If (assignRes <: ok<ctx>), then

                      1. (Let OK C' be assignRes as ok<ctx>)

                        1. (Assign_exp: C' |- typedExp_t := LIST val_t*{val_t <- val_t*} : assignRes')

                          1. If (assignRes' <: ok<ctx>), then

                            1. (Let OK C'' be assignRes' as ok<ctx>)

                              1. Result in: % |- % := % : OK C'' as assignRes

    8. Case (% matches pattern ITER % %)

      1. (Let ITER typedExp expIter be exp)

        1. Group iter: C |- ITER typedExp expIter '#' typ := val''' : %

          1. (Let varr'?{varr' <- varr'?} be $is_iter_on_var(ITER typedExp expIter '#' typ))

            1. If (varr'?{varr' <- varr'?} matches (_)), then

              1. (Let ?(varr) be varr'?{varr' <- varr'?})

                1. (Let C' be $add_varr(C, varr, val'''))

                  1. Result in: % |- % := % : OK C' as assignRes

          2. If ((val''' = OPT ?())), then

            1. If ($is_iter_on_var(ITER typedExp expIter '#' typ) matches ()), then

              1. (Let iter vari*{vari <- vari*} be expIter)

                1. If (iter matches QUEST), then

                  1. (Let vari_iter be $iterate_vari(vari, [QUEST]))*{vari <- vari*, vari_iter -> vari_iter*}

                    1. (Let val_bind*{val_bind <- val_bind*} be $repeat_<val>(OPT ?(), |vari_iter*{vari_iter <- vari_iter*}|))

                      1. (Let C' be $add_varis(C, vari_iter*{vari_iter <- vari_iter*}, val_bind*{val_bind <- val_bind*}))

                        1. Result in: % |- % := % : OK C' as assignRes

          3. Case analysis on val'''

            1. Case (% matches pattern OPT %)

              1. (Let OPT val'?{val' <- val'?} be val''')

                1. If (val'?{val' <- val'?} matches (_)), then

                  1. (Let ?(val) be val'?{val' <- val'?})

                    1. If ($is_iter_on_var(ITER typedExp expIter '#' typ) matches ()), then

                      1. (Let iter vari*{vari <- vari*} be expIter)

                        1. If (iter matches QUEST), then

                          1. (Assign_exp: C |- typedExp := val : assignRes)

                            1. If (assignRes <: ok<ctx>), then

                              1. (Let OK C' be assignRes as ok<ctx>)

                                1. (Let vari_iter be $iterate_vari(vari, [QUEST]))*{vari <- vari*, vari_iter -> vari_iter*}

                                  1. (Let val''?{val'' <- val''?} be $find_vari(C', vari))*{vari <- vari*, val''? -> val''?*}

                                    1. If (val''?{val'' <- val''?} matches (_))*{val''? <- val''?*}, then

                                      1. (Let ?(val_sub) be val''?{val'' <- val''?})*{val''? <- val''?*, val_sub -> val_sub*}

                                        1. (Let C'' be $add_varis(C', vari_iter*{vari_iter <- vari_iter*}, OPT ?(val_sub)*{val_sub <- val_sub*}))

                                          1. Result in: % |- % := % : OK C'' as assignRes

            2. Case (% matches pattern LIST %)

              1. (Let LIST val*{val <- val*} be val''')

                1. If ($is_iter_on_var(ITER typedExp expIter '#' typ) matches ()), then

                  1. (Let iter vari*{vari <- vari*} be expIter)

                    1. If (iter matches STAR), then

                      1. (Let C_local be C[LOCAL.VAL = $empty_map<varr, val>])

                        1. (Assign_exp: C_local |- typedExp := val : assignRes)*{val <- val*, assignRes -> assignRes*}

                          1. If (assignRes <: ok<ctx>)*{assignRes <- assignRes*}, then

                            1. (Let OK C_sub be assignRes as ok<ctx>)*{assignRes <- assignRes*, C_sub -> C_sub*}

                              1. (Let vari_iter be $iterate_vari(vari, [STAR]))*{vari <- vari*, vari_iter -> vari_iter*}

                                1. (Let val'*{val' <- val'*}?{val'* <- val'*?} be $finds_vari(C_sub*{C_sub <- C_sub*}, vari))*{vari <- vari*, val'*? -> val'*?*}

                                  1. If (val'*{val' <- val'*}?{val'* <- val'*?} matches (_))*{val'*? <- val'*?*}, then

                                    1. (Let ?(val_sub*{val_sub <- val_sub*}) be val'*{val' <- val'*}?{val'* <- val'*?})*{val'*? <- val'*?*, val_sub* -> val_sub**}

                                      1. (Let val_bind be LIST val_sub*{val_sub <- val_sub*})*{val_sub* <- val_sub**, val_bind -> val_bind*}

                                        1. (Let C' be $add_varis(C, vari_iter*{vari_iter <- vari_iter*}, val_bind*{val_bind <- val_bind*}))

                                          1. Result in: % |- % := % : OK C' as assignRes

2. Otherwise,

  1. Group error: C |- typedExp'' := val''' : %

    1. Result in: % |- % := % : ERROR as assignRes

relation Assign_exps: C |- typedExp*{typedExp <- typedExp*} := val*{val <- val*} : %

1. Group : C |- typedExp*{typedExp <- typedExp*} := val*{val <- val*} : %

  1. Case analysis on typedExp*{typedExp <- typedExp*} (total)

    1. Case (% matches pattern [])

      1. If (val*{val <- val*} matches []), then

        1. Result in: % |- % := % : OK C as assignRes

    2. Case (% matches pattern _ :: _)

      1. (Let typedExp_h :: typedExp_t*{typedExp_t <- typedExp_t*} be typedExp*{typedExp <- typedExp*})

        1. If (val*{val <- val*} matches _ :: _), then

          1. (Let val_h :: val_t*{val_t <- val_t*} be val*{val <- val*})

            1. (Assign_exp: C |- typedExp_h := val_h : assignRes)

              1. If (assignRes <: ok<ctx>), then

                1. (Let OK C' be assignRes as ok<ctx>)

                  1. (Assign_exps: C' |- typedExp_t*{typedExp_t <- typedExp_t*} := val_t*{val_t <- val_t*} : assignRes')

                    1. If (assignRes' <: ok<ctx>), then

                      1. (Let OK C'' be assignRes' as ok<ctx>)

                        1. Result in: % |- % := % : OK C'' as assignRes

2. Otherwise,

  1. Group error: C |- typedExp*{typedExp <- typedExp*} := val*{val <- val*} : %

    1. Result in: % |- % := % : ERROR as assignRes

relation Assign_arg: C |- arg := val : %

1. Case analysis on arg (total)

  1. Case (% matches pattern EXP %)

    1. (Let EXP typedExp be arg)

      1. Group exp: C |- EXP typedExp := val : %

        1. (Assign_exp: C |- typedExp := val : assignRes)

          1. If (assignRes <: ok<ctx>), then

            1. (Let OK C' be assignRes as ok<ctx>)

              1. Result in: % |- % := % : OK C' as assignRes

  2. Case (% matches pattern FUN %)

    1. (Let FUN id be arg)

      1. If (val matches FUNC %), then

        1. (Let FUNC id_global be val)

          1. Group fun: C |- FUN id := FUNC id_global : %

