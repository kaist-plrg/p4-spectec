        1. (Let REL id ':' typedExp*{typedExp <- typedExp*} `( inputHint `) be relPremIL)

          1. (Let (typedExp_in*{typedExp_in <- typedExp_in*}, typedExp_out*{typedExp_out <- typedExp_out*}) be $split_inputs<typedExp>(inputHint, typedExp*{typedExp <- typedExp*}))

            1. (Let vari_in*{vari_in <- vari_in*} be $free_varis_exps(typedExp_in*{typedExp_in <- typedExp_in*}))

              1. If ($is_bound(AC, IC, vari_in*{vari_in <- vari_in*})), then

                1. (Bind_exps: AC IC |- typedExp_out*{typedExp_out <- typedExp_out*} : AC_bound typedExp_out_part*{typedExp_out_part <- typedExp_out_part*} premAL_bind*{premAL_bind <- premAL_bind*})

                  1. (Let id_read*{id_read <- id_read*} be $ids_of_varis(vari_in*{vari_in <- vari_in*}))

                    1. (Let vari_out*{vari_out <- vari_out*} be $free_varis_exps(typedExp_out_part*{typedExp_out_part <- typedExp_out_part*}))

                      1. (Let vari_bind*{vari_bind <- vari_bind*} be $shallowest_varis(vari_out*{vari_out <- vari_out*}))

                        1. (Let IC_bind be $add_iterated(IC, vari_bind*{vari_bind <- vari_bind*}))

                          1. (Let premIterAL*{premIterAL <- premIterAL*} be $prem_iters(IC_bind, id_read*{id_read <- id_read*}, $ids_of_varis(vari_bind*{vari_bind <- vari_bind*})))

                            1. If (Iter_sourced: |- premIterAL*{premIterAL <- premIterAL*}) holds, then

                              1. (Let relPremAL be REL id ':' typedExp_in*{typedExp_in <- typedExp_in*} '->' typedExp_out_part*{typedExp_out_part <- typedExp_out_part*})

                                1. (Let premAL_rel be $iterate_prem(relPremAL as premAL, premIterAL*{premIterAL <- premIterAL*}))

                                  1. (Let premAL*{premAL <- premAL*} be premAL_rel :: premAL_bind*{premAL_bind <- premAL_bind*})

                                    1. Result in: % % |- % : AC_bound premAL*{premAL <- premAL*}

                            1. Else Dangling

              1. Else Dangling

  2. Case (% has type ifPrem)

    1. (Let ifPrem be premIL' as ifPrem)

      1. Group cond: AC IC |- ifPrem as premIL : % %

        1. (Let IF typedExp be ifPrem)

          1. (Let vari*{vari <- vari*} be $free_varis_exp(typedExp))

            1. If ($is_bound(AC, IC, vari*{vari <- vari*})), then

              1. (Let premIterAL*{premIterAL <- premIterAL*} be $prem_iters(IC, $ids_of_varis(vari*{vari <- vari*}), []))

                1. (Let premAL_if be $iterate_prem(ifPrem as premAL, premIterAL*{premIterAL <- premIterAL*}))

                  1. Result in: % % |- % : AC [premAL_if]

            1. Else Dangling

          2. (Let exp '#' _typ be typedExp)

            1. If (exp matches CMP % % %), then

              1. (Let CMP cmpop typedExp_l typedExp_r be exp)

                1. If (cmpop <: polyCmpop), then

                  1. (Let polyCmpop be cmpop as polyCmpop)

                    1. If (polyCmpop matches EQ), then

                      1. (Collectbind_exp: AC |- typedExp_l : vari_l*{vari_l <- vari_l*})

                        1. Case analysis on vari_l*{vari_l <- vari_l*} (total)

                          1. Case (% matches pattern _ :: _)

                            1. (Collectbind_exp: AC |- typedExp_r : vari*{vari <- vari*})

                              1. If (vari*{vari <- vari*} matches []), then

                                1. (Algo_let: AC IC |- typedExp_l '=' typedExp_r : AC_bound premAL*{premAL <- premAL*})

                                  1. Result in: % % |- % : AC_bound premAL*{premAL <- premAL*}

                              1. Else Dangling

                          2. Case (% matches pattern [])

                            1. (Collectbind_exp: AC |- typedExp_r : vari_r*{vari_r <- vari_r*})

                              1. If (vari_r*{vari_r <- vari_r*} matches _ :: _), then

                                1. (Algo_let: AC IC |- typedExp_r '=' typedExp_l : AC_bound premAL*{premAL <- premAL*})

                                  1. Result in: % % |- % : AC_bound premAL*{premAL <- premAL*}

                              1. Else Dangling

                    1. Else Dangling

                1. Else Dangling

            1. Else Dangling

  3. Case (% has type ifHoldPrem)

    1. (Let ifHoldPrem be premIL' as ifHoldPrem)

      1. Group ifhold: AC IC |- ifHoldPrem as premIL : % %

        1. (Let IFHOLD id ':' typedExp*{typedExp <- typedExp*} be ifHoldPrem)

          1. (Let vari_read*{vari_read <- vari_read*} be $free_varis_exps(typedExp*{typedExp <- typedExp*}))

            1. If ($is_bound(AC, IC, vari_read*{vari_read <- vari_read*})), then

              1. (Let premIterAL*{premIterAL <- premIterAL*} be $prem_iters(IC, $ids_of_varis(vari_read*{vari_read <- vari_read*}), []))

                1. (Let premAL_hold be $iterate_prem(ifHoldPrem as premAL, premIterAL*{premIterAL <- premIterAL*}))

                  1. Result in: % % |- % : AC [premAL_hold]

            1. Else Dangling

  4. Case (% has type ifNotHoldPrem)

    1. (Let ifNotHoldPrem be premIL' as ifNotHoldPrem)

      1. Group ifnothold: AC IC |- ifNotHoldPrem as premIL : % %

        1. (Let IFNOTHOLD id ':' typedExp*{typedExp <- typedExp*} be ifNotHoldPrem)

          1. (Let vari_read*{vari_read <- vari_read*} be $free_varis_exps(typedExp*{typedExp <- typedExp*}))

            1. If ($is_bound(AC, IC, vari_read*{vari_read <- vari_read*})), then

              1. (Let premIterAL*{premIterAL <- premIterAL*} be $prem_iters(IC, $ids_of_varis(vari_read*{vari_read <- vari_read*}), []))

                1. (Let premAL_hold be $iterate_prem(ifNotHoldPrem as premAL, premIterAL*{premIterAL <- premIterAL*}))

                  1. Result in: % % |- % : AC [premAL_hold]

            1. Else Dangling

  5. Case (% has type iterPremIL)

    1. (Let ITER premIL premIterIL be premIL' as iterPremIL)

      1. Group iter: AC IC |- ITER premIL premIterIL as premIL : % %

        1. (Let IC_iter be premIterIL :: IC)

          1. (Algo_prem: AC IC_iter |- premIL : AC_prem premAL*{premAL <- premAL*})

            1. Result in: % % |- % : AC_prem premAL*{premAL <- premAL*}

  6. Case (% has type debugPrem)

    1. (Let debugPrem be premIL' as debugPrem)

      1. Group dbg: AC IC |- debugPrem as premIL : % %

        1. (Let DEBUG typedExp be debugPrem)

          1. (Let vari*{vari <- vari*} be $free_varis_exp(typedExp))

            1. If ($is_bound(AC, IC, vari*{vari <- vari*})), then

              1. (Let premIterAL*{premIterAL <- premIterAL*} be $prem_iters(IC, $ids_of_varis(vari*{vari <- vari*}), []))

                1. (Let premAL_debug be $iterate_prem(debugPrem as premAL, premIterAL*{premIterAL <- premIterAL*}))

                  1. Result in: % % |- % : AC [premAL_debug]

            1. Else Dangling

relation Algo_let: AC IC |- typedExp_l '=' typedExp_r : % %

1. Group : AC IC |- typedExp_l '=' typedExp_r : % %

  1. (Bind_exps: AC IC |- [typedExp_l] : AC_bound typedExp*{typedExp <- typedExp*} premAL_bind*{premAL_bind <- premAL_bind*})

    1. If (typedExp*{typedExp <- typedExp*} matches [ _/1 ]), then

      1. (Let [typedExp_l_part] be typedExp*{typedExp <- typedExp*})

        1. (Let vari_r*{vari_r <- vari_r*} be $free_varis_exp(typedExp_r))

          1. If ($is_bound(AC, IC, vari_r*{vari_r <- vari_r*})), then

            1. (Let vari_l*{vari_l <- vari_l*} be $free_varis_exp(typedExp_l_part))

              1. (Let vari_bind*{vari_bind <- vari_bind*} be $shallowest_varis(vari_l*{vari_l <- vari_l*}))

                1. (Let IC_bind be $add_iterated(IC, vari_bind*{vari_bind <- vari_bind*}))

                  1. (Let premIterAL*{premIterAL <- premIterAL*} be $prem_iters(IC_bind, $ids_of_varis(vari_r*{vari_r <- vari_r*}), $ids_of_varis(vari_bind*{vari_bind <- vari_bind*})))

                    1. If (Iter_sourced: |- premIterAL*{premIterAL <- premIterAL*}) holds, then

                      1. (Let premAL_let be $iterate_prem(LET typedExp_l_part '=' typedExp_r as premAL, premIterAL*{premIterAL <- premIterAL*}))

                        1. Result in: % % |- % '=' % : AC_bound premAL_let :: premAL_bind*{premAL_bind <- premAL_bind*}

                    1. Else Dangling

          1. Else Dangling

    1. Else Dangling

relation Algo_prems: AC |- premIL*{premIL <- premIL*} : % %

1. Group : AC |- premIL*{premIL <- premIL*} : % %

  1. Case analysis on premIL*{premIL <- premIL*} (total)

    1. Case (% matches pattern [])

      1. Result in: % |- % : AC []

    2. Case (% matches pattern _ :: _)

      1. (Let premIL_h :: premIL_t*{premIL_t <- premIL_t*} be premIL*{premIL <- premIL*})

        1. (Let IC be [])

          1. (Algo_prem: AC IC |- premIL_h : AC_h premAL_h*{premAL_h <- premAL_h*})

            1. (Algo_prems: AC_h |- premIL_t*{premIL_t <- premIL_t*} : AC_t premAL_t*{premAL_t <- premAL_t*})

              1. Result in: % |- % : AC_t premAL_h*{premAL_h <- premAL_h*} ++ premAL_t*{premAL_t <- premAL_t*}

relation Algo_tblRow: AC |- tblRowIL : %

1. Group : AC |- tblRowIL : %

  1. (Let arg*{arg <- arg*} '=' typedExp be tblRowIL)

    1. (Let id_used*{id_used <- id_used*} be $ids_of_varis($free_varis_tblRowIL(tblRowIL)))

      1. (Let AC_row be $add_used(AC, id_used*{id_used <- id_used*}))

        1. (Collectbind_args: AC_row |- arg*{arg <- arg*} : vari_bind*{vari_bind <- vari_bind*})

          1. (Let `{ id_bind ':' _id*{_id <- _id*}*{_id* <- _id**, id_bind <- id_bind*} `} be $init_renamer([], vari_bind*{vari_bind <- vari_bind*}).OCC)

            1. If ((|id_bind*{id_bind <- id_bind*}| = |vari_bind*{vari_bind <- vari_bind*}|)), then

              1. (Bind_args: AC_row |- arg*{arg <- arg*} : AC_body arg_part*{arg_part <- arg_part*} premAL*{premAL <- premAL*})

                1. (Let vari_body*{vari_body <- vari_body*} be $free_varis_exp(typedExp))

                  1. If ($is_bound(AC_body, [], vari_body*{vari_body <- vari_body*})), then

                    1. Result in: % |- % : arg_part*{arg_part <- arg_part*} '=' typedExp '-' premAL*{premAL <- premAL*}

                  1. Else Dangling

            1. Else Dangling

relation TblRows_cover: AC typ*{typ <- typ*} |- tblRowIL*{tblRowIL <- tblRowIL*}

1. Group : AC typ*{typ <- typ*} |- tblRowIL*{tblRowIL <- tblRowIL*}

  1. (Let typCase*{typCase <- typCase*} be $variant_cases(AC.TYP, typ))*{typ <- typ*, typCase* -> typCase**}

    1. If ((|tblRowIL*{tblRowIL <- tblRowIL*}| > 0)), then

      1. (Let i be (|tblRowIL*{tblRowIL <- tblRowIL*}| - 1))

        1. If (i <: nat), then

          1. (Let n_init be i as nat)

            1. If ((n_init < |tblRowIL*{tblRowIL <- tblRowIL*}|)), then

              1. (Let arg*{arg <- arg*} '=' _typedExp be tblRowIL*{tblRowIL <- tblRowIL*}[n_init])

                1. If (arg matches EXP %)*{arg <- arg*}, then

                  1. (Let EXP typedExp_last be arg)*{arg <- arg*, typedExp_last -> typedExp_last*}

                    1. Case analysis on $forall_($is_wildcard_exp(typedExp_last)*{typedExp_last <- typedExp_last*}) (total)

                      1. Case true

                        1. If (((0 + n_init) <= |tblRowIL*{tblRowIL <- tblRowIL*}|)), then

                          1. (Let arg'*{arg' <- arg'*} '=' _typedExp'*{_typedExp' <- _typedExp'*, arg'* <- arg'**} be tblRowIL*{tblRowIL <- tblRowIL*}[0 : n_init])

                            1. If (arg' matches EXP %)*{arg' <- arg'*}*{arg'* <- arg'**}, then

                              1. (Let EXP typedExp be arg')*{arg' <- arg'*, typedExp -> typedExp*}*{arg'* <- arg'**, typedExp* -> typedExp**}

                                1. (Let typCase_row*{typCase_row <- typCase_row*} be $covered_cases(AC.TYP, typedExp))*{typedExp <- typedExp*, typCase_row* -> typCase_row**}*{typedExp* <- typedExp**, typCase_row** -> typCase_row***}

                                  1. If ($is_exclusive(typCase_row*{typCase_row <- typCase_row*}*{typCase_row* <- typCase_row**}*{typCase_row** <- typCase_row***})), then

                                    1. The relation holds

                                  1. Else Dangling

                            1. Else Dangling

                        1. Else Dangling

                      2. Case false

                        1. (Let arg'*{arg' <- arg'*} '=' _typedExp'*{_typedExp' <- _typedExp'*, arg'* <- arg'**} be tblRowIL*{tblRowIL <- tblRowIL*})

                          1. If (arg' matches EXP %)*{arg' <- arg'*}*{arg'* <- arg'**}, then

                            1. (Let EXP typedExp be arg')*{arg' <- arg'*, typedExp -> typedExp*}*{arg'* <- arg'**, typedExp* -> typedExp**}

                              1. (Let typCase_row*{typCase_row <- typCase_row*} be $covered_cases(AC.TYP, typedExp))*{typedExp <- typedExp*, typCase_row* -> typCase_row**}*{typedExp* <- typedExp**, typCase_row** -> typCase_row***}

                                1. If ($is_exclusive(typCase_row*{typCase_row <- typCase_row*}*{typCase_row* <- typCase_row**}*{typCase_row** <- typCase_row***})), then

                                  1. (Let typCase_comb*{typCase_comb <- typCase_comb*}*{typCase_comb* <- typCase_comb**} be $combinations(typCase*{typCase <- typCase*}*{typCase* <- typCase**}))

                                    1. If ($forall_($is_covered(typCase_row*{typCase_row <- typCase_row*}*{typCase_row* <- typCase_row**}*{typCase_row** <- typCase_row***}, typCase_comb*{typCase_comb <- typCase_comb*})*{typCase_comb* <- typCase_comb**})), then

                                      1. The relation holds

                                    1. Else Dangling

                                1. Else Dangling

                          1. Else Dangling

                1. Else Dangling

            1. Else Dangling

        1. Else Dangling

    1. Else Dangling

relation Algo_rul: AC inputHint |- rulIL : %

1. Group : AC inputHint |- rulIL : %

  1. (Let id ':' typedExp*{typedExp <- typedExp*} '-' premIL*{premIL <- premIL*} be rulIL)

    1. (Let id_used*{id_used <- id_used*} be $ids_of_varis($free_varis_rulIL(rulIL)))

      1. (Let AC_rul be $add_used(AC, id_used*{id_used <- id_used*}))

        1. (Let (typedExp_in*{typedExp_in <- typedExp_in*}, typedExp_out*{typedExp_out <- typedExp_out*}) be $split_inputs<typedExp>(inputHint, typedExp*{typedExp <- typedExp*}))

          1. (Bind_exps: AC_rul [] |- typedExp_in*{typedExp_in <- typedExp_in*} : AC_in typedExp_in_part*{typedExp_in_part <- typedExp_in_part*} premAL_bind*{premAL_bind <- premAL_bind*})

            1. (Algo_prems: AC_in |- premIL*{premIL <- premIL*} : AC_body premAL*{premAL <- premAL*})

              1. (Let vari_out*{vari_out <- vari_out*} be $free_varis_exps(typedExp_out*{typedExp_out <- typedExp_out*}))

                1. If ($is_bound(AC_body, [], vari_out*{vari_out <- vari_out*})), then

                  1. (Let rulAL be id ':' typedExp_in_part*{typedExp_in_part <- typedExp_in_part*} '->' typedExp_out*{typedExp_out <- typedExp_out*} '-' premAL_bind*{premAL_bind <- premAL_bind*} ++ premAL*{premAL <- premAL*})

                    1. Result in: % % |- % : rulAL

                1. Else Dangling

relation Algo_clause: AC |- clauseIL : %

1. Group : AC |- clauseIL : %

  1. (Let arg*{arg <- arg*} '=' typedExp '-' premIL*{premIL <- premIL*} be clauseIL)

    1. (Let id_used*{id_used <- id_used*} be $ids_of_varis($free_varis_clauseIL(clauseIL)))

      1. (Let AC_clause be $add_used(AC, id_used*{id_used <- id_used*}))

        1. (Bind_args: AC_clause |- arg*{arg <- arg*} : AC_arg arg_part*{arg_part <- arg_part*} premAL_arg*{premAL_arg <- premAL_arg*})

          1. (Algo_prems: AC_arg |- premIL*{premIL <- premIL*} : AC_body premAL*{premAL <- premAL*})

            1. (Let vari_body*{vari_body <- vari_body*} be $free_varis_exp(typedExp))

              1. If ($is_bound(AC_body, [], vari_body*{vari_body <- vari_body*})), then

                1. (Let clauseAL be arg_part*{arg_part <- arg_part*} '=' typedExp '-' premAL_arg*{premAL_arg <- premAL_arg*} ++ premAL*{premAL <- premAL*})

                  1. Result in: % |- % : clauseAL

              1. Else Dangling

relation Algo_def: AC |- defnIL : %

1. If (defnIL <: typDefn), then

  1. (Let typDefn be defnIL as typDefn)

    1. Group typ: AC |- typDefn as defnIL : %

      1. Result in: % |- % : typDefn as defnAL

1. Else Dangling

2. Group rel: AC |- defnIL : %

  1. Case analysis on defnIL

    1. Case (% has type externRelDefnIL)

      1. (Let externRelDefnIL be defnIL as externRelDefnIL)

        1. (Let EXTREL id ':' typ*{typ <- typ*} `( inputHint `) be externRelDefnIL)

          1. (Let (typ_in*{typ_in <- typ_in*}, typ_out*{typ_out <- typ_out*}) be $split_inputs<typ>(inputHint, typ*{typ <- typ*}))

            1. (Let externRelDefnAL be EXTREL id ':' typ_in*{typ_in <- typ_in*} '->' typ_out*{typ_out <- typ_out*})

              1. Result in: % |- % : externRelDefnAL as defnAL

    2. Case (% has type definedRelDefnIL)

      1. (Let definedRelDefnIL be defnIL as definedRelDefnIL)

        1. (Let REL id ':' typ*{typ <- typ*} `( inputHint `) '=' rulGroupIL*{rulGroupIL <- rulGroupIL*} elsGroupIL?{elsGroupIL <- elsGroupIL?} be definedRelDefnIL)

          1. (Let (typ_in*{typ_in <- typ_in*}, typ_out*{typ_out <- typ_out*}) be $split_inputs<typ>(inputHint, typ*{typ <- typ*}))

            1. (Let id_group ':' rulIL*{rulIL <- rulIL*} be rulGroupIL)*{rulGroupIL <- rulGroupIL*, id_group -> id_group*, rulIL* -> rulIL**}

              1. (Algo_rul: AC inputHint |- rulIL : rulAL)*{rulIL <- rulIL*, rulAL -> rulAL*}*{rulIL* <- rulIL**, rulAL* -> rulAL**}

                1. (Let rulGroupAL be id_group ':' rulAL*{rulAL <- rulAL*})*{id_group <- id_group*, rulAL* <- rulAL**, rulGroupAL -> rulGroupAL*}

                  1. (Let id_else ':' rulIL_else be elsGroupIL)?{elsGroupIL <- elsGroupIL?, id_else -> id_else?, rulIL_else -> rulIL_else?}

                    1. (Algo_rul: AC inputHint |- rulIL_else : rulAL_else)?{rulIL_else <- rulIL_else?, rulAL_else -> rulAL_else?}

                      1. (Let elsGroupAL be id_else ':' rulAL_else)?{id_else <- id_else?, rulAL_else <- rulAL_else?, elsGroupAL -> elsGroupAL?}

                        1. (Let definedRelDefnAL be REL id ':' typ_in*{typ_in <- typ_in*} '->' typ_out*{typ_out <- typ_out*} '=' rulGroupAL*{rulGroupAL <- rulGroupAL*} elsGroupAL?{elsGroupAL <- elsGroupAL?})

                          1. Result in: % |- % : definedRelDefnAL as defnAL

  1. Else Dangling

3. Group func: AC |- defnIL : %

  1. Case analysis on defnIL

    1. Case (% has type externFuncDefn)

      1. (Let externFuncDefn be defnIL as externFuncDefn)

        1. Result in: % |- % : externFuncDefn as defnAL

    2. Case (% has type builtinFuncDefn)

      1. (Let builtinFuncDefn be defnIL as builtinFuncDefn)

        1. Result in: % |- % : builtinFuncDefn as defnAL

    3. Case (% has type tableFuncDefnIL)

      1. (Let tableFuncDefnIL be defnIL as tableFuncDefnIL)

        1. (Let TABLEFUNC id param*{param <- param*} ':' typ '=' tblRowIL*{tblRowIL <- tblRowIL*} be tableFuncDefnIL)

          1. If (param matches EXP %)*{param <- param*}, then

            1. (Let EXP typ_param be param)*{param <- param*, typ_param -> typ_param*}

              1. (Let arg*{arg <- arg*} '=' _typedExp be tblRowIL)*{tblRowIL <- tblRowIL*, _typedExp -> _typedExp*, arg* -> arg**}

                1. If ((|arg*{arg <- arg*}| = |param*{param <- param*}|))*{arg* <- arg**}, then

                  1. (Algo_tblRow: AC |- tblRowIL : tblRowAL)*{tblRowIL <- tblRowIL*, tblRowAL -> tblRowAL*}

                    1. If (TblRows_cover: AC typ_param*{typ_param <- typ_param*} |- tblRowIL*{tblRowIL <- tblRowIL*}) holds, then

                      1. (Let tableFuncDefnAL be TABLEFUNC id param*{param <- param*} ':' typ '=' tblRowAL*{tblRowAL <- tblRowAL*})

                        1. Result in: % |- % : tableFuncDefnAL as defnAL

                    1. Else Dangling

                1. Else Dangling

          1. Else Dangling

    4. Case (% has type definedFuncDefnIL)

      1. (Let definedFuncDefnIL be defnIL as definedFuncDefnIL)

        1. (Let FUNC id tparam*{tparam <- tparam*} param*{param <- param*} ':' typ '=' clauseIL*{clauseIL <- clauseIL*} elsClauseIL?{elsClauseIL <- elsClauseIL?} be definedFuncDefnIL)

          1. (Let AC_func be $add_tparams(AC, tparam*{tparam <- tparam*}))

            1. (Algo_clause: AC_func |- clauseIL : clauseAL)*{clauseIL <- clauseIL*, clauseAL -> clauseAL*}

              1. (Algo_clause: AC_func |- elsClauseIL : elsClauseAL)?{elsClauseIL <- elsClauseIL?, elsClauseAL -> elsClauseAL?}

                1. (Let definedFuncDefnAL be FUNC id tparam*{tparam <- tparam*} param*{param <- param*} ':' typ '=' clauseAL*{clauseAL <- clauseAL*} elsClauseAL?{elsClauseAL <- elsClauseAL?})

                  1. Result in: % |- % : definedFuncDefnAL as defnAL

  1. Else Dangling

relation Guard_exp: AC |- exp '#' typ' : %

1. Group literal: AC |- exp '#' typ' : %

  1. Case analysis on exp

    1. Case (% matches pattern BOOL %)

      1. Result in: % |- % : []

    2. Case (% has type num)

      1. Result in: % |- % : []

    3. Case (% matches pattern TEXT %)

      1. Result in: % |- % : []

  1. Else Dangling

2. Case analysis on exp

  1. Case (% matches pattern VAR %)

    1. (Let VAR id be exp)

      1. Group variable: AC |- VAR id '#' typ' : %

        1. Result in: % |- % : []

  2. Case (% matches pattern UN % %)

    1. (Let UN unop typedExp be exp)

      1. Group unary: AC |- UN unop typedExp '#' typ' : %

        1. (Guard_exp: AC |- typedExp : premAL*{premAL <- premAL*})

          1. Result in: % |- % : premAL*{premAL <- premAL*}

  3. Case (% matches pattern BIN % % %)

    1. (Let BIN binop typedExp_l typedExp_r be exp)

      1. Group binary: AC |- BIN binop typedExp_l typedExp_r '#' typ' : %

        1. Case analysis on binop <- [DIV as binop, MOD as binop] (total)

          1. Case false

            1. (Guard_exps: AC |- [typedExp_l, typedExp_r] : premAL*{premAL <- premAL*})

              1. Result in: % |- % : premAL*{premAL <- premAL*}

          2. Case true

            1. (Guard_exps: AC |- [typedExp_l, typedExp_r] : premAL_operand*{premAL_operand <- premAL_operand*})

              1. (Let _exp '#' typ_r be typedExp_r)

                1. (Let typedExp_zero be $exp_zero(AC.TYP, typ_r))

                  1. (Let premAL_div be $sidecond_cmp(NE as cmpop, typedExp_r, typedExp_zero))

                    1. (Let premAL*{premAL <- premAL*} be premAL_operand*{premAL_operand <- premAL_operand*} ++ [premAL_div])

                      1. Result in: % |- % : premAL*{premAL <- premAL*}

  4. Case (% matches pattern CMP % % %)

    1. (Let CMP cmpop typedExp_l typedExp_r be exp)

      1. Group compare: AC |- CMP cmpop typedExp_l typedExp_r '#' typ' : %

        1. (Guard_exps: AC |- [typedExp_l, typedExp_r] : premAL*{premAL <- premAL*})

          1. Result in: % |- % : premAL*{premAL <- premAL*}

  5. Case (% matches pattern UPCAST % %)

    1. (Let UPCAST typ typedExp be exp)

      1. Group upcast: AC |- UPCAST typ typedExp '#' typ' : %

        1. (Guard_exp: AC |- typedExp : premAL*{premAL <- premAL*})

