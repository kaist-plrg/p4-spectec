                  1. (Let funcRes be $deopt_<funcRes>(funcRes_els?{funcRes_els <- funcRes_els?}, UNMATCH as funcRes))

                    1. Result in: % |- % `< % `> `( % `) : funcRes

            2. If ((funcRes' =/= UNMATCH as funcRes)), then

