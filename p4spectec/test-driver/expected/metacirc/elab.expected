var b : bool

var i : int

var n : nat

var t : text

def $ite<X>(bool, X, X) : X =

  clause 0 : (true, X_t, X_f) = X_t

  clause 1 : (false, X_t, X_f) = X_f

def $opt_as_seq_<X>(X?) : X* =

  clause 0 : (?()) = []

  clause 1 : (?(X)) = [X]

def $exists_(bool*) : bool =

  clause 0 : ([]) = false

  clause 1 : (b_h :: b_t*{b_t <- b_t*}) = (b_h \/ $exists_(b_t*{b_t <- b_t*}))

def $forall_(bool*) : bool =

  clause 0 : ([]) = true

  clause 1 : (b_h :: b_t*{b_t <- b_t*}) = (b_h /\ $forall_(b_t*{b_t <- b_t*}))

def $repeat_<X>(X, nat) : X* =

  clause 0 : (X, 0) = []

  clause 1 : (X, n) = [X] ++ $repeat_<X>(X, n')
  -- if (n =/= 0)
  -- if (n' as int = (n - 1))

builtin def $rev_<X>(X*) : X*

builtin def $assoc_<X, Y>(X, (X, Y)*) : Y?

builtin def $transpose_<X>(X**) : X**

syntax set<K> =
   | `{ K* `} (from set<K>)

def $empty_set<K> : set<K> =

  clause 0 :  = `{ [] `}

syntax pair<K, V> =
   | K ':' V (from pair<K, V>)

syntax map<K, V> = set<pair<K, V>>

def $empty_map<K, V> : map<K, V> =

  clause 0 :  = `{ [] `}

builtin def $find_map<K, V>(map<K, V>, K) : V?

builtin def $find_maps<K, V>(map<K, V>*, K) : V?

builtin def $add_map<K, V>(map<K, V>, K, V) : map<K, V>

builtin def $adds_map<K, V>(map<K, V>, K*, V*) : map<K, V>

syntax id = text

syntax atom = text

syntax mixop = atom**

syntax numtyp =
   | NAT (from numtyp)
   | INT (from numtyp)

syntax optyp =
   | BOOL (from optyp)
   | NAT (from numtyp)
   | INT (from numtyp)
   | TEXT (from optyp)

syntax typ =
   | BOOL (from optyp)
   | NAT (from numtyp)
   | INT (from numtyp)
   | TEXT (from optyp)
   | VAR id targ* (from typ)
   | TUP typ* (from typ)
   | ITER typ iter (from typ)
   | FUNC tparam* typ* typ (from typ)

syntax deftyp =
   | ALIAS typ (from deftyp)
   | STRUCT typfield* (from deftyp)
   | VARIANT typcase* (from deftyp)

syntax typfield =
   | atom typ (from typfield)

syntax typcase =
   | mixop typ* (from typcase)

syntax iter =
   | QUEST (from iter)
   | STAR (from iter)

syntax vari =
   | id typ iter* (from vari)

syntax num =
   | NAT nat (from num)
   | INT int (from num)

syntax boolunop =
   | NOT (from boolunop)

syntax boolbinop =
   | AND (from boolbinop)
   | OR (from boolbinop)
   | IMPL (from boolbinop)
   | EQUIV (from boolbinop)

syntax numunop =
   | PLUS (from numunop)
   | MINUS (from numunop)

syntax numbinop =
   | ADD (from numbinop)
   | SUB (from numbinop)
   | MUL (from numbinop)
   | DIV (from numbinop)
   | MOD (from numbinop)
   | POW (from numbinop)

syntax numcmpop =
   | LT (from numcmpop)
   | GT (from numcmpop)
   | LE (from numcmpop)
   | GE (from numcmpop)

syntax polycmpop =
   | EQ (from polycmpop)
   | NE (from polycmpop)

syntax unop =
   | NOT (from boolunop)
   | PLUS (from numunop)
   | MINUS (from numunop)

syntax binop =
   | AND (from boolbinop)
   | OR (from boolbinop)
   | IMPL (from boolbinop)
   | EQUIV (from boolbinop)
   | ADD (from numbinop)
   | SUB (from numbinop)
   | MUL (from numbinop)
   | DIV (from numbinop)
   | MOD (from numbinop)
   | POW (from numbinop)

syntax cmpop =
   | EQ (from polycmpop)
   | NE (from polycmpop)
   | LT (from numcmpop)
   | GT (from numcmpop)
   | LE (from numcmpop)
   | GE (from numcmpop)

extern syntax json

syntax val =
   | BOOL bool (from val)
   | NAT nat (from num)
   | INT int (from num)
   | TEXT text (from val)
   | STR valfield* (from val)
   | INJ valcase (from val)
   | TUP val* (from val)
   | OPT val? (from val)
   | LIST val* (from val)
   | FUNC id (from val)
   | EXT json (from val)

syntax valfield =
   | atom val (from valfield)

syntax valcase =
   | mixop val* (from valcase)

syntax exp =
   | BOOL bool (from exp)
   | NAT nat (from num)
   | INT int (from num)
   | TEXT text (from exp)
   | VAR id (from exp)
   | UN unop exp (from exp)
   | BIN binop exp exp (from exp)
   | CMP cmpop exp exp (from exp)
   | UPCAST typ exp (from exp)
   | DOWNCAST typ exp (from exp)
   | SUB exp typ (from exp)
   | MATCH exp pattern (from exp)
   | TUP exp* (from exp)
   | INJ expcase (from exp)
   | STR expfield* (from exp)
   | OPT exp? (from exp)
   | LIST exp* (from exp)
   | CONS exp exp (from exp)
   | CAT exp exp (from exp)
   | MEM exp exp (from exp)
   | LEN exp (from exp)
   | DOT exp atom (from exp)
   | IDX exp exp (from exp)
   | SLICE exp exp exp (from exp)
   | UPD exp path exp (from exp)
   | CALL id targ* arg* (from exp)
   | ITER exp iterexp (from exp)

syntax expcase =
   | mixop exp* (from expcase)

syntax expfield =
   | atom exp (from expfield)

syntax iterexp =
   | iter vari* (from iterexp)

syntax listpattern =
   | CONS (from listpattern)
   | FIXED nat (from listpattern)
   | NIL (from listpattern)

syntax optpattern =
   | SOME (from optpattern)
   | NONE (from optpattern)

syntax pattern =
   | INJ mixop (from pattern)
   | CONS (from listpattern)
   | FIXED nat (from listpattern)
   | NIL (from listpattern)
   | SOME (from optpattern)
   | NONE (from optpattern)

syntax path =
   | ROOT (from path)
   | IDX path exp (from path)
   | SLICE path exp exp (from path)
   | DOT path atom (from path)

syntax targ = typ

syntax arg =
   | EXP exp (from arg)
   | FUN id (from arg)

syntax tparam = id

syntax param =
   | EXP typ (from param)
   | FUN id ':' tparam* param* '->' typ (from param)

syntax iterprem =
   | iter vari* vari* (from iterprem)

syntax prem =
   | REL id ':' exp* '->' exp* (from prem)
   | IF exp (from prem)
   | IFHOLD id ':' exp* (from prem)
   | IFNOTHOLD id ':' exp* (from prem)
   | LET exp '=' exp (from prem)
   | ITER prem iterprem (from prem)
   | DEBUG exp (from prem)

syntax rulmatch =
   | exp* '-' prem* (from rulmatch)

syntax rulpath =
   | id '=' exp* '-' prem* (from rulpath)

syntax rulgroup =
   | id ':' rulmatch '=' rulpath* (from rulgroup)

syntax elsgroup =
   | id ':' rulmatch '=' rulpath (from elsgroup)

syntax clause =
   | arg* '=' exp '-' prem* (from clause)

syntax elsclause = clause

syntax tblrow =
   | arg* '=' exp '-' prem* (from tblrow)

syntax defn =
   | EXTTYP id (from defn)
   | TYP id tparam* '=' deftyp (from defn)
   | EXTREL id ':' typ* '->' typ* (from defn)
   | REL id ':' typ* '->' typ* '=' rulgroup* elsgroup? (from defn)
   | EXTFUNC id tparam* param* ':' typ (from defn)
   | BUILTINFUNC id tparam* param* ':' typ (from defn)
   | TABLEFUNC id param* ':' typ '=' tblrow* (from defn)
   | FUNC id tparam* param* ':' typ '=' clause* elsclause? (from defn)

syntax script = defn*

syntax varr =
   | id iter* (from varr)

syntax venv = map<varr, val>

syntax typdef =
   | PARAM (from typdef)
   | EXT (from typdef)
   | DEF tparam* '->' deftyp (from typdef)

syntax tdenv = map<id, typdef>

syntax theta = map<id, typ>

def $extend_tdenv(tdenv, tdenv) : tdenv =

  clause 0 : (tdenv_global, `{ [] `}) = tdenv_global

  clause -1 : (tdenv_global, `{ id ':' typdef*{id <- id*, typdef <- typdef*} `}) = $adds_map<id, typdef>(tdenv_global, id*{id <- id*}, typdef*{typdef <- typdef*})

def $theta_of_tdenv(tdenv) : theta =

  clause 0 : (`{ [] `}) = $empty_map<id, typ>

  clause 1 : (`{ id_h ':' typdef_h :: id_t ':' typdef_t*{id_t <- id_t*, typdef_t <- typdef_t*} `}) = $add_map<id, typ>(theta_t, id_h, typ_h)
  -- if (typdef_h = DEF [] '->' ALIAS typ_h)
  -- if (theta_t = $theta_of_tdenv(`{ id_t ':' typdef_t*{id_t <- id_t*, typdef_t <- typdef_t*} `}))

  clause 2 : (`{ id_h ':' typdef_h :: id_t ':' typdef_t*{id_t <- id_t*, typdef_t <- typdef_t*} `}) = $theta_of_tdenv(`{ id_t ':' typdef_t*{id_t <- id_t*, typdef_t <- typdef_t*} `})
  -- if ((typdef_h = PARAM) \/ (typdef_h = EXT))

def $is_iter_on_var(exp) : varr? =

  clause 0 : (VAR id) = ?(id [])

  clause 1 : (ITER exp iterexp) = ?(id iter*{iter <- iter*} ++ [iter_outer])
  -- if (?(id iter*{iter <- iter*}) = $is_iter_on_var(exp))
  -- if (iter_outer [id _typ iter*{iter <- iter*}] = iterexp)

  clause -1 : (_exp) = ?()

def $iter_vari(vari, iter) : vari =

  clause 0 : (id typ iter*{iter <- iter*}, iter_add) = id typ iter*{iter <- iter*} ++ [iter_add]

def $iter_varr(varr, iter) : varr =

  clause 0 : (id iter*{iter <- iter*}, iter_add) = id iter*{iter <- iter*} ++ [iter_add]

syntax externRelDef =
   | EXT id (from externRelDef)

syntax definedRelDef =
   | DEF rulgroup* elsgroup? (from definedRelDef)

syntax reldef =
   | EXT id (from externRelDef)
   | DEF rulgroup* elsgroup? (from definedRelDef)

syntax renv = map<id, reldef>

syntax externFuncDef =
   | EXT id tparam* param* typ (from externFuncDef)

syntax builtinFuncDef =
   | BUILTIN id tparam* param* typ (from builtinFuncDef)

syntax tableFuncDef =
   | TABLE param* typ '->' tblrow* (from tableFuncDef)

syntax definedFuncDef =
   | DEF tparam* param* typ '->' clause* elsclause? (from definedFuncDef)

syntax funcdef =
   | EXT id tparam* param* typ (from externFuncDef)
   | BUILTIN id tparam* param* typ (from builtinFuncDef)
   | TABLE param* typ '->' tblrow* (from tableFuncDef)
   | DEF tparam* param* typ '->' clause* elsclause? (from definedFuncDef)

syntax fenv = map<id, funcdef>

syntax cursor =
   | GLOBAL (from cursor)
   | LOCAL (from cursor)

syntax layer = {TYP tdenv, REL renv, FUNC fenv, VAL venv}

def $empty_layer : layer =

  clause 0 :  = {TYP $empty_map<id, typdef>, REL $empty_map<id, reldef>, FUNC $empty_map<id, funcdef>, VAL $empty_map<varr, val>}

syntax ctx = {GLOBAL layer, LOCAL layer}

def $empty_ctx : ctx =

  clause 0 :  = {GLOBAL $empty_layer, LOCAL $empty_layer}

var C : ctx

def $load_typdef(ctx, id, typdef) : ctx =

  clause 0 : (C, id, typdef) = C[GLOBAL.TYP = tdenv_update]
  -- if (tdenv_update = $add_map<id, typdef>(C.GLOBAL.TYP, id, typdef))

def $load_reldef(ctx, id, reldef) : ctx =

  clause 0 : (C, id, reldef) = C[GLOBAL.REL = renv_update]
  -- if (renv_update = $add_map<id, reldef>(C.GLOBAL.REL, id, reldef))

def $load_funcdef(ctx, id, funcdef) : ctx =

  clause 0 : (C, id, funcdef) = C[GLOBAL.FUNC = fenv_update]
  -- if (fenv_update = $add_map<id, funcdef>(C.GLOBAL.FUNC, id, funcdef))

def $load(ctx, script) : ctx =

  clause 0 : (C, defn_h :: defn_t*{defn_t <- defn_t*}) = $load(C', defn_t*{defn_t <- defn_t*})
  -- if (EXTTYP id = defn_h)
  -- if (C' = $load_typdef(C, id, EXT))

  clause 1 : (C, defn_h :: defn_t*{defn_t <- defn_t*}) = $load(C', defn_t*{defn_t <- defn_t*})
  -- if (TYP id tparam*{tparam <- tparam*} '=' deftyp = defn_h)
  -- if (C' = $load_typdef(C, id, DEF tparam*{tparam <- tparam*} '->' deftyp))

  clause 2 : (C, defn_h :: defn_t*{defn_t <- defn_t*}) = $load(C', defn_t*{defn_t <- defn_t*})
  -- if (EXTREL id ':' typ_input*{typ_input <- typ_input*} '->' typ_output*{typ_output <- typ_output*} = defn_h)
  -- if (C' = $load_reldef(C, id, EXT id as reldef))

  clause 3 : (C, defn_h :: defn_t*{defn_t <- defn_t*}) = $load(C', defn_t*{defn_t <- defn_t*})
  -- if (REL id ':' typ_input*{typ_input <- typ_input*} '->' typ_output*{typ_output <- typ_output*} '=' rulgroup*{rulgroup <- rulgroup*} elsgroup?{elsgroup <- elsgroup?} = defn_h)
  -- if (C' = $load_reldef(C, id, DEF rulgroup*{rulgroup <- rulgroup*} elsgroup?{elsgroup <- elsgroup?} as reldef))

  clause 4 : (C, defn_h :: defn_t*{defn_t <- defn_t*}) = $load(C', defn_t*{defn_t <- defn_t*})
  -- if (EXTFUNC id tparam*{tparam <- tparam*} param*{param <- param*} ':' typ = defn_h)
  -- if (C' = $load_funcdef(C, id, EXT id tparam*{tparam <- tparam*} param*{param <- param*} typ as funcdef))

  clause 5 : (C, defn_h :: defn_t*{defn_t <- defn_t*}) = $load(C', defn_t*{defn_t <- defn_t*})
  -- if (BUILTINFUNC id tparam*{tparam <- tparam*} param*{param <- param*} ':' typ = defn_h)
  -- if (C' = $load_funcdef(C, id, BUILTIN id tparam*{tparam <- tparam*} param*{param <- param*} typ as funcdef))

  clause 6 : (C, defn_h :: defn_t*{defn_t <- defn_t*}) = $load(C', defn_t*{defn_t <- defn_t*})
  -- if (TABLEFUNC id param*{param <- param*} ':' typ '=' tblrow*{tblrow <- tblrow*} = defn_h)
  -- if (C' = $load_funcdef(C, id, TABLE param*{param <- param*} typ '->' tblrow*{tblrow <- tblrow*} as funcdef))

  clause 7 : (C, defn_h :: defn_t*{defn_t <- defn_t*}) = $load(C', defn_t*{defn_t <- defn_t*})
  -- if (FUNC id tparam*{tparam <- tparam*} param*{param <- param*} ':' typ '=' clause*{clause <- clause*} elsclause?{elsclause <- elsclause?} = defn_h)
  -- if (C' = $load_funcdef(C, id, DEF tparam*{tparam <- tparam*} param*{param <- param*} typ '->' clause*{clause <- clause*} elsclause?{elsclause <- elsclause?} as funcdef))

  clause 8 : (C, []) = C

def $add_vari(ctx, vari, val) : ctx =

  clause 0 : (C, vari, val) = C[LOCAL.VAL = venv_update]
  -- if (id _typ iter*{iter <- iter*} = vari)
  -- if (venv_update = $add_map<varr, val>(C.LOCAL.VAL, id iter*{iter <- iter*}, val))

def $add_varr(ctx, varr, val) : ctx =

  clause 0 : (C, varr, val) = C[LOCAL.VAL = venv_update]
  -- if (venv_update = $add_map<varr, val>(C.LOCAL.VAL, varr, val))

def $add_varis(ctx, vari*, val*) : ctx =

  clause 0 : (C, vari*{vari <- vari*}, val*{val <- val*}) = C[LOCAL.VAL = venv_update]
  -- (if (id _typ iter*{iter <- iter*} = vari))*{_typ <- _typ*, id <- id*, iter* <- iter**, vari <- vari*}
  -- if (venv_update = $adds_map<varr, val>(C.LOCAL.VAL, id iter*{iter <- iter*}*{id <- id*, iter* <- iter**}, val*{val <- val*}))

def $add_varrs(ctx, varr*, val*) : ctx =

  clause 0 : (C, varr*{varr <- varr*}, val*{val <- val*}) = C[LOCAL.VAL = venv_update]
  -- if (venv_update = $adds_map<varr, val>(C.LOCAL.VAL, varr*{varr <- varr*}, val*{val <- val*}))

def $add_typ(ctx, id, typdef) : ctx =

  clause 0 : (C, id, typdef) = C[LOCAL.TYP = tdenv_update]
  -- if (tdenv_update = $add_map<id, typdef>(C.LOCAL.TYP, id, typdef))

def $add_func(ctx, id, funcdef) : ctx =

  clause 0 : (C, id, funcdef) = C[LOCAL.FUNC = fenv_update]
  -- if (fenv_update = $add_map<id, funcdef>(C.LOCAL.FUNC, id, funcdef))

def $find_vari(ctx, vari) : val? =

  clause 0 : (C, vari) = ?(val)
  -- if (id _typ iter*{iter <- iter*} = vari)
  -- if (?(val) = $find_map<varr, val>(C.LOCAL.VAL, id iter*{iter <- iter*}))

def $find_varr(ctx, varr) : val? =

  clause 0 : (C, varr) = $find_map<varr, val>(C.LOCAL.VAL, varr)

def $find_varis(ctx, vari*) : val*? =

  clause 0 : (C, vari*{vari <- vari*}) = ?(val*{val <- val*})
  -- (if (?(val) = $find_vari(C, vari)))*{val <- val*, vari <- vari*}

  clause -1 : (C, vari*{vari <- vari*}) = ?()

def $find_varrs(ctx, varr*) : val*? =

  clause 0 : (C, varr*{varr <- varr*}) = ?(val*{val <- val*})
  -- (if (?(val) = $find_map<varr, val>(C.LOCAL.VAL, varr)))*{val <- val*, varr <- varr*}

  clause -1 : (C, varr*{varr <- varr*}) = ?()

def $finds_vari(ctx*, vari) : val*? =

  clause 0 : (C*{C <- C*}, vari) = ?(val*{val <- val*})
  -- if (id _typ iter*{iter <- iter*} = vari)
  -- (if (?(val) = $find_map<varr, val>(C.LOCAL.VAL, id iter*{iter <- iter*})))*{C <- C*, val <- val*}

  clause -1 : (C*{C <- C*}, vari) = ?()

def $find_typ(ctx, id) : typdef? =

  clause 0 : (C, id) = ?(typdef)
  -- if (?(typdef) = $find_map<id, typdef>(C.LOCAL.TYP, id))

  clause 1 : (C, id) = $find_map<id, typdef>(C.GLOBAL.TYP, id)
  -- if (?() = $find_map<id, typdef>(C.LOCAL.TYP, id))

def $find_func(ctx, id) : funcdef? =

  clause 0 : (C, id) = ?(funcdef)
  -- if (?(funcdef) = $find_map<id, funcdef>(C.LOCAL.FUNC, id))

  clause 1 : (C, id) = ?(funcdef)
  -- if (?() = $find_map<id, funcdef>(C.LOCAL.FUNC, id))
  -- if (?(funcdef) = $find_map<id, funcdef>(C.GLOBAL.FUNC, id))

  clause -1 : (C, id) = ?()

def $find_rel(ctx, id) : reldef? =

  clause 0 : (C, id) = $find_map<id, reldef>(C.GLOBAL.REL, id)

def $sub_opt(ctx, vari*) : ctx? =

  clause 0 : (C, vari*{vari <- vari*}) = ?($add_varis(C, vari*{vari <- vari*}, val*{val <- val*}))
  -- (if (vari_iter = $iter_vari(vari, QUEST)))*{vari <- vari*, vari_iter <- vari_iter*}
  -- (if (?(OPT ?(val)) = $find_vari(C, vari_iter)))*{val <- val*, vari_iter <- vari_iter*}

  clause 1 : (C, vari*{vari <- vari*}) = ?()
  -- (if (vari_iter = $iter_vari(vari, QUEST)))*{vari <- vari*, vari_iter <- vari_iter*}
  -- (if (?(OPT ?()) = $find_vari(C, vari_iter)))*{vari_iter <- vari_iter*}

def $sub_list(ctx, vari*) : ctx* =

  clause 0 : (C, vari*{vari <- vari*}) = C'*{C' <- C'*}
  -- (if (vari_iter = $iter_vari(vari, STAR)))*{vari <- vari*, vari_iter <- vari_iter*}
  -- (if (?(LIST val*{val <- val*}) = $find_vari(C, vari_iter)))*{val* <- val**, vari_iter <- vari_iter*}
  -- if (val_trans*{val_trans <- val_trans*}*{val_trans* <- val_trans**} = $transpose_<val>(val*{val <- val*}*{val* <- val**}))
  -- (if (C' = $add_varis(C, vari*{vari <- vari*}, val_trans*{val_trans <- val_trans*})))*{C' <- C'*, val_trans* <- val_trans**}

syntax unitres =
   | OK (from unitres)
   | FAIL (from unitres)

syntax res<X> =
   | OK X (from res<X>)
   | FAIL (from res<X>)

syntax valres = res<val>

syntax valsres = res<val*>

extern relation Call_extern_func: |- id `< typ* `> `( val* `) : res<val>

extern relation Call_builtin_func: |- id '@' `< typ* `> `( val* `) : res<val>

extern relation Call_extern_rel: |- id val* : res<val*>

syntax ctxres = res<ctx>

relation Eval_exp: ctx |- exp : res<val>

  rulegroup literal

    rule boolean: C |- BOOL b : OK BOOL b

    rule number: C |- num as exp : OK num as val

    rule string: C |- TEXT t : OK TEXT t

  rulegroup variable

    rule variable: C |- VAR id : OK val
    -- if (?(val) = $find_varr(C, id []))

  rulegroup unary

    rule boolean: C |- UN NOT as unop exp : OK BOOL ~b
    -- Eval_exp: C |- exp : OK BOOL b

    rule number: C |- UN numunop as unop exp : OK val_res
    -- Eval_exp: C |- exp : OK num as val
    -- if (val_res = $unop_number(numunop, num))

  rulegroup binary

    rule boolean: C |- BIN boolbinop as binop exp_l exp_r : OK BOOL b_res
    -- Eval_exp: C |- exp_l : OK BOOL b_l
    -- Eval_exp: C |- exp_r : OK BOOL b_r
    -- if (b_res = $binop_bool(boolbinop, b_l, b_r))

    rule number: C |- BIN numbinop as binop exp_l exp_r : OK val_res
    -- Eval_exp: C |- exp_l : OK num_l as val
    -- Eval_exp: C |- exp_r : OK num_r as val
    -- if (val_res = $binop_number(numbinop, num_l, num_r))

  rulegroup compare

    rule poly: C |- CMP polycmpop as cmpop exp_l exp_r : OK BOOL b_res
    -- Eval_exp: C |- exp_l : OK val_l
    -- Eval_exp: C |- exp_r : OK val_r
    -- if (b_res = $cmpop_poly(polycmpop, val_l, val_r))

    rule number: C |- CMP numcmpop as cmpop exp_l exp_r : OK BOOL b_res
    -- Eval_exp: C |- exp_l : OK num_l as val
    -- Eval_exp: C |- exp_r : OK num_r as val
    -- if (b_res = $cmpop_number(numcmpop, num_l, num_r))

  rulegroup upcast

    rule upcast: C |- UPCAST typ exp : $upcast(C, typ, val)
    -- Eval_exp: C |- exp : OK val

  rulegroup downcast

    rule downcast: C |- DOWNCAST typ exp : $downcast(C, typ, val)
    -- Eval_exp: C |- exp : OK val

  rulegroup subtype

    rule subtype: C |- SUB exp typ : OK BOOL b
    -- Eval_exp: C |- exp : OK val
    -- if (b = $subtyp(C, typ, val))

  rulegroup match

    rule inj: C |- MATCH exp INJ mixop_p : OK BOOL (mixop_p = mixop_v)
    -- Eval_exp: C |- exp : OK INJ mixop_v _val*{_val <- _val*}

    rule list-cons: C |- MATCH exp CONS as pattern : OK BOOL (|val*{val <- val*}| > 0)
    -- Eval_exp: C |- exp : OK LIST val*{val <- val*}

    rule list-fixed: C |- MATCH exp FIXED n as pattern : OK BOOL (|val*{val <- val*}| = n)
    -- Eval_exp: C |- exp : OK LIST val*{val <- val*}

    rule list-nil: C |- MATCH exp NIL as pattern : OK BOOL (|val*{val <- val*}| = 0)
    -- Eval_exp: C |- exp : OK LIST val*{val <- val*}

    rule opt-some: C |- MATCH exp SOME as pattern : OK BOOL (val?{val <- val?} =/= ?())
    -- Eval_exp: C |- exp : OK OPT val?{val <- val?}

    rule opt-none: C |- MATCH exp NONE as pattern : OK BOOL (val?{val <- val?} = ?())
    -- Eval_exp: C |- exp : OK OPT val?{val <- val?}

  rulegroup tuple

    rule tuple: C |- TUP exp*{exp <- exp*} : OK TUP val*{val <- val*}
    -- (Eval_exp: C |- exp : OK val)*{exp <- exp*, val <- val*}

  rulegroup case

    rule case: C |- INJ mixop exp*{exp <- exp*} : OK INJ mixop val*{val <- val*}
    -- (Eval_exp: C |- exp : OK val)*{exp <- exp*, val <- val*}

  rulegroup struct

    rule struct: C |- STR expfield*{expfield <- expfield*} : OK STR valfield*{valfield <- valfield*}
    -- (if (atom exp = expfield))*{atom <- atom*, exp <- exp*, expfield <- expfield*}
    -- (Eval_exp: C |- exp : OK val)*{exp <- exp*, val <- val*}
    -- (if (valfield = atom val))*{atom <- atom*, val <- val*, valfield <- valfield*}

  rulegroup opt

    rule some: C |- OPT ?(exp) : OK OPT ?(val)
    -- Eval_exp: C |- exp : OK val

    rule none: C |- OPT ?() : OK OPT ?()

  rulegroup list

    rule list: C |- LIST exp*{exp <- exp*} : OK LIST val*{val <- val*}
    -- (Eval_exp: C |- exp : OK val)*{exp <- exp*, val <- val*}

  rulegroup cons

    rule cons: C |- CONS exp_h exp_t : OK LIST val_h :: val_t*{val_t <- val_t*}
    -- Eval_exp: C |- exp_h : OK val_h
    -- Eval_exp: C |- exp_t : OK LIST val_t*{val_t <- val_t*}

  rulegroup concat

    rule text: C |- CAT exp_l exp_r : OK TEXT text_l ++ text_r
    -- Eval_exp: C |- exp_l : OK TEXT text_l
    -- Eval_exp: C |- exp_r : OK TEXT text_r

    rule list: C |- CAT exp_l exp_r : OK LIST val_l*{val_l <- val_l*} ++ val_r*{val_r <- val_r*}
    -- Eval_exp: C |- exp_l : OK LIST val_l*{val_l <- val_l*}
    -- Eval_exp: C |- exp_r : OK LIST val_r*{val_r <- val_r*}

  rulegroup mem

    rule mem: C |- MEM exp_e exp_s : OK BOOL $exists_((val_e = val)*{val <- val*})
    -- Eval_exp: C |- exp_e : OK val_e
    -- Eval_exp: C |- exp_s : OK LIST val*{val <- val*}

  rulegroup len

    rule text: C |- LEN exp : OK NAT |text| as val
    -- Eval_exp: C |- exp : OK TEXT text

    rule list: C |- LEN exp : OK NAT |val*{val <- val*}| as val
    -- Eval_exp: C |- exp : OK LIST val*{val <- val*}

  rulegroup dot

    rule dot: C |- DOT exp atom : valres
    -- Eval_exp: C |- exp : OK val
    -- Eval_path: C |- val DOT ROOT atom : valres

  rulegroup idx

    rule idx: C |- IDX exp_b exp_i : valres
    -- Eval_exp: C |- exp_b : OK val_b
    -- Eval_path: C |- val_b IDX ROOT exp_i : valres

  rulegroup slice

    rule slice: C |- SLICE exp_b exp_i exp_n : valres
    -- Eval_exp: C |- exp_b : OK val_b
    -- Eval_path: C |- val_b SLICE ROOT exp_i exp_n : valres

  rulegroup upd

    rule upd: C |- UPD exp_b path exp_f : valres
    -- Eval_exp: C |- exp_b : OK val_b
    -- Eval_exp: C |- exp_f : OK val_f
    -- Eval_path_upd: C |- val_b path := val_f : valres

  rulegroup call

    rule call: C |- CALL id targ*{targ <- targ*} arg*{arg <- arg*} : valres
    -- Eval_targs: C |- targ*{targ <- targ*} : typ_input*{typ_input <- typ_input*}
    -- (Eval_arg: C |- arg : OK val_input)*{arg <- arg*, val_input <- val_input*}
    -- Call_func: C |- id typ_input*{typ_input <- typ_input*} val_input*{val_input <- val_input*} : valres

  rulegroup iter

    rule simple: C |- ITER exp iterexp : OK val
    -- if (?(varr) = $is_iter_on_var(ITER exp iterexp))
    -- if (?(val) = $find_varr(C, varr))

    rule opt: C |- ITER exp iterexp : OK OPT val?{val <- val?}
    -- if (?() = $is_iter_on_var(ITER exp iterexp))
    -- if (QUEST vari*{vari <- vari*} = iterexp)
    -- if (C_sub?{C_sub <- C_sub?} = $sub_opt(C, vari*{vari <- vari*}))
    -- (Eval_exp: C_sub |- exp : OK val)?{C_sub <- C_sub?, val <- val?}

    rule list: C |- ITER exp iterexp : OK LIST val*{val <- val*}
    -- if (?() = $is_iter_on_var(ITER exp iterexp))
    -- if (STAR vari*{vari <- vari*} = iterexp)
    -- if (C_sub*{C_sub <- C_sub*} = $sub_list(C, vari*{vari <- vari*}))
    -- (Eval_exp: C_sub |- exp : OK val)*{C_sub <- C_sub*, val <- val*}

  elsegroup

  rulegroup fail

    rule fail: C |- exp : FAIL

relation Eval_targs: ctx |- targ* : typ*

  rulegroup

    rule : C |- targ*{targ <- targ*} : targ_subst*{targ_subst <- targ_subst*}
    -- if (theta = $theta_of_tdenv(C.LOCAL.TYP))
    -- (if (targ_subst = $subst_typ(theta, targ)))*{targ <- targ*, targ_subst <- targ_subst*}

relation Eval_arg: ctx |- arg : res<val>

  rulegroup exp

    rule exp: C |- EXP exp : OK val
    -- Eval_exp: C |- exp : OK val

  rulegroup fun

    rule fun: C |- FUN id : OK FUNC id

  elsegroup

  rulegroup fail

    rule fail: C |- arg : FAIL

relation Eval_prem: ctx |- prem : res<ctx>

  rulegroup relpr

    rule relpr: C |- REL id ':' exp*{exp <- exp*} '->' exp_out*{exp_out <- exp_out*} : OK C'
    -- (Eval_exp: C |- exp : OK val)*{exp <- exp*, val <- val*}
    -- Call_rel: C |- id val*{val <- val*} : OK val_out*{val_out <- val_out*}
    -- Assign_exps: C |- exp_out*{exp_out <- exp_out*} := val_out*{val_out <- val_out*} : C'

  rulegroup ifpr

    rule true: C |- IF exp : OK C
    -- Eval_exp: C |- exp : OK BOOL true

    rule false: C |- IF exp : FAIL
    -- Eval_exp: C |- exp : OK BOOL false

  rulegroup ifholdpr

    rule hold: C |- IFHOLD id ':' exp*{exp <- exp*} : OK C
    -- (Eval_exp: C |- exp : OK val_input)*{exp <- exp*, val_input <- val_input*}
    -- Call_rel: C |- id val_input*{val_input <- val_input*} : OK []

    rule nothold: C |- IFNOTHOLD id ':' exp*{exp <- exp*} : OK C
    -- (Eval_exp: C |- exp : OK val_input)*{exp <- exp*, val_input <- val_input*}
    -- Call_rel: C |- id val_input*{val_input <- val_input*} : FAIL

  rulegroup letpr

    rule letpr: C |- LET exp_l '=' exp_r : OK C'
    -- Eval_exp: C |- exp_r : OK val_r
    -- Assign_exp: C |- exp_l := val_r : C'

  rulegroup iterpr-opt

    rule none: C |- ITER prem iterprem : OK C_res
    -- if (QUEST vari_bound*{vari_bound <- vari_bound*} vari_bind*{vari_bind <- vari_bind*} = iterprem)
    -- if (?() = $sub_opt(C, vari_bound*{vari_bound <- vari_bound*}))
    -- (if (vari_bind_iter = $iter_vari(vari_bind, QUEST)))*{vari_bind <- vari_bind*, vari_bind_iter <- vari_bind_iter*}
    -- if (val_bind*{val_bind <- val_bind*} = $repeat_<val>(OPT ?(), |vari_bind*{vari_bind <- vari_bind*}|))
    -- if (C_res = $add_varis(C, vari_bind_iter*{vari_bind_iter <- vari_bind_iter*}, val_bind*{val_bind <- val_bind*}))

    rule some: C |- ITER prem iterprem : OK C_res
    -- if (QUEST vari_bound*{vari_bound <- vari_bound*} vari_bind*{vari_bind <- vari_bind*} = iterprem)
    -- if (?(C_sub) = $sub_opt(C, vari_bound*{vari_bound <- vari_bound*}))
    -- (if (vari_bind_iter = $iter_vari(vari_bind, QUEST)))*{vari_bind <- vari_bind*, vari_bind_iter <- vari_bind_iter*}
    -- Eval_prem: C_sub |- prem : OK C_sub_res
    -- (if (?(val_bind) = $find_vari(C_sub_res, vari_bind)))*{val_bind <- val_bind*, vari_bind <- vari_bind*}
    -- if (C_res = $add_varis(C, vari_bind_iter*{vari_bind_iter <- vari_bind_iter*}, OPT ?(val_bind)*{val_bind <- val_bind*}))

  rulegroup iterpr-list

    rule empty: C |- ITER prem iterprem : OK C_res
    -- if (STAR vari_bound*{vari_bound <- vari_bound*} vari_bind*{vari_bind <- vari_bind*} = iterprem)
    -- if ([] = $sub_list(C, vari_bound*{vari_bound <- vari_bound*}))
    -- (if (vari_bind_iter = $iter_vari(vari_bind, STAR)))*{vari_bind <- vari_bind*, vari_bind_iter <- vari_bind_iter*}
    -- if (val_bind*{val_bind <- val_bind*} = $repeat_<val>(LIST [], |vari_bind*{vari_bind <- vari_bind*}|))
    -- if (C_res = $add_varis(C, vari_bind_iter*{vari_bind_iter <- vari_bind_iter*}, val_bind*{val_bind <- val_bind*}))

    rule list: C |- ITER prem iterprem : OK C_res
    -- if (STAR vari_bound*{vari_bound <- vari_bound*} vari_bind*{vari_bind <- vari_bind*} = iterprem)
    -- if (C_sub*{C_sub <- C_sub*} = $sub_list(C, vari_bound*{vari_bound <- vari_bound*}))
    -- if (C_sub*{C_sub <- C_sub*} =/= [])
    -- (Eval_prem: C_sub |- prem : OK C_sub_res)*{C_sub <- C_sub*, C_sub_res <- C_sub_res*}
    -- (if (?(val_sub_bind*{val_sub_bind <- val_sub_bind*}) = $find_varis(C_sub_res, vari_bind*{vari_bind <- vari_bind*})))*{C_sub_res <- C_sub_res*, val_sub_bind* <- val_sub_bind**}
    -- if (val_bind*{val_bind <- val_bind*}*{val_bind* <- val_bind**} = $transpose_<val>(val_sub_bind*{val_sub_bind <- val_sub_bind*}*{val_sub_bind* <- val_sub_bind**}))
    -- (if (val_res_bind = LIST val_bind*{val_bind <- val_bind*}))*{val_bind* <- val_bind**, val_res_bind <- val_res_bind*}
    -- (if (vari_bind_iter = $iter_vari(vari_bind, STAR)))*{vari_bind <- vari_bind*, vari_bind_iter <- vari_bind_iter*}
    -- if (C_res = $add_varis(C, vari_bind_iter*{vari_bind_iter <- vari_bind_iter*}, val_res_bind*{val_res_bind <- val_res_bind*}))

  rulegroup dbg

    rule dbg: C |- DEBUG exp : OK C
    -- Eval_exp: C |- exp : OK val
    -- debug val

  elsegroup

  rulegroup fail

    rule fail: C |- prem : FAIL

relation Eval_prems: ctx |- prem* : res<ctx>

  rulegroup

    rule empty: C |- [] : OK C

    rule head-fail: C |- prem_h :: prem_t*{prem_t <- prem_t*} : FAIL
    -- Eval_prem: C |- prem_h : FAIL

    rule head-succ: C |- prem_h :: prem_t*{prem_t <- prem_t*} : ctxres
    -- Eval_prem: C |- prem_h : OK C'
    -- Eval_prems: C' |- prem_t*{prem_t <- prem_t*} : ctxres

relation Call_func_dispatch: ctx |- funcdef targ* val* : res<val>

  rulegroup

    rule extern: C |- EXT id _tparam*{_tparam <- _tparam*} _param*{_param <- _param*} _typ as funcdef typ*{typ <- typ*} val*{val <- val*} : valres
    -- Call_extern_func: |- id `< typ*{typ <- typ*} `> `( val*{val <- val*} `) : valres

    rule builtin: C |- builtinFuncDef as funcdef typ*{typ <- typ*} val*{val <- val*} : valres
    -- if (BUILTIN id _tparam*{_tparam <- _tparam*} _param*{_param <- _param*} _typ = builtinFuncDef)
    -- Call_builtin_func: |- id '@' `< typ*{typ <- typ*} `> `( val*{val <- val*} `) : valres

    rule table: C |- tableFuncDef as funcdef [] val*{val <- val*} : valres
    -- Call_table_func: C |- tableFuncDef '@' `( val*{val <- val*} `) : valres

    rule defined: C |- definedFuncDef as funcdef typ*{typ <- typ*} val*{val <- val*} : valres
    -- Call_defined_func: C |- definedFuncDef '@' `< typ*{typ <- typ*} `> `( val*{val <- val*} `) : valres

relation Call_func: ctx |- id targ* val* : res<val>

  rulegroup

    rule : C |- id typ*{typ <- typ*} val*{val <- val*} : valres
    -- if (?(funcdef) = $find_func(C, id))
    -- Call_func_dispatch: C |- funcdef typ*{typ <- typ*} val*{val <- val*} : valres

relation Call_rel_dispatch: ctx |- reldef val* : res<val*>

  rulegroup

    rule defined: C |- definedRelDef as reldef val*{val <- val*} : valsres
    -- Call_defined_rel: C |- definedRelDef '@' `( val*{val <- val*} `) : valsres

    rule ext: C |- EXT id as reldef val*{val <- val*} : valsres
    -- Call_extern_rel: |- id val*{val <- val*} : valsres

relation Call_rel: ctx |- id val* : res<val*>

  rulegroup

    rule : C |- id val*{val <- val*} : valsres
    -- if (?(reldef) = $find_rel(C, id))
    -- Call_rel_dispatch: C |- reldef val*{val <- val*} : valsres

def $unop_number(numunop, num) : val =

  clause 0 : (PLUS, NAT n) = NAT n as val

  clause 1 : (PLUS, INT i) = INT i as val

  clause 2 : (MINUS, NAT n) = INT -n as int as val

  clause 3 : (MINUS, INT i) = INT -i as val

def $binop_bool(boolbinop, bool, bool) : bool =

  clause 0 : (AND, b_l, b_r) = (b_l /\ b_r)

  clause 1 : (OR, b_l, b_r) = (b_l \/ b_r)

  clause 2 : (IMPL, b_l, b_r) = (b_l => b_r)

  clause 3 : (EQUIV, b_l, b_r) = (b_l <=> b_r)

def $binop_number(numbinop, num, num) : val =

  clause 0 : (ADD, NAT n_l, NAT n_r) = NAT (n_l + n_r) as val

  clause 1 : (ADD, INT i_l, INT i_r) = INT (i_l + i_r) as val

  clause 2 : (SUB, NAT n_l, NAT n_r) = INT (n_l - n_r) as val

  clause 3 : (SUB, INT i_l, INT i_r) = INT (i_l - i_r) as val

  clause 4 : (MUL, NAT n_l, NAT n_r) = NAT (n_l * n_r) as val

  clause 5 : (MUL, INT i_l, INT i_r) = INT (i_l * i_r) as val

  clause 6 : (DIV, NAT n_l, NAT n_r) = NAT (n_l / n_r) as val

  clause 7 : (DIV, INT i_l, INT i_r) = INT (i_l / i_r) as val

  clause 8 : (MOD, NAT n_l, NAT n_r) = NAT (n_l \ n_r) as val

  clause 9 : (MOD, INT i_l, INT i_r) = INT (i_l \ i_r) as val

  clause 10 : (POW, NAT n_l, NAT n_r) = NAT (n_l ^ n_r) as val

  clause 11 : (POW, INT i_l, INT i_r) = INT (i_l ^ i_r) as val

def $cmpop_poly(polycmpop, val, val) : bool =

  clause 0 : (EQ, val_l, val_r) = (val_l = val_r)

  clause 1 : (NE, val_l, val_r) = (val_l =/= val_r)

def $cmpop_number(numcmpop, num, num) : bool =

  clause 0 : (LT, NAT n_l, NAT n_r) = (n_l < n_r)

  clause 1 : (LT, INT i_l, INT i_r) = (i_l < i_r)

  clause 2 : (GT, NAT n_l, NAT n_r) = (n_l > n_r)

  clause 3 : (GT, INT i_l, INT i_r) = (i_l > i_r)

  clause 4 : (LE, NAT n_l, NAT n_r) = (n_l <= n_r)

  clause 5 : (LE, INT i_l, INT i_r) = (i_l <= i_r)

  clause 6 : (GE, NAT n_l, NAT n_r) = (n_l >= n_r)

  clause 7 : (GE, INT i_l, INT i_r) = (i_l >= i_r)

def $is_tup(val) : bool =

  clause 0 : (TUP val*{val <- val*}) = true

  clause -1 : (val) = false

def $is_fun(val) : bool =

  clause 0 : (FUNC id) = true

  clause -1 : (val) = false

def $ids_typ(typ) : id* =

  clause 0 : (VAR id typ*{typ <- typ*}) = [id] ++ $ids_typs(typ*{typ <- typ*})

  clause 1 : (TUP typ*{typ <- typ*}) = $ids_typs(typ*{typ <- typ*})

  clause 2 : (ITER typ iter) = $ids_typ(typ)

  clause 3 : (FUNC tparam*{tparam <- tparam*} typ*{typ <- typ*} typ_ret) = tparam*{tparam <- tparam*} ++ $ids_typs(typ*{typ <- typ*}) ++ $ids_typ(typ_ret)

  clause -1 : (typ) = []

def $ids_typs(typ*) : id* =

  clause 0 : ([]) = []

  clause 1 : (typ_h :: typ_t*{typ_t <- typ_t*}) = $ids_typ(typ_h) ++ $ids_typs(typ_t*{typ_t <- typ_t*})

def $fresh_id(id, id*) : id =

  clause 0 : (id, id_used*{id_used <- id_used*}) = id
  -- if ~id <- id_used*{id_used <- id_used*}

  clause 1 : (id, id_used*{id_used <- id_used*}) = $fresh_id(id ++ "'", id_used*{id_used <- id_used*})
  -- if id <- id_used*{id_used <- id_used*}

def $fresh_ids(id*, id*) : id* =

  clause 0 : ([], id_used*{id_used <- id_used*}) = []

  clause 1 : (id_h :: id_t*{id_t <- id_t*}, id_used*{id_used <- id_used*}) = [id_fresh] ++ $fresh_ids(id_t*{id_t <- id_t*}, [id_fresh] ++ id_used*{id_used <- id_used*})
  -- if (id_fresh = $fresh_id(id_h, id_used*{id_used <- id_used*}))

def $subst_typ(theta, typ) : typ =

  clause 0 : (theta, NAT as typ) = NAT as typ

  clause 1 : (theta, INT as typ) = INT as typ

  clause 2 : (theta, TEXT as typ) = TEXT as typ

  clause 3 : (theta, BOOL as typ) = BOOL as typ

  clause 4 : (theta, VAR id []) = typ
  -- if (?(typ) = $find_map<id, typ>(theta, id))

  clause 5 : (theta, VAR id targ*{targ <- targ*}) = VAR id $subst_typ(theta, targ)*{targ <- targ*}
  -- if (?() = $find_map<id, typ>(theta, id))

  clause 6 : (theta, TUP typ*{typ <- typ*}) = TUP $subst_typ(theta, typ)*{typ <- typ*}

  clause 7 : (theta, ITER typ iter) = ITER $subst_typ(theta, typ) iter

  clause 8 : (theta, FUNC tparam*{tparam <- tparam*} typ*{typ <- typ*} typ_ret) = FUNC tparam_fresh*{tparam_fresh <- tparam_fresh*} typ_subst*{typ_subst <- typ_subst*} $subst_typ(theta, typ_ret_fresh)
  -- if (`{ id ':' typ_arg*{id <- id*, typ_arg <- typ_arg*} `} = theta)
  -- if (id_used*{id_used <- id_used*} = id*{id <- id*} ++ $ids_typs(typ_arg*{typ_arg <- typ_arg*}) ++ $ids_typ(FUNC tparam*{tparam <- tparam*} typ*{typ <- typ*} typ_ret))
  -- if (tparam_fresh*{tparam_fresh <- tparam_fresh*} = $fresh_ids(tparam*{tparam <- tparam*}, id_used*{id_used <- id_used*}))
  -- if (theta_fresh = `{ tparam ':' VAR tparam_fresh []*{tparam <- tparam*, tparam_fresh <- tparam_fresh*} `})
  -- if (typ_fresh*{typ_fresh <- typ_fresh*} = $subst_typ(theta_fresh, typ)*{typ <- typ*})
  -- if (typ_subst*{typ_subst <- typ_subst*} = $subst_typ(theta, typ_fresh)*{typ_fresh <- typ_fresh*})
  -- if (typ_ret_fresh = $subst_typ(theta_fresh, typ_ret))

def $param_typ(param) : typ =

  clause 0 : (EXP typ) = typ

  clause 1 : (FUN id ':' tparam*{tparam <- tparam*} param*{param <- param*} '->' typ) = FUNC tparam*{tparam <- tparam*} $param_typ(param)*{param <- param*} typ

def $func_typ(funcdef) : typ =

  clause 0 : (EXT id tparam*{tparam <- tparam*} param*{param <- param*} typ as funcdef) = FUNC tparam*{tparam <- tparam*} $param_typ(param)*{param <- param*} typ

  clause 1 : (BUILTIN id tparam*{tparam <- tparam*} param*{param <- param*} typ as funcdef) = FUNC tparam*{tparam <- tparam*} $param_typ(param)*{param <- param*} typ

  clause 2 : (TABLE param*{param <- param*} typ '->' tblrow*{tblrow <- tblrow*} as funcdef) = FUNC [] $param_typ(param)*{param <- param*} typ

  clause 3 : (DEF tparam*{tparam <- tparam*} param*{param <- param*} typ '->' clause*{clause <- clause*} elsclause?{elsclause <- elsclause?} as funcdef) = FUNC tparam*{tparam <- tparam*} $param_typ(param)*{param <- param*} typ

def $expand_typ(ctx, typ) : typ =

  clause 0 : (C, VAR id targ*{targ <- targ*}) = $expand_typ(C, $subst_typ(theta, typ))
  -- if (?(DEF tparam*{tparam <- tparam*} '->' ALIAS typ) = $find_typ(C, id))
  -- if (theta = `{ tparam ':' targ*{targ <- targ*, tparam <- tparam*} `})

  clause -1 : (C, typ) = typ

def $equiv_typ(ctx, typ, typ) : bool =

  clause 0 : (C, typ_l, typ_r) = $equiv_typ'(C, $expand_typ(C, typ_l), $expand_typ(C, typ_r))

def $equiv_typs(ctx, typ*, typ*) : bool =

  clause 0 : (C, [], []) = true

  clause 1 : (C, typ_l :: typ_l_t*{typ_l_t <- typ_l_t*}, typ_r :: typ_r_t*{typ_r_t <- typ_r_t*}) = ($equiv_typ(C, typ_l, typ_r) /\ $equiv_typs(C, typ_l_t*{typ_l_t <- typ_l_t*}, typ_r_t*{typ_r_t <- typ_r_t*}))

  clause -1 : (C, typ_l*{typ_l <- typ_l*}, typ_r*{typ_r <- typ_r*}) = false

def $equiv_typ'(ctx, typ, typ) : bool =

  clause 0 : (C, BOOL as typ, BOOL as typ) = true

  clause 1 : (C, NAT as typ, NAT as typ) = true

  clause 2 : (C, INT as typ, INT as typ) = true

  clause 3 : (C, TEXT as typ, TEXT as typ) = true

  clause 4 : (C, VAR id_l targ_l*{targ_l <- targ_l*}, VAR id_r targ_r*{targ_r <- targ_r*}) = ((id_l = id_r) /\ $equiv_typs(C, targ_l*{targ_l <- targ_l*}, targ_r*{targ_r <- targ_r*}))

  clause 5 : (C, TUP typ_l*{typ_l <- typ_l*}, TUP typ_r*{typ_r <- typ_r*}) = $equiv_typs(C, typ_l*{typ_l <- typ_l*}, typ_r*{typ_r <- typ_r*})

  clause 6 : (C, ITER typ_l iter_l, ITER typ_r iter_r) = ((iter_l = iter_r) /\ $equiv_typ(C, typ_l, typ_r))

  clause -1 : (C, typ_l, typ_r) = false

def $equiv_func_typ(ctx, typ, typ) : bool =

  clause 0 : (C, FUNC tparam_l*{tparam_l <- tparam_l*} typ_l*{typ_l <- typ_l*} typ_ret_l, FUNC tparam_r*{tparam_r <- tparam_r*} typ_r*{typ_r <- typ_r*} typ_ret_r) = ($equiv_typs(C_fresh, typ_l_subst*{typ_l_subst <- typ_l_subst*}, typ_r_subst*{typ_r_subst <- typ_r_subst*}) /\ $equiv_typ(C_fresh, typ_ret_l_subst, typ_ret_r_subst))
  -- if (|tparam_l*{tparam_l <- tparam_l*}| = |tparam_r*{tparam_r <- tparam_r*}|)
  -- if (|typ_l*{typ_l <- typ_l*}| = |typ_r*{typ_r <- typ_r*}|)
  -- if (`{ id_global ':' typdef_global*{id_global <- id_global*, typdef_global <- typdef_global*} `} = C.GLOBAL.TYP)
  -- if (`{ id_local ':' typdef_local*{id_local <- id_local*, typdef_local <- typdef_local*} `} = C.LOCAL.TYP)
  -- if (id_used*{id_used <- id_used*} = id_global*{id_global <- id_global*} ++ id_local*{id_local <- id_local*} ++ $ids_typ(FUNC tparam_l*{tparam_l <- tparam_l*} typ_l*{typ_l <- typ_l*} typ_ret_l) ++ $ids_typ(FUNC tparam_r*{tparam_r <- tparam_r*} typ_r*{typ_r <- typ_r*} typ_ret_r))
  -- if (tparam_fresh*{tparam_fresh <- tparam_fresh*} = $fresh_ids(tparam_l*{tparam_l <- tparam_l*}, id_used*{id_used <- id_used*}))
  -- if (theta_l = `{ tparam_l ':' VAR tparam_fresh []*{tparam_fresh <- tparam_fresh*, tparam_l <- tparam_l*} `})
  -- if (theta_r = `{ tparam_r ':' VAR tparam_fresh []*{tparam_fresh <- tparam_fresh*, tparam_r <- tparam_r*} `})
  -- if (typ_l_subst*{typ_l_subst <- typ_l_subst*} = $subst_typ(theta_l, typ_l)*{typ_l <- typ_l*})
  -- if (typ_r_subst*{typ_r_subst <- typ_r_subst*} = $subst_typ(theta_r, typ_r)*{typ_r <- typ_r*})
  -- if (typ_ret_l_subst = $subst_typ(theta_l, typ_ret_l))
  -- if (typ_ret_r_subst = $subst_typ(theta_r, typ_ret_r))
  -- if (tdenv_fresh = $adds_map<id, typdef>(C.LOCAL.TYP, tparam_fresh*{tparam_fresh <- tparam_fresh*}, $repeat_<typdef>(PARAM, |tparam_fresh*{tparam_fresh <- tparam_fresh*}|)))
  -- if (C_fresh = C[LOCAL.TYP = tdenv_fresh])

def $upcast(ctx, typ, val) : res<val> =

  clause 0 : (C, INT as typ, INT i as val) = OK INT i as val

  clause 1 : (C, INT as typ, NAT n as val) = OK INT n as int as val

  clause 2 : (C, INT as typ, val) = FAIL
  -- if ~val <: num

  clause 3 : (C, VAR id targ*{targ <- targ*}, val) = $upcast(C, typ', val)
  -- if (?(DEF tparam*{tparam <- tparam*} '->' ALIAS typ) = $find_typ(C, id))
  -- if (theta = `{ tparam ':' targ*{targ <- targ*, tparam <- tparam*} `})
  -- if (typ' = $subst_typ(theta, typ))

  clause 4 : (C, TUP typ*{typ <- typ*}, TUP val*{val <- val*}) = OK TUP val_upcast*{val_upcast <- val_upcast*}
  -- (if (OK val_upcast = $upcast(C, typ, val)))*{typ <- typ*, val <- val*, val_upcast <- val_upcast*}

  clause 5 : (C, TUP typ*{typ <- typ*}, val) = FAIL
  -- if ~$is_tup(val)

  clause 6 : (C, ITER typ QUEST, OPT val?{val <- val?}) = OK OPT val_upcast?{val_upcast <- val_upcast?}
  -- (if (OK val_upcast = $upcast(C, typ, val)))?{val <- val?, val_upcast <- val_upcast?}

  clause 7 : (C, ITER typ STAR, LIST val*{val <- val*}) = OK LIST val_upcast*{val_upcast <- val_upcast*}
  -- (if (OK val_upcast = $upcast(C, typ, val)))*{val <- val*, val_upcast <- val_upcast*}

  clause -1 : (C, typ, val) = OK val

def $downcast(ctx, typ, val) : res<val> =

  clause 0 : (C, NAT as typ, NAT n as val) = OK NAT n as val

  clause 1 : (C, NAT as typ, INT i as val) = OK NAT n as val
  -- if (n as int = i)

  clause 2 : (C, NAT as typ, val) = FAIL
  -- if ~val <: num

  clause 3 : (C, VAR id targ*{targ <- targ*}, val) = $downcast(C, typ', val)
  -- if (?(DEF tparam*{tparam <- tparam*} '->' ALIAS typ) = $find_typ(C, id))
  -- if (theta = `{ tparam ':' targ*{targ <- targ*, tparam <- tparam*} `})
  -- if (typ' = $subst_typ(theta, typ))

  clause 4 : (C, TUP typ*{typ <- typ*}, TUP val*{val <- val*}) = OK TUP val_downcast*{val_downcast <- val_downcast*}
  -- (if (OK val_downcast = $downcast(C, typ, val)))*{typ <- typ*, val <- val*, val_downcast <- val_downcast*}

  clause 5 : (C, TUP typ*{typ <- typ*}, val) = FAIL
  -- if ~$is_tup(val)

  clause 6 : (C, ITER typ QUEST, OPT val?{val <- val?}) = OK OPT val_downcast?{val_downcast <- val_downcast?}
  -- (if (OK val_downcast = $downcast(C, typ, val)))?{val <- val?, val_downcast <- val_downcast?}

  clause 7 : (C, ITER typ STAR, LIST val*{val <- val*}) = OK LIST val_downcast*{val_downcast <- val_downcast*}
  -- (if (OK val_downcast = $downcast(C, typ, val)))*{val <- val*, val_downcast <- val_downcast*}

  clause -1 : (C, typ, val) = OK val

def $subtyp(ctx, typ, val) : bool =

  clause 0 : (C, BOOL as typ, BOOL b) = true

  clause 1 : (C, NAT as typ, NAT n as val) = true

  clause 2 : (C, NAT as typ, INT i as val) = (i >= 0 as int)

  clause 3 : (C, INT as typ, num as val) = true

  clause 4 : (C, TEXT as typ, TEXT t) = true

  clause 5 : (C, VAR id targ*{targ <- targ*}, EXT json) = true
  -- if (?(EXT) = $find_typ(C, id))

  clause 6 : (C, VAR id targ*{targ <- targ*}, val) = $subtyp(C, typ_subst, val)
  -- if (?(DEF tparam*{tparam <- tparam*} '->' ALIAS typ) = $find_typ(C, id))
  -- if (theta = `{ tparam ':' targ*{targ <- targ*, tparam <- tparam*} `})
  -- if (typ_subst = $subst_typ(theta, typ))

  clause 7 : (C, VAR id targ*{targ <- targ*}, INJ mixop val*{val <- val*}) = $forall_($subtyp(C, typ_case_found_subst, val)*{typ_case_found_subst <- typ_case_found_subst*, val <- val*})
  -- if (?(DEF tparam*{tparam <- tparam*} '->' VARIANT typcase*{typcase <- typcase*}) = $find_typ(C, id))
  -- if (theta = `{ tparam ':' targ*{targ <- targ*, tparam <- tparam*} `})
  -- (if (mixop_case typ_case*{typ_case <- typ_case*} = typcase))*{mixop_case <- mixop_case*, typ_case* <- typ_case**, typcase <- typcase*}
  -- if mixop <- mixop_case*{mixop_case <- mixop_case*}
  -- if (?(typ_case_found*{typ_case_found <- typ_case_found*}) = $assoc_<mixop, typ*>(mixop, (mixop_case, typ_case*{typ_case <- typ_case*})*{mixop_case <- mixop_case*, typ_case* <- typ_case**}))
  -- if (typ_case_found_subst*{typ_case_found_subst <- typ_case_found_subst*} = $subst_typ(theta, typ_case_found)*{typ_case_found <- typ_case_found*})

  clause 8 : (C, VAR id targ*{targ <- targ*}, STR valfield*{valfield <- valfield*}) = $forall_($subtyp(C, typ_field_subst, val_field)*{typ_field_subst <- typ_field_subst*, val_field <- val_field*})
  -- if (?(DEF tparam*{tparam <- tparam*} '->' STRUCT typfield*{typfield <- typfield*}) = $find_typ(C, id))
  -- (if (atom typ_field = typfield))*{atom <- atom*, typ_field <- typ_field*, typfield <- typfield*}
  -- (if (atom val_field = valfield))*{atom <- atom*, val_field <- val_field*, valfield <- valfield*}
  -- if (theta = `{ tparam ':' targ*{targ <- targ*, tparam <- tparam*} `})
  -- (if (typ_field_subst = $subst_typ(theta, typ_field)))*{typ_field <- typ_field*, typ_field_subst <- typ_field_subst*}

  clause 9 : (C, TUP typ*{typ <- typ*}, TUP val*{val <- val*}) = $forall_($subtyp(C, typ, val)*{typ <- typ*, val <- val*})

  clause 10 : (C, ITER typ QUEST, OPT ?(val)) = $subtyp(C, typ, val)

  clause 11 : (C, ITER typ QUEST, OPT ?()) = true

  clause 12 : (C, ITER typ STAR, LIST val*{val <- val*}) = $forall_($subtyp(C, typ, val)*{val <- val*})

  clause 13 : (C, FUNC tparam*{tparam <- tparam*} typ*{typ <- typ*} typ_ret, FUNC id) = $equiv_func_typ(C, FUNC tparam*{tparam <- tparam*} typ*{typ <- typ*} typ_ret, $func_typ(funcdef))
  -- if (?(funcdef) = $find_func(C, id))

  clause -1 : (C, typ, val) = false

def $subtyps(ctx, typ*, val*) : bool =

  clause 0 : (C, typ*{typ <- typ*}, val*{val <- val*}) = $forall_($subtyp(C, typ, val)*{typ <- typ*, val <- val*})

  clause -1 : (C, typ*{typ <- typ*}, val*{val <- val*}) = false

relation Assign_exp: ctx |- exp := val : ctx

  rulegroup variable

    rule variable: C |- VAR id := val : C'
    -- if (C' = $add_varr(C, id [], val))

  rulegroup tup

    rule tup: C |- TUP exp*{exp <- exp*} := TUP val*{val <- val*} : C'
    -- Assign_exps: C |- exp*{exp <- exp*} := val*{val <- val*} : C'

  rulegroup inj

    rule inj: C |- INJ mixop exp*{exp <- exp*} := INJ mixop val*{val <- val*} : C'
    -- Assign_exps: C |- exp*{exp <- exp*} := val*{val <- val*} : C'

  rulegroup str

    rule str: C |- STR expfield*{expfield <- expfield*} := STR valfield*{valfield <- valfield*} : C'
    -- (if (atom val = valfield))*{atom <- atom*, val <- val*, valfield <- valfield*}
    -- (if (atom exp = expfield))*{atom <- atom*, exp <- exp*, expfield <- expfield*}
    -- Assign_exps: C |- exp*{exp <- exp*} := val*{val <- val*} : C'

  rulegroup opt

    rule opt-some: C |- OPT ?(exp) := OPT ?(val) : C'
    -- Assign_exp: C |- exp := val : C'

    rule opt-none: C |- OPT ?() := OPT ?() : C

  rulegroup list

    rule list: C |- LIST exp*{exp <- exp*} := LIST val*{val <- val*} : C'
    -- Assign_exps: C |- exp*{exp <- exp*} := val*{val <- val*} : C'

  rulegroup cons

    rule cons: C |- CONS exp_h exp_t := LIST val_h :: val_t*{val_t <- val_t*} : C''
    -- Assign_exp: C |- exp_h := val_h : C'
    -- Assign_exp: C' |- exp_t := LIST val_t*{val_t <- val_t*} : C''

  rulegroup iter

    rule simple: C |- ITER exp iterexp := val : C'
    -- if (?(varr) = $is_iter_on_var(ITER exp iterexp))
    -- if (C' = $add_varr(C, varr, val))

    rule opt-none: C |- ITER exp iterexp := OPT ?() : C'
    -- if (?() = $is_iter_on_var(ITER exp iterexp))
    -- if (QUEST vari*{vari <- vari*} = iterexp)
    -- (if (vari_iter = $iter_vari(vari, QUEST)))*{vari <- vari*, vari_iter <- vari_iter*}
    -- if (val_bind*{val_bind <- val_bind*} = $repeat_<val>(OPT ?(), |vari_iter*{vari_iter <- vari_iter*}|))
    -- if (C' = $add_varis(C, vari_iter*{vari_iter <- vari_iter*}, val_bind*{val_bind <- val_bind*}))

    rule opt-some: C |- ITER exp iterexp := OPT ?(val) : C''
    -- if (?() = $is_iter_on_var(ITER exp iterexp))
    -- if (QUEST vari*{vari <- vari*} = iterexp)
    -- Assign_exp: C |- exp := val : C'
    -- (if (vari_iter = $iter_vari(vari, QUEST)))*{vari <- vari*, vari_iter <- vari_iter*}
    -- (if (?(val_sub) = $find_vari(C', vari)))*{val_sub <- val_sub*, vari <- vari*}
    -- if ([C''] = $add_varis(C', vari_iter*{vari_iter <- vari_iter*}, [OPT ?(val_sub)])*{val_sub <- val_sub*})

    rule list: C |- ITER exp iterexp := LIST val*{val <- val*} : C'
    -- if (?() = $is_iter_on_var(ITER exp iterexp))
    -- if (STAR vari*{vari <- vari*} = iterexp)
    -- if (C_local = C[LOCAL.VAL = $empty_map<varr, val>])
    -- (Assign_exp: C_local |- exp := val : C_sub)*{C_sub <- C_sub*, val <- val*}
    -- (if (vari_iter = $iter_vari(vari, STAR)))*{vari <- vari*, vari_iter <- vari_iter*}
    -- (if (?(val_sub*{val_sub <- val_sub*}) = $finds_vari(C_sub*{C_sub <- C_sub*}, vari)))*{val_sub* <- val_sub**, vari <- vari*}
    -- (if (val_bind = LIST val_sub*{val_sub <- val_sub*}))*{val_bind <- val_bind*, val_sub* <- val_sub**}
    -- if (C' = $add_varis(C, vari_iter*{vari_iter <- vari_iter*}, val_bind*{val_bind <- val_bind*}))

relation Assign_exps: ctx |- exp* := val* : ctx

  rulegroup

    rule nil: C |- [] := [] : C

    rule cons: C |- exp_h :: exp_t*{exp_t <- exp_t*} := val_h :: val_t*{val_t <- val_t*} : C''
    -- Assign_exp: C |- exp_h := val_h : C'
    -- Assign_exps: C' |- exp_t*{exp_t <- exp_t*} := val_t*{val_t <- val_t*} : C''

relation Assign_arg: ctx '/' ctx |- arg := val : ctx

  rulegroup exp

    rule exp: C_callee '/' _C |- EXP exp := val : C_callee'
    -- Assign_exp: C_callee |- exp := val : C_callee'

  rulegroup fun

    rule fun: C_callee '/' C_caller |- FUN id_callee := FUNC id_caller : C_callee'
    -- if (?(funcdef) = $find_func(C_caller, id_caller))
    -- if (C_callee' = $add_func(C_callee, id_callee, funcdef))

relation Assign_args: ctx '/' ctx |- arg* := val* : ctx

  rulegroup

    rule nil: C_callee '/' _C |- [] := [] : C_callee

    rule cons: C_callee '/' C_caller |- arg_h :: arg_t*{arg_t <- arg_t*} := val_h :: val_t*{val_t <- val_t*} : C_callee''
    -- Assign_arg: C_callee '/' C_caller |- arg_h := val_h : C_callee'
    -- Assign_args: C_callee' '/' C_caller |- arg_t*{arg_t <- arg_t*} := val_t*{val_t <- val_t*} : C_callee''

relation Eval_path: ctx |- val path : res<val>

  rulegroup root

    rule root: C |- val_b ROOT : OK val_b

  rulegroup dot

    rule dot: C |- val_b DOT path atom : OK val
    -- Eval_path: C |- val_b path : OK STR valfield*{valfield <- valfield*}
    -- (if (atom_field val_field = valfield))*{atom_field <- atom_field*, val_field <- val_field*, valfield <- valfield*}
    -- if (?(val) = $assoc_<atom, val>(atom, (atom_field, val_field)*{atom_field <- atom_field*, val_field <- val_field*}))

  rulegroup idx

    rule text: C |- val_b IDX path exp_i : OK TEXT t[n]
    -- Eval_path: C |- val_b path : OK TEXT t
    -- Eval_exp: C |- exp_i : OK NAT n as val

    rule list: C |- val_b IDX path exp_i : OK val*{val <- val*}[n]
    -- Eval_path: C |- val_b path : OK LIST val*{val <- val*}
    -- Eval_exp: C |- exp_i : OK NAT n as val

  rulegroup slice

    rule text: C |- val_b SLICE path exp_i exp_n : OK TEXT t[n_i : n_n]
    -- Eval_path: C |- val_b path : OK TEXT t
    -- Eval_exp: C |- exp_i : OK NAT n_i as val
    -- Eval_exp: C |- exp_n : OK NAT n_n as val

    rule list: C |- val_b SLICE path exp_i exp_n : OK LIST val*{val <- val*}[n_i : n_n]
    -- Eval_path: C |- val_b path : OK LIST val*{val <- val*}
    -- Eval_exp: C |- exp_i : OK NAT n_i as val
    -- Eval_exp: C |- exp_n : OK NAT n_n as val

  elsegroup

  rulegroup fail

    rule fail: C |- val path : FAIL

relation Eval_path_upd: ctx |- val path := val : res<val>

  rulegroup root

    rule root: C |- val_b ROOT := val_n : OK val_n

  rulegroup idx

    rule text: C |- val_b IDX path exp_i := TEXT t_n : valres
    -- Eval_path: C |- val_b path : OK TEXT t
    -- Eval_exp: C |- exp_i : OK NAT n_target as val
    -- if (|t_n| = 1)
    -- Eval_path_upd: C |- val_b path := TEXT t[[n_target] = t_n] : valres

    rule list: C |- val_b IDX path exp_i := val_n : valres
    -- Eval_path: C |- val_b path : OK LIST val*{val <- val*}
    -- Eval_exp: C |- exp_i : OK NAT n_target as val
    -- Eval_path_upd: C |- val_b path := LIST val*{val <- val*}[[n_target] = val_n] : valres

  rulegroup slice

    rule text: C |- val_b SLICE path exp_i exp_n := TEXT t_n : valres
    -- Eval_path: C |- val_b path : OK TEXT t
    -- Eval_exp: C |- exp_i : OK NAT n_i as val
    -- Eval_exp: C |- exp_n : OK NAT n_n as val
    -- if (|t_n| = n_n)
    -- Eval_path_upd: C |- val_b path := TEXT t[[n_i : n_n] = t_n] : valres

    rule list: C |- val_b SLICE path exp_i exp_n := LIST val_n*{val_n <- val_n*} : valres
    -- Eval_path: C |- val_b path : OK LIST val*{val <- val*}
    -- Eval_exp: C |- exp_i : OK NAT n_i as val
    -- Eval_exp: C |- exp_n : OK NAT n_n as val
    -- if (|val_n*{val_n <- val_n*}| = n_n)
    -- Eval_path_upd: C |- val_b path := LIST val*{val <- val*}[[n_i : n_n] = val_n*{val_n <- val_n*}] : valres

  rulegroup dot

    rule dot: C |- val_b DOT path atom := val_n : valres
    -- Eval_path: C |- val_b path : OK STR valfield*{valfield <- valfield*}
    -- (if (atom_field val_field = valfield))*{atom_field <- atom_field*, val_field <- val_field*, valfield <- valfield*}
    -- (if (valfield_new = atom_field $ite<val>((atom = atom_field), val_n, val_field)))*{atom_field <- atom_field*, val_field <- val_field*, valfield_new <- valfield_new*}
    -- Eval_path_upd: C |- val_b path := STR valfield_new*{valfield_new <- valfield_new*} : valres

  elsegroup

  rulegroup fail

    rule fail: C |- val_b path := val_n : FAIL

relation Eval_clause: ctx '/' ctx |- clause '@' `( val* `) : res<val>

  rulegroup succ

    rule succ: C '/' C_caller |- clause '@' `( val*{val <- val*} `) : OK val_out
    -- if (arg*{arg <- arg*} '=' exp_out '-' prem*{prem <- prem*} = clause)
    -- Assign_args: C '/' C_caller |- arg*{arg <- arg*} := val*{val <- val*} : C'
    -- Eval_prems: C' |- prem*{prem <- prem*} : OK C''
    -- Eval_exp: C'' |- exp_out : OK val_out

  elsegroup

  rulegroup fail

    rule fail: C '/' C_caller |- clause '@' `( val*{val <- val*} `) : FAIL

relation Eval_clauses: ctx '/' ctx |- clause* '@' `( val* `) : res<val>

  rulegroup

    rule nil: C '/' C_caller |- [] '@' `( val*{val <- val*} `) : FAIL

    rule cons-succ: C '/' C_caller |- clause_h :: clause_t*{clause_t <- clause_t*} '@' `( val*{val <- val*} `) : OK val_res
    -- Eval_clause: C '/' C_caller |- clause_h '@' `( val*{val <- val*} `) : OK val_res

    rule cons-fail: C '/' C_caller |- clause_h :: clause_t*{clause_t <- clause_t*} '@' `( val*{val <- val*} `) : valres
    -- Eval_clause: C '/' C_caller |- clause_h '@' `( val*{val <- val*} `) : FAIL
    -- Eval_clauses: C '/' C_caller |- clause_t*{clause_t <- clause_t*} '@' `( val*{val <- val*} `) : valres

relation Eval_tblrow: ctx |- tblrow '@' `( val* `) : res<val>

  rulegroup succ

    rule succ: C |- tblrow '@' `( val*{val <- val*} `) : OK val_out
    -- if (arg*{arg <- arg*} '=' exp_out '-' prem*{prem <- prem*} = tblrow)
    -- if (C_callee = C[LOCAL = $empty_layer])
    -- Assign_args: C_callee '/' C |- arg*{arg <- arg*} := val*{val <- val*} : C_callee'
    -- Eval_prems: C_callee' |- prem*{prem <- prem*} : OK C_callee''
    -- Eval_exp: C_callee'' |- exp_out : OK val_out

  elsegroup

  rulegroup fail

    rule fail: C |- tblrow '@' `( val*{val <- val*} `) : FAIL

relation Eval_tblrows: ctx |- tblrow* '@' `( val* `) : res<val>

  rulegroup

    rule nil: C |- [] '@' `( val*{val <- val*} `) : FAIL

    rule cons-succ: C |- tblrow_h :: tblrow_t*{tblrow_t <- tblrow_t*} '@' `( val*{val <- val*} `) : OK val_out
    -- Eval_tblrow: C |- tblrow_h '@' `( val*{val <- val*} `) : OK val_out

    rule cons-fail: C |- tblrow_h :: tblrow_t*{tblrow_t <- tblrow_t*} '@' `( val*{val <- val*} `) : valres
    -- Eval_tblrow: C |- tblrow_h '@' `( val*{val <- val*} `) : FAIL
    -- Eval_tblrows: C |- tblrow_t*{tblrow_t <- tblrow_t*} '@' `( val*{val <- val*} `) : valres

relation Call_table_func: ctx |- tableFuncDef '@' `( val* `) : res<val>

  rulegroup

    rule : C |- tableFuncDef '@' `( val*{val <- val*} `) : valres
    -- if (TABLE _param*{_param <- _param*} _typ '->' tblrow*{tblrow <- tblrow*} = tableFuncDef)
    -- Eval_tblrows: C |- tblrow*{tblrow <- tblrow*} '@' `( val*{val <- val*} `) : valres

relation Call_defined_func: ctx |- definedFuncDef '@' `< typ* `> `( val* `) : res<val>

  rulegroup

    rule : C |- definedFuncDef '@' `< typ*{typ <- typ*} `> `( val*{val <- val*} `) : valres
    -- if (DEF tparam*{tparam <- tparam*} _param*{_param <- _param*} _typ '->' clause*{clause <- clause*} elsclause?{elsclause <- elsclause?} = definedFuncDef)
    -- if (tdenv = `{ tparam ':' DEF [] '->' ALIAS typ*{tparam <- tparam*, typ <- typ*} `})
    -- if (C_callee = C[LOCAL = $empty_layer[TYP = tdenv]])
    -- if (clause_else*{clause_else <- clause_else*} = $opt_as_seq_<clause>(elsclause?{elsclause <- elsclause?}))
    -- if (clause_all*{clause_all <- clause_all*} = clause*{clause <- clause*} ++ clause_else*{clause_else <- clause_else*})
    -- Eval_clauses: C_callee '/' C |- clause_all*{clause_all <- clause_all*} '@' `( val*{val <- val*} `) : valres

relation Eval_rul: ctx |- rulmatch -> rulpath '@' `( val* `) : res<val*>

  rulegroup succ

    rule succ: C |- rulmatch -> rulpath '@' `( val*{val <- val*} `) : OK val_out*{val_out <- val_out*}
    -- if (id '=' exp_out*{exp_out <- exp_out*} '-' prem_path*{prem_path <- prem_path*} = rulpath)
    -- if (exp*{exp <- exp*} '-' prem_match*{prem_match <- prem_match*} = rulmatch)
    -- Assign_exps: C |- exp*{exp <- exp*} := val*{val <- val*} : C'
    -- if (prem*{prem <- prem*} = prem_match*{prem_match <- prem_match*} ++ prem_path*{prem_path <- prem_path*})
    -- Eval_prems: C' |- prem*{prem <- prem*} : OK C''
    -- (Eval_exp: C'' |- exp_out : OK val_out)*{exp_out <- exp_out*, val_out <- val_out*}

  elsegroup

  rulegroup fail

    rule fail: C |- rulmatch -> rulpath '@' `( val*{val <- val*} `) : FAIL

relation Eval_ruls: ctx |- rulmatch -> rulpath* '@' `( val* `) : res<val*>

  rulegroup

    rule nil: C |- rulmatch -> [] '@' `( val*{val <- val*} `) : FAIL

    rule cons-succ: C |- rulmatch -> rulpath_h :: rulpath_t*{rulpath_t <- rulpath_t*} '@' `( val*{val <- val*} `) : OK val_out*{val_out <- val_out*}
    -- Eval_rul: C |- rulmatch -> rulpath_h '@' `( val*{val <- val*} `) : OK val_out*{val_out <- val_out*}

    rule cons-fail: C |- rulmatch -> rulpath_h :: rulpath_t*{rulpath_t <- rulpath_t*} '@' `( val*{val <- val*} `) : valsres
    -- Eval_rul: C |- rulmatch -> rulpath_h '@' `( val*{val <- val*} `) : FAIL
    -- Eval_ruls: C |- rulmatch -> rulpath_t*{rulpath_t <- rulpath_t*} '@' `( val*{val <- val*} `) : valsres

relation Eval_rulgroup: ctx |- rulgroup '@' `( val* `) : res<val*>

  rulegroup succ

    rule succ: C |- rulgroup '@' `( val*{val <- val*} `) : OK val_out*{val_out <- val_out*}
    -- if (id ':' rulmatch '=' rulpath*{rulpath <- rulpath*} = rulgroup)
    -- Eval_ruls: C |- rulmatch -> rulpath*{rulpath <- rulpath*} '@' `( val*{val <- val*} `) : OK val_out*{val_out <- val_out*}

  elsegroup

  rulegroup fail

    rule fail: C |- rulgroup '@' `( val*{val <- val*} `) : FAIL

relation Eval_rulgroups: ctx |- rulgroup* '@' `( val* `) : res<val*>

  rulegroup

    rule nil: C |- [] '@' `( val*{val <- val*} `) : FAIL

    rule cons-succ: C |- rulgroup_h :: rulgroup_t*{rulgroup_t <- rulgroup_t*} '@' `( val*{val <- val*} `) : OK val_out*{val_out <- val_out*}
    -- Eval_rulgroup: C |- rulgroup_h '@' `( val*{val <- val*} `) : OK val_out*{val_out <- val_out*}

    rule cons-fail: C |- rulgroup_h :: rulgroup_t*{rulgroup_t <- rulgroup_t*} '@' `( val*{val <- val*} `) : valsres
    -- Eval_rulgroup: C |- rulgroup_h '@' `( val*{val <- val*} `) : FAIL
    -- Eval_rulgroups: C |- rulgroup_t*{rulgroup_t <- rulgroup_t*} '@' `( val*{val <- val*} `) : valsres

relation Call_defined_rel: ctx |- definedRelDef '@' `( val* `) : res<val*>

  rulegroup

    rule : C |- definedRelDef '@' `( val*{val <- val*} `) : valsres
