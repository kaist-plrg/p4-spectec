error[elab/operator-cmpop-type-mismatch]: operator '<' is not defined for 'bool' and 'nat'
  ┌─ elab/operator-comparison-type.watsup:2:12
  │
1 │ dec $f : bool
  │          ---- return value of function '$f' expects 'bool'
2 │ def $f = $(true < 1)
  │            ^^^^   ^ right operand has type 'nat'
  │            │       
  │            left operand has type 'bool'

