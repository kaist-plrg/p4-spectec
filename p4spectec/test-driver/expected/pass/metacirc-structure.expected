                  1. (Let tparam_fresh*{tparam_fresh <- tparam_fresh*} be $fresh_ids(tparam_l*{tparam_l <- tparam_l*}, id_used*{id_used <- id_used*}))

                    1. If ((|tparam_fresh*{tparam_fresh <- tparam_fresh*}| = |tparam_l*{tparam_l <- tparam_l*}|)), then

                      1. (Let theta_l be `{ tparam_l ':' VAR tparam_fresh []*{tparam_fresh <- tparam_fresh*, tparam_l <- tparam_l*} `})

                        1. (Let theta_r be `{ tparam_r ':' VAR tparam_fresh []*{tparam_fresh <- tparam_fresh*, tparam_r <- tparam_r*} `})

