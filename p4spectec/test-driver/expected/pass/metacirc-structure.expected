                            1. (Let ?(val_sub*{val_sub <- val_sub*}) be val'*{val' <- val'*}?{val'* <- val'*?})*{val'*? <- val'*?*, val_sub* -> val_sub**}

                              1. (Let val_bind be LIST val_sub*{val_sub <- val_sub*})*{val_sub* <- val_sub**, val_bind -> val_bind*}

                                1. (Let C' be $add_varis(C, vari_iter*{vari_iter <- vari_iter*}, val_bind*{val_bind <- val_bind*}))

                                  1. Result in: % |- % := % : C'

                          1. Else Dangling

                1. Else Dangling

            1. Else Dangling

      3. Else Dangling

1. Else Dangling

relation Assign_exps: C |- exp*{exp <- exp*} := val*{val <- val*} : %

1. Case analysis on exp*{exp <- exp*} (total)

  1. Case (% matches pattern [])

    1. If (val*{val <- val*} matches []), then

      1. Result in: % |- % := % : C

    1. Else Dangling

  2. Case (% matches pattern _ :: _)

    1. (Let exp_h :: exp_t*{exp_t <- exp_t*} be exp*{exp <- exp*})

      1. If (val*{val <- val*} matches _ :: _), then

        1. (Let val_h :: val_t*{val_t <- val_t*} be val*{val <- val*})

          1. (Assign_exp: C |- exp_h := val_h : C')

            1. (Assign_exps: C' |- exp_t*{exp_t <- exp_t*} := val_t*{val_t <- val_t*} : C'')

              1. Result in: % |- % := % : C''

      1. Else Dangling

relation Assign_arg: C_callee '/' C |- arg := val : %

1. Case analysis on arg (total)

  1. Case (% matches pattern EXP %)

    1. (Let EXP exp be arg)

      1. (Assign_exp: C_callee |- exp := val : C_callee')

        1. Result in: % '/' % |- % := % : C_callee'

  2. Case (% matches pattern FUN %)

    1. (Let FUN id_callee be arg)

      1. If (val matches FUNC %), then

        1. (Let FUNC id_caller be val)

          1. (Let funcdef'?{funcdef' <- funcdef'?} be $find_func(C, id_caller))

            1. If (funcdef'?{funcdef' <- funcdef'?} matches (_)), then

              1. (Let ?(funcdef) be funcdef'?{funcdef' <- funcdef'?})

                1. (Let C_callee' be $add_func(C_callee, id_callee, funcdef))

                  1. Result in: % '/' % |- % := % : C_callee'

            1. Else Dangling

      1. Else Dangling

relation Assign_args: C_callee '/' C |- arg*{arg <- arg*} := val*{val <- val*} : %

1. Case analysis on arg*{arg <- arg*} (total)

  1. Case (% matches pattern [])

    1. If (val*{val <- val*} matches []), then

      1. Result in: % '/' % |- % := % : C_callee

    1. Else Dangling

  2. Case (% matches pattern _ :: _)

    1. (Let arg_h :: arg_t*{arg_t <- arg_t*} be arg*{arg <- arg*})

      1. If (val*{val <- val*} matches _ :: _), then

        1. (Let val_h :: val_t*{val_t <- val_t*} be val*{val <- val*})

          1. (Assign_arg: C_callee '/' C |- arg_h := val_h : C_callee')

            1. (Assign_args: C_callee' '/' C |- arg_t*{arg_t <- arg_t*} := val_t*{val_t <- val_t*} : C_callee'')

              1. Result in: % '/' % |- % := % : C_callee''

      1. Else Dangling

relation Eval_path: C |- val_b path' : %

1. Case analysis on path' (total)

  1. Case (% matches pattern ROOT)

    1. Result in: % |- % % : OK val_b

  2. Case (% matches pattern DOT % %)

    1. (Let DOT path atom be path')

      1. (Eval_path: C |- val_b path : res<val>)

        1. If (res<val> matches OK %), then

          1. (Let OK val' be res<val>)

            1. If (val' matches STR %), then

              1. (Let STR valfield*{valfield <- valfield*} be val')

                1. (Let atom_field val_field be valfield)*{valfield <- valfield*, atom_field -> atom_field*, val_field -> val_field*}

                  1. (Let val''?{val'' <- val''?} be $assoc_<atom, val>(atom, (atom_field, val_field)*{atom_field <- atom_field*, val_field <- val_field*}))

                    1. If (val''?{val'' <- val''?} matches (_)), then

                      1. (Let ?(val) be val''?{val'' <- val''?})

                        1. Result in: % |- % % : OK val

  3. Case (% matches pattern IDX % %)

    1. (Let IDX path exp_i be path')

      1. (Eval_path: C |- val_b path : res<val>)

        1. If (res<val> matches OK %), then

          1. (Let OK val' be res<val>)

            1. Case analysis on val'

              1. Case (% matches pattern TEXT %)

                1. (Let TEXT t be val')

                  1. (Eval_exp: C |- exp_i : res<val>')

                    1. If (res<val>' matches OK %), then

                      1. (Let OK val be res<val>')

                        1. If (val <: num), then

                          1. (Let num be val as num)

                            1. If (num matches NAT %), then

                              1. (Let NAT n be num)

                                1. If ((n < |t|)), then

                                  1. Result in: % |- % % : OK TEXT t[n]

              2. Case (% matches pattern LIST %)

                1. (Let LIST val*{val <- val*} be val')

                  1. (Eval_exp: C |- exp_i : res<val>')

                    1. If (res<val>' matches OK %), then

                      1. (Let OK val'' be res<val>')

                        1. If (val'' <: num), then

                          1. (Let num be val'' as num)

                            1. If (num matches NAT %), then

                              1. (Let NAT n be num)

                                1. If ((n < |val*{val <- val*}|)), then

                                  1. Result in: % |- % % : OK val*{val <- val*}[n]

  4. Case (% matches pattern SLICE % % %)

    1. (Let SLICE path exp_i exp_n be path')

      1. (Eval_path: C |- val_b path : res<val>)

        1. If (res<val> matches OK %), then

          1. (Let OK val' be res<val>)

            1. Case analysis on val'

              1. Case (% matches pattern TEXT %)

                1. (Let TEXT t be val')

                  1. (Eval_exp: C |- exp_i : res<val>')

                    1. If (res<val>' matches OK %), then

                      1. (Let OK val be res<val>')

                        1. If (val <: num), then

                          1. (Let num be val as num)

                            1. If (num matches NAT %), then

                              1. (Let NAT n_i be num)

                                1. (Eval_exp: C |- exp_n : res<val>'')

                                  1. If (res<val>'' matches OK %), then

                                    1. (Let OK val'' be res<val>'')

                                      1. If (val'' <: num), then

                                        1. (Let num' be val'' as num)

                                          1. If (num' matches NAT %), then

                                            1. (Let NAT n_n be num')

                                              1. Result in: % |- % % : OK TEXT t[n_i : n_n]

              2. Case (% matches pattern LIST %)

                1. (Let LIST val*{val <- val*} be val')

                  1. (Eval_exp: C |- exp_i : res<val>')

                    1. If (res<val>' matches OK %), then

                      1. (Let OK val'' be res<val>')

                        1. If (val'' <: num), then

                          1. (Let num be val'' as num)

                            1. If (num matches NAT %), then

                              1. (Let NAT n_i be num)

                                1. (Eval_exp: C |- exp_n : res<val>'')

                                  1. If (res<val>'' matches OK %), then

                                    1. (Let OK val''' be res<val>'')

                                      1. If (val''' <: num), then

                                        1. (Let num' be val''' as num)

                                          1. If (num' matches NAT %), then

                                            1. (Let NAT n_n be num')

                                              1. Result in: % |- % % : OK LIST val*{val <- val*}[n_i : n_n]

2. Otherwise,

  1. Result in: % |- % % : FAIL

relation Eval_path_upd: C |- val_b path' := val_n : %

1. Case analysis on path' (total)

  1. Case (% matches pattern ROOT)

    1. Result in: % |- % % := % : OK val_n

  2. Case (% matches pattern IDX % %)

    1. (Let IDX path exp_i be path')

      1. If (val_n matches TEXT %), then

        1. (Let TEXT t_n be val_n)

          1. (Eval_path: C |- val_b path : res<val>)

            1. If (res<val> matches OK %), then

              1. (Let OK val be res<val>)

                1. If (val matches TEXT %), then

                  1. (Let TEXT t be val)

                    1. (Eval_exp: C |- exp_i : res<val>')

                      1. If (res<val>' matches OK %), then

                        1. (Let OK val' be res<val>')

                          1. If (val' <: num), then

                            1. (Let num be val' as num)

                              1. If (num matches NAT %), then

                                1. (Let NAT n_target be num)

                                  1. If ((|t_n| = 1)), then

                                    1. (Eval_path_upd: C |- val_b path := TEXT t[[n_target] = t_n] : valres)

                                      1. Result in: % |- % % := % : valres

      2. (Eval_path: C |- val_b path : res<val>)

        1. If (res<val> matches OK %), then

          1. (Let OK val' be res<val>)

            1. If (val' matches LIST %), then

              1. (Let LIST val*{val <- val*} be val')

                1. (Eval_exp: C |- exp_i : res<val>')

                  1. If (res<val>' matches OK %), then

                    1. (Let OK val'' be res<val>')

                      1. If (val'' <: num), then

                        1. (Let num be val'' as num)

                          1. If (num matches NAT %), then

                            1. (Let NAT n_target be num)

                              1. (Eval_path_upd: C |- val_b path := LIST val*{val <- val*}[[n_target] = val_n] : valres)

                                1. Result in: % |- % % := % : valres

  3. Case (% matches pattern SLICE % % %)

    1. (Let SLICE path exp_i exp_n be path')

      1. If (val_n matches TEXT %), then

        1. (Let TEXT t_n be val_n)

          1. (Eval_path: C |- val_b path : res<val>)

            1. If (res<val> matches OK %), then

              1. (Let OK val be res<val>)

                1. If (val matches TEXT %), then

                  1. (Let TEXT t be val)

                    1. (Eval_exp: C |- exp_i : res<val>')

                      1. If (res<val>' matches OK %), then

                        1. (Let OK val' be res<val>')

                          1. If (val' <: num), then

                            1. (Let num be val' as num)

                              1. If (num matches NAT %), then

                                1. (Let NAT n_i be num)

                                  1. (Eval_exp: C |- exp_n : res<val>'')

                                    1. If (res<val>'' matches OK %), then

                                      1. (Let OK val'' be res<val>'')

                                        1. If (val'' <: num), then

                                          1. (Let num' be val'' as num)

                                            1. If (num' matches NAT %), then

                                              1. (Let NAT n_n be num')

                                                1. If ((|t_n| = n_n)), then

                                                  1. (Eval_path_upd: C |- val_b path := TEXT t[[n_i : n_n] = t_n] : valres)

                                                    1. Result in: % |- % % := % : valres

      2. (Eval_path: C |- val_b path : res<val>)

        1. If (res<val> matches OK %), then

          1. (Let OK val' be res<val>)

            1. If (val' matches LIST %), then

              1. (Let LIST val*{val <- val*} be val')

                1. (Eval_exp: C |- exp_i : res<val>')

                  1. If (res<val>' matches OK %), then

                    1. (Let OK val'' be res<val>')

                      1. If (val'' <: num), then

                        1. (Let num be val'' as num)

                          1. If (num matches NAT %), then

                            1. (Let NAT n_i be num)

                              1. (Eval_exp: C |- exp_n : res<val>'')

                                1. If (res<val>'' matches OK %), then

                                  1. (Let OK val''' be res<val>'')

                                    1. If (val''' <: num), then

                                      1. (Let num' be val''' as num)

                                        1. If (num' matches NAT %), then

                                          1. (Let NAT n_n be num')

                                            1. (Eval_path_upd: C |- val_b path := LIST val*{val <- val*}[[n_i : n_n] = [val_n]] : valres)

                                              1. Result in: % |- % % := % : valres

  4. Case (% matches pattern DOT % %)

    1. (Let DOT path atom be path')

      1. (Eval_path: C |- val_b path : res<val>)

        1. If (res<val> matches OK %), then

          1. (Let OK val be res<val>)

            1. If (val matches STR %), then

              1. (Let STR valfield*{valfield <- valfield*} be val)

                1. (Let atom_field val_field be valfield)*{valfield <- valfield*, atom_field -> atom_field*, val_field -> val_field*}

                  1. (Let valfield_new be atom_field $ite<val>((atom = atom_field), val_n, val_field))*{atom_field <- atom_field*, val_field <- val_field*, valfield_new -> valfield_new*}

                    1. (Eval_path_upd: C |- val_b path := STR valfield_new*{valfield_new <- valfield_new*} : valres)

                      1. Result in: % |- % % := % : valres

2. Otherwise,

  1. Result in: % |- % % := % : FAIL

relation Eval_clause: C '/' C_caller |- clause '@' `( val*{val <- val*} `) : %

1. (Let arg*{arg <- arg*} '=' exp_out '-' prem*{prem <- prem*} be clause)

  1. (Assign_args: C '/' C_caller |- arg*{arg <- arg*} := val*{val <- val*} : C')

    1. (Eval_prems: C' |- prem*{prem <- prem*} : res<ctx>)

      1. If (res<ctx> matches OK %), then

        1. (Let OK C'' be res<ctx>)

          1. (Eval_exp: C'' |- exp_out : res<val>)

            1. If (res<val> matches OK %), then

              1. (Let OK val_out be res<val>)

                1. Result in: % '/' % |- % '@' `( % `) : OK val_out

2. Otherwise,

  1. Result in: % '/' % |- % '@' `( % `) : FAIL

relation Eval_clauses: C '/' C_caller |- clause*{clause <- clause*} '@' `( val*{val <- val*} `) : %

1. Case analysis on clause*{clause <- clause*} (total)

  1. Case (% matches pattern [])

    1. Result in: % '/' % |- % '@' `( % `) : FAIL

  2. Case (% matches pattern _ :: _)

    1. (Let clause_h :: clause_t*{clause_t <- clause_t*} be clause*{clause <- clause*})

      1. (Eval_clause: C '/' C_caller |- clause_h '@' `( val*{val <- val*} `) : res<val>)

        1. Case analysis on res<val> (total)

          1. Case (% matches pattern OK %)

            1. (Let OK val_res be res<val>)

              1. Result in: % '/' % |- % '@' `( % `) : OK val_res

          2. Case (% matches pattern FAIL)

            1. (Eval_clauses: C '/' C_caller |- clause_t*{clause_t <- clause_t*} '@' `( val*{val <- val*} `) : valres)

              1. Result in: % '/' % |- % '@' `( % `) : valres

relation Eval_tblrow: C |- tblrow '@' `( val*{val <- val*} `) : %

1. (Let arg*{arg <- arg*} '=' exp_out '-' prem*{prem <- prem*} be tblrow)

  1. (Let C_callee be C[LOCAL = $empty_layer])

    1. (Assign_args: C_callee '/' C |- arg*{arg <- arg*} := val*{val <- val*} : C_callee')

      1. (Eval_prems: C_callee' |- prem*{prem <- prem*} : res<ctx>)

        1. If (res<ctx> matches OK %), then

          1. (Let OK C_callee'' be res<ctx>)

            1. (Eval_exp: C_callee'' |- exp_out : res<val>)

              1. If (res<val> matches OK %), then

                1. (Let OK val_out be res<val>)

                  1. Result in: % |- % '@' `( % `) : OK val_out

2. Otherwise,

  1. Result in: % |- % '@' `( % `) : FAIL

relation Eval_tblrows: C |- tblrow*{tblrow <- tblrow*} '@' `( val*{val <- val*} `) : %

1. Case analysis on tblrow*{tblrow <- tblrow*} (total)

  1. Case (% matches pattern [])

    1. Result in: % |- % '@' `( % `) : FAIL

  2. Case (% matches pattern _ :: _)

    1. (Let tblrow_h :: tblrow_t*{tblrow_t <- tblrow_t*} be tblrow*{tblrow <- tblrow*})

      1. (Eval_tblrow: C |- tblrow_h '@' `( val*{val <- val*} `) : res<val>)

        1. Case analysis on res<val> (total)

          1. Case (% matches pattern OK %)

            1. (Let OK val_out be res<val>)

              1. Result in: % |- % '@' `( % `) : OK val_out

          2. Case (% matches pattern FAIL)

            1. (Eval_tblrows: C |- tblrow_t*{tblrow_t <- tblrow_t*} '@' `( val*{val <- val*} `) : valres)

              1. Result in: % |- % '@' `( % `) : valres

relation Call_table_func: C |- tableFuncDef '@' `( val*{val <- val*} `) : %

1. (Let TABLE _param*{_param <- _param*} _typ '->' tblrow*{tblrow <- tblrow*} be tableFuncDef)

  1. (Eval_tblrows: C |- tblrow*{tblrow <- tblrow*} '@' `( val*{val <- val*} `) : valres)

    1. Result in: % |- % '@' `( % `) : valres

relation Call_defined_func: C |- definedFuncDef '@' `< typ*{typ <- typ*} `> `( val*{val <- val*} `) : %

1. (Let DEF tparam*{tparam <- tparam*} _param*{_param <- _param*} _typ '->' clause*{clause <- clause*} elsclause?{elsclause <- elsclause?} be definedFuncDef)

  1. If ((|tparam*{tparam <- tparam*}| = |typ*{typ <- typ*}|)), then

    1. (Let tdenv be `{ tparam ':' DEF [] '->' ALIAS typ*{tparam <- tparam*, typ <- typ*} `})

      1. (Let C_callee be C[LOCAL = $empty_layer[TYP = tdenv]])

        1. (Let clause_else*{clause_else <- clause_else*} be $opt_as_seq_<clause>(elsclause?{elsclause <- elsclause?}))

          1. (Let clause_all*{clause_all <- clause_all*} be clause*{clause <- clause*} ++ clause_else*{clause_else <- clause_else*})

            1. (Eval_clauses: C_callee '/' C |- clause_all*{clause_all <- clause_all*} '@' `( val*{val <- val*} `) : valres)

              1. Result in: % |- % '@' `< % `> `( % `) : valres

  1. Else Dangling

relation Eval_rul: C |- rulmatch -> rulpath '@' `( val*{val <- val*} `) : %

1. (Let id '=' exp_out*{exp_out <- exp_out*} '-' prem_path*{prem_path <- prem_path*} be rulpath)

  1. (Let exp*{exp <- exp*} '-' prem_match*{prem_match <- prem_match*} be rulmatch)

    1. (Assign_exps: C |- exp*{exp <- exp*} := val*{val <- val*} : C')

      1. (Let prem*{prem <- prem*} be prem_match*{prem_match <- prem_match*} ++ prem_path*{prem_path <- prem_path*})

        1. (Eval_prems: C' |- prem*{prem <- prem*} : res<ctx>)

          1. If (res<ctx> matches OK %), then

            1. (Let OK C'' be res<ctx>)

              1. (Eval_exp: C'' |- exp_out : res<val>)*{exp_out <- exp_out*, res<val> -> res<val>*}

                1. If (res<val> matches OK %)*{res<val> <- res<val>*}, then

                  1. (Let OK val_out be res<val>)*{res<val> <- res<val>*, val_out -> val_out*}

                    1. Result in: % |- % -> % '@' `( % `) : OK val_out*{val_out <- val_out*}

2. Otherwise,

  1. Result in: % |- % -> % '@' `( % `) : FAIL

relation Eval_ruls: C |- rulmatch -> rulpath*{rulpath <- rulpath*} '@' `( val*{val <- val*} `) : %

1. Case analysis on rulpath*{rulpath <- rulpath*} (total)

  1. Case (% matches pattern [])

    1. Result in: % |- % -> % '@' `( % `) : FAIL

  2. Case (% matches pattern _ :: _)

    1. (Let rulpath_h :: rulpath_t*{rulpath_t <- rulpath_t*} be rulpath*{rulpath <- rulpath*})

      1. (Eval_rul: C |- rulmatch -> rulpath_h '@' `( val*{val <- val*} `) : res<val*>)

        1. Case analysis on res<val*> (total)

          1. Case (% matches pattern OK %)

            1. (Let OK val_out*{val_out <- val_out*} be res<val*>)

              1. Result in: % |- % -> % '@' `( % `) : OK val_out*{val_out <- val_out*}

          2. Case (% matches pattern FAIL)

            1. (Eval_ruls: C |- rulmatch -> rulpath_t*{rulpath_t <- rulpath_t*} '@' `( val*{val <- val*} `) : valsres)

              1. Result in: % |- % -> % '@' `( % `) : valsres

relation Eval_rulgroup: C |- rulgroup '@' `( val*{val <- val*} `) : %

1. (Let id ':' rulmatch '=' rulpath*{rulpath <- rulpath*} be rulgroup)

  1. (Eval_ruls: C |- rulmatch -> rulpath*{rulpath <- rulpath*} '@' `( val*{val <- val*} `) : res<val*>)

    1. If (res<val*> matches OK %), then

      1. (Let OK val_out*{val_out <- val_out*} be res<val*>)

        1. Result in: % |- % '@' `( % `) : OK val_out*{val_out <- val_out*}

2. Otherwise,

  1. Result in: % |- % '@' `( % `) : FAIL

relation Eval_rulgroups: C |- rulgroup*{rulgroup <- rulgroup*} '@' `( val*{val <- val*} `) : %

1. Case analysis on rulgroup*{rulgroup <- rulgroup*} (total)

  1. Case (% matches pattern [])

    1. Result in: % |- % '@' `( % `) : FAIL

  2. Case (% matches pattern _ :: _)

    1. (Let rulgroup_h :: rulgroup_t*{rulgroup_t <- rulgroup_t*} be rulgroup*{rulgroup <- rulgroup*})

      1. (Eval_rulgroup: C |- rulgroup_h '@' `( val*{val <- val*} `) : res<val*>)

        1. Case analysis on res<val*> (total)

          1. Case (% matches pattern OK %)

            1. (Let OK val_out*{val_out <- val_out*} be res<val*>)

              1. Result in: % |- % '@' `( % `) : OK val_out*{val_out <- val_out*}

          2. Case (% matches pattern FAIL)

            1. (Eval_rulgroups: C |- rulgroup_t*{rulgroup_t <- rulgroup_t*} '@' `( val*{val <- val*} `) : valsres)

              1. Result in: % |- % '@' `( % `) : valsres

relation Call_defined_rel: C |- definedRelDef '@' `( val*{val <- val*} `) : %

1. (Let DEF rulgroup*{rulgroup <- rulgroup*} elsgroup?{elsgroup <- elsgroup?} be definedRelDef)

  1. (Let rulgroup_els be $elsgroup_as_rulgroup(elsgroup))?{elsgroup <- elsgroup?, rulgroup_els -> rulgroup_els?}

    1. (Let rulgroup_all*{rulgroup_all <- rulgroup_all*} be rulgroup*{rulgroup <- rulgroup*} ++ $opt_as_seq_<rulgroup>(rulgroup_els?{rulgroup_els <- rulgroup_els?}))

      1. (Let C_local be C[LOCAL = $empty_layer])

        1. (Eval_rulgroups: C_local |- rulgroup_all*{rulgroup_all <- rulgroup_all*} '@' `( val*{val <- val*} `) : valsres)

          1. Result in: % |- % '@' `( % `) : valsres

def $elsgroup_as_rulgroup(id ':' rulmatch '=' rulpath)

1. Return id ':' rulmatch '=' [rulpath]

relation Entry: |- script : %

1. Debug: "entry-al"

2. (Let C be $load($empty_ctx, script))

  1. Debug: "load complete"

  2. Debug: "into call"

  3. (Eval_exp: C |- CALL "main" [] [] : res<val>)

    1. If (res<val> matches OK %), then

      1. (Let OK val be res<val>)

        1. Debug: val

        2. Result in: |- % : val

    1. Else Dangling
