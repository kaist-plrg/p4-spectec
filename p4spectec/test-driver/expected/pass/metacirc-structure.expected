var b : bool

var i : int

var n : nat

var t : text

def $ite<X>(b, X_t, X_f)

1. Case analysis on b (total)

  1. Case (% = true)

    1. Return X_t

  2. Case (% = false)

    1. Return X_f

def $opt_as_seq_<X>(X'?{X' <- X'?})

1. Case analysis on X'?{X' <- X'?} (total)

  1. Case (% matches pattern ())

    1. Return []

  2. Case (% matches pattern (_))

    1. (Let ?(X) be X'?{X' <- X'?})

      1. Return [X]

def $exists_(b*{b <- b*})

1. Case analysis on b*{b <- b*} (total)

  1. Case (% matches pattern [])

    1. Return false

  2. Case (% matches pattern _ :: _)

    1. (Let b_h :: b_t*{b_t <- b_t*} be b*{b <- b*})

      1. Return (b_h \/ $exists_(b_t*{b_t <- b_t*}))

def $forall_(b*{b <- b*})

1. Case analysis on b*{b <- b*} (total)

  1. Case (% matches pattern [])

    1. Return true

  2. Case (% matches pattern _ :: _)

    1. (Let b_h :: b_t*{b_t <- b_t*} be b*{b <- b*})

      1. Return (b_h /\ $forall_(b_t*{b_t <- b_t*}))

def $repeat_<X>(X, n)

1. Case analysis on n (total)

  1. Case (% = 0)

    1. Return []

  2. Case (% =/= 0)

    1. (Let i be (n - 1))

      1. If (i <: nat), then

        1. (Let n' be i as nat)

          1. Return [X] ++ $repeat_<X>(X, n')

      1. Else Dangling

builtin def $rev_<X>(X*{X <- X*})

builtin def $assoc_<X, Y>(X, (X, Y)*{(X, Y) <- (X, Y)*})

builtin def $transpose_<X>(X*{X <- X*}*{X* <- X**})

syntax set<K> =
   | `{ K* `} (from set<K>)

def $empty_set<K>

1. Return `{ [] `}

syntax pair<K, V> =
   | K ':' V (from pair<K, V>)

syntax map<K, V> = set<pair<K, V>>

def $empty_map<K, V>

1. Return `{ [] `}

builtin def $find_map<K, V>(map<K, V>, K)

builtin def $find_maps<K, V>(map<K, V>*{map<K, V> <- map<K, V>*}, K)

builtin def $add_map<K, V>(map<K, V>, K, V)

builtin def $adds_map<K, V>(map<K, V>, K*{K <- K*}, V*{V <- V*})

syntax id = text

syntax atom = text

syntax mixop = atom**

syntax numtyp =
   | NAT (from numtyp)
   | INT (from numtyp)

syntax optyp =
   | BOOL (from optyp)
   | NAT (from numtyp)
   | INT (from numtyp)
   | TEXT (from optyp)

syntax typ =
   | BOOL (from optyp)
   | NAT (from numtyp)
   | INT (from numtyp)
   | TEXT (from optyp)
   | VAR id targ* (from typ)
   | TUP typ* (from typ)
   | ITER typ iter (from typ)
   | FUNC tparam* typ* typ (from typ)

syntax deftyp =
   | ALIAS typ (from deftyp)
   | STRUCT typfield* (from deftyp)
   | VARIANT typcase* (from deftyp)

syntax typfield =
   | atom typ (from typfield)

syntax typcase =
   | mixop typ* (from typcase)

syntax iter =
   | QUEST (from iter)
   | STAR (from iter)

syntax vari =
   | id typ iter* (from vari)

syntax num =
   | NAT nat (from num)
   | INT int (from num)

syntax boolunop =
   | NOT (from boolunop)

syntax boolbinop =
   | AND (from boolbinop)
   | OR (from boolbinop)
   | IMPL (from boolbinop)
   | EQUIV (from boolbinop)

syntax numunop =
   | PLUS (from numunop)
   | MINUS (from numunop)

syntax numbinop =
   | ADD (from numbinop)
   | SUB (from numbinop)
   | MUL (from numbinop)
   | DIV (from numbinop)
   | MOD (from numbinop)
   | POW (from numbinop)

syntax numcmpop =
   | LT (from numcmpop)
   | GT (from numcmpop)
   | LE (from numcmpop)
   | GE (from numcmpop)

syntax polycmpop =
   | EQ (from polycmpop)
   | NE (from polycmpop)

syntax unop =
   | NOT (from boolunop)
   | PLUS (from numunop)
   | MINUS (from numunop)

syntax binop =
   | AND (from boolbinop)
   | OR (from boolbinop)
   | IMPL (from boolbinop)
   | EQUIV (from boolbinop)
   | ADD (from numbinop)
   | SUB (from numbinop)
   | MUL (from numbinop)
   | DIV (from numbinop)
   | MOD (from numbinop)
   | POW (from numbinop)

syntax cmpop =
   | EQ (from polycmpop)
   | NE (from polycmpop)
   | LT (from numcmpop)
   | GT (from numcmpop)
   | LE (from numcmpop)
   | GE (from numcmpop)

extern syntax json

syntax val =
   | BOOL bool (from val)
   | NAT nat (from num)
   | INT int (from num)
   | TEXT text (from val)
   | STR valfield* (from val)
   | INJ valcase (from val)
   | TUP val* (from val)
   | OPT val? (from val)
   | LIST val* (from val)
   | FUNC id (from val)
   | EXT json (from val)

syntax valfield =
   | atom val (from valfield)

syntax valcase =
   | mixop val* (from valcase)

syntax exp =
   | BOOL bool (from exp)
   | NAT nat (from num)
   | INT int (from num)
   | TEXT text (from exp)
   | VAR id (from exp)
   | UN unop exp (from exp)
   | BIN binop exp exp (from exp)
   | CMP cmpop exp exp (from exp)
   | UPCAST typ exp (from exp)
   | DOWNCAST typ exp (from exp)
   | SUB exp typ (from exp)
   | MATCH exp pattern (from exp)
   | TUP exp* (from exp)
   | INJ expcase (from exp)
   | STR expfield* (from exp)
   | OPT exp? (from exp)
   | LIST exp* (from exp)
   | CONS exp exp (from exp)
   | CAT exp exp (from exp)
   | MEM exp exp (from exp)
   | LEN exp (from exp)
   | DOT exp atom (from exp)
   | IDX exp exp (from exp)
   | SLICE exp exp exp (from exp)
   | UPD exp path exp (from exp)
   | CALL id targ* arg* (from exp)
   | ITER exp iterexp (from exp)

syntax expcase =
   | mixop exp* (from expcase)

syntax expfield =
   | atom exp (from expfield)

syntax iterexp =
   | iter vari* (from iterexp)

syntax listpattern =
   | CONS (from listpattern)
   | FIXED nat (from listpattern)
   | NIL (from listpattern)

syntax optpattern =
   | SOME (from optpattern)
   | NONE (from optpattern)

syntax pattern =
   | INJ mixop (from pattern)
   | CONS (from listpattern)
   | FIXED nat (from listpattern)
   | NIL (from listpattern)
   | SOME (from optpattern)
   | NONE (from optpattern)

syntax path =
   | ROOT (from path)
   | IDX path exp (from path)
   | SLICE path exp exp (from path)
   | DOT path atom (from path)

syntax targ = typ

syntax arg =
   | EXP exp (from arg)
   | FUN id (from arg)

syntax tparam = id

syntax param =
   | EXP typ (from param)
   | FUN id ':' tparam* param* '->' typ (from param)

syntax iterprem =
   | iter vari* vari* (from iterprem)

syntax prem =
   | REL id ':' exp* '->' exp* (from prem)
   | IF exp (from prem)
   | IFHOLD id ':' exp* (from prem)
   | IFNOTHOLD id ':' exp* (from prem)
   | LET exp '=' exp (from prem)
   | ITER prem iterprem (from prem)
   | DEBUG exp (from prem)

syntax rulmatch =
   | exp* '-' prem* (from rulmatch)

syntax rulpath =
   | id '=' exp* '-' prem* (from rulpath)

syntax rulgroup =
   | id ':' rulmatch '=' rulpath* (from rulgroup)

syntax elsgroup =
   | id ':' rulmatch '=' rulpath (from elsgroup)

syntax clause =
   | arg* '=' exp '-' prem* (from clause)

syntax elsclause = clause

syntax tblrow =
   | arg* '=' exp '-' prem* (from tblrow)

syntax defn =
   | EXTTYP id (from defn)
   | TYP id tparam* '=' deftyp (from defn)
   | EXTREL id ':' typ* '->' typ* (from defn)
   | REL id ':' typ* '->' typ* '=' rulgroup* elsgroup? (from defn)
   | EXTFUNC id tparam* param* ':' typ (from defn)
   | BUILTINFUNC id tparam* param* ':' typ (from defn)
   | TABLEFUNC id param* ':' typ '=' tblrow* (from defn)
   | FUNC id tparam* param* ':' typ '=' clause* elsclause? (from defn)

syntax script = defn*

syntax varr =
   | id iter* (from varr)

syntax venv = map<varr, val>

syntax typdef =
   | PARAM (from typdef)
   | EXT (from typdef)
   | DEF tparam* '->' deftyp (from typdef)

syntax tdenv = map<id, typdef>

syntax theta = map<id, typ>

def $extend_tdenv(tdenv_global, set<pair<id, typdef>>)

1. If ((set<pair<id, typdef>> = `{ [] `})), then

  1. Return tdenv_global

2. Otherwise,

  1. (Let `{ id ':' typdef*{id <- id*, typdef <- typdef*} `} be set<pair<id, typdef>>)

    1. Return $adds_map<id, typdef>(tdenv_global, id*{id <- id*}, typdef*{typdef <- typdef*})

def $theta_of_tdenv(set<pair<id, typdef>>)

1. If ((set<pair<id, typdef>> = `{ [] `})), then

  1. Return $empty_map<id, typ>

1. Else Dangling

2. (Let `{ pair<id, typdef>*{pair<id, typdef> <- pair<id, typdef>*} `} be set<pair<id, typdef>>)

  1. If (pair<id, typdef>*{pair<id, typdef> <- pair<id, typdef>*} matches _ :: _), then

    1. (Let id_h ':' typdef_h :: id_t ':' typdef_t*{id_t <- id_t*, typdef_t <- typdef_t*} be pair<id, typdef>*{pair<id, typdef> <- pair<id, typdef>*})

      1. If (typdef_h matches DEF % '->' %), then

        1. (Let DEF tparam*{tparam <- tparam*} '->' deftyp be typdef_h)

          1. If (tparam*{tparam <- tparam*} matches []), then

            1. If (deftyp matches ALIAS %), then

              1. (Let ALIAS typ_h be deftyp)

                1. (Let theta_t be $theta_of_tdenv(`{ id_t ':' typdef_t*{id_t <- id_t*, typdef_t <- typdef_t*} `}))

                  1. Return $add_map<id, typ>(theta_t, id_h, typ_h)

            1. Else Dangling

          1. Else Dangling

      1. Else Dangling

      2. If (((typdef_h = PARAM) \/ (typdef_h = EXT))), then

        1. Return $theta_of_tdenv(`{ id_t ':' typdef_t*{id_t <- id_t*, typdef_t <- typdef_t*} `})

      2. Else Dangling

  1. Else Dangling

def $is_iter_on_var(exp')

1. Case analysis on exp'

  1. Case (% matches pattern VAR %)

    1. (Let VAR id be exp')

      1. Return ?(id [])

  2. Case (% matches pattern ITER % %)

    1. (Let ITER exp iterexp be exp')

      1. (Let varr?{varr <- varr?} be $is_iter_on_var(exp))

        1. If (varr?{varr <- varr?} matches (_)), then

          1. (Let ?(id iter*{iter <- iter*}) be varr?{varr <- varr?})

            1. (Let iter_outer vari*{vari <- vari*} be iterexp)

              1. If (vari*{vari <- vari*} matches [ _/1 ]), then

                1. (Let [id' _typ iter'*{iter' <- iter'*}] be vari*{vari <- vari*})

                  1. If ((id' = id)), then

                    1. If ((iter'*{iter' <- iter'*} = iter*{iter <- iter*})), then

                      1. Return ?(id iter*{iter <- iter*} ++ [iter_outer])

2. Otherwise,

  1. Return ?()

def $iter_vari(id typ iter*{iter <- iter*}, iter_add)

1. Return id typ iter*{iter <- iter*} ++ [iter_add]

def $iter_varr(id iter*{iter <- iter*}, iter_add)

1. Return id iter*{iter <- iter*} ++ [iter_add]

syntax externRelDef =
   | EXT id (from externRelDef)

syntax definedRelDef =
   | DEF rulgroup* elsgroup? (from definedRelDef)

syntax reldef =
   | EXT id (from externRelDef)
   | DEF rulgroup* elsgroup? (from definedRelDef)

syntax renv = map<id, reldef>

syntax externFuncDef =
   | EXT id tparam* param* typ (from externFuncDef)

syntax builtinFuncDef =
   | BUILTIN id tparam* param* typ (from builtinFuncDef)

syntax tableFuncDef =
   | TABLE param* typ '->' tblrow* (from tableFuncDef)

syntax definedFuncDef =
   | DEF tparam* param* typ '->' clause* elsclause? (from definedFuncDef)

syntax funcdef =
   | EXT id tparam* param* typ (from externFuncDef)
   | BUILTIN id tparam* param* typ (from builtinFuncDef)
   | TABLE param* typ '->' tblrow* (from tableFuncDef)
   | DEF tparam* param* typ '->' clause* elsclause? (from definedFuncDef)

syntax fenv = map<id, funcdef>

syntax cursor =
   | GLOBAL (from cursor)
   | LOCAL (from cursor)

syntax layer = {TYP tdenv, REL renv, FUNC fenv, VAL venv}

def $empty_layer

1. Return {TYP $empty_map<id, typdef>, REL $empty_map<id, reldef>, FUNC $empty_map<id, funcdef>, VAL $empty_map<varr, val>}

syntax ctx = {GLOBAL layer, LOCAL layer}

def $empty_ctx

1. Return {GLOBAL $empty_layer, LOCAL $empty_layer}

var C : ctx

def $load_typdef(C, id, typdef)

1. (Let tdenv_update be $add_map<id, typdef>(C.GLOBAL.TYP, id, typdef))

  1. Return C[GLOBAL.TYP = tdenv_update]

def $load_reldef(C, id, reldef)

1. (Let renv_update be $add_map<id, reldef>(C.GLOBAL.REL, id, reldef))

  1. Return C[GLOBAL.REL = renv_update]

def $load_funcdef(C, id, funcdef)

1. (Let fenv_update be $add_map<id, funcdef>(C.GLOBAL.FUNC, id, funcdef))

  1. Return C[GLOBAL.FUNC = fenv_update]

def $load(C, defn*{defn <- defn*})

1. Case analysis on defn*{defn <- defn*} (total)

  1. Case (% matches pattern _ :: _)

    1. (Let defn_h :: defn_t*{defn_t <- defn_t*} be defn*{defn <- defn*})

      1. Case analysis on defn_h (total)

        1. Case (% matches pattern EXTTYP %)

          1. (Let EXTTYP id be defn_h)

            1. (Let C' be $load_typdef(C, id, EXT))

              1. Return $load(C', defn_t*{defn_t <- defn_t*})

        2. Case (% matches pattern TYP % % '=' %)

          1. (Let TYP id tparam*{tparam <- tparam*} '=' deftyp be defn_h)

            1. (Let C' be $load_typdef(C, id, DEF tparam*{tparam <- tparam*} '->' deftyp))

              1. Return $load(C', defn_t*{defn_t <- defn_t*})

        3. Case (% matches pattern EXTREL % ':' % '->' %)

          1. (Let EXTREL id ':' typ_input*{typ_input <- typ_input*} '->' typ_output*{typ_output <- typ_output*} be defn_h)

            1. (Let C' be $load_reldef(C, id, EXT id as reldef))

              1. Return $load(C', defn_t*{defn_t <- defn_t*})

        4. Case (% matches pattern REL % ':' % '->' % '=' % %)

          1. (Let REL id ':' typ_input*{typ_input <- typ_input*} '->' typ_output*{typ_output <- typ_output*} '=' rulgroup*{rulgroup <- rulgroup*} elsgroup?{elsgroup <- elsgroup?} be defn_h)

            1. (Let C' be $load_reldef(C, id, DEF rulgroup*{rulgroup <- rulgroup*} elsgroup?{elsgroup <- elsgroup?} as reldef))

              1. Return $load(C', defn_t*{defn_t <- defn_t*})

        5. Case (% matches pattern EXTFUNC % % % ':' %)

          1. (Let EXTFUNC id tparam*{tparam <- tparam*} param*{param <- param*} ':' typ be defn_h)

            1. (Let C' be $load_funcdef(C, id, EXT id tparam*{tparam <- tparam*} param*{param <- param*} typ as funcdef))

              1. Return $load(C', defn_t*{defn_t <- defn_t*})

        6. Case (% matches pattern BUILTINFUNC % % % ':' %)

          1. (Let BUILTINFUNC id tparam*{tparam <- tparam*} param*{param <- param*} ':' typ be defn_h)

            1. (Let C' be $load_funcdef(C, id, BUILTIN id tparam*{tparam <- tparam*} param*{param <- param*} typ as funcdef))

              1. Return $load(C', defn_t*{defn_t <- defn_t*})

        7. Case (% matches pattern TABLEFUNC % % ':' % '=' %)

          1. (Let TABLEFUNC id param*{param <- param*} ':' typ '=' tblrow*{tblrow <- tblrow*} be defn_h)

            1. (Let C' be $load_funcdef(C, id, TABLE param*{param <- param*} typ '->' tblrow*{tblrow <- tblrow*} as funcdef))

              1. Return $load(C', defn_t*{defn_t <- defn_t*})

        8. Case (% matches pattern FUNC % % % ':' % '=' % %)

          1. (Let FUNC id tparam*{tparam <- tparam*} param*{param <- param*} ':' typ '=' clause*{clause <- clause*} elsclause?{elsclause <- elsclause?} be defn_h)

            1. (Let C' be $load_funcdef(C, id, DEF tparam*{tparam <- tparam*} param*{param <- param*} typ '->' clause*{clause <- clause*} elsclause?{elsclause <- elsclause?} as funcdef))

              1. Return $load(C', defn_t*{defn_t <- defn_t*})

  2. Case (% matches pattern [])

    1. Return C

def $add_vari(C, vari, val)

1. (Let id _typ iter*{iter <- iter*} be vari)

  1. (Let venv_update be $add_map<varr, val>(C.LOCAL.VAL, id iter*{iter <- iter*}, val))

    1. Return C[LOCAL.VAL = venv_update]

def $add_varr(C, varr, val)

1. (Let venv_update be $add_map<varr, val>(C.LOCAL.VAL, varr, val))

  1. Return C[LOCAL.VAL = venv_update]

def $add_varis(C, vari*{vari <- vari*}, val*{val <- val*})

1. (Let id _typ iter*{iter <- iter*} be vari)*{vari <- vari*, _typ -> _typ*, id -> id*, iter* -> iter**}

  1. (Let venv_update be $adds_map<varr, val>(C.LOCAL.VAL, id iter*{iter <- iter*}*{id <- id*, iter* <- iter**}, val*{val <- val*}))

    1. Return C[LOCAL.VAL = venv_update]

def $add_varrs(C, varr*{varr <- varr*}, val*{val <- val*})

1. (Let venv_update be $adds_map<varr, val>(C.LOCAL.VAL, varr*{varr <- varr*}, val*{val <- val*}))

  1. Return C[LOCAL.VAL = venv_update]

def $add_typ(C, id, typdef)

1. (Let tdenv_update be $add_map<id, typdef>(C.LOCAL.TYP, id, typdef))

  1. Return C[LOCAL.TYP = tdenv_update]

def $add_func(C, id, funcdef)

1. (Let fenv_update be $add_map<id, funcdef>(C.LOCAL.FUNC, id, funcdef))

  1. Return C[LOCAL.FUNC = fenv_update]

def $find_vari(C, vari)

1. (Let id _typ iter*{iter <- iter*} be vari)

  1. (Let val'?{val' <- val'?} be $find_map<varr, val>(C.LOCAL.VAL, id iter*{iter <- iter*}))

    1. If (val'?{val' <- val'?} matches (_)), then

      1. (Let ?(val) be val'?{val' <- val'?})

        1. Return ?(val)

    1. Else Dangling

def $find_varr(C, varr)

1. Return $find_map<varr, val>(C.LOCAL.VAL, varr)

def $find_varis(C, vari*{vari <- vari*})

1. (Let val'?{val' <- val'?} be $find_vari(C, vari))*{vari <- vari*, val'? -> val'?*}

  1. If (val'?{val' <- val'?} matches (_))*{val'? <- val'?*}, then

    1. (Let ?(val) be val'?{val' <- val'?})*{val'? <- val'?*, val -> val*}

      1. Return ?(val*{val <- val*})

2. Otherwise,

  1. Return ?()

def $find_varrs(C, varr*{varr <- varr*})

1. (Let val'?{val' <- val'?} be $find_map<varr, val>(C.LOCAL.VAL, varr))*{varr <- varr*, val'? -> val'?*}

  1. If (val'?{val' <- val'?} matches (_))*{val'? <- val'?*}, then

    1. (Let ?(val) be val'?{val' <- val'?})*{val'? <- val'?*, val -> val*}

      1. Return ?(val*{val <- val*})

2. Otherwise,

  1. Return ?()

def $finds_vari(C*{C <- C*}, vari)

1. (Let id _typ iter*{iter <- iter*} be vari)

  1. (Let val'?{val' <- val'?} be $find_map<varr, val>(C.LOCAL.VAL, id iter*{iter <- iter*}))*{C <- C*, val'? -> val'?*}

    1. If (val'?{val' <- val'?} matches (_))*{val'? <- val'?*}, then

      1. (Let ?(val) be val'?{val' <- val'?})*{val'? <- val'?*, val -> val*}

        1. Return ?(val*{val <- val*})

2. Otherwise,

  1. Return ?()

def $find_typ(C, id)

1. (Let typdef'?{typdef' <- typdef'?} be $find_map<id, typdef>(C.LOCAL.TYP, id))

  1. If (typdef'?{typdef' <- typdef'?} matches (_)), then

    1. (Let ?(typdef) be typdef'?{typdef' <- typdef'?})

      1. Return ?(typdef)

  1. Else Dangling

2. If ($find_map<id, typdef>(C.LOCAL.TYP, id) matches ()), then

  1. Return $find_map<id, typdef>(C.GLOBAL.TYP, id)

2. Else Dangling

def $find_func(C, id)

1. (Let funcdef'?{funcdef' <- funcdef'?} be $find_map<id, funcdef>(C.LOCAL.FUNC, id))

  1. If (funcdef'?{funcdef' <- funcdef'?} matches (_)), then

    1. (Let ?(funcdef) be funcdef'?{funcdef' <- funcdef'?})

      1. Return ?(funcdef)

2. If ($find_map<id, funcdef>(C.LOCAL.FUNC, id) matches ()), then

  1. (Let funcdef'?{funcdef' <- funcdef'?} be $find_map<id, funcdef>(C.GLOBAL.FUNC, id))

    1. If (funcdef'?{funcdef' <- funcdef'?} matches (_)), then

      1. (Let ?(funcdef) be funcdef'?{funcdef' <- funcdef'?})

        1. Return ?(funcdef)

3. Otherwise,

  1. Return ?()

def $find_rel(C, id)

1. Return $find_map<id, reldef>(C.GLOBAL.REL, id)

def $sub_opt(C, vari*{vari <- vari*})

1. (Let vari_iter be $iter_vari(vari, QUEST))*{vari <- vari*, vari_iter -> vari_iter*}

  1. (Let val'''?{val''' <- val'''?} be $find_vari(C, vari_iter))*{vari_iter <- vari_iter*, val'''? -> val'''?*}

    1. If (val'''?{val''' <- val'''?} matches (_))*{val'''? <- val'''?*}, then

      1. (Let ?(val'') be val'''?{val''' <- val'''?})*{val'''? <- val'''?*, val'' -> val''*}

        1. If (val'' matches OPT %)*{val'' <- val''*}, then

          1. (Let OPT val'?{val' <- val'?} be val'')*{val'' <- val''*, val'? -> val'?*}

            1. If (val'?{val' <- val'?} matches (_))*{val'? <- val'?*}, then

              1. (Let ?(val) be val'?{val' <- val'?})*{val'? <- val'?*, val -> val*}

                1. Return ?($add_varis(C, vari*{vari <- vari*}, val*{val <- val*}))

            1. Else Dangling

        1. Else Dangling

    1. Else Dangling

  2. If ((?(OPT ?()) = $find_vari(C, vari_iter)))*{vari_iter <- vari_iter*}, then

    1. Return ?()

  2. Else Dangling

def $sub_list(C, vari*{vari <- vari*})

1. (Let vari_iter be $iter_vari(vari, STAR))*{vari <- vari*, vari_iter -> vari_iter*}

  1. (Let val''?{val'' <- val''?} be $find_vari(C, vari_iter))*{vari_iter <- vari_iter*, val''? -> val''?*}

    1. If (val''?{val'' <- val''?} matches (_))*{val''? <- val''?*}, then

      1. (Let ?(val') be val''?{val'' <- val''?})*{val''? <- val''?*, val' -> val'*}

        1. If (val' matches LIST %)*{val' <- val'*}, then

          1. (Let LIST val*{val <- val*} be val')*{val' <- val'*, val* -> val**}

            1. (Let val_trans*{val_trans <- val_trans*}*{val_trans* <- val_trans**} be $transpose_<val>(val*{val <- val*}*{val* <- val**}))

              1. (Let C' be $add_varis(C, vari*{vari <- vari*}, val_trans*{val_trans <- val_trans*}))*{val_trans* <- val_trans**, C' -> C'*}

                1. Return C'*{C' <- C'*}

        1. Else Dangling

    1. Else Dangling

syntax unitres =
   | OK (from unitres)
   | FAIL (from unitres)

syntax res<X> =
   | OK X (from res<X>)
   | FAIL (from res<X>)

syntax valres = res<val>

syntax valsres = res<val*>

extern relation Call_extern_func: |- id `< typ*{typ <- typ*} `> `( val*{val <- val*} `) : %

extern relation Call_builtin_func: |- id '@' `< typ*{typ <- typ*} `> `( val*{val <- val*} `) : %

extern relation Call_extern_rel: |- id val*{val <- val*} : %

syntax ctxres = res<ctx>

relation Eval_exp: C |- exp'' : %

1. Case analysis on exp'' (total)

  1. Case (% matches pattern BOOL %)

    1. (Let BOOL b be exp'')

      1. Result in: % |- % : OK BOOL b

  2. Case (% has type num)

    1. (Let num be exp'' as num)

      1. Result in: % |- % : OK num as val

  3. Case (% matches pattern TEXT %)

    1. (Let TEXT t be exp'')

      1. Result in: % |- % : OK TEXT t

  4. Case (% matches pattern VAR %)

    1. (Let VAR id be exp'')

      1. (Let val'?{val' <- val'?} be $find_varr(C, id []))

        1. If (val'?{val' <- val'?} matches (_)), then

          1. (Let ?(val) be val'?{val' <- val'?})

            1. Result in: % |- % : OK val

  5. Case (% matches pattern UN % %)

    1. (Let UN unop exp be exp'')

      1. If ((unop = NOT as unop)), then

        1. (Eval_exp: C |- exp : res<val>)

          1. If (res<val> matches OK %), then

            1. (Let OK val be res<val>)

              1. If (val matches BOOL %), then

                1. (Let BOOL b be val)

                  1. Result in: % |- % : OK BOOL ~b

      2. If (unop <: numunop), then

        1. (Let numunop be unop as numunop)

          1. (Eval_exp: C |- exp : res<val>)

            1. If (res<val> matches OK %), then

              1. (Let OK val be res<val>)

                1. If (val <: num), then

                  1. (Let num be val as num)

                    1. (Let val_res be $unop_number(numunop, num))

                      1. Result in: % |- % : OK val_res

  6. Case (% matches pattern BIN % % %)

    1. (Let BIN binop exp_l exp_r be exp'')

      1. Case analysis on binop (total)

        1. Case (% has type boolbinop)

          1. (Let boolbinop be binop as boolbinop)

            1. (Eval_exp: C |- exp_l : res<val>)

              1. If (res<val> matches OK %), then

                1. (Let OK val be res<val>)

                  1. If (val matches BOOL %), then

                    1. (Let BOOL b_l be val)

                      1. (Eval_exp: C |- exp_r : res<val>')

                        1. If (res<val>' matches OK %), then

                          1. (Let OK val' be res<val>')

                            1. If (val' matches BOOL %), then

                              1. (Let BOOL b_r be val')

                                1. (Let b_res be $binop_bool(boolbinop, b_l, b_r))

                                  1. Result in: % |- % : OK BOOL b_res

        2. Case (% has type numbinop)

          1. (Let numbinop be binop as numbinop)

            1. (Eval_exp: C |- exp_l : res<val>)

              1. If (res<val> matches OK %), then

                1. (Let OK val be res<val>)

                  1. If (val <: num), then

                    1. (Let num_l be val as num)

                      1. (Eval_exp: C |- exp_r : res<val>')

                        1. If (res<val>' matches OK %), then

                          1. (Let OK val' be res<val>')

                            1. If (val' <: num), then

                              1. (Let num_r be val' as num)

                                1. (Let val_res be $binop_number(numbinop, num_l, num_r))

                                  1. Result in: % |- % : OK val_res

  7. Case (% matches pattern CMP % % %)

    1. (Let CMP cmpop exp_l exp_r be exp'')

      1. Case analysis on cmpop (total)

        1. Case (% has type polycmpop)

          1. (Let polycmpop be cmpop as polycmpop)

            1. (Eval_exp: C |- exp_l : res<val>)

              1. If (res<val> matches OK %), then

                1. (Let OK val_l be res<val>)

                  1. (Eval_exp: C |- exp_r : res<val>')

                    1. If (res<val>' matches OK %), then

                      1. (Let OK val_r be res<val>')

                        1. (Let b_res be $cmpop_poly(polycmpop, val_l, val_r))

                          1. Result in: % |- % : OK BOOL b_res

        2. Case (% has type numcmpop)

          1. (Let numcmpop be cmpop as numcmpop)

            1. (Eval_exp: C |- exp_l : res<val>)

              1. If (res<val> matches OK %), then

                1. (Let OK val be res<val>)

                  1. If (val <: num), then

                    1. (Let num_l be val as num)

                      1. (Eval_exp: C |- exp_r : res<val>')

                        1. If (res<val>' matches OK %), then

                          1. (Let OK val' be res<val>')

                            1. If (val' <: num), then

                              1. (Let num_r be val' as num)

                                1. (Let b_res be $cmpop_number(numcmpop, num_l, num_r))

                                  1. Result in: % |- % : OK BOOL b_res

  8. Case (% matches pattern UPCAST % %)

    1. (Let UPCAST typ exp be exp'')

      1. (Eval_exp: C |- exp : res<val>)

        1. If (res<val> matches OK %), then

          1. (Let OK val be res<val>)

            1. Result in: % |- % : $upcast(C, typ, val)

  9. Case (% matches pattern DOWNCAST % %)

    1. (Let DOWNCAST typ exp be exp'')

      1. (Eval_exp: C |- exp : res<val>)

        1. If (res<val> matches OK %), then

          1. (Let OK val be res<val>)

            1. Result in: % |- % : $downcast(C, typ, val)

  10. Case (% matches pattern SUB % %)

    1. (Let SUB exp typ be exp'')

      1. (Eval_exp: C |- exp : res<val>)

        1. If (res<val> matches OK %), then

          1. (Let OK val be res<val>)

            1. (Let b be $subtyp(C, typ, val))

              1. Result in: % |- % : OK BOOL b

  11. Case (% matches pattern MATCH % %)

    1. (Let MATCH exp pattern be exp'')

      1. Case analysis on pattern

        1. Case (% matches pattern INJ %)

          1. (Let INJ mixop_p be pattern)

            1. (Eval_exp: C |- exp : res<val>)

              1. If (res<val> matches OK %), then

                1. (Let OK val be res<val>)

                  1. If (val matches INJ %), then

                    1. (Let INJ mixop_v _val*{_val <- _val*} be val)

                      1. Result in: % |- % : OK BOOL (mixop_p = mixop_v)

        2. Case (% has type listpattern)

          1. (Let listpattern be pattern as listpattern)

            1. If (listpattern matches FIXED %), then

              1. (Let FIXED n be listpattern)

                1. (Eval_exp: C |- exp : res<val>)

                  1. If (res<val> matches OK %), then

                    1. (Let OK val' be res<val>)

                      1. If (val' matches LIST %), then

                        1. (Let LIST val*{val <- val*} be val')

                          1. Result in: % |- % : OK BOOL (|val*{val <- val*}| = n)

      2. Case analysis on pattern

        1. Case (% = CONS as pattern)

          1. (Eval_exp: C |- exp : res<val>)

            1. If (res<val> matches OK %), then

              1. (Let OK val' be res<val>)

                1. If (val' matches LIST %), then

                  1. (Let LIST val*{val <- val*} be val')

                    1. Result in: % |- % : OK BOOL (|val*{val <- val*}| > 0)

        2. Case (% = NIL as pattern)

          1. (Eval_exp: C |- exp : res<val>)

            1. If (res<val> matches OK %), then

              1. (Let OK val' be res<val>)

                1. If (val' matches LIST %), then

                  1. (Let LIST val*{val <- val*} be val')

                    1. Result in: % |- % : OK BOOL (|val*{val <- val*}| = 0)

        3. Case (% = SOME as pattern)

          1. (Eval_exp: C |- exp : res<val>)

            1. If (res<val> matches OK %), then

              1. (Let OK val' be res<val>)

                1. If (val' matches OPT %), then

                  1. (Let OPT val?{val <- val?} be val')

                    1. Result in: % |- % : OK BOOL (val?{val <- val?} =/= ?())

        4. Case (% = NONE as pattern)

          1. (Eval_exp: C |- exp : res<val>)

            1. If (res<val> matches OK %), then

              1. (Let OK val' be res<val>)

                1. If (val' matches OPT %), then

                  1. (Let OPT val?{val <- val?} be val')

                    1. Result in: % |- % : OK BOOL (val?{val <- val?} = ?())

  12. Case (% matches pattern TUP %)

    1. (Let TUP exp*{exp <- exp*} be exp'')

      1. (Eval_exp: C |- exp : res<val>)*{exp <- exp*, res<val> -> res<val>*}

        1. If (res<val> matches OK %)*{res<val> <- res<val>*}, then

          1. (Let OK val be res<val>)*{res<val> <- res<val>*, val -> val*}

            1. Result in: % |- % : OK TUP val*{val <- val*}

  13. Case (% matches pattern INJ %)

    1. (Let INJ mixop exp*{exp <- exp*} be exp'')

      1. (Eval_exp: C |- exp : res<val>)*{exp <- exp*, res<val> -> res<val>*}

        1. If (res<val> matches OK %)*{res<val> <- res<val>*}, then

          1. (Let OK val be res<val>)*{res<val> <- res<val>*, val -> val*}

            1. Result in: % |- % : OK INJ mixop val*{val <- val*}

  14. Case (% matches pattern STR %)

    1. (Let STR expfield*{expfield <- expfield*} be exp'')

      1. (Let atom exp be expfield)*{expfield <- expfield*, atom -> atom*, exp -> exp*}

        1. (Eval_exp: C |- exp : res<val>)*{exp <- exp*, res<val> -> res<val>*}

          1. If (res<val> matches OK %)*{res<val> <- res<val>*}, then

            1. (Let OK val be res<val>)*{res<val> <- res<val>*, val -> val*}

              1. (Let valfield be atom val)*{atom <- atom*, val <- val*, valfield -> valfield*}

                1. Result in: % |- % : OK STR valfield*{valfield <- valfield*}

  15. Case (% matches pattern OPT %)

    1. (Let OPT exp'?{exp' <- exp'?} be exp'')

      1. Case analysis on exp'?{exp' <- exp'?} (total)

        1. Case (% matches pattern (_))

          1. (Let ?(exp) be exp'?{exp' <- exp'?})

            1. (Eval_exp: C |- exp : res<val>)

              1. If (res<val> matches OK %), then

                1. (Let OK val be res<val>)

                  1. Result in: % |- % : OK OPT ?(val)

        2. Case (% matches pattern ())

          1. Result in: % |- % : OK OPT ?()

  16. Case (% matches pattern LIST %)

    1. (Let LIST exp*{exp <- exp*} be exp'')

      1. (Eval_exp: C |- exp : res<val>)*{exp <- exp*, res<val> -> res<val>*}

        1. If (res<val> matches OK %)*{res<val> <- res<val>*}, then

          1. (Let OK val be res<val>)*{res<val> <- res<val>*, val -> val*}

            1. Result in: % |- % : OK LIST val*{val <- val*}

  17. Case (% matches pattern CONS % %)

    1. (Let CONS exp_h exp_t be exp'')

      1. (Eval_exp: C |- exp_h : res<val>)

        1. If (res<val> matches OK %), then

          1. (Let OK val_h be res<val>)

            1. (Eval_exp: C |- exp_t : res<val>')

              1. If (res<val>' matches OK %), then

                1. (Let OK val be res<val>')

                  1. If (val matches LIST %), then

                    1. (Let LIST val_t*{val_t <- val_t*} be val)

                      1. Result in: % |- % : OK LIST val_h :: val_t*{val_t <- val_t*}

  18. Case (% matches pattern CAT % %)

    1. (Let CAT exp_l exp_r be exp'')

      1. (Eval_exp: C |- exp_l : res<val>)

        1. If (res<val> matches OK %), then

          1. (Let OK val be res<val>)

            1. Case analysis on val

              1. Case (% matches pattern TEXT %)

                1. (Let TEXT text_l be val)

                  1. (Eval_exp: C |- exp_r : res<val>')

                    1. If (res<val>' matches OK %), then

                      1. (Let OK val' be res<val>')

                        1. If (val' matches TEXT %), then

                          1. (Let TEXT text_r be val')

                            1. Result in: % |- % : OK TEXT text_l ++ text_r

              2. Case (% matches pattern LIST %)

                1. (Let LIST val_l*{val_l <- val_l*} be val)

                  1. (Eval_exp: C |- exp_r : res<val>')

                    1. If (res<val>' matches OK %), then

                      1. (Let OK val' be res<val>')

                        1. If (val' matches LIST %), then

                          1. (Let LIST val_r*{val_r <- val_r*} be val')

                            1. Result in: % |- % : OK LIST val_l*{val_l <- val_l*} ++ val_r*{val_r <- val_r*}

  19. Case (% matches pattern MEM % %)

    1. (Let MEM exp_e exp_s be exp'')

      1. (Eval_exp: C |- exp_e : res<val>)

        1. If (res<val> matches OK %), then

          1. (Let OK val_e be res<val>)

            1. (Eval_exp: C |- exp_s : res<val>')

              1. If (res<val>' matches OK %), then

                1. (Let OK val' be res<val>')

                  1. If (val' matches LIST %), then

                    1. (Let LIST val*{val <- val*} be val')

                      1. Result in: % |- % : OK BOOL $exists_((val_e = val)*{val <- val*})

  20. Case (% matches pattern LEN %)

    1. (Let LEN exp be exp'')

      1. (Eval_exp: C |- exp : res<val>)

        1. If (res<val> matches OK %), then

          1. (Let OK val' be res<val>)

            1. Case analysis on val'

              1. Case (% matches pattern TEXT %)

                1. (Let TEXT text be val')

                  1. Result in: % |- % : OK NAT |text| as val

              2. Case (% matches pattern LIST %)

                1. (Let LIST val*{val <- val*} be val')

                  1. Result in: % |- % : OK NAT |val*{val <- val*}| as val

  21. Case (% matches pattern DOT % %)

    1. (Let DOT exp atom be exp'')

      1. (Eval_exp: C |- exp : res<val>)

        1. If (res<val> matches OK %), then

          1. (Let OK val be res<val>)

            1. (Eval_path: C |- val DOT ROOT atom : valres)

              1. Result in: % |- % : valres

  22. Case (% matches pattern IDX % %)

    1. (Let IDX exp_b exp_i be exp'')

      1. (Eval_exp: C |- exp_b : res<val>)

        1. If (res<val> matches OK %), then

          1. (Let OK val_b be res<val>)

            1. (Eval_path: C |- val_b IDX ROOT exp_i : valres)

              1. Result in: % |- % : valres

  23. Case (% matches pattern SLICE % % %)

    1. (Let SLICE exp_b exp_i exp_n be exp'')

      1. (Eval_exp: C |- exp_b : res<val>)

        1. If (res<val> matches OK %), then

          1. (Let OK val_b be res<val>)

            1. (Eval_path: C |- val_b SLICE ROOT exp_i exp_n : valres)

              1. Result in: % |- % : valres

  24. Case (% matches pattern UPD % % %)

    1. (Let UPD exp_b path exp_f be exp'')

      1. (Eval_exp: C |- exp_b : res<val>)

        1. If (res<val> matches OK %), then

          1. (Let OK val_b be res<val>)

            1. (Eval_exp: C |- exp_f : res<val>')

              1. If (res<val>' matches OK %), then

                1. (Let OK val_f be res<val>')

                  1. (Eval_path_upd: C |- val_b path := val_f : valres)

                    1. Result in: % |- % : valres

  25. Case (% matches pattern CALL % % %)

    1. (Let CALL id targ*{targ <- targ*} arg*{arg <- arg*} be exp'')

      1. (Eval_targs: C |- targ*{targ <- targ*} : typ_input*{typ_input <- typ_input*})

        1. (Eval_arg: C |- arg : res<val>)*{arg <- arg*, res<val> -> res<val>*}

          1. If (res<val> matches OK %)*{res<val> <- res<val>*}, then

            1. (Let OK val_input be res<val>)*{res<val> <- res<val>*, val_input -> val_input*}

              1. (Call_func: C |- id targ*{targ <- targ*} val_input*{val_input <- val_input*} : valres)

                1. Result in: % |- % : valres

  26. Case (% matches pattern ITER % %)

    1. (Let ITER exp iterexp be exp'')

      1. (Let varr'?{varr' <- varr'?} be $is_iter_on_var(ITER exp iterexp))

        1. If (varr'?{varr' <- varr'?} matches (_)), then

          1. (Let ?(varr) be varr'?{varr' <- varr'?})

            1. (Let val'?{val' <- val'?} be $find_varr(C, varr))

              1. If (val'?{val' <- val'?} matches (_)), then

                1. (Let ?(val) be val'?{val' <- val'?})

                  1. Result in: % |- % : OK val

      2. If ($is_iter_on_var(ITER exp iterexp) matches ()), then

        1. (Let iter vari*{vari <- vari*} be iterexp)

          1. Case analysis on iter (total)

            1. Case (% matches pattern QUEST)

              1. (Let C_sub?{C_sub <- C_sub?} be $sub_opt(C, vari*{vari <- vari*}))

                1. (Eval_exp: C_sub |- exp : res<val>)?{C_sub <- C_sub?, res<val> -> res<val>?}

                  1. If (res<val> matches OK %)?{res<val> <- res<val>?}, then

                    1. (Let OK val be res<val>)?{res<val> <- res<val>?, val -> val?}

                      1. Result in: % |- % : OK OPT val?{val <- val?}

            2. Case (% matches pattern STAR)

              1. (Let C_sub*{C_sub <- C_sub*} be $sub_list(C, vari*{vari <- vari*}))

                1. (Eval_exp: C_sub |- exp : res<val>)*{C_sub <- C_sub*, res<val> -> res<val>*}

                  1. If (res<val> matches OK %)*{res<val> <- res<val>*}, then

                    1. (Let OK val be res<val>)*{res<val> <- res<val>*, val -> val*}

                      1. Result in: % |- % : OK LIST val*{val <- val*}

2. Otherwise,

  1. Result in: % |- % : FAIL

relation Eval_targs: C |- targ*{targ <- targ*} : %

1. (Let theta be $theta_of_tdenv(C.LOCAL.TYP))

  1. (Let targ_subst be $subst_typ(theta, targ))*{targ <- targ*, targ_subst -> targ_subst*}

    1. Result in: % |- % : targ_subst*{targ_subst <- targ_subst*}

relation Eval_arg: C |- arg : %

1. Case analysis on arg (total)

  1. Case (% matches pattern EXP %)

    1. (Let EXP exp be arg)

      1. (Eval_exp: C |- exp : res<val>)

        1. If (res<val> matches OK %), then

          1. (Let OK val be res<val>)

            1. Result in: % |- % : OK val

  2. Case (% matches pattern FUN %)

    1. (Let FUN id be arg)

      1. Result in: % |- % : OK FUNC id

2. Otherwise,

  1. Result in: % |- % : FAIL

relation Eval_prem: C |- prem' : %

1. Case analysis on prem' (total)

  1. Case (% matches pattern REL % ':' % '->' %)

    1. (Let REL id ':' exp*{exp <- exp*} '->' exp_out*{exp_out <- exp_out*} be prem')

      1. (Eval_exp: C |- exp : res<val>)*{exp <- exp*, res<val> -> res<val>*}

        1. If (res<val> matches OK %)*{res<val> <- res<val>*}, then

          1. (Let OK val be res<val>)*{res<val> <- res<val>*, val -> val*}

            1. (Call_rel: C |- id val*{val <- val*} : res<val*>)

              1. If (res<val*> matches OK %), then

                1. (Let OK val_out*{val_out <- val_out*} be res<val*>)

                  1. (Assign_exps: C |- exp_out*{exp_out <- exp_out*} := val_out*{val_out <- val_out*} : C')

                    1. Result in: % |- % : OK C'

  2. Case (% matches pattern IF %)

    1. (Let IF exp be prem')

      1. (Eval_exp: C |- exp : res<val>)

        1. Case analysis on res<val>

          1. Case (% = OK BOOL true)

            1. Result in: % |- % : OK C

          2. Case (% = OK BOOL false)

            1. Result in: % |- % : FAIL

  3. Case (% matches pattern IFHOLD % ':' %)

    1. (Let IFHOLD id ':' exp*{exp <- exp*} be prem')

      1. (Eval_exp: C |- exp : res<val>)*{exp <- exp*, res<val> -> res<val>*}

        1. If (res<val> matches OK %)*{res<val> <- res<val>*}, then

          1. (Let OK val_input be res<val>)*{res<val> <- res<val>*, val_input -> val_input*}

            1. (Call_rel: C |- id val_input*{val_input <- val_input*} : res<val*>)

              1. If ((res<val*> = OK [])), then

                1. Result in: % |- % : OK C

  4. Case (% matches pattern IFNOTHOLD % ':' %)

    1. (Let IFNOTHOLD id ':' exp*{exp <- exp*} be prem')

      1. (Eval_exp: C |- exp : res<val>)*{exp <- exp*, res<val> -> res<val>*}

        1. If (res<val> matches OK %)*{res<val> <- res<val>*}, then

          1. (Let OK val_input be res<val>)*{res<val> <- res<val>*, val_input -> val_input*}

            1. (Call_rel: C |- id val_input*{val_input <- val_input*} : res<val*>)

              1. If (res<val*> matches FAIL), then

                1. Result in: % |- % : OK C

  5. Case (% matches pattern LET % '=' %)

    1. (Let LET exp_l '=' exp_r be prem')

      1. (Eval_exp: C |- exp_r : res<val>)

        1. If (res<val> matches OK %), then

          1. (Let OK val_r be res<val>)

            1. (Assign_exp: C |- exp_l := val_r : C')

              1. Result in: % |- % : OK C'

  6. Case (% matches pattern ITER % %)

    1. (Let ITER prem iterprem be prem')

      1. (Let iter vari_bound*{vari_bound <- vari_bound*} vari_bind*{vari_bind <- vari_bind*} be iterprem)

        1. Case analysis on iter (total)

          1. Case (% matches pattern QUEST)

            1. If ($sub_opt(C, vari_bound*{vari_bound <- vari_bound*}) matches ()), then

              1. (Let vari_bind_iter be $iter_vari(vari_bind, QUEST))*{vari_bind <- vari_bind*, vari_bind_iter -> vari_bind_iter*}

                1. (Let val_bind*{val_bind <- val_bind*} be $repeat_<val>(OPT ?(), |vari_bind*{vari_bind <- vari_bind*}|))

                  1. (Let C_res be $add_varis(C, vari_bind_iter*{vari_bind_iter <- vari_bind_iter*}, val_bind*{val_bind <- val_bind*}))

                    1. Result in: % |- % : OK C_res

            2. (Let C'?{C' <- C'?} be $sub_opt(C, vari_bound*{vari_bound <- vari_bound*}))

              1. If (C'?{C' <- C'?} matches (_)), then

                1. (Let ?(C_sub) be C'?{C' <- C'?})

                  1. (Let vari_bind_iter be $iter_vari(vari_bind, QUEST))*{vari_bind <- vari_bind*, vari_bind_iter -> vari_bind_iter*}

                    1. (Eval_prem: C_sub |- prem : res<ctx>)

                      1. If (res<ctx> matches OK %), then

                        1. (Let OK C_sub_res be res<ctx>)

                          1. (Let val?{val <- val?} be $find_vari(C_sub_res, vari_bind))*{vari_bind <- vari_bind*, val? -> val?*}

                            1. If (val?{val <- val?} matches (_))*{val? <- val?*}, then

                              1. (Let ?(val_bind) be val?{val <- val?})*{val? <- val?*, val_bind -> val_bind*}

                                1. (Let C_res be $add_varis(C, vari_bind_iter*{vari_bind_iter <- vari_bind_iter*}, OPT ?(val_bind)*{val_bind <- val_bind*}))

                                  1. Result in: % |- % : OK C_res

          2. Case (% matches pattern STAR)

            1. If ($sub_list(C, vari_bound*{vari_bound <- vari_bound*}) matches []), then

              1. (Let vari_bind_iter be $iter_vari(vari_bind, STAR))*{vari_bind <- vari_bind*, vari_bind_iter -> vari_bind_iter*}

                1. (Let val_bind*{val_bind <- val_bind*} be $repeat_<val>(LIST [], |vari_bind*{vari_bind <- vari_bind*}|))

                  1. (Let C_res be $add_varis(C, vari_bind_iter*{vari_bind_iter <- vari_bind_iter*}, val_bind*{val_bind <- val_bind*}))

                    1. Result in: % |- % : OK C_res

            2. (Let C_sub*{C_sub <- C_sub*} be $sub_list(C, vari_bound*{vari_bound <- vari_bound*}))

              1. If (C_sub*{C_sub <- C_sub*} matches _ :: _), then

                1. (Eval_prem: C_sub |- prem : res<ctx>)*{C_sub <- C_sub*, res<ctx> -> res<ctx>*}

                  1. If (res<ctx> matches OK %)*{res<ctx> <- res<ctx>*}, then

                    1. (Let OK C_sub_res be res<ctx>)*{res<ctx> <- res<ctx>*, C_sub_res -> C_sub_res*}

                      1. (Let val*{val <- val*}?{val* <- val*?} be $find_varis(C_sub_res, vari_bind*{vari_bind <- vari_bind*}))*{C_sub_res <- C_sub_res*, val*? -> val*?*}

                        1. If (val*{val <- val*}?{val* <- val*?} matches (_))*{val*? <- val*?*}, then

                          1. (Let ?(val_sub_bind*{val_sub_bind <- val_sub_bind*}) be val*{val <- val*}?{val* <- val*?})*{val*? <- val*?*, val_sub_bind* -> val_sub_bind**}

                            1. (Let val_bind*{val_bind <- val_bind*}*{val_bind* <- val_bind**} be $transpose_<val>(val_sub_bind*{val_sub_bind <- val_sub_bind*}*{val_sub_bind* <- val_sub_bind**}))

                              1. (Let val_res_bind be LIST val_bind*{val_bind <- val_bind*})*{val_bind* <- val_bind**, val_res_bind -> val_res_bind*}

                                1. (Let vari_bind_iter be $iter_vari(vari_bind, STAR))*{vari_bind <- vari_bind*, vari_bind_iter -> vari_bind_iter*}

                                  1. (Let C_res be $add_varis(C, vari_bind_iter*{vari_bind_iter <- vari_bind_iter*}, val_res_bind*{val_res_bind <- val_res_bind*}))

                                    1. Result in: % |- % : OK C_res

  7. Case (% matches pattern DEBUG %)

    1. (Let DEBUG exp be prem')

      1. (Eval_exp: C |- exp : res<val>)

        1. If (res<val> matches OK %), then

          1. (Let OK val be res<val>)

            1. Debug: val

            2. Result in: % |- % : OK C

2. Otherwise,

  1. Result in: % |- % : FAIL

relation Eval_prems: C |- prem*{prem <- prem*} : %

1. Case analysis on prem*{prem <- prem*} (total)

  1. Case (% matches pattern [])

    1. Result in: % |- % : OK C

  2. Case (% matches pattern _ :: _)

    1. (Let prem_h :: prem_t*{prem_t <- prem_t*} be prem*{prem <- prem*})

      1. (Eval_prem: C |- prem_h : res<ctx>)

        1. Case analysis on res<ctx> (total)

          1. Case (% matches pattern FAIL)

            1. Result in: % |- % : FAIL

          2. Case (% matches pattern OK %)

            1. (Let OK C' be res<ctx>)

              1. (Eval_prems: C' |- prem_t*{prem_t <- prem_t*} : ctxres)

                1. Result in: % |- % : ctxres

relation Call_func_dispatch: C |- funcdef typ*{typ <- typ*} val*{val <- val*} : %

1. Case analysis on funcdef (total)

  1. Case (% has type externFuncDef)

    1. (Let EXT id _tparam*{_tparam <- _tparam*} _param*{_param <- _param*} _typ be funcdef as externFuncDef)

      1. (Call_extern_func: |- id `< typ*{typ <- typ*} `> `( val*{val <- val*} `) : valres)

        1. Result in: % |- % % % : valres

  2. Case (% has type builtinFuncDef)

    1. (Let builtinFuncDef be funcdef as builtinFuncDef)

      1. (Let BUILTIN id _tparam*{_tparam <- _tparam*} _param*{_param <- _param*} _typ be builtinFuncDef)

        1. (Call_builtin_func: |- id '@' `< typ*{typ <- typ*} `> `( val*{val <- val*} `) : valres)

          1. Result in: % |- % % % : valres

  3. Case (% has type tableFuncDef)

    1. (Let tableFuncDef be funcdef as tableFuncDef)

      1. If (typ*{typ <- typ*} matches []), then

        1. (Call_table_func: C |- tableFuncDef '@' `( val*{val <- val*} `) : valres)

          1. Result in: % |- % % % : valres

      1. Else Dangling

  4. Case (% has type definedFuncDef)

    1. (Let definedFuncDef be funcdef as definedFuncDef)

      1. (Call_defined_func: C |- definedFuncDef '@' `< typ*{typ <- typ*} `> `( val*{val <- val*} `) : valres)

        1. Result in: % |- % % % : valres

relation Call_func: C |- id typ*{typ <- typ*} val*{val <- val*} : %

1. (Let funcdef'?{funcdef' <- funcdef'?} be $find_func(C, id))

  1. If (funcdef'?{funcdef' <- funcdef'?} matches (_)), then

    1. (Let ?(funcdef) be funcdef'?{funcdef' <- funcdef'?})

      1. (Call_func_dispatch: C |- funcdef typ*{typ <- typ*} val*{val <- val*} : valres)

        1. Result in: % |- % % % : valres

  1. Else Dangling

relation Call_rel_dispatch: C |- reldef val*{val <- val*} : %

1. Case analysis on reldef (total)

  1. Case (% has type definedRelDef)

    1. (Let definedRelDef be reldef as definedRelDef)

      1. (Call_defined_rel: C |- definedRelDef '@' `( val*{val <- val*} `) : valsres)

        1. Result in: % |- % % : valsres

  2. Case (% has type externRelDef)

    1. (Let EXT id be reldef as externRelDef)

      1. (Call_extern_rel: |- id val*{val <- val*} : valsres)

        1. Result in: % |- % % : valsres

relation Call_rel: C |- id val*{val <- val*} : %

1. (Let reldef'?{reldef' <- reldef'?} be $find_rel(C, id))

  1. If (reldef'?{reldef' <- reldef'?} matches (_)), then

    1. (Let ?(reldef) be reldef'?{reldef' <- reldef'?})

      1. (Call_rel_dispatch: C |- reldef val*{val <- val*} : valsres)

        1. Result in: % |- % % : valsres

  1. Else Dangling

def $unop_number(numunop, num)

1. Case analysis on numunop (total)

  1. Case (% matches pattern PLUS)

    1. Case analysis on num (total)

      1. Case (% matches pattern NAT %)

        1. (Let NAT n be num)

          1. Return NAT n as val

      2. Case (% matches pattern INT %)

        1. (Let INT i be num)

          1. Return INT i as val

  2. Case (% matches pattern MINUS)

    1. Case analysis on num (total)

      1. Case (% matches pattern NAT %)

        1. (Let NAT n be num)

          1. Return INT -n as int as val

      2. Case (% matches pattern INT %)

        1. (Let INT i be num)

          1. Return INT -i as val

def $binop_bool(boolbinop, b_l, b_r)

1. Case analysis on boolbinop (total)

  1. Case (% matches pattern AND)

    1. Return (b_l /\ b_r)

  2. Case (% matches pattern OR)

    1. Return (b_l \/ b_r)

  3. Case (% matches pattern IMPL)

    1. Return (b_l => b_r)

  4. Case (% matches pattern EQUIV)

    1. Return (b_l <=> b_r)

