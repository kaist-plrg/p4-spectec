          1. If (val' matches OPT %), then

            1. (Let OPT val?{val <- val?} be val')

              1. (Let res<val> be $downcast(C, typ, val))?{val <- val?, res<val> -> res<val>?}

                1. If (res<val> matches OK %)?{res<val> <- res<val>?}, then

                  1. (Let OK val_downcast be res<val>)?{res<val> <- res<val>?, val_downcast -> val_downcast?}

                    1. Return OK OPT val_downcast?{val_downcast <- val_downcast?}

        2. Case (% matches pattern STAR)

          1. If (val' matches LIST %), then

            1. (Let LIST val*{val <- val*} be val')

              1. (Let res<val> be $downcast(C, typ, val))*{val <- val*, res<val> -> res<val>*}

                1. If (res<val> matches OK %)*{res<val> <- res<val>*}, then

                  1. (Let OK val_downcast be res<val>)*{res<val> <- res<val>*, val_downcast -> val_downcast*}

                    1. Return OK LIST val_downcast*{val_downcast <- val_downcast*}

2. Otherwise,

