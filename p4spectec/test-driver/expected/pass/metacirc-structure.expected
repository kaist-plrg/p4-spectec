                    1. Else Dangling

          1. Else Dangling

        1. Else Dangling

    1. Else Dangling

1. Else Dangling

def $upcast(C, typ'', val')

1. Case analysis on typ''

  1. Case (% has type numtyp)

    1. (Let numtyp be typ'' as numtyp)

      1. If (numtyp matches INT), then

        1. Case analysis on val' <: num (total)

          1. Case true

            1. (Let num be val' as num)

              1. Case analysis on num (total)

                1. Case (% matches pattern INT %)

                  1. (Let INT i be num)

                    1. Return OK INT i as val

                2. Case (% matches pattern NAT %)

                  1. (Let NAT n be num)

                    1. Return OK INT n as int as val

          2. Case false

            1. Return FAIL

  2. Case (% matches pattern VAR % %)

    1. (Let VAR id targ*{targ <- targ*} be typ'')

      1. (Let typdef'?{typdef' <- typdef'?} be $find_typ(C, id))

        1. If (typdef'?{typdef' <- typdef'?} matches (_)), then

          1. (Let ?(typdef) be typdef'?{typdef' <- typdef'?})

            1. If (typdef matches DEF % '->' %), then

              1. (Let DEF tparam*{tparam <- tparam*} '->' deftyp be typdef)

                1. If (deftyp matches ALIAS %), then

                  1. (Let ALIAS typ be deftyp)

                    1. If ((|targ*{targ <- targ*}| = |tparam*{tparam <- tparam*}|)), then

                      1. (Let theta be `{ tparam ':' targ*{targ <- targ*, tparam <- tparam*} `})

                        1. (Let typ' be $subst_typ(theta, typ))

                          1. Return $upcast(C, typ', val')

  3. Case (% matches pattern TUP %)

    1. (Let TUP typ*{typ <- typ*} be typ'')

      1. If (val' matches TUP %), then

        1. (Let TUP val*{val <- val*} be val')

          1. If ((|typ*{typ <- typ*}| = |val*{val <- val*}|)), then

            1. (Let res<val> be $upcast(C, typ, val))*{typ <- typ*, val <- val*, res<val> -> res<val>*}

              1. If (res<val> matches OK %)*{res<val> <- res<val>*}, then

                1. (Let OK val_upcast be res<val>)*{res<val> <- res<val>*, val_upcast -> val_upcast*}

                  1. Return OK TUP val_upcast*{val_upcast <- val_upcast*}

      2. If (~$is_tup(val')), then

        1. Return FAIL

  4. Case (% matches pattern ITER % %)

    1. (Let ITER typ iter be typ'')

      1. Case analysis on iter (total)

        1. Case (% matches pattern QUEST)

          1. If (val' matches OPT %), then

            1. (Let OPT val?{val <- val?} be val')

              1. (Let res<val> be $upcast(C, typ, val))?{val <- val?, res<val> -> res<val>?}

                1. If (res<val> matches OK %)?{res<val> <- res<val>?}, then

                  1. (Let OK val_upcast be res<val>)?{res<val> <- res<val>?, val_upcast -> val_upcast?}

                    1. Return OK OPT val_upcast?{val_upcast <- val_upcast?}

        2. Case (% matches pattern STAR)

          1. If (val' matches LIST %), then

            1. (Let LIST val*{val <- val*} be val')

              1. (Let res<val> be $upcast(C, typ, val))*{val <- val*, res<val> -> res<val>*}

                1. If (res<val> matches OK %)*{res<val> <- res<val>*}, then

                  1. (Let OK val_upcast be res<val>)*{res<val> <- res<val>*, val_upcast -> val_upcast*}

                    1. Return OK LIST val_upcast*{val_upcast <- val_upcast*}

2. Otherwise,

  1. Return OK val'

def $downcast(C, typ'', val')

1. Case analysis on typ''

  1. Case (% has type numtyp)

