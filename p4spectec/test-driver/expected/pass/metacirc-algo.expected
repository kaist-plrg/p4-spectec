  -- let `{ id_local ':' typdef_local*{id_local <- id_local*, typdef_local <- typdef_local*} `} = C.LOCAL.TYP
  -- let id_used*{id_used <- id_used*} = id_global*{id_global <- id_global*} ++ id_local*{id_local <- id_local*} ++ $ids_typ(FUNC tparam_l*{tparam_l <- tparam_l*} typ_l*{typ_l <- typ_l*} typ_ret_l) ++ $ids_typ(FUNC tparam_r*{tparam_r <- tparam_r*} typ_r*{typ_r <- typ_r*} typ_ret_r)
  -- let tparam_fresh*{tparam_fresh <- tparam_fresh*} = $fresh_ids(tparam_l*{tparam_l <- tparam_l*}, id_used*{id_used <- id_used*})
  -- if (|tparam_fresh*{tparam_fresh <- tparam_fresh*}| = |tparam_l*{tparam_l <- tparam_l*}|)
  -- let theta_l = `{ tparam_l ':' VAR tparam_fresh []*{tparam_fresh <- tparam_fresh*, tparam_l <- tparam_l*} `}
  -- let theta_r = `{ tparam_r ':' VAR tparam_fresh []*{tparam_fresh <- tparam_fresh*, tparam_r <- tparam_r*} `}
  -- let typ_l_subst*{typ_l_subst <- typ_l_subst*} = $subst_typ(theta_l, typ_l)*{typ_l <- typ_l*}
  -- let typ_r_subst*{typ_r_subst <- typ_r_subst*} = $subst_typ(theta_r, typ_r)*{typ_r <- typ_r*}
  -- let typ_ret_l_subst = $subst_typ(theta_l, typ_ret_l)
  -- let typ_ret_r_subst = $subst_typ(theta_r, typ_ret_r)
  -- let tdenv_fresh = $adds_map<id, typdef>(C.LOCAL.TYP, tparam_fresh*{tparam_fresh <- tparam_fresh*}, $repeat_<typdef>(PARAM, |tparam_fresh*{tparam_fresh <- tparam_fresh*}|))
  -- let C_fresh = C[LOCAL.TYP = tdenv_fresh]

def $upcast(ctx, typ, val) : res<val> =

  clause 0 : (C, typ, val) = OK INT i as val
  -- if typ <: numtyp
  -- let numtyp = typ as numtyp
  -- if numtyp matches INT
  -- if val <: num
  -- let num = val as num
  -- if num matches INT %
  -- let INT i = num

  clause 1 : (C, typ, val) = OK INT n as int as val
  -- if typ <: numtyp
  -- let numtyp = typ as numtyp
  -- if numtyp matches INT
  -- if val <: num
  -- let num = val as num
  -- if num matches NAT %
  -- let NAT n = num

  clause 2 : (C, typ, val) = FAIL
  -- if typ <: numtyp
  -- let numtyp = typ as numtyp
  -- if numtyp matches INT
  -- if ~val <: num

  clause 3 : (C, typ'', val) = $upcast(C, typ', val)
  -- if typ'' matches VAR % %
  -- let VAR id targ*{targ <- targ*} = typ''
  -- let typdef'?{typdef' <- typdef'?} = $find_typ(C, id)
  -- if typdef'?{typdef' <- typdef'?} matches (_)
