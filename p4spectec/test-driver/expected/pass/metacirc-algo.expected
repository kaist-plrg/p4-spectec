def $unop_number(numunop, num) : val =

  clause 0 : (numunop, num) = NAT n as val
  -- if numunop matches PLUS
  -- if num matches NAT %
  -- let NAT n = num

  clause 1 : (numunop, num) = INT i as val
  -- if numunop matches PLUS
  -- if num matches INT %
  -- let INT i = num

  clause 2 : (numunop, num) = INT -n as int as val
  -- if numunop matches MINUS
  -- if num matches NAT %
  -- let NAT n = num

  clause 3 : (numunop, num) = INT -i as val
  -- if numunop matches MINUS
  -- if num matches INT %
  -- let INT i = num

def $binop_bool(boolbinop, bool, bool) : bool =

  clause 0 : (boolbinop, b_l, b_r) = (b_l /\ b_r)
  -- if boolbinop matches AND

  clause 1 : (boolbinop, b_l, b_r) = (b_l \/ b_r)
  -- if boolbinop matches OR

  clause 2 : (boolbinop, b_l, b_r) = (b_l => b_r)
  -- if boolbinop matches IMPL

  clause 3 : (boolbinop, b_l, b_r) = (b_l <=> b_r)
  -- if boolbinop matches EQUIV

def $binop_number(numbinop, num, num) : val =

  clause 0 : (numbinop, num, num') = NAT (n_l + n_r) as val
  -- if numbinop matches ADD
  -- if num matches NAT %
  -- let NAT n_l = num
  -- if num' matches NAT %
  -- let NAT n_r = num'

  clause 1 : (numbinop, num, num') = INT (i_l + i_r) as val
  -- if numbinop matches ADD
  -- if num matches INT %
  -- let INT i_l = num
  -- if num' matches INT %
  -- let INT i_r = num'

  clause 2 : (numbinop, num, num') = INT (n_l - n_r) as val
  -- if numbinop matches SUB
  -- if num matches NAT %
  -- let NAT n_l = num
  -- if num' matches NAT %
  -- let NAT n_r = num'

  clause 3 : (numbinop, num, num') = INT (i_l - i_r) as val
  -- if numbinop matches SUB
  -- if num matches INT %
  -- let INT i_l = num
  -- if num' matches INT %
  -- let INT i_r = num'

  clause 4 : (numbinop, num, num') = NAT (n_l * n_r) as val
  -- if numbinop matches MUL
  -- if num matches NAT %
  -- let NAT n_l = num
  -- if num' matches NAT %
  -- let NAT n_r = num'

  clause 5 : (numbinop, num, num') = INT (i_l * i_r) as val
  -- if numbinop matches MUL
  -- if num matches INT %
  -- let INT i_l = num
  -- if num' matches INT %
  -- let INT i_r = num'

  clause 6 : (numbinop, num, num') = NAT (n_l / n_r) as val
  -- if numbinop matches DIV
  -- if num matches NAT %
  -- let NAT n_l = num
  -- if num' matches NAT %
  -- let NAT n_r = num'

  clause 7 : (numbinop, num, num') = INT (i_l / i_r) as val
  -- if numbinop matches DIV
  -- if num matches INT %
  -- let INT i_l = num
  -- if num' matches INT %
  -- let INT i_r = num'

  clause 8 : (numbinop, num, num') = NAT (n_l \ n_r) as val
  -- if numbinop matches MOD
  -- if num matches NAT %
  -- let NAT n_l = num
  -- if num' matches NAT %
  -- let NAT n_r = num'

  clause 9 : (numbinop, num, num') = INT (i_l \ i_r) as val
  -- if numbinop matches MOD
  -- if num matches INT %
  -- let INT i_l = num
  -- if num' matches INT %
  -- let INT i_r = num'

  clause 10 : (numbinop, num, num') = NAT (n_l ^ n_r) as val
  -- if numbinop matches POW
  -- if num matches NAT %
  -- let NAT n_l = num
  -- if num' matches NAT %
  -- let NAT n_r = num'

  clause 11 : (numbinop, num, num') = INT (i_l ^ i_r) as val
  -- if numbinop matches POW
  -- if num matches INT %
  -- let INT i_l = num
  -- if num' matches INT %
  -- let INT i_r = num'

def $cmpop_poly(polycmpop, val, val) : bool =

  clause 0 : (polycmpop, val_l, val_r) = (val_l = val_r)
  -- if polycmpop matches EQ

  clause 1 : (polycmpop, val_l, val_r) = (val_l =/= val_r)
  -- if polycmpop matches NE

def $cmpop_number(numcmpop, num, num) : bool =

  clause 0 : (numcmpop, num, num') = (n_l < n_r)
  -- if numcmpop matches LT
  -- if num matches NAT %
  -- let NAT n_l = num
  -- if num' matches NAT %
  -- let NAT n_r = num'

  clause 1 : (numcmpop, num, num') = (i_l < i_r)
  -- if numcmpop matches LT
  -- if num matches INT %
  -- let INT i_l = num
  -- if num' matches INT %
  -- let INT i_r = num'

  clause 2 : (numcmpop, num, num') = (n_l > n_r)
  -- if numcmpop matches GT
  -- if num matches NAT %
  -- let NAT n_l = num
  -- if num' matches NAT %
  -- let NAT n_r = num'

  clause 3 : (numcmpop, num, num') = (i_l > i_r)
  -- if numcmpop matches GT
  -- if num matches INT %
  -- let INT i_l = num
  -- if num' matches INT %
  -- let INT i_r = num'

  clause 4 : (numcmpop, num, num') = (n_l <= n_r)
  -- if numcmpop matches LE
  -- if num matches NAT %
  -- let NAT n_l = num
  -- if num' matches NAT %
  -- let NAT n_r = num'

  clause 5 : (numcmpop, num, num') = (i_l <= i_r)
  -- if numcmpop matches LE
  -- if num matches INT %
  -- let INT i_l = num
  -- if num' matches INT %
  -- let INT i_r = num'

  clause 6 : (numcmpop, num, num') = (n_l >= n_r)
  -- if numcmpop matches GE
  -- if num matches NAT %
  -- let NAT n_l = num
  -- if num' matches NAT %
  -- let NAT n_r = num'

  clause 7 : (numcmpop, num, num') = (i_l >= i_r)
  -- if numcmpop matches GE
  -- if num matches INT %
  -- let INT i_l = num
  -- if num' matches INT %
  -- let INT i_r = num'

def $is_tup(val) : bool =

  clause 0 : (val') = true
  -- if val' matches TUP %
  -- let TUP val*{val <- val*} = val'

  clause -1 : (val) = false

def $is_fun(val) : bool =

  clause 0 : (val) = true
  -- if val matches FUNC %
  -- let FUNC id = val

  clause -1 : (val) = false

def $ids_typ(typ) : id* =

  clause 0 : (typ') = [id] ++ $ids_typs(typ*{typ <- typ*})
  -- if typ' matches VAR % %
  -- let VAR id typ*{typ <- typ*} = typ'

  clause 1 : (typ') = $ids_typs(typ*{typ <- typ*})
  -- if typ' matches TUP %
  -- let TUP typ*{typ <- typ*} = typ'

  clause 2 : (typ') = $ids_typ(typ)
  -- if typ' matches ITER % %
  -- let ITER typ iter = typ'

  clause 3 : (typ') = tparam*{tparam <- tparam*} ++ $ids_typs(typ*{typ <- typ*}) ++ $ids_typ(typ_ret)
  -- if typ' matches FUNC % % %
  -- let FUNC tparam*{tparam <- tparam*} typ*{typ <- typ*} typ_ret = typ'

  clause -1 : (typ) = []

def $ids_typs(typ*) : id* =

  clause 0 : (typ*{typ <- typ*}) = []
  -- if typ*{typ <- typ*} matches []

  clause 1 : (typ*{typ <- typ*}) = $ids_typ(typ_h) ++ $ids_typs(typ_t*{typ_t <- typ_t*})
  -- if typ*{typ <- typ*} matches _ :: _
  -- let typ_h :: typ_t*{typ_t <- typ_t*} = typ*{typ <- typ*}

def $fresh_id(id, id*) : id =

  clause 0 : (id, id_used*{id_used <- id_used*}) = id
  -- if ~id <- id_used*{id_used <- id_used*}

  clause 1 : (id, id_used*{id_used <- id_used*}) = $fresh_id(id ++ "'", id_used*{id_used <- id_used*})
  -- if id <- id_used*{id_used <- id_used*}

def $fresh_ids(id*, id*) : id* =

  clause 0 : (id*{id <- id*}, id_used*{id_used <- id_used*}) = []
  -- if id*{id <- id*} matches []

  clause 1 : (id*{id <- id*}, id_used*{id_used <- id_used*}) = [id_fresh] ++ $fresh_ids(id_t*{id_t <- id_t*}, [id_fresh] ++ id_used*{id_used <- id_used*})
  -- if id*{id <- id*} matches _ :: _
  -- let id_h :: id_t*{id_t <- id_t*} = id*{id <- id*}
  -- let id_fresh = $fresh_id(id_h, id_used*{id_used <- id_used*})

def $subst_typ(theta, typ) : typ =

  clause 0 : (theta, typ) = NAT as typ
  -- if typ <: numtyp
  -- let numtyp = typ as numtyp
  -- if numtyp matches NAT

  clause 1 : (theta, typ) = INT as typ
  -- if typ <: numtyp
  -- let numtyp = typ as numtyp
  -- if numtyp matches INT

  clause 2 : (theta, typ) = TEXT as typ
  -- if typ <: optyp
  -- let optyp = typ as optyp
  -- if optyp matches TEXT

  clause 3 : (theta, typ) = BOOL as typ
  -- if typ <: optyp
  -- let optyp = typ as optyp
  -- if optyp matches BOOL

  clause 4 : (theta, typ') = typ
  -- if typ' matches VAR % %
  -- let VAR id targ*{targ <- targ*} = typ'
  -- if targ*{targ <- targ*} matches []
  -- let typ''?{typ'' <- typ''?} = $find_map<id, typ>(theta, id)
  -- if typ''?{typ'' <- typ''?} matches (_)
  -- let ?(typ) = typ''?{typ'' <- typ''?}

  clause 5 : (theta, typ) = VAR id $subst_typ(theta, targ)*{targ <- targ*}
  -- if typ matches VAR % %
  -- let VAR id targ*{targ <- targ*} = typ
  -- if (?() = $find_map<id, typ>(theta, id))

  clause 6 : (theta, typ') = TUP $subst_typ(theta, typ)*{typ <- typ*}
  -- if typ' matches TUP %
  -- let TUP typ*{typ <- typ*} = typ'

  clause 7 : (theta, typ') = ITER $subst_typ(theta, typ) iter
  -- if typ' matches ITER % %
  -- let ITER typ iter = typ'

  clause 8 : (theta, typ') = FUNC tparam_fresh*{tparam_fresh <- tparam_fresh*} typ_subst*{typ_subst <- typ_subst*} $subst_typ(theta, typ_ret_fresh)
  -- if typ' matches FUNC % % %
  -- let FUNC tparam*{tparam <- tparam*} typ*{typ <- typ*} typ_ret = typ'
  -- let `{ id ':' typ_arg*{id <- id*, typ_arg <- typ_arg*} `} = theta
  -- let id_used*{id_used <- id_used*} = id*{id <- id*} ++ $ids_typs(typ_arg*{typ_arg <- typ_arg*}) ++ $ids_typ(FUNC tparam*{tparam <- tparam*} typ*{typ <- typ*} typ_ret)
  -- let tparam_fresh*{tparam_fresh <- tparam_fresh*} = $fresh_ids(tparam*{tparam <- tparam*}, id_used*{id_used <- id_used*})
  -- if (|tparam*{tparam <- tparam*}| = |tparam_fresh*{tparam_fresh <- tparam_fresh*}|)
  -- let theta_fresh = `{ tparam ':' VAR tparam_fresh []*{tparam <- tparam*, tparam_fresh <- tparam_fresh*} `}
  -- let typ_fresh*{typ_fresh <- typ_fresh*} = $subst_typ(theta_fresh, typ)*{typ <- typ*}
  -- let typ_subst*{typ_subst <- typ_subst*} = $subst_typ(theta, typ_fresh)*{typ_fresh <- typ_fresh*}
  -- let typ_ret_fresh = $subst_typ(theta_fresh, typ_ret)

def $param_typ(param) : typ =

  clause 0 : (param) = typ
  -- if param matches EXP %
  -- let EXP typ = param

  clause 1 : (param') = FUNC tparam*{tparam <- tparam*} $param_typ(param)*{param <- param*} typ
  -- if param' matches FUN % ':' % % '->' %
  -- let FUN id ':' tparam*{tparam <- tparam*} param*{param <- param*} '->' typ = param'

def $func_typ(funcdef) : typ =

  clause 0 : (funcdef) = FUNC tparam*{tparam <- tparam*} $param_typ(param)*{param <- param*} typ
  -- if funcdef <: externFuncDef
  -- let EXT id tparam*{tparam <- tparam*} param*{param <- param*} typ = funcdef as externFuncDef

  clause 1 : (funcdef) = FUNC tparam*{tparam <- tparam*} $param_typ(param)*{param <- param*} typ
  -- if funcdef <: builtinFuncDef
  -- let BUILTIN id tparam*{tparam <- tparam*} param*{param <- param*} typ = funcdef as builtinFuncDef

  clause 2 : (funcdef) = FUNC [] $param_typ(param)*{param <- param*} typ
  -- if funcdef <: tableFuncDef
  -- let TABLE param*{param <- param*} typ '->' tblrow*{tblrow <- tblrow*} = funcdef as tableFuncDef

  clause 3 : (funcdef) = FUNC tparam*{tparam <- tparam*} $param_typ(param)*{param <- param*} typ
  -- if funcdef <: definedFuncDef
  -- let DEF tparam*{tparam <- tparam*} param*{param <- param*} typ '->' clause*{clause <- clause*} elsclause?{elsclause <- elsclause?} = funcdef as definedFuncDef

def $expand_typ(ctx, typ) : typ =

  clause 0 : (C, typ') = $expand_typ(C, $subst_typ(theta, typ))
  -- if typ' matches VAR % %
  -- let VAR id targ*{targ <- targ*} = typ'
  -- let typdef'?{typdef' <- typdef'?} = $find_typ(C, id)
  -- if typdef'?{typdef' <- typdef'?} matches (_)
  -- let ?(typdef) = typdef'?{typdef' <- typdef'?}
  -- if typdef matches DEF % '->' %
  -- let DEF tparam*{tparam <- tparam*} '->' deftyp = typdef
  -- if deftyp matches ALIAS %
  -- let ALIAS typ = deftyp
  -- if (|targ*{targ <- targ*}| = |tparam*{tparam <- tparam*}|)
  -- let theta = `{ tparam ':' targ*{targ <- targ*, tparam <- tparam*} `}

  clause -1 : (C, typ) = typ

def $equiv_typ(ctx, typ, typ) : bool =

  clause 0 : (C, typ_l, typ_r) = $equiv_typ'(C, $expand_typ(C, typ_l), $expand_typ(C, typ_r))

def $equiv_typs(ctx, typ*, typ*) : bool =

  clause 0 : (C, typ*{typ <- typ*}, typ'*{typ' <- typ'*}) = true
  -- if typ*{typ <- typ*} matches []
  -- if typ'*{typ' <- typ'*} matches []

  clause 1 : (C, typ*{typ <- typ*}, typ'*{typ' <- typ'*}) = ($equiv_typ(C, typ_l, typ_r) /\ $equiv_typs(C, typ_l_t*{typ_l_t <- typ_l_t*}, typ_r_t*{typ_r_t <- typ_r_t*}))
  -- if typ*{typ <- typ*} matches _ :: _
  -- let typ_l :: typ_l_t*{typ_l_t <- typ_l_t*} = typ*{typ <- typ*}
  -- if typ'*{typ' <- typ'*} matches _ :: _
  -- let typ_r :: typ_r_t*{typ_r_t <- typ_r_t*} = typ'*{typ' <- typ'*}

  clause -1 : (C, typ_l*{typ_l <- typ_l*}, typ_r*{typ_r <- typ_r*}) = false

def $equiv_typ'(ctx, typ, typ) : bool =

  clause 0 : (C, typ, typ') = true
  -- if typ <: optyp
  -- let optyp = typ as optyp
  -- if optyp matches BOOL
  -- if typ' <: optyp
  -- let optyp' = typ' as optyp
  -- if optyp' matches BOOL

  clause 1 : (C, typ, typ') = true
  -- if typ <: numtyp
  -- let numtyp = typ as numtyp
  -- if numtyp matches NAT
  -- if typ' <: numtyp
  -- let numtyp' = typ' as numtyp
  -- if numtyp' matches NAT

  clause 2 : (C, typ, typ') = true
  -- if typ <: numtyp
  -- let numtyp = typ as numtyp
  -- if numtyp matches INT
  -- if typ' <: numtyp
  -- let numtyp' = typ' as numtyp
  -- if numtyp' matches INT

  clause 3 : (C, typ, typ') = true
  -- if typ <: optyp
  -- let optyp = typ as optyp
  -- if optyp matches TEXT
  -- if typ' <: optyp
  -- let optyp' = typ' as optyp
  -- if optyp' matches TEXT

  clause 4 : (C, typ, typ') = ((id_l = id_r) /\ $equiv_typs(C, targ_l*{targ_l <- targ_l*}, targ_r*{targ_r <- targ_r*}))
  -- if typ matches VAR % %
  -- let VAR id_l targ_l*{targ_l <- targ_l*} = typ
  -- if typ' matches VAR % %
  -- let VAR id_r targ_r*{targ_r <- targ_r*} = typ'

  clause 5 : (C, typ, typ') = $equiv_typs(C, typ_l*{typ_l <- typ_l*}, typ_r*{typ_r <- typ_r*})
  -- if typ matches TUP %
  -- let TUP typ_l*{typ_l <- typ_l*} = typ
  -- if typ' matches TUP %
  -- let TUP typ_r*{typ_r <- typ_r*} = typ'

  clause 6 : (C, typ, typ') = ((iter_l = iter_r) /\ $equiv_typ(C, typ_l, typ_r))
  -- if typ matches ITER % %
  -- let ITER typ_l iter_l = typ
  -- if typ' matches ITER % %
  -- let ITER typ_r iter_r = typ'

  clause -1 : (C, typ_l, typ_r) = false

def $equiv_func_typ(ctx, typ, typ) : bool =

  clause 0 : (C, typ, typ') = ($equiv_typs(C_fresh, typ_l_subst*{typ_l_subst <- typ_l_subst*}, typ_r_subst*{typ_r_subst <- typ_r_subst*}) /\ $equiv_typ(C_fresh, typ_ret_l_subst, typ_ret_r_subst))
  -- if typ matches FUNC % % %
  -- let FUNC tparam_l*{tparam_l <- tparam_l*} typ_l*{typ_l <- typ_l*} typ_ret_l = typ
  -- if typ' matches FUNC % % %
  -- let FUNC tparam_r*{tparam_r <- tparam_r*} typ_r*{typ_r <- typ_r*} typ_ret_r = typ'
  -- if (|tparam_l*{tparam_l <- tparam_l*}| = |tparam_r*{tparam_r <- tparam_r*}|)
  -- if (|typ_l*{typ_l <- typ_l*}| = |typ_r*{typ_r <- typ_r*}|)
