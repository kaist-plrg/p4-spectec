  -- (let OK val_downcast = res<val>)?{res<val> <- res<val>?, val_downcast -> val_downcast?}

  clause 7 : (C, typ', val') = OK LIST val_downcast*{val_downcast <- val_downcast*}
  -- if typ' matches ITER % %
  -- let ITER typ iter = typ'
  -- if iter matches STAR
  -- if val' matches LIST %
  -- let LIST val*{val <- val*} = val'
  -- (let res<val> = $downcast(C, typ, val))*{val <- val*, res<val> -> res<val>*}
  -- (if res<val> matches OK %)*{res<val> <- res<val>*}
  -- (let OK val_downcast = res<val>)*{res<val> <- res<val>*, val_downcast -> val_downcast*}

  clause -1 : (C, typ, val) = OK val

def $subtyp(ctx, typ, val) : bool =

  clause 0 : (C, typ, val) = true
  -- if typ <: optyp
  -- let optyp = typ as optyp
  -- if optyp matches BOOL
  -- if val matches BOOL %
  -- let BOOL b = val

  clause 1 : (C, typ, val) = true
  -- if typ <: numtyp
  -- let numtyp = typ as numtyp
  -- if numtyp matches NAT
  -- if val <: num
  -- let num = val as num
  -- if num matches NAT %
  -- let NAT n = num

  clause 2 : (C, typ, val) = (i >= 0 as int)
  -- if typ <: numtyp
  -- let numtyp = typ as numtyp
  -- if numtyp matches NAT
  -- if val <: num
  -- let num = val as num
  -- if num matches INT %
  -- let INT i = num

  clause 3 : (C, typ, val) = true
  -- if typ <: numtyp
  -- let numtyp = typ as numtyp
  -- if numtyp matches INT
  -- if val <: num
  -- let num = val as num

  clause 4 : (C, typ, val) = true
  -- if typ <: optyp
  -- let optyp = typ as optyp
  -- if optyp matches TEXT
  -- if val matches TEXT %
  -- let TEXT t = val

  clause 5 : (C, typ, val) = true
  -- if typ matches VAR % %
  -- let VAR id targ*{targ <- targ*} = typ
  -- if val matches EXT %
  -- let EXT json = val
  -- if (?(EXT) = $find_typ(C, id))

  clause 6 : (C, typ', val) = $subtyp(C, typ_subst, val)
  -- if typ' matches VAR % %
  -- let VAR id targ*{targ <- targ*} = typ'
  -- let typdef'?{typdef' <- typdef'?} = $find_typ(C, id)
  -- if typdef'?{typdef' <- typdef'?} matches (_)
  -- let ?(typdef) = typdef'?{typdef' <- typdef'?}
  -- if typdef matches DEF % '->' %
  -- let DEF tparam*{tparam <- tparam*} '->' deftyp = typdef
  -- if deftyp matches ALIAS %
  -- let ALIAS typ = deftyp
  -- if (|targ*{targ <- targ*}| = |tparam*{tparam <- tparam*}|)
  -- let theta = `{ tparam ':' targ*{targ <- targ*, tparam <- tparam*} `}
  -- let typ_subst = $subst_typ(theta, typ)

  clause 7 : (C, typ, val') = $forall_($subtyp(C, typ_case_found_subst, val)*{typ_case_found_subst <- typ_case_found_subst*, val <- val*})
  -- if typ matches VAR % %
  -- let VAR id targ*{targ <- targ*} = typ
  -- if val' matches INJ %
  -- let INJ mixop val*{val <- val*} = val'
  -- let typdef'?{typdef' <- typdef'?} = $find_typ(C, id)
  -- if typdef'?{typdef' <- typdef'?} matches (_)
  -- let ?(typdef) = typdef'?{typdef' <- typdef'?}
  -- if typdef matches DEF % '->' %
  -- let DEF tparam*{tparam <- tparam*} '->' deftyp = typdef
  -- if deftyp matches VARIANT %
  -- let VARIANT typcase*{typcase <- typcase*} = deftyp
  -- if (|targ*{targ <- targ*}| = |tparam*{tparam <- tparam*}|)
  -- let theta = `{ tparam ':' targ*{targ <- targ*, tparam <- tparam*} `}
  -- (let mixop_case typ_case*{typ_case <- typ_case*} = typcase)*{typcase <- typcase*, mixop_case -> mixop_case*, typ_case* -> typ_case**}
  -- if mixop <- mixop_case*{mixop_case <- mixop_case*}
  -- let typ'*{typ' <- typ'*}?{typ'* <- typ'*?} = $assoc_<mixop, typ*>(mixop, (mixop_case, typ_case*{typ_case <- typ_case*})*{mixop_case <- mixop_case*, typ_case* <- typ_case**})
  -- if typ'*{typ' <- typ'*}?{typ'* <- typ'*?} matches (_)
  -- let ?(typ_case_found*{typ_case_found <- typ_case_found*}) = typ'*{typ' <- typ'*}?{typ'* <- typ'*?}
  -- let typ_case_found_subst*{typ_case_found_subst <- typ_case_found_subst*} = $subst_typ(theta, typ_case_found)*{typ_case_found <- typ_case_found*}
  -- if (|typ_case_found_subst*{typ_case_found_subst <- typ_case_found_subst*}| = |val*{val <- val*}|)

  clause 8 : (C, typ, val) = $forall_($subtyp(C, typ_field_subst, val_field)*{typ_field_subst <- typ_field_subst*, val_field <- val_field*})
  -- if typ matches VAR % %
  -- let VAR id targ*{targ <- targ*} = typ
  -- if val matches STR %
  -- let STR valfield*{valfield <- valfield*} = val
  -- let typdef'?{typdef' <- typdef'?} = $find_typ(C, id)
  -- if typdef'?{typdef' <- typdef'?} matches (_)
  -- let ?(typdef) = typdef'?{typdef' <- typdef'?}
  -- if typdef matches DEF % '->' %
  -- let DEF tparam*{tparam <- tparam*} '->' deftyp = typdef
  -- if deftyp matches STRUCT %
  -- let STRUCT typfield*{typfield <- typfield*} = deftyp
  -- (let atom typ_field = typfield)*{typfield <- typfield*, atom -> atom*, typ_field -> typ_field*}
  -- (let atom' val_field = valfield)*{valfield <- valfield*, atom' -> atom'*, val_field -> val_field*}
  -- if (|atom*{atom <- atom*}| = |atom'*{atom' <- atom'*}|)
  -- (if (atom' = atom))*{atom <- atom*, atom' <- atom'*}
  -- if (|targ*{targ <- targ*}| = |tparam*{tparam <- tparam*}|)
  -- let theta = `{ tparam ':' targ*{targ <- targ*, tparam <- tparam*} `}
  -- (let typ_field_subst = $subst_typ(theta, typ_field))*{typ_field <- typ_field*, typ_field_subst -> typ_field_subst*}

  clause 9 : (C, typ', val') = $forall_($subtyp(C, typ, val)*{typ <- typ*, val <- val*})
  -- if typ' matches TUP %
  -- let TUP typ*{typ <- typ*} = typ'
  -- if val' matches TUP %
  -- let TUP val*{val <- val*} = val'
  -- if (|typ*{typ <- typ*}| = |val*{val <- val*}|)

  clause 10 : (C, typ', val'') = $subtyp(C, typ, val)
  -- if typ' matches ITER % %
  -- let ITER typ iter = typ'
  -- if iter matches QUEST
  -- if val'' matches OPT %
  -- let OPT val'?{val' <- val'?} = val''
  -- if val'?{val' <- val'?} matches (_)
  -- let ?(val) = val'?{val' <- val'?}

  clause 11 : (C, typ', val) = true
  -- if typ' matches ITER % %
  -- let ITER typ iter = typ'
  -- if iter matches QUEST
  -- if (val = OPT ?())

  clause 12 : (C, typ', val') = $forall_($subtyp(C, typ, val)*{val <- val*})
  -- if typ' matches ITER % %
  -- let ITER typ iter = typ'
  -- if iter matches STAR
  -- if val' matches LIST %
  -- let LIST val*{val <- val*} = val'

  clause 13 : (C, typ', val) = $equiv_func_typ(C, FUNC tparam*{tparam <- tparam*} typ*{typ <- typ*} typ_ret, $func_typ(funcdef))
  -- if typ' matches FUNC % % %
  -- let FUNC tparam*{tparam <- tparam*} typ*{typ <- typ*} typ_ret = typ'
  -- if val matches FUNC %
  -- let FUNC id = val
  -- let funcdef'?{funcdef' <- funcdef'?} = $find_func(C, id)
  -- if funcdef'?{funcdef' <- funcdef'?} matches (_)
  -- let ?(funcdef) = funcdef'?{funcdef' <- funcdef'?}

  clause -1 : (C, typ, val) = false

def $subtyps(ctx, typ*, val*) : bool =

  clause 0 : (C, typ*{typ <- typ*}, val*{val <- val*}) = $forall_($subtyp(C, typ, val)*{typ <- typ*, val <- val*})
  -- if (|typ*{typ <- typ*}| = |val*{val <- val*}|)

  clause -1 : (C, typ*{typ <- typ*}, val*{val <- val*}) = false

