var b : bool

var i : int

var n : nat

var t : text

def $ite<X>(bool, X, X) : X =

  clause 0 : (b, X_t, X_f) = X_t
  -- if (b = true)

  clause 1 : (b, X_t, X_f) = X_f
  -- if (b = false)

def $opt_as_seq_<X>(X?) : X* =

  clause 0 : (X?{X <- X?}) = []
  -- if X?{X <- X?} matches ()

  clause 1 : (X'?{X' <- X'?}) = [X]
  -- if X'?{X' <- X'?} matches (_)
  -- let ?(X) = X'?{X' <- X'?}

def $exists_(bool*) : bool =

  clause 0 : (b*{b <- b*}) = false
  -- if b*{b <- b*} matches []

  clause 1 : (b*{b <- b*}) = (b_h \/ $exists_(b_t*{b_t <- b_t*}))
  -- if b*{b <- b*} matches _ :: _
  -- let b_h :: b_t*{b_t <- b_t*} = b*{b <- b*}

def $forall_(bool*) : bool =

  clause 0 : (b*{b <- b*}) = true
  -- if b*{b <- b*} matches []

  clause 1 : (b*{b <- b*}) = (b_h /\ $forall_(b_t*{b_t <- b_t*}))
  -- if b*{b <- b*} matches _ :: _
  -- let b_h :: b_t*{b_t <- b_t*} = b*{b <- b*}

def $repeat_<X>(X, nat) : X* =

  clause 0 : (X, n) = []
  -- if (n = 0)

  clause 1 : (X, n) = [X] ++ $repeat_<X>(X, n')
  -- if (n =/= 0)
  -- let i = (n - 1)
  -- if i <: nat
  -- let n' = i as nat

builtin def $rev_<X>(X*) : X*

builtin def $assoc_<X, Y>(X, (X, Y)*) : Y?

builtin def $transpose_<X>(X**) : X**

syntax set<K> =
   | `{ K* `} (from set<K>)

def $empty_set<K> : set<K> =

  clause 0 :  = `{ [] `}

syntax pair<K, V> =
   | K ':' V (from pair<K, V>)

syntax map<K, V> = set<pair<K, V>>

def $empty_map<K, V> : map<K, V> =

  clause 0 :  = `{ [] `}

builtin def $find_map<K, V>(map<K, V>, K) : V?

builtin def $find_maps<K, V>(map<K, V>*, K) : V?

builtin def $add_map<K, V>(map<K, V>, K, V) : map<K, V>

builtin def $adds_map<K, V>(map<K, V>, K*, V*) : map<K, V>

syntax id = text

syntax atom = text

syntax mixop = atom**

syntax numtyp =
   | NAT (from numtyp)
   | INT (from numtyp)

syntax optyp =
   | BOOL (from optyp)
   | NAT (from numtyp)
   | INT (from numtyp)
   | TEXT (from optyp)

syntax typ =
   | BOOL (from optyp)
   | NAT (from numtyp)
   | INT (from numtyp)
   | TEXT (from optyp)
   | VAR id targ* (from typ)
   | TUP typ* (from typ)
   | ITER typ iter (from typ)
   | FUNC tparam* typ* typ (from typ)

syntax deftyp =
   | ALIAS typ (from deftyp)
   | STRUCT typfield* (from deftyp)
   | VARIANT typcase* (from deftyp)

syntax typfield =
   | atom typ (from typfield)

syntax typcase =
   | mixop typ* (from typcase)

syntax iter =
   | QUEST (from iter)
   | STAR (from iter)

syntax vari =
   | id typ iter* (from vari)

syntax num =
   | NAT nat (from num)
   | INT int (from num)

syntax boolunop =
   | NOT (from boolunop)

syntax boolbinop =
   | AND (from boolbinop)
   | OR (from boolbinop)
   | IMPL (from boolbinop)
   | EQUIV (from boolbinop)

syntax numunop =
   | PLUS (from numunop)
   | MINUS (from numunop)

syntax numbinop =
   | ADD (from numbinop)
   | SUB (from numbinop)
   | MUL (from numbinop)
   | DIV (from numbinop)
   | MOD (from numbinop)
   | POW (from numbinop)

syntax numcmpop =
   | LT (from numcmpop)
   | GT (from numcmpop)
   | LE (from numcmpop)
   | GE (from numcmpop)

syntax polycmpop =
   | EQ (from polycmpop)
   | NE (from polycmpop)

syntax unop =
   | NOT (from boolunop)
   | PLUS (from numunop)
   | MINUS (from numunop)

syntax binop =
   | AND (from boolbinop)
   | OR (from boolbinop)
   | IMPL (from boolbinop)
   | EQUIV (from boolbinop)
   | ADD (from numbinop)
   | SUB (from numbinop)
   | MUL (from numbinop)
   | DIV (from numbinop)
   | MOD (from numbinop)
   | POW (from numbinop)

syntax cmpop =
   | EQ (from polycmpop)
   | NE (from polycmpop)
   | LT (from numcmpop)
   | GT (from numcmpop)
   | LE (from numcmpop)
   | GE (from numcmpop)

extern syntax json

syntax val =
   | BOOL bool (from val)
   | NAT nat (from num)
   | INT int (from num)
   | TEXT text (from val)
   | STR valfield* (from val)
   | INJ valcase (from val)
   | TUP val* (from val)
   | OPT val? (from val)
   | LIST val* (from val)
   | FUNC id (from val)
   | EXT json (from val)

syntax valfield =
   | atom val (from valfield)

syntax valcase =
   | mixop val* (from valcase)

syntax exp =
   | BOOL bool (from exp)
   | NAT nat (from num)
   | INT int (from num)
   | TEXT text (from exp)
   | VAR id (from exp)
   | UN unop exp (from exp)
   | BIN binop exp exp (from exp)
   | CMP cmpop exp exp (from exp)
   | UPCAST typ exp (from exp)
   | DOWNCAST typ exp (from exp)
   | SUB exp typ (from exp)
   | MATCH exp pattern (from exp)
   | TUP exp* (from exp)
   | INJ expcase (from exp)
   | STR expfield* (from exp)
   | OPT exp? (from exp)
   | LIST exp* (from exp)
   | CONS exp exp (from exp)
   | CAT exp exp (from exp)
   | MEM exp exp (from exp)
   | LEN exp (from exp)
   | DOT exp atom (from exp)
   | IDX exp exp (from exp)
   | SLICE exp exp exp (from exp)
   | UPD exp path exp (from exp)
   | CALL id targ* arg* (from exp)
   | ITER exp iterexp (from exp)

syntax expcase =
   | mixop exp* (from expcase)

syntax expfield =
   | atom exp (from expfield)

syntax iterexp =
   | iter vari* (from iterexp)

syntax listpattern =
   | CONS (from listpattern)
   | FIXED nat (from listpattern)
   | NIL (from listpattern)

syntax optpattern =
   | SOME (from optpattern)
   | NONE (from optpattern)

syntax pattern =
   | INJ mixop (from pattern)
   | CONS (from listpattern)
   | FIXED nat (from listpattern)
   | NIL (from listpattern)
   | SOME (from optpattern)
   | NONE (from optpattern)

syntax path =
   | ROOT (from path)
   | IDX path exp (from path)
   | SLICE path exp exp (from path)
   | DOT path atom (from path)

syntax targ = typ

syntax arg =
   | EXP exp (from arg)
   | FUN id (from arg)

syntax tparam = id

syntax param =
   | EXP typ (from param)
   | FUN id ':' tparam* param* '->' typ (from param)

syntax iterprem =
   | iter vari* vari* (from iterprem)

syntax prem =
   | REL id ':' exp* '->' exp* (from prem)
   | IF exp (from prem)
   | IFHOLD id ':' exp* (from prem)
   | IFNOTHOLD id ':' exp* (from prem)
   | LET exp '=' exp (from prem)
   | ITER prem iterprem (from prem)
   | DEBUG exp (from prem)

syntax rulmatch =
   | exp* '-' prem* (from rulmatch)

syntax rulpath =
   | id '=' exp* '-' prem* (from rulpath)

syntax rulgroup =
   | id ':' rulmatch '=' rulpath* (from rulgroup)

syntax elsgroup =
   | id ':' rulmatch '=' rulpath (from elsgroup)

syntax clause =
   | arg* '=' exp '-' prem* (from clause)

syntax elsclause = clause

syntax tblrow =
   | arg* '=' exp '-' prem* (from tblrow)

syntax defn =
   | EXTTYP id (from defn)
   | TYP id tparam* '=' deftyp (from defn)
   | EXTREL id ':' typ* '->' typ* (from defn)
   | REL id ':' typ* '->' typ* '=' rulgroup* elsgroup? (from defn)
   | EXTFUNC id tparam* param* ':' typ (from defn)
   | BUILTINFUNC id tparam* param* ':' typ (from defn)
   | TABLEFUNC id param* ':' typ '=' tblrow* (from defn)
   | FUNC id tparam* param* ':' typ '=' clause* elsclause? (from defn)

syntax script = defn*

syntax varr =
   | id iter* (from varr)

syntax venv = map<varr, val>

syntax typdef =
   | PARAM (from typdef)
   | EXT (from typdef)
   | DEF tparam* '->' deftyp (from typdef)

syntax tdenv = map<id, typdef>

syntax theta = map<id, typ>

def $extend_tdenv(tdenv, tdenv) : tdenv =

  clause 0 : (tdenv_global, set<pair<id, typdef>>) = tdenv_global
  -- if (set<pair<id, typdef>> = `{ [] `})

  clause -1 : (tdenv_global, `{ id ':' typdef*{id <- id*, typdef <- typdef*} `}) = $adds_map<id, typdef>(tdenv_global, id*{id <- id*}, typdef*{typdef <- typdef*})

def $theta_of_tdenv(tdenv) : theta =

  clause 0 : (set<pair<id, typdef>>) = $empty_map<id, typ>
  -- if (set<pair<id, typdef>> = `{ [] `})

  clause 1 : (`{ pair<id, typdef>*{pair<id, typdef> <- pair<id, typdef>*} `}) = $add_map<id, typ>(theta_t, id_h, typ_h)
  -- if pair<id, typdef>*{pair<id, typdef> <- pair<id, typdef>*} matches _ :: _
  -- let id_h ':' typdef_h :: id_t ':' typdef_t*{id_t <- id_t*, typdef_t <- typdef_t*} = pair<id, typdef>*{pair<id, typdef> <- pair<id, typdef>*}
  -- let typdef = typdef_h
  -- if typdef matches DEF % '->' %
  -- let DEF tparam*{tparam <- tparam*} '->' deftyp = typdef
  -- if tparam*{tparam <- tparam*} matches []
  -- if deftyp matches ALIAS %
  -- let ALIAS typ_h = deftyp
  -- let theta_t = $theta_of_tdenv(`{ id_t ':' typdef_t*{id_t <- id_t*, typdef_t <- typdef_t*} `})

  clause 2 : (`{ pair<id, typdef>*{pair<id, typdef> <- pair<id, typdef>*} `}) = $theta_of_tdenv(`{ id_t ':' typdef_t*{id_t <- id_t*, typdef_t <- typdef_t*} `})
  -- if pair<id, typdef>*{pair<id, typdef> <- pair<id, typdef>*} matches _ :: _
  -- let id_h ':' typdef_h :: id_t ':' typdef_t*{id_t <- id_t*, typdef_t <- typdef_t*} = pair<id, typdef>*{pair<id, typdef> <- pair<id, typdef>*}
  -- if ((typdef_h = PARAM) \/ (typdef_h = EXT))

def $is_iter_on_var(exp) : varr? =

  clause 0 : (exp) = ?(id [])
  -- if exp matches VAR %
  -- let VAR id = exp

  clause 1 : (exp') = ?(id iter*{iter <- iter*} ++ [iter_outer])
  -- if exp' matches ITER % %
  -- let ITER exp iterexp = exp'
  -- let varr?{varr <- varr?} = $is_iter_on_var(exp)
  -- if varr?{varr <- varr?} matches (_)
  -- let ?(id iter*{iter <- iter*}) = varr?{varr <- varr?}
  -- let iter_outer vari*{vari <- vari*} = iterexp
  -- if vari*{vari <- vari*} matches [ _/1 ]
  -- let [id' _typ iter'*{iter' <- iter'*}] = vari*{vari <- vari*}
  -- if (id' = id)
  -- if (iter'*{iter' <- iter'*} = iter*{iter <- iter*})

  clause -1 : (_exp) = ?()

def $iter_vari(vari, iter) : vari =

  clause 0 : (id typ iter*{iter <- iter*}, iter_add) = id typ iter*{iter <- iter*} ++ [iter_add]

def $iter_varr(varr, iter) : varr =

  clause 0 : (id iter*{iter <- iter*}, iter_add) = id iter*{iter <- iter*} ++ [iter_add]

syntax externRelDef =
   | EXT id (from externRelDef)

syntax definedRelDef =
   | DEF rulgroup* elsgroup? (from definedRelDef)

syntax reldef =
   | EXT id (from externRelDef)
   | DEF rulgroup* elsgroup? (from definedRelDef)

syntax renv = map<id, reldef>

syntax externFuncDef =
   | EXT id tparam* param* typ (from externFuncDef)

syntax builtinFuncDef =
   | BUILTIN id tparam* param* typ (from builtinFuncDef)

syntax tableFuncDef =
   | TABLE param* typ '->' tblrow* (from tableFuncDef)

syntax definedFuncDef =
   | DEF tparam* param* typ '->' clause* elsclause? (from definedFuncDef)

syntax funcdef =
   | EXT id tparam* param* typ (from externFuncDef)
   | BUILTIN id tparam* param* typ (from builtinFuncDef)
   | TABLE param* typ '->' tblrow* (from tableFuncDef)
   | DEF tparam* param* typ '->' clause* elsclause? (from definedFuncDef)

syntax fenv = map<id, funcdef>

syntax cursor =
   | GLOBAL (from cursor)
   | LOCAL (from cursor)

syntax layer = {TYP tdenv, REL renv, FUNC fenv, VAL venv}

def $empty_layer : layer =

  clause 0 :  = {TYP $empty_map<id, typdef>, REL $empty_map<id, reldef>, FUNC $empty_map<id, funcdef>, VAL $empty_map<varr, val>}

syntax ctx = {GLOBAL layer, LOCAL layer}

def $empty_ctx : ctx =

  clause 0 :  = {GLOBAL $empty_layer, LOCAL $empty_layer}

var C : ctx

def $load_typdef(ctx, id, typdef) : ctx =

  clause 0 : (C, id, typdef) = C[GLOBAL.TYP = tdenv_update]
  -- let tdenv_update = $add_map<id, typdef>(C.GLOBAL.TYP, id, typdef)

def $load_reldef(ctx, id, reldef) : ctx =

  clause 0 : (C, id, reldef) = C[GLOBAL.REL = renv_update]
  -- let renv_update = $add_map<id, reldef>(C.GLOBAL.REL, id, reldef)

def $load_funcdef(ctx, id, funcdef) : ctx =

  clause 0 : (C, id, funcdef) = C[GLOBAL.FUNC = fenv_update]
  -- let fenv_update = $add_map<id, funcdef>(C.GLOBAL.FUNC, id, funcdef)

def $load(ctx, script) : ctx =

  clause 0 : (C, defn*{defn <- defn*}) = $load(C', defn_t*{defn_t <- defn_t*})
  -- if defn*{defn <- defn*} matches _ :: _
  -- let defn_h :: defn_t*{defn_t <- defn_t*} = defn*{defn <- defn*}
  -- let defn' = defn_h
  -- if defn' matches EXTTYP %
  -- let EXTTYP id = defn'
  -- let C' = $load_typdef(C, id, EXT)

  clause 1 : (C, defn*{defn <- defn*}) = $load(C', defn_t*{defn_t <- defn_t*})
  -- if defn*{defn <- defn*} matches _ :: _
  -- let defn_h :: defn_t*{defn_t <- defn_t*} = defn*{defn <- defn*}
  -- let defn' = defn_h
  -- if defn' matches TYP % % '=' %
  -- let TYP id tparam*{tparam <- tparam*} '=' deftyp = defn'
  -- let C' = $load_typdef(C, id, DEF tparam*{tparam <- tparam*} '->' deftyp)

  clause 2 : (C, defn*{defn <- defn*}) = $load(C', defn_t*{defn_t <- defn_t*})
  -- if defn*{defn <- defn*} matches _ :: _
  -- let defn_h :: defn_t*{defn_t <- defn_t*} = defn*{defn <- defn*}
  -- let defn' = defn_h
  -- if defn' matches EXTREL % ':' % '->' %
  -- let EXTREL id ':' typ_input*{typ_input <- typ_input*} '->' typ_output*{typ_output <- typ_output*} = defn'
  -- let C' = $load_reldef(C, id, EXT id as reldef)

  clause 3 : (C, defn*{defn <- defn*}) = $load(C', defn_t*{defn_t <- defn_t*})
  -- if defn*{defn <- defn*} matches _ :: _
  -- let defn_h :: defn_t*{defn_t <- defn_t*} = defn*{defn <- defn*}
  -- let defn' = defn_h
  -- if defn' matches REL % ':' % '->' % '=' % %
  -- let REL id ':' typ_input*{typ_input <- typ_input*} '->' typ_output*{typ_output <- typ_output*} '=' rulgroup*{rulgroup <- rulgroup*} elsgroup?{elsgroup <- elsgroup?} = defn'
  -- let C' = $load_reldef(C, id, DEF rulgroup*{rulgroup <- rulgroup*} elsgroup?{elsgroup <- elsgroup?} as reldef)

  clause 4 : (C, defn*{defn <- defn*}) = $load(C', defn_t*{defn_t <- defn_t*})
  -- if defn*{defn <- defn*} matches _ :: _
  -- let defn_h :: defn_t*{defn_t <- defn_t*} = defn*{defn <- defn*}
  -- let defn' = defn_h
  -- if defn' matches EXTFUNC % % % ':' %
  -- let EXTFUNC id tparam*{tparam <- tparam*} param*{param <- param*} ':' typ = defn'
  -- let C' = $load_funcdef(C, id, EXT id tparam*{tparam <- tparam*} param*{param <- param*} typ as funcdef)

  clause 5 : (C, defn*{defn <- defn*}) = $load(C', defn_t*{defn_t <- defn_t*})
  -- if defn*{defn <- defn*} matches _ :: _
  -- let defn_h :: defn_t*{defn_t <- defn_t*} = defn*{defn <- defn*}
  -- let defn' = defn_h
  -- if defn' matches BUILTINFUNC % % % ':' %
  -- let BUILTINFUNC id tparam*{tparam <- tparam*} param*{param <- param*} ':' typ = defn'
  -- let C' = $load_funcdef(C, id, BUILTIN id tparam*{tparam <- tparam*} param*{param <- param*} typ as funcdef)

  clause 6 : (C, defn*{defn <- defn*}) = $load(C', defn_t*{defn_t <- defn_t*})
  -- if defn*{defn <- defn*} matches _ :: _
  -- let defn_h :: defn_t*{defn_t <- defn_t*} = defn*{defn <- defn*}
  -- let defn' = defn_h
  -- if defn' matches TABLEFUNC % % ':' % '=' %
  -- let TABLEFUNC id param*{param <- param*} ':' typ '=' tblrow*{tblrow <- tblrow*} = defn'
  -- let C' = $load_funcdef(C, id, TABLE param*{param <- param*} typ '->' tblrow*{tblrow <- tblrow*} as funcdef)

  clause 7 : (C, defn*{defn <- defn*}) = $load(C', defn_t*{defn_t <- defn_t*})
  -- if defn*{defn <- defn*} matches _ :: _
  -- let defn_h :: defn_t*{defn_t <- defn_t*} = defn*{defn <- defn*}
  -- let defn' = defn_h
  -- if defn' matches FUNC % % % ':' % '=' % %
  -- let FUNC id tparam*{tparam <- tparam*} param*{param <- param*} ':' typ '=' clause*{clause <- clause*} elsclause?{elsclause <- elsclause?} = defn'
  -- let C' = $load_funcdef(C, id, DEF tparam*{tparam <- tparam*} param*{param <- param*} typ '->' clause*{clause <- clause*} elsclause?{elsclause <- elsclause?} as funcdef)

  clause 8 : (C, defn*{defn <- defn*}) = C
  -- if defn*{defn <- defn*} matches []

def $add_vari(ctx, vari, val) : ctx =

  clause 0 : (C, vari, val) = C[LOCAL.VAL = venv_update]
  -- let id _typ iter*{iter <- iter*} = vari
  -- let venv_update = $add_map<varr, val>(C.LOCAL.VAL, id iter*{iter <- iter*}, val)

def $add_varr(ctx, varr, val) : ctx =

  clause 0 : (C, varr, val) = C[LOCAL.VAL = venv_update]
  -- let venv_update = $add_map<varr, val>(C.LOCAL.VAL, varr, val)

def $add_varis(ctx, vari*, val*) : ctx =

  clause 0 : (C, vari*{vari <- vari*}, val*{val <- val*}) = C[LOCAL.VAL = venv_update]
  -- (let id _typ iter*{iter <- iter*} = vari)*{vari <- vari*, _typ -> _typ*, id -> id*, iter* -> iter**}
  -- let venv_update = $adds_map<varr, val>(C.LOCAL.VAL, id iter*{iter <- iter*}*{id <- id*, iter* <- iter**}, val*{val <- val*})

def $add_varrs(ctx, varr*, val*) : ctx =

  clause 0 : (C, varr*{varr <- varr*}, val*{val <- val*}) = C[LOCAL.VAL = venv_update]
  -- let venv_update = $adds_map<varr, val>(C.LOCAL.VAL, varr*{varr <- varr*}, val*{val <- val*})

def $add_typ(ctx, id, typdef) : ctx =

  clause 0 : (C, id, typdef) = C[LOCAL.TYP = tdenv_update]
  -- let tdenv_update = $add_map<id, typdef>(C.LOCAL.TYP, id, typdef)

def $add_func(ctx, id, funcdef) : ctx =

  clause 0 : (C, id, funcdef) = C[LOCAL.FUNC = fenv_update]
  -- let fenv_update = $add_map<id, funcdef>(C.LOCAL.FUNC, id, funcdef)

def $find_vari(ctx, vari) : val? =

  clause 0 : (C, vari) = ?(val)
  -- let id _typ iter*{iter <- iter*} = vari
  -- let val'?{val' <- val'?} = $find_map<varr, val>(C.LOCAL.VAL, id iter*{iter <- iter*})
  -- if val'?{val' <- val'?} matches (_)
  -- let ?(val) = val'?{val' <- val'?}

def $find_varr(ctx, varr) : val? =

  clause 0 : (C, varr) = $find_map<varr, val>(C.LOCAL.VAL, varr)

def $find_varis(ctx, vari*) : val*? =

  clause 0 : (C, vari*{vari <- vari*}) = ?(val*{val <- val*})
  -- (let val'?{val' <- val'?} = $find_vari(C, vari))*{vari <- vari*, val'? -> val'?*}
  -- (if val'?{val' <- val'?} matches (_))*{val'? <- val'?*}
  -- (let ?(val) = val'?{val' <- val'?})*{val'? <- val'?*, val -> val*}

  clause -1 : (C, vari*{vari <- vari*}) = ?()

def $find_varrs(ctx, varr*) : val*? =

  clause 0 : (C, varr*{varr <- varr*}) = ?(val*{val <- val*})
  -- (let val'?{val' <- val'?} = $find_map<varr, val>(C.LOCAL.VAL, varr))*{varr <- varr*, val'? -> val'?*}
  -- (if val'?{val' <- val'?} matches (_))*{val'? <- val'?*}
  -- (let ?(val) = val'?{val' <- val'?})*{val'? <- val'?*, val -> val*}

  clause -1 : (C, varr*{varr <- varr*}) = ?()

def $finds_vari(ctx*, vari) : val*? =

  clause 0 : (C*{C <- C*}, vari) = ?(val*{val <- val*})
  -- let id _typ iter*{iter <- iter*} = vari
  -- (let val'?{val' <- val'?} = $find_map<varr, val>(C.LOCAL.VAL, id iter*{iter <- iter*}))*{C <- C*, val'? -> val'?*}
  -- (if val'?{val' <- val'?} matches (_))*{val'? <- val'?*}
  -- (let ?(val) = val'?{val' <- val'?})*{val'? <- val'?*, val -> val*}

  clause -1 : (C*{C <- C*}, vari) = ?()

def $find_typ(ctx, id) : typdef? =

  clause 0 : (C, id) = ?(typdef)
  -- let typdef'?{typdef' <- typdef'?} = $find_map<id, typdef>(C.LOCAL.TYP, id)
  -- if typdef'?{typdef' <- typdef'?} matches (_)
  -- let ?(typdef) = typdef'?{typdef' <- typdef'?}

  clause 1 : (C, id) = $find_map<id, typdef>(C.GLOBAL.TYP, id)
  -- if (?() = $find_map<id, typdef>(C.LOCAL.TYP, id))

def $find_func(ctx, id) : funcdef? =

  clause 0 : (C, id) = ?(funcdef)
  -- let funcdef'?{funcdef' <- funcdef'?} = $find_map<id, funcdef>(C.LOCAL.FUNC, id)
  -- if funcdef'?{funcdef' <- funcdef'?} matches (_)
  -- let ?(funcdef) = funcdef'?{funcdef' <- funcdef'?}

  clause 1 : (C, id) = ?(funcdef)
  -- if (?() = $find_map<id, funcdef>(C.LOCAL.FUNC, id))
  -- let funcdef'?{funcdef' <- funcdef'?} = $find_map<id, funcdef>(C.GLOBAL.FUNC, id)
  -- if funcdef'?{funcdef' <- funcdef'?} matches (_)
  -- let ?(funcdef) = funcdef'?{funcdef' <- funcdef'?}

  clause -1 : (C, id) = ?()

def $find_rel(ctx, id) : reldef? =

  clause 0 : (C, id) = $find_map<id, reldef>(C.GLOBAL.REL, id)

def $sub_opt(ctx, vari*) : ctx? =

  clause 0 : (C, vari*{vari <- vari*}) = ?($add_varis(C, vari*{vari <- vari*}, val*{val <- val*}))
  -- (let vari_iter = $iter_vari(vari, QUEST))*{vari <- vari*, vari_iter -> vari_iter*}
  -- (let val'''?{val''' <- val'''?} = $find_vari(C, vari_iter))*{vari_iter <- vari_iter*, val'''? -> val'''?*}
  -- (if val'''?{val''' <- val'''?} matches (_))*{val'''? <- val'''?*}
  -- (let ?(val'') = val'''?{val''' <- val'''?})*{val'''? <- val'''?*, val'' -> val''*}
  -- (if val'' matches OPT %)*{val'' <- val''*}
  -- (let OPT val'?{val' <- val'?} = val'')*{val'' <- val''*, val'? -> val'?*}
  -- (if val'?{val' <- val'?} matches (_))*{val'? <- val'?*}
  -- (let ?(val) = val'?{val' <- val'?})*{val'? <- val'?*, val -> val*}

  clause 1 : (C, vari*{vari <- vari*}) = ?()
  -- (let vari_iter = $iter_vari(vari, QUEST))*{vari <- vari*, vari_iter -> vari_iter*}
  -- (if (?(OPT ?()) = $find_vari(C, vari_iter)))*{vari_iter <- vari_iter*}

def $sub_list(ctx, vari*) : ctx* =

  clause 0 : (C, vari*{vari <- vari*}) = C'*{C' <- C'*}
  -- (let vari_iter = $iter_vari(vari, STAR))*{vari <- vari*, vari_iter -> vari_iter*}
  -- (let val''?{val'' <- val''?} = $find_vari(C, vari_iter))*{vari_iter <- vari_iter*, val''? -> val''?*}
  -- (if val''?{val'' <- val''?} matches (_))*{val''? <- val''?*}
  -- (let ?(val') = val''?{val'' <- val''?})*{val''? <- val''?*, val' -> val'*}
  -- (if val' matches LIST %)*{val' <- val'*}
  -- (let LIST val*{val <- val*} = val')*{val' <- val'*, val* -> val**}
  -- let val_trans*{val_trans <- val_trans*}*{val_trans* <- val_trans**} = $transpose_<val>(val*{val <- val*}*{val* <- val**})
  -- (let C' = $add_varis(C, vari*{vari <- vari*}, val_trans*{val_trans <- val_trans*}))*{val_trans* <- val_trans**, C' -> C'*}

syntax unitres =
   | OK (from unitres)
   | FAIL (from unitres)

syntax res<X> =
   | OK X (from res<X>)
   | FAIL (from res<X>)

syntax valres = res<val>

syntax valsres = res<val*>

extern relation Call_extern_func: |- id `< typ* `> `( val* `) : res<val>

extern relation Call_builtin_func: |- id '@' `< typ* `> `( val* `) : res<val>

extern relation Call_extern_rel: |- id val* : res<val*>

syntax ctxres = res<ctx>

