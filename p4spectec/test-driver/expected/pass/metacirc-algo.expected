  -- if deftyp matches ALIAS %
  -- let ALIAS typ = deftyp
  -- if (|targ*{targ <- targ*}| = |tparam*{tparam <- tparam*}|)
  -- let theta = `{ tparam ':' targ*{targ <- targ*, tparam <- tparam*} `}
  -- let typ' = $subst_typ(theta, typ)

  clause 4 : (C, typ', val') = OK TUP val_upcast*{val_upcast <- val_upcast*}
  -- if typ' matches TUP %
  -- let TUP typ*{typ <- typ*} = typ'
  -- if val' matches TUP %
  -- let TUP val*{val <- val*} = val'
  -- if (|typ*{typ <- typ*}| = |val*{val <- val*}|)
  -- (let res<val> = $upcast(C, typ, val))*{typ <- typ*, val <- val*, res<val> -> res<val>*}
  -- (if res<val> matches OK %)*{res<val> <- res<val>*}
  -- (let OK val_upcast = res<val>)*{res<val> <- res<val>*, val_upcast -> val_upcast*}

  clause 5 : (C, typ', val) = FAIL
  -- if typ' matches TUP %
  -- let TUP typ*{typ <- typ*} = typ'
  -- if ~$is_tup(val)

  clause 6 : (C, typ', val') = OK OPT val_upcast?{val_upcast <- val_upcast?}
  -- if typ' matches ITER % %
  -- let ITER typ iter = typ'
  -- if iter matches QUEST
  -- if val' matches OPT %
  -- let OPT val?{val <- val?} = val'
  -- (let res<val> = $upcast(C, typ, val))?{val <- val?, res<val> -> res<val>?}
  -- (if res<val> matches OK %)?{res<val> <- res<val>?}
  -- (let OK val_upcast = res<val>)?{res<val> <- res<val>?, val_upcast -> val_upcast?}

  clause 7 : (C, typ', val') = OK LIST val_upcast*{val_upcast <- val_upcast*}
  -- if typ' matches ITER % %
  -- let ITER typ iter = typ'
  -- if iter matches STAR
  -- if val' matches LIST %
  -- let LIST val*{val <- val*} = val'
  -- (let res<val> = $upcast(C, typ, val))*{val <- val*, res<val> -> res<val>*}
  -- (if res<val> matches OK %)*{res<val> <- res<val>*}
  -- (let OK val_upcast = res<val>)*{res<val> <- res<val>*, val_upcast -> val_upcast*}

  clause -1 : (C, typ, val) = OK val

