syntax singleton = ONLY
syntax box = BOX nat
syntax wrap<X> = WRAP X
syntax linked<X> = wrap<X>
syntax alias = linked<nat>
syntax nested = NEST box

dec $nullary(singleton) : nat
def $nullary(ONLY) = 0 -- otherwise

dec $pick(box) : nat
def $pick(BOX nat) = nat -- otherwise

relation Pick: box nat hint(input %0)
rule Pick: (BOX nat) nat -- otherwise

dec $unwrap<X>(wrap<X>) : X
def $unwrap<X>(WRAP X) = X -- otherwise

dec $opaque<X>(X) : X
def $opaque<X>(X) = X -- otherwise

dec $linked<X>(linked<X>) : X
def $linked<X>(WRAP X) = X -- otherwise

dec $alias(alias) : nat
def $alias(WRAP nat) = nat -- otherwise

dec $nested(nested) : nat
def $nested(NEST (BOX nat)) = nat -- otherwise

dec $bind(nat) : nat
def $bind(nat) = nat_result
  -- otherwise
  -- if nat_result = $(nat + 1)
  -- debug nat_result

dec $iterate(nat*) : nat*
def $iterate(nat*) = nat_result*
  -- otherwise
  -- if (nat_result = $(nat + 1))*
  -- (debug nat_result)*
