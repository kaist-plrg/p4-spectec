syntax singleton =
   | ONLY (from singleton)

syntax box =
   | BOX nat (from box)

syntax wrap<X> =
   | WRAP X (from wrap<X>)

syntax linked<X> = wrap<X>

syntax alias = linked<nat>

syntax nested =
   | NEST box (from nested)

def $nullary(singleton) : nat =

  clause -1 : (singleton) = 0
  -- if singleton matches ONLY

def $pick(box) : nat =

  clause -1 : (BOX nat) = nat

relation Pick: box nat



  elsegroup

  rulegroup

   match

    (signature) BOX nat %
    BOX nat %

   paths

    rulepath
    -- output: % nat

def $unwrap<X>(wrap<X>) : X =

  clause -1 : (WRAP X) = X

def $opaque<X>(X) : X =

  clause -1 : (X) = X

def $linked<X>(linked<X>) : X =

  clause -1 : (WRAP X) = X

def $alias(alias) : nat =

  clause -1 : (WRAP nat) = nat

def $nested(nested) : nat =

  clause -1 : (NEST BOX nat) = nat

def $bind(nat) : nat =

  clause -1 : (nat) = nat_result
  -- let nat_result = (nat + 1)
  -- debug nat_result

def $iterate(nat*) : nat* =

  clause -1 : (nat*{nat <- nat*}) = nat_result*{nat_result <- nat_result*}
  -- (let nat_result = (nat + 1))*{nat <- nat*, nat_result -> nat_result*}
  -- (debug nat_result)*{nat_result <- nat_result*}
