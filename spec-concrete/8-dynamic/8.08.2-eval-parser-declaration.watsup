;;
;; Parser local declaration evaluation
;;
;; syntax parserLocalDeclarationIR
;;

;;; constantDeclarationIR

rule ParserLocalDecl_eval/constantDeclarationIR:
  EC_0 STO |- constantDeclarationIR
            : EC_1 STO
  -- ConstDecl_eval:
      BLOCK EC_0 |- constantDeclarationIR : EC_1

;;; instantiationIR
;;; should have been handled during instantiation

;;; variableDeclarationIR

rule ParserLocalDecl_eval/cont:
  EC_0 STO_0 |- variableDeclarationIR
              : EC_1 STO_1
  -- VarDecl_eval:
      BLOCK EC_0 STO_0 |- variableDeclarationIR
                        : EC_1 STO_1 `EMPTY

;;
;; Parser local declaration list evaluation
;;
;; syntax parserLocalDeclarationListIR
;;

rulegroup ParserLocalDecls_eval {

  rule ParserLocalDecls_eval/nil:
    EC STO |- eps : EC STO

  rule ParserLocalDecls_eval/cons:
    EC_0 STO_0 |- parserLocalDeclarationIR_h :: parserLocalDeclarationListIR_t
                : EC_2 STO_2
    -- ParserLocalDecl_eval:
        EC_0 STO_0 |- parserLocalDeclarationIR_h : EC_1 STO_1
    -- ParserLocalDecls_eval:
        EC_1 STO_1 |- parserLocalDeclarationListIR_t : EC_2 STO_2

}
