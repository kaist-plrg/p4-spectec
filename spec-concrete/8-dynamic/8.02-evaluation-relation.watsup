;;
;;;; Results
;;

;;; Continue evaluation

syntax continueEmptyResult = `EMPTY
syntax continueResult<X> = `` X

;;; Exit from evaluation

syntax exitResult = EXIT

;;; Return from evaluation

syntax returnResult = RETURN value?

;;; Transitions

syntax acceptTransitionResult = ACCEPT
syntax rejectTransitionResult = REJECT errorValue
syntax stateTransitionResult = STATE id

syntax abortResult =
  | exitResult
  | rejectTransitionResult

;;
;;;; Expression evaluation
;;

syntax expressionResult =
  | continueResult<value>
  | abortResult

relation Expr_eval:
  cursor evalContext store |- typedExpressionIR
                            : evalContext store expressionResult
  hint(input %0 %1 %2 %3)
  hint(prose_in "evaluating" %3#", under cursor" %0#", evaluation context" %1#", and store" %2)
  hint(prose_out "the updated evaluation context" %4#", store" %5#" and expression result" %6)

syntax expressionListResult =
  | continueResult<value*>
  | rejectTransitionResult
  | exitResult

relation Exprs_eval:
  cursor evalContext store |- typedExpressionIR*
                            : evalContext store expressionListResult
  hint(input %0 %1 %2 %3)
  hint(prose_in "evaluating" %3#", under cursor" %0#", evaluation context" %1#", and store" %2)
  hint(prose_out "the updated evaluation context" %4#", store" %5#" and expression list result" %6)

syntax keysetExpressionResult =
  | continueResult<setValue*>
  | abortResult

relation Expr_eval_keyset:
  evalContext store |- keysetExpressionIR
                     : evalContext store keysetExpressionResult
  hint(input %0 %1 %2)

;;
;;;; Argument evaluation
;;

relation Argument_eval:
  cursor evalContext store |- argumentIR
                            : evalContext store expressionResult
  hint(input %0 %1 %2 %3)

syntax storageReferenceResult =
  | continueResult<storageReference?>
  | abortResult

relation Argument_eval_lvalue:
  cursor evalContext store |- argumentIR
                            : evalContext store storageReferenceResult
  hint(input %0 %1 %2 %3)

;;
;;;; L-value evaluation
;;

relation Lvalue_eval:
  cursor evalContext store |- typedLvalueIR
                            : evalContext store storageReferenceResult
  hint(input %0 %1 %2 %3)

relation Lvalue_read:
  cursor evalContext store |- storageReference : value
  hint(input %0 %1 %2 %3)

relation Lvalue_write:
  cursor evalContext store |- storageReference -> value
                            : evalContext
  hint(input %0 %1 %2 %3 %4)

;;
;;;; Statement evaluation
;;

syntax callResult =
  | abortResult
  | returnResult

syntax forBreakResult = BREAK

syntax forContinueResult = CONTINUE

syntax statementResult =
  | continueEmptyResult
  | callResult
  | forBreakResult
  | forContinueResult

relation Stmt_eval:
  cursor evalContext store |- statementIR
                            : evalContext store statementResult
  hint(input %0 %1 %2 %3)
  hint(prose_in "the compile-time evaluation of" %3#
              ", under cursor" %0#", evaluation context" %1#", and store" %2)
  hint(prose_out "\nthe updated evaluation context" %4#",\nthe store" %5#
               ",\nand the instantiated statement" %6)

relation BlockElementStmt_eval:
  evalContext store |- blockElementStatementIR
                     : evalContext store statementResult
  hint(input %0 %1 %2)

relation BlockElementStmts_eval:
  evalContext store |- blockElementStatementListIR
                     : evalContext store statementResult
  hint(input %0 %1 %2)

relation Block_eval:
  evalContext store |- blockStatementIR
                     : evalContext store statementResult
  hint(input %0 %1 %2)

;;
;;;; Parser evaluation
;;

syntax parserStatementResult =
  | continueEmptyResult
  | rejectTransitionResult

relation ParserStmt_eval:
  evalContext store |- parserStatementIR
                     : evalContext store parserStatementResult
  hint(input %0 %1 %2)

relation ParserStmts_eval:
  evalContext store |- parserStatementListIR
                     : evalContext store parserStatementResult
  hint(input %0 %1 %2)

syntax transitionResult =
  | acceptTransitionResult
  | rejectTransitionResult
  | stateTransitionResult

relation ParserTransition_eval:
  evalContext store |- transitionStatementIR 
                     : evalContext store transitionResult
  hint(input %0 %1 %2)

relation ParserState_eval:
  evalContext store |- state
                     : evalContext store transitionResult
  hint(input %0 %1 %2)

relation ParserState_trans:
  evalContext store |- TRANSITION nameIR
                     : evalContext store transitionResult
  hint(input %0 %1 %2)

relation ParserLocalDecl_eval:
  evalContext store |- parserLocalDeclarationIR
                     : evalContext store parserStatementResult
  hint(input %0 %1 %2)

relation ParserLocalDecls_eval:
  evalContext store |- parserLocalDeclarationIR*
                     : evalContext store parserStatementResult
  hint(input %0 %1 %2)

;;
;;;; Control evaluation
;;

syntax tableResult =
  | exitResult
  | returnResult

relation Table_eval:
  evalContext store |- typeId tableObjectProperty
                     : evalContext store tableResult
  hint(input %0 %1 %2 %3)

syntax controlBodyResult =
  | exitResult
  | returnResult

relation ControlBody_eval:
  evalContext store |- controlBodyIR
                     : evalContext store controlBodyResult
  hint(input %0 %1 %2)

syntax controlLocalDeclarationResult =
  | continueEmptyResult
  | exitResult

relation ControlLocalDecl_eval:
  evalContext store |- controlLocalDeclarationIR
                     : evalContext store controlLocalDeclarationResult
  hint(input %0 %1 %2)

relation ControlLocalDecls_eval:
  evalContext store |- controlLocalDeclarationIR*
                     : evalContext store controlLocalDeclarationResult
  hint(input %0 %1 %2)

;;
;;;; Declaration evaluation
;;

syntax declarationResult =
  | continueEmptyResult
  | abortResult

relation VarDecl_eval:
  cursor evalContext store |- variableDeclarationIR
                            : evalContext store declarationResult
  hint(input %0 %1 %2 %3)
  hint(prose_in "evaluating" %3#", under cursor" %0#
                ", evaluation context" %1#", and store" %2)
  hint(prose_out "\nthe updated evaluation context" %4#
                 ", the store" %5#
                 ",\nand the result" %6)

relation ConstDecl_eval:
  cursor evalContext |- constantDeclarationIR
                      : evalContext
  hint(input %0 %1 %2)
  hint(prose_in "evaluating" %2#", under cursor" %0#
                ", and evaluation context" %1)
  hint(prose_out "the updated evaluation context" %3)

;;
;;;; Call evaluation
;;

syntax calleeResult =
  | continueResult<callee>
  | abortResult

relation Callee_eval:
  cursor evalContext store |- callableTargetIR `< `_ > `( argumentListIR )
                            : evalContext store calleeResult
  hint(input %0 %1 %2 %3 %4)

syntax copyInArgumentResult =
  | continueResult<storageReference?>
  | abortResult

relation Copy_in_argument:
  store |-
    cursor evalContext parameterIR
    `@ cursor evalContext argumentIR
  ~> store evalContext evalContext `# copyInArgumentResult
  hint(input %0 %1 %2 %3 %4 %5 %6)
  
syntax copyInResult =
  | continueResult<storageReference?*>
  | abortResult

relation Copy_in:
  cursor store |-
    cursor evalContext parameterListIR
    `@ cursor evalContext argumentListIR
  ~> store evalContext evalContext `# copyInResult
  hint(input %0 %1 %2 %3 %4 %5 %6 %7)

relation Copy_in_default:
  parameterListIR `@ cursor evalContext value*
  ~> evalContext
  hint(input %0 %1 %2 %3)

relation Copy_out_argument:
  store |-
     cursor evalContext parameterIR
     `@ cursor evalContext storageReference?
  ~> evalContext
  hint(input %0 %1 %2 %3 %4 %5 %6)

relation Copy_out:
  cursor store |-
    cursor evalContext parameterListIR
    `@ cursor evalContext storageReference?*
  ~> evalContext
  hint(input %0 %1 %2 %3 %4 %5 %6 %7)

relation Call_eval:
  cursor evalContext store |- callee `@ `< typeArgumentListIR >
                                        `( argumentListIR )
                            : evalContext store callResult
  hint(input %0 %1 %2 %3 %4 %5)
  hint(prose_in "calling" %3 `< %4 > `( %5 ) #", under cursor" %0#", evaluation context" %1#", and store" %2)
  hint(prose_out "the updated evaluation context" %6#", store" %7#", and call result" %8)

extern relation ExternFunctionCall_eval:
  evalContext store |- evalContext nameIR `( nameIR* )
                     : evalContext store callResult
  hint(input %0 %1 %2 %3 %4)
  hint(prose_in "calling an extern function" %2 `( %3 ) #", under evaluation context" %0#", and store" %1)
  hint(prose_out "the updated evaluation context" %4#", store" %5#", and call result" %6)

extern relation ExternMethodCall_eval:
  evalContext store |- objectId `. nameIR `( nameIR* )
                     : evalContext store callResult
  hint(input %0 %1 %2 %3 %4)
  hint(prose_in "calling an extern method" %3 `( %4 ) "on object"
                %2#", under evaluation context" %0#", and store" %1)
  hint(prose_out "the updated evaluation context" %5#", store" %6#", and call result" %7)
