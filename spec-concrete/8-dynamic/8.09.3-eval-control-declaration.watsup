;;
;; Control local declaration evaluation
;;
;; syntax controlLocalDeclarationIR
;;

;;; constantDeclarationIR

rule ControlLocalDecl_eval/constantDeclarationIR:
  EC_0 STO_0 |- constantDeclarationIR
              : EC_1 STO_1 declarationResult
  -- Decl_eval:
      BLOCK EC_0 STO_0 |- constantDeclarationIR
                        : EC_1 STO_1 declarationResult

;;; instantiationIR
;;; should have been handled during instantiation

;;; variableDeclarationIR

rulegroup ControlLocalDecl_eval/variableDeclarationIR {

  rule ControlLocalDecl_eval/non-initializer:
    EC_0 STO |- annotationList typeIR nameIR eps `;
              : EC_1 STO ``
    ---- ;; get initial value
    -- if typeIR_subst = $subst_type_e(BLOCK, EC_0, typeIR)
    -- if value_init = $default(typeIR)
    ---- ;; update evaluation context
    -- if EC_1 = $add_var_e(BLOCK, EC_0, `` nameIR, value_init)

  rule ControlLocalDecl_eval/initializer-exit:
    EC_0 STO_0 |- annotationList typeIR nameIR (`= typedExpressionIR_init) `;
                : EC_1 STO_1 EXIT
    ---- ;; evaluate initializer
    -- Expr_eval:
        BLOCK EC_0 STO_0 |- typedExpressionIR_init
                          : EC_1 STO_1 EXIT

  rule ControlLocalDecl_eval/initializer-cont:
    EC_0 STO_0 |- annotationList typeIR nameIR (`= typedExpressionIR_init) `;
                : EC_2 STO_1 ``
    ---- ;; evaluate initializer
    -- Expr_eval:
        BLOCK EC_0 STO_0 |- typedExpressionIR_init
                          : EC_1 STO_1 (`` value_init)
    ---- ;; update evaluation context
    -- if EC_2 = $add_var_e(BLOCK, EC_1, `` nameIR, value_init)

}

;;; actionDeclarationIR
;;; should have been handled during instantiation

;;; tableDeclarationIR
;;; should have been handled during instantiation

;;
;; Control local declaration list instantiation
;;
;; syntax controlLocalDeclarationListIR
;;

rulegroup ControlLocalDecls_eval {

  rule ControlLocalDecls_eval/nil:
    EC STO |- eps : EC STO ``

   rule ControlLocalDecls_eval/cons-head-exit:
    EC_0 STO_0 |- controlLocalDeclarationIR_h :: controlLocalDeclarationListIR_t
                : EC_1 STO_1 EXIT
    -- ControlLocalDecl_eval:
        EC_0 STO_0 |- controlLocalDeclarationIR_h
                    : EC_1 STO_1 EXIT

   rule ControlLocalDecls_eval/cons-head-cont:
    EC_0 STO_0 |- controlLocalDeclarationIR_h :: controlLocalDeclarationListIR_t
                : EC_2 STO_2 declarationResult
    -- ControlLocalDecl_eval:
        EC_0 STO_0 |- controlLocalDeclarationIR_h
                    : EC_1 STO_1 ``
    -- ControlLocalDecls_eval:
        EC_1 STO_1 |- controlLocalDeclarationListIR_t
                    : EC_2 STO_2 declarationResult

}
