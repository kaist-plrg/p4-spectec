;;
;; Declaration evaluation
;;
;; syntax declarationIR
;;

;;; constantDeclarationIR
;;; syntax constantDeclarationIR =
;;;   annotationList CONST typeIR nameIR initializerIR `;

rule Decl_eval/constantDeclarationIR:
  p EC_0 STO |- annotationList CONST typeIR nameIR (`= value) `;
              : EC_1 STO ``
  -- if EC_1 = $add_var_e(p, EC_0, `` nameIR, value)
