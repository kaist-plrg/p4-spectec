;;
;; Statement evaluation
;;
;; syntax statementIR
;;

;;; emptyStatementIR

rule Stmt_eval/emptyStatementIR:
  p EC STO |- `; : EC STO ``

;;; assignmentStatementIR
;;; syntax assignmentStatementIR = typedLvalueIR assignop typedExpressionIR `;

rulegroup Stmt_eval/assignmentStatementIR {

  rule Stmt_eval/typedLvalueIR-exit:
    p EC_0 STO_0 |- typedLvalueIR assignop typedExpressionIR `;
                  : EC_1 STO_1 EXIT
    ---- ;; evaluate l-value
    -- Lvalue_eval:
        p EC_0 STO_0 |- typedLvalueIR
                      : EC_1 STO_1 EXIT

  rule Stmt_eval/typedLvalueIR-cont-eq-typedExpressionIR-exit:
    p EC_0 STO_0 |- typedLvalueIR `= typedExpressionIR `;
                  : EC_2 STO_2 EXIT
    ---- ;; evaluate l-value
    -- Lvalue_eval:
        p EC_0 STO_0 |- typedLvalueIR
                      : EC_1 STO_1 (`` storageReference)
    ---- ;; evaluate expression
    -- Expr_eval:
        p EC_1 STO_1 |- typedExpressionIR
                      : EC_2 STO_2 EXIT

  rule Stmt_eval/typedLvalueIR-cont-compound-typedExpressionIR-exit:
    p EC_0 STO_0 |- typedLvalueIR assignop typedExpressionIR `;
                  : EC_2 STO_2 EXIT
    ---- ;; evaluate l-value
    -- Lvalue_eval:
        p EC_0 STO_0 |- typedLvalueIR
                      : EC_1 STO_1 (`` storageReference)
    ---- ;; read from l-value
    -- if assignop =/= `=
    -- Lvalue_read:
        p EC_1 STO_1 |- storageReference : value_l
    ---- ;; evaluate expression
    -- Expr_eval:
        p EC_1 STO_1 |- typedExpressionIR
                      : EC_2 STO_2 EXIT

  rule Stmt_eval/typedLvalueIR-cont-eq-typedExpressionIR-cont:
    p EC_0 STO_0 |- typedLvalueIR `= typedExpressionIR `;
                  : EC_3 STO_2 ``
    ---- ;; evaluate l-value
    -- Lvalue_eval:
        p EC_0 STO_0 |- typedLvalueIR
                      : EC_1 STO_1 (`` storageReference)
    ---- ;; evaluate expression
    -- Expr_eval:
        p EC_1 STO_1 |- typedExpressionIR
                      : EC_2 STO_2 (`` value)
    ---- ;; perform assignment
    -- Lvalue_write:
        p EC_2 STO_2 |- storageReference -> value
                      : EC_3

  rule Stmt_eval/typedLvalueIR-cont-compound-typedExpressionIR-cont:
    p EC_0 STO_0 |- typedLvalueIR assignop typedExpressionIR `;
                  : EC_3 STO_2 ``
    ---- ;; evaluate l-value
    -- Lvalue_eval:
        p EC_0 STO_0 |- typedLvalueIR
                      : EC_1 STO_1 (`` storageReference)
    ---- ;; read from l-value
    -- if assignop =/= `=
    -- Lvalue_read:
        p EC_1 STO_1 |- storageReference : value_l
    ---- ;; evaluate expression
    -- Expr_eval:
        p EC_1 STO_1 |- typedExpressionIR
                      : EC_2 STO_2 (`` value_r)
    ---- ;; compute binary operation
    -- if binop = $assignop_as_binop(assignop)
    -- if value_update = $bin_op(binop, value_l, value_r)
    ---- ;; perform assignment
    -- Lvalue_write:
        p EC_2 STO_2 |- storageReference -> value_update
                      : EC_3

}

;;; callStatementIR
;;; syntax callStatementIR =
;;;   routineTargetIR `< typeArgumentListIR > `( argumentListIR ) `;

rulegroup Stmt_eval/callStatementIR {

  rule Stmt_eval/callee-exit:
    p EC_0 STO_0 |- callableTargetIR `< typeArgumentIR* > `( argumentIR* ) `;
                  : EC_1 STO_1 EXIT
    -- if callStatementIR = callableTargetIR `< typeArgumentIR* > `( argumentIR* ) `;
    -- Callee_eval:
        p EC_0 STO_0 |- callableTargetIR `< `_ > `( argumentIR* )
                      : EC_1 STO_1 EXIT

  rule Stmt_eval/callee-cont-call-exit:
    p EC_0 STO_0 |- callableTargetIR `< typeArgumentIR* > `( argumentIR* ) `;
                  : EC_2 STO_2 EXIT
    -- Callee_eval:
        p EC_0 STO_0 |- callableTargetIR `< `_ > `( argumentIR* )
                      : EC_1 STO_1 (`` callee)
    -- Call_eval:
        p EC_1 STO_1 |- callee `@ `< typeArgumentIR* > `( argumentIR* )
                      : EC_2 STO_2 EXIT

  rule Stmt_eval/callee-cont-call-reject:
    p EC_0 STO_0 |- callableTargetIR `< typeArgumentIR* > `( argumentIR* ) `;
                  : EC_2 STO_2 rejectTransitionResult
    -- Callee_eval:
        p EC_0 STO_0 |- callableTargetIR `< `_ > `( argumentIR* )
                      : EC_1 STO_1 (`` callee)
    -- Call_eval:
        p EC_1 STO_1 |- callee `@ `< typeArgumentIR* > `( argumentIR* )
                      : EC_2 STO_2 rejectTransitionResult

  rule Stmt_eval/callee-cont-call-return:
    p EC_0 STO_0 |- callableTargetIR `< typeArgumentIR* > `( argumentIR* ) `;
                  : EC_2 STO_2 ``
    -- Callee_eval:
        p EC_0 STO_0 |- callableTargetIR `< `_ > `( argumentIR* )
                      : EC_1 STO_1 (`` callee)
    -- Call_eval:
        p EC_1 STO_1 |- callee `@ `< typeArgumentIR* > `( argumentIR* )
                      : EC_2 STO_2 returnResult

}

;;; directApplicationStatementIR
;;; direct applications should have been handled during instantiation

;;; returnStatementIR
;;; syntax returnStatementIR

;;;; RETURN `;
;;;; RETURN typedExpressionIR `;

rulegroup Stmt_eval/returnStatementIR {

  rule Stmt_eval/non-expression:
    LOCAL EC STO |- RETURN `; : EC STO (RETURN eps)

  rule Stmt_eval/expression-exit:
    LOCAL EC_0 STO_0 |- RETURN typedExpressionIR `;
                      : EC_1 STO_1 EXIT
    -- Expr_eval:
        LOCAL EC_0 STO_0 |- typedExpressionIR
                          : EC_1 STO_1 EXIT

  rule Stmt_eval/expression-cont:
    LOCAL EC_0 STO_0 |- RETURN typedExpressionIR `;
                      : EC_1 STO_1 (RETURN value)
    -- Expr_eval:
        LOCAL EC_0 STO_0 |- typedExpressionIR
                          : EC_1 STO_1 (`` value)

}

;;; exitStatementIR
;;; syntax exitStatementIR = EXIT `;

rule Stmt_eval/exitStatement:
  p EC STO |- EXIT `; : EC STO EXIT

;;; syntax blockStatementIR =
;;;   annotationList `{ blockElementStatementListIR }

rule Stmt_eval/blockStatement:
  p EC_0 STO_0 |- blockStatementIR
                : EC_3 STO_1 statementResult
  -- if EC_1 = $enter_e(EC_0)
  -- Block_eval:
      EC_1 STO_0 |- blockStatementIR
                  : EC_2 STO_1 statementResult
  -- if EC_3 = $exit_e(EC_2)

;;; conditionalStatementIR
;;; syntax conditionalStatementIR

;;;; IF `( typedExpressionIR ) statementIR
;;;; IF `( typedExpressionIR ) statementIR ELSE statementIR

rulegroup Stmt_eval/conditionalStatementIR {

  rule Stmt_eval/non-else-exit:
    p EC STO |- IF `( typedExpressionIR_cond ) statementIR_then
              : EC_cond STO_cond EXIT
    -- Expr_eval:
        p EC STO |- typedExpressionIR_cond
                  : EC_cond STO_cond EXIT

  rule Stmt_eval/non-else-cont-true:
    p EC STO |- IF `( typedExpressionIR_cond ) statementIR_then
              : EC_then STO_then statementResult
    -- Expr_eval:
        p EC STO |- typedExpressionIR_cond
                  : EC_cond STO_cond (`` (`B true))
    -- Stmt_eval:
        p EC_cond STO_cond |- statementIR_then
                            : EC_then STO_then statementResult

  rule Stmt_eval/non-else-cont-false:
    p EC STO |- IF `( typedExpressionIR_cond ) statementIR_then
              : EC_cond STO_cond ``
    -- Expr_eval:
        p EC STO |- typedExpressionIR_cond
                  : EC_cond STO_cond (`` (`B false))

  rule Stmt_eval/else-exit:
    p EC STO |- IF `( typedExpressionIR_cond ) statementIR_then
                ELSE statementIR_else
              : EC_cond STO_cond EXIT
    -- Expr_eval:
        p EC STO |- typedExpressionIR_cond
                  : EC_cond STO_cond EXIT

  rule Stmt_eval/else-cont-true:
    p EC STO |- IF `( typedExpressionIR_cond ) statementIR_then
                ELSE statementIR_else
              : EC_then STO_then statementResult
    -- Expr_eval:
        p EC STO |- typedExpressionIR_cond
                  : EC_cond STO_cond (`` (`B true))
    -- Stmt_eval:
        p EC_cond STO_cond |- statementIR_then
                            : EC_then STO_then statementResult

  rule Stmt_eval/else-cont-false:
    p EC STO |- IF `( typedExpressionIR_cond ) statementIR_then
                ELSE statementIR_else
              : EC_else STO_else statementResult
    -- Expr_eval:
        p EC STO |- typedExpressionIR_cond
                  : EC_cond STO_cond (`` (`B false))
    -- Stmt_eval:
        p EC_cond STO_cond |- statementIR_else
                            : EC_else STO_else statementResult

}

;;; forStatementIR
;;; syntax forStatementIR

;;;; annotationList FOR
;;;;   `( forInitStatementListIR `; typedExpressionIR `; forUpdateStatementListIR )
;;;;   statementIR

;;;;; syntax forUpdateStatementIR

relation ForUpdateStmt_eval:
  evalContext store |- forUpdateStatementIR
                     : evalContext store statementResult
  hint(input %0 %1 %2)

;;;;;; callableTargetIR `< typeArgumentListIR > `( argumentListIR )

rule ForUpdateStmt_eval/call:
  EC_0 STO_0 |- callableTargetIR `< typeArgumentListIR > `( argumentListIR )
              : EC_1 STO_1 statementResult
  -- Stmt_eval: 
      LOCAL EC_0 STO_0 |- callableTargetIR `< typeArgumentListIR > `( argumentListIR ) `;
                        : EC_1 STO_1 statementResult

;;;;;; typedLvalueIR assignop typedExpressionIR

rule ForUpdateStmt_eval/assign:
  EC_0 STO_0 |- typedLvalueIR assignop typedExpressionIR
              : EC_1 STO_1 statementResult
  -- Stmt_eval: LOCAL EC_0 STO_0 |- typedLvalueIR assignop typedExpressionIR `;
                                  : EC_1 STO_1 statementResult

;;;;; syntax forUpdateStatementListIR = forUpdateStatementIR*

relation ForUpdateStmts_eval:
  evalContext store |- forUpdateStatementListIR
                     : evalContext store statementResult
  hint(input %0 %1 %2)

rulegroup ForUpdateStmts_eval {

  rule ForUpdateStmts_eval/nil:
    EC STO |- eps : EC STO ``

  rule ForUpdateStmts_eval/cons-head-exit:
    EC_0 STO_0 |- forUpdateStatementIR_h :: forUpdateStatementIR_t*
                : EC_1 STO_1 EXIT
    -- ForUpdateStmt_eval: 
        EC_0 STO_0 |- forUpdateStatementIR_h : EC_1 STO_1 EXIT

  rule ForUpdateStmts_eval/cons-head-cont:
    EC_0 STO_0 |- forUpdateStatementIR_h :: forUpdateStatementIR_t*
                : EC_2 STO_2 statementResult
    -- ForUpdateStmt_eval:
        EC_0 STO_0 |- forUpdateStatementIR_h : EC_1 STO_1 ``
    -- ForUpdateStmts_eval:
        EC_1 STO_1 |- forUpdateStatementIR_t* : EC_2 STO_2 statementResult

}

;;;;; syntax forInitStatementIR

relation ForInitStmt_eval:
  evalContext store |- forInitStatementIR
                     : evalContext store statementResult
  hint(input %0 %1 %2)

;;;;;; annotationList typeIR nameIR initializerOptIR

rulegroup ForInitStmt_eval/variableDeclarationIR {

  rule ForInitStmt_eval/non-initializer:
    EC_0 STO |- annotationList typeIR nameIR eps
              : EC_1 STO ``
    ---- ;; get initial value
    -- if typeIR_subst = $subst_type_e(LOCAL, EC_0, typeIR)
    -- if value_init = $default(typeIR_subst)
    ---- ;; update evaluation context
    -- if EC_1 = $add_var_e(LOCAL, EC_0, `` nameIR, value_init)

  rule ForInitStmt_eval/initializer-exit:
    EC_0 STO_0 |- annotationList typeIR nameIR (`= typedExpressionIR_init)
                : EC_1 STO_1 EXIT
    ---- ;; evaluate initializer
    -- Expr_eval:
        LOCAL EC_0 STO_0 |- typedExpressionIR_init 
                          : EC_1 STO_1 EXIT

  rule ForInitStmt_eval/initializer-cont:
    EC_0 STO_0 |- annotationList typeIR nameIR (`= typedExpressionIR_init)
                : EC_2 STO_1 ``
    ---- ;; evaluate initializer
    -- Expr_eval:
        LOCAL EC_0 STO_0 |- typedExpressionIR_init
                          : EC_1 STO_1 (`` value_init)
    ---- ;; update evaluation context
    -- if EC_2 = $add_var_e(LOCAL, EC_1, `` nameIR, value_init)

}

;;;;;; forUpdateStatementIR

rule ForInitStmt_eval/forUpdateStatementIR:
  EC_0 STO_0 |- forUpdateStatementIR
              : EC_1 STO_1 statementResult
  -- ForUpdateStmt_eval: 
      EC_0 STO_0 |- forUpdateStatementIR : EC_1 STO_1 statementResult

;;;;; syntax forInitStatementListIR = forInitStatementIR*

relation ForInitStmts_eval:
  evalContext store |- forInitStatementListIR
                     : evalContext store statementResult
  hint(input %0 %1 %2)

rulegroup ForInitStmts_eval {

  rule ForInitStmts_eval/nil:
    EC STO |- eps : EC STO ``

  rule ForInitStmts_eval/cons-head-exit:
    EC_0 STO_0 |- forInitStatementIR_h :: forInitStatementIR_t*
                : EC_1 STO_1 EXIT
    -- ForInitStmt_eval: 
        EC_0 STO_0 |- forInitStatementIR_h : EC_1 STO_1 EXIT

  rule ForInitStmts_eval/cons-head-cont:
    EC_0 STO_0 |- forInitStatementIR_h :: forInitStatementIR_t*
                : EC_2 STO_2 statementResult
    -- ForInitStmt_eval:
        EC_0 STO_0 |- forInitStatementIR_h : EC_1 STO_1 ``
    -- ForInitStmts_eval:
        EC_1 STO_1 |- forInitStatementIR_t* : EC_2 STO_2 statementResult

}

;;;; annotationList FOR
;;;;   `( forInitStatementListIR `; typedExpressionIR `; forUpdateStatementListIR )
;;;;   statementIR

relation ForThreeClauseLoop_eval:
  evalContext store |- typedExpressionIR statementIR forUpdateStatementListIR
                     : evalContext store statementResult
  hint(input %0 %1 %2 %3 %4)

rulegroup ForThreeClauseLoop_eval {

  rule ForThreeClauseLoop_eval/cond-exit:
    EC_0 STO_0 |- typedExpressionIR statementIR forUpdateStatementListIR
                : EC_1 STO_1 EXIT
    -- Expr_eval: 
        LOCAL EC_0 STO_0 |- typedExpressionIR : EC_1 STO_1 EXIT

  rule ForThreeClauseLoop_eval/cond-false:
    EC_0 STO_0 |- typedExpressionIR statementIR forUpdateStatementListIR
                : EC_1 STO_1 ``
    -- Expr_eval:
        LOCAL EC_0 STO_0 |- typedExpressionIR : EC_1 STO_1 (`` (`B false))

  rule ForThreeClauseLoop_eval/cond-true-loop-exit:
    EC_0 STO_0 |- typedExpressionIR statementIR forUpdateStatementListIR
                : EC_2 STO_2 EXIT
    -- Expr_eval:
        LOCAL EC_0 STO_0 |- typedExpressionIR : EC_1 STO_1 (`` (`B true))
    -- Stmt_eval:
        LOCAL EC_1 STO_1 |- statementIR : EC_2 STO_2 EXIT

  rule ForThreeClauseLoop_eval/cond-true-loop-return:
    EC_0 STO_0 |- typedExpressionIR statementIR forUpdateStatementListIR
                : EC_2 STO_2 returnResult
    -- Expr_eval:
        LOCAL EC_0 STO_0 |- typedExpressionIR : EC_1 STO_1 (`` (`B true))
    -- Stmt_eval:
        LOCAL EC_1 STO_1 |- statementIR : EC_2 STO_2 returnResult

  rule ForThreeClauseLoop_eval/cond-true-loop-break:
    EC_0 STO_0 |- typedExpressionIR statementIR forUpdateStatementListIR
                : EC_2 STO_2 ``
    -- Expr_eval:
        LOCAL EC_0 STO_0 |- typedExpressionIR : EC_1 STO_1 (`` (`B true))
    -- Stmt_eval:
        LOCAL EC_1 STO_1 |- statementIR : EC_2 STO_2 BREAK

  rule ForThreeClauseLoop_eval/cond-true-loop-cont-update-exit:
    EC_0 STO_0 |- typedExpressionIR statementIR forUpdateStatementListIR
                : EC_3 STO_3 EXIT
    -- Expr_eval:
        LOCAL EC_0 STO_0 |- typedExpressionIR : EC_1 STO_1 (`` (`B true))
    -- Stmt_eval:
        LOCAL EC_1 STO_1 |- statementIR : EC_2 STO_2 statementResult_loop
    -- if statementResult_loop <- [ ``, CONTINUE ]
    -- ForUpdateStmts_eval: 
        EC_2 STO_2 |- forUpdateStatementListIR : EC_3 STO_3 EXIT

  rule ForThreeClauseLoop_eval/cond-true-loop-cont-update-cont:
    EC_0 STO_0 |- typedExpressionIR statementIR forUpdateStatementListIR
                : EC_4 STO_4 statementResult
    -- Expr_eval:
        LOCAL EC_0 STO_0 |- typedExpressionIR : EC_1 STO_1 (`` (`B true))
    -- Stmt_eval:
        LOCAL EC_1 STO_1 |- statementIR : EC_2 STO_2 statementResult_loop
    -- if statementResult_loop <- [ ``, CONTINUE ]
    -- ForUpdateStmts_eval:
        EC_2 STO_2 |- forUpdateStatementListIR : EC_3 STO_3 ``
    -- ForThreeClauseLoop_eval: 
        EC_3 STO_3 |- typedExpressionIR statementIR forUpdateStatementListIR
                    : EC_4 STO_4 statementResult

}

rulegroup Stmt_eval/forStatementIR-three-clause {

  rule Stmt_eval/init-exit:
    LOCAL EC_0 STO_0 |- annotationList FOR
                          `( forInitStatementListIR `;
                             typedExpressionIR `;
                             forUpdateStatementListIR ) statementIR
                      : EC_3 STO_1 EXIT
    -- if EC_1 = $enter_e(EC_0)
    -- ForInitStmts_eval:
        EC_1 STO_0 |- forInitStatementListIR : EC_2 STO_1 EXIT
    -- if EC_3 = $exit_e(EC_2)

  rule Stmt_eval/init-cont:
    LOCAL EC_0 STO_0 |- annotationList FOR
                          `( forInitStatementListIR `;
                             typedExpressionIR `;
                             forUpdateStatementListIR ) statementIR
                      : EC_4 STO_2 statementResult
    -- if EC_1 = $enter_e(EC_0)
    -- ForInitStmts_eval:
        EC_1 STO_0 |- forInitStatementListIR : EC_2 STO_1 ``
    -- ForThreeClauseLoop_eval:
        EC_2 STO_1 |- typedExpressionIR statementIR forUpdateStatementListIR
                    : EC_3 STO_2 statementResult
    -- if EC_4 = $exit_e(EC_3)

}

;;;; annotationList FOR
;;;;   `( typeIR nameIR IN forCollectionExpressionIR )
;;;;   statementIR
;;;; annotationList FOR
;;;;   `( annotationList typeIR nameIR IN forCollectionExpressionIR )
;;;;   statementIR

;;;;; syntax forCollectionExpressionIR

relation ForCollectionExpr_eval:
  evalContext store |- forCollectionExpressionIR
                     : evalContext store expressionListResult
  hint(input %0 %1 %2)

;;;;;; typedExpressionIR

rulegroup ForCollectionExpr_eval/expr {

  rule ForCollectionExpr_eval/exit:
    EC_0 STO_0 |- typedExpressionIR : EC_1 STO_1 EXIT
    -- Expr_eval:
        LOCAL EC_0 STO_0 |- typedExpressionIR : EC_1 STO_1 EXIT

  rule ForCollectionExpr_eval/list:
    EC_0 STO_0 |- typedExpressionIR : EC_1 STO_1 (`` value*)
    -- Expr_eval:
        LOCAL EC_0 STO_0 |- typedExpressionIR : EC_1 STO_1 (`` listValue)
    -- if LIST `[ value* ] = listValue

  rule ForCollectionExpr_eval/header-stack:
    EC_0 STO_0 |- typedExpressionIR : EC_1 STO_1 (`` value*)
    -- Expr_eval:
        LOCAL EC_0 STO_0 |- typedExpressionIR : EC_1 STO_1 (`` headerStackValue)
  -- if HEADER_STACK `[ value* `( _; _ ) ] = headerStackValue

}

;;;;;; typedExpressionIR `.. typedExpressionIR

dec $values_of_setValue(setTypeIR, setValue) : value*

def $values_of_setValue(SET `< typeIR >, SET `{ value_l `.. value_r })
  = value_l :: $values_of_setValue(SET `< typeIR >, SET `{ value_l_inc `.. value_r })
  -- if $bin_lt(value_l, value_r)
  -- if value_one = $cast_op(typeIR, D 1)
  -- if value_l_inc = $bin_plus(value_l, value_one)
def $values_of_setValue(SET `< typeIR >, SET `{ value_l `.. value_r }) = value_l
  -- if $bin_eq(value_l, value_r)
def $values_of_setValue(SET `< typeIR >, SET `{ value_l `.. value_r }) = eps
  -- if $bin_gt(value_l, value_r)

rulegroup ForCollectionExpr_eval/range {

  rule ForCollectionExpr_eval/left-exit:
    EC_0 STO_0 |- typedExpressionIR_l `.. typedExpressionIR_r 
                : EC_1 STO_1 EXIT
    -- Expr_eval: 
        LOCAL EC_0 STO_0 |- typedExpressionIR_l : EC_1 STO_1 EXIT

  rule ForCollectionExpr_eval/left-cont-right-exit:
    EC_0 STO_0 |- typedExpressionIR_l `.. typedExpressionIR_r 
                : EC_2 STO_2 EXIT
    -- Expr_eval: 
        LOCAL EC_0 STO_0 |- typedExpressionIR_l : EC_1 STO_1 (`` value_l)
    -- Expr_eval:
        LOCAL EC_1 STO_1 |- typedExpressionIR_r : EC_2 STO_2 EXIT

  rule ForCollectionExpr_eval/left-cont-right-cont:
    EC_0 STO_0 |- typedExpressionIR_l `.. typedExpressionIR_r 
                : EC_2 STO_2 (`` value*)
    -- Expr_eval: 
        LOCAL EC_0 STO_0 |- typedExpressionIR_l : EC_1 STO_1 (`` value_l)
    -- Expr_eval:
        LOCAL EC_1 STO_1 |- typedExpressionIR_r : EC_2 STO_2 (`` value_r)
    -- if typeIR = $type_of_typedExpressionIR(typedExpressionIR_l)
    -- if value*
        = $values_of_setValue(SET `< typeIR >, SET `{ value_l `.. value_r })

}

relation ForInLoop_eval:
  evalContext store |- nameIR value* statementIR
                     : evalContext store statementResult
  hint(input %0 %1 %2 %3 %4)

rulegroup ForInLoop_eval {

  rule ForInLoop_eval/nil:
    EC STO |- nameIR eps statementIR : EC STO ``

  rule ForInLoop_eval/cons-loop-exit:
    EC_0 STO_0 |- nameIR (value_h :: value_t*) statementIR
                : EC_2 STO_1 EXIT
    -- if EC_1 = $update_var_e(LOCAL, EC_0, `` nameIR, value_h)
    -- Stmt_eval: LOCAL EC_1 STO_0 |- statementIR : EC_2 STO_1 EXIT

  rule ForInLoop_eval/cons-loop-return:
    EC_0 STO_0 |- nameIR (value_h :: value_t*) statementIR
                : EC_2 STO_1 returnResult
    -- if EC_1 = $update_var_e(LOCAL, EC_0, `` nameIR, value_h)
    -- Stmt_eval: LOCAL EC_1 STO_0 |- statementIR : EC_2 STO_1 returnResult

  rule ForInLoop_eval/cons-loop-break:
    EC_0 STO_0 |- nameIR (value_h :: value_t*) statementIR
                : EC_2 STO_1 ``
    -- if EC_1 = $update_var_e(LOCAL, EC_0, `` nameIR, value_h)
    -- Stmt_eval: LOCAL EC_1 STO_0 |- statementIR : EC_2 STO_1 BREAK

  rule ForInLoop_eval/cons-loop-cont:
    EC_0 STO_0 |- nameIR (value_h :: value_t*) statementIR
                : EC_3 STO_2 statementResult
    -- if EC_1 = $update_var_e(LOCAL, EC_0, `` nameIR, value_h)
    -- Stmt_eval: LOCAL EC_1 STO_0 |- statementIR : EC_2 STO_1 statementResult_loop
    -- if statementResult_loop <- [ ``, CONTINUE ]
    -- ForInLoop_eval:
        EC_2 STO_1 |- nameIR value_t* statementIR : EC_3 STO_2 statementResult

}

rulegroup Stmt_eval/forStatementIR-in {

  rule Stmt_eval/no-annotations-collection-exit:
    LOCAL EC_0 STO_0 |- annotationList FOR
                          `( typeIR nameIR IN forCollectionExpressionIR ) 
                          statementIR
                      : EC_3 STO_1 EXIT
    -- if EC_1 = $enter_e(EC_0)
    -- ForCollectionExpr_eval:
        EC_1 STO_0 |- forCollectionExpressionIR : EC_2 STO_1 EXIT
    -- if EC_3 = $exit_e(EC_2)

  rule Stmt_eval/no-annotations-collection-loop:
    LOCAL EC_0 STO_0 |- annotationList FOR
                          `( typeIR nameIR IN forCollectionExpressionIR ) 
                          statementIR
                      : EC_5 STO_2 statementResult
    -- if EC_1 = $enter_e(EC_0)
    ---- ;; evaluate collection
    -- ForCollectionExpr_eval:
        EC_1 STO_0 |- forCollectionExpressionIR : EC_2 STO_1 (`` value*)
    ---- ;; update evaluation context
    -- if typeIR_subst = $subst_type_e(LOCAL, EC_0, typeIR)
    -- if value_init = $default(typeIR_subst)
    -- if EC_3 = $add_var_e(LOCAL, EC_2, `` nameIR, value_init)
    ---- ;; evaluate loop
    -- ForInLoop_eval:
        EC_3 STO_1 |- nameIR value* statementIR : EC_4 STO_2 statementResult
    -- if EC_5 = $exit_e(EC_4)

  rule Stmt_eval/annotations:
    LOCAL EC_0 STO_0 |- annotationList FOR
                          `( annotationList_in
                             typeIR nameIR IN forCollectionExpressionIR )
                          statementIR
                      : EC_1 STO_1 statementResult
    -- Stmt_eval:
        LOCAL EC_0 STO_0 |- annotationList FOR
                              `( typeIR nameIR IN forCollectionExpressionIR )
                              statementIR
                          : EC_1 STO_1 statementResult

}

;;; breakStatementIR

rule Stmt_eval/breakStatement:
  LOCAL EC STO |- BREAK `; : EC STO BREAK

;;; continueStatementIR

rule Stmt_eval/continueStatement:
  LOCAL EC STO |- CONTINUE `; : EC STO CONTINUE

;;; switchStatementIR
;;; syntax switchStatementIR =
;;;   SWITCH `( typedExpressionIR ) `{ switchCaseListIR }

;;;; Switch on table apply method result

;;;;; syntax switchLabelIR
;;;;;; DEFAULT
;;;;;; typedExpressionIR

dec $match_switchLabelIR_table(id, switchLabelIR) : bool
def $match_switchLabelIR_table(id, DEFAULT) = true
def $match_switchLabelIR_table(id, (`` id) `# _) = true
def $match_switchLabelIR_table(id, _) = false
  -- otherwise

;;;;; syntax switchCaseListIR
;;;;;; switchLabelIR `: blockStatementIR
;;;;;; switchLabelIR `: 

relation SwitchCases_table_eval:
  id |- switchCaseListIR : blockStatementIR?
  hint(input %0 %1)

dec $is_non_fallthrough_switchCaseIR(switchCaseIR) : bool
def $is_non_fallthrough_switchCaseIR(switchLabelIR `: blockStatementIR) = true
def $is_non_fallthrough_switchCaseIR(switchLabelIR `: ) = false

rulegroup SwitchCases_table_eval {

  rule SwitchCases_table_eval/nil:
    id |- eps : eps

  rule SwitchCases_table_eval/cons-non-fallthrough-match:
    id |- switchCaseIR_h :: switchCaseIR_t* : blockStatementIR_h
    ---- ;; if not fallthrough
    -- if switchLabelIR_h `: blockStatementIR_h = switchCaseIR_h
    ---- ;; if match
    -- if $match_switchLabelIR_table(id, switchLabelIR_h)

  rule SwitchCases_table_eval/cons-non-fallthrough-no-match:
    id |- switchCaseIR_h :: switchCaseIR_t* : blockStatementIR?
    ---- ;; if not fallthrough
    -- if switchLabelIR_h `: blockStatementIR_h = switchCaseIR_h
    ---- ;; if no match
    -- if ~$match_switchLabelIR_table(id, switchLabelIR_h)
    -- SwitchCases_table_eval:
        id |- switchCaseIR_t* : blockStatementIR?

  rule SwitchCases_table_eval/cons-fallthrough-match:
    id |- switchCaseIR_h :: switchCaseIR_t* : blockStatementIR
    ---- ;; if fallthrough
    -- if switchLabelIR_h `: = switchCaseIR_h
    ---- ;; if match
    -- if $match_switchLabelIR_table(id, switchLabelIR_h)
    ---- ;; take the closest non-fallthrough case
    -- if (_ `: blockStatementIR) :: _
        = $filter_<switchCaseIR>(switchCaseIR_t*, def $is_non_fallthrough_switchCaseIR)

  rule SwitchCases_table_eval/cons-fallthrough-no-match:
    id |- switchCaseIR_h :: switchCaseIR_t* : blockStatementIR?
    ---- ;; if fallthrough
    -- if switchLabelIR_h `: = switchCaseIR_h
    ---- ;; if no match
    -- if ~$match_switchLabelIR_table(id, switchLabelIR_h)
    -- SwitchCases_table_eval:
        id |- switchCaseIR_t* : blockStatementIR?

}

relation SwitchLabelIR_general_eval:
  cursor evalContext store |- switchLabelIR : evalContext store expressionResult
  hint(input %0 %1 %2 %3)

rulegroup SwitchLabelIR_general_eval {

  rule SwitchLabelIR_general_eval/default:
    LOCAL EC_0 STO_0 |- DEFAULT : EC_0 STO_0 (`` DEFAULT)

  rule SwitchLabelIR_general_eval/typedExpressionIR-exit:
    LOCAL EC_0 STO_0 |- typedExpressionIR : EC_1 STO_1 EXIT
    -- Expr_eval:
        LOCAL EC_0 STO_0 |- typedExpressionIR : EC_1 STO_1 EXIT

  rule SwitchLabelIR_general_eval/typedExpressionIR-cont:
    LOCAL EC_0 STO_0 |- typedExpressionIR : EC_1 STO_1 (`` value)
    -- Expr_eval:
        LOCAL EC_0 STO_0 |- typedExpressionIR : EC_1 STO_1 (`` value)

}

dec $match_switchLabelIR_general(value, value) : bool
def $match_switchLabelIR_general(value, DEFAULT) = true
def $match_switchLabelIR_general(w_a W i_a, w_b W i_b) = (w_a = w_b) /\ (i_a = i_b)
def $match_switchLabelIR_general(w_a S i_a, w_b W i_b) = (w_a = w_b) /\ (i_a = i_b)
def $match_switchLabelIR_general(enumValue_a, enumValue_b) = $bin_eq(enumValue_a, enumValue_b)
def $match_switchLabelIR_general(errorValue_a, errorValue_b) = $bin_eq(errorValue_a, errorValue_b)
def $match_switchLabelIR_general(value, _) = false
  -- otherwise

relation SwitchCases_general_eval:
  cursor evalContext store value |- switchCaseListIR : evalContext store blockStatementIR?
  hint(input %0 %1 %2 %3 %4)

rulegroup SwitchCases_general_eval {

  rule SwitchCases_general_eval/nil:
    LOCAL EC_0 STO_0 value |- eps : EC_0 STO_0 eps

  rule SwitchCases_general_eval/cons-non-fallthrough-match:
    LOCAL EC_0 STO_0 value |- (switchCaseIR_h :: switchCaseIR_t*) : EC_1 STO_1 blockStatementIR_h
    ---- ;; if not fall-through
    -- if switchLabelIR_h `: blockStatementIR_h = switchCaseIR_h
    -- SwitchLabelIR_general_eval:
        LOCAL EC_0 STO_0 |- switchLabelIR_h : EC_1 STO_1 (`` value_label)
    ---- ;; if match
    -- if $match_switchLabelIR_general(value, value_label)

  rule SwitchCases_general_eval/cons-non-fallthrough-no-match:
    LOCAL EC_0 STO_0 value |- (switchCaseIR_h :: switchCaseIR_t*) : EC_2 STO_2 blockStatementIR_h
    ---- ;; if not fall-through
    -- if switchLabelIR_h `: blockStatementIR_h = switchCaseIR_h
    -- SwitchLabelIR_general_eval:
        LOCAL EC_0 STO_0 |- switchLabelIR_h : EC_1 STO_1 (`` value_label)
    ---- ;; if not match
    -- if ~$match_switchLabelIR_general(value, value_label)
    -- SwitchCases_general_eval:
        LOCAL EC_1 STO_1 value |- switchCaseIR_t* : EC_2 STO_2 blockStatementIR?

  rule SwitchCases_general_eval/cons-fallthrough-match:
    LOCAL EC_0 STO_0 value |- (switchCaseIR_h :: switchCaseIR_t*) : EC_1 STO_1 blockStatementIR
    ---- ;; if fallthrough
    -- if switchLabelIR_h `: = switchCaseIR_h
    -- SwitchLabelIR_general_eval:
        LOCAL EC_0 STO_0 |- switchLabelIR_h : EC_1 STO_1 (`` value_label)
    ---- ;; if match
    -- if $match_switchLabelIR_general(value, value_label)
    ---- ;; take the closest non-fallthrough case
    -- if (_ `: blockStatementIR) :: _
        = $filter_<switchCaseIR>(switchCaseIR_t*, def $is_non_fallthrough_switchCaseIR)

  rule SwitchCases_general_eval/cons-fallthrough-no-match:
    LOCAL EC_0 STO_0 value |- (switchCaseIR_h :: switchCaseIR_t*) : EC_2 STO_2 blockStatementIR?
    ---- ;; if fallthrough
    -- if switchLabelIR_h `: = switchCaseIR_h
    -- SwitchLabelIR_general_eval:
        LOCAL EC_0 STO_0 |- switchLabelIR_h : EC_1 STO_1 (`` value_label)
    ---- ;; if no match
    -- if ~$match_switchLabelIR_general(value, value_label)
    -- SwitchCases_general_eval:
        LOCAL EC_1 STO_1 value |- switchCaseIR_t* : EC_2 STO_2 blockStatementIR?

}

rulegroup Stmt_eval/switchStatementIR-table {

  rule Stmt_eval/target-exit:
    LOCAL EC_0 STO_0 |- SWITCH `( typedExpressionIR ) `{ switchCaseIR* }
                      : EC_1 STO_1 EXIT
    ---- ;; evaluate switch target
    -- Expr_eval:
        LOCAL EC_0 STO_0 |- typedExpressionIR : EC_1 STO_1 EXIT

  rule Stmt_eval/target-cont-match:
    LOCAL EC_0 STO_0 |- SWITCH `( typedExpressionIR ) `{ switchCaseIR* }
                      : EC_2 STO_2 statementResult
    ---- ;; evaluate switch target
    -- Expr_eval:
        LOCAL EC_0 STO_0 |- typedExpressionIR : EC_1 STO_1 (`` value)
    ---- ;; if switch on table apply result
    -- if TABLE_ENUM _ `. id_enum = value
    ---- ;; find matching case
    -- SwitchCases_table_eval:
        id_enum |- switchCaseIR* : blockStatementIR
    ---- ;; evaluate matching case
    -- Stmt_eval:
        LOCAL EC_1 STO_1 |- blockStatementIR : EC_2 STO_2 statementResult

  rule Stmt_eval/target-cont-no-match:
    LOCAL EC_0 STO_0 |- SWITCH `( typedExpressionIR ) `{ switchCaseIR* }
                      : EC_1 STO_1 ``
    ---- ;; evaluate switch target
    -- Expr_eval:
        LOCAL EC_0 STO_0 |- typedExpressionIR : EC_1 STO_1 (`` value)
    ---- ;; if switch on table apply result
    -- if TABLE_ENUM _ `. id_enum = value
    ---- ;; find matching case
    -- SwitchCases_table_eval:
        id_enum |- switchCaseIR* : eps

}

rulegroup Stmt_eval/switchStatementIR-general {

  ;; target-exit is covered in Stmt_eval/switchStatementIR-table

  rule Stmt_eval/target-cont-match:
    LOCAL EC_0 STO_0 |- SWITCH `( typedExpressionIR ) `{ switchCaseIR* }
                      : EC_2 STO_2 statementResult
    ---- ;; evaluate switch target
    -- Expr_eval:
        LOCAL EC_0 STO_0 |- typedExpressionIR : EC_1 STO_1 (`` value)
    ---- ;; find matching case
    -- SwitchCases_general_eval:
        LOCAL EC_0 STO_0 value |- switchCaseIR* : EC_1 STO_1 blockStatementIR
    ---- ;; evaluate matching case
    -- Stmt_eval:
        LOCAL EC_1 STO_1 |- blockStatementIR : EC_2 STO_2 statementResult

  rule Stmt_eval/target-cont-no-match:
    LOCAL EC_0 STO_0 |- SWITCH `( typedExpressionIR ) `{ switchCaseIR* }
                      : EC_1 STO_1 ``
    ---- ;; evaluate switch target
    -- Expr_eval:
        LOCAL EC_0 STO_0 |- typedExpressionIR : EC_1 STO_1 (`` value)
    ---- ;; find matching case
    -- SwitchCases_general_eval:
        LOCAL EC_0 STO_0 value |- switchCaseIR* : EC_1 STO_1 eps

}

