;;; constantDeclarationIR

rulegroup BlockElementStmt_eval/constantDeclarationIR {

  rule BlockElementStmt_eval/exit:
    EC_0 STO_0 |- constantDeclarationIR
                : EC_1 STO_1 EXIT
    -- Decl_eval:
        LOCAL EC_0 STO_0 |- constantDeclarationIR
                          : EC_1 STO_1 EXIT

  rule BlockElementStmt_eval/cont:
    EC_0 STO_0 |- constantDeclarationIR
                : EC_1 STO_1 ``
    -- Decl_eval:
        LOCAL EC_0 STO_0 |- constantDeclarationIR
                          : EC_1 STO_1 ``

}

;;; variableDeclarationIR

rulegroup BlockElementStmt_eval/variableDeclarationIR {

  rule BlockElementStmt_eval/non-initializer:
    EC_0 STO |- annotationList typeIR nameIR eps `;
              : EC_1 STO ``
    ---- ;; get initial value
    -- if typeIR_subst = $subst_type_e(LOCAL, EC_0, typeIR)
    -- if value_init = $default(typeIR)
    ---- ;; update evaluation context
    -- if EC_1 = $add_var_e(LOCAL, EC_0, `` nameIR, value_init)

  rule BlockElementStmt_eval/initializer-exit:
    EC_0 STO_0 |- annotationList typeIR nameIR (`= typedExpressionIR_init) `;
                : EC_1 STO_1 EXIT
    ---- ;; evaluate initializer
    -- Expr_eval:
        LOCAL EC_0 STO_0 |- typedExpressionIR_init
                          : EC_1 STO_1 EXIT

  rule BlockElementStmt_eval/initializer-cont:
    EC_0 STO_0 |- annotationList typeIR nameIR (`= typedExpressionIR_init) `;
                : EC_2 STO_1 ``
    ---- ;; evaluate initializer
    -- Expr_eval:
        LOCAL EC_0 STO_0 |- typedExpressionIR_init
                          : EC_1 STO_1 (`` value_init)
    ---- ;; update evaluation context
    -- if EC_2 = $add_var_e(LOCAL, EC_1, `` nameIR, value_init)

}

;;; statementIR

rule BlockElementStmt_eval/statementIR:
  EC_0 STO_0 |- statementIR
              : EC_1 STO_1 statementResult
  -- Stmt_eval:
      LOCAL EC_0 STO_0 |- statementIR
                        : EC_1 STO_1 statementResult

;;
;; syntax blockElementStatementListIR
;;

rulegroup BlockElementStmts_eval {

  rule BlockElementStmts_eval/nil:
    EC STO |- eps : EC STO ``

  rule BlockElementStmts_eval/cons-head-exit:
    EC_0 STO_0 |- blockElementStatementIR_h :: blockElementStatementIR_t*
                : EC_1 STO_1 EXIT
    -- BlockElementStmt_eval:
        EC_0 STO_0 |- blockElementStatementIR_h
                    : EC_1 STO_1 EXIT

  rule BlockElementStmts_eval/cons-head-return:
    EC_0 STO_0 |- blockElementStatementIR_h :: blockElementStatementIR_t*
                : EC_1 STO_1 returnResult
    -- BlockElementStmt_eval:
        EC_0 STO_0 |- blockElementStatementIR_h
                    : EC_1 STO_1 returnResult

  rule BlockElementStmts_eval/cons-head-break:
    EC_0 STO_0 |- blockElementStatementIR_h :: blockElementStatementIR_t*
                : EC_1 STO_1 BREAK
    -- BlockElementStmt_eval:
        EC_0 STO_0 |- blockElementStatementIR_h
                    : EC_1 STO_1 BREAK

  rule BlockElementStmts_eval/cons-head-continue:
    EC_0 STO_0 |- blockElementStatementIR_h :: blockElementStatementIR_t*
                : EC_1 STO_1 CONTINUE
    -- BlockElementStmt_eval:
        EC_0 STO_0 |- blockElementStatementIR_h
                    : EC_1 STO_1 CONTINUE

  rule BlockElementStmts_eval/cons-head-cont:
    EC_0 STO_0 |- blockElementStatementIR_h :: blockElementStatementIR_t*
                : EC_2 STO_2 statementResult
    -- BlockElementStmt_eval:
        EC_0 STO_0 |- blockElementStatementIR_h
                    : EC_1 STO_1 ``
    -- BlockElementStmts_eval:
        EC_1 STO_1 |- blockElementStatementIR_t*
                    : EC_2 STO_2 statementResult

}

;;
;; syntax blockStatmentIR = annotationList `{ blockElementStatementListIR }
;;

rule Block_eval:
  EC_0 STO_0 |- annotationList `{ blockElementStatementListIR }
              : EC_1 STO_1 statementResult
  -- BlockElementStmts_eval:
      EC_0 STO_0 |- blockElementStatementListIR
                  : EC_1 STO_1 statementResult
