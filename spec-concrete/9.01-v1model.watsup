      = (typedExpressionIR_main `. "ig") `# `( VOID CTK )
  -- if routineTargetIR
      = typedExpressionIR_v `. "apply"
  -- Stmt_eval:
      GLOBAL EC_0 STO_0 |- routineTargetIR `< eps > `( argumentIR* ) `;
                         : EC_1 STO_1 CONT

