;;
;; Layered context
;;

;; Global layer

syntax globalEvaluationLayer = globalInstantiationLayer

;; Block Layer

syntax blockEvaluationLayer = blockInstantiationLayer

;; Local layer

syntax localEvaluationLayer = localInstantiationLayer

;;
;; Instantiation context
;;

syntax evaluationContext =
  { GLOBAL globalEvaluationLayer,
    BLOCK blockEvaluationLayer,
    LOCAL localEvaluationLayer }

var EC : evaluationContext

;;
;; Frame entry and exit
;;

dec $enter_eval(evaluationContext) : evaluationContext

def $enter_eval(EC) = EC[ .LOCAL.FRAMES = $empty_frame :: EC.LOCAL.FRAMES ]

dec $exit_eval(evaluationContext) : evaluationContext

def $exit_eval(EC) = EC[ .LOCAL.FRAMES = frame_t* ]
  -- if EC.LOCAL.FRAMES = frame_h :: frame_t*

;;
;; Adders
;;

;;; Adder for values

dec $add_value_eval(cursor, evaluationContext, id, value): evaluationContext
dec $add_values_eval(cursor, evaluationContext, id*, value*): evaluationContext

def $add_value_eval(GLOBAL, EC, id, value) = EC[ .GLOBAL.FRAME = frame ]
  -- if ~$in_set<id>(id, $dom_map<id, value>(EC.GLOBAL.FRAME))
  -- if frame = $add_map<id, value>(EC.GLOBAL.FRAME, id, value)
def $add_value_eval(BLOCK, EC, id, value) = EC[ .BLOCK.FRAME = frame ]
  -- if ~$in_set<id>(id, $dom_map<id, value>(EC.BLOCK.FRAME))
  -- if frame = $add_map<id, value>(EC.BLOCK.FRAME, id, value)
def $add_value_eval(LOCAL, EC, id, value) = EC[ .LOCAL.FRAMES = frame_h' :: frame_t* ]
  -- if EC.LOCAL.FRAMES = frame_h :: frame_t*
  -- if ~$in_set<id>(id, $dom_map<id, value>(frame_h))
  -- if frame_h' = $add_map<id, value>(frame_h, id, value)

def $add_values_eval(p, EC, eps, eps) = EC
def $add_values_eval(p, EC, id_h :: id_t*, value_h :: value_t*) = EC''
  -- if EC' = $add_value_eval(p, EC, id_h, value_h)
  -- if EC'' = $add_values_eval(p, EC', id_t*, value_t*)

;;; Adder for type definitions

dec $add_typedef_eval(cursor, evaluationContext, tid, typeDefIR) : evaluationContext

def $add_typedef_eval(GLOBAL, EC, tid, typeDefIR) = EC[ .GLOBAL.TYPE = tdenv ]
  -- if $add_map<tid, typeDefIR>(EC.GLOBAL.TYPE, tid, typeDefIR) = tdenv

;;; Adder for parser states

dec $add_state_eval(cursor, evaluationContext, nameIR, state) : evaluationContext

def $add_state_eval(BLOCK, EC, nameIR, state) = EC[ .BLOCK.STATE = senv ]
  -- if ~$in_set<nameIR>(nameIR, $dom_map<nameIR, state>(EC.BLOCK.STATE))
  -- if senv = $add_map<nameIR, state>(EC.BLOCK.STATE, nameIR, state)

;;; Adder for type variables

dec $add_types_eval(cursor, evaluationContext, tid*, typeIR*) : evaluationContext
dec $add_type_eval(cursor, evaluationContext, tid, typeIR) : evaluationContext

def $add_types_eval(p, EC, eps, eps) = EC
def $add_types_eval(p, EC, tid_h :: tid_t*, typeIR_h :: typeIR_t*) =
    $add_types_eval(p, EC', tid_t*, typeIR_t*)
  -- if EC' = $add_type_eval(p, EC, tid_h, typeIR_h)

def $add_type_eval(BLOCK, EC, tid, typeIR) = EC[ .BLOCK.TYPE = tenv ]
  -- if tenv = $add_map<tid, typeIR>(EC.BLOCK.TYPE, tid, typeIR)
def $add_type_eval(LOCAL, EC, tid, typeIR) = EC[ .LOCAL.TYPE = tenv ]
  -- if tenv = $add_map<tid, typeIR>(EC.LOCAL.TYPE, tid, typeIR)

;;; Adder for routines

dec $add_routine_overload_eval(cursor, evaluationContext, rid, routine)
  : evaluationContext

def $add_routine_overload_eval(GLOBAL, EC, rid, routine) = EC[ .GLOBAL.ROUTINE = renv ]
  -- if ~$in_set<rid>(rid, $dom_map<rid, routine>(EC.GLOBAL.ROUTINE))
  -- if renv = $add_map<rid, routine>(EC.GLOBAL.ROUTINE, rid, routine)
def $add_routine_overload_eval(BLOCK, EC, rid, routine) = EC[ .BLOCK.ROUTINE = renv ]
  -- if ~$in_set<rid>(rid, $dom_map<rid, routine>(EC.BLOCK.ROUTINE))
  -- if renv = $add_map<rid, routine>(EC.BLOCK.ROUTINE, rid, routine)

dec $add_routine_non_overload_eval(cursor, evaluationContext, rid, routine)
  : evaluationContext

def $add_routine_non_overload_eval(GLOBAL, EC, rid, routine) = EC[ .GLOBAL.ROUTINE = renv ]
  -- if id `( _ ) = rid
  -- if `{ (id_k `( _ ))* } = $dom_map<rid, routine>(EC.GLOBAL.ROUTINE)
  -- if ~$in_set<id>(id, `{ id_k* })
  -- if renv = $add_map<rid, routine>(EC.GLOBAL.ROUTINE, rid, routine)
def $add_routine_non_overload_eval(BLOCK, EC, rid, routine) = EC[ .BLOCK.ROUTINE = renv ]
  -- if id `( _ ) = rid
  -- if `{ (id_k `( _ ))* } = $dom_map<rid, routine>(EC.BLOCK.ROUTINE)
  -- if ~$in_set<id>(id, `{ id_k* })
  -- if renv = $add_map<rid, routine>(EC.BLOCK.ROUTINE, rid, routine)

;;; Adder for constructors

dec $add_constructor_eval(evaluationContext, cid, constructor)
  : evaluationContext

def $add_constructor_eval(EC, cid, constructor)
  = EC[ .GLOBAL.CONSTRUCTOR = cenv ]
  -- if cenv
      = $add_map<cid, constructor>(EC.GLOBAL.CONSTRUCTOR, cid, constructor)

dec $add_constructors_eval(evaluationContext, cid*, constructor*)
  : evaluationContext

def $add_constructors_eval(EC, eps, eps) = EC
def $add_constructors_eval(EC, cid_h :: cid_t*, constructor_h :: constructor_t*)
  = $add_constructors_eval(EC', cid_t*, constructor_t*)
  -- if EC' = $add_constructor_eval(EC, cid_h, constructor_h)

;;
;; Finders
;;

;;; Finder for values

dec $find_value_eval(cursor, evaluationContext, prefixedNameIR) : value

def $find_value_eval(p, EC, `. id) = value
  -- if value = $find_map<id, value>(EC.GLOBAL.FRAME, id)
def $find_value_eval(GLOBAL, EC, `` id) = value
  -- if value = $find_map<id, value>(EC.GLOBAL.FRAME, id)
def $find_value_eval(BLOCK, EC, `` id) = value
  -- if value = $find_map<id, value>(EC.BLOCK.FRAME, id)
def $find_value_eval(BLOCK, EC, `` id)
  = $find_value_eval(GLOBAL, EC, `` id)
  -- if eps = $find_map<id, value>(EC.BLOCK.FRAME, id)
def $find_value_eval(LOCAL, EC, `` id) = value
  -- if value = $find_maps<id, value>(EC.LOCAL.FRAMES, id)
def $find_value_eval(LOCAL, EC, `` id)
  = $find_value_eval(BLOCK, EC, `` id)
  -- if eps = $find_maps<id, value>(EC.LOCAL.FRAMES, id)

;;; Finder for typedefs

dec $find_type_eval(cursor, evaluationContext, prefixedNameIR) : typeDefIR?

def $find_type_eval(_, EC, `` nameIR)
  = $find_map<tid, typeDefIR>(EC.GLOBAL.TYPE, nameIR)
def $find_type_eval(_, EC, `. nameIR)
  = $find_map<tid, typeDefIR>(EC.GLOBAL.TYPE, nameIR)

;;; Finder for constructors 

dec $find_constructor_eval(evaluationContext, prefixedNameIR, argumentIR*)
  : (cid, constructor, id*)?

def $find_constructor_eval(EC, `` id, argumentIR*)
  = $find_overloaded<constructor>(EC.GLOBAL.CONSTRUCTOR, id, (id_arg?)*)
  -- if (id_arg?)* = $ids_arguments(argumentIR*)
def $find_constructor_eval(EC, `. id, argumentIR*)
  = $find_overloaded<constructor>(EC.GLOBAL.CONSTRUCTOR, id, (id_arg?)*)
  -- if (id_arg?)* = $ids_arguments(argumentIR*)
