;;
;; Unrolling outer typedefs
;;

dec $unroll_typeIR(typeIR) : typeIR
  hint(prose_in %0 "with typedefs unrolled")
def $unroll_typeIR(TYPEDEF _ typeIR) = $unroll_typeIR(typeIR)
def $unroll_typeIR(typeIR) = typeIR
  -- otherwise

;;
;; Unrolling outer aliases
;;

dec $unroll_aliasType(typeIR) : typeIR
  hint(prose_in %0 "with aliases unrolled")
def $unroll_aliasType(TYPE _ typeIR) = $unroll_aliasType(typeIR)
def $unroll_aliasType(TYPEDEF _ typeIR) = $unroll_aliasType(typeIR)
def $unroll_aliasType(typeIR) = typeIR
  -- otherwise

;;
;; Checkers for type properties
;;

tblgroup typeIR_is(typeIR) : bool
  hint(prose_true %0 "can be" %1)
  hint(prose_false %0 "cannot be" %1)
{
  tbl dec $defaultable  hint(tbl_col "default-initialized")
  tbl dec $equalable    hint(tbl_col "compared for equality")
  tbl dec $assignable   hint(tbl_col "assigned to")
}

;;; Default

tbl def $typeIR_is.defaultable =
  | BOOL => true
  | ERROR => true
  | STRING => true
  | integerTypeIR => true
  | TYPEDEF _ typeIR => $typeIR_is.defaultable(typeIR)
  | TYPE _ typeIR => $typeIR_is.defaultable(typeIR)
  | TUPLE `< typeIR* > => $forall_($typeIR_is.defaultable(typeIR)*)
  | typeIR `[ _ ] => $typeIR_is.defaultable(typeIR)
  | STRUCT _ `< _ > `{ (_ typeIR _ `;)* } => $forall_($typeIR_is.defaultable(typeIR)*)
  | HEADER _ `< _ > `{ (_ typeIR _ `;)* } => $forall_($typeIR_is.defaultable(typeIR)*)
  | HEADER_UNION _ `< _ > `{ (_ typeIR _ `;)* } => $forall_($typeIR_is.defaultable(typeIR)*)
  | ENUM _ `{ _ } => true
  | ENUM _ `< typeIR > `{ _ } => $typeIR_is.defaultable(typeIR)
  | _ => false

;;; Equals

tbl def $typeIR_is.equalable =
  | VOID => false
  | `` typeId => false
  | TYPEDEF _ typeIR => $typeIR_is.equalable(typeIR)
  | externObjectTypeIR => false
  | parserObjectTypeIR => false
  | controlObjectTypeIR => false
  | packageObjectTypeIR => false
  | tableObjectTypeIR => false
  | DEFAULT => false
  | SEQ `< _ `, `... > => false
  | RECORD `{ _ `, `... } => false
  | HEADER_INVALID => false
  | setTypeIR => false
  | tableMetadataTypeIR => false
  | _ => true

;;; Assignable

tbl def $typeIR_is.assignable =
  | VOID => false
  | STRING => false
  | INT => false
  | TYPEDEF _ typeIR => $typeIR_is.assignable(typeIR)
  | objectTypeIR => false
  | synthesizedTypeIR => false
  | _ => true
