;;
;; Base type of a type definition
;;

dec $type_of_typeDefIR(typeDefIR) : typeIR
  hint(prose_in "the underlying type of" %0)

;;; Name type definitions

def $type_of_typeDefIR(nameTypeDefIR) = nameTypeDefIR

;;; Alias type definitions

def $type_of_typeDefIR(aliasTypeDefIR) = aliasTypeDefIR

;;; Data type definitions

def $type_of_typeDefIR(
    STRUCT tid `< _ `, _ > `{ fieldTypeIR* }
  )
  = STRUCT tid `{ fieldTypeIR* }

def $type_of_typeDefIR(
    HEADER tid `< _ `, _ > `{ fieldTypeIR* }
  )
  = HEADER tid `{ fieldTypeIR* }

def $type_of_typeDefIR(
    HEADER_UNION tid `< _ `, _ > `{ fieldTypeIR* }
  )
  = HEADER_UNION tid `{ fieldTypeIR* }

def $type_of_typeDefIR(enumTypeDefIR) = enumTypeDefIR

;;; Object type definitions

def $type_of_typeDefIR(
    EXTERN tid `< _ `, _ > `{ (cid `: externMethodTypeDefIR)* }
  )
  = EXTERN tid `{ (cid `: externMethodTypeDefIR)* }

def $type_of_typeDefIR(PARSER tid `< _ `, _ > `( parameterTypeIR* ))
  = PARSER tid `( parameterTypeIR* )

def $type_of_typeDefIR(CONTROL tid `< _ `, _ > `( parameterTypeIR* ))
  = CONTROL tid `( parameterTypeIR* )

def $type_of_typeDefIR(PACKAGE tid `< _ `, _ > `{ typeIR* })
  = PACKAGE tid `{ typeIR* }

def $type_of_typeDefIR(tableObjectTypeDefIR) = tableObjectTypeDefIR

;;
;; Type parameters of a type definition
;;

dec $type_parameters_of_typeDefIR(typeDefIR) : (tid* , tid*)
  hint(prose_in "the type parameters of" %0)

;;; Name type definitions

def $type_parameters_of_typeDefIR(nameTypeDefIR) = (eps, eps)

;;; Alias type definitions

def $type_parameters_of_typeDefIR(aliasTypeDefIR) = (eps, eps)

;;; Data type definitions

def $type_parameters_of_typeDefIR(
    STRUCT _ `< tid_expl* `, tid_impl* > `{ _ }
  )
  = (tid_expl* , tid_impl*)

def $type_parameters_of_typeDefIR(
    HEADER _ `< tid_expl* `, tid_impl* > `{ _ }
  )
  = (tid_expl* , tid_impl*)

def $type_parameters_of_typeDefIR(
    HEADER_UNION _ `< tid_expl* `, tid_impl* > `{ _ }
  )
  = (tid_expl* , tid_impl*)

def $type_parameters_of_typeDefIR(enumTypeDefIR) = (eps, eps)

;;; Object type definitions

def $type_parameters_of_typeDefIR(
    EXTERN _ `< tid_expl* `, tid_impl* > `{ _ }
  )
  = (tid_expl* , tid_impl*)

def $type_parameters_of_typeDefIR(
    PARSER _ `< tid_expl* `, tid_impl* > `( _ )
  )
  = (tid_expl* , tid_impl*)

def $type_parameters_of_typeDefIR(
    CONTROL _ `< tid_expl* `, tid_impl* > `( _ )
  )
  = (tid_expl* , tid_impl*)

def $type_parameters_of_typeDefIR(
    PACKAGE _ `< tid_expl* `, tid_impl* > `{ _ }
  )
  = (tid_expl* , tid_impl*)

def $type_parameters_of_typeDefIR(tableObjectTypeDefIR) = (eps, eps)

;;
;; Monomorphic or polymorphic type definition
;;

dec $is_monomorphic_typeDefIR(typeDefIR) : bool
  hint(prose_in %0 "is monomorphic")
dec $is_polymorphic_typeDefIR(typeDefIR) : bool
  hint(prose_in %0 "is polymorphic")

def $is_monomorphic_typeDefIR(nameTypeDefIR) = true
def $is_monomorphic_typeDefIR(aliasTypeDefIR) = true
def $is_monomorphic_typeDefIR(enumTypeDefIR) = true
def $is_monomorphic_typeDefIR(tableObjectTypeDefIR) = true
def $is_monomorphic_typeDefIR(typeDefIR) = false
  -- otherwise

def $is_polymorphic_typeDefIR(typeDefIR)
  = ~$is_monomorphic_typeDefIR(typeDefIR)
