;;
;; Value
;;

;;
;;;; Base values
;;

syntax boolValue = B bool
syntax errorValue = ERROR `. id
syntax matchKindValue = MATCH_KIND `. id
syntax stringValue = stringLiteral

syntax integerValue =
  | integerLiteral
  | nat `. nat V int

syntax baseValue =
  | boolValue
  | errorValue
  | matchKindValue
  | stringValue
  | integerValue

;;
;;;; Data values
;;

syntax value

syntax listValue = LIST `[ value* ]
syntax tupleValue = TUPLE `( value* )
syntax headerStackValue = HEADER_STACK `[ value* `( nat; nat ) ]

syntax fieldValue = value id `;

syntax structValue = STRUCT tid `{ fieldValue* }
syntax headerValue = HEADER tid `{ bool `; fieldValue* }
syntax headerUnionValue = HEADER_UNION tid `{ fieldValue* }

syntax enumValue =
  | tid `. id
  | tid `. id `. value

syntax dataValue =
  | listValue
  | tupleValue
  | headerStackValue
  | structValue
  | headerValue
  | headerUnionValue
  | enumValue

;;
;;;; Object reference values
;;

syntax objectReferenceValue = `! oid

;;
;;;; Synthesized values
;;

syntax defaultValue = DEFAULT

syntax invalidHeaderValue = `{#}

syntax sequenceValue =
  | SEQ `( value* )
  | SEQ `( value* `, `... )

syntax recordValue =
  | RECORD `{ fieldValue* }
  | RECORD `{ fieldValue* `, `... }

syntax setValue =
  | SET `{ value }
  | SET `{ value `&&& value }
  | SET `{ value `.. value }
  | SET `{ `... }

syntax tableMetadataEnumValue = TABLE_ENUM tid `. id

syntax tableMetadataStructValue =
  TABLE_STRUCT tid `{ HIT boolValue `;
                      MISS boolValue `;
                      ACTION_RUN tableMetadataEnumValue `; }

syntax tableMetadataValue =
  | tableMetadataEnumValue
  | tableMetadataStructValue

syntax synthesizedValue =
  | defaultValue
  | invalidHeaderValue
  | sequenceValue
  | recordValue
  | setValue
  | tableMetadataValue

;;
;;;; Values
;;

syntax value =
  | baseValue
  | dataValue
  | objectReferenceValue
  | synthesizedValue
