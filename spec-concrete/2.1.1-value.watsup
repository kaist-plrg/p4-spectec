;;
;; Value
;;

;;
;;;; Base values
;;

;;
;;;; Primitive values
;;

syntax primitiveValue =
  | B bool
  | ERROR `. id
  | MATCH_KIND `. id
  | stringLiteral

;;
;;;; Numeric values
;;

syntax numberValue =
  | numberLiteral
  | nat `. nat V int

syntax baseValue = primitiveValue | numberValue

;;
;;;; Data values
;;

syntax value

syntax listValue = LIST `[ value* ]
syntax tupleValue = TUPLE `( value* )
syntax headerStackValue = HEADER_STACK `[ value* `( nat; nat ) ]

syntax fieldValue = value id `;

syntax structValue = STRUCT tid `{ fieldValue* }
syntax headerValue = HEADER tid `{ bool `; fieldValue* }
syntax headerUnionValue = HEADER_UNION tid `{ fieldValue* }

syntax enumValue =
  | tid `. id
  | tid `. id `( value )

syntax dataValue =
  | listValue
  | tupleValue
  | headerStackValue
  | structValue
  | headerValue
  | headerUnionValue
  | enumValue

;;
;;;; Object reference values
;;

syntax objectReferenceValue = `! oid

;;
;;;; Synthesized values
;;

syntax defaultValue = DEFAULT

syntax invalidHeaderValue = `{#}

syntax sequenceValue =
  | SEQ `( value* )
  | SEQ `( value* `, `... )

syntax recordValue =
  | RECORD `{ fieldValue* }
  | RECORD `{ fieldValue* `, `... }

syntax setValue =
  | SET `{ value }
  | SET `{ value `&&& value }
  | SET `{ value `.. value }

syntax tableMetadataValue =
  | TABLE_ENUM tid `. id
  | TABLE_STRUCT tid `{ fieldValue* }

syntax synthesizedValue =
  | defaultValue
  | invalidHeaderValue
  | sequenceValue
  | recordValue
  | setValue
  | tableMetadataValue

;;
;;;; Values
;;

syntax value =
  | baseValue
  | dataValue
  | objectReferenceValue
  | synthesizedValue
