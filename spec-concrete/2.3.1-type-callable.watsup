;;
;; Callable types
;;

;;
;;;; Parameter types
;;

syntax constantInitializerIR = `= value
syntax constantInitializerOptIR = constantInitializerIR?

syntax parameterIR =
  annotationList direction typeIR nameIR constantInitializerOptIR
  hint(prose_fields ["annotations", "direction", "type", "name", "default initializer"])

;;
;;;; Action types
;;

syntax actionTypeIR = ACTION `( parameterIR* )

;;
;;;; Function types
;;

syntax definedFunctionTypeIR = FUNCTION `( parameterIR* ) `: typeIR

syntax externFunctionTypeIR = EXTERN_FUNCTION `( parameterIR* ) `: typeIR

syntax functionTypeIR =
  | definedFunctionTypeIR
  | externFunctionTypeIR

;;
;;;; Method types
;;

syntax builtinMethodTypeIR = BUILTIN_METHOD `( parameterIR* ) `: typeIR

syntax externMethodTypeIR =
  | EXTERN_METHOD `( parameterIR* ) `: typeIR
  | EXTERN_METHOD ABSTRACT `( parameterIR* ) `: typeIR

syntax parserApplyMethodTypeIR = PARSER_APPLY `( parameterIR* )

syntax controlApplyMethodTypeIR = CONTROL_APPLY `( parameterIR* )

syntax tableApplyMethodTypeIR = TABLE_APPLY `: tableMetadataStructTypeIR

syntax methodTypeIR =
  | builtinMethodTypeIR
  | externMethodTypeIR
  | parserApplyMethodTypeIR
  | controlApplyMethodTypeIR
  | tableApplyMethodTypeIR

;;
;;;; Callable types
;;

syntax callableTypeIR =
  | actionTypeIR
  | functionTypeIR
  | methodTypeIR
