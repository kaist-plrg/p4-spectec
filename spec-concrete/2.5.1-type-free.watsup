;;
;; Free type variables
;;

syntax bound = set<tid>

dec $free_typeIR(typeIR) : bound
dec $free_typeDefIR(typeDefIR) : bound

dec $free_parameterTypeIR(parameterTypeIR) : bound

dec $free_callableTypeIR(callableTypeIR) : bound
dec $free_callableTypeDefIR(callableTypeDefIR) : bound

;;
;; Free type variables in types
;;

;;; Base types

def $free_typeIR(baseTypeIR) = `{ eps }

;;; Named types

def $free_typeIR(`` tid) = `{ tid }

def $free_typeIR(typeDefIR `< typeIR* >)
  = $union_set<tid>(bound_base, bound_args)
  -- if bound_base = $free_typeDefIR(typeDefIR)
  -- if bound_args = $unions_set<tid>($free_typeIR(typeIR)*)

;;; Typedef types

def $free_typeIR(TYPEDEF _ typeIR) = $free_typeIR(typeIR)

def $free_typeIR(TYPE _ typeIR) = $free_typeIR(typeIR)

;;; Data types

def $free_typeIR(LIST `< typeIR >) = $free_typeIR(typeIR)

def $free_typeIR(TUPLE `< typeIR* >)
  = $unions_set<tid>($free_typeIR(typeIR)*)

def $free_typeIR(typeIR `[ _ ]) = $free_typeIR(typeIR)

def $free_typeIR(STRUCT _ `{ (typeIR _ `;)* })
  = $unions_set<tid>($free_typeIR(typeIR)*)

def $free_typeIR(HEADER _ `{ (typeIR _ `;)* })
  = $unions_set<tid>($free_typeIR(typeIR)*)

def $free_typeIR(HEADER_UNION _ `{ (typeIR _ `;)* })
  = $unions_set<tid>($free_typeIR(typeIR)*)

def $free_typeIR(ENUM _ `{ _ }) = `{ eps }

def $free_typeIR(ENUM _ `< typeIR > `{ _ }) = $free_typeIR(typeIR)

;;; Object types

def $free_typeIR(EXTERN _ `{ (_ `: externMethodTypeDefIR)* })
  = $unions_set<tid>($free_callableTypeDefIR(externMethodTypeDefIR)*)

def $free_typeIR(PARSER _ `( parameterTypeIR* ))
  = bound_params
  -- if bound_params
      = $unions_set<tid>($free_parameterTypeIR(parameterTypeIR)*)

def $free_typeIR(CONTROL _ `( parameterTypeIR* ))
  = bound_params
  -- if bound_params
      = $unions_set<tid>($free_parameterTypeIR(parameterTypeIR)*)

def $free_typeIR(PACKAGE _ `{ typeIR* })
  = $unions_set<tid>($free_typeIR(typeIR)*)

def $free_typeIR(TABLE _ `{ _ }) = `{ eps }

;;; Synthesized types

def $free_typeIR(DEFAULT) = `{ eps }

def $free_typeIR(HEADER_INVALID) = `{ eps }

def $free_typeIR(SEQ `< typeIR* >)
  = $unions_set<tid>($free_typeIR(typeIR)*)

def $free_typeIR(SEQ `< typeIR* `, `... >)
  = $unions_set<tid>($free_typeIR(typeIR)*)

def $free_typeIR(RECORD `{ (typeIR _ `;)* })
  = $unions_set<tid>($free_typeIR(typeIR)*)

def $free_typeIR(RECORD `{ (typeIR _ `;)* `, `... })
  = $unions_set<tid>($free_typeIR(typeIR)*)

def $free_typeIR(SET `< typeIR* >)
  = $unions_set<tid>($free_typeIR(typeIR)*)

def $free_typeIR(tableMetadataTypeIR) = `{ eps }

;;
;;;; Free type variables in type definitions
;;

def $free_typeDefIR(typeDefIR)
  = $diff_set<tid>(bound_base, bound_tparams)
  -- if (tid_tparam_expl*, tid_tparam_impl*)
      = $type_parameters_of_typeDefIR(typeDefIR)
  -- if bound_tparams = `{ tid_tparam_expl* ++ tid_tparam_impl* }
  -- if typeIR = $type_of_typeDefIR(typeDefIR)
  -- if bound_base = $free_typeIR(typeIR)

;;
;;;; Free type varaibles in parameter types
;;

def $free_parameterTypeIR(_ typeIR _ _) = $free_typeIR(typeIR)

;;
;;;; Free type variables in callable types
;;

;;; Action types

def $free_callableTypeIR(ACTION `( parameterTypeIR* ))
  = bound_params
  -- if bound_params
      = $unions_set<tid>($free_parameterTypeIR(parameterTypeIR)*)

;;; Function types

def $free_callableTypeIR(
    FUNCTION `( parameterTypeIR* ) `: typeIR
  )
  = $union_set<tid>(bound_params, bound_ret)
  -- if bound_params
      = $unions_set<tid>($free_parameterTypeIR(parameterTypeIR)*)
  -- if bound_ret = $free_typeIR(typeIR)

def $free_callableTypeIR(
    EXTERN_FUNCTION `( parameterTypeIR* ) `: typeIR
  )
  = $union_set<tid>(bound_params, bound_ret)
  -- if bound_params
      = $unions_set<tid>($free_parameterTypeIR(parameterTypeIR)*)
  -- if bound_ret = $free_typeIR(typeIR)

;;; Method types

def $free_callableTypeIR(
    BUILTIN_METHOD `( parameterTypeIR* ) `: typeIR
  )
  = $union_set<tid>(bound_params, bound_ret)
  -- if bound_params
      = $unions_set<tid>($free_parameterTypeIR(parameterTypeIR)*)
  -- if bound_ret = $free_typeIR(typeIR)

def $free_callableTypeIR(
    EXTERN_METHOD `( parameterTypeIR* ) `: typeIR
  )
  = $union_set<tid>(bound_params, bound_ret)
  -- if bound_params
      = $unions_set<tid>($free_parameterTypeIR(parameterTypeIR)*)
  -- if bound_ret = $free_typeIR(typeIR)

def $free_callableTypeIR(
    EXTERN_METHOD ABSTRACT `( parameterTypeIR* ) `: typeIR
  )
  = $union_set<tid>(bound_params, bound_ret)
  -- if bound_params
      = $unions_set<tid>($free_parameterTypeIR(parameterTypeIR)*)
  -- if bound_ret = $free_typeIR(typeIR)

def $free_callableTypeIR(PARSER_APPLY `( parameterTypeIR* ))
  = bound_params
  -- if bound_params
      = $unions_set<tid>($free_parameterTypeIR(parameterTypeIR)*)

def $free_callableTypeIR(CONTROL_APPLY `( parameterTypeIR* ))
  = bound_params
  -- if bound_params
      = $unions_set<tid>($free_parameterTypeIR(parameterTypeIR)*)

def $free_callableTypeIR(TABLE_APPLY `: _) = `{ eps }

;;
;;;; Free type variables in callable type definitions
;;

def $free_callableTypeDefIR(callableTypeDefIR)
  = $diff_set<tid>(bound_base, bound_tparams)
  -- if (tid_tparam_expl*, tid_tparam_impl*)
      = $type_parameters_of_callableTypeDefIR(callableTypeDefIR)
  -- if bound_tparams = `{ tid_tparam_expl* ++ tid_tparam_impl* }
  -- if callableTypeIR
      = $type_of_callableTypeDefIR(callableTypeDefIR)
  -- if bound_base = $free_callableTypeIR(callableTypeIR)
