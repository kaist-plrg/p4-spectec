;;
;; Expression evaluation
;;
;; syntax typedExpressionIR =
;;   expressionIR `# `( typeIR ctk )
;;

;;; syntax expressionIR

;;;; literalExpressionIR
;;;; syntax literalExpression

;;;;; TRUE | FALSE

rulegroup Expr_eval/literalExpressionIR-boolean {

  rule Expr_eval/true:
    p EC STO |- TRUE `# _ : STO (B true)

  rule Expr_eval/false:
    p EC STO |- FALSE `# _ : STO (B false)

}

;;;;; number

rulegroup Expr_eval/literalExpressionIR-number {

  rule Expr_eval/arbint:
    p EC STO |- (D i) `# _ : STO (D i)

  rule Expr_eval/fixbit:
    p EC STO |- (n W i) `# _ : STO (n W i)

  rule Expr_eval/fixint:
    p EC STO |- (n S i) `# _ : STO (n S i)

}

;;;;; stringLiteral

rule Expr_eval/literalExpressionIR-stringLiteral:
  p EC STO |- (`" text `") `# _ : STO (`" text `")

;;;; referenceExpressionIR
;;;; syntax referenceExpressionIR = prefixedNameIR

rule Expr_eval/referenceExpressionIR:
  p EC STO |- prefixedNameIR `# _ : STO value
  -- if value = $find_value_eval(p, EC, prefixedNameIR)

;;;; defaultExpressionIR

rule Expr_eval/defaultExpressionIR:
  p EC STO |- `... `# _ : STO DEFAULT

;;;; unaryExpressionIR
;;;; syntax unaryExpressionIR = unop typedExpressionIR

rule Expr_eval/unaryExpressionIR:
  p EC STO_0 |- (unop typedExpressionIR) `# _ : STO_1 $un_op(unop, value)
  -- Expr_eval: p EC STO_0 |- typedExpressionIR : STO_1 value

;;;; binaryExpressionIR
;;;; syntax binaryExpressionIR =
;;;;   typedExpressionIR binop typedExpressionIR

rulegroup Expr_eval/binaryExpressionIR {

  rule Expr_eval/non-short-circuit:
    p EC STO_0 |- (typedExpressionIR_l binop typedExpressionIR_r) `# `( _ _ )
                : STO_2 $bin_op(binop, value_l, value_r)
    -- if ~(binop <- [ `&&, `|| ])
    -- Expr_eval: p EC STO_0 |- typedExpressionIR_l : STO_1 value_l
    -- Expr_eval: p EC STO_1 |- typedExpressionIR_r : STO_2 value_r

  rule Expr_eval/land-false:
    p EC STO_0 |- (typedExpressionIR_l `&& typedExpressionIR_r) `# `( _ _ )
                : STO_1 (B false)
    -- Expr_eval: p EC STO_0 |- typedExpressionIR_l : STO_1 (B false)

  rule Expr_eval/land-true:
    p EC STO_0 |- (typedExpressionIR_l `&& typedExpressionIR_r) `# `( _ _ )
                : STO_2 value_r
    -- Expr_eval: p EC STO_0 |- typedExpressionIR_l : STO_1 (B true)
    -- Expr_eval: p EC STO_1 |- typedExpressionIR_r : STO_2 value_r

  rule Expr_eval/lor-true:
    p EC STO_0 |- (typedExpressionIR_l `|| typedExpressionIR_r) `# `( _ _ )
                : STO_1 (B true)
    -- Expr_eval: p EC STO_0 |- typedExpressionIR_l : STO_1 (B true)

  rule Expr_eval/lor-false:
    p EC STO_0 |- (typedExpressionIR_l `|| typedExpressionIR_r) `# `( _ _ )
                : STO_2 value_r
    -- Expr_eval: p EC STO_0 |- typedExpressionIR_l : STO_1 (B false)
    -- Expr_eval: p EC STO_1 |- typedExpressionIR_r : STO_2 value_r

}

;;;; ternaryExpressionIR
;;;; syntax ternaryExpressionIR =
;;;;   typedExpressionIR `? typedExpressionIR `: typedExpressionIR

rulegroup Expr_eval/ternaryExpressionIR {

  rule Expr_eval/true:
    p EC STO_0 |- (typedExpressionIR_cond `? typedExpressionIR_true `: typedExpressionIR_false) `# _
                : STO_2 value_true
    -- Expr_eval: p EC STO_0 |- typedExpressionIR_cond : STO_1 (B true)
    -- Expr_eval: p EC STO_1 |- typedExpressionIR_true : STO_2 value_true

  rule Expr_eval/false:
    p EC STO_0 |- (typedExpressionIR_cond `? typedExpressionIR_true `: typedExpressionIR_false) `# _
                : STO_2 value_false
    -- Expr_eval: p EC STO_0 |- typedExpressionIR_cond : STO_1 (B false)
    -- Expr_eval: p EC STO_1 |- typedExpressionIR_false : STO_2 value_false

}

;;;; castExpressionIR
;;;; syntax castExpressionIR = `( typeIR ) typedExpressionIR

rule Expr_eval/castExpressionIR:
  p EC STO_0 |- (`( typeIR ) typedExpressionIR) `# _ : STO_1 value_cast
  -- Expr_eval: p EC STO_0 |- typedExpressionIR : STO_1 value
  -- if value_cast = $cast_op(typeIR, value)
