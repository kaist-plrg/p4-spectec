;;;; parenthesizedExpressionIR
;;;; syntax parenthesizedExpressionIR = `( typedExpressionIR )

rule Expr_eval/parenthesizedExpressionIR:
  p EC STO_0 |- (`( typedExpressionIR )) `# _ : STO_1 value
  -- Expr_eval: p EC STO_0 |- typedExpressionIR : STO_1 value

;;
;; Expression list instantiation
;;
;; syntax typedExpressionListIR
;;

rule Exprs_eval/nil:
  p EC STO |- eps : STO (`{ eps })

rule Exprs_eval/cons-head-exit:
  p EC STO_0 |- typedExpressionIR_h :: typedExpressionIR_t*
              : STO_1 EXIT
  -- Expr_eval:
      p EC STO_0 |- typedExpressionIR_h : STO_1 EXIT

rule Exprs_eval/cons-head-cont:
  p EC STO_0 |- typedExpressionIR_h :: typedExpressionIR_t*
              : STO_2 (`{ value_h :: value_t* })
  -- Expr_eval:
      p EC STO_0 |- typedExpressionIR_h : STO_1 value_h
  -- Exprs_eval:
      p EC STO_1 |- typedExpressionIR_t* : STO_2 (`{ value_t* })

rule Exprs_eval/cons-tail-exit:
  p EC STO_0 |- typedExpressionIR_h :: typedExpressionIR_t*
              : STO_2 EXIT
  -- Expr_eval:
      p EC STO_0 |- typedExpressionIR_h : STO_1 value_h
  -- Exprs_eval:
      p EC STO_1 |- typedExpressionIR_t* : STO_2 EXIT
