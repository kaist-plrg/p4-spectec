;;
;; Expression evaluation
;;
;; syntax typedExpressionIR =
;;   expressionIR `# `( typeIR ctk )
;;

;;; syntax expressionIR

;;;; literalExpressionIR
;;;; syntax literalExpression

;;;;; TRUE | FALSE

rulegroup Expr_eval/literalExpressionIR-boolean {

  rule Expr_eval/true:
    p EC STO |- TRUE `# _ : EC STO expressionResult
    -- if expressionResult = CONT (B true)

  rule Expr_eval/false:
    p EC STO |- FALSE `# _ : EC STO expressionResult
    -- if expressionResult = CONT (B false)

}

;;;;; number

rulegroup Expr_eval/literalExpressionIR-number {

  rule Expr_eval/arbint:
    p EC STO |- (D i) `# _ : EC STO expressionResult
    -- if expressionResult = CONT (D i)

  rule Expr_eval/fixbit:
    p EC STO |- (n W i) `# _ : EC STO expressionResult
    -- if expressionResult = CONT (n W i)

  rule Expr_eval/fixint:
    p EC STO |- (n S i) `# _ : EC STO expressionResult
    -- if expressionResult = CONT (n S i)

}

;;;;; stringLiteral

rule Expr_eval/literalExpressionIR-stringLiteral:
  p EC STO |- (`" text `") `# _ : EC STO expressionResult
  -- if expressionResult = CONT (`" text `")

;;;; referenceExpressionIR
;;;; syntax referenceExpressionIR = prefixedNameIR

rule Expr_eval/referenceExpressionIR:
  p EC STO |- prefixedNameIR `# _ : EC STO (CONT value)
  -- if value = $find_value_eval(p, EC, prefixedNameIR)

;;;; defaultExpressionIR

rule Expr_eval/defaultExpressionIR:
  p EC STO |- `... `# _ : EC STO (CONT DEFAULT)

;;;; unaryExpressionIR
;;;; syntax unaryExpressionIR = unop typedExpressionIR

rulegroup Expr_eval/unaryExpressionIR {

  rule Expr_eval/exit:
    p EC_0 STO_0 |- (unop typedExpressionIR) `# _ : EC_1 STO_1 EXIT
    -- Expr_eval: p EC_0 STO_0 |- typedExpressionIR : EC_1 STO_1 EXIT

  rule Expr_eval/cont:
    p EC_0 STO_0 |- (unop typedExpressionIR) `# _ : EC_1 STO_1 expressionResult
    -- Expr_eval: p EC_0 STO_0 |- typedExpressionIR : EC_1 STO_1 (CONT value)
    -- if expressionResult = CONT $un_op(unop, value)

}

;;;; binaryExpressionIR
;;;; syntax binaryExpressionIR =
;;;;   typedExpressionIR binop typedExpressionIR

rulegroup Expr_eval/binaryExpressionIR {

  rule Expr_eval/non-short-circuit-exit:
    p EC_0 STO_0 |- (typedExpressionIR_l binop typedExpressionIR_r) `# `( _ _ )
                  : EC_1 STO_1 EXIT
    -- if ~(binop <- [ `&&, `|| ])
    -- Exprs_eval:
        p EC_0 STO_0 |- [ typedExpressionIR_l, typedExpressionIR_r ]
                      : EC_1 STO_1 EXIT

  rule Expr_eval/non-short-circuit-cont:
    p EC_0 STO_0 |- (typedExpressionIR_l binop typedExpressionIR_r) `# `( _ _ )
                  : EC_1 STO_1 expressionResult
    -- if ~(binop <- [ `&&, `|| ])
    -- Exprs_eval:
        p EC_0 STO_0 |- [ typedExpressionIR_l, typedExpressionIR_r ]
                      : EC_1 STO_1 (CONT ([ value_l, value_r]))
    -- if value = $bin_op(binop, value_l, value_r)
    -- if expressionResult = CONT value

  rule Expr_eval/land-exit:
    p EC_0 STO_0 |- (typedExpressionIR_l `&& typedExpressionIR_r) `# `( _ _ )
                  : EC_1 STO_1 EXIT
    -- Expr_eval: p EC_0 STO_0 |- typedExpressionIR_l : EC_1 STO_1 EXIT

  rule Expr_eval/land-false:
    p EC_0 STO_0 |- (typedExpressionIR_l `&& typedExpressionIR_r) `# `( _ _ )
                  : EC_1 STO_1 expressionResult
    -- Expr_eval: p EC_0 STO_0 |- typedExpressionIR_l : EC_1 STO_1 (CONT (B false))
    -- if expressionResult = CONT (B false)

  rule Expr_eval/land-true-exit:
    p EC_0 STO_0 |- (typedExpressionIR_l `&& typedExpressionIR_r) `# `( _ _ )
                  : EC_2 STO_2 EXIT
    -- Expr_eval: p EC_0 STO_0 |- typedExpressionIR_l : EC_1 STO_1 (CONT (B true))
    -- Expr_eval: p EC_1 STO_1 |- typedExpressionIR_r : EC_2 STO_2 EXIT

  rule Expr_eval/land-true:
    p EC_0 STO_0 |- (typedExpressionIR_l `&& typedExpressionIR_r) `# `( _ _ )
                  : EC_2 STO_2 expressionResult_r
    -- Expr_eval: p EC_0 STO_0 |- typedExpressionIR_l : EC_1 STO_1 (CONT (B true))
    -- Expr_eval: p EC_1 STO_1 |- typedExpressionIR_r : EC_2 STO_2 expressionResult_r

  rule Expr_eval/lor-exit:
    p EC_0 STO_0 |- (typedExpressionIR_l `|| typedExpressionIR_r) `# `( _ _ )
                  : EC_1 STO_1 EXIT
    -- Expr_eval: p EC_0 STO_0 |- typedExpressionIR_l : EC_1 STO_1 EXIT

  rule Expr_eval/lor-true:
    p EC_0 STO_0 |- (typedExpressionIR_l `|| typedExpressionIR_r) `# `( _ _ )
                  : EC_1 STO_1 expressionResult
    -- Expr_eval: p EC_0 STO_0 |- typedExpressionIR_l : EC_1 STO_1 (CONT (B true))
    -- if expressionResult = CONT (B true)

  rule Expr_eval/lor-false-exit:
    p EC_0 STO_0 |- (typedExpressionIR_l `|| typedExpressionIR_r) `# `( _ _ )
                  : EC_2 STO_2 EXIT
    -- Expr_eval: p EC_0 STO_0 |- typedExpressionIR_l : EC_1 STO_1 (CONT (B false))
    -- Expr_eval: p EC_1 STO_1 |- typedExpressionIR_r : EC_2 STO_2 EXIT

  rule Expr_eval/lor-false:
    p EC_0 STO_0 |- (typedExpressionIR_l `|| typedExpressionIR_r) `# `( _ _ )
                  : EC_2 STO_2 expressionResult_r
    -- Expr_eval: p EC_0 STO_0 |- typedExpressionIR_l : EC_1 STO_1 (CONT (B false))
    -- Expr_eval: p EC_1 STO_1 |- typedExpressionIR_r : EC_2 STO_2 expressionResult_r

}

;;;; ternaryExpressionIR
;;;; syntax ternaryExpressionIR =
;;;;   typedExpressionIR `? typedExpressionIR `: typedExpressionIR

rulegroup Expr_eval/ternaryExpressionIR {

  rule Expr_eval/cond-exit:
    p EC_0 STO_0 |- (typedExpressionIR_cond `? typedExpressionIR_true
                                            `: typedExpressionIR_false) `# _
                  : EC_1 STO_1 EXIT
    -- Expr_eval: p EC_0 STO_0 |- typedExpressionIR_cond : EC_1 STO_1 EXIT

  rule Expr_eval/cond-true:
    p EC_0 STO_0 |- (typedExpressionIR_cond `? typedExpressionIR_true
                                            `: typedExpressionIR_false) `# _
                  : EC_2 STO_2 expressionResult_true
    -- Expr_eval: p EC_0 STO_0 |- typedExpressionIR_cond : EC_1 STO_1 (CONT (B true))
    -- Expr_eval: p EC_1 STO_1 |- typedExpressionIR_true : EC_2 STO_2 expressionResult_true

  rule Expr_eval/cond-false:
    p EC_0 STO_0 |- (typedExpressionIR_cond `? typedExpressionIR_true
                                            `: typedExpressionIR_false) `# _
                  : EC_2 STO_2 expressionResult_false
    -- Expr_eval: p EC_0 STO_0 |- typedExpressionIR_cond : EC_1 STO_1 (CONT (B false))
    -- Expr_eval: p EC_1 STO_1 |- typedExpressionIR_false : EC_2 STO_2 expressionResult_false

}

;;;; castExpressionIR
;;;; syntax castExpressionIR = `( typeIR ) typedExpressionIR

rulegroup Expr_eval/castExpressionIR {

  rule Expr_eval/exit:
    p EC_0 STO_0 |- (`( typeIR ) typedExpressionIR) `# _
                  : EC_1 STO_1 EXIT
    -- Expr_eval: p EC_0 STO_0 |- typedExpressionIR : EC_1 STO_1 EXIT

  rule Expr_eval/cont:
    p EC_0 STO_0 |- (`( typeIR ) typedExpressionIR) `# _
                  : EC_1 STO_1 expressionResult
    -- Expr_eval: p EC_0 STO_0 |- typedExpressionIR : EC_1 STO_1 (CONT value)
    -- if value_cast = $cast_op(typeIR, value)
    -- if expressionResult = CONT value_cast

}

;;;; dataExpressionIR
;;;; syntax dataExpressionIR

;;;;; `{#}

rule Expr_eval/dataExpressionIR-invalid:
  p EC STO |- `{#} `# _ : EC STO expressionResult
  -- if expressionResult = CONT `{#}

;;;;; SEQ `{ typedExpressionListIR }
;;;;; SEQ `{ typedExpressionListIR `, `... }

rulegroup Expr_eval/dataExpressionIR-sequence {

  rule Expr_eval/non-default-exit:
    p EC_0 STO_0 |- (SEQ `{ typedExpressionListIR }) `# _
                  : EC_1 STO_1 EXIT
    -- Exprs_eval:
        p EC_0 STO_0 |- typedExpressionListIR : EC_1 STO_1 EXIT

  rule Expr_eval/non-default-cont:
    p EC_0 STO_0 |- (SEQ `{ typedExpressionListIR }) `# _
                  : EC_1 STO_1 expressionResult
    -- Exprs_eval:
        p EC_0 STO_0 |- typedExpressionListIR : EC_1 STO_1 (CONT value*)
    -- if expressionResult = CONT (SEQ `( value* ))

  rule Expr_eval/default-exit:
    p EC_0 STO_0 |- (SEQ `{ typedExpressionListIR `, `... }) `# _
                  : EC_1 STO_1 EXIT
    -- Exprs_eval:
        p EC_0 STO_0 |- typedExpressionListIR : EC_1 STO_1 EXIT

  rule Expr_eval/default-cont:
    p EC_0 STO_0 |- (SEQ `{ typedExpressionListIR `, `... }) `# _
                  : EC_1 STO_1 expressionResult
    -- Exprs_eval:
        p EC_0 STO_0 |- typedExpressionListIR : EC_1 STO_1 (CONT value*)
    -- if expressionResult = CONT (SEQ `( value* `, `... ))

}

;;;;; RECORD `{ namedExpressionListIR }
;;;;; RECORD `{ namedExpressionListIR `, `... }

rulegroup Expr_eval/dataExpressionIR-record {

   rule Expr_eval/non-default-exit:
    p EC_0 STO_0 |- (RECORD `{ (nameIR `= typedExpressionIR)* }) `# _
                  : EC_1 STO_1 EXIT
    -- Exprs_eval:
        p EC_0 STO_0 |- typedExpressionIR* : EC_1 STO_1 EXIT

  rule Expr_eval/non-default-cont:
    p EC_0 STO_0 |- (RECORD `{ (nameIR `= typedExpressionIR)* }) `# _
                  : EC_1 STO_1 expressionResult
    -- Exprs_eval:
        p EC_0 STO_0 |- typedExpressionIR* : EC_1 STO_1 (CONT value*)
    -- if expressionResult = CONT (RECORD `{ (value nameIR `;)* })

  rule Expr_eval/default-exit:
    p EC_0 STO_0 |- (RECORD `{ (nameIR `= typedExpressionIR)* `, `... }) `# _
                  : EC_1 STO_1 EXIT
    -- Exprs_eval:
        p EC_0 STO_0 |- typedExpressionIR* : EC_1 STO_1 EXIT

  rule Expr_eval/default-cont:
    p EC_0 STO_0 |- (RECORD `{ (nameIR `= typedExpressionIR)* `, `... }) `# _
                  : EC_1 STO_1 expressionResult
    -- Exprs_eval:
        p EC_0 STO_0 |- typedExpressionIR* : EC_1 STO_1 (CONT value*)
    -- if expressionResult = CONT (RECORD `{ (value nameIR `;)* `, `... })

}

;;;; accessExpressionIR
;;;; syntax accessExpressionIR

;;;;; errorAccessExpressionIR
;;;;; syntax errorAccessExpressionIR = ERROR `. nameIR

rule Expr_eval/errorAccessExpressionIR:
  p EC STO |- (ERROR `. nameIR) `# _ : EC STO expressionResult
  -- if nameIR_error = "error." ++ nameIR
  -- if value_error = $find_value_eval(p, EC, `` nameIR_error)
  -- if expressionResult = CONT value_error

;;;;; memberAccessExpressionIR
;;;;; syntax memberAccessExpressionIR = memberAccessBaseIR `. nameIR
;;;;;; syntax memberAccessBaseIR

;;;;;;; TYPE prefixedNameIR

rulegroup Expr_eval/memberAccessExpressionIR-type {

  rule Expr_eval/enum:
    p EC STO |- ((TYPE prefixedNameIR) `. nameIR) `# _
              : EC STO expressionResult
    -- if ENUM tid `{ _ } = $find_type_eval(p, EC, prefixedNameIR)
    -- if expressionResult = CONT (tid `. nameIR)

  rule Expr_eval/serenum:
    p EC STO |- ((TYPE prefixedNameIR) `. nameIR) `# _
              : EC STO expressionResult
    -- if ENUM tid `# _ `{ (id_member `= value_member `;)* }
        = $find_type_eval(p, EC, prefixedNameIR)
    -- if value = $assoc_<nameIR, value>(nameIR, (id_member, value_member)*)
    -- if expressionResult = CONT (tid `. nameIR `# value)

}

;;;;;;; typedExpressionIR

rulegroup Expr_eval/memberAccessExpressionIR-expression {

  rule Expr_eval/exit:
    p EC_0 STO_0 |- (typedExpressionIR_base `. nameIR) `# `( typeIR_base _ )
                  : EC_1 STO_1 EXIT
    -- Expr_eval: p EC_0 STO_0 |- typedExpressionIR_base : EC_1 STO_1 EXIT

  rule Expr_eval/stack-size:
    p EC_0 STO_0 |- (typedExpressionIR_base `. "size") `# `( typeIR_base _ )
                  : EC_1 STO_1 expressionResult
    -- Expr_eval: p EC_0 STO_0 |- typedExpressionIR_base : EC_1 STO_1 (CONT value_base) 
    -- if `[ _ `# `( _; n_size ) ] = value_base
    -- if expressionResult = CONT (D n_size)

  rule Expr_eval/struct:
    p EC_0 STO_0 |- (typedExpressionIR_base `. nameIR) `# `( typeIR_base _ )
                  : EC_1 STO_1 expressionResult
    -- Expr_eval: p EC_0 STO_0 |- typedExpressionIR_base : EC_1 STO_1 (CONT value_base)
    -- if STRUCT _ `{ (value_field id_field `;)* } = value_base
    -- if value_member
        = $assoc_<nameIR, value>(nameIR, (id_field, value_field)*)
    -- if expressionResult = CONT value_member

  rule Expr_eval/header:
    p EC_0 STO_0 |- (typedExpressionIR_base `. nameIR) `# `( typeIR_base _ )
                  : EC_1 STO_1 expressionResult
    -- Expr_eval: p EC_0 STO_0 |- typedExpressionIR_base : EC_1 STO_1 (CONT value_base)
    -- if HEADER _ `{ (value_field id_field `;)* } = value_base
    -- if value_member
        = $assoc_<nameIR, value>(nameIR, (id_field, value_field)*)
    -- if expressionResult = CONT value_member

  rule Expr_eval/headerunion:
    p EC_0 STO_0 |- (typedExpressionIR_base `. nameIR) `# `( typeIR_base _ )
                  : EC_1 STO_1 expressionResult
    -- Expr_eval: p EC_0 STO_0 |- typedExpressionIR_base : EC_1 STO_1 (CONT value_base)
    -- if HEADER_UNION _ `{ (value_field id_field `;)* } = value_base
    -- if value_member
        = $assoc_<nameIR, value>(nameIR, (id_field, value_field)*)
    -- if expressionResult = CONT value_member

}

;;;;; indexAccessExpressionIR
;;;;; syntax indexAccessExpressionIR =
;;;;; typedExpressionIR `[ typedExpressionIR ]
;;;;; (TODO) handle header stack accesses

rulegroup Expr_eval/indexAccessExpressionIR {
  
  rule Expr_eval/exit:
    p EC_0 STO_0 |- (typedExpressionIR_base `[ typedExpressionIR_index ]) `# _
                  : EC_1 STO_1 EXIT
    -- Exprs_eval:
        p EC_0 STO_0 |- [ typedExpressionIR_base, typedExpressionIR_index ]
                      : EC_1 STO_1 EXIT

  rule Expr_eval/tuple-exit:
    p EC_0 STO_0 |- (typedExpressionIR_base `[ typedExpressionIR_index ]) `# _
                  : EC_1 STO_1 expressionResult
    -- Exprs_eval:
        p EC_0 STO_0 |- [ typedExpressionIR_base, typedExpressionIR_index ]
                      : EC_1 STO_1 (CONT ([ value_base, value_index ]))
    -- if `( value_elem* ) = value_base
    -- if n_index = $to_number(value_index)
    -- if value = value_elem*[n_index]
    -- if expressionResult = CONT value

}

;;;;; sliceAccessExpressionIR
;;;;; syntax sliceAccessExpressionIR =
;;;;;  typedExpressionIR `[ typedExpressionIR `: typedExpressionIR ]

rulegroup Expr_eval/sliceAccessExpressionIR {

  rule Expr_eval/exit:
    p EC_0 STO_0 |- (typedExpressionIR_base `[ typedExpressionIR_hi
                                            `: typedExpressionIR_lo ]) `# _
                  : EC_1 STO_1 EXIT
    -- Exprs_eval:
        p EC_0 STO_0 |- [ typedExpressionIR_base, typedExpressionIR_hi, typedExpressionIR_lo ]
                      : EC_1 STO_1 EXIT

  rule Expr_eval/cont:
    p EC_0 STO_0 |- (typedExpressionIR_base `[ typedExpressionIR_hi
                                            `: typedExpressionIR_lo ]) `# _
                  : EC_1 STO_1 expressionResult
    -- Exprs_eval:
        p EC_0 STO_0 |- [ typedExpressionIR_base, typedExpressionIR_hi, typedExpressionIR_lo ]
                      : EC_1 STO_1 (CONT ([ value_base, value_hi, value_lo ]))
    -- if value = $bitacc_op(value_base, value_hi, value_lo)
    -- if expressionResult = CONT value

}

