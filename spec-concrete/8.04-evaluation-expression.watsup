;;
;; Expression evaluation
;;
;; syntax typedExpressionIR =
;;   expressionIR `# `( typeIR ctk )
;;

;;; syntax expressionIR

;;;; literalExpressionIR
;;;; syntax literalExpression

;;;;; TRUE | FALSE

rulegroup Expr_eval/literalExpressionIR-boolean {

  rule Expr_eval/true:
    p EC STO |- TRUE `# _ : STO (B true)

  rule Expr_eval/false:
    p EC STO |- FALSE `# _ : STO (B false)

}

;;;;; number

rulegroup Expr_eval/literalExpressionIR-number {

  rule Expr_eval/arbint:
    p EC STO |- (D i) `# _ : STO (D i)

  rule Expr_eval/fixbit:
    p EC STO |- (n W i) `# _ : STO (n W i)

  rule Expr_eval/fixint:
    p EC STO |- (n S i) `# _ : STO (n S i)

}

;;;;; stringLiteral

rule Expr_eval/literalExpressionIR-stringLiteral:
  p EC STO |- (`" text `") `# _ : STO (`" text `")

;;;; referenceExpressionIR
;;;; syntax referenceExpressionIR = prefixedNameIR

rule Expr_eval/referenceExpressionIR:
  p EC STO |- prefixedNameIR `# _ : STO value
  -- if value = $find_value_eval(p, EC, prefixedNameIR)

;;;; defaultExpressionIR

rule Expr_eval/defaultExpressionIR:
  p EC STO |- `... `# _ : STO DEFAULT

;;;; unaryExpressionIR
;;;; syntax unaryExpressionIR = unop typedExpressionIR

rule Expr_eval/unaryExpressionIR:
  p EC STO_0 |- (unop typedExpressionIR) `# _ : STO_1 $un_op(unop, value)
  -- Expr_eval: p EC STO_0 |- typedExpressionIR : STO_1 value

;;;; binaryExpressionIR
;;;; syntax binaryExpressionIR =
;;;;   typedExpressionIR binop typedExpressionIR

rulegroup Expr_eval/binaryExpressionIR {

  rule Expr_eval/non-short-circuit-exit:
    p EC STO_0 |- (typedExpressionIR_l binop typedExpressionIR_r) `# `( _ _ )
                : STO_1 EXIT
    -- if ~(binop <- [ `&&, `|| ])
    -- Exprs_eval:
        p EC STO_0 |- [ typedExpressionIR_l, typedExpressionIR_r ]
                    : STO_1 EXIT

  rule Expr_eval/non-short-circuit-cont:
    p EC STO_0 |- (typedExpressionIR_l binop typedExpressionIR_r) `# `( _ _ )
                : STO_1 value
    -- if ~(binop <- [ `&&, `|| ])
    -- Exprs_eval:
        p EC STO_0 |- [ typedExpressionIR_l, typedExpressionIR_r ]
                    : STO_1 (`{ [ value_l, value_r] })
    -- if value = $bin_op(binop, value_l, value_r)

  rule Expr_eval/land-exit:
    p EC STO_0 |- (typedExpressionIR_l `&& typedExpressionIR_r) `# `( _ _ )
                : STO_1 EXIT
    -- Expr_eval: p EC STO_0 |- typedExpressionIR_l : STO_1 EXIT

  rule Expr_eval/land-false:
    p EC STO_0 |- (typedExpressionIR_l `&& typedExpressionIR_r) `# `( _ _ )
                : STO_1 (B false)
    -- Expr_eval: p EC STO_0 |- typedExpressionIR_l : STO_1 (B false)

  rule Expr_eval/land-true-exit:
    p EC STO_0 |- (typedExpressionIR_l `&& typedExpressionIR_r) `# `( _ _ )
                : STO_2 EXIT
    -- Expr_eval: p EC STO_0 |- typedExpressionIR_l : STO_1 (B true)
    -- Expr_eval: p EC STO_1 |- typedExpressionIR_r : STO_2 EXIT

  rule Expr_eval/land-true:
    p EC STO_0 |- (typedExpressionIR_l `&& typedExpressionIR_r) `# `( _ _ )
                : STO_2 value_r
    -- Expr_eval: p EC STO_0 |- typedExpressionIR_l : STO_1 (B true)
    -- Expr_eval: p EC STO_1 |- typedExpressionIR_r : STO_2 value_r

  rule Expr_eval/lor-exit:
    p EC STO_0 |- (typedExpressionIR_l `|| typedExpressionIR_r) `# `( _ _ )
                : STO_1 EXIT
    -- Expr_eval: p EC STO_0 |- typedExpressionIR_l : STO_1 EXIT

  rule Expr_eval/lor-true:
    p EC STO_0 |- (typedExpressionIR_l `|| typedExpressionIR_r) `# `( _ _ )
                : STO_1 (B true)
    -- Expr_eval: p EC STO_0 |- typedExpressionIR_l : STO_1 (B true)

  rule Expr_eval/lor-false-exit:
    p EC STO_0 |- (typedExpressionIR_l `|| typedExpressionIR_r) `# `( _ _ )
                : STO_2 EXIT
    -- Expr_eval: p EC STO_0 |- typedExpressionIR_l : STO_1 (B false)
    -- Expr_eval: p EC STO_1 |- typedExpressionIR_r : STO_2 EXIT

  rule Expr_eval/lor-false:
    p EC STO_0 |- (typedExpressionIR_l `|| typedExpressionIR_r) `# `( _ _ )
                : STO_2 value_r
    -- Expr_eval: p EC STO_0 |- typedExpressionIR_l : STO_1 (B false)
    -- Expr_eval: p EC STO_1 |- typedExpressionIR_r : STO_2 value_r

}

;;;; ternaryExpressionIR
;;;; syntax ternaryExpressionIR =
;;;;   typedExpressionIR `? typedExpressionIR `: typedExpressionIR

rulegroup Expr_eval/ternaryExpressionIR {

  rule Expr_eval/cond-exit:
    p EC STO_0 |- (typedExpressionIR_cond `? typedExpressionIR_true `: typedExpressionIR_false) `# _
                : STO_1 EXIT
    -- Expr_eval: p EC STO_0 |- typedExpressionIR_cond : STO_1 EXIT

  rule Expr_eval/cond-true:
    p EC STO_0 |- (typedExpressionIR_cond `? typedExpressionIR_true `: typedExpressionIR_false) `# _
                : STO_2 expressionResult_true
    -- Expr_eval: p EC STO_0 |- typedExpressionIR_cond : STO_1 (B true)
    -- Expr_eval: p EC STO_1 |- typedExpressionIR_true : STO_2 expressionResult_true

  rule Expr_eval/cond-false:
    p EC STO_0 |- (typedExpressionIR_cond `? typedExpressionIR_true `: typedExpressionIR_false) `# _
                : STO_2 expressionResult_false
    -- Expr_eval: p EC STO_0 |- typedExpressionIR_cond : STO_1 (B false)
    -- Expr_eval: p EC STO_1 |- typedExpressionIR_false : STO_2 expressionResult_false

}

;;;; castExpressionIR
;;;; syntax castExpressionIR = `( typeIR ) typedExpressionIR

rule Expr_eval/castExpressionIR:
  p EC STO_0 |- (`( typeIR ) typedExpressionIR) `# _ : STO_1 value_cast
  -- Expr_eval: p EC STO_0 |- typedExpressionIR : STO_1 value
  -- if value_cast = $cast_op(typeIR, value)

;;;; dataExpressionIR
;;;; syntax dataExpressionIR

;;;;; `{#}

rule Expr_eval/dataExpressionIR-invalid:
  p EC STO |- `{#} `# _ : STO `{#}

;;;;; SEQ `{ typedExpressionListIR }
;;;;; SEQ `{ typedExpressionListIR `, `... }

rulegroup Expr_eval/dataExpressionIR-sequence {

  rule Expr_eval/non-default:
    p EC STO_0 |- (SEQ `{ typedExpressionListIR }) `# _
                : STO_1 (SEQ `( value* ))
    -- Exprs_eval:
        p EC STO_0 |- typedExpressionListIR : STO_1 (`{ value* })

  rule Expr_eval/default:
    p EC STO_0 |- (SEQ `{ typedExpressionListIR `, `... }) `# _
                : STO_1 (SEQ `( value* `, `... ))
    -- Exprs_eval:
        p EC STO_0 |- typedExpressionListIR : STO_1 (`{ value* })

}

;;;;; RECORD `{ namedExpressionListIR }
;;;;; RECORD `{ namedExpressionListIR `, `... }

rulegroup Expr_eval/dataExpressionIR-record {

  rule Expr_eval/non-default:
    p EC STO_0 |- (RECORD `{ (nameIR `= typedExpressionIR)* }) `# _
                : STO_1 (RECORD `{ (value nameIR `;)* })
    -- Exprs_eval:
        p EC STO_0 |- typedExpressionIR* : STO_1 (`{ value* })

  rule Expr_eval/default:
    p EC STO_0 |- (RECORD `{ (nameIR `= typedExpressionIR)* `, `... }) `# _
              : STO_1 (RECORD `{ (value nameIR `;)* `, `... })
    -- Exprs_eval:
        p EC STO_0 |- typedExpressionIR* : STO_1 (`{ value* })

}

;;;; accessExpressionIR
;;;; syntax accessExpressionIR

;;;;; errorAccessExpressionIR
;;;;; syntax errorAccessExpressionIR = ERROR `. nameIR

rule Expr_eval/errorAccessExpressionIR:
  p EC STO |- (ERROR `. nameIR) `# _ : STO value_error
  -- if nameIR_error = "error." ++ nameIR
  -- if value_error = $find_value_eval(p, EC, `` nameIR_error)

;;;;; memberAccessExpressionIR
;;;;; syntax memberAccessExpressionIR = memberAccessBaseIR `. nameIR
;;;;;; syntax memberAccessBaseIR

;;;;;;; TYPE prefixedNameIR

rulegroup Expr_eval/memberAccessExpressionIR-type {

  rule Expr_eval/enum:
    p EC STO |- ((TYPE prefixedNameIR) `. nameIR) `# _
              : STO (tid `. nameIR)
    -- if ENUM tid `{ _ } = $find_type_eval(p, EC, prefixedNameIR)

  rule Expr_eval/serenum:
    p EC STO |- ((TYPE prefixedNameIR) `. nameIR) `# _
              : STO (tid `. nameIR `# value)
    -- if ENUM tid `# _ `{ (id_member `= value_member `;)* }
        = $find_type_eval(p, EC, prefixedNameIR)
    -- if value = $assoc_<nameIR, value>(nameIR, (id_member, value_member)*)

}

;;;;;;; typedExpressionIR

rulegroup Expr_eval/memberAccessExpressionIR-expression {

  rule Expr_eval/exit:
    p EC STO |- (typedExpressionIR_base `. nameIR) `# `( typeIR_base _ )
              : STO EXIT
    -- Expr_eval: p EC STO |- typedExpressionIR_base : STO EXIT

  rule Expr_eval/stack-size:
    p EC STO |- (typedExpressionIR_base `. "size") `# `( typeIR_base _ )
              : STO (D n_size)
    -- Expr_eval: p EC STO |- typedExpressionIR_base : STO value_base 
    -- if `[ _ `# `( _; n_size ) ] = value_base

  rule Expr_eval/struct:
    p EC STO |- (typedExpressionIR_base `. nameIR) `# `( typeIR_base _ )
              : STO value_member
    -- Expr_eval: p EC STO |- typedExpressionIR_base : STO value_base
    -- if STRUCT _ `{ (value_field id_field `;)* } = value_base
    -- if value_member
        = $assoc_<nameIR, value>(nameIR, (id_field, value_field)*)

   rule Expr_eval/header:
    p EC STO |- (typedExpressionIR_base `. nameIR) `# `( typeIR_base _ )
              : STO value_member
    -- Expr_eval: p EC STO |- typedExpressionIR_base : STO value_base
    -- if HEADER _ `{ (value_field id_field `;)* } = value_base
    -- if value_member
        = $assoc_<nameIR, value>(nameIR, (id_field, value_field)*)

   rule Expr_eval/headerUnion:
    p EC STO |- (typedExpressionIR_base `. nameIR) `# `( typeIR_base _ )
              : STO value_member
    -- Expr_eval: p EC STO |- typedExpressionIR_base : STO value_base
    -- if HEADER_UNION _ `{ (value_field id_field `;)* } = value_base
    -- if value_member
        = $assoc_<nameIR, value>(nameIR, (id_field, value_field)*) 

}

;;;;; indexAccessExpressionIR
;;;;; syntax indexAccessExpressionIR =
;;;;; typedExpressionIR `[ typedExpressionIR ]
;;;;; (TODO) handle header stack accesses

rulegroup Expr_eval/indexAccessExpressionIR {
  
  rule Expr_eval/exit:
    p EC STO_0 |- (typedExpressionIR_base `[ typedExpressionIR_index ]) `# _
                : STO_1 EXIT
    -- Exprs_eval:
        p EC STO_0 |- [ typedExpressionIR_base, typedExpressionIR_index ]
                    : STO_1 EXIT

  rule Expr_eval/tuple-exit:
    p EC STO_0 |- (typedExpressionIR_base `[ typedExpressionIR_index ]) `# _
                : STO_1 value
    -- Exprs_eval:
        p EC STO_0 |- [ typedExpressionIR_base, typedExpressionIR_index ]
                    : STO_1 (`{ [ value_base, value_index ] })
    -- if `( value_elem* ) = value_base
    -- if n_index = $to_number(value_index)
    -- if value = value_elem*[n_index]

}

;;;;; sliceAccessExpressionIR
;;;;; syntax sliceAccessExpressionIR =
;;;;;  typedExpressionIR `[ typedExpressionIR `: typedExpressionIR ]

rulegroup Expr_eval/sliceAccessExpressionIR {

  rule Expr_eval/exit:
    p EC STO_0 |- (typedExpressionIR_base `[ typedExpressionIR_hi `: typedExpressionIR_lo ]) `# _
                : STO_1 EXIT
    -- Exprs_eval:
        p EC STO_0 |- [ typedExpressionIR_base, typedExpressionIR_hi, typedExpressionIR_lo ]
                    : STO_1 EXIT

  rule Expr_eval/cont:
    p EC STO_0 |- (typedExpressionIR_base `[ typedExpressionIR_hi `: typedExpressionIR_lo ]) `# _
                : STO_1 value
    -- Exprs_eval:
        p EC STO_0 |- [ typedExpressionIR_base, typedExpressionIR_hi, typedExpressionIR_lo ]
                    : STO_1 (`{ [ value_base, value_hi, value_lo ] })
    -- if value = $bitacc_op(value_base, value_hi, value_lo)

}

