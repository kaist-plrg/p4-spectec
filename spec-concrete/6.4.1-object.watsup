;;
;; Objects
;;

syntax venv

syntax object =
  | EXTERN tid `{ theta venv renv }
  | PARSER `( parameterListIR )
      `{ venv
         parserLocalDeclarationListIR
         senv }
  | CONTROL `( parameterListIR )
      `{ venv
         controlLocalDeclarationListIR
         renv
         controlBodyIR }
  | PACKAGE `{ theta venv }
  | TABLE tid `{ venv tablePropertyListIR }
