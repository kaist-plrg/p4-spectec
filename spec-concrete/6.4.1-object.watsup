;;
;; Objects
;;

syntax venv

;;
;;;; Extern object
;;;; Name of the extern object (tid), bound type variables (theta),
;;;; value environment (venv), and routine environment for methods (renv)
;;

syntax externObject = EXTERN tid `{ theta venv renv }

;;
;;;; Parser object
;;;; Apply parameters (parameterListIR), value environment (venv),
;;;; local declarations (parserLocalDeclarationListIR), and state environment (senv)
;;

syntax parserObject =
  PARSER `( parameterListIR )
    `{ venv
       parserLocalDeclarationListIR
       senv }

;;
;;;; Control object
;;;; Apply parameters (parameterListIR), value environment (venv),
;;;; local declarations (controlLocalDeclarationListIR),
;;;; routine environment for actions (renv), and body (controlBodyIR)
;;

syntax controlObject =
  CONTROL `( parameterListIR )
    `{ venv
       controlLocalDeclarationListIR
       renv
       controlBodyIR }

;;
;;;; Package object
;;;; Name of the package (tid), bound type variables (theta),
;;;; and value environment (venv)
;;

syntax packageObject = PACKAGE `{ theta venv }

;;
;;;; Table object
;;;; Name of the table (tid) and value environment (venv)
;;

syntax tableObject = TABLE tid `{ venv tablePropertyListIR }

syntax object =
  | externObject
  | parserObject
  | controlObject
  | packageObject
  | tableObject
