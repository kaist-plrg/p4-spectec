;;
;;;; Expression evaluation results
;;

syntax expressionResult =
  | value
  | EXIT

;;
;;;; Statement execution results
;;

syntax statementResult =
  | CONT
  | EXIT
  | RETURN value

;;
;;;; Parser transition results
;;

syntax transitionResult =
  | ACCEPT
  | REJECT
  | STATE id

;;
;;;; Declaration execution results
;;

syntax declarationResult =
  | CONT
  | EXIT
