;;
;; Relations for well-formedness
;;

relation Type_wf:
  bound |- typeIR
  hint(input %0 %1)
  hint(prose_true %1 "is a well-formed type, assuming bound type ids" %0)

relation TypeDef_wf:
  bound |- typeDefIR
  hint(input %0 %1)
  hint(prose_true %1 "is a well-formed type, assuming bound type ids" %0)

relation ParameterType_wf:
  bound |- parameterTypeIR
  hint(input %0 %1)
  hint(prose_true %1 "is a well-formed type, assuming bound type ids" %0)

relation ParameterTypes_wf:
  bound |- parameterTypeIR*
  hint(input %0 %1)
  hint(prose_true %1 "is a well-formed type, assuming bound type ids" %0)

relation CallableType_wf:
  bound |- callableTypeIR
  hint(input %0 %1)
  hint(prose_true %1 "is a well-formed type, assuming bound type ids" %0)

relation CallableTypeDef_wf:
  bound |- callableTypeDefIR
  hint(input %0 %1)
  hint(prose_true %1 "is a well-formed type, assuming bound type ids" %0)

relation ConstructorParameterType_wf:
  bound |- parameterTypeIR
  hint(input %0 %1)
  hint(prose_true %1 "is a well-formed type, assuming bound type ids" %0)

relation ConstructorParameterTypes_wf:
  bound |- parameterTypeIR*
  hint(input %0 %1)
  hint(prose_true %1 "is a well-formed type, assuming bound type ids" %0)

relation ConstructorType_wf:
  bound |- constructorTypeIR
  hint(input %0 %1)
  hint(prose_true %1 "is a well-formed type, assuming bound type ids" %0)

relation ConstructorTypeDef_wf:
  bound |- constructorTypeDefIR
  hint(input %0 %1)
  hint(prose_true %1 "is a well-formed type, assuming bound type ids" %0)

;;
;;;; Well-formedness of types
;;

;;; Base types

rule Type_wf/baseTypeIR:
  bound |- baseTypeIR

;;; Named types

rule Type_wf/nameTypeIR:
  bound |- `` tid
  -- if $in_set<tid>(tid, bound)

rule Type_wf/specializedTypeIR:
  bound |- typeDefIR_base `< typeIR_arg* >
  -- if typeIR_spec = $specialize_typeDefIR(typeDefIR_base, typeIR_arg*)
  -- Type_wf: bound |- typeIR_spec

;;; Alias types

dec $nestable_typedef(typeIR) : bool
  hint(prose_true %0 "can be used in a typedef")
  hint(prose_false %0 "cannot be used in a typedef")
tbl dec $nestable'_typedef(typeIR) : bool
  hint(prose_true %0 "can be used in a typedef")
  hint(prose_false %0 "cannot be used in a typedef")

def $nestable_typedef(typeIR) = $nestable'_typedef(typeIR_canon)
  -- if typeIR_canon = $canon_typeIR(typeIR)
tbl def $nestable'_typedef =
  | BOOL => true
  | ERROR => true
  | STRING => true
  | integerTypeIR => true
  | nameTypeIR => true
  | newTypeIR => true
  | dataTypeIR => true
  | _ => false

rule Type_wf/typedefTypeIR:
  bound |- TYPEDEF _ typeIR
  -- if $nestable_typedef(typeIR)
  -- Type_wf: bound |- typeIR

dec $nestable_new(typeIR) : bool
  hint(prose_true %0 "can be used in a new type")
  hint(prose_false %0 "cannot be used in a new type")
tbl dec $nestable'_new(typeIR) : bool
  hint(prose_true %0 "can be used in a new type")
  hint(prose_false %0 "cannot be used in a new type")

def $nestable_new(typeIR) = $nestable'_new(typeIR_canon)
  -- if typeIR_canon = $canon_typeIR(typeIR)
tbl def $nestable'_new =
  | BOOL => true
  | BIT `< _ > => true
  | INT `< _ > => true
  | nameTypeIR => true
  | newTypeIR => true
  | _ => false

rule Type_wf/newTypeIR:
  bound |- TYPE _ typeIR
  -- if $nestable_new(typeIR)
  -- Type_wf: bound |- typeIR 

;;; Data types

dec $nestable_list(typeIR) : bool
  hint(prose_true %0 "can be nested in a list type")
  hint(prose_false %0 "cannot be nested in a list type")
tbl dec $nestable'_list(typeIR) : bool
  hint(prose_true %0 "can be nested in a list type")
  hint(prose_false %0 "cannot be nested in a list type")

def $nestable_list(typeIR) = $nestable'_list(typeIR_canon)
  -- if typeIR_canon = $canon_typeIR(typeIR)
tbl def $nestable'_list =
  | BOOL => true
  | ERROR => true
  | MATCH_KIND => true
  | STRING => true
  | integerTypeIR => true
  | nameTypeIR => true
  | newTypeIR => true
  | dataTypeIR => true
  | _ => false

rule Type_wf/listTypeIR:
  bound |- LIST `< typeIR >
  -- if $nestable_list(typeIR)
  -- Type_wf: bound |- typeIR

dec $nestable_tuple(typeIR) : bool
  hint(prose_true %0 "can be nested in a tuple type")
  hint(prose_false %0 "cannot be nested in a tuple type")
tbl dec $nestable'_tuple(typeIR) : bool
  hint(prose_true %0 "can be nested in a tuple type")
  hint(prose_false %0 "cannot be nested in a tuple type")

def $nestable_tuple(typeIR) = $nestable'_tuple(typeIR_canon)
  -- if typeIR_canon = $canon_typeIR(typeIR)
tbl def $nestable'_tuple =
  | BOOL => true
  | ERROR => true
  | BIT `< _ > => true
  | INT `< _ > => true
  | VARBIT `< _ > => true
  | nameTypeIR => true
  | newTypeIR => true
  | tupleTypeIR => true
  | headerStackTypeIR => true
  | structTypeIR => true
  | headerTypeIR => true
  | headerUnionTypeIR => true
  | enumTypeIR => true
  | _ => false

rule Type_wf/tupleTypeIR:
  bound |- TUPLE `< typeIR* >
  -- if $nestable_tuple(typeIR)*
  -- (Type_wf: bound |- typeIR)*

dec $nestable_headerStack(typeIR) : bool
  hint(prose_true %0 "can be nested in a header stack type")
  hint(prose_false %0 "cannot be nested in a header stack type")
tbl dec $nestable'_headerStack(typeIR) : bool
  hint(prose_true %0 "can be nested in a header stack type")
  hint(prose_false %0 "cannot be nested in a header stack type")

def $nestable_headerStack(typeIR)
  = $nestable'_headerStack(typeIR_canon)
  -- if typeIR_canon = $canon_typeIR(typeIR)

tbl def $nestable'_headerStack =
  | nameTypeIR => true
  | headerTypeIR => true
  | headerUnionTypeIR => true
  | _ => false

rule Type_wf/headerStackTypeIR:
  bound |- typeIR `[ _ ]
  -- if $nestable_headerStack(typeIR)
  -- Type_wf: bound |- typeIR

dec $nestable_struct(typeIR) : bool
  hint(prose_true %0 "can be nested in a struct type")
  hint(prose_false %0 "cannot be nested in a struct type")
dec $nestable'_struct(typeIR) : bool
  hint(prose_true %0 "can be nested in a struct type")
  hint(prose_false %0 "cannot be nested in a struct type")

def $nestable_struct(typeIR) = $nestable'_struct(typeIR_canon)
  -- if typeIR_canon = $canon_typeIR(typeIR)
def $nestable'_struct(typeIR) = $nestable'_tuple(typeIR)

rule Type_wf/structTypeIR:
  bound |- STRUCT _ `{ (typeIR_field id_field `;)* }
  -- if $distinct_<id>(id_field*)
  -- if $nestable_struct(typeIR_field)*
  -- (Type_wf: bound |- typeIR_field)*

dec $nestable_header(typeIR) : bool
  hint(prose_true %0 "can be used in a header type")
  hint(prose_false %0 "cannot be used in a header type")
tbl dec $nestable'_header(typeIR) : bool
  hint(prose_true %0 "can be used in a header type")
  hint(prose_false %0 "cannot be used in a header type")
dec $nestable_struct_in_header(typeIR) : bool
  hint(prose_true %0 "can be used in a struct nested in a header type")
  hint(prose_false %0 "cannot be used in a struct nested in a header type")
tbl dec $nestable'_struct_in_header(typeIR) : bool
  hint(prose_true %0 "can be used in a struct nested in a header type")
  hint(prose_false %0 "cannot be used in a struct nested in a header type")

def $nestable_header(typeIR)
  = $nestable'_header(typeIR_canon)
  -- if typeIR_canon = $canon_typeIR(typeIR)
tbl def $nestable'_header =
  | BOOL => true
  | INT `< _ > => true
  | BIT `< _ > => true
  | VARBIT `< _ > => true
  | nameTypeIR => true
  | newTypeIR => true
  | ENUM _ `< _ > `{ _ } => true
  | STRUCT _ `{ (typeIR_field _ `;)* } =>
    $forall_($nestable_struct_in_header(typeIR_field)*)
  | _ => false

def $nestable_struct_in_header(typeIR)
  = $nestable'_struct_in_header(typeIR_canon)
  -- if typeIR_canon = $canon_typeIR(typeIR)
tbl def $nestable'_struct_in_header =
  | BOOL => true
  | INT `< _ > => true
  | BIT `< _ > => true
  | nameTypeIR => true
  | newTypeIR => true
  | ENUM _ `< _ > `{ _ } => true
  | STRUCT _ `{ (typeIR_field _ `;)* } =>
    $forall_($nestable_struct_in_header(typeIR_field)*)
  | _ => false

rule Type_wf/headerTypeIR:
  bound |- HEADER _ `{ (typeIR_field id_field `;)* }
  -- if $distinct_<id>(id_field*)
  -- if $nestable_header(typeIR_field)*
  -- (Type_wf: bound |- typeIR_field)*

dec $nestable_headerUnion(typeIR) : bool
  hint(prose_true %0 "can be used in a header union type")
  hint(prose_false %0 "cannot be used in a header union type")
tbl dec $nestable'_headerUnion(typeIR) : bool
  hint(prose_true %0 "can be used in a header union type")
  hint(prose_false %0 "cannot be used in a header union type")

def $nestable_headerUnion(typeIR)
  = $nestable'_headerUnion(typeIR_canon)
  -- if typeIR_canon = $canon_typeIR(typeIR)
tbl def $nestable'_headerUnion =
  | nameTypeIR => true
  | newTypeIR => true
  | headerTypeIR => true
  | _ => false

rule Type_wf/headerUnionTypeIR:
  bound |- HEADER_UNION _ `{ (typeIR_field id_field `;)* }
  -- if $distinct_<id>(id_field*)
  -- if $nestable_headerUnion(typeIR_field)*
  -- (Type_wf: bound |- typeIR_field)*

dec $nestable_enum_serializable(typeIR) : bool
  hint(prose_true %0 "can be used in a serializable enum type")
  hint(prose_false %0 "cannot be used in a serializable enum type")
tbl dec $nestable'_enum_serializable(typeIR) : bool
  hint(prose_true %0 "can be used in a serializable enum type")
  hint(prose_false %0 "cannot be used in a serializable enum type")
dec $nestable_new_in_enum_serializable(typeIR) : bool
  hint(prose_true %0 "can be used in a new type nested in a serializable enum type")
  hint(prose_false %0 "cannot be used in a new type nested in a serializable enum type")
tbl dec $nestable'_new_in_enum_serializable(typeIR) : bool
  hint(prose_true %0 "can be used in a new type nested in a serializable enum type")
  hint(prose_false %0 "cannot be used in a new type nested in a serializable enum type")

def $nestable_enum_serializable(typeIR)
  = $nestable'_enum_serializable(typeIR_canon)
  -- if typeIR_canon = $canon_typeIR(typeIR)
tbl def $nestable'_enum_serializable =
  | INT `< _ > => true
  | BIT `< _ > => true
  | nameTypeIR => true
  | TYPE _ typeIR => $nestable_new_in_enum_serializable(typeIR)
  | _ => false

def $nestable_new_in_enum_serializable(typeIR)
  = $nestable'_new_in_enum_serializable(typeIR_canon)
  -- if typeIR_canon = $canon_typeIR(typeIR)
tbl def $nestable'_new_in_enum_serializable =
  | INT `< _ > => true
  | BIT `< _ > => true
  | nameTypeIR => true
  | newTypeIR => true
  | _ => false

rulegroup Type_wf/enumTypeIR {

  rule Type_wf/non-serializable:
    bound |- ENUM _ `{ id_field* }
    -- if $distinct_<id>(id_field*)

  rule Type_wf/serializable:
    bound |- ENUM _ `< typeIR > `{ (id_field `= _ `;)* }
    -- if $distinct_<id>(id_field*)
    -- if $nestable_enum_serializable(typeIR)
    -- Type_wf: bound |- typeIR

}

;;; Object types

rule Type_wf/externObjectTypeIR:
  bound |- EXTERN _ (`{ (_ `: externMethodTypeDefIR)* })
  -- (CallableTypeDef_wf: bound |- externMethodTypeDefIR)*

rule Type_wf/parserObjectTypeIR:
  bound |- PARSER `( parameterTypeIR* )
  -- ParameterTypes_wf: bound |- parameterTypeIR*

rule Type_wf/controlObjectTypeIR:
  bound |- CONTROL `( parameterTypeIR* )
  -- ParameterTypes_wf: bound |- parameterTypeIR*

rule Type_wf/packageObjectTypeIR:
  bound |- PACKAGE `{ typeIR* }
  -- (Type_wf: bound |- typeIR)*

rule Type_wf/tableObjectTypeIR:
  bound |- TABLE _ `{ tableMetadataStructTypeIR }
  -- Type_wf: bound |- tableMetadataStructTypeIR

;;; Synthesized types

rule Type_wf/defaultTypeIR:
  bound |- DEFAULT

rule Type_wf/invalidHeaderTypeIR:
  bound |- HEADER_INVALID

rulegroup Type_wf/sequenceTypeIR {

  rule Type_wf/non-default:
    bound |- SEQ `< typeIR* >
    -- (Type_wf: bound |- typeIR)*

  rule Type_wf/default:
    bound |- SEQ `< typeIR* `, `... >
    -- (Type_wf: bound |- typeIR)*

}

rulegroup Type_wf/recordTypeIR {

  rule Type_wf/non-default:
    bound |- RECORD `{ (typeIR_field id_field `;)* }
    -- if $distinct_<id>(id_field*)
    -- (Type_wf: bound |- typeIR_field)*

  rule Type_wf/default:
    bound |- RECORD `{ (typeIR_field id_field `;)* `, `... }
    -- if $distinct_<id>(id_field*)
    -- (Type_wf: bound |- typeIR_field)*

}

dec $nestable_set(typeIR) : bool
  hint(prose_true %0 "can be used in a set type")
  hint(prose_false %0 "cannot be used in a set type")
tbl dec $nestable'_set(typeIR) : bool
  hint(prose_true %0 "can be used in a set type")
  hint(prose_false %0 "cannot be used in a set type")
dec $nestable_tuple_in_set(typeIR) : bool
  hint(prose_true %0 "can be used in a tuple nested in a set type")
  hint(prose_false %0 "cannot be used in a tuple nested in a set type")
tbl dec $nestable'_tuple_in_set(typeIR) : bool
  hint(prose_true %0 "can be used in a tuple nested in a set type")
  hint(prose_false %0 "cannot be used in a tuple nested in a set type")
dec $nestable_sequence_in_set(typeIR) : bool
  hint(prose_true %0 "can be used in a sequence nested in a set type")
  hint(prose_false %0 "cannot be used in a sequence nested in a set type")
tbl dec $nestable'_sequence_in_set(typeIR) : bool
  hint(prose_true %0 "can be used in a sequence nested in a set type")
  hint(prose_false %0 "cannot be used in a sequence nested in a set type")

def $nestable_set(typeIR) = $nestable'_set(typeIR_canon)
  -- if typeIR_canon = $canon_typeIR(typeIR)
tbl def $nestable'_set =
  | BOOL => true
  | ERROR => true
  | INT `< _ > => true
  | BIT `< _ > => true
  | nameTypeIR => true
  | newTypeIR => true
  | TUPLE `< typeIR* > => $forall_($nestable_tuple_in_set(typeIR)*)
  | enumTypeIR => true
  | SEQ `< typeIR* > => $forall_($nestable_sequence_in_set(typeIR)*)
  | _ => false

def $nestable_tuple_in_set(typeIR)
  = $nestable'_tuple_in_set(typeIR_canon)
  -- if typeIR_canon = $canon_typeIR(typeIR)
tbl def $nestable'_tuple_in_set =
  | BOOL => true
  | INT `< _ > => true
  | BIT `< _ > => true
  | nameTypeIR => true
  | newTypeIR => true
  | TUPLE `< typeIR* > => $forall_($nestable_tuple_in_set(typeIR)*)
  | enumTypeIR => true
  | _ => false

def $nestable_sequence_in_set(typeIR)
  = $nestable'_sequence_in_set(typeIR_canon)
  -- if typeIR_canon = $canon_typeIR(typeIR)
tbl def $nestable'_sequence_in_set =
  | BOOL => true
  | INT `< _ > => true
  | BIT `< _ > => true
  | nameTypeIR => true
  | newTypeIR => true
  | TUPLE `< typeIR* > => $forall_($nestable_sequence_in_set(typeIR)*)
  | enumTypeIR => true
  | SEQ `< typeIR* > => $forall_($nestable_sequence_in_set(typeIR)*)
  | _ => false

rule Type_wf/setTypeIR:
  bound |- SET `< typeIR >
  -- if $nestable_set(typeIR)
  -- Type_wf: bound |- typeIR

rulegroup Type_wf/tableMetadataTypeIR {

  rule Type_wf/enum:
    bound |- TABLE_ENUM _ `{ id* }
    -- if $distinct_<id>(id*)

  rule Type_wf/struct:
    bound |- TABLE_STRUCT _ `{ HIT _ `;
                               MISS _ `;
                               ACTION_RUN tableMetadataEnumTypeIR `; }
    -- Type_wf: bound |- tableMetadataEnumTypeIR
  
}

;;
;;;; Well-formedness of type definitions
;;

rule TypeDef_wf:
  bound |- typeDefIR
  -- if (tid_tparam_expl*, tid_tparam_impl*)
      = $type_parameters_of_typeDefIR(typeDefIR)
  -- if $distinct_<tid>(tid_tparam_expl* ++ tid_tparam_impl*)
  -- if typeIR_base = $type_of_typeDefIR(typeDefIR)
  -- if bound_inner
      = $union_set<tid>(bound, `{ tid_tparam_expl* ++ tid_tparam_impl* })
  -- Type_wf: bound_inner |- typeIR_base

;;
;;;; Well-formedness of parameter types
;;

rulegroup ParameterType_wf {

  rule ParameterType_wf/non-default:
    bound |- direction typeIR _ eps
    -- Type_wf: bound |- typeIR
    -- if typeIR_canon = $canon_typeIR(typeIR)
    -- if ~$is_synthesizedTypeIR(typeIR_canon)
    -- if ($is_stringTypeIR(typeIR_canon)
          \/ $is_arbitraryIntTypeIR(typeIR_canon)
          \/ $is_objectTypeIR(typeIR_canon))
          => direction = `EMPTY

  rule ParameterType_wf/default:
    bound |- direction typeIR _ value
    -- Type_wf: bound |- typeIR
    -- if typeIR_canon = $canon_typeIR(typeIR)
    -- if ~$is_synthesizedTypeIR(typeIR_canon)
    -- if direction = IN \/ direction = `EMPTY
    -- if ($is_stringTypeIR(typeIR_canon)
          \/ $is_arbitraryIntTypeIR(typeIR_canon)
          \/ $is_objectTypeIR(typeIR_canon))
          => direction = `EMPTY

}

rule ParameterTypes_wf:
  bound |- parameterTypeIR*
  -- if (_ _ id _ = parameterTypeIR)*
  -- if $distinct_<id>(id*)
  -- (ParameterType_wf: bound |- parameterTypeIR)*

;;
;;;; Well-formedness of callable types
;;

;;; Action types

dec $directionless_trailing(direction*) : bool
  hint(prose_true "directionless parameters in" %0 "only appear at the end")
  hint(prose_false "directionless parameters in" %0 "do not only appear at the end")
dec $directionless_trailing'(bool, direction*) : bool

def $directionless_trailing(direction*)
  = $directionless_trailing'(true, $rev_<direction>(direction*))

def $directionless_trailing'(_, eps) = true
def $directionless_trailing'(true, `EMPTY :: direction_t*)
  = $directionless_trailing'(true, direction_t*)
def $directionless_trailing'(false, `EMPTY :: direction_t*) = false
def $directionless_trailing'(_, direction_h :: direction_t*)
  = $directionless_trailing'(false, direction_t*)
  -- if direction_h =/= `EMPTY

dec $nestable_action(typeIR) : bool
  hint(prose_true %0 "can be used in an action type")
  hint(prose_false %0 "cannot be used in an action type")
tbl dec $nestable'_action(typeIR) : bool
  hint(prose_true %0 "can be used in an action type")
  hint(prose_false %0 "cannot be used in an action type")

def $nestable_action(typeIR) = $nestable'_action(typeIR_canon)
  -- if typeIR_canon = $canon_typeIR(typeIR)
tbl def $nestable'_action =
  | INT => false
  | objectTypeIR => false
  | synthesizedTypeIR => false
  | _ => true

rule CallableType_wf/actionTypeIR:
  bound |- ACTION `( parameterTypeIR* )
  -- ParameterTypes_wf: bound |- parameterTypeIR*
  -- if (direction typeIR _ _ = parameterTypeIR)*
  -- if $directionless_trailing(direction*)
  -- if $nestable_action(typeIR)*

;;; Function types

dec $nestable_definedFunction(typeIR) : bool
  hint(prose_true %0 "can be used in a defined function type")
  hint(prose_false %0 "cannot be used in a defined function type")
tbl dec $nestable'_definedFunction(typeIR) : bool
  hint(prose_true %0 "can be used in a defined function type")
  hint(prose_false %0 "cannot be used in a defined function type")

def $nestable_definedFunction(typeIR)
  = $nestable'_definedFunction(typeIR_canon)
  -- if typeIR_canon = $canon_typeIR(typeIR)
tbl def $nestable'_definedFunction =
  | objectTypeIR => false
  | synthesizedTypeIR => false
  | _ => true

rule CallableType_wf/definedFunctionTypeIR:
  bound |- FUNCTION `( parameterTypeIR* ) `: typeIR_ret
  -- ParameterTypes_wf: bound |- parameterTypeIR*
  -- if (_ typeIR _ _ = parameterTypeIR)* 
  -- if $nestable_definedFunction(typeIR)*
  -- Type_wf: bound |- typeIR_ret

dec $nestable_externFunction(typeIR) : bool
  hint(prose_true %0 "can be used in an extern function type")
  hint(prose_false %0 "cannot be used in an extern function type")
tbl dec $nestable'_externFunction(typeIR) : bool
  hint(prose_true %0 "can be used in an extern function type")
  hint(prose_false %0 "cannot be used in an extern function type")

def $nestable_externFunction(typeIR)
  = $nestable'_externFunction(typeIR_canon)
  -- if typeIR_canon = $canon_typeIR(typeIR)
tbl def $nestable'_externFunction =
  | parserObjectTypeIR => false
  | controlObjectTypeIR => false
  | packageObjectTypeIR => false
  | tableObjectTypeIR => false
  | _ => true

rule CallableType_wf/externFunctionTypeIR:
  bound |- EXTERN_FUNCTION `( parameterTypeIR* ) `: typeIR_ret
  -- ParameterTypes_wf: bound |- parameterTypeIR*
  -- if (_ typeIR _ _ = parameterTypeIR)* 
  -- if $nestable_externFunction(typeIR)*
  -- Type_wf: bound |- typeIR_ret

;;; Method types

rule CallableType_wf/builtinMethodTypeIR:
  bound |- BUILTIN_METHOD `( parameterTypeIR* ) `: typeIR_ret
  -- ParameterTypes_wf: bound |- parameterTypeIR*
  -- Type_wf: bound |- typeIR_ret

dec $nestable_externMethod(typeIR) : bool
  hint(prose_true %0 "can be used in an extern method type")
  hint(prose_false %0 "cannot be used in an extern method type")
tbl dec $nestable'_externMethod(typeIR) : bool
  hint(prose_true %0 "can be used in an extern method type")
  hint(prose_false %0 "cannot be used in an extern method type")

def $nestable_externMethod(typeIR)
  = $nestable'_externMethod(typeIR_canon)
  -- if typeIR_canon = $canon_typeIR(typeIR)
tbl def $nestable'_externMethod =
  | parserObjectTypeIR => false
  | controlObjectTypeIR => false
  | packageObjectTypeIR => false
  | tableObjectTypeIR => false
  | _ => true

rulegroup CallableType_wf/externMethodTypeIR {

  rule CallableType_wf/non-abstract:
    bound |- EXTERN_METHOD `( parameterTypeIR* ) `: typeIR_ret
    -- ParameterTypes_wf: bound |- parameterTypeIR*
    -- if (_ typeIR _ _ = parameterTypeIR)* 
    -- if $nestable_externMethod(typeIR)*
    -- Type_wf: bound |- typeIR_ret

  rule CallableType_wf/abstract:
    bound |- EXTERN_METHOD ABSTRACT `( parameterTypeIR* ) `: typeIR_ret
    -- ParameterTypes_wf: bound |- parameterTypeIR*
    -- if (_ typeIR _ _ = parameterTypeIR)* 
    -- if $nestable_externMethod(typeIR)*
    -- Type_wf: bound |- typeIR_ret

}

dec $nestable_parserApplyMethod(typeIR) : bool
  hint(prose_true %0 "can be used in a parser apply method type")
  hint(prose_false %0 "cannot be used in a parser apply method type")
tbl dec $nestable'_parserApplyMethod(typeIR) : bool
  hint(prose_true %0 "can be used in a parser apply method type")
  hint(prose_false %0 "cannot be used in a parser apply method type")

def $nestable_parserApplyMethod(typeIR)
  = $nestable'_parserApplyMethod(typeIR_canon)
  -- if typeIR_canon = $canon_typeIR(typeIR)
tbl def $nestable'_parserApplyMethod =
  | parserObjectTypeIR => false
  | controlObjectTypeIR => false
  | packageObjectTypeIR => false
  | tableObjectTypeIR => false
  | _ => true

rule CallableType_wf/parserApplyMethodTypeIR:
  bound |- PARSER_APPLY `( parameterTypeIR* )
  -- ParameterTypes_wf: bound |- parameterTypeIR*
  -- if (_ typeIR _ _ = parameterTypeIR)* 
  -- if $nestable_parserApplyMethod(typeIR)*

dec $nestable_controlApplyMethod(typeIR) : bool
  hint(prose_true %0 "can be used in a control apply method type")
  hint(prose_false %0 "cannot be used in a control apply method type")
tbl dec $nestable'_controlApplyMethod(typeIR) : bool
  hint(prose_true %0 "can be used in a control apply method type")
  hint(prose_false %0 "cannot be used in a control apply method type")

def $nestable_controlApplyMethod(typeIR)
  = $nestable'_controlApplyMethod(typeIR_canon)
  -- if typeIR_canon = $canon_typeIR(typeIR)
tbl def $nestable'_controlApplyMethod =
  | parserObjectTypeIR => false
  | packageObjectTypeIR => false
  | tableObjectTypeIR => false
  | _ => true

rule CallableType_wf/controlApplyMethodTypeIR:
  bound |- CONTROL_APPLY `( parameterTypeIR* )
  -- ParameterTypes_wf: bound |- parameterTypeIR*
  -- if (_ typeIR _ _ = parameterTypeIR)* 
  -- if $nestable_controlApplyMethod(typeIR)*

rule CallableType_wf/tableApplyMethodTypeIR:
  bound |- TABLE_APPLY `: tableMetadataStructTypeIR

;;
;;;; Well-formedness of callable type definitions
;;

rule CallableTypeDef_wf:
  bound |- callableTypeDefIR
  -- if (tid_tparam_expl*, tid_tparam_impl*)
      = $type_parameters_of_callableTypeDefIR(callableTypeDefIR)
  -- if $distinct_<tid>(tid_tparam_expl* ++ tid_tparam_impl*)
  -- if callableTypeIR_base
      = $type_of_callableTypeDefIR(callableTypeDefIR)
  -- if bound_inner
      = $union_set<tid>(bound, `{ tid_tparam_expl* ++ tid_tparam_impl* })
  -- CallableType_wf: bound_inner |- callableTypeIR_base

