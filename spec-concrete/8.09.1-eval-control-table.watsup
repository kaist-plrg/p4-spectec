;;
;; Match-action table evaluation
;;
;;
;; syntax tableObjectProperty
;;

;;; (TODO) for now, directly evaluate the default_action

rule Table_eval:
  EC_0 STO_0 |- TBL
              : EC_1 STO_1 (RETURN eps)
  -- if _ _ DEFAULT_ACTION `= (prefixedNameIR `( argumentListIR )) `;
      = TBL.DEFAULT_ACTION
  -- Stmt_eval:
      LOCAL EC_0 STO_0 |- prefixedNameIR `< eps > `( argumentListIR ) `;
                        : EC_1 STO_1 ``
