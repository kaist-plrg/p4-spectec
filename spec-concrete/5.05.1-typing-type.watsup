;;; type
;;; syntax type

;;;; baseType
;;;; syntax baseType

;;; VOID
;;;;; BOOL
;;;;; ERROR
;;;;; MATCH_KIND
;;;;; STRING

rulegroup Type_ok/primitiveType {

  rule Type_ok/void:
    p TC |- VOID : VOID `# eps

  rule Type_ok/boolean:
    p TC |- BOOL : BOOL `# eps

  rule Type_ok/error:
    p TC |- ERROR : ERROR `# eps

  rule Type_ok/matchkind:
    p TC |- MATCH_KIND : MATCH_KIND `# eps

  rule Type_ok/string:
    p TC |- STRING : STRING `# eps

}

;;;;; INT

rule Type_ok/arbitraryInt:
  p TC |- INT : INT `# eps

;;;;; INT `< int >
;;;;; INT `< `( expression ) >

rulegroup Type_ok/fixedInt {

  rule Type_ok/integer:
    p TC |- INT `< n > : (INT `< n >) `# eps

  rule Type_ok/expression:
    p TC |- INT `< `( expression ) > : (INT `< n >) `# eps
    -- Expr_ok: p TC |- expression : typedExpressionIR
    -- if LCTK = $ctk_of_typedExpressionIR(typedExpressionIR)
    -- Expr_eval_lctk: p TC |- typedExpressionIR ~> value
    -- if n = $to_int(value)

}

;;;;; BIT
;;;;; BIT `< int >
;;;;; BIT `< `( expression ) >

rulegroup Type_ok/fixedBit {

  rule Type_ok/none:
    p TC |- BIT : (BIT `< 1 >) `# eps

  rule Type_ok/integer:
    p TC |- BIT `< n > : (BIT `< n >) `# eps

  rule Type_ok/expression:
    p TC |- BIT `< `( expression ) > : (BIT `< n >) `# eps
    -- Expr_ok: p TC |- expression : typedExpressionIR
    -- if LCTK = $ctk_of_typedExpressionIR(typedExpressionIR)
    -- Expr_eval_lctk: p TC |- typedExpressionIR ~> value
    -- if n = $to_int(value)

}

;;;;; VARBIT `< int >
;;;;; VARBIT `< `( expression ) >

rulegroup Type_ok/variableBit {

  rule Type_ok/integer:
    p TC |- VARBIT `< n > : (VARBIT `< n >) `# eps

  rule Type_ok/expression:
    p TC |- VARBIT `< `( expression ) > : (VARBIT `< n >) `# eps
    -- Expr_ok: p TC |- expression : typedExpressionIR
    -- if LCTK = $ctk_of_typedExpressionIR(typedExpressionIR)
    -- Expr_eval_lctk: p TC |- typedExpressionIR ~> value
    -- if n = $to_int(value)

}

;;;; namedType
;;;; syntax namedType

;;;;; prefixedTypeName

rulegroup Type_ok/prefixedTypeName {

  rule Type_ok/monomorphic:
    p TC |- prefixedTypeName : typeIR `# eps
    -- if prefixedNameIR = $prefixedTypeName(prefixedTypeName)
    -- if typeDefIR = $find_typeDef_t(p, TC, prefixedNameIR)
    -- if $is_monomorphic_typeDefIR(typeDefIR)
    -- if typeIR = $type_of_typeDefIR(typeDefIR)

  rule Type_ok/polymorphic:
    p TC |- prefixedTypeName : (typeDefIR `< eps >) `# eps
    -- if prefixedNameIR = $prefixedTypeName(prefixedTypeName)
    -- if typeDefIR = $find_typeDef_t(p, TC, prefixedNameIR)
    -- if ~$is_monomorphic_typeDefIR(typeDefIR)

}

;;;;; specializedType
;;;;; syntax specializedType = prefixedTypeName `< typeArgumentList >

rulegroup Type_ok/specializedType {

  rule Type_ok/poly:
    p TC |- prefixedTypeName `< typeArgumentList >
          : (typeDefIR `< typeIR_arg* >) `# tid_fresh*
    -- if prefixedNameIR = $prefixedTypeName(prefixedTypeName)
    -- if typeDefIR = $find_typeDef_t(p, TC, prefixedNameIR)
    -- if $is_polymorphic_typeDefIR(typeDefIR)
    -- if typeArgument* = $flatten_typeArgumentList(typeArgumentList)
    -- TypeArguments_ok: p TC |- typeArgument* : typeIR_arg* `# tid_fresh*

}

;;;; headerStackType
;;;; syntax headerStackType = namedType `[ expression ]

rulegroup Type_ok/headerStackType {

  rule Type_ok/prefixedTypeName:
    p TC |- prefixedTypeName `[ expression_size ]
          : (typeIR_base `[ n_size ]) `# eps
    ---- ;; check base type
    -- Type_ok: p TC |- prefixedTypeName : typeIR_base `# eps
    ---- ;; check size
    -- Expr_ok: p TC |- expression_size : typedExpressionIR_size
    -- if LCTK = $ctk_of_typedExpressionIR(typedExpressionIR_size)
    -- Expr_eval_lctk: p TC |- typedExpressionIR_size ~> value_size
    -- if n_size = $to_int(value_size)

  rule Type_ok/specializedType:
    p TC |- specializedType `[ expression_size ]
          : (typeIR_base `[ n_size ]) `# tid_fresh*
    ---- ;; check base type
    -- Type_ok: p TC |- specializedType : typeIR_base `# tid_fresh*
    ---- ;; check size
    -- Expr_ok: p TC |- expression_size : typedExpressionIR_size
    -- if LCTK = $ctk_of_typedExpressionIR(typedExpressionIR_size)
    -- Expr_eval_lctk: p TC |- typedExpressionIR_size ~> value_size
    -- if n_size = $to_int(value_size)

}

;;;; listType
;;;; syntax listType = LIST `< typeArgument >

rule Type_ok/listType:
  p TC |- LIST `< typeArgument >
       : (LIST `< typeIR_arg >) `# tid_fresh*
  ---- ;; check type argument
  -- TypeArgument_ok: p TC |- typeArgument : typeIR_arg `# tid_fresh*

;;;; tupleType
;;;; syntax tupleType = TUPLE `< typeArgumentList >

rule Type_ok/tupleType:
  p TC |- TUPLE `< typeArgumentList >
       : (TUPLE `< typeIR_arg* >) `# tid_fresh*
