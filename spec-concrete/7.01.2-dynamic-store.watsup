;;
;; Store
;;

;; Map from object identifiers to objects
syntax store = map<oid, object>

var STO : store

dec $empty_store : store
def $empty_store = $empty_map<oid, object>

;;
;; Finder
;;

dec $find_store_externState(store, oid) : externState?

def $find_store_externState(STO, oid) = externState
  -- if externObject = $find_map<oid, object>(STO, oid)
  -- if EXTERN _ `< _ > `{ externState _ _ } = externObject
def $find_store_externState(STO, oid) = eps
  -- otherwise

;;
;; Updater
;;

dec $update_store_externState(store, oid, externState) : store?

def $update_store_externState(STO_0, oid, externState) = STO_1
  -- if externObject = $find_map<oid, object>(STO_0, oid)
  -- if EXTERN tid `< theta > `{ _ frame externMethodDefEnv }
      = externObject
  -- if externObject_update
      = EXTERN tid `< theta > `{ externState frame externMethodDefEnv }
  -- if STO_1 = $add_map<oid, object>(STO_0, oid, externObject_update)
def $update_store_externState(STO_0, oid, externState) = eps
  -- otherwise
