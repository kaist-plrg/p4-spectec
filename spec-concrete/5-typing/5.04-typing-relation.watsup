;;
;;;; Static evaluation
;;;; of expressions/arguments that are local compile-time known
;;

extern relation ExternFunctionCall_eval_lctk:
  typingContext |- nameIR `( nameIR* ) ~> value
  hint(input %0 %1 %2)
  hint(testgen_ignore)
  hint(prose_in "calling an extern function" %1#"("#%2#")" "under typing context" %0)
  hint(prose_out "the resulting value" %3)

relation Expr_eval_lctk:
  cursor typingContext |- typedExpressionIR ~> value
  hint(input %0 %1 %2)
  hint(testgen_ignore)
  hint(prose_in "the local compile-time evaluation of" %2#", under cursor" %0 "and typing context" %1)
  hint(prose_out "the resulting value" %3)

relation Argument_eval_lctk:
  cursor typingContext |- argumentIR ~> value
  hint(input %0 %1 %2)
  hint(testgen_ignore)
  hint(prose_in "the local compile-time evaluation of" %2#", under cursor" %0 "and typing context" %1)
  hint(prose_out "the resulting value" %3)

;;
;;;; Type evaluation
;;;; Inserts fresh type variables (`# typeId*) for don't care type arguments (`_)
;;

relation Type_ok:
  cursor typingContext |- typeOrVoid : typeIR `# typeId*
  hint(input %0 %1 %2)
  hint(prose_in "typing" %2#", under cursor" %0 "and typing context" %1)
  hint(prose_out "the type" %3 "and a set of fresh type variables" %4)

relation TypeArgument_ok:
  cursor typingContext |- typeArgument : typeArgumentIR `# typeId*
  hint(input %0 %1 %2)
  hint(prose_in "typing" %2#", under cursor" %0 "and typing context" %1)
  hint(prose_out "the type argument" %3 "and set of fresh type variables" %4)

relation TypeArguments_ok:
  cursor typingContext |- typeArgument* : typeArgumentListIR `# typeId*
  hint(input %0 %1 %2)
  hint(prose_in "typing" %2#", under cursor" %0 "and typing context" %1)
  hint(prose_out "the type argument list" %3 "and set of fresh type variables" %4)

;;
;;;; Subtyping, explicit and implicit
;;

relation Sub_expl: typeIR <: typeIR
  hint(input %0 %1)
  hint(prose_true %0 "can be explicitly cast to" %1)
  hint(prose_false %0 "cannot be explicitly cast to" %1)
relation Sub_expl_unroll: typeIR <: typeIR
  hint(input %0 %1)
  hint(prose_true %0 "can be explicitly cast to" %1 "after unrolling")
  hint(prose_false %0 "cannot be explicitly cast to" %1 "after unrolling")
relation Sub_expl_unroll_neq: typeIR <: typeIR
  hint(input %0 %1)
  hint(prose_true %0 "can be explicitly cast to" %1 "when they are not the same type after unrolling")
  hint(prose_false %0 "cannot be explicitly cast to" %1 "when they are not the same type after unrolling")

relation Sub_impl: typeIR <: typeIR
  hint(input %0 %1)
  hint(prose_true %0 "can be implicitly cast to" %1)
  hint(prose_false %0 "cannot be implicitly cast to" %1)
relation Sub_impl_unroll: typeIR <: typeIR
  hint(input %0 %1)
  hint(prose_true %0 "can be implicitly cast to" %1 "after unrolling")
  hint(prose_false %0 "cannot be implicitly cast to" %1 "after unrolling")
relation Sub_impl_unroll_neq: typeIR <: typeIR
  hint(input %0 %1)
  hint(prose_true %0 "can be implicitly cast to" %1 "when they are not the same type after unrolling")
  hint(prose_false %0 "cannot be implicitly cast to" %1 "when they are not the same type after unrolling")

;;
;;;; Expression typing
;;

relation Expr_ok:
  cursor typingContext |- expression : typedExpressionIR
  hint(input %0 %1 %2)
  hint(prose_in "typing" %2#", under cursor" %0 "and typing context" %1)
  hint(prose_out "the typed expression" %3)

;;
;;;; Argument typing
;;

relation Argument_ok:
  cursor typingContext |- argument : argumentIR
  hint(input %0 %1 %2)
  hint(prose_in "typing" %2#", under cursor" %0 "and typing context" %1)
  hint(prose_out "the typed argument" %3)

;;
;;;; L-value typing
;;

relation Lvalue_ok:
  cursor typingContext |- lvalue : typedLvalueIR
  hint(input %0 %1 %2)
  hint(prose_in "typing" %2#", under cursor" %0 "and typing context" %1)
  hint(prose_out "the typed lvalue" %3)

;;
;;;; Statement typing
;;

syntax loopctxt = LOOP | NOLOOP

var l : loopctxt

relation Stmt_ok:
  cursor typingContext flow loopctxt |- statement
                                      : typingContext flow statementIR
  hint(input %0 %1 %2 %3 %4)
  hint(prose_in
        "typing" %3#", under cursor" %0#", typing context"
        %1#", abstract control flow" %2#", and loop context" %4)
  hint(prose_out
        "\nthe typing context" %5#",\nthe abstract control flow"
        %6#",\nand the typed statement" %7)

relation BlockElementStmt_ok:
  typingContext flow loopctxt |- blockElementStatement
                               : typingContext flow blockElementStatementIR
  hint(input %0 %1 %2 %3)
  hint(prose_in
        "typing" %2#", under typing context"
        %0#", abstract control flow" %1#", and loop context" %3)
  hint(prose_out
        "\nthe typing context" %4#",\nthe abstract control flow"
        %5#",\nand the typed block element statement" %6)

relation BlockElementStmts_ok:
  typingContext flow loopctxt |- blockElementStatement*
                               : typingContext flow blockElementStatementIR*
  hint(input %0 %1 %2 %3)
  hint(prose_in
        "typing" %2#", under typing context"
        %0#", abstract control flow" %1#", and loop context" %3)
  hint(prose_out
        "\nthe typing context" %4#",\nthe abstract control flow"
        %5#",\nand the typed block element statements" %6)

relation Block_ok:
  typingContext flow loopctxt |- blockStatement
                               : typingContext flow blockStatementIR
  hint(input %0 %1 %2 %3)
  hint(prose_in
        "typing" %2#", under typing context"
        %0#", abstract control flow" %1#", and loop context" %3)
  hint(prose_out
        "\nthe typing context" %4#",\nthe abstract control flow"
        %5#",\nand the typed block statement" %6)

;;
;;;; Parameter typing
;;;; inserts fresh type variables for parameters with don't care types
;;

relation Parameter_ok:
  cursor typingContext |- parameter : parameterIR `# typeId*
  hint(input %0 %1 %2)
  hint(prose_in "typing" %2#", under cursor" %0 "and typing context" %1)
  hint(prose_out "the parameter" %3 "and set of fresh type variables" %4)

relation Parameters_ok:
  cursor typingContext |- parameter* : parameterListIR `# typeId*
  hint(input %0 %1 %2)
  hint(prose_in "typing" %2#", under cursor" %0 "and typing context" %1)
  hint(prose_out "the parameter list" %3 "and set of fresh type variables" %4)

relation ConstructorParameter_ok:
  cursor typingContext |- constructorParameter
                        : constructorParameterIR `# typeId*
  hint(input %0 %1 %2)
  hint(prose_in "typing" %2#", under cursor" %0 "and typing context" %1)
  hint(prose_out "the constructor parameter" %3 "and set of fresh type variables" %4)

relation ConstructorParameters_ok:
  cursor typingContext |- constructorParameter*
                        : constructorParameterListIR `# typeId*
  hint(input %0 %1 %2)
  hint(prose_in "typing" %2#", under cursor" %0 "and typing context" %1)
  hint(prose_out "the constructor parameter list" %3 "and set of fresh type variables" %4)

;;
;;;; Extern method/constructor typing
;;

relation ExternMethod_ok:
  typingContext typeId |- externMethodPrototype
                     : typingContext externMethodPrototypeIR
  hint(input %0 %1 %2)
  hint(prose_in "typing" %2#", under typing context" %0 "for an extern object" %1)
  hint(prose_out "the updated typing context" %3 "and the typed method prototype" %4)

relation ExternMethods_ok:
  typingContext typeId |- externMethodPrototype*
                     : typingContext externMethodPrototypeIR*
  hint(input %0 %1 %2)
  hint(prose_in "typing" %2#", under typing context" %0 "for an extern object" %1)
  hint(prose_out "the updated typing context" %3 "and the typed method prototypes" %4)

relation ExternConstructor_ok:
  typingContext typeId |- externConstructorPrototype
                     : typingContext externConstructorPrototypeIR
  hint(input %0 %1 %2)
  hint(prose_in "typing" %2#", under typing context" %0 "for an extern object" %1)
  hint(prose_out "the updated typing context" %3 "and the typed constructor prototype" %4)

relation ExternConstructors_ok:
  typingContext typeId |- externConstructorPrototype*
                     : typingContext externConstructorPrototypeIR*
  hint(input %0 %1 %2)
  hint(prose_in "typing" %2#", under typing context" %0 "for an extern object" %1)
  hint(prose_out "the updated typing context" %3 "and the typed constructor prototypes" %4)

;;
;;;; Parser typing
;;

relation ParserTransition_ok:
  typingContext nameIR* |- transitionStatement : transitionStatementIR
  hint(input %0 %1 %2)
  hint(prose_in "typing" %2#", under typing context" %0 "and parser state names" %1)
  hint(prose_out "the typed transition statement" %3)

relation ParserStmt_ok:
  typingContext |- parserStatement : typingContext parserStatementIR
  hint(input %0 %1)
  hint(prose_in "typing" %1#", under typing context" %0)
  hint(prose_out "the updated typing context" %2 "and the typed parser statement" %3)

relation ParserStmts_ok:
  typingContext |- parserStatement* : typingContext parserStatementIR*
  hint(input %0 %1)
  hint(prose_in "typing" %1#", under typing context" %0)
  hint(prose_out "the updated typing context" %2 "and the typed parser statements" %3)

relation ParserState_ok:
  typingContext nameIR* |- parserState : parserStateIR
  hint(input %0 %1 %2)
  hint(prose_in "typing" %2#", under typing context" %0 "and parser state names" %1)
  hint(prose_out "the typed parser state" %3)

relation ParserStates_ok:
  typingContext |- parserState* : parserStateIR*
  hint(input %0 %1)
  hint(prose_in "typing" %1#", under typing context" %0)
  hint(prose_out "the typed parser states" %2)

relation ParserLocalDecl_ok:
  typingContext |- parserLocalDeclaration
                 : typingContext parserLocalDeclarationIR
  hint(input %0 %1)
  hint(prose_in "typing" %1#", under typing context" %0)
  hint(prose_out "the updated typing context" %2 "and the typed parser local declaration" %3)

relation ParserLocalDecls_ok:
  typingContext |- parserLocalDeclaration*
                 : typingContext parserLocalDeclarationIR*
  hint(input %0 %1)
  hint(prose_in "typing" %1#", under typing context" %0)
  hint(prose_out "the updated typing context" %2 "and the typed parser local declarations" %3)

;;
;;;; Control typing
;;

relation TableKey_ok:
  typingContext tableContext |- tableKey : tableContext tableKeyIR
  hint(input %0 %1 %2)
  hint(prose_in "typing" %2#", under typing context" %0 "and table context" %1)
  hint(prose_out "the updated table context" %3 "and the typed table key" %4)

relation TableKeys_ok:
  typingContext tableContext |- tableKey* : tableContext tableKeyListIR
  hint(input %0 %1 %2)
  hint(prose_in "typing" %2#", under typing context" %0 "and table context" %1)
  hint(prose_out "the updated table context" %3 "and the typed table keys" %4)

relation Call_action_partial_ok:
  typingContext |- parameterIR* `@ argumentListIR
                 : parameterIR* `, parameterIR* `@ argumentListIR
  hint(input %0 %1 %2)
  hint(prose_in "typing" %2#", under typing context" %0)
  hint(prose_out "the typed argument list" %3)

relation TableAction_ok:
