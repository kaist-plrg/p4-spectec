                        : typingContext variableDeclarationIR
  hint(input %0 %1 %2)
  hint(prose_in "typing" %2#", under cursor" %0 "and typing context" %1)
  hint(prose_out "the updated typing context" %3 "and" %4)

relation ConstDecl_ok:
  cursor typingContext |- constantDeclaration
                        : typingContext constantDeclarationIR
  hint(input %0 %1 %2)
  hint(prose_in "typing" %2#", under cursor" %0 "and typing context" %1)
  hint(prose_out "the updated typing context" %3 "and" %4)

relation InstDecl_ok:
  cursor typingContext |- instantiation
                        : typingContext instantiationIR
  hint(input %0 %1 %2)
  hint(prose_in "typing" %2#", under cursor" %0 "and typing context" %1)
  hint(prose_out "the updated typing context" %3 "and" %4)

relation FuncDecl_ok:
  cursor typingContext |- functionDeclaration
                        : typingContext functionDeclarationIR
  hint(input %0 %1 %2)
  hint(prose_in "typing" %2#", under cursor" %0 "and typing context" %1)
  hint(prose_out "the updated typing context" %3 "and" %4)

relation ActionDecl_ok:
  cursor typingContext |- actionDeclaration
                        : typingContext actionDeclarationIR
  hint(input %0 %1 %2)
  hint(prose_in "typing" %2#", under cursor" %0 "and typing context" %1)
  hint(prose_out "the updated typing context" %3 "and" %4)

relation Decl_ok:
  typingContext |- declaration : typingContext declarationIR
  hint(input %0 %1)
  hint(prose_in "typing" %1 "under typing context" %0)
  hint(prose_out "the updated typing context" %2 "and" %3)

relation Decls_ok:
  typingContext |- declaration* : typingContext declarationIR*
  hint(input %0 %1)
  hint(prose_in "typing" %1 "under typing context" %0)
  hint(prose_out "the updated typing context" %2 "and" %3)

relation Program_ok:
  |- p4program : p4programIR
  hint(input %0)
  hint(prose_in "typing" %0)
  hint(prose_out "the typed P4 program" %1)

;;
;;;; Call/instantiation convention
;;

;; Checks the copy-in/out calling convention,
;; and inserts implicit casts for arguments, if necessary
;; note that it depends on whether an action is being called or not

syntax actctxt = ACTION | NOACTION

relation Call_convention_expr_ok:
  cursor typingContext actctxt |- parameterIR `@ typedExpressionIR
                                : typedExpressionIR
  hint(input %0 %1 %2 %3 %4)
  hint(prose_in "checking the calling convention of" %4 "applied to parameter type" %3
             #", under cursor" %0#", typing context" %1 #", and action context" %2)

relation Call_convention_argument_ok:
  cursor typingContext actctxt |- parameterIR `@ argumentIR
                                : argumentIR
  hint(input %0 %1 %2 %3 %4)
  hint(prose_in "checking the calling convention of" %4 "applied to parameter type" %3
             #", under cursor" %0#", typing context" %1 #", and action context" %2)

relation Call_convention_ok:
  cursor typingContext actctxt |- parameterIR* `@ argumentListIR
                                : argumentListIR
  hint(input %0 %1 %2 %3 %4)
  hint(prose_in "checking the calling convention of" %4 "applied to parameter types" %3
             #", under cursor" %0#", typing context" %1 #", and action context" %2)

;;
;;;; Callable typing
;;

;; Finds the type of a callable target,
;; inserts fresh type variables for parameters with don't care types, (typeId*)
;; and also identifies the ids of default arguments (id*)

dec $is_static_callableTarget(callableTargetIR) : ctk

def $is_static_callableTarget(`. "static_assert") = LCTK
def $is_static_callableTarget(`` "static_assert") = LCTK
def $is_static_callableTarget(_ `. nameIR) = LCTK
  -- if nameIR <- [ "minSizeInBits", "minSizeInBytes",
                    "maxSizeInBits", "maxSizeInBytes" ]
def $is_static_callableTarget(TYPE _ `. nameIR) = LCTK
  -- if nameIR <- [ "minSizeInBits", "minSizeInBytes",
                    "maxSizeInBits", "maxSizeInBytes" ]
def $is_static_callableTarget(_) = DYN
  -- otherwise

dec $is_static_assert_callableTarget(callableTargetIR) : bool
def $is_static_assert_callableTarget(`. "static_assert") = true
def $is_static_assert_callableTarget(`` "static_assert") = true
def $is_static_assert_callableTarget(`( callableTargetIR ))
  = $is_static_assert_callableTarget(callableTargetIR)
def $is_static_assert_callableTarget(_) = false
  -- otherwise

relation CallableTarget_ok:
  cursor typingContext |- callableTarget : callableTargetIR
  hint(input %0 %1 %2)
  hint(prose_in "typing" %2#", under cursor" %0 "and typing context" %1)
  hint(prose_out "the typed callable target" %3)

relation CallableTarget_lvalue_ok:
  cursor typingContext |- lvalue : callableTargetIR
  hint(input %0 %1 %2)
  hint(prose_in "typing" %2#", under cursor" %0 "and typing context" %1)
  hint(prose_out "the typed callable target" %3)

relation CallableType_ok:
  cursor typingContext |- callableTargetIR `< typeArgumentListIR > `( argumentIR* )
                        : callableTypeIR `< `# typeId* > `( `# id* )
  hint(input %0 %1 %2 %3 %4)
  hint(prose_in "finding the type of" %2 `< %3 > `( %4 ) #", under cursor" %0 "and typing context" %1)
  hint(prose_out "the callable type" %5 "with fresh type variables" %6
            "and default parameter ids" %7)

;; Checks that an action/function/method invocation is valid,
;; gets the return type,
;; infers the types of missing type arguments,
;; and inserts implicit casts for arguments, if necessary

relation Call_ok:
  cursor typingContext |- callableTypeIR `< typeArgumentListIR `# typeId* >
                            `( argumentListIR `# id* )
                        : typeIR `< typeArgumentListIR > `( argumentListIR )
  hint(input %0 %1 %2 %3 %4 %5 %6)
  hint(prose_in "typing the invocation" %2 `< %3 > `( %5 ) "with omitted type arguments"
             %4 "and omitted arguments" %6
             ", under cursor" %0 "and typing context" %1)
  hint(prose_out "the return type" %7 "with inferred type arguments" %8
             "and the casted argument list" %9)

;;
;;;; Constructor typing
;;

;; Finds the type of a constructor,
;; inserts fresh type variables for parameters with don't care types, (typeId*)
;; and also identifies the ids of default arguments (id*)

relation ConstructorType_ok:
  cursor typingContext |- prefixedNameIR `< typeArgumentListIR > `( argumentIR* )
                        : constructorTypeIR `< `# typeId* > `( `# id* )
  hint(input %0 %1 %2 %3 %4)
  hint(prose_in "type checking constructor"
                %2# `< %3 > `( %4 ) #", under cursor" %0 "and typing context" %1)
  hint(prose_out %5 "with fresh type variables" %6
                 "and default parameter ids" %7)

;; Checks that a constructor invocation is valid,
;; gets the return type,
;; infers the types of missing type arguments,
;; and inserts implicit casts for arguments, if necessary

syntax instctxt = NAMED | ANON

relation Inst_ok:
  cursor typingContext instctxt |- constructorTypeIR
                                    `< typeArgumentListIR `# typeId* > `( argumentListIR `# id* )
                                 : typeIR
                                    `< typeArgumentListIR > `( argumentListIR )
  hint(input %0 %1 %2 %3 %4 %5 %6 %7)
  hint(prose_in "typing the instantiation" %3 `< %4 > `( %6 ) "with omitted type arguments"
             %5 "and omitted arguments" %7
             ", under cursor" %0#", typing context" %1
             #", and" %2 "instantiation site context")
