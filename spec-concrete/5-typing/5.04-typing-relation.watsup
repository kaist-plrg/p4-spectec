  hint(prose_in "typing" %2#", under typing context" %0 "and table context" %1)
  hint(prose_out "the updated table context" %3 "and the typed table action" %4)

relation TableActions_ok:
  typingContext tableContext |- tableAction* : tableContext tableActionListIR
