  hint(prose_in "typing" %2#", under typing context" %0 "and table context" %1)
  hint(prose_out "the updated table context" %3 "and the typed table actions" %4)

relation Call_action_default_ok:
  typingContext |- parameterIR* `@ argumentListIR
                 : parameterIR* `, parameterIR* `@ argumentListIR
  hint(input %0 %1 %2)
  hint(prose_in "typing" %2#", under typing context" %0)
  hint(prose_out "the typed argument list" %3)

relation TableDefaultAction_ok:
  typingContext tableContext |- initializer : tableActionReferenceIR
  hint(input %0 %1 %2)
  hint(prose_in "typing" %2#", under typing context" %0 "and table context" %1)
  hint(prose_out "the typed default action" %3)

relation TableEntry_keyset_ok:
  typingContext tableContext |- keysetExpression : tableEntryState keysetExpressionIR
  hint(input %0 %1 %2)
  hint(prose_in "typing" %2#", under typing context" %0 "and table context" %1)
  hint(prose_out "the updated table context" %3 "and the typed keyset expression" %4)

relation TableEntry_action_ok:
  typingContext tableContext |- tableActionReference : tableActionReferenceIR
  hint(input %0 %1 %2)
  hint(prose_in "typing" %2#", under typing context" %0 "and table context" %1)
  hint(prose_out "the typed table action reference" %3)

relation TableEntry_priority_ok:
  typingContext tableContext tableEntryState |- tableEntryPriority?
                                              : tableContext tableEntryPriorityOptIR
  hint(input %0 %1 %2 %3)
  hint(prose_in "typing" %3#", under typing context" %0 "and table context" %1
             #", and table entry state" %2)
  hint(prose_out "the updated table context" %4 "and the typed table entry priority" %5)

relation TableEntry_ok:
  typingContext tableContext |- tableEntry : tableContext tableEntryIR
  hint(input %0 %1 %2)
  hint(prose_in "typing" %2#", under typing context" %0 "and table context" %1)
  hint(prose_out "the updated table context" %3 "and the typed table entry" %4)

relation TableEntries_ok:
  typingContext tableContext |- tableEntry* : tableContext tableEntryListIR
  hint(input %0 %1 %2)
  hint(prose_in "typing" %2#", under typing context" %0 "and table context" %1)
  hint(prose_out "the updated table context" %3 "and the typed table entries" %4)

relation TableProperty_ok:
  typingContext tableContext |- tableProperty : tableContext tablePropertyIR
  hint(input %0 %1 %2)
  hint(prose_in "typing" %2#", under typing context" %0 "and table context" %1)
  hint(prose_out "the updated table context" %3 "and the typed table property" %4)

relation TableProperties_ok:
  typingContext tableContext |- tableProperty* : tableContext tablePropertyListIR
  hint(input %0 %1 %2)
  hint(prose_in "typing" %2#", under typing context" %0 "and table context" %1)
  hint(prose_out "the updated table context" %3 "and the typed table properties" %4)

relation Table_ok:
  typingContext |- tableProperty* : tableContext tablePropertyListIR
  hint(input %0 %1)
  hint(prose_in "typing" %1#", under typing context" %0)
  hint(prose_out "the updated typing context" %2 "and the typed table" %3)

relation TableType_ok:
  typingContext tableContext |- name : typingContext typeIR
  hint(input %0 %1 %2)
  hint(prose_in "typing" %2#", under typing context" %0 "and table context" %1)
  hint(prose_out "the updated typing context" %3 "and the table type" %4)

relation ControlLocalDecl_ok:
  typingContext |- controlLocalDeclaration
                 : typingContext controlLocalDeclarationIR
  hint(input %0 %1)
  hint(prose_in "typing" %1#", under typing context" %0)
  hint(prose_out "the updated typing context" %2 "and the typed control local declaration" %3)

relation ControlLocalDecls_ok:
  typingContext |- controlLocalDeclaration*
           : typingContext controlLocalDeclarationIR*
  hint(input %0 %1)
  hint(prose_in "typing" %1#", under typing context" %0)
  hint(prose_out "the updated typing context" %2 "and the typed control local declarations" %3)

;;
;;;; Declaration typing
;;

relation Decl_ok:
  cursor typingContext |- declaration : typingContext declarationIR
  hint(input %0 %1 %2)
  hint(prose_in "typing" %2#", under cursor" %0 "and typing context" %1)
  hint(prose_out "the modified typing context" %3 "and the typed declaration" %4)

relation Decls_ok:
  cursor typingContext |- declaration* : typingContext declarationIR*
  hint(input %0 %1 %2)
  hint(prose_in "typing" %2#", under cursor" %0 "and typing context" %1
             #",\nand the modified typing context")
  hint(prose_out "the modified typing context" %3 "and the typed declarations" %4)

relation Program_ok:
  |- p4program : p4programIR
  hint(input %0)
  hint(prose_in "typing" %0)
  hint(prose_out "the typed P4 program" %1)

;;
;;;; Call/instantiation convention
;;

;; Checks the copy-in/out calling convention,
;; and inserts implicit casts for arguments, if necessary
;; note that it depends on whether an action is being called or not

syntax actctxt = ACTION | NOACTION

relation Call_convention_expr_ok:
  cursor typingContext actctxt |- parameterIR `@ typedExpressionIR
                                : typedExpressionIR
  hint(input %0 %1 %2 %3 %4)
  hint(prose_in "checking the calling convention of" %4 "applied to parameter type" %3
             #", under cursor" %0#", typing context" %1 #", and action context" %2)

relation Call_convention_argument_ok:
  cursor typingContext actctxt |- parameterIR `@ argumentIR
                                : argumentIR
  hint(input %0 %1 %2 %3 %4)
  hint(prose_in "checking the calling convention of" %4 "applied to parameter type" %3
             #", under cursor" %0#", typing context" %1 #", and action context" %2)

relation Call_convention_ok:
  cursor typingContext actctxt |- parameterIR* `@ argumentListIR
                                : argumentListIR
  hint(input %0 %1 %2 %3 %4)
  hint(prose_in "checking the calling convention of" %4 "applied to parameter types" %3
             #", under cursor" %0#", typing context" %1 #", and action context" %2)

;;
;;;; Callable typing
;;

;; Finds the type of a callable target,
;; inserts fresh type variables for parameters with don't care types, (typeId*)
;; and also identifies the ids of default arguments (id*)

dec $is_static_callableTarget(callableTargetIR) : ctk

def $is_static_callableTarget(`. "static_assert") = LCTK
def $is_static_callableTarget(`` "static_assert") = LCTK
def $is_static_callableTarget(_ `. nameIR) = LCTK
  -- if nameIR <- [ "minSizeInBits", "minSizeInBytes",
                    "maxSizeInBits", "maxSizeInBytes" ]
def $is_static_callableTarget(TYPE _ `. nameIR) = LCTK
  -- if nameIR <- [ "minSizeInBits", "minSizeInBytes",
                    "maxSizeInBits", "maxSizeInBytes" ]
def $is_static_callableTarget(_) = DYN
  -- otherwise

relation CallableTarget_ok:
  cursor typingContext |- callableTarget : callableTargetIR
  hint(input %0 %1 %2)
  hint(prose_in "typing" %2#", under cursor" %0 "and typing context" %1)
  hint(prose_out "the typed callable target" %3)

relation CallableTarget_lvalue_ok:
  cursor typingContext |- lvalue : callableTargetIR
  hint(input %0 %1 %2)
  hint(prose_in "typing" %2#", under cursor" %0 "and typing context" %1)
  hint(prose_out "the typed callable target" %3)

relation CallableType_ok:
  cursor typingContext |- callableTargetIR `< typeArgumentListIR > `( argumentIR* )
                        : callableTypeIR `< `# typeId* > `( `# id* )
  hint(input %0 %1 %2 %3 %4)

;; Checks that an action/function/method invocation is valid,
;; gets the return type,
;; infers the types of missing type arguments,
;; and inserts implicit casts for arguments, if necessary

relation Call_ok:
  cursor typingContext |- callableTypeIR `< typeArgumentListIR `# typeId* >
                            `( argumentListIR `# id* )
                        : typeIR `< typeArgumentListIR > `( argumentListIR )
  hint(input %0 %1 %2 %3 %4 %5 %6)

;;
;;;; Constructor typing
;;

;; Finds the type of a constructor,
;; inserts fresh type variables for parameters with don't care types, (typeId*)
;; and also identifies the ids of default arguments (id*)

relation ConstructorType_ok:
  cursor typingContext |- prefixedNameIR `< typeArgumentListIR > `( argumentIR* )
                        : constructorTypeIR `< `# typeId* > `( `# id* )
  hint(input %0 %1 %2 %3 %4)

;; Checks that a constructor invocation is valid,
;; gets the return type,
;; infers the types of missing type arguments,
;; and inserts implicit casts for arguments, if necessary

syntax instctxt = NAMED | ANON

relation Inst_ok:
  cursor typingContext instctxt |- constructorTypeIR
                                    `< typeArgumentListIR `# typeId* > `( argumentListIR `# id* )
                                 : typeIR
                                    `< typeArgumentListIR > `( argumentListIR )
  hint(input %0 %1 %2 %3 %4 %5 %6 %7)
