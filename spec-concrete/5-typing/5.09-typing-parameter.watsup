;;
;; Parameter typing
;;
;; syntax parameter =
;;  annotationList direction type name initializerOpt
;;

;;; syntax initializerOpt

;;;; `EMPTY
;;;; initializer

rulegroup Parameter_ok {

  rule Parameter_ok/non-initializer:
    p TC |- annotationList direction type name `EMPTY
          : (annotationList direction typeIR nameIR eps) `# typeId_fresh*
    -- Type_ok: p TC |- type : typeIR `# typeId_fresh*
    -- if B = $union_set<typeId>($bound(p, TC), `{ typeId_fresh* })
    -- Type_wf: B |- typeIR
    -- if nameIR = $name(name)

  rule Parameter_ok/initializer:
    p TC |- annotationList direction type name (`= expression_init)
          : (annotationList direction typeIR nameIR (`= value_init))
              `# typeId_fresh*
    ---- ;; check parameter type
    -- Type_ok: p TC |- type : typeIR `# typeId_fresh*
    -- if B = $union_set<typeId>($bound(p, TC), `{ typeId_fresh* })
    -- Type_wf: B |- typeIR
    ---- ;; check initializer
    -- Expr_ok: p TC |- expression_init : typedExpressionIR_init
    -- if typeIR_init = $type_of_typedExpressionIR(typedExpressionIR_init)
    -- if LCTK = $ctk_of_typedExpressionIR(typedExpressionIR_init)
    ---- ;; check that the initializer type is
    ---- ;; compatible with the parameter type
    ---- ;; while inserting implicit casts if necessary
    -- if typedExpressionIR_init_cast
        = $coerce_unary(typedExpressionIR_init, typeIR)
    -- if nameIR = $name(name)
    ---- ;; evaluate the initializer
    -- Expr_eval_lctk: p TC |- typedExpressionIR_init_cast ~> value_init

}

;;
;; Parameter list typing
;;
;; syntax parameterList
;;

rule Parameters_ok/nil:
  p TC |- eps : eps `# eps

rule Parameters_ok/cons:
  p TC |- parameter_h :: parameter_t*
        : (parameterIR_h :: parameterIR_t*) `# (typeId_fresh_h* ++ typeId_fresh_t*)
  -- Parameter_ok: p TC |- parameter_h : parameterIR_h `# typeId_fresh_h*
  -- Parameters_ok: p TC |- parameter_t* : parameterIR_t* `# typeId_fresh_t*

;;
;; Constructor typing
;;
;; syntax constructorParameter
;;

rule ConstructorParameter_ok:
  p TC |- constructorParameter : constructorParameterIR `# typeId_fresh*
  -- Parameter_ok: p TC |- constructorParameter
                         : constructorParameterIR `# typeId_fresh*

;;
;; Constructor list typing
;;
;; syntax constructorParameterList
;;

rule ConstructorParameters_ok:
  p TC |- constructorParameter* : constructorParameterIR* `# typeId_fresh*
  -- Parameters_ok: p TC |- constructorParameter*
                          : constructorParameterIR* `# typeId_fresh*
