;;
;; Constructors
;;

syntax constructor =
  | EXTERN nameIR `< typeParameterListIR >
      `( constructorParameterListIR )
      `{ externMethodPrototypeListIR }
  | PARSER `( parameterListIR )
      `( constructorParameterListIR )
      `{ parserLocalDeclarationListIR
         parserStateListIR }
  | CONTROL `( parameterListIR )
      `( constructorParameterListIR )
      `{ controlLocalDeclarationListIR
         APPLY controlBodyIR }
  | PACKAGE `< typeParameterListIR >
      `( constructorParameterListIR )
  | TABLE nameIR `{ tablePropertyListIR }
