;;
;; Constructors
;;

syntax constructor =
  | EXTERN nameIR `< typeParameterListIR >
    `( constructorParameterListIR ) `{ methodPrototypeListIR }
  | PARSER `< typeParameterListIR > `( parameterListIR )
    `( constructorParameterListIR ) `{ parserLocalDeclarationListIR parserStateListIR }
  | CONTROL `< typeParameterListIR > `( parameterListIR )
    `( constructorParameterListIR ) `{ controlLocalDeclarationListIR APPLY controlBodyIR }
  | PACKAGE `< typeParameterListIR > `( constructorParameterListIR )
  | TABLE nameIR `{ tablePropertyListIR }
