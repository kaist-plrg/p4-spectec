;;
;; Checkers for type properties
;;

;;; Nominal

dec $is_nominal_typeIR(typeIR) : bool
tbl dec $is_nominal_typeIR'(typeIR) : bool

def $is_nominal_typeIR(typeIR)
  = $is_nominal_typeIR'($canon_typeIR(typeIR))
tbl def $is_nominal_typeIR' =
  | newTypeIR => true
  | structTypeIR => true
  | headerTypeIR => true
  | headerUnionTypeIR => true
  | enumTypeIR => true
  | externObjectTypeIR => true
  | tableObjectTypeIR => true
  | _ => false

;; Default

dec $is_defaultable_typeIR(typeIR) : bool
tbl dec $is_defaultable_typeIR'(typeIR) : bool

def $is_defaultable_typeIR(typeIR)
  = $is_defaultable_typeIR'($canon_typeIR(typeIR))
tbl def $is_defaultable_typeIR' =
  | BOOL => true
  | ERROR => true
  | STRING => true
  | numberTypeIR => true
  | TYPE _ typeIR => $is_defaultable_typeIR(typeIR)
  | TUPLE `< typeIR* > => $forall_($is_defaultable_typeIR(typeIR)*)
  | typeIR `[ _ ] => $is_defaultable_typeIR(typeIR)
  | STRUCT _ `{ (typeIR _ `;)* } => $forall_($is_defaultable_typeIR(typeIR)*)
  | HEADER _ `{ (typeIR _ `;)* } => $forall_($is_defaultable_typeIR(typeIR)*)
  | HEADER_UNION _ `{ (typeIR _ `;)* } => $forall_($is_defaultable_typeIR(typeIR)*)
  | ENUM _ `{ _ } => true
  | ENUM _ `< typeIR > `{ _ } => $is_defaultable_typeIR(typeIR)
  | _ => false

;; Equals

dec $is_equalable_typeIR(typeIR) : bool
tbl dec $is_equalable_typeIR'(typeIR) : bool

def $is_equalable_typeIR(typeIR)
  = $is_equalable_typeIR'($canon_typeIR(typeIR))
tbl def $is_equalable_typeIR' =
  | VOID => false
  | `` tid => false
  | externObjectTypeIR => false
  | parserObjectTypeIR => false
  | controlObjectTypeIR => false
  | packageObjectTypeIR => false
  | tableObjectTypeIR => false
  | DEFAULT => false
  | SEQ `< _ `, `... > => false
  | RECORD `{ _ `, `... } => false
  | HEADER_INVALID => false
  | setTypeIR => false
  | tableMetadataTypeIR => false
  | _ => true

;; Assignable

dec $is_assignable_typeIR(typeIR) : bool
tbl dec $is_assignable_typeIR'(typeIR) : bool

def $is_assignable_typeIR(typeIR)
  = $is_assignable_typeIR'($canon_typeIR(typeIR))
tbl def $is_assignable_typeIR' =
  | VOID => false
  | STRING => false
  | INT => false
  | objectTypeIR => false
  | synthesizedTypeIR => false
  | _ => true
