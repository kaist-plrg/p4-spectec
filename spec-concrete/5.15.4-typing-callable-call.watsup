;;
;; Callable target typing
;;
;; syntax callableTarget = expression
;;

;;; referenceExpression
;;; syntax referenceExpression

;;;; prefixedNonTypeName
;;;; THIS

rulegroup CallableTarget_ok/referenceExpression {

  rule CallableTarget_ok/prefixedNonTypeName:
    p TC |- prefixedNonTypeName : prefixedNameIR
    -- if prefixedNameIR = $prefixedNonTypeName(prefixedNonTypeName)
    ---- ;; call to "verify" is only allowed in parsers
    -- if ((prefixedNameIR = `` "verify") \/ (prefixedNameIR = `. "verify"))
          => ((p = BLOCK /\ $is_parser_blockKind(TC.BLOCK.KIND))
               \/ (p = LOCAL /\ $is_parser_state_localKind(TC.LOCAL.KIND))) 

  rule CallableTarget_ok/this:
    p TC |- THIS : (`` "this")

}

;;; memberAccessExpression
;;; syntax memberAccessExpression = memberAccessBase `. member
;;;; syntax memberAccessBase

;;;;; prefixedTypeName
;;;;; expression

rulegroup CallableTarget_ok/memberAccessExpression {

  rule CallableTarget_ok/memberAccessExpression-prefixedTypeName:
    p TC |- prefixedTypeName `. member : TYPE prefixedNameIR `. nameIR
    -- if prefixedNameIR = $prefixedTypeName(prefixedTypeName)
    -- if nameIR = $name(member)

  rule CallableTarget_ok/memberAccessExpression-expression:
    p TC |- expression_base `. member : typedExpressionIR_base `. nameIR
    -- if nameIR = $name(member)
    -- Expr_ok: p TC |- expression_base : typedExpressionIR_base

}

;;;;; syntax parenthesizedExpression = `( expression )

rule CallableTarget_ok/parenthesizedExpression:
  p TC |- `( expression ) : `( callableTargetIR )
  -- CallableTarget_ok: p TC |- expression : callableTargetIR

;;
;; Callable target typing (when used as a lvalue)
;;
;; syntax lvalue
;;

rule CallableTarget_lvalue_ok:
  p TC |- lvalue : callableTargetIR
  -- if expression = $lvalue_as_expression(lvalue)
  -- CallableTarget_ok: p TC |- expression : callableTargetIR

;;
;; Callable call typing
;; 
;; syntax callableTargetIR
;;

;;; referenceExpressionIR
;;; syntax referenceExpressionIR = prefixedNameIR

rulegroup CallableType_ok/referenceExpressionIR {

  rule CallableType_ok/actionTypeIR:
    p TC |- prefixedNameIR `< eps > `( argumentIR* )
          : actionTypeIR `< `# eps > `( `# id_default* )
    ---- ;; find the action type definition
    -- if (cid, actionTypeIR, id_default*)
        = $find_callableDef_overloaded_t(
            p, TC, prefixedNameIR, argumentIR*
          )
    ---- ;; check that the action type is well-formed
    -- CallableType_wf: $bound(p, TC) |- actionTypeIR

  rule CallableType_ok/functionTypeIR:
    p TC |- prefixedNameIR `< typeArgumentIR* > `( argumentIR* )
          : functionTypeIR `< `# tid_impl* > `( `# id_default* )
    ---- ;; find and specialize the function type definition
    -- if (cid, functionTypeDefIR, id_default*)
        = $find_callableDef_overloaded_t(
            p, TC, prefixedNameIR, argumentIR*
          )
    -- if (functionTypeIR, tid_impl*)
        = $specialize_callableTypeDefIR(
            functionTypeDefIR, typeArgumentIR*
          )
    ---- ;; check that the function type is well-formed
    -- if bound = $union_set<tid>($bound(p, TC), `{ tid_impl* })
    -- CallableType_wf: bound |- functionTypeIR

}

;;; typedLvalueIR `. nameIR

rule CallableType_ok/typedExpressionIR-nameIR-builtin-method-minmax-SizeIn-BitsBytes:
  p TC |- (typedExpressionIR_base `. nameIR) `< eps > `( eps )
        : methodTypeIR `< `# eps > `( `# eps )
  ---- ;; if the method is min/maxSizeInBits/Bytes builtin
  -- if nameIR <- [ "minSizeInBits", "minSizeInBytes",
                    "maxSizeInBits", "maxSizeInBytes" ]
  ---- ;; create callable type
  -- if methodTypeIR = BUILTIN_METHOD `( eps ) `: INT

rule CallableType_ok/typedExpressionIR-nameIR-builtin-method-stack-push-pop-front:
  p TC |- (typedExpressionIR_base `. nameIR) `< eps > `( argumentIR )
        : methodTypeIR `< `# eps > `( `# eps )
  ---- ;; if the method is push/pop_front builtin
  -- if nameIR <- [ "push_front", "pop_front" ]
  ---- ;; check that the base type is a stack
  -- if typeIR_base = $typeIR_of_typedExpressionIR(typedExpressionIR_base)
  -- if typeIR `[ _ ] = $canon_typeIR(typeIR_base)
  ---- ;; (TODO) check if the argument is named
  ---- ;; create callable type
  -- if parameterTypeIR = `EMPTY INT "count" eps
  -- if methodTypeIR = BUILTIN_METHOD `( parameterTypeIR ) `: INT

rule CallableType_ok/typedExpressionIR-nameIR-builtin-method-header-isValid:
  p TC |- (typedExpressionIR_base `. nameIR) `< eps > `( eps )
        : methodTypeIR `< `# eps > `( `# eps )
  ---- ;; if the method is isValid builtin
  -- if nameIR <- [ "isValid" ]
  ---- ;; check that the base type is a header
  -- if typeIR_base = $typeIR_of_typedExpressionIR(typedExpressionIR_base)
  -- if HEADER _ `{ _ } = $canon_typeIR(typeIR_base)
  ---- ;; create callable type
  -- if methodTypeIR = BUILTIN_METHOD `( eps ) `: BOOL

rule CallableType_ok/typedExpressionIR-nameIR-builtin-method-union-isValid:
  p TC |- (typedExpressionIR_base `. nameIR) `< eps > `( eps )
        : methodTypeIR `< `# eps > `( `# eps )
  ---- ;; if the method is isValid builtin
  -- if nameIR <- [ "isValid" ]
  ---- ;; check that the base type is a header
  -- if typeIR_base = $typeIR_of_typedExpressionIR(typedExpressionIR_base)
  -- if HEADER_UNION _ `{ _ } = $canon_typeIR(typeIR_base)
  ---- ;; create callable type
  -- if methodTypeIR = BUILTIN_METHOD `( eps ) `: BOOL

rule CallableType_ok/typedExpressionIR-nameIR-builtin-method-header-set-ValidInvalid:
  p TC |- (typedExpressionIR_base `. nameIR) `< eps > `( eps )
        : methodTypeIR `< `# eps > `( `# eps )
  ---- ;; if the method is setValid/Invalid builtin
  -- if nameIR <- [ "setValid", "setInvalid" ]
  ---- ;; check that the base type is a header
  -- if typeIR_base = $typeIR_of_typedExpressionIR(typedExpressionIR_base)
  -- if HEADER _ `{ _ } = $canon_typeIR(typeIR_base)
  ---- ;; create callable type
  -- if methodTypeIR = BUILTIN_METHOD `( eps ) `: VOID

rule CallableType_ok/typedExpressionIR-nameIR-extern-method:
  p TC |- (typedExpressionIR_base `. nameIR) `< typeArgumentIR* > `( argumentIR* )
        : externMethodTypeIR `< `# tid_impl* > `( `# id_default* )
  ---- ;; if the base type is an extern
  -- if typeIR_base = $typeIR_of_typedExpressionIR(typedExpressionIR_base)
  -- if EXTERN _ `{ (cid_extern `: externMethodTypeDefIR_extern)* }
      = $canon_typeIR(typeIR_base)
  ---- ;; find method type
  -- if (id_arg?)* = $ids_arguments(argumentIR*)
  -- if (_, externMethodTypeDefIR, id_default*)
      = $find_overloaded<externMethodTypeDefIR>(
          `{ (cid_extern `: externMethodTypeDefIR_extern)* },
          nameIR,
          (id_arg?)*)
  ---- ;; specialize callable type
  -- if (externMethodTypeIR, tid_impl*)
      = $specialize_callableTypeDefIR(
          externMethodTypeDefIR, typeArgumentIR*
        )
  ---- ;; check that the callable type is well-formed
  -- if bound = $union_set<tid>($bound(p, TC), `{ tid_impl* })
  -- CallableType_wf: bound |- externMethodTypeIR

rule CallableType_ok/typedExpressionIR-nameIR-parser-apply-method:
  p TC |- (typedExpressionIR_base `. "apply") `< eps > `( argumentIR* )
        : parserApplyMethodTypeIR `< `# eps > `( `# id_default* )
  ---- ;; if the base type is a parser 
  -- if typeIR_base = $typeIR_of_typedExpressionIR(typedExpressionIR_base)
  -- if PARSER `( parameterTypeIR* ) = $canon_typeIR(typeIR_base)
  ---- ;; create method type
  -- if parserApplyMethodTypeIR = PARSER_APPLY `( parameterTypeIR* )
  ---- ;; create callable id
  -- if (_ _ id_param value_param? = parameterTypeIR)*
  -- if (pid = id_param `# (value_param? =/= eps))*
  -- if cid = "apply" `( pid* )
  ---- ;; perform overload resoultion
  -- if (id_arg?)* = $ids_arguments(argumentIR*)
  -- if (_, parserApplyMethodTypeIR, id_default*)
      = $find_overloaded<parserApplyMethodTypeIR>(
          `{ (cid `: parserApplyMethodTypeIR) },
          "apply",
          (id_arg?)*)

rule CallableType_ok/typedExpressionIR-nameIR-control-apply-method:
  p TC |- (typedExpressionIR_base `. "apply") `< eps > `( argumentIR* )
        : controlApplyMethodTypeIR `< `# eps > `( `# id_default* )
  ---- ;; if the base type is a control 
  -- if typeIR_base = $typeIR_of_typedExpressionIR(typedExpressionIR_base)
  -- if CONTROL `( parameterTypeIR* ) = $canon_typeIR(typeIR_base)
  ---- ;; create method type
  -- if controlApplyMethodTypeIR = CONTROL_APPLY `( parameterTypeIR* )
  ---- ;; create callable id
  -- if (_ _ id_param value_param? = parameterTypeIR)*
  -- if (pid = id_param `# (value_param? =/= eps))*
  -- if cid = "apply" `( pid* )
  ---- ;; perform default resoultion
  -- if (id_arg?)* = $ids_arguments(argumentIR*)
  -- if (_, controlApplyMethodTypeIR, id_default*)
      = $find_overloaded<controlApplyMethodTypeDefIR>(
          `{ (cid `: controlApplyMethodTypeIR) },
          "apply",
          (id_arg?)*)

rule CallableType_ok/typedExpressionIR-nameIR-table-apply-method:
  p TC |- (typedExpressionIR_base `. "apply") `< eps > `( eps )
        : tableApplyMethodTypeIR `< `# eps > `( `# eps )
  ---- ;; if the base type is a table
  -- if typeIR_base = $typeIR_of_typedExpressionIR(typedExpressionIR_base)
  -- if TABLE _ `{ typeIR_table } = $canon_typeIR(typeIR_base)
  ---- ;; create method type
  -- if tableApplyMethodTypeIR = TABLE_APPLY `: typeIR_table

;;; TYPE prefixedNameIR `. nameIR

;;; `( callableTargetIR )

rule CallableType_ok/parenthesized:
  p TC |- (`( callableTargetIR )) `< typeArgumentIR* > `( argumentIR* )
        : callableTypeIR `< `# tid_inserted* > `( `# id_default* )
  -- CallableType_ok:
      p TC |- callableTargetIR `< typeArgumentIR* > `( argumentIR* )
            : callableTypeIR `< `# tid_inserted* > `( `# id_default* )

;;
;; Call typing
;;

;;; Action call

;;;; syntax actionTypeIR =
;;;;  ACTION `( parameterTypeIR* )

dec $callable_action(cursor, typingContext) : bool

def $callable_action(GLOBAL, TC) = false
def $callable_action(BLOCK, TC) = false
def $callable_action(LOCAL, TC)
  = $is_action_localKind(TC.LOCAL.KIND)
    \/ $is_control_apply_method_localKind(TC.LOCAL.KIND)

rule Call_ok/action:
  p TC |- (ACTION `( parameterTypeIR* ))
            `< eps `# eps > `( argumentIR* `# id_default* )
        : VOID `< eps > `( argumentIR_cast* )
  ---- ;; filter default arguments
  -- if parameterTypeIR_non_default*
      = $filter_default_parameterTypeIRs(parameterTypeIR*, id_default*)
  ---- ;; check arity
  -- if $(|parameterTypeIR_non_default*| = |argumentIR*|)
  ---- ;; align parameters and arguments if named
  -- if parameterTypeIR_aligned*
      = $align_parameterTypeIRs(parameterTypeIR_non_default*, argumentIR*)
  ---- ;; check call site
  -- if $callable_action(p, TC)
  ---- ;; check call convention
  -- Call_convention_ok:
      p TC ACTION |- parameterTypeIR_aligned* `@ argumentIR*
                   : argumentIR_cast*

;;; Function call
;;; syntax functionTypeIR

;;;; definedFunctionTypeIR
;;;; syntax definedFunctionTypeIR =
;;;;  FUNCTION `( parameterTypeIR* ) `: typeIR

dec $callable_definedFunction(cursor, typingContext) : bool

def $callable_definedFunction(GLOBAL, TC) = false
def $callable_definedFunction(BLOCK, TC)
  = $is_parser_blockKind(TC.BLOCK.KIND)
    \/ $is_control_blockKind(TC.BLOCK.KIND)
def $callable_definedFunction(LOCAL, TC)
  = ~$is_extern_method_localKind(TC.LOCAL.KIND)
    /\ ~$is_extern_abstract_method_localKind(TC.LOCAL.KIND)

rule Call_ok/definedFunctionTypeIR:
  p TC |- (FUNCTION `( parameterTypeIR* ) `: typeIR_ret)
          `< typeArgumentIR* `# tid_infer* > `( argumentIR* `# id_default* )
        : typeIR_ret_inferred `< typeArgumentIR_inferred* > `( argumentIR_cast* )
  ---- ;; filter default arguments
  -- if parameterTypeIR_non_default*
      = $filter_default_parameterTypeIRs(parameterTypeIR*, id_default*)
  ---- ;; check arity
  -- if $(|parameterTypeIR_non_default*| = |argumentIR*|)
  ---- ;; align parameters and arguments if named
  -- if parameterTypeIR_aligned*
      = $align_parameterTypeIRs(parameterTypeIR_non_default*, argumentIR*)
  ---- ;; perform type inference
  -- if inference = $infer(tid_infer*, parameterTypeIR_aligned*, argumentIR*)
  -- if (typeIR_inferred = $find_map<tid, typeIR>(inference, tid_infer))*
  -- if typeArgumentIR_inferred* = typeArgumentIR* ++ typeIR_inferred*
  ---- ;; substitute inferred types
  -- if (parameterTypeIR_aligned_inferred
        = $subst_parameterTypeIR(inference, parameterTypeIR_aligned))*
  -- if typeIR_ret_inferred
      = $subst_typeIR(inference, typeIR_ret)
  ---- ;; check that the substituted function is still well-formed
  -- if functionTypeIR_inferred
      = FUNCTION `( parameterTypeIR_aligned_inferred* ) `: typeIR_ret_inferred
  -- CallableType_wf: $bound(p, TC) |- functionTypeIR_inferred
  ---- ;; check call site
  -- if $callable_definedFunction(p, TC)
  ---- ;; check call convention
  -- Call_convention_ok:
      p TC NOACTION |- parameterTypeIR_aligned_inferred* `@ argumentIR*
                     : argumentIR_cast*

;;;; externFunctionTypeIR
;;;; syntax externFunctionTypeIR =
;;;;  EXTERN_FUNCTION `( parameterTypeIR* ) `: typeIR

dec $callable_externFunction(cursor, typingContext) : bool

def $callable_externFunction(GLOBAL, TC) = false
def $callable_externFunction(BLOCK, TC)
  = $is_parser_blockKind(TC.BLOCK.KIND)
    \/ $is_control_blockKind(TC.BLOCK.KIND)
def $callable_externFunction(LOCAL, TC) = true

rule Call_ok/externFunctionTypeIR:
  p TC |- (EXTERN_FUNCTION `( parameterTypeIR* ) `: typeIR_ret)
            `< typeArgumentIR* `# tid_infer* > `( argumentIR* `# id_default* )
        : typeIR_ret_inferred `< typeArgumentIR_inferred* > `( argumentIR_cast* )
  ---- ;; filter default arguments
  -- if parameterTypeIR_non_default*
      = $filter_default_parameterTypeIRs(parameterTypeIR*, id_default*)
  ---- ;; check arity
  -- if $(|parameterTypeIR_non_default*| = |argumentIR*|)
  ---- ;; align parameters and arguments if named
  -- if parameterTypeIR_aligned*
      = $align_parameterTypeIRs(parameterTypeIR_non_default*, argumentIR*)
  ---- ;; perform type inference
  -- if inference = $infer(tid_infer*, parameterTypeIR_aligned*, argumentIR*)
  -- if (typeIR_inferred = $find_map<tid, typeIR>(inference, tid_infer))*
  -- if typeArgumentIR_inferred* = typeArgumentIR* ++ typeIR_inferred*
  ---- ;; substitute inferred types
  -- if (parameterTypeIR_aligned_inferred
        = $subst_parameterTypeIR(inference, parameterTypeIR_aligned))*
  -- if typeIR_ret_inferred
      = $subst_typeIR(inference, typeIR_ret)
  ---- ;; check that the substituted function is still well-formed
  -- if functionTypeIR_inferred
      = EXTERN_FUNCTION `( parameterTypeIR_aligned_inferred* ) `: typeIR_ret_inferred
  -- CallableType_wf: $bound(p, TC) |- functionTypeIR_inferred
  ---- ;; check call site
  -- if $callable_externFunction(p, TC)
  ---- ;; check call convention
  -- Call_convention_ok:
      p TC NOACTION |- parameterTypeIR_aligned_inferred* `@ argumentIR*
                     : argumentIR_cast*

