  = tablePropertyList
def $unflatten_tablePropertyList'(
    tablePropertyList, tableProperty_h :: tableProperty_t*)
  = $unflatten_tablePropertyList'(
      tablePropertyList tableProperty_h,
      tableProperty_t*)

def $lift_tablePropertyIR(KEY `= `{ tableKeyIR* })
  = KEY `= `{ tableKeyList }
  -- if tableKeyList = $lift_tableKeyListIR(tableKeyIR*)

def $lift_tablePropertyIR(ACTIONS `= `{ tableActionIR* })
  = ACTIONS `= `{ tableActionList }
  -- if tableActionList = $lift_tableActionListIR(tableActionIR*)

def $lift_tablePropertyIR(
    annotationList constOptIR DEFAULT_ACTION `= tableActionReferenceIR `;)
  = annotationList constOpt (`ID "default_action") (`= expression) `;
  -- if constOpt = $lift_constOptIR(constOptIR)
  -- if expression
      = $lift_tableActionReferenceIR_as_expression(tableActionReferenceIR)

def $lift_tablePropertyIR(
    annotationList constOptIR ENTRIES `= `{ tableEntryIR* })
  = annotationList constOpt ENTRIES `= `{ tableEntryList }
  -- if constOpt = $lift_constOptIR(constOptIR)
  -- if tableEntryList
      = $lift_tableEntryListIR(tableEntryIR*)

def $lift_tablePropertyIR(
    annotationList constOptIR CUSTOM nameIR initializerIR `;)
  = annotationList constOpt tableCustomName initializer `;
  -- if constOpt = $lift_constOptIR(constOptIR)
  -- if tableCustomName = $lift_nameIR_as_tableCustomName(nameIR)
  -- if initializer = $lift_initializerIR(initializerIR)

def $lift_tablePropertyIR(tablePropertyIR) = $sink<tableProperty>()
  -- debug tablePropertyIR
  -- otherwise

def $lift_tablePropertyListIR(tablePropertyIR*)
  = tablePropertyList
  -- if (tableProperty
      = $lift_tablePropertyIR(tablePropertyIR))*
  -- if tablePropertyList
      = $unflatten_tablePropertyList(tableProperty*)

def $lift_tableDeclarationIR(
    annotationList TABLE typeIR nameIR `{ tablePropertyIR* })
  = annotationList TABLE name `{ tablePropertyList }
  -- if name = $lift_nameIR_as_nonTypeName(nameIR)
  -- if tablePropertyList
      = $lift_tablePropertyListIR(tablePropertyIR*)

