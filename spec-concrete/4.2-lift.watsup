    parserLocalDeclarationList,
    parserLocalDeclaration_h :: parserLocalDeclaration_t*)
  = $unflatten_parserLocalDeclarationList'(
      parserLocalDeclarationList parserLocalDeclaration_h,
      parserLocalDeclaration_t*)

def $lift_parserLocalDeclarationIR(constantDeclarationIR)
  = constantDeclaration
  -- if constantDeclaration
      = $lift_declarationIR(constantDeclarationIR)

def $lift_parserLocalDeclarationIR(instantiationIR)
  = instantiation
  -- if instantiation
      = $lift_declarationIR(instantiationIR)

def $lift_parserLocalDeclarationIR(variableDeclarationIR)
  = annotationList type name initializerOpt `;
  -- if annotationList typeIR nameIR initializerIR? `;
      = variableDeclarationIR
  -- if type = $lift_typeIR(typeIR)
  -- if name = $lift_nameIR_as_nonTypeName(nameIR)
  -- if initializerOpt = $lift_initializerOptIR(initializerIR?)

def $lift_parserLocalDeclarationIR(valueSetDeclarationIR)
  = $lift_valueSetDeclarationIR(valueSetDeclarationIR)

def $lift_parserLocalDeclarationListIR(parserLocalDeclarationIR*)
  = parserLocalDeclarationList
  -- if (parserLocalDeclaration
      = $lift_parserLocalDeclarationIR(parserLocalDeclarationIR))*
  -- if parserLocalDeclarationList
      = $unflatten_parserLocalDeclarationList(parserLocalDeclaration*)

dec $unflatten_parserStateList(parserState*) : parserStateList
dec $unflatten_parserStateList'(parserStateList, parserState*)
  : parserStateList

def $unflatten_parserStateList(parserState_h :: parserState_t*)
  = $unflatten_parserStateList'(parserState_h, parserState_t*)
def $unflatten_parserStateList'(parserStateList, eps)
  = parserStateList
def $unflatten_parserStateList'(
    parserStateList, parserState_h :: parserState_t*)
  = $unflatten_parserStateList'(
      parserStateList parserState_h, parserState_t*)

def $lift_parserStateIR(
    annotationList STATE nameIR
      `{ parserStatementIR* transitionStatementIR })
  = annotationList STATE name `{ parserStatementList transitionStatement }
  -- if name = $lift_nameIR_as_nonTypeName(nameIR)
  -- if parserStatementList
      = $lift_parserStatementListIR(parserStatementIR*)
  -- if transitionStatement
      = $lift_transitionStatementIR(transitionStatementIR)

def $lift_parserStateListIR(parserStateIR*)
  = parserStateList
  -- if (parserState
      = $lift_parserStateIR(parserStateIR))*
  -- if parserStateList
      = $unflatten_parserStateList(parserState*)

def $lift_declarationIR(
    annotationList PARSER nameIR `< typeParameterIR* >
      `( parameterIR* ) `( constructorParameterIR* )
      `{ parserLocalDeclarationIR* parserStateIR* })
  = annotationList PARSER name typeParameterListOpt
      `( parameterList ) constructorParameterListOpt
      `{ parserLocalDeclarationList parserStateList }
  -- if name = $lift_nameIR_as_nonTypeName(nameIR)
  -- if typeParameterListOpt
      = $lift_typeParameterListIR(typeParameterIR*)
  -- if parameterList = $lift_parameterListIR(parameterIR*)
  -- if constructorParameterListOpt
      = $lift_constructorParameterListIR(constructorParameterIR*)
  -- if parserLocalDeclarationList
      = $lift_parserLocalDeclarationListIR(parserLocalDeclarationIR*)
  -- if parserStateList
      = $lift_parserStateListIR(parserStateIR*)

