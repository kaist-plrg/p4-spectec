    tableActionList, tableAction_h :: tableAction_t*)
  = $unflatten_tableActionList'(
      tableActionList tableAction_h, tableAction_t*)

def $lift_tableActionReferenceIR(prefixedNameIR `( argumentIR* ))
  = prefixedNonTypeName `( argumentList )
  -- if prefixedNonTypeName
      = $lift_prefixedNameIR_as_prefixedNonTypeName(prefixedNameIR)
  -- if argumentList
      = $lift_argumentListIR(argumentIR*)

def $lift_tableActionReferenceIR_as_expression(
    prefixedNameIR `( argumentIR* ))
  = prefixedNonTypeName `( argumentList )
  -- if prefixedNonTypeName
      = $lift_prefixedNameIR_as_prefixedNonTypeName(prefixedNameIR)
  -- if argumentList
      = $lift_argumentListIR(argumentIR*)

def $lift_tableActionIR(
    annotationList tableActionReferenceIR `;)
  = annotationList tableActionReference `;
  -- if tableActionReference
      = $lift_tableActionReferenceIR(tableActionReferenceIR)

def $lift_tableActionListIR(tableActionIR*) = tableActionList
  -- if (tableAction
      = $lift_tableActionIR(tableActionIR))*
  -- if tableActionList
      = $unflatten_tableActionList(tableAction*)

