  = annotationList CONTROL name typeParameterListOpt `( parameterList ) `;
  -- if name = $lift_nameIR_as_nonTypeName(nameIR)
  -- if typeParameterIR* = typeParameterIR_expl* ++ typeParameterIR_impl*
  -- if typeParameterListOpt
      = $lift_typeParameterListIR(typeParameterIR*)
  -- if parameterList = $lift_parameterListIR(parameterIR*)

