;;;;;; Select expressions
;;

dec $unflatten_selectCaseList(selectCase*) : selectCaseList
dec $unflatten_selectCaseList'(selectCaseList, selectCase*)
  : selectCaseList

def $unflatten_selectCaseList(selectCase*)
  = $unflatten_selectCaseList'(`EMPTY, selectCase*)
def $unflatten_selectCaseList'(selectCaseList, eps)
  = selectCaseList
def $unflatten_selectCaseList'(
    selectCaseList, selectCase_h :: selectCase_t*)
  = $unflatten_selectCaseList'(
      selectCaseList selectCase_h, selectCase_t*)

def $lift_selectCaseIR(keysetExpressionIR `: nameIR `;)
  = keysetExpression `: name `;
  -- if keysetExpression
      = $lift_keysetExpressionIR(keysetExpressionIR)
  -- if name
      = $lift_nameIR_as_nonTypeName(nameIR)

def $lift_selectCaseListIR(selectCaseIR*)
  = selectCaseList
  -- if (selectCase = $lift_selectCaseIR(selectCaseIR))*
  -- if selectCaseList = $unflatten_selectCaseList(selectCase*)

def $lift_stateExpressionIR(
    SELECT `( typedExpressionListIR ) `{ selectCaseIR* })
  = SELECT `( expressionList ) `{ selectCaseList }
  -- if expressionList
      = $lift_typedExpressionListIR(typedExpressionListIR)
  -- if selectCaseList
      = $lift_selectCaseListIR(selectCaseIR*)

;;
;;;;;; Transition statements
;;

def $lift_stateExpressionIR(nameIR `;)
  = name `;
  -- if name = $lift_nameIR_as_nonTypeName(nameIR)

def $lift_transitionStatementIR(TRANSITION stateExpressionIR)
  = TRANSITION stateExpression
  -- if stateExpression
      = $lift_stateExpressionIR(stateExpressionIR)

;;
;;;;;; Value set declarations
;;

dec $lift_typeIR_as_valueSetType(typeIR) : valueSetType

def $lift_typeIR_as_valueSetType(typeIR) = baseType
  -- if baseType = $lift_typeIR(typeIR)
def $lift_typeIR_as_valueSetType(typeIR) = tupleType
  -- if tupleType = $lift_typeIR(typeIR)
def $lift_typeIR_as_valueSetType(typeIR) = prefixedTypeName
  -- if prefixedTypeName = $lift_typeIR(typeIR)

dec $lift_valueSetDeclarationIR(valueSetDeclarationIR) : valueSetDeclaration

def $lift_valueSetDeclarationIR(
    annotationList VALUE_SET `< typeIR > `( typedExpressionIR ) nameIR `;)
  = annotationList VALUE_SET `< valueSetType > `( expression ) name `;
  -- if valueSetType = $lift_typeIR_as_valueSetType(typeIR)
  -- if expression = $lift_typedExpressionIR(typedExpressionIR)
  -- if name = $lift_nameIR_as_nonTypeName(nameIR)

