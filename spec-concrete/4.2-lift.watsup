    controlLocalDeclarationList,
    controlLocalDeclaration_h :: controlLocalDeclaration_t*)
  = $unflatten_controlLocalDeclarationList'(
      controlLocalDeclarationList controlLocalDeclaration_h,
      controlLocalDeclaration_t*)

def $lift_controlLocalDeclarationIR(constantDeclarationIR)
  = constantDeclaration
  -- if constantDeclaration
      = $lift_declarationIR(constantDeclarationIR)

def $lift_controlLocalDeclarationIR(instantiationIR)
  = instantiation
  -- if instantiation
      = $lift_declarationIR(instantiationIR)

def $lift_controlLocalDeclarationIR(variableDeclarationIR)
  = annotationList type name initializerOpt `;
  -- if annotationList typeIR nameIR initializerIR? `;
      = variableDeclarationIR
  -- if type = $lift_typeIR(typeIR)
  -- if name = $lift_nameIR_as_nonTypeName(nameIR)
  -- if initializerOpt = $lift_initializerOptIR(initializerIR?)

def $lift_controlLocalDeclarationIR(actionDeclarationIR)
  = actionDeclaration
  -- if actionDeclaration
      = $lift_declarationIR(actionDeclarationIR)

def $lift_controlLocalDeclarationIR(tableDeclarationIR)
  = $lift_tableDeclarationIR(tableDeclarationIR)

def $lift_controlLocalDeclarationListIR(controlLocalDeclarationIR*)
  = controlLocalDeclarationList
  -- if (controlLocalDeclaration
      = $lift_controlLocalDeclarationIR(controlLocalDeclarationIR))*
  -- if controlLocalDeclarationList
      = $unflatten_controlLocalDeclarationList(controlLocalDeclaration*)

def $lift_controlBodyIR(controlBodyIR)
  = $lift_blockStatementIR(controlBodyIR)

def $lift_declarationIR(
    annotationList CONTROL nameIR `< typeParameterIR* >
      `( parameterIR* ) `( constructorParameterIR* )
      `{ controlLocalDeclarationIR* APPLY controlBodyIR })
  = annotationList CONTROL name typeParameterListOpt
      `( parameterList ) constructorParameterListOpt
      `{ controlLocalDeclarationList APPLY controlBody }
  -- if name = $lift_nameIR_as_nonTypeName(nameIR)
  -- if typeParameterListOpt
      = $lift_typeParameterListIR(typeParameterIR*)
  -- if parameterList = $lift_parameterListIR(parameterIR*)
  -- if constructorParameterListOpt
      = $lift_constructorParameterListIR(constructorParameterIR*)
  -- if controlLocalDeclarationList
      = $lift_controlLocalDeclarationListIR(controlLocalDeclarationIR*)
  -- if controlBody = $lift_controlBodyIR(controlBodyIR)

;;
;;;; Package type declarations
;;

def $lift_declarationIR(
    annotationList PACKAGE nameIR
      `< typeParameterIR_expl* `, typeParameterIR_impl* >
      `( parameterIR* ) `;)
  = annotationList PACKAGE name typeParameterListOpt `( parameterList ) `;
  -- if name = $lift_nameIR_as_nonTypeName(nameIR)
  -- if typeParameterIR* = typeParameterIR_expl* ++ typeParameterIR_impl*
  -- if typeParameterListOpt
      = $lift_typeParameterListIR(typeParameterIR*)
  -- if parameterList = $lift_parameterListIR(parameterIR*)

;;
;;;; Type declarations
;;

;;
;;;; Declaration
;;

def $lift_declarationIR(declarationIR) = $sink<declaration>()
  -- debug declarationIR
  -- otherwise

;;
;; P4 program
;;

dec $unflatten_p4program(declaration*) : p4program
dec $unflatten_p4program'(p4program, declaration*) : p4program

def $unflatten_p4program(declaration*)
  = $unflatten_p4program'(`EMPTY, declaration*)
def $unflatten_p4program'(p4program, eps) = p4program
def $unflatten_p4program'(p4program, declaration_h :: declaration_t*)
  = $unflatten_p4program'(p4program declaration_h, declaration_t*)

def $lift_p4programIR(declarationIR* `;)
  = $unflatten_p4program(declaration*)
  -- if (declaration = $lift_declarationIR(declarationIR))*
