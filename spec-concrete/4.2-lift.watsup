    controlLocalDeclaration*)
  = $unflatten_controlLocalDeclarationList'(
      `EMPTY, controlLocalDeclaration*)
def $unflatten_controlLocalDeclarationList'(
    controlLocalDeclarationList, eps)
  = controlLocalDeclarationList
