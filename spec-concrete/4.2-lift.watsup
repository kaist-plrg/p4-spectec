def $unflatten_tableEntryList'(
    tableEntryList, tableEntry_h :: tableEntry_t*)
  = $unflatten_tableEntryList'(
      tableEntryList tableEntry_h,
      tableEntry_t*)

def $lift_tableEntryPriorityIR(
    PRIORITY `= integerLiteral `:)
  = PRIORITY `= integerLiteral `:

def $lift_tableEntryPriorityIR(
    PRIORITY `= `( typedExpressionIR ) `:)
  = PRIORITY `= `( expression ) `:
  -- if expression = $lift_typedExpressionIR(typedExpressionIR)

def $lift_tableEntryIR(
    constOptIR eps
      keysetExpressionIR `: tableActionReferenceIR annotationList `;)
  = constOpt keysetExpression `: tableActionReference annotationList `;
  -- if constOpt = $lift_constOptIR(constOptIR)
  -- if keysetExpression
      = $lift_keysetExpressionIR(keysetExpressionIR)
  -- if tableActionReference
      = $lift_tableActionReferenceIR(tableActionReferenceIR)

def $lift_tableEntryIR(
    constOptIR tableEntryPriorityIR
      keysetExpressionIR `: tableActionReferenceIR annotationList `;)
  = constOpt tableEntryPriority
      keysetExpression `: tableActionReference annotationList `;
  -- if constOpt = $lift_constOptIR(constOptIR)
  -- if tableEntryPriority
      = $lift_tableEntryPriorityIR(tableEntryPriorityIR)
  -- if keysetExpression
      = $lift_keysetExpressionIR(keysetExpressionIR)
  -- if tableActionReference
      = $lift_tableActionReferenceIR(tableActionReferenceIR)

def $lift_tableEntryListIR(tableEntryIR*)
  = tableEntryList
  -- if (tableEntry
      = $lift_tableEntryIR(tableEntryIR))*
  -- if tableEntryList
      = $unflatten_tableEntryList(tableEntry*)

