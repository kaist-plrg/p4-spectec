    typedExpressionIR `: nameIR annotationList `;)
  = expression `: name annotationList `;
  -- if expression = $lift_typedExpressionIR(typedExpressionIR)
  -- if name = $lift_nameIR_as_nonTypeName(nameIR)

def $lift_tableKeyListIR(tableKeyIR*) = tableKeyList
  -- if (tableKey = $lift_tableKeyIR(tableKeyIR))*
