;;
;; Copy-in (non-default, single argument)
;;

;;; `EMPTY | IN

rulegroup Copy_in_argument/directionless-in {

  rule Copy_in_argument/exit:
    STO_0 p_caller EC_caller_0 (_ direction typeIR nameIR _)
       `@ p_callee EC_callee_0 argumentIR
    ~> STO_1 EC_caller_1 `@ EC_callee_0 `# EXIT
    ---- ;; check parameter direction
    -- if direction = `EMPTY \/ direction = IN
    ---- ;; evaluate argument
    -- Argument_eval:
        p_caller EC_caller_0 STO_0 |- argumentIR
                                  : EC_caller_1 STO_1 EXIT

  rule Copy_in_argument/cont:
    STO_0 p_caller EC_caller_0 (_ direction typeIR nameIR _)
       `@ p_callee EC_callee_0 argumentIR
    ~> STO_1 EC_caller_1 `@ EC_callee_1 `# (CONT eps)
    ---- ;; check parameter direction
    -- if direction = `EMPTY \/ direction = IN
    ---- ;; evaluate argument
    -- Argument_eval:
        p_caller EC_caller_0 STO_0 |- argumentIR
                                    : EC_caller_1 STO_1 (CONT value)
    ---- ;; update callee context
    -- if EC_callee_1
        = $add_value_eval(p_callee, EC_callee_0, `` nameIR, value)

}

;;; INOUT

rulegroup Copy_in_argument/inout {
 
  rule Copy_in_argument/exit:
    STO_0 p_caller EC_caller_0 (_  INOUT typeIR nameIR _)
       `@ p_callee EC_callee_0 argumentIR
    ~> STO_1 EC_caller_1 `@ EC_callee_0 `# EXIT
    ---- ;; get storage reference of argument
    -- Argument_eval_lvalue:
        p_caller EC_caller_0 STO_0 |- argumentIR
                                    : EC_caller_1 STO_1 EXIT
 
  rule Copy_in_argument/exit:
    STO_0 p_caller EC_caller_0 (_  INOUT typeIR nameIR _)
       `@ p_callee EC_callee_0 argumentIR
    ~> STO_1 EC_caller_1 `@ EC_callee_1 `# (CONT storageReference)
    ---- ;; get storage reference of argument
    -- Argument_eval_lvalue:
        p_caller EC_caller_0 STO_0 |- argumentIR
                                    : EC_caller_1 STO_1 (CONT storageReference)
    ---- ;; read value from storage reference
    -- Lvalue_read:
        p_caller EC_caller_1 |- storageReference : value
    ---- ;; update callee context
    -- if EC_callee_1
        = $add_value_eval(p_callee, EC_callee_0, `` nameIR, value)

}

;;; OUT

rulegroup Copy_in_argument/out {
 
  rule Copy_in_argument/exit:
    STO_0 p_caller EC_caller_0 (_  OUT typeIR nameIR _)
       `@ p_callee EC_callee_0 argumentIR
    ~> STO_1 EC_caller_1 `@ EC_callee_0 `# EXIT
    ---- ;; get storage reference of argument
    -- Argument_eval_lvalue:
        p_caller EC_caller_0 STO_0 |- argumentIR
                                    : EC_caller_1 STO_1 EXIT
 
  rule Copy_in_argument/exit:
    STO_0 p_caller EC_caller_0 (_  OUT typeIR nameIR _)
       `@ p_callee EC_callee_0 argumentIR
    ~> STO_1 EC_caller_1 `@ EC_callee_1 `# (CONT storageReference?)
    ---- ;; get storage reference of argument
    -- Argument_eval_lvalue:
        p_caller EC_caller_0 STO_0 |- argumentIR
                                    : EC_caller_1 STO_1 (CONT storageReference?)
    ---- ;; get initial value
    -- if typeIR_subst = $subst_type_eval(p_callee, EC_callee_0, typeIR)
    -- if value_init = $default(typeIR_subst)
    ---- ;; update callee context
    -- if EC_callee_1
        = $add_value_eval(p_callee, EC_callee_0, `` nameIR, value_init)

}

;;
;; Copy-in (non-default, multiple arguments)
;;

rulegroup Copy_in {

  rule Copy_in/nil:
    STO p_caller EC_caller eps `@ p_callee EC_callee eps
    ~> STO EC_caller `@ EC_callee `# (CONT eps)

  rule Copy_in/cons-head-exit:
    STO_0 p_caller EC_caller_0 (parameterIR_h :: parameterIR_t*)
       `@ p_callee EC_callee_0 (argumentIR_h :: argumentIR_t*)
    ~> STO_1 EC_caller_1 `@ EC_callee_1 `# EXIT
    ----
    -- Copy_in_argument:
        STO_0 p_caller EC_caller_0 parameterIR_h
           `@ p_callee EC_callee_0 argumentIR_h
        ~> STO_1 EC_caller_1 `@ EC_callee_1 `# EXIT

  rule Copy_in/cons-head-cont-tail-exit:
    STO_0 p_caller EC_caller_0 (parameterIR_h :: parameterIR_t*)
       `@ p_callee EC_callee_0 (argumentIR_h :: argumentIR_t*)
    ~> STO_2 EC_caller_2 `@ EC_callee_2 `# EXIT
    ----
    -- Copy_in_argument:
        STO_0 p_caller EC_caller_0 parameterIR_h
           `@ p_callee EC_callee_0 argumentIR_h
        ~> STO_1 EC_caller_1 `@ EC_callee_1 `# (CONT storageReference_h?)
    ----
    -- Copy_in:
        STO_1 p_caller EC_caller_1 parameterIR_t*
           `@ p_callee EC_callee_1 argumentIR_t*
        ~> STO_2 EC_caller_2 `@ EC_callee_2 `# EXIT

  rule Copy_in/cons-head-cont-tail-cont:
    STO_0 p_caller EC_caller_0 (parameterIR_h :: parameterIR_t*)
       `@ p_callee EC_callee_0 (argumentIR_h :: argumentIR_t*)
    ~> STO_2 EC_caller_2 `@ EC_callee_2 `# (CONT storageReference?*)
    ----
    -- Copy_in_argument:
        STO_0 p_caller EC_caller_0 parameterIR_h
           `@ p_callee EC_callee_0 argumentIR_h
        ~> STO_1 EC_caller_1 `@ EC_callee_1 `# (CONT storageReference_h?)
    ----
    -- Copy_in:
        STO_1 p_caller EC_caller_1 parameterIR_t*
           `@ p_callee EC_callee_1 argumentIR_t*
        ~> STO_2 EC_caller_2 `@ EC_callee_2 `# (CONT storageReference_t*)
    ----
    -- if storageReference?*
        = storageReference_h? :: storageReference_t*

}

;;
;; Copy-in (default, multiple argument)
;;

rule Copy_in_default:
  parameterIR* `@ p_callee EC_callee_0 value*
  ~> `@ EC_callee_1
  ----
  -- if (_ _ _ nameIR _ = parameterIR)*
  -- if EC_callee_1
      = $add_values_eval(p_callee, EC_callee_0, (`` nameIR)*, value*)
