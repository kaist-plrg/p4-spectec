;;
;; Callable names
;;

dec $callableId_IR(nameIR, parameterListIR) : callableId
dec $parameterId_IR(parameterIR) : parameterId

def $callableId_IR(nameIR, parameterIR*)
  = nameIR `( $parameterId_IR(parameterIR)* )

def $parameterId_IR(_ _ _ nameIR eps) = nameIR `# false
def $parameterId_IR(_ _ _ nameIR constantInitializerIR) = nameIR `# true
