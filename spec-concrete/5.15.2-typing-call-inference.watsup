;;
;; Type constraint
;;

syntax infer =
  | KNOWN AS typeIR
  | UNKNOWN

syntax constraint = map<tid, infer>

dec $empty_constraint(tid*) : constraint
def $empty_constraint(tid*) = `{ (tid `: UNKNOWN)* }

syntax inference = map<tid, typeIR>

;;
;; Type inference operations
;;

dec $infer(tid*, parameterIR*, argumentIR*) : inference
dec $infer'(constraint, parameterIR, argumentIR) : constraint

dec $resolve_inference(inference) : inference
dec $resolve_inference'(typeIR) : typeIR

dec $gen_constraint_typeIR(constraint, typeIR, typeIR) : constraint
dec $gen_constraint_typeIRs(constraint, typeIR*, typeIR*) : constraint
dec $gen_constraint_callableTypeDefIR(
    constraint, callableTypeDefIR, callableTypeDefIR
  )
  : constraint
dec $gen_constraint_callableTypeDefIRs(
    constraint, callableTypeDefIR*, callableTypeDefIR*
  )
  : constraint

dec $merge_constraint(constraint, constraint) : constraint
dec $merge_constraint'(constraint, constraint, tid*, constraint) : constraint
dec $merge_constraints(constraint, constraint*) : constraint

dec $resolve_constraint(constraint) : inference

;;
;;;; Type inference
;;

def $infer(tid_infer*, parameterIR*, argumentIR*) = inference_resolved
  ---- ;; create constraints
  -- if constraint_init = $empty_constraint(tid_infer*)
  -- if (constraint_pair
      = $infer'(constraint_init, parameterIR, argumentIR))*
  ---- ;; merge and resolve generated constraints
  -- if constraint_inferred = $merge_constraints(constraint_init, constraint_pair*)
  -- if inference = $resolve_constraint(constraint_inferred)
  ---- ;; resolve synthesized types
  -- if inference_resolved = $resolve_inference(inference)

def $infer'(constraint, parameterIR, typedExpressionIR)
  = $gen_constraint_typeIR(constraint, typeIR_param, typeIR_arg)
  -- if _ _ typeIR_param _ _ = parameterIR
  -- if typeIR_arg = $type_of_typedExpressionIR(typedExpressionIR)

def $infer'(constraint, parameterIR, nameIR `= typedExpressionIR)
  = $gen_constraint_typeIR(constraint, typeIR_param, typeIR_arg)
  -- if _ _ typeIR_param _ _ = parameterIR
  -- if typeIR_arg = $type_of_typedExpressionIR(typedExpressionIR)

def $infer'(constraint, parameterIR, nameIR `= `_) = constraint

def $infer'(constraint, parameterIR, `_) = constraint


;;
;;;; Synthesized type resolution
;;

def $resolve_inference(`{ (tid `: typeIR)* }) = `{ (tid `: typeIR_resolved)* }
  -- if (typeIR_resolved = $resolve_inference'(typeIR))*

def $resolve_inference'(typeIR) = typeIR_resolved
  -- if SEQ `< typeIR_arg* > = $canon_typeIR(typeIR)
  -- if typeIR_resolved = TUPLE `< typeIR_arg* >
def $resolve_inference'(typeIR) = typeIR
  -- otherwise

;;
;;;; Constraint generation
;;

;;; Named types

def $gen_constraint_typeIR(constraint, `` tid_param, typeIR_arg)
  = $update_map<tid, infer>(constraint, tid_param, KNOWN AS typeIR_arg)
  -- if $in_set<tid>(tid_param, $dom_map<tid, infer>(constraint))

def $gen_constraint_typeIR(
    constraint_0,
    typeDefIR_param `< typeIR_param* >,
    typeDefIR_arg `< typeIR_arg* >
  )
  = constraint_2
  -- if typeIR_specialized_param
      = $specialize_typeDefIR(typeDefIR_param, typeIR_param*)
  -- if typeIR_specialized_arg
      = $specialize_typeDefIR(typeDefIR_arg, typeIR_arg*)
  -- if $is_nominal_typeIR(typeIR_specialized_param)
        /\ $is_nominal_typeIR(typeIR_specialized_arg)
  -- if constraint_1 = $gen_constraint_typeIR(
                          constraint_0,
                          typeIR_specialized_param,
                          typeIR_specialized_arg)
  -- if constraint_2 = $gen_constraint_typeIRs(
                          constraint_1,
                          typeIR_param*,
                          typeIR_arg*)

def $gen_constraint_typeIR(
    constraint_0,
    typeDefIR_param `< typeIR_param* >,
    typeDefIR_arg `< typeIR_arg* >
  )
  = constraint_1
  -- if typeIR_specialized_param
      = $specialize_typeDefIR(typeDefIR_param, typeIR_param*)
  -- if typeIR_specialized_arg
      = $specialize_typeDefIR(typeDefIR_arg, typeIR_arg*)
  -- if ~$is_nominal_typeIR(typeIR_specialized_param)
        /\ ~$is_nominal_typeIR(typeIR_specialized_arg)
  -- if constraint_1 = $gen_constraint_typeIR(
                          constraint_0,
                          typeIR_specialized_param,
                          typeIR_specialized_arg)

;;; Alias types

def $gen_constraint_typeIR(constraint, TYPEDEF _ typeIR_param, typeIR_arg)
  = $gen_constraint_typeIR(constraint, typeIR_param, typeIR_arg)

def $gen_constraint_typeIR(constraint, typeIR_param, TYPEDEF _ typeIR_arg)
  = $gen_constraint_typeIR(constraint, typeIR_param, typeIR_arg)

def $gen_constraint_typeIR(constraint, TYPE tid typeIR_param, TYPE tid typeIR_arg)
  = $gen_constraint_typeIR(constraint, typeIR_param, typeIR_arg)

;;; Data types

def $gen_constraint_typeIR(
    constraint,
    LIST `< typeIR_param >,
    LIST `< typeIR_arg >)
  = $gen_constraint_typeIR(constraint, typeIR_param, typeIR_arg)

def $gen_constraint_typeIR(
    constraint,
    TUPLE `< typeIR_param* >,
    TUPLE `< typeIR_arg* >)
  = $gen_constraint_typeIRs(constraint, typeIR_param*, typeIR_arg*)

def $gen_constraint_typeIR(
    constraint,
    typeIR_param `[ n_size ],
    typeIR_arg `[ n_size ])
  = $gen_constraint_typeIR(constraint, typeIR_param, typeIR_arg)

def $gen_constraint_typeIR(
    constraint,
    STRUCT tid `{ (typeIR_field_param id_field `;)* },
    STRUCT tid `{ (typeIR_field_arg id_field `;)* })
  = $gen_constraint_typeIRs(
      constraint, typeIR_field_param*, typeIR_field_arg*)

def $gen_constraint_typeIR(
    constraint,
    HEADER tid `{ (typeIR_field_param id_field `;)* },
    HEADER tid `{ (typeIR_field_arg id_field `;)* })
  = $gen_constraint_typeIRs(
      constraint, typeIR_field_param*, typeIR_field_arg*)

def $gen_constraint_typeIR(
    constraint,
    HEADER_UNION tid `{ (typeIR_field_param id_field `;)* },
    HEADER_UNION tid `{ (typeIR_field_arg id_field `;)* })
  = $gen_constraint_typeIRs(
      constraint, typeIR_field_param*, typeIR_field_arg*)

;;; Object types

def $gen_constraint_typeIR(
    constraint,
    EXTERN tid `{ (cid `: externMethodTypeDefIR_param)* },
    EXTERN tid `{ (cid `: externMethodTypeDefIR_arg)* })
  = $gen_constraint_callableTypeDefIRs(
      constraint,
      externMethodTypeDefIR_param*,
      externMethodTypeDefIR_arg*)

def $gen_constraint_typeIR(
    constraint,
    PARSER `( parameterIR_param* ),
    PARSER `( parameterIR_arg* ))
  = $gen_constraint_typeIRs(constraint, typeIR_param*, typeIR_arg*)
  -- if (_ direction typeIR_param _ _ = parameterIR_param)*
  -- if (_ direction typeIR_arg _ _ = parameterIR_arg)*

def $gen_constraint_typeIR(
    constraint,
    CONTROL `( parameterIR_param* ),
    CONTROL `( parameterIR_arg* ))
  = $gen_constraint_typeIRs(constraint, typeIR_param*, typeIR_arg*)
  -- if (_ direction typeIR_param _ _ = parameterIR_param)*
  -- if (_ direction typeIR_arg _ _ = parameterIR_arg)*

def $gen_constraint_typeIR(
    constraint,
    PACKAGE `{ typeIR_param* },
    PACKAGE `{ typeIR_arg* })
  = $gen_constraint_typeIRs(constraint, typeIR_param*, typeIR_arg*)

;;; Synthesized types

def $gen_constraint_typeIR(constraint, typeIR_param, typeIR_arg)
  = constraint
  -- otherwise

;;; Multiple types

def $gen_constraint_typeIRs(constraint, typeIR_param*, typeIR_arg*)
  = $merge_constraints(constraint, constraint_pair*)
  -- if (constraint_pair
      = $gen_constraint_typeIR(constraint, typeIR_param, typeIR_arg))*

;;; callables

def $gen_constraint_callableTypeDefIR(
    constraint_0,
    EXTERN_METHOD  `< _ `, _ > `( parameterIR_param* ) `: typeIR_ret_param,
    EXTERN_METHOD  `< _ `, _ > `( parameterIR_arg* ) `: typeIR_ret_arg)
  = constraint_2
  -- if (_ direction typeIR_param _ _ = parameterIR_param)*
  -- if (_ direction typeIR_arg _ _ = parameterIR_arg)*
  -- if constraint_1
      = $gen_constraint_typeIRs(constraint_0, typeIR_param*, typeIR_arg*)
  -- if constraint_2
      = $gen_constraint_typeIR(constraint_1, typeIR_ret_param, typeIR_ret_arg)

def $gen_constraint_callableTypeDefIR(
    constraint_0,
    EXTERN_METHOD ABSTRACT `< _ `, _ > `( parameterIR_param* ) `: typeIR_ret_param,
    EXTERN_METHOD ABSTRACT `< _ `, _ > `( parameterIR_arg* ) `: typeIR_ret_arg)
  = constraint_2
  -- if (_ direction typeIR_param _ _ = parameterIR_param)*
  -- if (_ direction typeIR_arg _ _ = parameterIR_arg)*
  -- if constraint_1
      = $gen_constraint_typeIRs(constraint_0, typeIR_param*, typeIR_arg*)
  -- if constraint_2
      = $gen_constraint_typeIR(constraint_1, typeIR_ret_param, typeIR_ret_arg)

;;; Multiple callables

def $gen_constraint_callableTypeDefIRs(
    constraint,
    callableTypeDefIR_param*,
    callableTypeDefIR_arg*)
  = $merge_constraints(constraint, constraint_pair*)
  -- if (constraint_pair
      = $gen_constraint_callableTypeDefIR(
          constraint,
          callableTypeDefIR_param,
          callableTypeDefIR_arg))*

;;
;;;; Constraint merging
;;

def $merge_constraint(constraint_pre, constraint_post)
  = $merge_constraint'(constraint_pre, constraint_post, tid_pre*, `{ eps })
  -- if `{ tid_pre* } = $dom_map<tid, infer>(constraint_pre)
  -- if `{ tid_post* } = $dom_map<tid, infer>(constraint_post)
  -- if $eq_set<tid>(`{ tid_pre* }, `{ tid_post* })

def $merge_constraint'(
    constraint_pre, constraint_post, eps, constraint
  )
  = constraint

def $merge_constraint'(
    constraint_pre, constraint_post,
    tid_h :: tid_t*,
    constraint
  )
  = $merge_constraint'(constraint_pre, constraint_post, tid_t*, constraint_updated)
  -- if UNKNOWN = $find_map<tid, infer>(constraint_pre, tid_h)
  -- if UNKNOWN = $find_map<tid, infer>(constraint_post, tid_h)
  -- if constraint_updated
      = $update_map<tid, infer>(constraint, tid_h, UNKNOWN)

def $merge_constraint'(
    constraint_pre, constraint_post,
    tid_h :: tid_t*,
    constraint
  )
  = $merge_constraint'(constraint_pre, constraint_post, tid_t*, constraint_updated)
  -- if UNKNOWN = $find_map<tid, infer>(constraint_pre, tid_h)
  -- if KNOWN AS typeIR_post = $find_map<tid, infer>(constraint_post, tid_h)
  -- if constraint_updated
      = $update_map<tid, infer>(constraint, tid_h, KNOWN AS typeIR_post)

def $merge_constraint'(
    constraint_pre, constraint_post,
    tid_h :: tid_t*,
    constraint
  )
  = $merge_constraint'(constraint_pre, constraint_post, tid_t*, constraint_updated)
  -- if KNOWN AS typeIR_pre = $find_map<tid, infer>(constraint_pre, tid_h)
  -- if UNKNOWN = $find_map<tid, infer>(constraint_post, tid_h)
  -- if constraint_updated
      = $update_map<tid, infer>(constraint, tid_h, KNOWN AS typeIR_pre)

def $merge_constraint'(
    constraint_pre, constraint_post,
    tid_h :: tid_t*,
    constraint
  )
  = $merge_constraint'(constraint_pre, constraint_post, tid_t*, constraint_updated)
  -- if KNOWN AS typeIR_pre = $find_map<tid, infer>(constraint_pre, tid_h)
  -- if KNOWN AS typeIR_post = $find_map<tid, infer>(constraint_post, tid_h)
  -- Sub_impl: typeIR_pre <: typeIR_post
  -- if constraint_updated
      = $update_map<tid, infer>(constraint, tid_h, KNOWN AS typeIR_post)

def $merge_constraint'(
    constraint_pre, constraint_post,
    tid_h :: tid_t*,
    constraint
  )
  = $merge_constraint'(constraint_pre, constraint_post, tid_t*, constraint_updated)
  -- if KNOWN AS typeIR_pre = $find_map<tid, infer>(constraint_pre, tid_h)
  -- if KNOWN AS typeIR_post = $find_map<tid, infer>(constraint_post, tid_h)
  -- Sub_impl:/ typeIR_pre <: typeIR_post
  -- Sub_impl: typeIR_post <: typeIR_pre
  -- if constraint_updated
      = $update_map<tid, infer>(constraint, tid_h, KNOWN AS typeIR_pre)

def $merge_constraints(constraint_pre, eps) = constraint_pre

def $merge_constraints(
    constraint_pre_0,
    constraint_post_h :: constraint_post_t*
  )
  = constraint_pre_2
  -- if constraint_pre_1
      = $merge_constraint(constraint_pre_0, constraint_post_h)
  -- if constraint_pre_2
      = $merge_constraints(constraint_pre_1, constraint_post_t*)

;;
;;;; Constraint resolution
;;

def $resolve_constraint(`{ (tid `: infer)* })
  = `{ (tid `: typeIR)* }
  -- if (KNOWN AS typeIR = infer)*
