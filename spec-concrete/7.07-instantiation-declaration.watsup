;;
;; Declaration instantiation
;;
;; syntax declarationIR
;;

;;; constantDeclarationIR
;;; syntax constantDeclarationIR =
;;;   annotationList CONST typeIR nameIR initializerIR `;

rulegroup Decl_inst/constantDeclarationIR {

  rule Decl_inst/global:
    GLOBAL IC_0 STO |- annotationList CONST typeIR nameIR (`= value) `;
                   ==> IC_1 STO eps
    -- if IC_1 = $add_value_inst(GLOBAL, IC_0, nameIR, value)

  rule Decl_inst/non-global:
    p IC_0 STO |- annotationList CONST typeIR nameIR (`= value) `;
              ==> IC_1 STO constantDeclarationIR
    -- if p =/= GLOBAL
    -- if IC_1 = $add_value_inst(p, IC_0, nameIR, value)
    -- if constantDeclarationIR 
        = annotationList CONST typeIR nameIR (`= value) `;

}

;;; instantiationIR
;;; syntax instantiationIR =
;;;   annotationList typeIR `< typeArgumentListIR > `( argumentListIR )
;;;   nameIR objectInitializerOptIR `;

;; Merge value environments

dec $merge_venvs(venv, venv) : venv
def $merge_venvs(venv, `{ (id `: value)* })
  = $adds_map<id, value>(venv, id*, value*)

;; Merge routine environments and transform functions to extern methods

dec $merge_renv_with_extern(renv, renv) : renv
def $merge_renv_with_extern(renv, `{ eps }) = renv
def $merge_renv_with_extern(renv, `{ (rid_h `: routine_h) :: (rid_t `: routine_t)* })
  = $merge_renv_with_extern(renv_post, `{ (rid_t `: routine_t)* })
  -- if routine_h
      = FUNCTION `< typeParameterListIR > `( parameterListIR ) blockStatementIR
  -- if routine_h_post
      = EXTERN_METHOD `< typeParameterListIR > `( parameterListIR ) blockStatementIR
  -- if renv_post
      = $update_map<rid, routine>(renv, rid_h, routine_h_post)

rulegroup Decl_inst/instantiationIR {

  rule Decl_inst/extern-global:
    GLOBAL IC_0 STO_0 |- annotationList typeIR prefixedNameIR `< typeArgumentListIR >
                          `( argumentListIR ) nameIR objectInitializerOptIR `;
                     ==> IC_1 STO_2 eps
    ---- ;; find and instantiate constructor
    -- if (_, constructor, id_default*)
        = $find_constructor_inst(IC_0, prefixedNameIR, argumentListIR)
    -- if IC_inner = $enter_path(IC_0, nameIR)
    -- Constructor_inst:
        GLOBAL IC_inner STO_0 |- constructor `< typeArgumentListIR >
                                  `( argumentListIR `# id_default* )
                             ==> STO_1 object
    ---- ;; if object is an extern
    -- if EXTERN tid `{ tenv venv renv } = object
    ---- ;; initialize context for object declarations
    -- if IC_decl
        = $empty_instantiationContext[ .PATH = IC_0.PATH ][ .GLOBAL = IC_0.GLOBAL ]
    -- if objectDeclarationListIR
        = $flatten_objectInitializerOptIR(objectInitializerOptIR)
    -- Decls_inst: BLOCK IC_decl STO_1 |- objectDeclarationListIR
                                      ==> IC_decl_post STO_2 _
    ---- ;; merge value environments
    -- if venv_merged
        = $merge_venvs(venv, IC_decl_post.BLOCK.VENV)
    ---- ;; merge routine environments and transform functions to extern methods
    -- if renv_merged
        = $merge_renv_with_extern(renv, IC_decl_post.BLOCK.RENV)
    ---- ;; create new object with merged environments
    -- if object_merged = EXTERN tid `{ tenv venv_merged renv_merged }
    ---- ;; add object to store
    -- if oid = IC_0.PATH ++ nameIR
    -- if STO_3 = $add_map<oid, object>(STO_2, oid, object_merged)
    ---- ;; add reference to object in value environment
    -- if IC_1 = $add_value_inst(GLOBAL, IC_0, nameIR, `! oid)

  rule Decl_inst/extern-non-global:
    p IC_0 STO_0 |- annotationList typeIR prefixedNameIR `< typeArgumentListIR >
                      `( argumentListIR ) nameIR objectInitializerOptIR `;
                ==> IC_1 STO_2 constantDeclarationIR
    ---- ;; if not at global scope
    -- if p =/= GLOBAL
    ---- ;; find and instantiate constructor
    -- if (_, constructor, id_default*)
        = $find_constructor_inst(IC_0, prefixedNameIR, argumentListIR)
    -- if IC_inner = $enter_path(IC_0, nameIR)
    -- Constructor_inst:
        p IC_inner STO_0 |- constructor `< typeArgumentListIR > `( argumentListIR `# id_default* )
                        ==> STO_1 object
    ---- ;; if object is an extern
    -- if EXTERN tid `{ tenv venv renv } = object
    ---- ;; initialize context for object declarations
    -- if IC_decl
        = $empty_instantiationContext[ .PATH = IC_0.PATH ][ .GLOBAL = IC_0.GLOBAL ]
    -- if objectDeclarationListIR
        = $flatten_objectInitializerOptIR(objectInitializerOptIR)
    -- Decls_inst: BLOCK IC_decl STO_1 |- objectDeclarationListIR
                                      ==> IC_decl_post STO_2 _
    ---- ;; merge value environments
    -- if venv_merged
        = $merge_venvs(venv, IC_decl_post.BLOCK.VENV)
    ---- ;; merge routine environments and transform functions to extern methods
    -- if renv_merged
        = $merge_renv_with_extern(renv, IC_decl_post.BLOCK.RENV)
    ---- ;; create new object with merged environments
    -- if object_merged = EXTERN tid `{ tenv venv_merged renv_merged }
    ---- ;; add object to store
    -- if oid = IC_0.PATH ++ nameIR
    -- if STO_3 = $add_map<oid, object>(STO_2, oid, object_merged)
    ---- ;; add reference to object in value environment
    -- if IC_1 = $add_value_inst(GLOBAL, IC_0, nameIR, `! oid)
    ---- ;; replace declaration with constant declaration holding the reference
    -- if constantDeclarationIR
        = `EMPTY CONST typeIR nameIR (`= (`! oid)) `;

  rule Decl_inst/non-extern-global:
    GLOBAL IC_0 STO_0 |- annotationList typeIR prefixedNameIR `< typeArgumentListIR >
                          `( argumentListIR ) nameIR objectInitializerOptIR `;
                     ==> IC_1 STO_1 eps
    ---- ;; find and instantiate constructor
    -- if (_, constructor, id_default*)
        = $find_constructor_inst(IC_0, prefixedNameIR, argumentListIR)
    -- if IC_inner = $enter_path(IC_0, nameIR)
    -- Constructor_inst:
        GLOBAL IC_inner STO_0 |- constructor `< typeArgumentListIR >
                                  `( argumentListIR `# id_default* )
                             ==> STO_1 object
    ---- ;; if object is not an extern
    -- if ~$is_extern_object(object)
    ---- ;; bind object to store
    -- if oid = IC_0.PATH ++ nameIR
    -- if STO_2 = $add_map<oid, object>(STO_1, oid, object)
    ---- ;; add reference to object in value environment
    -- if IC_1 = $add_value_inst(GLOBAL, IC_0, nameIR, `! oid)

  rule Decl_inst/non-extern-non-global:
    p IC_0 STO_0 |- annotationList typeIR prefixedNameIR `< typeArgumentListIR >
                          `( argumentListIR ) nameIR objectInitializerOptIR `;
                     ==> IC_1 STO_1 constantDeclarationIR
    ---- ;; if not at global scope
    -- if p =/= GLOBAL
    ---- ;; find and instantiate constructor
    -- if (_, constructor, id_default*)
        = $find_constructor_inst(IC_0, prefixedNameIR, argumentListIR)
    -- if IC_inner = $enter_path(IC_0, nameIR)
    -- Constructor_inst:
        p IC_inner STO_0 |- constructor `< typeArgumentListIR >
                              `( argumentListIR `# id_default* )
                        ==> STO_1 object
    ---- ;; if object is not an extern
    -- if ~$is_extern_object(object)
    ---- ;; bind object to store
    -- if oid = IC_0.PATH ++ nameIR
    -- if STO_2 = $add_map<oid, object>(STO_1, oid, object)
    ---- ;; add reference to object in value environment
    -- if IC_1 = $add_value_inst(p, IC_0, nameIR, `! oid)
    ---- ;; replace declaration with constant declaration holding the reference
    -- if constantDeclarationIR
        = `EMPTY CONST typeIR nameIR (`= (`! oid)) `;

}

;;; functionDeclarationIR
;;; syntax functionDeclarationIR
;;;; annotationList functionPrototypeIR blockStatementIR

rule Decl_inst/functionDeclarationIR:
  p IC_0 STO |- annotationList
                (typeIR nameIR (`< typeParameterListIR `, typeParameterListIR_inferred >) `( parameterListIR ))
                blockStatementIR
            ==> IC_1 STO eps
  ---- ;; bind function to routine environment
  -- if rid = $rid_IR(nameIR, parameterListIR)
  -- if function
      = FUNCTION `< typeParameterListIR ++ typeParameterListIR_inferred >
          `( parameterListIR ) blockStatementIR
  -- if IC_1 = $add_routine_overload_inst(p, IC_0, rid, function)

;;; actionDeclarationIR
;;; syntax actionDeclarationIR =
;;;   annotationList ACTION nameIR `( parameterListIR ) blockStatementIR

rule Decl_inst/actionDeclarationIR:
  p IC_0 STO |- annotationList ACTION nameIR `( parameterListIR ) blockStatementIR
            ==> IC_1 STO eps
  ---- ;; bind action to routine environment
  -- if rid = $rid_IR(nameIR, parameterListIR)
  -- if action = ACTION `( parameterListIR ) blockStatementIR
  -- if IC_1 = $add_routine_non_overload_inst(p, IC_0, rid, action)

;;; errorDeclarationIR
;;; syntax errorDeclarationIR = ERROR `{ nameListIR }

rule Decl_inst/errorDeclarationIR:
  GLOBAL IC_0 STO |- ERROR `{ nameIR* } ==> IC_1 STO eps
  ---- ;; bind errors to value environment
  -- if (nameIR_error = $concat_text([ "error.", nameIR ]))*
  -- if (value_error = ERROR `. nameIR)*
  -- if IC_1 = $add_values_inst(GLOBAL, IC_0, nameIR_error*, value_error*)

;;; matchKindDeclarationIR
;;; syntax matchKindDeclarationIR = MATCH_KIND `{ nameListIR }

rule Decl_inst/matchKindDeclarationIR:
  GLOBAL IC_0 STO |- MATCH_KIND `{ nameIR* } ==> IC_1 STO eps
  ---- ;; add match kinds to value environment
  -- if (value_match_kind = MATCH_KIND `. nameIR)*
  -- if IC_1 = $add_values_inst(GLOBAL, IC_0, nameIR*, value_match_kind*)

;;; externDeclarationIR
;;; syntax externDeclarationIR
;;;; externFunctionDeclarationIR
;;;; syntax externFunctionDeclarationIR
;;;;; annotationList EXTERN functionPrototypeIR `;

rule Decl_inst/externFunctionDeclarationIR:
  GLOBAL IC_0 STO |- annotationList EXTERN
                     (typeIR nameIR `< typeParameterListIR `, typeParameterListIR_inferred >
                     `( parameterListIR )) `;
                 ==> IC_1 STO eps
  ---- ;; bind extern function to routine environment
  -- if rid = $rid_IR(nameIR, parameterListIR)
  -- if function
      = EXTERN_FUNCTION
          `< typeParameterListIR ++ typeParameterListIR_inferred > `( parameterListIR )
  -- if IC_1 = $add_routine_overload_inst(GLOBAL, IC_0, rid, function)

;;;; externObjectDeclarationIR

dec $ridof_externMethodPrototypeIR(externMethodPrototypeIR) : rid
  hint(prose_in "the routine id of " %0)

def $ridof_externMethodPrototypeIR(
    _ (_ nameIR `< _ `, _ > `( parameterListIR )) `;
  )
  = $rid_IR(nameIR, parameterListIR)
def $ridof_externMethodPrototypeIR(
    _ ABSTRACT (_ nameIR `< _ `, _ > `( parameterListIR )) `;
  )
  = $rid_IR(nameIR, parameterListIR)

dec $typeof_externMethodPrototypeIR(externMethodPrototypeIR) : routineTypeDefIR
  hint(prose_in "the routine type definition of " %0)

def $typeof_externMethodPrototypeIR(
    _ (typeIR_ret nameIR
      `< typeParameterListIR_expl `, typeParameterListIR_impl >
      `( parameterIR* )) `;
  )
  = routineTypeDefIR
  -- if (parameterTypeIR = $typeof_parameterIR(parameterIR))*
  -- if externMethodTypeIR
      = EXTERN_METHOD `( parameterTypeIR* ) `-> typeIR_ret
  -- if routineTypeDefIR
      = externMethodTypeIR `< typeParameterListIR_expl `, typeParameterListIR_impl >
def $typeof_externMethodPrototypeIR(
    _ ABSTRACT (typeIR_ret nameIR
      `< typeParameterListIR_expl `, typeParameterListIR_impl >
      `( parameterIR* )) `;
  )
  = routineTypeDefIR
  -- if (parameterTypeIR = $typeof_parameterIR(parameterIR))*
  -- if externMethodTypeIR
      = EXTERN_METHOD ABSTRACT `( parameterTypeIR* ) `-> typeIR_ret
  -- if routineTypeDefIR
      = externMethodTypeIR `< typeParameterListIR_expl `, typeParameterListIR_impl >

dec $cidof_externConstructorPrototypeIR(externConstructorPrototypeIR) : cid
  hint(prose_in "the constructor id of " %0)

def $cidof_externConstructorPrototypeIR(
    _ nameIR `< `, _ > `( parameterIR* ) `;
  )
  = $cid_IR(nameIR, parameterIR*)

dec $constructor_of_externConstructorPrototypeIR(
    typeParameterListIR,
    externMethodPrototypeListIR,
    externConstructorPrototypeIR
  ) : constructor
  hint(prose_in "the constructor of " %2 "with type parameters " %0 " and methods " %1)

def $constructor_of_externConstructorPrototypeIR(
    typeParameterListIR_expl,
    externMethodPrototypeListIR,
    _ nameIR `< `, typeParameterListIR_impl > `( parameterIR* ) `;
  )
  = constructor
  -- if typeParameterListIR
      = typeParameterListIR_expl ++ typeParameterListIR_impl
  -- if constructor
      = EXTERN nameIR `< typeParameterListIR >
          `( parameterIR* ) `{ externMethodPrototypeListIR }

rulegroup Decl_inst/externObjectDeclarationIR {

  rule Decl_inst/non-constructor:
    GLOBAL IC_0 STO |- annotationList EXTERN nameIR
                        `< typeParameterListIR `, >
                        `{ eps externMethodPrototypeIR* }
                  ==> IC_2 STO eps
    ---- ;; bind methods to routine environment
    -- if (rid = $ridof_externMethodPrototypeIR(externMethodPrototypeIR))*
    -- if (routineTypeDefIR
        = $typeof_externMethodPrototypeIR(externMethodPrototypeIR))*
    -- if rdenv = `{ (rid `: routineTypeDefIR)* }
    ---- ;; add polymorphic extern type to typedef environment
    -- if externObjectTypeIR = EXTERN nameIR rdenv
    -- if polyTypeDefIR = externObjectTypeIR `< typeParameterListIR `, eps >
    -- if IC_1 = $add_typedef_inst(GLOBAL, IC_0, nameIR, polyTypeDefIR)
    ---- ;; if no constructor was provided, add a default constructor
    -- if cid = $cid_IR(nameIR, eps)
    -- if constructor
        = EXTERN nameIR `< typeParameterListIR > `( eps ) `{ externMethodPrototypeIR* }
    -- if IC_2 = $add_constructor_inst(IC_1, cid, constructor)

  rule Decl_inst/constructor:
    GLOBAL IC_0 STO |- annotationList EXTERN nameIR
                        `< typeParameterListIR `, >
                        `{ externConstructorPrototypeIR* externMethodPrototypeIR* }
                   ==> IC_2 STO eps
    ---- ;; bind methods to routine environment
    -- if (rid = $ridof_externMethodPrototypeIR(externMethodPrototypeIR))*
    -- if (routineTypeDefIR
        = $typeof_externMethodPrototypeIR(externMethodPrototypeIR))*
    -- if rdenv = `{ (rid `: routineTypeDefIR)* }
    ---- ;; add polymorphic extern type to typedef environment
    -- if externObjectTypeIR = EXTERN nameIR rdenv
    -- if polyTypeDefIR = externObjectTypeIR `< typeParameterListIR `, eps >
    -- if IC_1 = $add_typedef_inst(GLOBAL, IC_0, nameIR, polyTypeDefIR)
    ---- ;; bind extern constructors to constructor environment
    -- if (cid = $cidof_externConstructorPrototypeIR(externConstructorPrototypeIR))*
    -- if (constructor
        = $constructor_of_externConstructorPrototypeIR(
            typeParameterListIR,
            externMethodPrototypeIR*,
            externConstructorPrototypeIR))*
    -- if IC_2 = $add_constructors_inst(IC_1, cid*, constructor*)

}

;;; parserDeclarationIR
;;; syntax parserDeclarationIR
;;;   annotationList PARSER
;;;   nameIR `< typeParameterListIR >
;;;   `( parameterListIR ) `( constructorParameterListIR )
;;;   `{ parserLocalDeclarationListIR parserStateListIR }`

rule Decl_inst/parserDeclarationIR:
  GLOBAL IC_0 STO |- annotationList PARSER nameIR `< eps >
                      `( parameterListIR ) `( constructorParameterListIR )
                      `{ parserLocalDeclarationListIR parserStateListIR }
                 ==> IC_1 STO eps
  -- if cid = $cid_IR(nameIR, constructorParameterListIR)
  -- if constructor 
      = PARSER `( parameterListIR ) `( constructorParameterListIR )
          `{ parserLocalDeclarationListIR parserStateListIR }
  -- if IC_1 = $add_constructor_inst(IC_0, cid, constructor)

;;; controlDeclarationIR
;;; syntax controlDeclarationIR =
;;;   annotationList CONTROL
;;;   nameIR `< typeParameterListIR >
;;;  `( parameterListIR ) `( constructorParameterListIR )
;;;  `{ controlLocalDeclarationListIR APPLY controlBodyIR }

rule Decl_inst/controlDeclarationIR:
  GLOBAL IC_0 STO |- annotationList CONTROL nameIR `< eps >
                      `( parameterListIR ) `( constructorParameterListIR )
                      `{ controlLocalDeclarationListIR APPLY controlBodyIR }
                ==> IC_1 STO eps
  ---- ;; bind control to constructor environment
  -- if cid = $cid_IR(nameIR, constructorParameterListIR)
  -- if constructor
      = CONTROL `( parameterListIR ) `( constructorParameterListIR )
          `{ controlLocalDeclarationListIR APPLY controlBodyIR }
  -- if IC_1 = $add_constructor_inst(IC_0, cid, constructor)

;;; typeDeclarationIR
;;; syntax typeDeclarationIR

;;;; derivedTypeDeclarationIR
;;;; syntax derivedTypeDeclarationIR

;;;;; enumTypeDeclarationIR
;;;;; syntax enumTypeDeclarationIR

;;;;;; annotationList ENUM nameIR `{ nameListIR }

rule Decl_inst/enumTypeDeclarationIR-non-serializable:
  GLOBAL IC_0 STO |- annotationList ENUM nameIR `{ nameIR_field* }
                 ==> IC_2 STO eps
  ---- ;; bind fields to value environment
  -- if (nameIR_enum_field = nameIR ++ "." ++ nameIR_field)*
  -- if (value_enum_field = nameIR `. nameIR_field)*
  -- if IC_1 = $add_values_inst(GLOBAL, IC_0, nameIR_enum_field*, value_enum_field*)
  ---- ;; bind enum type to typedef environment
  -- if typeIR_enum = ENUM nameIR `{ nameIR_field* }
  -- if IC_2 = $add_typedef_inst(GLOBAL, IC_1, nameIR, typeIR_enum)

;;;;;; annotationList ENUM typeIR nameIR `{ namedExpressionListIR }

rule Decl_inst/enumTypeDeclarationIR-serializable:
  GLOBAL IC_0 STO_0 |- annotationList ENUM typeIR nameIR `{ (nameIR_field `= typedExpressionIR_field)* }
                   ==> IC_2 STO_1 eps
  ---- ;; instantiate fields
  -- Exprs_inst: GLOBAL IC_0 STO_0 |- typedExpressionIR_field* ==> STO_1 value_field*
  ---- ;; bind fields to value environment
  -- if (nameIR_serenum_field = nameIR ++ "." ++ nameIR_field)*
  -- if (value_serenum_field = nameIR `. nameIR_field `# value_field)*
  -- if IC_1
      = $add_values_inst(GLOBAL, IC_0, nameIR_serenum_field*, value_serenum_field*)
  ---- ;; bind enum type to typedef environment
  -- if typeIR_serenum
      = ENUM nameIR `# typeIR `{ (nameIR_field `= value_field `;)* }
  -- if IC_2
      = $add_typedef_inst(GLOBAL, IC_1, nameIR, typeIR_serenum)

;;;;; structTypeDeclarationIR
;;;;; syntax structTypeDeclarationIR =
;;;;;   annotationList STRUCT nameIR
;;;;;     `< typeParameterListIR `, typeParameterListIR >
;;;;;     `{ typeFieldListIR }

rule Decl_inst/structTypeDeclarationIR:
  GLOBAL IC_0 STO |- annotationList STRUCT nameIR
                      `< typeParameterListIR `, typeParameterListIR_inferred >
                      `{ typeFieldIR* }
                 ==> IC_1 STO eps
  ---- ;; bind struct type to typedef environment
  -- if (annotationList_field typeIR_field nameIR_field `; = typeFieldIR)*
  -- if typeDefIR
      = (STRUCT nameIR `{ (typeIR_field nameIR_field `;)* })
          `< typeParameterListIR `, typeParameterListIR_inferred >
  -- if IC_1 = $add_typedef_inst(GLOBAL, IC_0, nameIR, typeDefIR)

;;;;; headerTypeDeclarationIR
;;;;; syntax headerTypeDeclarationIR =
;;;;;   annotationList HEADER nameIR
;;;;;     `< typeParameterListIR `, typeParameterListIR >
;;;;;     `{ typeFieldListIR }

rule Decl_inst/headerTypeDeclarationIR:
  GLOBAL IC_0 STO |- annotationList HEADER nameIR
                       `< typeParameterListIR `, typeParameterListIR_inferred >
                       `{ typeFieldIR* }
                 ==> IC_1 STO eps
  ---- ;; bind header type to typedef environment
  -- if (annotationList_field typeIR_field nameIR_field `; = typeFieldIR)*
  -- if typeDefIR
      = (HEADER nameIR `{ (typeIR_field nameIR_field `;)* })
          `< typeParameterListIR `, typeParameterListIR_inferred >
  -- if IC_1 = $add_typedef_inst(GLOBAL, IC_0, nameIR, typeDefIR)

;;;;; headerUnionTypeDeclarationIR
;;;;; syntax headerUnionTypeDeclarationIR =
;;;;;   annotationList HEADER_UNION nameIR
;;;;;     `< typeParameterListIR `, typeParameterListIR >
;;;;;     `{ typeFieldListIR }

rule Decl_inst/headerUnionTypeDeclarationIR:
  GLOBAL IC_0 STO |- annotationList HEADER_UNION nameIR
                       `< typeParameterListIR `, typeParameterListIR_inferred >
                       `{ typeFieldIR* }
                 ==> IC_1 STO eps
  ---- ;; bind header union type to typedef environment
  -- if (annotationList_field typeIR_field nameIR_field `; = typeFieldIR)*
  -- if typeDefIR
      = (HEADER_UNION nameIR `{ (typeIR_field nameIR_field `;)* }) 
          `< typeParameterListIR `, typeParameterListIR_inferred >
  -- if IC_1 = $add_typedef_inst(GLOBAL, IC_0, nameIR, typeDefIR)

;;;; typedefDeclarationIR
;;;; syntax typedefDeclarationIR

;;;;; annotationList TYPEDEF typedefTypeIR nameIR `;
;;;;; syntax typedefTypeIR

;;;;;; typeIR
;;;;;; derivedTypeDeclarationIR

rulegroup Decl_inst/typedefDeclarationIR-typedef {

  rule Decl_inst/typeIR:
    GLOBAL IC_0 STO |- annotationList TYPEDEF typeIR nameIR `;
                   ==> IC_1 STO eps
    ---- ;; bind type to typedef environment
    -- if typeIR_typedef = TYPEDEF nameIR typeIR
    -- if IC_1 = $add_typedef_inst(GLOBAL, IC_0, nameIR, typeIR_typedef)

  rule Decl_inst/derivedTypeDeclarationIR-mono:
    GLOBAL IC_0 STO |- annotationList TYPEDEF derivedTypeDeclarationIR nameIR `;
                   ==> IC_1 STO eps
    ---- ;; instantiate type declaration
    -- Decl_inst: GLOBAL IC_0 $empty_store |- derivedTypeDeclarationIR ==> IC_local _ _
    ---- ;; diff the local and global context to get the declared type id
    -- if `{ tid_newtype }
        = $diff_set<tid>(
            $dom_map<tid, typeDefIR>(IC_local.GLOBAL.TDENV),
            $dom_map<tid, typeDefIR>(IC_0.GLOBAL.TDENV))
    ---- ;; find the type definition
    -- if typeIR = $find_typedef_inst(GLOBAL, IC_local, `. tid_newtype)
    -- if typeIR_typedef = TYPEDEF nameIR typeIR
    -- if IC_1 = $add_typedef_inst(GLOBAL, IC_0, nameIR, typeIR_typedef)

  rule Decl_inst/derivedTypeDeclaration-poly:
    GLOBAL IC_0 STO |- annotationList TYPEDEF derivedTypeDeclarationIR nameIR `;
                   ==> IC_1 STO eps
    ---- ;; instantiate type declaration
    -- Decl_inst: GLOBAL IC_0 $empty_store |- derivedTypeDeclarationIR ==> IC_local _ _
    ---- ;; diff the local and global context to get the declared type id
    -- if `{ tid_newtype }
        = $diff_set<tid>(
            $dom_map<tid, typeDefIR>(IC_local.GLOBAL.TDENV),
            $dom_map<tid, typeDefIR>(IC_0.GLOBAL.TDENV))
    -- if typeIR `< eps `, eps >
        = $find_typedef_inst(GLOBAL, IC_local, `. tid_newtype)
    -- if typeIR_typedef = TYPEDEF nameIR ((typeIR `< eps `, eps >) `< eps >)
    ---- ;; bind specialized type to typedef environment
    -- if IC_1 = $add_typedef_inst(GLOBAL, IC_0, nameIR, typeIR_typedef)

}

;;;;; annotationList TYPE typeIR nameIR `;

rule Decl_inst/typedefDeclarationIR-newtype:
  GLOBAL IC_0 STO |- annotationList TYPE typeIR nameIR `;
                 ==> IC_1 STO eps
  ---- ;; bind newtype to typedef environment
  -- if typeIR_newtype = TYPE nameIR typeIR
  -- if IC_1 = $add_typedef_inst(GLOBAL, IC_0, nameIR, typeIR_newtype)

;;;; parserTypeDeclarationIR
;;;; syntax parserTypeDeclarationIR =
;;;;   annotationList PARSER nameIR
;;;;     `< typeParameterListIR `, typeParameterListIR >
;;;;     `( parameterListIR ) `;

rule Decl_inst/parserTypeDeclarationIR:
  GLOBAL IC_0 STO |- annotationList PARSER nameIR
                       `< typeParameterListIR `, typeParameterListIR_inferred >
                       `( parameterIR* ) `;
                 ==> IC_1 STO eps
  ---- ;; bind parser type to typedef environment
  -- if (parameterTypeIR = $typeof_parameterIR(parameterIR))*
  -- if typeIR_parser = PARSER `( parameterTypeIR* )
  -- if typeDefIR_parser
      = typeIR_parser `< typeParameterListIR `, typeParameterListIR_inferred >
  -- if IC_1 = $add_typedef_inst(GLOBAL, IC_0, nameIR, typeDefIR_parser)

;;;; controlTypeDeclarationIR
;;;; syntax controlTypeDeclarationIR =
;;;;   annotationList CONTROL nameIR
;;;;     `< typeParameterListIR `, typeParameterListIR >
;;;;     `( parameterListIR ) `;

rule Decl_inst/controlTypeDeclarationIR:
  GLOBAL IC_0 STO |- annotationList CONTROL nameIR
                       `< typeParameterListIR `, typeParameterListIR_inferred >
                       `( parameterIR* ) `;
                 ==> IC_1 STO eps
  ---- ;; bind control type to typedef environment
  -- if (parameterTypeIR = $typeof_parameterIR(parameterIR))*
  -- if typeIR_control = CONTROL `( parameterTypeIR* )
  -- if typeDefIR_control
      = typeIR_control `< typeParameterListIR `, typeParameterListIR_inferred >
  -- if IC_1 = $add_typedef_inst(GLOBAL, IC_0, nameIR, typeDefIR_control)

;;;; packageTypeDeclarationIR
;;;; syntax packageTypeDeclarationIR =
;;;;   annotationList PACKAGE nameIR
;;;;     `< typeParameterListIR `, typeParameterListIR >
;;;;     `( parameterListIR ) `;

rule Decl_inst/packageTypeDeclarationIR:
  GLOBAL IC_0 STO |- annotationList PACKAGE nameIR
                      `< typeParameterListIR `, typeParameterListIR_inferred >
                      `( parameterIR* ) `;
                 ==> IC_2 STO eps
  ---- ;; bind package type to typedef environment
  -- if (_ _ typeIR _ _ = parameterIR)*
  -- if typeIR_package = PACKAGE `< typeIR* >
  -- if typeDefIR_package
      = typeIR_package `< typeParameterListIR `, typeParameterListIR_inferred >
  -- if IC_1 = $add_typedef_inst(GLOBAL, IC_0, nameIR, typeDefIR_package)
  ---- ;; bind package constructor to constructor environment
  -- if cid = $cid_IR(nameIR, parameterIR*)
  -- if constructor_package
      = PACKAGE `< typeParameterListIR ++ typeParameterListIR_inferred > `( parameterIR* )
  -- if IC_2 = $add_constructor_inst(IC_1, cid, constructor_package)

;;
;; syntax declarationListIR
;;

rule Decls_inst/nil:
  p IC STO |- eps ==> IC STO eps

rule Decls_inst/cons-none:
  p IC_0 STO_0 |- declarationIR_h :: declarationIR_t*
              ==> IC_2 STO_2 declarationIR_t_inst*
  -- Decl_inst: p IC_0 STO_0 |- declarationIR_h ==> IC_1 STO_1 eps
  -- Decls_inst: p IC_1 STO_1 |- declarationIR_t* ==> IC_2 STO_2 declarationIR_t_inst*

rule Decls_inst/cons-some:
  p IC_0 STO_0 |- declarationIR_h :: declarationIR_t*
              ==> IC_2 STO_2 (declarationIR_h_inst :: declarationIR_t_inst*)
  -- Decl_inst: p IC_0 STO_0 |- declarationIR_h
                            ==> IC_1 STO_1 declarationIR_h_inst
  -- Decls_inst: p IC_1 STO_1 |- declarationIR_t*
                             ==> IC_2 STO_2 declarationIR_t_inst*

;;
;; syntax p4programIR
;;

rule Program_inst:
  |- p4program ==> IC_1.GLOBAL.CENV IC_1.GLOBAL.TDENV IC_1.GLOBAL.RENV IC_1.GLOBAL.VENV STO_1
  ---- ;; type check the program
  -- Program_ok: |- p4program : _ (declarationIR* `;)
  ---- ;; instantiate the declarations
  -- if IC_0 = $empty_instantiationContext
  -- if STO_0 = $empty_store
  -- Decls_inst: GLOBAL IC_0 STO_0 |- declarationIR* ==> IC_1 STO_1 eps
