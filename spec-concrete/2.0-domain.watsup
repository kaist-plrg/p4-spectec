;;
;; Cursor for scoping
;;

syntax cursor = GLOBAL | BLOCK | LOCAL

var p : cursor

;;
;; Names
;;

syntax nameIR = text

dec $name(name) : nameIR
  hint(prose_in "the name of" %0)
def $name(`ID t) = t
def $name(`TID t) = t
def $name(APPLY) = "apply"
def $name(KEY) = "key"
def $name(ACTIONS) = "actions"
def $name(STATE) = "state"
def $name(ENTRIES) = "entries"
def $name(TYPE) = "type"
def $name(PRIORITY) = "priority"
def $name(LIST) = "list"

dec $tableCustomName(tableCustomName) : nameIR
  hint(prose_in "the name of" %0)
def $tableCustomName(`ID t) = t
def $tableCustomName(`TID t) = t
def $tableCustomName(APPLY) = "apply"
def $tableCustomName(STATE) = "state"
def $tableCustomName(TYPE) = "type"
def $tableCustomName(PRIORITY) = "priority"

;;
;; Variable names
;;

syntax id = nameIR

;;
;; Type variable names
;;

syntax typeId = nameIR

builtin dec $fresh_typeId() : typeId
  hint(prose_in "a fresh type variable")

dec $fresh_typeIds(nat) : typeId*
  hint(prose_in %0 "fresh type variables")
def $fresh_typeIds(0) = eps
def $fresh_typeIds(n) = $fresh_typeId() :: $fresh_typeIds(n')
  -- if n =/= 0
  -- if n' = $(n - 1)

;;
;; Callable names
;;
;; A pair of function name and a list of parameter names,
;; with a boolean flag indicating whether the parameter has
;; a default value
;;

syntax parameterId = nameIR `# bool
syntax callableId = nameIR `( parameterId* )

dec $callableId(name, parameterList) : callableId
dec $callableId_(name, constructorParameterListOpt) : callableId
dec $parameterIds(parameterList) : parameterId*
dec $parameterId(parameter) : parameterId

def $callableId(name, parameterList)
  = $name(name) `( $parameterIds(parameterList) )

def $callableId_(name, `EMPTY) = $name(name) `( eps )
def $callableId_(name, `( parameterList )) = $callableId(name, parameterList)

def $parameterIds(`EMPTY) = eps
def $parameterIds(parameter) = $parameterId(parameter)
def $parameterIds(nonEmptyParameterList `, parameter)
  = $parameterIds(nonEmptyParameterList) ++ [ $parameterId(parameter) ]

def $parameterId(_ _ _ name `EMPTY) = $name(name) `# false
def $parameterId(_ _ _ name initializer) = $name(name) `# true

;;
;; Object names (fully qualified paths)
;;

syntax objectId = nameIR*

dec $objectId_ends_with(objectId, id) : bool
  hint(prose_in %0 "is an object name that ends with" %1)

def $objectId_ends_with(objectId, id) = true
  -- if id :: _ = $rev_<id>(objectId)
def $objectId_ends_with(objectId, id) = false
  -- otherwise
