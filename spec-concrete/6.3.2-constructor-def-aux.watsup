;;
;; Parameters of a constructor definition
;;

dec $parameters_of_constructorDef(constructorDef)
  : parameterIR*

def $parameters_of_constructorDef(
    EXTERN _ `< _ > `( constructorParameterListIR ) `{ _ })
  = constructorParameterListIR

def $parameters_of_constructorDef(
    PARSER `( _ ) `( constructorParameterListIR ) `{ _ _ })
  = constructorParameterListIR

def $parameters_of_constructorDef(
    CONTROL `( _ ) `( constructorParameterListIR ) `{ _ APPLY _ })
  = constructorParameterListIR

def $parameters_of_constructorDef(
    PACKAGE `< _ > `( constructorParameterListIR ))
  = constructorParameterListIR

def $parameters_of_constructorDef(TABLE _ `{ _ })
  = eps
