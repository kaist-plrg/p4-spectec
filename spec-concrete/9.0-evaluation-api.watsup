;;
;; Initialization
;;

;;
;;;; Global variable initialization
;;

relation Var_init:
  evaluationContext |- typeIR nameIR : evaluationContext
  hint(input %0 %1 %2)
  hint(prose_in "instantiating global variable" %2 "of type" %1 "in the evaluation context" %0)
  hint(prose_out "the resulting evaluation context" %3)

rule Var_init:
  EC_0 |- typeIR nameIR : EC_1
  -- if value = $default(typeIR)
  -- if EC_1 = $add_value_eval(GLOBAL, EC_0, `` nameIR, value)

;;
;;;; Extern initialization
;;;;
;;;; (TODO) Support instantiation with type arguments and arguments
;;

relation Extern_init:
  evaluationContext store |- nameIR : store
  hint(input %0 %1 %2)
  hint(prose_in "instantiating extern" %0 "in the evaluation context" %1 "and store" %2)
  hint(prose_out "the resulting store" %3)

rule Extern_init:
  EC STO_0 |- nameIR : STO_2
  -- if IC = { PATH ([]),
               GLOBAL EC.GLOBAL,
               BLOCK EC.BLOCK,
               LOCAL EC.LOCAL }
  -- if (_, constructor, _)
      = $find_constructor_inst(IC, `` nameIR, eps)
  -- Constructor_inst:
      GLOBAL IC STO_0 |- constructor `< eps > `( eps `# eps ) ==> STO_1 object
  -- if oid_object = [ nameIR ]
  -- if STO_2 = $add_map<oid, object>(STO_1, oid_object, object)

;;
;;;; Program initialization
;;;;
;;;; syntax p4program
;;

relation Program_init:
  |- p4program : evaluationContext store
  hint(input %0)
  hint(prose_in "initializing the evaluation context and store for" %0)
  hint(prose_out "the resulting evaluation context" %1#" and store" %2)

rule Program_init:
  |- p4program : EC STO
  -- Program_inst: |- p4program ==> globalEvaluationLayer STO
  -- if blockEvaluationLayer
      = { TYPE $empty_tenv,
          ROUTINE $empty_renv,
          STATE $empty_senv,
          FRAME $empty_frame }
  -- if localEvaluationLayer
      = { TYPE $empty_tenv,
          FRAMES ([ $empty_frame ]) }
  -- if EC = { GLOBAL globalEvaluationLayer,
               BLOCK blockEvaluationLayer,
               LOCAL localEvaluationLayer }

;;
;; Invocation
;;

;;
;;;; Parser object invocation
;;

relation Parser_invoke:
  evaluationContext store |- parserObject `. APPLY `( argumentListIR )
                           : evaluationContext store transitionResult
  hint(input %0 %1 %2 %3)

rule Parser_invoke:
  EC_caller_0 STO_0 |- parserObject `. APPLY `( argumentListIR )
                     : EC_caller_2 STO_2 transitionResult
  ---- ;; unpack the parser object
  -- if PARSER `( parameterListIR )
          `{ frame parserLocalDeclarationListIR senv }
      = parserObject
  ---- ;; crete the callee context
  -- if EC_callee_0
      = $inherit_evaluationContext(GLOBAL, EC_caller_0)
  -- if EC_callee_1
      = EC_callee_0[ .BLOCK.FRAME = frame ][ .BLOCK.STATE = senv ]
  ---- ;; align parameters with arguments
  -- if (parameterIR_aligned*, argumentIR_aligned*,
         parameterIR_default*, value_default*)
      = $align_params_with_args(parameterListIR, argumentListIR, eps)
  ---- ;; copy-in
  -- Copy_in:
      STO_0 GLOBAL EC_caller_0 parameterIR_aligned*
         `@ BLOCK EC_callee_1 argumentIR_aligned*
      ~> STO_1 EC_caller_1 `@ EC_callee_2 `# (CONT storageReference?*)
  -- Copy_in_default:
      parameterIR_default* `@ BLOCK EC_callee_2 value_default*
      ~> `@ EC_callee_3
  ---- ;; evaluate local declarations
  -- ParserLocalDecls_eval:
      EC_callee_3 STO_1 |- parserLocalDeclarationListIR
                          : EC_callee_4 STO_2
  ---- ;; execute the parser state machine
  -- ParserState_trans:
      EC_callee_4 STO_2 |- TRANSITION "start"
                         : EC_callee_5 STO_3 transitionResult
  ---- ;; copy-out
  -- Copy_out:
      GLOBAL EC_caller_1 parameterIR_aligned*
      `@ BLOCK EC_callee_5 storageReference?*
      ~> EC_caller_2
