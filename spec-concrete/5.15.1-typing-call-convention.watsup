;;
;; Helpers
;;

;;; Filtering out default parameters

dec $filter_default_parameterIRs(parameterIR*, id*) : parameterIR*

def $filter_default_parameterIRs(eps, id_default*) = eps
def $filter_default_parameterIRs(
    parameterIR_h :: parameterIR_t*,
    id_default*
  )
  = $filter_default_parameterIRs(parameterIR_t*, id_default*)
  -- if _ _ _ nameIR_h _ = parameterIR_h
  -- if nameIR_h <- id_default*
def $filter_default_parameterIRs(
    parameterIR_h :: parameterIR_t*,
    id_default*
  )
  = parameterIR_h
    :: $filter_default_parameterIRs(parameterIR_t*, id_default*)
  -- otherwise

;;; Aligning parameters if the arguments are named

dec $align_parameterIRs(parameterIR*, argumentIR*)
  : parameterIR*
dec $align_parameterIRs'(
    map<id, parameterIR>, parameterIR, argumentIR
  ): parameterIR?

def $align_parameterIRs(parameterIR*, argumentIR*)
  = parameterIR_aligned*
  -- if (_ _ _ nameIR _ = parameterIR)*
  -- (if parameterIR_aligned
       = $align_parameterIRs'(
          `{ (nameIR `: parameterIR)* }, parameterIR, argumentIR
         ))*

def $align_parameterIRs'(_, parameterIR, typedExpressionIR)
  = parameterIR
def $align_parameterIRs'(`{ (id_param `: parameterIR)* }, _, nameIR `= _)
  = $find_map<id, parameterIR>(`{ (id_param `: parameterIR)* }, nameIR)
def $align_parameterIRs'(`{ (id_param `: parameterIR)* }, _, nameIR `= `_)
  = $find_map<id, parameterIR>(`{ (id_param `: parameterIR)* }, nameIR)
def $align_parameterIRs'(_, parameterIR, `_)
  = parameterIR

;;
;; Calling convention (single argument)
;;

;; syntax direction

;;; IN

rule Call_convention_expr_ok/in:
  p TC actctxt |- (_ IN typeIR_param _ _) `@ typedExpressionIR_arg
                : typedExpressionIR_arg_cast
  ---- ;; may insert implicit casts for direction in
  -- if typedExpressionIR_arg_cast
      = $coerce_unary(typedExpressionIR_arg, typeIR_param)

;;; OUT | INOUT

relation Expr_lvalue_ok:
  cursor typingContext |- typedExpressionIR
  hint(input %0 %1 %2)
  hint(prose_in %2 "is a valid l-value, under cursor" %0 "and typing context" %1)

rule Expr_lvalue_ok/referenceExpressionIR:
  p TC |- prefixedNameIR `# `( _ _ )
  -- if direction _ DYN _ = $find_var_t(p, TC, prefixedNameIR)
  -- if direction = OUT \/ direction = INOUT

rulegroup Expr_lvalue_ok/accessExpressionIR-memberAccessExpressionIR {

  rule Expr_lvalue_ok/headerstack-next-last:
    p TC |- (typedExpressionIR_base `. nameIR) `# `( _ _ )
    -- Expr_lvalue_ok: p TC |- typedExpressionIR_base
    ---- ;; if the base expression is a header stack
    -- if typeIR_base = $type_of_typedExpressionIR(typedExpressionIR_base)
    -- if typeIR `[ _ ] = $canon_typeIR(typeIR_base)
    ---- ;; if accessing "next" or "last"
    -- if nameIR = "next" \/ nameIR = "last"
    ---- ;; "next" and "last" can be only used within a parser
    -- if (p = BLOCK /\ $is_parser_blockKind(TC.BLOCK.KIND))
          \/ (p = LOCAL /\ $is_parser_state_localKind(TC.LOCAL.KIND))

  rule Expr_lvalue_ok/non-headerstack:
    p TC |- (typedExpressionIR_base `. nameIR) `# `( _ _ )
    -- Expr_lvalue_ok: p TC |- typedExpressionIR_base
    -- if typeIR_base = $type_of_typedExpressionIR(typedExpressionIR_base)
    ---- ;; if the base expression is not a header stack
    -- if ~$is_headerStackTypeIR($canon_typeIR(typeIR_base))

}

rule Expr_lvalue_ok/accessExpressionIR-indexAccessExpressionIR:
  p TC |- (typedExpressionIR_base `[ typedExpressionIR_index ]) `# `( _ _ )
  -- Expr_lvalue_ok: p TC |- typedExpressionIR_base

rule Expr_lvalue_ok/accessExpressionIR-indexAccessExpressionIR-bitslice:
  p TC |- (typedExpressionIR_base `[ typedExpressionIR_hi
                                    `: typedExpressionIR_lo ]) `# `( _ _ )
  -- Expr_lvalue_ok: p TC |- typedExpressionIR_base

rule Call_convention_expr_ok/out-inout:
  p TC actctxt |- (_ direction typeIR_param _ _) `@ typedExpressionIR_arg
                : typedExpressionIR_arg
  -- if direction = OUT \/ direction = INOUT
  ---- ;; may not insert implicit casts for direction out or inout
  -- if typeIR_arg = $type_of_typedExpressionIR(typedExpressionIR_arg)
  -- Type_alpha: typeIR_param ~~ typeIR_arg
  ---- ;; for copy-out, the expression must be a l-value
  -- Expr_lvalue_ok: p TC |- typedExpressionIR_arg

;;; `EMPTY

rulegroup Call_convention_expr_ok/empty {

  rule Call_convention_expr_ok/action:
    p TC ACTION |- (_ `EMPTY typeIR_param _ _) `@ typedExpressionIR_arg
                 : typedExpressionIR_arg_cast
     ---- ;; may insert implicit casts for directionless action argument
    -- if typedExpressionIR_arg_cast
        = $coerce_unary(typedExpressionIR_arg, typeIR_param) 
    
  rule Call_convention_expr_ok/non-action:
    p TC NOACTION |- (_ `EMPTY typeIR_param _ _) `@ typedExpressionIR_arg
                   : typedExpressionIR_arg
    ---- ;; may insert implicit casts for directionless non-action argument
    -- if typedExpressionIR_arg_cast
        = $coerce_unary(typedExpressionIR_arg, typeIR_param) 
    ---- ;; the argument must be compile-time known
    -- if DYN =/= $ctk_of_typedExpressionIR(typedExpressionIR_arg)

}

;; syntax argumentIR

;;; typedExpressionIR

rule Call_convention_argument_ok/typedExpression:
  p TC actctxt |- parameterIR `@ typedExpressionIR
                : typedExpressionIR_cast
  -- Call_convention_expr_ok:
      p TC actctxt |- parameterIR `@ typedExpressionIR
                    : typedExpressionIR_cast

;;; nameIR `= typedExpressionIR

rule Call_convention_argument_ok/nameIR-typedExpression:
  p TC actctxt |- parameterIR `@ (nameIR `= typedExpressionIR)
                : (nameIR `= typedExpressionIR_cast)
  -- Call_convention_expr_ok:
      p TC actctxt |- parameterIR `@ typedExpressionIR
                    : typedExpressionIR_cast

;;; nameIR `= `_

rule Call_convention_argument_ok/nameIR-dontcare:
  p TC actctxt |- parameterIR `@ (nameIR `= `_)
                : (nameIR `= `_)
  -- if _ OUT _ _ _ = parameterIR

;;; `_

rule Call_convention_argument_ok/dontcare:
  p TC actctxt |- parameterIR `@ `_ : `_
  -- if _ OUT _ _ _ = parameterIR

;;
;; Calling convention (multiple arguments)
;;

rule Call_convention_ok/nil:
  p TC actctxt |- eps `@ eps : eps

rule Call_convention_ok/cons:
  p TC actctxt |- (parameterIR_h :: parameterIR_t*)
                    `@ (argumentIR_h :: argumentIR_t*)
                : (argumentIR_h_cast :: argumentIR_t_cast*)
  -- Call_convention_argument_ok:
      p TC actctxt |- parameterIR_h `@ argumentIR_h
                    : argumentIR_h_cast
  -- Call_convention_ok:
      p TC actctxt |- parameterIR_t* `@ argumentIR_t*
                    : argumentIR_t_cast*
