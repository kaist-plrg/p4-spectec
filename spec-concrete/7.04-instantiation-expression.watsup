;;
;; Expression evaluation for instantiation
;;
;; syntax typedExpressionIR =
;;   expressionIR `# `( typeIR ctk )
;;

;;; syntax expressionIR

;;;; literalExpressionIR
;;;; syntax literalExpression

;;;;; TRUE | FALSE

rulegroup Expr_inst/literalExpressionIR-boolean {

  rule Expr_inst/true:
    p IC STO |- TRUE `# _ ==> STO (B true)

  rule Expr_inst/false:
    p IC STO |- FALSE `# _ ==> STO (B false)

}

;;;;; number

rulegroup Expr_inst/literalExpression-number {

  rule Expr_inst/arbint:
    p IC STO |- (D i) `# _ ==> STO (D i)

  rule Expr_inst/fixbit:
    p IC STO |- (n W i) `# _ ==> STO (n W i)

  rule Expr_inst/fixint:
    p IC STO |- (n S i) `# _ ==> STO (n S i)

}

;;;;; stringLiteral

rule Expr_inst/literalExpressionIR-stringLiteral:
  p IC STO |- (`" text `") `# _ ==> STO (`" text `")

;;;; referenceExpressionIR
;;;; syntax referenceExpressionIR = prefixedNameIR

rule Expr_inst/referenceExpressionIR:
  p IC STO |- prefixedNameIR `# _ ==> STO value
  -- if value = $find_value_inst(p, IC, prefixedNameIR)

;;;; defaultExpressionIR

rule Expr_inst/defaultExpressionIR:
  p IC STO |- `... `# _ ==> STO DEFAULT

;;;; unaryExpressionIR
;;;; syntax unaryExpressionIR = unop typedExpressionIR

rulegroup Expr_inst/unaryExpressionIR {

  rule Expr_inst/bnot:
    p IC STO_0 |- (`~ typedExpressionIR) `# _ ==> STO_1 $un_bnot(value)
    -- Expr_inst: p IC STO_0 |- typedExpressionIR ==> STO_1 value

  rule Expr_inst/lnot:
    p IC STO_0 |- (`! typedExpressionIR) `# _ ==> STO_1 $un_lnot(value)
    -- Expr_inst: p IC STO_0 |- typedExpressionIR ==> STO_1 value

  rule Expr_inst/plus:
    p IC STO_0 |- (`+ typedExpressionIR) `# _ ==> STO_1 $un_plus(value)
    -- Expr_inst: p IC STO_0 |- typedExpressionIR ==> STO_1 value

  rule Expr_inst/minus:
    p IC STO_0 |- (`- typedExpressionIR) `# _ ==> STO_1 $un_minus(value)
    -- Expr_inst: p IC STO_0 |- typedExpressionIR ==> STO_1 value

}

;;;; binaryExpressionIR
;;;; syntax binaryExpressionIR =
;;;;   typedExpressionIR binop typedExpressionIR

rulegroup Expr_inst/binaryExpressionIR {

  rule Expr_inst/plus:
    p IC STO_0 |- (typedExpressionIR_l `+ typedExpressionIR_r) `# _
              ==> STO_2 $bin_plus(value_l, value_r)
    -- Expr_inst: p IC STO_0 |- typedExpressionIR_l ==> STO_1 value_l
    -- Expr_inst: p IC STO_1 |- typedExpressionIR_r ==> STO_2 value_r

  rule Expr_inst/satplus:
    p IC STO_0 |- (typedExpressionIR_l `|+| typedExpressionIR_r) `# _
              ==> STO_2 $bin_satplus(value_l, value_r)
    -- Expr_inst: p IC STO_0 |- typedExpressionIR_l ==> STO_1 value_l
    -- Expr_inst: p IC STO_1 |- typedExpressionIR_r ==> STO_2 value_r

  rule Expr_inst/minus:
    p IC STO_0 |- (typedExpressionIR_l `- typedExpressionIR_r) `# _
              ==> STO_2 $bin_minus(value_l, value_r)
    -- Expr_inst: p IC STO_0 |- typedExpressionIR_l ==> STO_1 value_l
    -- Expr_inst: p IC STO_1 |- typedExpressionIR_r ==> STO_2 value_r

  rule Expr_inst/satminus:
    p IC STO_0 |- (typedExpressionIR_l `|-| typedExpressionIR_r) `# _
            ==> STO_2 $bin_satminus(value_l, value_r)
    -- Expr_inst: p IC STO_0 |- typedExpressionIR_l ==> STO_1 value_l
    -- Expr_inst: p IC STO_1 |- typedExpressionIR_r ==> STO_2 value_r

  rule Expr_inst/mul:
    p IC STO_0 |- (typedExpressionIR_l `* typedExpressionIR_r) `# _
              ==> STO_2 $bin_mul(value_l, value_r)
    -- Expr_inst: p IC STO_0 |- typedExpressionIR_l ==> STO_1 value_l
    -- Expr_inst: p IC STO_1 |- typedExpressionIR_r ==> STO_2 value_r

  rule Expr_inst/div:
    p IC STO_0 |- (typedExpressionIR_l `/ typedExpressionIR_r) `# _
              ==> STO_2 $bin_div(value_l, value_r)
    -- Expr_inst: p IC STO_0 |- typedExpressionIR_l ==> STO_1 value_l
    -- Expr_inst: p IC STO_1 |- typedExpressionIR_r ==> STO_2 value_r

  rule Expr_inst/mod:
    p IC STO_0 |- (typedExpressionIR_l `% typedExpressionIR_r) `# _
              ==> STO_2 $bin_mod(value_l, value_r)
    -- Expr_inst: p IC STO_0 |- typedExpressionIR_l ==> STO_1 value_l
    -- Expr_inst: p IC STO_1 |- typedExpressionIR_r ==> STO_2 value_r

  rule Expr_inst/shl:
    p IC STO_0 |- (typedExpressionIR_l `<< typedExpressionIR_r) `# _
              ==> STO_2 $bin_shl(value_l, value_r)
    -- Expr_inst: p IC STO_0 |- typedExpressionIR_l ==> STO_1 value_l
    -- Expr_inst: p IC STO_1 |- typedExpressionIR_r ==> STO_2 value_r

  rule Expr_inst/shr:
    p IC STO_0 |- (typedExpressionIR_l `>> typedExpressionIR_r) `# _
              ==> STO_2 $bin_shr(value_l, value_r)
    -- Expr_inst: p IC STO_0 |- typedExpressionIR_l ==> STO_1 value_l
    -- Expr_inst: p IC STO_1 |- typedExpressionIR_r ==> STO_2 value_r

  rule Expr_inst/le:
    p IC STO_0 |- (typedExpressionIR_l `<= typedExpressionIR_r) `# _
              ==> STO_2 (B $bin_le(value_l, value_r))
    -- Expr_inst: p IC STO_0 |- typedExpressionIR_l ==> STO_1 value_l
    -- Expr_inst: p IC STO_1 |- typedExpressionIR_r ==> STO_2 value_r

  rule Expr_inst/ge:
    p IC STO_0 |- (typedExpressionIR_l `>= typedExpressionIR_r) `# _
              ==> STO_2 (B $bin_ge(value_l, value_r))
    -- Expr_inst: p IC STO_0 |- typedExpressionIR_l ==> STO_1 value_l
    -- Expr_inst: p IC STO_1 |- typedExpressionIR_r ==> STO_2 value_r

  rule Expr_inst/lt:
    p IC STO_0 |- (typedExpressionIR_l ``< typedExpressionIR_r) `# _
              ==> STO_2 (B $bin_lt(value_l, value_r))
    -- Expr_inst: p IC STO_0 |- typedExpressionIR_l ==> STO_1 value_l
    -- Expr_inst: p IC STO_1 |- typedExpressionIR_r ==> STO_2 value_r

  rule Expr_inst/gt:
    p IC STO_0 |- (typedExpressionIR_l ``> typedExpressionIR_r) `# _
              ==> STO_2 (B $bin_gt(value_l, value_r))
    -- Expr_inst: p IC STO_0 |- typedExpressionIR_l ==> STO_1 value_l
    -- Expr_inst: p IC STO_1 |- typedExpressionIR_r ==> STO_2 value_r

  rule Expr_inst/eq:
    p IC STO_0 |- (typedExpressionIR_l `== typedExpressionIR_r) `# _
              ==> STO_2 (B $bin_eq(value_l, value_r))
    -- Expr_inst: p IC STO_0 |- typedExpressionIR_l ==> STO_1 value_l
    -- Expr_inst: p IC STO_1 |- typedExpressionIR_r ==> STO_2 value_r

  rule Expr_inst/ne:
    p IC STO_0 |- (typedExpressionIR_l `!= typedExpressionIR_r) `# _
              ==> STO_2 (B $bin_ne(value_l, value_r))
    -- Expr_inst: p IC STO_0 |- typedExpressionIR_l ==> STO_1 value_l
    -- Expr_inst: p IC STO_1 |- typedExpressionIR_r ==> STO_2 value_r

  rule Expr_inst/band:
    p IC STO_0 |- (typedExpressionIR_l `& typedExpressionIR_r) `# _
              ==> STO_2 $bin_band(value_l, value_r)
    -- Expr_inst: p IC STO_0 |- typedExpressionIR_l ==> STO_1 value_l
    -- Expr_inst: p IC STO_1 |- typedExpressionIR_r ==> STO_2 value_r

  rule Expr_inst/bxor:
    p IC STO_0 |- (typedExpressionIR_l `^ typedExpressionIR_r) `# _
              ==> STO_2 $bin_bxor(value_l, value_r)
    -- Expr_inst: p IC STO_0 |- typedExpressionIR_l ==> STO_1 value_l
    -- Expr_inst: p IC STO_1 |- typedExpressionIR_r ==> STO_2 value_r

  rule Expr_inst/bor:
    p IC STO_0 |- (typedExpressionIR_l `| typedExpressionIR_r) `# _
              ==> STO_2 $bin_bor(value_l, value_r)
    -- Expr_inst: p IC STO_0 |- typedExpressionIR_l ==> STO_1 value_l
    -- Expr_inst: p IC STO_1 |- typedExpressionIR_r ==> STO_2 value_r

  rule Expr_inst/concat:
    p IC STO_0 |- (typedExpressionIR_l `++ typedExpressionIR_r) `# _
              ==> STO_2 $bin_concat(value_l, value_r)
    -- Expr_inst: p IC STO_0 |- typedExpressionIR_l ==> STO_1 value_l
    -- Expr_inst: p IC STO_1 |- typedExpressionIR_r ==> STO_2 value_r

  rule Expr_inst/land:
    p IC STO_0 |- (typedExpressionIR_l `&& typedExpressionIR_r) `# _
              ==> STO_2 $bin_land(value_l, value_r)
    -- Expr_inst: p IC STO_0 |- typedExpressionIR_l ==> STO_1 value_l
    -- Expr_inst: p IC STO_1 |- typedExpressionIR_r ==> STO_2 value_r

  rule Expr_inst/lor:
    p IC STO_0 |- (typedExpressionIR_l `|| typedExpressionIR_r) `# _
              ==> STO_2 $bin_lor(value_l, value_r)
    -- Expr_inst: p IC STO_0 |- typedExpressionIR_l ==> STO_1 value_l
    -- Expr_inst: p IC STO_1 |- typedExpressionIR_r ==> STO_2 value_r

}

;;;; ternaryExpressionIR
;;;; syntax ternaryExpressionIR =
;;;;   typedExpressionIR `? typedExpressionIR `: typedExpressionIR

rulegroup Expr_inst/ternaryExpressionIR {

  rule Expr_inst/true:
    p IC STO_0 |- (typedExpressionIR_cond `? typedExpressionIR_true `: typedExpressionIR_false) `# _
              ==> STO_2 value_true
    -- Expr_inst: p IC STO_0 |- typedExpressionIR_cond ==> STO_1 (B true)
    -- Expr_inst: p IC STO_1 |- typedExpressionIR_true ==> STO_2 value_true

  rule Expr_inst/false:
    p IC STO_0 |- (typedExpressionIR_cond `? typedExpressionIR_true `: typedExpressionIR_false) `# _
              ==> STO_2 value_false
    -- Expr_inst: p IC STO_0 |- typedExpressionIR_cond ==> STO_1 (B false)
    -- Expr_inst: p IC STO_1 |- typedExpressionIR_false ==> STO_2 value_false

}

;;;; castExpressionIR
;;;; syntax castExpressionIR = `( typeIR ) typedExpressionIR

rule Expr_inst/castExpressionIR:
  p IC STO_0 |- (`( typeIR ) typedExpressionIR) `# _ ==> STO_1 value_cast
  -- Expr_inst: p IC STO_0 |- typedExpressionIR ==> STO_1 value
  -- if value_cast = $cast_op(typeIR, value)

;;;; dataExpressionIR
;;;; syntax dataExpressionIR

;;;;; `{#}

rule Expr_inst/dataExpressionIR-invalid:
  p IC STO |- `{#} `# _ ==> STO `{#}

;;;;; SEQ `{ typedExpressionListIR }
;;;;; SEQ `{ typedExpressionListIR `, `... }

rulegroup Expr_inst/dataExpressionIR-sequence {

  rule Expr_inst/non-default:
    p IC STO_0 |- (SEQ `{ typedExpressionListIR }) `# _
              ==> STO_1 (SEQ `( value* ))
    -- Exprs_inst: p IC STO_0 |- typedExpressionListIR ==> STO_1 value*

  rule Expr_inst/default:
    p IC STO_0 |- (SEQ `{ typedExpressionListIR `, `... }) `# _
              ==> STO_1 (SEQ `( value* `, `... ))
    -- Exprs_inst: p IC STO_0 |- typedExpressionListIR ==> STO_1 value*

}

;;;;; RECORD `{ namedExpressionListIR }
;;;;; RECORD `{ namedExpressionListIR `, `... }

rulegroup Expr_inst/dataExpressionIR-record {

  rule Expr_inst/non-default:
    p IC STO_0 |- (RECORD `{ (nameIR `= typedExpressionIR)* }) `# _
              ==> STO_1 (RECORD `{ (value nameIR `;)* })
    -- Exprs_inst: p IC STO_0 |- typedExpressionIR* ==> STO_1 value*

  rule Expr_inst/default:
    p IC STO_0 |- (RECORD `{ (nameIR `= typedExpressionIR)* `, `... }) `# _
              ==> STO_1 (RECORD `{ (value nameIR `;)* `, `... })
    -- Exprs_inst: p IC STO_0 |- typedExpressionIR* ==> STO_1 value*

}

;;;; accessExpressionIR
;;;; syntax accessExpressionIR

;;;;; errorAccessExpressionIR
;;;;; syntax errorAccessExpressionIR = ERROR `. nameIR

rule Expr_inst/accessExpressionIR-errorAccessExpressionIR:
  p IC STO |- (ERROR `. nameIR) `# _ ==> STO value_error
  -- if nameIR_error = "error." ++ nameIR
  -- if value_error = $find_value_inst(p, IC, `` nameIR_error)

;;;;; memberAccessExpressionIR
;;;;; syntax memberAccessExpressionIR = memberAccessBaseIR `. nameIR
;;;;;; syntax memberAccessBaseIR

;;;;;;; TYPE prefixedNameIR

rulegroup Expr_inst/accessExpressionIR-memberAccessExpressionIR-type {

  rule Expr_inst/enum:
    p IC STO |- ((TYPE prefixedNameIR) `. nameIR) `# _
            ==> STO (tid `. nameIR)
    -- if ENUM tid `{ _ } = $find_typedef_inst(p, IC, prefixedNameIR)

  rule Expr_inst/serenum:
    p IC STO |- ((TYPE prefixedNameIR) `. nameIR) `# _
            ==> STO (tid `. nameIR `# value)
    -- if ENUM tid `# _ `{ (id_member `= value_member `;)* }
        = $find_typedef_inst(p, IC, prefixedNameIR)
    -- if value = $assoc_<nameIR, value>(nameIR, (id_member, value_member)*)

}

;;;;;;; typedExpressionIR

rule Expr_inst/accessExpressionIR-memberAccessExpressionIR-typedExpressionIR-stack-size:
  p IC STO |- (typedExpressionIR_base `. "size") `# `( typeIR_base _ )
            ==> STO (D n_size)
  -- if _ `# `( typeIR_base _ ) = typedExpressionIR_base
  -- if _ `[ n_size ] = $canon(typeIR_base)

;;;;; indexAccessExpressionIR
;;;;; syntax indexAccessExpressionIR

;;;;;; typedExpressionIR `[ typedExpressionIR ]
;;;;;; tuple or stack accesses are not evaluated statically

;;;;;; typedExpressionIR `[ typedExpressionIR `: typedExpressionIR ]

rule Expr_inst/indexAccessExpressionIR-bitslice:
  p IC STO_0 |- (typedExpressionIR_base `[ typedExpressionIR_hi `: typedExpressionIR_lo ]) `# _
            ==> STO_3 $bitacc_op(value_base, value_hi, value_lo)
  -- Expr_inst: p IC STO_0 |- typedExpressionIR_base ==> STO_1 value_base
  -- Expr_inst: p IC STO_1 |- typedExpressionIR_hi ==> STO_2 value_hi
  -- Expr_inst: p IC STO_2 |- typedExpressionIR_lo ==> STO_3 value_lo

;;;; callExpressionIR
;;;; syntax callExpressionIR

;;;;; constructorTargetIR `( argumentListIR )

rule Expr_inst/callExpressionIR-instantiation:
  p IC STO_0 |- ((prefixedNameIR `< typeArgumentListIR >) `( argumentListIR )) `# _
            ==> STO_2 value_ref
  ---- ;; find and instantiate constructor
  -- if (_, constructor, id_default*)
      = $find_constructor_inst(IC, prefixedNameIR, argumentListIR)
  -- Constructor_inst:
      p IC STO_0 |- constructor `< typeArgumentListIR > `( argumentListIR `# id_default* )
                ==> STO_1 object
  ---- ;; add object to caller store
  -- if STO_2 = $add_map<oid, object>(STO_1, IC.PATH, object)
  ---- ;; create reference value
  -- if value_ref = `! IC.PATH

;;;;; routineTargetIR `< typeArgumentListIR > `( argumentListIR )

;;;;;; syntax routineTargetIR

;;;;;;; referenceExpressionIR
;;;;;;; function/action calls are not evaluated statically

;;;;;;; typedExpressionIR `. nameIR

rule Expr_inst/callExpressionIR-typedeExpressionIR-size:
  p IC STO |- ((typedExpressionIR_base `. nameIR) `< eps > `( eps )) `# _
          ==> STO $sizeof(typeIR_base, nameIR)
  -- if _ `# `( typeIR_base _ ) = typedExpressionIR_base
  -- if nameIR <- [ "minSizeInBits", "minSizeInBytes", "maxSizeInBits", "maxSizeInBytes" ]

;;;;;;; TYPE prefixedNameIR `. nameIR

rulegroup Expr_inst/callExpressionIR-type {

  rule Expr_inst/size-mono:
    p IC STO |- ((TYPE prefixedNameIR `. nameIR) `< eps > `( eps )) `# _
            ==> STO $sizeof(typeIR_base, nameIR)
    -- if typeIR_base = $find_typedef_inst(p, IC, prefixedNameIR)
    -- if nameIR <- [ "minSizeInBits", "minSizeInBytes", "maxSizeInBits", "maxSizeInBytes" ]

  rule Expr_inst/size-poly:
    p IC STO |- ((TYPE prefixedNameIR `. nameIR) `< eps > `( eps )) `# _
            ==> STO $sizeof(typeIR_base, nameIR)
    -- if typeIR_base `< eps `, eps > = $find_typedef_inst(p, IC, prefixedNameIR)
    -- if nameIR <- [ "minSizeInBits", "minSizeInBytes", "maxSizeInBits", "maxSizeInBytes" ]

}

;;;;;;; `( routineTargetIR )

rule Expr_inst/callExpressionIR-parenthesized:
  p IC STO_0 |- ((`( routineTargetIR )) `< typeArgumentListIR > `( argumentListIR ))
                `# expressionNoteIR
            ==> STO_1 value
    -- Expr_inst:
        p IC STO_0 |- (routineTargetIR `< typeArgumentListIR > `( argumentListIR ))
                      `# expressionNoteIR
                  ==> STO_1 value

;;;; parenthesizedExpressionIR
;;;; syntax parenthesizedExpressionIR = `( typedExpressionIR )

rule Expr_inst/parenthesizedExpressionIR:
  p IC STO_0 |- (`( typedExpressionIR )) `# _ ==> STO_1 value
  -- Expr_inst: p IC STO_0 |- typedExpressionIR ==> STO_1 value

;;
;; Expression list instantiation
;;
;; syntax typedExpressionListIR
;;

rule Exprs_inst/nil:
  p IC STO |- eps ==> STO eps

rule Exprs_inst/cons:
  p IC STO_0 |- typedExpressionIR_h :: typedExpressionIR_t*
            ==> STO_2 (value_h :: value_t*)
  -- Expr_inst: p IC STO_0 |- typedExpressionIR_h ==> STO_1 value_h
  -- Exprs_inst: p IC STO_1 |- typedExpressionIR_t* ==> STO_2 value_t*
