;;
;; Routines
;;

syntax renv, senv

syntax action = ACTION `( parameterListIR ) blockStatementIR

syntax builtinFunction =
  BUILTIN_FUNCTION `< typeParameterListIR > `( parameterListIR )

syntax definedFunction =
  FUNCTION `< typeParameterListIR > `( parameterListIR ) blockStatementIR

syntax externFunction =
  EXTERN_FUNCTION `< typeParameterListIR > `( parameterListIR )

syntax function =
  | builtinFunction
  | definedFunction
  | externFunction

syntax builtinMethod =
  BUILTIN_METHOD `( parameterListIR ) `# storageReference

syntax externMethod =
  | EXTERN_METHOD `< typeParameterListIR > `( parameterListIR ) blockStatementIR?
  | EXTERN_METHOD ABSTRACT `< typeParameterListIR > `( parameterListIR )

syntax parserApplyMethod =
  PARSER_APPLY `( parameterListIR )
    `{ parserLocalDeclarationListIR `; senv }

syntax controlApplyMethod =
  CONTROL_APPLY `( parameterListIR )
    `{ controlLocalDeclarationListIR `; renv `; blockElementStatementListIR }

syntax tableApplyMethod =
  TABLE_APPLY `{ tablePropertyListIR }

syntax method =
  | builtinMethod
  | externMethod
  | parserApplyMethod
  | controlApplyMethod
  | tableApplyMethod

syntax routine = action | function | method
