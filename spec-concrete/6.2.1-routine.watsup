;;
;; Routines
;;

syntax renv, senv

syntax function =
  | BUILTIN_FUNCTION `< typeParameterListIR > `( parameterListIR )
  | FUNCTION `< typeParameterListIR > `( parameterListIR ) blockStatementIR
  | ACTION `( parameterListIR ) blockStatementIR
  | EXTERN_FUNCTION `< typeParameterListIR > `( parameterListIR )

syntax method =
  | BUILTIN_METHOD `( parameterListIR ) `# lvalueDyn 
  | EXTERN_METHOD `< typeParameterListIR > `( parameterListIR ) blockStatementIR?
  | EXTERN_METHOD ABSTRACT `< typeParameterListIR > `( parameterListIR )
  | PARSER_APPLY `( parameterListIR )
    `{ parserLocalDeclarationListIR `; senv }
  | CONTROL_APPLY `( parameterListIR )
    `{ controlLocalDeclarationListIR `; renv `; blockElementStatementListIR }
  | TABLE_APPLY `{ tablePropertyListIR }

syntax routine = 
  | function
  | method
