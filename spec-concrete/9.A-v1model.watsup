;;
;; V1Model deparser invocation
;;

relation V1Model_deparse:
  evalContext store |- evalContext store callResult
  hint(input %0 %1)

rule V1Model_deparse:
  EC_0 STO_0 |- EC_1 STO_1 (RETURN eps)
  ---- ;; prepare the arguments
  -- if argumentIR_packet_out
      = $V1Model_setup_packet_out_argument(EC_0)
  -- if argumentIR_hdr
      = $V1Model_setup_hdr_argument(STO_0)
  -- if argumentIR* = [ argumentIR_packet_out, argumentIR_hdr ]
  ---- ;; invoke the deparse object (main.dep)
  -- if typedExpressionIR_main
      = $V1Model_setup_main_callee(EC_0, STO_0)
  -- if typedExpressionIR_dep
      = $V1Model_setup_deparse_callee(EC_0, STO_0, typedExpressionIR_main)
  -- if callableTargetIR = typedExpressionIR_dep `. "apply"
  -- Stmt_eval:
      GLOBAL EC_0 STO_0 |- callableTargetIR `< eps > `( argumentIR* ) `;
                         : EC_1 STO_1 ``
