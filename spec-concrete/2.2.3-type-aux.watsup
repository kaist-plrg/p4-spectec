;;
;; Type constructor checks
;;

;;;; Base types

dec $is_baseTypeIR(typeIR) : bool
def $is_baseTypeIR(baseTypeIR) = true
def $is_baseTypeIR(typeIR) = false
  -- otherwise

dec $is_voidTypeIR(typeIR) : bool
def $is_voidTypeIR(VOID) = true
def $is_voidTypeIR(typeIR) = false
  -- otherwise

dec $is_boolTypeIR(typeIR) : bool
def $is_boolTypeIR(BOOL) = true
def $is_boolTypeIR(typeIR) = false
  -- otherwise

dec $is_errorTypeIR(typeIR) : bool
def $is_errorTypeIR(ERROR) = true
def $is_errorTypeIR(typeIR) = false
  -- otherwise

dec $is_matchkindTypeIR(typeIR) : bool
def $is_matchkindTypeIR(MATCH_KIND) = true
def $is_matchkindTypeIR(typeIR) = false
  -- otherwise

dec $is_stringTypeIR(typeIR) : bool
def $is_stringTypeIR(STRING) = true
def $is_stringTypeIR(typeIR) = false
  -- otherwise

dec $is_integerTypeIR(typeIR) : bool
def $is_integerTypeIR(integerTypeIR) = true
def $is_integerTypeIR(typeIR) = false
  -- otherwise

dec $is_arbitraryIntTypeIR(typeIR) : bool
def $is_arbitraryIntTypeIR(INT) = true
def $is_arbitraryIntTypeIR(typeIR) = false
  -- otherwise

dec $is_fixedIntTypeIR(typeIR) : bool
def $is_fixedIntTypeIR(INT `< _ >) = true
def $is_fixedIntTypeIR(typeIR) = false
  -- otherwise

dec $is_fixedBitTypeIR(typeIR) : bool
def $is_fixedBitTypeIR(BIT `< _ >) = true
def $is_fixedBitTypeIR(typeIR) = false
  -- otherwise

;;;; Named types

;;;; Alias types

