  -- if $distinct_<id>(id*)
  -- if $nestable_headerUnion(typeIR)*
  -- (Type_wf: bound |- typeIR)*

rule Type_wf/enumTypeIR-non-serializable:
  bound |- ENUM _ `{ id* }
  -- if $distinct_<id>(id*)

dec $nestable_enum_serializable(typeIR) : bool
  hint(prose_true %0 "can be used in a serializable enum type")
dec $nestable'_enum_serializable(typeIR) : bool
  hint(prose_true %0 "can be used in a serializable enum type")
dec $nestable_new_in_enum_serializable(typeIR) : bool
  hint(prose_true %0 "can be used in a new type nested in a serializable enum type")
dec $nestable'_new_in_enum_serializable(typeIR) : bool
  hint(prose_true %0 "can be used in a new type nested in a serializable enum type")

def $nestable_enum_serializable(typeIR)
  = $nestable'_enum_serializable(typeIR_canon)
  -- if typeIR_canon = $canon(typeIR)
def $nestable'_enum_serializable(INT `< _ >) = true
def $nestable'_enum_serializable(BIT `< _ >) = true
def $nestable'_enum_serializable(nameTypeIR) = true
def $nestable'_enum_serializable(TYPE _ typeIR)
  = $nestable_new_in_enum_serializable(typeIR)
def $nestable'_enum_serializable(_) = false
  -- otherwise

def $nestable_new_in_enum_serializable(typeIR)
  = $nestable'_new_in_enum_serializable(typeIR_canon)
  -- if typeIR_canon = $canon(typeIR)
