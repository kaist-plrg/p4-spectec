rule Type_wf/structTypeIR:
  bound |- STRUCT _ `{ (typeIR id `;)* }
  -- if $distinct_<id>(id*)
  -- if $nestable_struct(typeIR)*
  -- (Type_wf: bound |- typeIR)*

