;;
;; Types
;;

;;
;;;; Base types
;;

syntax voidTypeIR = VOID
syntax boolTypeIR = BOOL
syntax errorTypeIR = ERROR
syntax matchKindTypeIR = MATCH_KIND
syntax stringTypeIR = STRING

syntax integerTypeIR =
  | INT
  | INT `< nat >
  | BIT `< nat >
  | VARBIT `< nat >

syntax baseTypeIR =
  | voidTypeIR
  | boolTypeIR
  | errorTypeIR
  | matchKindTypeIR
  | stringTypeIR
  | integerTypeIR

;;
;;;; Named types
;;

syntax typeIR
syntax typeDefIR

syntax nameTypeIR = `` tid hint(print %0)

syntax specializedTypeIR = typeDefIR `< typeIR* >

syntax namedTypeIR =
  | nameTypeIR
  | specializedTypeIR

;;
;;;; Alias types
;;

syntax typedefTypeIR =
  TYPEDEF tid typeIR
  hint(print %1)

syntax newTypeIR =
  TYPE tid typeIR
  hint(print %1)

syntax aliasTypeIR =
  | typedefTypeIR
  | newTypeIR

;;
;;;; Data types
;;

syntax listTypeIR = LIST `< typeIR >
syntax tupleTypeIR = TUPLE `< typeIR* >
syntax headerStackTypeIR = typeIR `[ nat ]

syntax fieldTypeIR = typeIR id `;

syntax structTypeIR =
  STRUCT tid `{ fieldTypeIR* }
  hint(print %1)
syntax headerTypeIR =
  HEADER tid `{ fieldTypeIR* }
  hint(print %1)
syntax headerUnionTypeIR =
  HEADER_UNION tid `{ fieldTypeIR* }
  hint(print %1)

syntax valueFieldIR = id `= value `;

syntax enumTypeIR =
  | ENUM tid `{ id* }                         hint(print %1)
  | ENUM tid `< typeIR > `{ valueFieldIR* }   hint(print %1)

syntax dataTypeIR =
  | listTypeIR
  | tupleTypeIR
  | headerStackTypeIR
  | structTypeIR
  | headerTypeIR
  | headerUnionTypeIR
  | enumTypeIR

;;
;;;; Object types
;;

syntax parameterIR
syntax externMethodTypeDefIR
syntax tableMetadataStructTypeIR

syntax externMethodTypeDefEnv = map<cid, externMethodTypeDefIR>

syntax externObjectTypeIR =
  EXTERN tid externMethodTypeDefEnv
  hint(print %1)

syntax parserObjectTypeIR = PARSER `( parameterIR* )

syntax controlObjectTypeIR = CONTROL `( parameterIR* )

syntax packageObjectTypeIR = PACKAGE `{ typeIR* }

syntax tableObjectTypeIR =
  TABLE tid `{ tableMetadataStructTypeIR }
  hint(print %1)

syntax objectTypeIR =
  | externObjectTypeIR
  | parserObjectTypeIR
  | controlObjectTypeIR
  | packageObjectTypeIR
  | tableObjectTypeIR

;;
;;;; Synthesized types
;;

syntax defaultTypeIR = DEFAULT

syntax invalidHeaderTypeIR = HEADER_INVALID

syntax sequenceTypeIR =
  | SEQ `< typeIR* >
  | SEQ `< typeIR* `, `... >

syntax recordTypeIR =
  | RECORD `{ fieldTypeIR* }
  | RECORD `{ fieldTypeIR* `, `... }

syntax setTypeIR = SET `< typeIR* >

syntax tableMetadataEnumTypeIR =
  TABLE_ENUM tid `{ id* }

syntax tableMetadataStructTypeIR =
  TABLE_STRUCT tid `{ HIT boolTypeIR `;
                      MISS boolTypeIR `;
                      ACTION_RUN tableMetadataEnumTypeIR `; }

syntax tableMetadataTypeIR =
  | tableMetadataEnumTypeIR
  | tableMetadataStructTypeIR

syntax synthesizedTypeIR =
  | defaultTypeIR
  | invalidHeaderTypeIR
  | sequenceTypeIR
  | recordTypeIR
  | setTypeIR
  | tableMetadataTypeIR

;;
;;;; Types
;;

syntax typeIR =
  | baseTypeIR
  | namedTypeIR
  | aliasTypeIR
  | dataTypeIR
  | objectTypeIR
  | synthesizedTypeIR
