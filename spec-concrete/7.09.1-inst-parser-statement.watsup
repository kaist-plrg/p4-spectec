;;
;; Parser statement instantiation
;;
;; syntax parserStatementIR
;;

;;; constantDeclarationIR

rule ParserStmt_inst/constantDeclarationIR:
  IC_0 STO_0 |- constantDeclarationIR
              : IC_1 STO_1 constantDeclarationIR_inst
  -- Decl_inst:
      LOCAL IC_0 STO_0 |- constantDeclarationIR
                        : IC_1 STO_1 constantDeclarationIR_inst

;;; variableDeclarationIR

rule ParserStmt_inst/variableDeclarationIR:
  IC_0 STO_0 |- variableDeclarationIR
              : IC_1 STO_1 variableDeclarationIR_inst
  -- BlockElementStmt_inst:
      IC_0 STO_0 |- variableDeclarationIR
                  : IC_1 STO_1 variableDeclarationIR_inst

;;; emptyStatementIR

rule ParserStmt_inst/emptyStatementIR:
  IC_0 STO_0 |- emptyStatementIR
              : IC_1 STO_1 emptyStatementIR_inst
  -- Stmt_inst:
      LOCAL IC_0 STO_0 |- emptyStatementIR
                        : IC_1 STO_1 emptyStatementIR_inst

;;; assignmentStatementIR

rule ParserStmt_inst/assignmentStatementIR:
  IC_0 STO_0 |- assignmentStatementIR
              : IC_1 STO_1 assignmentStatementIR_inst
  -- Stmt_inst:
      LOCAL IC_0 STO_0 |- assignmentStatementIR
                        : IC_1 STO_1 assignmentStatementIR_inst

;;; callStatementIR

rule ParserStmt_inst/callStatementIR:
  IC_0 STO_0 |- callStatementIR
              : IC_1 STO_1 callStatementIR_inst
  -- Stmt_inst:
      LOCAL IC_0 STO_0 |- callStatementIR
                        : IC_1 STO_1 callStatementIR_inst

;;; directApplicationStatementIR
;;; syntax directApplicationStatementIR =
;;;   prefixedNameIR `. APPLY `( argumentListIR ) `;

rule ParserStmt_inst/directApplicationStatementIR:
  IC STO_0 |- prefixedNameIR `. APPLY `( argumentListIR ) `;
            : IC STO_2 parserBlockStatementIR
  ---- ;; find and instantiate constructor
  -- if (_, constructorDef, _)
      = $find_constructorDef_i(IC, prefixedNameIR, eps)
  -- Constructor_inst:
      LOCAL IC STO_0 |- constructorDef `< eps > `( eps `# eps )
                      : STO_1 object
  ---- ;; assign new tid with random string appended
  -- if tid = $flatten_prefixedNameIR(prefixedNameIR)
  -- if tid_fresh = $fresh_tid()
  -- if nameIR = tid ++ "_" ++ tid_fresh
  ---- ;; add object to store
  -- if oid = IC.PATH ++ nameIR
  -- if STO_2 = $add_map<oid, object>(STO_1, oid, object)
  ---- ;; replace with constant declaration and call statement
  -- if typeIR = `` tid
  -- if constantDeclarationIR
      = `EMPTY CONST typeIR nameIR (`= (`! oid)) `;
  -- if callableTargetIR
      = ((`` tid) `# `( typeIR CTK )) `. "apply"
  -- if callStatementIR
      = callableTargetIR `< eps > `( argumentListIR ) `;
  ---- ;; create parser block
  -- if parserBlockStatementIR
      = `EMPTY `{ [ constantDeclarationIR, callStatementIR ] }

;;; parserBlockStatementIR

rule ParserStmt_inst/parserBlockStatementIR:
  IC_0 STO_0 |- annotationList `{ parserStatementListIR }
              : IC_1 STO_1 parserBlockStatementIR_inst
  ---- ;; instantiate inner statements
  -- ParserStmts_inst:
      IC_0 STO_0 |- parserStatementListIR
                  : IC_1 STO_1 parserStatementListIR_inst
  -- if parserBlockStatementIR_inst
      = annotationList `{ parserStatementListIR_inst }

;;; conditionalStatementIR

rule ParserStmt_inst/conditionalStatementIR:
  IC_0 STO_0 |- conditionalStatementIR
              : IC_1 STO_1 conditionalStatementIR_inst
  -- Stmt_inst:
      LOCAL IC_0 STO_0 |- conditionalStatementIR
                        : IC_1 STO_1 conditionalStatementIR_inst

;;
;; Parser statement list instantiation
;;
;; syntax parserStatementListIR
;;

rule ParserStmts_inst/nil:
  IC STO |- eps : IC STO eps

rule ParserStmts_inst/cons:
  IC_0 STO_0 |- parserStatementIR_h :: parserStatementIR_t*
              : IC_2 STO_2 (parserStatementIR_h_inst :: parserStatementIR_t_inst*)
  -- ParserStmt_inst: IC_0 STO_0 |- parserStatementIR_h
                                  : IC_1 STO_1 parserStatementIR_h_inst
  -- ParserStmts_inst: IC_1 STO_1 |- parserStatementIR_t*
                                   : IC_2 STO_2 parserStatementIR_t_inst*
