;;
;; Type constraint
;;

syntax strict =
  | STRICT
  | LAX

syntax strictness = map<typeId, strict>

dec $empty_strictness(typeId*) : strictness
def $empty_strictness(typeId*) = `{ (typeId ':' STRICT)* `}

syntax infer =
  | KNOWN AS typeIR
  | UNKNOWN

syntax constraint = map<typeId, infer>

dec $empty_constraint(typeId*) : constraint
def $empty_constraint(typeId*) = `{ (typeId ':' UNKNOWN)* `}

syntax inference = map<typeId, typeIR>

;;
;; Type inference operations
;;

relation Infer:
  typeId* |- parameterIR* ',' parameterIR* '@' argumentIR* : inference
  hint(input %0 %1 %2 %3)

relation Infer_pair:
  constraint |- parameterIR '@' argumentIR : constraint
  hint(input %0 %1 %2)

relation Gen_constraint:
  constraint |- typeIR* '@' typeIR* : constraint
  hint(input %0 %1 %2)

relation Gen_constraint_pair:
  constraint |- typeIR '@' typeIR : constraint
  hint(input %0 %1 %2)

relation Merge_constraint:
  |- constraint ',' constraint : constraint
  hint(input %0 %1)

relation Merge_constraints:
  |- constraint ',' constraint* : constraint
  hint(input %0 %1)

relation Merge_infer:
  |- infer ',' infer : infer
  hint(input %0 %1)

;;
;;;; Synthesized type resolution
;;

dec $resolve_inference(inference) : inference
dec $resolve_inference'(typeIR) : typeIR

def $resolve_inference(`{ (typeId ':' typeIR)* `})
  = `{ (typeId ':' typeIR_resolved)* `}
  -- if (typeIR_resolved = $resolve_inference'(typeIR))*

def $resolve_inference'(typeIR) = typeIR_resolved
  -- if SEQ `< typeIR_arg* `> = $unroll_typeIR(typeIR)
  -- if typeIR_resolved = TUPLE `< typeIR_arg* `>
def $resolve_inference'(typeIR) = typeIR
  -- otherwise

;;
;;;; Constraint resolution
;;;; Indeterminate constraints are resolved to BOOL (if LAX, i.e., optional)
;;

dec $resolve_constraint(strictness, constraint) : inference

def $resolve_constraint(strictness, `{ eps `}) = `{ eps `}
def $resolve_constraint(strictness, `{ (typeId_h ':' infer_h) :: (typeId_t ':' infer_t)* `})
  = `{ (typeId_h ':' typeIR_h) :: (typeId_t ':' typeIR_t)* `}
  -- if KNOWN AS typeIR_h = infer_h
  -- if `{ (typeId_t ':' typeIR_t)* `}
      = $resolve_constraint(strictness, `{ (typeId_t ':' infer_t)* `})
def $resolve_constraint(strictness, `{ (typeId_h ':' infer_h) :: (typeId_t ':' infer_t)* `})
  = `{ (typeId_h ':' BOOL) :: (typeId_t ':' typeIR_t)* `}
  -- if UNKNOWN = infer_h
  -- if $find_map<typeId, strict>(strictness, typeId_h) = LAX
  -- if `{ (typeId_t ':' typeIR_t)* `}
      = $resolve_constraint(strictness, `{ (typeId_t ':' infer_t)* `})

;;
;;;; Type inference
;;

rule Infer/empty:
  eps |- _ ',' _ '@' _ : `{ eps `}

rule Infer/nonempty:
  typeId_infer* |- parameterIR* ',' parameterIR_optional* '@' argumentIR*
  : inference_resolved
  -- if typeId_infer* =/= eps
  ---- ;; create strictness
  -- if strictness_init = $empty_strictness(typeId_infer*)
  -- if B = $free_parameterIRs(parameterIR*)
  -- if B_optional = $free_parameterIRs(parameterIR_optional*)
  -- if `{ typeId_free* `} = $diff_set<typeId>(B_optional, B)
  -- if strict* = $repeat_<strict>(LAX, |typeId_free*|)
  -- if strictness = $adds_map<typeId, strict>(strictness_init, typeId_free*, strict*)
  ---- ;; create constraints
  -- if constraint_init = $empty_constraint(typeId_infer*)
  -- (Infer_pair:
      constraint_init |- parameterIR '@' argumentIR : constraint_pair)*
  ---- ;; merge and resolve generated constraints
  -- Merge_constraints:
      |- constraint_init ',' constraint_pair* : constraint_inferred
  -- if inference = $resolve_constraint(strictness, constraint_inferred)
  ---- ;; resolve synthesized types
  -- if inference_resolved = $resolve_inference(inference)

rule Infer_pair/expression:
  constraint |- parameterIR '@' typedExpressionIR : constraint_updated
  -- if _ _ typeIR_param _ _ = parameterIR
  -- if typeIR_arg = $type_of_typedExpressionIR(typedExpressionIR)
  -- Gen_constraint_pair:
      constraint |- typeIR_param '@' typeIR_arg : constraint_updated

rule Infer_pair/named-expression:
  constraint |- parameterIR '@' (nameIR '=' typedExpressionIR) : constraint_updated
  -- if _ _ typeIR_param _ _ = parameterIR
  -- if typeIR_arg = $type_of_typedExpressionIR(typedExpressionIR)
  -- Gen_constraint_pair:
      constraint |- typeIR_param '@' typeIR_arg : constraint_updated

rule Infer_pair/named-missing:
  constraint |- _ '@' (_ '=' '_') : constraint

rule Infer_pair/missing:
  constraint |- _ '@' '_' : constraint

;;
;;;; Constraint generation
;;

;;; Named types

rule Gen_constraint_pair/name:
  constraint |- (_NAME typeId_param) '@' typeIR_arg : constraint_updated
  -- if $in_set<typeId>(typeId_param, $dom_map<typeId, infer>(constraint))
  -- if constraint_updated
      = $update_map<typeId, infer>(constraint, typeId_param, KNOWN AS typeIR_arg)

;;; Alias types

rule Gen_constraint_pair/typedef-param:
  constraint |- (TYPEDEF _ typeIR_param) '@' typeIR_arg : constraint_updated
  -- Gen_constraint_pair:
      constraint |- typeIR_param '@' typeIR_arg : constraint_updated

rule Gen_constraint_pair/typedef-arg:
  constraint |- typeIR_param '@' (TYPEDEF _ typeIR_arg) : constraint_updated
  -- if ~(typeIR_param <: nameTypeIR)
  -- if ~(typeIR_param <: typedefTypeIR)
  -- Gen_constraint_pair:
      constraint |- typeIR_param '@' typeIR_arg : constraint_updated

rule Gen_constraint_pair/newtype:
  constraint |- (TYPE typeId typeIR_param) '@' (TYPE typeId typeIR_arg)
  : constraint_updated
  -- Gen_constraint_pair:
      constraint |- typeIR_param '@' typeIR_arg : constraint_updated

;;; Data types

rule Gen_constraint_pair/list:
  constraint |- (LIST `< typeIR_param `>) '@' (LIST `< typeIR_arg `>)
  : constraint_updated
  -- Gen_constraint_pair:
      constraint |- typeIR_param '@' typeIR_arg : constraint_updated

rule Gen_constraint_pair/tuple:
  constraint |- (TUPLE `< typeIR_param* `>) '@' (TUPLE `< typeIR_arg* `>)
  : constraint_updated
  -- Gen_constraint:
      constraint |- typeIR_param* '@' typeIR_arg* : constraint_updated

rule Gen_constraint_pair/array:
  constraint |- (ARRAY typeIR_param `[ n_size `]) '@' (ARRAY typeIR_arg `[ n_size `])
  : constraint_updated
  -- Gen_constraint_pair:
      constraint |- typeIR_param '@' typeIR_arg : constraint_updated

rule Gen_constraint_pair/header-stack:
  constraint
  |- (HEADER_STACK typeIR_param `[ n_size `]) '@' (HEADER_STACK typeIR_arg `[ n_size `])
  : constraint_updated
  -- Gen_constraint_pair:
      constraint |- typeIR_param '@' typeIR_arg : constraint_updated

rule Gen_constraint_pair/struct:
  constraint
  |- (STRUCT typeId `< typeIR_arg_a* `> `{ _ `}) '@' (STRUCT typeId `< typeIR_arg_b* `> `{ _ `})
  : constraint_updated
  -- Gen_constraint:
      constraint |- typeIR_arg_a* '@' typeIR_arg_b* : constraint_updated

rule Gen_constraint_pair/header:
  constraint
  |- (HEADER typeId `< typeIR_arg_a* `> `{ _ `}) '@' (HEADER typeId `< typeIR_arg_b* `> `{ _ `})
  : constraint_updated
  -- Gen_constraint:
      constraint |- typeIR_arg_a* '@' typeIR_arg_b* : constraint_updated

rule Gen_constraint_pair/header-union:
  constraint
  |- (HEADER_UNION typeId `< typeIR_arg_a* `> `{ _ `})
     '@' (HEADER_UNION typeId `< typeIR_arg_b* `> `{ _ `})
  : constraint_updated
  -- Gen_constraint:
      constraint |- typeIR_arg_a* '@' typeIR_arg_b* : constraint_updated

;;; Object types

rule Gen_constraint_pair/extern:
  constraint
  |- (EXTERN typeId `< typeIR_arg_a* `> `{ _ `}) '@' (EXTERN typeId `< typeIR_arg_b* `> `{ _ `})
  : constraint_updated
  -- Gen_constraint:
      constraint |- typeIR_arg_a* '@' typeIR_arg_b* : constraint_updated

rule Gen_constraint_pair/parser:
  constraint
  |- (PARSER _ `< _ `> `( parameterIR_param* `)) '@' (PARSER _ `< _ `> `( parameterIR_arg* `))
  : constraint_updated
  -- if (_ direction typeIR_param _ _ = parameterIR_param)*
  -- if (_ direction typeIR_arg _ _ = parameterIR_arg)*
  -- Gen_constraint:
      constraint |- typeIR_param* '@' typeIR_arg* : constraint_updated

rule Gen_constraint_pair/control:
  constraint
  |- (CONTROL _ `< _ `> `( parameterIR_param* `)) '@' (CONTROL _ `< _ `> `( parameterIR_arg* `))
  : constraint_updated
  -- if (_ direction typeIR_param _ _ = parameterIR_param)*
  -- if (_ direction typeIR_arg _ _ = parameterIR_arg)*
  -- Gen_constraint:
      constraint |- typeIR_param* '@' typeIR_arg* : constraint_updated

rule Gen_constraint_pair/package:
  constraint
  |- (PACKAGE _ `< _ `> `{ typeIR_param* `}) '@' (PACKAGE _ `< _ `> `{ typeIR_arg* `})
  : constraint_updated
  -- Gen_constraint:
      constraint |- typeIR_param* '@' typeIR_arg* : constraint_updated

rule Gen_constraint_pair/default:
  constraint |- _ '@' _ : constraint
  -- otherwise

;;; Multiple types

rule Gen_constraint:
  constraint |- typeIR_param* '@' typeIR_arg* : constraint_merged
  -- (Gen_constraint_pair:
      constraint |- typeIR_param '@' typeIR_arg : constraint_pair)*
  -- Merge_constraints:
      |- constraint ',' constraint_pair* : constraint_merged

;;
;;;; Constraint merging
;;

rule Merge_constraint:
  |- constraint_pre ',' constraint_post : `{ (typeId ':' infer)* `}
  -- if `{ (typeId ':' infer_pre)* `} = constraint_pre
  -- if `{ typeId_post* `} = $dom_map<typeId, infer>(constraint_post)
  -- if $eq_set<typeId>(`{ typeId* `}, `{ typeId_post* `})
  -- (if infer_post = $find_map<typeId, infer>(constraint_post, typeId))*
  -- (Merge_infer: |- infer_pre ',' infer_post : infer)*

rule Merge_infer/unknown:
  |- UNKNOWN ',' UNKNOWN : UNKNOWN

rule Merge_infer/known-post:
  |- UNKNOWN ',' (KNOWN AS typeIR_post) : KNOWN AS typeIR_post

rule Merge_infer/known-pre:
  |- (KNOWN AS typeIR_pre) ',' UNKNOWN : KNOWN AS typeIR_pre

rule Merge_infer/cast-pre:
  |- (KNOWN AS typeIR_pre) ',' (KNOWN AS typeIR_post) : KNOWN AS typeIR_post
  -- Cast_impl: typeIR_pre -> typeIR_post : OK _

rule Merge_infer/cast-post:
  |- (KNOWN AS typeIR_pre) ',' (KNOWN AS typeIR_post) : KNOWN AS typeIR_pre
  -- Cast_impl: typeIR_pre -> typeIR_post : FAIL
  -- Cast_impl: typeIR_post -> typeIR_pre : OK _

rule Merge_constraints/nil:
  |- constraint_pre ',' eps : constraint_pre

rule Merge_constraints/cons:
  |- constraint_pre_0 ',' (constraint_post_h :: constraint_post_t*) : constraint_pre_2
  -- Merge_constraint:
      |- constraint_pre_0 ',' constraint_post_h : constraint_pre_1
  -- Merge_constraints:
      |- constraint_pre_1 ',' constraint_post_t* : constraint_pre_2
