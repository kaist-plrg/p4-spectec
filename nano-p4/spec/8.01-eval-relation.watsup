;; Parser transition result

syntax transitionResult =
  | ACCEPT
  | REJECT
  | STATE id

;;
;; Expression
;;

relation Expr_eval:
  scope evalContext |- expression : value
  hint(input %0 %1 %2)

;;
;; Lvalue
;;

relation Lvalue_eval:
  scope evalContext |- lvalue : value
  hint(input %0 %1 %2)

relation Lvalue_write:
  scope evalContext |- lvalue := value -| evalContext
  hint(input %0 %1 %2 %3)

;;
;; Call
;;

syntax actionCallee =
  ACTION callableId `( parameterIR* ) blockStatement

syntax externMethodCallee =
  EXTERN_METHOD value `. callableId `( parameterIR* )

syntax parserApplyMethodCallee =
  PARSER `. APPLY
    `( parameterIR* )
    `{ parserLocalDeclarationList `; parserStateList }

syntax controlApplyMethodCallee =
  CONTROL `. APPLY
    `( parameterIR* )
    `{ controlLocalDeclarationList `; controlBody }

syntax tableApplyMethodCallee =
  TABLE typeId `. APPLY `{ tableProperties }

syntax callee =
  | actionCallee
  | externMethodCallee
  | parserApplyMethodCallee
  | controlApplyMethodCallee
  | tableApplyMethodCallee

relation Callee_eval:
  scope evalContext |- lvalue : callee
  hint(input %0 %1 %2)

relation Call_eval:
  scope evalContext |- callee `( argument* ) -| evalContext
  hint(input %0 %1 %2 %3)

;;
;; Calling conventions
;;

relation Copy_in:
  scope evalContext parameterIR*
    `@ scope evalContext argument*
  ~> evalContext lvalue?*
  hint(input %0 %1 %2 %3 %4 %5)

relation Copy_out:
  scope evalContext parameterIR*
    `@ scope evalContext lvalue?*
  ~> evalContext
  hint(input %0 %1 %2 %3 %4 %5)

;;
;; Parser
;;

relation ParserState_trans:
  evalContext |- TRANSITION nameIR : transitionResult -| evalContext
  hint(input %0 %1)

relation ParserLocalDeclList_eval:
  evalContext |- parserLocalDeclarationList -| evalContext
  hint(input %0 %1)

;;
;; Variable declaration
;;

relation VarDecl_eval:
  scope evalContext |- variableDeclaration -| evalContext
  hint(input %0 %1 %2)

;;
;; Statement
;;

relation Statement_eval:
  scope evalContext |- statement -| evalContext
  hint(input %0 %1 %2)

relation Statements_eval:
  scope evalContext |- statement* -| evalContext
  hint(input %0 %1 %2)

relation Block_eval:
  scope evalContext |- blockStatement -| evalContext
  hint(input %0 %1 %2)
