syntax id = text
syntax callableId = text
syntax nameIR = text

dec $id(name) : text
def $id(name) = $print_<name>(name)

syntax scope = GLOBAL | BLOCK | LOCAL

syntax typeId = id

syntax typeIR

;;
;; Base types
;;

syntax baseTypeIR = baseType

;;
;; Arguments
;;

syntax argumentIR = expression `# typeIR

;;
;; Parameters
;;

syntax parameterIR = direction typeIR nameIR

;;
;; User defined data types
;;

syntax fieldTypeIR = typeIR id `;

syntax structTypeIR = STRUCT typeId `{ fieldTypeIR* }
syntax headerTypeIR = HEADER typeId `{ fieldTypeIR* }

syntax dataTypeIR =
  | structTypeIR
  | headerTypeIR

;;
;; Object types
;;

syntax externMethodTypeDefIR =
  VOID callableId `( parameterIR* )

syntax externMethodTypeDefEnv =
  map<callableId, externMethodTypeDefIR>

syntax externObjectTypeIR =
  EXTERN typeId externMethodTypeDefEnv

syntax parserObjectTypeIR =
  PARSER typeId `( parameterIR* )

syntax controlObjectTypeIR =
  CONTROL typeId `( parameterIR* )

syntax packageObjectTypeIR =
  PACKAGE typeId `( parameterIR* )

syntax tableObjectTypeIR = TABLE typeId

syntax objectTypeIR =
  | externObjectTypeIR
  | parserObjectTypeIR
  | controlObjectTypeIR
  | packageObjectTypeIR
  | tableObjectTypeIR

;;
;; Object typeDefs
;;

syntax externTypeDefIR = externObjectTypeIR
syntax parserTypeDefIR = parserObjectTypeIR
syntax controlTypeDefIR = controlObjectTypeIR
syntax packageTypeDefIR = packageObjectTypeIR

syntax objectTypeDefIR =
  | externTypeDefIR
  | parserTypeDefIR
  | controlTypeDefIR
  | packageTypeDefIR

;;
;; Internal type representation
;;

syntax typeIR =
  | baseTypeIR
  | dataTypeIR
  | objectTypeIR

syntax typeDefIR =
  | dataTypeIR
  | objectTypeDefIR
