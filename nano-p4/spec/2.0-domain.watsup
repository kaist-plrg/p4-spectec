syntax id = text
syntax nameIR = text

dec $id(name) : text
def $id(name) = $print_<name>(name)

syntax scope = GLOBAL | BLOCK | LOCAL

syntax typeId = id
syntax typeIR

;;
;; Base types
;;

syntax baseTypeIR = baseType

;;
;; User defined data types
;;

syntax fieldTypeIR = typeIR id `;

syntax structTypeIR = STRUCT id `{ fieldTypeIR* }
syntax headerTypeIR = HEADER id `{ fieldTypeIR* }

syntax dataTypeIR =
  | structTypeIR
  | headerTypeIR

;;
;; Type variables
;;

syntax namedTypeIR = TYPEVAR typeId

;;
;; Object types
;;

syntax parameterIR = direction typeIR name

syntax parserObjectTypeIR =
  PARSER typeId `( parameterIR* )

syntax controlObjectTypeIR =
  CONTROL typeId `( parameterIR* )

syntax packageObjectTypeIR =
  PACKAGE typeId `( parameterIR* )

syntax objectTypeIR =
  | parserObjectTypeIR
  | controlObjectTypeIR
  | packageObjectTypeIR

;;
;; Internal type representation
;;

syntax typeIR =
  | baseTypeIR
  | namedTypeIR
  | dataTypeIR
  | objectTypeIR

syntax typeDefIR =
  | dataTypeIR
  | PARSER typeId typeId* `( parameterIR* )
  | CONTROL typeId typeId* `( parameterIR* )
  | PACKAGE typeId typeId* `( parameterIR* )
