;;
;; Layered context
;;

;; Frame : maps nameIR -> value

syntax frame = map<nameIR, value>

dec $empty_frame : frame
def $empty_frame = $empty_map<id, value>

;; Global layer

syntax globalEvalLayer =
  { TYPE typeDefEnv,
    CALLABLE callableDefEnv,
    FRAME frame,
    PARSER parserDeclarationIR,
    CONTROL controlDeclarationIR }

;; Block layer

syntax blockEvalLayer =
  { FRAME frame }

;; Local layer

syntax localEvalLayer =
  { FRAMES frame* }

;;
;; Evaluation context
;;

syntax evalContext =
  { GLOBAL globalEvalLayer,
    BLOCK blockEvalLayer,
    LOCAL localEvalLayer }

var EC : evalContext

dec $make_evalContext(typingContext, instContext) : evalContext

def $make_evalContext(TC, IC) = EC
  -- if parserDeclarationIR = IC.PARSER
  -- if controlDeclarationIR = IC.CONTROL
  -- if globalEvalLayer
      = { TYPE TC.GLOBAL.TYPE,
          CALLABLE $empty_callableDefEnv,
          FRAME $empty_frame,
          PARSER parserDeclarationIR,
          CONTROL controlDeclarationIR }
  -- if blockEvalLayer
      = { FRAME $empty_frame }
  -- if localEvalLayer
      = { FRAMES ([ $empty_frame ]) }
  -- if EC
      = { GLOBAL globalEvalLayer,
          BLOCK blockEvalLayer,
          LOCAL localEvalLayer }

;;
;; Context inheritance
;;

dec $inherit_e(scope, evalContext) : evalContext

def $inherit_e(GLOBAL, EC)
  = EC[ .BLOCK = blockEvalLayer ][ .LOCAL = localEvalLayer ]
  -- if blockEvalLayer
      = { FRAME $empty_frame }
  -- if localEvalLayer
      = { FRAMES ([ $empty_frame ]) }
def $inherit_e(BLOCK, EC)
  = EC[ .LOCAL = localEvalLayer ]
  -- if localEvalLayer
      = { FRAMES ([ $empty_frame ]) }
def $inherit_e(LOCAL, EC) = EC

;;
;; Finder for variables
;;

dec $find_var_e(scope, evalContext, nameIR) : value

def $find_var_e(GLOBAL, EC, nameIR) = value
  -- if frame = EC.GLOBAL.FRAME
  -- if value = $find_map<nameIR, value>(frame, nameIR)
def $find_var_e(BLOCK, EC, nameIR) = value
  -- if frame = EC.BLOCK.FRAME
  -- if value = $find_map<nameIR, value>(frame, nameIR)
def $find_var_e(BLOCK, EC, nameIR) = $find_var_e(GLOBAL, EC, nameIR)
  -- if frame = EC.BLOCK.FRAME
  -- if eps = $find_map<nameIR, value>(frame, nameIR)
def $find_var_e(LOCAL, EC, nameIR) = value
  -- if frame* = EC.LOCAL.FRAMES
  -- if value = $find_maps<nameIR, value>(frame*, nameIR)
def $find_var_e(LOCAL, EC, nameIR) = $find_var_e(BLOCK, EC, nameIR)
  -- if frame* = EC.LOCAL.FRAMES
  -- if eps = $find_maps<nameIR, value>(frame*, nameIR)

;;
;; Adder for variables
;;

dec $add_var_e(scope, evalContext, nameIR, value) : evalContext

def $add_var_e(GLOBAL, EC, nameIR, value) = EC'
  -- if frame = EC.GLOBAL.FRAME
  -- if ~$in_set<nameIR>($dom_map<nameIR, value>(frame), nameIR)
  -- if frame' = $add_map<nameIR, value>(frame, nameIR, value)
  -- if EC' = EC[ .GLOBAL.FRAME = frame' ]
def $add_var_e(BLOCK, EC, nameIR, value) = EC'
  -- if frame = EC.BLOCK.FRAME
  -- if ~$in_set<nameIR>($dom_map<nameIR, value>(frame), nameIR)
  -- if frame' = $add_map<nameIR, value>(frame, nameIR, value)
  -- if EC' = EC[ .BLOCK.FRAME = frame' ]
def $add_var_e(GLOBAL, EC, nameIR, value) = EC'
  -- if frame_h :: frame_t* = EC.LOCAL.FRAMES
  -- if ~$in_set<nameIR>($dom_map<nameIR, value>(frame_h), nameIR)
  -- if frame_h' = $add_map<nameIR, value>(frame_h, nameIR, value)
  -- if EC' = EC[ .LOCAL.FRAMES = frame_h' :: frame_t* ]

;;
;; Updater for variables
;;

dec $update_var_e(scope, evalContext, nameIR, value) : evalContext

def $update_var_e(GLOBAL, EC, nameIR, value) = EC[ .GLOBAL.FRAME = frame' ]
  -- if frame = EC.GLOBAL.FRAME
  -- if $in_set<nameIR>($dom_map<nameIR, value>(frame), nameIR)
  -- if frame' = $update_map<nameIR, value>(frame, nameIR, value)
def $update_var_e(BLOCK, EC, nameIR, value) = EC[ .BLOCK.FRAME = frame' ]
  -- if frame = EC.BLOCK.FRAME
  -- if $in_set<nameIR>($dom_map<nameIR, value>(frame), nameIR)
  -- if frame' = $update_map<nameIR, value>(frame, nameIR, value)
def $update_var_e(BLOCK, EC, nameIR, value)
  = $update_var_e(GLOBAL, EC, nameIR, value)
  -- if frame = EC.BLOCK.FRAME
  -- if ~$in_set<nameIR>($dom_map<nameIR, value>(frame), nameIR)
def $update_var_e(LOCAL, EC, nameIR, value)
  = $update_var_e(BLOCK, EC, nameIR, value)
  ---- ;; TODO: is this unreachable?
  -- if eps = EC.LOCAL.FRAMES
def $update_var_e(LOCAL, EC, nameIR, value)
  = EC[ .LOCAL.FRAMES = frame_h' :: frame_t* ]
  -- if frame_h :: frame_t* = EC.LOCAL.FRAMES
  -- if $in_set<nameIR>($dom_map<nameIR, value>(frame_h), nameIR)
  -- if frame_h' = $update_map<nameIR, value>(frame_h, nameIR, value)
def $update_var_e(LOCAL, EC, nameIR, value)
  = EC[ .LOCAL.FRAMES = frame_h :: EC_pop'.LOCAL.FRAMES ]
  -- if frame_h :: frame_t* = EC.LOCAL.FRAMES
  -- if ~$in_set<nameIR>($dom_map<nameIR, value>(frame_h), nameIR)
  -- if EC_pop = EC[ .LOCAL.FRAMES = frame_t* ]
  -- if EC_pop' = $update_var_e(LOCAL, EC_pop, nameIR, value)

;;
;; Finder for callableDefs
;;

dec $find_callableDef_e(evalContext, callableId) : callableDef
def $find_callableDef_e(EC, callableId) = callableDef
  -- if callableDef
      = $find_map<callableId, callableDef>(EC.GLOBAL.CALLABLE, callableId)

;;
;; Finder for typeDefs
;;

dec $find_typeDef_e(evalContext, typeId) : typeDefIR
def $find_typeDef_e(EC, typeId) = typeDefIR
  -- if typeDefIR = $find_map<typeId, typeDefIR>(EC.GLOBAL.TYPE, typeId)

;;
;; Resolve type to typeIR
;;

dec $resolve_type_e(evalContext, type) : typeIR

def $resolve_type_e(EC, baseType) = baseType
def $resolve_type_e(EC, `TID typeId) = typeIR
  -- if typeDefIR = $find_map<typeId, typeDefIR>(EC.GLOBAL.TYPE, typeId)
  -- if typeIR = $typeIR_of_typeDefIR(typeDefIR)

;;
;; Frame entry and exit
;;

dec $enter_e(evalContext) : evalContext
dec $exit_e(evalContext) : evalContext

def $enter_e(EC) = EC[ .LOCAL.FRAMES = $empty_frame :: EC.LOCAL.FRAMES ]
def $exit_e(EC) = EC[ .LOCAL.FRAMES = frame_t* ]
  -- if EC.LOCAL.FRAMES = frame_h :: frame_t*
