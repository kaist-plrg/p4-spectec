;;
;; Declaration instantiation
;;

relation Decl_inst:
  instContext |- declaration -| instContext
  hint(input %0 %1)

relation Decls_inst:
  instContext |- declaration* -| instContext
  hint(input %0 %1)

rule Decl_inst/instantiation:
  IC_0 |- (`TID typeId_target) `( argumentList ) name `; -| IC_1
  -- if argument* = $flatten_argumentList(argumentList)
  ---- ;; find parser declaration
  -- if (`TID callableId_parser) `( _ ) = argument*[0]
  -- if parserDeclarationIR
      = $find_callableDef_i(IC_0, callableId_parser)
  ---- ;; find control declaration
  -- if (`TID callableId_control) `( _ ) = argument*[1]
  -- if controlDeclarationIR
      = $find_callableDef_i(IC_0, callableId_control)
  -- if IC_1
      = IC_0[ .PARSER = parserDeclarationIR ][ .CONTROL = controlDeclarationIR ]

rule Decl_inst/actionDeclaration:
  IC_0 |- actionDeclaration -| IC_1
  -- if ACTION name_action `( _ ) blockStatement = actionDeclaration
  -- if callableId = $id(name_action)
  ---- ;; find action type
  -- if ACTION parameterIR* = $find_callableTypeDef_i(IC_0, callableId)
  -- if actionDeclarationIR
      = ACTION callableId `( parameterIR* ) blockStatement
  -- if IC_1 = $add_callableDef_i(IC_0, callableId, actionDeclarationIR)

rule Decl_inst/matchKindDeclaration:
  IC |- MATCH_KIND `{ nameList } -| IC

rule Decl_inst/externDeclaration:
  IC |- externDeclaration -| IC

rule Decl_inst/parserDeclaration:
  IC_0 |- parserDeclaration -| IC_1
  -- if PARSER name
    `( parameterList )
    `{ parserLocalDeclarationList parserStateList } = parserDeclaration
  -- if callableId = $id(name)
  ---- ;; find parser type
  -- if PARSER parameterIR* = $find_callableTypeDef_i(IC_0, callableId)
  -- if parserDeclarationIR
      = PARSER callableId
          `( parameterIR* )
          `{ parserLocalDeclarationList parserStateList }
  -- if IC_1 = $add_callableDef_i(IC_0, callableId, parserDeclarationIR)

rule Decl_inst/controlDeclaration:
  IC_0 |- controlDeclaration -| IC_1
  -- if CONTROL name
    `( parameterList )
    `{ controlLocalDeclarationList APPLY controlBody } = controlDeclaration
  -- if callableId = $id(name)
  ---- ;; find control type
  -- if CONTROL parameterIR* = $find_callableTypeDef_i(IC_0, callableId)
  -- if controlDeclarationIR
      = CONTROL callableId
          `( parameterIR* )
          `{ controlLocalDeclarationList APPLY controlBody }
  -- if IC_1 = $add_callableDef_i(IC_0, callableId, controlDeclarationIR)

rule Decl_inst/typeDeclaration:
  IC |- typeDeclaration -| IC

rulegroup Decls_inst {

  rule Decls_inst/nil:
    IC_0 |- eps -| IC_0

  rule Decls_inst/cons:
    IC_0 |- declaration_h :: declaration_t* -| IC_2
    -- Decl_inst: IC_0 |- declaration_h -| IC_1
    -- Decls_inst: IC_1 |- declaration_t* -| IC_2

}

;;
;; Program instantiation
;;

relation Program_inst:
  typingContext |- program -| instContext
  hint(input %0 %1)

rule Program_inst:
  TC |- program -| IC'
  -- if declaration* = $flatten_program(program)
  -- if IC = $make_instContext(TC)
  -- Decls_inst: IC |- declaration* -| IC'
  -- debug IC'
