;; syntax statement =
;;   | emptyStatement
;;   | assignmentStatement
;;   | callStatement
;;   | blockStatement
;;   | conditionalStatement

rule Statement_ok/emptyStatement:
  scope TC |- emptyStatement -| TC

rule Statement_ok/assignmentStatement:
  scope TC |- lvalue `= expression `; -| TC
  -- Lvalue_ok: scope TC |- lvalue : typeIR_lvalue
  -- Expr_ok: scope TC |- expression : typeIR_expression
  ---- ;; NOTE: type equivalence
  -- if typeIR_lvalue = typeIR_expression

rulegroup Statement_ok/callStatement {

  rule Statement_ok/callStatement-name-no-typeArgumentList:
    scope TC |- referenceExpression `( argumentList ) `; -| TC
    -- if callableId = $id(referenceExpression)
    -- if callableTypeDef = $find_callableDef_t(TC, callableId)
    -- if parameterIR* = $params_of_callableTypeDef(callableTypeDef)
    -- ArgumentList_ok: scope TC |- argumentList : typeIR*
    -- if (_ typeIR_param _ = parameterIR)*
    ---- ;; TODO: does this do what i wish it does?
    -- if (typeIR_param = typeIR)*

  rule Statement_ok/callStatement-member-no-typeArgumentList:
    scope TC |- (lvalue_base `. member) `( argumentList ) `; -| TC
    -- Lvalue_ok: scope TC |- lvalue_base : typeIR_base

  rule Statement_ok/callStatement-typeArgumentList:
    scope TC |- lvalue `( argumentList ) `; -| TC

}

rulegroup Statements_ok {

  rule Statements_ok/nil:
    TC_0 |- eps -| TC_0

  rule Statements_ok/cons:
    TC_0 |- statement_h :: statement_t* -| TC_2
    -- Statement_ok:
        LOCAL TC_0 |- statement_h -| TC_1
    -- Statements_ok:
        TC_1 |- statement_t* -| TC_2

}

rule Block_ok:
  TC_0 |- `{ statementList }
  -- if statement* =
      $flatten_statementList(statementList)
  -- Statements_ok: TC_0 |- statement* -| TC_1
