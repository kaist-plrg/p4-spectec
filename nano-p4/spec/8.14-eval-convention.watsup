;;
;; Copy-in
;;

relation Copy_in_arg:
    scope evalContext parameterIR
    `@ scope evalContext argument
  ~> evalContext lvalue?
  hint(input %0 %1 %2 %3 %4 %5)

rulegroup Copy_in_arg {

  rule Copy_in_arg/directionless-in:
      scope_caller EC_caller (direction _ nameIR)
      `@ scope_callee EC_callee argument
    ~> EC_callee' eps
    -- if direction = `EMPTY \/ direction = IN
    -- Expr_eval:
        scope_caller EC_caller |- argument : value
    -- if EC_callee' = $add_var_e(scope_callee, EC_callee, nameIR, value)

  rule Copy_in_arg/out:
      scope_caller EC_caller (OUT typeIR nameIR)
      `@ scope_callee EC_callee argument
    ~> EC_callee' lvalue
    -- if value = $default(typeIR)
    -- if EC_callee' = $add_var_e(scope_callee, EC_callee, nameIR, value)
    -- if lvalue = $lvalue_of_expression(argument)

  rule Copy_in_arg/inout:
    scope_caller EC_caller (INOUT typeIR nameIR)
      `@ scope_callee EC_callee argument
    ~> EC_callee' lvalue
    -- Expr_eval:
        scope_caller EC_caller |- argument : value
    -- if EC_callee' = $add_var_e(scope_callee, EC_callee, nameIR, value)
    -- if lvalue = $lvalue_of_expression(argument)

}

rulegroup Copy_in {

  rule Copy_in/nil:
      scope_caller EC_caller eps
      `@ scope_callee EC_callee eps
    ~> EC_callee eps

  rule Copy_in/cons:
    scope_caller EC_caller (parameterIR_h :: parameterIR_t*)
      `@ scope_callee EC_callee_0 (argument_h :: argument_t*)
    ~> EC_callee_2 (lvalue_h? :: lvalue_t?*)
    -- Copy_in_arg:
        scope_caller EC_caller parameterIR_h
          `@ scope_callee EC_callee_0 argument_h
        ~> EC_callee_1 lvalue_h?
    -- Copy_in:
        scope_caller EC_caller parameterIR_t*
          `@ scope_callee EC_callee_1 argument_t*
        ~> EC_callee_2 lvalue_t?*

}

;;
;; Copy-out
;;

relation Copy_out_arg:
  scope evalContext parameterIR
    `@ scope evalContext lvalue?
  ~> evalContext
  hint(input %0 %1 %2 %3 %4 %5)

rulegroup Copy_out_arg {

  rule Copy_out_arg/directionless-in:
    scope_caller EC_caller (direction _ _)
      `@ scope_callee EC_callee eps
    ~> EC_caller
    -- if direction = IN \/ direction = `EMPTY

  rule Copy_out_arg/out-inout:
    scope_caller EC_caller_0 (direction typeIR nameIR)
      `@ scope_callee EC_callee lvalue
    ~> EC_caller_1
    -- if direction = OUT \/ direction = INOUT
    -- if value = $find_var_e(scope_callee, EC_callee, nameIR)
    -- Lvalue_write:
        scope_caller EC_caller_0 |- lvalue := value -| EC_caller_1

}

rulegroup Copy_out {

  rule Copy_out/nil:
    scope_caller EC_caller eps
      `@ scope_callee EC_callee eps
    ~> EC_caller

  rule Copy_out/cons:
    scope_caller EC_caller_0 (parameterIR_h :: parameterIR_t*)
      `@ scope_callee EC_callee (lvalue_h? :: lvalue_t?*)
    ~> EC_caller_2
  -- Copy_out_arg:
      scope_caller EC_caller_0 parameterIR_h
        `@ scope_callee EC_callee lvalue_h?
      ~> EC_caller_1
  -- Copy_out:
      scope_caller EC_caller_1 parameterIR_t*
        `@ scope_callee EC_callee lvalue_t?*
      ~> EC_caller_2

}
