;;
;; Elaborated callable definitions
;;

syntax actionDeclarationIR =
  ACTION nameIR
    `( parameterIR* ) blockStatement

syntax parserDeclarationIR =
  PARSER nameIR
    `( parameterIR* )
    `{ parserLocalDeclarationList parserStateList }

syntax controlDeclarationIR =
  CONTROL nameIR
    `( parameterIR* )
    `{ controlLocalDeclarationList APPLY controlBody }

syntax callableDef =
  | actionDeclarationIR
  | parserDeclarationIR
  | controlDeclarationIR

syntax callableDefEnv = map<callableId, callableDef>

dec $empty_callableDefEnv : map<callableId, callableDef>
def $empty_callableDefEnv = $empty_map<callableId, callableDef>

syntax globalInstLayer =
  { CALLABLE_TYPE callableTypeDefEnv,
    CALLABLE callableDefEnv,
    PARSER parserDeclarationIR?,
    CONTROL controlDeclarationIR? }

syntax instContext = globalInstLayer

var IC : instContext

dec $make_instContext(typingContext) : instContext
def $make_instContext(TC) = IC
  -- if IC
      = {
          CALLABLE_TYPE TC.GLOBAL.CALLABLE,
          CALLABLE $empty_callableDefEnv,
          PARSER eps,
          CONTROL eps }

;;
;; Finder and Adders
;;

;;
;;;; Finder for callableDefs
;;

dec $find_callableDef_i(instContext, callableId) : callableDef
def $find_callableDef_i(IC, callableId) = callableDef
  -- if callableDef
      = $find_map<callableId, callableDef>(IC.CALLABLE, callableId)

;;
;;;; Adder for callableDefs
;;

dec $add_callableDef_i(instContext, callableId, callableDef)
  : instContext

def $add_callableDef_i(IC, callableId, callableDef)
  = IC'
  -- if callableDefEnv = IC.CALLABLE
  -- if ~$in_set<callableId>(
        $dom_map<callableId, callableDef>(callableDefEnv),
        callableId
      )
  -- if callableDefEnv'
      = $add_map<callableId, callableDef>(
          callableDefEnv,
          callableId,
          callableDef
        )
  -- if IC' = IC[ .CALLABLE = callableDefEnv' ]

;;
;;;; Finder for callableTypeDefs
;;

dec $find_callableTypeDef_i(instContext, callableId) : callableTypeDef
def $find_callableTypeDef_i(IC, callableId) = callableTypeDef
  -- if callableTypeDef
      = $find_map<callableId, callableTypeDef>(IC.CALLABLE_TYPE, callableId)
