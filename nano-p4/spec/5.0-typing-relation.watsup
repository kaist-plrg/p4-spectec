;;
;; Type definition environment
;; : type name -> type definition
;;

syntax typeDef =
  | derivedTypeDeclaration
  | externDeclaration

syntax typeId = id
syntax typeDefEnv = map<typeId, typeDef>

;;
;; Callable type definition environment
;; : callable name -> callable type
;;

syntax callableTypeDef = actionDeclaration

syntax callableId = id
syntax callableTypeDefEnv = map<callableId, callableTypeDef>

;;
;; Type frame
;; : variable name -> variable type
;;

syntax typeFrame = map<id, type>

;;
;; Typing context
;;

syntax typingContext =
  { TYPE typeDefEnv,
    CALLABLE callableTypeDefEnv,
    FRAME typeFrame }

;;
;; Expression typing
;;

relation Expr_ok:
  typingContext |- expression : type
  hint(input %0 %1 %2)

;;
;; Lvalue typing
;;

relation Lvalue_ok:
  typingContext |- lvalue : type
  hint(input %0 %1 %2)

;;
;; Statement typing
;;

relation Stmt_ok:
  typingContext |- statement -| typingContext
  hint(input %0 %1)

relation BlockElementStatement_ok:
  typingContext |- blockElementStatement -| typingContext
  hint(input %0 %1)

relation BlockElementStatementList_ok:
  typingContext |- blockElementStatementList -| typingContext
  hint(input %0 %1)

;;
;; Declaration typing
;;

relation Decl_ok:
  typingContext |- declaration -| typingContext
  hint(input %0 %1)

relation Decls_ok:
  typingContext |- declaration* -| typingContext
  hint(input %0 %1)

;;
;; Program typing
;;

relation Program_ok:
  |- program -| typingContext
  hint(input %0)
