;; Declaration

rule Decl_ok/constantDeclaration:
  TC_0 |- constantDeclaration -| TC_1
  -- ConstDecl_ok: GLOBAL TC_0 |- constantDeclaration -| TC_1

rule Decl_ok/instantiation:
  TC_0 |- type `( argumentList ) name `; -| TC_0

rule Decl_ok/actionDeclaration:
  TC_0 |- actionDeclaration -| TC_1
  -- ActionDecl_ok: TC_0 |- actionDeclaration -| TC_1

rule Decl_ok/matchKindDeclaration:
  TC_0 |- MATCH_KIND `{ nameList trailingCommaOpt } -| TC_1
  -- if name* = $flatten_nameList(nameList)
  -- if (id = $id(name))*
  ---- ;; check name collision
  -- if $distinct_<id>(id*)
  ---- ;; update context
  -- if varTypeIR* = $repeat_<varTypeIR>(`EMPTY MATCH_KIND, |id*|)
  -- if TC_1 = $add_vars_t(GLOBAL, TC_0, id*, varTypeIR*)

rule Decl_ok/externDeclaration:
  TC_0 |- externDeclaration -| TC_1
  -- ExternDecl_ok: TC_0 |- externDeclaration -| TC_1

rule Decl_ok/parserDeclaration:
  TC_0 |- parserDeclaration -| TC_0
  -- if PARSER name
    `( parameterList )
    `{ parserLocalDeclarationList parserStateList } = parserDeclaration
  -- ParameterList_ok: TC_0 |- parameterList ~> parameterIR*

rule Decl_ok/controlDeclaration:
  TC_0 |- controlDeclaration -| TC_0

rule Decl_ok/typeDeclaration:
  TC_0 |- typeDeclaration -| TC_1
  -- TypeDecl_ok: TC_0 |- typeDeclaration -| TC_1

rulegroup Decls_ok {

  rule Decls_ok/nil:
    TC_0 |- eps -| TC_0

  rule Decls_ok/cons:
    TC_0 |- declaration_h :: declaration_t* -| TC_2
    -- Decl_ok: TC_0 |- declaration_h -| TC_1
    -- Decls_ok: TC_1 |- declaration_t* -| TC_2

}

rule Program_ok:
  |- program -| TC'
  -- if declaration* = $flatten_program(program)
  -- if TC = $empty_typingContext
  -- Decls_ok: TC |- declaration* -| TC'
