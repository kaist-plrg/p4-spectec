;;
;; Extern declaration
;;

relation ExternDecl_ok:
  typingContext |- externDeclaration -| typingContext
  hint(input %0 %1)

rulegroup ExternDecl_ok {

  rule ExternDecl_ok/externFunctionDeclaration:
    TC_0 |- EXTERN functionPrototype `; -| TC_1
    -- if VOID name typeParameterListOpt `( parameterList ) = functionPrototype
    -- if typeParameter* = $flatten_typeParameterListOpt(typeParameterListOpt)
    ---- ;; TODO: all (function) parameters must have a direction
    -- ParameterList_ok: TC_0 |- parameterList ~> parameterIR*
    -- if callableId = $id(name)
    -- if callableTypeDef = FUNCTION typeParameter* parameterIR*
    -- if TC_1 = $add_callableDef_t(TC_0, callableId, callableTypeDef)

  rule ExternDecl_ok/externObjectDeclaration:
    TC_0 |- EXTERN nonTypeName
            typeParameterListOpt `{ externMethodPrototypeList } -| TC_0

}

