;;
;; Parser transition statement
;;

relation ParserTransition_eval:
  evalContext |- transitionStatement : transitionResult
  hint(input %0 %1)

relation ParserSelect_eval:
  evalContext |- selectExpression : transitionResult
  hint(input %0 %1)

rulegroup ParserTransition_eval {

  rule ParserTransition_eval/accept:
    EC |- TRANSITION (name `;) : ACCEPT
    -- if $id(name) = "accept"

  rule ParserTransition_eval/reject:
    EC |- TRANSITION (name `;) : REJECT
    -- if $id(name) = "reject"

  rule ParserTransition_eval/state:
    EC |- TRANSITION (name `;) : (STATE nameIR)
    -- if nameIR = $id(name)
    -- if nameIR =/= "accept" /\ nameIR =/= "reject"

  rule ParserTransition_eval/selectExpression:
    EC |- TRANSITION selectExpression : transitionResult
    -- ParserSelect_eval:
        EC |- selectExpression : transitionResult

}

dec $match_case_expression(value, (name, value)*) : name?

def $match_case_expression(value, eps) = eps
def $match_case_expression(
    value,
    (name_case_h, value_case_h) :: (name_case_t, value_case_t)*)
  = name_case_h
  -- if $bin_eq(value, value_case_h)
def $match_case_expression(
    value,
    (name_case_h, value_case_h) :: (name_case_t, value_case_t)*)
  = $match_case_expression(value, (name_case_t, value_case_t)*)
  -- if ~$bin_eq(value, value_case_h)

rulegroup ParserSelect_eval {

  rule ParserSelect_eval/accept:
    EC |- selectExpression : transitionResult
    -- if SELECT `( expression ) `{ selectCaseList } = selectExpression
    -- Expr_eval: LOCAL EC |- expression : value
    -- if selectCase* = $flatten_selectCaseList(selectCaseList)
    -- if (expression_case `: name_case `; = selectCase)*
    -- (Expr_eval: LOCAL EC |- expression_case : value_case)*
    -- if name_match = $match_case_expression(value, (name_case, value_case)*)
    -- ParserTransition_eval:
        EC |- TRANSITION (name_match `;) : transitionResult

  rule ParserSelect_eval/reject:
    EC |- selectExpression : REJECT
    -- if SELECT `( expression ) `{ selectCaseList } = selectExpression
    -- Expr_eval: LOCAL EC |- expression : value
    -- if selectCase* = $flatten_selectCaseList(selectCaseList)
    -- if (expression_case `: name_case `; = selectCase)*
    -- (Expr_eval: LOCAL EC |- expression_case : value_case)*
    -- if eps = $match_case_expression(value, (name_case, value_case)*)

}


;;
;; Parser state
;;

relation ParserState_eval:
  evalContext |- parserState : transitionResult -| evalContext
  hint(input %0 %1)

rule ParserState_eval:
  EC_0 |- parserState : transitionResult -| EC_1
  -- if STATE name `{ statementList transitionStatement } = parserState
  -- if statement* = $flatten_statementList(statementList)
  -- Statements_eval:
      LOCAL EC_0 |- statement* -| EC_1
  -- ParserTransition_eval:
      EC_1 |- transitionStatement : transitionResult

;;
;; Parser transition
;;

dec $find_parserState(parserState*, nameIR) : parserState?
def $find_parserState(eps, nameIR) = eps
def $find_parserState(parserState_h :: parserState_t*, nameIR_target)
  = parserState_h
  -- if STATE name `{ _ _ } = parserState_h
  -- if $id(name) = nameIR_target
def $find_parserState(parserState_h :: parserState_t*, nameIR_target)
  = $find_parserState(parserState_t*, nameIR_target)
  -- if STATE name `{ _ _ } = parserState_h
  -- if $id(name) =/= nameIR_target

rulegroup ParserState_trans {

  rule ParserState_trans/accept:
    EC_0 parserState* |- nameIR : ACCEPT -| EC_1
    -- if parserState_found = $find_parserState(parserState*, nameIR)
    -- ParserState_eval:
        EC_0 |- parserState_found : ACCEPT -| EC_1

  rule ParserState_trans/reject:
    EC_0 parserState* |- nameIR : ACCEPT -| EC_1
    -- if parserState_found = $find_parserState(parserState*, nameIR)
    -- ParserState_eval:
        EC_0 |- parserState_found : REJECT -| EC_1

  rule ParserState_trans/state:
    EC_0 parserState* |- nameIR : transitionResult -| EC_2
    -- if parserState_found = $find_parserState(parserState*, nameIR)
    -- ParserState_eval:
        EC_0 |- parserState_found : (STATE nameIR_next) -| EC_1
    -- ParserState_trans:
        EC_1 parserState* |- nameIR_next : transitionResult -| EC_2

}

;;
;; Parser local declarations
;;

relation ParserLocalDecl_eval:
  evalContext |- parserLocalDeclaration -| evalContext
  hint(input %0 %1)

relation ParserLocalDecls_eval:
  evalContext |- parserLocalDeclaration* -| evalContext
  hint(input %0 %1)

rule ParserLocalDecl_eval:
  EC_0 |- variableDeclaration -| EC_1
  -- VarDecl_eval:
      BLOCK EC_0 |- variableDeclaration -| EC_1

rulegroup ParserLocalDecls_eval {

  rule ParserLocalDecls_eval/nil:
    EC |- eps -| EC

  rule ParserLocalDecls_eval/cons:
    EC_0 |- parserLocalDeclaration_h :: parserLocalDeclaration_t* -| EC_1
    -- ParserLocalDecl_eval:
        EC_0 |- parserLocalDeclaration_h -| EC_1
    -- ParserLocalDecls_eval:
        EC_1 |- parserLocalDeclaration_t* -| EC_2

}

rule ParserLocalDeclList_eval:
  EC_0 |- parserLocalDeclarationList -| EC_1
  -- if parserLocalDeclaration*
      = $flatten_parserLocalDeclarationList(parserLocalDeclarationList)
  -- ParserLocalDecls_eval:
      EC_0 |- parserLocalDeclaration* -| EC_1
