;;
;; Type elaboration
;;

relation Type_ok:
  typingContext |- type ~> typeIR
  hint(input %0 %1)

;;
;; Type elaboration
;;

relation Type_alpha:
  typeIR ~~ typeIR
  hint(input %0 %1)

;;
;; Expression typing
;;

relation Expr_ok:
  scope typingContext |- expression : typeIR
  hint(input %0 %1 %2)

;;
;; Argument typing
;;

relation ArgumentList_ok:
  scope typingContext |- argumentList : argumentIR*
  hint(input %0 %1 %2)

;;
;; Lvalue typing
;;

relation Lvalue_ok:
  scope typingContext |- lvalue : typeIR
  hint(input %0 %1 %2)

;;
;; Calling convention
;;

relation Call_convention_ok:
  parameterIR* `@ argumentIR*
  hint(input %0 %1)

;;
;; Statement typing
;;

relation Statement_ok:
  scope typingContext |- statement -| typingContext
  hint(input %0 %1 %2)

relation Statements_ok:
  typingContext |- statement* -| typingContext
  hint(input %0 %1)

relation Block_ok:
  typingContext |- blockStatement
  hint(input %0 %1)

;;
;; Parser declaration
;;

relation ParserLocalDeclList_ok:
  typingContext |- parserLocalDeclarationList -| typingContext
  hint(input %0 %1)

relation ParserTransition_ok:
  typingContext nameIR* |- transitionStatement
  hint(input %0 %1 %2)

relation ParserStateList_ok:
  typingContext |- parserStateList
  hint(input %0 %1)

;;
;; Table typing
;;

relation TableKey_ok:
  typingContext |- tableKey : matchKey
  hint(input %0 %1)

relation TableActionList_ok:
  typingContext |- tableActionList : matchAction*
  hint(input %0 %1)

relation TableEntries_ok:
  typingContext tableContext |- tableEntry*
  hint(input %0 %1 %2)

relation TableProperties_ok:
  typingContext |- tableProperties : tableContext
  hint(input %0 %1)

relation TableDecl_ok:
  typingContext |- tableDeclaration -| typingContext
  hint(input %0 %1)

;;
;; Control declaration
;;

relation ControlLocalDeclList_ok:
  typingContext |- controlLocalDeclarationList -| typingContext
  hint(input %0 %1)

;;
;; Extern method
;;

relation ExternMethod_ok:
  typingContext |- externMethodPrototype : externMethodTypeDefIR
  hint(input %0 %1)

;;
;; Declaration typing
;;

relation VarDecl_ok:
  scope typingContext |- variableDeclaration -| typingContext
  hint(input %0 %1 %2)

relation Decl_ok:
  typingContext |- declaration -| typingContext
  hint(input %0 %1)

relation Decls_ok:
  typingContext |- declaration* -| typingContext
  hint(input %0 %1)

;;
;; Program typing
;;

relation Program_ok:
  |- program -| typingContext
  hint(input %0)
