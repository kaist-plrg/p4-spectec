;;
;; Type definition environment
;; : type name -> type definition
;;

syntax typeDefEnv = map<typeId, typeDefIR>

dec $empty_typeDefEnv : map<typeId, typeDefIR>
def $empty_typeDefEnv = $empty_map<typeId, typeDefIR>

;;
;; Callable type definition environment
;; : callable name -> callable type
;;

syntax callableTypeDef =
  | ACTION parameterIR*
  | FUNCTION parameterIR*
  | PARSER parameterIR*
  | CONTROL parameterIR*

dec $params_of_callableTypeDef(callableTypeDef) : parameterIR*

def $params_of_callableTypeDef(ACTION parameterIR*) = parameterIR*
def $params_of_callableTypeDef(FUNCTION parameterIR*) = parameterIR*
def $params_of_callableTypeDef(PARSER parameterIR*) = parameterIR*
def $params_of_callableTypeDef(CONTROL parameterIR*) = parameterIR*

syntax callableTypeDefEnv = map<callableId, callableTypeDef>

dec $empty_callableTypeDefEnv : map<callableId, callableTypeDef>
def $empty_callableTypeDefEnv = $empty_map<callableId, callableTypeDef>

;;
;; Type frame
;; : variable name -> variable type
;;

syntax varTypeIR = direction typeIR

syntax typeFrame = map<id, varTypeIR>

dec $empty_typeFrame : map<id, varTypeIR>
def $empty_typeFrame = $empty_map<id, varTypeIR>

;;
;; Typing layers
;;

syntax globalTypingLayer =
  { TYPE typeDefEnv,
    CALLABLE callableTypeDefEnv,
    FRAME typeFrame }

syntax blockTypingLayer =
  { FRAME typeFrame }

syntax localTypingLayer =
  { FRAMES typeFrame* }

;;
;; Typing context
;;

syntax typingContext =
  { GLOBAL globalTypingLayer,
    BLOCK blockTypingLayer,
    LOCAL localTypingLayer }

var TC : typingContext

dec $empty_typingContext : typingContext
def $empty_typingContext = TC
  -- if globalTypingLayer
      = { TYPE $empty_typeDefEnv,
          CALLABLE $empty_callableTypeDefEnv,
          FRAME $empty_typeFrame }
  -- if blockTypingLayer = { FRAME $empty_typeFrame }
  -- if localTypingLayer = { FRAMES ([$empty_typeFrame]) }
  -- if TC
      = { GLOBAL globalTypingLayer,
          BLOCK blockTypingLayer,
          LOCAL localTypingLayer }

;;
;; Table context
;;

syntax matchKey = typeIR `: nameIR

syntax matchAction = callableId `( parameterIR* `@ argumentIR* )

syntax tableContext =
  { KEY matchKey,
    ACTIONS matchAction* }

var TBLC : tableContext

;;
;; Frame entry and exit
;;

dec $enter_t(typingContext) : typingContext
dec $exit_t(typingContext) : typingContext

def $enter_t(TC)
  = TC[ .LOCAL.FRAMES = $empty_typeFrame :: TC.LOCAL.FRAMES ]
def $exit_t(TC) = TC [ .LOCAL.FRAMES = typeFrame_t* ]
  -- if typeFrame_h :: typeFrame_t* = TC.LOCAL.FRAMES

;;
;; Adders
;;

;;
;;;; Adder for variables
;;

dec $add_var_t(scope, typingContext, id, varTypeIR) : typingContext
dec $add_vars_t(scope, typingContext, id*, varTypeIR*) : typingContext

def $add_var_t(GLOBAL, TC, id, varTypeIR) = TC'
  -- if typeFrame = TC.GLOBAL.FRAME
  -- if ~$in_set<id>($dom_map<id, varTypeIR>(typeFrame), id)
  -- if typeFrame' = $add_map<id, varTypeIR>(typeFrame, id, varTypeIR)
  -- if TC' = TC[.GLOBAL.FRAME = typeFrame']

def $add_var_t(BLOCK, TC, id, varTypeIR) = TC'
  -- if typeFrame = TC.BLOCK.FRAME
  -- if ~$in_set<id>($dom_map<id, varTypeIR>(typeFrame), id)
  -- if typeFrame' = $add_map<id, varTypeIR>(typeFrame, id, varTypeIR)
  -- if TC' = TC[.BLOCK.FRAME = typeFrame']

def $add_var_t(LOCAL, TC, id, varTypeIR) = TC'
  -- if typeFrame_h :: typeFrame_t* = TC.LOCAL.FRAMES
  -- if ~$in_set<id>($dom_map<id, varTypeIR>(typeFrame_h), id)
  -- if typeFrame_h' = $add_map<id, varTypeIR>(typeFrame_h, id, varTypeIR)
  -- if TC' = TC[.LOCAL.FRAMES = typeFrame_h' :: typeFrame_t*]

def $add_vars_t(scope, TC, eps, eps) = TC
def $add_vars_t(scope, TC, id_h :: id_t*, varTypeIR_h :: varTypeIR_t*) = TC''
  -- if TC' = $add_var_t(scope, TC, id_h, varTypeIR_h)
  -- if TC'' = $add_vars_t(scope, TC', id_t*, varTypeIR_t*)

;;
;;;; Adder for callableDefs
;;

dec $add_callableDef_t(typingContext, callableId, callableTypeDef)
  : typingContext

def $add_callableDef_t(TC, callableId, callableTypeDef)
  = TC'
  -- if callableTypeDefEnv = TC.GLOBAL.CALLABLE
  -- if ~$in_set<callableId>(
        $dom_map<callableId, callableTypeDef>(callableTypeDefEnv),
        callableId
      )
  -- if callableTypeDefEnv'
      = $add_map<callableId, callableTypeDef>(
          callableTypeDefEnv,
          callableId,
          callableTypeDef
        )
  -- if TC' = TC[.GLOBAL.CALLABLE = callableTypeDefEnv']

;;
;;;; Adder for typeDefs
;;

dec $add_typeDef_t(typingContext, typeId, typeDefIR) : typingContext

def $add_typeDef_t(TC, typeId, typeDefIR) = TC'
  -- if typeDefEnv = TC.GLOBAL.TYPE
  -- if ~$in_set<typeId>($dom_map<typeId, typeDefIR>(typeDefEnv), typeId)
  -- if typeDefEnv' = $add_map<typeId, typeDefIR>(typeDefEnv, typeId, typeDefIR)
  -- if TC' = TC[.GLOBAL.TYPE = typeDefEnv']

;;
;; Finders
;;

;;
;;;; Finders for variables
;;

dec $find_var_t(scope, typingContext, id) : varTypeIR

def $find_var_t(GLOBAL, TC, id) = varTypeIR
  -- if typeFrame = TC.GLOBAL.FRAME
  -- if varTypeIR = $find_map<id, varTypeIR>(typeFrame, id)
def $find_var_t(BLOCK, TC, id) = varTypeIR
  -- if typeFrame = TC.BLOCK.FRAME
  -- if varTypeIR = $find_map<id, varTypeIR>(typeFrame, id)
def $find_var_t(BLOCK, TC, id) = $find_var_t(GLOBAL, TC, id)
  -- if typeFrame = TC.BLOCK.FRAME
  -- if eps = $find_map<id, varTypeIR>(typeFrame, id)
def $find_var_t(LOCAL, TC, id) = varTypeIR
  -- if typeFrame* = TC.LOCAL.FRAMES
  -- if varTypeIR = $find_maps<id, varTypeIR>(typeFrame*, id)
def $find_var_t(LOCAL, TC, id) = $find_var_t(BLOCK, TC, id)
  -- if typeFrame* = TC.LOCAL.FRAMES
  -- if eps = $find_maps<id, varTypeIR>(typeFrame*, id)

;;
;;;; Finders for typeDefs
;;

dec $find_typeDef_t(typingContext, typeId) : typeDefIR
def $find_typeDef_t(TC, typeId) = typeDefIR
  -- if typeDefIR = $find_map<typeId, typeDefIR>(TC.GLOBAL.TYPE, typeId)

;;
;;;; Finders for callableTypeDefs
;;

dec $find_callableDef_t(typingContext, callableId) : callableTypeDef
def $find_callableDef_t(TC, callableId) = callableTypeDef
  -- if callableTypeDef
      = $find_map<callableId, callableTypeDef>(TC.GLOBAL.CALLABLE, callableId)

;;
;; typeDefIR -> typeIR. only called for monomorphic types
;;

dec $typeIR_of_typeDefIR(typeDefIR) : typeIR

def $typeIR_of_typeDefIR(dataTypeIR) = dataTypeIR
def $typeIR_of_typeDefIR(objectTypeDefIR) = objectTypeDefIR
