;;
;; Bit array conversions
;;

syntax bit = bool
syntax bits = bit*

builtin dec $bits_to_int_unsigned(bits) : int
builtin dec $bits_to_int_signed(bits) : int

builtin dec $int_to_bits_unsigned(nat, int) : bits
builtin dec $int_to_bits_signed(nat, int) : bits

;;
;; Write bits into a value
;;
;; $write_value_from_bits(value, bits) consumes bits from the front
;; in field declaration order and returns the updated value.
;; The auxiliary primed functions also return the unconsumed remainder.
;;

dec $write_value_from_bits(value, bits) : value
dec $write_value_from_bits'(value, bits) : (value, bits)
dec $write_value_fields_from_bits'(fieldValue*, bits) : (fieldValue*, bits)

def $write_value_from_bits(value, b*) = value'
  -- if (value', eps) = $write_value_from_bits'(value, b*)

def $write_value_from_bits'(w W _, b*) = (w W i, b_t*)
  -- if b_h* = b*[0 : w]
  -- if n_t = $(|b*| - w)
  -- if b_t* = b*[w : n_t]
  -- if i = $int_to_bitstr(w, $bits_to_int_unsigned(b_h*))

def $write_value_from_bits'(w S _, b*) = (w S i, b_t*)
  -- if b_h* = b*[0 : w]
  -- if n_t = $(|b*| - w)
  -- if b_t* = b*[w : n_t]
  -- if i = $int_to_bitstr(w, $bits_to_int_signed(b_h*))

def $write_value_from_bits'(`B _, b_h :: b_t*) = (`B b_h, b_t*)

def $write_value_from_bits'(STRUCT typeId `{ fieldValue* }, b*)
  = (STRUCT typeId `{ fieldValue'* }, b_rest*)
  -- if (fieldValue'*, b_rest*) = $write_value_fields_from_bits'(fieldValue*, b*)

def $write_value_from_bits'(HEADER typeId `{ fieldValue* }, b*)
  = (HEADER typeId `{ fieldValue'* }, b_rest*)
  -- if (fieldValue'*, b_rest*) = $write_value_fields_from_bits'(fieldValue*, b*)

;; fieldValue

def $write_value_fields_from_bits'(eps, b*) = (eps, b*)

def $write_value_fields_from_bits'((value id `;) :: fieldValue_t*, b*)
  = ((value' id `;) :: fieldValue_t'*, b_rest*)
  -- if (value', b_mid*) = $write_value_from_bits'(value, b*)
  -- if (fieldValue_t'*, b_rest*) = $write_value_fields_from_bits'(fieldValue_t*, b_mid*)
