;; The lower spec for `examples/extern-call.watsup`.
;;
;; `spectec-boot extern -lower examples/lower` loads this and resolves the
;; *extern* names the upper spec declares against the ordinary `dec`/`relation`
;; definitions here -- which is exactly what `Make_parametric` does when it
;; routes `Call_extern_func`/`Call_extern_rel` into a lower runner's
;; `eval_func`/`eval_rel` (`backend-boot/spectec.ml:173-215`).
;;
;; Deliberately exercises shapes whose decoding is non-trivial: a list argument
;; taken apart with a cons pattern (the one place the AL interpreter reads an
;; argument's `note.typ`, in `assign_cons_exp`), and a variant/mixop argument.

var i : int
var n : nat

;; ---------------------------------------------------------------------------
;; An extern *function*: sums a list, taken apart head/tail so that the decoded
;; list value's note is actually propagated by `assign_cons_exp`.
;; ---------------------------------------------------------------------------

dec $lower_sum(int*) : int
def $lower_sum([]) = 0
def $lower_sum(i_h :: i_t*) = $(i_h + $lower_sum(i_t*))

;; ---------------------------------------------------------------------------
;; An extern *relation*, with outputs.  Partial on purpose: only a `POS` shape
;; has a derivation, so a `NEG` input FAILs and that FAIL has to cross the wire
;; as `{"fail": null}`.
;; ---------------------------------------------------------------------------

syntax sign =
  | POS int
  | NEG int

relation Lower_classify:
  |- sign ':' int int
  hint(input %0)

;; Two outputs, so the `{"ok": [val, ...]}` multi-value response is exercised.
rule Lower_classify/pos:
  |- (POS i) ':' i $(i * 2)
  -- if $(i >= 0)
