extern syntax opaque
syntax off = OFF
syntax on = ON
syntax flag = off | on
var f : flag

extern relation External: flag ~> flag
  hint(input %0)
relation Check: flag ~> flag
  hint(input %0)
rulegroup Check/value {
rule Check/on: ON ~> ON
}
rule Check/else: f ~> f
  -- otherwise

extern dec $external(flag) : flag
builtin dec $text_to_int(text) : nat
dec $identity(flag) : flag
def $identity(ON) = ON
def $identity(f) = f
  -- otherwise

tbl dec $is_on(flag) : bool
tbl def $is_on =
  | ON => true
  | OFF => false
