    EC_0 ARCH_0 |- callStatementIR : EC_1 ARCH_1 _EMPTY
    -- Stmt_eval: LOCAL EC_0 ARCH_0 |- callStatementIR : EC_1 ARCH_1 _EMPTY

}





rule ParserStmt_eval/parserBlockStatementIR:
  EC_0 ARCH_0 |- parserBlockStatementIR : EC_3 ARCH_1 parserStatementResult
  -- if EC_1 = $enter_e(EC_0)
  -- ParserBlock_eval:
      EC_1 ARCH_0 |- parserBlockStatementIR : EC_2 ARCH_1 parserStatementResult
  -- if EC_3 = $exit_e(EC_2)





rulegroup ParserStmt_eval/parserConditionalStatementIR {

  rule ParserStmt_eval/non-else-reject:
    EC ARCH
        |- IF `( typedExpressionIR_cond `) parserStatementIR_then
            : EC_cond ARCH_cond rejectTransitionResult
    -- Expr_eval:
        LOCAL EC ARCH
            |- typedExpressionIR_cond : EC_cond ARCH_cond rejectTransitionResult

  rule ParserStmt_eval/non-else-cont-true:
    EC ARCH
        |- IF `( typedExpressionIR_cond `) parserStatementIR_then
            : EC_then ARCH_then parserStatementResult
    -- Expr_eval:
        LOCAL EC ARCH
            |- typedExpressionIR_cond : EC_cond ARCH_cond (_CONT (_B true))
    -- ParserStmt_eval:
        EC_cond ARCH_cond
            |- parserStatementIR_then : EC_then ARCH_then parserStatementResult

  rule ParserStmt_eval/non-else-cont-false:
    EC ARCH
        |- IF `( typedExpressionIR_cond `) parserStatementIR_then
            : EC_cond ARCH_cond _EMPTY
    -- Expr_eval:
        LOCAL EC ARCH
            |- typedExpressionIR_cond : EC_cond ARCH_cond (_CONT (_B false))

  rule ParserStmt_eval/else-reject:
    EC ARCH
        |- IF `( typedExpressionIR_cond `) parserStatementIR_then ELSE
        parserStatementIR_else
            : EC_cond ARCH_cond rejectTransitionResult
    -- Expr_eval:
        LOCAL EC ARCH
            |- typedExpressionIR_cond : EC_cond ARCH_cond rejectTransitionResult

  rule ParserStmt_eval/else-cont-true:
    EC ARCH
        |- IF `( typedExpressionIR_cond `) parserStatementIR_then ELSE
        parserStatementIR_else
            : EC_then ARCH_then parserStatementResult
    -- Expr_eval:
        LOCAL EC ARCH
            |- typedExpressionIR_cond : EC_cond ARCH_cond (_CONT (_B true))
    -- ParserStmt_eval:
        EC_cond ARCH_cond
            |- parserStatementIR_then : EC_then ARCH_then parserStatementResult

  rule ParserStmt_eval/else-cont-false:
    EC ARCH
        |- IF `( typedExpressionIR_cond `) parserStatementIR_then ELSE
        parserStatementIR_else
            : EC_else ARCH_else parserStatementResult
    -- Expr_eval:
        LOCAL EC ARCH
            |- typedExpressionIR_cond : EC_cond ARCH_cond (_CONT (_B false))
    -- ParserStmt_eval:
        EC_cond ARCH_cond
            |- parserStatementIR_else : EC_else ARCH_else parserStatementResult

}









rulegroup ParserBlockElementStmt_eval {

  rule ParserBlockElementStmt_eval/constantDeclarationIR:
