  rule TableEntry_keyset_ok/tuple-non-noprilpm:
    TC TBLC |- `( '_' `) : TBLS (`( '_' `))
    -- if TBLC.MODE = NONE \/ TBLC.MODE = PRI
    -- if TBLS = NON_LPM

}





rule TableEntry_keyset_ok/tuple:
  TC TBLC
      |- `( simpleKeysetExpression_h ',' simpleKeysetExpressionList_t `)
