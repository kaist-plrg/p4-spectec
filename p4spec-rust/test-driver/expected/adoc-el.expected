  rule V1Model_parser/cont:
    EC_0 ARCH_0 |- EC_1 ARCH_1 ACCEPT
    -- if argumentIR_packet_in = $V1Model_setup_packet_in_argument(EC_0)
    -- if argumentIR_hdr = $V1Model_setup_hdr_argument(ARCH_0)
