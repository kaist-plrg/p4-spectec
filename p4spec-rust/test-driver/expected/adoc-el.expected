def $is_tableLargestPriorityWinsProperty(_) = false
  -- otherwise

dec $insert_NoAction_tablePropertyIR(tableContext, tablePropertyIR*)
  : (tableContext, tablePropertyIR*)

def $insert_NoAction_tablePropertyIR(TBLC, eps) = (TBLC, eps)

def $insert_NoAction_tablePropertyIR(
    TBLC_0,
    tablePropertyIR_h :: tablePropertyIR_t*)
  = (TBLC_1, tablePropertyIR_h_updated :: tablePropertyIR_t*)
  -- if ACTIONS '=' `{ tableActionIR* `} = tablePropertyIR_h
  -- (if (_ tableActionReferenceIR '#' `( _ ',' _ `) ';' = tableActionIR))*
  -- if tableActionReferenceIR_NoAction = ('.' "NoAction") eps `( eps `)
  -- if ~(tableActionReferenceIR_NoAction <- tableActionReferenceIR*)
  -- if TBLC_1 = $add_action_tbl(TBLC_0, '.' "NoAction", eps, eps)
  -- if tableActionIR_NoAction
      = _EMPTY tableActionReferenceIR_NoAction '#' `( eps ',' eps `) ';'
  -- if tablePropertyIR_h_updated
      = ACTIONS '=' `{ tableActionIR* ++ [tableActionIR_NoAction] `}

def $insert_NoAction_tablePropertyIR(
    TBLC_0,
    tablePropertyIR_h :: tablePropertyIR_t*)
  = (TBLC_0, tablePropertyIR_h :: tablePropertyIR_t*)
  -- if ACTIONS '=' `{ tableActionIR* `} = tablePropertyIR_h
  -- (if (_ tableActionReferenceIR '#' `( _ ',' _ `) ';' = tableActionIR))*
  -- if tableActionReferenceIR_NoAction = ('.' "NoAction") eps `( eps `)
  -- if (tableActionReferenceIR_NoAction <- tableActionReferenceIR*)

def $insert_NoAction_tablePropertyIR(
    TBLC_0,
    tablePropertyIR_h :: tablePropertyIR_t*)
  = (TBLC_1, tablePropertyIR_h :: tablePropertyIR_t_updated*)
  -- if ~(tablePropertyIR_h <: tableActionsPropertyIR)
  -- if (TBLC_1, tablePropertyIR_t_updated*)
      = $insert_NoAction_tablePropertyIR(TBLC_0, tablePropertyIR_t*)

rulegroup Table_ok {

  rule Table_ok/zero-default-action:
    TC
        |- tableProperty*
            : TBLC_2
            (tablePropertyIR_updated* ++ [tablePropertyIR_default_action])
    -- if $(
      |$filter_<tableProperty>(
          tableProperty*,
          $is_tableKeysProperty(tableProperty)*)|
          <= 1)
    -- if |$filter_<tableProperty>(
        tableProperty*,
        $is_tableActionsProperty(tableProperty)*)|
        = 1
    -- if |$filter_<tableProperty>(
        tableProperty*,
        $is_tableDefaultActionProperty(tableProperty)*)|
        = 0
    -- if $(
      |$filter_<tableProperty>(
          tableProperty*,
          $is_tableLargestPriorityWinsProperty(tableProperty)*)|
          <= 1)
    -- if TBLC_0 = $empty_tableContext()
    -- TableProperties_ok: TC TBLC_0 |- tableProperty* : TBLC_1 tablePropertyIR*
    -- if tablePropertyIR_default_action
        = _EMPTY eps DEFAULT_ACTION '=' ((_BARE "NoAction") eps `( eps `)) ';'
    -- if (TBLC_2, tablePropertyIR_updated*)
        = $insert_NoAction_tablePropertyIR(TBLC_1, tablePropertyIR*)

  rule Table_ok/one-default-action:
    TC |- tableProperty* : TBLC_1 tablePropertyIR*
    -- if $(
      |$filter_<tableProperty>(
          tableProperty*,
          $is_tableKeysProperty(tableProperty)*)|
          <= 1)
    -- if |$filter_<tableProperty>(
        tableProperty*,
        $is_tableActionsProperty(tableProperty)*)|
        = 1
    -- if |$filter_<tableProperty>(
        tableProperty*,
        $is_tableDefaultActionProperty(tableProperty)*)|
        = 1
    -- if $(
      |$filter_<tableProperty>(
          tableProperty*,
          $is_tableLargestPriorityWinsProperty(tableProperty)*)|
          <= 1)
    -- if TBLC_0 = $empty_tableContext()
    -- TableProperties_ok: TC TBLC_0 |- tableProperty* : TBLC_1 tablePropertyIR*

}

rule TableType_ok:
  TC_0 TBLC |- name : TC_1 typeIR_table
  -- if nameIR = $name(name)
  -- if typeId_enum = "action_list(" ++ nameIR ++ ")"
