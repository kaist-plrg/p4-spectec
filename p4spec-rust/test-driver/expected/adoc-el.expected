rulegroup Callee_eval/externMethodCallee {

  rule Callee_eval/abort:
    p EC_0 ARCH_0
        |- (typedExpressionIR '.' nameIR) `< '_' `> `( argumentListIR `)
            : EC_1 ARCH_1 abortResult
    -- if typedLvalueIR = $typedExpressionIR_as_typedLvalueIR(typedExpressionIR)
    -- Lvalue_eval: p EC_0 ARCH_0 |- typedLvalueIR : EC_1 ARCH_1 abortResult

  rule Callee_eval/cont:
    p EC_0 ARCH_0
        |- (typedExpressionIR '.' nameIR) `< '_' `> `( argumentListIR `)
            : EC_1 ARCH_1 (_CONT externMethodCallee)
    -- if typedLvalueIR = $typedExpressionIR_as_typedLvalueIR(typedExpressionIR)
    -- Lvalue_eval:
        p EC_0 ARCH_0 |- typedLvalueIR : EC_1 ARCH_1 (_CONT storageReference)
    -- Lvalue_read: p EC_1 ARCH_1 |- storageReference : (REF objectId)
    -- if EXTERN _ `< theta `> `{ _ frame externMethodDefEnv `}
        = $find_object_e(ARCH_1, objectId)
    -- if callTargetKey = $callTargetKey(nameIR, argumentListIR)
    -- if _ ':' externMethodDef '#' id_default* '#' id_optional*
        = $find_overloaded<externMethodDef>(
            externMethodDefEnv,
            callTargetKey,
            def $parameterListIR_of_externMethodDef)
    -- if EXTERN_METHOD nameIR `< typeParameterListIR `> `( parameterListIR `)
    blockStatementIR?
        = externMethodDef
    -- if externMethodCallee
        = EXTERN_METHOD objectId '.' nameIR `< typeParameterListIR `>
        `( parameterListIR '#' id_default* '#' id_optional* `)
        `{ theta ';' frame ';' blockStatementIR? `}

}





rulegroup Callee_eval/parserApplyMethodCallee {

  rule Callee_eval/abort:
    p EC_0 ARCH_0
        |- (typedExpressionIR '.' "apply") `< '_' `> `( argumentListIR `)
            : EC_1 ARCH_1 abortResult
    -- if typedLvalueIR = $typedExpressionIR_as_typedLvalueIR(typedExpressionIR)
    -- Lvalue_eval: p EC_0 ARCH_0 |- typedLvalueIR : EC_1 ARCH_1 abortResult

  rule Callee_eval/cont:
    p EC_0 ARCH_0
        |- (typedExpressionIR '.' "apply") `< '_' `> `( argumentListIR `)
            : EC_1 ARCH_1 (_CONT parserApplyMethodCallee)
    -- if typedLvalueIR = $typedExpressionIR_as_typedLvalueIR(typedExpressionIR)
    -- Lvalue_eval:
        p EC_0 ARCH_0 |- typedLvalueIR : EC_1 ARCH_1 (_CONT storageReference)
    -- Lvalue_read: p EC_1 ARCH_1 |- storageReference : (REF objectId)
    -- if PARSER `< theta `> `( parameterListIR `)
    `{ frame parserLocalDeclarationListIR stateEnv `}
        = $find_object_e(ARCH_1, objectId)
    -- if callableId = $callableId_IR("apply", parameterListIR)
    -- if parserApplyMethodDef
        = PARSER_APPLY `( parameterListIR `)
        `{ parserLocalDeclarationListIR ';' stateEnv `}
    -- if callTargetKey = $callTargetKey("apply", argumentListIR)
    -- if _ ':' _ '#' id_default* '#' _
        = $find_overloaded<parserApplyMethodDef>(
            `{ (callableId ':' parserApplyMethodDef) `},
            callTargetKey,
            def $parameterListIR_of_parserApplyMethodDef)
    -- if parserApplyMethodCallee
        = PARSER objectId '.' APPLY `( parameterListIR '#' id_default* `)
        `{ theta ';' frame ';' parserLocalDeclarationListIR ';' stateEnv `}

}





rulegroup Callee_eval/controlApplyMethodCallee {

  rule Callee_eval/abort:
    p EC_0 ARCH_0
        |- (typedExpressionIR '.' "apply") `< '_' `> `( argumentListIR `)
            : EC_1 ARCH_1 abortResult
    -- if typedLvalueIR = $typedExpressionIR_as_typedLvalueIR(typedExpressionIR)
    -- Lvalue_eval: p EC_0 ARCH_0 |- typedLvalueIR : EC_1 ARCH_1 abortResult

  rule Callee_eval/cont:
    p EC_0 ARCH_0
        |- (typedExpressionIR '.' "apply") `< '_' `> `( argumentListIR `)
            : EC_1 ARCH_1 (_CONT controlApplyMethodCallee)
    -- if typedLvalueIR = $typedExpressionIR_as_typedLvalueIR(typedExpressionIR)
    -- Lvalue_eval:
        p EC_0 ARCH_0 |- typedLvalueIR : EC_1 ARCH_1 (_CONT storageReference)
    -- Lvalue_read: p EC_1 ARCH_1 |- storageReference : (REF objectId)
    -- if CONTROL `< theta `> `( parameterListIR `)
    `{ frame controlLocalDeclarationListIR actionDefEnv controlBodyIR `}
        = $find_object_e(ARCH_1, objectId)
    -- if callableId = $callableId_IR("apply", parameterListIR)
    -- if controlApplyMethodDef
        = CONTROL_APPLY `( parameterListIR `)
        `{ controlLocalDeclarationListIR ';' actionDefEnv ';' controlBodyIR `}
    -- if callTargetKey = $callTargetKey("apply", argumentListIR)
    -- if _ ':' _ '#' id_default* '#' _
        = $find_overloaded<controlApplyMethodDef>(
            `{ (callableId ':' controlApplyMethodDef) `},
            callTargetKey,
            def $parameterListIR_of_controlApplyMethodDef)
    -- if controlApplyMethodCallee
        = CONTROL objectId '.' APPLY `( parameterListIR '#' id_default* `)
        `{
          theta ';' frame ';' controlLocalDeclarationListIR ';' actionDefEnv ';'
          controlBodyIR
        `}

}





rulegroup Callee_eval/tableApplyMethodCallee {

  rule Callee_eval/abort:
    p EC_0 ARCH_0
        |- (typedExpressionIR '.' "apply") `< '_' `> `( eps `)
            : EC_1 ARCH_1 abortResult
    -- if typedLvalueIR = $typedExpressionIR_as_typedLvalueIR(typedExpressionIR)
    -- Lvalue_eval: p EC_0 ARCH_0 |- typedLvalueIR : EC_1 ARCH_1 abortResult

  rule Callee_eval/cont:
    p EC_0 ARCH_0
        |- (typedExpressionIR '.' "apply") `< '_' `> `( eps `)
            : EC_1 ARCH_1 (_CONT tableApplyMethodCallee)
    -- if typedLvalueIR = $typedExpressionIR_as_typedLvalueIR(typedExpressionIR)
    -- Lvalue_eval:
        p EC_0 ARCH_0 |- typedLvalueIR : EC_1 ARCH_1 (_CONT storageReference)
    -- Lvalue_read: p EC_1 ARCH_1 |- storageReference : (REF objectId)
    -- if TABLE typeId `{ frame TBL `} = $find_object_e(ARCH_1, objectId)
    -- if tableApplyMethodCallee = TABLE objectId '.' APPLY `{ frame ';' TBL `}

}





rule Callee_eval/parenthesized:
  p EC_0 ARCH_0
      |- (`( callableTargetIR `)) `< '_' `> `( argumentListIR `)
          : EC_1 ARCH_1 calleeResult
  -- Callee_eval:
      p EC_0 ARCH_0
          |- callableTargetIR `< '_' `> `( argumentListIR `)
              : EC_1 ARCH_1 calleeResult





rulegroup Copy_in_arg/directionless-in {

  rule Copy_in_arg/abort:
    ARCH_0
        |- p_caller EC_caller_0 (_ direction typeIR nameIR _) '@' p_callee
        EC_callee_0 argumentIR
            ~> ARCH_1 EC_caller_1 EC_callee_0 '#' abortResult
    -- if direction = _EMPTY \/ direction = IN
    -- Argument_eval:
        p_caller EC_caller_0 ARCH_0
            |- argumentIR : EC_caller_1 ARCH_1 abortResult

  rule Copy_in_arg/cont:
    ARCH_0
        |- p_caller EC_caller_0 (_ direction typeIR nameIR _) '@' p_callee
        EC_callee_0 argumentIR
            ~> ARCH_1 EC_caller_1 EC_callee_1 '#' (_CONT eps)
    -- if direction = _EMPTY \/ direction = IN
    -- Argument_eval:
        p_caller EC_caller_0 ARCH_0
            |- argumentIR : EC_caller_1 ARCH_1 (_CONT value)
    -- if EC_callee_1 = $add_var_e(p_callee, EC_callee_0, _BARE nameIR, value)

}





rulegroup Copy_in_arg/inout {

  rule Copy_in_arg/abort:
    ARCH_0
        |- p_caller EC_caller_0 (_ INOUT typeIR nameIR _) '@' p_callee
        EC_callee_0 argumentIR
            ~> ARCH_1 EC_caller_1 EC_callee_0 '#' abortResult
    -- Argument_eval_lvalue:
        p_caller EC_caller_0 ARCH_0
            |- argumentIR : EC_caller_1 ARCH_1 abortResult

  rule Copy_in_arg/cont:
    ARCH_0
        |- p_caller EC_caller_0 (_ INOUT typeIR nameIR _) '@' p_callee
        EC_callee_0 argumentIR
            ~> ARCH_1 EC_caller_1 EC_callee_1 '#' (_CONT storageReference)
    -- Argument_eval_lvalue:
        p_caller EC_caller_0 ARCH_0
            |- argumentIR : EC_caller_1 ARCH_1 (_CONT storageReference)
    -- Lvalue_read: p_caller EC_caller_1 ARCH_1 |- storageReference : value
    -- if EC_callee_1 = $add_var_e(p_callee, EC_callee_0, _BARE nameIR, value)

}





rulegroup Copy_in_arg/out {

  rule Copy_in_arg/abort:
    ARCH_0
        |- p_caller EC_caller_0 (_ OUT typeIR nameIR _) '@' p_callee EC_callee_0
        argumentIR
            ~> ARCH_1 EC_caller_1 EC_callee_0 '#' abortResult
    -- Argument_eval_lvalue:
        p_caller EC_caller_0 ARCH_0
            |- argumentIR : EC_caller_1 ARCH_1 abortResult

  rule Copy_in_arg/cont:
    ARCH_0
        |- p_caller EC_caller_0 (_ OUT typeIR nameIR _) '@' p_callee EC_callee_0
        argumentIR
            ~> ARCH_1 EC_caller_1 EC_callee_1 '#' (_CONT storageReference?)
    -- Argument_eval_lvalue:
        p_caller EC_caller_0 ARCH_0
            |- argumentIR : EC_caller_1 ARCH_1 (_CONT storageReference?)
    -- if typeIR_subst = $subst_type_e(p_callee, EC_callee_0, typeIR)
    -- if value_init = $default(typeIR_subst)
    -- if EC_callee_1
        = $add_var_e(p_callee, EC_callee_0, _BARE nameIR, value_init)

}





rulegroup Copy_in {

  rule Copy_in/nil:
    p_shared ARCH
        |- p_caller EC_caller eps '@' p_callee EC_callee_0 eps
            ~> ARCH EC_caller EC_callee_1 '#' (_CONT eps)
    -- if EC_callee_1 = $copy_e(p_shared, EC_caller, EC_callee_0)

  rule Copy_in/cons-head-abort:
    p_shared ARCH_0
        |- p_caller EC_caller_0 (parameterIR_h :: parameterIR_t*) '@' p_callee
        EC_callee_0 (argumentIR_h :: argumentIR_t*)
            ~> ARCH_1 EC_caller_1 EC_callee_1 '#' abortResult
    -- Copy_in_arg:
        ARCH_0
            |- p_caller EC_caller_0 parameterIR_h '@' p_callee EC_callee_0
            argumentIR_h
                ~> ARCH_1 EC_caller_1 EC_callee_1 '#' abortResult

  rule Copy_in/cons-head-cont-tail-abort:
    p_shared ARCH_0
        |- p_caller EC_caller_0 (parameterIR_h :: parameterIR_t*) '@' p_callee
        EC_callee_0 (argumentIR_h :: argumentIR_t*)
            ~> ARCH_2 EC_caller_2 EC_callee_2 '#' abortResult
    -- Copy_in_arg:
        ARCH_0
            |- p_caller EC_caller_0 parameterIR_h '@' p_callee EC_callee_0
            argumentIR_h
                ~> ARCH_1 EC_caller_1 EC_callee_1 '#'
                (_CONT storageReference_h?)
    -- Copy_in:
        p_shared ARCH_1
            |- p_caller EC_caller_1 parameterIR_t* '@' p_callee EC_callee_1
            argumentIR_t*
                ~> ARCH_2 EC_caller_2 EC_callee_2 '#' abortResult

  rule Copy_in/cons-head-cont-tail-cont:
    p_shared ARCH_0
        |- p_caller EC_caller_0 (parameterIR_h :: parameterIR_t*) '@' p_callee
        EC_callee_0 (argumentIR_h :: argumentIR_t*)
            ~> ARCH_2 EC_caller_2 EC_callee_2 '#' (_CONT storageReference?*)
    -- Copy_in_arg:
        ARCH_0
            |- p_caller EC_caller_0 parameterIR_h '@' p_callee EC_callee_0
            argumentIR_h
                ~> ARCH_1 EC_caller_1 EC_callee_1 '#'
                (_CONT storageReference_h?)
    -- Copy_in:
        p_shared ARCH_1
            |- p_caller EC_caller_1 parameterIR_t* '@' p_callee EC_callee_1
            argumentIR_t*
                ~> ARCH_2 EC_caller_2 EC_callee_2 '#'
                (_CONT storageReference_t?*)
    -- if storageReference?* = storageReference_h? :: storageReference_t?*

}





rule Copy_in_default:
  parameterIR* '@' p_callee EC_callee_0 ~> EC_callee_1
  -- (if (_ _ _ nameIR ('=' _VALUE value) = parameterIR))*
  -- if EC_callee_1
      = $add_vars_e(p_callee, EC_callee_0, (_BARE nameIR)*, value*)





rule Copy_out_argument/in-directionless:
  ARCH
      |- p_caller EC_caller_0 (_ direction typeIR nameIR _) '@' p_callee
      EC_callee eps
          ~> EC_caller_0
  -- if direction = IN \/ direction = _EMPTY





rulegroup Copy_out_argument/out-inout {

  rule Copy_out_argument/dontcare:
    ARCH
        |- p_caller EC_caller (_ direction typeIR nameIR _) '@' p_callee
        EC_callee eps
            ~> EC_caller
    -- if direction = OUT \/ direction = INOUT

  rule Copy_out_argument/non-dontcare:
    ARCH
        |- p_caller EC_caller_0 (_ direction typeIR nameIR _) '@' p_callee
        EC_callee storageReference
            ~> EC_caller_1
    -- if direction = OUT \/ direction = INOUT
    -- if value = $find_var_e(_BARE nameIR, p_callee, EC_callee)
    -- Lvalue_write:
        p_caller EC_caller_0 ARCH |- storageReference := value : EC_caller_1

}





relation Copy_out_inner:
  arch
      |- cursor evalContext parameterListIR '@' cursor evalContext
      storageReference?*
          ~> evalContext

rulegroup Copy_out_inner {

  rule Copy_out_inner/nil:
    ARCH |- p_caller EC_caller eps '@' p_callee EC_callee eps ~> EC_caller

  rule Copy_out_inner/cons:
    ARCH
        |- p_caller EC_caller_0 (parameterIR_h :: parameterIR_t*) '@' p_callee
        EC_callee (storageReference_h? :: storageReference_t?*)
            ~> EC_caller_2
    -- Copy_out_argument:
        ARCH
            |- p_caller EC_caller_0 parameterIR_h '@' p_callee EC_callee
            storageReference_h?
                ~> EC_caller_1
    -- Copy_out_inner:
        ARCH
            |- p_caller EC_caller_1 parameterIR_t* '@' p_callee EC_callee
            storageReference_t?*
                ~> EC_caller_2

}

rule Copy_out:
  p_shared ARCH
      |- p_caller EC_caller_0 parameterListIR '@' p_callee EC_callee
      storageReference?*
          ~> EC_caller_2
  -- if EC_caller_1 = $copy_e(p_shared, EC_callee, EC_caller_0)
  -- Copy_out_inner:
      ARCH
          |- p_caller EC_caller_1 parameterListIR '@' p_callee EC_callee
          storageReference?*
              ~> EC_caller_2





actionResult
    : exitResult | returnResult
    ;

relation ActionBody_eval:
  evalContext arch |- blockStatementIR : evalContext arch actionResult

rulegroup ActionBody_eval {

  rule ActionBody_eval/cont:
    EC_0 ARCH_0 |- blockStatementIR : EC_1 ARCH_1 (RETURN eps)
    -- Block_eval: EC_0 ARCH_0 |- blockStatementIR : EC_1 ARCH_1 _EMPTY

  rule ActionBody_eval/exit:
    EC_0 ARCH_0 |- blockStatementIR : EC_1 ARCH_1 EXIT
    -- Block_eval: EC_0 ARCH_0 |- blockStatementIR : EC_1 ARCH_1 EXIT

  rule ActionBody_eval/return-void:
    EC_0 ARCH_0 |- blockStatementIR : EC_1 ARCH_1 (RETURN eps)
    -- Block_eval: EC_0 ARCH_0 |- blockStatementIR : EC_1 ARCH_1 (RETURN eps)

}

rulegroup Call_eval/actionCallee {

  rule Call_eval/copyin-exit:
    p EC_0 ARCH_0
        |- actionCallee '@' `< eps `> `( argumentListIR `) : EC_1 ARCH_1 EXIT
    -- if ACTION p_shared '.' nameIR `( parameterIR* '#' id_default* `)
    blockStatementIR
        = actionCallee
    -- if EC_callee_0 = $inherit_e(p_shared, EC_0)
    -- if GIVEN parameterIR_aligned* DEFAULT parameterIR_default* OPTIONAL _
        = $align_parameterListIR(parameterIR*, argumentListIR, id_default*, eps)
    -- Copy_in:
        p_shared ARCH_0
            |- p EC_0 parameterIR_aligned* '@' LOCAL EC_callee_0 argumentListIR
                ~> ARCH_1 EC_1 EC_callee_1 '#' EXIT

  rule Call_eval/copyin-cont-ActionBody-exit:
    p EC_0 ARCH_0
        |- actionCallee '@' `< eps `> `( argumentListIR `) : EC_2 ARCH_2 EXIT
    -- if ACTION p_shared '.' nameIR `( parameterIR* '#' id_default* `)
    blockStatementIR
        = actionCallee
    -- if EC_callee_0 = $inherit_e(p_shared, EC_0)
    -- if GIVEN parameterIR_aligned* DEFAULT parameterIR_default* OPTIONAL _
        = $align_parameterListIR(parameterIR*, argumentListIR, id_default*, eps)
    -- Copy_in:
        p_shared ARCH_0
            |- p EC_0 parameterIR_aligned* '@' LOCAL EC_callee_0 argumentListIR
                ~> ARCH_1 EC_1 EC_callee_1 '#' (_CONT storageReference?*)
    -- Copy_in_default:
        parameterIR_default* '@' LOCAL EC_callee_1 ~> EC_callee_2
    -- ActionBody_eval:
        EC_callee_2 ARCH_1 |- blockStatementIR : EC_callee_3 ARCH_2 EXIT
    -- Copy_out:
        p_shared ARCH_2
            |- p EC_1 parameterIR_aligned* '@' LOCAL EC_callee_3
            storageReference?*
                ~> EC_2

  rule Call_eval/return:
    p EC_0 ARCH_0
        |- actionCallee '@' `< eps `> `( argumentListIR `)
            : EC_2 ARCH_2 (RETURN eps)
    -- if ACTION p_shared '.' nameIR `( parameterIR* '#' id_default* `)
    blockStatementIR
        = actionCallee
    -- if EC_callee_0 = $inherit_e(p_shared, EC_0)
    -- if GIVEN parameterIR_aligned* DEFAULT parameterIR_default* OPTIONAL _
        = $align_parameterListIR(parameterIR*, argumentListIR, id_default*, eps)
    -- Copy_in:
        p_shared ARCH_0
            |- p EC_0 parameterIR_aligned* '@' LOCAL EC_callee_0 argumentListIR
                ~> ARCH_1 EC_1 EC_callee_1 '#' (_CONT storageReference?*)
    -- Copy_in_default:
        parameterIR_default* '@' LOCAL EC_callee_1 ~> EC_callee_2
    -- ActionBody_eval:
        EC_callee_2 ARCH_1 |- blockStatementIR : EC_callee_3 ARCH_2 (RETURN eps)
    -- Copy_out:
        p_shared ARCH_2
            |- p EC_1 parameterIR_aligned* '@' LOCAL EC_callee_3
            storageReference?*
                ~> EC_2

}

definedFunctionResult
    : exitResult | returnResult
    ;

relation DefinedFunctionBody_eval:
  evalContext arch |- blockStatementIR : evalContext arch definedFunctionResult

rulegroup DefinedFunctionBody_eval {

  rule DefinedFunctionBody_eval/cont:
    EC_0 ARCH_0 |- blockStatementIR : EC_1 ARCH_1 (RETURN eps)
    -- Block_eval: EC_0 ARCH_0 |- blockStatementIR : EC_1 ARCH_1 _EMPTY

  rule DefinedFunctionBody_eval/exit:
    EC_0 ARCH_0 |- blockStatementIR : EC_1 ARCH_1 EXIT
    -- Block_eval: EC_0 ARCH_0 |- blockStatementIR : EC_1 ARCH_1 EXIT

  rule DefinedFunctionBody_eval/return-void:
    EC_0 ARCH_0 |- blockStatementIR : EC_1 ARCH_1 returnResult
    -- Block_eval: EC_0 ARCH_0 |- blockStatementIR : EC_1 ARCH_1 returnResult

}





rulegroup Call_eval/definedFunctionCallee {

  rule Call_eval/definedFunctionCallee-copyin-abort:
    p EC_0 ARCH_0
        |- definedFunctionCallee '@' `< typeArgumentIR* `> `( argumentListIR `)
            : EC_1 ARCH_1 abortResult
    -- if FUNCTION nameIR `< typeParameterIR* `>
    `( parameterIR* '#' id_default* `) blockStatementIR
        = definedFunctionCallee
    -- if EC_callee_0 = $inherit_e(GLOBAL, EC_0)
    -- if EC_callee_1
        = EC_callee_0[LOCAL.TYPE = `{ (typeParameterIR ':' typeArgumentIR)* `}]
    -- if GIVEN parameterIR_aligned* DEFAULT parameterIR_default* OPTIONAL _
        = $align_parameterListIR(parameterIR*, argumentListIR, id_default*, eps)
    -- if p_shared = GLOBAL
    -- Copy_in:
        p_shared ARCH_0
            |- p EC_0 parameterIR_aligned* '@' LOCAL EC_callee_1 argumentListIR
                ~> ARCH_1 EC_1 EC_callee_2 '#' abortResult

  rule Call_eval/definedFunctionCallee-cont:
    p EC_0 ARCH_0
        |- definedFunctionCallee '@' `< typeArgumentIR* `> `( argumentListIR `)
            : EC_2 ARCH_2 definedFunctionResult
    -- if FUNCTION nameIR `< typeParameterIR* `>
    `( parameterIR* '#' id_default* `) blockStatementIR
        = definedFunctionCallee
    -- if EC_callee_0 = $inherit_e(GLOBAL, EC_0)
    -- if EC_callee_1
        = EC_callee_0[LOCAL.TYPE = `{ (typeParameterIR ':' typeArgumentIR)* `}]
    -- if GIVEN parameterIR_aligned* DEFAULT parameterIR_default* OPTIONAL _
        = $align_parameterListIR(parameterIR*, argumentListIR, id_default*, eps)
    -- if p_shared = GLOBAL
    -- Copy_in:
        p_shared ARCH_0
            |- p EC_0 parameterIR_aligned* '@' LOCAL EC_callee_1 argumentListIR
                ~> ARCH_1 EC_1 EC_callee_2 '#' (_CONT storageReference?*)
    -- Copy_in_default:
        parameterIR_default* '@' LOCAL EC_callee_2 ~> EC_callee_3
    -- DefinedFunctionBody_eval:
        EC_callee_3 ARCH_1
            |- blockStatementIR : EC_callee_4 ARCH_2 definedFunctionResult
    -- Copy_out:
        p_shared ARCH_2
            |- p EC_1 parameterIR_aligned* '@' LOCAL EC_callee_4
            storageReference?*
                ~> EC_2

}





rulegroup Call_eval/externFunctionCallee {

  rule Call_eval/externFunctionCallee-copyin-abort:
    p EC_0 ARCH_0
        |- externFunctionCallee '@' `< typeArgumentIR* `> `( argumentIR* `)
            : EC_1 ARCH_1 abortResult
    -- if EXTERN_FUNCTION nameIR `< typeParameterIR* `>
    `( parameterIR* '#' id_default* '#' id_optional* `)
        = externFunctionCallee
    -- if EC_callee_0 = $inherit_e(GLOBAL, EC_0)
    -- if EC_callee_1
        = EC_callee_0[LOCAL.TYPE = `{ (typeParameterIR ':' typeArgumentIR)* `}]
    -- if GIVEN parameterIR_aligned* DEFAULT parameterIR_default* OPTIONAL _
        = $align_parameterListIR(
            parameterIR*,
            argumentIR*,
            id_default*,
            id_optional*)
    -- if p_shared = GLOBAL
    -- Copy_in:
        p_shared ARCH_0
            |- p EC_0 parameterIR_aligned* '@' LOCAL EC_callee_1 argumentIR*
                ~> ARCH_1 EC_1 EC_callee_2 '#' abortResult

  rule Call_eval/externFunctionCallee-copyin-cont-call-reject:
    p EC_0 ARCH_0
        |- externFunctionCallee '@' `< typeArgumentIR* `> `( argumentIR* `)
            : EC_1 ARCH_2 rejectTransitionResult
    -- if EXTERN_FUNCTION nameIR `< typeParameterIR* `>
    `( parameterIR* '#' id_default* '#' id_optional* `)
        = externFunctionCallee
    -- if EC_callee_0 = $inherit_e(GLOBAL, EC_0)
    -- if EC_callee_1
        = EC_callee_0[LOCAL.TYPE = `{ (typeParameterIR ':' typeArgumentIR)* `}]
    -- if GIVEN parameterIR_aligned* DEFAULT parameterIR_default* OPTIONAL _
        = $align_parameterListIR(
            parameterIR*,
            argumentIR*,
            id_default*,
            id_optional*)
    -- if p_shared = GLOBAL
    -- Copy_in:
        p_shared ARCH_0
            |- p EC_0 parameterIR_aligned* '@' LOCAL EC_callee_1 argumentIR*
                ~> ARCH_1 EC_1 EC_callee_2 '#' (_CONT storageReference?*)
    -- Copy_in_default:
        parameterIR_default* '@' LOCAL EC_callee_2 ~> EC_callee_3
    -- (if (_ _ _ nameIR_param _ = parameterIR))*
    -- ExternFunctionCall_eval:
        EC_callee_3 ARCH_1
            |- nameIR `( nameIR_param* `)
                : EC_callee_4 ARCH_2 rejectTransitionResult

  rule Call_eval/externFunctionCallee-copyin-cont-call-non-reject:
    p EC_0 ARCH_0
        |- externFunctionCallee '@' `< typeArgumentIR* `> `( argumentIR* `)
            : EC_2 ARCH_2 callResult
    -- if EXTERN_FUNCTION nameIR `< typeParameterIR* `>
    `( parameterIR* '#' id_default* '#' id_optional* `)
        = externFunctionCallee
    -- if EC_callee_0 = $inherit_e(GLOBAL, EC_0)
    -- if EC_callee_1
        = EC_callee_0[LOCAL.TYPE = `{ (typeParameterIR ':' typeArgumentIR)* `}]
    -- if GIVEN parameterIR_aligned* DEFAULT parameterIR_default* OPTIONAL _
        = $align_parameterListIR(
            parameterIR*,
            argumentIR*,
            id_default*,
            id_optional*)
    -- if p_shared = GLOBAL
    -- Copy_in:
        p_shared ARCH_0
            |- p EC_0 parameterIR_aligned* '@' LOCAL EC_callee_1 argumentIR*
                ~> ARCH_1 EC_1 EC_callee_2 '#' (_CONT storageReference?*)
    -- Copy_in_default:
        parameterIR_default* '@' LOCAL EC_callee_2 ~> EC_callee_3
    -- (if (_ _ _ nameIR_param _ = parameterIR))*
    -- ExternFunctionCall_eval:
        EC_callee_3 ARCH_1
            |- nameIR `( nameIR_param* `) : EC_callee_4 ARCH_2 callResult
    -- if ~(callResult <: rejectTransitionResult)
    -- Copy_out:
        p_shared ARCH_2
            |- p EC_1 parameterIR_aligned* '@' LOCAL EC_callee_4
            storageReference?*
                ~> EC_2

}





rulegroup Call_eval/builtinPushFrontMethodCallee {

  rule Call_eval/abort:
    p EC_0 ARCH_0
        |- builtinPushFrontMethodCallee '@' `< eps `> `( argumentIR `)
            : EC_1 ARCH_1 abortResult
    -- if BUILTIN_PUSH_FRONT storageReference = builtinPushFrontMethodCallee
    -- Lvalue_read: p EC_0 ARCH_0 |- storageReference : headerStackValue
    -- if HEADER_STACK `[ value_element* `( n_idx `) `] = headerStackValue
    -- Argument_eval: p EC_0 ARCH_0 |- argumentIR : EC_1 ARCH_1 abortResult

  rule Call_eval/cont:
    p EC_0 ARCH_0
        |- builtinPushFrontMethodCallee '@' `< eps `> `( argumentIR `)
            : EC_2 ARCH_1 (RETURN eps)
    -- if BUILTIN_PUSH_FRONT storageReference = builtinPushFrontMethodCallee
    -- Lvalue_read: p EC_0 ARCH_0 |- storageReference : headerStackValue
    -- if HEADER_STACK `[ value_element* `( n_idx `) `] = headerStackValue
    -- if n_size = |value_element*|
    -- Argument_eval:
        p EC_0 ARCH_0 |- argumentIR : EC_1 ARCH_1 (_CONT integerValue_count)
    -- if n_count = $nat_of_integerValue(integerValue_count)
    -- if $(n_count < n_size)
    -- if value_front* = value_element*[0 : n_count]
    -- (if (value_front_invalidated = $invalidate_value(value_front)))*
    -- if n_back = $max_int([0, $(n_size - n_count)])
    -- if value_back* = value_element*[0 : n_back]
    -- if value_element_updated* = value_front_invalidated* ++ value_back*
    -- if n_idx_updated = $min_nat([n_size, $(n_idx + n_count)])
    -- if headerStackValue_updated
        = HEADER_STACK `[ value_element_updated* `( n_idx_updated `) `]
    -- Lvalue_write:
        p EC_1 ARCH_1 |- storageReference := headerStackValue_updated : EC_2

  rule Call_eval/cont-overflow:
    p EC_0 ARCH_0
        |- builtinPushFrontMethodCallee '@' `< eps `> `( argumentIR `)
            : EC_2 ARCH_1 (RETURN eps)
    -- if BUILTIN_PUSH_FRONT storageReference = builtinPushFrontMethodCallee
    -- Lvalue_read: p EC_0 ARCH_0 |- storageReference : headerStackValue
    -- if HEADER_STACK `[ value_element* `( n_idx `) `] = headerStackValue
    -- if n_size = |value_element*|
    -- Argument_eval:
        p EC_0 ARCH_0 |- argumentIR : EC_1 ARCH_1 (_CONT integerValue_count)
    -- if n_count = $nat_of_integerValue(integerValue_count)
    -- if $(n_count >= n_size)
    -- (if (value_element_updated = $invalidate_value(value_element)))*
    -- if n_idx_updated = $min_nat([n_size, $(n_idx + n_count)])
    -- if headerStackValue_updated
        = HEADER_STACK `[ value_element_updated* `( n_idx_updated `) `]
    -- Lvalue_write:
        p EC_1 ARCH_1 |- storageReference := headerStackValue_updated : EC_2

}





rulegroup Call_eval/builtinPopFrontMethodCallee {

  rule Call_eval/abort:
    p EC_0 ARCH_0
        |- builtinPopFrontMethodCallee '@' `< eps `> `( argumentIR `)
