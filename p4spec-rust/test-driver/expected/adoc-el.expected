        = $add_callableDef_overload_i(BLOCK, IC_0, callableId, externMethodDef)

  rule ExternMethod_inst/abstract:
    IC_0
        |- annotationList ABSTRACT
        (
          typeIR nameIR
          `< typeParameterListIR ',' typeParameterListIR_inferred `>
          `( parameterListIR `)) ';'
            : IC_1
    -- if callableId = $callableId_IR(nameIR, parameterListIR)
    -- if externMethodDef
        = EXTERN_METHOD ABSTRACT nameIR
        `< typeParameterListIR ++ typeParameterListIR_inferred `>
        `( parameterListIR `)
    -- if IC_1
        = $add_callableDef_overload_i(BLOCK, IC_0, callableId, externMethodDef)

}





