def $compat_shift(INT, INT) = true

def $compat_shift(INT, INT `< _ `>) = true

def $compat_shift(INT, BIT `< _ `>) = true

def $compat_shift(INT `< _ `>, INT) = true

def $compat_shift(INT `< _ `>, INT `< _ `>) = true

def $compat_shift(INT `< _ `>, BIT `< _ `>) = true

def $compat_shift(BIT `< _ `>, INT) = true

def $compat_shift(BIT `< _ `>, INT `< _ `>) = true

def $compat_shift(BIT `< _ `>, BIT `< _ `>) = true

