dec $V1Model_setup_verify_callee(evalContext, arch, typedExpressionIR)
  : typedExpressionIR

def $V1Model_setup_verify_callee(EC, ARCH, typedExpressionIR_main)
  = typedExpressionIR_verify
  -- if typeDefIR_verify = $find_typeDef_e(GLOBAL, EC, _BARE "VerifyChecksum")
