      |- parserApplyMethodTypeIR `< eps '#' eps `>
      `( argumentIR* '#' id_default* '#' id_optional* `)
          : VOID `< eps `> `( argumentIR_cast* `)
  -- if PARSER_APPLY `( parameterIR* `) = parserApplyMethodTypeIR
  -- if GIVEN parameterIR_aligned* DEFAULT _ OPTIONAL _
      = $align_parameterListIR(
          parameterIR*,
          argumentIR*,
          id_default*,
          id_optional*)
  -- if $callable_parserApplyMethod(p, TC)
  -- Call_convention_ok:
      p TC NOACTION |- parameterIR_aligned* '@' argumentIR* : argumentIR_cast*





dec $callable_controlApplyMethod(cursor, typingContext) : bool

def $callable_controlApplyMethod(GLOBAL, TC) = false

def $callable_controlApplyMethod(BLOCK, TC) = false

def $callable_controlApplyMethod(LOCAL, TC) = localKind = CONTROL_APPLY_METHOD
  -- if localKind = TC.LOCAL.KIND

rule Call_ok/controlApplyMethodTypeIR:
  p TC
      |- controlApplyMethodTypeIR `< eps '#' eps `>
      `( argumentIR* '#' id_default* '#' id_optional* `)
          : VOID `< eps `> `( argumentIR_cast* `)
  -- if CONTROL_APPLY `( parameterIR* `) = controlApplyMethodTypeIR
