matchKey
    : typeIR : nameIR
    ;

matchAction
    : prefixedNameIR ( parameterIR* @ argumentListIR )
    ;

matchPriority = {
  DELTA nat,
  LARGEST_WINS bool
}

matchEntries = {
  SIZE nat,
  CONST bool
}

matchMode
    : NONE | LPM nat | PRI
    ;

tableContext = {
  KEYS matchKey*,
  ACTIONS matchAction*,
  PRIORITIES matchPriority,
  ENTRIES matchEntries,
  MODE matchMode
}

var TBLC : tableContext





tableEntryState
    : LPM nat | NON_LPM
    ;

var TBLS : tableEntryState





dec $empty_tableContext : tableContext

def $empty_tableContext()
  = {
    KEYS eps,
    ACTIONS eps,
    PRIORITIES matchPriority,
    ENTRIES matchEntries,
    MODE NONE
  }
  -- if matchPriority = {DELTA 1, LARGEST_WINS true}
  -- if matchEntries = {SIZE 0, CONST true}





dec $add_key_tbl(tableContext, id, typeIR) : tableContext

def $add_key_tbl(TBLC, id, typeIR) = TBLC[KEYS = TBLC.KEYS ++ [matchKey]]
  -- if matchKey = typeIR ':' id





dec $add_action_tbl(tableContext, prefixedNameIR, parameterIR*, argumentListIR)
  : tableContext

def $add_action_tbl(TBLC, prefixedNameIR, parameterIR*, argumentListIR)
  = TBLC[ACTIONS = TBLC.ACTIONS ++ [matchAction]]
  -- if matchAction = prefixedNameIR `( parameterIR* '@' argumentListIR `)





dec $is_lpm_key(tableKeyIR) : bool

dec $is_lpm_key'(nameIR) : bool

def $is_lpm_key(_ '#' _ ':' nameIR _ ';') = $is_lpm_key'(nameIR)

def $is_lpm_key'("lpm") = true

def $is_lpm_key'(nameIR) = false
  -- otherwise





dec $requires_priority(tableKeyIR) : bool

dec $requires_priority'(nameIR) : bool

def $requires_priority(_ '#' _ ':' nameIR _ ';') = $requires_priority'(nameIR)

def $requires_priority'("range") = true

def $requires_priority'("ternary") = true

def $requires_priority'("optional") = true

def $requires_priority'(nameIR) = false
  -- otherwise





dec $update_mode_tbl(tableContext, tableKeyIR*) : tableContext

def $update_mode_tbl(TBLC, tableKeyIR*) = TBLC[MODE = PRI]
  -- (if b_pri = $requires_priority(tableKeyIR))*
  -- if $exists_(b_pri*)

def $update_mode_tbl(TBLC, tableKeyIR*) = TBLC[MODE = LPM n]
  -- (if b_pri = $requires_priority(tableKeyIR))*
  -- if ~$exists_(b_pri*)
  -- (if b_lpm = $is_lpm_key(tableKeyIR))*
  -- if tableKeyIR_lpm = $filter_<tableKeyIR>(tableKeyIR*, b_lpm*)
  -- if typedExpressionIR '#' _ ':' "lpm" _ ';' = tableKeyIR_lpm
  -- if typeIR = $type_of_typedExpressionIR(typedExpressionIR)
  -- if integerTypeIR = $unroll_aliasType(typeIR)
  -- if n = $width_of_integerTypeIR(integerTypeIR)

def $update_mode_tbl(TBLC, tableKeyIR*) = TBLC[MODE = NONE]
  -- (if b_pri = $requires_priority(tableKeyIR))*
  -- if ~$exists_(b_pri*)
  -- (if b_lpm = $is_lpm_key(tableKeyIR))*
  -- if ~$exists_(b_lpm*)





dec $find_action(tableContext, prefixedNameIR) : (parameterIR*, argumentListIR)?

dec $find_action'(matchAction*, prefixedNameIR)
  : (parameterIR*, argumentListIR)?

def $find_action(TBLC, prefixedNameIR)
  = $find_action'(TBLC.ACTIONS, prefixedNameIR)

def $find_action'(eps, prefixedNameIR) = eps

def $find_action'(matchAction_h :: matchAction_t*, prefixedNameIR)
  = (parameterIR*, argumentListIR)
  -- if prefixedNameIR `( parameterIR* '@' argumentListIR `) = matchAction_h

def $find_action'(matchAction_h :: matchAction_t*, prefixedNameIR)
  = $find_action'(matchAction_t*, prefixedNameIR)
  -- if prefixedNameIR_h `( _ '@' _ `) = matchAction_h
  -- if prefixedNameIR_h =/= prefixedNameIR





dec $set_priorities_of_tableEntryListIR(
    tableContext,
    tableEntryState*,
    tableEntryListIR)
  : tableEntryListIR

dec $set_priorities_of_tableEntryListIR'(tableContext, nat, tableEntryIR*)
  : tableEntryIR*

dec $set_priority_of_tableEntryIR(tableEntryIR, nat) : tableEntryIR

def $set_priorities_of_tableEntryListIR(TBLC, TBLS*, tableEntryIR*)
  = tableEntryIR*
  -- if TBLC.MODE = NONE
  -- (if eps = $tableEntryPriorityOptIR_of_tableEntryIR(tableEntryIR))*

def $set_priorities_of_tableEntryListIR(TBLC, TBLS*, tableEntryIR*)
  = tableEntryIR_updated*
  -- if TBLC.MODE = LPM n
  -- (if LPM n_prefix = TBLS)*
  -- (if eps = $tableEntryPriorityOptIR_of_tableEntryIR(tableEntryIR))*
  -- (if tableEntryIR_updated
      = $set_priority_of_tableEntryIR(tableEntryIR, n_prefix))*

def $set_priorities_of_tableEntryListIR(TBLC, TBLS*, eps) = eps
  -- if TBLC.MODE = PRI

def $set_priorities_of_tableEntryListIR(
    TBLC,
    TBLS*,
    tableEntryIR_h :: tableEntryIR_t*)
  = tableEntryIR_h_updated :: tableEntryIR_t_updated*
  -- if TBLC.MODE = PRI
  -- if eps = $tableEntryPriorityOptIR_of_tableEntryIR(tableEntryIR_h)
  -- (if eps = $tableEntryPriorityOptIR_of_tableEntryIR(tableEntryIR_t))*
  -- if b_lw = TBLC.PRIORITIES.LARGEST_WINS
  -- if n_size = TBLC.ENTRIES.SIZE
  -- if n_delta = TBLC.PRIORITIES.DELTA
  -- if n = $ite<int>(b_lw, $((n_size - 1) * n_delta + 1), 1)
  -- if tableEntryIR_h_updated
      = $set_priority_of_tableEntryIR(tableEntryIR_h, n)
  -- if tableEntryIR_t_updated*
      = $set_priorities_of_tableEntryListIR'(TBLC, n, tableEntryIR_t*)

def $set_priorities_of_tableEntryListIR(
    TBLC,
    TBLS*,
    tableEntryIR_h :: tableEntryIR_t*)
  = tableEntryIR_h_updated :: tableEntryIR_t_updated*
  -- if TBLC.MODE = PRI
  -- if ~TBLC.ENTRIES.CONST
  -- if PRIORITY '=' integerLiteral ':'
      = $tableEntryPriorityOptIR_of_tableEntryIR(tableEntryIR_h)
  -- if n = $nat_of_integerValue(integerLiteral)
  -- if tableEntryIR_h_updated
      = $set_priority_of_tableEntryIR(tableEntryIR_h, n)
  -- if tableEntryIR_t_updated*
      = $set_priorities_of_tableEntryListIR'(TBLC, n, tableEntryIR_t*)

def $set_priorities_of_tableEntryListIR'(TBLC, n_last, eps) = eps

def $set_priorities_of_tableEntryListIR'(
    TBLC,
    n_last,
    tableEntryIR_h :: tableEntryIR_t*)
  = tableEntryIR_h_updated :: tableEntryIR_t_updated*
  -- if eps = $tableEntryPriorityOptIR_of_tableEntryIR(tableEntryIR_h)
  -- if b_lw = TBLC.PRIORITIES.LARGEST_WINS
  -- if n_delta = TBLC.PRIORITIES.DELTA
  -- if n = $ite<int>(b_lw, $(n_last - n_delta), $(n_last + n_delta))
  -- if tableEntryIR_h_updated
      = $set_priority_of_tableEntryIR(tableEntryIR_h, n)
  -- if tableEntryIR_t_updated*
      = $set_priorities_of_tableEntryListIR'(TBLC, n, tableEntryIR_t*)

def $set_priorities_of_tableEntryListIR'(
    TBLC,
    n_last,
    tableEntryIR_h :: tableEntryIR_t*)
  = tableEntryIR_h_updated :: tableEntryIR_t_updated*
  -- if PRIORITY '=' integerLiteral ':'
      = $tableEntryPriorityOptIR_of_tableEntryIR(tableEntryIR_h)
  -- if n = $nat_of_integerValue(integerLiteral)
  -- if tableEntryIR_h_updated
      = $set_priority_of_tableEntryIR(tableEntryIR_h, n)
  -- if tableEntryIR_t_updated*
      = $set_priorities_of_tableEntryListIR'(TBLC, n, tableEntryIR_t*)

def $set_priority_of_tableEntryIR(tableEntryIR, n) = tableEntryIR_updated
  -- if constOptIR _ keysetExpressionIR ':' tableActionReferenceIR
  annotationList ';'
      = tableEntryIR
  -- if tableEntryPriorityIR = PRIORITY '=' (D n) ':'
  -- if tableEntryIR_updated
      = constOptIR tableEntryPriorityIR keysetExpressionIR ':'
      tableActionReferenceIR annotationList ';'





dec $join_tableEntryState(tableEntryState, tableEntryState) : tableEntryState

def $join_tableEntryState(NON_LPM, LPM n) = LPM n

def $join_tableEntryState(LPM n, NON_LPM) = LPM n

def $join_tableEntryState(NON_LPM, NON_LPM) = NON_LPM

dec $tableEntry_lpm_prefix(value) : nat

dec $tableEntry_lpm_prefix'(value, nat) : nat

def $tableEntry_lpm_prefix(value) = $tableEntry_lpm_prefix'(value, 0)

def $tableEntry_lpm_prefix'(0 W _, n_prefix) = n_prefix

def $tableEntry_lpm_prefix'(w W n, n_prefix)
  = $tableEntry_lpm_prefix'(value', $(n_prefix + 1))
  -- if $(w > 0)
  -- if w' = $(w - 1)
  -- if $(n \ 2 =/= 0)
  -- if n' = $((n - 1) / 2)
  -- if value' = w' W n'

def $tableEntry_lpm_prefix'(w W n, 0) = $tableEntry_lpm_prefix'(value', 0)
  -- if $(w > 0)
  -- if w' = $(w - 1)
  -- if $(n \ 2 = 0)
  -- if value' = w' W $(n / 2)

relation Type_wf:
  bound |- typeIR

relation TypeDef_wf:
  bound |- typeDefIR

relation ParameterType_wf:
  bound |- parameterIR

relation ReturnType_wf:
  bound |- typeIR

relation CallableType_wf:
  bound |- callableTypeIR

relation CallableTypeDef_wf:
  bound |- callableTypeDefIR

relation ConstructorParameterType_wf:
  bound |- parameterIR

relation ConstructorType_wf:
  bound |- constructorTypeIR

relation ConstructorTypeDef_wf:
  bound |- constructorTypeDefIR





rule Type_wf/baseTypeIR:
  B |- baseTypeIR





rule Type_wf/nameTypeIR:
  B |- _NAME typeId
  -- if $in_set<typeId>(typeId, B)





tbl dec $nestable_typedef(typeIR) : bool

tbl def $nestable_typedef =
  | BOOL => true
  | ERROR => true
  | STRING => true
  | integerTypeIR => true
  | nameTypeIR => true
  | TYPEDEF _ typeIR => $nestable_typedef(typeIR)
  | newTypeIR => true
  | dataTypeIR => true
  | externObjectTypeIR => true
  | parserObjectTypeIR => true
  | controlObjectTypeIR => true
  | packageObjectTypeIR => true
  | _ => false

rule Type_wf/typedefTypeIR:
  B |- TYPEDEF _ typeIR
  -- if $nestable_typedef(typeIR)
  -- Type_wf: B |- typeIR

tbl dec $nestable_new(typeIR) : bool

tbl def $nestable_new =
  | BOOL => true
  | BIT `< _ `> => true
  | INT `< _ `> => true
  | nameTypeIR => true
  | TYPEDEF _ typeIR => $nestable_new(typeIR)
  | newTypeIR => true
  | _ => false

rule Type_wf/newTypeIR:
  B |- TYPE _ typeIR
  -- if $nestable_new(typeIR)
  -- Type_wf: B |- typeIR





tbl dec $nestable_list(typeIR) : bool

tbl def $nestable_list =
  | BOOL => true
  | ERROR => true
  | MATCH_KIND => true
  | STRING => true
  | integerTypeIR => true
  | nameTypeIR => true
  | TYPEDEF _ typeIR => $nestable_list(typeIR)
  | newTypeIR => true
  | listTypeIR => true
  | tupleTypeIR => true
  | headerStackTypeIR => true
  | structTypeIR => true
  | headerTypeIR => true
  | headerUnionTypeIR => true
  | enumTypeIR => true
  | _ => false

rule Type_wf/listTypeIR:
  B |- LIST `< typeIR `>
  -- if $nestable_list(typeIR)
  -- Type_wf: B |- typeIR

tbl dec $nestable_tuple(typeIR) : bool

tbl dec $nestable_array_in_tuple(typeIR) : bool

tbl def $nestable_tuple =
  | BOOL => true
  | ERROR => true
  | BIT `< _ `> => true
  | INT `< _ `> => true
  | VARBIT `< _ `> => true
  | nameTypeIR => true
  | TYPEDEF _ typeIR => $nestable_tuple(typeIR)
  | newTypeIR => true
  | tupleTypeIR => true
  | ARRAY typeIR `[ _ `] => $nestable_array_in_tuple(typeIR)
  | headerStackTypeIR => true
  | structTypeIR => true
  | headerTypeIR => true
  | headerUnionTypeIR => true
  | enumTypeIR => true
  | _ => false

tbl def $nestable_array_in_tuple =
  | BOOL => true
  | INT `< _ `> => true
  | BIT `< _ `> => true
  | VARBIT `< _ `> => true
  | nameTypeIR => true
  | TYPEDEF _ typeIR => $nestable_array_in_tuple(typeIR)
  | newTypeIR => true
  | ARRAY typeIR `[ _ `] => $nestable_array_in_tuple(typeIR)
  | structTypeIR => true
  | enumTypeIR => true
  | _ => false

rule Type_wf/tupleTypeIR:
  B |- TUPLE `< typeIR* `>
  -- (if $nestable_tuple(typeIR))*
  -- (Type_wf: B |- typeIR)*

tbl dec $nestable_array(typeIR) : bool

tbl def $nestable_array =
  | BOOL => true
  | INT `< _ `> => true
  | BIT `< _ `> => true
  | VARBIT `< _ `> => true
  | nameTypeIR => true
  | TYPEDEF _ typeIR => $nestable_array(typeIR)
  | newTypeIR => true
  | arrayTypeIR => true
  | structTypeIR => true
  | enumTypeIR => true
  | externObjectTypeIR => true
  | _ => false

rule Type_wf/arrayTypeIR:
  B |- ARRAY typeIR `[ _ `]
  -- if $nestable_array(typeIR)
  -- Type_wf: B |- typeIR

tbl dec $nestable_headerStack(typeIR) : bool

tbl def $nestable_headerStack =
  | nameTypeIR => true
  | TYPEDEF _ typeIR => $nestable_headerStack(typeIR)
  | headerTypeIR => true
  | headerUnionTypeIR => true
  | _ => false

rule Type_wf/headerStackTypeIR:
  B |- HEADER_STACK typeIR `[ _ `]
  -- if $nestable_headerStack(typeIR)
  -- Type_wf: B |- typeIR

dec $nestable_struct(typeIR) : bool

def $nestable_struct(typeIR) = $nestable_tuple(typeIR)

rule Type_wf/structTypeIR:
  B |- STRUCT _ `< _ `> `{ (_ typeIR_field nameIR_field ';')* `}
  -- if $distinct_<nameIR>(nameIR_field*)
  -- (if $nestable_struct(typeIR_field))*
  -- (Type_wf: B |- typeIR_field)*

tbl dec $nestable_header(typeIR) : bool

tbl dec $nestable_struct_in_header(typeIR) : bool

tbl dec $nestable_array_in_header(typeIR) : bool

tbl def $nestable_header =
  | BOOL => true
  | INT `< _ `> => true
  | BIT `< _ `> => true
  | VARBIT `< _ `> => true
  | nameTypeIR => true
  | TYPEDEF _ typeIR => $nestable_header(typeIR)
  | newTypeIR => true
  | ENUM _ `< _ `> `{ _ `} => true
  | STRUCT _ `< _ `> `{ (_ typeIR_field _ ';')* `}
      => $forall_($nestable_struct_in_header(typeIR_field)*)
  | ARRAY typeIR `[ _ `] => $nestable_array_in_header(typeIR)
  | _ => false

tbl def $nestable_struct_in_header =
  | BOOL => true
  | INT `< _ `> => true
  | BIT `< _ `> => true
  | nameTypeIR => true
  | TYPEDEF _ typeIR => $nestable_struct_in_header(typeIR)
  | newTypeIR => true
  | ENUM _ `< _ `> `{ _ `} => true
  | STRUCT _ `< _ `> `{ (_ typeIR_field _ ';')* `}
      => $forall_($nestable_struct_in_header(typeIR_field)*)
  | _ => false

tbl def $nestable_array_in_header =
  | BOOL => true
  | INT `< _ `> => true
  | BIT `< _ `> => true
  | VARBIT `< _ `> => true
  | nameTypeIR => true
  | TYPEDEF _ typeIR => $nestable_array_in_header(typeIR)
  | newTypeIR => true
  | ARRAY typeIR `[ _ `] => $nestable_array_in_header(typeIR)
  | structTypeIR => true
  | enumTypeIR => true
  | _ => false

rule Type_wf/headerTypeIR:
  B |- HEADER _ `< _ `> `{ (_ typeIR_field nameIR_field ';')* `}
  -- if $distinct_<nameIR>(nameIR_field*)
  -- (if $nestable_header(typeIR_field))*
  -- (Type_wf: B |- typeIR_field)*

tbl dec $nestable_headerUnion(typeIR) : bool

tbl def $nestable_headerUnion =
  | nameTypeIR => true
  | TYPEDEF _ typeIR => $nestable_headerUnion(typeIR)
  | headerTypeIR => true
  | _ => false

rule Type_wf/headerUnionTypeIR:
  B |- HEADER_UNION _ `< _ `> `{ (_ typeIR_field nameIR_field ';')* `}
  -- if $distinct_<nameIR>(nameIR_field*)
  -- (if $nestable_headerUnion(typeIR_field))*
  -- (Type_wf: B |- typeIR_field)*

tbl dec $nestable_enum_serializable(typeIR) : bool

tbl dec $nestable_new_in_enum_serializable(typeIR) : bool

tbl def $nestable_enum_serializable =
  | INT `< _ `> => true
  | BIT `< _ `> => true
  | nameTypeIR => true
  | TYPEDEF _ typeIR => $nestable_enum_serializable(typeIR)
  | TYPE _ typeIR => $nestable_new_in_enum_serializable(typeIR)
  | _ => false

tbl def $nestable_new_in_enum_serializable =
  | INT `< _ `> => true
  | BIT `< _ `> => true
  | nameTypeIR => true
  | TYPEDEF _ typeIR => $nestable_new_in_enum_serializable(typeIR)
  | newTypeIR => true
  | _ => false

rulegroup Type_wf/enumTypeIR {

  rule Type_wf/non-serializable:
    B |- ENUM _ `{ nameIR_field* `}
    -- if $distinct_<nameIR>(nameIR_field*)

  rule Type_wf/serializable:
    B |- ENUM _ `< typeIR `> `{ (nameIR_field '=' _ ';')* `}
    -- if $distinct_<nameIR>(nameIR_field*)
    -- if $nestable_enum_serializable(typeIR)
    -- Type_wf: B |- typeIR

}





rule Type_wf/externObjectTypeIR:
  B |- EXTERN _ `< _ `> (`{ (_ ':' externMethodTypeDefIR)* `})
  -- (CallableTypeDef_wf: B |- externMethodTypeDefIR)*

rule Type_wf/parserObjectTypeIR:
  B |- PARSER _ `< _ `> `( parameterIR* `)
  -- (ParameterType_wf: B |- parameterIR)*

rule Type_wf/controlObjectTypeIR:
  B |- CONTROL _ `< _ `> `( parameterIR* `)
  -- (ParameterType_wf: B |- parameterIR)*

rule Type_wf/packageObjectTypeIR:
  B |- PACKAGE _ `< _ `> `{ typeIR* `}
  -- (Type_wf: B |- typeIR)*

rule Type_wf/tableObjectTypeIR:
  B |- TABLE _ `{ tableMetadataStructTypeIR `}
  -- Type_wf: B |- tableMetadataStructTypeIR





rule Type_wf/defaultTypeIR:
  B |- DEFAULT

rule Type_wf/invalidHeaderTypeIR:
  B |- HEADER_INVALID

rulegroup Type_wf/sequenceTypeIR {

  rule Type_wf/non-default:
    B |- SEQ `< typeIR* `>
    -- (Type_wf: B |- typeIR)*

  rule Type_wf/default:
    B |- SEQ `< typeIR* ',' '...' `>
    -- (Type_wf: B |- typeIR)*

}

rulegroup Type_wf/recordTypeIR {

  rule Type_wf/non-default:
    B |- RECORD `{ (_ typeIR_field nameIR_field ';')* `}
    -- if $distinct_<nameIR>(nameIR_field*)
    -- (Type_wf: B |- typeIR_field)*

  rule Type_wf/default:
    B |- RECORD `{ (_ typeIR_field nameIR_field ';')* ',' '...' `}
    -- if $distinct_<nameIR>(nameIR_field*)
    -- (Type_wf: B |- typeIR_field)*

}

