    -- if EC_callee_2 = EC_callee_1[BLOCK.FRAME = frame]
    -- if EC_callee_3
        = EC_callee_2[LOCAL.TYPE = `{ (typeParameterIR ':' typeArgumentIR)* `}]
    -- if GIVEN parameterIR_aligned* DEFAULT parameterIR_default* OPTIONAL _
        = $align_parameterListIR(
            parameterIR*,
            argumentIR*,
            id_default*,
            id_optional*)
    -- if p_shared = GLOBAL
    -- Copy_in:
        p_shared ARCH_0
            |- p EC_0 parameterIR_aligned* '@' LOCAL EC_callee_3 argumentIR*
                ~> ARCH_1 EC_1 EC_callee_4 '#' (_CONT storageReference?*)
    -- Copy_in_default:
        parameterIR_default* '@' LOCAL EC_callee_4 ~> EC_callee_5
    -- DefinedFunctionBody_eval:
        EC_callee_5 ARCH_1
            |- blockStatementIR : EC_callee_6 ARCH_2 definedFunctionResult
    -- Copy_out:
        p_shared ARCH_2
            |- p EC_1 parameterIR_aligned* '@' LOCAL EC_callee_6
            storageReference?*
                ~> EC_2

  rule Call_eval/copyin-abort:
    p EC_0 ARCH_0
        |- externMethodCallee '@' `< typeArgumentIR* `> `( argumentIR* `)
            : EC_1 ARCH_1 abortResult
    -- if EXTERN_METHOD objectId '.' nameIR `< typeParameterIR* `>
    `( parameterIR* '#' id_default* '#' id_optional* `)
    `{ theta ';' frame ';' eps `}
        = externMethodCallee
    -- if EC_callee_0 = $inherit_e(GLOBAL, EC_0)
    -- if EC_callee_1 = EC_callee_0[BLOCK.TYPE = theta]
    -- if EC_callee_2 = EC_callee_1[BLOCK.FRAME = frame]
    -- if EC_callee_3
        = EC_callee_2[LOCAL.TYPE = `{ (typeParameterIR ':' typeArgumentIR)* `}]
    -- if GIVEN parameterIR_aligned* DEFAULT parameterIR_default* OPTIONAL _
        = $align_parameterListIR(
            parameterIR*,
            argumentIR*,
            id_default*,
            id_optional*)
    -- if p_shared = GLOBAL
    -- Copy_in:
        p_shared ARCH_0
            |- p EC_0 parameterIR_aligned* '@' LOCAL EC_callee_3 argumentIR*
                ~> ARCH_1 EC_1 EC_callee_4 '#' abortResult

  rule Call_eval/copyin-cont-non-abstract-reject:
    p EC_0 ARCH_0
        |- externMethodCallee '@' `< typeArgumentIR* `> `( argumentIR* `)
            : EC_1 ARCH_2 rejectTransitionResult
    -- if EXTERN_METHOD objectId '.' nameIR `< typeParameterIR* `>
    `( parameterIR* '#' id_default* '#' id_optional* `)
    `{ theta ';' frame ';' eps `}
        = externMethodCallee
    -- if EC_callee_0 = $inherit_e(GLOBAL, EC_0)
    -- if EC_callee_1 = EC_callee_0[BLOCK.TYPE = theta]
    -- if EC_callee_2 = EC_callee_1[BLOCK.FRAME = frame]
    -- if EC_callee_3
        = EC_callee_2[LOCAL.TYPE = `{ (typeParameterIR ':' typeArgumentIR)* `}]
    -- if GIVEN parameterIR_aligned* DEFAULT parameterIR_default* OPTIONAL _
        = $align_parameterListIR(
            parameterIR*,
            argumentIR*,
            id_default*,
            id_optional*)
    -- if p_shared = GLOBAL
    -- Copy_in:
        p_shared ARCH_0
            |- p EC_0 parameterIR_aligned* '@' LOCAL EC_callee_3 argumentIR*
                ~> ARCH_1 EC_1 EC_callee_4 '#' (_CONT storageReference?*)
    -- Copy_in_default:
        parameterIR_default* '@' LOCAL EC_callee_4 ~> EC_callee_5
    -- (if (_ _ _ nameIR_param _ = parameterIR))*
    -- ExternMethodCall_eval:
        EC_callee_5 ARCH_1
            |- objectId '.' nameIR `( nameIR_param* `)
                : EC_callee_6 ARCH_2 rejectTransitionResult

  rule Call_eval/copyin-cont-non-abstract-non-reject:
    p EC_0 ARCH_0
        |- externMethodCallee '@' `< typeArgumentIR* `> `( argumentIR* `)
