relation TableProperties_ok:
  typingContext tableContext
      |- tableProperty* : tableContext tablePropertyListIR

relation Table_ok:
  typingContext |- tableProperty* : tableContext tablePropertyListIR

relation TableType_ok:
  typingContext tableContext |- name : typingContext typeIR

relation ControlLocalDecl_ok:
  typingContext
      |- controlLocalDeclaration : typingContext controlLocalDeclarationIR

relation ControlLocalDeclList_ok:
  typingContext
      |- controlLocalDeclarationList : typingContext controlLocalDeclarationIR*





relation VarDecl_ok:
  cursor typingContext
      |- variableDeclaration : typingContext variableDeclarationIR

relation ConstDecl_ok:
  cursor typingContext
      |- constantDeclaration : typingContext constantDeclarationIR

relation InstDecl_ok:
  cursor typingContext |- instantiation : typingContext instantiationIR

relation FuncDecl_ok:
  cursor typingContext
      |- functionDeclaration : typingContext functionDeclarationIR

relation ActionDecl_ok:
  cursor typingContext |- actionDeclaration : typingContext actionDeclarationIR

relation Decl_ok:
  typingContext |- declaration : typingContext declarationIR

relation Decls_ok:
  typingContext |- declaration* : typingContext declarationIR*

relation Program_ok:
   |- p4program : p4programIR





actctxt
    : ACTION | NOACTION
    ;

relation Call_convention_expr_ok:
  cursor typingContext actctxt
      |- parameterIR '@' typedExpressionIR : typedExpressionIR

relation Call_convention_arg_ok:
  cursor typingContext actctxt |- parameterIR '@' argumentIR : argumentIR

relation Call_convention_ok:
  cursor typingContext actctxt
      |- parameterIR* '@' argumentListIR : argumentListIR





dec $is_static_callableTypeIR(callableTypeIR) : ctk

def $is_static_callableTypeIR(EXTERN_FUNCTION "static_assert" `( _ `) ':' _)
  = LCTK

def $is_static_callableTypeIR(builtinSizeMethodTypeIR) = LCTK

def $is_static_callableTypeIR(_) = DYN
  -- otherwise

dec $is_static_assert_callableTypeIR(callableTypeIR) : bool

def $is_static_assert_callableTypeIR(
    EXTERN_FUNCTION "static_assert" `( _ `) ':' _)
  = true

def $is_static_assert_callableTypeIR(_) = false
  -- otherwise

relation CallableTarget_ok:
  cursor typingContext |- callableTarget : callableTargetIR

relation CallableTarget_lvalue_ok:
  cursor typingContext |- lvalue : callableTargetIR

relation CallableType_ok:
  cursor typingContext
      |- callableTargetIR `< typeArgumentListIR `> `( argumentIR* `)
          : callableTypeIR `< '#' typeId* `> `( '#' id* '#' id* `)





relation Call_ok:
  cursor typingContext
      |- callableTypeIR `< typeArgumentListIR '#' typeId* `>
      `( argumentListIR '#' id* '#' id* `)
          : typeIR `< typeArgumentListIR `> `( argumentListIR `)





relation ConstructorType_ok:
  cursor typingContext
      |- constructorTargetIR `( argumentIR* `)
          : constructorTypeIR `< '#' typeId* `> `( '#' id* '#' id* `)





instctxt
    : NAMED | ANON
    ;

relation Inst_ok:
  cursor typingContext instctxt
      |- constructorTypeIR `< typeArgumentListIR '#' typeId* `>
      `( argumentListIR '#' id* '#' id* `)
          : typeIR `< typeArgumentListIR `> `( argumentListIR `)









rule Type_ok/void:
  p TC |- VOID : VOID '#' eps





rule Type_ok/boolean:
  p TC |- BOOL : BOOL '#' eps





rule Type_ok/error:
  p TC |- ERROR : ERROR '#' eps





rule Type_ok/matchKind:
  p TC |- MATCH_KIND : MATCH_KIND '#' eps





rule Type_ok/string:
  p TC |- STRING : STRING '#' eps





rule Type_ok/arbitraryInt:
  p TC |- INT : INT '#' eps





rulegroup Type_ok/fixedInt {

  rule Type_ok/integer:
    p TC |- INT `< n `> : (INT `< n `>) '#' eps
    -- if $(n > 0)

  rule Type_ok/expression:
    p TC |- INT `< `( expression `) `> : (INT `< n `>) '#' eps
    -- Expr_ok: p TC |- expression : typedExpressionIR
    -- if LCTK = $ctk_of_typedExpressionIR(typedExpressionIR)
    -- Expr_eval_lctk: p TC |- typedExpressionIR ~> integerValue
    -- if n = $nat_of_integerValue(integerValue)
    -- if $(n > 0)

}





rulegroup Type_ok/fixedBit {

  rule Type_ok/none:
    p TC |- BIT : (BIT `< 1 `>) '#' eps

  rule Type_ok/integer:
    p TC |- BIT `< n `> : (BIT `< n `>) '#' eps

  rule Type_ok/expression:
    p TC |- BIT `< `( expression `) `> : (BIT `< n `>) '#' eps
    -- Expr_ok: p TC |- expression : typedExpressionIR
    -- if LCTK = $ctk_of_typedExpressionIR(typedExpressionIR)
    -- Expr_eval_lctk: p TC |- typedExpressionIR ~> integerValue
    -- if n = $nat_of_integerValue(integerValue)

}





rulegroup Type_ok/variableBit {

  rule Type_ok/integer:
    p TC |- VARBIT `< n `> : (VARBIT `< n `>) '#' eps

  rule Type_ok/expression:
    p TC |- VARBIT `< `( expression `) `> : (VARBIT `< n `>) '#' eps
    -- Expr_ok: p TC |- expression : typedExpressionIR
    -- if LCTK = $ctk_of_typedExpressionIR(typedExpressionIR)
    -- Expr_eval_lctk: p TC |- typedExpressionIR ~> integerValue
    -- if n = $nat_of_integerValue(integerValue)

}





rulegroup Type_ok/prefixedTypeName-identifier {

  rule Type_ok/identifier:
    p TC |- _ID typeId : typeIR '#' typeId_fresh*
    -- Type_ok: p TC |- _TID typeId : typeIR '#' typeId_fresh*

  rule Type_ok/monomorphic:
    p TC |- prefixedTypeName : typeIR '#' eps
    -- if prefixedNameIR = $prefixedTypeName(prefixedTypeName)
    -- if typeDefIR = $find_typeDef_t(p, TC, prefixedNameIR)
    -- if $is_monomorphic_typeDefIR(typeDefIR)
    -- if typeIR = $typeIR_of_typeDefIR(typeDefIR)

  rule Type_ok/polymorphic:
    p TC |- prefixedTypeName : typeIR '#' eps
    -- if prefixedNameIR = $prefixedTypeName(prefixedTypeName)
    -- if typeDefIR = $find_typeDef_t(p, TC, prefixedNameIR)
    -- if ~$is_monomorphic_typeDefIR(typeDefIR)
    -- if typeIR = $specialize_typeDefIR(typeDefIR, eps)

}





rule Type_ok/specializedType:
  p TC |- prefixedTypeName `< typeArgumentList `> : typeIR '#' typeId_fresh*
  -- if prefixedNameIR = $prefixedTypeName(prefixedTypeName)
  -- if typeDefIR = $find_typeDef_t(p, TC, prefixedNameIR)
  -- if $is_polymorphic_typeDefIR(typeDefIR)
  -- TypeArgumentList_ok:
      p TC |- typeArgumentList : typeIR_arg* '#' typeId_fresh*
  -- if typeIR = $specialize_typeDefIR(typeDefIR, typeIR_arg*)





rule Type_ok/headerStackType:
  p TC
      |- type `[ expression_size `]
          : (HEADER_STACK typeIR_base `[ n_size `]) '#' typeId_fresh*
  -- Type_ok: p TC |- type : typeIR_base '#' typeId_fresh*
  -- if typeIR_base' = $unroll_typeIR(typeIR_base)
  -- if typeIR_base' <: headerTypeIR \/ typeIR_base' <: headerUnionTypeIR
  -- Expr_ok: p TC |- expression_size : typedExpressionIR_size
  -- if LCTK = $ctk_of_typedExpressionIR(typedExpressionIR_size)
  -- Expr_eval_lctk: p TC |- typedExpressionIR_size ~> integerValue_size
  -- if n_size = $nat_of_integerValue(integerValue_size)
  -- if $(n_size > 0)

rule Type_ok/arrayType:
  p TC
      |- type `[ expression_size `]
          : (ARRAY typeIR_base `[ n_size `]) '#' typeId_fresh*
  -- Type_ok: p TC |- type : typeIR_base '#' typeId_fresh*
  -- if typeIR_base' = $unroll_typeIR(typeIR_base)
  -- if ~(typeIR_base' <: headerTypeIR \/ typeIR_base' <: headerUnionTypeIR)
  -- Expr_ok: p TC |- expression_size : typedExpressionIR_size
  -- if LCTK = $ctk_of_typedExpressionIR(typedExpressionIR_size)
  -- Expr_eval_lctk: p TC |- typedExpressionIR_size ~> integerValue_size
  -- if n_size = $nat_of_integerValue(integerValue_size)
  -- if $(n_size > 0)





rule Type_ok/listType:
  p TC |- LIST `< typeArgument `> : (LIST `< typeIR_arg `>) '#' typeId_fresh*
  -- TypeArgument_ok: p TC |- typeArgument : typeIR_arg '#' typeId_fresh*





rule Type_ok/tupleType:
  p TC
      |- TUPLE `< typeArgumentList `>
          : (TUPLE `< typeIR_arg* `>) '#' typeId_fresh*
  -- TypeArgumentList_ok:
      p TC |- typeArgumentList : typeIR_arg* '#' typeId_fresh*

dec $chain_casts(typeIR*, (typeIR*)*) : (typeIR*)*

dec $chain_casts'(typeIR, typeIR*) : (typeIR, typeIR*)

def $chain_casts(typeIR_cur*, (typeIR_chain*)*) = eps
  -- if eps = $concat_<typeIR>((typeIR_chain*)*)

def $chain_casts(typeIR_cur*, (typeIR_chain*)*)
  = typeIR_next* :: $chain_casts(typeIR_next*, (typeIR_chain_rest*)*)
  -- if eps =/= $concat_<typeIR>((typeIR_chain*)*)
  -- (if (
    (typeIR_next, typeIR_chain_rest*)
        = $chain_casts'(typeIR_cur, typeIR_chain*)))*

def $chain_casts'(typeIR_cur, eps) = (typeIR_cur, eps)

def $chain_casts'(typeIR_cur, typeIR_h :: typeIR_t*) = (typeIR_h, typeIR_t*)

dec $chain_casts_sequenceTypeIR(typeIR*, typeIR**, typeIR) : typeIR*

def $chain_casts_sequenceTypeIR(typeIR_a*, typeIR_cast_elem**, typeIR_b)
  = typeIR_cast_agg* ++ [typeIR_b]
  -- if typeIR_cast_step** = $chain_casts(typeIR_a*, typeIR_cast_elem**)
  -- (if (typeIR_cast_agg = SEQ `< typeIR_cast_step* `>))*

dec $chain_casts_sequenceTypeIR_default(typeIR*, typeIR**, typeIR) : typeIR*

def $chain_casts_sequenceTypeIR_default(typeIR_a*, typeIR_cast_elem**, typeIR_b)
  = typeIR_cast_agg* ++ [typeIR_b]
  -- if typeIR_cast_step** = $chain_casts(typeIR_a*, typeIR_cast_elem**)
  -- (if (typeIR_cast_agg = SEQ `< typeIR_cast_step* ',' '...' `>))*

dec $chain_casts_recordTypeIR(fieldTypeIR*, typeIR**, typeIR) : typeIR*

def $chain_casts_recordTypeIR(
    (annotationList_a typeIR_a id_a ';')*,
    typeIR_cast_elem**,
    typeIR_b)
  = typeIR_cast_agg* ++ [typeIR_b]
  -- if typeIR_cast_step** = $chain_casts(typeIR_a*, typeIR_cast_elem**)
  -- (if (
    typeIR_cast_agg
        = RECORD `{ (annotationList_a typeIR_cast_step id_a ';')* `}))*

dec $chain_casts_recordTypeIR_default(fieldTypeIR*, typeIR**, typeIR) : typeIR*

def $chain_casts_recordTypeIR_default(
    (annotationList_a typeIR_a id_a ';')*,
    typeIR_cast_elem**,
    typeIR_b)
  = typeIR_cast_agg* ++ [typeIR_b]
  -- if typeIR_cast_step** = $chain_casts(typeIR_a*, typeIR_cast_elem**)
  -- (if (
    typeIR_cast_agg
        = RECORD
        `{ (annotationList_a typeIR_cast_step id_a ';')* ',' '...' `}))*





rulegroup Cast_expl {

  rule Cast_expl/equals:
    typeIR_a -> typeIR_b : OK ([typeIR_b])
    -- if typeIR_a_unroll = $unroll_typeIR(typeIR_a)
    -- if typeIR_b_unroll = $unroll_typeIR(typeIR_b)
    -- Type_alpha: typeIR_a_unroll ~~ typeIR_b_unroll

  rule Cast_expl/not-equals:
    typeIR_a -> typeIR_b : castResult
    -- if typeIR_a_unroll = $unroll_typeIR(typeIR_a)
    -- if typeIR_b_unroll = $unroll_typeIR(typeIR_b)
    -- Type_alpha:/ typeIR_a_unroll ~~ typeIR_b_unroll
    -- Cast_expl_neq: typeIR_a_unroll -> typeIR_b_unroll : castResult

}





rule Cast_expl_neq/boolean-fixBit:
  BOOL -> BIT `< 1 `> : OK ([BIT `< 1 `>])

rulegroup Cast_expl_neq/arbitraryInt {

  rule Cast_expl_neq/boolean:
    INT -> BOOL : OK ([BOOL])

  rule Cast_expl_neq/fixInt:
    INT -> INT `< w `> : OK ([INT `< w `>])

  rule Cast_expl_neq/fixBit:
    INT -> BIT `< w `> : OK ([BIT `< w `>])

}

rulegroup Cast_expl_neq/fixInt {

  rule Cast_expl_neq/arbitraryInt:
    INT `< _ `> -> INT : OK ([INT])

  rule Cast_expl_neq/fixInt:
    INT `< w_a `> -> INT `< w_b `> : OK ([INT `< w_b `>])

  rule Cast_expl_neq/fixBit:
    INT `< w `> -> BIT `< w `> : OK ([BIT `< w `>])

}

rulegroup Cast_expl_neq/fixBit {

  rule Cast_expl_neq/boolean:
    BIT `< 1 `> -> BOOL : OK ([BOOL])

  rule Cast_expl_neq/arbitraryInt:
    BIT `< _ `> -> INT : OK ([INT])

  rule Cast_expl_neq/fixInt:
    BIT `< w `> -> INT `< w `> : OK ([INT `< w `>])

  rule Cast_expl_neq/fixBit:
    BIT `< w_a `> -> BIT `< w_b `> : OK ([BIT `< w_b `>])

}

rulegroup Cast_expl_neq/newTypeIR {

  rule Cast_expl_neq/left:
    TYPE _ typeIR_a -> typeIR_b : OK (typeIR_a :: typeIR_cast*)
    -- Cast_impl: typeIR_a -> typeIR_b : OK typeIR_cast*

  rule Cast_expl_neq/right:
    typeIR_a -> newTypeIR : OK (typeIR_cast* ++ [newTypeIR])
    -- if TYPE _ typeIR_b = newTypeIR
    -- Cast_impl: typeIR_a -> typeIR_b : OK typeIR_cast*

}

rulegroup Cast_expl_neq/enumTypeIR-serializable {

  rule Cast_expl_neq/left:
    ENUM _ `< typeIR_a `> `{ _ `} -> typeIR_b : OK (typeIR_a :: typeIR_cast*)
    -- Cast_impl: typeIR_a -> typeIR_b : OK typeIR_cast*

  rule Cast_expl_neq/right:
    typeIR_a -> serializableEnumTypeIR
        : OK (typeIR_cast* ++ [serializableEnumTypeIR])
    -- if ENUM _ `< typeIR_b `> `{ _ `} = serializableEnumTypeIR
    -- Cast_impl: typeIR_a -> typeIR_b : OK typeIR_cast*

}

rule Cast_expl_neq/defaultTypeIR:
  DEFAULT -> typeIR_b : OK ([typeIR_b])
  -- if $is_defaultable_typeIR(typeIR_b)

rulegroup Cast_expl_neq/invalidHeaderTypeIR {

  rule Cast_expl_neq/headerTypeIR:
    HEADER_INVALID -> headerTypeIR : OK ([headerTypeIR])

  rule Cast_expl_neq/headerUnionTypeIR:
    HEADER_INVALID -> headerUnionTypeIR : OK ([headerUnionTypeIR])

}

rulegroup Cast_expl_neq/sequenceTypeIR-non-default {

  rule Cast_expl_neq/listTypeIR:
    SEQ `< typeIR_a* `> -> listTypeIR : OK typeIR_cast_agg*
    -- if LIST `< typeIR_b `> = listTypeIR
    -- (Cast_expl: typeIR_a -> typeIR_b : OK typeIR_cast*)*
    -- if typeIR_cast_agg*
        = $chain_casts_sequenceTypeIR(typeIR_a*, typeIR_cast**, listTypeIR)

  rule Cast_expl_neq/tupleTypeIR:
    SEQ `< typeIR_a* `> -> tupleTypeIR : OK typeIR_cast_agg*
    -- if TUPLE `< typeIR_b* `> = tupleTypeIR
    -- (Cast_expl: typeIR_a -> typeIR_b : OK typeIR_cast*)*
    -- if typeIR_cast_agg*
        = $chain_casts_sequenceTypeIR(typeIR_a*, typeIR_cast**, tupleTypeIR)

  rule Cast_expl_neq/arrayTypeIR:
    SEQ `< typeIR_a* `> -> arrayTypeIR : OK typeIR_cast_agg*
    -- if ARRAY typeIR_b `[ n_size `] = arrayTypeIR
    -- if $(|typeIR_a*| = n_size)
    -- (Cast_expl: typeIR_a -> typeIR_b : OK typeIR_cast*)*
    -- if typeIR_cast_agg*
        = $chain_casts_sequenceTypeIR(typeIR_a*, typeIR_cast**, arrayTypeIR)

  rule Cast_expl_neq/headerStackTypeIR:
    SEQ `< typeIR_a* `> -> headerStackTypeIR : OK typeIR_cast_agg*
    -- if HEADER_STACK typeIR_b `[ n_size `] = headerStackTypeIR
    -- if $(|typeIR_a*| = n_size)
    -- (Cast_expl: typeIR_a -> typeIR_b : OK typeIR_cast*)*
    -- if typeIR_cast_agg*
        = $chain_casts_sequenceTypeIR(
            typeIR_a*,
            typeIR_cast**,
            headerStackTypeIR)

  rule Cast_expl_neq/structTypeIR:
    SEQ `< typeIR_a* `> -> structTypeIR : OK typeIR_cast_agg*
    -- if STRUCT _ `< _ `> `{ (_ typeIR_field_b _ ';')* `} = structTypeIR
    -- (Cast_expl: typeIR_a -> typeIR_field_b : OK typeIR_cast*)*
    -- if typeIR_cast_agg*
        = $chain_casts_sequenceTypeIR(typeIR_a*, typeIR_cast**, structTypeIR)

  rule Cast_expl_neq/headerTypeIR:
    SEQ `< typeIR_a* `> -> headerTypeIR : OK typeIR_cast_agg*
    -- if HEADER _ `< _ `> `{ (_ typeIR_field_b _ ';')* `} = headerTypeIR
    -- (Cast_expl: typeIR_a -> typeIR_field_b : OK typeIR_cast*)*
    -- if typeIR_cast_agg*
        = $chain_casts_sequenceTypeIR(typeIR_a*, typeIR_cast**, headerTypeIR)

}

rulegroup Cast_expl_neq/sequenceTypeIR-default {

  rule Cast_expl_neq/tupleTypeIR:
    SEQ `< typeIR_a* ',' '...' `> -> tupleTypeIR : OK typeIR_cast_agg*
    -- if TUPLE `< typeIR_b* `> = tupleTypeIR
    -- if $(|typeIR_a*| < |typeIR_b*|)
    -- if (typeIR_b_non_default*, typeIR_b_default*)
        = $partition_<typeIR>(typeIR_b*, |typeIR_a*|)
    -- (Cast_expl: typeIR_a -> typeIR_b_non_default : OK typeIR_cast*)*
    -- (if $is_defaultable_typeIR(typeIR_b_default))*
    -- if typeIR_cast_agg*
        = $chain_casts_sequenceTypeIR_default(
            typeIR_a*,
            typeIR_cast**,
            tupleTypeIR)

  rule Cast_expl_neq/arrayTypeIR:
    SEQ `< typeIR_a* ',' '...' `> -> arrayTypeIR : OK typeIR_cast_agg*
    -- if ARRAY typeIR_b `[ n_size `] = arrayTypeIR
    -- if $(|typeIR_a*| < n_size)
    -- (Cast_expl: typeIR_a -> typeIR_b : OK typeIR_cast*)*
    -- if $is_defaultable_typeIR(typeIR_b)
    -- if typeIR_cast_agg*
        = $chain_casts_sequenceTypeIR_default(
            typeIR_a*,
            typeIR_cast**,
            arrayTypeIR)

  rule Cast_expl_neq/headerStackTypeIR:
    SEQ `< typeIR_a* ',' '...' `> -> headerStackTypeIR : OK typeIR_cast_agg*
    -- if HEADER_STACK typeIR_b `[ n_size `] = headerStackTypeIR
    -- if $(|typeIR_a*| < n_size)
    -- (Cast_expl: typeIR_a -> typeIR_b : OK typeIR_cast*)*
    -- if $is_defaultable_typeIR(typeIR_b)
    -- if typeIR_cast_agg*
        = $chain_casts_sequenceTypeIR_default(
            typeIR_a*,
            typeIR_cast**,
            headerStackTypeIR)

  rule Cast_expl_neq/structTypeIR:
    SEQ `< typeIR_a* ',' '...' `> -> structTypeIR : OK typeIR_cast_agg*
    -- if STRUCT _ `< _ `> `{ (_ typeIR_field_b _ ';')* `} = structTypeIR
    -- if $(|typeIR_a*| < |typeIR_field_b*|)
    -- if (typeIR_field_b_non_default*, typeIR_field_b_default*)
        = $partition_<typeIR>(typeIR_field_b*, |typeIR_a*|)
    -- (Cast_expl: typeIR_a -> typeIR_field_b_non_default : OK typeIR_cast*)*
    -- (if $is_defaultable_typeIR(typeIR_field_b_default))*
    -- if typeIR_cast_agg*
        = $chain_casts_sequenceTypeIR_default(
            typeIR_a*,
            typeIR_cast**,
            structTypeIR)

  rule Cast_expl_neq/headerTypeIR:
    SEQ `< typeIR_a* ',' '...' `> -> headerTypeIR : OK typeIR_cast_agg*
    -- if HEADER _ `< _ `> `{ (_ typeIR_field_b _ ';')* `} = headerTypeIR
    -- if $(|typeIR_a*| < |typeIR_field_b*|)
    -- if (typeIR_field_b_non_default*, typeIR_field_b_default*)
        = $partition_<typeIR>(typeIR_field_b*, |typeIR_a*|)
    -- (Cast_expl: typeIR_a -> typeIR_field_b_non_default : OK typeIR_cast*)*
    -- (if $is_defaultable_typeIR(typeIR_field_b_default))*
    -- if typeIR_cast_agg*
        = $chain_casts_sequenceTypeIR_default(
            typeIR_a*,
            typeIR_cast**,
            headerTypeIR)

}

rulegroup Cast_expl_neq/recordTypeIR-non-default {

  rule Cast_expl_neq/structTypeIR:
    RECORD `{ fieldTypeIR_a* `} -> structTypeIR : OK typeIR_cast_agg*
    -- if (_ typeIR_field_a id_field_a ';')* = fieldTypeIR_a*
    -- if STRUCT _ `< _ `> `{ (_ typeIR_field_b id_field_b ';')* `}
        = structTypeIR
    -- if $eq_set<id>(`{ id_field_a* `}, `{ id_field_b* `})
    -- (if (
      typeIR_field_a_aligned
          = $find_map<id, typeIR>(
              `{ (id_field_a ':' typeIR_field_a)* `},
              id_field_a)))*
    -- (if (
      typeIR_field_b_aligned
          = $find_map<id, typeIR>(
              `{ (id_field_b ':' typeIR_field_b)* `},
              id_field_a)))*
    -- (Cast_expl:
        typeIR_field_a_aligned -> typeIR_field_b_aligned : OK typeIR_cast*)*
    -- if typeIR_cast_agg*
        = $chain_casts_recordTypeIR(fieldTypeIR_a*, typeIR_cast**, structTypeIR)

  rule Cast_expl_neq/headerTypeIR:
    RECORD `{ fieldTypeIR_a* `} -> headerTypeIR : OK typeIR_cast_agg*
    -- if (_ typeIR_field_a id_field_a ';')* = fieldTypeIR_a*
    -- if HEADER _ `< _ `> `{ (_ typeIR_field_b id_field_b ';')* `}
        = headerTypeIR
    -- if $eq_set<id>(`{ id_field_a* `}, `{ id_field_b* `})
    -- (if (
      typeIR_field_a_aligned
          = $find_map<id, typeIR>(
              `{ (id_field_a ':' typeIR_field_a)* `},
              id_field_a)))*
    -- (if (
      typeIR_field_b_aligned
          = $find_map<id, typeIR>(
              `{ (id_field_b ':' typeIR_field_b)* `},
              id_field_a)))*
    -- (Cast_expl:
        typeIR_field_a_aligned -> typeIR_field_b_aligned : OK typeIR_cast*)*
    -- if typeIR_cast_agg*
        = $chain_casts_recordTypeIR(fieldTypeIR_a*, typeIR_cast**, headerTypeIR)

}

rulegroup Cast_expl_neq/recordTypeIR-default {

  rule Cast_expl_neq/structTypeIR:
    RECORD `{ fieldTypeIR_a* ',' '...' `} -> structTypeIR : OK typeIR_cast_agg*
    -- if (_ typeIR_field_a id_field_a ';')* = fieldTypeIR_a*
    -- if STRUCT _ `< _ `> `{ (_ typeIR_field_b id_field_b ';')* `}
        = structTypeIR
    -- if $sub_set<id>(`{ id_field_a* `}, `{ id_field_b* `})
    -- (if (
      typeIR_field_a_aligned
          = $find_map<id, typeIR>(
              `{ (id_field_a ':' typeIR_field_a)* `},
              id_field_a)))*
    -- (if (
      typeIR_field_b_non_default_aligned
          = $find_map<id, typeIR>(
              `{ (id_field_b ':' typeIR_field_b)* `},
              id_field_a)))*
    -- (Cast_expl:
        typeIR_field_a_aligned -> typeIR_field_b_non_default_aligned
            : OK typeIR_cast*)*
    -- if `{ id_default* `}
        = $diff_set<id>(`{ id_field_b* `}, `{ id_field_a* `})
    -- (if (
      typeIR_field_b_default
          = $find_map<id, typeIR>(
              `{ (id_field_b ':' typeIR_field_b)* `},
              id_default)))*
    -- (if $is_defaultable_typeIR(typeIR_field_b_default))*
    -- if typeIR_cast_agg*
        = $chain_casts_recordTypeIR_default(
            fieldTypeIR_a*,
            typeIR_cast**,
            structTypeIR)

  rule Cast_expl_neq/headerTypeIR:
    RECORD `{ fieldTypeIR_a* ',' '...' `} -> headerTypeIR : OK typeIR_cast_agg*
    -- if (_ typeIR_field_a id_field_a ';')* = fieldTypeIR_a*
    -- if HEADER _ `< _ `> `{ (_ typeIR_field_b id_field_b ';')* `}
        = headerTypeIR
    -- if $sub_set<id>(`{ id_field_a* `}, `{ id_field_b* `})
    -- (if (
      typeIR_field_a_aligned
          = $find_map<id, typeIR>(
              `{ (id_field_a ':' typeIR_field_a)* `},
              id_field_a)))*
    -- (if (
      typeIR_field_b_non_default_aligned
          = $find_map<id, typeIR>(
              `{ (id_field_b ':' typeIR_field_b)* `},
              id_field_a)))*
    -- (Cast_expl:
        typeIR_field_a_aligned -> typeIR_field_b_non_default_aligned
            : OK typeIR_cast*)*
    -- if `{ id_default* `}
        = $diff_set<id>(`{ id_field_b* `}, `{ id_field_a* `})
    -- (if (
      typeIR_field_b_default
          = $find_map<id, typeIR>(
              `{ (id_field_b ':' typeIR_field_b)* `},
              id_default)))*
    -- (if $is_defaultable_typeIR(typeIR_field_b_default))*
    -- if typeIR_cast_agg*
        = $chain_casts_recordTypeIR_default(
            fieldTypeIR_a*,
            typeIR_cast**,
            headerTypeIR)

}

rule Cast_expl_neq/fail:
  typeIR_a -> typeIR_b : FAIL
  -- otherwise





rulegroup Cast_impl {

  rule Cast_impl/equals:
    typeIR_a -> typeIR_b : OK eps
    -- if typeIR_a_unroll = $unroll_typeIR(typeIR_a)
    -- if typeIR_b_unroll = $unroll_typeIR(typeIR_b)
    -- Type_alpha: typeIR_a_unroll ~~ typeIR_b_unroll

  rule Cast_impl/not-equals:
    typeIR_a -> typeIR_b : castResult
    -- if typeIR_a_unroll = $unroll_typeIR(typeIR_a)
    -- if typeIR_b_unroll = $unroll_typeIR(typeIR_b)
    -- Type_alpha:/ typeIR_a_unroll ~~ typeIR_b_unroll
    -- Cast_impl_neq: typeIR_a_unroll -> typeIR_b_unroll : castResult

}





rulegroup Cast_impl_neq/arbitraryInt {

  rule Cast_impl_neq/fixInt:
    INT -> INT `< w `> : OK ([INT `< w `>])

  rule Cast_impl_neq/fixBit:
    INT -> BIT `< w `> : OK ([BIT `< w `>])

}

rule Cast_impl_neq/enumTypeIR-serializable:
  ENUM _ `< typeIR_a `> `{ _ `} -> typeIR_b : OK (typeIR_a :: typeIR_cast*)
  -- Cast_impl: typeIR_a -> typeIR_b : OK typeIR_cast*

rule Cast_impl_neq/defaultTypeIR:
  DEFAULT -> typeIR_b : OK ([typeIR_b])
  -- if $is_defaultable_typeIR(typeIR_b)

rulegroup Cast_impl_neq/invalidHeaderTypeIR {

  rule Cast_impl_neq/headerTypeIR:
    HEADER_INVALID -> headerTypeIR : OK ([headerTypeIR])

  rule Cast_impl_neq/headerUnionTypeIR:
    HEADER_INVALID -> headerUnionTypeIR : OK ([headerUnionTypeIR])

}

rulegroup Cast_impl_neq/sequenceTypeIR-non-default {

  rule Cast_impl_neq/listTypeIR:
    SEQ `< typeIR_a* `> -> listTypeIR : OK typeIR_cast_agg*
    -- if LIST `< typeIR_b `> = listTypeIR
    -- (Cast_impl: typeIR_a -> typeIR_b : OK typeIR_cast*)*
    -- if typeIR_cast_agg*
        = $chain_casts_sequenceTypeIR(typeIR_a*, typeIR_cast**, listTypeIR)

  rule Cast_impl_neq/tupleTypeIR:
    SEQ `< typeIR_a* `> -> tupleTypeIR : OK typeIR_cast_agg*
    -- if TUPLE `< typeIR_b* `> = tupleTypeIR
    -- (Cast_impl: typeIR_a -> typeIR_b : OK typeIR_cast*)*
    -- if typeIR_cast_agg*
        = $chain_casts_sequenceTypeIR(typeIR_a*, typeIR_cast**, tupleTypeIR)

  rule Cast_impl_neq/arrayTypeIR:
    SEQ `< typeIR_a* `> -> arrayTypeIR : OK typeIR_cast_agg*
    -- if ARRAY typeIR_b `[ n_size `] = arrayTypeIR
    -- if $(|typeIR_a*| = n_size)
    -- (Cast_impl: typeIR_a -> typeIR_b : OK typeIR_cast*)*
    -- if typeIR_cast_agg*
        = $chain_casts_sequenceTypeIR(typeIR_a*, typeIR_cast**, arrayTypeIR)

  rule Cast_impl_neq/headerStackTypeIR:
    SEQ `< typeIR_a* `> -> headerStackTypeIR : OK typeIR_cast_agg*
    -- if HEADER_STACK typeIR_b `[ n_size `] = headerStackTypeIR
    -- if $(|typeIR_a*| = n_size)
    -- (Cast_impl: typeIR_a -> typeIR_b : OK typeIR_cast*)*
    -- if typeIR_cast_agg*
        = $chain_casts_sequenceTypeIR(
            typeIR_a*,
            typeIR_cast**,
            headerStackTypeIR)

  rule Cast_impl_neq/structTypeIR:
    SEQ `< typeIR_a* `> -> structTypeIR : OK typeIR_cast_agg*
    -- if STRUCT _ `< _ `> `{ (_ typeIR_field_b _ ';')* `} = structTypeIR
    -- (Cast_impl: typeIR_a -> typeIR_field_b : OK typeIR_cast*)*
    -- if typeIR_cast_agg*
        = $chain_casts_sequenceTypeIR(typeIR_a*, typeIR_cast**, structTypeIR)

  rule Cast_impl_neq/headerTypeIR:
    SEQ `< typeIR_a* `> -> headerTypeIR : OK typeIR_cast_agg*
    -- if HEADER _ `< _ `> `{ (_ typeIR_field_b _ ';')* `} = headerTypeIR
    -- (Cast_impl: typeIR_a -> typeIR_field_b : OK typeIR_cast*)*
    -- if typeIR_cast_agg*
        = $chain_casts_sequenceTypeIR(typeIR_a*, typeIR_cast**, headerTypeIR)

  rule Cast_impl_neq/sequenceTypeIR:
    SEQ `< typeIR_a* `> -> sequenceTypeIR_b : OK typeIR_cast_agg*
    -- if sequenceTypeIR_a = SEQ `< typeIR_a* `>
    -- if SEQ `< typeIR_b* `> = sequenceTypeIR_b
    -- (Cast_impl: typeIR_a -> typeIR_b : OK typeIR_cast*)*
    -- if typeIR_cast_agg*
        = $chain_casts_sequenceTypeIR(
            typeIR_a*,
            typeIR_cast**,
            sequenceTypeIR_b)

}

rulegroup Cast_impl_neq/sequenceTypeIR-default {

  rule Cast_impl_neq/tupleTypeIR:
    SEQ `< typeIR_a* ',' '...' `> -> tupleTypeIR : OK typeIR_cast_agg*
    -- if TUPLE `< typeIR_b* `> = tupleTypeIR
    -- if $(|typeIR_a*| < |typeIR_b*|)
    -- if (typeIR_b_non_default*, typeIR_b_default*)
        = $partition_<typeIR>(typeIR_b*, |typeIR_a*|)
    -- (Cast_impl: typeIR_a -> typeIR_b_non_default : OK typeIR_cast*)*
    -- (if $is_defaultable_typeIR(typeIR_b_default))*
    -- if typeIR_cast_agg*
        = $chain_casts_sequenceTypeIR_default(
            typeIR_a*,
            typeIR_cast**,
            tupleTypeIR)

  rule Cast_impl_neq/arrayTypeIR:
    SEQ `< typeIR_a* ',' '...' `> -> arrayTypeIR : OK typeIR_cast_agg*
    -- if ARRAY typeIR_b `[ n_size `] = arrayTypeIR
    -- if $(|typeIR_a*| < n_size)
    -- (Cast_impl: typeIR_a -> typeIR_b : OK typeIR_cast*)*
    -- if $is_defaultable_typeIR(typeIR_b)
    -- if typeIR_cast_agg*
        = $chain_casts_sequenceTypeIR_default(
            typeIR_a*,
            typeIR_cast**,
            arrayTypeIR)

  rule Cast_impl_neq/headerStackTypeIR:
    SEQ `< typeIR_a* ',' '...' `> -> headerStackTypeIR : OK typeIR_cast_agg*
    -- if HEADER_STACK typeIR_b `[ n_size `] = headerStackTypeIR
    -- if $(|typeIR_a*| < n_size)
    -- (Cast_impl: typeIR_a -> typeIR_b : OK typeIR_cast*)*
    -- if $is_defaultable_typeIR(typeIR_b)
    -- if typeIR_cast_agg*
        = $chain_casts_sequenceTypeIR_default(
            typeIR_a*,
            typeIR_cast**,
            headerStackTypeIR)

  rule Cast_impl_neq/structTypeIR:
    SEQ `< typeIR_a* ',' '...' `> -> structTypeIR : OK typeIR_cast_agg*
    -- if STRUCT _ `< _ `> `{ (_ typeIR_field_b _ ';')* `} = structTypeIR
    -- if $(|typeIR_a*| < |typeIR_field_b*|)
    -- if (typeIR_field_b_non_default*, typeIR_field_b_default*)
        = $partition_<typeIR>(typeIR_field_b*, |typeIR_a*|)
    -- (Cast_impl: typeIR_a -> typeIR_field_b_non_default : OK typeIR_cast*)*
    -- (if $is_defaultable_typeIR(typeIR_field_b_default))*
    -- if typeIR_cast_agg*
        = $chain_casts_sequenceTypeIR_default(
            typeIR_a*,
            typeIR_cast**,
            structTypeIR)

  rule Cast_impl_neq/headerTypeIR:
    SEQ `< typeIR_a* ',' '...' `> -> headerTypeIR : OK typeIR_cast_agg*
    -- if HEADER _ `< _ `> `{ (_ typeIR_field_b _ ';')* `} = headerTypeIR
    -- if $(|typeIR_a*| < |typeIR_field_b*|)
    -- if (typeIR_field_b_non_default*, typeIR_field_b_default*)
        = $partition_<typeIR>(typeIR_field_b*, |typeIR_a*|)
    -- (Cast_impl: typeIR_a -> typeIR_field_b_non_default : OK typeIR_cast*)*
    -- (if $is_defaultable_typeIR(typeIR_field_b_default))*
    -- if typeIR_cast_agg*
        = $chain_casts_sequenceTypeIR_default(
            typeIR_a*,
            typeIR_cast**,
            headerTypeIR)

}

rulegroup Cast_impl_neq/recordTypeIR-non-default {

  rule Cast_impl_neq/structTypeIR:
    RECORD `{ fieldTypeIR_a* `} -> structTypeIR : OK typeIR_cast_agg*
    -- if (annotationList_a typeIR_field_a id_field_a ';')* = fieldTypeIR_a*
    -- if STRUCT _ `< _ `> `{ (_ typeIR_field_b id_field_b ';')* `}
        = structTypeIR
    -- if $eq_set<id>(`{ id_field_a* `}, `{ id_field_b* `})
    -- (if (
      typeIR_field_a_aligned
          = $find_map<id, typeIR>(
              `{ (id_field_a ':' typeIR_field_a)* `},
              id_field_a)))*
    -- (if (
      typeIR_field_b_aligned
          = $find_map<id, typeIR>(
              `{ (id_field_b ':' typeIR_field_b)* `},
              id_field_a)))*
    -- (Cast_impl:
        typeIR_field_a_aligned -> typeIR_field_b_aligned : OK typeIR_cast*)*
    -- if typeIR_cast_agg*
        = $chain_casts_recordTypeIR(fieldTypeIR_a*, typeIR_cast**, structTypeIR)

  rule Cast_impl_neq/headerTypeIR:
    RECORD `{ fieldTypeIR_a* `} -> headerTypeIR : OK typeIR_cast_agg*
    -- if (annotationList_a typeIR_field_a id_field_a ';')* = fieldTypeIR_a*
    -- if HEADER _ `< _ `> `{ (_ typeIR_field_b id_field_b ';')* `}
        = headerTypeIR
    -- if $eq_set<id>(`{ id_field_a* `}, `{ id_field_b* `})
    -- (if (
      typeIR_field_a_aligned
          = $find_map<id, typeIR>(
              `{ (id_field_a ':' typeIR_field_a)* `},
              id_field_a)))*
    -- (if (
      typeIR_field_b_aligned
          = $find_map<id, typeIR>(
              `{ (id_field_b ':' typeIR_field_b)* `},
              id_field_a)))*
    -- (Cast_impl:
        typeIR_field_a_aligned -> typeIR_field_b_aligned : OK typeIR_cast*)*
    -- if typeIR_cast_agg*
        = $chain_casts_recordTypeIR(fieldTypeIR_a*, typeIR_cast**, headerTypeIR)

}

rulegroup Cast_impl_neq/recordTypeIR-default {

  rule Cast_impl_neq/structTypeIR:
    RECORD `{ fieldTypeIR_a* ',' '...' `} -> structTypeIR : OK typeIR_cast_agg*
    -- if (annotationList_a typeIR_field_a id_field_a ';')* = fieldTypeIR_a*
    -- if STRUCT _ `< _ `> `{ (_ typeIR_field_b id_field_b ';')* `}
        = structTypeIR
    -- if $sub_set<id>(`{ id_field_a* `}, `{ id_field_b* `})
    -- (if (
      typeIR_field_a_aligned
          = $find_map<id, typeIR>(
              `{ (id_field_a ':' typeIR_field_a)* `},
              id_field_a)))*
    -- (if (
      typeIR_field_b_non_default_aligned
          = $find_map<id, typeIR>(
              `{ (id_field_b ':' typeIR_field_b)* `},
              id_field_a)))*
    -- (Cast_impl:
        typeIR_field_a_aligned -> typeIR_field_b_non_default_aligned
            : OK typeIR_cast*)*
    -- if `{ id_default* `}
        = $diff_set<id>(`{ id_field_b* `}, `{ id_field_a* `})
    -- (if (
      typeIR_field_b_default
          = $find_map<id, typeIR>(
              `{ (id_field_b ':' typeIR_field_b)* `},
              id_default)))*
    -- (if $is_defaultable_typeIR(typeIR_field_b_default))*
    -- if typeIR_cast_agg*
        = $chain_casts_recordTypeIR_default(
            fieldTypeIR_a*,
            typeIR_cast**,
            structTypeIR)

  rule Cast_impl_neq/headerTypeIR:
    RECORD `{ fieldTypeIR_a* ',' '...' `} -> headerTypeIR : OK typeIR_cast_agg*
    -- if (annotationList_a typeIR_field_a id_field_a ';')* = fieldTypeIR_a*
    -- if HEADER _ `< _ `> `{ (_ typeIR_field_b id_field_b ';')* `}
        = headerTypeIR
    -- if $sub_set<id>(`{ id_field_a* `}, `{ id_field_b* `})
    -- (if (
      typeIR_field_a_aligned
          = $find_map<id, typeIR>(
              `{ (id_field_a ':' typeIR_field_a)* `},
              id_field_a)))*
    -- (if (
      typeIR_field_b_non_default_aligned
          = $find_map<id, typeIR>(
              `{ (id_field_b ':' typeIR_field_b)* `},
              id_field_a)))*
    -- (Cast_impl:
        typeIR_field_a_aligned -> typeIR_field_b_non_default_aligned
            : OK typeIR_cast*)*
    -- if `{ id_default* `}
        = $diff_set<id>(`{ id_field_b* `}, `{ id_field_a* `})
    -- (if (
      typeIR_field_b_default
          = $find_map<id, typeIR>(
              `{ (id_field_b ':' typeIR_field_b)* `},
              id_default)))*
    -- (if $is_defaultable_typeIR(typeIR_field_b_default))*
    -- if typeIR_cast_agg*
        = $chain_casts_recordTypeIR_default(
            fieldTypeIR_a*,
            typeIR_cast**,
            headerTypeIR)

}

rule Cast_impl_neq/fail:
  typeIR_a -> typeIR_b : FAIL
  -- otherwise





dec $reduce_serenum(typedExpressionIR) : typedExpressionIR

def $reduce_serenum(typedExpressionIR) = typedExpressionIR_reduced
  -- if typeIR = $type_of_typedExpressionIR(typedExpressionIR)
  -- if ctk = $ctk_of_typedExpressionIR(typedExpressionIR)
  -- if ENUM _ `< typeIR_underlying `> `{ _ `} = $unroll_typeIR(typeIR)
  -- if typedExpressionIR_reduced
      = (`( typeIR_underlying `) typedExpressionIR) '#'
      `( typeIR_underlying ctk `)

def $reduce_serenum(typedExpressionIR) = typedExpressionIR
  -- otherwise





dec $reduce_serenum_unary(typedExpressionIR, def $check(typeIR) : bool)
  : typedExpressionIR?

def $reduce_serenum_unary(typedExpressionIR, def $check) = typedExpressionIR
  -- if _ '#' `( typeIR _ `) = typedExpressionIR
  -- if $check(typeIR)

def $reduce_serenum_unary(typedExpressionIR, def $check)
  = $reduce_serenum_unary(typedExpressionIR_cast, def $check)
  -- if _ '#' `( typeIR ctk `) = typedExpressionIR
  -- if ~$check(typeIR)
  -- if ENUM _ `< typeIR_underlying `> `{ _ `} = $unroll_typeIR(typeIR)
  -- if typedExpressionIR_cast
      = (`( typeIR_underlying `) typedExpressionIR) '#'
      `( typeIR_underlying ctk `)

def $reduce_serenum_unary(typedExpressionIR, def $check) = eps
  -- otherwise





dec $reduce_serenum_binary(
    typedExpressionIR,
    typedExpressionIR,
    def $check(typeIR, typeIR) : bool)
  : (typedExpressionIR, typedExpressionIR)?

def $reduce_serenum_binary(typedExpressionIR_l, typedExpressionIR_r, def $check)
  = (typedExpressionIR_l, typedExpressionIR_r)
  -- if _ '#' `( typeIR_l _ `) = typedExpressionIR_l
  -- if _ '#' `( typeIR_r _ `) = typedExpressionIR_r
  -- if $check(typeIR_l, typeIR_r)

def $reduce_serenum_binary(typedExpressionIR_l, typedExpressionIR_r, def $check)
  = (
    $reduce_serenum_binary(
        typedExpressionIR_l_cast,
        typedExpressionIR_r,
        def $check))
  -- if _ '#' `( typeIR_l ctk_l `) = typedExpressionIR_l
  -- if _ '#' `( typeIR_r _ `) = typedExpressionIR_r
  -- if ~$check(typeIR_l, typeIR_r)
  -- if ENUM _ `< typeIR_l_underlying `> `{ _ `} = $unroll_typeIR(typeIR_l)
  -- if typedExpressionIR_l_cast
      = (`( typeIR_l_underlying `) typedExpressionIR_l) '#'
      `( typeIR_l_underlying ctk_l `)

def $reduce_serenum_binary(typedExpressionIR_l, typedExpressionIR_r, def $check)
  = (
    $reduce_serenum_binary(
        typedExpressionIR_l,
        typedExpressionIR_r_cast,
        def $check))
  -- if _ '#' `( typeIR_l _ `) = typedExpressionIR_l
  -- if _ '#' `( typeIR_r ctk_r `) = typedExpressionIR_r
  -- if ~$check(typeIR_l, typeIR_r)
  -- if ~($unroll_typeIR(typeIR_l) <: serializableEnumTypeIR)
  -- if ENUM _ `< typeIR_r_underlying `> `{ _ `} = $unroll_typeIR(typeIR_r)
  -- if typedExpressionIR_r_cast
      = (`( typeIR_r_underlying `) typedExpressionIR_r) '#'
      `( typeIR_r_underlying ctk_r `)

def $reduce_serenum_binary(typedExpressionIR_l, typedExpressionIR_r, def $check)
  = eps
  -- otherwise





dec $apply_cast(typedExpressionIR, typeIR*) : typedExpressionIR

def $apply_cast(typedExpressionIR, eps) = typedExpressionIR

def $apply_cast(typedExpressionIR, typeIR_h :: typeIR_t*)
  = $apply_cast(typedExpressionIR_cast, typeIR_t*)
  -- if _ '#' `( _ ctk `) = typedExpressionIR
  -- if typedExpressionIR_cast
      = (`( typeIR_h `) typedExpressionIR) '#' `( typeIR_h ctk `)





dec $cast_unary(typedExpressionIR, typeIR) : typedExpressionIR?

def $cast_unary(typedExpressionIR, typeIR_to) = typedExpressionIR_cast
  -- if _ '#' `( typeIR _ `) = typedExpressionIR
  -- Cast_impl: typeIR -> typeIR_to : OK typeIR_cast*
  -- if typedExpressionIR_cast = $apply_cast(typedExpressionIR, typeIR_cast*)

def $cast_unary(typedExpressionIR, typeIR_to) = eps
  -- otherwise





dec $cast_binary(typedExpressionIR, typedExpressionIR)
  : (typedExpressionIR, typedExpressionIR)?

def $cast_binary(typedExpressionIR_l, typedExpressionIR_r)
  = (typedExpressionIR_l_cast, typedExpressionIR_r)
  -- if _ '#' `( typeIR_l _ `) = typedExpressionIR_l
  -- if _ '#' `( typeIR_r _ `) = typedExpressionIR_r
  -- Cast_impl: typeIR_l -> typeIR_r : OK typeIR_cast*
  -- if typedExpressionIR_l_cast
      = $apply_cast(typedExpressionIR_l, typeIR_cast*)

def $cast_binary(typedExpressionIR_l, typedExpressionIR_r)
  = (typedExpressionIR_l, typedExpressionIR_r_cast)
  -- if _ '#' `( typeIR_l _ `) = typedExpressionIR_l
  -- if _ '#' `( typeIR_r _ `) = typedExpressionIR_r
  -- Cast_impl: typeIR_l -> typeIR_r : FAIL
  -- Cast_impl: typeIR_r -> typeIR_l : OK typeIR_cast*
  -- if typedExpressionIR_r_cast
      = $apply_cast(typedExpressionIR_r, typeIR_cast*)

def $cast_binary(typedExpressionIR_l, typedExpressionIR_r)
  = $cast_binary(typedExpressionIR_l_cast, typedExpressionIR_r)
  -- if _ '#' `( typeIR_l _ `) = typedExpressionIR_l
  -- if _ '#' `( typeIR_r _ `) = typedExpressionIR_r
  -- Cast_impl: typeIR_l -> typeIR_r : FAIL
  -- Cast_impl: typeIR_r -> typeIR_l : FAIL
  -- if typedExpressionIR_l_cast = $reduce_serenum(typedExpressionIR_l)
  -- if typedExpressionIR_l =/= typedExpressionIR_l_cast

def $cast_binary(typedExpressionIR_l, typedExpressionIR_r)
  = $cast_binary(typedExpressionIR_l, typedExpressionIR_r_cast)
  -- if _ '#' `( typeIR_l _ `) = typedExpressionIR_l
  -- if _ '#' `( typeIR_r _ `) = typedExpressionIR_r
  -- Cast_impl: typeIR_l -> typeIR_r : FAIL
  -- Cast_impl: typeIR_r -> typeIR_l : FAIL
  -- if typedExpressionIR_l_cast = $reduce_serenum(typedExpressionIR_l)
  -- if typedExpressionIR_l = typedExpressionIR_l_cast
  -- if typedExpressionIR_r_cast = $reduce_serenum(typedExpressionIR_r)
  -- if typedExpressionIR_r =/= typedExpressionIR_r_cast

def $cast_binary(typedExpressionIR_l, typedExpressionIR_r) = eps
  -- otherwise





rulegroup TypeArgument_ok {

  rule TypeArgument_ok/type:
    p TC |- type : typeIR '#' typeId_impl*
    -- Type_ok: p TC |- type : typeIR '#' typeId_impl*

  rule TypeArgument_ok/void:
    p TC |- VOID : VOID '#' eps

  rule TypeArgument_ok/dontcare:
    p TC |- '_' : (_NAME typeId_impl) '#' typeId_impl
    -- if typeId_impl = $fresh_typeId()

  rule TypeArgument_ok/nonTypeName:
    p TC |- nonTypeName : (_NAME typeId) '#' eps
    -- if typeId = $name(nonTypeName)
    -- Type_wf: $bound(p, TC) |- _NAME typeId

}





rulegroup TypeArguments_ok {

  rule TypeArguments_ok/nil:
    p TC |- eps : eps '#' eps

  rule TypeArguments_ok/cons:
    p TC
        |- typeArgument_h :: typeArgument_t*
            : (typeArgumentIR_h :: typeArgumentIR_t*) '#' typeId_impl*
    -- TypeArgument_ok:
        p TC |- typeArgument_h : typeArgumentIR_h '#' typeId_impl_h*
    -- TypeArguments_ok:
        p TC |- typeArgument_t* : typeArgumentIR_t* '#' typeId_impl_t*
    -- if typeId_impl* = typeId_impl_h* ++ typeId_impl_t*

}

rule TypeArgumentList_ok:
  p TC |- typeArgumentList : typeArgumentIR* '#' typeId_impl*
  -- if typeArgument* = $flatten_typeArgumentList(typeArgumentList)
  -- TypeArguments_ok: p TC |- typeArgument* : typeArgumentIR* '#' typeId_impl*

rule TypeParameterListOpt_ok:
  p TC_0 |- typeParameterListOpt : TC_1 typeId*
  -- if typeParameter* = $flatten_typeParameterListOpt(typeParameterListOpt)
  -- (if (typeId = $name(typeParameter)))*
  -- if TC_1 = $add_typeParameters_t(p, TC_0, typeId*)





rulegroup Expr_ok/literalExpression {

  rule Expr_ok/booleanLiteral:
    p TC |- booleanLiteral : booleanLiteral '#' expressionNoteIR
    -- if expressionNoteIR = `( BOOL LCTK `)

  rule Expr_ok/integerLiteral-arbint:
    p TC |- D i : (D i) '#' expressionNoteIR
    -- if expressionNoteIR = `( INT LCTK `)

  rule Expr_ok/integerLiteral-fixint:
    p TC |- n S i : (n S i) '#' expressionNoteIR
    -- if expressionNoteIR = `( (INT `< n `>) LCTK `)

  rule Expr_ok/integerLiteral-fixbit:
    p TC |- n W i : (n W i) '#' expressionNoteIR
    -- if expressionNoteIR = `( (BIT `< n `>) LCTK `)

  rule Expr_ok/stringLiteral:
    p TC |- stringLiteral : stringLiteral '#' expressionNoteIR
    -- if expressionNoteIR = `( STRING LCTK `)

}





rulegroup Expr_ok/referenceExpression {

  rule Expr_ok/prefixedNonTypeName:
    p TC |- prefixedNonTypeName : prefixedNameIR '#' expressionNoteIR
    -- if prefixedNameIR = $prefixedNonTypeName(prefixedNonTypeName)
    -- if _ typeIR ctk _ = $find_var_t(prefixedNameIR, p, TC)
    -- if expressionNoteIR = `( typeIR ctk `)

  rule Expr_ok/this:
    p TC |- THIS : prefixedNameIR '#' expressionNoteIR
    -- if prefixedNameIR = _BARE "this"
    -- if _ typeIR ctk _ = $find_var_t(prefixedNameIR, p, TC)
    -- if expressionNoteIR = `( typeIR ctk `)

}





rule Expr_ok/defaultExpression:
  p TC |- '...' : '...' '#' expressionNoteIR
  -- if expressionNoteIR = `( DEFAULT LCTK `)





tbl dec $compat_lnot(typeIR) : bool

tbl def $compat_lnot =
  | BOOL => true
  | TYPEDEF _ typeIR => $compat_lnot(typeIR)
  | _ => false

rule Expr_ok/unaryExpression-lnot:
  p TC |- '!' expression : ('!' typedExpressionIR_reduced) '#' expressionNoteIR
  -- Expr_ok: p TC |- expression : typedExpressionIR
  -- if typedExpressionIR_reduced
      = $reduce_serenum_unary(typedExpressionIR, def $compat_lnot)
  -- if typeIR_reduced = $type_of_typedExpressionIR(typedExpressionIR_reduced)
  -- if ctk_reduced = $ctk_of_typedExpressionIR(typedExpressionIR_reduced)
  -- if expressionNoteIR = `( typeIR_reduced ctk_reduced `)





tbl dec $compat_bnot(typeIR) : bool

tbl def $compat_bnot =
  | INT `< _ `> => true
  | BIT `< _ `> => true
  | TYPEDEF _ typeIR => $compat_bnot(typeIR)
  | _ => false

rule Expr_ok/unaryExpression-bnot:
  p TC |- '~' expression : ('~' typedExpressionIR_reduced) '#' expressionNoteIR
  -- Expr_ok: p TC |- expression : typedExpressionIR
  -- if typedExpressionIR_reduced
      = $reduce_serenum_unary(typedExpressionIR, def $compat_bnot)
  -- if typeIR_reduced = $type_of_typedExpressionIR(typedExpressionIR_reduced)
  -- if ctk_reduced = $ctk_of_typedExpressionIR(typedExpressionIR_reduced)
  -- if expressionNoteIR = `( typeIR_reduced ctk_reduced `)





tbl dec $compat_uplusminus(typeIR) : bool

tbl def $compat_uplusminus =
  | INT => true
  | INT `< _ `> => true
  | BIT `< _ `> => true
  | TYPEDEF _ typeIR => $compat_uplusminus(typeIR)
  | _ => false

rule Expr_ok/unaryExpression-uplusminus:
  p TC
      |- unop expression : (unop typedExpressionIR_reduced) '#' expressionNoteIR
  -- if unop = '+' \/ unop = '-'
  -- Expr_ok: p TC |- expression : typedExpressionIR
  -- if typedExpressionIR_reduced
      = $reduce_serenum_unary(typedExpressionIR, def $compat_uplusminus)
  -- if typeIR_reduced = $type_of_typedExpressionIR(typedExpressionIR_reduced)
  -- if ctk_reduced = $ctk_of_typedExpressionIR(typedExpressionIR_reduced)
  -- if expressionNoteIR = `( typeIR_reduced ctk_reduced `)





