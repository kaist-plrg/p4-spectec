def $flatten_tableEntryList(tableEntryList tableEntry)
  = $flatten_tableEntryList(tableEntryList) ++ [tableEntry]





tableProperty
    : KEY = { tableKeyList } | ACTIONS = { tableActionList }
    | annotationList constOpt ENTRIES = { tableEntryList }
    | annotationList constOpt tableCustomName initializer ;
    ;

tablePropertyList
    : /* empty */ | tablePropertyList tableProperty
    ;

dec $flatten_tablePropertyList(tablePropertyList) : tableProperty*

def $flatten_tablePropertyList(_EMPTY) = eps

def $flatten_tablePropertyList(tablePropertyList tableProperty)
  = $flatten_tablePropertyList(tablePropertyList) ++ [tableProperty]

tableDeclaration
    : annotationList TABLE name { tablePropertyList }
    ;





controlTypeDeclaration
    : annotationList CONTROL name typeParameterListOpt ( parameterList ) ;
    ;





controlBody = blockStatement

controlLocalDeclaration
    : constantDeclaration | instantiation | variableDeclaration
    | actionDeclaration | tableDeclaration
    ;

controlLocalDeclarationList
    : /* empty */ | controlLocalDeclarationList controlLocalDeclaration
    ;

dec $flatten_controlLocalDeclarationList(controlLocalDeclarationList)
  : controlLocalDeclaration*

def $flatten_controlLocalDeclarationList(_EMPTY) = eps

def $flatten_controlLocalDeclarationList(
    controlLocalDeclarationList controlLocalDeclaration)
  = $flatten_controlLocalDeclarationList(controlLocalDeclarationList)
      ++ [controlLocalDeclaration]

controlDeclaration
    : annotationList CONTROL name typeParameterListOpt ( parameterList )
        constructorParameterListOpt
        { controlLocalDeclarationList APPLY controlBody }
    ;





packageTypeDeclaration
    : annotationList PACKAGE name typeParameterListOpt ( parameterList ) ;
    ;





typeDeclaration
    : derivedTypeDeclaration | typedefDeclaration | parserTypeDeclaration
    | controlTypeDeclaration | packageTypeDeclaration
    ;





declaration
    : constantDeclaration | instantiation | functionDeclaration
    | actionDeclaration | errorDeclaration | matchKindDeclaration
    | externDeclaration | parserDeclaration | controlDeclaration
    | typeDeclaration
    ;





annotationToken
    : UNEXPECTED_TOKEN | ABSTRACT | ACTION | ACTIONS | APPLY | BOOL | BIT
    | BREAK | CONST | CONTINUE | CONTROL | DEFAULT | ELSE | ENTRIES | ENUM
    | ERROR | EXIT | EXTERN | FALSE | FOR | HEADER | HEADER_UNION | IF | IN
    | INOUT | INT | KEY | MATCH_KIND | TYPE | OUT | PARSER | PACKAGE | PRAGMA
    | RETURN | SELECT | STATE | STRING | STRUCT | SWITCH | TABLE | THIS
    | TRANSITION | TRUE | TUPLE | TYPEDEF | VARBIT | VALUE_SET | LIST | VOID | _
    | identifier | typeIdentifier | stringLiteral | integerLiteral | &&& | ..
    | << | && | || | == | != | >= | <= | ++ | + | |+| | - | |-| | * | / | % | |
    | & | ^ | ~ | [ | ] | { | } | < | > | ! | : | , | ? | . | = | ; | @
    ;

annotationBody
    : /* empty */ | annotationBody ( annotationBody )
    | annotationBody annotationToken
    ;

structuredAnnotationBody
    : sequenceOrRecordElementExpression trailingCommaOpt
    ;

annotation
    : @ name | @ name ( annotationBody ) | @ name [ structuredAnnotationBody ]
    | @ PRAGMA name annotationBody
    ;

annotationListNonEmpty
    : annotation | annotationListNonEmpty annotation
    ;

annotationList
    : /* empty */ | annotationListNonEmpty
    ;

dec $flatten_annotationList(annotationList) : annotation*

def $flatten_annotationList(_EMPTY) = eps

def $flatten_annotationList(annotation) = annotation

def $flatten_annotationList(annotationListNonEmpty annotation)
  = $flatten_annotationList(annotationListNonEmpty) ++ [annotation]





p4program
    : /* empty */ | p4program declaration | p4program ;
    ;

dec $flatten_p4program(p4program) : declaration*

def $flatten_p4program(_EMPTY) = eps

def $flatten_p4program(p4program declaration)
  = $flatten_p4program(p4program) ++ [declaration]

def $flatten_p4program(p4program ';') = $flatten_p4program(p4program)

cursor
    : GLOBAL | BLOCK | LOCAL
    ;

var p : cursor





nameIR = text

dec $name(name) : nameIR

def $name(name) = $print_<name>(name)

dec $tableCustomName(tableCustomName) : nameIR

def $tableCustomName(tableCustomName)
  = $print_<tableCustomName>(tableCustomName)





id = nameIR





typeId = nameIR

builtin dec $fresh_typeId : typeId

dec $fresh_typeIds(nat) : typeId*

def $fresh_typeIds(0) = eps

def $fresh_typeIds(n) = $fresh_typeId() :: $fresh_typeIds(n')
  -- if n =/= 0
  -- if n' = $(n - 1)





callTargetId
    : nameIR ( id* )
    ;

callableId = callTargetId

constructorId = callTargetId

dec $callableId(name, parameterList) : callableId

dec $callableId'(parameterList) : id*

dec $constructorId(name, constructorParameterListOpt) : constructorId

def $callableId(name, parameterList)
  = $name(name) `( $callableId'(parameterList) `)

def $constructorId(name, _EMPTY) = $name(name) `( eps `)

def $constructorId(name, `( parameterList `)) = $callableId(name, parameterList)

def $callableId'(_EMPTY) = eps

def $callableId'(_ _ _ name _) = $name(name)

def $callableId'(nonEmptyParameterList ',' (_ _ _ name _))
  = $callableId'(nonEmptyParameterList) ++ [$name(name)]





objectId = nameIR*

dec $objectId_ends_with(objectId, nameIR) : bool

def $objectId_ends_with(objectId, nameIR) = true
  -- if nameIR :: _ = $rev_<id>(objectId)

def $objectId_ends_with(objectId, nameIR) = false
  -- otherwise





boolValue
    : _B bool
    ;

errorValue
    : ERROR . nameIR
    ;

matchKindValue
    : MATCH_KIND . nameIR
    ;

stringValue = stringLiteral

integerValue
    : integerLiteral | nat . nat V int
    ;

baseValue
    : boolValue | errorValue | matchKindValue | stringValue | integerValue
    ;





syntax value

listValue
    : LIST [ value* ]
    ;

tupleValue
    : TUPLE ( value* )
    ;

arrayValue
    : ARRAY [ value* ]
    ;

headerStackValue
    : HEADER_STACK [ value* ( nat ) ]
    ;

fieldValue
    : value nameIR ;
    ;

structValue
    : STRUCT typeId { fieldValue* }
    ;

headerValue
    : HEADER typeId { bool ; fieldValue* }
    ;

headerUnionValue
    : HEADER_UNION typeId { fieldValue* }
    ;

enumValue
    : typeId . nameIR | typeId . nameIR . value
    ;

dataValue
    : listValue | tupleValue | arrayValue | headerStackValue | structValue
    | headerValue | headerUnionValue | enumValue
    ;





objectReferenceValue
    : REF objectId
    ;





defaultValue
    : DEFAULT
    ;

invalidHeaderValue
    : {#}
    ;

sequenceValue
    : SEQ ( value* ) | SEQ ( value* , ... )
    ;

recordValue
    : RECORD { fieldValue* } | RECORD { fieldValue* , ... }
    ;

setValue
    : SET { value } | SET { value* ( nat ) } | SET { value &&& value }
    | SET { value .. value } | SET { ... }
    ;

tableMetadataEnumValue
    : TABLE_ENUM typeId . nameIR
    ;

tableMetadataStructValue
    : TABLE_STRUCT typeId
        { HIT boolValue ; MISS boolValue ; ACTION_RUN tableMetadataEnumValue ; }
    ;

tableMetadataValue
    : tableMetadataEnumValue | tableMetadataStructValue
    ;

synthesizedValue
    : defaultValue | invalidHeaderValue | sequenceValue | recordValue | setValue
    | tableMetadataValue
    ;





value
    : baseValue | dataValue | objectReferenceValue | synthesizedValue
    ;

builtin dec $bitstr_to_int(int, int) : int





builtin dec $int_to_bitstr(int, int) : int





bit = bool

bits = bit*

builtin dec $bits_to_int_unsigned(bits) : int

builtin dec $bits_to_int_signed(bits) : int

builtin dec $int_to_bits_unsigned(nat, int) : bits

builtin dec $int_to_bits_signed(nat, int) : bits





dec $int_of_integerValue(integerValue) : int

def $int_of_integerValue(D i) = i

def $int_of_integerValue(w S i) = $bitstr_to_int(w, i)

def $int_of_integerValue(w W i) = i

def $int_of_integerValue(_ '.' _ V i) = i

dec $nat_of_integerValue(integerValue) : nat?

def $nat_of_integerValue(integerValue) = n
  -- if n = $int_of_integerValue(integerValue)

def $nat_of_integerValue(integerValue) = eps
