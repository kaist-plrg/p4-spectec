  -- (if (nameIR_enum_field = $flatten_prefixedNameIR(prefixedNameIR_action)))*
  -- if tableMetadataEnumTypeIR
      = TABLE_ENUM typeId_enum `{ nameIR_enum_field* `}
  -- (if (value_enum_field = TABLE_ENUM typeId_enum '.' nameIR_enum_field))*
  -- (if (
    varTypeIR_enum_field
        = _EMPTY tableMetadataEnumTypeIR LCTK value_enum_field))*
  -- if TC_1
      = $add_vars_t(
          BLOCK,
          TC_0,
          (typeId_enum ++ "." ++ nameIR_enum_field)*,
          varTypeIR_enum_field*)
  -- if typeId_struct = "apply_result(" ++ nameIR ++ ")"
