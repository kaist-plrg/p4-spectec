        LOCAL TC
            |- lvalue_callable `< typeArgumentList `> `( argumentList `) ';'
                : _
                (callableTargetIR `< typeArgumentIR* `> `( argumentIR* `) ';')

  rule ForUpdateStmt_ok/assign:
    TC |- lvalue assignop expression : typedLvalueIR assignop typedExpressionIR
    -- Stmt_ok:
