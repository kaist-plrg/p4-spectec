  -- if expression = $lift_callableTargetIR_as_expression(callableTargetIR)





def $lift_callableTargetIR_as_lvalue(_BARE "this") = THIS

def $lift_callableTargetIR_as_lvalue(_BARE nameIR) = nonTypeName
  -- if nameIR =/= "this"
  -- if nonTypeName = $lift_nameIR_as_nonTypeName(nameIR)

def $lift_callableTargetIR_as_lvalue('.' nameIR) = _ID '.' nonTypeName
  -- if nonTypeName = $lift_nameIR_as_nonTypeName(nameIR)

def $lift_callableTargetIR_as_lvalue(typedExpressionIR '.' nameIR)
  = lvalue '.' member
  -- if typedLvalueIR = $typedExpressionIR_as_typedLvalueIR(typedExpressionIR)
  -- if lvalue = $lift_typedLvalueIR(typedLvalueIR)
  -- if member = $lift_nameIR_as_member(nameIR)

def $lift_callableTargetIR_as_lvalue(TYPE (_BARE "this") '.' nameIR)
  = THIS '.' member
  -- if member = $lift_nameIR_as_member(nameIR)

def $lift_callableTargetIR_as_lvalue(TYPE (_BARE nameIR) '.' nameIR_field)
  = nonTypeName '.' member
  -- if nameIR =/= "this"
  -- if nonTypeName = $lift_nameIR_as_nonTypeName(nameIR)
  -- if member = $lift_nameIR_as_member(nameIR_field)

def $lift_callableTargetIR_as_lvalue(TYPE ('.' nameIR) '.' nameIR_field)
  = (_ID '.' nonTypeName) '.' member
  -- if nonTypeName = $lift_nameIR_as_nonTypeName(nameIR)
  -- if member = $lift_nameIR_as_member(nameIR_field)

def $lift_callableTargetIR_as_lvalue(`( callableTargetIR `)) = `( lvalue `)
  -- if lvalue = $lift_callableTargetIR_as_lvalue(callableTargetIR)









