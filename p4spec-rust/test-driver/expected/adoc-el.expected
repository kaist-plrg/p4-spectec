            |- assignmentStatementIR : EC_1 ARCH_1 rejectTransitionResult

  rule ParserStmt_eval/cont:
    EC_0 ARCH_0 |- assignmentStatementIR : EC_1 ARCH_1 _EMPTY
    -- Stmt_eval:
        LOCAL EC_0 ARCH_0 |- assignmentStatementIR : EC_1 ARCH_1 _EMPTY

}





rulegroup ParserStmt_eval/callStatementIR {

