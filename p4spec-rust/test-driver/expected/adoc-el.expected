rule Call_convention_expr_ok/in:
  p TC actctxt
      |- (_ IN typeIR_param _ _) '@' typedExpressionIR_arg
          : typedExpressionIR_arg_cast
  -- if typedExpressionIR_arg_cast
      = $cast_unary(typedExpressionIR_arg, typeIR_param)





rule Call_convention_expr_ok/out-inout:
  p TC actctxt
      |- (_ direction typeIR_param _ _) '@' typedExpressionIR_arg
          : typedExpressionIR_arg
  -- if direction = OUT \/ direction = INOUT
  -- if typeIR_arg = $type_of_typedExpressionIR(typedExpressionIR_arg)
  -- Type_alpha: typeIR_param ~~ typeIR_arg
  -- if typedLvalueIR_arg
      = $typedExpressionIR_as_typedLvalueIR(typedExpressionIR_arg)
  -- if lvalue_arg = $lift_typedLvalueIR(typedLvalueIR_arg)
  -- Lvalue_ok: p TC |- lvalue_arg : _





rulegroup Call_convention_expr_ok/directionless {

  rule Call_convention_expr_ok/action:
    p TC ACTION
        |- (_ _EMPTY typeIR_param _ _) '@' typedExpressionIR_arg
            : typedExpressionIR_arg_cast
    -- if typedExpressionIR_arg_cast
        = $cast_unary(typedExpressionIR_arg, typeIR_param)

  rule Call_convention_expr_ok/non-action:
    p TC NOACTION
        |- (_ _EMPTY typeIR_param _ _) '@' typedExpressionIR_arg
            : typedExpressionIR_arg_cast
    -- if typedExpressionIR_arg_cast
        = $cast_unary(typedExpressionIR_arg, typeIR_param)
    -- if DYN =/= $ctk_of_typedExpressionIR(typedExpressionIR_arg)

}





rulegroup Call_convention_arg_ok {

  rule Call_convention_arg_ok/typedExpression:
    p TC actctxt |- parameterIR '@' typedExpressionIR : typedExpressionIR_cast
    -- Call_convention_expr_ok:
        p TC actctxt
            |- parameterIR '@' typedExpressionIR : typedExpressionIR_cast

  rule Call_convention_arg_ok/nameIR-typedExpression:
    p TC actctxt
        |- parameterIR '@' (nameIR '=' typedExpressionIR)
            : (nameIR '=' typedExpressionIR_cast)
    -- Call_convention_expr_ok:
        p TC actctxt
            |- parameterIR '@' typedExpressionIR : typedExpressionIR_cast

  rule Call_convention_arg_ok/nameIR-dontcare:
    p TC actctxt |- parameterIR '@' (nameIR '=' '_') : (nameIR '=' '_')
    -- if _ OUT _ _ _ = parameterIR

  rule Call_convention_arg_ok/dontcare:
    p TC actctxt |- parameterIR '@' '_' : '_'
    -- if _ OUT _ _ _ = parameterIR

}





rulegroup Call_convention_ok {

  rule Call_convention_ok/nil:
    p TC actctxt |- eps '@' eps : eps

  rule Call_convention_ok/cons:
    p TC actctxt
        |- (parameterIR_h :: parameterIR_t*) '@' (argumentIR_h :: argumentIR_t*)
            : (argumentIR_h_cast :: argumentIR_t_cast*)
    -- Call_convention_arg_ok:
        p TC actctxt |- parameterIR_h '@' argumentIR_h : argumentIR_h_cast
    -- Call_convention_ok:
        p TC actctxt |- parameterIR_t* '@' argumentIR_t* : argumentIR_t_cast*

}

strict
    : STRICT | LAX
    ;

strictness = map<typeId, strict>

dec $empty_strictness(typeId*) : strictness

def $empty_strictness(typeId*) = `{ (typeId ':' STRICT)* `}

infer
    : KNOWN AS typeIR | UNKNOWN
    ;

constraint = map<typeId, infer>

dec $empty_constraint(typeId*) : constraint

def $empty_constraint(typeId*) = `{ (typeId ':' UNKNOWN)* `}

inference = map<typeId, typeIR>





dec $infer(typeId*, parameterIR*, parameterIR*, argumentIR*) : inference

dec $infer_pair(constraint, parameterIR, argumentIR) : constraint

dec $resolve_inference(inference) : inference

dec $resolve_inference'(typeIR) : typeIR

dec $gen_constraint(constraint, typeIR*, typeIR*) : constraint

dec $gen_constraint_pair(constraint, typeIR, typeIR) : constraint

dec $merge_constraint(constraint, constraint) : constraint

dec $merge_constraint'(constraint, constraint, typeId*, constraint) : constraint

dec $merge_constraints(constraint, constraint*) : constraint

dec $resolve_constraint(strictness, constraint) : inference





def $infer(eps, parameterIR*, parameterIR_optional*, argumentIR*)
  = $empty_map<typeId, typeIR>()

def $infer(typeId_infer*, parameterIR*, parameterIR_optional*, argumentIR*)
  = inference_resolved
  -- if typeId_infer* =/= eps
  -- if strictness_init = $empty_strictness(typeId_infer*)
  -- if B = $free_parameterIRs(parameterIR*)
  -- if B_optional = $free_parameterIRs(parameterIR_optional*)
  -- if `{ typeId_free* `} = $diff_set<typeId>(B_optional, B)
  -- if strict* = $repeat_<strict>(LAX, |typeId_free*|)
  -- if strictness
      = $adds_map<typeId, strict>(strictness_init, typeId_free*, strict*)
  -- if constraint_init = $empty_constraint(typeId_infer*)
  -- (if (
    constraint_pair = $infer_pair(constraint_init, parameterIR, argumentIR)))*
  -- if constraint_inferred
      = $merge_constraints(constraint_init, constraint_pair*)
  -- if inference = $resolve_constraint(strictness, constraint_inferred)
  -- if inference_resolved = $resolve_inference(inference)

def $infer_pair(constraint, parameterIR, typedExpressionIR)
  = $gen_constraint_pair(constraint, typeIR_param, typeIR_arg)
  -- if _ _ typeIR_param _ _ = parameterIR
  -- if typeIR_arg = $type_of_typedExpressionIR(typedExpressionIR)

def $infer_pair(constraint, parameterIR, nameIR '=' typedExpressionIR)
  = $gen_constraint_pair(constraint, typeIR_param, typeIR_arg)
  -- if _ _ typeIR_param _ _ = parameterIR
  -- if typeIR_arg = $type_of_typedExpressionIR(typedExpressionIR)

def $infer_pair(constraint, parameterIR, nameIR '=' '_') = constraint

def $infer_pair(constraint, parameterIR, '_') = constraint





def $resolve_inference(`{ (typeId ':' typeIR)* `})
  = `{ (typeId ':' typeIR_resolved)* `}
  -- (if (typeIR_resolved = $resolve_inference'(typeIR)))*

def $resolve_inference'(typeIR) = typeIR_resolved
  -- if SEQ `< typeIR_arg* `> = $unroll_typeIR(typeIR)
  -- if typeIR_resolved = TUPLE `< typeIR_arg* `>

def $resolve_inference'(typeIR) = typeIR
  -- otherwise





def $gen_constraint_pair(constraint, _NAME typeId_param, typeIR_arg)
  = $update_map<typeId, infer>(constraint, typeId_param, KNOWN AS typeIR_arg)
  -- if $in_set<typeId>(typeId_param, $dom_map<typeId, infer>(constraint))





def $gen_constraint_pair(constraint, TYPEDEF _ typeIR_param, typeIR_arg)
  = $gen_constraint_pair(constraint, typeIR_param, typeIR_arg)

def $gen_constraint_pair(constraint, typeIR_param, TYPEDEF _ typeIR_arg)
  = $gen_constraint_pair(constraint, typeIR_param, typeIR_arg)
  -- if ~(typeIR_param <: nameTypeIR)
  -- if ~(typeIR_param <: typedefTypeIR)

def $gen_constraint_pair(
    constraint,
    TYPE typeId typeIR_param,
    TYPE typeId typeIR_arg)
  = $gen_constraint_pair(constraint, typeIR_param, typeIR_arg)





def $gen_constraint_pair(
    constraint,
    LIST `< typeIR_param `>,
    LIST `< typeIR_arg `>)
  = $gen_constraint_pair(constraint, typeIR_param, typeIR_arg)

def $gen_constraint_pair(
    constraint,
    TUPLE `< typeIR_param* `>,
    TUPLE `< typeIR_arg* `>)
  = $gen_constraint(constraint, typeIR_param*, typeIR_arg*)

def $gen_constraint_pair(
    constraint,
    ARRAY typeIR_param `[ n_size `],
    ARRAY typeIR_arg `[ n_size `])
  = $gen_constraint_pair(constraint, typeIR_param, typeIR_arg)

def $gen_constraint_pair(
    constraint,
    HEADER_STACK typeIR_param `[ n_size `],
    HEADER_STACK typeIR_arg `[ n_size `])
  = $gen_constraint_pair(constraint, typeIR_param, typeIR_arg)

def $gen_constraint_pair(
    constraint,
    STRUCT typeId `< typeIR_arg_a* `> `{ _ `},
    STRUCT typeId `< typeIR_arg_b* `> `{ _ `})
  = $gen_constraint(constraint, typeIR_arg_a*, typeIR_arg_b*)

def $gen_constraint_pair(
    constraint,
    HEADER typeId `< typeIR_arg_a* `> `{ _ `},
    HEADER typeId `< typeIR_arg_b* `> `{ _ `})
  = $gen_constraint(constraint, typeIR_arg_a*, typeIR_arg_b*)

def $gen_constraint_pair(
    constraint,
    HEADER_UNION typeId `< typeIR_arg_a* `> `{ _ `},
    HEADER_UNION typeId `< typeIR_arg_b* `> `{ _ `})
  = $gen_constraint(constraint, typeIR_arg_a*, typeIR_arg_b*)





def $gen_constraint_pair(
    constraint,
    EXTERN typeId `< typeIR_arg_a* `> `{ _ `},
    EXTERN typeId `< typeIR_arg_b* `> `{ _ `})
  = $gen_constraint(constraint, typeIR_arg_a*, typeIR_arg_b*)

def $gen_constraint_pair(
    constraint,
    PARSER _ `< _ `> `( parameterIR_param* `),
    PARSER _ `< _ `> `( parameterIR_arg* `))
  = $gen_constraint(constraint, typeIR_param*, typeIR_arg*)
  -- (if (_ direction typeIR_param _ _ = parameterIR_param))*
  -- (if (_ direction typeIR_arg _ _ = parameterIR_arg))*

def $gen_constraint_pair(
    constraint,
    CONTROL _ `< _ `> `( parameterIR_param* `),
    CONTROL _ `< _ `> `( parameterIR_arg* `))
  = $gen_constraint(constraint, typeIR_param*, typeIR_arg*)
  -- (if (_ direction typeIR_param _ _ = parameterIR_param))*
  -- (if (_ direction typeIR_arg _ _ = parameterIR_arg))*

def $gen_constraint_pair(
    constraint,
    PACKAGE _ `< _ `> `{ typeIR_param* `},
    PACKAGE _ `< _ `> `{ typeIR_arg* `})
  = $gen_constraint(constraint, typeIR_param*, typeIR_arg*)

def $gen_constraint_pair(constraint, typeIR_param, typeIR_arg) = constraint
  -- otherwise





def $gen_constraint(constraint, typeIR_param*, typeIR_arg*)
  = $merge_constraints(constraint, constraint_pair*)
  -- (if (
    constraint_pair
        = $gen_constraint_pair(constraint, typeIR_param, typeIR_arg)))*





def $merge_constraint(constraint_pre, constraint_post)
  = $merge_constraint'(constraint_pre, constraint_post, typeId_pre*, `{ eps `})
  -- if `{ typeId_pre* `} = $dom_map<typeId, infer>(constraint_pre)
  -- if `{ typeId_post* `} = $dom_map<typeId, infer>(constraint_post)
  -- if $eq_set<typeId>(`{ typeId_pre* `}, `{ typeId_post* `})

def $merge_constraint'(constraint_pre, constraint_post, eps, constraint)
  = constraint

def $merge_constraint'(
    constraint_pre,
    constraint_post,
    typeId_h :: typeId_t*,
    constraint)
  = $merge_constraint'(
      constraint_pre,
      constraint_post,
      typeId_t*,
      constraint_updated)
  -- if UNKNOWN = $find_map<typeId, infer>(constraint_pre, typeId_h)
  -- if UNKNOWN = $find_map<typeId, infer>(constraint_post, typeId_h)
  -- if constraint_updated
      = $update_map<typeId, infer>(constraint, typeId_h, UNKNOWN)

def $merge_constraint'(
    constraint_pre,
    constraint_post,
    typeId_h :: typeId_t*,
    constraint)
  = $merge_constraint'(
      constraint_pre,
      constraint_post,
      typeId_t*,
      constraint_updated)
  -- if UNKNOWN = $find_map<typeId, infer>(constraint_pre, typeId_h)
  -- if KNOWN AS typeIR_post
      = $find_map<typeId, infer>(constraint_post, typeId_h)
  -- if constraint_updated
      = $update_map<typeId, infer>(constraint, typeId_h, KNOWN AS typeIR_post)

def $merge_constraint'(
    constraint_pre,
    constraint_post,
    typeId_h :: typeId_t*,
    constraint)
  = $merge_constraint'(
      constraint_pre,
      constraint_post,
      typeId_t*,
      constraint_updated)
  -- if KNOWN AS typeIR_pre = $find_map<typeId, infer>(constraint_pre, typeId_h)
  -- if UNKNOWN = $find_map<typeId, infer>(constraint_post, typeId_h)
  -- if constraint_updated
      = $update_map<typeId, infer>(constraint, typeId_h, KNOWN AS typeIR_pre)

def $merge_constraint'(
    constraint_pre,
    constraint_post,
    typeId_h :: typeId_t*,
    constraint)
  = $merge_constraint'(
      constraint_pre,
      constraint_post,
      typeId_t*,
      constraint_updated)
  -- if KNOWN AS typeIR_pre = $find_map<typeId, infer>(constraint_pre, typeId_h)
  -- if KNOWN AS typeIR_post
      = $find_map<typeId, infer>(constraint_post, typeId_h)
  -- Cast_impl: typeIR_pre -> typeIR_post : OK _
  -- if constraint_updated
      = $update_map<typeId, infer>(constraint, typeId_h, KNOWN AS typeIR_post)

def $merge_constraint'(
    constraint_pre,
    constraint_post,
    typeId_h :: typeId_t*,
    constraint)
  = $merge_constraint'(
      constraint_pre,
      constraint_post,
      typeId_t*,
      constraint_updated)
  -- if KNOWN AS typeIR_pre = $find_map<typeId, infer>(constraint_pre, typeId_h)
  -- if KNOWN AS typeIR_post
      = $find_map<typeId, infer>(constraint_post, typeId_h)
  -- Cast_impl: typeIR_pre -> typeIR_post : FAIL
  -- Cast_impl: typeIR_post -> typeIR_pre : OK _
  -- if constraint_updated
      = $update_map<typeId, infer>(constraint, typeId_h, KNOWN AS typeIR_pre)

def $merge_constraints(constraint_pre, eps) = constraint_pre

def $merge_constraints(
    constraint_pre_0,
    constraint_post_h :: constraint_post_t*)
  = constraint_pre_2
  -- if constraint_pre_1
      = $merge_constraint(constraint_pre_0, constraint_post_h)
  -- if constraint_pre_2
      = $merge_constraints(constraint_pre_1, constraint_post_t*)





def $resolve_constraint(strictness, `{ eps `}) = `{ eps `}

def $resolve_constraint(
    strictness,
    `{ (typeId_h ':' infer_h) :: (typeId_t ':' infer_t)* `})
  = `{ (typeId_h ':' typeIR_h) :: (typeId_t ':' typeIR_t)* `}
  -- if KNOWN AS typeIR_h = infer_h
  -- if `{ (typeId_t ':' typeIR_t)* `}
      = $resolve_constraint(strictness, `{ (typeId_t ':' infer_t)* `})

def $resolve_constraint(
    strictness,
    `{ (typeId_h ':' infer_h) :: (typeId_t ':' infer_t)* `})
  = `{ (typeId_h ':' BOOL) :: (typeId_t ':' typeIR_t)* `}
  -- if UNKNOWN = infer_h
  -- if $find_map<typeId, strict>(strictness, typeId_h) = LAX
  -- if `{ (typeId_t ':' typeIR_t)* `}
      = $resolve_constraint(strictness, `{ (typeId_t ':' infer_t)* `})

dec $resolve_type_alias(typeIR) : (nameIR, typeIR*)

def $resolve_type_alias(TYPEDEF nameIR_alias typeIR_alias)
  = $resolve_type_alias(typeIR_alias)

def $resolve_type_alias(EXTERN nameIR_alias `< typeIR_arg* `> _)
  = (nameIR_alias, typeIR_arg*)

def $resolve_type_alias(PACKAGE nameIR_alias `< typeIR_arg* `> `{ _ `})
  = (nameIR_alias, typeIR_arg*)

rulegroup ConstructorType_ok {

  rule ConstructorType_ok/non-aliased-none-type:
    p TC
        |- (prefixedNameIR `< typeArgumentIR* `>) `( argumentIR* `)
            : constructorTypeIR `< '#' typeId_impl* `>
            `( '#' id_default* '#' id_optional* `)
    -- if eps = $find_typeDef_t(p, TC, prefixedNameIR)
    -- if callableId ':' constructorTypeDefIR '#' id_default* '#' id_optional*
        = $find_constructorDef_overloaded_t(TC, prefixedNameIR, argumentIR*)
    -- if (constructorTypeIR, typeId_impl*)
        = $specialize_constructorTypeDefIR(
            constructorTypeDefIR,
            typeArgumentIR*)

  rule ConstructorType_ok/non-aliased-some-type:
    p TC
        |- (prefixedNameIR `< typeArgumentIR* `>) `( argumentIR* `)
            : constructorTypeIR `< '#' typeId_impl* `>
            `( '#' id_default* '#' id_optional* `)
    -- if typeDefIR = $find_typeDef_t(p, TC, prefixedNameIR)
    -- if ~(typeDefIR <: typedefTypeIR)
    -- if callableId ':' constructorTypeDefIR '#' id_default* '#' id_optional*
        = $find_constructorDef_overloaded_t(TC, prefixedNameIR, argumentIR*)
    -- if (constructorTypeIR, typeId_impl*)
        = $specialize_constructorTypeDefIR(
            constructorTypeDefIR,
            typeArgumentIR*)

  rule ConstructorType_ok/aliased:
    p TC
        |- (prefixedNameIR `< eps `>) `( argumentIR* `)
            : constructorTypeIR `< '#' typeId_impl* `>
            `( '#' id_default* '#' id_optional* `)
    -- if TYPEDEF nameIR_alias typeIR_alias
        = $find_typeDef_t(p, TC, prefixedNameIR)
    -- if (nameIR, typeArgumentIR*) = $resolve_type_alias(typeIR_alias)
    -- if callableId ':' constructorTypeDefIR '#' id_default* '#' id_optional*
        = $find_constructorDef_overloaded_t(TC, _BARE nameIR, argumentIR*)
    -- if (constructorTypeIR, typeId_impl*)
        = $specialize_constructorTypeDefIR(
            constructorTypeDefIR,
            typeArgumentIR*)

}





dec $instantiable_extern(cursor, typingContext, instctxt) : bool

def $instantiable_extern(GLOBAL, TC, instctxt) = true

def $instantiable_extern(BLOCK, TC, instctxt) = true

def $instantiable_extern(LOCAL, TC, instctxt) = true

dec $instantiable_parser(cursor, typingContext, instctxt) : bool

def $instantiable_parser(GLOBAL, TC, instctxt) = instctxt = ANON

def $instantiable_parser(BLOCK, TC, instctxt)
  = blockKind = PARSER \/ blockKind = PACKAGE
  -- if blockKind = TC.BLOCK.KIND

def $instantiable_parser(LOCAL, TC, instctxt) = localKind = PARSER_STATE
  -- if localKind = TC.LOCAL.KIND

dec $instantiable_control(cursor, typingContext, instctxt) : bool

def $instantiable_control(GLOBAL, TC, instctxt) = instctxt = ANON

def $instantiable_control(BLOCK, TC, instctxt)
  = blockKind = CONTROL \/ blockKind = PACKAGE
  -- if blockKind = TC.BLOCK.KIND

def $instantiable_control(LOCAL, TC, instctxt)
  = localKind = CONTROL_APPLY_METHOD
  -- if localKind = TC.LOCAL.KIND

dec $instantiable_package(cursor, typingContext, instctxt) : bool

def $instantiable_package(GLOBAL, TC, instctxt) = true

def $instantiable_package(BLOCK, TC, instctxt) = blockKind = PACKAGE
  -- if blockKind = TC.BLOCK.KIND

def $instantiable_package(LOCAL, TC, instctxt) = false

dec $instantiable_table(cursor, typingContext, instctxt) : bool

def $instantiable_table(GLOBAL, TC, instctxt) = false

def $instantiable_table(BLOCK, TC, instctxt) = blockKind = CONTROL
  -- if blockKind = TC.BLOCK.KIND

def $instantiable_table(LOCAL, TC, instctxt) = false

dec $instantiable(cursor, typingContext, instctxt, typeIR) : bool

def $instantiable(p, TC, instctxt, typeIR)
  = $instantiable_extern(p, TC, instctxt)
  -- if typeIR_unroll = $unroll_typeIR(typeIR)
  -- if typeIR_unroll <: externObjectTypeIR

def $instantiable(p, TC, instctxt, typeIR)
  = $instantiable_parser(p, TC, instctxt)
  -- if typeIR_unroll = $unroll_typeIR(typeIR)
  -- if typeIR_unroll <: parserObjectTypeIR

def $instantiable(p, TC, instctxt, typeIR)
  = $instantiable_control(p, TC, instctxt)
  -- if typeIR_unroll = $unroll_typeIR(typeIR)
  -- if typeIR_unroll <: controlObjectTypeIR

def $instantiable(p, TC, instctxt, typeIR)
  = $instantiable_package(p, TC, instctxt)
  -- if typeIR_unroll = $unroll_typeIR(typeIR)
  -- if typeIR_unroll <: packageObjectTypeIR

def $instantiable(p, TC, instctxt, typeIR)
  = $instantiable_table(p, TC, instctxt)
  -- if typeIR_unroll = $unroll_typeIR(typeIR)
  -- if typeIR_unroll <: tableObjectTypeIR

rulegroup Inst_ok {

  rule Inst_ok/package:
    p TC instctxt
        |- constructorTypeIR `< typeArgumentIR* '#' typeId_infer* `>
        `( argumentIR* '#' id_default* '#' id_optional* `)
            : typeIR_object_inferred `< typeArgumentIR_inferred* `>
            `( argumentIR_cast* `)
    -- if CONSTRUCTOR `( parameterIR* `) ':' typeIR_object = constructorTypeIR
    -- if GIVEN parameterIR_aligned* DEFAULT _ OPTIONAL parameterIR_optional*
        = $align_parameterListIR(
            parameterIR*,
            argumentIR*,
            id_default*,
            id_optional*)
    -- if inference
        = $infer(
            typeId_infer*,
            parameterIR_aligned*,
            parameterIR_optional*,
            argumentIR*)
    -- (if (
      typeArgumentIR_inferred = $subst_typeIR(inference, typeArgumentIR)))*
    -- (if (
      parameterIR_aligned_inferred
          = $subst_parameterIR(inference, parameterIR_aligned)))*
    -- if typeIR_object_inferred = $subst_typeIR(inference, typeIR_object)
    -- if constructorTypeIR_inferred
        = CONSTRUCTOR `( parameterIR_aligned_inferred* `) ':'
        typeIR_object_inferred
    -- ConstructorType_wf: $bound(p, TC) |- constructorTypeIR_inferred
    -- if $instantiable(p, TC, instctxt, typeIR_object_inferred)
    -- if typeIR_object_unroll = $unroll_typeIR(typeIR_object)
    -- if typeIR_object_unroll <: packageObjectTypeIR
    -- if p = GLOBAL
    -- Call_convention_ok:
        BLOCK TC NOACTION
            |- parameterIR_aligned_inferred* '@' argumentIR* : argumentIR_cast*

  rule Inst_ok/non-package:
    p TC instctxt
        |- constructorTypeIR `< typeArgumentIR* '#' typeId_infer* `>
        `( argumentIR* '#' id_default* '#' id_optional* `)
            : typeIR_object_inferred `< typeArgumentIR_inferred* `>
            `( argumentIR_cast* `)
    -- if CONSTRUCTOR `( parameterIR* `) ':' typeIR_object = constructorTypeIR
    -- if GIVEN parameterIR_aligned* DEFAULT _ OPTIONAL parameterIR_optional*
        = $align_parameterListIR(
            parameterIR*,
            argumentIR*,
            id_default*,
            id_optional*)
    -- if inference
        = $infer(
            typeId_infer*,
            parameterIR_aligned*,
            parameterIR_optional*,
            argumentIR*)
    -- (if (
      typeArgumentIR_inferred = $subst_typeIR(inference, typeArgumentIR)))*
    -- (if (
      parameterIR_aligned_inferred
          = $subst_parameterIR(inference, parameterIR_aligned)))*
    -- if typeIR_object_inferred = $subst_typeIR(inference, typeIR_object)
    -- if constructorTypeIR_inferred
        = CONSTRUCTOR `( parameterIR_aligned_inferred* `) ':'
        typeIR_object_inferred
    -- ConstructorType_wf: $bound(p, TC) |- constructorTypeIR_inferred
    -- if $instantiable(p, TC, instctxt, typeIR_object_inferred)
    -- if typeIR_object_unroll = $unroll_typeIR(typeIR_object)
    -- if ~(typeIR_object_unroll <: packageObjectTypeIR)
    -- Call_convention_ok:
        p TC NOACTION
            |- parameterIR_aligned_inferred* '@' argumentIR* : argumentIR_cast*

}









rulegroup CallableTarget_ok {

  rule CallableTarget_ok/prefixedNonTypeName:
    p TC |- prefixedNonTypeName : prefixedNameIR
    -- if prefixedNameIR = $prefixedNonTypeName(prefixedNonTypeName)

  rule CallableTarget_ok/this:
    p TC |- THIS : (_BARE "this")

  rule CallableTarget_ok/memberAccessExpression-prefixedTypeName:
    p TC |- prefixedTypeName '.' member : TYPE prefixedNameIR '.' nameIR
    -- if prefixedNameIR = $prefixedTypeName(prefixedTypeName)
    -- if nameIR = $name(member)

  rule CallableTarget_ok/memberAccessExpression-expression:
    p TC |- expression_base '.' member : typedExpressionIR_base '.' nameIR
    -- if nameIR = $name(member)
    -- Expr_ok: p TC |- expression_base : typedExpressionIR_base

  rule CallableTarget_ok/parenthesizedExpression:
    p TC |- `( expression `) : `( callableTargetIR `)
    -- CallableTarget_ok: p TC |- expression : callableTargetIR

}





rule CallableTarget_lvalue_ok:
  p TC |- lvalue : callableTargetIR
  -- if expression = $lvalue_as_expression(lvalue)
  -- CallableTarget_ok: p TC |- expression : callableTargetIR





rule CallableType_ok/actionTypeIR:
  p TC
      |- prefixedNameIR `< eps `> `( argumentIR* `)
          : actionTypeIR `< '#' eps `> `( '#' id_default* '#' id_optional* `)
  -- if callableId ':' actionTypeIR '#' id_default* '#' id_optional*
      = $find_callableDef_overloaded_t(p, TC, prefixedNameIR, argumentIR*)

rule CallableType_ok/functionTypeIR:
  p TC
      |- prefixedNameIR `< typeArgumentIR* `> `( argumentIR* `)
          : functionTypeIR `< '#' typeId_impl* `>
          `( '#' id_default* '#' id_optional* `)
  -- if callableId ':' functionTypeDefIR '#' id_default* '#' id_optional*
      = $find_callableDef_overloaded_t(p, TC, prefixedNameIR, argumentIR*)
  -- if (functionTypeIR, typeId_impl*)
      = $specialize_callableTypeDefIR(functionTypeDefIR, typeArgumentIR*)





rule CallableType_ok/builtinMethodTypeIR-size:
  p TC
      |- (typedExpressionIR_base '.' nameIR) `< eps `> `( eps `)
          : methodTypeIR `< '#' eps `> `( '#' eps '#' eps `)
  -- if nameIR
      <- ["minSizeInBits", "minSizeInBytes", "maxSizeInBits", "maxSizeInBytes"]
  -- if typeIR_base = $type_of_typedExpressionIR(typedExpressionIR_base)
  -- if $is_serializable_typeIR(typeIR_base)
  -- if methodTypeIR = BUILTIN_SIZE_OF

rule CallableType_ok/builtinMethodTypeIR-header-stack-push-front:
  p TC
      |- (typedExpressionIR_base '.' "push_front") `< eps `> `( argumentIR `)
          : methodTypeIR `< '#' eps `> `( '#' eps '#' eps `)
  -- if typeIR_base = $type_of_typedExpressionIR(typedExpressionIR_base)
  -- if HEADER_STACK typeIR `[ _ `] = $unroll_typeIR(typeIR_base)
  -- if methodTypeIR = BUILTIN_PUSH_FRONT

rule CallableType_ok/builtinMethodTypeIR-header-stack-pop-front:
  p TC
      |- (typedExpressionIR_base '.' "pop_front") `< eps `> `( argumentIR `)
          : methodTypeIR `< '#' eps `> `( '#' eps '#' eps `)
  -- if typeIR_base = $type_of_typedExpressionIR(typedExpressionIR_base)
  -- if HEADER_STACK typeIR `[ _ `] = $unroll_typeIR(typeIR_base)
  -- if methodTypeIR = BUILTIN_POP_FRONT

rulegroup CallableType_ok/builtinMethodTypeIR-header {

  rule CallableType_ok/isValid:
    p TC
        |- (typedExpressionIR_base '.' "isValid") `< eps `> `( eps `)
            : methodTypeIR `< '#' eps `> `( '#' eps '#' eps `)
    -- if typeIR_base = $type_of_typedExpressionIR(typedExpressionIR_base)
    -- if HEADER _ `< _ `> `{ _ `} = $unroll_typeIR(typeIR_base)
    -- if methodTypeIR = BUILTIN_IS_VALID

  rule CallableType_ok/setValid:
    p TC
        |- (typedExpressionIR_base '.' "setValid") `< eps `> `( eps `)
            : methodTypeIR `< '#' eps `> `( '#' eps '#' eps `)
    -- if typeIR_base = $type_of_typedExpressionIR(typedExpressionIR_base)
    -- if HEADER _ `< _ `> `{ _ `} = $unroll_typeIR(typeIR_base)
    -- if methodTypeIR = BUILTIN_SET_VALID

  rule CallableType_ok/setInvalid:
    p TC
        |- (typedExpressionIR_base '.' "setInvalid") `< eps `> `( eps `)
            : methodTypeIR `< '#' eps `> `( '#' eps '#' eps `)
    -- if typeIR_base = $type_of_typedExpressionIR(typedExpressionIR_base)
    -- if HEADER _ `< _ `> `{ _ `} = $unroll_typeIR(typeIR_base)
    -- if methodTypeIR = BUILTIN_SET_INVALID

}

rule CallableType_ok/isValid:
  p TC
      |- (typedExpressionIR_base '.' "isValid") `< eps `> `( eps `)
          : methodTypeIR `< '#' eps `> `( '#' eps '#' eps `)
  -- if typeIR_base = $type_of_typedExpressionIR(typedExpressionIR_base)
  -- if HEADER_UNION _ `< _ `> `{ _ `} = $unroll_typeIR(typeIR_base)
  -- if methodTypeIR = BUILTIN_IS_VALID

rule CallableType_ok/externMethodTypeIR:
  p TC
      |- (typedExpressionIR_base '.' nameIR) `< typeArgumentIR* `>
      `( argumentIR* `)
          : externMethodTypeIR `< '#' typeId_impl* `>
          `( '#' id_default* '#' id_optional* `)
  -- if typeIR_base = $type_of_typedExpressionIR(typedExpressionIR_base)
  -- if EXTERN typeId `< _ `>
  `{ (callableId_extern ':' externMethodTypeDefIR_extern)* `}
      = $unroll_typeIR(typeIR_base)
  -- if callTargetKey = $callTargetKey(nameIR, argumentIR*)
  -- if _ ':' externMethodTypeDefIR '#' id_default* '#' id_optional*
      = $find_overloaded<externMethodTypeDefIR>(
          `{ (callableId_extern ':' externMethodTypeDefIR_extern)* `},
          callTargetKey,
          def $parameterListIR_of_externMethodTypeDefIR)
  -- if (externMethodTypeIR, typeId_impl*)
      = $specialize_callableTypeDefIR(externMethodTypeDefIR, typeArgumentIR*)

rule CallableType_ok/parserApplyMethodTypeIR:
  p TC
      |- (typedExpressionIR_base '.' "apply") `< eps `> `( argumentIR* `)
          : parserApplyMethodTypeIR `< '#' eps `>
          `( '#' id_default* '#' id_optional* `)
  -- if typeIR_base = $type_of_typedExpressionIR(typedExpressionIR_base)
  -- if PARSER _ `< _ `> `( parameterIR* `) = $unroll_typeIR(typeIR_base)
  -- if parserApplyMethodTypeIR = PARSER_APPLY `( parameterIR* `)
  -- (if (_ _ _ id_param _ = parameterIR))*
  -- if callableId = "apply" `( id_param* `)
  -- if callTargetKey = $callTargetKey("apply", argumentIR*)
  -- if _ ':' _ '#' id_default* '#' id_optional*
      = $find_overloaded<parserApplyMethodTypeIR>(
          `{ (callableId ':' parserApplyMethodTypeIR) `},
          callTargetKey,
          def $parameterListIR_of_parserApplyMethodTypeIR)

rule CallableType_ok/controlApplyMethodTypeIR:
  p TC
      |- (typedExpressionIR_base '.' "apply") `< eps `> `( argumentIR* `)
          : controlApplyMethodTypeIR `< '#' eps `>
          `( '#' id_default* '#' id_optional* `)
  -- if typeIR_base = $type_of_typedExpressionIR(typedExpressionIR_base)
  -- if CONTROL _ `< _ `> `( parameterIR* `) = $unroll_typeIR(typeIR_base)
  -- if controlApplyMethodTypeIR = CONTROL_APPLY `( parameterIR* `)
  -- (if (_ _ _ id_param _ = parameterIR))*
  -- if callableId = "apply" `( id_param* `)
  -- if callTargetKey = $callTargetKey("apply", argumentIR*)
  -- if _ ':' _ '#' id_default* '#' id_optional*
      = $find_overloaded<controlApplyMethodTypeDefIR>(
          `{ (callableId ':' controlApplyMethodTypeIR) `},
          callTargetKey,
          def $parameterListIR_of_controlApplyMethodTypeIR)

rule CallableType_ok/tableApplyMethodTypeIR:
  p TC
      |- (typedExpressionIR_base '.' "apply") `< eps `> `( eps `)
          : tableApplyMethodTypeIR `< '#' eps `> `( '#' eps '#' eps `)
  -- if typeIR_base = $type_of_typedExpressionIR(typedExpressionIR_base)
  -- if TABLE _ `{ tableMetadataStructTypeIR `} = $unroll_typeIR(typeIR_base)
  -- if tableApplyMethodTypeIR = TABLE_APPLY ':' tableMetadataStructTypeIR





rule CallableType_ok/parenthesized:
  p TC
      |- (`( callableTargetIR `)) `< typeArgumentIR* `> `( argumentIR* `)
          : callableTypeIR `< '#' typeId_inserted* `>
          `( '#' id_default* '#' id_optional* `)
  -- CallableType_ok:
      p TC
          |- callableTargetIR `< typeArgumentIR* `> `( argumentIR* `)
              : callableTypeIR `< '#' typeId_inserted* `>
              `( '#' id_default* '#' id_optional* `)









dec $callable_action(cursor, typingContext) : bool

def $callable_action(GLOBAL, TC) = false

def $callable_action(BLOCK, TC) = false

def $callable_action(LOCAL, TC)
  = (localKind = ACTION) \/ (localKind = CONTROL_APPLY_METHOD)
  -- if localKind = TC.LOCAL.KIND

rule Call_ok/actionTypeIR:
  p TC
      |- actionTypeIR `< eps '#' eps `>
      `( argumentIR* '#' id_default* '#' id_optional* `)
          : VOID `< eps `> `( argumentIR_cast* `)
  -- if _ ACTION _ `( parameterIR* `) = actionTypeIR
  -- if GIVEN parameterIR_aligned* DEFAULT _ OPTIONAL _
      = $align_parameterListIR(
          parameterIR*,
          argumentIR*,
          id_default*,
          id_optional*)
  -- if $callable_action(p, TC)
  -- Call_convention_ok:
      p TC ACTION |- parameterIR_aligned* '@' argumentIR* : argumentIR_cast*





dec $callable_definedFunction(cursor, typingContext) : bool

def $callable_definedFunction(GLOBAL, TC) = false

def $callable_definedFunction(BLOCK, TC)
  = (blockKind = PARSER) \/ (blockKind = CONTROL)
  -- if blockKind = TC.BLOCK.KIND

def $callable_definedFunction(LOCAL, TC) = ~(localKind <: externMethodLocalKind)
  -- if localKind = TC.LOCAL.KIND

rule Call_ok/definedFunctionTypeIR:
  p TC
      |- definedFunctionTypeIR `< typeArgumentIR* '#' typeId_infer* `>
      `( argumentIR* '#' id_default* '#' id_optional* `)
          : typeIR_ret_inferred `< typeArgumentIR_inferred* `>
          `( argumentIR_cast* `)
  -- if FUNCTION nameIR `( parameterIR* `) ':' typeIR_ret
      = definedFunctionTypeIR
  -- if GIVEN parameterIR_aligned* DEFAULT _ OPTIONAL parameterIR_optional*
      = $align_parameterListIR(
          parameterIR*,
          argumentIR*,
          id_default*,
          id_optional*)
  -- if inference
      = $infer(
          typeId_infer*,
          parameterIR_aligned*,
          parameterIR_optional*,
          argumentIR*)
  -- (if (typeArgumentIR_inferred = $subst_typeIR(inference, typeArgumentIR)))*
  -- (if (
    parameterIR_aligned_inferred
        = $subst_parameterIR(inference, parameterIR_aligned)))*
  -- if typeIR_ret_inferred = $subst_typeIR(inference, typeIR_ret)
  -- if functionTypeIR_inferred
      = FUNCTION nameIR `( parameterIR_aligned_inferred* `) ':'
      typeIR_ret_inferred
  -- if B = $bound(p, TC)
  -- CallableType_wf: B |- functionTypeIR_inferred
  -- if $callable_definedFunction(p, TC)
  -- Call_convention_ok:
      p TC NOACTION
          |- parameterIR_aligned_inferred* '@' argumentIR* : argumentIR_cast*





dec $callable_externFunction(cursor, typingContext, nameIR) : bool

def $callable_externFunction(GLOBAL, TC, nameIR) = false
  -- if nameIR = "verify"

def $callable_externFunction(GLOBAL, TC, nameIR) = true
  -- if nameIR =/= "verify"

def $callable_externFunction(BLOCK, TC, nameIR) = blockKind = PARSER
  -- if nameIR = "verify"
  -- if blockKind = TC.BLOCK.KIND

def $callable_externFunction(BLOCK, TC, nameIR)
  = (blockKind = PARSER) \/ (blockKind = CONTROL)
  -- if nameIR =/= "verify"
  -- if blockKind = TC.BLOCK.KIND

def $callable_externFunction(LOCAL, TC, nameIR) = localKind = PARSER_STATE
  -- if nameIR = "verify"
  -- if localKind = TC.LOCAL.KIND

def $callable_externFunction(LOCAL, TC, nameIR) = true
  -- if nameIR =/= "verify"

rule Call_ok/externFunctionTypeIR:
  p TC
      |- externFunctionTypeIR `< typeArgumentIR* '#' typeId_infer* `>
      `( argumentIR* '#' id_default* '#' id_optional* `)
          : typeIR_ret_inferred `< typeArgumentIR_inferred* `>
          `( argumentIR_cast* `)
  -- if EXTERN_FUNCTION nameIR `( parameterIR* `) ':' typeIR_ret
      = externFunctionTypeIR
  -- if GIVEN parameterIR_aligned* DEFAULT _ OPTIONAL parameterIR_optional*
      = $align_parameterListIR(
          parameterIR*,
          argumentIR*,
          id_default*,
          id_optional*)
  -- if inference
      = $infer(
          typeId_infer*,
          parameterIR_aligned*,
          parameterIR_optional*,
          argumentIR*)
  -- (if (typeArgumentIR_inferred = $subst_typeIR(inference, typeArgumentIR)))*
  -- (if (
    parameterIR_aligned_inferred
        = $subst_parameterIR(inference, parameterIR_aligned)))*
  -- if typeIR_ret_inferred = $subst_typeIR(inference, typeIR_ret)
  -- if externFunctionTypeIR_inferred
      = EXTERN_FUNCTION nameIR `( parameterIR_aligned_inferred* `) ':'
      typeIR_ret_inferred
  -- if B = $bound(p, TC)
  -- CallableType_wf: B |- externFunctionTypeIR_inferred
  -- if $callable_externFunction(p, TC, nameIR)
  -- Call_convention_ok:
      p TC NOACTION
          |- parameterIR_aligned_inferred* '@' argumentIR* : argumentIR_cast*





rule Call_ok/builtinMethodTypeIR:
  p TC
      |- builtinMethodTypeIR `< typeArgumentIR* '#' eps `>
      `( argumentIR* '#' id_default* '#' id_optional* `)
          : typeIR_ret `< typeArgumentIR* `> `( argumentIR_cast* `)
  -- if (parameterIR*, typeIR_ret)
      = $signature_of_builtinMethodTypeIR(builtinMethodTypeIR)
  -- if GIVEN parameterIR_aligned* DEFAULT _ OPTIONAL _
      = $align_parameterListIR(
          parameterIR*,
          argumentIR*,
          id_default*,
          id_optional*)
  -- Call_convention_ok:
      p TC NOACTION |- parameterIR_aligned* '@' argumentIR* : argumentIR_cast*





dec $callable_externMethod(cursor, typingContext) : bool

def $callable_externMethod(GLOBAL, TC) = false

def $callable_externMethod(BLOCK, TC)
  = (blockKind = PARSER) \/ (blockKind = CONTROL)
  -- if blockKind = TC.BLOCK.KIND

def $callable_externMethod(LOCAL, TC) = true

rulegroup Call_ok/externMethodTypeIR {

  rule Call_ok/non-abstract:
    p TC
        |- externMethodTypeIR `< typeArgumentIR* '#' typeId_infer* `>
        `( argumentIR* '#' id_default* '#' id_optional* `)
            : typeIR_ret_inferred `< typeArgumentIR_inferred* `>
            `( argumentIR_cast* `)
    -- if EXTERN_METHOD nameIR `( parameterIR* `) ':' typeIR_ret
        = externMethodTypeIR
    -- if GIVEN parameterIR_aligned* DEFAULT _ OPTIONAL parameterIR_optional*
        = $align_parameterListIR(
            parameterIR*,
            argumentIR*,
            id_default*,
            id_optional*)
    -- if inference
        = $infer(
            typeId_infer*,
            parameterIR_aligned*,
            parameterIR_optional*,
            argumentIR*)
    -- (if (
      typeArgumentIR_inferred = $subst_typeIR(inference, typeArgumentIR)))*
    -- (if (
      parameterIR_aligned_inferred
          = $subst_parameterIR(inference, parameterIR_aligned)))*
    -- if typeIR_ret_inferred = $subst_typeIR(inference, typeIR_ret)
    -- if externMethodTypeIR_inferred
        = EXTERN_METHOD nameIR `( parameterIR_aligned_inferred* `) ':'
        typeIR_ret_inferred
    -- if B = $bound(p, TC)
    -- CallableType_wf: B |- externMethodTypeIR_inferred
    -- if $callable_externMethod(p, TC)
    -- Call_convention_ok:
        p TC NOACTION
            |- parameterIR_aligned_inferred* '@' argumentIR* : argumentIR_cast*

  rule Call_ok/abstract:
    p TC
        |- externMethodTypeIR `< typeArgumentIR* '#' typeId_infer* `>
        `( argumentIR* '#' id_default* '#' id_optional* `)
            : typeIR_ret_inferred `< typeArgumentIR_inferred* `>
            `( argumentIR_cast* `)
    -- if EXTERN_METHOD ABSTRACT nameIR `( parameterIR* `) ':' typeIR_ret
        = externMethodTypeIR
    -- if GIVEN parameterIR_aligned* DEFAULT _ OPTIONAL parameterIR_optional*
        = $align_parameterListIR(
            parameterIR*,
            argumentIR*,
            id_default*,
            id_optional*)
    -- if inference
        = $infer(
            typeId_infer*,
            parameterIR_aligned*,
            parameterIR_optional*,
            argumentIR*)
    -- (if (
      typeArgumentIR_inferred = $subst_typeIR(inference, typeArgumentIR)))*
    -- (if (
      parameterIR_aligned_inferred
          = $subst_parameterIR(inference, parameterIR_aligned)))*
    -- if typeIR_ret_inferred = $subst_typeIR(inference, typeIR_ret)
    -- if externMethodTypeIR_inferred
        = EXTERN_METHOD ABSTRACT nameIR `( parameterIR_aligned_inferred* `) ':'
        typeIR_ret_inferred
    -- if B = $bound(p, TC)
    -- CallableType_wf: B |- externMethodTypeIR_inferred
    -- if $callable_externMethod(p, TC)
    -- Call_convention_ok:
        p TC NOACTION
            |- parameterIR_aligned_inferred* '@' argumentIR* : argumentIR_cast*

}





dec $callable_parserApplyMethod(cursor, typingContext) : bool

def $callable_parserApplyMethod(GLOBAL, TC) = false

def $callable_parserApplyMethod(BLOCK, TC) = false

def $callable_parserApplyMethod(LOCAL, TC) = localKind = PARSER_STATE
  -- if localKind = TC.LOCAL.KIND

