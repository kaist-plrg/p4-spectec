dec $init_table(tablePropertyListIR) : tableObjectProperty

dec $init_tableKeys(tablePropertyListIR) : tableKeysPropertyIR

dec $init_tableEntries(tablePropertyListIR) : tableEntriesPropertyIR

def $init_tableKeys(tablePropertyIR*) = tableKeysPropertyIR
  -- if [tableKeysPropertyIR]
      = $filter_<tablePropertyIR>(
          tablePropertyIR*,
          (tablePropertyIR <: tableKeysPropertyIR)*)

def $init_tableKeys(tablePropertyIR*) = KEY '=' `{ eps `}
  -- if eps
      = $filter_<tablePropertyIR>(
          tablePropertyIR*,
          (tablePropertyIR <: tableKeysPropertyIR)*)

def $init_tableEntries(tablePropertyIR*) = tableEntriesPropertyIR
  -- if [tableEntriesPropertyIR]
      = $filter_<tablePropertyIR>(
          tablePropertyIR*,
          (tablePropertyIR <: tableEntriesPropertyIR)*)

def $init_tableEntries(tablePropertyIR*) = _EMPTY eps ENTRIES '=' `{ eps `}
  -- if eps
      = $filter_<tablePropertyIR>(
          tablePropertyIR*,
          (tablePropertyIR <: tableEntriesPropertyIR)*)

def $init_table(tablePropertyIR*) = TBL
  -- if tableKeysPropertyIR = $init_tableKeys(tablePropertyIR*)
  -- if [tableActionsPropertyIR]
      = $filter_<tablePropertyIR>(
          tablePropertyIR*,
          (tablePropertyIR <: tableActionsPropertyIR)*)
  -- if [tableDefaultActionPropertyIR]
      = $filter_<tablePropertyIR>(
          tablePropertyIR*,
          (tablePropertyIR <: tableDefaultActionPropertyIR)*)
  -- if tableEntriesPropertyIR = $init_tableEntries(tablePropertyIR*)
  -- if tableCustomPropertyIR*
      = $filter_<tablePropertyIR>(
          tablePropertyIR*,
          (tablePropertyIR <: tableCustomPropertyIR)*)
  -- if TBL
      = {
        KEYS tableKeysPropertyIR,
        ACTIONS tableActionsPropertyIR,
        DEFAULT_ACTION tableDefaultActionPropertyIR,
        ENTRIES tableEntriesPropertyIR,
        CUSTOMS tableCustomPropertyIR*
      }





