dec $add_type_i(cursor, instContext, typeId, typeIR) : instContext

dec $add_types_i(cursor, instContext, typeId*, typeIR*) : instContext

def $add_type_i(BLOCK, IC, typeId, typeIR) = IC[BLOCK.TYPE = theta]
  -- if theta = $add_map<typeId, typeIR>(IC.BLOCK.TYPE, typeId, typeIR)

def $add_type_i(LOCAL, IC, typeId, typeIR) = IC[LOCAL.TYPE = theta]
  -- if theta = $add_map<typeId, typeIR>(IC.LOCAL.TYPE, typeId, typeIR)

def $add_types_i(p, IC, eps, eps) = IC

def $add_types_i(p, IC, typeId_h :: typeId_t*, typeIR_h :: typeIR_t*)
  = $add_types_i(p, IC', typeId_t*, typeIR_t*)
  -- if IC' = $add_type_i(p, IC, typeId_h, typeIR_h)





dec $add_callableDef_overload_i(cursor, instContext, callableId, callableDef)
  : instContext

def $add_callableDef_overload_i(GLOBAL, IC, callableId, callableDef)
  = IC[GLOBAL.CALLABLE = callableDefEnv]
  -- if ~$in_set<callableId>(
      callableId,
      $dom_map<callableId, callableDef>(IC.GLOBAL.CALLABLE))
  -- if callableDefEnv
      = $add_map<callableId, callableDef>(
          IC.GLOBAL.CALLABLE,
          callableId,
          callableDef)

def $add_callableDef_overload_i(BLOCK, IC, callableId, callableDef)
  = IC[BLOCK.CALLABLE = callableDefEnv]
  -- if ~$in_set<callableId>(
      callableId,
      $dom_map<callableId, callableDef>(IC.BLOCK.CALLABLE))
  -- if callableDefEnv
      = $add_map<callableId, callableDef>(
          IC.BLOCK.CALLABLE,
          callableId,
          callableDef)

dec $add_callableDef_non_overload_i(
    cursor,
    instContext,
    callableId,
    callableDef)
  : instContext

def $add_callableDef_non_overload_i(GLOBAL, IC, callableId, callableDef)
  = IC[GLOBAL.CALLABLE = callableDefEnv]
  -- if id `( _ `) = callableId
  -- if `{ (id_k `( _ `))* `}
      = $dom_map<callableId, callableDef>(IC.GLOBAL.CALLABLE)
  -- if ~$in_set<id>(id, `{ id_k* `})
  -- if callableDefEnv
      = $add_map<callableId, callableDef>(
          IC.GLOBAL.CALLABLE,
          callableId,
          callableDef)

def $add_callableDef_non_overload_i(BLOCK, IC, callableId, callableDef)
  = IC[BLOCK.CALLABLE = callableDefEnv]
  -- if id `( _ `) = callableId
  -- if `{ (id_k `( _ `))* `}
      = $dom_map<callableId, callableDef>(IC.BLOCK.CALLABLE)
  -- if ~$in_set<id>(id, `{ id_k* `})
  -- if callableDefEnv
      = $add_map<callableId, callableDef>(
          IC.BLOCK.CALLABLE,
          callableId,
          callableDef)





dec $find_callableDef_non_overload_i(cursor, instContext, prefixedNameIR)
  : (cursor, callableId, callableDef)?

def $find_callableDef_non_overload_i(p, IC, '.' nameIR) = eps
  -- if eps = $find_non_overloaded<callableDef>(IC.GLOBAL.CALLABLE, nameIR)

def $find_callableDef_non_overload_i(p, IC, '.' nameIR)
  = (GLOBAL, callableId, callableDef)
  -- if (callableId, callableDef)
      = $find_non_overloaded<callableDef>(IC.GLOBAL.CALLABLE, nameIR)

def $find_callableDef_non_overload_i(GLOBAL, IC, _BARE nameIR)
  = $find_callableDef_non_overload_i(GLOBAL, IC, '.' nameIR)

def $find_callableDef_non_overload_i(BLOCK, IC, _BARE nameIR)
  = (BLOCK, callableId, callableDef)
  -- if (callableId, callableDef)
      = $find_non_overloaded<callableDef>(IC.BLOCK.CALLABLE, nameIR)

def $find_callableDef_non_overload_i(BLOCK, IC, _BARE nameIR)
  = $find_callableDef_non_overload_i(GLOBAL, IC, _BARE nameIR)
  -- if eps = $find_non_overloaded<callableDef>(IC.BLOCK.CALLABLE, nameIR)

def $find_callableDef_non_overload_i(LOCAL, IC, _BARE nameIR)
  = $find_callableDef_non_overload_i(BLOCK, IC, _BARE nameIR)





dec $add_constructorDef_i(instContext, callableId, constructorDef) : instContext

dec $add_constructorDefs_i(instContext, callableId*, constructorDef*)
  : instContext

def $add_constructorDef_i(IC, callableId, constructorDef)
  = IC[GLOBAL.CONSTRUCTOR = constructorDefEnv]
  -- if constructorDefEnv
      = $add_map<callableId, constructorDef>(
          IC.GLOBAL.CONSTRUCTOR,
          callableId,
          constructorDef)

def $add_constructorDefs_i(IC, eps, eps) = IC

def $add_constructorDefs_i(
    IC,
    callableId_h :: callableId_t*,
    constructorDef_h :: constructorDef_t*)
  = IC''
  -- if IC' = $add_constructorDef_i(IC, callableId_h, constructorDef_h)
  -- if IC'' = $add_constructorDefs_i(IC', callableId_t*, constructorDef_t*)





dec $find_var_i(prefixedNameIR, cursor, instContext) : value

def $find_var_i('.' id, p, IC) = value
  -- if value = $find_map<id, value>(IC.GLOBAL.FRAME, id)

def $find_var_i(_BARE id, GLOBAL, IC) = value
  -- if value = $find_map<id, value>(IC.GLOBAL.FRAME, id)

def $find_var_i(_BARE id, BLOCK, IC) = value
  -- if value = $find_map<id, value>(IC.BLOCK.FRAME, id)

def $find_var_i(_BARE id, BLOCK, IC) = $find_var_i(_BARE id, GLOBAL, IC)
  -- if eps = $find_map<id, value>(IC.BLOCK.FRAME, id)

def $find_var_i(_BARE id, LOCAL, IC) = value
  -- if value = $find_maps<id, value>(IC.LOCAL.FRAMES, id)

def $find_var_i(_BARE id, LOCAL, IC) = $find_var_i(_BARE id, BLOCK, IC)
  -- if eps = $find_maps<id, value>(IC.LOCAL.FRAMES, id)





dec $find_typeDef_i(cursor, instContext, prefixedNameIR) : typeDefIR?

def $find_typeDef_i(_, IC, _BARE nameIR)
  = $find_map<typeId, typeDefIR>(IC.GLOBAL.TYPE, nameIR)

def $find_typeDef_i(_, IC, '.' nameIR)
  = $find_map<typeId, typeDefIR>(IC.GLOBAL.TYPE, nameIR)





dec $find_constructorDef_i(instContext, prefixedNameIR, argumentIR*)
  : callResolution<constructorDef>?

def $find_constructorDef_i(IC, _BARE nameIR, argumentIR*)
  = $find_overloaded<constructorDef>(
      IC.GLOBAL.CONSTRUCTOR,
      callTargetKey,
      def $parameterListIR_of_constructorDef)
  -- if callTargetKey = $callTargetKey(nameIR, argumentIR*)

def $find_constructorDef_i(IC, '.' nameIR, argumentIR*)
  = $find_overloaded<constructorDef>(
      IC.GLOBAL.CONSTRUCTOR,
      callTargetKey,
      def $parameterListIR_of_constructorDef)
  -- if callTargetKey = $callTargetKey(nameIR, argumentIR*)





dec $subst_type_i(cursor, instContext, typeIR) : typeIR

def $subst_type_i(GLOBAL, IC, typeIR) = typeIR

def $subst_type_i(BLOCK, IC, typeIR) = typeIR_subst
  -- if theta = IC.BLOCK.TYPE
  -- if typeIR_subst = $subst_typeIR(theta, typeIR)

def $subst_type_i(LOCAL, IC, typeIR) = typeIR_subst
  -- if theta_block = IC.BLOCK.TYPE
  -- if theta_local = IC.LOCAL.TYPE
  -- if theta = $extend_map<typeId, typeIR>(theta_block, theta_local)
  -- if typeIR_subst = $subst_typeIR(theta, typeIR)

relation Expr_inst:
  cursor instContext store |- typedExpressionIR : store value

relation Exprs_inst:
  cursor instContext store |- typedExpressionIR* : store value*





relation Argument_inst:
  cursor instContext store |- argumentIR : store value





relation DirectApplicationStmt_inst:
  cursor instContext store
      |- directApplicationStatementIR
          : store constantDeclarationIR callStatementIR

relation Stmt_inst:
  cursor instContext store |- statementIR : instContext store statementIR

relation BlockElementStmt_inst:
  instContext store
      |- blockElementStatementIR : instContext store blockElementStatementIR

relation BlockElementStmtList_inst:
  instContext store
      |- blockElementStatementListIR
          : instContext store blockElementStatementIR*

relation Block_inst:
  instContext store |- blockStatementIR : instContext store blockStatementIR





relation ExternMethod_inst:
  instContext |- externMethodPrototypeIR : instContext

relation ExternMethods_inst:
  instContext |- externMethodPrototypeIR* : instContext





relation ParserStmt_inst:
  instContext store |- parserStatementIR : instContext store parserStatementIR

relation ParserBlockElementStmt_inst:
  instContext store
      |- parserBlockElementStatementIR
          : instContext store parserBlockElementStatementIR

relation ParserBlockElementStmtList_inst:
  instContext store
      |- parserBlockElementStatementListIR
          : instContext store parserBlockElementStatementIR*

relation ParserBlock_inst:
  instContext store
      |- parserBlockStatementIR : instContext store parserBlockStatementIR

relation ParserState_inst:
  instContext store |- parserStateIR : instContext store

relation ParserStates_inst:
  instContext store |- parserStateIR* : instContext store

relation ParserLocalDecl_inst:
  instContext store
      |- parserLocalDeclarationIR : instContext store parserLocalDeclarationIR

relation ParserLocalDecls_inst:
  instContext store
      |- parserLocalDeclarationIR* : instContext store parserLocalDeclarationIR*





relation TableAction_inst:
  instContext store |- tableActionIR : store tableActionIR

relation TableActions_inst:
  instContext store |- tableActionIR* : store tableActionIR*

relation TableProperty_inst:
  instContext store |- tablePropertyIR : store tablePropertyIR

relation TableProperties_inst:
  instContext store |- tablePropertyIR* : store tablePropertyIR*

relation ControlLocalDecl_inst:
  instContext store
      |- controlLocalDeclarationIR
          : instContext store controlLocalDeclarationIR?

relation ControlLocalDecls_inst:
  instContext store
      |- controlLocalDeclarationIR*
          : instContext store controlLocalDeclarationIR*





relation ConstDecl_inst:
  cursor instContext |- constantDeclarationIR : instContext

relation InstDecl_inst:
  cursor instContext store
      |- instantiationIR : instContext store constantDeclarationIR

relation FuncDecl_inst:
  cursor instContext |- functionDeclarationIR : instContext

relation ActionDecl_inst:
  cursor instContext |- actionDeclarationIR : instContext

relation Decl_inst:
  instContext store |- declarationIR : instContext store

relation Decls_inst:
  instContext store |- declarationIR* : instContext store

relation Program_inst:
   |- p4program : globalInstLayer store





relation Copy_in_arg_inst:
  store cursor instContext argumentIR '@' cursor instContext id
      ~> store instContext

relation Copy_in_inst:
  store cursor instContext argumentIR* '@' cursor instContext id*
      ~> store instContext

relation Copy_in_arg_inst_default:
  store cursor instContext '@' cursor instContext parameterIR
      ~> store instContext

relation Copy_in_inst_default:
  store cursor instContext '@' cursor instContext parameterIR*
      ~> store instContext





relation Constructor_inst:
  cursor instContext
      |- prefixedNameIR `< typeArgumentListIR `> `( argumentListIR `)
          : constructorDef `< typeArgumentListIR `> `( '#' id* '#' id* `)

relation Constructor_call:
  cursor instContext store
      |- constructorDef `< typeArgumentListIR `>
      `( argumentListIR '#' id* '#' id* `)
          : store object





rulegroup Expr_inst/literalExpressionIR {

  rule Expr_inst/booleanLiteral:
    p IC STO |- booleanLiteral '#' _ : STO boolValue
    -- if boolValue = $ite<boolValue>(booleanLiteral = TRUE, _B true, _B false)

  rule Expr_inst/integerLiteral:
    p IC STO |- integerLiteral '#' _ : STO integerLiteral

  rule Expr_inst/stringLiteral:
    p IC STO |- stringLiteral '#' _ : STO stringLiteral

}





rule Expr_inst/referenceExpressionIR:
  p IC STO |- prefixedNameIR '#' _ : STO value
  -- if value = $find_var_i(prefixedNameIR, p, IC)





rule Expr_inst/defaultExpressionIR:
  p IC STO |- '...' '#' _ : STO DEFAULT





rule Expr_inst/unaryExpressionIR:
  p IC STO_0 |- (unop typedExpressionIR) '#' _ : STO_1 $un_op(unop, value)
  -- Expr_inst: p IC STO_0 |- typedExpressionIR : STO_1 value





rulegroup Expr_inst/binaryExpressionIR {

  rule Expr_inst/non-short-circuit:
    p IC STO_0
        |- (typedExpressionIR_l binop typedExpressionIR_r) '#' _
            : STO_2 $bin_op(binop, value_l, value_r)
    -- if ~(binop <- ['&&', '||'])
    -- Expr_inst: p IC STO_0 |- typedExpressionIR_l : STO_1 value_l
    -- Expr_inst: p IC STO_1 |- typedExpressionIR_r : STO_2 value_r

  rule Expr_inst/land-false:
    p IC STO_0
        |- (typedExpressionIR_l '&&' typedExpressionIR_r) '#' _
            : STO_1 (_B false)
    -- Expr_inst: p IC STO_0 |- typedExpressionIR_l : STO_1 (_B false)

  rule Expr_inst/land-true:
    p IC STO_0
        |- (typedExpressionIR_l '&&' typedExpressionIR_r) '#' _ : STO_2 value_r
    -- Expr_inst: p IC STO_0 |- typedExpressionIR_l : STO_1 (_B true)
    -- Expr_inst: p IC STO_1 |- typedExpressionIR_r : STO_2 value_r

  rule Expr_inst/lor-true:
    p IC STO_0
        |- (typedExpressionIR_l '||' typedExpressionIR_r) '#' _
            : STO_1 (_B true)
    -- Expr_inst: p IC STO_0 |- typedExpressionIR_l : STO_1 (_B true)

  rule Expr_inst/lor-false:
    p IC STO_0
        |- (typedExpressionIR_l '||' typedExpressionIR_r) '#' _ : STO_2 value_r
    -- Expr_inst: p IC STO_0 |- typedExpressionIR_l : STO_1 (_B false)
    -- Expr_inst: p IC STO_1 |- typedExpressionIR_r : STO_2 value_r

}





rulegroup Expr_inst/ternaryExpressionIR {

  rule Expr_inst/true:
    p IC STO_0
        |- (
          typedExpressionIR_cond '?' typedExpressionIR_true ':'
          typedExpressionIR_false) '#' _
            : STO_2 value_true
    -- Expr_inst: p IC STO_0 |- typedExpressionIR_cond : STO_1 (_B true)
    -- Expr_inst: p IC STO_1 |- typedExpressionIR_true : STO_2 value_true

  rule Expr_inst/false:
    p IC STO_0
        |- (
          typedExpressionIR_cond '?' typedExpressionIR_true ':'
          typedExpressionIR_false) '#' _
            : STO_2 value_false
    -- Expr_inst: p IC STO_0 |- typedExpressionIR_cond : STO_1 (_B false)
    -- Expr_inst: p IC STO_1 |- typedExpressionIR_false : STO_2 value_false

}





rule Expr_inst/castExpressionIR:
  p IC STO_0 |- (`( typeIR `) typedExpressionIR) '#' _ : STO_1 value_cast
  -- Expr_inst: p IC STO_0 |- typedExpressionIR : STO_1 value
  -- if value_cast = $cast_op(typeIR, value)





rule Expr_inst/invalidHeaderExpressionIR:
  p IC STO |- '{#}' '#' _ : STO '{#}'





rulegroup Expr_inst/sequenceExpressionIR {

  rule Expr_inst/non-default:
    p IC STO_0
        |- (SEQ `{ typedExpressionListIR `}) '#' _ : STO_1 (SEQ `( value* `))
    -- Exprs_inst: p IC STO_0 |- typedExpressionListIR : STO_1 value*

  rule Expr_inst/default:
    p IC STO_0
        |- (SEQ `{ typedExpressionListIR ',' '...' `}) '#' _
            : STO_1 (SEQ `( value* ',' '...' `))
    -- Exprs_inst: p IC STO_0 |- typedExpressionListIR : STO_1 value*

}





rulegroup Expr_inst/recordExpressionIR {

  rule Expr_inst/non-default:
    p IC STO_0
        |- (RECORD `{ (nameIR '=' typedExpressionIR)* `}) '#' _
            : STO_1 (RECORD `{ (value nameIR ';')* `})
    -- Exprs_inst: p IC STO_0 |- typedExpressionIR* : STO_1 value*

  rule Expr_inst/default:
    p IC STO_0
        |- (RECORD `{ (nameIR '=' typedExpressionIR)* ',' '...' `}) '#' _
            : STO_1 (RECORD `{ (value nameIR ';')* ',' '...' `})
    -- Exprs_inst: p IC STO_0 |- typedExpressionIR* : STO_1 value*

}





rule Expr_inst/errorAccessExpressionIR:
  p IC STO |- (ERROR '.' nameIR) '#' _ : STO value_error
  -- if nameIR_error = "error." ++ nameIR
  -- if value_error = $find_var_i(_BARE nameIR_error, p, IC)





rulegroup Expr_inst/memberAccessExpressionIR-type {

  rule Expr_inst/enum:
    p IC STO
        |- ((TYPE prefixedNameIR) '.' nameIR) '#' _ : STO (typeId '.' nameIR)
    -- if ENUM typeId `{ _ `} = $find_typeDef_i(p, IC, prefixedNameIR)

  rule Expr_inst/serenum:
    p IC STO
        |- ((TYPE prefixedNameIR) '.' nameIR) '#' _
            : STO (typeId '.' nameIR '.' value)
    -- if ENUM typeId `< _ `> `{ (id_member '=' value_member ';')* `}
        = $find_typeDef_i(p, IC, prefixedNameIR)
    -- if value = $assoc_<nameIR, value>(nameIR, (id_member, value_member)*)

}





rulegroup Expr_inst/memberAccessExpressionIR-typedExpressionIR {

  rule Expr_inst/header-stack-size:
    p IC STO |- (typedExpressionIR_base '.' nameIR) '#' _ : STO (32 W n_size)
    -- if typeIR_base = $type_of_typedExpressionIR(typedExpressionIR_base)
    -- if HEADER_STACK _ `[ n_size `] = $unroll_typeIR(typeIR_base)
    -- if nameIR = "size"

  rule Expr_inst/struct:
    p IC STO_0 |- (typedExpressionIR_base '.' nameIR) '#' _ : STO_1 value
    -- Expr_inst: p IC STO_0 |- typedExpressionIR_base : STO_1 structValue
    -- if STRUCT _ `{ (value_field id_field ';')* `} = structValue
    -- if value = $assoc_<id, value>(nameIR, (id_field, value_field)*)

  rule Expr_inst/header:
    p IC STO_0 |- (typedExpressionIR_base '.' nameIR) '#' _ : STO_1 value
    -- Expr_inst: p IC STO_0 |- typedExpressionIR_base : STO_1 headerValue
    -- if HEADER _ `{ _ ';' (value_field id_field ';')* `} = headerValue
    -- if value = $assoc_<id, value>(nameIR, (id_field, value_field)*)

  rule Expr_inst/header-union:
    p IC STO_0 |- (typedExpressionIR_base '.' nameIR) '#' _ : STO_1 value
    -- Expr_inst: p IC STO_0 |- typedExpressionIR_base : STO_1 headerUnionValue
    -- if HEADER_UNION _ `{ (value_field id_field ';')* `} = headerUnionValue
    -- if value = $assoc_<id, value>(nameIR, (id_field, value_field)*)

}





rulegroup Expr_inst/indexAccessExpressionIR {

  rule Expr_inst/tuple:
    p IC STO_0
        |- (typedExpressionIR_base `[ typedExpressionIR_index `]) '#' _
            : STO_2 value
    -- Expr_inst: p IC STO_0 |- typedExpressionIR_base : STO_1 value_base
    -- Expr_inst:
        p IC STO_1 |- typedExpressionIR_index : STO_2 integerValue_index
    -- if TUPLE `( value_e* `) = value_base
    -- if n_index = $nat_of_integerValue(integerValue_index)
    -- if $(n_index < |value_e*|)
    -- if value = value_e*[n_index]

  rule Expr_inst/array:
    p IC STO_0
        |- (typedExpressionIR_base `[ typedExpressionIR_index `]) '#' _
            : STO_2 value
    -- Expr_inst: p IC STO_0 |- typedExpressionIR_base : STO_1 value_base
    -- Expr_inst:
        p IC STO_1 |- typedExpressionIR_index : STO_2 integerValue_index
    -- if ARRAY `[ value_e* `] = value_base
    -- if n_index = $nat_of_integerValue(integerValue_index)
    -- if $(n_index < |value_e*|)
    -- if value = value_e*[n_index]

  rule Expr_inst/stack:
    p IC STO_0
        |- (typedExpressionIR_base `[ typedExpressionIR_index `]) '#' _
            : STO_2 value
    -- Expr_inst: p IC STO_0 |- typedExpressionIR_base : STO_1 value_base
    -- Expr_inst:
        p IC STO_1 |- typedExpressionIR_index : STO_2 integerValue_index
    -- if HEADER_STACK `[ value_e* `( _ `) `] = value_base
    -- if n_index = $nat_of_integerValue(integerValue_index)
    -- if $(n_index < |value_e*|)
    -- if value = value_e*[n_index]

}





rulegroup Expr_inst/sliceAccessExpressionIR {

  rule Expr_inst/range:
    p IC STO_0
        |- (
          typedExpressionIR_base
          `[ typedExpressionIR_hi ':' typedExpressionIR_lo `]) '#' _
            : STO_3 $bitacc_range_op(value_base, value_hi, value_lo)
    -- Expr_inst: p IC STO_0 |- typedExpressionIR_base : STO_1 value_base
    -- Expr_inst: p IC STO_1 |- typedExpressionIR_hi : STO_2 value_hi
    -- Expr_inst: p IC STO_2 |- typedExpressionIR_lo : STO_3 value_lo

  rule Expr_inst/offset:
    p IC STO_0
        |- (
          typedExpressionIR_base
          `[ typedExpressionIR_l '+:' typedExpressionIR_w `]) '#' _
            : STO_3 $bitacc_offset_op(value_base, value_l, value_w)
    -- Expr_inst: p IC STO_0 |- typedExpressionIR_base : STO_1 value_base
    -- Expr_inst: p IC STO_1 |- typedExpressionIR_l : STO_2 value_l
    -- Expr_inst: p IC STO_2 |- typedExpressionIR_w : STO_3 value_w

}





rule Expr_inst/callExpressionIR-constructor:
  p IC STO_0
      |- ((prefixedNameIR `< typeArgumentListIR `>) `( argumentListIR `)) '#' _
          : STO_2 value_ref
  -- Constructor_inst:
      p IC
          |- prefixedNameIR `< typeArgumentListIR `> `( argumentListIR `)
              : constructorDef `< typeArgumentListIR_inst `>
              `( '#' id_default* '#' id_optional* `)
  -- Constructor_call:
      p IC STO_0
          |- constructorDef `< typeArgumentListIR_inst `>
          `( argumentListIR '#' id_default* '#' id_optional* `)
              : STO_1 object
  -- if STO_2 = $add_store(STO_1, IC.PATH, object)
  -- if value_ref = REF IC.PATH









rulegroup Expr_inst/callExpressionIR-callable {

  rule Expr_inst/expression:
    p IC STO
        |- ((typedExpressionIR_base '.' nameIR) `< _ `> `( _ `)) '#' _
            : STO $sizeof(typeIR_base, nameIR)
    -- if _ '#' `( typeIR_base _ `) = typedExpressionIR_base
    -- if nameIR
        <- [
          "minSizeInBits",
          "minSizeInBytes",
          "maxSizeInBits",
          "maxSizeInBytes"]

  rule Expr_inst/type-monomorphic:
    p IC STO
        |- ((TYPE prefixedNameIR '.' nameIR) `< _ `> `( _ `)) '#' _
            : STO $sizeof(typeIR_base, nameIR)
    -- if typeDefIR_base = $find_typeDef_i(p, IC, prefixedNameIR)
    -- if $is_monomorphic_typeDefIR(typeDefIR_base)
    -- if typeIR_base = $typeIR_of_typeDefIR(typeDefIR_base)
    -- if nameIR
        <- [
          "minSizeInBits",
          "minSizeInBytes",
          "maxSizeInBits",
          "maxSizeInBytes"]

  rule Expr_inst/type-polymorphic:
    p IC STO
        |- ((TYPE prefixedNameIR '.' nameIR) `< _ `> `( _ `)) '#' _
            : STO $sizeof(typeIR_base, nameIR)
    -- if typeDefIR_base = $find_typeDef_i(p, IC, prefixedNameIR)
    -- if ~$is_monomorphic_typeDefIR(typeDefIR_base)
    -- if (eps, eps) = $typeParameterListIR_of_typeDefIR(typeDefIR_base)
    -- if typeIR_base = $typeIR_of_typeDefIR(typeDefIR_base)
    -- if nameIR
        <- [
          "minSizeInBits",
          "minSizeInBytes",
          "maxSizeInBits",
          "maxSizeInBytes"]

}





rule Expr_inst/callExpressionIR-parenthesized:
  p IC STO_0
      |- (
        (`( callableTargetIR `)) `< typeArgumentListIR `> `( argumentListIR `))
      '#' expressionNoteIR
          : STO_1 value
  -- Expr_inst:
      p IC STO_0
          |- (callableTargetIR `< typeArgumentListIR `> `( argumentListIR `))
          '#' expressionNoteIR
              : STO_1 value





rule Expr_inst/parenthesizedExpressionIR:
  p IC STO_0 |- (`( typedExpressionIR `)) '#' _ : STO_1 value
  -- Expr_inst: p IC STO_0 |- typedExpressionIR : STO_1 value





rulegroup Exprs_inst {

  rule Exprs_inst/nil:
    p IC STO |- eps : STO eps

  rule Exprs_inst/cons:
    p IC STO_0
        |- typedExpressionIR_h :: typedExpressionIR_t*
            : STO_2 (value_h :: value_t*)
    -- Expr_inst: p IC STO_0 |- typedExpressionIR_h : STO_1 value_h
    -- Exprs_inst: p IC STO_1 |- typedExpressionIR_t* : STO_2 value_t*

}

rulegroup Argument_inst {

  rule Argument_inst/typedExpressionIR:
    p IC STO_0 |- typedExpressionIR : STO_1 value
    -- Expr_inst: p IC STO_0 |- typedExpressionIR : STO_1 value

  rule Argument_inst/nameIR-typedExpressionIR:
    p IC STO_0 |- nameIR '=' typedExpressionIR : STO_1 value
    -- Expr_inst: p IC STO_0 |- typedExpressionIR : STO_1 value

}





rule Stmt_inst/emptyStatementIR:
  p IC STO |- emptyStatementIR : IC STO emptyStatementIR





rule Stmt_inst/assignmentStatementIR:
  p IC STO |- assignmentStatementIR : IC STO assignmentStatementIR





rule Stmt_inst/callStatementIR:
  p IC STO |- callStatementIR : IC STO callStatementIR





rule DirectApplicationStmt_inst:
  p IC STO_0
      |- constructorTargetIR '.' APPLY `( argumentListIR `) ';'
          : STO_2 constantDeclarationIR callStatementIR
  -- if prefixedNameIR `< typeArgumentListIR `> = constructorTargetIR
  -- Constructor_inst:
      p IC
          |- prefixedNameIR `< typeArgumentListIR `> `( eps `)
              : constructorDef `< typeArgumentListIR_inst `>
              `( '#' id_default* '#' id_optional* `)
  -- if typeId = $flatten_prefixedNameIR(prefixedNameIR)
  -- if IC_callee = $enter_path_i(IC, typeId)
  -- Constructor_call:
      p IC_callee STO_0
          |- constructorDef `< typeArgumentListIR_inst `>
          `( eps '#' id_default* '#' id_optional* `)
              : STO_1 object
  -- if typeId_fresh = $fresh_typeId()
  -- if typeIR = _NAME typeId
  -- if nameIR = $concat_text([typeId, "_", typeId_fresh])
  -- if objectId = IC.PATH ++ typeId
  -- if STO_2 = $add_store(STO_1, objectId, object)
  -- if constantDeclarationIR
      = _EMPTY CONST typeIR nameIR ('=' _VALUE (REF objectId)) ';'
  -- if typedExpressionIR_base = (_BARE nameIR) '#' `( typeIR CTK `)
  -- if callableTargetIR = typedExpressionIR_base '.' "apply"
  -- if callStatementIR
      = callableTargetIR `< typeArgumentListIR_inst `> `( argumentListIR `) ';'

rule Stmt_inst/directApplicationStatementIR:
  p IC STO_0 |- directApplicationStatementIR : IC STO_1 blockStatementIR
  -- DirectApplicationStmt_inst:
      p IC STO_0
          |- directApplicationStatementIR
              : STO_1 constantDeclarationIR callStatementIR
  -- if blockStatementIR = _EMPTY `{ [constantDeclarationIR, callStatementIR] `}





rule Stmt_inst/returnStatementIR:
  LOCAL IC STO |- returnStatementIR : IC STO returnStatementIR





rule Stmt_inst/exitStatementIR:
  p IC STO |- exitStatementIR : IC STO exitStatementIR





rule Stmt_inst/blockStatementIR:
  LOCAL IC_0 STO_0
      |- annotationList `{ blockElementStatementListIR `}
          : IC_3 STO_1 (annotationList `{ blockElementStatementListIR_inst `})
  -- if IC_1 = $enter_i(IC_0)
  -- Block_inst:
      IC_1 STO_0
          |- annotationList `{ blockElementStatementListIR `}
              : IC_2 STO_1 (_ `{ blockElementStatementListIR_inst `})
  -- if IC_3 = $exit_i(IC_2)





rulegroup Stmt_inst/conditionalStatementIR {

  rule Stmt_inst/non-else:
    p IC STO_0
        |- IF `( typedExpressionIR_cond `) statementIR_then
            : IC STO_1 (IF `( typedExpressionIR_cond `) statementIR_then_inst)
    -- Stmt_inst:
        p IC STO_0 |- statementIR_then : IC_then STO_1 statementIR_then_inst

  rule Stmt_inst/else:
    p IC STO_0
        |- IF `( typedExpressionIR_cond `) statementIR_then ELSE
        statementIR_else
            : IC STO_2
            (
              IF `( typedExpressionIR_cond `) statementIR_then_inst ELSE
              statementIR_else_inst)
    -- Stmt_inst:
        p IC STO_0 |- statementIR_then : IC_then STO_1 statementIR_then_inst
    -- Stmt_inst:
        p IC STO_1 |- statementIR_else : IC_else STO_2 statementIR_else_inst

}





rule Stmt_inst/forStatementIR-three-clause:
  p IC STO_0
      |- annotationList FOR
      `(
        forInitStatementListIR ';' typedExpressionIR ';'
        forUpdateStatementListIR
      `) statementIR
          : IC STO_1 forStatementIR
  -- Stmt_inst: p IC STO_0 |- statementIR : IC_body STO_1 statementIR_body
  -- if forStatementIR
      = annotationList FOR
      `(
        forInitStatementListIR ';' typedExpressionIR ';'
        forUpdateStatementListIR
      `) statementIR_body





rulegroup Stmt_inst/forStatementIR-in {

  rule Stmt_inst/no-annotations:
    p IC STO_0
        |- annotationList FOR `( typeIR nameIR IN forCollectionExpressionIR `)
        statementIR
            : IC STO_1 forStatementIR
    -- Stmt_inst: p IC STO_0 |- statementIR : IC_body STO_1 statementIR_body
    -- if forStatementIR
        = annotationList FOR `( typeIR nameIR IN forCollectionExpressionIR `)
        statementIR_body

  rule Stmt_inst/annotations:
    p IC STO_0
        |- annotationList FOR
        `( annotationList typeIR nameIR IN forCollectionExpressionIR `)
        statementIR
            : IC STO_1 forStatementIR
    -- Stmt_inst: p IC STO_0 |- statementIR : IC_body STO_1 statementIR_body
    -- if forStatementIR
        = annotationList FOR
        `( annotationList typeIR nameIR IN forCollectionExpressionIR `)
        statementIR_body

}





rule Stmt_inst/breakStatementIR:
  p IC STO |- breakStatementIR : IC STO breakStatementIR





rule Stmt_inst/continueStatementIR:
  p IC STO |- continueStatementIR : IC STO continueStatementIR





relation SwitchCase_inst:
  cursor instContext store |- switchCaseIR : store switchCaseIR





rulegroup SwitchCase_inst {

  rule SwitchCase_inst/blockStatementIR:
    p IC STO_0
        |- switchLabelIR ':' blockStatementIR
            : STO_1 (switchLabelIR ':' blockStatementIR_inst)
    -- Stmt_inst:
        p IC STO_0 |- blockStatementIR : IC_switch STO_1 blockStatementIR_inst

  rule SwitchCase_inst/non-blockStatementIR:
    p IC STO |- switchLabelIR ':' : STO (switchLabelIR ':')

}





relation SwitchCases_inst:
  cursor instContext store |- switchCaseIR* : store switchCaseIR*

rulegroup SwitchCases_inst {

  rule SwitchCases_inst/nil:
    p IC STO |- eps : STO eps

  rule SwitchCases_inst/cons:
    p IC STO_0
        |- switchCaseIR_h :: switchCaseIR_t*
            : STO_2 (switchCaseIR_h' :: switchCaseIR_t'*)
    -- SwitchCase_inst: p IC STO_0 |- switchCaseIR_h : STO_1 switchCaseIR_h'
