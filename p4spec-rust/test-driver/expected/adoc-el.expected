    -- if BUILTIN_POP_FRONT storageReference = builtinPopFrontMethodCallee
    -- Lvalue_read: p EC_0 ARCH_0 |- storageReference : headerStackValue
    -- if HEADER_STACK `[ value_element* `( n_idx `) `] = headerStackValue
    -- if n_size = |value_element*|
    -- Argument_eval:
        p EC_0 ARCH_0 |- argumentIR : EC_1 ARCH_1 (_CONT integerValue_count)
    -- if n_count = $nat_of_integerValue(integerValue_count)
    -- if $(n_count < n_size)
    -- if n_front = $max_int([0, $(n_size - n_count)])
    -- if value_front* = value_element*[n_count : n_front]
    -- if value_back* = value_element*[0 : n_count]
    -- (if (value_back_invalidated = $invalidate_value(value_back)))*
    -- if value_element_updated* = value_front* ++ value_back_invalidated*
    -- if n_idx_updated = n_front
    -- if headerStackValue_updated
        = HEADER_STACK `[ value_element_updated* `( n_idx_updated `) `]
    -- Lvalue_write:
        p EC_1 ARCH_1 |- storageReference := headerStackValue_updated : EC_2

  rule Call_eval/cont-overflow:
    p EC_0 ARCH_0
        |- builtinPopFrontMethodCallee '@' `< eps `> `( argumentIR `)
            : EC_2 ARCH_1 (RETURN eps)
    -- if BUILTIN_POP_FRONT storageReference = builtinPopFrontMethodCallee
    -- Lvalue_read: p EC_0 ARCH_0 |- storageReference : headerStackValue
    -- if HEADER_STACK `[ value_element* `( n_idx `) `] = headerStackValue
    -- if n_size = |value_element*|
    -- Argument_eval:
        p EC_0 ARCH_0 |- argumentIR : EC_1 ARCH_1 (_CONT integerValue_count)
    -- if n_count = $nat_of_integerValue(integerValue_count)
    -- if $(n_count >= n_size)
    -- (if (value_element_updated = $invalidate_value(value_element)))*
    -- if n_idx_updated = $max_int([0, $(n_size - n_count)])
    -- if headerStackValue_updated
        = HEADER_STACK `[ value_element_updated* `( n_idx_updated `) `]
    -- Lvalue_write:
        p EC_1 ARCH_1 |- storageReference := headerStackValue_updated : EC_2

}





rule Call_eval/builtinIsValidMethodCallee-header:
  p EC ARCH
      |- builtinIsValidMethodCallee '@' `< eps `> `( eps `)
          : EC ARCH returnResult
  -- if BUILTIN_IS_VALID storageReference = builtinIsValidMethodCallee
  -- Lvalue_read: p EC ARCH |- storageReference : headerValue
  -- if HEADER _ `{ b_valid ';' _ `} = headerValue
  -- if returnResult = RETURN (_B b_valid)





rule Call_eval/builtinSetValidMethodCallee:
  p EC_0 ARCH
      |- builtinSetValidMethodCallee '@' `< eps `> `( eps `)
          : EC_1 ARCH returnResult
  -- if BUILTIN_SET_VALID storageReference = builtinSetValidMethodCallee
  -- Lvalue_read: p EC_0 ARCH |- storageReference : headerValue
  -- if HEADER typeId `{ _ ';' fieldValue* `} = headerValue
  -- if value = HEADER typeId `{ true ';' fieldValue* `}
  -- Lvalue_write: p EC_0 ARCH |- storageReference := value : EC_1
  -- if returnResult = RETURN eps





rule Call_eval/builtinSetInvalidMethodCallee:
