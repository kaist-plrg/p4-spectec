  = typedExpressionIR_parser
  -- if typeDefIR_parser = $find_typeDef_e(GLOBAL, EC, _BARE "Parser")
  -- if PACKAGE `< theta `> `{ _ `} = $find_object_e(ARCH, ["main"])
