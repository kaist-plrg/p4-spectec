dec $update_fieldValue(fieldValue*, nameIR, value) : fieldValue*

def $update_fieldValue(eps, nameIR, value) = eps

def $update_fieldValue(
    (value_field_h nameIR_field_h ';') :: fieldValue_t*,
    nameIR,
    value)
  = (value nameIR ';') :: fieldValue_t*
  -- if nameIR_field_h = nameIR

def $update_fieldValue(
    (value_field_h nameIR_field_h ';') :: fieldValue_t*,
    nameIR,
    value)
  = (value_field_h nameIR_field_h ';')
      :: $update_fieldValue(fieldValue_t*, nameIR, value)
  -- if nameIR_field_h =/= nameIR





dec $update_headerUnion(fieldValue*, nameIR) : fieldValue*

def $update_headerUnion(eps, nameIR) = eps

def $update_headerUnion(
    (value_field_h nameIR_field_h ';') :: fieldValue_t*,
    nameIR)
  = (value_field_h nameIR_field_h ';')
      :: $update_headerUnion(fieldValue_t*, nameIR)
  -- if nameIR_field_h = nameIR

def $update_headerUnion(
    (value_field_h nameIR_field_h ';') :: fieldValue_t*,
    nameIR)
  = (value_field_h_update nameIR_field_h ';')
      :: $update_headerUnion(fieldValue_t*, nameIR)
  -- if nameIR_field_h =/= nameIR
  -- if HEADER typeId `{ _ ';' fieldValue* `} = value_field_h
  -- if value_field_h_update = HEADER typeId `{ false ';' fieldValue* `}





dec $isValid_header(value) : bool

def $isValid_header(headerValue) = b_valid
  -- if HEADER _ `{ b_valid ';' _ `} = headerValue





dec $invalidate_value(value) : value

dec $invalidate_header(headerValue) : headerValue

dec $invalidate_headerUnion(headerUnionValue) : headerUnionValue

def $invalidate_header(HEADER typeId `{ _ ';' fieldValue* `})
  = HEADER typeId `{ false ';' fieldValue* `}

def $invalidate_headerUnion(
    HEADER_UNION typeId `{ (value_field nameIR_field ';')* `})
  = HEADER_UNION typeId `{ (value_field_invalidated nameIR_field ';')* `}
  -- (if (value_field_invalidated = $invalidate_value(value_field)))*

def $invalidate_value(headerValue) = $invalidate_header(headerValue)

def $invalidate_value(headerUnionValue)
  = $invalidate_headerUnion(headerUnionValue)





dec $write_value_from_bits(value, nat, bool*) : value

dec $write_value_from_bits'(value, nat, bool*) : (value, bool*)

dec $write_values_from_bits'(value*, nat, bool*) : (value*, bool*)

dec $write_value_fields_from_bits'(fieldValue*, nat, bool*)
  : (fieldValue*, bool*)

dec $write_value_field_from_bits'(fieldValue, nat, bool*) : (fieldValue, bool*)

def $write_value_from_bits(value, n_var, b*) = value_updated
  -- if (value_updated, eps) = $write_value_from_bits'(value, n_var, b*)

def $write_value_from_bits'(_B _, n_var, b_h :: b_t*) = (_B b_h, b_t*)

def $write_value_from_bits'(w W _, n_var, b*) = (w W i, b_t*)
  -- if $(|b*| >= w)
  -- if b_h* = b*[0 : w]
  -- if n_t = $(|b*| - w)
  -- if b_t* = b*[w : n_t]
  -- if i = $int_to_bitstr(w, $bits_to_int_unsigned(b_h*))

def $write_value_from_bits'(w S _, n_var, b*) = (w S i, b_t*)
  -- if $(|b*| >= w)
  -- if b_h* = b*[0 : w]
  -- if n_t = $(|b*| - w)
  -- if b_t* = b*[w : n_t]
  -- if i = $int_to_bitstr(w, $bits_to_int_signed(b_h*))

def $write_value_from_bits'(n_max '.' _ V i, 0, b*) = (n_max '.' 0 V i, b*)

def $write_value_from_bits'(n_max '.' _ V _, n_var, b*)
  = (n_max '.' n_var V i, b_t*)
  -- if n_var =/= 0
  -- if $(|b*| >= n_var)
  -- if b_h* = b*[0 : n_var]
  -- if n_t = $(|b*| - n_var)
  -- if b_t* = b*[n_var : n_t]
  -- if i = $int_to_bitstr(n_var, $bits_to_int_signed(b_h*))

def $write_values_from_bits'(eps, n_var, b*) = (eps, b*)

def $write_values_from_bits'(value_h :: value_t*, n_var, b*)
  = (value_h_updated :: value_t_updated*, b_rest*)
  -- if (value_h_updated, b_t*) = $write_value_from_bits'(value_h, n_var, b*)
  -- if (value_t_updated*, b_rest*)
      = $write_values_from_bits'(value_t*, n_var, b_t*)

def $write_value_fields_from_bits'(eps, n_var, b*) = (eps, b*)

def $write_value_fields_from_bits'(fieldValue_h :: fieldValue_t*, n_var, b*)
  = (fieldValue_h_updated :: fieldValue_t_updated*, b_rest*)
  -- if (fieldValue_h_updated, b_t*)
      = $write_value_field_from_bits'(fieldValue_h, n_var, b*)
  -- if (fieldValue_t_updated*, b_rest*)
      = $write_value_fields_from_bits'(fieldValue_t*, n_var, b_t*)

def $write_value_field_from_bits'(value id ';', n_var, b*)
  = (value_updated id ';', b_rest*)
  -- if (value_updated, b_rest*) = $write_value_from_bits'(value, n_var, b*)

def $write_value_from_bits'(STRUCT typeId `{ fieldValue* `}, n_var, b*)
  = (STRUCT typeId `{ fieldValue_updated* `}, b_rest*)
  -- if (fieldValue_updated*, b_rest*)
      = $write_value_fields_from_bits'(fieldValue*, n_var, b*)

def $write_value_from_bits'(HEADER typeId `{ _ ';' fieldValue* `}, n_var, b*)
  = (HEADER typeId `{ true ';' fieldValue_updated* `}, b_rest*)
  -- if (fieldValue_updated*, b_rest*)
      = $write_value_fields_from_bits'(fieldValue*, n_var, b*)

def $write_value_from_bits'(typeId '.' nameIR '.' value, n_var, b*)
  = (typeId '.' "__UNSPECIFIED" '.' value_updated, b_rest*)
  -- if (value_updated, b_rest*) = $write_value_from_bits'(value, n_var, b*)

def $write_value_from_bits'(ARRAY `[ value* `], n_var, b*)
  = (ARRAY `[ value_updated* `], b_rest*)
  -- if (value_updated*, b_rest*) = $write_values_from_bits'(value*, n_var, b*)

def $write_value_from_bits'(HEADER_STACK `[ value* `( n_idx `) `], n_var, b*)
  = (HEADER_STACK `[ value_updated* `( n_idx `) `], b_rest*)
  -- if (value_updated*, b_rest*) = $write_values_from_bits'(value*, n_var, b*)





dec $write_bits_from_value(value) : bool*

def $write_bits_from_value(_B b) = [b]

def $write_bits_from_value(w S i) = $int_to_bits_signed(w, i)

def $write_bits_from_value(w W i) = $int_to_bits_unsigned(w, i)

def $write_bits_from_value(_ '.' w V i) = $int_to_bits_unsigned(w, i)

def $write_bits_from_value(ARRAY `[ value_element* `])
  = $concat_<bool>($write_bits_from_value(value_element)*)

def $write_bits_from_value(HEADER_STACK `[ value_element* `( _ `) `])
  = $concat_<bool>($write_bits_from_value(value_element)*)

def $write_bits_from_value(STRUCT _ `{ (value_field id_field ';')* `})
  = $concat_<bool>($write_bits_from_value(value_field)*)

def $write_bits_from_value(HEADER _ `{ true ';' (value_field id_field ';')* `})
  = $concat_<bool>($write_bits_from_value(value_field)*)

def $write_bits_from_value(HEADER _ `{ false ';' _ `}) = eps

def $write_bits_from_value(HEADER_UNION _ `{ (value id ';')* `})
  = $concat_<bool>($write_bits_from_value(value)*)

def $write_bits_from_value(typeId '.' id '.' value)
  = $write_bits_from_value(value)

syntax typeIR

syntax typeArgumentIR





voidTypeIR
    : VOID
    ;

boolTypeIR
    : BOOL
    ;

errorTypeIR
    : ERROR
    ;

matchKindTypeIR
    : MATCH_KIND
    ;

stringTypeIR
    : STRING
    ;

intTypeIR
    : INT
    ;

fixedIntTypeIR
    : INT < nat >
    ;

fixedBitTypeIR
    : BIT < nat >
    ;

varBitTypeIR
    : VARBIT < nat >
    ;

integerTypeIR
    : intTypeIR | fixedIntTypeIR | fixedBitTypeIR | varBitTypeIR
    ;

baseTypeIR
    : voidTypeIR | boolTypeIR | errorTypeIR | matchKindTypeIR | stringTypeIR
    | integerTypeIR
    ;





nameTypeIR
    : _NAME typeId
    ;





typedefTypeIR
    : TYPEDEF typeId typeIR
    ;

newTypeIR
    : TYPE typeId typeIR
    ;

aliasTypeIR
    : typedefTypeIR | newTypeIR
    ;





listTypeIR
    : LIST < typeIR >
    ;

tupleTypeIR
    : TUPLE < typeIR* >
    ;

arrayTypeIR
    : ARRAY typeIR [ nat ]
    ;

headerStackTypeIR
    : HEADER_STACK typeIR [ nat ]
    ;

fieldTypeIR
    : annotationList typeIR nameIR ;
    ;

structTypeIR
    : STRUCT typeId < typeArgumentIR* > { fieldTypeIR* }
    ;

headerTypeIR
    : HEADER typeId < typeArgumentIR* > { fieldTypeIR* }
    ;

headerUnionTypeIR
    : HEADER_UNION typeId < typeArgumentIR* > { fieldTypeIR* }
    ;

valueFieldIR
    : nameIR = value ;
    ;

simpleEnumTypeIR
    : ENUM typeId { nameIR* }
    ;

serializableEnumTypeIR
    : ENUM typeId < typeIR > { valueFieldIR* }
    ;

enumTypeIR
    : simpleEnumTypeIR | serializableEnumTypeIR
    ;

dataTypeIR
    : listTypeIR | tupleTypeIR | arrayTypeIR | headerStackTypeIR | structTypeIR
    | headerTypeIR | headerUnionTypeIR | enumTypeIR
    ;





syntax parameterIR

syntax externMethodTypeDefIR

syntax tableMetadataStructTypeIR

externMethodTypeDefEnv = map<callableId, externMethodTypeDefIR>

externObjectTypeIR
    : EXTERN typeId < typeArgumentIR* > externMethodTypeDefEnv
    ;

parserObjectTypeIR
    : PARSER typeId < typeArgumentIR* > ( parameterIR* )
    ;

controlObjectTypeIR
    : CONTROL typeId < typeArgumentIR* > ( parameterIR* )
    ;

packageObjectTypeIR
    : PACKAGE typeId < typeArgumentIR* > { typeIR* }
    ;

tableObjectTypeIR
    : TABLE typeId { tableMetadataStructTypeIR }
    ;

objectTypeIR
    : externObjectTypeIR | parserObjectTypeIR | controlObjectTypeIR
    | packageObjectTypeIR | tableObjectTypeIR
    ;





defaultTypeIR
    : DEFAULT
    ;

invalidHeaderTypeIR
    : HEADER_INVALID
    ;

sequenceTypeIR
    : SEQ < typeIR* > | SEQ < typeIR* , ... >
    ;

recordTypeIR
    : RECORD { fieldTypeIR* } | RECORD { fieldTypeIR* , ... }
    ;

setTypeIR
    : SET < typeIR >
    ;

tableMetadataEnumTypeIR
    : TABLE_ENUM typeId { nameIR* }
    ;

tableMetadataStructTypeIR
    : TABLE_STRUCT typeId
        {
          HIT boolTypeIR ; MISS boolTypeIR ; ACTION_RUN tableMetadataEnumTypeIR
          ;
        }
    ;

tableMetadataTypeIR
    : tableMetadataEnumTypeIR | tableMetadataStructTypeIR
    ;

synthesizedTypeIR
    : defaultTypeIR | invalidHeaderTypeIR | sequenceTypeIR | recordTypeIR
    | setTypeIR | tableMetadataTypeIR
    ;





typeIR
    : baseTypeIR | nameTypeIR | aliasTypeIR | dataTypeIR | objectTypeIR
    | synthesizedTypeIR
    ;

typeArgumentIR = typeIR

typeParameterIR = typeId





nameTypeDefIR = nameTypeIR





aliasTypeDefIR = aliasTypeIR





structTypeDefIR
    : STRUCT typeId < typeParameterIR* > { fieldTypeIR* }
    ;

headerTypeDefIR
    : HEADER typeId < typeParameterIR* > { fieldTypeIR* }
    ;

headerUnionTypeDefIR
    : HEADER_UNION typeId < typeParameterIR* > { fieldTypeIR* }
    ;

enumTypeDefIR = enumTypeIR

dataTypeDefIR
    : structTypeDefIR | headerTypeDefIR | headerUnionTypeDefIR | enumTypeDefIR
    ;





externObjectTypeDefIR
    : EXTERN typeId < typeParameterIR* , typeParameterIR* >
        externMethodTypeDefEnv
    ;

parserObjectTypeDefIR
    : PARSER typeId < typeParameterIR* , typeParameterIR* > ( parameterIR* )
    ;

controlObjectTypeDefIR
    : CONTROL typeId < typeParameterIR* , typeParameterIR* > ( parameterIR* )
    ;

packageObjectTypeDefIR
    : PACKAGE typeId < typeParameterIR* , typeParameterIR* > { typeIR* }
    ;

tableObjectTypeDefIR = tableObjectTypeIR

objectTypeDefIR
    : externObjectTypeDefIR | parserObjectTypeDefIR | controlObjectTypeDefIR
    | packageObjectTypeDefIR | tableObjectTypeDefIR
    ;





typeDefIR
    : nameTypeDefIR | aliasTypeDefIR | dataTypeDefIR | objectTypeDefIR
    ;

dec $unroll_typeIR(typeIR) : typeIR

def $unroll_typeIR(TYPEDEF _ typeIR) = $unroll_typeIR(typeIR)

def $unroll_typeIR(typeIR) = typeIR
  -- otherwise





dec $unroll_aliasType(typeIR) : typeIR

def $unroll_aliasType(TYPE _ typeIR) = $unroll_aliasType(typeIR)

def $unroll_aliasType(TYPEDEF _ typeIR) = $unroll_aliasType(typeIR)

def $unroll_aliasType(typeIR) = typeIR
  -- otherwise





dec $width_of_integerTypeIR(integerTypeIR) : nat?

def $width_of_integerTypeIR(INT) = eps

def $width_of_integerTypeIR(INT `< n `>) = n

def $width_of_integerTypeIR(BIT `< n `>) = n

def $width_of_integerTypeIR(VARBIT `< n `>) = n





tbl dec $is_defaultable_typeIR(typeIR) : bool

tbl def $is_defaultable_typeIR =
  | BOOL => true
  | ERROR => true
  | STRING => true
  | integerTypeIR => true
  | TYPEDEF _ typeIR => $is_defaultable_typeIR(typeIR)
  | TYPE _ typeIR => $is_defaultable_typeIR(typeIR)
  | TUPLE `< typeIR* `> => $forall_($is_defaultable_typeIR(typeIR)*)
  | ARRAY typeIR `[ _ `] => $is_defaultable_typeIR(typeIR)
  | HEADER_STACK typeIR `[ _ `] => $is_defaultable_typeIR(typeIR)
  | STRUCT _ `< _ `> `{ (_ typeIR _ ';')* `}
      => $forall_($is_defaultable_typeIR(typeIR)*)
  | HEADER _ `< _ `> `{ (_ typeIR _ ';')* `}
      => $forall_($is_defaultable_typeIR(typeIR)*)
  | HEADER_UNION _ `< _ `> `{ (_ typeIR _ ';')* `}
      => $forall_($is_defaultable_typeIR(typeIR)*)
  | ENUM _ `{ _ `} => true
  | ENUM _ `< typeIR `> `{ _ `} => $is_defaultable_typeIR(typeIR)
  | _ => false





tbl dec $is_equalable_typeIR(typeIR) : bool

tbl def $is_equalable_typeIR =
  | VOID => false
  | _NAME typeId => false
  | TYPEDEF _ typeIR => $is_equalable_typeIR(typeIR)
  | externObjectTypeIR => false
  | parserObjectTypeIR => false
  | controlObjectTypeIR => false
  | packageObjectTypeIR => false
  | tableObjectTypeIR => false
  | DEFAULT => false
  | sequenceTypeIR => false
  | recordTypeIR => false
  | HEADER_INVALID => false
  | setTypeIR => false
  | tableMetadataTypeIR => false
  | _ => true





tbl dec $is_assignable_typeIR(typeIR) : bool

tbl def $is_assignable_typeIR =
  | VOID => false
  | STRING => false
  | INT => false
  | TYPEDEF _ typeIR => $is_assignable_typeIR(typeIR)
  | objectTypeIR => false
  | synthesizedTypeIR => false
  | _ => true





tbl dec $is_serializable_typeIR(typeIR) : bool

tbl def $is_serializable_typeIR =
  | BOOL => true
  | INT `< _ `> => true
  | BIT `< _ `> => true
  | VARBIT `< _ `> => true
  | TYPEDEF _ typeIR => $is_serializable_typeIR(typeIR)
  | TYPE _ typeIR => $is_serializable_typeIR(typeIR)
  | ENUM _ `< typeIR `> `{ _ `} => $is_serializable_typeIR(typeIR)
  | TUPLE `< typeIR* `> => $forall_($is_serializable_typeIR(typeIR)*)
  | ARRAY typeIR `[ _ `] => $is_serializable_typeIR(typeIR)
  | HEADER_STACK typeIR `[ _ `] => $is_serializable_typeIR(typeIR)
  | STRUCT _ `< _ `> `{ (_ typeIR _ ';')* `}
      => $forall_($is_serializable_typeIR(typeIR)*)
  | HEADER _ `< _ `> `{ (_ typeIR _ ';')* `}
      => $forall_($is_serializable_typeIR(typeIR)*)
  | HEADER_UNION _ `< _ `> `{ (_ typeIR _ ';')* `}
      => $forall_($is_serializable_typeIR(typeIR)*)
  | _ => false

