            |- controlLocalDeclarationListIR : EC_callee_4 ARCH_2 _EMPTY
    -- ControlBody_eval:
        EC_callee_4 ARCH_2 |- controlBodyIR : EC_callee_5 ARCH_3 (RETURN eps)
    -- Copy_out:
