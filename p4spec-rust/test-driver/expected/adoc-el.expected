dec $callable_tableApplyMethod(cursor, typingContext) : bool

def $callable_tableApplyMethod(GLOBAL, TC) = false

def $callable_tableApplyMethod(BLOCK, TC) = false

def $callable_tableApplyMethod(LOCAL, TC)
  = (localKind = CONTROL_APPLY_METHOD) \/ (localKind = TABLE_APPLY_METHOD)
  -- if localKind = TC.LOCAL.KIND

rule Call_ok/tableApplyMethodTypeIR:
  p TC
      |- tableApplyMethodTypeIR `< eps '#' eps `> `( eps '#' eps '#' eps `)
          : tableMetadataStructTypeIR `< eps `> `( eps `)
  -- if TABLE_APPLY ':' tableMetadataStructTypeIR = tableApplyMethodTypeIR
  -- if $callable_tableApplyMethod(p, TC)

dec $callableId_IR(nameIR, parameterListIR) : callableId

def $callableId_IR(nameIR, parameterIR*) = nameIR `( id* `)
  -- (if (_ _ _ id _ = parameterIR))*

storageReference
    : referenceExpressionIR | storageReference . nameIR
    | storageReference [ value ] | storageReference [ value sliceop value ]
    ;

syntax stateEnv, actionDefEnv, frame, tableObjectProperty





actionDef
    : annotationList ACTION nameIR ( parameterListIR ) blockStatementIR
    ;





definedFunctionDef
    : FUNCTION nameIR < typeParameterListIR > ( parameterListIR )
        blockStatementIR
    ;

externFunctionDef
    : EXTERN_FUNCTION nameIR < typeParameterListIR > ( parameterListIR )
    ;

functionDef
    : definedFunctionDef | externFunctionDef
    ;





externMethodDef
    : EXTERN_METHOD nameIR < typeParameterListIR > ( parameterListIR )
        blockStatementIR?
    | EXTERN_METHOD ABSTRACT nameIR < typeParameterListIR > ( parameterListIR )
    ;

parserApplyMethodDef
    : PARSER_APPLY ( parameterListIR )
        { parserLocalDeclarationListIR ; stateEnv }
    ;

controlApplyMethodDef
    : CONTROL_APPLY ( parameterListIR )
        { controlLocalDeclarationListIR ; actionDefEnv ; controlBodyIR }
    ;

tableApplyMethodDef
    : TABLE_APPLY { tablePropertyListIR }
    ;

methodDef
    : externMethodDef | parserApplyMethodDef | controlApplyMethodDef
    | tableApplyMethodDef
    ;

callableDef
    : actionDef | functionDef | methodDef
    ;

dec $parameterListIR_of_callableDef(callableDef) : parameterIR*





dec $parameterListIR_of_actionDef(actionDef) : parameterIR*

def $parameterListIR_of_actionDef(
    annotationList ACTION _ `( parameterListIR `) _)
  = parameterListIR

def $parameterListIR_of_callableDef(actionDef)
  = $parameterListIR_of_actionDef(actionDef)





dec $parameterListIR_of_functionDef(functionDef) : parameterIR*

dec $parameterListIR_of_definedFunctionDef(definedFunctionDef) : parameterIR*

def $parameterListIR_of_definedFunctionDef(
    FUNCTION _ `< _ `> `( parameterListIR `) _)
  = parameterListIR

dec $parameterListIR_of_externFunctionDef(externFunctionDef) : parameterIR*

def $parameterListIR_of_externFunctionDef(
    EXTERN_FUNCTION _ `< _ `> `( parameterListIR `))
  = parameterListIR

def $parameterListIR_of_functionDef(definedFunctionDef)
  = $parameterListIR_of_definedFunctionDef(definedFunctionDef)

def $parameterListIR_of_functionDef(externFunctionDef)
  = $parameterListIR_of_externFunctionDef(externFunctionDef)

def $parameterListIR_of_callableDef(functionDef)
  = $parameterListIR_of_functionDef(functionDef)





dec $parameterListIR_of_methodDef(methodDef) : parameterIR*

dec $parameterListIR_of_externMethodDef(externMethodDef) : parameterIR*

def $parameterListIR_of_externMethodDef(
    EXTERN_METHOD _ `< _ `> `( parameterListIR `) _)
  = parameterListIR

dec $parameterListIR_of_parserApplyMethodDef(parserApplyMethodDef)
  : parameterIR*

def $parameterListIR_of_parserApplyMethodDef(
    PARSER_APPLY `( parameterListIR `) `{ _ ';' _ `})
  = parameterListIR

dec $parameterListIR_of_controlApplyMethodDef(controlApplyMethodDef)
  : parameterIR*

def $parameterListIR_of_controlApplyMethodDef(
    CONTROL_APPLY `( parameterListIR `) `{ _ ';' _ ';' _ `})
  = parameterListIR

dec $parameterListIR_of_tableApplyMethodDef(tableApplyMethodDef) : parameterIR*

def $parameterListIR_of_tableApplyMethodDef(TABLE_APPLY `{ _ `}) = eps

def $parameterListIR_of_methodDef(externMethodDef)
  = $parameterListIR_of_externMethodDef(externMethodDef)

def $parameterListIR_of_methodDef(parserApplyMethodDef)
  = $parameterListIR_of_parserApplyMethodDef(parserApplyMethodDef)

def $parameterListIR_of_methodDef(controlApplyMethodDef)
  = $parameterListIR_of_controlApplyMethodDef(controlApplyMethodDef)

def $parameterListIR_of_methodDef(tableApplyMethodDef)
  = $parameterListIR_of_tableApplyMethodDef(tableApplyMethodDef)

def $parameterListIR_of_callableDef(methodDef)
  = $parameterListIR_of_methodDef(methodDef)





actionCallee
    : ACTION cursor . nameIR ( parameterListIR # id* ) blockStatementIR
    ;





definedFunctionCallee
    : FUNCTION nameIR < typeParameterListIR > ( parameterListIR # id* )
        blockStatementIR
    ;

externFunctionCallee
    : EXTERN_FUNCTION nameIR < typeParameterListIR >
        ( parameterListIR # id* # id* )
    ;

functionCallee
    : definedFunctionCallee | externFunctionCallee
    ;





builtinIsValidMethodCallee
    : BUILTIN_IS_VALID storageReference
    ;

builtinSetValidMethodCallee
    : BUILTIN_SET_VALID storageReference
    ;

builtinSetInvalidMethodCallee
    : BUILTIN_SET_INVALID storageReference
    ;

builtinPushFrontMethodCallee
    : BUILTIN_PUSH_FRONT storageReference
    ;

builtinPopFrontMethodCallee
    : BUILTIN_POP_FRONT storageReference
    ;

builtinSizeMethodCallee
    : BUILTIN_SIZE_OF nameIR typeIR
    ;

builtinMethodCallee
    : builtinIsValidMethodCallee | builtinSetValidMethodCallee
    | builtinSetInvalidMethodCallee | builtinPushFrontMethodCallee
    | builtinPopFrontMethodCallee | builtinSizeMethodCallee
    ;

externMethodCallee
    : EXTERN_METHOD objectId . nameIR < typeParameterListIR >
        ( parameterListIR # id* # id* ) { theta ; frame ; blockStatementIR? }
    ;

parserApplyMethodCallee
    : PARSER objectId . APPLY ( parameterListIR # id* )
        { theta ; frame ; parserLocalDeclarationListIR ; stateEnv }
    ;

controlApplyMethodCallee
    : CONTROL objectId . APPLY ( parameterListIR # id* )
        {
          theta ; frame ; controlLocalDeclarationListIR ; actionDefEnv ;
          controlBodyIR
        }
    ;

tableApplyMethodCallee
    : TABLE objectId . APPLY { frame ; tableObjectProperty }
    ;

methodCallee
    : builtinMethodCallee | externMethodCallee | parserApplyMethodCallee
    | controlApplyMethodCallee | tableApplyMethodCallee
    ;

callee
    : actionCallee | functionCallee | methodCallee
    ;

externObjectConstructorDef
    : EXTERN nameIR < typeParameterListIR > ( constructorParameterListIR )
        { externMethodPrototypeListIR }
    ;

parserObjectConstructorDef
    : PARSER < typeParameterListIR > ( parameterListIR )
        ( constructorParameterListIR )
        { parserLocalDeclarationListIR parserStateListIR }
    ;

controlObjectConstructorDef
    : CONTROL < typeParameterListIR > ( parameterListIR )
        ( constructorParameterListIR )
        { controlLocalDeclarationListIR APPLY controlBodyIR }
    ;

packageObjectConstructorDef
    : PACKAGE < typeParameterListIR > ( constructorParameterListIR )
    ;

constructorDef
    : externObjectConstructorDef | parserObjectConstructorDef
    | controlObjectConstructorDef | packageObjectConstructorDef
    ;

dec $parameterListIR_of_constructorDef(constructorDef) : parameterIR*

def $parameterListIR_of_constructorDef(
    EXTERN _ `< _ `> `( constructorParameterListIR `) `{ _ `})
  = constructorParameterListIR

def $parameterListIR_of_constructorDef(
    PARSER `< _ `> `( _ `) `( constructorParameterListIR `) `{ _ _ `})
  = constructorParameterListIR

def $parameterListIR_of_constructorDef(
    CONTROL `< _ `> `( _ `) `( constructorParameterListIR `) `{ _ APPLY _ `})
  = constructorParameterListIR

def $parameterListIR_of_constructorDef(
    PACKAGE `< _ `> `( constructorParameterListIR `))
  = constructorParameterListIR





extern syntax objectState

externMethodDefEnv = map<callableId, externMethodDef>

extern dec $init_objectState(nameIR, typeIR*, id*, value*) : objectState

externObject
    : EXTERN typeId < theta > { objectState frame externMethodDefEnv }
    ;





parserObject
    : PARSER < theta > ( parameterListIR )
        { frame parserLocalDeclarationListIR stateEnv }
    ;





actionDefEnv = map<callableId, actionDef>

controlObject
    : CONTROL < theta > ( parameterListIR )
        { frame controlLocalDeclarationListIR actionDefEnv controlBodyIR }
    ;





packageObject
    : PACKAGE < theta > { frame }
    ;





tableObjectProperty = {
  KEYS tableKeysPropertyIR,
  ACTIONS tableActionsPropertyIR,
  DEFAULT_ACTION tableDefaultActionPropertyIR,
  ENTRIES tableEntriesPropertyIR,
  CUSTOMS tableCustomPropertyIR*
}

var TBL : tableObjectProperty

tableObject
    : TABLE typeId { frame tableObjectProperty }
    ;





valueSetObject
    : VALUE_SET { value* ( nat ) }
    ;

object
    : externObject | parserObject | controlObject | packageObject | tableObject
    | valueSetObject
    ;

frame = map<id, value>

dec $empty_frame : frame

def $empty_frame() = $empty_map<id, value>()

stateEnv = map<id, parserStateIR>

dec $empty_stateEnv : stateEnv

def $empty_stateEnv() = $empty_map<id, parserStateIR>()

callableDefEnv = map<callableId, callableDef>

dec $empty_callableDefEnv : callableDefEnv

def $empty_callableDefEnv() = $empty_map<callableId, callableDef>()

constructorDefEnv = map<callableId, constructorDef>

dec $empty_constructorDefEnv : constructorDefEnv

def $empty_constructorDefEnv() = $empty_map<callableId, constructorDef>()





store = map<objectId, object>

var STO : store

dec $empty_store : store

def $empty_store() = store
  -- if store = $empty_map<objectId, object>()





dec $add_store(store, objectId, object) : store

def $add_store(store, objectId, object) = store'
  -- if store' = $add_map<objectId, object>(store, objectId, object)





dec $find_store(store, objectId) : object

def $find_store(store, objectId) = object
  -- if object = $find_map<objectId, object>(store, objectId)





globalInstLayer = {
  CONSTRUCTOR constructorDefEnv,
  TYPE typeDefEnv,
  CALLABLE callableDefEnv,
  FRAME frame
}





blockInstLayer = {
  TYPE theta,
  CALLABLE callableDefEnv,
  STATE stateEnv,
  FRAME frame
}





localInstLayer = {
  TYPE theta,
  FRAMES frame*
}





instContext = {
  PATH objectId,
  GLOBAL globalInstLayer,
  BLOCK blockInstLayer,
  LOCAL localInstLayer
}

var IC : instContext





dec $empty_instContext : instContext

def $empty_instContext() = IC
  -- if globalInstLayer
      = {
        CONSTRUCTOR $empty_constructorDefEnv(),
        TYPE $empty_typeDefEnv(),
        CALLABLE $empty_callableDefEnv(),
        FRAME $empty_frame()
      }
  -- if blockInstLayer
      = {
        TYPE $empty_theta(),
        CALLABLE $empty_callableDefEnv(),
        STATE $empty_stateEnv(),
        FRAME $empty_frame()
      }
  -- if localInstLayer = {TYPE $empty_theta(), FRAMES ([$empty_frame()])}
  -- if IC
      = {
        PATH ([]),
        GLOBAL globalInstLayer,
        BLOCK blockInstLayer,
        LOCAL localInstLayer
      }





dec $enter_i(instContext) : instContext

def $enter_i(IC) = IC[LOCAL.FRAMES = $empty_frame() :: IC.LOCAL.FRAMES]

dec $exit_i(instContext) : instContext

def $exit_i(IC) = IC[LOCAL.FRAMES = frame_t*]
  -- if IC.LOCAL.FRAMES = frame_h :: frame_t*





dec $enter_path_i(instContext, id) : instContext

def $enter_path_i(IC, id) = IC[PATH = IC.PATH ++ id]





dec $inherit_i(cursor, instContext) : instContext

def $inherit_i(GLOBAL, IC) = IC[BLOCK = blockInstLayer][LOCAL = localInstLayer]
  -- if blockInstLayer
      = {
        TYPE $empty_theta(),
        CALLABLE $empty_callableDefEnv(),
        STATE $empty_stateEnv(),
        FRAME $empty_frame()
      }
  -- if localInstLayer = {TYPE $empty_theta(), FRAMES ([$empty_frame()])}

def $inherit_i(BLOCK, IC) = IC[LOCAL = localInstLayer]
  -- if localInstLayer = {TYPE $empty_theta(), FRAMES ([$empty_frame()])}

def $inherit_i(LOCAL, IC) = IC





dec $add_var_i(cursor, instContext, id, value) : instContext

dec $add_vars_i(cursor, instContext, id*, value*) : instContext

def $add_var_i(GLOBAL, IC, id, value) = IC[GLOBAL.FRAME = frame]
  -- if ~$in_set<id>(id, $dom_map<id, value>(IC.GLOBAL.FRAME))
  -- if frame = $add_map<id, value>(IC.GLOBAL.FRAME, id, value)

def $add_var_i(BLOCK, IC, id, value) = IC[BLOCK.FRAME = frame]
  -- if ~$in_set<id>(id, $dom_map<id, value>(IC.BLOCK.FRAME))
  -- if frame = $add_map<id, value>(IC.BLOCK.FRAME, id, value)

def $add_var_i(LOCAL, IC, id, value) = IC[LOCAL.FRAMES = frame_h' :: frame_t*]
  -- if IC.LOCAL.FRAMES = frame_h :: frame_t*
  -- if ~$in_set<id>(id, $dom_map<id, value>(frame_h))
  -- if frame_h' = $add_map<id, value>(frame_h, id, value)

def $add_vars_i(p, IC, eps, eps) = IC

def $add_vars_i(p, IC, id_h :: id_t*, value_h :: value_t*) = IC''
  -- if IC' = $add_var_i(p, IC, id_h, value_h)
  -- if IC'' = $add_vars_i(p, IC', id_t*, value_t*)





dec $add_typeDef_i(cursor, instContext, typeId, typeDefIR) : instContext

def $add_typeDef_i(GLOBAL, IC, typeId, typeDefIR) = IC[GLOBAL.TYPE = typeDefEnv]
  -- if typeDefEnv
      = $add_map<typeId, typeDefIR>(IC.GLOBAL.TYPE, typeId, typeDefIR)





dec $add_parserState_i(instContext, nameIR, parserStateIR) : instContext

def $add_parserState_i(IC, nameIR, parserStateIR) = IC[BLOCK.STATE = stateEnv]
