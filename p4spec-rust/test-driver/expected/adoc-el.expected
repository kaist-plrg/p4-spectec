dec $sizeof(typeIR, id) : value

dec $sizeof_minSizeInBits(typeIR) : value

dec $sizeof_minSizeInBits'(typeIR) : nat

dec $sizeof_minSizeInBytes(typeIR) : value

dec $sizeof_maxSizeInBits(typeIR) : value

dec $sizeof_maxSizeInBits'(typeIR) : nat

dec $sizeof_maxSizeInBytes(typeIR) : value





def $sizeof_minSizeInBits(typeIR) = D $sizeof_minSizeInBits'(typeIR)

def $sizeof_minSizeInBits'(BOOL) = 1

def $sizeof_minSizeInBits'(INT `< w `>) = w

def $sizeof_minSizeInBits'(BIT `< w `>) = w

def $sizeof_minSizeInBits'(VARBIT `< _ `>) = 0

def $sizeof_minSizeInBits'(TYPEDEF _ typeIR) = $sizeof_minSizeInBits'(typeIR)

def $sizeof_minSizeInBits'(TYPE _ typeIR) = $sizeof_minSizeInBits'(typeIR)

def $sizeof_minSizeInBits'(ENUM _ `< typeIR `> `{ _ `})
  = $sizeof_minSizeInBits'(typeIR)

def $sizeof_minSizeInBits'(TUPLE `< typeIR* `>)
  = $sum_nat($sizeof_minSizeInBits'(typeIR)*)

def $sizeof_minSizeInBits'(ARRAY typeIR `[ n_size `])
  = $($sizeof_minSizeInBits'(typeIR) * n_size)

def $sizeof_minSizeInBits'(HEADER_STACK typeIR `[ n_size `])
  = $($sizeof_minSizeInBits'(typeIR) * n_size)

def $sizeof_minSizeInBits'(STRUCT _ `< _ `> `{ (_ typeIR _ ';')* `})
  = $sum_nat($sizeof_minSizeInBits'(typeIR)*)

def $sizeof_minSizeInBits'(HEADER _ `< _ `> `{ (_ typeIR _ ';')* `})
  = $sum_nat($sizeof_minSizeInBits'(typeIR)*)

def $sizeof_minSizeInBits'(HEADER_UNION _ `< _ `> `{ (_ typeIR _ ';')* `})
  = $min_nat($sizeof_minSizeInBits'(typeIR)*)

def $sizeof(typeIR, "minSizeInBits") = $sizeof_minSizeInBits(typeIR)





def $sizeof_minSizeInBytes(typeIR) = D $(n_size / 8)
  -- if n_size = $sizeof_minSizeInBits'(typeIR)

def $sizeof(typeIR, "minSizeInBytes") = $sizeof_minSizeInBytes(typeIR)





def $sizeof_maxSizeInBits(typeIR) = D $sizeof_maxSizeInBits'(typeIR)

def $sizeof_maxSizeInBits'(BOOL) = 1

def $sizeof_maxSizeInBits'(INT `< w `>) = w

def $sizeof_maxSizeInBits'(BIT `< w `>) = w

def $sizeof_maxSizeInBits'(VARBIT `< w `>) = w

def $sizeof_maxSizeInBits'(TYPEDEF _ typeIR) = $sizeof_maxSizeInBits'(typeIR)

def $sizeof_maxSizeInBits'(TYPE _ typeIR) = $sizeof_maxSizeInBits'(typeIR)

def $sizeof_maxSizeInBits'(ENUM _ `< typeIR `> `{ _ `})
  = $sizeof_maxSizeInBits'(typeIR)

def $sizeof_maxSizeInBits'(TUPLE `< typeIR* `>)
  = $sum_nat($sizeof_maxSizeInBits'(typeIR)*)

def $sizeof_maxSizeInBits'(ARRAY typeIR `[ n_size `])
  = $($sizeof_maxSizeInBits'(typeIR) * n_size)

def $sizeof_maxSizeInBits'(HEADER_STACK typeIR `[ n_size `])
  = $($sizeof_maxSizeInBits'(typeIR) * n_size)

def $sizeof_maxSizeInBits'(STRUCT _ `< _ `> `{ (_ typeIR _ ';')* `})
  = $sum_nat($sizeof_maxSizeInBits'(typeIR)*)

def $sizeof_maxSizeInBits'(HEADER _ `< _ `> `{ (_ typeIR _ ';')* `})
  = $sum_nat($sizeof_maxSizeInBits'(typeIR)*)

def $sizeof_maxSizeInBits'(HEADER_UNION _ `< _ `> `{ (_ typeIR _ ';')* `})
  = $max_nat($sizeof_maxSizeInBits'(typeIR)*)

def $sizeof(typeIR, "maxSizeInBits") = $sizeof_maxSizeInBits(typeIR)





def $sizeof_maxSizeInBytes(typeIR) = D $(n_size / 8)
  -- if n_size = $sizeof_maxSizeInBits'(typeIR)

def $sizeof(typeIR, "maxSizeInBytes") = $sizeof_maxSizeInBytes(typeIR)

prefixedNameIR
    : _BARE nameIR | . nameIR
    ;

dec $prefixedNonTypeName(prefixedNonTypeName) : prefixedNameIR

def $prefixedNonTypeName(nonTypeName) = _BARE $name(nonTypeName)

def $prefixedNonTypeName(_ID '.' nonTypeName) = '.' $name(nonTypeName)

dec $prefixedTypeName(prefixedTypeName) : prefixedNameIR

def $prefixedTypeName(typeName) = _BARE $name(typeName)

def $prefixedTypeName(_TID '.' typeName) = '.' $name(typeName)

dec $flatten_prefixedNameIR(prefixedNameIR) : nameIR

def $flatten_prefixedNameIR(_BARE nameIR) = nameIR

def $flatten_prefixedNameIR('.' nameIR) = "." ++ nameIR

nameListIR = nameIR*





typeParameterListIR = typeParameterIR*





parameterListIR = parameterIR*





constructorParameterListIR = parameterIR*





namedValueIR
    : nameIR = value
    ;

namedValueListIR = namedValueIR*





namedExpressionIR
    : nameIR = typedExpressionIR
    ;

namedExpressionListIR = namedExpressionIR*





literalExpressionIR = literalExpression





referenceExpressionIR = prefixedNameIR





defaultExpressionIR = defaultExpression





unaryExpressionIR
    : unop typedExpressionIR
    ;

binaryExpressionIR
    : typedExpressionIR binop typedExpressionIR
    ;

ternaryExpressionIR
    : typedExpressionIR ? typedExpressionIR : typedExpressionIR
    ;





castExpressionIR
    : ( typeIR ) typedExpressionIR
    ;





syntax typedExpressionListIR

invalidHeaderExpressionIR = invalidHeaderExpression

sequenceExpressionIR
    : SEQ { typedExpressionListIR } | SEQ { typedExpressionListIR , ... }
    ;

recordExpressionIR
    : RECORD { namedExpressionListIR } | RECORD { namedExpressionListIR , ... }
    ;

dataExpressionIR
    : invalidHeaderExpressionIR | sequenceExpressionIR | recordExpressionIR
    ;





syntax memberAccessBaseIR

errorAccessExpressionIR
    : ERROR . nameIR
    ;

memberAccessExpressionIR
    : memberAccessBaseIR . nameIR
    ;

indexAccessExpressionIR
    : typedExpressionIR [ typedExpressionIR ]
    ;

sliceAccessExpressionIR
    : typedExpressionIR [ typedExpressionIR sliceop typedExpressionIR ]
    ;

accessExpressionIR
    : errorAccessExpressionIR | memberAccessExpressionIR
    | indexAccessExpressionIR | sliceAccessExpressionIR
    ;





syntax typedLvalueIR

syntax typeArgumentListIR

syntax argumentListIR

callableTargetIR
    : referenceExpressionIR | typedExpressionIR . nameIR
    | TYPE prefixedNameIR . nameIR | ( callableTargetIR )
    ;

constructorTargetIR
    : prefixedNameIR < typeArgumentListIR >
    ;

callExpressionIR
    : constructorTargetIR ( argumentListIR )
    | callableTargetIR < typeArgumentListIR > ( argumentListIR )
    ;





parenthesizedExpressionIR
    : ( typedExpressionIR )
    ;





expressionIR
    : literalExpressionIR | referenceExpressionIR | defaultExpressionIR
    | unaryExpressionIR | binaryExpressionIR | ternaryExpressionIR
    | castExpressionIR | dataExpressionIR | accessExpressionIR
    | callExpressionIR | parenthesizedExpressionIR
    ;

expressionNoteIR
    : ( typeIR ctk )
    ;

typedExpressionIR
    : expressionIR # expressionNoteIR
    ;

typedExpressionListIR = typedExpressionIR*

memberAccessBaseIR
    : TYPE prefixedNameIR | typedExpressionIR
    ;

dec $type_of_typedExpressionIR(typedExpressionIR) : typeIR

def $type_of_typedExpressionIR(typedExpressionIR) = typeIR
  -- if _ '#' `( typeIR _ `) = typedExpressionIR

dec $ctk_of_typedExpressionIR(typedExpressionIR) : ctk

def $ctk_of_typedExpressionIR(typedExpressionIR) = ctk
  -- if _ '#' `( _ ctk `) = typedExpressionIR





simpleKeysetExpressionIR
    : typedExpressionIR | typedExpressionIR &&& typedExpressionIR
    | typedExpressionIR .. typedExpressionIR | DEFAULT | _
    ;

simpleKeysetExpressionListIR = simpleKeysetExpressionIR*

tupleKeysetExpressionIR
    : ( simpleKeysetExpressionListIR )
    ;

keysetExpressionIR
    : simpleKeysetExpressionIR | tupleKeysetExpressionIR
    ;

dec $flatten_keysetExpressionIR(keysetExpressionIR)
  : simpleKeysetExpressionListIR

def $flatten_keysetExpressionIR(simpleKeysetExpressionIR)
  = [simpleKeysetExpressionIR]

def $flatten_keysetExpressionIR(`( simpleKeysetExpressionListIR `))
  = simpleKeysetExpressionListIR





typeArgumentListIR = typeArgumentIR*





argumentIR
    : typedExpressionIR | nameIR = typedExpressionIR | nameIR = _ | _
    ;

argumentListIR = argumentIR*





lvalueIR
    : referenceExpressionIR | typedLvalueIR . nameIR
    | typedLvalueIR [ typedExpressionIR ]
    | typedLvalueIR [ typedExpressionIR sliceop typedExpressionIR ]
    | ( typedLvalueIR )
    ;

lvalueNoteIR
    : ( typeIR )
    ;

typedLvalueIR
    : lvalueIR # lvalueNoteIR
    ;

dec $type_of_typedLvalueIR(typedLvalueIR) : typeIR

def $type_of_typedLvalueIR(typedLvalueIR) = typeIR
  -- if _ '#' `( typeIR `) = typedLvalueIR

dec $typedLvalueIR_as_typedExpressionIR(typedLvalueIR) : typedExpressionIR?

def $typedLvalueIR_as_typedExpressionIR(referenceExpressionIR '#' `( typeIR `))
  = referenceExpressionIR '#' `( typeIR DYN `)

def $typedLvalueIR_as_typedExpressionIR(
    (typedLvalueIR '.' nameIR) '#' `( typeIR `))
  = (typedExpressionIR '.' nameIR) '#' `( typeIR DYN `)
  -- if typedExpressionIR = $typedLvalueIR_as_typedExpressionIR(typedLvalueIR)

def $typedLvalueIR_as_typedExpressionIR(
    (typedLvalueIR_base `[ typedExpressionIR_index `]) '#' `( typeIR `))
  = (typedExpressionIR_base `[ typedExpressionIR_index `]) '#' `( typeIR DYN `)
  -- if typedExpressionIR_base
      = $typedLvalueIR_as_typedExpressionIR(typedLvalueIR_base)

def $typedLvalueIR_as_typedExpressionIR(
    (typedLvalueIR_base `[ typedExpressionIR_hi ':' typedExpressionIR_lo `]) '#'
    `( typeIR `))
  = (typedExpressionIR_base `[ typedExpressionIR_hi ':' typedExpressionIR_lo `])
  '#' `( typeIR DYN `)
  -- if typedExpressionIR_base
      = $typedLvalueIR_as_typedExpressionIR(typedLvalueIR_base)

def $typedLvalueIR_as_typedExpressionIR(
    (typedLvalueIR_base `[ typedExpressionIR_l '+:' typedExpressionIR_w `]) '#'
    `( typeIR `))
  = (typedExpressionIR_base `[ typedExpressionIR_l '+:' typedExpressionIR_w `])
  '#' `( typeIR DYN `)
  -- if typedExpressionIR_base
      = $typedLvalueIR_as_typedExpressionIR(typedLvalueIR_base)

dec $typedExpressionIR_as_typedLvalueIR(typedExpressionIR) : typedLvalueIR?

def $typedExpressionIR_as_typedLvalueIR(
    referenceExpressionIR '#' `( typeIR _ `))
  = referenceExpressionIR '#' `( typeIR `)

def $typedExpressionIR_as_typedLvalueIR(
    (typedExpressionIR '.' nameIR) '#' `( typeIR _ `))
  = (typedLvalueIR '.' nameIR) '#' `( typeIR `)
  -- if typedLvalueIR = $typedExpressionIR_as_typedLvalueIR(typedExpressionIR)

def $typedExpressionIR_as_typedLvalueIR(
    (typedExpressionIR_base `[ typedExpressionIR_index `]) '#' `( typeIR _ `))
  = (typedLvalueIR_base `[ typedExpressionIR_index `]) '#' `( typeIR `)
  -- if typedLvalueIR_base
      = $typedExpressionIR_as_typedLvalueIR(typedExpressionIR_base)

def $typedExpressionIR_as_typedLvalueIR(
    (typedExpressionIR_base `[ typedExpressionIR_hi ':' typedExpressionIR_lo `])
    '#' `( typeIR _ `))
  = (typedLvalueIR_base `[ typedExpressionIR_hi ':' typedExpressionIR_lo `]) '#'
  `( typeIR `)
  -- if typedLvalueIR_base
      = $typedExpressionIR_as_typedLvalueIR(typedExpressionIR_base)

def $typedExpressionIR_as_typedLvalueIR(
    (typedExpressionIR_base `[ typedExpressionIR_l '+:' typedExpressionIR_w `])
    '#' `( typeIR _ `))
  = (typedLvalueIR_base `[ typedExpressionIR_l '+:' typedExpressionIR_w `]) '#'
  `( typeIR `)
  -- if typedLvalueIR_base
      = $typedExpressionIR_as_typedLvalueIR(typedExpressionIR_base)

def $typedExpressionIR_as_typedLvalueIR(
    (`( typedExpressionIR `)) '#' `( typeIR _ `))
  = (`( typedLvalueIR `)) '#' `( typeIR `)
  -- if typedLvalueIR = $typedExpressionIR_as_typedLvalueIR(typedExpressionIR)





emptyStatementIR = emptyStatement





assignmentStatementIR
    : typedLvalueIR assignop typedExpressionIR ;
    ;





callStatementIR
    : callableTargetIR < typeArgumentListIR > ( argumentListIR ) ;
    ;





directApplicationStatementIR
    : constructorTargetIR . APPLY ( argumentListIR ) ;
    ;





returnStatementIR
    : RETURN ; | RETURN typedExpressionIR ;
    ;





exitStatementIR = exitStatement





syntax blockElementStatementListIR

blockStatementIR
    : annotationList { blockElementStatementListIR }
    ;





syntax statementIR

conditionalStatementIR
    : IF ( typedExpressionIR ) statementIR
    | IF ( typedExpressionIR ) statementIR ELSE statementIR
    ;





syntax initializerOptIR

forUpdateStatementIR
    : callableTargetIR < typeArgumentListIR > ( argumentListIR )
    | typedLvalueIR assignop typedExpressionIR
    ;

forUpdateStatementListIR = forUpdateStatementIR*

forInitStatementIR
    : annotationList typeIR nameIR initializerOptIR | forUpdateStatementIR
    ;

forInitStatementListIR = forInitStatementIR*

forCollectionExpressionIR
    : typedExpressionIR | typedExpressionIR .. typedExpressionIR
    ;

forStatementIR
    : annotationList FOR
        (
          forInitStatementListIR ; typedExpressionIR ; forUpdateStatementListIR
        ) statementIR
    | annotationList FOR ( typeIR nameIR IN forCollectionExpressionIR )
        statementIR
    | annotationList FOR
        ( annotationList typeIR nameIR IN forCollectionExpressionIR )
        statementIR
    ;





switchLabelIR
    : DEFAULT | typedExpressionIR
    ;

switchCaseIR
    : switchLabelIR : blockStatementIR | switchLabelIR :
    ;

dec $switchLabelIR_of_switchCaseIR(switchCaseIR) : switchLabelIR

def $switchLabelIR_of_switchCaseIR(switchLabelIR ':' _) = switchLabelIR

def $switchLabelIR_of_switchCaseIR(switchLabelIR ':') = switchLabelIR

switchCaseListIR = switchCaseIR*

switchStatementIR
    : SWITCH ( typedExpressionIR ) { switchCaseListIR }
    ;





breakStatementIR = breakStatement

continueStatementIR = continueStatement





statementIR
    : emptyStatementIR | assignmentStatementIR | callStatementIR
    | directApplicationStatementIR | returnStatementIR | exitStatementIR
    | blockStatementIR | conditionalStatementIR | forStatementIR
    | breakStatementIR | continueStatementIR | switchStatementIR
    ;





constantDeclarationIR
    : annotationList CONST typeIR nameIR constantInitializerIR ;
    ;

initializerOptIR = initializerIR?

variableDeclarationIR
    : annotationList typeIR nameIR initializerOptIR ;
    ;

blockElementStatementIR
    : constantDeclarationIR | variableDeclarationIR | statementIR
    ;

blockElementStatementListIR = blockElementStatementIR*





functionPrototypeIR
    : typeIR nameIR < typeParameterListIR , typeParameterListIR >
        ( parameterListIR )
    ;

functionDeclarationIR
    : annotationList functionPrototypeIR blockStatementIR
    ;





actionDeclarationIR
    : annotationList ACTION nameIR ( parameterListIR ) blockStatementIR
    ;





syntax objectDeclarationListIR

objectInitializerIR
    : = { objectDeclarationListIR }
    ;

objectInitializerOptIR = objectInitializerIR?

instantiationIR
    : annotationList typeIR constructorTargetIR ( argumentListIR ) nameIR
        objectInitializerOptIR ;
    ;

objectDeclarationIR
    : functionDeclarationIR | instantiationIR
    ;

objectDeclarationListIR = objectDeclarationIR*

dec $flatten_objectInitializerOptIR(objectInitializerOptIR)
  : objectDeclarationListIR

def $flatten_objectInitializerOptIR(eps) = eps

def $flatten_objectInitializerOptIR('=' `{ objectDeclarationListIR `})
  = objectDeclarationListIR





errorDeclarationIR
    : ERROR { nameListIR }
    ;





matchKindDeclarationIR
    : MATCH_KIND { nameListIR }
    ;





enumTypeDeclarationIR
    : annotationList ENUM nameIR { nameListIR }
    | annotationList ENUM typeIR nameIR { namedValueListIR }
    ;





typeFieldIR
    : annotationList typeIR nameIR ;
    ;

typeFieldListIR = typeFieldIR*

structTypeDeclarationIR
    : annotationList STRUCT nameIR < typeParameterListIR > { typeFieldListIR }
    ;

headerTypeDeclarationIR
    : annotationList HEADER nameIR < typeParameterListIR > { typeFieldListIR }
    ;

headerUnionTypeDeclarationIR
    : annotationList HEADER_UNION nameIR < typeParameterListIR >
        { typeFieldListIR }
    ;

derivedTypeDeclarationIR
    : enumTypeDeclarationIR | structTypeDeclarationIR | headerTypeDeclarationIR
    | headerUnionTypeDeclarationIR
    ;





typedefIR
    : typeIR | derivedTypeDeclarationIR
    ;

typedefDeclarationIR
    : annotationList TYPEDEF typedefIR nameIR ;
    | annotationList TYPE typeIR nameIR ;
    ;





externFunctionDeclarationIR
    : annotationList EXTERN functionPrototypeIR ;
    ;

externConstructorPrototypeIR
    : annotationList nameIR < , typeParameterListIR > ( parameterListIR ) ;
    ;

externConstructorPrototypeListIR = externConstructorPrototypeIR*

externMethodPrototypeIR
    : annotationList functionPrototypeIR ;
    | annotationList ABSTRACT functionPrototypeIR ;
    ;

externMethodPrototypeListIR = externMethodPrototypeIR*

externObjectDeclarationIR
    : annotationList EXTERN nameIR < typeParameterListIR , >
        { externConstructorPrototypeListIR externMethodPrototypeListIR }
    ;

externDeclarationIR
    : externFunctionDeclarationIR | externObjectDeclarationIR
    ;





selectCaseIR
    : keysetExpressionIR : nameIR ;
    ;

selectCaseListIR = selectCaseIR*

selectExpressionIR
    : SELECT ( typedExpressionListIR ) { selectCaseListIR }
    ;





stateExpressionIR
    : nameIR ; | selectExpressionIR
    ;

transitionStatementIR
    : TRANSITION stateExpressionIR
    ;





valueSetDeclarationIR
    : annotationList VALUE_SET < typeIR > ( typedExpressionIR ) nameIR ;
    ;





parserTypeDeclarationIR
    : annotationList PARSER nameIR < typeParameterListIR , typeParameterListIR >
        ( parameterListIR ) ;
    ;





syntax parserBlockElementStatementIR, parserStatementIR

parserBlockElementStatementListIR = parserBlockElementStatementIR*

parserBlockStatementIR
    : annotationList { parserBlockElementStatementListIR }
    ;

parserConditionalStatementIR
    : IF ( typedExpressionIR ) parserStatementIR
    | IF ( typedExpressionIR ) parserStatementIR ELSE parserStatementIR
    ;

parserStatementIR
    : emptyStatementIR | assignmentStatementIR | callStatementIR
    | directApplicationStatementIR | parserBlockStatementIR
    | parserConditionalStatementIR
    ;

parserBlockElementStatementIR
    : constantDeclarationIR | variableDeclarationIR | parserStatementIR
    ;

parserStateIR
    : annotationList STATE nameIR
        { parserBlockElementStatementListIR transitionStatementIR }
    ;

parserStateListIR = parserStateIR*

parserLocalDeclarationIR
    : constantDeclarationIR | instantiationIR | variableDeclarationIR
    | valueSetDeclarationIR
    ;

parserLocalDeclarationListIR = parserLocalDeclarationIR*

parserDeclarationIR
    : annotationList PARSER nameIR < typeParameterListIR , typeParameterListIR >
        ( parameterListIR ) ( constructorParameterListIR )
        { parserLocalDeclarationListIR parserStateListIR }
    ;





constIR = const

constOptIR = constIR?





tableKeyIR
    : typedExpressionIR # nameIR : nameIR annotationList ;
    ;

tableKeyListIR = tableKeyIR*





controlPlaneNameIR = nameIR?

tableActionReferenceIR
    : prefixedNameIR controlPlaneNameIR ( argumentListIR )
    ;

tableActionIR
    : annotationList tableActionReferenceIR #
        ( parameterListIR , parameterListIR ) ;
    ;

tableActionListIR = tableActionIR*





tableEntryPriorityIR
    : PRIORITY = integerLiteral :
    ;

tableEntryPriorityOptIR = tableEntryPriorityIR?

tableEntryIR
    : constOptIR tableEntryPriorityOptIR keysetExpressionIR :
        tableActionReferenceIR annotationList ;
    ;

dec $tableEntryPriorityOptIR_of_tableEntryIR(tableEntryIR)
  : tableEntryPriorityOptIR

def $tableEntryPriorityOptIR_of_tableEntryIR(tableEntryIR)
  = tableEntryPriorityOptIR
  -- if _ tableEntryPriorityOptIR _ ':' _ _ ';' = tableEntryIR

tableEntryListIR = tableEntryIR*





syntax tableCustomPropertyIR





tableKeysPropertyIR
    : KEY = { tableKeyListIR }
    ;

tableActionsPropertyIR
    : ACTIONS = { tableActionListIR }
    ;

tableDefaultActionPropertyIR
    : annotationList constOptIR DEFAULT_ACTION = tableActionReferenceIR ;
    ;

tableEntriesPropertyIR
    : annotationList constOptIR ENTRIES = { tableEntryListIR }
    ;

tableCustomPropertyIR
    : annotationList constOptIR CUSTOM nameIR initializerIR ;
    | annotationList constOptIR CUSTOM_CONST nameIR constantInitializerIR ;
    ;

tablePropertyIR
    : tableKeysPropertyIR | tableActionsPropertyIR
    | tableDefaultActionPropertyIR | tableEntriesPropertyIR
    | tableCustomPropertyIR
    ;

tablePropertyListIR = tablePropertyIR*

tableDeclarationIR
    : annotationList TABLE typeIR nameIR { tablePropertyListIR }
    ;





controlTypeDeclarationIR
    : annotationList CONTROL nameIR
        < typeParameterListIR , typeParameterListIR > ( parameterListIR ) ;
    ;





controlBodyIR = blockStatementIR

controlLocalDeclarationIR
    : constantDeclarationIR | instantiationIR | variableDeclarationIR
    | actionDeclarationIR | tableDeclarationIR
    ;

controlLocalDeclarationListIR = controlLocalDeclarationIR*

controlDeclarationIR
    : annotationList CONTROL nameIR
        < typeParameterListIR , typeParameterListIR > ( parameterListIR )
        ( constructorParameterListIR )
        { controlLocalDeclarationListIR APPLY controlBodyIR }
    ;





packageTypeDeclarationIR
    : annotationList PACKAGE nameIR
        < typeParameterListIR , typeParameterListIR > ( parameterListIR ) ;
    ;





typeDeclarationIR
    : derivedTypeDeclarationIR | typedefDeclarationIR | parserTypeDeclarationIR
    | controlTypeDeclarationIR | packageTypeDeclarationIR
    ;





declarationIR
    : constantDeclarationIR | instantiationIR | functionDeclarationIR
    | actionDeclarationIR | errorDeclarationIR | matchKindDeclarationIR
    | externDeclarationIR | parserDeclarationIR | controlDeclarationIR
    | typeDeclarationIR
    ;





p4programIR
    : declarationIR* ;
    ;





dec $partition_parameterListIR(parameterIR*, nameIR*, nameIR*)
  : (parameterIR*, parameterIR*, parameterIR*)

def $partition_parameterListIR(eps, _, _) = (eps, eps, eps)

def $partition_parameterListIR(
    parameterIR_h :: parameterIR_t*,
    nameIR_default*,
    nameIR_optional*)
  = (
    parameterIR_given*,
    parameterIR_h :: parameterIR_default*,
    parameterIR_optional*)
  -- if (parameterIR_given*, parameterIR_default*, parameterIR_optional*)
      = $partition_parameterListIR(
          parameterIR_t*,
          nameIR_default*,
          nameIR_optional*)
  -- if _ _ _ nameIR_h _ = parameterIR_h
  -- if nameIR_h <- nameIR_default*

def $partition_parameterListIR(
    parameterIR_h :: parameterIR_t*,
    nameIR_default*,
    nameIR_optional*)
  = (
    parameterIR_given*,
    parameterIR_default*,
    parameterIR_h :: parameterIR_optional*)
  -- if (parameterIR_given*, parameterIR_default*, parameterIR_optional*)
      = $partition_parameterListIR(
          parameterIR_t*,
          nameIR_default*,
          nameIR_optional*)
  -- if _ _ _ nameIR_h _ = parameterIR_h
  -- if nameIR_h <- nameIR_optional*

def $partition_parameterListIR(
    parameterIR_h :: parameterIR_t*,
    nameIR_default*,
    nameIR_optional*)
  = (
    parameterIR_h :: parameterIR_given*,
    parameterIR_default*,
    parameterIR_optional*)
  -- if (parameterIR_given*, parameterIR_default*, parameterIR_optional*)
      = $partition_parameterListIR(
          parameterIR_t*,
          nameIR_default*,
          nameIR_optional*)
  -- if _ _ _ nameIR_h _ = parameterIR_h
  -- if ~(nameIR_h <- nameIR_default*)
  -- if ~(nameIR_h <- nameIR_optional*)





callAlign
    : GIVEN parameterIR* DEFAULT parameterIR* OPTIONAL parameterIR*
    ;

dec $align_parameterListIR(parameterIR*, argumentIR*, nameIR*, nameIR*)
  : callAlign

dec $align_parameterListIR_given(
    map<id, parameterIR>,
    parameterIR*,
    argumentIR*)
  : parameterIR*

def $align_parameterListIR(
    parameterIR*,
    argumentIR*,
    nameIR_default*,
    nameIR_optional*)
  = GIVEN parameterIR_given_aligned* DEFAULT parameterIR_default* OPTIONAL
  parameterIR_optional*
  -- if (parameterIR_given*, parameterIR_default*, parameterIR_optional*)
      = $partition_parameterListIR(
          parameterIR*,
          nameIR_default*,
          nameIR_optional*)
  -- (if (_ _ _ nameIR_given _ = parameterIR_given))*
  -- if parameterIR_given_aligned*
      = $align_parameterListIR_given(
          `{ (nameIR_given ':' parameterIR_given)* `},
          parameterIR_given*,
          argumentIR*)

def $align_parameterListIR_given(`{ (id ':' parameterIR)* `}, eps, eps) = eps

def $align_parameterListIR_given(
    `{ (id ':' parameterIR)* `},
    parameterIR_h :: parameterIR_t*,
    argumentIR_h :: argumentIR_t*)
  = parameterIR_h :: parameterIR_aligned*
  -- if argumentIR_h = typedExpressionIR
  -- if parameterIR_aligned*
      = $align_parameterListIR_given(
          `{ (id ':' parameterIR)* `},
          parameterIR_t*,
          argumentIR_t*)

def $align_parameterListIR_given(
    `{ (id ':' parameterIR)* `},
    parameterIR_h :: parameterIR_t*,
    argumentIR_h :: argumentIR_t*)
  = parameterIR_h :: parameterIR_aligned*
  -- if argumentIR_h = '_'
  -- if parameterIR_aligned*
      = $align_parameterListIR_given(
          `{ (id ':' parameterIR)* `},
          parameterIR_t*,
          argumentIR_t*)

def $align_parameterListIR_given(
    `{ (id ':' parameterIR)* `},
    parameterIR_h :: parameterIR_t*,
    argumentIR_h :: argumentIR_t*)
  = parameterIR_match :: parameterIR_aligned*
  -- if argumentIR_h = nameIR '=' _
  -- if parameterIR_match
      = $find_map<id, parameterIR>(`{ (id ':' parameterIR)* `}, nameIR)
  -- if parameterIR_aligned*
      = $align_parameterListIR_given(
          `{ (id ':' parameterIR)* `},
          parameterIR_t*,
          argumentIR_t*)

def $align_parameterListIR_given(
    `{ (id ':' parameterIR)* `},
    parameterIR_h :: parameterIR_t*,
    argumentIR_h :: argumentIR_t*)
  = parameterIR_match :: parameterIR_aligned*
  -- if argumentIR_h = nameIR '=' '_'
  -- if parameterIR_match
      = $find_map<id, parameterIR>(`{ (id ':' parameterIR)* `}, nameIR)
  -- if parameterIR_aligned*
      = $align_parameterListIR_given(
          `{ (id ':' parameterIR)* `},
          parameterIR_t*,
          argumentIR_t*)

callTargetKey
    : nameIR ( id?* )
    ;

namedCallTargetKey
    : nameIR ( id* )
    ;

unnamedCallTargetKey
    : nameIR ( nat )
    ;

callTargetParameter
    : nameIR # bool # bool
    ;

callTargetValue = callTargetParameter*

callTargetMatch
    : MATCH id* id* | NOMATCH
    ;

callResolution<V>
    : callableId : V # nameIR* # nameIR*
    ;

dec $callTargetKey(nameIR, argumentListIR) : callTargetKey

dec $callTargetKey'(argumentIR) : id?

def $callTargetKey(nameIR_f, argumentIR*) = nameIR_f `( id_arg?* `)
  -- (if (id_arg? = $callTargetKey'(argumentIR)))*

def $callTargetKey'(typedExpressionIR) = eps

def $callTargetKey'(id_arg '=' _) = id_arg

def $callTargetKey'(id_arg '=' '_') = id_arg

def $callTargetKey'('_') = eps





dec $match_overloaded_named<V>(
    pair<callTargetId, V>,
    namedCallTargetKey,
    def $get_parameterListIR(V) : parameterListIR)
  : callTargetMatch





def $match_overloaded_named<V>(
    (callTargetId ':' V),
    nameIR_f `( id_arg* `),
    def $get_parameterListIR)
  = $ite<callTargetMatch>(
      $eq_set<id>(`{ id_param* `}, `{ id_arg* `}),
      MATCH eps eps,
      NOMATCH)
  -- if nameIR_f `( id_param* `) = callTargetId
  -- if parameterIR* = $get_parameterListIR(V)
  -- (if (id_param = $id_of_parameterIR(parameterIR)))*
  -- if |id_param*| = |id_arg*|





def $match_overloaded_named<V>(
    (callTargetId ':' V),
    nameIR_f `( id_arg* `),
    def $get_parameterListIR)
  = MATCH id_default* id_optional*
  -- if nameIR_f `( id_param* `) = callTargetId
  -- if parameterIR* = $get_parameterListIR(V)
  -- (if (id_param = $id_of_parameterIR(parameterIR)))*
  -- (if (b_default = $is_default_parameterIR(parameterIR)))*
  -- (if (b_optional = $is_optional_parameterIR(parameterIR)))*
  -- if $(|id_param*| > |id_arg*|)
  -- if `{ id_param_omitted* `} = $diff_set<id>(`{ id_param* `}, `{ id_arg* `})
  -- if id_default_param*
      = $filter_<id>(id_param*, $is_default_parameterIR(parameterIR)*)
  -- if id_default*
      = $filter_<id>(
          id_param_omitted*,
          (id_param_omitted <- id_default_param*)*)
  -- if id_optional_param*
      = $filter_<id>(id_param*, $is_optional_parameterIR(parameterIR)*)
  -- if id_optional*
      = $filter_<id>(
          id_param_omitted*,
          (id_param_omitted <- id_optional_param*)*)
  -- if $eq_set<id>(`{ id_default* ++ id_optional* `}, `{ id_param_omitted* `})





def $match_overloaded_named<V>(
    (callTargetId ':' V),
    nameIR_f `( id_arg* `),
    def $get_parameterListIR)
  = NOMATCH
  -- otherwise





dec $match_overloaded_unnamed<V>(
    pair<callTargetId, V>,
    unnamedCallTargetKey,
    def $get_parameterListIR(V) : parameterListIR)
  : callTargetMatch





def $match_overloaded_unnamed<V>(
    (callTargetId ':' V),
    nameIR_f `( n_arg `),
    def $get_parameterListIR)
  = MATCH eps eps
  -- if nameIR_f `( id_param* `) = callTargetId
  -- if parameterIR* = $get_parameterListIR(V)
  -- (if (b_default = $is_default_parameterIR(parameterIR)))*
  -- (if (b_optional = $is_optional_parameterIR(parameterIR)))*
  -- if ~($exists_(b_default*) /\ $exists_(b_optional*))
  -- if |id_param*| = n_arg





def $match_overloaded_unnamed<V>(
    (callTargetId ':' V),
    nameIR_f `( n_arg `),
    def $get_parameterListIR)
  = MATCH id_default* eps
  -- if nameIR_f `( id_param* `) = callTargetId
  -- if parameterIR* = $get_parameterListIR(V)
  -- (if (b_default = $is_default_parameterIR(parameterIR)))*
  -- (if (b_optional = $is_optional_parameterIR(parameterIR)))*
  -- if ~($exists_(b_default*) /\ $exists_(b_optional*))
  -- if $(|id_param*| > n_arg)
  -- if (parameterIR_given*, parameterIR_omitted*)
      = $partition_<parameterIR>(parameterIR*, n_arg)
  -- (if (~$is_optional_parameterIR(parameterIR_omitted)))*
  -- (if $is_default_parameterIR(parameterIR_omitted))*
  -- (if (id_default = $id_of_parameterIR(parameterIR_omitted)))*





def $match_overloaded_unnamed<V>(
    (callTargetId ':' V),
    nameIR_f `( n_arg `),
    def $get_parameterListIR)
  = MATCH eps id_optional*
  -- if nameIR_f `( id_param* `) = callTargetId
  -- if parameterIR* = $get_parameterListIR(V)
  -- (if (b_default = $is_default_parameterIR(parameterIR)))*
  -- (if (b_optional = $is_optional_parameterIR(parameterIR)))*
  -- if ~($exists_(b_default*) /\ $exists_(b_optional*))
  -- if $(|id_param*| > n_arg)
  -- if (parameterIR_given*, parameterIR_omitted*)
      = $partition_<parameterIR>(parameterIR*, n_arg)
  -- (if (~$is_default_parameterIR(parameterIR_given)))*
  -- (if $is_optional_parameterIR(parameterIR_omitted))*
  -- (if (id_optional = $id_of_parameterIR(parameterIR_omitted)))*





def $match_overloaded_unnamed<V>(
    (callTargetId ':' V),
    nameIR_f `( n_arg `),
    def $get_parameterListIR)
  = NOMATCH
  -- otherwise





dec $find_overloadeds_named<V>(
    map<callableId, V>,
    namedCallTargetKey,
    def $get_parameterListIR(V) : parameterListIR)
  : callResolution<V>*

def $find_overloadeds_named<V>(
    `{ eps `},
    nameIR_f `( id_arg* `),
    def $get_parameterListIR)
  = eps

def $find_overloadeds_named<V>(
    `{ (callTargetId_h ':' V_h) :: (callTargetId_t ':' V_t)* `},
    nameIR_f `( id_arg* `),
    def $get_parameterListIR)
  = $find_overloadeds_named<V>(
      `{ (callTargetId_t ':' V_t)* `},
      nameIR_f `( id_arg* `),
      def $get_parameterListIR)
  -- if NOMATCH
      = $match_overloaded_named<V>(
          (callTargetId_h ':' V_h),
          nameIR_f `( id_arg* `),
          def $get_parameterListIR)

def $find_overloadeds_named<V>(
    `{ (callTargetId_h ':' V_h) :: (callTargetId_t ':' V_t)* `},
    nameIR_f `( id_arg* `),
    def $get_parameterListIR)
  = (callTargetId_h ':' V_h '#' id_default* '#' id_optional*)
      :: $find_overloadeds_named<V>(
          `{ (callTargetId_t ':' V_t)* `},
          nameIR_f `( id_arg* `),
          def $get_parameterListIR)
  -- if MATCH id_default* id_optional*
      = $match_overloaded_named<V>(
          (callTargetId_h ':' V_h),
          nameIR_f `( id_arg* `),
          def $get_parameterListIR)





dec $find_overloadeds_unnamed<V>(
    map<callableId, V>,
    unnamedCallTargetKey,
    def $get_parameterListIR(V) : parameterListIR)
  : callResolution<V>*

def $find_overloadeds_unnamed<V>(
    `{ eps `},
    nameIR_f `( nat `),
    def $get_parameterListIR)
  = eps

def $find_overloadeds_unnamed<V>(
    `{ (callTargetId_h ':' V_h) :: (callTargetId_t ':' V_t)* `},
    nameIR_f `( n_arg `),
    def $get_parameterListIR)
  = $find_overloadeds_unnamed<V>(
      `{ (callTargetId_t ':' V_t)* `},
      nameIR_f `( n_arg `),
      def $get_parameterListIR)
  -- if NOMATCH
      = $match_overloaded_unnamed<V>(
          (callTargetId_h ':' V_h),
          nameIR_f `( n_arg `),
          def $get_parameterListIR)

def $find_overloadeds_unnamed<V>(
    `{ (callTargetId_h ':' V_h) :: (callTargetId_t ':' V_t)* `},
    nameIR_f `( n_arg `),
    def $get_parameterListIR)
  = (callTargetId_h ':' V_h '#' id_default* '#' id_optional*)
      :: $find_overloadeds_unnamed<V>(
          `{ (callTargetId_t ':' V_t)* `},
          nameIR_f `( n_arg `),
          def $get_parameterListIR)
  -- if MATCH id_default* id_optional*
      = $match_overloaded_unnamed<V>(
          (callTargetId_h ':' V_h),
          nameIR_f `( n_arg `),
          def $get_parameterListIR)





dec $find_overloaded<V>(
    map<callTargetId, V>,
    callTargetKey,
    def $get_parameterListIR(V) : parameterListIR)
  : callResolution<V>?





def $find_overloaded<V>(
    `{ (callableId ':' V)* `},
    nameIR_f `( id_arg?* `),
    def $get_parameterListIR)
  = eps
  -- if $(|(id_arg?)*| > 0)
  -- (if (id_arg_inner = id_arg?))*
  -- if eps
      = $find_overloadeds_named<V>(
          `{ (callableId ':' V)* `},
          nameIR_f `( id_arg_inner* `),
          def $get_parameterListIR)

def $find_overloaded<V>(
    `{ (callableId ':' V)* `},
    nameIR_f `( id_arg?* `),
    def $get_parameterListIR)
  = callableId_found ':' V_found '#' id_default* '#' id_optional*
  -- if $(|(id_arg?)*| > 0)
  -- (if (id_arg_inner = id_arg?))*
  -- if callableId_found ':' V_found '#' id_default* '#' id_optional*
      = $find_overloadeds_named<V>(
          `{ (callableId ':' V)* `},
          nameIR_f `( id_arg_inner* `),
          def $get_parameterListIR)





def $find_overloaded<V>(
    `{ (callableId ':' V)* `},
    nameIR_f `( id_arg?* `),
    def $get_parameterListIR)
  = eps
  -- (if (id_arg? = eps))*
  -- if eps
      = $find_overloadeds_unnamed<V>(
          `{ (callableId ':' V)* `},
          nameIR_f `( |id_arg?*| `),
          def $get_parameterListIR)

def $find_overloaded<V>(
    `{ (callableId ':' V)* `},
    nameIR_f `( id_arg?* `),
    def $get_parameterListIR)
  = callableId_found ':' V_found '#' id_omitted* '#' id_optional*
  -- (if (id_arg? = eps))*
  -- if callableId_found ':' V_found '#' id_omitted* '#' id_optional*
      = $find_overloadeds_unnamed<V>(
          `{ (callableId ':' V)* `},
          nameIR_f `( |id_arg?*| `),
          def $get_parameterListIR)





dec $find_non_overloaded<V>(map<callableId, V>, nameIR) : (callableId, V)?

dec $find_non_overloadeds<V>(map<callableId, V>, nameIR) : (callableId, V)*

def $find_non_overloaded<V>(`{ (callableId ':' V)* `}, nameIR_f)
