rulegroup ControlLocalDecl_inst/tableDeclarationIR {

  rule ControlLocalDecl_inst/tableDeclarationIR-no-name-annotation:
    IC_0 STO_0
        |- annotationList TABLE typeIR nameIR `{ tablePropertyListIR `}
            : IC_1 STO_2 constantDeclarationIR
    -- if IC_callee_0 = $inherit_i(BLOCK, IC_0)
    -- if IC_frame = $enter_i(IC_callee_0)
    -- TableProperties_inst:
        IC_frame STO_0 |- tablePropertyListIR : STO_1 tablePropertyListIR_inst
    -- if TBL = $init_table(tablePropertyListIR_inst)
    -- if frame :: _ = IC_frame.LOCAL.FRAMES
    -- if object_table = TABLE nameIR `{ frame TBL `}
    -- if nameIR_object = $name_annotation_default(annotationList, nameIR)
    -- if objectId = IC_0.PATH ++ nameIR_object
    -- if STO_2 = $add_store(STO_1, objectId, object_table)
    -- if eps = $name_annotation(annotationList)
    -- if IC_1 = $add_var_i(BLOCK, IC_0, nameIR, REF objectId)
    -- if constantDeclarationIR
        = _EMPTY CONST typeIR nameIR ('=' _VALUE (REF objectId)) ';'

  rule ControlLocalDecl_inst/tableDeclarationIR-name-annotation:
    IC_0 STO_0
        |- annotationList TABLE typeIR nameIR `{ tablePropertyListIR `}
            : IC_1 STO_3 constantDeclarationIR
    -- if IC_callee_0 = $inherit_i(BLOCK, IC_0)
    -- if IC_frame = $enter_i(IC_callee_0)
    -- TableProperties_inst:
        IC_frame STO_0 |- tablePropertyListIR : STO_1 tablePropertyListIR_inst
    -- if TBL = $init_table(tablePropertyListIR_inst)
    -- if frame :: _ = IC_frame.LOCAL.FRAMES
    -- if object_table = TABLE nameIR `{ frame TBL `}
    -- if nameIR_object = $name_annotation_default(annotationList, nameIR)
    -- if objectId = IC_0.PATH ++ nameIR_object
    -- if STO_2 = $add_store(STO_1, objectId, object_table)
    -- if nameIR_annotation = $name_annotation(annotationList)
    -- if objectId_annotation = IC_0.PATH ++ nameIR_annotation
    -- if STO_3 = $add_store(STO_2, objectId_annotation, object_table)
    -- if IC_1 = $add_var_i(BLOCK, IC_0, nameIR, REF objectId)
    -- if constantDeclarationIR
        = _EMPTY CONST typeIR nameIR ('=' _VALUE (REF objectId)) ';'

}





rulegroup ControlLocalDecls_inst {

  rule ControlLocalDecls_inst/nil:
    IC STO |- eps : IC STO eps

  rule ControlLocalDecls_inst/cons-none:
    IC_0 STO_0
        |- controlLocalDeclarationIR_h :: controlLocalDeclarationIR_t*
            : IC_2 STO_2 controlLocalDeclarationIR_t_inst*
    -- ControlLocalDecl_inst:
        IC_0 STO_0 |- controlLocalDeclarationIR_h : IC_1 STO_1 eps
    -- ControlLocalDecls_inst:
        IC_1 STO_1
            |- controlLocalDeclarationIR_t*
                : IC_2 STO_2 controlLocalDeclarationIR_t_inst*

  rule ControlLocalDecls_inst/cons-some:
    IC_0 STO_0
        |- controlLocalDeclarationIR_h :: controlLocalDeclarationIR_t*
            : IC_2 STO_2
            (
              controlLocalDeclarationIR_h_inst
                  :: controlLocalDeclarationIR_t_inst*)
    -- ControlLocalDecl_inst:
        IC_0 STO_0
            |- controlLocalDeclarationIR_h
                : IC_1 STO_1 controlLocalDeclarationIR_h_inst
    -- ControlLocalDecls_inst:
        IC_1 STO_1
            |- controlLocalDeclarationIR_t*
                : IC_2 STO_2 controlLocalDeclarationIR_t_inst*

}

rulegroup Constructor_inst {

  rule Constructor_inst/non-aliased-none-type:
    p IC
        |- prefixedNameIR `< typeArgumentIR* `> `( argumentIR* `)
            : constructorDef `< typeArgumentIR* `>
            `( '#' id_default* '#' id_optional* `)
    -- if eps = $find_typeDef_i(p, IC, prefixedNameIR)
    -- if _ ':' constructorDef '#' id_default* '#' id_optional*
        = $find_constructorDef_i(IC, prefixedNameIR, argumentIR*)

  rule Constructor_inst/non-aliased-some-type:
    p IC
        |- prefixedNameIR `< typeArgumentIR* `> `( argumentIR* `)
            : constructorDef `< typeArgumentIR* `>
            `( '#' id_default* '#' id_optional* `)
    -- if typeDefIR = $find_typeDef_i(p, IC, prefixedNameIR)
    -- if ~(typeDefIR <: typedefTypeIR)
    -- if _ ':' constructorDef '#' id_default* '#' id_optional*
        = $find_constructorDef_i(IC, prefixedNameIR, argumentIR*)

  rule Constructor_inst/aliased:
    p IC
        |- prefixedNameIR `< eps `> `( argumentIR* `)
            : constructorDef `< typeArgumentIR* `>
            `( '#' id_default* '#' id_optional* `)
    -- if TYPEDEF nameIR_alias typeIR_alias
        = $find_typeDef_i(p, IC, prefixedNameIR)
    -- if (nameIR, typeArgumentIR*) = $resolve_type_alias(typeIR_alias)
    -- if _ ':' constructorDef '#' id_default* '#' id_optional*
        = $find_constructorDef_i(IC, _BARE nameIR, argumentIR*)

}

rule Copy_in_arg_inst:
  STO_0 p_caller IC_caller argumentIR '@' p_callee IC_callee_0 id
      ~> STO_1 IC_callee_1
  -- if IC_caller_inner = $enter_path_i(IC_caller, id)
  -- Argument_inst: p_caller IC_caller_inner STO_0 |- argumentIR : STO_1 value
  -- if IC_callee_1 = $add_var_i(p_callee, IC_callee_0, id, value)

rulegroup Copy_in_inst {

  rule Copy_in_inst/nil:
    STO p_caller IC_caller eps '@' p_callee IC_callee eps ~> STO IC_callee

  rule Copy_in_inst/cons:
    STO_0 p_caller IC_caller (argumentIR_h :: argumentIR_t*) '@' p_callee
    IC_callee_0 (id_h :: id_t*)
        ~> STO_2 IC_callee_2
    -- Copy_in_arg_inst:
        STO_0 p_caller IC_caller argumentIR_h '@' p_callee IC_callee_0 id_h
            ~> STO_1 IC_callee_1
    -- Copy_in_inst:
        STO_1 p_caller IC_caller argumentIR_t* '@' p_callee IC_callee_1 id_t*
            ~> STO_2 IC_callee_2

}

rulegroup Copy_in_arg_inst_default {

  rule Copy_in_arg_inst_default/initializerIR:
    STO_0 p_caller IC_caller '@' p_callee IC_callee_0 parameterIR
        ~> STO_1 IC_callee_1
    -- if _ _ _ id ('=' typedExpressionIR) = parameterIR
    -- if IC_caller_inner = $enter_path_i(IC_caller, id)
    -- Expr_inst:
        p_caller IC_caller_inner STO_0 |- typedExpressionIR : STO_1 value
    -- if IC_callee_1 = $add_var_i(p_callee, IC_callee_0, id, value)

  rule Copy_in_arg_inst_default/constantInitializerIR:
    STO p_caller IC_caller '@' p_callee IC_callee_0 parameterIR
        ~> STO IC_callee_1
    -- if _ _ _ id ('=' _VALUE value) = parameterIR
    -- if IC_callee_1 = $add_var_i(p_callee, IC_callee_0, id, value)

}

rulegroup Copy_in_inst_default {

  rule Copy_in_inst_default/nil:
    STO p_caller IC_caller '@' p_callee IC_callee eps ~> STO IC_callee

  rule Copy_in_inst_default/cons:
    STO_0 p_caller IC_caller '@' p_callee IC_callee_0
    (parameterIR_h :: parameterIR_t*)
        ~> STO_2 IC_callee_2
    -- Copy_in_arg_inst_default:
        STO_0 p_caller IC_caller '@' p_callee IC_callee_0 parameterIR_h
            ~> STO_1 IC_callee_1
    -- Copy_in_inst_default:
        STO_1 p_caller IC_caller '@' p_callee IC_callee_1 parameterIR_t*
            ~> STO_2 IC_callee_2

}





rule Constructor_call/externConstructorDef:
  p IC STO_0
      |- externObjectConstructorDef `< typeArgumentIR* `>
      `( argumentIR* '#' id_default* '#' id_optional* `)
          : STO_2 object_extern
  -- if EXTERN nameIR `< typeParameterIR* `> `( constructorParameterIR* `)
  `{ externMethodPrototypeIR* `}
      = externObjectConstructorDef
  -- if p_callee = BLOCK
  -- if IC_callee_0 = $inherit_i(GLOBAL, IC)
  -- if theta = `{ (typeParameterIR ':' typeArgumentIR)* `}
  -- if IC_callee_1 = IC_callee_0[BLOCK.TYPE = theta]
  -- if GIVEN constructorParameterIR_aligned* DEFAULT
  constructorParameterIR_default* OPTIONAL _
      = $align_parameterListIR(
          constructorParameterIR*,
          argumentIR*,
          id_default*,
          id_optional*)
  -- (if (_ _ _ id_aligned _ = constructorParameterIR_aligned))*
  -- Copy_in_inst:
      STO_0 p IC argumentIR* '@' p_callee IC_callee_1 id_aligned*
          ~> STO_1 IC_callee_2
  -- Copy_in_inst_default:
      STO_1 p IC '@' p_callee IC_callee_2 constructorParameterIR_default*
          ~> STO_2 IC_callee_3
  -- ExternMethods_inst: IC_callee_3 |- externMethodPrototypeIR* : IC_callee_4
  -- if `{ (callableId ':' externMethodDef)* `} = IC_callee_4.BLOCK.CALLABLE
  -- (if (_ _ _ id_default _ = constructorParameterIR_default))*
  -- if id_cparam* = id_aligned* ++ id_default*
  -- (if (
    value_cparam = $find_map<id, value>(IC_callee_4.BLOCK.FRAME, id_cparam)))*
  -- if objectState
      = $init_objectState(nameIR, typeArgumentIR*, id_cparam*, value_cparam*)
  -- if theta_extern = IC_callee_4.BLOCK.TYPE
  -- if frame_extern = IC_callee_4.BLOCK.FRAME
  -- if externMethodDefEnv_extern = `{ (callableId ':' externMethodDef)* `}
  -- if object_extern
      = EXTERN nameIR `< theta_extern `>
      `{ objectState frame_extern externMethodDefEnv_extern `}





rule Constructor_call/parserConstructorDef:
  p IC STO_0
      |- parserObjectConstructorDef `< typeArgumentIR* `>
      `( argumentIR* '#' id_default* '#' id_optional* `)
          : STO_4 object_parser
  -- if PARSER `< typeParameterIR* `> `( parameterIR* `)
  `( constructorParameterIR* `) `{ parserLocalDeclarationIR* parserStateIR* `}
      = parserObjectConstructorDef
  -- if p_callee = BLOCK
  -- if IC_callee_0 = $inherit_i(GLOBAL, IC)
  -- if theta_parser = `{ (typeParameterIR ':' typeArgumentIR)* `}
  -- if IC_callee_1 = IC_callee_0[BLOCK.TYPE = theta_parser]
  -- if GIVEN constructorParameterIR_aligned* DEFAULT
  constructorParameterIR_default* OPTIONAL _
      = $align_parameterListIR(
          constructorParameterIR*,
          argumentIR*,
          id_default*,
          id_optional*)
  -- (if (_ _ _ id_aligned _ = constructorParameterIR_aligned))*
  -- Copy_in_inst:
      STO_0 p IC argumentIR* '@' p_callee IC_callee_1 id_aligned*
          ~> STO_1 IC_callee_2
  -- Copy_in_inst_default:
      STO_1 p IC '@' p_callee IC_callee_2 constructorParameterIR_default*
          ~> STO_2 IC_callee_3
  -- ParserLocalDecls_inst:
      IC_callee_3 STO_2
          |- parserLocalDeclarationIR*
              : IC_local STO_3 parserLocalDeclarationIR_inst*
  -- ParserStates_inst: IC_local STO_3 |- parserStateIR* : IC_state STO_4
  -- if frame_parser = IC_callee_3.BLOCK.FRAME
  -- if stateEnv_parser = IC_state.BLOCK.STATE
  -- if object_parser
      = PARSER `< theta_parser `> `( parameterIR* `)
      `{ frame_parser parserLocalDeclarationIR_inst* stateEnv_parser `}





rule Constructor_call/controlConstructorDef:
  p IC STO_0
      |- controlObjectConstructorDef `< typeArgumentIR* `>
      `( argumentIR* '#' id_default* '#' id_optional* `)
          : STO_4 object_control
  -- if CONTROL `< typeParameterIR* `> `( parameterIR* `)
  `( constructorParameterIR* `)
  `{ controlLocalDeclarationIR* APPLY controlBodyIR `}
      = controlObjectConstructorDef
  -- if p_callee = BLOCK
  -- if IC_callee_0 = $inherit_i(GLOBAL, IC)
  -- if theta_control = `{ (typeParameterIR ':' typeArgumentIR)* `}
  -- if IC_callee_1 = IC_callee_0[BLOCK.TYPE = theta_control]
  -- if GIVEN constructorParameterIR_aligned* DEFAULT
  constructorParameterIR_default* OPTIONAL _
      = $align_parameterListIR(
          constructorParameterIR*,
          argumentIR*,
          id_default*,
          id_optional*)
  -- (if (_ _ _ id_aligned _ = constructorParameterIR_aligned))*
  -- Copy_in_inst:
      STO_0 p IC argumentIR* '@' p_callee IC_callee_1 id_aligned*
          ~> STO_1 IC_callee_2
  -- Copy_in_inst_default:
      STO_1 p IC '@' p_callee IC_callee_2 constructorParameterIR_default*
          ~> STO_2 IC_callee_3
  -- ControlLocalDecls_inst:
      IC_callee_3 STO_2
          |- controlLocalDeclarationIR*
              : IC_local_0 STO_3 controlLocalDeclarationIR_inst*
  -- Block_inst:
      IC_local_0 STO_3 |- controlBodyIR : IC_local_1 STO_4 controlBodyIR_inst
  -- if frame_control = IC_callee_3.BLOCK.FRAME
  -- if `{ (callableId ':' actionDef)* `} = IC_local_1.BLOCK.CALLABLE
  -- if actionDefEnv_control = `{ (callableId ':' actionDef)* `}
  -- if object_control
      = CONTROL `< theta_control `> `( parameterIR* `)
      `{
        frame_control controlLocalDeclarationIR_inst*
        `{ (callableId ':' actionDef)* `} controlBodyIR_inst
      `}





rule Constructor_call/packageConstructorDef:
  p IC STO_0
      |- packageObjectConstructorDef `< typeArgumentIR* `>
      `( argumentIR* '#' id_default* '#' id_optional* `)
          : STO_2 object_package
  -- if PACKAGE `< typeParameterIR* `> `( constructorParameterIR* `)
      = packageObjectConstructorDef
  -- if p_callee = BLOCK
  -- if IC_callee_0 = $inherit_i(GLOBAL, IC)
  -- if IC_callee_1
      = IC_callee_0[BLOCK.TYPE = `{ (typeParameterIR ':' typeArgumentIR)* `}]
  -- if GIVEN constructorParameterIR_aligned* DEFAULT
  constructorParameterIR_default* OPTIONAL _
      = $align_parameterListIR(
          constructorParameterIR*,
          argumentIR*,
          id_default*,
          id_optional*)
  -- (if (_ _ _ id_aligned _ = constructorParameterIR_aligned))*
  -- Copy_in_inst:
      STO_0 p IC argumentIR* '@' p_callee IC_callee_1 id_aligned*
          ~> STO_1 IC_callee_2
  -- Copy_in_inst_default:
      STO_1 p IC '@' p_callee IC_callee_2 constructorParameterIR_default*
          ~> STO_2 IC_callee_3
  -- if theta_package = IC_callee_3.BLOCK.TYPE
  -- if frame_package = IC_callee_3.BLOCK.FRAME
  -- if object_package = PACKAGE `< theta_package `> `{ frame_package `}





globalEvalLayer = globalInstLayer





blockEvalLayer = blockInstLayer





localEvalLayer = localInstLayer





evalContext = {
  GLOBAL globalEvalLayer,
  BLOCK blockEvalLayer,
  LOCAL localEvalLayer
}

var EC : evalContext





dec $enter_e(evalContext) : evalContext

def $enter_e(EC) = EC[LOCAL.FRAMES = $empty_frame() :: EC.LOCAL.FRAMES]

dec $exit_e(evalContext) : evalContext

def $exit_e(EC) = EC[LOCAL.FRAMES = frame_t*]
  -- if EC.LOCAL.FRAMES = frame_h :: frame_t*





dec $inherit_e(cursor, evalContext) : evalContext

def $inherit_e(GLOBAL, EC) = EC[BLOCK = blockEvalLayer][LOCAL = localEvalLayer]
  -- if blockEvalLayer
      = {
        TYPE $empty_theta(),
        CALLABLE $empty_callableDefEnv(),
        STATE $empty_stateEnv(),
        FRAME $empty_frame()
      }
  -- if localEvalLayer = {TYPE $empty_theta(), FRAMES ([$empty_frame()])}

def $inherit_e(BLOCK, EC) = EC[LOCAL = localEvalLayer]
  -- if localEvalLayer = {TYPE $empty_theta(), FRAMES ([$empty_frame()])}

def $inherit_e(LOCAL, EC) = EC





dec $copy_e(cursor, evalContext, evalContext) : evalContext

def $copy_e(GLOBAL, EC_from, EC_to) = EC_to[GLOBAL = EC_from.GLOBAL]

def $copy_e(BLOCK, EC_from, EC_to)
  = EC_to[GLOBAL = EC_from.GLOBAL][BLOCK = EC_from.BLOCK]

def $copy_e(LOCAL, EC_from, EC_to)
  = EC_to[GLOBAL = EC_from.GLOBAL][BLOCK = EC_from.BLOCK][LOCAL = EC_from.LOCAL]





dec $add_var_e(cursor, evalContext, prefixedNameIR, value) : evalContext

dec $add_vars_e(cursor, evalContext, prefixedNameIR*, value*) : evalContext

def $add_var_e(GLOBAL, EC, '.' id, value) = EC[GLOBAL.FRAME = frame]
  -- if frame = $add_map<id, value>(EC.GLOBAL.FRAME, id, value)

def $add_var_e(GLOBAL, EC, _BARE id, value) = EC[GLOBAL.FRAME = frame]
  -- if frame = $add_map<id, value>(EC.GLOBAL.FRAME, id, value)

def $add_var_e(BLOCK, EC, _BARE id, value) = EC[BLOCK.FRAME = frame]
  -- if frame = $add_map<id, value>(EC.BLOCK.FRAME, id, value)

def $add_var_e(LOCAL, EC, _BARE id, value)
  = EC[LOCAL.FRAMES = frame_h' :: frame_t*]
  -- if EC.LOCAL.FRAMES = frame_h :: frame_t*
  -- if frame_h' = $add_map<id, value>(frame_h, id, value)

def $add_vars_e(p, EC, eps, eps) = EC

def $add_vars_e(
    p,
    EC,
    prefixedNameIR_h :: prefixedNameIR_t*,
    value_h :: value_t*)
  = EC''
  -- if EC' = $add_var_e(p, EC, prefixedNameIR_h, value_h)
  -- if EC'' = $add_vars_e(p, EC', prefixedNameIR_t*, value_t*)





dec $update_var_e(cursor, evalContext, prefixedNameIR, value) : evalContext

def $update_var_e(p, EC, '.' id, value) = EC[GLOBAL.FRAME = frame]
  -- if frame = $update_map<id, value>(EC.GLOBAL.FRAME, id, value)

def $update_var_e(GLOBAL, EC, _BARE id, value) = EC[GLOBAL.FRAME = frame']
  -- if frame = EC.GLOBAL.FRAME
  -- if $in_set<id>(id, $dom_map<id, value>(frame))
  -- if frame' = $update_map<id, value>(frame, id, value)

def $update_var_e(BLOCK, EC, _BARE id, value) = EC[BLOCK.FRAME = frame']
  -- if frame = EC.BLOCK.FRAME
  -- if $in_set<id>(id, $dom_map<id, value>(frame))
  -- if frame' = $update_map<id, value>(frame, id, value)

def $update_var_e(BLOCK, EC, _BARE id, value)
  = $update_var_e(GLOBAL, EC, _BARE id, value)
  -- if frame = EC.BLOCK.FRAME
  -- if ~$in_set<id>(id, $dom_map<id, value>(frame))

def $update_var_e(LOCAL, EC, _BARE id, value)
  = $update_var_e(BLOCK, EC, _BARE id, value)
  -- if eps = EC.LOCAL.FRAMES

def $update_var_e(LOCAL, EC, _BARE id, value)
  = EC[LOCAL.FRAMES = frame_h' :: frame_t*]
  -- if frame_h :: frame_t* = EC.LOCAL.FRAMES
  -- if $in_set<id>(id, $dom_map<id, value>(frame_h))
  -- if frame_h' = $update_map<id, value>(frame_h, id, value)

def $update_var_e(LOCAL, EC, _BARE id, value)
  = EC_pop'[LOCAL.FRAMES = frame_h :: EC_pop'.LOCAL.FRAMES]
  -- if frame_h :: frame_t* = EC.LOCAL.FRAMES
  -- if ~$in_set<id>(id, $dom_map<id, value>(frame_h))
  -- if EC_pop = EC[LOCAL.FRAMES = frame_t*]
  -- if EC_pop' = $update_var_e(LOCAL, EC_pop, _BARE id, value)





dec $find_var_e(prefixedNameIR, cursor, evalContext) : value

def $find_var_e('.' id, p, EC) = value
  -- if value = $find_map<id, value>(EC.GLOBAL.FRAME, id)

def $find_var_e(_BARE id, GLOBAL, EC) = value
  -- if value = $find_map<id, value>(EC.GLOBAL.FRAME, id)

def $find_var_e(_BARE id, BLOCK, EC) = value
  -- if value = $find_map<id, value>(EC.BLOCK.FRAME, id)

def $find_var_e(_BARE id, BLOCK, EC) = $find_var_e(_BARE id, GLOBAL, EC)
  -- if eps = $find_map<id, value>(EC.BLOCK.FRAME, id)

def $find_var_e(_BARE id, LOCAL, EC) = value
  -- if value = $find_maps<id, value>(EC.LOCAL.FRAMES, id)

def $find_var_e(_BARE id, LOCAL, EC) = $find_var_e(_BARE id, BLOCK, EC)
  -- if eps = $find_maps<id, value>(EC.LOCAL.FRAMES, id)





dec $find_typeDef_e(cursor, evalContext, prefixedNameIR) : typeDefIR?

def $find_typeDef_e(_, EC, _BARE nameIR)
  = $find_map<typeId, typeDefIR>(EC.GLOBAL.TYPE, nameIR)

def $find_typeDef_e(_, EC, '.' nameIR)
  = $find_map<typeId, typeDefIR>(EC.GLOBAL.TYPE, nameIR)





dec $find_type_e(cursor, evalContext, nameIR) : typeIR?

def $find_type_e(BLOCK, EC, nameIR)
  = $find_map<typeId, typeIR>(EC.BLOCK.TYPE, nameIR)

def $find_type_e(LOCAL, EC, nameIR) = typeIR
  -- if typeIR = $find_map<typeId, typeIR>(EC.LOCAL.TYPE, nameIR)

def $find_type_e(LOCAL, EC, nameIR) = $find_type_e(BLOCK, EC, nameIR)
  -- if eps = $find_map<typeId, typeIR>(EC.LOCAL.TYPE, nameIR)





dec $find_callableDef_overloaded_e(
    cursor,
    evalContext,
    prefixedNameIR,
    argumentIR*)
  : callResolution<(cursor, callableDef)>?

def $find_callableDef_overloaded_e(GLOBAL, EC, _BARE nameIR, argumentIR*)
  = callableId ':' (GLOBAL, callableDef) '#' id_default* '#' id_optional*
  -- if callTargetKey = $callTargetKey(nameIR, argumentIR*)
  -- if callableId ':' callableDef '#' id_default* '#' id_optional*
      = $find_overloaded<callableDef>(
          EC.GLOBAL.CALLABLE,
          callTargetKey,
          def $parameterListIR_of_callableDef)

def $find_callableDef_overloaded_e(GLOBAL, EC, _BARE nameIR, argumentIR*) = eps
  -- if callTargetKey = $callTargetKey(nameIR, argumentIR*)
  -- if eps
      = $find_overloaded<callableDef>(
          EC.GLOBAL.CALLABLE,
          callTargetKey,
          def $parameterListIR_of_callableDef)

def $find_callableDef_overloaded_e(GLOBAL, EC, '.' nameIR, argumentIR*)
  = callableId ':' (GLOBAL, callableDef) '#' id_default* '#' id_optional*
  -- if callTargetKey = $callTargetKey(nameIR, argumentIR*)
  -- if callableId ':' callableDef '#' id_default* '#' id_optional*
      = $find_overloaded<callableDef>(
          EC.GLOBAL.CALLABLE,
          callTargetKey,
          def $parameterListIR_of_callableDef)

def $find_callableDef_overloaded_e(GLOBAL, EC, '.' nameIR, argumentIR*) = eps
  -- if callTargetKey = $callTargetKey(nameIR, argumentIR*)
  -- if eps
      = $find_overloaded<callableDef>(
          EC.GLOBAL.CALLABLE,
          callTargetKey,
          def $parameterListIR_of_callableDef)

def $find_callableDef_overloaded_e(BLOCK, EC, _BARE nameIR, argumentIR*)
  = callableId ':' (BLOCK, callableDef) '#' id_default* '#' id_optional*
  -- if callTargetKey = $callTargetKey(nameIR, argumentIR*)
  -- if callableId ':' callableDef '#' id_default* '#' id_optional*
      = $find_overloaded<callableDef>(
          EC.BLOCK.CALLABLE,
          callTargetKey,
          def $parameterListIR_of_callableDef)

def $find_callableDef_overloaded_e(BLOCK, EC, _BARE nameIR, argumentIR*)
  = $find_callableDef_overloaded_e(GLOBAL, EC, _BARE nameIR, argumentIR*)
  -- if callTargetKey = $callTargetKey(nameIR, argumentIR*)
  -- if eps
      = $find_overloaded<callableDef>(
          EC.BLOCK.CALLABLE,
          callTargetKey,
          def $parameterListIR_of_callableDef)

def $find_callableDef_overloaded_e(LOCAL, EC, _BARE nameIR, argumentIR*)
  = $find_callableDef_overloaded_e(BLOCK, EC, _BARE nameIR, argumentIR*)





dec $find_constructorDef_e(evalContext, prefixedNameIR, argumentIR*)
  : callResolution<constructorDef>?

def $find_constructorDef_e(EC, _BARE nameIR, argumentIR*)
  = $find_overloaded<constructorDef>(
      EC.GLOBAL.CONSTRUCTOR,
      callTargetKey,
      def $parameterListIR_of_constructorDef)
  -- if callTargetKey = $callTargetKey(nameIR, argumentIR*)

def $find_constructorDef_e(EC, '.' nameIR, argumentIR*)
  = $find_overloaded<constructorDef>(
      EC.GLOBAL.CONSTRUCTOR,
      callTargetKey,
      def $parameterListIR_of_constructorDef)
  -- if callTargetKey = $callTargetKey(nameIR, argumentIR*)





dec $find_parserState_e(evalContext, nameIR) : parserStateIR?

def $find_parserState_e(EC, nameIR)
  = $find_map<nameIR, parserStateIR>(EC.BLOCK.STATE, nameIR)





dec $subst_type_e(cursor, evalContext, typeIR) : typeIR

def $subst_type_e(GLOBAL, EC, typeIR) = typeIR

def $subst_type_e(BLOCK, EC, typeIR) = typeIR_subst
  -- if theta = EC.BLOCK.TYPE
  -- if typeIR_subst = $subst_typeIR(theta, typeIR)

def $subst_type_e(LOCAL, EC, typeIR) = typeIR_subst
  -- if theta_block = EC.BLOCK.TYPE
  -- if theta_local = EC.LOCAL.TYPE
  -- if theta = $extend_map<typeId, typeIR>(theta_block, theta_local)
  -- if typeIR_subst = $subst_typeIR(theta, typeIR)

extern syntax archState

extern dec $init_archState : archState

arch = {
  STATE archState,
  STORE store
}

var ARCH : arch





dec $add_object_e(arch, objectId, object) : arch

def $add_object_e(ARCH, objectId, object) = ARCH[STORE = STO]
  -- if STO = $add_map<objectId, object>(ARCH.STORE, objectId, object)





dec $find_archState_e(arch) : archState

def $find_archState_e(ARCH) = ARCH.STATE

dec $find_object_e(arch, objectId) : object?

def $find_object_e(ARCH, objectId)
  = $find_map<objectId, object>(ARCH.STORE, objectId)

dec $find_object_qualified_e(arch, objectId) : object?

def $find_object_qualified_e(ARCH, objectId) = $find_object_e(ARCH, objectId)

dec $find_object_unqualified_e(arch, id) : object?

def $find_object_unqualified_e(ARCH, id) = object_id_found
  -- if `{ (objectId ':' object)* `} = ARCH.STORE
  -- (if (
    object_id?
        = $ite<object?>($objectId_ends_with(objectId, id), object, eps)))*
  -- if object_id_found = $filter_<object?>(object_id?*, (object_id? =/= eps)*)

def $find_object_unqualified_e(ARCH, id) = eps
  -- otherwise

dec $find_objectState_e(arch, objectId) : objectState?

def $find_objectState_e(ARCH, objectId) = objectState
  -- if externObject = $find_object_e(ARCH, objectId)
  -- if EXTERN _ `< _ `> `{ objectState _ _ `} = externObject

def $find_objectState_e(ARCH, objectId) = eps
  -- otherwise





dec $update_archState_e(arch, archState) : arch

def $update_archState_e(ARCH, archState) = ARCH[STATE = archState]

dec $update_object_qualified_e(arch, objectId, object) : arch

def $update_object_qualified_e(ARCH_0, objectId, object) = ARCH_1
  -- if eps =/= $find_object_qualified_e(ARCH_0, objectId)
  -- if ARCH_1 = $add_object_e(ARCH_0, objectId, object)

dec $update_object_unqualified_e(arch, id, object) : arch

def $update_object_unqualified_e(ARCH_0, id, object) = ARCH_1
  -- if `{ (objectId ':' _)* `} = ARCH_0.STORE
  -- (if (
    objectId_id?
        = $ite<objectId?>($objectId_ends_with(objectId, id), objectId, eps)))*
  -- if objectId_found
      = $filter_<objectId?>(objectId_id?*, (objectId_id? =/= eps)*)
  -- if ARCH_1 = $add_object_e(ARCH_0, objectId_found, object)

dec $update_objectState_e(arch, objectId, objectState) : arch?

def $update_objectState_e(ARCH_0, objectId, objectState) = ARCH_1
  -- if externObject = $find_object_e(ARCH_0, objectId)
  -- if EXTERN typeId `< theta `> `{ _ frame externMethodDefEnv `}
      = externObject
  -- if externObject_update
      = EXTERN typeId `< theta `> `{ objectState frame externMethodDefEnv `}
  -- if ARCH_1 = $add_object_e(ARCH_0, objectId, externObject_update)

def $update_objectState_e(ARCH, objectId, objectState) = eps
  -- otherwise





continueEmptyResult
    : /* empty */
    ;

continueResult<X>
    : _CONT X
    ;





exitResult
    : EXIT
    ;





returnResult
    : RETURN value?
    ;





acceptTransitionResult
    : ACCEPT
    ;

rejectTransitionResult
    : REJECT errorValue
    ;

stateTransitionResult
    : STATE id
    ;

abortResult
    : exitResult | rejectTransitionResult
    ;





expressionResult
    : continueResult<value> | abortResult
    ;

relation Expr_eval:
  cursor evalContext arch
      |- typedExpressionIR : evalContext arch expressionResult

expressionListResult
    : continueResult<value*> | abortResult
    ;

relation Exprs_eval:
  cursor evalContext arch
      |- typedExpressionIR* : evalContext arch expressionListResult

keysetExpressionResult
    : continueResult<setValue*> | abortResult
    ;

relation Eval_keyset:
  evalContext arch
      |- keysetExpressionIR : evalContext arch keysetExpressionResult





relation Argument_eval:
  cursor evalContext arch |- argumentIR : evalContext arch expressionResult

storageReferenceResult
    : continueResult<storageReference?> | abortResult
    ;

relation Argument_eval_lvalue:
  cursor evalContext arch
      |- argumentIR : evalContext arch storageReferenceResult





relation Lvalue_eval:
  cursor evalContext arch
      |- typedLvalueIR : evalContext arch storageReferenceResult

relation Lvalue_read:
  cursor evalContext arch |- storageReference : value

relation Lvalue_write:
  cursor evalContext arch |- storageReference := value : evalContext





callResult
    : abortResult | returnResult
    ;

forBreakResult
    : BREAK
    ;

forContinueResult
    : CONTINUE
    ;

forResult
    : forBreakResult | forContinueResult
    ;

statementResult
    : continueEmptyResult | callResult | forResult
    ;

relation Stmt_eval:
  cursor evalContext arch |- statementIR : evalContext arch statementResult

relation BlockElementStmt_eval:
  evalContext arch |- blockElementStatementIR : evalContext arch statementResult

relation BlockElementStmtList_eval:
  evalContext arch
      |- blockElementStatementListIR : evalContext arch statementResult

relation Block_eval:
  evalContext arch |- blockStatementIR : evalContext arch statementResult





parserStatementResult
    : continueEmptyResult | rejectTransitionResult
    ;

relation ParserStmt_eval:
  evalContext arch |- parserStatementIR : evalContext arch parserStatementResult

relation ParserBlockElementStmt_eval:
  evalContext arch
      |- parserBlockElementStatementIR : evalContext arch parserStatementResult

relation ParserBlockElementStmtList_eval:
  evalContext arch
      |- parserBlockElementStatementListIR
          : evalContext arch parserStatementResult

relation ParserBlock_eval:
  evalContext arch
      |- parserBlockStatementIR : evalContext arch parserStatementResult

transitionResult
    : acceptTransitionResult | rejectTransitionResult | stateTransitionResult
    ;

relation ParserSelect_eval:
  evalContext arch |- selectExpressionIR : evalContext arch transitionResult

relation ParserTransition_eval:
  evalContext arch |- transitionStatementIR : evalContext arch transitionResult

relation ParserState_eval:
  evalContext arch |- parserStateIR : evalContext arch transitionResult

relation ParserState_trans:
  evalContext arch |- TRANSITION nameIR : evalContext arch transitionResult

parserDeclarationResult = parserStatementResult

relation ParserLocalDecl_eval:
  evalContext arch
      |- parserLocalDeclarationIR : evalContext arch parserDeclarationResult

relation ParserLocalDecls_eval:
  evalContext arch
      |- parserLocalDeclarationIR* : evalContext arch parserDeclarationResult





tableResult
    : exitResult | returnResult
    ;

relation Table_eval:
  evalContext arch |- typeId tableObjectProperty : evalContext arch tableResult

controlBodyResult
    : exitResult | returnResult
    ;

relation ControlBody_eval:
  evalContext arch |- controlBodyIR : evalContext arch controlBodyResult

controlLocalDeclarationResult
    : continueEmptyResult | exitResult
    ;

relation ControlLocalDecl_eval:
  evalContext arch
      |- controlLocalDeclarationIR
          : evalContext arch controlLocalDeclarationResult

relation ControlLocalDecls_eval:
  evalContext arch
      |- controlLocalDeclarationIR*
          : evalContext arch controlLocalDeclarationResult





declarationResult
    : continueEmptyResult | abortResult
    ;

relation VarDecl_eval:
  cursor evalContext arch
      |- variableDeclarationIR : evalContext arch declarationResult

relation ConstDecl_eval:
  cursor evalContext |- constantDeclarationIR : evalContext





calleeResult
    : continueResult<callee> | abortResult
    ;

relation Callee_eval:
  cursor evalContext arch
      |- callableTargetIR `< '_' `> `( argumentListIR `)
          : evalContext arch calleeResult

copyInArgumentResult
    : continueResult<storageReference?> | abortResult
    ;

relation Copy_in_arg:
  arch
      |- cursor evalContext parameterIR '@' cursor evalContext argumentIR
          ~> arch evalContext evalContext '#' copyInArgumentResult

copyInResult
    : continueResult<storageReference?*> | abortResult
    ;

relation Copy_in:
  cursor arch
      |- cursor evalContext parameterListIR '@' cursor evalContext
      argumentListIR
          ~> arch evalContext evalContext '#' copyInResult

relation Copy_in_default:
  parameterListIR '@' cursor evalContext ~> evalContext

relation Copy_out_argument:
  arch
      |- cursor evalContext parameterIR '@' cursor evalContext storageReference?
          ~> evalContext

relation Copy_out:
  cursor arch
      |- cursor evalContext parameterListIR '@' cursor evalContext
      storageReference?*
          ~> evalContext

relation Call_eval:
  cursor evalContext arch
      |- callee '@' `< typeArgumentListIR `> `( argumentListIR `)
          : evalContext arch callResult

extern relation ExternFunctionCall_eval:
  evalContext arch |- nameIR `( nameIR* `) : evalContext arch callResult

extern relation ExternMethodCall_eval:
  evalContext arch
      |- objectId '.' nameIR `( nameIR* `) : evalContext arch callResult





rulegroup Expr_eval/literalExpressionIR {

  rule Expr_eval/booleanLiteral:
    p EC ARCH |- booleanLiteral '#' _ : EC ARCH expressionResult
    -- if boolValue = $ite<boolValue>(booleanLiteral = TRUE, _B true, _B false)
    -- if expressionResult = _CONT boolValue

  rule Expr_eval/integerLiteral:
    p EC ARCH |- integerLiteral '#' _ : EC ARCH expressionResult
    -- if expressionResult = _CONT integerLiteral

  rule Expr_eval/stringLiteral:
    p EC ARCH |- stringLiteral '#' _ : EC ARCH expressionResult
    -- if expressionResult = _CONT stringLiteral

}





rule Expr_eval/referenceExpressionIR:
  p EC ARCH |- prefixedNameIR '#' _ : EC ARCH expressionResult
  -- if value = $find_var_e(prefixedNameIR, p, EC)
  -- if expressionResult = _CONT value





rule Expr_eval/defaultExpressionIR:
  p EC ARCH |- '...' '#' _ : EC ARCH expressionResult
  -- if expressionResult = _CONT DEFAULT





rulegroup Expr_eval/unaryExpressionIR {

  rule Expr_eval/abort:
    p EC_0 ARCH_0 |- (unop typedExpressionIR) '#' _ : EC_1 ARCH_1 abortResult
    -- Expr_eval: p EC_0 ARCH_0 |- typedExpressionIR : EC_1 ARCH_1 abortResult

  rule Expr_eval/cont:
    p EC_0 ARCH_0
        |- (unop typedExpressionIR) '#' _ : EC_1 ARCH_1 expressionResult
    -- Expr_eval: p EC_0 ARCH_0 |- typedExpressionIR : EC_1 ARCH_1 (_CONT value)
    -- if expressionResult = _CONT $un_op(unop, value)

}





rulegroup Expr_eval/binaryExpressionIR {

  rule Expr_eval/non-short-circuit-abort:
    p EC_0 ARCH_0
        |- (typedExpressionIR_l binop typedExpressionIR_r) '#' _
            : EC_1 ARCH_1 abortResult
    -- if ~(binop <- ['&&', '||'])
    -- Exprs_eval:
        p EC_0 ARCH_0
            |- [typedExpressionIR_l, typedExpressionIR_r]
                : EC_1 ARCH_1 abortResult

  rule Expr_eval/non-short-circuit-cont:
    p EC_0 ARCH_0
        |- (typedExpressionIR_l binop typedExpressionIR_r) '#' _
            : EC_1 ARCH_1 expressionResult
    -- if ~(binop <- ['&&', '||'])
    -- Exprs_eval:
        p EC_0 ARCH_0
            |- [typedExpressionIR_l, typedExpressionIR_r]
                : EC_1 ARCH_1 (_CONT ([value_l, value_r]))
    -- if expressionResult = _CONT $bin_op(binop, value_l, value_r)

  rule Expr_eval/land-abort:
    p EC_0 ARCH_0
        |- (typedExpressionIR_l '&&' typedExpressionIR_r) '#' _
            : EC_1 ARCH_1 abortResult
    -- Expr_eval: p EC_0 ARCH_0 |- typedExpressionIR_l : EC_1 ARCH_1 abortResult

  rule Expr_eval/land-false:
    p EC_0 ARCH_0
        |- (typedExpressionIR_l '&&' typedExpressionIR_r) '#' _
            : EC_1 ARCH_1 expressionResult
    -- Expr_eval:
        p EC_0 ARCH_0 |- typedExpressionIR_l : EC_1 ARCH_1 (_CONT (_B false))
    -- if expressionResult = _CONT (_B false)

  rule Expr_eval/land-true:
    p EC_0 ARCH_0
        |- (typedExpressionIR_l '&&' typedExpressionIR_r) '#' _
            : EC_2 ARCH_2 expressionResult_r
    -- Expr_eval:
        p EC_0 ARCH_0 |- typedExpressionIR_l : EC_1 ARCH_1 (_CONT (_B true))
    -- Expr_eval:
        p EC_1 ARCH_1 |- typedExpressionIR_r : EC_2 ARCH_2 expressionResult_r

  rule Expr_eval/lor-abort:
    p EC_0 ARCH_0
        |- (typedExpressionIR_l '||' typedExpressionIR_r) '#' _
            : EC_1 ARCH_1 abortResult
    -- Expr_eval: p EC_0 ARCH_0 |- typedExpressionIR_l : EC_1 ARCH_1 abortResult

  rule Expr_eval/lor-true:
    p EC_0 ARCH_0
        |- (typedExpressionIR_l '||' typedExpressionIR_r) '#' _
            : EC_1 ARCH_1 expressionResult
    -- Expr_eval:
        p EC_0 ARCH_0 |- typedExpressionIR_l : EC_1 ARCH_1 (_CONT (_B true))
    -- if expressionResult = _CONT (_B true)

  rule Expr_eval/lor-false:
    p EC_0 ARCH_0
        |- (typedExpressionIR_l '||' typedExpressionIR_r) '#' _
            : EC_2 ARCH_2 expressionResult_r
    -- Expr_eval:
        p EC_0 ARCH_0 |- typedExpressionIR_l : EC_1 ARCH_1 (_CONT (_B false))
    -- Expr_eval:
        p EC_1 ARCH_1 |- typedExpressionIR_r : EC_2 ARCH_2 expressionResult_r

}





rulegroup Expr_eval/ternaryExpressionIR {

  rule Expr_eval/cond-abort:
    p EC_0 ARCH_0
        |- (
          typedExpressionIR_cond '?' typedExpressionIR_true ':'
          typedExpressionIR_false) '#' _
            : EC_1 ARCH_1 abortResult
    -- Expr_eval:
        p EC_0 ARCH_0 |- typedExpressionIR_cond : EC_1 ARCH_1 abortResult

  rule Expr_eval/cond-true:
    p EC_0 ARCH_0
        |- (
          typedExpressionIR_cond '?' typedExpressionIR_true ':'
          typedExpressionIR_false) '#' _
            : EC_2 ARCH_2 expressionResult_true
    -- Expr_eval:
        p EC_0 ARCH_0 |- typedExpressionIR_cond : EC_1 ARCH_1 (_CONT (_B true))
    -- Expr_eval:
        p EC_1 ARCH_1
            |- typedExpressionIR_true : EC_2 ARCH_2 expressionResult_true

  rule Expr_eval/cond-false:
    p EC_0 ARCH_0
        |- (
          typedExpressionIR_cond '?' typedExpressionIR_true ':'
          typedExpressionIR_false) '#' _
            : EC_2 ARCH_2 expressionResult_false
    -- Expr_eval:
        p EC_0 ARCH_0 |- typedExpressionIR_cond : EC_1 ARCH_1 (_CONT (_B false))
    -- Expr_eval:
        p EC_1 ARCH_1
            |- typedExpressionIR_false : EC_2 ARCH_2 expressionResult_false

}





rulegroup Expr_eval/castExpressionIR {

  rule Expr_eval/abort:
    p EC_0 ARCH_0
        |- (`( typeIR `) typedExpressionIR) '#' _ : EC_1 ARCH_1 abortResult
    -- Expr_eval: p EC_0 ARCH_0 |- typedExpressionIR : EC_1 ARCH_1 abortResult

  rule Expr_eval/cont:
    p EC_0 ARCH_0
        |- (`( typeIR `) typedExpressionIR) '#' _
            : EC_1 ARCH_1 (_CONT value_cast)
    -- Expr_eval: p EC_0 ARCH_0 |- typedExpressionIR : EC_1 ARCH_1 (_CONT value)
    -- if value_cast = $cast_op(typeIR, value)

}





rule Expr_eval/invalidHeaderExpressionIR:
  p EC ARCH |- '{#}' '#' _ : EC ARCH expressionResult
  -- if expressionResult = _CONT '{#}'





rulegroup Expr_eval/sequenceExpressionIR {

  rule Expr_eval/non-default-abort:
    p EC_0 ARCH_0
        |- (SEQ `{ typedExpressionListIR `}) '#' _ : EC_1 ARCH_1 abortResult
    -- Exprs_eval:
        p EC_0 ARCH_0 |- typedExpressionListIR : EC_1 ARCH_1 abortResult

  rule Expr_eval/non-default-cont:
    p EC_0 ARCH_0
        |- (SEQ `{ typedExpressionListIR `}) '#' _
            : EC_1 ARCH_1 expressionResult
    -- Exprs_eval:
        p EC_0 ARCH_0 |- typedExpressionListIR : EC_1 ARCH_1 (_CONT value*)
    -- if expressionResult = _CONT (SEQ `( value* `))

  rule Expr_eval/default-abort:
    p EC_0 ARCH_0
        |- (SEQ `{ typedExpressionListIR ',' '...' `}) '#' _
            : EC_1 ARCH_1 abortResult
    -- Exprs_eval:
        p EC_0 ARCH_0 |- typedExpressionListIR : EC_1 ARCH_1 abortResult

  rule Expr_eval/default-cont:
    p EC_0 ARCH_0
        |- (SEQ `{ typedExpressionListIR ',' '...' `}) '#' _
            : EC_1 ARCH_1 expressionResult
    -- Exprs_eval:
        p EC_0 ARCH_0 |- typedExpressionListIR : EC_1 ARCH_1 (_CONT value*)
    -- if expressionResult = _CONT (SEQ `( value* ',' '...' `))

}





rulegroup Expr_eval/recordExpressionIR {

  rule Expr_eval/non-default-abort:
    p EC_0 ARCH_0
        |- (RECORD `{ (nameIR '=' typedExpressionIR)* `}) '#' _
            : EC_1 ARCH_1 abortResult
    -- Exprs_eval: p EC_0 ARCH_0 |- typedExpressionIR* : EC_1 ARCH_1 abortResult

  rule Expr_eval/non-default-cont:
    p EC_0 ARCH_0
        |- (RECORD `{ (nameIR '=' typedExpressionIR)* `}) '#' _
            : EC_1 ARCH_1 expressionResult
    -- Exprs_eval:
        p EC_0 ARCH_0 |- typedExpressionIR* : EC_1 ARCH_1 (_CONT value*)
    -- if expressionResult = _CONT (RECORD `{ (value nameIR ';')* `})

  rule Expr_eval/default-abort:
    p EC_0 ARCH_0
        |- (RECORD `{ (nameIR '=' typedExpressionIR)* ',' '...' `}) '#' _
            : EC_1 ARCH_1 abortResult
    -- Exprs_eval: p EC_0 ARCH_0 |- typedExpressionIR* : EC_1 ARCH_1 abortResult

  rule Expr_eval/default-cont:
    p EC_0 ARCH_0
        |- (RECORD `{ (nameIR '=' typedExpressionIR)* ',' '...' `}) '#' _
            : EC_1 ARCH_1 expressionResult
    -- Exprs_eval:
        p EC_0 ARCH_0 |- typedExpressionIR* : EC_1 ARCH_1 (_CONT value*)
    -- if expressionResult = _CONT (RECORD `{ (value nameIR ';')* ',' '...' `})

}





rule Expr_eval/errorAccessExpressionIR:
  p EC ARCH |- (ERROR '.' nameIR) '#' _ : EC ARCH expressionResult
  -- if nameIR_error = "error." ++ nameIR
  -- if value_error = $find_var_e(_BARE nameIR_error, p, EC)
  -- if expressionResult = _CONT value_error





rulegroup Expr_eval/memberAccessExpressionIR-type {

  rule Expr_eval/enum:
    p EC ARCH
        |- ((TYPE prefixedNameIR) '.' nameIR) '#' _ : EC ARCH expressionResult
    -- if ENUM typeId `{ _ `} = $find_typeDef_e(p, EC, prefixedNameIR)
    -- if expressionResult = _CONT (typeId '.' nameIR)

  rule Expr_eval/serenum:
    p EC ARCH
        |- ((TYPE prefixedNameIR) '.' nameIR) '#' _ : EC ARCH expressionResult
    -- if ENUM typeId `< _ `> `{ (nameIR_member '=' value_member ';')* `}
        = $find_typeDef_e(p, EC, prefixedNameIR)
    -- if value = $assoc_<nameIR, value>(nameIR, (nameIR_member, value_member)*)
    -- if expressionResult = _CONT (typeId '.' nameIR '.' value)

}





rulegroup Expr_eval/memberAccessExpressionIR-typedExpressionIR {

  rule Expr_eval/abort:
    p EC_0 ARCH_0
        |- (typedExpressionIR_base '.' nameIR) '#' `( typeIR_base _ `)
            : EC_1 ARCH_1 abortResult
    -- Expr_eval:
        p EC_0 ARCH_0 |- typedExpressionIR_base : EC_1 ARCH_1 abortResult

  rule Expr_eval/stack-size:
    p EC_0 ARCH_0
        |- (typedExpressionIR_base '.' nameIR) '#' `( typeIR_base _ `)
            : EC_1 ARCH_1 expressionResult
    -- Expr_eval:
        p EC_0 ARCH_0
            |- typedExpressionIR_base
                : EC_1 ARCH_1 (_CONT headerStackValue_base)
    -- if HEADER_STACK `[ value_elem* `( _ `) `] = headerStackValue_base
    -- if nameIR = "size"
    -- if n_size = |value_elem*|
    -- if expressionResult = _CONT (32 W n_size)

  rule Expr_eval/stack-last-out-of-bounds:
    p EC_0 ARCH_0
        |- (typedExpressionIR_base '.' nameIR) '#' `( typeIR_base _ `)
            : EC_1 ARCH_1 rejectTransitionResult
    -- Expr_eval:
        p EC_0 ARCH_0
            |- typedExpressionIR_base
                : EC_1 ARCH_1 (_CONT headerStackValue_base)
    -- if HEADER_STACK `[ value_elem* `( n_idx `) `] = headerStackValue_base
    -- if nameIR = "last"
    -- if n_size = |value_elem*|
    -- if b_out_of_bounds = ($(n_idx < 1) \/ $(n_idx > n_size))
    -- if b_out_of_bounds
    -- if rejectTransitionResult = REJECT (ERROR '.' "StackOutOfBounds")

  rule Expr_eval/stack-last-in-bounds:
    p EC_0 ARCH_0
        |- (typedExpressionIR_base '.' nameIR) '#' `( typeIR_base _ `)
            : EC_1 ARCH_1 expressionResult
    -- Expr_eval:
        p EC_0 ARCH_0
            |- typedExpressionIR_base
                : EC_1 ARCH_1 (_CONT headerStackValue_base)
    -- if HEADER_STACK `[ value_elem* `( n_idx `) `] = headerStackValue_base
    -- if nameIR = "last"
    -- if n_size = |value_elem*|
    -- if b_out_of_bounds = ($(n_idx < 1) \/ $(n_idx > n_size))
    -- if ~b_out_of_bounds
    -- if n_idx_last = $(n_idx - 1)
    -- if value_last = value_elem*[n_idx_last]
    -- if expressionResult = _CONT value_last

  rule Expr_eval/stack-lastIndex:
    p EC_0 ARCH_0
        |- (typedExpressionIR_base '.' nameIR) '#' `( typeIR_base _ `)
            : EC_1 ARCH_1 expressionResult
    -- Expr_eval:
        p EC_0 ARCH_0
            |- typedExpressionIR_base
                : EC_1 ARCH_1 (_CONT headerStackValue_base)
    -- if HEADER_STACK `[ value_elem* `( n_idx `) `] = headerStackValue_base
    -- if nameIR = "lastIndex"
    -- if n_idx_last = $($max_nat([n_idx, 1]) - 1)
    -- if value_idx_last = 32 W n_idx_last
    -- if expressionResult = _CONT value_idx_last

  rule Expr_eval/struct:
    p EC_0 ARCH_0
        |- (typedExpressionIR_base '.' nameIR) '#' `( typeIR_base _ `)
            : EC_1 ARCH_1 expressionResult
    -- Expr_eval:
        p EC_0 ARCH_0
            |- typedExpressionIR_base : EC_1 ARCH_1 (_CONT structValue_base)
    -- if STRUCT _ `{ (value_field id_field ';')* `} = structValue_base
    -- if value_member
        = $assoc_<nameIR, value>(nameIR, (id_field, value_field)*)
    -- if expressionResult = _CONT value_member

  rule Expr_eval/header:
    p EC_0 ARCH_0
        |- (typedExpressionIR_base '.' nameIR) '#' `( typeIR_base _ `)
            : EC_1 ARCH_1 expressionResult
    -- Expr_eval:
        p EC_0 ARCH_0
            |- typedExpressionIR_base : EC_1 ARCH_1 (_CONT headerValue_base)
    -- if HEADER _ `{ _ ';' (value_field id_field ';')* `} = headerValue_base
    -- if value_member
        = $assoc_<nameIR, value>(nameIR, (id_field, value_field)*)
    -- if expressionResult = _CONT value_member

  rule Expr_eval/headerunion:
    p EC_0 ARCH_0
        |- (typedExpressionIR_base '.' nameIR) '#' `( typeIR_base _ `)
            : EC_1 ARCH_1 expressionResult
    -- Expr_eval:
        p EC_0 ARCH_0
            |- typedExpressionIR_base
                : EC_1 ARCH_1 (_CONT headerUnionValue_base)
    -- if HEADER_UNION _ `{ (value_field id_field ';')* `}
        = headerUnionValue_base
    -- if value_member
        = $assoc_<nameIR, value>(nameIR, (id_field, value_field)*)
    -- if expressionResult = _CONT value_member

  rule Expr_eval/tableMetadataStructValue-hit:
    p EC_0 ARCH_0
        |- (typedExpressionIR_base '.' nameIR) '#' _
            : EC_1 ARCH_1 expressionResult
    -- Expr_eval:
        p EC_0 ARCH_0
            |- typedExpressionIR_base
                : EC_1 ARCH_1 (_CONT tableMetadataStructValue_base)
    -- if TABLE_STRUCT _ `{ HIT boolValue_hit ';' MISS _ ';' ACTION_RUN _ ';' `}
        = tableMetadataStructValue_base
    -- if nameIR = "hit"
    -- if expressionResult = _CONT boolValue_hit

  rule Expr_eval/tableMetadataStructValue-miss:
    p EC_0 ARCH_0
        |- (typedExpressionIR_base '.' nameIR) '#' _
            : EC_1 ARCH_1 expressionResult
    -- Expr_eval:
        p EC_0 ARCH_0
            |- typedExpressionIR_base
                : EC_1 ARCH_1 (_CONT tableMetadataStructValue_base)
    -- if TABLE_STRUCT _
    `{ HIT _ ';' MISS boolValue_miss ';' ACTION_RUN _ ';' `}
        = tableMetadataStructValue_base
    -- if nameIR = "miss"
    -- if expressionResult = _CONT boolValue_miss

  rule Expr_eval/tableMetadataStructValue-action_run:
    p EC_0 ARCH_0
        |- (typedExpressionIR_base '.' nameIR) '#' _
            : EC_1 ARCH_1 expressionResult
    -- Expr_eval:
        p EC_0 ARCH_0
            |- typedExpressionIR_base
                : EC_1 ARCH_1 (_CONT tableMetadataStructValue_base)
    -- if TABLE_STRUCT _
    `{ HIT _ ';' MISS _ ';' ACTION_RUN tableMetadataEnumValue ';' `}
        = tableMetadataStructValue_base
    -- if nameIR = "action_run"
    -- if expressionResult = _CONT tableMetadataEnumValue

}





rulegroup Expr_eval/indexAccessExpressionIR {

  rule Expr_eval/abort:
    p EC_0 ARCH_0
        |- (typedExpressionIR_base `[ typedExpressionIR_index `]) '#' _
            : EC_1 ARCH_1 abortResult
    -- Exprs_eval:
        p EC_0 ARCH_0
            |- [typedExpressionIR_base, typedExpressionIR_index]
                : EC_1 ARCH_1 abortResult

  rule Expr_eval/tuple:
    p EC_0 ARCH_0
        |- (typedExpressionIR_base `[ typedExpressionIR_index `]) '#' _
            : EC_1 ARCH_1 expressionResult
    -- Exprs_eval:
        p EC_0 ARCH_0
            |- [typedExpressionIR_base, typedExpressionIR_index]
                : EC_1 ARCH_1 (_CONT ([tupleValue_base, integerValue_index]))
    -- if TUPLE `( value_elem* `) = tupleValue_base
    -- if n_index = $nat_of_integerValue(integerValue_index)
    -- if expressionResult = _CONT value_elem*[n_index]

  rule Expr_eval/array:
    p EC_0 ARCH_0
        |- (typedExpressionIR_base `[ typedExpressionIR_index `]) '#' _
            : EC_1 ARCH_1 expressionResult
    -- Exprs_eval:
        p EC_0 ARCH_0
            |- [typedExpressionIR_base, typedExpressionIR_index]
                : EC_1 ARCH_1 (_CONT ([arrayValue_base, integerValue_index]))
    -- if ARRAY `[ value_elem* `] = arrayValue_base
    -- if n_size = |value_elem*|
    -- if i_index = $int_of_integerValue(integerValue_index)
    -- if b_in_bounds = ($(i_index < n_size) /\ $(i_index >= 0))
    -- if n_idx = $ite<int>(b_in_bounds, i_index, $(n_size - 1))
    -- if expressionResult = _CONT value_elem*[n_idx]

  rule Expr_eval/headerStack:
    p EC_0 ARCH_0
        |- (typedExpressionIR_base `[ typedExpressionIR_index `]) '#' _
            : EC_1 ARCH_1 expressionResult
    -- Exprs_eval:
        p EC_0 ARCH_0
            |- [typedExpressionIR_base, typedExpressionIR_index]
                : EC_1 ARCH_1
                (_CONT ([headerStackValue_base, integerValue_index]))
    -- if HEADER_STACK `[ value_elem* `( _ `) `] = headerStackValue_base
    -- if n_size = |value_elem*|
    -- if i_index = $int_of_integerValue(integerValue_index)
    -- if b_in_bounds = ($(i_index < n_size) /\ $(i_index >= 0))
    -- if n_idx = $ite<int>(b_in_bounds, i_index, $(n_size - 1))
    -- if expressionResult = _CONT value_elem*[n_idx]

}





rulegroup Expr_eval/sliceAccessExpressionIR {

  rule Expr_eval/abort:
    p EC_0 ARCH_0
        |- (
          typedExpressionIR_base
          `[ typedExpressionIR_hi sliceop typedExpressionIR_lo `]) '#' _
            : EC_1 ARCH_1 abortResult
    -- Exprs_eval:
        p EC_0 ARCH_0
            |- [
              typedExpressionIR_base,
              typedExpressionIR_hi,
              typedExpressionIR_lo]
                : EC_1 ARCH_1 abortResult

  rule Expr_eval/cont-range:
    p EC_0 ARCH_0
        |- (
          typedExpressionIR_base
          `[ typedExpressionIR_hi ':' typedExpressionIR_lo `]) '#' _
            : EC_1 ARCH_1 expressionResult
    -- Exprs_eval:
        p EC_0 ARCH_0
            |- [
              typedExpressionIR_base,
              typedExpressionIR_hi,
              typedExpressionIR_lo]
                : EC_1 ARCH_1 (_CONT ([value_base, value_hi, value_lo]))
    -- if expressionResult
        = _CONT $bitacc_range_op(value_base, value_hi, value_lo)

  rule Expr_eval/cont-offset:
    p EC_0 ARCH_0
        |- (
          typedExpressionIR_base
          `[ typedExpressionIR_l '+:' typedExpressionIR_w `]) '#' _
            : EC_1 ARCH_1 expressionResult
    -- Exprs_eval:
        p EC_0 ARCH_0
            |- [
              typedExpressionIR_base,
              typedExpressionIR_l,
              typedExpressionIR_w]
                : EC_1 ARCH_1 (_CONT ([value_base, value_l, value_w]))
    -- if expressionResult
        = _CONT $bitacc_offset_op(value_base, value_l, value_w)

}









rulegroup Expr_eval/callExpressionIR {

  rule Expr_eval/callee-abort:
    p EC_0 ARCH_0
        |- (callableTargetIR `< typeArgumentIR* `> `( argumentIR* `)) '#' _
            : EC_1 ARCH_1 abortResult
    -- Callee_eval:
        p EC_0 ARCH_0
            |- callableTargetIR `< '_' `> `( argumentIR* `)
                : EC_1 ARCH_1 abortResult

  rule Expr_eval/callee-cont-call-abort:
    p EC_0 ARCH_0
        |- (callableTargetIR `< typeArgumentIR* `> `( argumentIR* `)) '#' _
            : EC_2 ARCH_2 abortResult
    -- Callee_eval:
        p EC_0 ARCH_0
            |- callableTargetIR `< '_' `> `( argumentIR* `)
                : EC_1 ARCH_1 (_CONT callee)
    -- Call_eval:
        p EC_1 ARCH_1
            |- callee '@' `< typeArgumentIR* `> `( argumentIR* `)
                : EC_2 ARCH_2 abortResult

  rule Expr_eval/callee-cont-call-return:
    p EC_0 ARCH_0
        |- (callableTargetIR `< typeArgumentIR* `> `( argumentIR* `)) '#' _
            : EC_2 ARCH_2 (_CONT value)
    -- Callee_eval:
        p EC_0 ARCH_0
            |- callableTargetIR `< '_' `> `( argumentIR* `)
                : EC_1 ARCH_1 (_CONT callee)
    -- Call_eval:
        p EC_1 ARCH_1
            |- callee '@' `< typeArgumentIR* `> `( argumentIR* `)
                : EC_2 ARCH_2 (RETURN value)

}





rule Expr_eval/parenthesizedExpressionIR:
  p EC_0 ARCH_0
      |- (`( typedExpressionIR `)) '#' _ : EC_1 ARCH_1 expressionResult
  -- Expr_eval:
      p EC_0 ARCH_0 |- typedExpressionIR : EC_1 ARCH_1 expressionResult





rulegroup Exprs_eval {

  rule Exprs_eval/nil:
    p EC ARCH |- eps : EC ARCH (_CONT eps)

  rule Exprs_eval/cons-head-abort:
    p EC_0 ARCH_0
        |- typedExpressionIR_h :: typedExpressionIR_t* : EC_1 ARCH_1 abortResult
    -- Expr_eval: p EC_0 ARCH_0 |- typedExpressionIR_h : EC_1 ARCH_1 abortResult

  rule Exprs_eval/cons-head-cont-tail-abort:
    p EC_0 ARCH_0
        |- typedExpressionIR_h :: typedExpressionIR_t* : EC_2 ARCH_2 abortResult
    -- Expr_eval:
        p EC_0 ARCH_0 |- typedExpressionIR_h : EC_1 ARCH_1 (_CONT value_h)
    -- Exprs_eval:
        p EC_1 ARCH_1 |- typedExpressionIR_t* : EC_2 ARCH_2 abortResult

  rule Exprs_eval/cons-head-cont-tail-cont:
    p EC_0 ARCH_0
        |- typedExpressionIR_h :: typedExpressionIR_t*
            : EC_2 ARCH_2 (_CONT (value_h :: value_t*))
    -- Expr_eval:
        p EC_0 ARCH_0 |- typedExpressionIR_h : EC_1 ARCH_1 (_CONT value_h)
    -- Exprs_eval:
        p EC_1 ARCH_1 |- typedExpressionIR_t* : EC_2 ARCH_2 (_CONT value_t*)

}

dec $match_keysets(setValue*, value*) : bool

dec $match_keyset(setValue, value) : bool

def $match_keysets(eps, eps) = true

def $match_keysets(SET `{ '...' `}, value_key*) = true

def $match_keysets(setValue, value_key) = $match_keyset(setValue, value_key)
  -- if setValue =/= SET `{ '...' `}

def $match_keysets(setValue_h :: setValue_t*, value_key_h :: value_key_t*)
  = $match_keysets(setValue_t*, value_key_t*)
  -- if setValue_t* =/= eps
  -- if value_key_t* =/= eps
  -- if $match_keyset(setValue_h, value_key_h)

def $match_keysets(setValue_h :: setValue_t*, value_key_h :: value_key_t*)
  = false
  -- if setValue_t* =/= eps
  -- if value_key_t* =/= eps
  -- if ~$match_keyset(setValue_h, value_key_h)

def $match_keyset(SET `{ '...' `}, value_key) = true

def $match_keyset(SET `{ value `}, value_key) = $bin_eq(value, value_key)

def $match_keyset(SET `{ value* `( _ `) `}, value_key)
  = $exists_($bin_eq(value, value_key)*)

def $match_keyset(SET `{ value_base '&&&' value_mask `}, value_key)
  = $bin_eq($bin_band(value_base, value_mask), $bin_band(value_key, value_mask))

def $match_keyset(SET `{ value_base '..' value_limit `}, value_key)
  = $bin_le(value_base, value_key) /\ $bin_le(value_key, value_limit)





simpleKeysetExpressionResult
    : continueResult<setValue> | abortResult
    ;

