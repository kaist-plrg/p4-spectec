;; Premise evaluation rules

rule Eval_prem/relpr:
  C |- REL id `: exp* `-> exp_out* : ctxres
  -- Eval_exps: C |- exp* : OK val*
  -- Call_rel: C |- id val* : OK val_out*
  -- Assign_exps : C |- val_out* -> exp_out* : ctxres

rulegroup Eval_prem/ifpr {

  rule Eval_prem/fail:
    C |- IF exp : FAIL
    -- Eval_exp: C |- exp : FAIL

  rule Eval_prem/true:
    C |- IF exp : OK C
    -- Eval_exp: C |- exp : OK (BOOL true)

  rule Eval_prem/false:
    C |- IF exp : FAIL
    -- Eval_exp: C |- exp : OK (BOOL false)

}

rule Eval_prem/ifholdpr:
  C |- IFHOLD id `: exp* : OK C
  -- Eval_exps: C |- exp* : OK val_input*
  -- Call_rel: C |- id val_input* : OK eps

rule Eval_prem/ifnotholdpr:
  C |- IFNOTHOLD id `: exp* : OK C
  -- Eval_exps: C |- exp* : OK val_input*
  -- Call_rel: C |- id val_input* : FAIL

rule Eval_prem/letpr:
  C |- LET exp_l `= exp_r : ctxres
  -- Eval_exp : C |- exp_r : OK val
  -- Assign_exp : C |- val -> exp_l : ctxres


