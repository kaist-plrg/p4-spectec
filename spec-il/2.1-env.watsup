;; Value environment
;; In the mechanization, the underlying types of variables are omitted

syntax varr = id iter*

syntax venv = map<varr, val>

;; Type definition environment

syntax typdef =
  | PARAM
  | EXT
  | DEF tparam* `-> deftyp

syntax tdenv = map<id, typdef>

;; Relation environment

syntax externRelDef =
  | EXT id

syntax definedRelDef =
  | DEF rulgroup* elsgroup?

syntax reldef =
  | externRelDef
  | definedRelDef

syntax renv = map<id, reldef>

;; Function environment

syntax externFuncDef =
  | EXT id

syntax builtinFuncDef =
  | BUILTIN id tparam* param*

syntax tableFuncDef =
  | TABLE param* `-> tblrow*

syntax definedFuncDef =
  | DEF tparam* `-> clause* elsclause?

syntax funcdef =
  | externFuncDef
  | builtinFuncDef
  | tableFuncDef
  | definedFuncDef

syntax fenv = map<id, funcdef>
