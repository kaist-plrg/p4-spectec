;; Meta-function invocation

;;; Clause invocation

relation Eval_clause:
  ctx `/ ctx |- clause `@ `( val* ) : res<val>
  hint(input %0 %1 %2 %3)

rule Eval_clause/succ:
  C `/ C_caller |- clause `@ `( val* ) : OK val_out
  -- if arg* `= exp_out `- prem* = clause
  -- Assign_args: C `/ C_caller |- val* -> arg* : OK C'
  -- Eval_prems: C' |- prem* : OK C''
  -- Eval_exp : C'' |- exp_out : OK val_out

rule Eval_clause/fail:
  C `/ C_caller |- clause `@ `( val* ) : FAIL
  -- otherwise

relation Eval_clauses:
  ctx `/ ctx |- clause* `@ `( val* ) : res<val>
  hint(input %0 %1 %2 %3)

rule Eval_clauses/cons-succ:
  C `/ C_caller |- (clause_h :: clause_t*) `@ `( val* ) : OK val_res
  -- Eval_clause: C `/ C_caller |- clause_h `@ `( val* ) : OK val_res

rule Eval_clauses/cons-fail:
  C `/ C_caller |- (clause_h :: clause_t*) `@ `( val* ) : OK val_res
  -- Eval_clause: C `/ C_caller |- clause_h `@ `( val* ) : FAIL
  -- Eval_clauses: C `/ C_caller |- clause_t* `@ `( val* ) : OK val_res

rule Eval_clauses/fail:
  C `/ C_caller |- _ `@ `( _ ) : FAIL
  -- otherwise

;;; Extern meta-function invocation

extern relation Call_extern_func:
  ctx |- id `< typ* > `( val* ) : res<val>
  hint(input %0 %1 %2 %3)

;;; Builtin meta-function invocation

extern relation Call_builtin_func:
  ctx |- id `@ `< typ* > `( val* ) : res<val>
  hint(input %0 %1 %2 %3)

;;; Table meta-function invocation

;;;; Table row evaluation

relation Eval_tblrow:
  ctx |- tblrow `@ `( val* ) : res<val>
  hint(input %0 %1 %2)

rule Eval_tblrow/succ:
  C |- tblrow `@ `( val* ) : OK val_out
  -- if arg* `= exp_out `- prem* = tblrow
  -- if C_callee = C[ .LOCAL = $empty_layer ]
  -- Assign_args: C_callee `/ C |- val* -> arg* : OK C_callee'
  -- Eval_prems: C_callee' |- prem* : OK C_callee''
  -- Eval_exp: C_callee'' |- exp_out : OK val_out

rule Eval_tblrow/fail:
  C |- tblrow `@ `( val* ) : FAIL
  -- otherwise

;;;; Table row sequence evaluation

relation Eval_tblrows:
  ctx |- tblrow* `@ `( val* ) : res<val>
  hint(input %0 %1 %2)

rule Eval_tblrows/nil:
  C |- eps `@ `( val* ) : FAIL

rule Eval_tblrows/cons-succ:
  C |- (tblrow_h :: tblrow_t*) `@ `( val* ) : OK val_out
  -- Eval_tblrow: C |- tblrow_h `@ `( val* ) : OK val_out

rule Eval_tblrows/cons-fail:
  C |- (tblrow_h :: tblrow_t*) `@ `( val* ) : valres
  -- Eval_tblrow: C |- tblrow_h `@ `( val* ) : FAIL
  -- Eval_tblrows: C |- tblrow_t* `@ `( val* ) : valres

;;;; Table meta-function evaluation

relation Call_table_func:
  ctx |- tableFuncDef `@ `( val* ) : res<val>
  hint(input %0 %1 %2)

rule Call_table_func:
  C |- tableFuncDef `@ `( val* ) : valres
  -- if TABLE _ `-> tblrow* = tableFuncDef
  -- Eval_tblrows: C |- tblrow* `@ `( val* ) : valres

;;; Defined meta-function invocation

relation Call_defined_func:
  ctx |- definedFuncDef `@ `< typ* > `( val* ) : res<val>
  hint(input %0 %1 %2 %3)

rule Call_defined_func:
  C |- definedFuncDef `@ `< typ* > `( val* ) : valres
  -- if DEF tparam* `-> clause* elsclause? = definedFuncDef
  -- if tdenv = `{ (tparam `: (DEF eps `-> (ALIAS typ)))* }
  -- if C_callee = C[ .LOCAL = $empty_layer[ .TYP = tdenv ] ]
  -- if clause_else* = $opt_as_seq_<clause>(elsclause?)
  -- if clause_all* = clause* ++ clause_else*
  -- Eval_clauses: C_callee `/ C |- clause_all* `@ `( val* ) : valres

;;; Meta-function dispatch

rulegroup Call_func/ok {

    rule Call_func/extern:
      C |- (EXT id) typ* val* : OK val_output
      -- Call_extern_func:
          C |- id `< typ* > `( val* ) : OK val_output

    rule Call_func/builtin:
      C |- builtinFuncDef typ* val* : OK val_output
      -- if BUILTIN id _ _ = builtinFuncDef
      -- Call_builtin_func:
          C |- id `@ `< typ* > `( val* ) : OK val_output

    rule Call_func/table:
      C |- tableFuncDef eps val* : OK val_output
      -- Call_table_func:
          C |- tableFuncDef `@ `( val* ) : OK val_output

    rule Call_func/defined:
      C |- definedFuncDef typ* val* : OK val_output
      -- Call_defined_func:
          C |- definedFuncDef `@ `< typ* > `( val* ) : OK val_output

}

rule Call_func/fail:
  C |- funcdef typ* val* : FAIL
  -- otherwise

;; Meta-function call wrapper with cache

rule Call_func_cached:
  C |- id targ* arg* : valres
  -- Eval_targs: C |- targ* : typ_input*
  -- Eval_args: C |- arg* : OK val_input*
  -- if funccache = $cache_find_func(id, val_input*)
  -- Call_func_dispatch:
      C |- id typ_input* val_input* funccache : valres

rule Call_func_dispatch/hit:
  C |- id typ* val* (OK val_cached) : OK val_cached

rule Call_func_dispatch/miss:
  C |- id typ* val* NONE : valres
  -- if (cursor, funcdef) = $find_func(C, id)
  -- if cp_before = $cache_checkpoint()
  -- Call_func: C |- funcdef typ* val* : valres
  -- if cp_after = $cache_checkpoint()
  -- if b_ext = (funcdef <: externFuncDef)
  -- if b_seff = $cache_seff(cp_before, cp_after)
  -- if b_anon = (cursor = LOCAL)
  -- if b_hoff = $exists_($is_fun(val)*)
  -- if $cache_add_func_maybe(
          b_ext \/ b_seff \/ b_anon \/ b_hoff,
          ;; true,
          id, val*, valres)
