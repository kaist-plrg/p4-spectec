;; Result to represent backtracking in evaluation

syntax res<X> = OK X | FAIL

syntax valres = res<val>
syntax valsres = res<val*>
syntax ctxres = res<ctx>

;; Evaluation relations

relation Eval_exp:
  ctx |- exp : res<val>
  hint(input %0 %1)

relation Eval_exps:
  ctx |- exp* : res<val*>
  hint(input %0 %1)

relation Eval_targs:
  ctx |- targ* : typ*
  hint(input %0 %1)

relation Eval_arg:
  ctx |- arg : res<val>
  hint(input %0 %1)

relation Eval_args:
  ctx |- arg* : res<val*>
  hint(input %0 %1)

relation Eval_prem:
  ctx |- prem : res<ctx>
  hint(input %0 %1)

relation Eval_prems:
  ctx |- prem* : res<ctx>
  hint(input %0 %1)

relation Call_func:
  ctx |- funcdef targ* val* : res<val>
  hint(input %0 %1 %2 %3)

relation Call_func_cached:
  ctx |- id targ* val* : res<val>
  hint(input %0 %1 %2 %3)

relation Call_rel:
  ctx |- reldef val* : res<val*>
  hint(input %0 %1 %2)

relation Call_rel_cached:
  ctx |- id val* : res<val*>
  hint(input %0 %1 %2)

;; Interface to an external cache

extern syntax cachepoint
syntax funccache = OK val | NONE
syntax relcache = OK val* | NONE

var cp : cachepoint

extern dec $cache_find_func(id, val*) : funccache
extern dec $cache_add_func_maybe(bool, id, val*, valres) : bool

extern dec $cache_find_rel(id, val*) : relcache
extern dec $cache_add_rel_maybe(bool, id, val*, valsres) : bool

extern dec $cache_checkpoint() : cachepoint
extern dec $cache_seff(cachepoint, cachepoint) : bool

relation Call_func_dispatch:
  ctx |- id typ* val* funccache : res<val>
  hint(input %0 %1 %2 %3 %4)

relation Call_rel_dispatch:
  ctx |- id val* relcache : res<val*>
  hint(input %0 %1 %2 %3)

;; Iteration helper

dec $is_iter_on_var(exp) : varr?

def $is_iter_on_var(VAR id) = id eps
def $is_iter_on_var(ITER exp iterexp)
  = id (iter* ++ [ iter_outer ])
  -- if id iter* = $is_iter_on_var(exp)
  -- if iter_outer (id _ iter*) = iterexp
def $is_iter_on_var(_) = eps
  -- otherwise
