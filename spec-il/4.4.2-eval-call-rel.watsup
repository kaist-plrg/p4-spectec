;; Relation invocation

syntax valsopt = val*?

;;; Rule path evaluation

relation Eval_rul:
  ctx |- rulmatch -> rulpath `@ `( val* ) : res<val*>
  hint(input %0 %1 %2 %3)

rule Eval_rul/succ:
  C |- rulmatch -> rulpath `@ `( val* ) : OK val_out*
  -- if id `= exp_out* `- prem_path* = rulpath
  -- debug id
  -- if exp* `- prem_match* = rulmatch
  -- Assign_exps: C |- val* -> exp* : OK C'
  -- if prem* = prem_match* ++ prem_path*
  -- Eval_prems: C' |- prem* : OK C''
  -- Eval_exps: C'' |- exp_out* : OK val_out*

rule Eval_rul/fail:
  C |- rulmatch -> rulpath `@ `( val* ) : FAIL
  -- otherwise

;;; Rule path sequence evaluation

relation Eval_ruls:
  ctx |- rulmatch -> rulpath* `@ `( val* ) : res<val*>
  hint(input %0 %1 %2 %3)

rule Eval_ruls/cons-succ:
  C |- rulmatch -> (rulpath_h :: rulpath_t*) `@ `( val* ) : OK val_out*
  -- Eval_rul: C |- rulmatch -> rulpath_h `@ `( val* ) : OK val_out*

rule Eval_ruls/cons-fail:
  C |- rulmatch -> (rulpath_h :: rulpath_t*) `@ `( val* ) : OK val_out*
  -- Eval_rul: C |- rulmatch -> rulpath_h `@ `( val* ) : FAIL
  -- Eval_ruls: C |- rulmatch -> rulpath_t* `@ `( val* ) : OK val_out*

rule Eval_ruls/fail:
  C |- rulmatch -> rulpath* `@ `( val* ) : FAIL
  -- otherwise

;;; Rule group evaluation

relation Eval_rulgroup:
  ctx |- rulgroup `@ `( val* ) : res<val*>
  hint(input %0 %1 %2)

rule Eval_rulgroup/succ:
  C |- rulgroup `@ `( val* ) : OK val_out*
  -- if id `: rulmatch `= rulpath* = rulgroup
  -- debug id
  -- Eval_ruls: C |- rulmatch -> rulpath* `@ `( val* ) : OK val_out*

rule Eval_rulgroup/fail:
  C |- rulgroup `@ `( val* ) : FAIL
  -- otherwise

;;; Rule group sequence evaluation

relation Eval_rulgroups:
  ctx |- rulgroup* `@ `( val* ) : res<val*>
  hint(input %0 %1 %2)

rule Eval_rulgroups/cons-succ:
  C |- (rulgroup_h :: rulgroup_t*) `@ `( val* ) : OK val_out*
  -- Eval_rulgroup: C |- rulgroup_h `@ `( val* ) : OK val_out*

rule Eval_rulgroups/cons-fail:
  C |- (rulgroup_h :: rulgroup_t*) `@ `( val* ) : OK val_out*
  -- Eval_rulgroup: C |- rulgroup_h `@ `( val* ) : FAIL
  -- Eval_rulgroups: C |- rulgroup_t* `@ `( val* ) : OK val_out*

rule Eval_rulgroups/fail:
  C |- rulgroup* `@ `( val* ) : FAIL
  -- otherwise

;; Defined relations

rulegroup Call_rel/defined {
    
    rule Call_rel/succ:
      C |- id val* : OK val_out*
      -- if DEF rulgroup* elsgroup? = $find_rel(C, id)
      -- if C_local = C[ .LOCAL = $empty_layer ]
      -- Eval_rulgroups: C_local |- rulgroup* `@ `( val* ) : OK val_out*

    rule Call_rel/fail-with-els:
      C |- id val* : OK val_out*
      -- if DEF rulgroup* elsgroup = $find_rel(C, id)
      -- if C_local = C[ .LOCAL = $empty_layer ]
      -- Eval_rulgroups: C_local |- rulgroup* `@ `( val* ) : FAIL
      -- if id_els `: rulmatch_els `= rulpath_els = elsgroup
      -- if rulgroup_els = id_els `: rulmatch_els `= rulpath_els
      -- Eval_rulgroup: C_local |- rulgroup_els `@ `( val* ) : OK val_out*

}

;; Extern relations

dec $invoke_extern_rel(id, val*) : res<val*>

rule Call_rel/ext:
  C |- id val* : $invoke_extern_rel(id, val*)
  -- if EXT = $find_rel(C, id)

rule Call_rel/fail:
  C |- id val* : FAIL
  -- otherwise
