;; Fast micro test tier: a curated subset of the p4c submodule's own test
;; corpus (selected via -only include-lists, see ../../../testdata/micro/),
;; run through the exact same test executables as the full parse/run/sim
;; suites.

(rule
 (alias micro)
 (action
  (progn
   (ignore-outputs
    (diff micro_parse_pos.expected micro_parse_pos.actual))
   (ignore-outputs
    (diff micro_run_pos_il.expected micro_run_pos_il.actual))
   (ignore-outputs
    (diff micro_run_pos_sl.expected micro_run_pos_sl.actual))
   (ignore-outputs
    (diff micro_run_pos_pl.expected micro_run_pos_pl.actual))
   (ignore-outputs
    (diff micro_run_neg_il.expected micro_run_neg_il.actual))
   (ignore-outputs
    (diff micro_run_neg_sl.expected micro_run_neg_sl.actual))
   (ignore-outputs
    (diff micro_run_neg_pl.expected micro_run_neg_pl.actual))
   (ignore-outputs
    (diff micro_sim_v1model_il.expected micro_sim_v1model_il.actual))
   (ignore-outputs
    (diff micro_sim_v1model_sl.expected micro_sim_v1model_sl.actual))
   (ignore-outputs
    (diff micro_sim_v1model_pl.expected micro_sim_v1model_pl.actual))
   (ignore-outputs
    (diff micro_sim_ebpf_il.expected micro_sim_ebpf_il.actual))
   (ignore-outputs
    (diff micro_sim_ebpf_sl.expected micro_sim_ebpf_sl.actual))
   (ignore-outputs
    (diff micro_sim_ebpf_pl.expected micro_sim_ebpf_pl.actual))
   (ignore-outputs
    (diff micro_sim_psa_il.expected micro_sim_psa_il.actual))
   (ignore-outputs
    (diff micro_sim_psa_sl.expected micro_sim_psa_sl.actual))
   (ignore-outputs
    (diff micro_sim_psa_pl.expected micro_sim_psa_pl.actual)))))

(rule
 (alias micro-det)
 (action
  (progn
   (ignore-outputs
    (diff micro_run_pos_il.expected micro_run_pos_il_det.actual))
   (ignore-outputs
    (diff micro_run_pos_sl.expected micro_run_pos_sl_det.actual))
   (ignore-outputs
    (diff micro_run_neg_il.expected micro_run_neg_il_det.actual))
   (ignore-outputs
    (diff micro_run_neg_sl.expected micro_run_neg_sl_det.actual))
   (ignore-outputs
    (diff micro_sim_v1model_il.expected micro_sim_v1model_il_det.actual))
   (ignore-outputs
    (diff micro_sim_v1model_sl.expected micro_sim_v1model_sl_det.actual))
   (ignore-outputs
    (diff micro_sim_ebpf_il.expected micro_sim_ebpf_il_det.actual))
   (ignore-outputs
    (diff micro_sim_ebpf_sl.expected micro_sim_ebpf_sl_det.actual))
   (ignore-outputs
    (diff micro_sim_psa_il.expected micro_sim_psa_il_det.actual))
   (ignore-outputs
    (diff micro_sim_psa_sl.expected micro_sim_psa_sl_det.actual)))))

;; Parse (reduction-independent, lives outside @micro-det)

(rule
 (target micro_parse_pos.actual)
 (deps
  (source_tree ../../../spec)
  (source_tree ../../../p4c/p4include)
  (source_tree ../../../p4c/testdata/p4_16_samples)
  (source_tree ../../../p4c/testdata/p4_16_errors)
  (source_tree ../../../testdata/micro))
 (action
  (with-stdout-to
   micro_parse_pos.actual
   (with-stderr-to
    micro_parse_pos.err
    (run
     %{exe:../parse/test.exe}
     parser
     -s
     ../../../spec
     -i
     ../../../p4c/p4include
     -only
     ../../../testdata/micro/pos
     -p4-dir
     ../../../p4c/testdata/p4_16_samples)))))

