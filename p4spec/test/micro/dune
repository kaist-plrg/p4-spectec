;; @micro: shallow per-category coverage over a tiny curated corpus.

(rule
 (target micro_parse_pos.actual)
 (deps
  (source_tree ../../../spec)
  (source_tree ../../../p4c/p4include)
  (source_tree programs)
  ../parse/test.exe)
 (action
  (with-stdout-to
   micro_parse_pos.actual
   (with-stderr-to
    micro_parse_pos.err
    (run
     ../parse/test.exe
     parser
     -s
     ../../../spec
     -i
     ../../../p4c/p4include
     -p4-dir
     programs)))))

(rule
 (target micro_parse_neg.actual)
 (deps
  (source_tree ../../../spec)
  (source_tree ../../../p4c/p4include)
  (source_tree programs-parse-neg)
