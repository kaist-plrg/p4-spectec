(rule
 (alias micro)
 (deps
  ../run/run_regression_neg_sl.expected
  ../run/run_regression_neg_sl.actual
  ../run/run_regression_pos_sl.expected
  ../run/run_regression_pos_sl.actual
  ../sim/sim_v1model_regression_sl.expected
  ../sim/sim_v1model_regression_sl.actual)
 (action
  (progn
   (diff micro_parse_pos.expected micro_parse_pos.actual)
   (diff micro_parse_neg.expected micro_parse_neg.actual)
   (diff micro_run_pos_al.expected micro_run_pos_al.actual)
   (diff micro_run_pos_sl.expected micro_run_pos_sl.actual)
   (diff micro_run_neg_al.expected micro_run_neg_al.actual)
   (diff micro_run_neg_sl.expected micro_run_neg_sl.actual)
   (diff micro_sim_v1model_al.expected micro_sim_v1model_al.actual)
   (diff micro_sim_v1model_sl.expected micro_sim_v1model_sl.actual)
   (diff micro_sim_ebpf_al.expected micro_sim_ebpf_al.actual)
   (diff micro_sim_ebpf_sl.expected micro_sim_ebpf_sl.actual)
   (diff micro_sim_psa_al.expected micro_sim_psa_al.actual)
   (diff micro_sim_psa_sl.expected micro_sim_psa_sl.actual)
   (diff micro_run_pos_pl.expected micro_run_pos_pl.actual)
   (diff micro_run_neg_pl.expected micro_run_neg_pl.actual)
   (diff micro_sim_v1model_pl.expected micro_sim_v1model_pl.actual)
   (diff micro_sim_ebpf_pl.expected micro_sim_ebpf_pl.actual)
   (diff micro_sim_psa_pl.expected micro_sim_psa_pl.actual)
   (diff micro_boot_al.expected micro_boot_al.actual)
   (diff micro_boot_al_al.expected micro_boot_al_al.actual)
   ;; Regression corpus: reuse the run-sl/sim-sl targets (testdata/regression)
   (diff
    ../run/run_regression_neg_sl.expected
    ../run/run_regression_neg_sl.actual)
   (diff
    ../run/run_regression_pos_sl.expected
    ../run/run_regression_pos_sl.actual)
   (diff
    ../sim/sim_v1model_regression_sl.expected
    ../sim/sim_v1model_regression_sl.actual))))

(rule
 (alias micro-det)
 (action
  (progn
   (diff micro_run_pos_al.expected micro_run_pos_al_det.actual)
   (diff micro_run_pos_sl.expected micro_run_pos_sl_det.actual)
   (diff micro_run_neg_al.expected micro_run_neg_al_det.actual)
   (diff micro_run_neg_sl.expected micro_run_neg_sl_det.actual)
   (diff micro_sim_v1model_al.expected micro_sim_v1model_al_det.actual)
   (diff micro_sim_v1model_sl.expected micro_sim_v1model_sl_det.actual)
   (diff micro_sim_ebpf_al.expected micro_sim_ebpf_al_det.actual)
