(executable
 (name main)
 (modules main)
 (libraries p4spectec_lsp linol-eio yojson unix str))

(executable
 (name e2e)
 (modules e2e)
 (libraries yojson unix))

(rule
 (target main.actual)
 (action
  (with-stdout-to
   %{target}
   (run ./main.exe))))

(rule
 (target e2e.actual)
 (action
  (with-stdout-to
   %{target}
   (run ./e2e.exe %{exe:../../bin/lsp_main.exe}))))

(rule
 (alias lsp)
 (action
  (progn
   (diff main.expected main.actual)
   (diff e2e.expected e2e.actual))))

(alias
 (name runtest)
 (deps
  (alias lsp)))
