(executable
 (name smoke_test)
 (modules smoke_test)
 (libraries p4spectec))

(rule
 (target latex-smoke.tex)
 (action
  (with-stdout-to
   latex-smoke.tex
   (run ./smoke_test.exe))))

(rule
 (alias latex-smoke)
 (deps latex-smoke.tex)
 (action
  (run pdflatex -halt-on-error -interaction=nonstopmode latex-smoke.tex)))
