;; P4 static semantics tests

(test
 (name test)
 (preprocess
  (pps ppx_let))
 (modules test)
 (libraries
  test_common
  p4spectec
  core
  core_kernel
  core_unix
  core_unix.command_unix)
 (action
  (progn
   (ignore-outputs
    (diff run_pos_il.expected run_pos_il.actual))
   (ignore-outputs
    (diff run_pos_sl.expected run_pos_sl.actual))
   (ignore-outputs
    (diff run_neg_il.expected run_neg_il.actual))
   (ignore-outputs
    (diff run_neg_sl.expected run_neg_sl.actual)))))

(rule
 (alias run)
 (action
  (progn
   (ignore-outputs
    (diff run_pos_il.expected run_pos_il.actual))
   (ignore-outputs
    (diff run_pos_sl.expected run_pos_sl.actual))
   (ignore-outputs
    (diff run_neg_il.expected run_neg_il.actual))
   (ignore-outputs
    (diff run_neg_sl.expected run_neg_sl.actual)))))

(rule
 (alias run-il)
 (action
  (progn
   (ignore-outputs
    (diff run_pos_il.expected run_pos_il.actual))
   (ignore-outputs
    (diff run_neg_il.expected run_neg_il.actual)))))

(rule
 (alias run-sl)
 (action
  (progn
   (ignore-outputs
    (diff run_pos_sl.expected run_pos_sl.actual))
   (ignore-outputs
    (diff run_neg_sl.expected run_neg_sl.actual)))))

(rule
 (alias run-det)
 (action
  (progn
   (ignore-outputs
    (diff run_pos_il.expected run_pos_il_det.actual))
   (ignore-outputs
    (diff run_pos_sl.expected run_pos_sl_det.actual))
   (ignore-outputs
    (diff run_neg_il.expected run_neg_il_det.actual))
   (ignore-outputs
    (diff run_neg_sl.expected run_neg_sl_det.actual)))))

(rule
 (alias run-il-det)
 (action
  (progn
   (ignore-outputs
    (diff run_pos_il.expected run_pos_il_det.actual))
   (ignore-outputs
    (diff run_neg_il.expected run_neg_il_det.actual)))))

(rule
 (alias run-sl-det)
 (action
  (progn
   (ignore-outputs
    (diff run_pos_sl.expected run_pos_sl_det.actual))
   (ignore-outputs
    (diff run_neg_sl.expected run_neg_sl_det.actual)))))

;; Rules to generate outputs (fast, no -det)

(rule
 (target run_pos_il.actual)
 (action
  (with-stdout-to
   run_pos_il.actual
   (with-stderr-to
    run_pos_il.err
    (run
     ./test.exe
     run
     -il
     -s
     ../../../../../spec-concrete
     -rel
     Program_inst
     -i
     ../../../../../p4c/p4include
     -e
     ../../../../../excludes/static
     -p4-dir
     ../../../../../p4c/testdata/p4_16_samples)))))

(rule
 (target run_neg_il.actual)
 (action
  (with-stdout-to
   run_neg_il.actual
   (with-stderr-to
    run_neg_il.err
    (run
     ./test.exe
     run
     -il
     -s
     ../../../../../spec-concrete
     -rel
     Program_ok
     -i
     ../../../../../p4c/p4include
     -e
     ../../../../../excludes/static
     -p4-dir
     ../../../../../p4c/testdata/p4_16_errors
     -neg)))))

(rule
 (target run_pos_sl.actual)
 (action
  (with-stdout-to
   run_pos_sl.actual
   (with-stderr-to
    run_pos_sl.err
    (run
     ./test.exe
     run
     -sl
     -s
     ../../../../../spec-concrete
     -rel
     Program_inst
     -i
     ../../../../../p4c/p4include
     -e
     ../../../../../excludes/static
