;; P4 static semantics tests

(executable
 (name test)
 (preprocess
  (pps ppx_let))
 (modules test)
 (libraries
  test_common
  p4spectec
  core
  core_kernel
  core_unix
  core_unix.command_unix))

;; Nano-P4 static semantics tests

(executable
 (name nano_test)
 (preprocess
  (pps ppx_let))
 (modules nano_test)
 (libraries
  test_common
  p4spectec
  core
  core_kernel
  core_unix
  core_unix.command_unix))

(rule
 (alias run)
 (action
  (progn
   (ignore-outputs
    (diff run_pos_al.expected run_pos_al.actual))
   (ignore-outputs
    (diff run_pos_sl.expected run_pos_sl.actual))
   (ignore-outputs
    (diff run_neg_al.expected run_neg_al.actual))
   (ignore-outputs
    (diff run_neg_sl.expected run_neg_sl.actual))
   (ignore-outputs
    (diff run_regression_neg_sl.expected run_regression_neg_sl.actual))
   (ignore-outputs
    (diff run_regression_pos_sl.expected run_regression_pos_sl.actual)))))

(rule
 (alias run-al)
 (action
  (progn
   (ignore-outputs
    (diff run_pos_al.expected run_pos_al.actual))
   (ignore-outputs
    (diff run_neg_al.expected run_neg_al.actual)))))

(rule
 (alias run-sl)
 (action
  (progn
   (ignore-outputs
    (diff run_pos_sl.expected run_pos_sl.actual))
   (ignore-outputs
    (diff run_neg_sl.expected run_neg_sl.actual))
   (ignore-outputs
    (diff run_regression_neg_sl.expected run_regression_neg_sl.actual))
   (ignore-outputs
    (diff run_regression_pos_sl.expected run_regression_pos_sl.actual)))))

(rule
 (alias run-pl)
 (action
  (progn
   (ignore-outputs
    (diff run_pos_pl.expected run_pos_pl.actual))
   (ignore-outputs
    (diff run_neg_pl.expected run_neg_pl.actual)))))

(rule
 (alias run-det)
 (action
  (progn
   (ignore-outputs
    (diff run_pos_al.expected run_pos_al_det.actual))
   (ignore-outputs
    (diff run_pos_sl.expected run_pos_sl_det.actual))
   (ignore-outputs
    (diff run_neg_al.expected run_neg_al_det.actual))
   (ignore-outputs
    (diff run_neg_sl.expected run_neg_sl_det.actual))
   (ignore-outputs
    (diff run_regression_neg_sl.expected run_regression_neg_sl_det.actual))
   (ignore-outputs
    (diff run_regression_pos_sl.expected run_regression_pos_sl_det.actual)))))

(rule
 (alias run-al-det)
 (action
  (progn
   (ignore-outputs
    (diff run_pos_al.expected run_pos_al_det.actual))
   (ignore-outputs
    (diff run_neg_al.expected run_neg_al_det.actual)))))

(rule
 (alias run-sl-det)
 (action
  (progn
   (ignore-outputs
    (diff run_pos_sl.expected run_pos_sl_det.actual))
   (ignore-outputs
    (diff run_neg_sl.expected run_neg_sl_det.actual)))))

(rule
 (alias run-pl-det)
 (action
  (progn
   (ignore-outputs
    (diff run_pos_pl.expected run_pos_pl_det.actual))
   (ignore-outputs
    (diff run_neg_pl.expected run_neg_pl_det.actual)))))

;; Rules to generate outputs (fast, no -det)

(rule
 (target run_pos_al.actual)
 (deps
  (source_tree ../../../spec)
  (source_tree ../../../p4c/p4include)
  (source_tree ../../../p4c/testdata/p4_16_samples)
  (source_tree ../../../p4c/testdata/p4_16_errors)
  (source_tree ../../../excludes)
  (source_tree ../../../patches)
  (source_tree ../../../testdata))
 (action
  (with-stdout-to
   run_pos_al.actual
   (with-stderr-to
    run_pos_al.err
    (run
     ./test.exe
     run
     -al
     -s
     ../../../spec
     -rel
     Program_inst
     -i
     ../../../p4c/p4include
     -e
     ../../../excludes/static
     -p4-dir
     ../../../p4c/testdata/p4_16_samples)))))

(rule
 (target run_neg_al.actual)
 (deps
  (source_tree ../../../spec)
  (source_tree ../../../p4c/p4include)
  (source_tree ../../../p4c/testdata/p4_16_samples)
  (source_tree ../../../p4c/testdata/p4_16_errors)
  (source_tree ../../../excludes)
  (source_tree ../../../patches)
  (source_tree ../../../testdata))
 (action
  (with-stdout-to
   run_neg_al.actual
   (with-stderr-to
    run_neg_al.err
    (run
     ./test.exe
     run
     -al
     -s
     ../../../spec
     -rel
     Program_ok
     -i
     ../../../p4c/p4include
     -e
     ../../../excludes/static
     -p4-dir
     ../../../p4c/testdata/p4_16_errors
     -neg)))))

