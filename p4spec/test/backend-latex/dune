(library
 (name backend_latex_test_support)
 (modules backend_latex_test_support)
 (libraries p4spectec backend_latex))

(executables
 (names
  doc_test
  width_test
  layout_test
  link_test
  serialize_test
  renderer_test)
 (modules
  doc_test
  width_test
  layout_test
  link_test
  serialize_test
  renderer_test)
 (libraries p4spectec backend_latex backend_latex_test_support))

(rule
 (target doc.actual)
 (action
  (with-stdout-to
   doc.actual
   (run ./doc_test.exe))))

(rule
 (aliases backend-latex-doc backend-latex)
 (action
  (diff doc.expected doc.actual)))

