[numbered-continuation]
\begin{array}{r@{\quad}l}
{\scriptstyle\mathtt{(1)}} & \mathit{alpha} \\
 & \quad\mathit{beta} \\
{\scriptstyle\mathtt{(2)}} & \mathit{tail}
\end{array}
[flat-above-boundary]
\mathit{1234} \mathit{5678}
[flat-at-boundary]
\mathit{1234} \mathit{5678}
[broken-over-boundary]
\begin{array}{l}
\mathit{1234} \\
\quad\mathit{5678}
\end{array}
[group-with-pending-suffix]
\begin{array}{l}
\mathit{abc} \\
\mathit{def}\mathit{XYZ}
\end{array}
[broken-suffix-line-awareness]
\begin{array}{l}
\mathit{aaa} \mathit{bbb} \\
\mathit{cc}
\end{array}
[nested-layout]
\begin{array}{l}
\mathit{outer} \\
\quad\mathit{inner} \\
\quad\quad\mathit{continuation}
\end{array}
[nested-delimiter-column]
\begin{array}{l}
\mathit{head} \\
\quad\left(\begin{array}{l}
\mathit{abc} \\
\quad\mathit{def}
\end{array}\right)
\end{array}
[delimiter-closing-boundary]
\left(\begin{array}{l}
\mathit{1234} \\
\mathit{5678}
\end{array}\right)
[direct-delimiter-closing-boundary]
\left(\begin{array}{l}
\mathit{1234} \\
\mathit{5678}
\end{array}\right)
[subscript-base-reservation-boundary]
{\begin{array}{l}
\mathit{12345} \\
\mathit{6789}
\end{array}}_{\mathit{xy}}
[direct-superscript-half-width-boundary]
{\mathit{12345}}^{\mathit{abcd} \mathit{efgh}}
[soft-comma-list]
\left(\begin{array}{l}
\mathit{alpha}, \\
\mathit{beta}, \\
\mathit{gamma}
\end{array}\right)
[fill-exact-fit]
\mathit{aaa} \mathit{bbb}
[fill-one-over]
\begin{array}{l}
\mathit{aaa} \\
\mathit{bbb}
\end{array}
[fill-greedy-two-lines]
\begin{array}{l}
\mathit{aaa} \mathit{bbb} \\
\mathit{ccc}
\end{array}
[fill-greedy-three-lines]
\begin{array}{l}
\mathit{aaa} \\
\mathit{bbb} \\
\mathit{ccc}
\end{array}
[fill-indented]
\begin{array}{l}
\mathit{aaa} \mathit{bbb} \\
\quad\mathit{ccc}
\end{array}
[fill-pending-suffix]
\begin{array}{l}
\mathit{aaa} \\
\mathit{bbb}\mathit{XYZ}
\end{array}
[fill-nested-item]
\begin{array}{l}
\mathit{aaa} \\
\quad\mathit{dddd} \\
\quad\mathit{eeee} \mathit{f}
\end{array}
[spanning-grid]
\mathrlap{\displaystyle \begin{array}{rcl}
\mathit{f(x)} & = & \mathit{short} \\
\mathrlap{\displaystyle \quad\text{if}\,\mathit{condition}}\smash{\hphantom{\begin{array}{r}
\mathit{f(x)}
\end{array}}} &  &
\end{array}}\smash{\hphantom{\begin{array}{l}
\begin{array}{rcl}
\mathit{f(x)} & = & \mathit{short}
\end{array} \\
\quad\text{if}\,\mathit{condition}
\end{array}}}
[grid-row-gap]
\begin{array}{lcl}
\mathit{f(x)} & = & \mathit{first} \\[1ex]
\mathit{f(long)} & = & \mathit{second}
\end{array}
[mathjax-spanning-grid]
\mathrlap{\displaystyle \begin{array}{rcl}
\mathrm{call}\left(\href{#lhs_arg}{\mathit{argument}}\right) & = & \mathit{result} \\
\mathrlap{\displaystyle \quad\text{if}\,\href{#condition}{\mathit{condition}}}\smash{\hphantom{\begin{array}{r}
\mathrm{call}\left(\mathit{argument}\right)
\end{array}}} &  &
\end{array}}\smash{\hphantom{\begin{array}{l}
\begin{array}{rcl}
\mathrm{call}\left(\mathit{argument}\right) & = & \mathit{result}
\end{array} \\
\quad\text{if}\,\mathit{condition}
\end{array}}}
[spanning-only-grid]
\begin{array}{l}
\quad\text{if}\,\mathit{condition} \\
\mathit{a\_much\_longer\_condition}
\end{array}
[mixed-grid-width-envelope]
\mathrlap{\displaystyle \begin{array}{rcl}
\href{#cell}{\mathit{x}} & = & \mathit{y} \\
\mathrlap{\displaystyle \quad\text{if}\,\href{#wide_condition}{\mathit{condition\_that\_is\_deliberately\_wider\_than\_the\_equation}}}\smash{\hphantom{\begin{array}{r}
\mathit{x}
\end{array}}} &  &
\end{array}}\smash{\hphantom{\begin{array}{l}
\begin{array}{rcl}
\mathit{x} & = & \mathit{y}
\end{array} \\
\quad\text{if}\,\mathit{condition\_that\_is\_deliberately\_wider\_than\_the\_equation}
\end{array}}}
[mixed-grid-order]
\mathrlap{\displaystyle \begin{array}{l}
\mathit{cell\_first} \\
\mathrlap{\displaystyle \mathit{span\_first}}\smash{\hphantom{\begin{array}{r}
\mathit{cell\_first} \\
\mathit{cell\_second}
\end{array}}} \\
\mathit{cell\_second} \\
\mathrlap{\displaystyle \mathit{span\_second}}\smash{\hphantom{\begin{array}{r}
\mathit{cell\_first} \\
\mathit{cell\_second}
\end{array}}}
\end{array}}\smash{\hphantom{\begin{array}{l}
\begin{array}{l}
\mathit{cell\_first} \\
\mathit{cell\_second}
\end{array} \\
\mathit{span\_first} \\
\mathit{span\_second}
\end{array}}}
[aligned-complementary-cell-budgets]
\begin{aligned}
\begin{array}{l}
\mathit{aaaaa} \\
\quad\mathit{bbbbb}
\end{array} & = & \mathit{x} \\
\mathit{y} & = & \begin{array}{l}
\mathit{ccccc} \\
\quad\mathit{ddddd}
\end{array}
\end{aligned}
[grid-complementary-cell-budgets]
\begin{array}{rcl}
\begin{array}{l}
\mathit{aaaaa} \\
\quad\mathit{bbbbb}
\end{array} & = & \mathit{x} \\
\mathit{y} & = & \begin{array}{l}
\mathit{ccccc} \\
\quad\mathit{ddddd}
\end{array}
\end{array}
[grid-stable-column-recompute]
\begin{array}{rcl}
\begin{array}{l}
\mathit{aaaaaaaaaa} \\
\mathit{bbbbbbbbbb}
\end{array} & = & \mathit{x} \\
\mathit{y} & = & \mathit{ccccc} \mathit{ddddd}
\end{array}
[grid-nested-cell-budget]
\begin{array}{rcl}
\mathit{lllll} & = & \begin{array}{l}
\mathit{z} \\
\quad\mathit{cccc} \\
\quad\mathit{dddd}
\end{array}
\end{array}
[bad-width]
true
