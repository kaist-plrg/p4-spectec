[linked-badge]
\href{#rule_label}{{\definecolor{ellatexrulelabelbg}{rgb}{0.94,0.94,0.92}\fcolorbox{black}{ellatexrulelabelbg}{\scriptsize \texttt{Rule\_label}}}}
[badge-link-stripping]
\mathrlap{\displaystyle \begin{array}{rcl}
\href{#badge}{{\definecolor{ellatexrulelabelbg}{rgb}{0.94,0.94,0.92}\fcolorbox{black}{ellatexrulelabelbg}{\scriptsize \texttt{Rule\_label}}}} & = & \mathit{value} \\
\mathrlap{\displaystyle \quad\text{if}\,\mathit{condition\_that\_is\_deliberately\_wider\_than\_the\_badge}}\smash{\hphantom{\begin{array}{r}
{\definecolor{ellatexrulelabelbg}{rgb}{0.94,0.94,0.92}\fcolorbox{black}{ellatexrulelabelbg}{\scriptsize \texttt{Rule\_label}}}
\end{array}}} &  &
\end{array}}\smash{\hphantom{\begin{array}{l}
\begin{array}{rcl}
{\definecolor{ellatexrulelabelbg}{rgb}{0.94,0.94,0.92}\fcolorbox{black}{ellatexrulelabelbg}{\scriptsize \texttt{Rule\_label}}} & = & \mathit{value}
\end{array} \\
\quad\text{if}\,\mathit{condition\_that\_is\_deliberately\_wider\_than\_the\_badge}
\end{array}}}
[link]
\href{#call_fn'}{\mathrm{call\_fn'}}
[empty-link]

[fallback-link]
\href{#relation_target}{\mathit{p} \vdash }\href{#call_fn}{\mathrm{call\_fn}}\href{#relation_target}{ \left(\mathit{x}\right) = \mathit{y}}
[empty-fallback-link]

[unlinked-fallback-link]
\href{#relation_target}{\mathit{x} = \mathit{y}}
[numbered-links]
\begin{array}{r@{\quad}l}
{\scriptstyle\mathtt{(1)}} & \href{#first_premise}{\mathit{first}} \\
{\scriptstyle\mathtt{(2)}} & \href{#relation}{\mathit{second}}
\end{array}
[numbered-unlinked-fallback]
\begin{array}{r@{\quad}l}
{\scriptstyle\mathtt{(1)}} & \href{#relation}{\mathit{first}} \\
{\scriptstyle\mathtt{(2)}} & \href{#relation}{\mathit{second}}
\end{array}
[numbered-nested-fallback]
{\displaystyle \href{#relation}{\mathit{before} }{\begin{array}{r@{\quad}l}
{\scriptstyle\mathtt{(1)}} & \href{#relation}{\mathit{first}} \\
{\scriptstyle\mathtt{(2)}} & \href{#relation}{\mathit{second}}
\end{array}}\href{#relation}{ \mathit{after}}}
[fill-links]
\begin{array}{l}
\href{#first}{\mathit{aaa}} \href{#relation}{\mathit{bbb}} \\
\href{#relation}{\mathit{ccc}}
\end{array}
[fill-nested-fallback]
{\displaystyle \begin{array}{l}
\href{#relation}{\mathit{before} }\href{#relation}{\mathit{aaa}} \\
\href{#relation}{\mathit{bbb}}\href{#relation}{ \mathit{after}}
\end{array}}
[fill-grid-link-stripping]
\mathrlap{\displaystyle \begin{array}{l}
\href{#first}{\mathit{aaa}} \href{#second}{\mathit{bbb}} \\
\mathrlap{\displaystyle \mathit{tail}}\smash{\hphantom{\begin{array}{r}
\mathit{aaa} \mathit{bbb}
\end{array}}}
\end{array}}\smash{\hphantom{\begin{array}{l}
\begin{array}{l}
\mathit{aaa} \mathit{bbb}
\end{array} \\
\mathit{tail}
\end{array}}}
[line-wise-link-fallback]
\begin{array}{l}
\href{#relation}{\mathit{left}} \\
\href{#relation}{\quad}\href{#function}{\mathrm{call}} \\
\href{#relation}{\quad\mathit{right}}
\end{array}
