[bool-type]
\mathbb{B}
[number-types]
\left(\mathbb{N}, \mathbb{Z}, \mathbb{T}\right)
[type-application]
\mathsf{Box\_t}\left\langle\mathbb{B}, \mathbb{N}\right\rangle
[type-iteration]
{\mathsf{item\_t}}^{\ast}
[empty-sequence-type]

[singleton-sequence-type]
\mathsf{p}
[multiple-sequence-type]
\mathsf{p}\,\mathsf{TC}\,\mathsf{x}
[notation-type]
\left\langle\mathsf{CASE}\,\mathsf{x\_t}\right\rangle
[subscripted-arrow-type]
\mathsf{x} {\to}_{\mathsf{n}} \mathsf{y}\,\mathsf{z}
[singleton-arrow-sub-type]
\mathsf{x} {\to}_{\mathsf{n}}
[singleton-double-arrow-sub-type]
\mathsf{p} {\Rightarrow}_{\mathsf{k}}
[empty-sequence-expression]

[singleton-sequence-expression]
\mathsf{p}
[literals]
\mathsf{true}\,123456789012345678901234567890\,\mathtt{0x123456789abcdef0123456789abcdef}\,\texttt{"a\_\#\%\&\{\}}\backslash{}\hat{}\sim{}\texttt{"}\,\epsilon
[multiple-sequence-expression]
\mathsf{p}\,\mathsf{TC}\,\mathsf{x}
[variable-subscripts]
\mathsf{plain}\,{\mathsf{TC}}_{\mathsf{0}}\,{\mathsf{typeId}}_{\mathsf{fresh\_local}}\,\mathsf{\_}
[precedence-stronger-right]
\mathsf{a} + \mathsf{b} \cdot \mathsf{c}
[precedence-weaker-left]
\left(\mathsf{a} + \mathsf{b}\right) \cdot \mathsf{c}
[left-associative-right-child]
\mathsf{a} - \left(\mathsf{b} - \mathsf{c}\right)
[right-associative-left-child]
\left(\mathsf{a} \Rightarrow \mathsf{b}\right) \Rightarrow \mathsf{c}
[non-associative-child]
\left(\mathsf{a} \mathrel{\vdash} \mathsf{b}\right) \mathrel{\vdash} \mathsf{c}
[explicit-parentheses]
\left({\mathsf{x}}_{\mathsf{under}}\right)
[power]
{{\mathsf{a}}^{\mathsf{b}}}^{\mathsf{c}}
[collections]
\left[\mathsf{x}, \mathsf{y}\right]\,\left(\mathsf{x}, \mathsf{y}\right)\,\left\{\mathsf{FIELD} \mathsf{x}, {\,}_{\mathsf{META}} {\mathsf{ignored}}_{\mathsf{label}}\right\}
[list-leading-silent-item]
\left[{\,}_{\mathsf{META}}, \mathsf{x}, \mathsf{y}\right]
[tuple-middle-silent-item]
\left(\mathsf{x}, {\,}_{\mathsf{META}}, \mathsf{y}\right)
[call-trailing-silent-argument]
\mathrm{call\_fn}\left(\mathsf{x}, \mathsf{y}, {\,}_{\mathsf{META}}\right)
[all-silent-list]
\left[{\,}_{\mathsf{META}}, {\,}_{\mathsf{META}}\right]
[list-operators]
\left(\mathsf{x} \mathbin{::} \mathsf{xs}\right) \mathbin{+\!\!+} \left[\mathsf{y}\right]
[access]
{\mathsf{record}}_{\mathsf{FIELD}}\left[\mathsf{lo} : \mathsf{hi}\right]\left[\left[\mathsf{i}\right].\mathsf{NEXT} = \left|\mathsf{value}\right|\right]
[membership-and-subtype]
\mathsf{x} \in \mathsf{xs} \mathrel{<:} \mathsf{element\_t}
[call]
\mathrm{lookup\_fn}\left\langle\mathsf{key\_t}\right\rangle\left({\mathsf{key}}_{\mathsf{v}}, \mathrm{fallback\_fn}\right)
[iteration]
{\mathsf{entry}}^{?}
[bracket-notation]
\left\{\mathsf{payload}\right\}
[subscripted-arrows]
\left(\mathsf{x} {\to}_{\mathsf{n}} \mathsf{y}\,\mathsf{z}\right)\,\left(\mathsf{p} {\Rightarrow}_{\mathsf{k}} \mathsf{q}\right)
[singleton-arrow-sub-expression]
\mathsf{x} {\to}_{\mathsf{n}}
[singleton-double-arrow-sub-expression]
\mathsf{p} {\Rightarrow}_{\mathsf{k}}
[silent-tag]
\mathsf{left}\,{\,}_{\mathsf{META}}\,\mathsf{right}
[silent-left-infix-flat]
{\,}_{\mathsf{META}} \mathbin{\mathtt{<+>}} \mathsf{rightvisible}
[silent-left-infix-constrained]
\begin{array}{l}
{\,}_{\mathsf{META}} \\
\quad\quad\mathbin{\mathtt{<+>}} \mathsf{rightvisible}
\end{array}
[silent-operator-infix-flat]
\mathsf{leftvisible} {\,}_{\mathsf{META}} \mathsf{rightvisible}
