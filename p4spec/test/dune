;; Test configuration for P4-SpecTec

(test
 (name test)
 (preprocess
  (pps ppx_let))
 (modules test)
 (libraries p4spec core core_kernel core_unix core_unix.command_unix)
 (action
  (progn
   (ignore-outputs
    (diff elab.expected elab.actual))
   (ignore-outputs
    (diff struct.expected struct.actual))
   (ignore-outputs
    (diff prose.expected prose.actual))
   (ignore-outputs
    (diff run_il_type_pos_p4c.expected run_il_type_pos_p4c.actual))
   (ignore-outputs
    (diff run_il_type_neg_p4c.expected run_il_type_neg_p4c.actual))
   (ignore-outputs
    (diff run_il_inst_p4c.expected run_il_inst_p4c.actual))
   (ignore-outputs
    (diff run_sl_type_pos_p4c.expected run_sl_type_pos_p4c.actual))
   (ignore-outputs
    (diff run_sl_type_neg_p4c.expected run_sl_type_neg_p4c.actual))
   (ignore-outputs
    (diff run_sl_lift_p4c.expected run_sl_lift_p4c.actual))
   (ignore-outputs
    (diff run_sl_inst_p4c.expected run_sl_inst_p4c.actual))
   (ignore-outputs
    (diff sim_sl_v1model_p4c.expected sim_sl_v1model_p4c.actual))
   (ignore-outputs
    (diff cover_dangling_p4c.expected cover_dangling_p4c.actual))
   (ignore-outputs
    (diff parser_pos_p4c.expected parser_pos_p4c.actual))
   (ignore-outputs
    (diff parser_neg_p4c.expected parser_neg_p4c.actual)))))

;; Elaboration and structuring tests for specification language

(rule
 (alias speclang)
 (action
  (progn
   (ignore-outputs
    (diff elab.expected elab.actual))
   (ignore-outputs
    (diff struct.expected struct.actual))
   (ignore-outputs
    (diff prose.expected prose.actual)))))

;; P4 typing tests

(rule
 (alias p4type)
 (action
  (progn
   (ignore-outputs
    (diff run_il_type_pos_p4c.expected run_il_type_pos_p4c.actual))
   (ignore-outputs
    (diff run_il_type_neg_p4c.expected run_il_type_neg_p4c.actual))
   (ignore-outputs
    (diff run_sl_type_pos_p4c.expected run_sl_type_pos_p4c.actual))
   (ignore-outputs
    (diff run_sl_type_neg_p4c.expected run_sl_type_neg_p4c.actual)))))

;; P4 lifting tests

(rule
 (alias p4lift)
 (action
  (progn
   (ignore-outputs
    (diff run_sl_lift_p4c.expected run_sl_lift_p4c.actual)))))

;; P4 instantiation tests

(rule
 (alias p4inst)
 (action
  (progn
   (ignore-outputs
