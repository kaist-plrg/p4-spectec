(rule
 (target run_il_type_pos_p4c.actual)
 (action
  (with-stdout-to
   run_il_type_pos_p4c.actual
   (with-stderr-to
    run_il_type_pos_p4c.err
    (run
     ./test.exe
     run
     -il
     -s
     ../../../../spec-concrete
     -rel
     Program_ok
     -i
     ../../../../p4c/p4include
     -e
     ../../../../excludes
     -d
     ../../../../p4c/testdata/p4_16_samples)))))

