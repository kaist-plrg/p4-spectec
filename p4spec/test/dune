(rule
 (target p4_static_pos_il.actual)
 (action
  (with-stdout-to
   p4_static_pos_il.actual
   (with-stderr-to
    p4_static_pos_il.err
    (run
     ./test.exe
     run
     -il
     -s
     ../../../../spec-concrete
     -rel
     Program_inst
     -i
     ../../../../p4c/p4include
     -e
     ../../../../excludes/static
     -p4-dir
     ../../../../p4c/testdata/p4_16_samples
     -p4-dir
     ../../../../testdata/custom)))))

(rule
 (target p4_static_neg_il.actual)
 (action
  (with-stdout-to
   p4_static_neg_il.actual
