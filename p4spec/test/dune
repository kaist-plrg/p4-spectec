;; Test configuration for P4-SpecTec

(test
 (name test)
 (preprocess
  (pps ppx_let))
 (modules test)
 (libraries p4spectec core core_kernel core_unix core_unix.command_unix)
 (action
  (progn
   (ignore-outputs
    (diff elab.expected elab.actual))
   (ignore-outputs
    (diff struct.expected struct.actual))
   (ignore-outputs
    (diff prose.expected prose.actual))
   (ignore-outputs
    (diff run_il_type_pos.expected run_il_type_pos.actual))
   (ignore-outputs
    (diff run_il_type_neg.expected run_il_type_neg.actual))
   (ignore-outputs
    (diff run_il_inst.expected run_il_inst.actual))
   (ignore-outputs
    (diff run_sl_type_pos.expected run_sl_type_pos.actual))
   (ignore-outputs
    (diff run_sl_type_neg.expected run_sl_type_neg.actual))
   (ignore-outputs
    (diff run_sl_inst.expected run_sl_inst.actual))
   (ignore-outputs
    (diff sim_sl_v1model.expected sim_sl_v1model.actual))
   (ignore-outputs
    (diff sim_sl_ebpf.expected sim_sl_ebpf.actual))
   (ignore-outputs
    (diff cover_dangling.expected cover_dangling.actual))
   (ignore-outputs
    (diff cover_sim_instr.expected cover_sim_instr.actual))
   (ignore-outputs
    (diff parser_pos.expected parser_pos.actual))
   (ignore-outputs
    (diff parser_neg.expected parser_neg.actual)))))

;; Elaboration and structuring tests for specification language

(rule
 (alias speclang)
 (action
  (progn
   (ignore-outputs
    (diff elab.expected elab.actual))
   (ignore-outputs
    (diff struct.expected struct.actual))
   (ignore-outputs
    (diff prose.expected prose.actual)))))

;; P4 typing tests

