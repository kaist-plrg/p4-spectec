(rule
 (target run_il_type_pos.actual)
 (action
  (with-stdout-to
   run_il_type_pos.actual
   (with-stderr-to
    run_il_type_pos.err
    (run
     ./test.exe
     run
     -il
     -s
     ../../../../spec-concrete
     -rel
     Program_ok
     -i
     ../../../../p4c/p4include
     -e
     ../../../../excludes/static
     -p4-dir
     ../../../../p4c/testdata/p4_16_samples
     -p4-dir
     ../../../../testdata/custom)))))

