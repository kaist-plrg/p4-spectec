 (action
  (progn
   (ignore-outputs
    (diff cover_dangling_p4c.expected cover_dangling_p4c.actual)))))

;; P4 parsing tests

(rule
 (alias p4parse)
 (action
  (progn
   (ignore-outputs
    (diff parser_pos_p4c.expected parser_pos_p4c.actual))
   (ignore-outputs
    (diff parser_neg_p4c.expected parser_neg_p4c.actual)))))

;; Rules to generate outputs

(rule
 (target elab.actual)
 (action
  (with-stdout-to
   elab.actual
   (with-stderr-to
    elab.err
    (run ./test.exe elab -s ../../../../spec-concrete)))))

(rule
 (target struct.actual)
 (action
  (with-stdout-to
   struct.actual
   (with-stderr-to
    struct.err
    (run ./test.exe struct -s ../../../../spec-concrete)))))

