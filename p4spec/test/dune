;; Test configuration for P4-SpecTec

(test
 (name test)
 (preprocess
  (pps ppx_let))
 (modules test)
 (libraries p4spectec core core_kernel core_unix core_unix.command_unix)
 (action
  (progn
   (ignore-outputs
    (diff elab.expected elab.actual))
   (ignore-outputs
    (diff struct.expected struct.actual))
   (ignore-outputs
    (diff prose.expected prose.actual))
   (ignore-outputs
    (diff p4_static_pos_il.expected p4_static_pos_il.actual))
   (ignore-outputs
    (diff p4_static_neg_il.expected p4_static_neg_il.actual))
   (ignore-outputs
    (diff p4_static_pos_sl.expected p4_static_pos_sl.actual))
   (ignore-outputs
    (diff p4_static_neg_sl.expected p4_static_neg_sl.actual))
   (ignore-outputs
    (diff p4_dynamic_v1model_sl.expected p4_dynamic_v1model_sl.actual))
   (ignore-outputs
    (diff p4_dynamic_ebpf_sl.expected p4_dynamic_ebpf_sl.actual))
   (ignore-outputs
    (diff parser_pos.expected parser_pos.actual))
   (ignore-outputs
    (diff parser_neg.expected parser_neg.actual)))))

;; Elaboration and structuring tests for specification language

(rule
 (alias speclang)
 (action
  (progn
   (ignore-outputs
    (diff elab.expected elab.actual))
   (ignore-outputs
    (diff struct.expected struct.actual))
   (ignore-outputs
    (diff prose.expected prose.actual)))))

;; P4 static semantics tests

(rule
 (alias p4static)
 (action
  (progn
   (ignore-outputs
    (diff p4_static_pos_il.expected p4_static_pos_il.actual))
   (ignore-outputs
    (diff p4_static_neg_il.expected p4_static_neg_il.actual))
   (ignore-outputs
    (diff p4_static_pos_sl.expected p4_static_pos_sl.actual))
   (ignore-outputs
    (diff p4_static_pos_sl.expected p4_static_pos_sl.actual)))))

