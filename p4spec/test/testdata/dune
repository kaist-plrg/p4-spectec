;; Export 'flattened' test suites

(executable
 (name test)
 (preprocess
  (pps ppx_let))
 (modules test)
 (libraries
  test_common
  p4spectec
  core
  core_kernel
  core_unix
  core_unix.command_unix))

(rule
  (alias export-p4testgen-v1model)
  (action
    (run
     ./test.exe
     export-tests
     -arch
     v1model
     -p4-dir
     ../../../../../p4c/testdata/p4_16_samples
     -stf-dir
     ../../../../../testdata/p4testgen
     -export-dir
     ../../../../../p4testgen-v1model)))

