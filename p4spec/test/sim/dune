;; Nano-P4 simulation tests

(rule
 (alias sim-nano)
 (action
  (progn
   (ignore-outputs
    (diff sim_nano_sl.expected sim_nano_sl.actual)))))

(rule
 (target sim_nano_sl.actual)
 (deps
  (source_tree ../../../nano-p4/spec)
  (source_tree ../../../nano-p4/include)
  (source_tree ../../../nano-p4/testdata))
 (action
  (with-stdout-to
   sim_nano_sl.actual
   (with-stderr-to
    sim_nano_sl.err
    (run
     ./nano_test.exe
     sim
     -sl
     -s
     ../../../nano-p4/spec
     -i
     ../../../nano-p4/include
     -p4-dir
     ../../../nano-p4/testdata/positive)))))
