;; Rules to generate outputs

(rule
 (target p4_dynamic_v1model_p4c_il.actual)
 (action
  (with-stdout-to
   p4_dynamic_v1model_p4c_il.actual
   (with-stderr-to
    p4_dynamic_v1model_p4c_il.err
    (run
     ./test.exe
     sim
     -il
     -det
     -arch
     v1model
     -s
     ../../../../../spec-concrete
     -i
     ../../../../../p4c/p4include
     -e
     ../../../../../excludes/static
     -e
     ../../../../../excludes/dynamic
     -p4-dir
     ../../../../../p4c/testdata/p4_16_samples
     -stf-dir
     ../../../../../p4c/testdata/p4_16_samples
     -p
     ../../../../../patches/v1model)))))

