;; P4 simulation tests

(test
 (name test)
 (preprocess
  (pps ppx_let))
 (modules test)
 (libraries
  test_common
  p4spectec
  core
  core_kernel
  core_unix
  core_unix.command_unix)
 (action
  (progn
   (ignore-outputs
    (diff
     p4_dynamic_v1model_p4c_il.expected
     p4_dynamic_v1model_p4c_il.actual))
   (ignore-outputs
    (diff
     p4_dynamic_v1model_p4c_sl.expected
     p4_dynamic_v1model_p4c_sl.actual))
   (ignore-outputs
    (diff
     p4_dynamic_v1model_p4testgen_il.expected
     p4_dynamic_v1model_p4testgen_il.actual))
   (ignore-outputs
    (diff
     p4_dynamic_v1model_p4testgen_sl.expected
     p4_dynamic_v1model_p4testgen_sl.actual))
   (ignore-outputs
    (diff
     p4_dynamic_v1model_custom_il.expected
     p4_dynamic_v1model_custom_il.actual))
   (ignore-outputs
    (diff
     p4_dynamic_v1model_custom_sl.expected
     p4_dynamic_v1model_custom_sl.actual))
   (ignore-outputs
    (diff p4_dynamic_ebpf_p4c_il.expected p4_dynamic_ebpf_p4c_il.actual))
   (ignore-outputs
    (diff p4_dynamic_ebpf_p4c_sl.expected p4_dynamic_ebpf_p4c_sl.actual))
   (ignore-outputs
    (diff
     p4_dynamic_ebpf_p4testgen_il.expected
     p4_dynamic_ebpf_p4testgen_il.actual))
   (ignore-outputs
    (diff
     p4_dynamic_ebpf_p4testgen_sl.expected
     p4_dynamic_ebpf_p4testgen_sl.actual)))))

