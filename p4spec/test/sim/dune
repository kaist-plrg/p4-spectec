;; Rules to generate outputs (fast, no -det)

(rule
 (target sim_v1model_p4c_il.actual)
 (deps
  (source_tree ../../../spec)
  (source_tree ../../../p4c/p4include)
  (source_tree ../../../p4c/testdata/p4_16_samples)
  (source_tree ../../../p4c/testdata/p4_16_errors)
  (source_tree ../../../excludes)
  (source_tree ../../../patches)
  (source_tree ../../../testdata))
 (action
  (with-stdout-to
   sim_v1model_p4c_il.actual
   (with-stderr-to
    sim_v1model_p4c_il.err
    (run
     ./test.exe
     sim
     -il
     -arch
     v1model
     -s
     ../../../spec
     -i
     ../../../p4c/p4include
     -e
     ../../../excludes/static
     -e
     ../../../excludes/dynamic
     -p4-dir
     ../../../p4c/testdata/p4_16_samples
     -stf-dir
     ../../../p4c/testdata/p4_16_samples
     -p
     ../../../patches/v1model)))))

