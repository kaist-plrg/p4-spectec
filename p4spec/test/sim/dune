;; P4 simulation tests

(executable
 (name test)
 (preprocess
  (pps ppx_let))
 (modules test)
 (libraries
  test_common
  p4spectec
  core
  core_kernel
  core_unix
  core_unix.command_unix))

;; Nano-P4 simulation tests

(executable
 (name nano_test)
 (preprocess
  (pps ppx_let))
