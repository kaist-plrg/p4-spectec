  (source_tree ../../../p4c/testdata/p4_16_errors)
  (source_tree ../../../excludes)
  (source_tree ../../../patches)
  (source_tree ../../../testdata))
 (action
  (with-stdout-to
   sim_ebpf_p4c_pl_det.actual
   (with-stderr-to
    sim_ebpf_p4c_pl_det.err
    (run
     ./test.exe
     sim
