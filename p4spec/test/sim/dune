;; P4 simulation tests

(test
 (name test)
 (preprocess
  (pps ppx_let))
 (modules test)
 (libraries
  test_common
  p4spectec
  core
  core_kernel
  core_unix
  core_unix.command_unix)
 (action
  (progn
   (ignore-outputs
    (diff sim_v1model_p4c_il.expected sim_v1model_p4c_il.actual))
   (ignore-outputs
    (diff sim_v1model_p4c_sl.expected sim_v1model_p4c_sl.actual))
   (ignore-outputs
    (diff sim_v1model_p4testgen_il.expected sim_v1model_p4testgen_il.actual))
   (ignore-outputs
    (diff sim_v1model_p4testgen_sl.expected sim_v1model_p4testgen_sl.actual))
   (ignore-outputs
    (diff sim_v1model_custom_il.expected sim_v1model_custom_il.actual))
   (ignore-outputs
    (diff sim_v1model_custom_sl.expected sim_v1model_custom_sl.actual))
   (ignore-outputs
    (diff sim_ebpf_p4c_il.expected sim_ebpf_p4c_il.actual))
   (ignore-outputs
    (diff sim_ebpf_p4c_sl.expected sim_ebpf_p4c_sl.actual))
   (ignore-outputs
    (diff sim_ebpf_p4testgen_il.expected sim_ebpf_p4testgen_il.actual))
   (ignore-outputs
    (diff sim_ebpf_p4testgen_sl.expected sim_ebpf_p4testgen_sl.actual))
   (ignore-outputs
    (diff sim_psa_p4c_il.expected sim_psa_p4c_il.actual))
   (ignore-outputs
    (diff sim_psa_p4c_sl.expected sim_psa_p4c_sl.actual)))))

