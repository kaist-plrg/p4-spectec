    rule list: EC_0 ARCH_0 |- typedExpressionIR as forCollectionExpressionIR : EC_1 ARCH_1 ` value*{value <- value*} as expressionListResult
    -- Expr_eval: LOCAL EC_0 ARCH_0 |- typedExpressionIR : EC_1 ARCH_1 ` listValue as value as expressionResult
    -- if (LIST [ value*{value <- value*} ] = listValue)

    rule header-stack: EC_0 ARCH_0 |- typedExpressionIR as forCollectionExpressionIR : EC_1 ARCH_1 ` value*{value <- value*} as expressionListResult
    -- Expr_eval: LOCAL EC_0 ARCH_0 |- typedExpressionIR : EC_1 ARCH_1 ` headerStackValue as value as expressionResult
    -- if (HEADER_STACK [ value*{value <- value*} ( _nat ; _nat' ) ] = headerStackValue)

  rulegroup range

    rule left-abort: EC_0 ARCH_0 |- typedExpressionIR_l .. typedExpressionIR_r : EC_1 ARCH_1 abortResult as expressionListResult
    -- Expr_eval: LOCAL EC_0 ARCH_0 |- typedExpressionIR_l : EC_1 ARCH_1 abortResult as expressionResult

    rule left-cont-right-abort: EC_0 ARCH_0 |- typedExpressionIR_l .. typedExpressionIR_r : EC_2 ARCH_2 abortResult as expressionListResult
    -- Expr_eval: LOCAL EC_0 ARCH_0 |- typedExpressionIR_l : EC_1 ARCH_1 ` value_l as expressionResult
    -- Expr_eval: LOCAL EC_1 ARCH_1 |- typedExpressionIR_r : EC_2 ARCH_2 abortResult as expressionResult

    rule left-cont-right-cont: EC_0 ARCH_0 |- typedExpressionIR_l .. typedExpressionIR_r : EC_2 ARCH_2 ` value*{value <- value*} as expressionListResult
    -- Expr_eval: LOCAL EC_0 ARCH_0 |- typedExpressionIR_l : EC_1 ARCH_1 ` value_l as expressionResult
    -- Expr_eval: LOCAL EC_1 ARCH_1 |- typedExpressionIR_r : EC_2 ARCH_2 ` value_r as expressionResult
    -- if (typeIR = $type_of_typedExpressionIR(typedExpressionIR_l))
    -- if (value*{value <- value*} = $values_of_setValue(SET < typeIR >, SET { value_l .. value_r }))

def $values_of_setValue(setTypeIR, setValue) : value* =

  clause 0 : (SET < typeIR >, setValue) = value_l :: $values_of_setValue(SET < typeIR >, SET { value_l_inc .. value_r })
  -- if setValue matches `SET {% .. %}`
  -- let SET { value_l .. value_r } = setValue
  -- if $bin_lt(value_l, value_r)
  -- let value_one = $cast_op(typeIR, D 1 as int as value)
  -- let value_l_inc = $bin_plus(value_l, value_one)

  clause 1 : (SET < typeIR >, setValue) = [value_l]
  -- if setValue matches `SET {% .. %}`
  -- let SET { value_l .. value_r } = setValue
  -- if $bin_eq(value_l, value_r)

