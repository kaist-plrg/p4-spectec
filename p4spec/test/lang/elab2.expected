def $cast_op(typeIR, value) : value =

  clause 0 : (typeIR, value) = $cast_bool(typeIR_unroll, boolValue)
  -- if value <: boolValue
  -- let boolValue = value as boolValue
  -- let typeIR_unroll = $unroll_typeIR(typeIR)

  clause 1 : (typeIR, value) = $cast_int(typeIR_unroll, integerValue)
  -- if value <: integerValue
  -- let integerValue = value as integerValue
  -- let typeIR_unroll = $unroll_typeIR(typeIR)

  clause 2 : (typeIR, value) = $cast_error(typeIR_unroll, errorValue)
  -- if value <: errorValue
  -- let errorValue = value as errorValue
  -- let typeIR_unroll = $unroll_typeIR(typeIR)

  clause 3 : (typeIR, value) = $cast_list(typeIR_unroll, listValue)
  -- if value <: listValue
  -- let listValue = value as listValue
  -- let typeIR_unroll = $unroll_typeIR(typeIR)

  clause 4 : (typeIR, value) = $cast_header_stack(typeIR_unroll, headerStackValue)
  -- if value <: headerStackValue
  -- let headerStackValue = value as headerStackValue
  -- let typeIR_unroll = $unroll_typeIR(typeIR)

  clause 5 : (typeIR, value) = $cast_struct(typeIR_unroll, structValue)
  -- if value <: structValue
  -- let structValue = value as structValue
  -- let typeIR_unroll = $unroll_typeIR(typeIR)

  clause 6 : (typeIR, value) = $cast_header(typeIR_unroll, headerValue)
  -- if value <: headerValue
  -- let headerValue = value as headerValue
  -- let typeIR_unroll = $unroll_typeIR(typeIR)

  clause 7 : (typeIR, value) = $cast_enum(typeIR_unroll, enumValue)
  -- if value <: enumValue
  -- let enumValue = value as enumValue
  -- let typeIR_unroll = $unroll_typeIR(typeIR)

  clause 8 : (typeIR, value) = $cast_sequence(typeIR_unroll, sequenceValue)
  -- if value <: sequenceValue
  -- let sequenceValue = value as sequenceValue
  -- let typeIR_unroll = $unroll_typeIR(typeIR)

  clause 9 : (typeIR, value) = $cast_record(typeIR_unroll, recordValue)
  -- if value <: recordValue
  -- let recordValue = value as recordValue
  -- let typeIR_unroll = $unroll_typeIR(typeIR)

  clause 10 : (typeIR, value) = $cast_default(typeIR_unroll, DEFAULT)
  -- if value <: defaultValue
  -- let defaultValue = value as defaultValue
  -- if (defaultValue = DEFAULT)
  -- let typeIR_unroll = $unroll_typeIR(typeIR)

  clause 11 : (typeIR, value) = $cast_invalid_header(typeIR_unroll)
  -- if value <: invalidHeaderValue
  -- let invalidHeaderValue = value as invalidHeaderValue
  -- let typeIR_unroll = $unroll_typeIR(typeIR)

  clause 12 : (typeIR, value) = $cast_set(typeIR_unroll, setValue)
  -- if value <: setValue
  -- let setValue = value as setValue
  -- let typeIR_unroll = $unroll_typeIR(typeIR)

def $default(typeIR) : value =

  clause 0 : (typeIR) = `B false as value
  -- if typeIR <: boolTypeIR
  -- let boolTypeIR = typeIR as boolTypeIR
  -- if (boolTypeIR = BOOL)

  clause 1 : (typeIR) = ERROR . "NoError" as value
  -- if typeIR <: errorTypeIR
  -- let errorTypeIR = typeIR as errorTypeIR
  -- if (errorTypeIR = ERROR)

  clause 2 : (typeIR) = " text_empty " as value
  -- if typeIR <: stringTypeIR
  -- let stringTypeIR = typeIR as stringTypeIR
  -- if (stringTypeIR = STRING)
  -- let text_empty = ""

  clause 3 : (typeIR) = D 0 as int as value
  -- if typeIR <: intTypeIR
  -- let intTypeIR = typeIR as intTypeIR
  -- if (intTypeIR = INT)

  clause 4 : (typeIR) = w W 0 as int as value
  -- if typeIR <: fixedBitTypeIR
  -- let BIT < w > = typeIR as fixedBitTypeIR

  clause 5 : (typeIR) = w S 0 as int as value
  -- if typeIR <: fixedIntTypeIR
  -- let INT < w > = typeIR as fixedIntTypeIR

  clause 6 : (typeIR) = w . 0 V 0 as int as value
  -- if typeIR <: varBitTypeIR
  -- let VARBIT < w > = typeIR as varBitTypeIR

  clause 7 : (typeIR') = $default(typeIR)
  -- if typeIR' <: typedefTypeIR
  -- let TYPEDEF _typeId typeIR = typeIR' as typedefTypeIR

  clause 8 : (typeIR') = $default(typeIR)
  -- if typeIR' <: newTypeIR
  -- let TYPE _typeId typeIR = typeIR' as newTypeIR

  clause 9 : (typeIR') = TUPLE ( $default(typeIR)*{typeIR <- typeIR*} ) as value
  -- if typeIR' <: tupleTypeIR
  -- let TUPLE < typeIR*{typeIR <- typeIR*} > = typeIR' as tupleTypeIR

  clause 10 : (typeIR') = HEADER_STACK [ value*{value <- value*} ( 0 ; n_s ) ] as value
  -- if typeIR' <: headerStackTypeIR
  -- let typeIR [ n_s ] = typeIR' as headerStackTypeIR
  -- let value*{value <- value*} = $repeat_<value>($default(typeIR), n_s)

  clause 11 : (typeIR) = STRUCT typeId { $default(typeIR_f) id_f ;*{id_f <- id_f*, typeIR_f <- typeIR_f*} } as value
  -- if typeIR <: structTypeIR
  -- let STRUCT typeId < _typeArgumentIR*{_typeArgumentIR <- _typeArgumentIR*} > { _annotationList typeIR_f id_f ;*{_annotationList <- _annotationList*, id_f <- id_f*, typeIR_f <- typeIR_f*} } = typeIR as structTypeIR

  clause 12 : (typeIR) = HEADER typeId { false ; $default(typeIR_f) id_f ;*{id_f <- id_f*, typeIR_f <- typeIR_f*} } as value
  -- if typeIR <: headerTypeIR
  -- let HEADER typeId < _typeArgumentIR*{_typeArgumentIR <- _typeArgumentIR*} > { _annotationList typeIR_f id_f ;*{_annotationList <- _annotationList*, id_f <- id_f*, typeIR_f <- typeIR_f*} } = typeIR as headerTypeIR

  clause 13 : (typeIR) = HEADER_UNION typeId { $default(typeIR_f) id_f ;*{id_f <- id_f*, typeIR_f <- typeIR_f*} } as value
  -- if typeIR <: headerUnionTypeIR
  -- let HEADER_UNION typeId < _typeArgumentIR*{_typeArgumentIR <- _typeArgumentIR*} > { _annotationList typeIR_f id_f ;*{_annotationList <- _annotationList*, id_f <- id_f*, typeIR_f <- typeIR_f*} } = typeIR as headerUnionTypeIR

  clause 14 : (typeIR) = typeId . id_f_h as value
  -- if typeIR <: simpleEnumTypeIR
  -- let ENUM typeId { id*{id <- id*} } = typeIR as simpleEnumTypeIR
  -- if id*{id <- id*} matches _ :: _
  -- let id_f_h :: _id*{_id <- _id*} = id*{id <- id*}

  clause 15 : (typeIR') = typeId . id_zero . value_zero as value
  -- if typeIR' <: serializableEnumTypeIR
  -- let ENUM typeId < typeIR > { nameIR_field = value_field ;*{nameIR_field <- nameIR_field*, value_field <- value_field*} } = typeIR' as serializableEnumTypeIR
  -- let value_zero = $cast_int(typeIR, D 0 as int as integerValue)
  -- let id?{id <- id?} = $assoc_<value, id>(value_zero, (value_field, nameIR_field)*{nameIR_field <- nameIR_field*, value_field <- value_field*})
  -- if id?{id <- id?} matches (_)
  -- let ?(id_zero) = id?{id <- id?}

  clause 16 : (typeIR') = typeId . id_zero . value_zero as value
  -- if typeIR' <: serializableEnumTypeIR
  -- let ENUM typeId < typeIR > { nameIR_field = value_field ;*{nameIR_field <- nameIR_field*, value_field <- value_field*} } = typeIR' as serializableEnumTypeIR
  -- let value_zero = $cast_int(typeIR, D 0 as int as integerValue)
  -- if (?() = $assoc_<value, id>(value_zero, (value_field, nameIR_field)*{nameIR_field <- nameIR_field*, value_field <- value_field*}))
  -- let id_zero = "__UNSPECIFIED"

def $cast_to_enum(enumTypeIR, value) : value =

  clause 0 : (enumTypeIR, value) = $cast_to_enum'(typeId, typeIR, valueFieldIR*{valueFieldIR <- valueFieldIR*}, value)
  -- if enumTypeIR <: serializableEnumTypeIR
  -- let ENUM typeId < typeIR > { valueFieldIR*{valueFieldIR <- valueFieldIR*} } = enumTypeIR as serializableEnumTypeIR

def $cast_to_enum'(typeId, typeIR, valueFieldIR*, value) : value =

  clause 0 : (typeId, typeIR, valueFieldIR*{valueFieldIR <- valueFieldIR*}, value_target) = typeId . id_unnamed . value_idx as value
  -- if valueFieldIR*{valueFieldIR <- valueFieldIR*} matches []
  -- let value_idx = $cast_op(typeIR, value_target)
  -- let id_unnamed = "__UNSPECIFIED"

  clause 1 : (typeId, typeIR, valueFieldIR*{valueFieldIR <- valueFieldIR*}, value_target) = typeId . nameIR . value as value
  -- if valueFieldIR*{valueFieldIR <- valueFieldIR*} matches _ :: _
  -- let valueFieldIR_h :: valueFieldIR_t*{valueFieldIR_t <- valueFieldIR_t*} = valueFieldIR*{valueFieldIR <- valueFieldIR*}
  -- let nameIR = value ; = valueFieldIR_h
  -- if $bin_eq(value, value_target)

  clause 2 : (typeId, typeIR, valueFieldIR*{valueFieldIR <- valueFieldIR*}, value_target) = $cast_to_enum'(typeId, typeIR, valueFieldIR_t*{valueFieldIR_t <- valueFieldIR_t*}, value_target)
  -- if valueFieldIR*{valueFieldIR <- valueFieldIR*} matches _ :: _
  -- let valueFieldIR_h :: valueFieldIR_t*{valueFieldIR_t <- valueFieldIR_t*} = valueFieldIR*{valueFieldIR <- valueFieldIR*}
  -- let nameIR = value ; = valueFieldIR_h
  -- if ~$bin_eq(value, value_target)

def $cast_bool(typeIR, boolValue) : value =

  clause 0 : (typeIR, `B b) = `B b as value
  -- if typeIR <: boolTypeIR
  -- let boolTypeIR = typeIR as boolTypeIR
  -- if (boolTypeIR = BOOL)

  clause 1 : (typeIR, boolValue) = w W 1 as int as value
  -- if typeIR <: fixedBitTypeIR
  -- let BIT < w > = typeIR as fixedBitTypeIR
  -- if (boolValue = `B true)

  clause 2 : (typeIR, boolValue) = w W 0 as int as value
  -- if typeIR <: fixedBitTypeIR
  -- let BIT < w > = typeIR as fixedBitTypeIR
  -- if (boolValue = `B false)

  clause 3 : (typeIR', boolValue) = $cast_bool(typeIR, boolValue)
  -- if typeIR' <: newTypeIR
  -- let TYPE _typeId typeIR = typeIR' as newTypeIR

  clause 4 : (typeIR', boolValue) = SET { $cast_bool(typeIR, boolValue) } as value
  -- if typeIR' <: setTypeIR
  -- let SET < typeIR > = typeIR' as setTypeIR

def $cast_int(typeIR, integerValue) : value =

  clause 0 : (typeIR, integerValue) = `B (i =/= 0 as int) as value
  -- if typeIR <: boolTypeIR
  -- let boolTypeIR = typeIR as boolTypeIR
  -- if (boolTypeIR = BOOL)
  -- if integerValue <: integerLiteral
  -- let integerLiteral = integerValue as integerLiteral
  -- if integerLiteral matches `D %`
  -- let D i = integerLiteral

  clause 1 : (typeIR, integerValue) = `B (i =/= 0 as int) as value
  -- if typeIR <: boolTypeIR
  -- let boolTypeIR = typeIR as boolTypeIR
  -- if (boolTypeIR = BOOL)
  -- if integerValue <: integerLiteral
  -- let integerLiteral = integerValue as integerLiteral
  -- if integerLiteral matches `% W %`
  -- let w W i = integerLiteral

  clause 2 : (typeIR, integerValue) = D i as value
  -- if typeIR <: intTypeIR
  -- let intTypeIR = typeIR as intTypeIR
  -- if (intTypeIR = INT)
  -- if integerValue <: integerLiteral
  -- let integerLiteral = integerValue as integerLiteral
  -- if integerLiteral matches `D %`
  -- let D i = integerLiteral

  clause 3 : (typeIR, integerValue) = D i as value
  -- if typeIR <: intTypeIR
  -- let intTypeIR = typeIR as intTypeIR
  -- if (intTypeIR = INT)
  -- if integerValue <: integerLiteral
  -- let integerLiteral = integerValue as integerLiteral
  -- if integerLiteral matches `% W %`
  -- let _nat W i = integerLiteral

  clause 4 : (typeIR, integerValue) = D $bitstr_to_int(w as int, i) as value
  -- if typeIR <: intTypeIR
  -- let intTypeIR = typeIR as intTypeIR
  -- if (intTypeIR = INT)
  -- if integerValue <: integerLiteral
  -- let integerLiteral = integerValue as integerLiteral
  -- if integerLiteral matches `% S %`
  -- let w S i = integerLiteral

  clause 5 : (typeIR, integerValue) = w_to W i_cast as value
  -- if typeIR <: fixedBitTypeIR
  -- let BIT < w_to > = typeIR as fixedBitTypeIR
  -- if integerValue <: integerLiteral
  -- let integerLiteral = integerValue as integerLiteral
  -- if integerLiteral matches `D %`
  -- let D i = integerLiteral
  -- let i_cast = $int_to_bitstr(w_to as int, i)

  clause 6 : (typeIR, integerValue) = w_to W i_cast as value
  -- if typeIR <: fixedBitTypeIR
  -- let BIT < w_to > = typeIR as fixedBitTypeIR
  -- if integerValue <: integerLiteral
  -- let integerLiteral = integerValue as integerLiteral
  -- if integerLiteral matches `% W %`
  -- let _nat W i = integerLiteral
  -- let i_cast = $int_to_bitstr(w_to as int, i)

  clause 7 : (typeIR, integerValue) = w_to W i_cast as value
  -- if typeIR <: fixedBitTypeIR
  -- let BIT < w_to > = typeIR as fixedBitTypeIR
  -- if integerValue <: integerLiteral
  -- let integerLiteral = integerValue as integerLiteral
  -- if integerLiteral matches `% S %`
  -- let w_from S i = integerLiteral
  -- let i_from = $bitstr_to_int(w_from as int, i)
  -- let i_cast = $int_to_bitstr(w_to as int, i_from)

  clause 8 : (typeIR, integerValue) = w_to S i_cast as value
  -- if typeIR <: fixedIntTypeIR
  -- let INT < w_to > = typeIR as fixedIntTypeIR
  -- if integerValue <: integerLiteral
  -- let integerLiteral = integerValue as integerLiteral
  -- if integerLiteral matches `D %`
  -- let D i = integerLiteral
  -- let i_cast = $int_to_bitstr(w_to as int, i)

  clause 9 : (typeIR, integerValue) = w_to S i_cast as value
  -- if typeIR <: fixedIntTypeIR
  -- let INT < w_to > = typeIR as fixedIntTypeIR
  -- if integerValue <: integerLiteral
  -- let integerLiteral = integerValue as integerLiteral
  -- if integerLiteral matches `% W %`
  -- let _nat W i = integerLiteral
  -- let i_cast = $int_to_bitstr(w_to as int, i)

  clause 10 : (typeIR, integerValue) = w_to S i_cast as value
  -- if typeIR <: fixedIntTypeIR
  -- let INT < w_to > = typeIR as fixedIntTypeIR
  -- if integerValue <: integerLiteral
  -- let integerLiteral = integerValue as integerLiteral
  -- if integerLiteral matches `% S %`
  -- let w_from S i = integerLiteral
  -- let i_from = $bitstr_to_int(w_from as int, i)
  -- let i_cast = $int_to_bitstr(w_to as int, i_from)

  clause 11 : (typeIR, integerValue) = w_max . w V i as value
  -- if typeIR <: varBitTypeIR
  -- let VARBIT < w_max > = typeIR as varBitTypeIR
  -- if integerValue matches `% . % V %`
  -- let w_max' . w V i = integerValue
  -- if (w_max = w_max')

  clause 12 : (typeIR', integerValue) = $cast_op(typeIR, D i as value)
  -- if typeIR' <: newTypeIR
  -- let TYPE _typeId typeIR = typeIR' as newTypeIR
  -- if integerValue <: integerLiteral
  -- let integerLiteral = integerValue as integerLiteral
  -- if integerLiteral matches `D %`
  -- let D i = integerLiteral

  clause 13 : (typeIR', integerValue) = $cast_op(typeIR, w W i as value)
  -- if typeIR' <: newTypeIR
  -- let TYPE _typeId typeIR = typeIR' as newTypeIR
  -- if integerValue <: integerLiteral
  -- let integerLiteral = integerValue as integerLiteral
  -- if integerLiteral matches `% W %`
  -- let w W i = integerLiteral

  clause 14 : (typeIR', integerValue) = $cast_op(typeIR, w S i as value)
  -- if typeIR' <: newTypeIR
  -- let TYPE _typeId typeIR = typeIR' as newTypeIR
  -- if integerValue <: integerLiteral
  -- let integerLiteral = integerValue as integerLiteral
  -- if integerLiteral matches `% S %`
  -- let w S i = integerLiteral

  clause 15 : (typeIR, integerValue) = $cast_to_enum(enumTypeIR, w W i as value)
  -- if typeIR <: enumTypeIR
  -- let enumTypeIR = typeIR as enumTypeIR
  -- if integerValue <: integerLiteral
  -- let integerLiteral = integerValue as integerLiteral
  -- if integerLiteral matches `% W %`
  -- let w W i = integerLiteral

  clause 16 : (typeIR, integerValue) = $cast_to_enum(enumTypeIR, w S i as value)
  -- if typeIR <: enumTypeIR
  -- let enumTypeIR = typeIR as enumTypeIR
  -- if integerValue <: integerLiteral
  -- let integerLiteral = integerValue as integerLiteral
  -- if integerLiteral matches `% S %`
  -- let w S i = integerLiteral

  clause 17 : (typeIR', integerValue) = SET { $cast_op(typeIR, D i as value) } as value
  -- if typeIR' <: setTypeIR
  -- let SET < typeIR > = typeIR' as setTypeIR
  -- if integerValue <: integerLiteral
  -- let integerLiteral = integerValue as integerLiteral
  -- if integerLiteral matches `D %`
  -- let D i = integerLiteral

  clause 18 : (typeIR', integerValue) = SET { $cast_op(typeIR, w W i as value) } as value
  -- if typeIR' <: setTypeIR
  -- let SET < typeIR > = typeIR' as setTypeIR
  -- if integerValue <: integerLiteral
  -- let integerLiteral = integerValue as integerLiteral
  -- if integerLiteral matches `% W %`
  -- let w W i = integerLiteral

  clause 19 : (typeIR', integerValue) = SET { $cast_op(typeIR, w S i as value) } as value
  -- if typeIR' <: setTypeIR
  -- let SET < typeIR > = typeIR' as setTypeIR
  -- if integerValue <: integerLiteral
  -- let integerLiteral = integerValue as integerLiteral
  -- if integerLiteral matches `% S %`
  -- let w S i = integerLiteral

def $cast_error(typeIR, errorValue) : value =

  clause 0 : (typeIR, ERROR . nameIR) = ERROR . nameIR as value
  -- if typeIR <: errorTypeIR
  -- let errorTypeIR = typeIR as errorTypeIR
  -- if (errorTypeIR = ERROR)

  clause 1 : (typeIR', errorValue) = SET { $cast_op(typeIR, errorValue as value) } as value
  -- if typeIR' <: setTypeIR
  -- let SET < typeIR > = typeIR' as setTypeIR

def $cast_list(typeIR, listValue) : value =

  clause 0 : (typeIR', LIST [ value*{value <- value*} ]) = LIST [ $cast_op(typeIR, value)*{value <- value*} ] as value
  -- if typeIR' <: listTypeIR
  -- let LIST < typeIR > = typeIR' as listTypeIR

def $cast_header_stack(typeIR, headerStackValue) : value =

  clause 0 : (typeIR', HEADER_STACK [ value*{value <- value*} ( n_idx ; n_size' ) ]) = HEADER_STACK [ value*{value <- value*} ( n_idx ; n_size ) ] as value
  -- if typeIR' <: headerStackTypeIR
  -- let typeIR [ n_size ] = typeIR' as headerStackTypeIR
  -- if (n_size = n_size')

def $cast_struct(typeIR, structValue) : value =

  clause 0 : (typeIR, STRUCT typeId' { value_field nameIR_field ;*{nameIR_field <- nameIR_field*, value_field <- value_field*} }) = STRUCT typeId { value_field nameIR_field ;*{nameIR_field <- nameIR_field*, value_field <- value_field*} } as value
  -- if typeIR <: structTypeIR
  -- let STRUCT typeId < _typeArgumentIR*{_typeArgumentIR <- _typeArgumentIR*} > { _fieldTypeIR*{_fieldTypeIR <- _fieldTypeIR*} } = typeIR as structTypeIR
  -- if (typeId = typeId')

def $cast_header(typeIR, headerValue) : value =

  clause 0 : (typeIR, HEADER typeId' { b ; value_field nameIR_field ;*{nameIR_field <- nameIR_field*, value_field <- value_field*} }) = HEADER typeId { b ; value_field nameIR_field ;*{nameIR_field <- nameIR_field*, value_field <- value_field*} } as value
  -- if typeIR <: headerTypeIR
  -- let HEADER typeId < _typeArgumentIR*{_typeArgumentIR <- _typeArgumentIR*} > { _fieldTypeIR*{_fieldTypeIR <- _fieldTypeIR*} } = typeIR as headerTypeIR
  -- if (typeId = typeId')

def $cast_enum(typeIR, enumValue) : value =

  clause 0 : (typeIR, enumValue) = typeId . nameIR as value
  -- if typeIR <: simpleEnumTypeIR
  -- let ENUM typeId { _nameIR*{_nameIR <- _nameIR*} } = typeIR as simpleEnumTypeIR
  -- if enumValue matches `% . %`
  -- let typeId' . nameIR = enumValue
  -- if (typeId = typeId')

  clause 1 : (typeIR, enumValue) = typeId . nameIR . value as value
  -- if typeIR <: serializableEnumTypeIR
  -- let ENUM typeId < _typeIR > { _valueFieldIR*{_valueFieldIR <- _valueFieldIR*} } = typeIR as serializableEnumTypeIR
  -- if enumValue matches `% . % . %`
  -- let typeId' . nameIR . value = enumValue
  -- if (typeId = typeId')

  clause 2 : (typeIR', enumValue) = SET { $cast_op(typeIR, enumValue as value) } as value
  -- if typeIR' <: setTypeIR
  -- let SET < typeIR > = typeIR' as setTypeIR

