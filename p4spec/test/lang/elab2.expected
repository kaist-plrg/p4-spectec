relation BlockElementStmtList_eval: evalContext arch |- blockElementStatementListIR : evalContext arch statementResult

  rulegroup 

    rule nil: EC ARCH |- [] : EC ARCH `EMPTY as statementResult

    rule cons-head-non-cont: EC_0 ARCH_0 |- blockElementStatementIR_h :: blockElementStatementIR_t*{blockElementStatementIR_t <- blockElementStatementIR_t*} : EC_1 ARCH_1 statementResult
