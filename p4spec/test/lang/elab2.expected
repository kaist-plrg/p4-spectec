syntax globalEvalLayer = globalInstLayer

syntax blockEvalLayer = blockInstLayer

syntax localEvalLayer = localInstLayer

syntax evalContext = {GLOBAL globalEvalLayer, BLOCK blockEvalLayer, LOCAL localEvalLayer}

var EC : evalContext

def $enter_e(evalContext) : evalContext =

  clause 0 : (EC) = EC[LOCAL.FRAMES = $empty_frame :: EC.LOCAL.FRAMES]

def $exit_e(evalContext) : evalContext =

  clause 0 : (EC) = EC[LOCAL.FRAMES = frame_t*{frame_t <- frame_t*}]
  -- let frame*{frame <- frame*} = EC.LOCAL.FRAMES
  -- if frame*{frame <- frame*} matches _ :: _
  -- let frame_h :: frame_t*{frame_t <- frame_t*} = frame*{frame <- frame*}

def $inherit_e(cursor, evalContext) : evalContext =

  clause 0 : (p, EC) = EC[BLOCK = blockEvalLayer][LOCAL = localEvalLayer]
  -- if p matches `GLOBAL`
  -- let blockEvalLayer = {TYPE $empty_theta, CALLABLE $empty_callableDefEnv, STATE $empty_stateEnv, FRAME $empty_frame}
  -- let localEvalLayer = {TYPE $empty_theta, FRAMES [$empty_frame]}

  clause 1 : (p, EC) = EC[LOCAL = localEvalLayer]
  -- if p matches `BLOCK`
  -- let localEvalLayer = {TYPE $empty_theta, FRAMES [$empty_frame]}

  clause 2 : (p, EC) = EC
  -- if p matches `LOCAL`

def $copy_e(cursor, evalContext, evalContext) : evalContext =

  clause 0 : (p, EC_from, EC_to) = EC_to[GLOBAL = EC_from.GLOBAL]
  -- if p matches `GLOBAL`

  clause 1 : (p, EC_from, EC_to) = EC_to[GLOBAL = EC_from.GLOBAL][BLOCK = EC_from.BLOCK]
  -- if p matches `BLOCK`

  clause 2 : (p, EC_from, EC_to) = EC_to[GLOBAL = EC_from.GLOBAL][BLOCK = EC_from.BLOCK][LOCAL = EC_from.LOCAL]
  -- if p matches `LOCAL`

