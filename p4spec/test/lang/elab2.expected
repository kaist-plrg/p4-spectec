def $lift_typeArgumentIR(typeArgumentIR) : typeArgument =

  clause 0 : (typeIR) = $lift_typeArgumentIR_as_realTypeArgument(typeIR) as typeArgument

def $lift_dataTypeIR(dataTypeIR) : type =

  clause 0 : (dataTypeIR) = LIST < typeArgument > as type
  -- if dataTypeIR <: listTypeIR
  -- let LIST < typeIR > = dataTypeIR as listTypeIR
  -- let typeArgument = $lift_typeArgumentIR(typeIR)

  clause 1 : (dataTypeIR) = TUPLE < typeArgumentList > as type
  -- if dataTypeIR <: tupleTypeIR
  -- let TUPLE < typeIR*{typeIR <- typeIR*} > = dataTypeIR as tupleTypeIR
  -- let typeArgumentList = $lift_typeArgumentListIR(typeIR*{typeIR <- typeIR*})

  clause 2 : (dataTypeIR) = namedType [ D n as int as expression ] as type
