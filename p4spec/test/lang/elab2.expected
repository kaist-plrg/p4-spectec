  -- let frame_h' = $update_map<id, value>(frame_h, id, value)

  clause 6 : (p, EC, prefixedNameIR, value) = EC_pop'[LOCAL.FRAMES = frame_h :: EC_pop'.LOCAL.FRAMES]
