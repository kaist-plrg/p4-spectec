  clause 7 : (typeDefIR) = (typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*}, typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*})
  -- if typeDefIR <: parserObjectTypeDefIR
