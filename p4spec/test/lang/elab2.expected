relation Block_eval: evalContext arch |- blockStatementIR : evalContext arch statementResult

  rulegroup 

    rule : EC_0 ARCH_0 |- annotationList { blockElementStatementListIR } : EC_1 ARCH_1 statementResult
    -- BlockElementStmtList_eval: EC_0 ARCH_0 |- blockElementStatementListIR : EC_1 ARCH_1 statementResult

syntax parserStatementResult = 
   | `EMPTY (from continueEmptyResult) 
   | REJECT errorValue (from rejectTransitionResult) 

relation ParserStmt_eval: evalContext arch |- parserStatementIR : evalContext arch parserStatementResult

  rulegroup emptyStatementIR

    rule emptyStatementIR: EC_0 ARCH_0 |- emptyStatementIR as parserStatementIR : EC_1 ARCH_1 `EMPTY as parserStatementResult
    -- Stmt_eval: LOCAL EC_0 ARCH_0 |- emptyStatementIR as statementIR : EC_1 ARCH_1 `EMPTY as statementResult

  rulegroup assignmentStatementIR

    rule reject: EC_0 ARCH_0 |- assignmentStatementIR as parserStatementIR : EC_1 ARCH_1 rejectTransitionResult as parserStatementResult
    -- Stmt_eval: LOCAL EC_0 ARCH_0 |- assignmentStatementIR as statementIR : EC_1 ARCH_1 rejectTransitionResult as statementResult

    rule cont: EC_0 ARCH_0 |- assignmentStatementIR as parserStatementIR : EC_1 ARCH_1 `EMPTY as parserStatementResult
    -- Stmt_eval: LOCAL EC_0 ARCH_0 |- assignmentStatementIR as statementIR : EC_1 ARCH_1 `EMPTY as statementResult

  rulegroup callStatementIR

    rule reject: EC_0 ARCH_0 |- callStatementIR as parserStatementIR : EC_1 ARCH_1 rejectTransitionResult as parserStatementResult
    -- Stmt_eval: LOCAL EC_0 ARCH_0 |- callStatementIR as statementIR : EC_1 ARCH_1 rejectTransitionResult as statementResult

    rule cont: EC_0 ARCH_0 |- callStatementIR as parserStatementIR : EC_1 ARCH_1 `EMPTY as parserStatementResult
    -- Stmt_eval: LOCAL EC_0 ARCH_0 |- callStatementIR as statementIR : EC_1 ARCH_1 `EMPTY as statementResult

  rulegroup parserBlockStatementIR

    rule parserBlockStatementIR: EC_0 ARCH_0 |- parserBlockStatementIR as parserStatementIR : EC_3 ARCH_1 parserStatementResult
    -- if (EC_1 = $enter_e(EC_0))
    -- ParserBlock_eval: EC_1 ARCH_0 |- parserBlockStatementIR : EC_2 ARCH_1 parserStatementResult
    -- if (EC_3 = $exit_e(EC_2))

  rulegroup parserConditionalStatementIR

    rule non-else-reject: EC ARCH |- IF ( typedExpressionIR_cond ) parserStatementIR_then as parserStatementIR : EC_cond ARCH_cond rejectTransitionResult as parserStatementResult
    -- Expr_eval: LOCAL EC ARCH |- typedExpressionIR_cond : EC_cond ARCH_cond rejectTransitionResult as expressionResult

    rule non-else-cont-true: EC ARCH |- IF ( typedExpressionIR_cond ) parserStatementIR_then as parserStatementIR : EC_then ARCH_then parserStatementResult
    -- Expr_eval: LOCAL EC ARCH |- typedExpressionIR_cond : EC_cond ARCH_cond ` `B true as value as expressionResult
    -- ParserStmt_eval: EC_cond ARCH_cond |- parserStatementIR_then : EC_then ARCH_then parserStatementResult

