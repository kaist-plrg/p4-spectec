  rulegroup callStatementIR

    rule callee-abort: p EC_0 ARCH_0 |- callableTargetIR < typeArgumentIR*{typeArgumentIR <- typeArgumentIR*} > ( argumentIR*{argumentIR <- argumentIR*} ) ; as statementIR : EC_1 ARCH_1 abortResult as statementResult
