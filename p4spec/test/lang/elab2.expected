def $join_tableEntryState(tableEntryState, tableEntryState) : tableEntryState =

  clause 0 : (TBLS, TBLS') = LPM n
  -- if TBLS matches `NON_LPM`
  -- if TBLS' matches `LPM %`
  -- let LPM n = TBLS'

  clause 1 : (TBLS, TBLS') = LPM n
  -- if TBLS matches `LPM %`
  -- let LPM n = TBLS
  -- if TBLS' matches `NON_LPM`

  clause 2 : (TBLS, TBLS') = NON_LPM
  -- if TBLS matches `NON_LPM`
  -- if TBLS' matches `NON_LPM`

def $tableEntry_lpm_prefix(value) : nat =

  clause 0 : (value) = $tableEntry_lpm_prefix'(value, 0)

