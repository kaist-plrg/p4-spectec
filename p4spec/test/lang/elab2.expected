relation Cast_expl: typeIR -> typeIR

  rulegroup 

    rule equals: typeIR_a -> typeIR_b
    -- if (typeIR_a_unroll = $unroll_typeIR(typeIR_a))
    -- if (typeIR_b_unroll = $unroll_typeIR(typeIR_b))
    -- if Type_alpha: typeIR_a_unroll ~~ typeIR_b_unroll holds

    rule not-equals: typeIR_a -> typeIR_b
    -- if (typeIR_a_unroll = $unroll_typeIR(typeIR_a))
    -- if (typeIR_b_unroll = $unroll_typeIR(typeIR_b))
    -- if Type_alpha: typeIR_a_unroll ~~ typeIR_b_unroll does not hold
    -- if Cast_expl_neq: typeIR_a_unroll -> typeIR_b_unroll holds

relation Cast_expl_neq: typeIR -> typeIR

  rulegroup boolean-fixBit

    rule boolean-fixBit: BOOL as typeIR -> BIT < 1 > as typeIR

  rulegroup arbitraryInt

    rule boolean: INT as typeIR -> BOOL as typeIR

    rule fixInt: INT as typeIR -> INT < _nat > as typeIR

    rule fixBit: INT as typeIR -> BIT < _nat > as typeIR

  rulegroup fixInt

    rule arbitraryInt: INT < _nat > as typeIR -> INT as typeIR

    rule fixInt: INT < w_a > as typeIR -> INT < w_b > as typeIR

    rule fixBit: INT < w > as typeIR -> BIT < w > as typeIR

  rulegroup fixBit

    rule boolean: BIT < 1 > as typeIR -> BOOL as typeIR

    rule arbitraryInt: BIT < _nat > as typeIR -> INT as typeIR

    rule fixInt: BIT < w > as typeIR -> INT < w > as typeIR

    rule fixBit: BIT < w_a > as typeIR -> BIT < w_b > as typeIR

  rulegroup newTypeIR

    rule left: TYPE _typeId typeIR_a as typeIR -> typeIR_b
    -- if Cast_impl: typeIR_a -> typeIR_b holds

    rule right: typeIR_a -> TYPE _typeId typeIR_b as typeIR
    -- if Cast_impl: typeIR_a -> typeIR_b holds

  rulegroup enumTypeIR-serializable

    rule left: ENUM _typeId < typeIR_a > { _valueFieldIR*{_valueFieldIR <- _valueFieldIR*} } as typeIR -> typeIR_b
    -- if Cast_impl: typeIR_a -> typeIR_b holds

    rule right: typeIR_a -> ENUM _typeId < typeIR_b > { _valueFieldIR*{_valueFieldIR <- _valueFieldIR*} } as typeIR
    -- if Cast_impl: typeIR_a -> typeIR_b holds

  rulegroup defaultTypeIR

    rule defaultTypeIR: DEFAULT as typeIR -> typeIR_b
    -- if $is_defaultable_typeIR(typeIR_b)

  rulegroup invalidHeaderTypeIR

    rule headerTypeIR: HEADER_INVALID as typeIR -> headerTypeIR as typeIR

    rule headerUnionTypeIR: HEADER_INVALID as typeIR -> headerUnionTypeIR as typeIR

  rulegroup sequenceTypeIR-non-default

    rule listTypeIR: SEQ < typeIR_a*{typeIR_a <- typeIR_a*} > as typeIR -> LIST < typeIR_b > as typeIR
    -- (if Cast_expl: typeIR_a -> typeIR_b holds)*{typeIR_a <- typeIR_a*}

    rule tupleTypeIR: SEQ < typeIR_a*{typeIR_a <- typeIR_a*} > as typeIR -> TUPLE < typeIR_b*{typeIR_b <- typeIR_b*} > as typeIR
    -- (if Cast_expl: typeIR_a -> typeIR_b holds)*{typeIR_a <- typeIR_a*, typeIR_b <- typeIR_b*}

