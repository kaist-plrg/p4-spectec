    rule cont-setValue: EC_0 ARCH_0 |- typedExpressionIR as simpleKeysetExpressionIR : EC_1 ARCH_1 ` setValue as simpleKeysetExpressionResult
    -- Expr_eval: LOCAL EC_0 ARCH_0 |- typedExpressionIR : EC_1 ARCH_1 ` setValue as value as expressionResult

    rule cont-objectReferenceValue: EC_0 ARCH_0 |- typedExpressionIR as simpleKeysetExpressionIR : EC_1 ARCH_1 ` setValue as simpleKeysetExpressionResult
    -- Expr_eval: LOCAL EC_0 ARCH_0 |- typedExpressionIR : EC_1 ARCH_1 ` REF objectId as value as expressionResult
    -- if (?(VALUE_SET { value*{value <- value*} ( n_size ) } as object) = $find_object_e(ARCH_1, objectId))
    -- if (setValue = SET { value*{value <- value*} ( n_size ) })

  rulegroup mask

    rule left-abort: EC_0 ARCH_0 |- typedExpressionIR_l &&& typedExpressionIR_r : EC_1 ARCH_1 abortResult as simpleKeysetExpressionResult
    -- Expr_eval: LOCAL EC_0 ARCH_0 |- typedExpressionIR_l : EC_1 ARCH_1 abortResult as expressionResult

    rule left-cont-right-abort: EC_0 ARCH_0 |- typedExpressionIR_l &&& typedExpressionIR_r : EC_2 ARCH_2 abortResult as simpleKeysetExpressionResult
    -- Expr_eval: LOCAL EC_0 ARCH_0 |- typedExpressionIR_l : EC_1 ARCH_1 ` value_l as expressionResult
    -- Expr_eval: LOCAL EC_1 ARCH_1 |- typedExpressionIR_r : EC_2 ARCH_2 abortResult as expressionResult

    rule left-cont-right-cont: EC_0 ARCH_0 |- typedExpressionIR_l &&& typedExpressionIR_r : EC_2 ARCH_2 ` setValue as simpleKeysetExpressionResult
    -- Expr_eval: LOCAL EC_0 ARCH_0 |- typedExpressionIR_l : EC_1 ARCH_1 ` value_l as expressionResult
    -- Expr_eval: LOCAL EC_1 ARCH_1 |- typedExpressionIR_r : EC_2 ARCH_2 ` value_r as expressionResult
    -- if (setValue = SET { value_l &&& value_r })

  rulegroup range

    rule left-abort: EC_0 ARCH_0 |- typedExpressionIR_l .. typedExpressionIR_r : EC_1 ARCH_1 abortResult as simpleKeysetExpressionResult
    -- Expr_eval: LOCAL EC_0 ARCH_0 |- typedExpressionIR_l : EC_1 ARCH_1 abortResult as expressionResult

    rule left-cont-right-abort: EC_0 ARCH_0 |- typedExpressionIR_l .. typedExpressionIR_r : EC_2 ARCH_2 abortResult as simpleKeysetExpressionResult
    -- Expr_eval: LOCAL EC_0 ARCH_0 |- typedExpressionIR_l : EC_1 ARCH_1 ` value_l as expressionResult
    -- Expr_eval: LOCAL EC_1 ARCH_1 |- typedExpressionIR_r : EC_2 ARCH_2 abortResult as expressionResult

    rule left-cont-right-cont: EC_0 ARCH_0 |- typedExpressionIR_l .. typedExpressionIR_r : EC_2 ARCH_2 ` setValue as simpleKeysetExpressionResult
    -- Expr_eval: LOCAL EC_0 ARCH_0 |- typedExpressionIR_l : EC_1 ARCH_1 ` value_l as expressionResult
    -- Expr_eval: LOCAL EC_1 ARCH_1 |- typedExpressionIR_r : EC_2 ARCH_2 ` value_r as expressionResult
    -- if (setValue = SET { value_l .. value_r })

  rulegroup default-any

    rule default-any: EC ARCH |- simpleKeysetExpressionIR : EC ARCH ` setValue as simpleKeysetExpressionResult
    -- if ((simpleKeysetExpressionIR = DEFAULT) \/ (simpleKeysetExpressionIR = _))
    -- if (setValue = SET { ... })

