    rule cons-head-cont-tail-abort: p EC_0 ARCH_0 |- typedExpressionIR_h :: typedExpressionIR_t*{typedExpressionIR_t <- typedExpressionIR_t*} : EC_2 ARCH_2 abortResult as expressionListResult
