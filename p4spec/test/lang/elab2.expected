def $lift_instantiationIR(instantiationIR) : instantiation =

  clause 0 : (annotationList typeIR constructorTargetIR ( argumentIR*{argumentIR <- argumentIR*} ) nameIR objectInitializerIR?{objectInitializerIR <- objectInitializerIR?} ;) = annotationList type ( argumentList ) name ;
  -- if objectInitializerIR?{objectInitializerIR <- objectInitializerIR?} matches ()
  -- let prefixedNameIR < typeArgumentIR*{typeArgumentIR <- typeArgumentIR*} > = constructorTargetIR
  -- if typeArgumentIR*{typeArgumentIR <- typeArgumentIR*} matches []
  -- let prefixedTypeName = $lift_prefixedNameIR_as_prefixedTypeName(prefixedNameIR)
  -- let type = prefixedTypeName as type
  -- let argumentList = $lift_argumentListIR(argumentIR*{argumentIR <- argumentIR*})
  -- let name = $lift_nameIR_as_nonTypeName(nameIR) as name

  clause 1 : (annotationList typeIR constructorTargetIR ( argumentIR*{argumentIR <- argumentIR*} ) nameIR objectInitializerIR?{objectInitializerIR <- objectInitializerIR?} ;) = annotationList type ( argumentList ) name ;
  -- if objectInitializerIR?{objectInitializerIR <- objectInitializerIR?} matches ()
  -- let prefixedNameIR < typeArgumentIR*{typeArgumentIR <- typeArgumentIR*} > = constructorTargetIR
  -- if (|typeArgumentIR*{typeArgumentIR <- typeArgumentIR*}| > 0)
  -- let prefixedTypeName = $lift_prefixedNameIR_as_prefixedTypeName(prefixedNameIR)
  -- let typeArgumentList = $lift_typeArgumentListIR(typeArgumentIR*{typeArgumentIR <- typeArgumentIR*})
  -- let type = prefixedTypeName < typeArgumentList > as type
  -- let argumentList = $lift_argumentListIR(argumentIR*{argumentIR <- argumentIR*})
  -- let name = $lift_nameIR_as_nonTypeName(nameIR) as name

  clause 2 : (annotationList typeIR constructorTargetIR ( argumentIR*{argumentIR <- argumentIR*} ) nameIR objectInitializerOptIR ;) = annotationList type ( argumentList ) name = { objectDeclarationList } ;
  -- if objectInitializerOptIR matches (_)
  -- let ?(= { objectDeclarationIR*{objectDeclarationIR <- objectDeclarationIR*} }) = objectInitializerOptIR
  -- let prefixedNameIR < typeArgumentIR*{typeArgumentIR <- typeArgumentIR*} > = constructorTargetIR
  -- if typeArgumentIR*{typeArgumentIR <- typeArgumentIR*} matches []
  -- let prefixedTypeName = $lift_prefixedNameIR_as_prefixedTypeName(prefixedNameIR)
  -- let type = prefixedTypeName as type
  -- let argumentList = $lift_argumentListIR(argumentIR*{argumentIR <- argumentIR*})
  -- let name = $lift_nameIR_as_nonTypeName(nameIR) as name
  -- let objectDeclarationList = $lift_objectDeclarationListIR(objectDeclarationIR*{objectDeclarationIR <- objectDeclarationIR*})

  clause 3 : (annotationList typeIR constructorTargetIR ( argumentIR*{argumentIR <- argumentIR*} ) nameIR objectInitializerOptIR ;) = annotationList type ( argumentList ) name = { objectDeclarationList } ;
  -- if objectInitializerOptIR matches (_)
  -- let ?(= { objectDeclarationIR*{objectDeclarationIR <- objectDeclarationIR*} }) = objectInitializerOptIR
  -- let prefixedNameIR < typeArgumentIR*{typeArgumentIR <- typeArgumentIR*} > = constructorTargetIR
  -- if (|typeArgumentIR*{typeArgumentIR <- typeArgumentIR*}| > 0)
  -- let prefixedTypeName = $lift_prefixedNameIR_as_prefixedTypeName(prefixedNameIR)
  -- if (typeArgumentIR*{typeArgumentIR <- typeArgumentIR*} =/= [])
  -- let typeArgumentList = $lift_typeArgumentListIR(typeArgumentIR*{typeArgumentIR <- typeArgumentIR*})
  -- let type = prefixedTypeName < typeArgumentList > as type
  -- let argumentList = $lift_argumentListIR(argumentIR*{argumentIR <- argumentIR*})
  -- let name = $lift_nameIR_as_nonTypeName(nameIR) as name
  -- let objectDeclarationList = $lift_objectDeclarationListIR(objectDeclarationIR*{objectDeclarationIR <- objectDeclarationIR*})

def $unflatten_objectDeclarationList(objectDeclaration*) : objectDeclarationList =

  clause 0 : (objectDeclaration*{objectDeclaration <- objectDeclaration*}) = $unflatten_objectDeclarationList'(`EMPTY, objectDeclaration*{objectDeclaration <- objectDeclaration*})

