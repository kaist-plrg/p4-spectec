def $is_static_callableTypeIR(callableTypeIR) : ctk =

  clause 0 : (callableTypeIR) = LCTK
  -- if callableTypeIR <: externFunctionTypeIR
  -- let EXTERN_FUNCTION t ( _parameterIR*{_parameterIR <- _parameterIR*} ) : _typeIR = callableTypeIR as externFunctionTypeIR
  -- if (t = "static_assert")

  clause 1 : (callableTypeIR) = LCTK
  -- if callableTypeIR <: builtinMethodTypeIR
  -- let BUILTIN_METHOD nameIR ( _parameterIR*{_parameterIR <- _parameterIR*} ) : _typeIR = callableTypeIR as builtinMethodTypeIR
  -- if nameIR <- ["minSizeInBits", "minSizeInBytes", "maxSizeInBits", "maxSizeInBytes"]

  clause -1 : (_callableTypeIR) = DYN

def $is_static_assert_callableTypeIR(callableTypeIR) : bool =

  clause 0 : (callableTypeIR) = true
  -- if callableTypeIR <: externFunctionTypeIR
  -- let EXTERN_FUNCTION t ( _parameterIR*{_parameterIR <- _parameterIR*} ) : _typeIR = callableTypeIR as externFunctionTypeIR
  -- if (t = "static_assert")

  clause -1 : (_callableTypeIR) = false

