  clause 1 : (parameter*{parameter <- parameter*}) = $unflatten_nonEmptyParameterList(parameter_h :: parameter_t*{parameter_t <- parameter_t*}) as parameterList
  -- if parameter*{parameter <- parameter*} matches _ :: _
  -- let parameter_h :: parameter_t*{parameter_t <- parameter_t*} = parameter*{parameter <- parameter*}

def $unflatten_nonEmptyParameterList(parameter*) : nonEmptyParameterList =

