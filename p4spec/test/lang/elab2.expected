  -- let typeIR [ n ] = dataTypeIR as headerStackTypeIR
  -- let type = $lift_typeIR(typeIR)
  -- if type <: namedType
  -- let namedType = type as namedType

  clause 3 : (dataTypeIR) = typeName as type
  -- if dataTypeIR <: simpleEnumTypeIR
  -- let ENUM typeId { _nameIR*{_nameIR <- _nameIR*} } = dataTypeIR as simpleEnumTypeIR
  -- let typeName = $lift_nameIR_as_typeName(typeId)

  clause 4 : (dataTypeIR) = typeName as prefixedTypeName < typeArgument as typeArgumentList > as type
