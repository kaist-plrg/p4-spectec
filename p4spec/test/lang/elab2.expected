  clause 5 : (p, EC, prefixedNameIR, argumentIR*{argumentIR <- argumentIR*}) = $find_callableDef_overloaded_e(GLOBAL, EC, ` nameIR, argumentIR*{argumentIR <- argumentIR*})
  -- if p matches `BLOCK`
