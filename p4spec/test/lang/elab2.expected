    -- Exprs_eval: p EC_1 ARCH_1 |- typedExpressionIR_t*{typedExpressionIR_t <- typedExpressionIR_t*} : EC_2 ARCH_2 abortResult as expressionListResult

    rule cons-head-cont-tail-cont: p EC_0 ARCH_0 |- typedExpressionIR_h :: typedExpressionIR_t*{typedExpressionIR_t <- typedExpressionIR_t*} : EC_2 ARCH_2 ` value_h :: value_t*{value_t <- value_t*} as expressionListResult
    -- Expr_eval: p EC_0 ARCH_0 |- typedExpressionIR_h : EC_1 ARCH_1 ` value_h as expressionResult
    -- Exprs_eval: p EC_1 ARCH_1 |- typedExpressionIR_t*{typedExpressionIR_t <- typedExpressionIR_t*} : EC_2 ARCH_2 ` value_t*{value_t <- value_t*} as expressionListResult

