  rulegroup forStatementIR-three-clause

    rule init-abort: LOCAL EC_0 ARCH_0 |- annotationList FOR ( forInitStatementListIR ; typedExpressionIR ; forUpdateStatementListIR ) statementIR as statementIR : EC_3 ARCH_1 abortResult as statementResult
    -- if (EC_1 = $enter_e(EC_0))
    -- ForInitStmts_eval: EC_1 ARCH_0 |- forInitStatementListIR : EC_2 ARCH_1 abortResult as statementResult
    -- if (EC_3 = $exit_e(EC_2))

    rule init-cont: LOCAL EC_0 ARCH_0 |- annotationList FOR ( forInitStatementListIR ; typedExpressionIR ; forUpdateStatementListIR ) statementIR as statementIR : EC_4 ARCH_2 statementResult
    -- if (EC_1 = $enter_e(EC_0))
