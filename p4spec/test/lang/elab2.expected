  -- let ?(parameterIR_match) = parameterIR''?{parameterIR'' <- parameterIR''?}
  -- let parameterIR_aligned*{parameterIR_aligned <- parameterIR_aligned*} = $align_parameterListIR_given({ id : parameterIR*{id <- id*, parameterIR <- parameterIR*} }, parameterIR_t*{parameterIR_t <- parameterIR_t*}, argumentIR_t*{argumentIR_t <- argumentIR_t*})

  clause 4 : ({ id : parameterIR*{id <- id*, parameterIR <- parameterIR*} }, parameterIR'*{parameterIR' <- parameterIR'*}, argumentIR*{argumentIR <- argumentIR*}) = parameterIR_match :: parameterIR_aligned*{parameterIR_aligned <- parameterIR_aligned*}
  -- if parameterIR'*{parameterIR' <- parameterIR'*} matches _ :: _
  -- let parameterIR_h :: parameterIR_t*{parameterIR_t <- parameterIR_t*} = parameterIR'*{parameterIR' <- parameterIR'*}
  -- if argumentIR*{argumentIR <- argumentIR*} matches _ :: _
  -- let argumentIR_h :: argumentIR_t*{argumentIR_t <- argumentIR_t*} = argumentIR*{argumentIR <- argumentIR*}
  -- let argumentIR' = argumentIR_h
  -- if argumentIR' matches `% = _`
  -- let nameIR = _ = argumentIR'
  -- let parameterIR''?{parameterIR'' <- parameterIR''?} = $find_map<id, parameterIR>({ id : parameterIR*{id <- id*, parameterIR <- parameterIR*} }, nameIR)
  -- if parameterIR''?{parameterIR'' <- parameterIR''?} matches (_)
  -- let ?(parameterIR_match) = parameterIR''?{parameterIR'' <- parameterIR''?}
  -- let parameterIR_aligned*{parameterIR_aligned <- parameterIR_aligned*} = $align_parameterListIR_given({ id : parameterIR*{id <- id*, parameterIR <- parameterIR*} }, parameterIR_t*{parameterIR_t <- parameterIR_t*}, argumentIR_t*{argumentIR_t <- argumentIR_t*})

syntax callTargetKey = 
   | nameIR ( id?* ) (from callTargetKey) 

syntax namedCallTargetKey = 
   | nameIR ( id* ) (from namedCallTargetKey) 

syntax unnamedCallTargetKey = 
   | nameIR ( nat ) (from unnamedCallTargetKey) 

syntax callTargetParameter = 
   | nameIR # bool # bool (from callTargetParameter) 

syntax callTargetValue = callTargetParameter*

syntax callTargetMatch = 
   | MATCH id* id* (from callTargetMatch)  hint(prose MATCH "with defaults" %0 and "optionals" %1)
   | NOMATCH (from callTargetMatch) 

syntax callResolution<V> = 
   | callableId : V # nameIR* # nameIR* (from callResolution<V>)  hint(prose_fields "call target id" "call target" "defaults" "optionals")

def $callTargetKey(nameIR, argumentListIR) : callTargetKey =

  clause 0 : (nameIR_f, argumentIR*{argumentIR <- argumentIR*}) = nameIR_f ( id_arg?{id_arg <- id_arg?}*{id_arg? <- id_arg?*} )
  -- (let id_arg?{id_arg <- id_arg?} = $callTargetKey'(argumentIR))*{argumentIR <- argumentIR*, id_arg? -> id_arg?*}

def $callTargetKey'(argumentIR) : id? =

  clause 0 : (argumentIR) = ?()
  -- if argumentIR <: typedExpressionIR
  -- let typedExpressionIR = argumentIR as typedExpressionIR

  clause 1 : (argumentIR) = ?(id_arg)
  -- if argumentIR matches `% = %`
  -- let id_arg = _typedExpressionIR = argumentIR

  clause 2 : (argumentIR) = ?(id_arg)
  -- if argumentIR matches `% = _`
  -- let id_arg = _ = argumentIR

  clause 3 : (argumentIR) = ?()
  -- if argumentIR matches `_`

def $match_overloaded_named<V>(pair<callTargetId, V>, namedCallTargetKey, $get_parameterListIR(V) : parameterListIR) : callTargetMatch =

  clause 0 : (callTargetId : V, nameIR_f ( id_arg*{id_arg <- id_arg*} ), $get_parameterListIR) = $ite<callTargetMatch>($eq_set<id>({ id_param*{id_param <- id_param*} }, { id_arg*{id_arg <- id_arg*} }), MATCH [] [], NOMATCH)
  -- let nameIR ( id_param*{id_param <- id_param*} ) = callTargetId
  -- if (nameIR = nameIR_f)
  -- let parameterIR*{parameterIR <- parameterIR*} = $get_parameterListIR(V)
  -- (if (id_param = $id_of_parameterIR(parameterIR)))*{id_param <- id_param*, parameterIR <- parameterIR*}
  -- if (|id_param*{id_param <- id_param*}| = |id_arg*{id_arg <- id_arg*}|)

  clause 1 : (callTargetId : V, nameIR_f ( id_arg*{id_arg <- id_arg*} ), $get_parameterListIR) = MATCH id_default*{id_default <- id_default*} id_optional*{id_optional <- id_optional*}
  -- let nameIR ( id_param*{id_param <- id_param*} ) = callTargetId
  -- if (nameIR = nameIR_f)
  -- let parameterIR*{parameterIR <- parameterIR*} = $get_parameterListIR(V)
