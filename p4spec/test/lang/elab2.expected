  -- let ENUM typeId < typeIR > { _valueFieldIR*{_valueFieldIR <- _valueFieldIR*} } = dataTypeIR as serializableEnumTypeIR
  -- let typeName = $lift_nameIR_as_typeName(typeId)
  -- let typeArgument = $lift_typeArgumentIR(typeIR)

def $lift_typeIR_as_typeOrVoid(typeIR) : typeOrVoid =

  clause 0 : (typeIR) = VOID
  -- if typeIR <: voidTypeIR
  -- let voidTypeIR = typeIR as voidTypeIR
  -- if (voidTypeIR = VOID)

  clause 1 : (typeIR) = $lift_typeIR(typeIR) as typeOrVoid
