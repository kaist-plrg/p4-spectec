  -- let expressionList = $lift_typedExpressionListIR(typedExpressionIR*{typedExpressionIR <- typedExpressionIR*})

  clause 3 : (dataExpressionIR) = { recordElementExpression as sequenceOrRecordElementExpression `EMPTY } as dataExpression
  -- if dataExpressionIR <: recordExpressionIR
  -- let recordExpressionIR = dataExpressionIR as recordExpressionIR
  -- if recordExpressionIR matches `RECORD {%}`
  -- let RECORD { namedExpressionIR*{namedExpressionIR <- namedExpressionIR*} } = recordExpressionIR
  -- (let namedExpression = $lift_namedExpressionIR(namedExpressionIR))*{namedExpressionIR <- namedExpressionIR*, namedExpression -> namedExpression*}
  -- let recordElementExpression = $unflatten_recordElementExpression(namedExpression*{namedExpression <- namedExpression*})

  clause 4 : (dataExpressionIR) = { recordElementExpression as sequenceOrRecordElementExpression `EMPTY } as dataExpression
  -- if dataExpressionIR <: recordExpressionIR
  -- let recordExpressionIR = dataExpressionIR as recordExpressionIR
  -- if recordExpressionIR matches `RECORD {% , ...}`
  -- let RECORD { namedExpressionIR*{namedExpressionIR <- namedExpressionIR*} , ... } = recordExpressionIR
  -- (let namedExpression = $lift_namedExpressionIR(namedExpressionIR))*{namedExpressionIR <- namedExpressionIR*, namedExpression -> namedExpression*}
  -- let recordElementExpression = $unflatten_recordElementExpression_with_default(namedExpression*{namedExpression <- namedExpression*})

def $lift_errorAccessExpressionIR(errorAccessExpressionIR) : errorAccessExpression =

  clause 0 : (ERROR . nameIR) = ERROR . member
  -- let member = $lift_nameIR_as_member(nameIR)

def $lift_memberAccessBaseIR(memberAccessBaseIR) : memberAccessBase =

  clause 0 : (memberAccessBaseIR) = $lift_prefixedNameIR_as_prefixedTypeName(prefixedNameIR) as memberAccessBase
  -- if memberAccessBaseIR matches `TYPE %`
  -- let TYPE prefixedNameIR = memberAccessBaseIR

  clause 1 : (memberAccessBaseIR) = $lift_typedExpressionIR(typedExpressionIR) as memberAccessBase
  -- if memberAccessBaseIR <: typedExpressionIR
  -- let typedExpressionIR = memberAccessBaseIR as typedExpressionIR

def $lift_memberAccessExpressionIR(memberAccessExpressionIR) : memberAccessExpression =

  clause 0 : (memberAccessBaseIR . nameIR) = memberAccessBase . member
  -- let memberAccessBase = $lift_memberAccessBaseIR(memberAccessBaseIR)
  -- let member = $lift_nameIR_as_member(nameIR)

def $lift_indexAccessExpressionIR(indexAccessExpressionIR) : indexAccessExpression =

  clause 0 : (typedExpressionIR_base [ typedExpressionIR_index ]) = expression_base [ expression_index ]
  -- let expression_base = $lift_typedExpressionIR(typedExpressionIR_base)
  -- let expression_index = $lift_typedExpressionIR(typedExpressionIR_index)

def $lift_sliceAccessExpressionIR(sliceAccessExpressionIR) : sliceAccessExpression =

  clause 0 : (typedExpressionIR_base [ typedExpressionIR_hi sliceop typedExpressionIR_lo ]) = expression_base [ expression_hi : expression_lo ]
  -- if sliceop matches `:`
  -- let expression_base = $lift_typedExpressionIR(typedExpressionIR_base)
  -- let expression_hi = $lift_typedExpressionIR(typedExpressionIR_hi)
  -- let expression_lo = $lift_typedExpressionIR(typedExpressionIR_lo)

def $lift_accessExpressionIR(accessExpressionIR) : accessExpression =

  clause 0 : (accessExpressionIR) = $lift_errorAccessExpressionIR(errorAccessExpressionIR) as accessExpression
  -- if accessExpressionIR <: errorAccessExpressionIR
  -- let errorAccessExpressionIR = accessExpressionIR as errorAccessExpressionIR

  clause 1 : (accessExpressionIR) = $lift_memberAccessExpressionIR(memberAccessExpressionIR) as accessExpression
  -- if accessExpressionIR <: memberAccessExpressionIR
  -- let memberAccessExpressionIR = accessExpressionIR as memberAccessExpressionIR

  clause 2 : (accessExpressionIR) = $lift_indexAccessExpressionIR(indexAccessExpressionIR) as accessExpression
  -- if accessExpressionIR <: indexAccessExpressionIR
  -- let indexAccessExpressionIR = accessExpressionIR as indexAccessExpressionIR

  clause 3 : (accessExpressionIR) = $lift_sliceAccessExpressionIR(sliceAccessExpressionIR) as accessExpression
  -- if accessExpressionIR <: sliceAccessExpressionIR
  -- let sliceAccessExpressionIR = accessExpressionIR as sliceAccessExpressionIR

