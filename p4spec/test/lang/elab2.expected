    rule dontcare: p TC |- _ as typeArgument : ` typeId_impl as typeIR # [typeId_impl]
    -- if (typeId_impl = $fresh_typeId)

    rule nonTypeName: p TC |- nonTypeName as typeArgument : ` typeId as typeIR # []
