def $subst_externMethodTypeDefEnv(externMethodTypeDefEnv, externMethodTypeDefEnv) : externMethodTypeDefEnv =

  clause 0 : (externMethodTypeDefEnv_extern, set<pair<callableId, externMethodTypeDefIR>>) = externMethodTypeDefEnv_extern
  -- if (set<pair<callableId, externMethodTypeDefIR>> = { [] })

  clause 1 : (externMethodTypeDefEnv_extern, { pair<callableId, externMethodTypeDefIR>*{pair<callableId, externMethodTypeDefIR> <- pair<callableId, externMethodTypeDefIR>*} }) = $subst_externMethodTypeDefEnv(externMethodTypeDefEnv_extern_subst, { callableId_init_t : externMethodTypeDefIR_init_t*{callableId_init_t <- callableId_init_t*, externMethodTypeDefIR_init_t <- externMethodTypeDefIR_init_t*} })
  -- if pair<callableId, externMethodTypeDefIR>*{pair<callableId, externMethodTypeDefIR> <- pair<callableId, externMethodTypeDefIR>*} matches _ :: _
  -- let callableId_init_h : externMethodTypeDefIR_init_h :: callableId_init_t : externMethodTypeDefIR_init_t*{callableId_init_t <- callableId_init_t*, externMethodTypeDefIR_init_t <- externMethodTypeDefIR_init_t*} = pair<callableId, externMethodTypeDefIR>*{pair<callableId, externMethodTypeDefIR> <- pair<callableId, externMethodTypeDefIR>*}
  -- let nameIR_init_h ( _id*{_id <- _id*} ) = callableId_init_h
  -- let (callableId, externMethodTypeDefIR)?{(callableId, externMethodTypeDefIR) <- (callableId, externMethodTypeDefIR)?} = $find_non_overloaded<externMethodTypeDefIR>(externMethodTypeDefEnv_extern, nameIR_init_h)
  -- if (callableId, externMethodTypeDefIR)?{(callableId, externMethodTypeDefIR) <- (callableId, externMethodTypeDefIR)?} matches (_)
  -- let ?((callableId, externMethodTypeDefIR_abstract)) = (callableId, externMethodTypeDefIR)?{(callableId, externMethodTypeDefIR) <- (callableId, externMethodTypeDefIR)?}
  -- let externMethodTypeDefIR = externMethodTypeDefIR_abstract
  -- if externMethodTypeDefIR matches `EXTERN_METHOD ABSTRACT % <% , %> (%) : %`
  -- let EXTERN_METHOD ABSTRACT nameIR < typeId_expl*{typeId_expl <- typeId_expl*} , typeId_impl*{typeId_impl <- typeId_impl*} > ( parameterIR*{parameterIR <- parameterIR*} ) : typeIR_ret = externMethodTypeDefIR
  -- let externMethodTypeDefIR_concrete = EXTERN_METHOD nameIR < typeId_expl*{typeId_expl <- typeId_expl*} , typeId_impl*{typeId_impl <- typeId_impl*} > ( parameterIR*{parameterIR <- parameterIR*} ) : typeIR_ret
  -- if ExternMethodTypeDef_alpha: externMethodTypeDefIR_concrete ~~ externMethodTypeDefIR_init_h holds
  -- let externMethodTypeDefEnv_extern_subst = $update_map<callableId, externMethodTypeDefIR>(externMethodTypeDefEnv_extern, callableId, externMethodTypeDefIR_concrete)

