  -- let typeParameterIR*{typeParameterIR <- typeParameterIR*} = typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*} ++ typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*}
  -- let typeParameterListOpt = $lift_typeParameterListIR(typeParameterIR*{typeParameterIR <- typeParameterIR*})
  -- let parameterList = $lift_parameterListIR(parameterIR*{parameterIR <- parameterIR*})
  -- let constructorParameterListOpt = $lift_constructorParameterListIR(constructorParameterIR*{constructorParameterIR <- constructorParameterIR*})
  -- let controlLocalDeclarationList = $lift_controlLocalDeclarationListIR(controlLocalDeclarationIR*{controlLocalDeclarationIR <- controlLocalDeclarationIR*})
  -- let controlBody = $lift_controlBodyIR(controlBodyIR)

def $lift_packageTypeDeclarationIR(packageTypeDeclarationIR) : packageTypeDeclaration =

  clause 0 : (annotationList PACKAGE nameIR < typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*} , typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*} > ( parameterIR*{parameterIR <- parameterIR*} ) ;) = annotationList PACKAGE name typeParameterListOpt ( parameterList ) ;
  -- let name = $lift_nameIR_as_nonTypeName(nameIR) as name
  -- let typeParameterIR*{typeParameterIR <- typeParameterIR*} = typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*} ++ typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*}
  -- let typeParameterListOpt = $lift_typeParameterListIR(typeParameterIR*{typeParameterIR <- typeParameterIR*})
  -- let parameterList = $lift_parameterListIR(parameterIR*{parameterIR <- parameterIR*})

def $lift_typeDeclarationIR(typeDeclarationIR) : typeDeclaration =

  clause 0 : (typeDeclarationIR) = $lift_derivedTypeDeclarationIR(derivedTypeDeclarationIR) as typeDeclaration
  -- if typeDeclarationIR <: derivedTypeDeclarationIR
  -- let derivedTypeDeclarationIR = typeDeclarationIR as derivedTypeDeclarationIR

  clause 1 : (typeDeclarationIR) = $lift_typedefDeclarationIR(typedefDeclarationIR) as typeDeclaration
  -- if typeDeclarationIR <: typedefDeclarationIR
  -- let typedefDeclarationIR = typeDeclarationIR as typedefDeclarationIR

  clause 2 : (typeDeclarationIR) = $lift_parserTypeDeclarationIR(parserTypeDeclarationIR) as typeDeclaration
  -- if typeDeclarationIR <: parserTypeDeclarationIR
  -- let parserTypeDeclarationIR = typeDeclarationIR as parserTypeDeclarationIR

  clause 3 : (typeDeclarationIR) = $lift_controlTypeDeclarationIR(controlTypeDeclarationIR) as typeDeclaration
  -- if typeDeclarationIR <: controlTypeDeclarationIR
  -- let controlTypeDeclarationIR = typeDeclarationIR as controlTypeDeclarationIR

  clause 4 : (typeDeclarationIR) = $lift_packageTypeDeclarationIR(packageTypeDeclarationIR) as typeDeclaration
  -- if typeDeclarationIR <: packageTypeDeclarationIR
  -- let packageTypeDeclarationIR = typeDeclarationIR as packageTypeDeclarationIR

def $lift_declarationIR(declarationIR) : declaration =

  clause 0 : (declarationIR) = $lift_constantDeclarationIR(constantDeclarationIR) as declaration
  -- if declarationIR <: constantDeclarationIR
  -- let constantDeclarationIR = declarationIR as constantDeclarationIR

  clause 1 : (declarationIR) = $lift_instantiationIR(instantiationIR) as declaration
  -- if declarationIR <: instantiationIR
  -- let instantiationIR = declarationIR as instantiationIR

  clause 2 : (declarationIR) = $lift_functionDeclarationIR(functionDeclarationIR) as declaration
  -- if declarationIR <: functionDeclarationIR
  -- let functionDeclarationIR = declarationIR as functionDeclarationIR

  clause 3 : (declarationIR) = $lift_actionDeclarationIR(actionDeclarationIR) as declaration
  -- if declarationIR <: actionDeclarationIR
  -- let actionDeclarationIR = declarationIR as actionDeclarationIR

  clause 4 : (declarationIR) = $lift_errorDeclarationIR(errorDeclarationIR) as declaration
  -- if declarationIR <: errorDeclarationIR
  -- let errorDeclarationIR = declarationIR as errorDeclarationIR

  clause 5 : (declarationIR) = $lift_matchKindDeclarationIR(matchKindDeclarationIR) as declaration
  -- if declarationIR <: matchKindDeclarationIR
  -- let matchKindDeclarationIR = declarationIR as matchKindDeclarationIR

  clause 6 : (declarationIR) = $lift_externDeclarationIR(externDeclarationIR) as declaration
  -- if declarationIR <: externDeclarationIR
  -- let externDeclarationIR = declarationIR as externDeclarationIR

  clause 7 : (declarationIR) = $lift_parserDeclarationIR(parserDeclarationIR) as declaration
  -- if declarationIR <: parserDeclarationIR
  -- let parserDeclarationIR = declarationIR as parserDeclarationIR

  clause 8 : (declarationIR) = $lift_controlDeclarationIR(controlDeclarationIR) as declaration
  -- if declarationIR <: controlDeclarationIR
  -- let controlDeclarationIR = declarationIR as controlDeclarationIR

  clause 9 : (declarationIR) = $lift_typeDeclarationIR(typeDeclarationIR) as declaration
  -- if declarationIR <: typeDeclarationIR
  -- let typeDeclarationIR = declarationIR as typeDeclarationIR

  clause -1 : (declarationIR) = $sink<declaration>
  -- debug declarationIR

def $lift_p4programIR(p4programIR) : p4program =

  clause 0 : (declarationIR*{declarationIR <- declarationIR*} ;) = $unflatten_p4program(declaration*{declaration <- declaration*})
  -- (let declaration = $lift_declarationIR(declarationIR))*{declarationIR <- declarationIR*, declaration -> declaration*}

def $unflatten_p4program(declaration*) : p4program =

  clause 0 : (declaration*{declaration <- declaration*}) = $unflatten_p4program'(`EMPTY, declaration*{declaration <- declaration*})

def $unflatten_p4program'(p4program, declaration*) : p4program =

  clause 0 : (p4program, declaration*{declaration <- declaration*}) = p4program
  -- if declaration*{declaration <- declaration*} matches []

  clause 1 : (p4program, declaration*{declaration <- declaration*}) = $unflatten_p4program'(p4program declaration_h, declaration_t*{declaration_t <- declaration_t*})
  -- if declaration*{declaration <- declaration*} matches _ :: _
  -- let declaration_h :: declaration_t*{declaration_t <- declaration_t*} = declaration*{declaration <- declaration*}

syntax flow = 
   | CONT (from flow) 
   | RET (from flow) 

var f : flow

def $join_flow(flow, flow) : flow =

  clause 0 : (f, f') = RET
  -- if f matches `RET`
  -- if f' matches `RET`

  clause -1 : (f_a, f_b) = CONT

syntax loop = 
   | IN (from loop) 
   | OUT (from loop) 

var l : loop

syntax varTypeIR = 
   | direction typeIR ctk value? (from varTypeIR)  hint(prose_fields "direction" "type" "compile-time known-ness" "default value")

syntax typeFrame = map<id, varTypeIR>

def $empty_typeFrame : typeFrame =

  clause 0 :  = $empty_map<id, varTypeIR>

syntax typeDefEnv = map<typeId, typeDefIR>

def $empty_typeDefEnv : typeDefEnv =

  clause 0 :  = $empty_map<typeId, typeDefIR>

syntax callableTypeDefEnv = map<callableId, callableTypeDefIR>

def $empty_callableTypeDefEnv : callableTypeDefEnv =

  clause 0 :  = $empty_map<callableId, callableTypeDefIR>

syntax constructorTypeDefEnv = map<constructorId, constructorTypeDefIR>

def $empty_constructorTypeDefEnv : constructorTypeDefEnv =

  clause 0 :  = $empty_map<constructorId, constructorTypeDefIR>

syntax globalTypingLayer = {CONSTRUCTOR constructorTypeDefEnv, TYPE typeDefEnv, CALLABLE callableTypeDefEnv, FRAME typeFrame}

syntax blockKind = 
   | `EMPTY (from blockKind) 
   | EXTERN (from blockKind) 
   | PARSER (from blockKind) 
   | CONTROL (from blockKind) 
   | PACKAGE (from blockKind) 

syntax blockTypingLayer = {KIND blockKind, TYPE typeDefEnv, CALLABLE callableTypeDefEnv, FRAME typeFrame}

syntax actionLocalKind = 
   | ACTION (from actionLocalKind) 

syntax definedFunctionLocalKind = 
   | FUNCTION : typeIR (from definedFunctionLocalKind) 

syntax externFunctionLocalKind = 
   | EXTERN_FUNCTION : typeIR (from externFunctionLocalKind) 

syntax functionLocalKind = 
   | FUNCTION : typeIR (from definedFunctionLocalKind) 
   | EXTERN_FUNCTION : typeIR (from externFunctionLocalKind) 

syntax externMethodLocalKind = 
   | EXTERN_METHOD : typeIR (from externMethodLocalKind) 
   | EXTERN_METHOD ABSTRACT : typeIR (from externMethodLocalKind) 

syntax methodLocalKind = 
   | EXTERN_METHOD : typeIR (from externMethodLocalKind) 
   | EXTERN_METHOD ABSTRACT : typeIR (from externMethodLocalKind) 
   | PARSER_STATE (from methodLocalKind) 
   | CONTROL_APPLY_METHOD (from methodLocalKind) 
   | TABLE_APPLY_METHOD (from methodLocalKind) 

syntax localKind = 
   | `EMPTY (from localKind) 
   | ACTION (from actionLocalKind) 
   | FUNCTION : typeIR (from definedFunctionLocalKind) 
   | EXTERN_FUNCTION : typeIR (from externFunctionLocalKind) 
   | EXTERN_METHOD : typeIR (from externMethodLocalKind) 
   | EXTERN_METHOD ABSTRACT : typeIR (from externMethodLocalKind) 
   | PARSER_STATE (from methodLocalKind) 
   | CONTROL_APPLY_METHOD (from methodLocalKind) 
   | TABLE_APPLY_METHOD (from methodLocalKind) 

syntax localTypingLayer = {KIND localKind, TYPE typeDefEnv, FRAMES typeFrame*}

syntax typingContext = {CONTROL flow, LOOP loop, GLOBAL globalTypingLayer, BLOCK blockTypingLayer, LOCAL localTypingLayer}

var TC : typingContext

def $empty_typingContext : typingContext =

  clause 0 :  = TC
  -- let globalTypingLayer = {CONSTRUCTOR $empty_constructorTypeDefEnv, TYPE $empty_typeDefEnv, CALLABLE $empty_callableTypeDefEnv, FRAME $empty_typeFrame}
  -- let blockTypingLayer = {KIND `EMPTY, TYPE $empty_typeDefEnv, CALLABLE $empty_callableTypeDefEnv, FRAME $empty_typeFrame}
  -- let localTypingLayer = {KIND `EMPTY, TYPE $empty_typeDefEnv, FRAMES [$empty_typeFrame]}
  -- let TC = {CONTROL CONT, LOOP OUT, GLOBAL globalTypingLayer, BLOCK blockTypingLayer, LOCAL localTypingLayer}

def $bound(cursor, typingContext) : bound =

  clause 0 : (p, TC) = { [] }
  -- if p matches `GLOBAL`

  clause 1 : (p, TC) = $dom_map<typeId, typeDefIR>(TC.BLOCK.TYPE)
  -- if p matches `BLOCK`

  clause 2 : (p, TC) = $union_set<typeId>(B_block, B_local)
  -- if p matches `LOCAL`
  -- let B_block = $bound(BLOCK, TC)
  -- let B_local = $dom_map<typeId, typeDefIR>(TC.LOCAL.TYPE)

def $enter_t(typingContext) : typingContext =

  clause 0 : (TC) = TC[LOCAL.FRAMES = $empty_typeFrame :: TC.LOCAL.FRAMES]

def $exit_t(typingContext) : typingContext =

  clause 0 : (TC) = TC[LOCAL.FRAMES = typeFrame_t*{typeFrame_t <- typeFrame_t*}]
  -- let typeFrame*{typeFrame <- typeFrame*} = TC.LOCAL.FRAMES
  -- if typeFrame*{typeFrame <- typeFrame*} matches _ :: _
  -- let typeFrame_h :: typeFrame_t*{typeFrame_t <- typeFrame_t*} = typeFrame*{typeFrame <- typeFrame*}

def $join_control_t(typingContext, typingContext) : flow =

  clause 0 : (TC_a, TC_b) = $join_flow(TC_a.CONTROL, TC_b.CONTROL)

def $set_control_t(typingContext, flow) : typingContext =

  clause 0 : (TC, flow) = TC[CONTROL = flow]

def $enter_loop_t(typingContext) : typingContext =

  clause 0 : (TC) = TC[LOOP = IN]

def $set_loop_t(typingContext, loop) : typingContext =

  clause 0 : (TC, loop) = TC[LOOP = loop]

