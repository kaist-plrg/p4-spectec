  rulegroup binaryExpression-concat

    rule binaryExpression-concat: p TC |- expression_l ++ expression_r as expression : typedExpressionIR_l_reduced ++ typedExpressionIR_r_reduced as expressionIR # expressionNoteIR
    -- Expr_ok: p TC |- expression_l : typedExpressionIR_l
