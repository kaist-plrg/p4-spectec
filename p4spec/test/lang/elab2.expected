    -- (if (?(typeIR_field_a_aligned) = $find_map<id, typeIR>({ id_field_a : typeIR_field_a*{id_field_a <- id_field_a*, typeIR_field_a <- typeIR_field_a*} }, id_field_a)))*{id_field_a <- id_field_a*, typeIR_field_a_aligned <- typeIR_field_a_aligned*}
    -- (if (?(typeIR_field_b_aligned) = $find_map<id, typeIR>({ id_field_b : typeIR_field_b*{id_field_b <- id_field_b*, typeIR_field_b <- typeIR_field_b*} }, id_field_a)))*{id_field_a <- id_field_a*, typeIR_field_b_aligned <- typeIR_field_b_aligned*}
    -- (if Cast_impl: typeIR_field_a_aligned -> typeIR_field_b_aligned holds)*{typeIR_field_a_aligned <- typeIR_field_a_aligned*, typeIR_field_b_aligned <- typeIR_field_b_aligned*}

  rulegroup recordTypeIR-default

    rule structTypeIR: RECORD { _annotationList typeIR_field_a id_field_a ;*{_annotationList <- _annotationList*, id_field_a <- id_field_a*, typeIR_field_a <- typeIR_field_a*} , ... } as typeIR -> STRUCT _typeId < _typeArgumentIR*{_typeArgumentIR <- _typeArgumentIR*} > { _annotationList' typeIR_field_b id_field_b ;*{_annotationList' <- _annotationList'*, id_field_b <- id_field_b*, typeIR_field_b <- typeIR_field_b*} } as typeIR
