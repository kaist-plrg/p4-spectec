    -- if (n_index < |value_e*{value_e <- value_e*}|)
    -- if (value = value_e*{value_e <- value_e*}[n_index])

  rulegroup sliceAccessExpressionIR

    rule range: p IC STO_0 |- typedExpressionIR_base [ typedExpressionIR_hi : typedExpressionIR_lo ] as expressionIR # _expressionNoteIR : STO_3 $bitacc_range_op(value_base, value_hi, value_lo)
    -- Expr_inst: p IC STO_0 |- typedExpressionIR_base : STO_1 value_base
    -- Expr_inst: p IC STO_1 |- typedExpressionIR_hi : STO_2 value_hi
    -- Expr_inst: p IC STO_2 |- typedExpressionIR_lo : STO_3 value_lo

