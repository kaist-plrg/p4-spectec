  rulegroup conditionalStatementIR

    rule non-else-abort: p EC ARCH |- IF ( typedExpressionIR_cond ) statementIR_then as statementIR : EC_cond ARCH_cond abortResult as statementResult
    -- Expr_eval: p EC ARCH |- typedExpressionIR_cond : EC_cond ARCH_cond abortResult as expressionResult

    rule non-else-cont-true: p EC ARCH |- IF ( typedExpressionIR_cond ) statementIR_then as statementIR : EC_then ARCH_then statementResult
    -- Expr_eval: p EC ARCH |- typedExpressionIR_cond : EC_cond ARCH_cond ` `B true as value as expressionResult
    -- Stmt_eval: p EC_cond ARCH_cond |- statementIR_then : EC_then ARCH_then statementResult

    rule non-else-cont-false: p EC ARCH |- IF ( typedExpressionIR_cond ) statementIR_then as statementIR : EC_cond ARCH_cond `EMPTY as statementResult
    -- Expr_eval: p EC ARCH |- typedExpressionIR_cond : EC_cond ARCH_cond ` `B false as value as expressionResult

    rule else-abort: p EC ARCH |- IF ( typedExpressionIR_cond ) statementIR_then ELSE statementIR_else as statementIR : EC_cond ARCH_cond abortResult as statementResult
    -- Expr_eval: p EC ARCH |- typedExpressionIR_cond : EC_cond ARCH_cond abortResult as expressionResult

    rule else-cont-true: p EC ARCH |- IF ( typedExpressionIR_cond ) statementIR_then ELSE statementIR_else as statementIR : EC_then ARCH_then statementResult
    -- Expr_eval: p EC ARCH |- typedExpressionIR_cond : EC_cond ARCH_cond ` `B true as value as expressionResult
    -- Stmt_eval: p EC_cond ARCH_cond |- statementIR_then : EC_then ARCH_then statementResult

    rule else-cont-false: p EC ARCH |- IF ( typedExpressionIR_cond ) statementIR_then ELSE statementIR_else as statementIR : EC_else ARCH_else statementResult
    -- Expr_eval: p EC ARCH |- typedExpressionIR_cond : EC_cond ARCH_cond ` `B false as value as expressionResult
