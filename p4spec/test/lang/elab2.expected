    (enumTypeIR as typeIR) -> true
  row 9 :
    (SEQ < typeIR*{typeIR <- typeIR*} > as typeIR) -> $forall_($nestable_sequence_in_set(typeIR)*{typeIR <- typeIR*})
  row 10 :
    (_typeIR) -> false

tbl def $nestable_tuple_in_set(typeIR) : bool =
  row 0 :
    (BOOL as typeIR) -> true
  row 1 :
    (INT < _nat > as typeIR) -> true
  row 2 :
    (BIT < _nat > as typeIR) -> true
  row 3 :
    (nameTypeIR as typeIR) -> true
  row 4 :
    (TYPEDEF _typeId typeIR as typeIR) -> $nestable_tuple_in_set(typeIR)
  row 5 :
    (newTypeIR as typeIR) -> true
  row 6 :
    (TUPLE < typeIR*{typeIR <- typeIR*} > as typeIR) -> $forall_($nestable_tuple_in_set(typeIR)*{typeIR <- typeIR*})
  row 7 :
    (enumTypeIR as typeIR) -> true
  row 8 :
    (_typeIR) -> false

tbl def $nestable_sequence_in_set(typeIR) : bool =
  row 0 :
    (BOOL as typeIR) -> true
  row 1 :
    (INT < _nat > as typeIR) -> true
  row 2 :
    (BIT < _nat > as typeIR) -> true
  row 3 :
    (nameTypeIR as typeIR) -> true
  row 4 :
    (TYPEDEF _typeId typeIR as typeIR) -> $nestable_sequence_in_set(typeIR)
  row 5 :
    (newTypeIR as typeIR) -> true
  row 6 :
    (TUPLE < typeIR*{typeIR <- typeIR*} > as typeIR) -> $forall_($nestable_sequence_in_set(typeIR)*{typeIR <- typeIR*})
  row 7 :
    (enumTypeIR as typeIR) -> true
  row 8 :
    (SEQ < typeIR*{typeIR <- typeIR*} > as typeIR) -> $forall_($nestable_sequence_in_set(typeIR)*{typeIR <- typeIR*})
  row 9 :
    (_typeIR) -> false

def $directionless_trailing(direction*) : bool =

  clause 0 : (direction*{direction <- direction*}) = $directionless_trailing'(true, $rev_<direction>(direction*{direction <- direction*}))

def $directionless_trailing'(bool, direction*) : bool =

  clause 0 : (_b, direction*{direction <- direction*}) = true
  -- if direction*{direction <- direction*} matches []

  clause 1 : (b, direction'*{direction' <- direction'*}) = $directionless_trailing'(true, direction_t*{direction_t <- direction_t*})
  -- if (b = true)
  -- if direction'*{direction' <- direction'*} matches _ :: _
  -- let direction :: direction_t*{direction_t <- direction_t*} = direction'*{direction' <- direction'*}
  -- if direction matches `/* empty */`

  clause 2 : (b, direction'*{direction' <- direction'*}) = false
  -- if (b = false)
  -- if direction'*{direction' <- direction'*} matches _ :: _
  -- let direction :: direction_t*{direction_t <- direction_t*} = direction'*{direction' <- direction'*}
  -- if direction matches `/* empty */`

  clause 3 : (_b, direction*{direction <- direction*}) = $directionless_trailing'(false, direction_t*{direction_t <- direction_t*})
  -- if direction*{direction <- direction*} matches _ :: _
  -- let direction_h :: direction_t*{direction_t <- direction_t*} = direction*{direction <- direction*}
  -- if (direction_h =/= `EMPTY)

