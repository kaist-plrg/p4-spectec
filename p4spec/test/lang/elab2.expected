def $is_tableKeysProperty(tableProperty) : bool =

  clause 0 : (tableProperty) = true
  -- if tableProperty matches `KEY = {%}`
  -- let KEY = { _tableKeyList } = tableProperty

  clause -1 : (_tableProperty) = false

def $is_tableActionsProperty(tableProperty) : bool =

  clause 0 : (tableProperty) = true
  -- if tableProperty matches `ACTIONS = {%}`
  -- let ACTIONS = { _tableActionList } = tableProperty

  clause -1 : (_tableProperty) = false

def $is_tableDefaultActionProperty(tableProperty) : bool =

  clause 0 : (tableProperty) = true
  -- if tableProperty matches `% % % % ;`
  -- let _annotationList _constOpt tableCustomName _initializer ; = tableProperty
  -- if ("default_action" = $tableCustomName(tableCustomName))

  clause -1 : (_tableProperty) = false

def $insert_NoAction_tablePropertyIR(tableContext, tablePropertyIR*) : (tableContext, tablePropertyIR*) =

  clause 0 : (TBLC, tablePropertyIR*{tablePropertyIR <- tablePropertyIR*}) = (TBLC, [])
  -- if tablePropertyIR*{tablePropertyIR <- tablePropertyIR*} matches []

  clause 1 : (TBLC_0, tablePropertyIR*{tablePropertyIR <- tablePropertyIR*}) = (TBLC_1, tablePropertyIR_h_updated :: tablePropertyIR_t*{tablePropertyIR_t <- tablePropertyIR_t*})
  -- if tablePropertyIR*{tablePropertyIR <- tablePropertyIR*} matches _ :: _
  -- let tablePropertyIR_h :: tablePropertyIR_t*{tablePropertyIR_t <- tablePropertyIR_t*} = tablePropertyIR*{tablePropertyIR <- tablePropertyIR*}
  -- let tablePropertyIR' = tablePropertyIR_h
  -- if tablePropertyIR' <: tableActionsPropertyIR
  -- let ACTIONS = { tableActionIR*{tableActionIR <- tableActionIR*} } = tablePropertyIR' as tableActionsPropertyIR
  -- (let _annotationList tableActionReferenceIR # ( _parameterListIR , _parameterListIR' ) ; = tableActionIR)*{tableActionIR <- tableActionIR*, _annotationList -> _annotationList*, _parameterListIR -> _parameterListIR*, _parameterListIR' -> _parameterListIR'*, tableActionReferenceIR -> tableActionReferenceIR*}
  -- let tableActionReferenceIR_NoAction = . "NoAction" ?() ( [] )
  -- if ~tableActionReferenceIR_NoAction <- tableActionReferenceIR*{tableActionReferenceIR <- tableActionReferenceIR*}
  -- let TBLC_1 = $add_action_tbl(TBLC_0, . "NoAction", [], [])
  -- let tableActionIR_NoAction = `EMPTY tableActionReferenceIR_NoAction # ( [] , [] ) ;
  -- let tablePropertyIR_h_updated = ACTIONS = { tableActionIR*{tableActionIR <- tableActionIR*} ++ [tableActionIR_NoAction] } as tablePropertyIR

  clause 2 : (TBLC_0, tablePropertyIR*{tablePropertyIR <- tablePropertyIR*}) = (TBLC_0, tablePropertyIR_h :: tablePropertyIR_t*{tablePropertyIR_t <- tablePropertyIR_t*})
  -- if tablePropertyIR*{tablePropertyIR <- tablePropertyIR*} matches _ :: _
  -- let tablePropertyIR_h :: tablePropertyIR_t*{tablePropertyIR_t <- tablePropertyIR_t*} = tablePropertyIR*{tablePropertyIR <- tablePropertyIR*}
  -- let tablePropertyIR' = tablePropertyIR_h
  -- if tablePropertyIR' <: tableActionsPropertyIR
  -- let ACTIONS = { tableActionIR*{tableActionIR <- tableActionIR*} } = tablePropertyIR' as tableActionsPropertyIR
  -- (let _annotationList tableActionReferenceIR # ( _parameterListIR , _parameterListIR' ) ; = tableActionIR)*{tableActionIR <- tableActionIR*, _annotationList -> _annotationList*, _parameterListIR -> _parameterListIR*, _parameterListIR' -> _parameterListIR'*, tableActionReferenceIR -> tableActionReferenceIR*}
  -- let tableActionReferenceIR_NoAction = . "NoAction" ?() ( [] )
  -- if tableActionReferenceIR_NoAction <- tableActionReferenceIR*{tableActionReferenceIR <- tableActionReferenceIR*}

  clause 3 : (TBLC_0, tablePropertyIR*{tablePropertyIR <- tablePropertyIR*}) = (TBLC_1, tablePropertyIR_h :: tablePropertyIR_t_updated*{tablePropertyIR_t_updated <- tablePropertyIR_t_updated*})
  -- if tablePropertyIR*{tablePropertyIR <- tablePropertyIR*} matches _ :: _
  -- let tablePropertyIR_h :: tablePropertyIR_t*{tablePropertyIR_t <- tablePropertyIR_t*} = tablePropertyIR*{tablePropertyIR <- tablePropertyIR*}
  -- if ~tablePropertyIR_h <: tableActionsPropertyIR
  -- let (TBLC_1, tablePropertyIR_t_updated*{tablePropertyIR_t_updated <- tablePropertyIR_t_updated*}) = $insert_NoAction_tablePropertyIR(TBLC_0, tablePropertyIR_t*{tablePropertyIR_t <- tablePropertyIR_t*})

relation ControlLocalDecls_ok: typingContext |- controlLocalDeclaration* : typingContext controlLocalDeclarationIR*

  rulegroup 

    rule nil: TC |- [] : TC []

    rule cons: TC_0 |- controlLocalDeclaration_h :: controlLocalDeclaration_t*{controlLocalDeclaration_t <- controlLocalDeclaration_t*} : TC_2 controlLocalDeclarationIR_h :: controlLocalDeclarationIR_t*{controlLocalDeclarationIR_t <- controlLocalDeclarationIR_t*}
    -- ControlLocalDecl_ok: TC_0 |- controlLocalDeclaration_h : TC_1 controlLocalDeclarationIR_h
    -- ControlLocalDecls_ok: TC_1 |- controlLocalDeclaration_t*{controlLocalDeclaration_t <- controlLocalDeclaration_t*} : TC_2 controlLocalDeclarationIR_t*{controlLocalDeclarationIR_t <- controlLocalDeclarationIR_t*}

syntax infer = 
   | KNOWN AS typeIR (from infer) 
   | UNKNOWN (from infer) 

syntax constraint = map<typeId, infer>

def $empty_constraint(typeId*) : constraint =

  clause 0 : (typeId*{typeId <- typeId*}) = { typeId : UNKNOWN*{typeId <- typeId*} }

syntax inference = map<typeId, typeIR>

def $infer(typeId*, parameterIR*, argumentIR*) : inference =

  clause 0 : (typeId*{typeId <- typeId*}, parameterIR*{parameterIR <- parameterIR*}, argumentIR*{argumentIR <- argumentIR*}) = $empty_map<typeId, typeIR>
  -- if typeId*{typeId <- typeId*} matches []

  clause 1 : (typeId_infer*{typeId_infer <- typeId_infer*}, parameterIR*{parameterIR <- parameterIR*}, argumentIR*{argumentIR <- argumentIR*}) = inference_resolved
  -- if (typeId_infer*{typeId_infer <- typeId_infer*} =/= [])
  -- let constraint_init = $empty_constraint(typeId_infer*{typeId_infer <- typeId_infer*})
  -- (let constraint_pair = $infer'(constraint_init, parameterIR, argumentIR))*{argumentIR <- argumentIR*, parameterIR <- parameterIR*, constraint_pair -> constraint_pair*}
  -- let constraint_inferred = $merge_constraints(constraint_init, constraint_pair*{constraint_pair <- constraint_pair*})
  -- let inference = $resolve_constraint(constraint_inferred)
  -- let inference_resolved = $resolve_inference(inference)

def $infer'(constraint, parameterIR, argumentIR) : constraint =

  clause 0 : (constraint, parameterIR, argumentIR) = $gen_constraint(constraint, typeIR_param, typeIR_arg)
  -- if argumentIR <: typedExpressionIR
  -- let typedExpressionIR = argumentIR as typedExpressionIR
  -- let _annotationList _direction typeIR_param _id _parameterInitializerOptIR = parameterIR
  -- let typeIR_arg = $type_of_typedExpressionIR(typedExpressionIR)

  clause 1 : (constraint, parameterIR, argumentIR) = $gen_constraint(constraint, typeIR_param, typeIR_arg)
  -- if argumentIR matches `% = %`
  -- let nameIR = typedExpressionIR = argumentIR
  -- let _annotationList _direction typeIR_param _id _parameterInitializerOptIR = parameterIR
  -- let typeIR_arg = $type_of_typedExpressionIR(typedExpressionIR)

  clause 2 : (constraint, parameterIR, argumentIR) = constraint
  -- if argumentIR matches `% = _`
  -- let nameIR = _ = argumentIR

  clause 3 : (constraint, parameterIR, argumentIR) = constraint
  -- if argumentIR matches `_`

def $resolve_inference(inference) : inference =

  clause 0 : ({ typeId : typeIR*{typeIR <- typeIR*, typeId <- typeId*} }) = { typeId : typeIR_resolved*{typeIR_resolved <- typeIR_resolved*, typeId <- typeId*} }
  -- (let typeIR_resolved = $resolve_inference'(typeIR))*{typeIR <- typeIR*, typeIR_resolved -> typeIR_resolved*}

def $resolve_inference'(typeIR) : typeIR =

  clause 0 : (typeIR) = typeIR_resolved
  -- let typeIR' = $unroll_typeIR(typeIR)
  -- if typeIR' <: sequenceTypeIR
  -- let sequenceTypeIR = typeIR' as sequenceTypeIR
  -- if sequenceTypeIR matches `SEQ <%>`
  -- let SEQ < typeIR_arg*{typeIR_arg <- typeIR_arg*} > = sequenceTypeIR
  -- let typeIR_resolved = TUPLE < typeIR_arg*{typeIR_arg <- typeIR_arg*} > as typeIR

  clause -1 : (typeIR) = typeIR

def $gen_constraint(constraint, typeIR, typeIR) : constraint =

  clause 0 : (constraint, typeIR, typeIR_arg) = $update_map<typeId, infer>(constraint, typeId_param, KNOWN AS typeIR_arg)
  -- if typeIR <: nameTypeIR
  -- let ` typeId_param = typeIR as nameTypeIR
  -- if $in_set<typeId>(typeId_param, $dom_map<typeId, infer>(constraint))

  clause 1 : (constraint, typeIR, typeIR_arg) = $gen_constraint(constraint, typeIR_param, typeIR_arg)
  -- if typeIR <: typedefTypeIR
  -- let TYPEDEF _typeId typeIR_param = typeIR as typedefTypeIR

  clause 2 : (constraint, typeIR_param, typeIR) = $gen_constraint(constraint, typeIR_param, typeIR_arg)
  -- if typeIR <: typedefTypeIR
  -- let TYPEDEF _typeId typeIR_arg = typeIR as typedefTypeIR
  -- if ~typeIR_param <: nameTypeIR
  -- if ~typeIR_param <: typedefTypeIR

  clause 3 : (constraint, typeIR, typeIR') = $gen_constraint(constraint, typeIR_param, typeIR_arg)
  -- if typeIR <: newTypeIR
  -- let TYPE typeId typeIR_param = typeIR as newTypeIR
  -- if typeIR' <: newTypeIR
  -- let TYPE typeId' typeIR_arg = typeIR' as newTypeIR
  -- if (typeId = typeId')

  clause 4 : (constraint, typeIR, typeIR') = $gen_constraint(constraint, typeIR_param, typeIR_arg)
  -- if typeIR <: listTypeIR
  -- let LIST < typeIR_param > = typeIR as listTypeIR
  -- if typeIR' <: listTypeIR
  -- let LIST < typeIR_arg > = typeIR' as listTypeIR

  clause 5 : (constraint, typeIR, typeIR') = $gen_constraints(constraint, typeIR_param*{typeIR_param <- typeIR_param*}, typeIR_arg*{typeIR_arg <- typeIR_arg*})
  -- if typeIR <: tupleTypeIR
  -- let TUPLE < typeIR_param*{typeIR_param <- typeIR_param*} > = typeIR as tupleTypeIR
  -- if typeIR' <: tupleTypeIR
  -- let TUPLE < typeIR_arg*{typeIR_arg <- typeIR_arg*} > = typeIR' as tupleTypeIR

  clause 6 : (constraint, typeIR, typeIR') = $gen_constraint(constraint, typeIR_param, typeIR_arg)
  -- if typeIR <: headerStackTypeIR
  -- let typeIR_param [ n_size ] = typeIR as headerStackTypeIR
  -- if typeIR' <: headerStackTypeIR
  -- let typeIR_arg [ n_size' ] = typeIR' as headerStackTypeIR
  -- if (n_size = n_size')

  clause 7 : (constraint, typeIR, typeIR') = $gen_constraints(constraint, typeIR_arg_a*{typeIR_arg_a <- typeIR_arg_a*}, typeIR_arg_b*{typeIR_arg_b <- typeIR_arg_b*})
  -- if typeIR <: structTypeIR
  -- let STRUCT typeId < typeIR_arg_a*{typeIR_arg_a <- typeIR_arg_a*} > { _fieldTypeIR*{_fieldTypeIR <- _fieldTypeIR*} } = typeIR as structTypeIR
  -- if typeIR' <: structTypeIR
  -- let STRUCT typeId' < typeIR_arg_b*{typeIR_arg_b <- typeIR_arg_b*} > { _fieldTypeIR'*{_fieldTypeIR' <- _fieldTypeIR'*} } = typeIR' as structTypeIR
  -- if (typeId = typeId')

  clause 8 : (constraint, typeIR, typeIR') = $gen_constraints(constraint, typeIR_arg_a*{typeIR_arg_a <- typeIR_arg_a*}, typeIR_arg_b*{typeIR_arg_b <- typeIR_arg_b*})
  -- if typeIR <: headerTypeIR
  -- let HEADER typeId < typeIR_arg_a*{typeIR_arg_a <- typeIR_arg_a*} > { _fieldTypeIR*{_fieldTypeIR <- _fieldTypeIR*} } = typeIR as headerTypeIR
  -- if typeIR' <: headerTypeIR
  -- let HEADER typeId' < typeIR_arg_b*{typeIR_arg_b <- typeIR_arg_b*} > { _fieldTypeIR'*{_fieldTypeIR' <- _fieldTypeIR'*} } = typeIR' as headerTypeIR
  -- if (typeId = typeId')

  clause 9 : (constraint, typeIR, typeIR') = $gen_constraints(constraint, typeIR_arg_a*{typeIR_arg_a <- typeIR_arg_a*}, typeIR_arg_b*{typeIR_arg_b <- typeIR_arg_b*})
  -- if typeIR <: headerUnionTypeIR
  -- let HEADER_UNION typeId < typeIR_arg_a*{typeIR_arg_a <- typeIR_arg_a*} > { _fieldTypeIR*{_fieldTypeIR <- _fieldTypeIR*} } = typeIR as headerUnionTypeIR
  -- if typeIR' <: headerUnionTypeIR
  -- let HEADER_UNION typeId' < typeIR_arg_b*{typeIR_arg_b <- typeIR_arg_b*} > { _fieldTypeIR'*{_fieldTypeIR' <- _fieldTypeIR'*} } = typeIR' as headerUnionTypeIR
  -- if (typeId = typeId')

  clause 10 : (constraint, typeIR, typeIR') = $gen_constraints(constraint, typeIR_arg_a*{typeIR_arg_a <- typeIR_arg_a*}, typeIR_arg_b*{typeIR_arg_b <- typeIR_arg_b*})
  -- if typeIR <: externObjectTypeIR
  -- let EXTERN typeId < typeIR_arg_a*{typeIR_arg_a <- typeIR_arg_a*} > { _pair<callableId, externMethodTypeDefIR>*{_pair<callableId, externMethodTypeDefIR> <- _pair<callableId, externMethodTypeDefIR>*} } = typeIR as externObjectTypeIR
  -- if typeIR' <: externObjectTypeIR
  -- let EXTERN typeId' < typeIR_arg_b*{typeIR_arg_b <- typeIR_arg_b*} > { _pair<callableId, externMethodTypeDefIR>'*{_pair<callableId, externMethodTypeDefIR>' <- _pair<callableId, externMethodTypeDefIR>'*} } = typeIR' as externObjectTypeIR
  -- if (typeId = typeId')

  clause 11 : (constraint, typeIR, typeIR') = $gen_constraints(constraint, typeIR_param*{typeIR_param <- typeIR_param*}, typeIR_arg*{typeIR_arg <- typeIR_arg*})
  -- if typeIR <: parserObjectTypeIR
  -- let PARSER _typeId < _typeArgumentIR*{_typeArgumentIR <- _typeArgumentIR*} > ( parameterIR_param*{parameterIR_param <- parameterIR_param*} ) = typeIR as parserObjectTypeIR
  -- if typeIR' <: parserObjectTypeIR
  -- let PARSER _typeId' < _typeArgumentIR'*{_typeArgumentIR' <- _typeArgumentIR'*} > ( parameterIR_arg*{parameterIR_arg <- parameterIR_arg*} ) = typeIR' as parserObjectTypeIR
  -- (let _annotationList direction typeIR_param _id _parameterInitializerOptIR = parameterIR_param)*{parameterIR_param <- parameterIR_param*, _annotationList -> _annotationList*, _id -> _id*, _parameterInitializerOptIR -> _parameterInitializerOptIR*, direction -> direction*, typeIR_param -> typeIR_param*}
  -- (let _annotationList' direction' typeIR_arg _id' _parameterInitializerOptIR' = parameterIR_arg)*{parameterIR_arg <- parameterIR_arg*, _annotationList' -> _annotationList'*, _id' -> _id'*, _parameterInitializerOptIR' -> _parameterInitializerOptIR'*, direction' -> direction'*, typeIR_arg -> typeIR_arg*}
  -- (if (direction' = direction))*{direction <- direction*, direction' <- direction'*}

  clause 12 : (constraint, typeIR, typeIR') = $gen_constraints(constraint, typeIR_param*{typeIR_param <- typeIR_param*}, typeIR_arg*{typeIR_arg <- typeIR_arg*})
  -- if typeIR <: controlObjectTypeIR
  -- let CONTROL _typeId < _typeArgumentIR*{_typeArgumentIR <- _typeArgumentIR*} > ( parameterIR_param*{parameterIR_param <- parameterIR_param*} ) = typeIR as controlObjectTypeIR
  -- if typeIR' <: controlObjectTypeIR
  -- let CONTROL _typeId' < _typeArgumentIR'*{_typeArgumentIR' <- _typeArgumentIR'*} > ( parameterIR_arg*{parameterIR_arg <- parameterIR_arg*} ) = typeIR' as controlObjectTypeIR
  -- (let _annotationList direction typeIR_param _id _parameterInitializerOptIR = parameterIR_param)*{parameterIR_param <- parameterIR_param*, _annotationList -> _annotationList*, _id -> _id*, _parameterInitializerOptIR -> _parameterInitializerOptIR*, direction -> direction*, typeIR_param -> typeIR_param*}
  -- (let _annotationList' direction' typeIR_arg _id' _parameterInitializerOptIR' = parameterIR_arg)*{parameterIR_arg <- parameterIR_arg*, _annotationList' -> _annotationList'*, _id' -> _id'*, _parameterInitializerOptIR' -> _parameterInitializerOptIR'*, direction' -> direction'*, typeIR_arg -> typeIR_arg*}
  -- (if (direction' = direction))*{direction <- direction*, direction' <- direction'*}

  clause 13 : (constraint, typeIR, typeIR') = $gen_constraints(constraint, typeIR_param*{typeIR_param <- typeIR_param*}, typeIR_arg*{typeIR_arg <- typeIR_arg*})
  -- if typeIR <: packageObjectTypeIR
  -- let PACKAGE _typeId < _typeArgumentIR*{_typeArgumentIR <- _typeArgumentIR*} > { typeIR_param*{typeIR_param <- typeIR_param*} } = typeIR as packageObjectTypeIR
  -- if typeIR' <: packageObjectTypeIR
  -- let PACKAGE _typeId' < _typeArgumentIR'*{_typeArgumentIR' <- _typeArgumentIR'*} > { typeIR_arg*{typeIR_arg <- typeIR_arg*} } = typeIR' as packageObjectTypeIR

  clause -1 : (constraint, typeIR_param, typeIR_arg) = constraint

def $gen_constraints(constraint, typeIR*, typeIR*) : constraint =

  clause 0 : (constraint, typeIR_param*{typeIR_param <- typeIR_param*}, typeIR_arg*{typeIR_arg <- typeIR_arg*}) = $merge_constraints(constraint, constraint_pair*{constraint_pair <- constraint_pair*})
  -- (let constraint_pair = $gen_constraint(constraint, typeIR_param, typeIR_arg))*{typeIR_arg <- typeIR_arg*, typeIR_param <- typeIR_param*, constraint_pair -> constraint_pair*}

def $merge_constraint(constraint, constraint) : constraint =

  clause 0 : (constraint_pre, constraint_post) = $merge_constraint'(constraint_pre, constraint_post, typeId_pre*{typeId_pre <- typeId_pre*}, { [] })
  -- let { typeId_pre*{typeId_pre <- typeId_pre*} } = $dom_map<typeId, infer>(constraint_pre)
  -- let { typeId_post*{typeId_post <- typeId_post*} } = $dom_map<typeId, infer>(constraint_post)
  -- if $eq_set<typeId>({ typeId_pre*{typeId_pre <- typeId_pre*} }, { typeId_post*{typeId_post <- typeId_post*} })

def $merge_constraint'(constraint, constraint, typeId*, constraint) : constraint =

  clause 0 : (constraint_pre, constraint_post, typeId*{typeId <- typeId*}, constraint) = constraint
  -- if typeId*{typeId <- typeId*} matches []

  clause 1 : (constraint_pre, constraint_post, typeId*{typeId <- typeId*}, constraint) = $merge_constraint'(constraint_pre, constraint_post, typeId_t*{typeId_t <- typeId_t*}, constraint_updated)
  -- if typeId*{typeId <- typeId*} matches _ :: _
  -- let typeId_h :: typeId_t*{typeId_t <- typeId_t*} = typeId*{typeId <- typeId*}
  -- if (?(UNKNOWN) = $find_map<typeId, infer>(constraint_pre, typeId_h))
  -- if (?(UNKNOWN) = $find_map<typeId, infer>(constraint_post, typeId_h))
  -- let constraint_updated = $update_map<typeId, infer>(constraint, typeId_h, UNKNOWN)

  clause 2 : (constraint_pre, constraint_post, typeId*{typeId <- typeId*}, constraint) = $merge_constraint'(constraint_pre, constraint_post, typeId_t*{typeId_t <- typeId_t*}, constraint_updated)
  -- if typeId*{typeId <- typeId*} matches _ :: _
  -- let typeId_h :: typeId_t*{typeId_t <- typeId_t*} = typeId*{typeId <- typeId*}
  -- if (?(UNKNOWN) = $find_map<typeId, infer>(constraint_pre, typeId_h))
  -- let infer'?{infer' <- infer'?} = $find_map<typeId, infer>(constraint_post, typeId_h)
  -- if infer'?{infer' <- infer'?} matches (_)
  -- let ?(infer) = infer'?{infer' <- infer'?}
  -- if infer matches `KNOWN AS %`
  -- let KNOWN AS typeIR_post = infer
  -- let constraint_updated = $update_map<typeId, infer>(constraint, typeId_h, KNOWN AS typeIR_post)

  clause 3 : (constraint_pre, constraint_post, typeId*{typeId <- typeId*}, constraint) = $merge_constraint'(constraint_pre, constraint_post, typeId_t*{typeId_t <- typeId_t*}, constraint_updated)
  -- if typeId*{typeId <- typeId*} matches _ :: _
  -- let typeId_h :: typeId_t*{typeId_t <- typeId_t*} = typeId*{typeId <- typeId*}
  -- let infer'?{infer' <- infer'?} = $find_map<typeId, infer>(constraint_pre, typeId_h)
  -- if infer'?{infer' <- infer'?} matches (_)
  -- let ?(infer) = infer'?{infer' <- infer'?}
  -- if infer matches `KNOWN AS %`
  -- let KNOWN AS typeIR_pre = infer
  -- if (?(UNKNOWN) = $find_map<typeId, infer>(constraint_post, typeId_h))
  -- let constraint_updated = $update_map<typeId, infer>(constraint, typeId_h, KNOWN AS typeIR_pre)

  clause 4 : (constraint_pre, constraint_post, typeId*{typeId <- typeId*}, constraint) = $merge_constraint'(constraint_pre, constraint_post, typeId_t*{typeId_t <- typeId_t*}, constraint_updated)
  -- if typeId*{typeId <- typeId*} matches _ :: _
  -- let typeId_h :: typeId_t*{typeId_t <- typeId_t*} = typeId*{typeId <- typeId*}
  -- let infer'?{infer' <- infer'?} = $find_map<typeId, infer>(constraint_pre, typeId_h)
  -- if infer'?{infer' <- infer'?} matches (_)
  -- let ?(infer) = infer'?{infer' <- infer'?}
  -- if infer matches `KNOWN AS %`
  -- let KNOWN AS typeIR_pre = infer
  -- let infer'''?{infer''' <- infer'''?} = $find_map<typeId, infer>(constraint_post, typeId_h)
  -- if infer'''?{infer''' <- infer'''?} matches (_)
  -- let ?(infer'') = infer'''?{infer''' <- infer'''?}
  -- if infer'' matches `KNOWN AS %`
  -- let KNOWN AS typeIR_post = infer''
  -- if Cast_impl: typeIR_pre -> typeIR_post holds
  -- let constraint_updated = $update_map<typeId, infer>(constraint, typeId_h, KNOWN AS typeIR_post)

  clause 5 : (constraint_pre, constraint_post, typeId*{typeId <- typeId*}, constraint) = $merge_constraint'(constraint_pre, constraint_post, typeId_t*{typeId_t <- typeId_t*}, constraint_updated)
  -- if typeId*{typeId <- typeId*} matches _ :: _
  -- let typeId_h :: typeId_t*{typeId_t <- typeId_t*} = typeId*{typeId <- typeId*}
  -- let infer'?{infer' <- infer'?} = $find_map<typeId, infer>(constraint_pre, typeId_h)
  -- if infer'?{infer' <- infer'?} matches (_)
  -- let ?(infer) = infer'?{infer' <- infer'?}
  -- if infer matches `KNOWN AS %`
  -- let KNOWN AS typeIR_pre = infer
  -- let infer'''?{infer''' <- infer'''?} = $find_map<typeId, infer>(constraint_post, typeId_h)
  -- if infer'''?{infer''' <- infer'''?} matches (_)
  -- let ?(infer'') = infer'''?{infer''' <- infer'''?}
  -- if infer'' matches `KNOWN AS %`
  -- let KNOWN AS typeIR_post = infer''
  -- if Cast_impl: typeIR_pre -> typeIR_post does not hold
  -- if Cast_impl: typeIR_post -> typeIR_pre holds
  -- let constraint_updated = $update_map<typeId, infer>(constraint, typeId_h, KNOWN AS typeIR_pre)

def $merge_constraints(constraint, constraint*) : constraint =

  clause 0 : (constraint_pre, constraint*{constraint <- constraint*}) = constraint_pre
  -- if constraint*{constraint <- constraint*} matches []

  clause 1 : (constraint_pre_0, constraint*{constraint <- constraint*}) = constraint_pre_2
  -- if constraint*{constraint <- constraint*} matches _ :: _
  -- let constraint_post_h :: constraint_post_t*{constraint_post_t <- constraint_post_t*} = constraint*{constraint <- constraint*}
  -- let constraint_pre_1 = $merge_constraint(constraint_pre_0, constraint_post_h)
  -- let constraint_pre_2 = $merge_constraints(constraint_pre_1, constraint_post_t*{constraint_post_t <- constraint_post_t*})

def $resolve_constraint(constraint) : inference =

  clause 0 : ({ typeId : infer*{infer <- infer*, typeId <- typeId*} }) = { typeId : typeIR*{typeIR <- typeIR*, typeId <- typeId*} }
  -- (let infer' = infer)*{infer <- infer*, infer' -> infer'*}
  -- (if infer' matches `KNOWN AS %`)*{infer' <- infer'*}
  -- (let KNOWN AS typeIR = infer')*{infer' <- infer'*, typeIR -> typeIR*}

def $resolve_type_alias(typeIR) : (nameIR, typeIR*) =

  clause 0 : (typeIR) = $resolve_type_alias(typeIR_alias)
  -- if typeIR <: typedefTypeIR
  -- let TYPEDEF nameIR_alias typeIR_alias = typeIR as typedefTypeIR

  clause 1 : (typeIR) = (nameIR_alias, typeIR_arg*{typeIR_arg <- typeIR_arg*})
  -- if typeIR <: externObjectTypeIR
  -- let EXTERN nameIR_alias < typeIR_arg*{typeIR_arg <- typeIR_arg*} > _externMethodTypeDefEnv = typeIR as externObjectTypeIR

  clause 2 : (typeIR) = (nameIR_alias, typeIR_arg*{typeIR_arg <- typeIR_arg*})
  -- if typeIR <: packageObjectTypeIR
  -- let PACKAGE nameIR_alias < typeIR_arg*{typeIR_arg <- typeIR_arg*} > { _typeIR*{_typeIR <- _typeIR*} } = typeIR as packageObjectTypeIR

def $instantiable_extern(cursor, typingContext, instctxt) : bool =

  clause 0 : (p, TC, instctxt) = true
  -- if p matches `GLOBAL`

  clause 1 : (p, TC, instctxt) = true
  -- if p matches `BLOCK`

  clause 2 : (p, TC, instctxt) = true
  -- if p matches `LOCAL`

def $instantiable_parser(cursor, typingContext, instctxt) : bool =

  clause 0 : (p, TC, instctxt) = (instctxt = ANON)
  -- if p matches `GLOBAL`

  clause 1 : (p, TC, instctxt) = ((blockKind = PARSER) \/ (blockKind = PACKAGE))
  -- if p matches `BLOCK`
  -- let blockKind = TC.BLOCK.KIND

  clause 2 : (p, TC, instctxt) = (localKind = PARSER_STATE as localKind)
  -- if p matches `LOCAL`
  -- let localKind = TC.LOCAL.KIND

def $instantiable_control(cursor, typingContext, instctxt) : bool =

  clause 0 : (p, TC, instctxt) = (instctxt = ANON)
  -- if p matches `GLOBAL`

  clause 1 : (p, TC, instctxt) = ((blockKind = CONTROL) \/ (blockKind = PACKAGE))
  -- if p matches `BLOCK`
  -- let blockKind = TC.BLOCK.KIND

  clause 2 : (p, TC, instctxt) = (localKind = CONTROL_APPLY_METHOD as localKind)
  -- if p matches `LOCAL`
  -- let localKind = TC.LOCAL.KIND

def $instantiable_package(cursor, typingContext, instctxt) : bool =

  clause 0 : (p, TC, instctxt) = true
  -- if p matches `GLOBAL`

  clause 1 : (p, TC, instctxt) = (blockKind = PACKAGE)
  -- if p matches `BLOCK`
  -- let blockKind = TC.BLOCK.KIND

  clause 2 : (p, TC, instctxt) = false
  -- if p matches `LOCAL`

def $instantiable_table(cursor, typingContext, instctxt) : bool =

  clause 0 : (p, TC, instctxt) = false
  -- if p matches `GLOBAL`

  clause 1 : (p, TC, instctxt) = (blockKind = CONTROL)
  -- if p matches `BLOCK`
  -- let blockKind = TC.BLOCK.KIND

  clause 2 : (p, TC, instctxt) = false
  -- if p matches `LOCAL`

def $instantiable(cursor, typingContext, instctxt, typeIR) : bool =

  clause 0 : (p, TC, instctxt, typeIR) = $instantiable_extern(p, TC, instctxt)
  -- let typeIR_unroll = $unroll_typeIR(typeIR)
  -- if typeIR_unroll <: externObjectTypeIR

  clause 1 : (p, TC, instctxt, typeIR) = $instantiable_parser(p, TC, instctxt)
  -- let typeIR_unroll = $unroll_typeIR(typeIR)
  -- if typeIR_unroll <: parserObjectTypeIR

  clause 2 : (p, TC, instctxt, typeIR) = $instantiable_control(p, TC, instctxt)
  -- let typeIR_unroll = $unroll_typeIR(typeIR)
  -- if typeIR_unroll <: controlObjectTypeIR

  clause 3 : (p, TC, instctxt, typeIR) = $instantiable_package(p, TC, instctxt)
  -- let typeIR_unroll = $unroll_typeIR(typeIR)
  -- if typeIR_unroll <: packageObjectTypeIR

  clause 4 : (p, TC, instctxt, typeIR) = $instantiable_table(p, TC, instctxt)
  -- let typeIR_unroll = $unroll_typeIR(typeIR)
  -- if typeIR_unroll <: tableObjectTypeIR

def $callable_action(cursor, typingContext) : bool =

  clause 0 : (p, TC) = false
  -- if p matches `GLOBAL`

  clause 1 : (p, TC) = false
  -- if p matches `BLOCK`

  clause 2 : (p, TC) = ((localKind = ACTION as localKind) \/ (localKind = CONTROL_APPLY_METHOD as localKind))
  -- if p matches `LOCAL`
  -- let localKind = TC.LOCAL.KIND

def $callable_definedFunction(cursor, typingContext) : bool =

  clause 0 : (p, TC) = false
  -- if p matches `GLOBAL`

  clause 1 : (p, TC) = ((blockKind = PARSER) \/ (blockKind = CONTROL))
  -- if p matches `BLOCK`
  -- let blockKind = TC.BLOCK.KIND

  clause 2 : (p, TC) = ~localKind <: externMethodLocalKind
  -- if p matches `LOCAL`
  -- let localKind = TC.LOCAL.KIND

def $callable_externFunction(cursor, typingContext, nameIR) : bool =

  clause 0 : (p, TC, nameIR) = false
  -- if p matches `GLOBAL`
  -- if (nameIR = "verify")

  clause 1 : (p, TC, nameIR) = true
  -- if p matches `GLOBAL`
  -- if (nameIR =/= "verify")

  clause 2 : (p, TC, nameIR) = (blockKind = PARSER)
  -- if p matches `BLOCK`
  -- if (nameIR = "verify")
  -- let blockKind = TC.BLOCK.KIND

  clause 3 : (p, TC, nameIR) = ((blockKind = PARSER) \/ (blockKind = CONTROL))
  -- if p matches `BLOCK`
  -- if (nameIR =/= "verify")
  -- let blockKind = TC.BLOCK.KIND

  clause 4 : (p, TC, nameIR) = (localKind = PARSER_STATE as localKind)
  -- if p matches `LOCAL`
  -- if (nameIR = "verify")
  -- let localKind = TC.LOCAL.KIND

  clause 5 : (p, TC, nameIR) = true
  -- if p matches `LOCAL`
  -- if (nameIR =/= "verify")

def $callable_externMethod(cursor, typingContext) : bool =

  clause 0 : (p, TC) = false
  -- if p matches `GLOBAL`

  clause 1 : (p, TC) = ((blockKind = PARSER) \/ (blockKind = CONTROL))
  -- if p matches `BLOCK`
  -- let blockKind = TC.BLOCK.KIND

  clause 2 : (p, TC) = true
  -- if p matches `LOCAL`

def $callable_parserApplyMethod(cursor, typingContext) : bool =

  clause 0 : (p, TC) = false
  -- if p matches `GLOBAL`

  clause 1 : (p, TC) = false
  -- if p matches `BLOCK`

  clause 2 : (p, TC) = (localKind = PARSER_STATE as localKind)
  -- if p matches `LOCAL`
  -- let localKind = TC.LOCAL.KIND

def $callable_controlApplyMethod(cursor, typingContext) : bool =

  clause 0 : (p, TC) = false
  -- if p matches `GLOBAL`

  clause 1 : (p, TC) = false
  -- if p matches `BLOCK`

  clause 2 : (p, TC) = (localKind = CONTROL_APPLY_METHOD as localKind)
  -- if p matches `LOCAL`
  -- let localKind = TC.LOCAL.KIND

def $callable_tableApplyMethod(cursor, typingContext) : bool =

  clause 0 : (p, TC) = false
  -- if p matches `GLOBAL`

  clause 1 : (p, TC) = false
  -- if p matches `BLOCK`

  clause 2 : (p, TC) = ((localKind = CONTROL_APPLY_METHOD as localKind) \/ (localKind = TABLE_APPLY_METHOD as localKind))
  -- if p matches `LOCAL`
  -- let localKind = TC.LOCAL.KIND

def $callableId_IR(nameIR, parameterListIR) : callableId =

  clause 0 : (nameIR, parameterIR*{parameterIR <- parameterIR*}) = nameIR ( id*{id <- id*} )
  -- (let _annotationList _direction _typeIR id _parameterInitializerOptIR = parameterIR)*{parameterIR <- parameterIR*, _annotationList -> _annotationList*, _direction -> _direction*, _parameterInitializerOptIR -> _parameterInitializerOptIR*, _typeIR -> _typeIR*, id -> id*}

syntax storageReference = 
   | ` nameIR (from prefixedNameIR)  hint(print %0)
   | . nameIR (from prefixedNameIR) 
   | storageReference . nameIR (from storageReference) 
   | storageReference [ value ] (from storageReference) 
   | storageReference [ value sliceop value ] (from storageReference) 

syntax actionDef = 
   | annotationList ACTION nameIR ( parameterListIR ) blockStatementIR (from actionDef) 

syntax definedFunctionDef = 
   | FUNCTION nameIR < typeParameterListIR > ( parameterListIR ) blockStatementIR (from definedFunctionDef) 

syntax externFunctionDef = 
   | EXTERN_FUNCTION nameIR < typeParameterListIR > ( parameterListIR ) (from externFunctionDef) 

syntax functionDef = 
   | FUNCTION nameIR < typeParameterListIR > ( parameterListIR ) blockStatementIR (from definedFunctionDef) 
   | EXTERN_FUNCTION nameIR < typeParameterListIR > ( parameterListIR ) (from externFunctionDef) 

syntax externMethodDef = 
   | EXTERN_METHOD nameIR < typeParameterListIR > ( parameterListIR ) blockStatementIR? (from externMethodDef) 
   | EXTERN_METHOD ABSTRACT nameIR < typeParameterListIR > ( parameterListIR ) (from externMethodDef) 

syntax parserApplyMethodDef = 
   | PARSER_APPLY ( parameterListIR ) { parserLocalDeclarationListIR ; stateEnv } (from parserApplyMethodDef) 

syntax controlApplyMethodDef = 
   | CONTROL_APPLY ( parameterListIR ) { controlLocalDeclarationListIR ; actionDefEnv ; controlBodyIR } (from controlApplyMethodDef) 

syntax tableApplyMethodDef = 
   | TABLE_APPLY { tablePropertyListIR } (from tableApplyMethodDef) 

syntax methodDef = 
   | EXTERN_METHOD nameIR < typeParameterListIR > ( parameterListIR ) blockStatementIR? (from externMethodDef) 
   | EXTERN_METHOD ABSTRACT nameIR < typeParameterListIR > ( parameterListIR ) (from externMethodDef) 
   | PARSER_APPLY ( parameterListIR ) { parserLocalDeclarationListIR ; stateEnv } (from parserApplyMethodDef) 
   | CONTROL_APPLY ( parameterListIR ) { controlLocalDeclarationListIR ; actionDefEnv ; controlBodyIR } (from controlApplyMethodDef) 
   | TABLE_APPLY { tablePropertyListIR } (from tableApplyMethodDef) 

syntax callableDef = 
   | annotationList ACTION nameIR ( parameterListIR ) blockStatementIR (from actionDef) 
   | FUNCTION nameIR < typeParameterListIR > ( parameterListIR ) blockStatementIR (from definedFunctionDef) 
   | EXTERN_FUNCTION nameIR < typeParameterListIR > ( parameterListIR ) (from externFunctionDef) 
   | EXTERN_METHOD nameIR < typeParameterListIR > ( parameterListIR ) blockStatementIR? (from externMethodDef) 
   | EXTERN_METHOD ABSTRACT nameIR < typeParameterListIR > ( parameterListIR ) (from externMethodDef) 
   | PARSER_APPLY ( parameterListIR ) { parserLocalDeclarationListIR ; stateEnv } (from parserApplyMethodDef) 
   | CONTROL_APPLY ( parameterListIR ) { controlLocalDeclarationListIR ; actionDefEnv ; controlBodyIR } (from controlApplyMethodDef) 
   | TABLE_APPLY { tablePropertyListIR } (from tableApplyMethodDef) 

def $parameterListIR_of_callableDef(callableDef) : parameterIR* =

  clause 0 : (callableDef) = $parameterListIR_of_actionDef(actionDef)
  -- if callableDef <: actionDef
  -- let actionDef = callableDef as actionDef

  clause 1 : (callableDef) = $parameterListIR_of_functionDef(functionDef)
  -- if callableDef <: functionDef
  -- let functionDef = callableDef as functionDef

  clause 2 : (callableDef) = $parameterListIR_of_methodDef(methodDef)
  -- if callableDef <: methodDef
  -- let methodDef = callableDef as methodDef

def $parameterListIR_of_actionDef(actionDef) : parameterIR* =

  clause 0 : (annotationList ACTION _nameIR ( parameterListIR ) _blockStatementIR) = parameterListIR

def $parameterListIR_of_functionDef(functionDef) : parameterIR* =

  clause 0 : (functionDef) = $parameterListIR_of_definedFunctionDef(definedFunctionDef)
  -- if functionDef <: definedFunctionDef
  -- let definedFunctionDef = functionDef as definedFunctionDef

  clause 1 : (functionDef) = $parameterListIR_of_externFunctionDef(externFunctionDef)
  -- if functionDef <: externFunctionDef
  -- let externFunctionDef = functionDef as externFunctionDef

def $parameterListIR_of_definedFunctionDef(definedFunctionDef) : parameterIR* =

  clause 0 : (FUNCTION _nameIR < _typeParameterListIR > ( parameterListIR ) _blockStatementIR) = parameterListIR

def $parameterListIR_of_externFunctionDef(externFunctionDef) : parameterIR* =

  clause 0 : (EXTERN_FUNCTION _nameIR < _typeParameterListIR > ( parameterListIR )) = parameterListIR

def $parameterListIR_of_methodDef(methodDef) : parameterIR* =

  clause 0 : (methodDef) = $parameterListIR_of_externMethodDef(externMethodDef)
  -- if methodDef <: externMethodDef
  -- let externMethodDef = methodDef as externMethodDef

  clause 1 : (methodDef) = $parameterListIR_of_parserApplyMethodDef(parserApplyMethodDef)
  -- if methodDef <: parserApplyMethodDef
  -- let parserApplyMethodDef = methodDef as parserApplyMethodDef

  clause 2 : (methodDef) = $parameterListIR_of_controlApplyMethodDef(controlApplyMethodDef)
  -- if methodDef <: controlApplyMethodDef
  -- let controlApplyMethodDef = methodDef as controlApplyMethodDef

  clause 3 : (methodDef) = $parameterListIR_of_tableApplyMethodDef(tableApplyMethodDef)
  -- if methodDef <: tableApplyMethodDef
  -- let tableApplyMethodDef = methodDef as tableApplyMethodDef

def $parameterListIR_of_externMethodDef(externMethodDef) : parameterIR* =

  clause 0 : (externMethodDef) = parameterListIR
  -- if externMethodDef matches `EXTERN_METHOD % <%> (%) %`
  -- let EXTERN_METHOD _nameIR < _typeParameterListIR > ( parameterListIR ) _blockStatementIR?{_blockStatementIR <- _blockStatementIR?} = externMethodDef

def $parameterListIR_of_parserApplyMethodDef(parserApplyMethodDef) : parameterIR* =

  clause 0 : (PARSER_APPLY ( parameterListIR ) { _parserLocalDeclarationListIR ; _stateEnv }) = parameterListIR

def $parameterListIR_of_controlApplyMethodDef(controlApplyMethodDef) : parameterIR* =

  clause 0 : (CONTROL_APPLY ( parameterListIR ) { _controlLocalDeclarationListIR ; _actionDefEnv ; _controlBodyIR }) = parameterListIR

def $parameterListIR_of_tableApplyMethodDef(tableApplyMethodDef) : parameterIR* =

  clause 0 : (TABLE_APPLY { _tablePropertyListIR }) = []

syntax actionCallee = 
   | ACTION cursor . nameIR ( parameterListIR # id* ) blockStatementIR (from actionCallee) 

syntax definedFunctionCallee = 
   | FUNCTION nameIR < typeParameterListIR > ( parameterListIR # id* ) blockStatementIR (from definedFunctionCallee) 

syntax externFunctionCallee = 
   | EXTERN_FUNCTION nameIR < typeParameterListIR > ( parameterListIR # id* # id* ) (from externFunctionCallee) 

syntax functionCallee = 
   | FUNCTION nameIR < typeParameterListIR > ( parameterListIR # id* ) blockStatementIR (from definedFunctionCallee) 
   | EXTERN_FUNCTION nameIR < typeParameterListIR > ( parameterListIR # id* # id* ) (from externFunctionCallee) 

syntax builtinMethodCallee = 
   | BUILTIN_METHOD storageReference . nameIR < typeArgumentListIR > ( parameterListIR ) (from builtinMethodCallee) 

syntax externMethodCallee = 
   | EXTERN_METHOD objectId . nameIR < typeParameterListIR > ( parameterListIR # id* # id* ) { theta ; frame ; blockStatementIR? } (from externMethodCallee) 

syntax parserApplyMethodCallee = 
   | PARSER objectId . APPLY ( parameterListIR # id* ) { theta ; frame ; parserLocalDeclarationListIR ; stateEnv } (from parserApplyMethodCallee) 

syntax controlApplyMethodCallee = 
   | CONTROL objectId . APPLY ( parameterListIR # id* ) { theta ; frame ; controlLocalDeclarationListIR ; actionDefEnv ; controlBodyIR } (from controlApplyMethodCallee) 

syntax tableApplyMethodCallee = 
   | TABLE objectId . APPLY { frame ; tableObjectProperty } (from tableApplyMethodCallee) 

syntax methodCallee = 
   | BUILTIN_METHOD storageReference . nameIR < typeArgumentListIR > ( parameterListIR ) (from builtinMethodCallee) 
   | EXTERN_METHOD objectId . nameIR < typeParameterListIR > ( parameterListIR # id* # id* ) { theta ; frame ; blockStatementIR? } (from externMethodCallee) 
   | PARSER objectId . APPLY ( parameterListIR # id* ) { theta ; frame ; parserLocalDeclarationListIR ; stateEnv } (from parserApplyMethodCallee) 
   | CONTROL objectId . APPLY ( parameterListIR # id* ) { theta ; frame ; controlLocalDeclarationListIR ; actionDefEnv ; controlBodyIR } (from controlApplyMethodCallee) 
   | TABLE objectId . APPLY { frame ; tableObjectProperty } (from tableApplyMethodCallee) 

syntax callee = 
   | ACTION cursor . nameIR ( parameterListIR # id* ) blockStatementIR (from actionCallee) 
   | FUNCTION nameIR < typeParameterListIR > ( parameterListIR # id* ) blockStatementIR (from definedFunctionCallee) 
   | EXTERN_FUNCTION nameIR < typeParameterListIR > ( parameterListIR # id* # id* ) (from externFunctionCallee) 
   | BUILTIN_METHOD storageReference . nameIR < typeArgumentListIR > ( parameterListIR ) (from builtinMethodCallee) 
   | EXTERN_METHOD objectId . nameIR < typeParameterListIR > ( parameterListIR # id* # id* ) { theta ; frame ; blockStatementIR? } (from externMethodCallee) 
   | PARSER objectId . APPLY ( parameterListIR # id* ) { theta ; frame ; parserLocalDeclarationListIR ; stateEnv } (from parserApplyMethodCallee) 
   | CONTROL objectId . APPLY ( parameterListIR # id* ) { theta ; frame ; controlLocalDeclarationListIR ; actionDefEnv ; controlBodyIR } (from controlApplyMethodCallee) 
   | TABLE objectId . APPLY { frame ; tableObjectProperty } (from tableApplyMethodCallee) 

syntax externObjectConstructorDef = 
   | EXTERN nameIR < typeParameterListIR > ( constructorParameterListIR ) { externMethodPrototypeListIR } (from externObjectConstructorDef) 

syntax parserObjectConstructorDef = 
   | PARSER < typeParameterListIR > ( parameterListIR ) ( constructorParameterListIR ) { parserLocalDeclarationListIR parserStateListIR } (from parserObjectConstructorDef) 

syntax controlObjectConstructorDef = 
   | CONTROL < typeParameterListIR > ( parameterListIR ) ( constructorParameterListIR ) { controlLocalDeclarationListIR APPLY controlBodyIR } (from controlObjectConstructorDef) 

syntax packageObjectConstructorDef = 
   | PACKAGE < typeParameterListIR > ( constructorParameterListIR ) (from packageObjectConstructorDef) 

syntax constructorDef = 
   | EXTERN nameIR < typeParameterListIR > ( constructorParameterListIR ) { externMethodPrototypeListIR } (from externObjectConstructorDef) 
   | PARSER < typeParameterListIR > ( parameterListIR ) ( constructorParameterListIR ) { parserLocalDeclarationListIR parserStateListIR } (from parserObjectConstructorDef) 
   | CONTROL < typeParameterListIR > ( parameterListIR ) ( constructorParameterListIR ) { controlLocalDeclarationListIR APPLY controlBodyIR } (from controlObjectConstructorDef) 
   | PACKAGE < typeParameterListIR > ( constructorParameterListIR ) (from packageObjectConstructorDef) 

def $parameterListIR_of_constructorDef(constructorDef) : parameterIR* =

  clause 0 : (constructorDef) = constructorParameterListIR
  -- if constructorDef <: externObjectConstructorDef
  -- let EXTERN _nameIR < _typeParameterListIR > ( constructorParameterListIR ) { _externMethodPrototypeListIR } = constructorDef as externObjectConstructorDef

  clause 1 : (constructorDef) = constructorParameterListIR
  -- if constructorDef <: parserObjectConstructorDef
  -- let PARSER < _typeParameterListIR > ( _parameterListIR ) ( constructorParameterListIR ) { _parserLocalDeclarationListIR _parserStateListIR } = constructorDef as parserObjectConstructorDef

  clause 2 : (constructorDef) = constructorParameterListIR
  -- if constructorDef <: controlObjectConstructorDef
  -- let CONTROL < _typeParameterListIR > ( _parameterListIR ) ( constructorParameterListIR ) { _controlLocalDeclarationListIR APPLY _controlBodyIR } = constructorDef as controlObjectConstructorDef

  clause 3 : (constructorDef) = constructorParameterListIR
  -- if constructorDef <: packageObjectConstructorDef
  -- let PACKAGE < _typeParameterListIR > ( constructorParameterListIR ) = constructorDef as packageObjectConstructorDef

extern syntax objectState

syntax externMethodDefEnv = map<callableId, externMethodDef>

extern def $init_objectState(nameIR, typeIR*, value*) : objectState

syntax externObject = 
   | EXTERN typeId < theta > { objectState frame externMethodDefEnv } (from externObject) 

syntax parserObject = 
   | PARSER < theta > ( parameterListIR ) { frame parserLocalDeclarationListIR stateEnv } (from parserObject) 

syntax actionDefEnv = map<callableId, actionDef>

syntax controlObject = 
   | CONTROL < theta > ( parameterListIR ) { frame controlLocalDeclarationListIR actionDefEnv controlBodyIR } (from controlObject) 

syntax packageObject = 
   | PACKAGE < theta > { frame } (from packageObject) 

syntax tableObjectProperty = {KEYS tableKeysPropertyIR, ACTIONS tableActionsPropertyIR, DEFAULT_ACTION tableDefaultActionPropertyIR, ENTRIES tableEntriesPropertyIR, CUSTOMS tableCustomPropertyIR*}

var TBL : tableObjectProperty

syntax tableObject = 
   | TABLE typeId { frame tableObjectProperty } (from tableObject) 

syntax valueSetObject = 
   | VALUE_SET { value* ( nat ) } (from valueSetObject) 

syntax object = 
   | EXTERN typeId < theta > { objectState frame externMethodDefEnv } (from externObject) 
   | PARSER < theta > ( parameterListIR ) { frame parserLocalDeclarationListIR stateEnv } (from parserObject) 
   | CONTROL < theta > ( parameterListIR ) { frame controlLocalDeclarationListIR actionDefEnv controlBodyIR } (from controlObject) 
   | PACKAGE < theta > { frame } (from packageObject) 
   | TABLE typeId { frame tableObjectProperty } (from tableObject) 
   | VALUE_SET { value* ( nat ) } (from valueSetObject) 

syntax frame = map<id, value>

def $empty_frame : frame =

  clause 0 :  = $empty_map<id, value>

syntax stateEnv = map<id, parserStateIR>

def $empty_stateEnv : stateEnv =

  clause 0 :  = $empty_map<id, parserStateIR>

syntax callableDefEnv = map<callableId, callableDef>

def $empty_callableDefEnv : callableDefEnv =

  clause 0 :  = $empty_map<callableId, callableDef>

syntax constructorDefEnv = map<callableId, constructorDef>

def $empty_constructorDefEnv : constructorDefEnv =

  clause 0 :  = $empty_map<callableId, constructorDef>

syntax store = map<objectId, object>

var STO : store

def $empty_store : store =

  clause 0 :  = store
  -- let store = $empty_map<objectId, object>

def $add_store(store, objectId, object) : store =

  clause 0 : (store, objectId, object) = store'
  -- let store' = $add_map<objectId, object>(store, objectId, object)

def $find_store(store, objectId) : object =

  clause 0 : (store, objectId) = object
  -- let object'?{object' <- object'?} = $find_map<objectId, object>(store, objectId)
  -- if object'?{object' <- object'?} matches (_)
  -- let ?(object) = object'?{object' <- object'?}

syntax globalInstLayer = {CONSTRUCTOR constructorDefEnv, TYPE typeDefEnv, CALLABLE callableDefEnv, FRAME frame}

syntax blockInstLayer = {TYPE theta, CALLABLE callableDefEnv, STATE stateEnv, FRAME frame}

syntax localInstLayer = {TYPE theta, FRAMES frame*}

syntax instContext = {PATH objectId, GLOBAL globalInstLayer, BLOCK blockInstLayer, LOCAL localInstLayer}

var IC : instContext

def $empty_instContext : instContext =

  clause 0 :  = IC
  -- let globalInstLayer = {CONSTRUCTOR $empty_constructorDefEnv, TYPE $empty_typeDefEnv, CALLABLE $empty_callableDefEnv, FRAME $empty_frame}
  -- let blockInstLayer = {TYPE $empty_theta, CALLABLE $empty_callableDefEnv, STATE $empty_stateEnv, FRAME $empty_frame}
  -- let localInstLayer = {TYPE $empty_theta, FRAMES [$empty_frame]}
  -- let IC = {PATH [], GLOBAL globalInstLayer, BLOCK blockInstLayer, LOCAL localInstLayer}

def $enter_i(instContext) : instContext =

  clause 0 : (IC) = IC[LOCAL.FRAMES = $empty_frame :: IC.LOCAL.FRAMES]

def $exit_i(instContext) : instContext =

  clause 0 : (IC) = IC[LOCAL.FRAMES = frame_t*{frame_t <- frame_t*}]
  -- let frame*{frame <- frame*} = IC.LOCAL.FRAMES
  -- if frame*{frame <- frame*} matches _ :: _
  -- let frame_h :: frame_t*{frame_t <- frame_t*} = frame*{frame <- frame*}

def $enter_path_i(instContext, id) : instContext =

  clause 0 : (IC, id) = IC[PATH = IC.PATH ++ [id]]

def $inherit_i(cursor, instContext) : instContext =

  clause 0 : (p, IC) = IC[BLOCK = blockInstLayer][LOCAL = localInstLayer]
  -- if p matches `GLOBAL`
  -- let blockInstLayer = {TYPE $empty_theta, CALLABLE $empty_callableDefEnv, STATE $empty_stateEnv, FRAME $empty_frame}
  -- let localInstLayer = {TYPE $empty_theta, FRAMES [$empty_frame]}

  clause 1 : (p, IC) = IC[LOCAL = localInstLayer]
  -- if p matches `BLOCK`
  -- let localInstLayer = {TYPE $empty_theta, FRAMES [$empty_frame]}

  clause 2 : (p, IC) = IC
  -- if p matches `LOCAL`

def $add_var_i(cursor, instContext, id, value) : instContext =

  clause 0 : (p, IC, id, value) = IC[GLOBAL.FRAME = frame]
  -- if p matches `GLOBAL`
  -- if ~$in_set<id>(id, $dom_map<id, value>(IC.GLOBAL.FRAME))
  -- let frame = $add_map<id, value>(IC.GLOBAL.FRAME, id, value)

  clause 1 : (p, IC, id, value) = IC[BLOCK.FRAME = frame]
  -- if p matches `BLOCK`
  -- if ~$in_set<id>(id, $dom_map<id, value>(IC.BLOCK.FRAME))
  -- let frame = $add_map<id, value>(IC.BLOCK.FRAME, id, value)

  clause 2 : (p, IC, id, value) = IC[LOCAL.FRAMES = frame_h' :: frame_t*{frame_t <- frame_t*}]
  -- if p matches `LOCAL`
  -- let frame*{frame <- frame*} = IC.LOCAL.FRAMES
  -- if frame*{frame <- frame*} matches _ :: _
  -- let frame_h :: frame_t*{frame_t <- frame_t*} = frame*{frame <- frame*}
  -- if ~$in_set<id>(id, $dom_map<id, value>(frame_h))
  -- let frame_h' = $add_map<id, value>(frame_h, id, value)

def $add_vars_i(cursor, instContext, id*, value*) : instContext =

  clause 0 : (p, IC, id*{id <- id*}, value*{value <- value*}) = IC
  -- if id*{id <- id*} matches []
  -- if value*{value <- value*} matches []

  clause 1 : (p, IC, id*{id <- id*}, value*{value <- value*}) = IC''
  -- if id*{id <- id*} matches _ :: _
  -- let id_h :: id_t*{id_t <- id_t*} = id*{id <- id*}
  -- if value*{value <- value*} matches _ :: _
  -- let value_h :: value_t*{value_t <- value_t*} = value*{value <- value*}
  -- let IC' = $add_var_i(p, IC, id_h, value_h)
  -- let IC'' = $add_vars_i(p, IC', id_t*{id_t <- id_t*}, value_t*{value_t <- value_t*})

def $add_typeDef_i(cursor, instContext, typeId, typeDefIR) : instContext =

  clause 0 : (p, IC, typeId, typeDefIR) = IC[GLOBAL.TYPE = typeDefEnv]
  -- if p matches `GLOBAL`
  -- let typeDefEnv = $add_map<typeId, typeDefIR>(IC.GLOBAL.TYPE, typeId, typeDefIR)

def $add_parserState_i(instContext, nameIR, parserStateIR) : instContext =

  clause 0 : (IC, nameIR, parserStateIR) = IC[BLOCK.STATE = stateEnv]
  -- if ~$in_set<nameIR>(nameIR, $dom_map<nameIR, parserStateIR>(IC.BLOCK.STATE))
  -- let stateEnv = $add_map<nameIR, parserStateIR>(IC.BLOCK.STATE, nameIR, parserStateIR)

def $add_type_i(cursor, instContext, typeId, typeIR) : instContext =

  clause 0 : (p, IC, typeId, typeIR) = IC[BLOCK.TYPE = theta]
  -- if p matches `BLOCK`
  -- let theta = $add_map<typeId, typeIR>(IC.BLOCK.TYPE, typeId, typeIR)

  clause 1 : (p, IC, typeId, typeIR) = IC[LOCAL.TYPE = theta]
  -- if p matches `LOCAL`
  -- let theta = $add_map<typeId, typeIR>(IC.LOCAL.TYPE, typeId, typeIR)

def $add_types_i(cursor, instContext, typeId*, typeIR*) : instContext =

  clause 0 : (p, IC, typeId*{typeId <- typeId*}, typeIR*{typeIR <- typeIR*}) = IC
  -- if typeId*{typeId <- typeId*} matches []
  -- if typeIR*{typeIR <- typeIR*} matches []

  clause 1 : (p, IC, typeId*{typeId <- typeId*}, typeIR*{typeIR <- typeIR*}) = $add_types_i(p, IC', typeId_t*{typeId_t <- typeId_t*}, typeIR_t*{typeIR_t <- typeIR_t*})
  -- if typeId*{typeId <- typeId*} matches _ :: _
  -- let typeId_h :: typeId_t*{typeId_t <- typeId_t*} = typeId*{typeId <- typeId*}
  -- if typeIR*{typeIR <- typeIR*} matches _ :: _
  -- let typeIR_h :: typeIR_t*{typeIR_t <- typeIR_t*} = typeIR*{typeIR <- typeIR*}
  -- let IC' = $add_type_i(p, IC, typeId_h, typeIR_h)

def $add_callableDef_overload_i(cursor, instContext, callableId, callableDef) : instContext =

  clause 0 : (p, IC, callableId, callableDef) = IC[GLOBAL.CALLABLE = callableDefEnv]
  -- if p matches `GLOBAL`
  -- if ~$in_set<callableId>(callableId, $dom_map<callableId, callableDef>(IC.GLOBAL.CALLABLE))
  -- let callableDefEnv = $add_map<callableId, callableDef>(IC.GLOBAL.CALLABLE, callableId, callableDef)

  clause 1 : (p, IC, callableId, callableDef) = IC[BLOCK.CALLABLE = callableDefEnv]
  -- if p matches `BLOCK`
  -- if ~$in_set<callableId>(callableId, $dom_map<callableId, callableDef>(IC.BLOCK.CALLABLE))
  -- let callableDefEnv = $add_map<callableId, callableDef>(IC.BLOCK.CALLABLE, callableId, callableDef)

def $add_callableDef_non_overload_i(cursor, instContext, callableId, callableDef) : instContext =

  clause 0 : (p, IC, callableId, callableDef) = IC[GLOBAL.CALLABLE = callableDefEnv]
  -- if p matches `GLOBAL`
  -- let id ( _id*{_id <- _id*} ) = callableId
  -- let { id_k ( _id'*{_id' <- _id'*} )*{_id'* <- _id'**, id_k <- id_k*} } = $dom_map<callableId, callableDef>(IC.GLOBAL.CALLABLE)
  -- if ~$in_set<id>(id, { id_k*{id_k <- id_k*} })
  -- let callableDefEnv = $add_map<callableId, callableDef>(IC.GLOBAL.CALLABLE, callableId, callableDef)

  clause 1 : (p, IC, callableId, callableDef) = IC[BLOCK.CALLABLE = callableDefEnv]
  -- if p matches `BLOCK`
  -- let id ( _id*{_id <- _id*} ) = callableId
  -- let { id_k ( _id'*{_id' <- _id'*} )*{_id'* <- _id'**, id_k <- id_k*} } = $dom_map<callableId, callableDef>(IC.BLOCK.CALLABLE)
  -- if ~$in_set<id>(id, { id_k*{id_k <- id_k*} })
  -- let callableDefEnv = $add_map<callableId, callableDef>(IC.BLOCK.CALLABLE, callableId, callableDef)

def $find_callableDef_non_overload_i(cursor, instContext, prefixedNameIR) : (cursor, callableId, callableDef)? =

  clause 0 : (p, IC, prefixedNameIR) = ?()
  -- if prefixedNameIR matches `. %`
  -- let . nameIR = prefixedNameIR
  -- if (?() = $find_non_overloaded<callableDef>(IC.GLOBAL.CALLABLE, nameIR))

  clause 1 : (p, IC, prefixedNameIR) = ?((GLOBAL, callableId, callableDef))
  -- if prefixedNameIR matches `. %`
  -- let . nameIR = prefixedNameIR
  -- let (callableId, callableDef)?{(callableId, callableDef) <- (callableId, callableDef)?} = $find_non_overloaded<callableDef>(IC.GLOBAL.CALLABLE, nameIR)
  -- if (callableId, callableDef)?{(callableId, callableDef) <- (callableId, callableDef)?} matches (_)
  -- let ?((callableId, callableDef)) = (callableId, callableDef)?{(callableId, callableDef) <- (callableId, callableDef)?}

  clause 2 : (p, IC, prefixedNameIR) = $find_callableDef_non_overload_i(GLOBAL, IC, . nameIR)
  -- if p matches `GLOBAL`
  -- if prefixedNameIR matches `` %`
  -- let ` nameIR = prefixedNameIR

  clause 3 : (p, IC, prefixedNameIR) = ?((BLOCK, callableId, callableDef))
  -- if p matches `BLOCK`
  -- if prefixedNameIR matches `` %`
  -- let ` nameIR = prefixedNameIR
  -- let (callableId, callableDef)?{(callableId, callableDef) <- (callableId, callableDef)?} = $find_non_overloaded<callableDef>(IC.BLOCK.CALLABLE, nameIR)
  -- if (callableId, callableDef)?{(callableId, callableDef) <- (callableId, callableDef)?} matches (_)
  -- let ?((callableId, callableDef)) = (callableId, callableDef)?{(callableId, callableDef) <- (callableId, callableDef)?}

  clause 4 : (p, IC, prefixedNameIR) = $find_callableDef_non_overload_i(GLOBAL, IC, ` nameIR)
  -- if p matches `BLOCK`
  -- if prefixedNameIR matches `` %`
  -- let ` nameIR = prefixedNameIR
  -- if (?() = $find_non_overloaded<callableDef>(IC.BLOCK.CALLABLE, nameIR))

  clause 5 : (p, IC, prefixedNameIR) = $find_callableDef_non_overload_i(BLOCK, IC, ` nameIR)
  -- if p matches `LOCAL`
  -- if prefixedNameIR matches `` %`
  -- let ` nameIR = prefixedNameIR

def $add_constructorDef_i(instContext, callableId, constructorDef) : instContext =

  clause 0 : (IC, callableId, constructorDef) = IC[GLOBAL.CONSTRUCTOR = constructorDefEnv]
  -- let constructorDefEnv = $add_map<callableId, constructorDef>(IC.GLOBAL.CONSTRUCTOR, callableId, constructorDef)

def $add_constructorDefs_i(instContext, callableId*, constructorDef*) : instContext =

  clause 0 : (IC, callableId*{callableId <- callableId*}, constructorDef*{constructorDef <- constructorDef*}) = IC
  -- if callableId*{callableId <- callableId*} matches []
  -- if constructorDef*{constructorDef <- constructorDef*} matches []

  clause 1 : (IC, callableId*{callableId <- callableId*}, constructorDef*{constructorDef <- constructorDef*}) = IC''
  -- if callableId*{callableId <- callableId*} matches _ :: _
  -- let callableId_h :: callableId_t*{callableId_t <- callableId_t*} = callableId*{callableId <- callableId*}
  -- if constructorDef*{constructorDef <- constructorDef*} matches _ :: _
  -- let constructorDef_h :: constructorDef_t*{constructorDef_t <- constructorDef_t*} = constructorDef*{constructorDef <- constructorDef*}
  -- let IC' = $add_constructorDef_i(IC, callableId_h, constructorDef_h)
  -- let IC'' = $add_constructorDefs_i(IC', callableId_t*{callableId_t <- callableId_t*}, constructorDef_t*{constructorDef_t <- constructorDef_t*})

def $find_var_i(prefixedNameIR, cursor, instContext) : value =

  clause 0 : (prefixedNameIR, p, IC) = value
  -- if prefixedNameIR matches `. %`
  -- let . id = prefixedNameIR
  -- let value'?{value' <- value'?} = $find_map<id, value>(IC.GLOBAL.FRAME, id)
  -- if value'?{value' <- value'?} matches (_)
  -- let ?(value) = value'?{value' <- value'?}

  clause 1 : (prefixedNameIR, p, IC) = value
  -- if prefixedNameIR matches `` %`
  -- let ` id = prefixedNameIR
  -- if p matches `GLOBAL`
  -- let value'?{value' <- value'?} = $find_map<id, value>(IC.GLOBAL.FRAME, id)
  -- if value'?{value' <- value'?} matches (_)
  -- let ?(value) = value'?{value' <- value'?}

  clause 2 : (prefixedNameIR, p, IC) = value
  -- if prefixedNameIR matches `` %`
  -- let ` id = prefixedNameIR
  -- if p matches `BLOCK`
  -- let value'?{value' <- value'?} = $find_map<id, value>(IC.BLOCK.FRAME, id)
  -- if value'?{value' <- value'?} matches (_)
  -- let ?(value) = value'?{value' <- value'?}

  clause 3 : (prefixedNameIR, p, IC) = $find_var_i(` id, GLOBAL, IC)
  -- if prefixedNameIR matches `` %`
  -- let ` id = prefixedNameIR
  -- if p matches `BLOCK`
  -- if (?() = $find_map<id, value>(IC.BLOCK.FRAME, id))

  clause 4 : (prefixedNameIR, p, IC) = value
  -- if prefixedNameIR matches `` %`
  -- let ` id = prefixedNameIR
  -- if p matches `LOCAL`
  -- let value'?{value' <- value'?} = $find_maps<id, value>(IC.LOCAL.FRAMES, id)
  -- if value'?{value' <- value'?} matches (_)
  -- let ?(value) = value'?{value' <- value'?}

  clause 5 : (prefixedNameIR, p, IC) = $find_var_i(` id, BLOCK, IC)
  -- if prefixedNameIR matches `` %`
  -- let ` id = prefixedNameIR
  -- if p matches `LOCAL`
  -- if (?() = $find_maps<id, value>(IC.LOCAL.FRAMES, id))

def $find_typeDef_i(cursor, instContext, prefixedNameIR) : typeDefIR? =

  clause 0 : (_p, IC, prefixedNameIR) = $find_map<typeId, typeDefIR>(IC.GLOBAL.TYPE, nameIR)
  -- if prefixedNameIR matches `` %`
  -- let ` nameIR = prefixedNameIR

  clause 1 : (_p, IC, prefixedNameIR) = $find_map<typeId, typeDefIR>(IC.GLOBAL.TYPE, nameIR)
  -- if prefixedNameIR matches `. %`
  -- let . nameIR = prefixedNameIR

def $find_constructorDef_i(instContext, prefixedNameIR, argumentIR*) : callResolution<constructorDef>? =

  clause 0 : (IC, prefixedNameIR, argumentIR*{argumentIR <- argumentIR*}) = $find_overloaded<constructorDef>(IC.GLOBAL.CONSTRUCTOR, callTargetKey, $parameterListIR_of_constructorDef)
  -- if prefixedNameIR matches `` %`
  -- let ` nameIR = prefixedNameIR
  -- let callTargetKey = $callTargetKey(nameIR, argumentIR*{argumentIR <- argumentIR*})

  clause 1 : (IC, prefixedNameIR, argumentIR*{argumentIR <- argumentIR*}) = $find_overloaded<constructorDef>(IC.GLOBAL.CONSTRUCTOR, callTargetKey, $parameterListIR_of_constructorDef)
  -- if prefixedNameIR matches `. %`
  -- let . nameIR = prefixedNameIR
  -- let callTargetKey = $callTargetKey(nameIR, argumentIR*{argumentIR <- argumentIR*})

def $subst_type_i(cursor, instContext, typeIR) : typeIR =

  clause 0 : (p, IC, typeIR) = typeIR
  -- if p matches `GLOBAL`

  clause 1 : (p, IC, typeIR) = typeIR_subst
  -- if p matches `BLOCK`
  -- let theta = IC.BLOCK.TYPE
  -- let typeIR_subst = $subst_typeIR(theta, typeIR)

  clause 2 : (p, IC, typeIR) = typeIR_subst
  -- if p matches `LOCAL`
  -- let theta_block = IC.BLOCK.TYPE
  -- let theta_local = IC.LOCAL.TYPE
  -- let theta = $extend_map<typeId, typeIR>(theta_block, theta_local)
  -- let typeIR_subst = $subst_typeIR(theta, typeIR)

relation Expr_inst: cursor instContext store |- typedExpressionIR : store value

  rulegroup literalExpressionIR

    rule booleanLiteral: p IC STO |- booleanLiteral as expressionIR # _expressionNoteIR : STO boolValue as value
    -- if (boolValue = $ite<boolValue>((booleanLiteral = TRUE), `B true, `B false))

    rule integerLiteral: p IC STO |- integerLiteral as expressionIR # _expressionNoteIR : STO integerLiteral as value

    rule stringLiteral: p IC STO |- stringLiteral as expressionIR # _expressionNoteIR : STO stringLiteral as value

  rulegroup referenceExpressionIR

    rule referenceExpressionIR: p IC STO |- prefixedNameIR as expressionIR # _expressionNoteIR : STO value
    -- if (value = $find_var_i(prefixedNameIR, p, IC))

  rulegroup defaultExpressionIR

    rule defaultExpressionIR: p IC STO |- ... as expressionIR # _expressionNoteIR : STO DEFAULT as value

  rulegroup unaryExpressionIR

    rule unaryExpressionIR: p IC STO_0 |- unop typedExpressionIR as expressionIR # _expressionNoteIR : STO_1 $un_op(unop, value)
    -- Expr_inst: p IC STO_0 |- typedExpressionIR : STO_1 value

  rulegroup binaryExpressionIR

    rule non-short-circuit: p IC STO_0 |- typedExpressionIR_l binop typedExpressionIR_r as expressionIR # _expressionNoteIR : STO_2 $bin_op(binop, value_l, value_r)
    -- if ~binop <- [&&, ||]
    -- Expr_inst: p IC STO_0 |- typedExpressionIR_l : STO_1 value_l
    -- Expr_inst: p IC STO_1 |- typedExpressionIR_r : STO_2 value_r

    rule land-false: p IC STO_0 |- typedExpressionIR_l && typedExpressionIR_r as expressionIR # _expressionNoteIR : STO_1 `B false as value
    -- Expr_inst: p IC STO_0 |- typedExpressionIR_l : STO_1 `B false as value

    rule land-true: p IC STO_0 |- typedExpressionIR_l && typedExpressionIR_r as expressionIR # _expressionNoteIR : STO_2 value_r
    -- Expr_inst: p IC STO_0 |- typedExpressionIR_l : STO_1 `B true as value
    -- Expr_inst: p IC STO_1 |- typedExpressionIR_r : STO_2 value_r

    rule lor-true: p IC STO_0 |- typedExpressionIR_l || typedExpressionIR_r as expressionIR # _expressionNoteIR : STO_1 `B true as value
    -- Expr_inst: p IC STO_0 |- typedExpressionIR_l : STO_1 `B true as value

    rule lor-false: p IC STO_0 |- typedExpressionIR_l || typedExpressionIR_r as expressionIR # _expressionNoteIR : STO_2 value_r
    -- Expr_inst: p IC STO_0 |- typedExpressionIR_l : STO_1 `B false as value
    -- Expr_inst: p IC STO_1 |- typedExpressionIR_r : STO_2 value_r

  rulegroup ternaryExpressionIR

    rule true: p IC STO_0 |- typedExpressionIR_cond ? typedExpressionIR_true : typedExpressionIR_false as expressionIR # _expressionNoteIR : STO_2 value_true
    -- Expr_inst: p IC STO_0 |- typedExpressionIR_cond : STO_1 `B true as value
    -- Expr_inst: p IC STO_1 |- typedExpressionIR_true : STO_2 value_true

    rule false: p IC STO_0 |- typedExpressionIR_cond ? typedExpressionIR_true : typedExpressionIR_false as expressionIR # _expressionNoteIR : STO_2 value_false
    -- Expr_inst: p IC STO_0 |- typedExpressionIR_cond : STO_1 `B false as value
    -- Expr_inst: p IC STO_1 |- typedExpressionIR_false : STO_2 value_false

  rulegroup castExpressionIR

    rule castExpressionIR: p IC STO_0 |- ( typeIR ) typedExpressionIR as expressionIR # _expressionNoteIR : STO_1 value_cast
    -- Expr_inst: p IC STO_0 |- typedExpressionIR : STO_1 value
    -- if (value_cast = $cast_op(typeIR, value))

  rulegroup invalidHeaderExpressionIR

    rule invalidHeaderExpressionIR: p IC STO |- {#} as expressionIR # _expressionNoteIR : STO {#} as value

  rulegroup sequenceExpressionIR

    rule non-default: p IC STO_0 |- SEQ { typedExpressionListIR } as expressionIR # _expressionNoteIR : STO_1 SEQ ( value*{value <- value*} ) as value
    -- Exprs_inst: p IC STO_0 |- typedExpressionListIR : STO_1 value*{value <- value*}

    rule default: p IC STO_0 |- SEQ { typedExpressionListIR , ... } as expressionIR # _expressionNoteIR : STO_1 SEQ ( value*{value <- value*} , ... ) as value
    -- Exprs_inst: p IC STO_0 |- typedExpressionListIR : STO_1 value*{value <- value*}

  rulegroup recordExpressionIR

    rule non-default: p IC STO_0 |- RECORD { nameIR = typedExpressionIR*{nameIR <- nameIR*, typedExpressionIR <- typedExpressionIR*} } as expressionIR # _expressionNoteIR : STO_1 RECORD { value nameIR ;*{nameIR <- nameIR*, value <- value*} } as value
    -- Exprs_inst: p IC STO_0 |- typedExpressionIR*{typedExpressionIR <- typedExpressionIR*} : STO_1 value*{value <- value*}

    rule default: p IC STO_0 |- RECORD { nameIR = typedExpressionIR*{nameIR <- nameIR*, typedExpressionIR <- typedExpressionIR*} , ... } as expressionIR # _expressionNoteIR : STO_1 RECORD { value nameIR ;*{nameIR <- nameIR*, value <- value*} , ... } as value
