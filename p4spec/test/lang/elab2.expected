    rule definedFunctionCallee: p EC ARCH |- referenceExpressionIR as callableTargetIR < _ > ( argumentListIR ) : EC ARCH ` definedFunctionCallee as callee as calleeResult
    -- if (?(_callableId : (_p, definedFunctionDef as callableDef) # id_default*{id_default <- id_default*} # _nameIR*{_nameIR <- _nameIR*}) = $find_callableDef_overloaded_e(p, EC, referenceExpressionIR, argumentListIR))
