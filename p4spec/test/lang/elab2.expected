  clause 0 : (dataExpressionIR) = {#} as dataExpression
  -- if dataExpressionIR <: invalidHeaderExpression
  -- let invalidHeaderExpression = dataExpressionIR as invalidHeaderExpression
  -- if (invalidHeaderExpression = {#})

  clause 1 : (dataExpressionIR) = { expressionList as sequenceOrRecordElementExpression `EMPTY } as dataExpression
