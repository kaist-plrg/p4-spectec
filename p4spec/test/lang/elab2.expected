def $is_valid_bitslice(typeIR, nat, nat) : bool =

  clause 0 : (typeIR, n_lo, n_hi) = (n_lo <= n_hi)
  -- if typeIR <: intTypeIR
  -- let intTypeIR = typeIR as intTypeIR
  -- if (intTypeIR = INT)

  clause 1 : (typeIR, n_lo, n_hi) = (((n_lo <= n_hi) /\ (n_hi <= w)) /\ (w_slice <= w))
  -- if typeIR <: fixedIntTypeIR
  -- let INT < w > = typeIR as fixedIntTypeIR
  -- let i = ((n_hi - n_lo) + 1 as int)
  -- if i <: nat
  -- let w_slice = i as nat

  clause 2 : (typeIR, n_lo, n_hi) = (((n_lo <= n_hi) /\ (n_hi <= w)) /\ (w_slice <= w))
  -- if typeIR <: fixedBitTypeIR
  -- let BIT < w > = typeIR as fixedBitTypeIR
  -- let i = ((n_hi - n_lo) + 1 as int)
  -- if i <: nat
  -- let w_slice = i as nat

  clause 3 : (typeIR', n_lo, n_hi) = $is_valid_bitslice(typeIR, n_lo, n_hi)
  -- if typeIR' <: typedefTypeIR
  -- let TYPEDEF _typeId typeIR = typeIR' as typedefTypeIR

  clause -1 : (_typeIR, _nat, _nat') = false

def $is_concrete_extern_object(typeIR) : bool =

  clause 0 : (typeIR) = $is_concrete_extern_object'($unroll_typeIR(typeIR))

def $is_concrete_extern_object'(typeIR) : bool =

  clause 0 : (typeIR) = true
  -- if ~typeIR <: externObjectTypeIR

  clause 1 : (typeIR) = true
  -- if typeIR <: externObjectTypeIR
  -- let EXTERN _typeId < _typeArgumentIR*{_typeArgumentIR <- _typeArgumentIR*} > { _callableId : externMethodTypeDefIR*{_callableId <- _callableId*, externMethodTypeDefIR <- externMethodTypeDefIR*} } = typeIR as externObjectTypeIR
  -- (if $is_concrete_extern_object''(externMethodTypeDefIR))*{externMethodTypeDefIR <- externMethodTypeDefIR*}

  clause -1 : (typeIR) = false

def $is_concrete_extern_object''(externMethodTypeDefIR) : bool =

  clause 0 : (externMethodTypeDefIR) = true
  -- if externMethodTypeDefIR matches `EXTERN_METHOD % <% , %> (%) : %`
  -- let EXTERN_METHOD _nameIR < _typeParameterIR*{_typeParameterIR <- _typeParameterIR*} , _typeParameterIR'*{_typeParameterIR' <- _typeParameterIR'*} > ( _parameterIR*{_parameterIR <- _parameterIR*} ) : _typeIR = externMethodTypeDefIR

  clause -1 : (externMethodTypeDefIR) = false

relation Parameters_ok: cursor typingContext |- parameter* : typingContext parameterListIR # typeId*

  rulegroup 

    rule nil: p TC |- [] : TC [] # []

    rule cons: p TC_0 |- parameter_h :: parameter_t*{parameter_t <- parameter_t*} : TC_2 parameterIR*{parameterIR <- parameterIR*} # typeId_fresh*{typeId_fresh <- typeId_fresh*}
    -- Parameter_ok: p TC_0 |- parameter_h : TC_1 parameterIR_h # typeId_fresh_h*{typeId_fresh_h <- typeId_fresh_h*}
    -- Parameters_ok: p TC_1 |- parameter_t*{parameter_t <- parameter_t*} : TC_2 parameterIR_t*{parameterIR_t <- parameterIR_t*} # typeId_fresh_t*{typeId_fresh_t <- typeId_fresh_t*}
    -- if (parameterIR*{parameterIR <- parameterIR*} = parameterIR_h :: parameterIR_t*{parameterIR_t <- parameterIR_t*})
    -- if (typeId_fresh*{typeId_fresh <- typeId_fresh*} = typeId_fresh_h*{typeId_fresh_h <- typeId_fresh_h*} ++ typeId_fresh_t*{typeId_fresh_t <- typeId_fresh_t*})

relation ForUpdateStmt_ok: typingContext |- forUpdateStatement : forUpdateStatementIR

  rulegroup 

    rule call-no-typeArgumentList: TC |- lvalue_callable ( argumentList ) : callableTargetIR < typeArgumentIR*{typeArgumentIR <- typeArgumentIR*} > ( argumentIR*{argumentIR <- argumentIR*} )
    -- Stmt_ok: LOCAL TC |- lvalue_callable ( argumentList ) ; as statement : _TC callableTargetIR < typeArgumentIR*{typeArgumentIR <- typeArgumentIR*} > ( argumentIR*{argumentIR <- argumentIR*} ) ; as statementIR

    rule call-typeArgumentList: TC |- lvalue_callable < typeArgumentList > ( argumentList ) : callableTargetIR < typeArgumentIR*{typeArgumentIR <- typeArgumentIR*} > ( argumentIR*{argumentIR <- argumentIR*} )
    -- Stmt_ok: LOCAL TC |- lvalue_callable < typeArgumentList > ( argumentList ) ; as statement : _TC callableTargetIR < typeArgumentIR*{typeArgumentIR <- typeArgumentIR*} > ( argumentIR*{argumentIR <- argumentIR*} ) ; as statementIR

    rule assign: TC |- lvalue assignop expression : typedLvalueIR assignop typedExpressionIR
