def $lift_callableTargetIR_as_expression(callableTargetIR) : expression =

  clause 0 : (callableTargetIR) = THIS as expression
  -- if (callableTargetIR = ` "this" as callableTargetIR)

  clause 1 : (callableTargetIR) = nonTypeName as expression
  -- if callableTargetIR <: prefixedNameIR
  -- let prefixedNameIR = callableTargetIR as prefixedNameIR
  -- if prefixedNameIR matches `` %`
  -- let ` nameIR = prefixedNameIR
  -- if (nameIR =/= "this")
  -- let nonTypeName = $lift_nameIR_as_nonTypeName(nameIR)

  clause 2 : (callableTargetIR) = `ID . nonTypeName as expression
  -- if callableTargetIR <: prefixedNameIR
  -- let prefixedNameIR = callableTargetIR as prefixedNameIR
  -- if prefixedNameIR matches `. %`
  -- let . nameIR = prefixedNameIR
  -- let nonTypeName = $lift_nameIR_as_nonTypeName(nameIR)

  clause 3 : (callableTargetIR) = expression as memberAccessBase . member as expression
  -- if callableTargetIR matches `% . %`
  -- let typedExpressionIR . nameIR = callableTargetIR
  -- let expression = $lift_typedExpressionIR(typedExpressionIR)
  -- let member = $lift_nameIR_as_member(nameIR)

  clause 4 : (callableTargetIR) = THIS as memberAccessBase . member as expression
  -- if callableTargetIR matches `TYPE % . %`
  -- let TYPE prefixedNameIR . nameIR = callableTargetIR
  -- if (prefixedNameIR = ` "this")
  -- let member = $lift_nameIR_as_member(nameIR)

  clause 5 : (callableTargetIR) = nonTypeName as memberAccessBase . member as expression
  -- if callableTargetIR matches `TYPE % . %`
  -- let TYPE prefixedNameIR . nameIR_field = callableTargetIR
  -- if prefixedNameIR matches `` %`
  -- let ` nameIR = prefixedNameIR
  -- if (nameIR =/= "this")
  -- let nonTypeName = $lift_nameIR_as_nonTypeName(nameIR)
  -- let member = $lift_nameIR_as_member(nameIR_field)

  clause 6 : (callableTargetIR) = `ID . nonTypeName as memberAccessBase . member as expression
  -- if callableTargetIR matches `TYPE % . %`
  -- let TYPE prefixedNameIR . nameIR_field = callableTargetIR
  -- if prefixedNameIR matches `. %`
  -- let . nameIR = prefixedNameIR
  -- let nonTypeName = $lift_nameIR_as_nonTypeName(nameIR)
  -- let member = $lift_nameIR_as_member(nameIR_field)

  clause 7 : (callableTargetIR') = ( expression ) as expression
  -- if callableTargetIR' matches `(%)`
  -- let ( callableTargetIR ) = callableTargetIR'
  -- let expression = $lift_callableTargetIR_as_expression(callableTargetIR)

