    rule aliased: p TC |- prefixedNameIR < [] > ( argumentIR*{argumentIR <- argumentIR*} ) : constructorTypeIR < # typeId_impl*{typeId_impl <- typeId_impl*} > ( # id_default*{id_default <- id_default*} # id_optional*{id_optional <- id_optional*} )
