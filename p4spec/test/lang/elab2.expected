relation BlockElementStmt_eval: evalContext arch |- blockElementStatementIR : evalContext arch statementResult

  rulegroup 

    rule constantDeclarationIR: EC_0 ARCH |- constantDeclarationIR as blockElementStatementIR : EC_1 ARCH `EMPTY as statementResult
