    -- (if Cast_impl: typeIR_field_a_aligned -> typeIR_field_b_non_default_aligned holds)*{typeIR_field_a_aligned <- typeIR_field_a_aligned*, typeIR_field_b_non_default_aligned <- typeIR_field_b_non_default_aligned*}
    -- if ({ id_default*{id_default <- id_default*} } = $diff_set<id>({ id_field_b*{id_field_b <- id_field_b*} }, { id_field_a*{id_field_a <- id_field_a*} }))
    -- (if (?(typeIR_field_b_default) = $find_map<id, typeIR>({ id_field_b : typeIR_field_b*{id_field_b <- id_field_b*, typeIR_field_b <- typeIR_field_b*} }, id_default)))*{id_default <- id_default*, typeIR_field_b_default <- typeIR_field_b_default*}
    -- (if $is_defaultable_typeIR(typeIR_field_b_default))*{typeIR_field_b_default <- typeIR_field_b_default*}

relation Expr_ok: cursor typingContext |- expression : typedExpressionIR

  rulegroup literalExpression

    rule booleanLiteral: p TC |- booleanLiteral as expression : booleanLiteral as expressionIR # expressionNoteIR
    -- if (expressionNoteIR = ( BOOL as typeIR LCTK ))

    rule integerLiteral-arbint: p TC |- D i as expression : D i as expressionIR # expressionNoteIR
    -- if (expressionNoteIR = ( INT as typeIR LCTK ))

    rule integerLiteral-fixint: p TC |- n S i as expression : n S i as expressionIR # expressionNoteIR
    -- if (expressionNoteIR = ( INT < n > as typeIR LCTK ))

    rule integerLiteral-fixbit: p TC |- n W i as expression : n W i as expressionIR # expressionNoteIR
    -- if (expressionNoteIR = ( BIT < n > as typeIR LCTK ))

    rule stringLiteral: p TC |- stringLiteral as expression : stringLiteral as expressionIR # expressionNoteIR
