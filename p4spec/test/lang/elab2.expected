  -- if annotation'?{annotation' <- annotation'?} matches (_)
  -- let ?(annotation_found) = annotation'?{annotation' <- annotation'?}

  clause -1 : (_annotationList) = ?()

def $add_annotationList(annotationList, annotation?) : annotationList =

  clause 0 : (annotationList, annotation?{annotation <- annotation?}) = annotationList
  -- if annotation?{annotation <- annotation?} matches ()

  clause 1 : (annotationList, annotation'?{annotation' <- annotation'?}) = annotation as annotationList
  -- if annotationList matches `/* empty */`
  -- if annotation'?{annotation' <- annotation'?} matches (_)
  -- let ?(annotation) = annotation'?{annotation' <- annotation'?}

  clause 2 : (annotationList, annotation'?{annotation' <- annotation'?}) = annotationListNonEmpty annotation as annotationList
  -- if annotationList <: annotationListNonEmpty
  -- let annotationListNonEmpty = annotationList as annotationListNonEmpty
  -- if annotation'?{annotation' <- annotation'?} matches (_)
  -- let ?(annotation) = annotation'?{annotation' <- annotation'?}

def $subexpressions_of_typedExpressionIR(typedExpressionIR) : typedExpressionListIR =

  clause 0 : (typedExpressionIR) = typedExpressionIR :: $subexpressions_of_expressionIR(expressionIR)
  -- let expressionIR # _expressionNoteIR = typedExpressionIR

def $subexpressions_of_typedExpressionListIR(typedExpressionListIR) : typedExpressionListIR =

  clause 0 : (typedExpressionIR*{typedExpressionIR <- typedExpressionIR*}) = $concat_<typedExpressionIR>($subexpressions_of_typedExpressionIR(typedExpressionIR)*{typedExpressionIR <- typedExpressionIR*})

def $subexpressions_of_expressionIR(expressionIR) : typedExpressionListIR =

  clause 0 : (expressionIR) = $subexpressions_of_typedExpressionIR(typedExpressionIR)
  -- if expressionIR <: unaryExpressionIR
  -- let unop typedExpressionIR = expressionIR as unaryExpressionIR

  clause 1 : (expressionIR) = $subexpressions_of_typedExpressionIR(typedExpressionIR_l) ++ $subexpressions_of_typedExpressionIR(typedExpressionIR_r)
  -- if expressionIR <: binaryExpressionIR
  -- let typedExpressionIR_l binop typedExpressionIR_r = expressionIR as binaryExpressionIR

  clause 2 : (expressionIR) = $subexpressions_of_typedExpressionIR(typedExpressionIR_cond) ++ $subexpressions_of_typedExpressionIR(typedExpressionIR_then) ++ $subexpressions_of_typedExpressionIR(typedExpressionIR_else)
  -- if expressionIR <: ternaryExpressionIR
  -- let typedExpressionIR_cond ? typedExpressionIR_then : typedExpressionIR_else = expressionIR as ternaryExpressionIR

  clause 3 : (expressionIR) = $subexpressions_of_typedExpressionIR(typedExpressionIR)
  -- if expressionIR <: castExpressionIR
  -- let ( typeIR ) typedExpressionIR = expressionIR as castExpressionIR

  clause 4 : (expressionIR) = $subexpressions_of_typedExpressionListIR(typedExpressionListIR)
  -- if expressionIR <: sequenceExpressionIR
  -- let sequenceExpressionIR = expressionIR as sequenceExpressionIR
  -- if sequenceExpressionIR matches `SEQ {%}`
  -- let SEQ { typedExpressionListIR } = sequenceExpressionIR

  clause 5 : (expressionIR) = $subexpressions_of_typedExpressionListIR(typedExpressionListIR)
  -- if expressionIR <: sequenceExpressionIR
  -- let sequenceExpressionIR = expressionIR as sequenceExpressionIR
  -- if sequenceExpressionIR matches `SEQ {% , ...}`
  -- let SEQ { typedExpressionListIR , ... } = sequenceExpressionIR

  clause 6 : (expressionIR) = $subexpressions_of_typedExpressionListIR(typedExpressionIR*{typedExpressionIR <- typedExpressionIR*})
  -- if expressionIR <: recordExpressionIR
  -- let recordExpressionIR = expressionIR as recordExpressionIR
  -- if recordExpressionIR matches `RECORD {%}`
  -- let RECORD { nameIR = typedExpressionIR*{nameIR <- nameIR*, typedExpressionIR <- typedExpressionIR*} } = recordExpressionIR

  clause 7 : (expressionIR) = $subexpressions_of_typedExpressionListIR(typedExpressionIR*{typedExpressionIR <- typedExpressionIR*})
  -- if expressionIR <: recordExpressionIR
  -- let recordExpressionIR = expressionIR as recordExpressionIR
  -- if recordExpressionIR matches `RECORD {% , ...}`
  -- let RECORD { nameIR = typedExpressionIR*{nameIR <- nameIR*, typedExpressionIR <- typedExpressionIR*} , ... } = recordExpressionIR

  clause 8 : (expressionIR) = $subexpressions_of_typedExpressionIR(typedExpressionIR)
  -- if expressionIR <: memberAccessExpressionIR
  -- let memberAccessBaseIR . nameIR = expressionIR as memberAccessExpressionIR
  -- if memberAccessBaseIR <: typedExpressionIR
  -- let typedExpressionIR = memberAccessBaseIR as typedExpressionIR

  clause 9 : (expressionIR) = $subexpressions_of_typedExpressionIR(typedExpressionIR_base) ++ $subexpressions_of_typedExpressionIR(typedExpressionIR_index)
  -- if expressionIR <: indexAccessExpressionIR
  -- let typedExpressionIR_base [ typedExpressionIR_index ] = expressionIR as indexAccessExpressionIR

  clause 10 : (expressionIR) = $subexpressions_of_typedExpressionIR(typedExpressionIR_base) ++ $subexpressions_of_typedExpressionIR(typedExpressionIR_hi) ++ $subexpressions_of_typedExpressionIR(typedExpressionIR_lo)
  -- if expressionIR <: sliceAccessExpressionIR
  -- let typedExpressionIR_base [ typedExpressionIR_hi sliceop typedExpressionIR_lo ] = expressionIR as sliceAccessExpressionIR
  -- if sliceop matches `:`

  clause 11 : (expressionIR) = $subexpressions_of_argumentListIR(argumentIR*{argumentIR <- argumentIR*})
  -- if expressionIR <: callExpressionIR
  -- let callExpressionIR = expressionIR as callExpressionIR
  -- if callExpressionIR matches `% (%)`
  -- let constructorTargetIR ( argumentIR*{argumentIR <- argumentIR*} ) = callExpressionIR

  clause 12 : (expressionIR) = $subexpressions_of_argumentListIR(argumentIR*{argumentIR <- argumentIR*})
  -- if expressionIR <: callExpressionIR
  -- let callExpressionIR = expressionIR as callExpressionIR
  -- if callExpressionIR matches `% <%> (%)`
  -- let callableTargetIR < typeArgumentIR*{typeArgumentIR <- typeArgumentIR*} > ( argumentIR*{argumentIR <- argumentIR*} ) = callExpressionIR

  clause 13 : (expressionIR) = $subexpressions_of_typedExpressionIR(typedExpressionIR)
  -- if expressionIR <: parenthesizedExpressionIR
  -- let ( typedExpressionIR ) = expressionIR as parenthesizedExpressionIR

  clause -1 : (_expressionIR) = []

def $subexpressions_of_argumentIR(argumentIR) : typedExpressionListIR =

  clause 0 : (argumentIR) = $subexpressions_of_typedExpressionIR(typedExpressionIR)
  -- if argumentIR <: typedExpressionIR
  -- let typedExpressionIR = argumentIR as typedExpressionIR

  clause 1 : (argumentIR) = $subexpressions_of_typedExpressionIR(typedExpressionIR)
  -- if argumentIR matches `% = %`
  -- let nameIR = typedExpressionIR = argumentIR

  clause -1 : (_argumentIR) = []

def $subexpressions_of_argumentListIR(argumentListIR) : typedExpressionListIR =

  clause 0 : (argumentIR*{argumentIR <- argumentIR*}) = $concat_<typedExpressionIR>($subexpressions_of_argumentIR(argumentIR)*{argumentIR <- argumentIR*})

def $sink<T> : T =

def $lift_nameIR_as_identifier(nameIR) : identifier =

  clause 0 : (nameIR) = `ID nameIR

def $lift_nameIR_as_typeIdentifier(nameIR) : typeIdentifier =

  clause 0 : (nameIR) = `TID nameIR

def $lift_nameIR_as_nonTypeName(nameIR) : nonTypeName =

  clause 0 : (t) = APPLY
  -- if (t = "apply")

  clause 1 : (t) = KEY
  -- if (t = "key")

  clause 2 : (t) = ACTIONS
  -- if (t = "actions")

  clause 3 : (t) = STATE
  -- if (t = "state")

  clause 4 : (t) = ENTRIES
  -- if (t = "entries")

  clause 5 : (t) = TYPE
  -- if (t = "type")

  clause 6 : (t) = PRIORITY
  -- if (t = "priority")

  clause -1 : (nameIR) = `ID nameIR as nonTypeName

def $lift_prefixedNameIR_as_prefixedNonTypeName(prefixedNameIR) : prefixedNonTypeName =

  clause 0 : (prefixedNameIR) = $lift_nameIR_as_nonTypeName(nameIR) as prefixedNonTypeName
  -- if prefixedNameIR matches `` %`
  -- let ` nameIR = prefixedNameIR

  clause 1 : (prefixedNameIR) = `ID . $lift_nameIR_as_nonTypeName(nameIR)
  -- if prefixedNameIR matches `. %`
  -- let . nameIR = prefixedNameIR

def $lift_nameIR_as_typeName(nameIR) : typeName =

  clause 0 : (nameIR) = $lift_nameIR_as_typeIdentifier(nameIR)

def $lift_prefixedNameIR_as_prefixedTypeName(prefixedNameIR) : prefixedTypeName =

  clause 0 : (prefixedNameIR) = $lift_nameIR_as_typeName(nameIR) as prefixedTypeName
  -- if prefixedNameIR matches `` %`
  -- let ` nameIR = prefixedNameIR

  clause 1 : (prefixedNameIR) = `TID . $lift_nameIR_as_typeName(nameIR)
  -- if prefixedNameIR matches `. %`
  -- let . nameIR = prefixedNameIR

def $lift_nameIR_as_tableCustomName(nameIR) : tableCustomName =

  clause 0 : (t) = APPLY
  -- if (t = "apply")

  clause 1 : (t) = STATE
  -- if (t = "state")

  clause 2 : (t) = TYPE
  -- if (t = "type")

  clause 3 : (t) = PRIORITY
  -- if (t = "priority")

  clause -1 : (nameIR) = $lift_nameIR_as_identifier(nameIR) as tableCustomName

def $lift_nameListIR_as_nonTypeNameList(nameIR*) : nameList =

  clause 0 : (nameIR*{nameIR <- nameIR*}) = nameList
  -- (let name = $lift_nameIR_as_nonTypeName(nameIR) as name)*{nameIR <- nameIR*, name -> name*}
  -- let nameList = $unflatten_nameList(name*{name <- name*})

def $unflatten_nameList(name*) : nameList =

  clause 0 : (name*{name <- name*}) = $unflatten_nameList'(name_h as nameList, name_t*{name_t <- name_t*})
  -- if name*{name <- name*} matches _ :: _
  -- let name_h :: name_t*{name_t <- name_t*} = name*{name <- name*}

def $unflatten_nameList'(nameList, name*) : nameList =

  clause 0 : (nameList, name*{name <- name*}) = nameList
  -- if name*{name <- name*} matches []

  clause 1 : (nameList, name*{name <- name*}) = $unflatten_nameList'(nameList , name_h, name_t*{name_t <- name_t*})
  -- if name*{name <- name*} matches _ :: _
  -- let name_h :: name_t*{name_t <- name_t*} = name*{name <- name*}

def $lift_nameIR_as_member(nameIR) : member =

  clause 0 : (nameIR) = $lift_nameIR_as_nonTypeName(nameIR) as member

def $lift_value(value) : expression =

  clause -1 : (value) = $sink<expression>
  -- debug value

def $lift_typeIR(typeIR) : type =

  clause 0 : (typeIR) = $lift_baseTypeIR(baseTypeIR) as type
  -- if typeIR <: baseTypeIR
  -- let baseTypeIR = typeIR as baseTypeIR

  clause 1 : (typeIR) = $lift_nameTypeIR(nameTypeIR) as type
  -- if typeIR <: nameTypeIR
  -- let nameTypeIR = typeIR as nameTypeIR

  clause 2 : (typeIR) = $lift_aliasTypeIR(aliasTypeIR)
  -- if typeIR <: aliasTypeIR
  -- let aliasTypeIR = typeIR as aliasTypeIR

  clause 3 : (typeIR) = $lift_dataTypeIR(dataTypeIR)
  -- if typeIR <: dataTypeIR
  -- let dataTypeIR = typeIR as dataTypeIR

  clause -1 : (typeIR) = $sink<type>
  -- debug typeIR

def $lift_baseTypeIR(baseTypeIR) : baseType =

  clause 0 : (baseTypeIR) = BOOL
  -- if baseTypeIR <: boolTypeIR
  -- let boolTypeIR = baseTypeIR as boolTypeIR
  -- if (boolTypeIR = BOOL)

  clause 1 : (baseTypeIR) = ERROR
  -- if baseTypeIR <: errorTypeIR
  -- let errorTypeIR = baseTypeIR as errorTypeIR
  -- if (errorTypeIR = ERROR)

  clause 2 : (baseTypeIR) = ERROR
  -- if baseTypeIR <: errorTypeIR
  -- let errorTypeIR = baseTypeIR as errorTypeIR
  -- if (errorTypeIR = ERROR)

  clause 3 : (baseTypeIR) = MATCH_KIND
  -- if baseTypeIR <: matchKindTypeIR
  -- let matchKindTypeIR = baseTypeIR as matchKindTypeIR
  -- if (matchKindTypeIR = MATCH_KIND)

  clause 4 : (baseTypeIR) = STRING
  -- if baseTypeIR <: stringTypeIR
  -- let stringTypeIR = baseTypeIR as stringTypeIR
  -- if (stringTypeIR = STRING)

  clause 5 : (baseTypeIR) = INT
  -- if baseTypeIR <: intTypeIR
  -- let intTypeIR = baseTypeIR as intTypeIR
  -- if (intTypeIR = INT)

  clause 6 : (baseTypeIR) = INT < w as int >
  -- if baseTypeIR <: fixedIntTypeIR
  -- let INT < w > = baseTypeIR as fixedIntTypeIR

  clause 7 : (baseTypeIR) = BIT < w as int >
  -- if baseTypeIR <: fixedBitTypeIR
  -- let BIT < w > = baseTypeIR as fixedBitTypeIR

  clause 8 : (baseTypeIR) = VARBIT < w as int >
  -- if baseTypeIR <: varBitTypeIR
  -- let VARBIT < w > = baseTypeIR as varBitTypeIR

def $lift_typeDefIR_as_typeName(typeDefIR) : typeName =

  clause 0 : (typeDefIR) = typeName
  -- if typeDefIR <: nameTypeIR
  -- let ` typeId = typeDefIR as nameTypeIR
