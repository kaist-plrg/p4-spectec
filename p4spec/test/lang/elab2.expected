    rule headerTypeIR: SEQ < typeIR_a*{typeIR_a <- typeIR_a*} , ... > as typeIR -> HEADER _typeId < _typeArgumentIR*{_typeArgumentIR <- _typeArgumentIR*} > { _annotationList typeIR_field_b _nameIR ;*{_annotationList <- _annotationList*, _nameIR <- _nameIR*, typeIR_field_b <- typeIR_field_b*} } as typeIR
