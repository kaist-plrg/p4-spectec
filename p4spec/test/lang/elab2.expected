syntax voidTypeIR = 
   | VOID (from voidTypeIR) 

syntax boolTypeIR = 
   | BOOL (from boolTypeIR) 

syntax errorTypeIR = 
   | ERROR (from errorTypeIR) 

syntax matchKindTypeIR = 
   | MATCH_KIND (from matchKindTypeIR) 

syntax stringTypeIR = 
   | STRING (from stringTypeIR) 

syntax intTypeIR = 
   | INT (from intTypeIR) 

syntax fixedIntTypeIR = 
   | INT < nat > (from fixedIntTypeIR) 

syntax fixedBitTypeIR = 
   | BIT < nat > (from fixedBitTypeIR) 

syntax varBitTypeIR = 
   | VARBIT < nat > (from varBitTypeIR) 

syntax integerTypeIR = 
   | INT (from intTypeIR) 
   | INT < nat > (from fixedIntTypeIR) 
   | BIT < nat > (from fixedBitTypeIR) 
   | VARBIT < nat > (from varBitTypeIR) 

syntax baseTypeIR = 
   | VOID (from voidTypeIR) 
   | BOOL (from boolTypeIR) 
   | ERROR (from errorTypeIR) 
   | MATCH_KIND (from matchKindTypeIR) 
   | STRING (from stringTypeIR) 
   | INT (from intTypeIR) 
   | INT < nat > (from fixedIntTypeIR) 
   | BIT < nat > (from fixedBitTypeIR) 
   | VARBIT < nat > (from varBitTypeIR) 

syntax nameTypeIR = 
   | ` typeId (from nameTypeIR)  hint(print %0)

syntax typedefTypeIR = 
   | TYPEDEF typeId typeIR (from typedefTypeIR)  hint(print %0)

syntax newTypeIR = 
   | TYPE typeId typeIR (from newTypeIR)  hint(print %0)

syntax aliasTypeIR = 
   | TYPEDEF typeId typeIR (from typedefTypeIR)  hint(print %0)
   | TYPE typeId typeIR (from newTypeIR)  hint(print %0)

syntax listTypeIR = 
   | LIST < typeIR > (from listTypeIR) 

syntax tupleTypeIR = 
   | TUPLE < typeIR* > (from tupleTypeIR) 

syntax headerStackTypeIR = 
   | typeIR [ nat ] (from headerStackTypeIR) 

syntax fieldTypeIR = 
   | annotationList typeIR nameIR ; (from fieldTypeIR) 

syntax structTypeIR = 
   | STRUCT typeId < typeArgumentIR* > { fieldTypeIR* } (from structTypeIR)  hint(print %0#"<"#%1#">")

syntax headerTypeIR = 
   | HEADER typeId < typeArgumentIR* > { fieldTypeIR* } (from headerTypeIR)  hint(print %0#"<"#%1#">")

syntax headerUnionTypeIR = 
   | HEADER_UNION typeId < typeArgumentIR* > { fieldTypeIR* } (from headerUnionTypeIR)  hint(print %0#"<"#%1#">")

syntax valueFieldIR = 
   | nameIR = value ; (from valueFieldIR) 

syntax simpleEnumTypeIR = 
   | ENUM typeId { nameIR* } (from simpleEnumTypeIR)  hint(print %0)

syntax serializableEnumTypeIR = 
   | ENUM typeId < typeIR > { valueFieldIR* } (from serializableEnumTypeIR)  hint(print %0)

syntax enumTypeIR = 
   | ENUM typeId { nameIR* } (from simpleEnumTypeIR)  hint(print %0)
   | ENUM typeId < typeIR > { valueFieldIR* } (from serializableEnumTypeIR)  hint(print %0)

syntax dataTypeIR = 
   | LIST < typeIR > (from listTypeIR) 
   | TUPLE < typeIR* > (from tupleTypeIR) 
   | typeIR [ nat ] (from headerStackTypeIR) 
   | STRUCT typeId < typeArgumentIR* > { fieldTypeIR* } (from structTypeIR)  hint(print %0#"<"#%1#">")
   | HEADER typeId < typeArgumentIR* > { fieldTypeIR* } (from headerTypeIR)  hint(print %0#"<"#%1#">")
   | HEADER_UNION typeId < typeArgumentIR* > { fieldTypeIR* } (from headerUnionTypeIR)  hint(print %0#"<"#%1#">")
   | ENUM typeId { nameIR* } (from simpleEnumTypeIR)  hint(print %0)
   | ENUM typeId < typeIR > { valueFieldIR* } (from serializableEnumTypeIR)  hint(print %0)

syntax externMethodTypeDefEnv = map<callableId, externMethodTypeDefIR>

syntax externObjectTypeIR = 
   | EXTERN typeId < typeArgumentIR* > externMethodTypeDefEnv (from externObjectTypeIR)  hint(print %0#"<"#%1#">")

syntax parserObjectTypeIR = 
   | PARSER typeId < typeArgumentIR* > ( parameterIR* ) (from parserObjectTypeIR)  hint(print %0#"<"#%1#">")

syntax controlObjectTypeIR = 
   | CONTROL typeId < typeArgumentIR* > ( parameterIR* ) (from controlObjectTypeIR)  hint(print %0#"<"#%1#">")

syntax packageObjectTypeIR = 
   | PACKAGE typeId < typeArgumentIR* > { typeIR* } (from packageObjectTypeIR)  hint(print %0#"<"#%1#">")

syntax tableObjectTypeIR = 
   | TABLE typeId { tableMetadataStructTypeIR } (from tableObjectTypeIR)  hint(print %0)

syntax objectTypeIR = 
   | EXTERN typeId < typeArgumentIR* > externMethodTypeDefEnv (from externObjectTypeIR)  hint(print %0#"<"#%1#">")
   | PARSER typeId < typeArgumentIR* > ( parameterIR* ) (from parserObjectTypeIR)  hint(print %0#"<"#%1#">")
   | CONTROL typeId < typeArgumentIR* > ( parameterIR* ) (from controlObjectTypeIR)  hint(print %0#"<"#%1#">")
   | PACKAGE typeId < typeArgumentIR* > { typeIR* } (from packageObjectTypeIR)  hint(print %0#"<"#%1#">")
   | TABLE typeId { tableMetadataStructTypeIR } (from tableObjectTypeIR)  hint(print %0)

syntax defaultTypeIR = 
   | DEFAULT (from defaultTypeIR) 

syntax invalidHeaderTypeIR = 
   | HEADER_INVALID (from invalidHeaderTypeIR) 

syntax sequenceTypeIR = 
   | SEQ < typeIR* > (from sequenceTypeIR) 
   | SEQ < typeIR* , ... > (from sequenceTypeIR) 

syntax recordTypeIR = 
   | RECORD { fieldTypeIR* } (from recordTypeIR) 
   | RECORD { fieldTypeIR* , ... } (from recordTypeIR) 

syntax setTypeIR = 
   | SET < typeIR > (from setTypeIR) 

syntax tableMetadataEnumTypeIR = 
   | TABLE_ENUM typeId { nameIR* } (from tableMetadataEnumTypeIR)  hint(print %0)

syntax tableMetadataStructTypeIR = 
   | TABLE_STRUCT typeId { HIT boolTypeIR ; MISS boolTypeIR ; ACTION_RUN tableMetadataEnumTypeIR ; } (from tableMetadataStructTypeIR)  hint(print %0)

syntax tableMetadataTypeIR = 
   | TABLE_ENUM typeId { nameIR* } (from tableMetadataEnumTypeIR)  hint(print %0)
   | TABLE_STRUCT typeId { HIT boolTypeIR ; MISS boolTypeIR ; ACTION_RUN tableMetadataEnumTypeIR ; } (from tableMetadataStructTypeIR)  hint(print %0)

syntax synthesizedTypeIR = 
   | DEFAULT (from defaultTypeIR) 
   | HEADER_INVALID (from invalidHeaderTypeIR) 
   | SEQ < typeIR* > (from sequenceTypeIR) 
   | SEQ < typeIR* , ... > (from sequenceTypeIR) 
   | RECORD { fieldTypeIR* } (from recordTypeIR) 
   | RECORD { fieldTypeIR* , ... } (from recordTypeIR) 
   | SET < typeIR > (from setTypeIR) 
   | TABLE_ENUM typeId { nameIR* } (from tableMetadataEnumTypeIR)  hint(print %0)
   | TABLE_STRUCT typeId { HIT boolTypeIR ; MISS boolTypeIR ; ACTION_RUN tableMetadataEnumTypeIR ; } (from tableMetadataStructTypeIR)  hint(print %0)

syntax typeIR = 
   | VOID (from voidTypeIR) 
   | BOOL (from boolTypeIR) 
   | ERROR (from errorTypeIR) 
   | MATCH_KIND (from matchKindTypeIR) 
   | STRING (from stringTypeIR) 
   | INT (from intTypeIR) 
   | INT < nat > (from fixedIntTypeIR) 
   | BIT < nat > (from fixedBitTypeIR) 
   | VARBIT < nat > (from varBitTypeIR) 
   | ` typeId (from nameTypeIR)  hint(print %0)
   | TYPEDEF typeId typeIR (from typedefTypeIR)  hint(print %0)
   | TYPE typeId typeIR (from newTypeIR)  hint(print %0)
   | LIST < typeIR > (from listTypeIR) 
   | TUPLE < typeIR* > (from tupleTypeIR) 
   | typeIR [ nat ] (from headerStackTypeIR) 
   | STRUCT typeId < typeArgumentIR* > { fieldTypeIR* } (from structTypeIR)  hint(print %0#"<"#%1#">")
   | HEADER typeId < typeArgumentIR* > { fieldTypeIR* } (from headerTypeIR)  hint(print %0#"<"#%1#">")
   | HEADER_UNION typeId < typeArgumentIR* > { fieldTypeIR* } (from headerUnionTypeIR)  hint(print %0#"<"#%1#">")
   | ENUM typeId { nameIR* } (from simpleEnumTypeIR)  hint(print %0)
   | ENUM typeId < typeIR > { valueFieldIR* } (from serializableEnumTypeIR)  hint(print %0)
   | EXTERN typeId < typeArgumentIR* > externMethodTypeDefEnv (from externObjectTypeIR)  hint(print %0#"<"#%1#">")
   | PARSER typeId < typeArgumentIR* > ( parameterIR* ) (from parserObjectTypeIR)  hint(print %0#"<"#%1#">")
   | CONTROL typeId < typeArgumentIR* > ( parameterIR* ) (from controlObjectTypeIR)  hint(print %0#"<"#%1#">")
   | PACKAGE typeId < typeArgumentIR* > { typeIR* } (from packageObjectTypeIR)  hint(print %0#"<"#%1#">")
   | TABLE typeId { tableMetadataStructTypeIR } (from tableObjectTypeIR)  hint(print %0)
   | DEFAULT (from defaultTypeIR) 
   | HEADER_INVALID (from invalidHeaderTypeIR) 
   | SEQ < typeIR* > (from sequenceTypeIR) 
   | SEQ < typeIR* , ... > (from sequenceTypeIR) 
   | RECORD { fieldTypeIR* } (from recordTypeIR) 
   | RECORD { fieldTypeIR* , ... } (from recordTypeIR) 
   | SET < typeIR > (from setTypeIR) 
   | TABLE_ENUM typeId { nameIR* } (from tableMetadataEnumTypeIR)  hint(print %0)
   | TABLE_STRUCT typeId { HIT boolTypeIR ; MISS boolTypeIR ; ACTION_RUN tableMetadataEnumTypeIR ; } (from tableMetadataStructTypeIR)  hint(print %0)

syntax typeArgumentIR = typeIR

syntax typeParameterIR = typeId

syntax nameTypeDefIR = nameTypeIR

syntax aliasTypeDefIR = aliasTypeIR

syntax structTypeDefIR = 
   | STRUCT typeId < typeParameterIR* > { fieldTypeIR* } (from structTypeDefIR) 

syntax headerTypeDefIR = 
   | HEADER typeId < typeParameterIR* > { fieldTypeIR* } (from headerTypeDefIR) 

syntax headerUnionTypeDefIR = 
   | HEADER_UNION typeId < typeParameterIR* > { fieldTypeIR* } (from headerUnionTypeDefIR) 

syntax enumTypeDefIR = enumTypeIR

syntax dataTypeDefIR = 
   | STRUCT typeId < typeParameterIR* > { fieldTypeIR* } (from structTypeDefIR) 
   | HEADER typeId < typeParameterIR* > { fieldTypeIR* } (from headerTypeDefIR) 
   | HEADER_UNION typeId < typeParameterIR* > { fieldTypeIR* } (from headerUnionTypeDefIR) 
   | ENUM typeId { nameIR* } (from simpleEnumTypeIR)  hint(print %0)
   | ENUM typeId < typeIR > { valueFieldIR* } (from serializableEnumTypeIR)  hint(print %0)

syntax externObjectTypeDefIR = 
   | EXTERN typeId < typeParameterIR* , typeParameterIR* > externMethodTypeDefEnv (from externObjectTypeDefIR) 

syntax parserObjectTypeDefIR = 
   | PARSER typeId < typeParameterIR* , typeParameterIR* > ( parameterIR* ) (from parserObjectTypeDefIR) 

syntax controlObjectTypeDefIR = 
   | CONTROL typeId < typeParameterIR* , typeParameterIR* > ( parameterIR* ) (from controlObjectTypeDefIR) 

syntax packageObjectTypeDefIR = 
   | PACKAGE typeId < typeParameterIR* , typeParameterIR* > { typeIR* } (from packageObjectTypeDefIR) 

syntax tableObjectTypeDefIR = tableObjectTypeIR

syntax objectTypeDefIR = 
   | EXTERN typeId < typeParameterIR* , typeParameterIR* > externMethodTypeDefEnv (from externObjectTypeDefIR) 
   | PARSER typeId < typeParameterIR* , typeParameterIR* > ( parameterIR* ) (from parserObjectTypeDefIR) 
   | CONTROL typeId < typeParameterIR* , typeParameterIR* > ( parameterIR* ) (from controlObjectTypeDefIR) 
   | PACKAGE typeId < typeParameterIR* , typeParameterIR* > { typeIR* } (from packageObjectTypeDefIR) 
   | TABLE typeId { tableMetadataStructTypeIR } (from tableObjectTypeIR)  hint(print %0)

syntax typeDefIR = 
   | ` typeId (from nameTypeIR)  hint(print %0)
   | TYPEDEF typeId typeIR (from typedefTypeIR)  hint(print %0)
   | TYPE typeId typeIR (from newTypeIR)  hint(print %0)
   | STRUCT typeId < typeParameterIR* > { fieldTypeIR* } (from structTypeDefIR) 
   | HEADER typeId < typeParameterIR* > { fieldTypeIR* } (from headerTypeDefIR) 
   | HEADER_UNION typeId < typeParameterIR* > { fieldTypeIR* } (from headerUnionTypeDefIR) 
   | ENUM typeId { nameIR* } (from simpleEnumTypeIR)  hint(print %0)
   | ENUM typeId < typeIR > { valueFieldIR* } (from serializableEnumTypeIR)  hint(print %0)
   | EXTERN typeId < typeParameterIR* , typeParameterIR* > externMethodTypeDefEnv (from externObjectTypeDefIR) 
   | PARSER typeId < typeParameterIR* , typeParameterIR* > ( parameterIR* ) (from parserObjectTypeDefIR) 
   | CONTROL typeId < typeParameterIR* , typeParameterIR* > ( parameterIR* ) (from controlObjectTypeDefIR) 
   | PACKAGE typeId < typeParameterIR* , typeParameterIR* > { typeIR* } (from packageObjectTypeDefIR) 
   | TABLE typeId { tableMetadataStructTypeIR } (from tableObjectTypeIR)  hint(print %0)

def $unroll_typeIR(typeIR) : typeIR =

  clause 0 : (typeIR') = $unroll_typeIR(typeIR)
  -- if typeIR' <: typedefTypeIR
  -- let TYPEDEF _typeId typeIR = typeIR' as typedefTypeIR

  clause -1 : (typeIR) = typeIR

def $unroll_aliasType(typeIR) : typeIR =

  clause 0 : (typeIR') = $unroll_aliasType(typeIR)
  -- if typeIR' <: newTypeIR
  -- let TYPE _typeId typeIR = typeIR' as newTypeIR

  clause 1 : (typeIR') = $unroll_aliasType(typeIR)
  -- if typeIR' <: typedefTypeIR
  -- let TYPEDEF _typeId typeIR = typeIR' as typedefTypeIR

  clause -1 : (typeIR) = typeIR

def $width_of_integerTypeIR(integerTypeIR) : nat? =

  clause 0 : (integerTypeIR) = ?()
  -- if integerTypeIR <: intTypeIR
  -- let intTypeIR = integerTypeIR as intTypeIR
  -- if (intTypeIR = INT)

  clause 1 : (integerTypeIR) = ?(n)
  -- if integerTypeIR <: fixedIntTypeIR
  -- let INT < n > = integerTypeIR as fixedIntTypeIR

  clause 2 : (integerTypeIR) = ?(n)
  -- if integerTypeIR <: fixedBitTypeIR
  -- let BIT < n > = integerTypeIR as fixedBitTypeIR

  clause 3 : (integerTypeIR) = ?(n)
  -- if integerTypeIR <: varBitTypeIR
  -- let VARBIT < n > = integerTypeIR as varBitTypeIR

tbl def $is_defaultable_typeIR(typeIR) : bool =
  row 0 :
    (BOOL as typeIR) -> true
  row 1 :
    (ERROR as typeIR) -> true
  row 2 :
    (STRING as typeIR) -> true
  row 3 :
    (integerTypeIR as typeIR) -> true
  row 4 :
    (TYPEDEF _typeId typeIR as typeIR) -> $is_defaultable_typeIR(typeIR)
  row 5 :
    (TYPE _typeId typeIR as typeIR) -> $is_defaultable_typeIR(typeIR)
  row 6 :
    (TUPLE < typeIR*{typeIR <- typeIR*} > as typeIR) -> $forall_($is_defaultable_typeIR(typeIR)*{typeIR <- typeIR*})
  row 7 :
    (typeIR [ _nat ] as typeIR) -> $is_defaultable_typeIR(typeIR)
  row 8 :
    (STRUCT _typeId < _typeArgumentIR*{_typeArgumentIR <- _typeArgumentIR*} > { _annotationList typeIR _nameIR ;*{_annotationList <- _annotationList*, _nameIR <- _nameIR*, typeIR <- typeIR*} } as typeIR) -> $forall_($is_defaultable_typeIR(typeIR)*{typeIR <- typeIR*})
  row 9 :
    (HEADER _typeId < _typeArgumentIR*{_typeArgumentIR <- _typeArgumentIR*} > { _annotationList typeIR _nameIR ;*{_annotationList <- _annotationList*, _nameIR <- _nameIR*, typeIR <- typeIR*} } as typeIR) -> $forall_($is_defaultable_typeIR(typeIR)*{typeIR <- typeIR*})
  row 10 :
    (HEADER_UNION _typeId < _typeArgumentIR*{_typeArgumentIR <- _typeArgumentIR*} > { _annotationList typeIR _nameIR ;*{_annotationList <- _annotationList*, _nameIR <- _nameIR*, typeIR <- typeIR*} } as typeIR) -> $forall_($is_defaultable_typeIR(typeIR)*{typeIR <- typeIR*})
  row 11 :
    (ENUM _typeId { _nameIR*{_nameIR <- _nameIR*} } as typeIR) -> true
  row 12 :
    (ENUM _typeId < typeIR > { _valueFieldIR*{_valueFieldIR <- _valueFieldIR*} } as typeIR) -> $is_defaultable_typeIR(typeIR)
  row 13 :
    (_typeIR) -> false

tbl def $is_equalable_typeIR(typeIR) : bool =
  row 0 :
    (VOID as typeIR) -> false
  row 1 :
    (` typeId as typeIR) -> false
  row 2 :
    (TYPEDEF _typeId typeIR as typeIR) -> $is_equalable_typeIR(typeIR)
  row 3 :
    (externObjectTypeIR as typeIR) -> false
  row 4 :
    (parserObjectTypeIR as typeIR) -> false
  row 5 :
    (controlObjectTypeIR as typeIR) -> false
  row 6 :
    (packageObjectTypeIR as typeIR) -> false
  row 7 :
    (tableObjectTypeIR as typeIR) -> false
  row 8 :
    (DEFAULT as typeIR) -> false
  row 9 :
    (sequenceTypeIR as typeIR) -> false
  row 10 :
    (recordTypeIR as typeIR) -> false
  row 11 :
    (HEADER_INVALID as typeIR) -> false
  row 12 :
    (setTypeIR as typeIR) -> false
  row 13 :
    (tableMetadataTypeIR as typeIR) -> false
  row 14 :
    (_typeIR) -> true

tbl def $is_assignable_typeIR(typeIR) : bool =
  row 0 :
    (VOID as typeIR) -> false
  row 1 :
    (STRING as typeIR) -> false
  row 2 :
    (INT as typeIR) -> false
  row 3 :
    (TYPEDEF _typeId typeIR as typeIR) -> $is_assignable_typeIR(typeIR)
  row 4 :
    (objectTypeIR as typeIR) -> false
  row 5 :
    (synthesizedTypeIR as typeIR) -> false
  row 6 :
    (_typeIR) -> true

def $typeId_of_typeDefIR(typeDefIR) : typeId =

  clause 0 : (typeDefIR) = typeId
  -- if typeDefIR <: nameTypeIR
  -- let ` typeId = typeDefIR as nameTypeIR

  clause 1 : (typeDefIR) = typeId
  -- if typeDefIR <: typedefTypeIR
  -- let TYPEDEF typeId _typeIR = typeDefIR as typedefTypeIR

  clause 2 : (typeDefIR) = typeId
  -- if typeDefIR <: newTypeIR
  -- let TYPE typeId _typeIR = typeDefIR as newTypeIR

  clause 3 : (typeDefIR) = typeId
  -- if typeDefIR <: structTypeDefIR
  -- let STRUCT typeId < _typeParameterIR*{_typeParameterIR <- _typeParameterIR*} > { _fieldTypeIR*{_fieldTypeIR <- _fieldTypeIR*} } = typeDefIR as structTypeDefIR

  clause 4 : (typeDefIR) = typeId
  -- if typeDefIR <: headerTypeDefIR
  -- let HEADER typeId < _typeParameterIR*{_typeParameterIR <- _typeParameterIR*} > { _fieldTypeIR*{_fieldTypeIR <- _fieldTypeIR*} } = typeDefIR as headerTypeDefIR

  clause 5 : (typeDefIR) = typeId
  -- if typeDefIR <: headerUnionTypeDefIR
  -- let HEADER_UNION typeId < _typeParameterIR*{_typeParameterIR <- _typeParameterIR*} > { _fieldTypeIR*{_fieldTypeIR <- _fieldTypeIR*} } = typeDefIR as headerUnionTypeDefIR

  clause 6 : (typeDefIR) = typeId
  -- if typeDefIR <: simpleEnumTypeIR
  -- let ENUM typeId { _nameIR*{_nameIR <- _nameIR*} } = typeDefIR as simpleEnumTypeIR

  clause 7 : (typeDefIR) = typeId
  -- if typeDefIR <: serializableEnumTypeIR
  -- let ENUM typeId < _typeIR > { _valueFieldIR*{_valueFieldIR <- _valueFieldIR*} } = typeDefIR as serializableEnumTypeIR

  clause 8 : (typeDefIR) = typeId
  -- if typeDefIR <: externObjectTypeDefIR
  -- let EXTERN typeId < _typeParameterIR*{_typeParameterIR <- _typeParameterIR*} , _typeParameterIR'*{_typeParameterIR' <- _typeParameterIR'*} > { _pair<callableId, externMethodTypeDefIR>*{_pair<callableId, externMethodTypeDefIR> <- _pair<callableId, externMethodTypeDefIR>*} } = typeDefIR as externObjectTypeDefIR

  clause 9 : (typeDefIR) = typeId
  -- if typeDefIR <: parserObjectTypeDefIR
  -- let PARSER typeId < _typeParameterIR*{_typeParameterIR <- _typeParameterIR*} , _typeParameterIR'*{_typeParameterIR' <- _typeParameterIR'*} > ( _parameterIR*{_parameterIR <- _parameterIR*} ) = typeDefIR as parserObjectTypeDefIR

  clause 10 : (typeDefIR) = typeId
  -- if typeDefIR <: controlObjectTypeDefIR
  -- let CONTROL typeId < _typeParameterIR*{_typeParameterIR <- _typeParameterIR*} , _typeParameterIR'*{_typeParameterIR' <- _typeParameterIR'*} > ( _parameterIR*{_parameterIR <- _parameterIR*} ) = typeDefIR as controlObjectTypeDefIR

  clause 11 : (typeDefIR) = typeId
  -- if typeDefIR <: packageObjectTypeDefIR
  -- let PACKAGE typeId < _typeParameterIR*{_typeParameterIR <- _typeParameterIR*} , _typeParameterIR'*{_typeParameterIR' <- _typeParameterIR'*} > { _typeIR*{_typeIR <- _typeIR*} } = typeDefIR as packageObjectTypeDefIR

  clause 12 : (typeDefIR) = typeId
  -- if typeDefIR <: tableObjectTypeIR
  -- let TABLE typeId { _tableMetadataStructTypeIR } = typeDefIR as tableObjectTypeIR

def $typeIR_of_typeDefIR(typeDefIR) : typeIR =

  clause 0 : (typeDefIR) = nameTypeDefIR as typeIR
  -- if typeDefIR <: nameTypeDefIR
  -- let nameTypeDefIR = typeDefIR as nameTypeDefIR

  clause 1 : (typeDefIR) = aliasTypeDefIR as typeIR
  -- if typeDefIR <: aliasTypeDefIR
  -- let aliasTypeDefIR = typeDefIR as aliasTypeDefIR

  clause 2 : (typeDefIR) = STRUCT typeId < ` typeParameterIR as typeIR*{typeParameterIR <- typeParameterIR*} > { fieldTypeIR*{fieldTypeIR <- fieldTypeIR*} } as typeIR
  -- if typeDefIR <: structTypeDefIR
  -- let STRUCT typeId < typeParameterIR*{typeParameterIR <- typeParameterIR*} > { fieldTypeIR*{fieldTypeIR <- fieldTypeIR*} } = typeDefIR as structTypeDefIR

  clause 3 : (typeDefIR) = HEADER typeId < ` typeParameterIR as typeIR*{typeParameterIR <- typeParameterIR*} > { fieldTypeIR*{fieldTypeIR <- fieldTypeIR*} } as typeIR
  -- if typeDefIR <: headerTypeDefIR
  -- let HEADER typeId < typeParameterIR*{typeParameterIR <- typeParameterIR*} > { fieldTypeIR*{fieldTypeIR <- fieldTypeIR*} } = typeDefIR as headerTypeDefIR

  clause 4 : (typeDefIR) = HEADER_UNION typeId < ` typeParameterIR as typeIR*{typeParameterIR <- typeParameterIR*} > { fieldTypeIR*{fieldTypeIR <- fieldTypeIR*} } as typeIR
  -- if typeDefIR <: headerUnionTypeDefIR
  -- let HEADER_UNION typeId < typeParameterIR*{typeParameterIR <- typeParameterIR*} > { fieldTypeIR*{fieldTypeIR <- fieldTypeIR*} } = typeDefIR as headerUnionTypeDefIR

  clause 5 : (typeDefIR) = enumTypeDefIR as typeIR
  -- if typeDefIR <: enumTypeDefIR
  -- let enumTypeDefIR = typeDefIR as enumTypeDefIR

  clause 6 : (typeDefIR) = EXTERN typeId < ` typeParameterIR as typeIR*{typeParameterIR <- typeParameterIR*} > { callableId : externMethodTypeDefIR*{callableId <- callableId*, externMethodTypeDefIR <- externMethodTypeDefIR*} } as typeIR
  -- if typeDefIR <: externObjectTypeDefIR
  -- let EXTERN typeId < typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*} , typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*} > { callableId : externMethodTypeDefIR*{callableId <- callableId*, externMethodTypeDefIR <- externMethodTypeDefIR*} } = typeDefIR as externObjectTypeDefIR
  -- let typeParameterIR*{typeParameterIR <- typeParameterIR*} = typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*} ++ typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*}

  clause 7 : (typeDefIR) = PARSER typeId < ` typeParameterIR as typeIR*{typeParameterIR <- typeParameterIR*} > ( parameterIR*{parameterIR <- parameterIR*} ) as typeIR
  -- if typeDefIR <: parserObjectTypeDefIR
  -- let PARSER typeId < typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*} , typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*} > ( parameterIR*{parameterIR <- parameterIR*} ) = typeDefIR as parserObjectTypeDefIR
  -- let typeParameterIR*{typeParameterIR <- typeParameterIR*} = typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*} ++ typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*}

  clause 8 : (typeDefIR) = CONTROL typeId < ` typeParameterIR as typeIR*{typeParameterIR <- typeParameterIR*} > ( parameterIR*{parameterIR <- parameterIR*} ) as typeIR
  -- if typeDefIR <: controlObjectTypeDefIR
  -- let CONTROL typeId < typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*} , typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*} > ( parameterIR*{parameterIR <- parameterIR*} ) = typeDefIR as controlObjectTypeDefIR
  -- let typeParameterIR*{typeParameterIR <- typeParameterIR*} = typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*} ++ typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*}

  clause 9 : (typeDefIR) = PACKAGE typeId < ` typeParameterIR as typeIR*{typeParameterIR <- typeParameterIR*} > { typeIR*{typeIR <- typeIR*} } as typeIR
  -- if typeDefIR <: packageObjectTypeDefIR
  -- let PACKAGE typeId < typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*} , typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*} > { typeIR*{typeIR <- typeIR*} } = typeDefIR as packageObjectTypeDefIR
  -- let typeParameterIR*{typeParameterIR <- typeParameterIR*} = typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*} ++ typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*}

  clause 10 : (typeDefIR) = tableObjectTypeDefIR as typeIR
  -- if typeDefIR <: tableObjectTypeDefIR
  -- let tableObjectTypeDefIR = typeDefIR as tableObjectTypeDefIR

def $typeParameterListIR_of_typeDefIR(typeDefIR) : (typeParameterIR*, typeParameterIR*) =

  clause 0 : (typeDefIR) = ([], [])
  -- if typeDefIR <: nameTypeDefIR
  -- let nameTypeDefIR = typeDefIR as nameTypeDefIR

  clause 1 : (typeDefIR) = ([], [])
