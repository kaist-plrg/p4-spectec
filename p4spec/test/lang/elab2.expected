def $result_concat(typeIR, typeIR) : typeIR =

  clause 0 : (typeIR, typeIR') = STRING as typeIR
  -- if typeIR <: stringTypeIR
  -- let stringTypeIR = typeIR as stringTypeIR
  -- if (stringTypeIR = STRING)
  -- if typeIR' <: stringTypeIR
  -- let stringTypeIR' = typeIR' as stringTypeIR
  -- if (stringTypeIR' = STRING)

  clause 1 : (typeIR, typeIR') = INT < (w_a + w_b) > as typeIR
  -- if typeIR <: fixedIntTypeIR
  -- let INT < w_a > = typeIR as fixedIntTypeIR
  -- if typeIR' <: fixedIntTypeIR
  -- let INT < w_b > = typeIR' as fixedIntTypeIR

  clause 2 : (typeIR, typeIR') = INT < (w_a + w_b) > as typeIR
  -- if typeIR <: fixedIntTypeIR
  -- let INT < w_a > = typeIR as fixedIntTypeIR
  -- if typeIR' <: fixedBitTypeIR
  -- let BIT < w_b > = typeIR' as fixedBitTypeIR

  clause 3 : (typeIR, typeIR') = BIT < (w_a + w_b) > as typeIR
  -- if typeIR <: fixedBitTypeIR
  -- let BIT < w_a > = typeIR as fixedBitTypeIR
  -- if typeIR' <: fixedIntTypeIR
  -- let INT < w_b > = typeIR' as fixedIntTypeIR

  clause 4 : (typeIR, typeIR') = BIT < (w_a + w_b) > as typeIR
  -- if typeIR <: fixedBitTypeIR
  -- let BIT < w_a > = typeIR as fixedBitTypeIR
  -- if typeIR' <: fixedBitTypeIR
  -- let BIT < w_b > = typeIR' as fixedBitTypeIR

  clause 5 : (typeIR, typeIR_r) = $result_concat(typeIR_l, typeIR_r)
  -- if typeIR <: typedefTypeIR
  -- let TYPEDEF _typeId typeIR_l = typeIR as typedefTypeIR

  clause 6 : (typeIR_l, typeIR) = $result_concat(typeIR_l, typeIR_r)
  -- if typeIR <: typedefTypeIR
  -- let TYPEDEF _typeId typeIR_r = typeIR as typedefTypeIR
  -- if ~typeIR_l <: typedefTypeIR

