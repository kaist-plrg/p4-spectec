  -- (let id_default = $id_of_parameterIR(parameterIR_omitted))*{parameterIR_omitted <- parameterIR_omitted*, id_default -> id_default*}

  clause 2 : (callTargetId : V, nameIR_f ( n_arg ), $get_parameterListIR) = MATCH [] id_optional*{id_optional <- id_optional*}
  -- let nameIR ( id_param*{id_param <- id_param*} ) = callTargetId
  -- if (nameIR = nameIR_f)
  -- let parameterIR*{parameterIR <- parameterIR*} = $get_parameterListIR(V)
  -- (let b_default = $is_default_parameterIR(parameterIR))*{parameterIR <- parameterIR*, b_default -> b_default*}
  -- (let b_optional = $is_optional_parameterIR(parameterIR))*{parameterIR <- parameterIR*, b_optional -> b_optional*}
