    -- (if (?(typeIR_inferred) = $find_map<typeId, typeIR>(inference, typeId_infer)))*{typeIR_inferred <- typeIR_inferred*, typeId_infer <- typeId_infer*}
    -- if (typeArgumentIR_inferred*{typeArgumentIR_inferred <- typeArgumentIR_inferred*} = typeArgumentIR*{typeArgumentIR <- typeArgumentIR*} ++ typeIR_inferred*{typeIR_inferred <- typeIR_inferred*})
    -- (if (parameterIR_aligned_inferred = $subst_parameterIR(inference, parameterIR_aligned)))*{parameterIR_aligned <- parameterIR_aligned*, parameterIR_aligned_inferred <- parameterIR_aligned_inferred*}
    -- if (typeIR_object_inferred = $subst_typeIR(inference, typeIR_object))
    -- if (constructorTypeIR_inferred = CONSTRUCTOR ( parameterIR_aligned_inferred*{parameterIR_aligned_inferred <- parameterIR_aligned_inferred*} ) : typeIR_object_inferred)
    -- if ConstructorType_wf: $bound(p, TC) |- constructorTypeIR_inferred holds
    -- if $instantiable(p, TC, instctxt, typeIR_object_inferred)
    -- if (typeIR_object_unroll = $unroll_typeIR(typeIR_object))
    -- if typeIR_object_unroll <: packageObjectTypeIR
    -- if (p = GLOBAL)
    -- Call_convention_ok: BLOCK TC NOACTION |- parameterIR_aligned_inferred*{parameterIR_aligned_inferred <- parameterIR_aligned_inferred*} @ argumentIR*{argumentIR <- argumentIR*} : argumentIR_cast*{argumentIR_cast <- argumentIR_cast*}

    rule non-package: p TC instctxt |- constructorTypeIR < typeArgumentIR*{typeArgumentIR <- typeArgumentIR*} # typeId_infer*{typeId_infer <- typeId_infer*} > ( argumentIR*{argumentIR <- argumentIR*} # id_default*{id_default <- id_default*} # id_optional*{id_optional <- id_optional*} ) : typeIR_object_inferred < typeArgumentIR_inferred*{typeArgumentIR_inferred <- typeArgumentIR_inferred*} > ( argumentIR_cast*{argumentIR_cast <- argumentIR_cast*} )
    -- if (CONSTRUCTOR ( parameterIR*{parameterIR <- parameterIR*} ) : typeIR_object = constructorTypeIR)
