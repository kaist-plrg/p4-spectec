    -- (if Cast_expl: typeIR_a -> typeIR_field_b holds)*{typeIR_a <- typeIR_a*, typeIR_field_b <- typeIR_field_b*}

  rulegroup sequenceTypeIR-default

    rule tupleTypeIR: SEQ < typeIR_a*{typeIR_a <- typeIR_a*} , ... > as typeIR -> TUPLE < typeIR_b*{typeIR_b <- typeIR_b*} > as typeIR
    -- if (|typeIR_a*{typeIR_a <- typeIR_a*}| < |typeIR_b*{typeIR_b <- typeIR_b*}|)
