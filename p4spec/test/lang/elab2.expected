  -- let (parameterIR_given*{parameterIR_given <- parameterIR_given*}, parameterIR_omitted*{parameterIR_omitted <- parameterIR_omitted*}) = $partition_<parameterIR>(parameterIR*{parameterIR <- parameterIR*}, n_arg)
  -- (if ~$is_default_parameterIR(parameterIR_given))*{parameterIR_given <- parameterIR_given*}
  -- (if $is_optional_parameterIR(parameterIR_omitted))*{parameterIR_omitted <- parameterIR_omitted*}
  -- (let id_optional = $id_of_parameterIR(parameterIR_omitted))*{parameterIR_omitted <- parameterIR_omitted*, id_optional -> id_optional*}

  clause -1 : (callTargetId : V, nameIR_f ( n_arg ), $get_parameterListIR) = NOMATCH

def $find_overloadeds_named<V>(map<callableId, V>, namedCallTargetKey, $get_parameterListIR(V) : parameterListIR) : callResolution<V>* =

  clause 0 : (set<pair<callableId, V>>, nameIR_f ( id_arg*{id_arg <- id_arg*} ), $get_parameterListIR) = []
  -- if (set<pair<callableId, V>> = { [] })

  clause 1 : ({ pair<callableId, V>*{pair<callableId, V> <- pair<callableId, V>*} }, nameIR_f ( id_arg*{id_arg <- id_arg*} ), $get_parameterListIR) = $find_overloadeds_named<V>({ callTargetId_t : V_t*{V_t <- V_t*, callTargetId_t <- callTargetId_t*} }, nameIR_f ( id_arg*{id_arg <- id_arg*} ), $get_parameterListIR)
  -- if pair<callableId, V>*{pair<callableId, V> <- pair<callableId, V>*} matches _ :: _
  -- let callTargetId_h : V_h :: callTargetId_t : V_t*{V_t <- V_t*, callTargetId_t <- callTargetId_t*} = pair<callableId, V>*{pair<callableId, V> <- pair<callableId, V>*}
  -- if (NOMATCH = $match_overloaded_named<V>(callTargetId_h : V_h, nameIR_f ( id_arg*{id_arg <- id_arg*} ), $get_parameterListIR))

  clause 2 : ({ pair<callableId, V>*{pair<callableId, V> <- pair<callableId, V>*} }, nameIR_f ( id_arg*{id_arg <- id_arg*} ), $get_parameterListIR) = callTargetId_h : V_h # id_default*{id_default <- id_default*} # id_optional*{id_optional <- id_optional*} :: $find_overloadeds_named<V>({ callTargetId_t : V_t*{V_t <- V_t*, callTargetId_t <- callTargetId_t*} }, nameIR_f ( id_arg*{id_arg <- id_arg*} ), $get_parameterListIR)
  -- if pair<callableId, V>*{pair<callableId, V> <- pair<callableId, V>*} matches _ :: _
  -- let callTargetId_h : V_h :: callTargetId_t : V_t*{V_t <- V_t*, callTargetId_t <- callTargetId_t*} = pair<callableId, V>*{pair<callableId, V> <- pair<callableId, V>*}
  -- let callTargetMatch = $match_overloaded_named<V>(callTargetId_h : V_h, nameIR_f ( id_arg*{id_arg <- id_arg*} ), $get_parameterListIR)
  -- if callTargetMatch matches `MATCH % %`
  -- let MATCH id_default*{id_default <- id_default*} id_optional*{id_optional <- id_optional*} = callTargetMatch

def $find_overloadeds_unnamed<V>(map<callableId, V>, unnamedCallTargetKey, $get_parameterListIR(V) : parameterListIR) : callResolution<V>* =

  clause 0 : (set<pair<callableId, V>>, nameIR_f ( nat ), $get_parameterListIR) = []
  -- if (set<pair<callableId, V>> = { [] })

  clause 1 : ({ pair<callableId, V>*{pair<callableId, V> <- pair<callableId, V>*} }, nameIR_f ( n_arg ), $get_parameterListIR) = $find_overloadeds_unnamed<V>({ callTargetId_t : V_t*{V_t <- V_t*, callTargetId_t <- callTargetId_t*} }, nameIR_f ( n_arg ), $get_parameterListIR)
  -- if pair<callableId, V>*{pair<callableId, V> <- pair<callableId, V>*} matches _ :: _
  -- let callTargetId_h : V_h :: callTargetId_t : V_t*{V_t <- V_t*, callTargetId_t <- callTargetId_t*} = pair<callableId, V>*{pair<callableId, V> <- pair<callableId, V>*}
  -- if (NOMATCH = $match_overloaded_unnamed<V>(callTargetId_h : V_h, nameIR_f ( n_arg ), $get_parameterListIR))

  clause 2 : ({ pair<callableId, V>*{pair<callableId, V> <- pair<callableId, V>*} }, nameIR_f ( n_arg ), $get_parameterListIR) = callTargetId_h : V_h # id_default*{id_default <- id_default*} # id_optional*{id_optional <- id_optional*} :: $find_overloadeds_unnamed<V>({ callTargetId_t : V_t*{V_t <- V_t*, callTargetId_t <- callTargetId_t*} }, nameIR_f ( n_arg ), $get_parameterListIR)
  -- if pair<callableId, V>*{pair<callableId, V> <- pair<callableId, V>*} matches _ :: _
  -- let callTargetId_h : V_h :: callTargetId_t : V_t*{V_t <- V_t*, callTargetId_t <- callTargetId_t*} = pair<callableId, V>*{pair<callableId, V> <- pair<callableId, V>*}
  -- let callTargetMatch = $match_overloaded_unnamed<V>(callTargetId_h : V_h, nameIR_f ( n_arg ), $get_parameterListIR)
  -- if callTargetMatch matches `MATCH % %`
  -- let MATCH id_default*{id_default <- id_default*} id_optional*{id_optional <- id_optional*} = callTargetMatch

def $find_overloaded<V>(map<callTargetId, V>, callTargetKey, $get_parameterListIR(V) : parameterListIR) : callResolution<V>? =

  clause 0 : ({ callableId : V*{V <- V*, callableId <- callableId*} }, nameIR_f ( id_arg?{id_arg <- id_arg?}*{id_arg? <- id_arg?*} ), $get_parameterListIR) = ?()
  -- if (|id_arg?{id_arg <- id_arg?}*{id_arg? <- id_arg?*}| > 0)
  -- (let id?{id <- id?} = id_arg?{id_arg <- id_arg?})*{id_arg? <- id_arg?*, id? -> id?*}
