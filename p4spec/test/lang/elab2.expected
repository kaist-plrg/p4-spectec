  rulegroup indexAccessExpressionIR

    rule tuple: p IC STO_0 |- typedExpressionIR_base [ typedExpressionIR_index ] as expressionIR # _expressionNoteIR : STO_2 value
    -- Expr_inst: p IC STO_0 |- typedExpressionIR_base : STO_1 value_base
    -- Expr_inst: p IC STO_1 |- typedExpressionIR_index : STO_2 integerValue_index as value
