    rule callee-cont-call-return: p EC_0 ARCH_0 |- callableTargetIR < typeArgumentIR*{typeArgumentIR <- typeArgumentIR*} > ( argumentIR*{argumentIR <- argumentIR*} ) ; as statementIR : EC_2 ARCH_2 `EMPTY as statementResult
    -- Callee_eval: p EC_0 ARCH_0 |- callableTargetIR < _ > ( argumentIR*{argumentIR <- argumentIR*} ) : EC_1 ARCH_1 ` callee as calleeResult
    -- Call_eval: p EC_1 ARCH_1 |- callee @ < typeArgumentIR*{typeArgumentIR <- typeArgumentIR*} > ( argumentIR*{argumentIR <- argumentIR*} ) : EC_2 ARCH_2 returnResult as callResult

  rulegroup returnStatementIR

    rule non-expression: LOCAL EC ARCH |- RETURN ; as statementIR : EC ARCH RETURN ?() as statementResult

    rule expression-abort: LOCAL EC_0 ARCH_0 |- RETURN typedExpressionIR ; as statementIR : EC_1 ARCH_1 abortResult as statementResult
    -- Expr_eval: LOCAL EC_0 ARCH_0 |- typedExpressionIR : EC_1 ARCH_1 abortResult as expressionResult

    rule expression-cont: LOCAL EC_0 ARCH_0 |- RETURN typedExpressionIR ; as statementIR : EC_1 ARCH_1 RETURN ?(value) as statementResult
