syntax calleeResult = 
   | ` callee (from continueResult<callee>) 
   | EXIT (from exitResult) 
   | REJECT errorValue (from rejectTransitionResult) 

relation Callee_eval: cursor evalContext arch |- callableTargetIR < _ > ( argumentListIR ) : evalContext arch calleeResult

  rulegroup actionCallee

    rule actionCallee: p EC ARCH |- referenceExpressionIR as callableTargetIR < _ > ( argumentListIR ) : EC ARCH ` actionCallee as callee as calleeResult
    -- if (?(_callableId : (p_ref, actionDef) as (cursor, callableDef) # id_default*{id_default <- id_default*} # _nameIR*{_nameIR <- _nameIR*}) = $find_callableDef_overloaded_e(p, EC, referenceExpressionIR, argumentListIR))
