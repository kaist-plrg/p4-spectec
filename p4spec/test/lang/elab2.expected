relation TypeArgument_ok: cursor typingContext |- typeArgument : typeArgumentIR # typeId*

  rulegroup 

    rule type: p TC |- type as typeArgument : typeIR # typeId_impl*{typeId_impl <- typeId_impl*}
    -- Type_ok: p TC |- type as typeOrVoid : typeIR # typeId_impl*{typeId_impl <- typeId_impl*}

