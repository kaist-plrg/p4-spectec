  -- let . nameIR = prefixedNameIR

def $find_type_e(cursor, evalContext, nameIR) : typeIR? =

  clause 0 : (p, EC, nameIR) = $find_map<typeId, typeIR>(EC.BLOCK.TYPE, nameIR)
  -- if p matches `BLOCK`

