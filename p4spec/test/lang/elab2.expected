extern relation ExternFunctionCall_eval_lctk: typingContext |- nameIR ( nameIR* ) ~> value

relation Expr_eval_lctk: cursor typingContext |- typedExpressionIR ~> value

  rulegroup literalExpressionIR

    rule booleanLiteral: p TC |- booleanLiteral as expressionIR # _expressionNoteIR ~> boolValue as value
    -- if (boolValue = $ite<boolValue>((booleanLiteral = TRUE), `B true, `B false))

    rule integerLiteral: p TC |- integerLiteral as expressionIR # _expressionNoteIR ~> integerLiteral as value

    rule stringLiteral: p TC |- stringLiteral as expressionIR # _expressionNoteIR ~> stringLiteral as value

  rulegroup referenceExpressionIR

    rule referenceExpressionIR: p TC |- prefixedNameIR as expressionIR # _expressionNoteIR ~> value
    -- if (value = $find_var_value_t(prefixedNameIR, p, TC))

  rulegroup defaultExpressionIR

    rule defaultExpressionIR: p TC |- ... as expressionIR # _expressionNoteIR ~> DEFAULT as value

  rulegroup unaryExpressionIR

    rule unaryExpressionIR: p TC |- unop typedExpressionIR as expressionIR # _expressionNoteIR ~> $un_op(unop, value)
    -- Expr_eval_lctk: p TC |- typedExpressionIR ~> value

  rulegroup binaryExpressionIR

    rule non-short-circuit: p TC |- typedExpressionIR_l binop typedExpressionIR_r as expressionIR # _expressionNoteIR ~> $bin_op(binop, value_l, value_r)
    -- if ~binop <- [&&, ||]
    -- Expr_eval_lctk: p TC |- typedExpressionIR_l ~> value_l
    -- Expr_eval_lctk: p TC |- typedExpressionIR_r ~> value_r

    rule land-false: p TC |- typedExpressionIR_l && typedExpressionIR_r as expressionIR # _expressionNoteIR ~> `B false as value
    -- Expr_eval_lctk: p TC |- typedExpressionIR_l ~> `B false as value

    rule land-true: p TC |- typedExpressionIR_l && typedExpressionIR_r as expressionIR # _expressionNoteIR ~> value_r
    -- Expr_eval_lctk: p TC |- typedExpressionIR_l ~> `B true as value
    -- Expr_eval_lctk: p TC |- typedExpressionIR_r ~> value_r

    rule lor-true: p TC |- typedExpressionIR_l || typedExpressionIR_r as expressionIR # _expressionNoteIR ~> `B true as value
    -- Expr_eval_lctk: p TC |- typedExpressionIR_l ~> `B true as value

    rule lor-false: p TC |- typedExpressionIR_l || typedExpressionIR_r as expressionIR # _expressionNoteIR ~> value_r
    -- Expr_eval_lctk: p TC |- typedExpressionIR_l ~> `B false as value
    -- Expr_eval_lctk: p TC |- typedExpressionIR_r ~> value_r

  rulegroup ternaryExpressionIR

    rule true: p TC |- typedExpressionIR_cond ? typedExpressionIR_true : typedExpressionIR_false as expressionIR # _expressionNoteIR ~> value_true
    -- Expr_eval_lctk: p TC |- typedExpressionIR_cond ~> `B true as value
    -- Expr_eval_lctk: p TC |- typedExpressionIR_true ~> value_true

    rule false: p TC |- typedExpressionIR_cond ? typedExpressionIR_true : typedExpressionIR_false as expressionIR # _expressionNoteIR ~> value_false
    -- Expr_eval_lctk: p TC |- typedExpressionIR_cond ~> `B false as value
    -- Expr_eval_lctk: p TC |- typedExpressionIR_false ~> value_false

  rulegroup castExpressionIR

    rule castExpressionIR: p TC |- ( typeIR ) typedExpressionIR as expressionIR # _expressionNoteIR ~> value_cast
    -- Expr_eval_lctk: p TC |- typedExpressionIR ~> value
    -- if (value_cast = $cast_op(typeIR, value))

  rulegroup invalidHeaderExpressionIR

    rule invalidHeaderExpressionIR: p TC |- {#} as expressionIR # _expressionNoteIR ~> {#} as value

  rulegroup sequenceExpressionIR

    rule non-default: p TC |- SEQ { typedExpressionIR*{typedExpressionIR <- typedExpressionIR*} } as expressionIR # _expressionNoteIR ~> SEQ ( value*{value <- value*} ) as value
    -- (Expr_eval_lctk: p TC |- typedExpressionIR ~> value)*{typedExpressionIR <- typedExpressionIR*, value <- value*}

    rule default: p TC |- SEQ { typedExpressionIR*{typedExpressionIR <- typedExpressionIR*} , ... } as expressionIR # _expressionNoteIR ~> SEQ ( value*{value <- value*} , ... ) as value
    -- (Expr_eval_lctk: p TC |- typedExpressionIR ~> value)*{typedExpressionIR <- typedExpressionIR*, value <- value*}

  rulegroup recordExpressionIR

    rule non-default: p TC |- RECORD { nameIR = typedExpressionIR*{nameIR <- nameIR*, typedExpressionIR <- typedExpressionIR*} } as expressionIR # _expressionNoteIR ~> RECORD { value nameIR ;*{nameIR <- nameIR*, value <- value*} } as value
    -- (Expr_eval_lctk: p TC |- typedExpressionIR ~> value)*{typedExpressionIR <- typedExpressionIR*, value <- value*}

    rule default: p TC |- RECORD { nameIR = typedExpressionIR*{nameIR <- nameIR*, typedExpressionIR <- typedExpressionIR*} , ... } as expressionIR # _expressionNoteIR ~> RECORD { value nameIR ;*{nameIR <- nameIR*, value <- value*} , ... } as value
    -- (Expr_eval_lctk: p TC |- typedExpressionIR ~> value)*{typedExpressionIR <- typedExpressionIR*, value <- value*}

  rulegroup errorAccessExpressionIR

    rule errorAccessExpressionIR: p TC |- ERROR . nameIR as expressionIR # ( _typeIR _ctk ) ~> value_error
    -- if (nameIR_error = "error." ++ nameIR)
    -- if (value_error = $find_var_value_t(` nameIR_error, p, TC))

  rulegroup memberAccessExpressionIR-type

    rule enum: p TC |- TYPE prefixedNameIR_base . nameIR as expressionIR # _expressionNoteIR ~> typeId . nameIR as value
    -- if (?(typeDefIR_base) = $find_typeDef_t(p, TC, prefixedNameIR_base))
    -- if $is_monomorphic_typeDefIR(typeDefIR_base)
    -- if (typeIR_base = $typeIR_of_typeDefIR(typeDefIR_base))
    -- if (ENUM typeId { nameIR_field*{nameIR_field <- nameIR_field*} } as typeIR = $unroll_typeIR(typeIR_base))
    -- if nameIR <- nameIR_field*{nameIR_field <- nameIR_field*}

    rule serenum: p TC |- TYPE prefixedNameIR_base . nameIR as expressionIR # _expressionNoteIR ~> typeId . nameIR . value as value
    -- if (?(typeDefIR_base) = $find_typeDef_t(p, TC, prefixedNameIR_base))
    -- if $is_monomorphic_typeDefIR(typeDefIR_base)
    -- if (typeIR_base = $typeIR_of_typeDefIR(typeDefIR_base))
    -- if (ENUM typeId < typeIR > { nameIR_field = value_field ;*{nameIR_field <- nameIR_field*, value_field <- value_field*} } as typeIR = $unroll_typeIR(typeIR_base))
    -- if (?(value) = $assoc_<nameIR, value>(nameIR, (nameIR_field, value_field)*{nameIR_field <- nameIR_field*, value_field <- value_field*}))

  rulegroup memberAccessExpressionIR-typedExpressionIR

    rule header-stack-size: p TC |- typedExpressionIR_base as memberAccessBaseIR . nameIR as expressionIR # _expressionNoteIR ~> D n_size as int as value
    -- if (typeIR_base = $type_of_typedExpressionIR(typedExpressionIR_base))
    -- if (_typeIR [ n_size ] as typeIR = $unroll_typeIR(typeIR_base))
    -- if (nameIR = "size")

    rule struct: p TC |- typedExpressionIR_base as memberAccessBaseIR . nameIR as expressionIR # _expressionNoteIR ~> value
    -- Expr_eval_lctk: p TC |- typedExpressionIR_base ~> structValue as value
    -- if (STRUCT _typeId { value_field nameIR_field ;*{nameIR_field <- nameIR_field*, value_field <- value_field*} } = structValue)
    -- if (?(value) = $assoc_<nameIR, value>(nameIR, (nameIR_field, value_field)*{nameIR_field <- nameIR_field*, value_field <- value_field*}))

    rule header: p TC |- typedExpressionIR_base as memberAccessBaseIR . nameIR as expressionIR # _expressionNoteIR ~> value
    -- Expr_eval_lctk: p TC |- typedExpressionIR_base ~> headerValue as value
    -- if (HEADER _typeId { _b ; value_field nameIR_field ;*{nameIR_field <- nameIR_field*, value_field <- value_field*} } = headerValue)
    -- if (?(value) = $assoc_<nameIR, value>(nameIR, (nameIR_field, value_field)*{nameIR_field <- nameIR_field*, value_field <- value_field*}))

    rule header-union: p TC |- typedExpressionIR_base as memberAccessBaseIR . nameIR as expressionIR # _expressionNoteIR ~> value
    -- Expr_eval_lctk: p TC |- typedExpressionIR_base ~> headerUnionValue as value
    -- if (HEADER_UNION _typeId { value_field nameIR_field ;*{nameIR_field <- nameIR_field*, value_field <- value_field*} } = headerUnionValue)
    -- if (?(value) = $assoc_<nameIR, value>(nameIR, (nameIR_field, value_field)*{nameIR_field <- nameIR_field*, value_field <- value_field*}))

  rulegroup indexAccessExpressionIR

    rule tuple: p TC |- typedExpressionIR_base [ typedExpressionIR_index ] as expressionIR # _expressionNoteIR ~> value
    -- Expr_eval_lctk: p TC |- typedExpressionIR_base ~> value_base
    -- Expr_eval_lctk: p TC |- typedExpressionIR_index ~> integerValue_index as value
    -- if (TUPLE ( value_e*{value_e <- value_e*} ) as value = value_base)
    -- if (?(n_index) = $nat_of_integerValue(integerValue_index))
    -- if (n_index < |value_e*{value_e <- value_e*}|)
    -- if (value = value_e*{value_e <- value_e*}[n_index])

    rule indexAccessExpressionIR-stack: p TC |- typedExpressionIR_base [ typedExpressionIR_index ] as expressionIR # _expressionNoteIR ~> value
    -- Expr_eval_lctk: p TC |- typedExpressionIR_base ~> value_base
    -- Expr_eval_lctk: p TC |- typedExpressionIR_index ~> integerValue_index as value
    -- if (HEADER_STACK [ value_e*{value_e <- value_e*} ( _nat ; _nat' ) ] as value = value_base)
    -- if (?(n_index) = $nat_of_integerValue(integerValue_index))
    -- if (n_index < |value_e*{value_e <- value_e*}|)
    -- if (value = value_e*{value_e <- value_e*}[n_index])

  rulegroup sliceAccessExpressionIR

    rule range: p TC |- typedExpressionIR_base [ typedExpressionIR_hi : typedExpressionIR_lo ] as expressionIR # _expressionNoteIR ~> $bitacc_range_op(value_base, value_hi, value_lo)
    -- Expr_eval_lctk: p TC |- typedExpressionIR_base ~> value_base
    -- Expr_eval_lctk: p TC |- typedExpressionIR_hi ~> value_hi
    -- Expr_eval_lctk: p TC |- typedExpressionIR_lo ~> value_lo

    rule offset: p TC |- typedExpressionIR_base [ typedExpressionIR_l +: typedExpressionIR_w ] as expressionIR # _expressionNoteIR ~> $bitacc_offset_op(value_base, value_l, value_w)
    -- Expr_eval_lctk: p TC |- typedExpressionIR_base ~> value_base
    -- Expr_eval_lctk: p TC |- typedExpressionIR_l ~> value_l
    -- Expr_eval_lctk: p TC |- typedExpressionIR_w ~> value_w

  rulegroup callExpressionIR

    rule static_assert: p TC |- prefixedNameIR as callableTargetIR < typeArgumentIR*{typeArgumentIR <- typeArgumentIR*} > ( argumentIR*{argumentIR <- argumentIR*} ) as expressionIR # _expressionNoteIR ~> boolValue as value
    -- CallableType_ok: p TC |- prefixedNameIR as callableTargetIR < typeArgumentIR*{typeArgumentIR <- typeArgumentIR*} > ( argumentIR*{argumentIR <- argumentIR*} ) : externFunctionTypeIR as callableTypeIR < # _typeId*{_typeId <- _typeId*} > ( # id_default*{id_default <- id_default*} # id_optional*{id_optional <- id_optional*} )
    -- if (EXTERN_FUNCTION "static_assert" ( parameterIR*{parameterIR <- parameterIR*} ) : BOOL as typeIR = externFunctionTypeIR)
    -- (if (_annotationList _direction _typeIR nameIR_param _parameterInitializerOptIR = parameterIR))*{_annotationList <- _annotationList*, _direction <- _direction*, _parameterInitializerOptIR <- _parameterInitializerOptIR*, _typeIR <- _typeIR*, nameIR_param <- nameIR_param*, parameterIR <- parameterIR*}
    -- if (TC_callee_0 = $empty_typingContext)
    -- if (GIVEN parameterIR_aligned*{parameterIR_aligned <- parameterIR_aligned*} DEFAULT [] = $align_parameterListIR(parameterIR*{parameterIR <- parameterIR*}, argumentIR*{argumentIR <- argumentIR*}, id_default*{id_default <- id_default*}, id_optional*{id_optional <- id_optional*}))
    -- (Argument_eval_lctk: p TC |- argumentIR ~> value_argument)*{argumentIR <- argumentIR*, value_argument <- value_argument*}
    -- (if (_annotationList' direction_param_aligned typeIR_param_aligned nameIR_param_aligned _parameterInitializerOptIR' = parameterIR_aligned))*{_annotationList' <- _annotationList'*, _parameterInitializerOptIR' <- _parameterInitializerOptIR'*, direction_param_aligned <- direction_param_aligned*, nameIR_param_aligned <- nameIR_param_aligned*, parameterIR_aligned <- parameterIR_aligned*, typeIR_param_aligned <- typeIR_param_aligned*}
    -- (if (varTypeIR = direction_param_aligned typeIR_param_aligned LCTK ?(value_argument)))*{direction_param_aligned <- direction_param_aligned*, typeIR_param_aligned <- typeIR_param_aligned*, value_argument <- value_argument*, varTypeIR <- varTypeIR*}
    -- if (TC_callee_1 = $add_vars_t(LOCAL, TC_callee_0, nameIR_param_aligned*{nameIR_param_aligned <- nameIR_param_aligned*}, varTypeIR*{varTypeIR <- varTypeIR*}))
    -- ExternFunctionCall_eval_lctk: TC_callee_1 |- "static_assert" ( nameIR_param*{nameIR_param <- nameIR_param*} ) ~> boolValue as value
    -- if (`B true = boolValue)

    rule size-expression: p TC |- typedExpressionIR_base . nameIR < _typeArgumentListIR > ( _argumentListIR ) as expressionIR # _expressionNoteIR ~> $sizeof(typeIR_base, nameIR)
    -- if (_expressionIR # ( typeIR_base _ctk ) = typedExpressionIR_base)
    -- if nameIR <- ["minSizeInBits", "minSizeInBytes", "maxSizeInBits", "maxSizeInBytes"]

    rule size-type-monomorphic: p TC |- TYPE prefixedNameIR . nameIR < _typeArgumentListIR > ( _argumentListIR ) as expressionIR # _expressionNoteIR ~> $sizeof(typeIR_base, nameIR)
    -- if (?(typeDefIR_base) = $find_typeDef_t(p, TC, prefixedNameIR))
    -- if $is_monomorphic_typeDefIR(typeDefIR_base)
    -- if (typeIR_base = $typeIR_of_typeDefIR(typeDefIR_base))
    -- if nameIR <- ["minSizeInBits", "minSizeInBytes", "maxSizeInBits", "maxSizeInBytes"]

    rule size-type-polymorphic: p TC |- TYPE prefixedNameIR . nameIR < _typeArgumentListIR > ( _argumentListIR ) as expressionIR # _expressionNoteIR ~> $sizeof(typeIR_base, nameIR)
    -- if (?(typeDefIR_base) = $find_typeDef_t(p, TC, prefixedNameIR))
    -- if ~$is_monomorphic_typeDefIR(typeDefIR_base)
    -- if (([], []) = $typeParameterListIR_of_typeDefIR(typeDefIR_base))
    -- if (typeIR_base = $typeIR_of_typeDefIR(typeDefIR_base))
    -- if nameIR <- ["minSizeInBits", "minSizeInBytes", "maxSizeInBits", "maxSizeInBytes"]

    rule callExpressionIR-parenthesized: p TC |- ( callableTargetIR ) < typeArgumentIR*{typeArgumentIR <- typeArgumentIR*} > ( argumentIR*{argumentIR <- argumentIR*} ) as expressionIR # ( typeIR ctk ) ~> value
    -- Expr_eval_lctk: p TC |- callableTargetIR < typeArgumentIR*{typeArgumentIR <- typeArgumentIR*} > ( argumentIR*{argumentIR <- argumentIR*} ) as expressionIR # ( typeIR ctk ) ~> value

  rulegroup parenthesizedExpressionIR

    rule parenthesizedExpressionIR: p TC |- ( typedExpressionIR ) as expressionIR # _expressionNoteIR ~> value
    -- Expr_eval_lctk: p TC |- typedExpressionIR ~> value

relation Argument_eval_lctk: cursor typingContext |- argumentIR ~> value

  rulegroup 

    rule typedExpressionIR: p TC |- typedExpressionIR as argumentIR ~> value
    -- Expr_eval_lctk: p TC |- typedExpressionIR ~> value

    rule namedArgumentIR: p TC |- nameIR = typedExpressionIR ~> value
    -- Expr_eval_lctk: p TC |- typedExpressionIR ~> value

relation Type_ok: cursor typingContext |- typeOrVoid : typeIR # typeId*

  rulegroup void

    rule void: p TC |- VOID : VOID as typeIR # []

  rulegroup boolean

    rule boolean: p TC |- BOOL as typeOrVoid : BOOL as typeIR # []

  rulegroup error

    rule error: p TC |- ERROR as typeOrVoid : ERROR as typeIR # []

  rulegroup matchKind

    rule matchKind: p TC |- MATCH_KIND as typeOrVoid : MATCH_KIND as typeIR # []

  rulegroup string

    rule string: p TC |- STRING as typeOrVoid : STRING as typeIR # []

  rulegroup arbitraryInt

    rule arbitraryInt: p TC |- INT as typeOrVoid : INT as typeIR # []

  rulegroup fixedInt

    rule integer: p TC |- INT < n as int > as typeOrVoid : INT < n > as typeIR # []
    -- if (n > 0)

    rule expression: p TC |- INT < ( expression ) > as typeOrVoid : INT < n > as typeIR # []
    -- Expr_ok: p TC |- expression : typedExpressionIR
    -- if (LCTK = $ctk_of_typedExpressionIR(typedExpressionIR))
    -- Expr_eval_lctk: p TC |- typedExpressionIR ~> integerValue as value
    -- if (?(n) = $nat_of_integerValue(integerValue))
    -- if (n > 0)

  rulegroup fixedBit

    rule none: p TC |- BIT as typeOrVoid : BIT < 1 > as typeIR # []

    rule integer: p TC |- BIT < n as int > as typeOrVoid : BIT < n > as typeIR # []

    rule expression: p TC |- BIT < ( expression ) > as typeOrVoid : BIT < n > as typeIR # []
    -- Expr_ok: p TC |- expression : typedExpressionIR
    -- if (LCTK = $ctk_of_typedExpressionIR(typedExpressionIR))
    -- Expr_eval_lctk: p TC |- typedExpressionIR ~> integerValue as value
    -- if (?(n) = $nat_of_integerValue(integerValue))

  rulegroup variableBit

    rule integer: p TC |- VARBIT < n as int > as typeOrVoid : VARBIT < n > as typeIR # []

    rule expression: p TC |- VARBIT < ( expression ) > as typeOrVoid : VARBIT < n > as typeIR # []
    -- Expr_ok: p TC |- expression : typedExpressionIR
    -- if (LCTK = $ctk_of_typedExpressionIR(typedExpressionIR))
    -- Expr_eval_lctk: p TC |- typedExpressionIR ~> integerValue as value
    -- if (?(n) = $nat_of_integerValue(integerValue))

  rulegroup prefixedTypeName-identifier

    rule identifier: p TC |- `ID typeId as typeOrVoid : typeIR # typeId_fresh*{typeId_fresh <- typeId_fresh*}
    -- Type_ok: p TC |- `TID typeId as typeOrVoid : typeIR # typeId_fresh*{typeId_fresh <- typeId_fresh*}

    rule monomorphic: p TC |- prefixedTypeName as typeOrVoid : typeIR # []
    -- if (prefixedNameIR = $prefixedTypeName(prefixedTypeName))
