syntax transitionResult = 
   | ACCEPT (from acceptTransitionResult) 
   | REJECT errorValue (from rejectTransitionResult) 
   | STATE id (from stateTransitionResult) 

relation ParserSelect_eval: evalContext arch |- selectExpressionIR : evalContext arch transitionResult

  rulegroup 

    rule reject: EC_0 ARCH_0 |- selectExpressionIR : EC_1 ARCH_1 rejectTransitionResult as transitionResult
    -- if (SELECT ( typedExpressionIR_key*{typedExpressionIR_key <- typedExpressionIR_key*} ) { selectCaseListIR } = selectExpressionIR)
    -- Exprs_eval: LOCAL EC_0 ARCH_0 |- typedExpressionIR_key*{typedExpressionIR_key <- typedExpressionIR_key*} : EC_1 ARCH_1 rejectTransitionResult as expressionListResult

    rule cont-selectCaseListIR-reject: EC_0 ARCH_0 |- selectExpressionIR : EC_2 ARCH_2 rejectTransitionResult as transitionResult
    -- if (SELECT ( typedExpressionIR_key*{typedExpressionIR_key <- typedExpressionIR_key*} ) { selectCaseListIR } = selectExpressionIR)
    -- Exprs_eval: LOCAL EC_0 ARCH_0 |- typedExpressionIR_key*{typedExpressionIR_key <- typedExpressionIR_key*} : EC_1 ARCH_1 ` value_key*{value_key <- value_key*} as expressionListResult
    -- SelectCases_match: EC_1 ARCH_1 value_key*{value_key <- value_key*} |- selectCaseListIR : EC_2 ARCH_2 rejectTransitionResult as selectCaseMatchResult

    rule no-match: EC_0 ARCH_0 |- selectExpressionIR : EC_2 ARCH_2 rejectTransitionResult as transitionResult
    -- if (SELECT ( typedExpressionIR_key*{typedExpressionIR_key <- typedExpressionIR_key*} ) { selectCaseListIR } = selectExpressionIR)
    -- Exprs_eval: LOCAL EC_0 ARCH_0 |- typedExpressionIR_key*{typedExpressionIR_key <- typedExpressionIR_key*} : EC_1 ARCH_1 ` value_key*{value_key <- value_key*} as expressionListResult
    -- SelectCases_match: EC_1 ARCH_1 value_key*{value_key <- value_key*} |- selectCaseListIR : EC_2 ARCH_2 ` nameIR_state?{nameIR_state <- nameIR_state?} as selectCaseMatchResult
    -- if (?() = nameIR_state?{nameIR_state <- nameIR_state?})
    -- if (rejectTransitionResult = REJECT ERROR . "NoMatch")

    rule match: EC_0 ARCH_0 |- selectExpressionIR : EC_3 ARCH_3 transitionResult
    -- if (SELECT ( typedExpressionIR_key*{typedExpressionIR_key <- typedExpressionIR_key*} ) { selectCaseListIR } = selectExpressionIR)
    -- Exprs_eval: LOCAL EC_0 ARCH_0 |- typedExpressionIR_key*{typedExpressionIR_key <- typedExpressionIR_key*} : EC_1 ARCH_1 ` value_key*{value_key <- value_key*} as expressionListResult
    -- SelectCases_match: EC_1 ARCH_1 value_key*{value_key <- value_key*} |- selectCaseListIR : EC_2 ARCH_2 ` ?(nameIR_state) as selectCaseMatchResult
    -- ParserTransition_eval: EC_2 ARCH_2 |- TRANSITION nameIR_state ; : EC_3 ARCH_3 transitionResult

relation ParserTransition_eval: evalContext arch |- transitionStatementIR : evalContext arch transitionResult

  rulegroup 

    rule nameIR-accept: EC ARCH |- TRANSITION nameIR ; : EC ARCH ACCEPT as transitionResult
    -- if (nameIR = "accept")

    rule nameIR-reject: EC ARCH |- TRANSITION nameIR ; : EC ARCH REJECT errorValue as transitionResult
    -- if (nameIR = "reject")
    -- if (errorValue = ERROR . "NoError")

    rule nameIR-state: EC ARCH |- TRANSITION nameIR ; : EC ARCH STATE nameIR as transitionResult
    -- if ((nameIR =/= "accept") /\ (nameIR =/= "reject"))

    rule selectExpressionIR: EC_0 ARCH_0 |- TRANSITION selectExpressionIR as stateExpressionIR : EC_1 ARCH_1 transitionResult
    -- ParserSelect_eval: EC_0 ARCH_0 |- selectExpressionIR : EC_1 ARCH_1 transitionResult

