    rule callee-cont-call-abort: p EC_0 ARCH_0 |- callableTargetIR < typeArgumentIR*{typeArgumentIR <- typeArgumentIR*} > ( argumentIR*{argumentIR <- argumentIR*} ) ; as statementIR : EC_2 ARCH_2 abortResult as statementResult
    -- Callee_eval: p EC_0 ARCH_0 |- callableTargetIR < _ > ( argumentIR*{argumentIR <- argumentIR*} ) : EC_1 ARCH_1 ` callee as calleeResult
