    -- (if Cast_expl: typeIR_field_a_aligned -> typeIR_field_b_aligned holds)*{typeIR_field_a_aligned <- typeIR_field_a_aligned*, typeIR_field_b_aligned <- typeIR_field_b_aligned*}

    rule headerTypeIR: RECORD { _annotationList typeIR_field_a id_field_a ;*{_annotationList <- _annotationList*, id_field_a <- id_field_a*, typeIR_field_a <- typeIR_field_a*} } as typeIR -> HEADER _typeId < _typeArgumentIR*{_typeArgumentIR <- _typeArgumentIR*} > { _annotationList' typeIR_field_b id_field_b ;*{_annotationList' <- _annotationList'*, id_field_b <- id_field_b*, typeIR_field_b <- typeIR_field_b*} } as typeIR
    -- if $eq_set<id>({ id_field_a*{id_field_a <- id_field_a*} }, { id_field_b*{id_field_b <- id_field_b*} })
    -- (if (?(typeIR_field_a_aligned) = $find_map<id, typeIR>({ id_field_a : typeIR_field_a*{id_field_a <- id_field_a*, typeIR_field_a <- typeIR_field_a*} }, id_field_a)))*{id_field_a <- id_field_a*, typeIR_field_a_aligned <- typeIR_field_a_aligned*}
    -- (if (?(typeIR_field_b_aligned) = $find_map<id, typeIR>({ id_field_b : typeIR_field_b*{id_field_b <- id_field_b*, typeIR_field_b <- typeIR_field_b*} }, id_field_a)))*{id_field_a <- id_field_a*, typeIR_field_b_aligned <- typeIR_field_b_aligned*}
    -- (if Cast_expl: typeIR_field_a_aligned -> typeIR_field_b_aligned holds)*{typeIR_field_a_aligned <- typeIR_field_a_aligned*, typeIR_field_b_aligned <- typeIR_field_b_aligned*}

  rulegroup recordTypeIR-default

    rule structTypeIR: RECORD { _annotationList typeIR_field_a id_field_a ;*{_annotationList <- _annotationList*, id_field_a <- id_field_a*, typeIR_field_a <- typeIR_field_a*} , ... } as typeIR -> STRUCT _typeId < _typeArgumentIR*{_typeArgumentIR <- _typeArgumentIR*} > { _annotationList' typeIR_field_b id_field_b ;*{_annotationList' <- _annotationList'*, id_field_b <- id_field_b*, typeIR_field_b <- typeIR_field_b*} } as typeIR
    -- if $sub_set<id>({ id_field_a*{id_field_a <- id_field_a*} }, { id_field_b*{id_field_b <- id_field_b*} })
    -- (if (?(typeIR_field_a_aligned) = $find_map<id, typeIR>({ id_field_a : typeIR_field_a*{id_field_a <- id_field_a*, typeIR_field_a <- typeIR_field_a*} }, id_field_a)))*{id_field_a <- id_field_a*, typeIR_field_a_aligned <- typeIR_field_a_aligned*}
    -- (if (?(typeIR_field_b_non_default_aligned) = $find_map<id, typeIR>({ id_field_b : typeIR_field_b*{id_field_b <- id_field_b*, typeIR_field_b <- typeIR_field_b*} }, id_field_a)))*{id_field_a <- id_field_a*, typeIR_field_b_non_default_aligned <- typeIR_field_b_non_default_aligned*}
    -- (if Cast_expl: typeIR_field_a_aligned -> typeIR_field_b_non_default_aligned holds)*{typeIR_field_a_aligned <- typeIR_field_a_aligned*, typeIR_field_b_non_default_aligned <- typeIR_field_b_non_default_aligned*}
    -- if ({ id_default*{id_default <- id_default*} } = $diff_set<id>({ id_field_b*{id_field_b <- id_field_b*} }, { id_field_a*{id_field_a <- id_field_a*} }))
    -- (if (?(typeIR_field_b_default) = $find_map<id, typeIR>({ id_field_b : typeIR_field_b*{id_field_b <- id_field_b*, typeIR_field_b <- typeIR_field_b*} }, id_default)))*{id_default <- id_default*, typeIR_field_b_default <- typeIR_field_b_default*}
    -- (if $is_defaultable_typeIR(typeIR_field_b_default))*{typeIR_field_b_default <- typeIR_field_b_default*}

    rule headerTypeIR: RECORD { _annotationList typeIR_field_a id_field_a ;*{_annotationList <- _annotationList*, id_field_a <- id_field_a*, typeIR_field_a <- typeIR_field_a*} , ... } as typeIR -> HEADER _typeId < _typeArgumentIR*{_typeArgumentIR <- _typeArgumentIR*} > { _annotationList' typeIR_field_b id_field_b ;*{_annotationList' <- _annotationList'*, id_field_b <- id_field_b*, typeIR_field_b <- typeIR_field_b*} } as typeIR
    -- if $sub_set<id>({ id_field_a*{id_field_a <- id_field_a*} }, { id_field_b*{id_field_b <- id_field_b*} })
    -- (if (?(typeIR_field_a_aligned) = $find_map<id, typeIR>({ id_field_a : typeIR_field_a*{id_field_a <- id_field_a*, typeIR_field_a <- typeIR_field_a*} }, id_field_a)))*{id_field_a <- id_field_a*, typeIR_field_a_aligned <- typeIR_field_a_aligned*}
    -- (if (?(typeIR_field_b_non_default_aligned) = $find_map<id, typeIR>({ id_field_b : typeIR_field_b*{id_field_b <- id_field_b*, typeIR_field_b <- typeIR_field_b*} }, id_field_a)))*{id_field_a <- id_field_a*, typeIR_field_b_non_default_aligned <- typeIR_field_b_non_default_aligned*}
    -- (if Cast_expl: typeIR_field_a_aligned -> typeIR_field_b_non_default_aligned holds)*{typeIR_field_a_aligned <- typeIR_field_a_aligned*, typeIR_field_b_non_default_aligned <- typeIR_field_b_non_default_aligned*}
    -- if ({ id_default*{id_default <- id_default*} } = $diff_set<id>({ id_field_b*{id_field_b <- id_field_b*} }, { id_field_a*{id_field_a <- id_field_a*} }))
    -- (if (?(typeIR_field_b_default) = $find_map<id, typeIR>({ id_field_b : typeIR_field_b*{id_field_b <- id_field_b*, typeIR_field_b <- typeIR_field_b*} }, id_default)))*{id_default <- id_default*, typeIR_field_b_default <- typeIR_field_b_default*}
    -- (if $is_defaultable_typeIR(typeIR_field_b_default))*{typeIR_field_b_default <- typeIR_field_b_default*}

relation Cast_impl: typeIR -> typeIR

  rulegroup 

    rule equals: typeIR_a -> typeIR_b
    -- if (typeIR_a_unroll = $unroll_typeIR(typeIR_a))
    -- if (typeIR_b_unroll = $unroll_typeIR(typeIR_b))
    -- if Type_alpha: typeIR_a_unroll ~~ typeIR_b_unroll holds

    rule not-equals: typeIR_a -> typeIR_b
    -- if (typeIR_a_unroll = $unroll_typeIR(typeIR_a))
    -- if (typeIR_b_unroll = $unroll_typeIR(typeIR_b))
    -- if Type_alpha: typeIR_a_unroll ~~ typeIR_b_unroll does not hold
    -- if Cast_impl_neq: typeIR_a_unroll -> typeIR_b_unroll holds

relation Cast_impl_neq: typeIR -> typeIR

  rulegroup arbitraryInt

    rule fixInt: INT as typeIR -> INT < _nat > as typeIR

    rule fixBit: INT as typeIR -> BIT < _nat > as typeIR

  rulegroup enumTypeIR-serializable

    rule enumTypeIR-serializable: ENUM _typeId < typeIR_a > { _valueFieldIR*{_valueFieldIR <- _valueFieldIR*} } as typeIR -> typeIR_b
    -- if Cast_impl: typeIR_a -> typeIR_b holds

  rulegroup defaultTypeIR

    rule defaultTypeIR: DEFAULT as typeIR -> typeIR_b
    -- if $is_defaultable_typeIR(typeIR_b)

  rulegroup invalidHeaderTypeIR

    rule headerTypeIR: HEADER_INVALID as typeIR -> headerTypeIR as typeIR

    rule headerUnionTypeIR: HEADER_INVALID as typeIR -> headerUnionTypeIR as typeIR

  rulegroup sequenceTypeIR-non-default

    rule listTypeIR: SEQ < typeIR_a*{typeIR_a <- typeIR_a*} > as typeIR -> LIST < typeIR_b > as typeIR
    -- (if Cast_impl: typeIR_a -> typeIR_b holds)*{typeIR_a <- typeIR_a*}

    rule tupleTypeIR: SEQ < typeIR_a*{typeIR_a <- typeIR_a*} > as typeIR -> TUPLE < typeIR_b*{typeIR_b <- typeIR_b*} > as typeIR
    -- (if Cast_impl: typeIR_a -> typeIR_b holds)*{typeIR_a <- typeIR_a*, typeIR_b <- typeIR_b*}

    rule headerStackTypeIR: SEQ < typeIR_a*{typeIR_a <- typeIR_a*} > as typeIR -> typeIR_b [ n_size ] as typeIR
    -- if (|typeIR_a*{typeIR_a <- typeIR_a*}| <= n_size)
    -- (if Cast_impl: typeIR_a -> typeIR_b holds)*{typeIR_a <- typeIR_a*}

    rule structTypeIR: SEQ < typeIR_a*{typeIR_a <- typeIR_a*} > as typeIR -> STRUCT _typeId < _typeArgumentIR*{_typeArgumentIR <- _typeArgumentIR*} > { _annotationList typeIR_field_b _nameIR ;*{_annotationList <- _annotationList*, _nameIR <- _nameIR*, typeIR_field_b <- typeIR_field_b*} } as typeIR
    -- (if Cast_impl: typeIR_a -> typeIR_field_b holds)*{typeIR_a <- typeIR_a*, typeIR_field_b <- typeIR_field_b*}

    rule headerTypeIR: SEQ < typeIR_a*{typeIR_a <- typeIR_a*} > as typeIR -> HEADER _typeId < _typeArgumentIR*{_typeArgumentIR <- _typeArgumentIR*} > { _annotationList typeIR_field_b _nameIR ;*{_annotationList <- _annotationList*, _nameIR <- _nameIR*, typeIR_field_b <- typeIR_field_b*} } as typeIR
    -- (if Cast_impl: typeIR_a -> typeIR_field_b holds)*{typeIR_a <- typeIR_a*, typeIR_field_b <- typeIR_field_b*}

    rule sequenceTypeIR: SEQ < typeIR_a*{typeIR_a <- typeIR_a*} > as typeIR -> SEQ < typeIR_b*{typeIR_b <- typeIR_b*} > as typeIR
    -- (if Cast_impl: typeIR_a -> typeIR_b holds)*{typeIR_a <- typeIR_a*, typeIR_b <- typeIR_b*}

  rulegroup sequenceTypeIR-default

    rule tupleTypeIR: SEQ < typeIR_a*{typeIR_a <- typeIR_a*} , ... > as typeIR -> TUPLE < typeIR_b*{typeIR_b <- typeIR_b*} > as typeIR
    -- if (|typeIR_a*{typeIR_a <- typeIR_a*}| < |typeIR_b*{typeIR_b <- typeIR_b*}|)
    -- if ((typeIR_b_non_default*{typeIR_b_non_default <- typeIR_b_non_default*}, typeIR_b_default*{typeIR_b_default <- typeIR_b_default*}) = $partition_<typeIR>(typeIR_b*{typeIR_b <- typeIR_b*}, |typeIR_a*{typeIR_a <- typeIR_a*}|))
    -- (if Cast_impl: typeIR_a -> typeIR_b_non_default holds)*{typeIR_a <- typeIR_a*, typeIR_b_non_default <- typeIR_b_non_default*}
    -- (if $is_defaultable_typeIR(typeIR_b_default))*{typeIR_b_default <- typeIR_b_default*}

    rule headerStackTypeIR: SEQ < typeIR_a*{typeIR_a <- typeIR_a*} , ... > as typeIR -> typeIR_b [ n_size ] as typeIR
    -- if (|typeIR_a*{typeIR_a <- typeIR_a*}| < n_size)
    -- (if Cast_impl: typeIR_a -> typeIR_b holds)*{typeIR_a <- typeIR_a*}
    -- if $is_defaultable_typeIR(typeIR_b)

    rule structTypeIR: SEQ < typeIR_a*{typeIR_a <- typeIR_a*} , ... > as typeIR -> STRUCT _typeId < _typeArgumentIR*{_typeArgumentIR <- _typeArgumentIR*} > { _annotationList typeIR_field_b _nameIR ;*{_annotationList <- _annotationList*, _nameIR <- _nameIR*, typeIR_field_b <- typeIR_field_b*} } as typeIR
    -- if (|typeIR_a*{typeIR_a <- typeIR_a*}| < |typeIR_field_b*{typeIR_field_b <- typeIR_field_b*}|)
    -- if ((typeIR_field_b_non_default*{typeIR_field_b_non_default <- typeIR_field_b_non_default*}, typeIR_field_b_default*{typeIR_field_b_default <- typeIR_field_b_default*}) = $partition_<typeIR>(typeIR_field_b*{typeIR_field_b <- typeIR_field_b*}, |typeIR_a*{typeIR_a <- typeIR_a*}|))
    -- (if Cast_impl: typeIR_a -> typeIR_field_b_non_default holds)*{typeIR_a <- typeIR_a*, typeIR_field_b_non_default <- typeIR_field_b_non_default*}
    -- (if $is_defaultable_typeIR(typeIR_field_b_default))*{typeIR_field_b_default <- typeIR_field_b_default*}

    rule headerTypeIR: SEQ < typeIR_a*{typeIR_a <- typeIR_a*} , ... > as typeIR -> HEADER _typeId < _typeArgumentIR*{_typeArgumentIR <- _typeArgumentIR*} > { _annotationList typeIR_field_b _nameIR ;*{_annotationList <- _annotationList*, _nameIR <- _nameIR*, typeIR_field_b <- typeIR_field_b*} } as typeIR
    -- if (|typeIR_a*{typeIR_a <- typeIR_a*}| < |typeIR_field_b*{typeIR_field_b <- typeIR_field_b*}|)
    -- if ((typeIR_field_b_non_default*{typeIR_field_b_non_default <- typeIR_field_b_non_default*}, typeIR_field_b_default*{typeIR_field_b_default <- typeIR_field_b_default*}) = $partition_<typeIR>(typeIR_field_b*{typeIR_field_b <- typeIR_field_b*}, |typeIR_a*{typeIR_a <- typeIR_a*}|))
    -- (if Cast_impl: typeIR_a -> typeIR_field_b_non_default holds)*{typeIR_a <- typeIR_a*, typeIR_field_b_non_default <- typeIR_field_b_non_default*}
    -- (if $is_defaultable_typeIR(typeIR_field_b_default))*{typeIR_field_b_default <- typeIR_field_b_default*}

  rulegroup recordTypeIR-non-default

    rule structTypeIR: RECORD { _annotationList typeIR_field_a id_field_a ;*{_annotationList <- _annotationList*, id_field_a <- id_field_a*, typeIR_field_a <- typeIR_field_a*} } as typeIR -> STRUCT _typeId < _typeArgumentIR*{_typeArgumentIR <- _typeArgumentIR*} > { _annotationList' typeIR_field_b id_field_b ;*{_annotationList' <- _annotationList'*, id_field_b <- id_field_b*, typeIR_field_b <- typeIR_field_b*} } as typeIR
