syntax expressionListResult = 
   | ` value* (from continueResult<value*>) 
   | EXIT (from exitResult) 
   | REJECT errorValue (from rejectTransitionResult) 

relation Exprs_eval: cursor evalContext arch |- typedExpressionIR* : evalContext arch expressionListResult

  rulegroup 

    rule nil: p EC ARCH |- [] : EC ARCH ` [] as expressionListResult

    rule cons-head-abort: p EC_0 ARCH_0 |- typedExpressionIR_h :: typedExpressionIR_t*{typedExpressionIR_t <- typedExpressionIR_t*} : EC_1 ARCH_1 abortResult as expressionListResult
