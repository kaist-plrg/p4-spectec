   | annotationList TYPEDEF typedefIR nameIR ; (from typedefDeclarationIR) 
   | annotationList TYPE typeIR nameIR ; (from typedefDeclarationIR) 
   | annotationList PARSER nameIR < typeParameterListIR , typeParameterListIR > ( parameterListIR ) ; (from parserTypeDeclarationIR) 
   | annotationList CONTROL nameIR < typeParameterListIR , typeParameterListIR > ( parameterListIR ) ; (from controlTypeDeclarationIR) 
   | annotationList PACKAGE nameIR < typeParameterListIR , typeParameterListIR > ( parameterListIR ) ; (from packageTypeDeclarationIR) 

syntax declarationIR = 
   | annotationList CONST typeIR nameIR constantInitializerIR ; (from constantDeclarationIR) 
   | annotationList typeIR constructorTargetIR ( argumentListIR ) nameIR objectInitializerOptIR ; (from instantiationIR)  hint(prose_fields "annotations" "type" "constructor target" "arguments" "name" "object initializer")
   | annotationList functionPrototypeIR blockStatementIR (from functionDeclarationIR) 
   | annotationList ACTION nameIR ( parameterListIR ) blockStatementIR (from actionDeclarationIR) 
   | ERROR { nameListIR } (from errorDeclarationIR) 
   | MATCH_KIND { nameListIR } (from matchKindDeclarationIR) 
   | annotationList EXTERN functionPrototypeIR ; (from externFunctionDeclarationIR) 
   | annotationList EXTERN nameIR < typeParameterListIR , > { externConstructorPrototypeListIR externMethodPrototypeListIR } (from externObjectDeclarationIR) 
   | annotationList PARSER nameIR < typeParameterListIR , typeParameterListIR > ( parameterListIR ) ( constructorParameterListIR ) { parserLocalDeclarationListIR parserStateListIR } (from parserDeclarationIR) 
   | annotationList CONTROL nameIR < typeParameterListIR , typeParameterListIR > ( parameterListIR ) ( constructorParameterListIR ) { controlLocalDeclarationListIR APPLY controlBodyIR } (from controlDeclarationIR) 
   | annotationList ENUM nameIR { nameListIR } (from enumTypeDeclarationIR) 
   | annotationList ENUM typeIR nameIR { namedValueListIR } (from enumTypeDeclarationIR) 
   | annotationList STRUCT nameIR < typeParameterListIR > { typeFieldListIR } (from structTypeDeclarationIR) 
   | annotationList HEADER nameIR < typeParameterListIR > { typeFieldListIR } (from headerTypeDeclarationIR) 
   | annotationList HEADER_UNION nameIR < typeParameterListIR > { typeFieldListIR } (from headerUnionTypeDeclarationIR) 
   | annotationList TYPEDEF typedefIR nameIR ; (from typedefDeclarationIR) 
   | annotationList TYPE typeIR nameIR ; (from typedefDeclarationIR) 
   | annotationList PARSER nameIR < typeParameterListIR , typeParameterListIR > ( parameterListIR ) ; (from parserTypeDeclarationIR) 
   | annotationList CONTROL nameIR < typeParameterListIR , typeParameterListIR > ( parameterListIR ) ; (from controlTypeDeclarationIR) 
   | annotationList PACKAGE nameIR < typeParameterListIR , typeParameterListIR > ( parameterListIR ) ; (from packageTypeDeclarationIR) 

syntax p4programIR = 
   | declarationIR* ; (from p4programIR) 

def $partition_parameterListIR(parameterIR*, nameIR*, nameIR*) : (parameterIR*, parameterIR*, parameterIR*) =

  clause 0 : (parameterIR*{parameterIR <- parameterIR*}, _nameIR*{_nameIR <- _nameIR*}, _nameIR'*{_nameIR' <- _nameIR'*}) = ([], [], [])
  -- if parameterIR*{parameterIR <- parameterIR*} matches []

  clause 1 : (parameterIR*{parameterIR <- parameterIR*}, nameIR_default*{nameIR_default <- nameIR_default*}, nameIR_optional*{nameIR_optional <- nameIR_optional*}) = (parameterIR_given*{parameterIR_given <- parameterIR_given*}, parameterIR_h :: parameterIR_default*{parameterIR_default <- parameterIR_default*}, parameterIR_optional*{parameterIR_optional <- parameterIR_optional*})
  -- if parameterIR*{parameterIR <- parameterIR*} matches _ :: _
  -- let parameterIR_h :: parameterIR_t*{parameterIR_t <- parameterIR_t*} = parameterIR*{parameterIR <- parameterIR*}
  -- let (parameterIR_given*{parameterIR_given <- parameterIR_given*}, parameterIR_default*{parameterIR_default <- parameterIR_default*}, parameterIR_optional*{parameterIR_optional <- parameterIR_optional*}) = $partition_parameterListIR(parameterIR_t*{parameterIR_t <- parameterIR_t*}, nameIR_default*{nameIR_default <- nameIR_default*}, nameIR_optional*{nameIR_optional <- nameIR_optional*})
  -- let _annotationList _direction _typeIR nameIR_h _parameterInitializerOptIR = parameterIR_h
  -- if nameIR_h <- nameIR_default*{nameIR_default <- nameIR_default*}

  clause 2 : (parameterIR*{parameterIR <- parameterIR*}, nameIR_default*{nameIR_default <- nameIR_default*}, nameIR_optional*{nameIR_optional <- nameIR_optional*}) = (parameterIR_given*{parameterIR_given <- parameterIR_given*}, parameterIR_default*{parameterIR_default <- parameterIR_default*}, parameterIR_h :: parameterIR_optional*{parameterIR_optional <- parameterIR_optional*})
  -- if parameterIR*{parameterIR <- parameterIR*} matches _ :: _
  -- let parameterIR_h :: parameterIR_t*{parameterIR_t <- parameterIR_t*} = parameterIR*{parameterIR <- parameterIR*}
  -- let (parameterIR_given*{parameterIR_given <- parameterIR_given*}, parameterIR_default*{parameterIR_default <- parameterIR_default*}, parameterIR_optional*{parameterIR_optional <- parameterIR_optional*}) = $partition_parameterListIR(parameterIR_t*{parameterIR_t <- parameterIR_t*}, nameIR_default*{nameIR_default <- nameIR_default*}, nameIR_optional*{nameIR_optional <- nameIR_optional*})
  -- let _annotationList _direction _typeIR nameIR_h _parameterInitializerOptIR = parameterIR_h
  -- if nameIR_h <- nameIR_optional*{nameIR_optional <- nameIR_optional*}

  clause 3 : (parameterIR*{parameterIR <- parameterIR*}, nameIR_default*{nameIR_default <- nameIR_default*}, nameIR_optional*{nameIR_optional <- nameIR_optional*}) = (parameterIR_h :: parameterIR_given*{parameterIR_given <- parameterIR_given*}, parameterIR_default*{parameterIR_default <- parameterIR_default*}, parameterIR_optional*{parameterIR_optional <- parameterIR_optional*})
  -- if parameterIR*{parameterIR <- parameterIR*} matches _ :: _
  -- let parameterIR_h :: parameterIR_t*{parameterIR_t <- parameterIR_t*} = parameterIR*{parameterIR <- parameterIR*}
  -- let (parameterIR_given*{parameterIR_given <- parameterIR_given*}, parameterIR_default*{parameterIR_default <- parameterIR_default*}, parameterIR_optional*{parameterIR_optional <- parameterIR_optional*}) = $partition_parameterListIR(parameterIR_t*{parameterIR_t <- parameterIR_t*}, nameIR_default*{nameIR_default <- nameIR_default*}, nameIR_optional*{nameIR_optional <- nameIR_optional*})
  -- let _annotationList _direction _typeIR nameIR_h _parameterInitializerOptIR = parameterIR_h
  -- if ~nameIR_h <- nameIR_default*{nameIR_default <- nameIR_default*}
  -- if ~nameIR_h <- nameIR_optional*{nameIR_optional <- nameIR_optional*}

syntax callAlign = 
   | GIVEN parameterIR* DEFAULT parameterIR* (from callAlign) 

def $align_parameterListIR(parameterIR*, argumentIR*, nameIR*, nameIR*) : callAlign =

  clause 0 : (parameterIR*{parameterIR <- parameterIR*}, argumentIR*{argumentIR <- argumentIR*}, nameIR_default*{nameIR_default <- nameIR_default*}, nameIR_optional*{nameIR_optional <- nameIR_optional*}) = GIVEN parameterIR_given_aligned*{parameterIR_given_aligned <- parameterIR_given_aligned*} DEFAULT parameterIR_default*{parameterIR_default <- parameterIR_default*}
  -- let (parameterIR_given*{parameterIR_given <- parameterIR_given*}, parameterIR_default*{parameterIR_default <- parameterIR_default*}, parameterIR_optional*{parameterIR_optional <- parameterIR_optional*}) = $partition_parameterListIR(parameterIR*{parameterIR <- parameterIR*}, nameIR_default*{nameIR_default <- nameIR_default*}, nameIR_optional*{nameIR_optional <- nameIR_optional*})
  -- (let _annotationList _direction _typeIR nameIR_given _parameterInitializerOptIR = parameterIR_given)*{parameterIR_given <- parameterIR_given*, _annotationList -> _annotationList*, _direction -> _direction*, _parameterInitializerOptIR -> _parameterInitializerOptIR*, _typeIR -> _typeIR*, nameIR_given -> nameIR_given*}
  -- let parameterIR_given_aligned*{parameterIR_given_aligned <- parameterIR_given_aligned*} = $align_parameterListIR_given({ nameIR_given : parameterIR_given*{nameIR_given <- nameIR_given*, parameterIR_given <- parameterIR_given*} }, parameterIR_given*{parameterIR_given <- parameterIR_given*}, argumentIR*{argumentIR <- argumentIR*})

def $align_parameterListIR_given(map<id, parameterIR>, parameterIR*, argumentIR*) : parameterIR* =

  clause 0 : ({ id : parameterIR*{id <- id*, parameterIR <- parameterIR*} }, parameterIR'*{parameterIR' <- parameterIR'*}, argumentIR*{argumentIR <- argumentIR*}) = []
  -- if parameterIR'*{parameterIR' <- parameterIR'*} matches []
  -- if argumentIR*{argumentIR <- argumentIR*} matches []

  clause 1 : ({ id : parameterIR*{id <- id*, parameterIR <- parameterIR*} }, parameterIR'*{parameterIR' <- parameterIR'*}, argumentIR*{argumentIR <- argumentIR*}) = parameterIR_h :: parameterIR_aligned*{parameterIR_aligned <- parameterIR_aligned*}
