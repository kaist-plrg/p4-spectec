    -- Expr_eval: p EC_1 ARCH_1 |- typedExpressionIR : EC_2 ARCH_2 ` value as expressionResult
    -- Lvalue_write: p EC_2 ARCH_2 |- storageReference := value : EC_3

    rule typedLvalueIR-cont-compound-typedExpressionIR-cont: p EC_0 ARCH_0 |- typedLvalueIR assignop typedExpressionIR ; as statementIR : EC_3 ARCH_2 `EMPTY as statementResult
    -- Lvalue_eval: p EC_0 ARCH_0 |- typedLvalueIR : EC_1 ARCH_1 ` ?(storageReference) as storageReferenceResult
