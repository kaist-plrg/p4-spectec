  -- let sequenceExpressionIR = dataExpressionIR as sequenceExpressionIR
  -- if sequenceExpressionIR matches `SEQ {%}`
  -- let SEQ { typedExpressionIR*{typedExpressionIR <- typedExpressionIR*} } = sequenceExpressionIR
  -- let expressionList = $lift_typedExpressionListIR(typedExpressionIR*{typedExpressionIR <- typedExpressionIR*})

  clause 2 : (dataExpressionIR) = { expressionList as sequenceOrRecordElementExpression `EMPTY } as dataExpression
  -- if dataExpressionIR <: sequenceExpressionIR
  -- let sequenceExpressionIR = dataExpressionIR as sequenceExpressionIR
  -- if sequenceExpressionIR matches `SEQ {% , ...}`
  -- let SEQ { typedExpressionIR*{typedExpressionIR <- typedExpressionIR*} , ... } = sequenceExpressionIR
