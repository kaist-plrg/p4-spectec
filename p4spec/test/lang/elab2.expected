    -- if (EC_4 = $exit_e(EC_3))

  rulegroup forStatementIR-in

    rule no-annotations-collection-abort: LOCAL EC_0 ARCH_0 |- annotationList FOR ( typeIR nameIR IN forCollectionExpressionIR ) statementIR as statementIR : EC_3 ARCH_1 abortResult as statementResult
    -- if (EC_1 = $enter_e(EC_0))
    -- ForCollectionExpr_eval: EC_1 ARCH_0 |- forCollectionExpressionIR : EC_2 ARCH_1 abortResult as expressionListResult
    -- if (EC_3 = $exit_e(EC_2))

    rule no-annotations-collection-loop: LOCAL EC_0 ARCH_0 |- annotationList FOR ( typeIR nameIR IN forCollectionExpressionIR ) statementIR as statementIR : EC_5 ARCH_2 statementResult
    -- if (EC_1 = $enter_e(EC_0))
    -- ForCollectionExpr_eval: EC_1 ARCH_0 |- forCollectionExpressionIR : EC_2 ARCH_1 ` value*{value <- value*} as expressionListResult
    -- if (typeIR_subst = $subst_type_e(LOCAL, EC_0, typeIR))
    -- if (value_init = $default(typeIR_subst))
    -- if (EC_3 = $add_var_e(LOCAL, EC_2, ` nameIR, value_init))
    -- ForInStmt_eval: EC_3 ARCH_1 |- nameIR value*{value <- value*} statementIR : EC_4 ARCH_2 statementResult
    -- if (EC_5 = $exit_e(EC_4))

    rule annotations: LOCAL EC_0 ARCH_0 |- annotationList FOR ( annotationList_in typeIR nameIR IN forCollectionExpressionIR ) statementIR as statementIR : EC_1 ARCH_1 statementResult
    -- Stmt_eval: LOCAL EC_0 ARCH_0 |- annotationList FOR ( typeIR nameIR IN forCollectionExpressionIR ) statementIR as statementIR : EC_1 ARCH_1 statementResult

  rulegroup breakStatementIR

    rule breakStatementIR: LOCAL EC ARCH |- BREAK ; as statementIR : EC ARCH BREAK as statementResult

  rulegroup continueStatementIR

    rule continueStatementIR: LOCAL EC ARCH |- CONTINUE ; as statementIR : EC ARCH CONTINUE as statementResult

  rulegroup switchStatementIR

    rule target-abort: LOCAL EC_0 ARCH_0 |- SWITCH ( typedExpressionIR ) { switchCaseIR*{switchCaseIR <- switchCaseIR*} } as statementIR : EC_1 ARCH_1 abortResult as statementResult
    -- Expr_eval: LOCAL EC_0 ARCH_0 |- typedExpressionIR : EC_1 ARCH_1 abortResult as expressionResult

    rule target-cont-table: LOCAL EC_0 ARCH_0 |- SWITCH ( typedExpressionIR ) { switchCaseIR*{switchCaseIR <- switchCaseIR*} } as statementIR : EC_2 ARCH_2 statementResult
