def $reverse_bytes_of_hex(text) : text =

  clause 0 : (t) = "0x" ++ $reverse_bytes_of_hex'(t[2 : n_len_bytes])
  -- if (t[0 : 2] = "0x")
  -- let n_len = |t|
  -- let i = (n_len - 2)
  -- if i <: nat
  -- let n_len_bytes = i as nat

def $reverse_bytes_of_hex'(text) : text =

  clause 0 : (t) = t
  -- if (|t| <= 2)

  clause 1 : (t) = t_bytes_rev ++ t_byte
  -- let n_len = |t|
  -- if (n_len > 2)
  -- let t_byte = t[0 : 2]
  -- let i = (n_len - 2)
  -- if i <: nat
  -- let n_len_bytes = i as nat
  -- let t_bytes = t[2 : n_len_bytes]
  -- let t_bytes_rev = $reverse_bytes_of_hex'(t_bytes)

