tbl def $compat_switch(typeIR) : bool =
  row 0 :
    (ERROR as typeIR) -> true
  row 1 :
    (INT < _nat > as typeIR) -> true
  row 2 :
    (BIT < _nat > as typeIR) -> true
  row 3 :
    (TYPEDEF _typeId typeIR as typeIR) -> $compat_switch(typeIR)
  row 4 :
    (enumTypeIR as typeIR) -> true
  row 5 :
    (_typeIR) -> false

