  -- if typeParameter'*{typeParameter' <- typeParameter'*} matches _ :: _
  -- let typeParameter_h :: typeParameter_t*{typeParameter_t <- typeParameter_t*} = typeParameter'*{typeParameter' <- typeParameter'*}

def $unflatten_typeParameterList'(typeParameterList, typeParameter*) : typeParameterList =

  clause 0 : (typeParameterList, typeParameter*{typeParameter <- typeParameter*}) = typeParameterList
  -- if typeParameter*{typeParameter <- typeParameter*} matches []

  clause 1 : (typeParameterList, typeParameter*{typeParameter <- typeParameter*}) = $unflatten_typeParameterList'(typeParameterList , typeParameter_h, typeParameter_t*{typeParameter_t <- typeParameter_t*})
