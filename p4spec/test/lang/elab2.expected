  rulegroup exitStatementIR

    rule exitStatementIR: p EC ARCH |- EXIT ; as statementIR : EC ARCH EXIT as statementResult

  rulegroup blockStatementIR

    rule blockStatementIR: p EC_0 ARCH_0 |- blockStatementIR as statementIR : EC_3 ARCH_1 statementResult
    -- if (EC_1 = $enter_e(EC_0))
