relation SelectCase_keyset_simple_ok: typingContext typeIR |- simpleKeysetExpression : simpleKeysetExpressionIR

  rulegroup expression

    rule set-alpha: TC typeIR_key |- expression as simpleKeysetExpression : typedExpressionIR as simpleKeysetExpressionIR
    -- Expr_ok: LOCAL TC |- expression : typedExpressionIR
    -- if (typeIR = $type_of_typedExpressionIR(typedExpressionIR))
    -- if (SET < typeIR_base > as typeIR = $unroll_typeIR(typeIR))
    -- if Type_alpha: typeIR_base ~~ typeIR_key holds

    rule set-subtype: TC typeIR_key |- expression as simpleKeysetExpression : typedExpressionIR_cast as simpleKeysetExpressionIR
    -- Expr_ok: LOCAL TC |- expression : typedExpressionIR
    -- if (typeIR = $type_of_typedExpressionIR(typedExpressionIR))
    -- if (SET < typeIR_base > as typeIR = $unroll_typeIR(typeIR))
    -- if Type_alpha: typeIR_base ~~ typeIR_key does not hold
    -- if Cast_impl: typeIR_base -> typeIR_key holds
    -- if (typeIR_cast = SET < typeIR_key > as typeIR)
    -- if (typedExpressionIR_cast = ( typeIR_cast ) typedExpressionIR as expressionIR # ( typeIR_cast DYN ))

    rule non-set: TC typeIR_key |- expression as simpleKeysetExpression : typedExpressionIR_cast as simpleKeysetExpressionIR
    -- Expr_ok: LOCAL TC |- expression : typedExpressionIR
    -- if (typeIR = $type_of_typedExpressionIR(typedExpressionIR))
    -- if (typeIR_unroll = $unroll_typeIR(typeIR))
    -- if ~typeIR_unroll <: setTypeIR
    -- if Cast_impl: typeIR -> typeIR_key holds
    -- if (typeIR_cast = SET < typeIR_key > as typeIR)
    -- if (typedExpressionIR_cast = ( typeIR_cast ) typedExpressionIR as expressionIR # ( typeIR_cast DYN ))

  rulegroup mask

    rule mask: TC typeIR_key |- expression_l &&& expression_r : typedExpressionIR_l_casted &&& typedExpressionIR_r_casted
    -- Expr_ok: LOCAL TC |- expression_l : typedExpressionIR_l
    -- Expr_ok: LOCAL TC |- expression_r : typedExpressionIR_r
    -- if (?((typedExpressionIR_l_cast, typedExpressionIR_r_cast)) = $cast_binary(typedExpressionIR_l, typedExpressionIR_r))
    -- if (?((typedExpressionIR_l_reduced, typedExpressionIR_r_reduced)) = $reduce_serenum_binary(typedExpressionIR_l_cast, typedExpressionIR_r_cast, $compat_mask))
    -- if (typeIR_reduced = $type_of_typedExpressionIR(typedExpressionIR_l_reduced))
    -- if (?(typedExpressionIR_l_casted) = $cast_unary(typedExpressionIR_l_reduced, typeIR_key))
    -- if (?(typedExpressionIR_r_casted) = $cast_unary(typedExpressionIR_r_reduced, typeIR_key))

  rulegroup range

    rule range: TC typeIR_key |- expression_l .. expression_r : typedExpressionIR_l_casted .. typedExpressionIR_r_casted
    -- Expr_ok: LOCAL TC |- expression_l : typedExpressionIR_l
    -- Expr_ok: LOCAL TC |- expression_r : typedExpressionIR_r
    -- if (?((typedExpressionIR_l_cast, typedExpressionIR_r_cast)) = $cast_binary(typedExpressionIR_l, typedExpressionIR_r))
    -- if (?((typedExpressionIR_l_reduced, typedExpressionIR_r_reduced)) = $reduce_serenum_binary(typedExpressionIR_l_cast, typedExpressionIR_r_cast, $compat_range))
    -- if (typeIR_reduced = $type_of_typedExpressionIR(typedExpressionIR_l_reduced))
    -- if (typeIR_reduced = $type_of_typedExpressionIR(typedExpressionIR_r_reduced))
    -- if (?(typedExpressionIR_l_casted) = $cast_unary(typedExpressionIR_l_reduced, typeIR_key))
    -- if (?(typedExpressionIR_r_casted) = $cast_unary(typedExpressionIR_r_reduced, typeIR_key))

  rulegroup default

    rule default: TC typeIR_key |- DEFAULT : DEFAULT

  rulegroup dontcare

    rule dontcare: TC typeIR_key |- _ : _

tbl def $compat_mask(typeIR, typeIR) : bool =
  row 0 :
    (INT as typeIR, INT as typeIR) -> true
  row 1 :
    (INT < w_l > as typeIR, INT < w_r > as typeIR) -> (w_l = w_r)
  row 2 :
    (BIT < w_l > as typeIR, BIT < w_r > as typeIR) -> (w_l = w_r)
  row 3 :
    (TYPEDEF _typeId typeIR_l as typeIR, typeIR_r) -> $compat_mask(typeIR_l, typeIR_r)
  row 4 :
    (typeIR_l, TYPEDEF _typeId typeIR_r as typeIR) -> $compat_mask(typeIR_l, typeIR_r)
  row 5 :
    (_typeIR, _typeIR') -> false

relation SelectCase_keyset_ok: typingContext typeIR* |- keysetExpression : keysetExpressionIR

