  -- let externConstructorPrototype*{externConstructorPrototype <- externConstructorPrototype*} = externConstructorOrMethodPrototype'*{externConstructorOrMethodPrototype' <- externConstructorOrMethodPrototype'*} as externConstructorPrototype*
