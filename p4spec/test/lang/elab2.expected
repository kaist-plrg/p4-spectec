def $find_var_t(prefixedNameIR, cursor, typingContext) : varTypeIR? =

  clause 0 : (prefixedNameIR, p, TC) = $find_map<id, varTypeIR>(typeFrame, id)
  -- if prefixedNameIR matches `. %`
  -- let . id = prefixedNameIR
  -- let typeFrame = TC.GLOBAL.FRAME

  clause 1 : (prefixedNameIR, p, TC) = $find_map<id, varTypeIR>(typeFrame, id)
  -- if prefixedNameIR matches `` %`
  -- let ` id = prefixedNameIR
  -- if p matches `GLOBAL`
  -- let typeFrame = TC.GLOBAL.FRAME

  clause 2 : (prefixedNameIR, p, TC) = ?(varTypeIR)
  -- if prefixedNameIR matches `` %`
  -- let ` id = prefixedNameIR
  -- if p matches `BLOCK`
  -- let typeFrame = TC.BLOCK.FRAME
  -- let varTypeIR'?{varTypeIR' <- varTypeIR'?} = $find_map<id, varTypeIR>(typeFrame, id)
  -- if varTypeIR'?{varTypeIR' <- varTypeIR'?} matches (_)
  -- let ?(varTypeIR) = varTypeIR'?{varTypeIR' <- varTypeIR'?}

  clause 3 : (prefixedNameIR, p, TC) = $find_var_t(` id, GLOBAL, TC)
  -- if prefixedNameIR matches `` %`
  -- let ` id = prefixedNameIR
  -- if p matches `BLOCK`
  -- let typeFrame = TC.BLOCK.FRAME
  -- if (?() = $find_map<id, varTypeIR>(typeFrame, id))

  clause 4 : (prefixedNameIR, p, TC) = ?(varTypeIR)
  -- if prefixedNameIR matches `` %`
  -- let ` id = prefixedNameIR
  -- if p matches `LOCAL`
  -- let typeFrame*{typeFrame <- typeFrame*} = TC.LOCAL.FRAMES
  -- let varTypeIR'?{varTypeIR' <- varTypeIR'?} = $find_maps<id, varTypeIR>(typeFrame*{typeFrame <- typeFrame*}, id)
  -- if varTypeIR'?{varTypeIR' <- varTypeIR'?} matches (_)
  -- let ?(varTypeIR) = varTypeIR'?{varTypeIR' <- varTypeIR'?}

  clause 5 : (prefixedNameIR, p, TC) = $find_var_t(` id, BLOCK, TC)
  -- if prefixedNameIR matches `` %`
  -- let ` id = prefixedNameIR
  -- if p matches `LOCAL`
  -- let typeFrame*{typeFrame <- typeFrame*} = TC.LOCAL.FRAMES
  -- if (?() = $find_maps<id, varTypeIR>(typeFrame*{typeFrame <- typeFrame*}, id))

def $find_var_value_t(prefixedNameIR, cursor, typingContext) : value =

  clause 0 : (prefixedNameIR, p, TC) = value
