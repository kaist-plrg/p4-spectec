def $find_var_e(prefixedNameIR, cursor, evalContext) : value =

  clause 0 : (prefixedNameIR, p, EC) = value
  -- if prefixedNameIR matches `. %`
  -- let . id = prefixedNameIR
  -- let value'?{value' <- value'?} = $find_map<id, value>(EC.GLOBAL.FRAME, id)
  -- if value'?{value' <- value'?} matches (_)
  -- let ?(value) = value'?{value' <- value'?}

  clause 1 : (prefixedNameIR, p, EC) = value
  -- if prefixedNameIR matches `` %`
  -- let ` id = prefixedNameIR
  -- if p matches `GLOBAL`
  -- let value'?{value' <- value'?} = $find_map<id, value>(EC.GLOBAL.FRAME, id)
  -- if value'?{value' <- value'?} matches (_)
  -- let ?(value) = value'?{value' <- value'?}

  clause 2 : (prefixedNameIR, p, EC) = value
  -- if prefixedNameIR matches `` %`
  -- let ` id = prefixedNameIR
  -- if p matches `BLOCK`
  -- let value'?{value' <- value'?} = $find_map<id, value>(EC.BLOCK.FRAME, id)
  -- if value'?{value' <- value'?} matches (_)
  -- let ?(value) = value'?{value' <- value'?}

  clause 3 : (prefixedNameIR, p, EC) = $find_var_e(` id, GLOBAL, EC)
  -- if prefixedNameIR matches `` %`
  -- let ` id = prefixedNameIR
  -- if p matches `BLOCK`
  -- if (?() = $find_map<id, value>(EC.BLOCK.FRAME, id))

  clause 4 : (prefixedNameIR, p, EC) = value
  -- if prefixedNameIR matches `` %`
  -- let ` id = prefixedNameIR
  -- if p matches `LOCAL`
  -- let value'?{value' <- value'?} = $find_maps<id, value>(EC.LOCAL.FRAMES, id)
  -- if value'?{value' <- value'?} matches (_)
  -- let ?(value) = value'?{value' <- value'?}

  clause 5 : (prefixedNameIR, p, EC) = $find_var_e(` id, BLOCK, EC)
  -- if prefixedNameIR matches `` %`
  -- let ` id = prefixedNameIR
  -- if p matches `LOCAL`
  -- if (?() = $find_maps<id, value>(EC.LOCAL.FRAMES, id))

def $find_typeDef_e(cursor, evalContext, prefixedNameIR) : typeDefIR? =

  clause 0 : (_p, EC, prefixedNameIR) = $find_map<typeId, typeDefIR>(EC.GLOBAL.TYPE, nameIR)
