syntax boolValue = 
   | `B bool (from boolValue) 

syntax errorValue = 
   | ERROR . nameIR (from errorValue) 

syntax matchKindValue = 
   | MATCH_KIND . nameIR (from matchKindValue) 

syntax stringValue = stringLiteral

syntax integerValue = 
   | D int (from integerLiteral)  hint(print %)
   | nat W int (from integerLiteral)  hint(print %#W#%)
   | nat S int (from integerLiteral)  hint(print %#S#%)
   | nat . nat V int (from integerValue) 

syntax baseValue = 
   | `B bool (from boolValue) 
   | ERROR . nameIR (from errorValue) 
   | MATCH_KIND . nameIR (from matchKindValue) 
   | " text " (from stringLiteral)  hint(print "#%#")
   | D int (from integerLiteral)  hint(print %)
   | nat W int (from integerLiteral)  hint(print %#W#%)
   | nat S int (from integerLiteral)  hint(print %#S#%)
   | nat . nat V int (from integerValue) 

syntax listValue = 
   | LIST [ value* ] (from listValue) 

syntax tupleValue = 
   | TUPLE ( value* ) (from tupleValue) 

syntax headerStackValue = 
   | HEADER_STACK [ value* ( nat ; nat ) ] (from headerStackValue) 

syntax fieldValue = 
   | value nameIR ; (from fieldValue) 

syntax structValue = 
   | STRUCT typeId { fieldValue* } (from structValue) 

syntax headerValue = 
   | HEADER typeId { bool ; fieldValue* } (from headerValue) 

syntax headerUnionValue = 
   | HEADER_UNION typeId { fieldValue* } (from headerUnionValue) 

syntax enumValue = 
   | typeId . nameIR (from enumValue) 
   | typeId . nameIR . value (from enumValue) 

syntax dataValue = 
   | LIST [ value* ] (from listValue) 
   | TUPLE ( value* ) (from tupleValue) 
   | HEADER_STACK [ value* ( nat ; nat ) ] (from headerStackValue) 
   | STRUCT typeId { fieldValue* } (from structValue) 
   | HEADER typeId { bool ; fieldValue* } (from headerValue) 
   | HEADER_UNION typeId { fieldValue* } (from headerUnionValue) 
   | typeId . nameIR (from enumValue) 
   | typeId . nameIR . value (from enumValue) 

syntax objectReferenceValue = 
   | REF objectId (from objectReferenceValue) 

syntax defaultValue = 
   | DEFAULT (from defaultValue) 

syntax invalidHeaderValue = 
   | {#} (from invalidHeaderValue) 

syntax sequenceValue = 
   | SEQ ( value* ) (from sequenceValue) 
   | SEQ ( value* , ... ) (from sequenceValue) 

syntax recordValue = 
   | RECORD { fieldValue* } (from recordValue) 
   | RECORD { fieldValue* , ... } (from recordValue) 

syntax setValue = 
   | SET { value } (from setValue) 
   | SET { value* ( nat ) } (from setValue) 
   | SET { value &&& value } (from setValue) 
   | SET { value .. value } (from setValue) 
   | SET { ... } (from setValue) 

syntax tableMetadataEnumValue = 
   | TABLE_ENUM typeId . nameIR (from tableMetadataEnumValue) 

syntax tableMetadataStructValue = 
   | TABLE_STRUCT typeId { HIT boolValue ; MISS boolValue ; ACTION_RUN tableMetadataEnumValue ; } (from tableMetadataStructValue) 

syntax tableMetadataValue = 
   | TABLE_ENUM typeId . nameIR (from tableMetadataEnumValue) 
   | TABLE_STRUCT typeId { HIT boolValue ; MISS boolValue ; ACTION_RUN tableMetadataEnumValue ; } (from tableMetadataStructValue) 

syntax synthesizedValue = 
   | DEFAULT (from defaultValue) 
   | {#} (from invalidHeaderValue) 
   | SEQ ( value* ) (from sequenceValue) 
   | SEQ ( value* , ... ) (from sequenceValue) 
   | RECORD { fieldValue* } (from recordValue) 
   | RECORD { fieldValue* , ... } (from recordValue) 
   | SET { value } (from setValue) 
   | SET { value* ( nat ) } (from setValue) 
   | SET { value &&& value } (from setValue) 
   | SET { value .. value } (from setValue) 
   | SET { ... } (from setValue) 
   | TABLE_ENUM typeId . nameIR (from tableMetadataEnumValue) 
   | TABLE_STRUCT typeId { HIT boolValue ; MISS boolValue ; ACTION_RUN tableMetadataEnumValue ; } (from tableMetadataStructValue) 

syntax value = 
   | `B bool (from boolValue) 
   | ERROR . nameIR (from errorValue) 
   | MATCH_KIND . nameIR (from matchKindValue) 
   | " text " (from stringLiteral)  hint(print "#%#")
   | D int (from integerLiteral)  hint(print %)
   | nat W int (from integerLiteral)  hint(print %#W#%)
   | nat S int (from integerLiteral)  hint(print %#S#%)
   | nat . nat V int (from integerValue) 
   | LIST [ value* ] (from listValue) 
   | TUPLE ( value* ) (from tupleValue) 
   | HEADER_STACK [ value* ( nat ; nat ) ] (from headerStackValue) 
   | STRUCT typeId { fieldValue* } (from structValue) 
   | HEADER typeId { bool ; fieldValue* } (from headerValue) 
   | HEADER_UNION typeId { fieldValue* } (from headerUnionValue) 
   | typeId . nameIR (from enumValue) 
   | typeId . nameIR . value (from enumValue) 
   | REF objectId (from objectReferenceValue) 
   | DEFAULT (from defaultValue) 
   | {#} (from invalidHeaderValue) 
   | SEQ ( value* ) (from sequenceValue) 
   | SEQ ( value* , ... ) (from sequenceValue) 
   | RECORD { fieldValue* } (from recordValue) 
   | RECORD { fieldValue* , ... } (from recordValue) 
   | SET { value } (from setValue) 
   | SET { value* ( nat ) } (from setValue) 
   | SET { value &&& value } (from setValue) 
   | SET { value .. value } (from setValue) 
   | SET { ... } (from setValue) 
   | TABLE_ENUM typeId . nameIR (from tableMetadataEnumValue) 
   | TABLE_STRUCT typeId { HIT boolValue ; MISS boolValue ; ACTION_RUN tableMetadataEnumValue ; } (from tableMetadataStructValue) 

