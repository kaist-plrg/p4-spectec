    -- if (?(_callableId : (_p, externFunctionDef as callableDef) # id_default*{id_default <- id_default*} # id_optional*{id_optional <- id_optional*}) = $find_callableDef_overloaded_e(p, EC, referenceExpressionIR, argumentListIR))
