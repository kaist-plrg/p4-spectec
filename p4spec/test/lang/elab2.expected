  clause 0 : (expression) = true
  -- let expression' = expression
  -- if expression' <: sequenceOrRecordExpression
  -- let { sequenceOrRecordElementExpression trailingCommaOpt } = expression' as sequenceOrRecordExpression
  -- if sequenceOrRecordElementExpression <: expression
  -- let expression_elem = sequenceOrRecordElementExpression as expression
  -- if trailingCommaOpt matches `/* empty */`

  clause -1 : (expression) = false

