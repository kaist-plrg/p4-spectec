relation ForCollectionExpr_eval: evalContext arch |- forCollectionExpressionIR : evalContext arch expressionListResult

  rulegroup typedExpressionIR

    rule abort: EC_0 ARCH_0 |- typedExpressionIR as forCollectionExpressionIR : EC_1 ARCH_1 abortResult as expressionListResult
