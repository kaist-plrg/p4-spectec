    rule typedLvalueIR-cont-eq-typedExpressionIR-abort: p EC_0 ARCH_0 |- typedLvalueIR assignop typedExpressionIR ; as statementIR : EC_2 ARCH_2 abortResult as statementResult
    -- Lvalue_eval: p EC_0 ARCH_0 |- typedLvalueIR : EC_1 ARCH_1 ` ?(storageReference) as storageReferenceResult
    -- if (assignop = =)
    -- Expr_eval: p EC_1 ARCH_1 |- typedExpressionIR : EC_2 ARCH_2 abortResult as expressionResult

    rule typedLvalueIR-cont-compound-typedExpressionIR-exit: p EC_0 ARCH_0 |- typedLvalueIR assignop typedExpressionIR ; as statementIR : EC_2 ARCH_2 EXIT as statementResult
