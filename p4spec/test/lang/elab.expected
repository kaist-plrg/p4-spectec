  -- let ` nameIR = prefixedNameIR

def $find_constructorDef_e(evalContext, prefixedNameIR, argumentIR*) : callResolution<constructorDef>? =

  clause 0 : (EC, prefixedNameIR, argumentIR*{argumentIR <- argumentIR*}) = $find_overloaded<constructorDef>(EC.global.constructor, callTargetKey, $parameterListIR_of_constructorDef)
  -- if prefixedNameIR matches ``%`
  -- let ` nameIR = prefixedNameIR
  -- let callTargetKey = $callTargetKey(nameIR, argumentIR*{argumentIR <- argumentIR*})

  clause 1 : (EC, prefixedNameIR, argumentIR*{argumentIR <- argumentIR*}) = $find_overloaded<constructorDef>(EC.global.constructor, callTargetKey, $parameterListIR_of_constructorDef)
  -- if prefixedNameIR matches `.%`
  -- let . nameIR = prefixedNameIR
  -- let callTargetKey = $callTargetKey(nameIR, argumentIR*{argumentIR <- argumentIR*})

def $find_parserState_e(evalContext, nameIR) : parserStateIR? =

  clause 0 : (EC, nameIR) = $find_map<nameIR, parserStateIR>(EC.block.state, nameIR)

def $subst_type_e(cursor, evalContext, typeIR) : typeIR =

  clause 0 : (cursor, EC, typeIR) = typeIR
  -- if cursor matches `GLOBAL`

  clause 1 : (cursor, EC, typeIR) = typeIR_subst
  -- if cursor matches `BLOCK`
  -- let theta = EC.block.type
  -- let typeIR_subst = $subst_typeIR(theta, typeIR)

  clause 2 : (cursor, EC, typeIR) = typeIR_subst
  -- if cursor matches `LOCAL`
  -- let theta_block = EC.block.type
  -- let theta_local = EC.local.type
  -- let theta = $extend_map<typeId, typeIR>(theta_block, theta_local)
  -- let typeIR_subst = $subst_typeIR(theta, typeIR)

extern syntax archState

extern def $init_archState : archState

syntax arch = {state archState, store store}

def $add_object_e(arch, objectId, object) : arch =

