  clause 0 : ([], nameIR, value) = []

  clause 1 : (value_field_h nameIR_field_h ';' :: fieldValue_t*{fieldValue_t <- fieldValue_t*}, nameIR, value) = value nameIR ';' :: fieldValue_t*{fieldValue_t <- fieldValue_t*}
  -- if (nameIR_field_h = nameIR)

  clause 2 : (value_field_h nameIR_field_h ';' :: fieldValue_t*{fieldValue_t <- fieldValue_t*}, nameIR, value) = value_field_h nameIR_field_h ';' :: $update_fieldValue(fieldValue_t*{fieldValue_t <- fieldValue_t*}, nameIR, value)
  -- if (nameIR_field_h =/= nameIR)

def $update_headerUnion(fieldValue*, nameIR) : fieldValue* =

  clause 0 : ([], nameIR) = []

  clause 1 : (value_field_h nameIR_field_h ';' :: fieldValue_t*{fieldValue_t <- fieldValue_t*}, nameIR) = value_field_h nameIR_field_h ';' :: $update_headerUnion(fieldValue_t*{fieldValue_t <- fieldValue_t*}, nameIR)
  -- if (nameIR_field_h = nameIR)

  clause 2 : (value_field_h nameIR_field_h ';' :: fieldValue_t*{fieldValue_t <- fieldValue_t*}, nameIR) = value_field_h_update nameIR_field_h ';' :: $update_headerUnion(fieldValue_t*{fieldValue_t <- fieldValue_t*}, nameIR)
  -- if (nameIR_field_h =/= nameIR)
  -- if (HEADER typeId `{ _b ';' fieldValue*{fieldValue <- fieldValue*} `} as value = value_field_h)
  -- if (value_field_h_update = HEADER typeId `{ false ';' fieldValue*{fieldValue <- fieldValue*} `} as value)

def $isValid_header(value) : bool =

  clause 0 : (headerValue as value) = b_valid
  -- if (HEADER _typeId `{ b_valid ';' _fieldValue*{_fieldValue <- _fieldValue*} `} = headerValue)

def $invalidate_value(value) : value =

  clause 0 : (headerValue as value) = $invalidate_header(headerValue) as value

  clause 1 : (headerUnionValue as value) = $invalidate_headerUnion(headerUnionValue) as value

def $invalidate_header(headerValue) : headerValue =

  clause 0 : (HEADER typeId `{ _b ';' fieldValue*{fieldValue <- fieldValue*} `}) = HEADER typeId `{ false ';' fieldValue*{fieldValue <- fieldValue*} `}

def $invalidate_headerUnion(headerUnionValue) : headerUnionValue =

  clause 0 : (HEADER_UNION typeId `{ value_field nameIR_field ';'*{nameIR_field <- nameIR_field*, value_field <- value_field*} `}) = HEADER_UNION typeId `{ value_field_invalidated nameIR_field ';'*{nameIR_field <- nameIR_field*, value_field_invalidated <- value_field_invalidated*} `}
  -- (if (value_field_invalidated = $invalidate_value(value_field)))*{value_field <- value_field*, value_field_invalidated <- value_field_invalidated*}

def $write_value_from_bits(value, nat, bool*) : value =

  clause 0 : (value, n_var, b*{b <- b*}) = value_updated
  -- if ((value_updated, []) = $write_value_from_bits'(value, n_var, b*{b <- b*}))

def $write_value_from_bits'(value, nat, bool*) : (value, bool*) =

  clause 0 : (_B _b as value, n_var, b_h :: b_t*{b_t <- b_t*}) = (_B b_h as value, b_t*{b_t <- b_t*})

  clause 1 : (w W _i as value, n_var, b*{b <- b*}) = (w W i as value, b_t*{b_t <- b_t*})
  -- if (|b*{b <- b*}| >= w)
  -- if (b_h*{b_h <- b_h*} = b*{b <- b*}[0 : w])
  -- if (n_t as int = (|b*{b <- b*}| - w))
  -- if (b_t*{b_t <- b_t*} = b*{b <- b*}[w : n_t])
  -- if (i = $int_to_bitstr(w as int, $bits_to_int_unsigned(b_h*{b_h <- b_h*})))

  clause 2 : (w S _i as value, n_var, b*{b <- b*}) = (w S i as value, b_t*{b_t <- b_t*})
  -- if (|b*{b <- b*}| >= w)
  -- if (b_h*{b_h <- b_h*} = b*{b <- b*}[0 : w])
  -- if (n_t as int = (|b*{b <- b*}| - w))
  -- if (b_t*{b_t <- b_t*} = b*{b <- b*}[w : n_t])
  -- if (i = $int_to_bitstr(w as int, $bits_to_int_signed(b_h*{b_h <- b_h*})))

  clause 3 : (n_max '.' _nat V i as value, 0, b*{b <- b*}) = (n_max '.' 0 V i as value, b*{b <- b*})

  clause 4 : (n_max '.' _nat V _i as value, n_var, b*{b <- b*}) = (n_max '.' n_var V i as value, b_t*{b_t <- b_t*})
  -- if (n_var =/= 0)
  -- if (|b*{b <- b*}| >= n_var)
  -- if (b_h*{b_h <- b_h*} = b*{b <- b*}[0 : n_var])
  -- if (n_t as int = (|b*{b <- b*}| - n_var))
  -- if (b_t*{b_t <- b_t*} = b*{b <- b*}[n_var : n_t])
  -- if (i = $int_to_bitstr(n_var as int, $bits_to_int_signed(b_h*{b_h <- b_h*})))

  clause 5 : (STRUCT typeId `{ fieldValue*{fieldValue <- fieldValue*} `} as value, n_var, b*{b <- b*}) = (STRUCT typeId `{ fieldValue_updated*{fieldValue_updated <- fieldValue_updated*} `} as value, b_rest*{b_rest <- b_rest*})
  -- if ((fieldValue_updated*{fieldValue_updated <- fieldValue_updated*}, b_rest*{b_rest <- b_rest*}) = $write_value_fields_from_bits'(fieldValue*{fieldValue <- fieldValue*}, n_var, b*{b <- b*}))

  clause 6 : (HEADER typeId `{ _b ';' fieldValue*{fieldValue <- fieldValue*} `} as value, n_var, b*{b <- b*}) = (HEADER typeId `{ true ';' fieldValue_updated*{fieldValue_updated <- fieldValue_updated*} `} as value, b_rest*{b_rest <- b_rest*})
  -- if ((fieldValue_updated*{fieldValue_updated <- fieldValue_updated*}, b_rest*{b_rest <- b_rest*}) = $write_value_fields_from_bits'(fieldValue*{fieldValue <- fieldValue*}, n_var, b*{b <- b*}))

  clause 7 : (typeId '.' nameIR '.' value as value, n_var, b*{b <- b*}) = (typeId '.' "__UNSPECIFIED" '.' value_updated as value, b_rest*{b_rest <- b_rest*})
  -- if ((value_updated, b_rest*{b_rest <- b_rest*}) = $write_value_from_bits'(value, n_var, b*{b <- b*}))

  clause 8 : (ARRAY `[ value*{value <- value*} `] as value, n_var, b*{b <- b*}) = (ARRAY `[ value_updated*{value_updated <- value_updated*} `] as value, b_rest*{b_rest <- b_rest*})
  -- if ((value_updated*{value_updated <- value_updated*}, b_rest*{b_rest <- b_rest*}) = $write_values_from_bits'(value*{value <- value*}, n_var, b*{b <- b*}))

  clause 9 : (HEADER_STACK `[ value*{value <- value*} `( n_idx `) `] as value, n_var, b*{b <- b*}) = (HEADER_STACK `[ value_updated*{value_updated <- value_updated*} `( n_idx `) `] as value, b_rest*{b_rest <- b_rest*})
  -- if ((value_updated*{value_updated <- value_updated*}, b_rest*{b_rest <- b_rest*}) = $write_values_from_bits'(value*{value <- value*}, n_var, b*{b <- b*}))

def $write_values_from_bits'(value*, nat, bool*) : (value*, bool*) =

  clause 0 : ([], n_var, b*{b <- b*}) = ([], b*{b <- b*})

  clause 1 : (value_h :: value_t*{value_t <- value_t*}, n_var, b*{b <- b*}) = (value_h_updated :: value_t_updated*{value_t_updated <- value_t_updated*}, b_rest*{b_rest <- b_rest*})
  -- if ((value_h_updated, b_t*{b_t <- b_t*}) = $write_value_from_bits'(value_h, n_var, b*{b <- b*}))
  -- if ((value_t_updated*{value_t_updated <- value_t_updated*}, b_rest*{b_rest <- b_rest*}) = $write_values_from_bits'(value_t*{value_t <- value_t*}, n_var, b_t*{b_t <- b_t*}))

def $write_value_fields_from_bits'(fieldValue*, nat, bool*) : (fieldValue*, bool*) =

  clause 0 : ([], n_var, b*{b <- b*}) = ([], b*{b <- b*})

  clause 1 : (fieldValue_h :: fieldValue_t*{fieldValue_t <- fieldValue_t*}, n_var, b*{b <- b*}) = (fieldValue_h_updated :: fieldValue_t_updated*{fieldValue_t_updated <- fieldValue_t_updated*}, b_rest*{b_rest <- b_rest*})
  -- if ((fieldValue_h_updated, b_t*{b_t <- b_t*}) = $write_value_field_from_bits'(fieldValue_h, n_var, b*{b <- b*}))
  -- if ((fieldValue_t_updated*{fieldValue_t_updated <- fieldValue_t_updated*}, b_rest*{b_rest <- b_rest*}) = $write_value_fields_from_bits'(fieldValue_t*{fieldValue_t <- fieldValue_t*}, n_var, b_t*{b_t <- b_t*}))

def $write_value_field_from_bits'(fieldValue, nat, bool*) : (fieldValue, bool*) =

  clause 0 : (value id ';', n_var, b*{b <- b*}) = (value_updated id ';', b_rest*{b_rest <- b_rest*})
  -- if ((value_updated, b_rest*{b_rest <- b_rest*}) = $write_value_from_bits'(value, n_var, b*{b <- b*}))

def $write_bits_from_value(value) : bool* =

  clause 0 : (_B b as value) = [b]

  clause 1 : (w S i as value) = $int_to_bits_signed(w, i)

  clause 2 : (w W i as value) = $int_to_bits_unsigned(w, i)

  clause 3 : (_nat '.' w V i as value) = $int_to_bits_unsigned(w, i)

  clause 4 : (ARRAY `[ value_element*{value_element <- value_element*} `] as value) = $concat_<bool>($write_bits_from_value(value_element)*{value_element <- value_element*})

  clause 5 : (HEADER_STACK `[ value_element*{value_element <- value_element*} `( _nat `) `] as value) = $concat_<bool>($write_bits_from_value(value_element)*{value_element <- value_element*})

  clause 6 : (STRUCT _typeId `{ value_field id_field ';'*{id_field <- id_field*, value_field <- value_field*} `} as value) = $concat_<bool>($write_bits_from_value(value_field)*{value_field <- value_field*})

  clause 7 : (HEADER _typeId `{ true ';' value_field id_field ';'*{id_field <- id_field*, value_field <- value_field*} `} as value) = $concat_<bool>($write_bits_from_value(value_field)*{value_field <- value_field*})

  clause 8 : (HEADER _typeId `{ false ';' _fieldValue*{_fieldValue <- _fieldValue*} `} as value) = []

  clause 9 : (HEADER_UNION _typeId `{ value id ';'*{id <- id*, value <- value*} `} as value) = $concat_<bool>($write_bits_from_value(value)*{value <- value*})

  clause 10 : (typeId '.' id '.' value as value) = $write_bits_from_value(value)

syntax voidTypeIR = 
   | VOID (from voidTypeIR) 

syntax boolTypeIR = 
   | BOOL (from boolTypeIR) 

syntax errorTypeIR = 
   | ERROR (from errorTypeIR) 

syntax matchKindTypeIR = 
   | MATCH_KIND (from matchKindTypeIR) 

syntax stringTypeIR = 
   | STRING (from stringTypeIR) 

syntax intTypeIR = 
   | INT (from intTypeIR) 

syntax fixedIntTypeIR = 
   | INT `< nat `> (from fixedIntTypeIR) 

syntax fixedBitTypeIR = 
   | BIT `< nat `> (from fixedBitTypeIR) 

syntax varBitTypeIR = 
   | VARBIT `< nat `> (from varBitTypeIR) 

syntax integerTypeIR = 
   | INT (from intTypeIR) 
   | INT `< nat `> (from fixedIntTypeIR) 
   | BIT `< nat `> (from fixedBitTypeIR) 
   | VARBIT `< nat `> (from varBitTypeIR) 

syntax baseTypeIR = 
   | VOID (from voidTypeIR) 
   | BOOL (from boolTypeIR) 
   | ERROR (from errorTypeIR) 
   | MATCH_KIND (from matchKindTypeIR) 
   | STRING (from stringTypeIR) 
   | INT (from intTypeIR) 
   | INT `< nat `> (from fixedIntTypeIR) 
   | BIT `< nat `> (from fixedBitTypeIR) 
   | VARBIT `< nat `> (from varBitTypeIR) 

syntax nameTypeIR = 
   | _NAME typeId (from nameTypeIR)  hint(print %0)

syntax typedefTypeIR = 
   | TYPEDEF typeId typeIR (from typedefTypeIR)  hint(print %0)

syntax newTypeIR = 
   | TYPE typeId typeIR (from newTypeIR)  hint(print %0)

syntax aliasTypeIR = 
   | TYPEDEF typeId typeIR (from typedefTypeIR)  hint(print %0)
   | TYPE typeId typeIR (from newTypeIR)  hint(print %0)

syntax listTypeIR = 
   | LIST `< typeIR `> (from listTypeIR) 

syntax tupleTypeIR = 
   | TUPLE `< typeIR* `> (from tupleTypeIR) 

syntax arrayTypeIR = 
   | ARRAY typeIR `[ nat `] (from arrayTypeIR) 

syntax headerStackTypeIR = 
   | HEADER_STACK typeIR `[ nat `] (from headerStackTypeIR) 

syntax fieldTypeIR = 
   | annotationList typeIR nameIR ';' (from fieldTypeIR) 

syntax structTypeIR = 
   | STRUCT typeId `< typeArgumentIR* `> `{ fieldTypeIR* `} (from structTypeIR)  hint(print %0#"<"#%1#">")

syntax headerTypeIR = 
   | HEADER typeId `< typeArgumentIR* `> `{ fieldTypeIR* `} (from headerTypeIR)  hint(print %0#"<"#%1#">")

syntax headerUnionTypeIR = 
   | HEADER_UNION typeId `< typeArgumentIR* `> `{ fieldTypeIR* `} (from headerUnionTypeIR)  hint(print %0#"<"#%1#">")

syntax valueFieldIR = 
   | nameIR '=' value ';' (from valueFieldIR) 

syntax simpleEnumTypeIR = 
   | ENUM typeId `{ nameIR* `} (from simpleEnumTypeIR)  hint(print %0)

syntax serializableEnumTypeIR = 
   | ENUM typeId `< typeIR `> `{ valueFieldIR* `} (from serializableEnumTypeIR)  hint(print %0)

syntax enumTypeIR = 
   | ENUM typeId `{ nameIR* `} (from simpleEnumTypeIR)  hint(print %0)
   | ENUM typeId `< typeIR `> `{ valueFieldIR* `} (from serializableEnumTypeIR)  hint(print %0)

syntax dataTypeIR = 
   | LIST `< typeIR `> (from listTypeIR) 
   | TUPLE `< typeIR* `> (from tupleTypeIR) 
   | ARRAY typeIR `[ nat `] (from arrayTypeIR) 
   | HEADER_STACK typeIR `[ nat `] (from headerStackTypeIR) 
   | STRUCT typeId `< typeArgumentIR* `> `{ fieldTypeIR* `} (from structTypeIR)  hint(print %0#"<"#%1#">")
   | HEADER typeId `< typeArgumentIR* `> `{ fieldTypeIR* `} (from headerTypeIR)  hint(print %0#"<"#%1#">")
   | HEADER_UNION typeId `< typeArgumentIR* `> `{ fieldTypeIR* `} (from headerUnionTypeIR)  hint(print %0#"<"#%1#">")
   | ENUM typeId `{ nameIR* `} (from simpleEnumTypeIR)  hint(print %0)
   | ENUM typeId `< typeIR `> `{ valueFieldIR* `} (from serializableEnumTypeIR)  hint(print %0)

syntax externMethodTypeDefEnv = map<callableId, externMethodTypeDefIR>

syntax externObjectTypeIR = 
   | EXTERN typeId `< typeArgumentIR* `> externMethodTypeDefEnv (from externObjectTypeIR)  hint(print %0#"<"#%1#">")

syntax parserObjectTypeIR = 
   | PARSER typeId `< typeArgumentIR* `> `( parameterIR* `) (from parserObjectTypeIR)  hint(print %0#"<"#%1#">")

syntax controlObjectTypeIR = 
   | CONTROL typeId `< typeArgumentIR* `> `( parameterIR* `) (from controlObjectTypeIR)  hint(print %0#"<"#%1#">")

syntax packageObjectTypeIR = 
   | PACKAGE typeId `< typeArgumentIR* `> `{ typeIR* `} (from packageObjectTypeIR)  hint(print %0#"<"#%1#">")

syntax tableObjectTypeIR = 
   | TABLE typeId `{ tableMetadataStructTypeIR `} (from tableObjectTypeIR)  hint(print %0)

syntax objectTypeIR = 
   | EXTERN typeId `< typeArgumentIR* `> externMethodTypeDefEnv (from externObjectTypeIR)  hint(print %0#"<"#%1#">")
   | PARSER typeId `< typeArgumentIR* `> `( parameterIR* `) (from parserObjectTypeIR)  hint(print %0#"<"#%1#">")
   | CONTROL typeId `< typeArgumentIR* `> `( parameterIR* `) (from controlObjectTypeIR)  hint(print %0#"<"#%1#">")
   | PACKAGE typeId `< typeArgumentIR* `> `{ typeIR* `} (from packageObjectTypeIR)  hint(print %0#"<"#%1#">")
   | TABLE typeId `{ tableMetadataStructTypeIR `} (from tableObjectTypeIR)  hint(print %0)

syntax defaultTypeIR = 
   | DEFAULT (from defaultTypeIR) 

syntax invalidHeaderTypeIR = 
   | HEADER_INVALID (from invalidHeaderTypeIR) 

syntax sequenceTypeIR = 
   | SEQ `< typeIR* `> (from sequenceTypeIR) 
   | SEQ `< typeIR* ',' '...' `> (from sequenceTypeIR) 

syntax recordTypeIR = 
   | RECORD `{ fieldTypeIR* `} (from recordTypeIR) 
   | RECORD `{ fieldTypeIR* ',' '...' `} (from recordTypeIR) 

syntax setTypeIR = 
   | SET `< typeIR `> (from setTypeIR) 

syntax tableMetadataEnumTypeIR = 
   | TABLE_ENUM typeId `{ nameIR* `} (from tableMetadataEnumTypeIR)  hint(print %0)

syntax tableMetadataStructTypeIR = 
   | TABLE_STRUCT typeId `{ HIT boolTypeIR ';' MISS boolTypeIR ';' ACTION_RUN tableMetadataEnumTypeIR ';' `} (from tableMetadataStructTypeIR)  hint(print %0)

syntax tableMetadataTypeIR = 
   | TABLE_ENUM typeId `{ nameIR* `} (from tableMetadataEnumTypeIR)  hint(print %0)
   | TABLE_STRUCT typeId `{ HIT boolTypeIR ';' MISS boolTypeIR ';' ACTION_RUN tableMetadataEnumTypeIR ';' `} (from tableMetadataStructTypeIR)  hint(print %0)

syntax synthesizedTypeIR = 
   | DEFAULT (from defaultTypeIR) 
   | HEADER_INVALID (from invalidHeaderTypeIR) 
   | SEQ `< typeIR* `> (from sequenceTypeIR) 
   | SEQ `< typeIR* ',' '...' `> (from sequenceTypeIR) 
   | RECORD `{ fieldTypeIR* `} (from recordTypeIR) 
   | RECORD `{ fieldTypeIR* ',' '...' `} (from recordTypeIR) 
   | SET `< typeIR `> (from setTypeIR) 
   | TABLE_ENUM typeId `{ nameIR* `} (from tableMetadataEnumTypeIR)  hint(print %0)
   | TABLE_STRUCT typeId `{ HIT boolTypeIR ';' MISS boolTypeIR ';' ACTION_RUN tableMetadataEnumTypeIR ';' `} (from tableMetadataStructTypeIR)  hint(print %0)

syntax typeIR = 
   | VOID (from voidTypeIR) 
   | BOOL (from boolTypeIR) 
   | ERROR (from errorTypeIR) 
   | MATCH_KIND (from matchKindTypeIR) 
   | STRING (from stringTypeIR) 
   | INT (from intTypeIR) 
   | INT `< nat `> (from fixedIntTypeIR) 
   | BIT `< nat `> (from fixedBitTypeIR) 
   | VARBIT `< nat `> (from varBitTypeIR) 
   | _NAME typeId (from nameTypeIR)  hint(print %0)
   | TYPEDEF typeId typeIR (from typedefTypeIR)  hint(print %0)
   | TYPE typeId typeIR (from newTypeIR)  hint(print %0)
   | LIST `< typeIR `> (from listTypeIR) 
   | TUPLE `< typeIR* `> (from tupleTypeIR) 
   | ARRAY typeIR `[ nat `] (from arrayTypeIR) 
   | HEADER_STACK typeIR `[ nat `] (from headerStackTypeIR) 
   | STRUCT typeId `< typeArgumentIR* `> `{ fieldTypeIR* `} (from structTypeIR)  hint(print %0#"<"#%1#">")
   | HEADER typeId `< typeArgumentIR* `> `{ fieldTypeIR* `} (from headerTypeIR)  hint(print %0#"<"#%1#">")
   | HEADER_UNION typeId `< typeArgumentIR* `> `{ fieldTypeIR* `} (from headerUnionTypeIR)  hint(print %0#"<"#%1#">")
   | ENUM typeId `{ nameIR* `} (from simpleEnumTypeIR)  hint(print %0)
   | ENUM typeId `< typeIR `> `{ valueFieldIR* `} (from serializableEnumTypeIR)  hint(print %0)
   | EXTERN typeId `< typeArgumentIR* `> externMethodTypeDefEnv (from externObjectTypeIR)  hint(print %0#"<"#%1#">")
   | PARSER typeId `< typeArgumentIR* `> `( parameterIR* `) (from parserObjectTypeIR)  hint(print %0#"<"#%1#">")
   | CONTROL typeId `< typeArgumentIR* `> `( parameterIR* `) (from controlObjectTypeIR)  hint(print %0#"<"#%1#">")
   | PACKAGE typeId `< typeArgumentIR* `> `{ typeIR* `} (from packageObjectTypeIR)  hint(print %0#"<"#%1#">")
   | TABLE typeId `{ tableMetadataStructTypeIR `} (from tableObjectTypeIR)  hint(print %0)
   | DEFAULT (from defaultTypeIR) 
   | HEADER_INVALID (from invalidHeaderTypeIR) 
   | SEQ `< typeIR* `> (from sequenceTypeIR) 
   | SEQ `< typeIR* ',' '...' `> (from sequenceTypeIR) 
   | RECORD `{ fieldTypeIR* `} (from recordTypeIR) 
   | RECORD `{ fieldTypeIR* ',' '...' `} (from recordTypeIR) 
   | SET `< typeIR `> (from setTypeIR) 
   | TABLE_ENUM typeId `{ nameIR* `} (from tableMetadataEnumTypeIR)  hint(print %0)
   | TABLE_STRUCT typeId `{ HIT boolTypeIR ';' MISS boolTypeIR ';' ACTION_RUN tableMetadataEnumTypeIR ';' `} (from tableMetadataStructTypeIR)  hint(print %0)

syntax typeArgumentIR = typeIR

syntax typeParameterIR = typeId

syntax nameTypeDefIR = nameTypeIR

syntax aliasTypeDefIR = aliasTypeIR

syntax structTypeDefIR = 
   | STRUCT typeId `< typeParameterIR* `> `{ fieldTypeIR* `} (from structTypeDefIR) 

syntax headerTypeDefIR = 
   | HEADER typeId `< typeParameterIR* `> `{ fieldTypeIR* `} (from headerTypeDefIR) 

syntax headerUnionTypeDefIR = 
   | HEADER_UNION typeId `< typeParameterIR* `> `{ fieldTypeIR* `} (from headerUnionTypeDefIR) 

syntax enumTypeDefIR = enumTypeIR

syntax dataTypeDefIR = 
   | STRUCT typeId `< typeParameterIR* `> `{ fieldTypeIR* `} (from structTypeDefIR) 
   | HEADER typeId `< typeParameterIR* `> `{ fieldTypeIR* `} (from headerTypeDefIR) 
   | HEADER_UNION typeId `< typeParameterIR* `> `{ fieldTypeIR* `} (from headerUnionTypeDefIR) 
   | ENUM typeId `{ nameIR* `} (from simpleEnumTypeIR)  hint(print %0)
   | ENUM typeId `< typeIR `> `{ valueFieldIR* `} (from serializableEnumTypeIR)  hint(print %0)

syntax externObjectTypeDefIR = 
   | EXTERN typeId `< typeParameterIR* ',' typeParameterIR* `> externMethodTypeDefEnv (from externObjectTypeDefIR) 

syntax parserObjectTypeDefIR = 
   | PARSER typeId `< typeParameterIR* ',' typeParameterIR* `> `( parameterIR* `) (from parserObjectTypeDefIR) 

syntax controlObjectTypeDefIR = 
   | CONTROL typeId `< typeParameterIR* ',' typeParameterIR* `> `( parameterIR* `) (from controlObjectTypeDefIR) 

syntax packageObjectTypeDefIR = 
   | PACKAGE typeId `< typeParameterIR* ',' typeParameterIR* `> `{ typeIR* `} (from packageObjectTypeDefIR) 

syntax tableObjectTypeDefIR = tableObjectTypeIR

syntax objectTypeDefIR = 
   | EXTERN typeId `< typeParameterIR* ',' typeParameterIR* `> externMethodTypeDefEnv (from externObjectTypeDefIR) 
   | PARSER typeId `< typeParameterIR* ',' typeParameterIR* `> `( parameterIR* `) (from parserObjectTypeDefIR) 
   | CONTROL typeId `< typeParameterIR* ',' typeParameterIR* `> `( parameterIR* `) (from controlObjectTypeDefIR) 
   | PACKAGE typeId `< typeParameterIR* ',' typeParameterIR* `> `{ typeIR* `} (from packageObjectTypeDefIR) 
   | TABLE typeId `{ tableMetadataStructTypeIR `} (from tableObjectTypeIR)  hint(print %0)

syntax typeDefIR = 
   | _NAME typeId (from nameTypeIR)  hint(print %0)
   | TYPEDEF typeId typeIR (from typedefTypeIR)  hint(print %0)
   | TYPE typeId typeIR (from newTypeIR)  hint(print %0)
   | STRUCT typeId `< typeParameterIR* `> `{ fieldTypeIR* `} (from structTypeDefIR) 
   | HEADER typeId `< typeParameterIR* `> `{ fieldTypeIR* `} (from headerTypeDefIR) 
   | HEADER_UNION typeId `< typeParameterIR* `> `{ fieldTypeIR* `} (from headerUnionTypeDefIR) 
   | ENUM typeId `{ nameIR* `} (from simpleEnumTypeIR)  hint(print %0)
   | ENUM typeId `< typeIR `> `{ valueFieldIR* `} (from serializableEnumTypeIR)  hint(print %0)
   | EXTERN typeId `< typeParameterIR* ',' typeParameterIR* `> externMethodTypeDefEnv (from externObjectTypeDefIR) 
   | PARSER typeId `< typeParameterIR* ',' typeParameterIR* `> `( parameterIR* `) (from parserObjectTypeDefIR) 
   | CONTROL typeId `< typeParameterIR* ',' typeParameterIR* `> `( parameterIR* `) (from controlObjectTypeDefIR) 
   | PACKAGE typeId `< typeParameterIR* ',' typeParameterIR* `> `{ typeIR* `} (from packageObjectTypeDefIR) 
   | TABLE typeId `{ tableMetadataStructTypeIR `} (from tableObjectTypeIR)  hint(print %0)

def $unroll_typeIR(typeIR) : typeIR =

  clause 0 : (TYPEDEF _typeId typeIR as typeIR) = $unroll_typeIR(typeIR)

  clause -1 : (typeIR) = typeIR

def $unroll_aliasType(typeIR) : typeIR =

  clause 0 : (TYPE _typeId typeIR as typeIR) = $unroll_aliasType(typeIR)

  clause 1 : (TYPEDEF _typeId typeIR as typeIR) = $unroll_aliasType(typeIR)

  clause -1 : (typeIR) = typeIR

def $width_of_integerTypeIR(integerTypeIR) : nat? =

  clause 0 : (INT as integerTypeIR) = ?()

  clause 1 : (INT `< n `> as integerTypeIR) = ?(n)

  clause 2 : (BIT `< n `> as integerTypeIR) = ?(n)

  clause 3 : (VARBIT `< n `> as integerTypeIR) = ?(n)

tbl def $is_defaultable_typeIR(typeIR) : bool =
  row 0 :
    (BOOL as typeIR) -> true
  row 1 :
    (ERROR as typeIR) -> true
  row 2 :
    (STRING as typeIR) -> true
  row 3 :
    (integerTypeIR as typeIR) -> true
  row 4 :
    (TYPEDEF _typeId typeIR as typeIR) -> $is_defaultable_typeIR(typeIR)
  row 5 :
    (TYPE _typeId typeIR as typeIR) -> $is_defaultable_typeIR(typeIR)
  row 6 :
    (TUPLE `< typeIR*{typeIR <- typeIR*} `> as typeIR) -> $forall_($is_defaultable_typeIR(typeIR)*{typeIR <- typeIR*})
  row 7 :
    (ARRAY typeIR `[ _nat `] as typeIR) -> $is_defaultable_typeIR(typeIR)
  row 8 :
    (HEADER_STACK typeIR `[ _nat `] as typeIR) -> $is_defaultable_typeIR(typeIR)
  row 9 :
    (STRUCT _typeId `< _typeArgumentIR*{_typeArgumentIR <- _typeArgumentIR*} `> `{ _annotationList typeIR _nameIR ';'*{_annotationList <- _annotationList*, _nameIR <- _nameIR*, typeIR <- typeIR*} `} as typeIR) -> $forall_($is_defaultable_typeIR(typeIR)*{typeIR <- typeIR*})
  row 10 :
    (HEADER _typeId `< _typeArgumentIR*{_typeArgumentIR <- _typeArgumentIR*} `> `{ _annotationList typeIR _nameIR ';'*{_annotationList <- _annotationList*, _nameIR <- _nameIR*, typeIR <- typeIR*} `} as typeIR) -> $forall_($is_defaultable_typeIR(typeIR)*{typeIR <- typeIR*})
  row 11 :
    (HEADER_UNION _typeId `< _typeArgumentIR*{_typeArgumentIR <- _typeArgumentIR*} `> `{ _annotationList typeIR _nameIR ';'*{_annotationList <- _annotationList*, _nameIR <- _nameIR*, typeIR <- typeIR*} `} as typeIR) -> $forall_($is_defaultable_typeIR(typeIR)*{typeIR <- typeIR*})
  row 12 :
    (ENUM _typeId `{ _nameIR*{_nameIR <- _nameIR*} `} as typeIR) -> true
  row 13 :
    (ENUM _typeId `< typeIR `> `{ _valueFieldIR*{_valueFieldIR <- _valueFieldIR*} `} as typeIR) -> $is_defaultable_typeIR(typeIR)
  row 14 :
    (_typeIR) -> false

tbl def $is_equalable_typeIR(typeIR) : bool =
  row 0 :
    (VOID as typeIR) -> false
  row 1 :
    (_NAME typeId as typeIR) -> false
  row 2 :
    (TYPEDEF _typeId typeIR as typeIR) -> $is_equalable_typeIR(typeIR)
  row 3 :
    (externObjectTypeIR as typeIR) -> false
  row 4 :
    (parserObjectTypeIR as typeIR) -> false
  row 5 :
    (controlObjectTypeIR as typeIR) -> false
  row 6 :
    (packageObjectTypeIR as typeIR) -> false
  row 7 :
    (tableObjectTypeIR as typeIR) -> false
  row 8 :
    (DEFAULT as typeIR) -> false
  row 9 :
    (sequenceTypeIR as typeIR) -> false
  row 10 :
    (recordTypeIR as typeIR) -> false
  row 11 :
    (HEADER_INVALID as typeIR) -> false
  row 12 :
    (setTypeIR as typeIR) -> false
  row 13 :
    (tableMetadataTypeIR as typeIR) -> false
  row 14 :
    (_typeIR) -> true

tbl def $is_assignable_typeIR(typeIR) : bool =
  row 0 :
    (VOID as typeIR) -> false
  row 1 :
    (STRING as typeIR) -> false
  row 2 :
    (INT as typeIR) -> false
  row 3 :
    (TYPEDEF _typeId typeIR as typeIR) -> $is_assignable_typeIR(typeIR)
  row 4 :
    (objectTypeIR as typeIR) -> false
  row 5 :
    (synthesizedTypeIR as typeIR) -> false
  row 6 :
    (_typeIR) -> true

tbl def $is_serializable_typeIR(typeIR) : bool =
  row 0 :
    (BOOL as typeIR) -> true
  row 1 :
    (INT `< _nat `> as typeIR) -> true
  row 2 :
    (BIT `< _nat `> as typeIR) -> true
  row 3 :
    (VARBIT `< _nat `> as typeIR) -> true
  row 4 :
    (TYPEDEF _typeId typeIR as typeIR) -> $is_serializable_typeIR(typeIR)
  row 5 :
    (TYPE _typeId typeIR as typeIR) -> $is_serializable_typeIR(typeIR)
  row 6 :
    (ENUM _typeId `< typeIR `> `{ _valueFieldIR*{_valueFieldIR <- _valueFieldIR*} `} as typeIR) -> $is_serializable_typeIR(typeIR)
  row 7 :
    (TUPLE `< typeIR*{typeIR <- typeIR*} `> as typeIR) -> $forall_($is_serializable_typeIR(typeIR)*{typeIR <- typeIR*})
  row 8 :
    (ARRAY typeIR `[ _nat `] as typeIR) -> $is_serializable_typeIR(typeIR)
  row 9 :
    (HEADER_STACK typeIR `[ _nat `] as typeIR) -> $is_serializable_typeIR(typeIR)
  row 10 :
    (STRUCT _typeId `< _typeArgumentIR*{_typeArgumentIR <- _typeArgumentIR*} `> `{ _annotationList typeIR _nameIR ';'*{_annotationList <- _annotationList*, _nameIR <- _nameIR*, typeIR <- typeIR*} `} as typeIR) -> $forall_($is_serializable_typeIR(typeIR)*{typeIR <- typeIR*})
  row 11 :
    (HEADER _typeId `< _typeArgumentIR*{_typeArgumentIR <- _typeArgumentIR*} `> `{ _annotationList typeIR _nameIR ';'*{_annotationList <- _annotationList*, _nameIR <- _nameIR*, typeIR <- typeIR*} `} as typeIR) -> $forall_($is_serializable_typeIR(typeIR)*{typeIR <- typeIR*})
  row 12 :
    (HEADER_UNION _typeId `< _typeArgumentIR*{_typeArgumentIR <- _typeArgumentIR*} `> `{ _annotationList typeIR _nameIR ';'*{_annotationList <- _annotationList*, _nameIR <- _nameIR*, typeIR <- typeIR*} `} as typeIR) -> $forall_($is_serializable_typeIR(typeIR)*{typeIR <- typeIR*})
  row 13 :
    (_typeIR) -> false

def $typeId_of_typeDefIR(typeDefIR) : typeId =

  clause 0 : (_NAME typeId as typeDefIR) = typeId

  clause 1 : (TYPEDEF typeId _typeIR as typeDefIR) = typeId

  clause 2 : (TYPE typeId _typeIR as typeDefIR) = typeId

  clause 3 : (STRUCT typeId `< _typeParameterIR*{_typeParameterIR <- _typeParameterIR*} `> `{ _fieldTypeIR*{_fieldTypeIR <- _fieldTypeIR*} `} as typeDefIR) = typeId

  clause 4 : (HEADER typeId `< _typeParameterIR*{_typeParameterIR <- _typeParameterIR*} `> `{ _fieldTypeIR*{_fieldTypeIR <- _fieldTypeIR*} `} as typeDefIR) = typeId

  clause 5 : (HEADER_UNION typeId `< _typeParameterIR*{_typeParameterIR <- _typeParameterIR*} `> `{ _fieldTypeIR*{_fieldTypeIR <- _fieldTypeIR*} `} as typeDefIR) = typeId

  clause 6 : (ENUM typeId `{ _nameIR*{_nameIR <- _nameIR*} `} as typeDefIR) = typeId

  clause 7 : (ENUM typeId `< _typeIR `> `{ _valueFieldIR*{_valueFieldIR <- _valueFieldIR*} `} as typeDefIR) = typeId

  clause 8 : (EXTERN typeId `< _typeParameterIR*{_typeParameterIR <- _typeParameterIR*} ',' _typeParameterIR'*{_typeParameterIR' <- _typeParameterIR'*} `> `{ _pair<callableId, externMethodTypeDefIR>*{_pair<callableId, externMethodTypeDefIR> <- _pair<callableId, externMethodTypeDefIR>*} `} as typeDefIR) = typeId

  clause 9 : (PARSER typeId `< _typeParameterIR*{_typeParameterIR <- _typeParameterIR*} ',' _typeParameterIR'*{_typeParameterIR' <- _typeParameterIR'*} `> `( _parameterIR*{_parameterIR <- _parameterIR*} `) as typeDefIR) = typeId

  clause 10 : (CONTROL typeId `< _typeParameterIR*{_typeParameterIR <- _typeParameterIR*} ',' _typeParameterIR'*{_typeParameterIR' <- _typeParameterIR'*} `> `( _parameterIR*{_parameterIR <- _parameterIR*} `) as typeDefIR) = typeId

  clause 11 : (PACKAGE typeId `< _typeParameterIR*{_typeParameterIR <- _typeParameterIR*} ',' _typeParameterIR'*{_typeParameterIR' <- _typeParameterIR'*} `> `{ _typeIR*{_typeIR <- _typeIR*} `} as typeDefIR) = typeId

  clause 12 : (TABLE typeId `{ _tableMetadataStructTypeIR `} as typeDefIR) = typeId

def $typeIR_of_typeDefIR(typeDefIR) : typeIR =

  clause 0 : (nameTypeDefIR as typeDefIR) = nameTypeDefIR as typeIR

  clause 1 : (aliasTypeDefIR as typeDefIR) = aliasTypeDefIR as typeIR

  clause 2 : (STRUCT typeId `< typeParameterIR*{typeParameterIR <- typeParameterIR*} `> `{ fieldTypeIR*{fieldTypeIR <- fieldTypeIR*} `} as typeDefIR) = STRUCT typeId `< _NAME typeParameterIR as typeIR*{typeParameterIR <- typeParameterIR*} `> `{ fieldTypeIR*{fieldTypeIR <- fieldTypeIR*} `} as typeIR

  clause 3 : (HEADER typeId `< typeParameterIR*{typeParameterIR <- typeParameterIR*} `> `{ fieldTypeIR*{fieldTypeIR <- fieldTypeIR*} `} as typeDefIR) = HEADER typeId `< _NAME typeParameterIR as typeIR*{typeParameterIR <- typeParameterIR*} `> `{ fieldTypeIR*{fieldTypeIR <- fieldTypeIR*} `} as typeIR

  clause 4 : (HEADER_UNION typeId `< typeParameterIR*{typeParameterIR <- typeParameterIR*} `> `{ fieldTypeIR*{fieldTypeIR <- fieldTypeIR*} `} as typeDefIR) = HEADER_UNION typeId `< _NAME typeParameterIR as typeIR*{typeParameterIR <- typeParameterIR*} `> `{ fieldTypeIR*{fieldTypeIR <- fieldTypeIR*} `} as typeIR

  clause 5 : (enumTypeDefIR as typeDefIR) = enumTypeDefIR as typeIR

  clause 6 : (EXTERN typeId `< typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*} ',' typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*} `> `{ callableId ':' externMethodTypeDefIR*{callableId <- callableId*, externMethodTypeDefIR <- externMethodTypeDefIR*} `} as typeDefIR) = EXTERN typeId `< _NAME typeParameterIR as typeIR*{typeParameterIR <- typeParameterIR*} `> `{ callableId ':' externMethodTypeDefIR*{callableId <- callableId*, externMethodTypeDefIR <- externMethodTypeDefIR*} `} as typeIR
  -- if (typeParameterIR*{typeParameterIR <- typeParameterIR*} = typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*} ++ typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*})

  clause 7 : (PARSER typeId `< typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*} ',' typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*} `> `( parameterIR*{parameterIR <- parameterIR*} `) as typeDefIR) = PARSER typeId `< _NAME typeParameterIR as typeIR*{typeParameterIR <- typeParameterIR*} `> `( parameterIR*{parameterIR <- parameterIR*} `) as typeIR
  -- if (typeParameterIR*{typeParameterIR <- typeParameterIR*} = typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*} ++ typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*})

  clause 8 : (CONTROL typeId `< typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*} ',' typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*} `> `( parameterIR*{parameterIR <- parameterIR*} `) as typeDefIR) = CONTROL typeId `< _NAME typeParameterIR as typeIR*{typeParameterIR <- typeParameterIR*} `> `( parameterIR*{parameterIR <- parameterIR*} `) as typeIR
  -- if (typeParameterIR*{typeParameterIR <- typeParameterIR*} = typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*} ++ typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*})

  clause 9 : (PACKAGE typeId `< typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*} ',' typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*} `> `{ typeIR*{typeIR <- typeIR*} `} as typeDefIR) = PACKAGE typeId `< _NAME typeParameterIR as typeIR*{typeParameterIR <- typeParameterIR*} `> `{ typeIR*{typeIR <- typeIR*} `} as typeIR
  -- if (typeParameterIR*{typeParameterIR <- typeParameterIR*} = typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*} ++ typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*})

  clause 10 : (tableObjectTypeDefIR as typeDefIR) = tableObjectTypeDefIR as typeIR

def $typeParameterListIR_of_typeDefIR(typeDefIR) : (typeParameterIR*, typeParameterIR*) =

  clause 0 : (nameTypeDefIR as typeDefIR) = ([], [])

  clause 1 : (aliasTypeDefIR as typeDefIR) = ([], [])

  clause 2 : (STRUCT _typeId `< typeParameterIR*{typeParameterIR <- typeParameterIR*} `> `{ _fieldTypeIR*{_fieldTypeIR <- _fieldTypeIR*} `} as typeDefIR) = (typeParameterIR*{typeParameterIR <- typeParameterIR*}, [])

  clause 3 : (HEADER _typeId `< typeParameterIR*{typeParameterIR <- typeParameterIR*} `> `{ _fieldTypeIR*{_fieldTypeIR <- _fieldTypeIR*} `} as typeDefIR) = (typeParameterIR*{typeParameterIR <- typeParameterIR*}, [])

  clause 4 : (HEADER_UNION _typeId `< typeParameterIR*{typeParameterIR <- typeParameterIR*} `> `{ _fieldTypeIR*{_fieldTypeIR <- _fieldTypeIR*} `} as typeDefIR) = (typeParameterIR*{typeParameterIR <- typeParameterIR*}, [])

  clause 5 : (enumTypeDefIR as typeDefIR) = ([], [])

  clause 6 : (EXTERN _typeId `< typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*} ',' typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*} `> `{ _pair<callableId, externMethodTypeDefIR>*{_pair<callableId, externMethodTypeDefIR> <- _pair<callableId, externMethodTypeDefIR>*} `} as typeDefIR) = (typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*}, typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*})

  clause 7 : (PARSER _typeId `< typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*} ',' typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*} `> `( _parameterIR*{_parameterIR <- _parameterIR*} `) as typeDefIR) = (typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*}, typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*})

  clause 8 : (CONTROL _typeId `< typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*} ',' typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*} `> `( _parameterIR*{_parameterIR <- _parameterIR*} `) as typeDefIR) = (typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*}, typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*})

  clause 9 : (PACKAGE _typeId `< typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*} ',' typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*} `> `{ _typeIR*{_typeIR <- _typeIR*} `} as typeDefIR) = (typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*}, typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*})

  clause 10 : (tableObjectTypeDefIR as typeDefIR) = ([], [])

def $is_monomorphic_typeDefIR(typeDefIR) : bool =

  clause 0 : (nameTypeDefIR as typeDefIR) = true

  clause 1 : (aliasTypeDefIR as typeDefIR) = true

  clause 2 : (enumTypeDefIR as typeDefIR) = true

  clause 3 : (tableObjectTypeDefIR as typeDefIR) = true

  clause -1 : (typeDefIR) = false

def $is_polymorphic_typeDefIR(typeDefIR) : bool =

  clause 0 : (typeDefIR) = ~$is_monomorphic_typeDefIR(typeDefIR)

syntax initializerIR = 
   | '=' typedExpressionIR (from initializerIR) 

syntax constantInitializerIR = 
   | '=' _VALUE value (from constantInitializerIR) 

syntax parameterInitializerIR = 
   | '=' typedExpressionIR (from initializerIR) 
   | '=' _VALUE value (from constantInitializerIR) 

syntax parameterInitializerOptIR = parameterInitializerIR?

syntax parameterIR = 
   | annotationList direction typeIR id parameterInitializerOptIR (from parameterIR)  hint(prose_fields "annotations" "direction" "type" "name" "default initializer")

syntax actionTypeIR = 
   | annotationList ACTION nameIR `( parameterIR* `) (from actionTypeIR) 

syntax definedFunctionTypeIR = 
   | FUNCTION nameIR `( parameterIR* `) ':' typeIR (from definedFunctionTypeIR) 

syntax externFunctionTypeIR = 
   | EXTERN_FUNCTION nameIR `( parameterIR* `) ':' typeIR (from externFunctionTypeIR) 

syntax functionTypeIR = 
   | FUNCTION nameIR `( parameterIR* `) ':' typeIR (from definedFunctionTypeIR) 
   | EXTERN_FUNCTION nameIR `( parameterIR* `) ':' typeIR (from externFunctionTypeIR) 

syntax builtinIsValidMethodTypeIR = 
   | BUILTIN_IS_VALID (from builtinIsValidMethodTypeIR) 

syntax builtinSetValidMethodTypeIR = 
   | BUILTIN_SET_VALID (from builtinSetValidMethodTypeIR) 

syntax builtinSetInvalidMethodTypeIR = 
   | BUILTIN_SET_INVALID (from builtinSetInvalidMethodTypeIR) 

syntax builtinPushFrontMethodTypeIR = 
   | BUILTIN_PUSH_FRONT (from builtinPushFrontMethodTypeIR) 

syntax builtinPopFrontMethodTypeIR = 
   | BUILTIN_POP_FRONT (from builtinPopFrontMethodTypeIR) 

syntax builtinSizeMethodTypeIR = 
   | BUILTIN_SIZE_OF (from builtinSizeMethodTypeIR) 

syntax builtinMethodTypeIR = 
   | BUILTIN_IS_VALID (from builtinIsValidMethodTypeIR) 
   | BUILTIN_SET_VALID (from builtinSetValidMethodTypeIR) 
   | BUILTIN_SET_INVALID (from builtinSetInvalidMethodTypeIR) 
   | BUILTIN_PUSH_FRONT (from builtinPushFrontMethodTypeIR) 
   | BUILTIN_POP_FRONT (from builtinPopFrontMethodTypeIR) 
   | BUILTIN_SIZE_OF (from builtinSizeMethodTypeIR) 

def $signature_of_builtinMethodTypeIR(builtinMethodTypeIR) : (parameterIR*, typeIR) =

  clause 0 : (BUILTIN_IS_VALID as builtinMethodTypeIR) = ([], BOOL as typeIR)

  clause 1 : (BUILTIN_SET_VALID as builtinMethodTypeIR) = ([], VOID as typeIR)

  clause 2 : (BUILTIN_SET_INVALID as builtinMethodTypeIR) = ([], VOID as typeIR)

  clause 3 : (BUILTIN_PUSH_FRONT as builtinMethodTypeIR) = ([_EMPTY _EMPTY INT as typeIR "count" ?()], VOID as typeIR)

  clause 4 : (BUILTIN_POP_FRONT as builtinMethodTypeIR) = ([_EMPTY _EMPTY INT as typeIR "count" ?()], VOID as typeIR)

  clause 5 : (BUILTIN_SIZE_OF as builtinMethodTypeIR) = ([], INT as typeIR)

syntax externMethodTypeIR = 
   | EXTERN_METHOD nameIR `( parameterIR* `) ':' typeIR (from externMethodTypeIR) 
   | EXTERN_METHOD ABSTRACT nameIR `( parameterIR* `) ':' typeIR (from externMethodTypeIR) 

syntax parserApplyMethodTypeIR = 
   | PARSER_APPLY `( parameterIR* `) (from parserApplyMethodTypeIR) 

syntax controlApplyMethodTypeIR = 
   | CONTROL_APPLY `( parameterIR* `) (from controlApplyMethodTypeIR) 

syntax tableApplyMethodTypeIR = 
   | TABLE_APPLY ':' tableMetadataStructTypeIR (from tableApplyMethodTypeIR) 

syntax methodTypeIR = 
   | BUILTIN_IS_VALID (from builtinIsValidMethodTypeIR) 
   | BUILTIN_SET_VALID (from builtinSetValidMethodTypeIR) 
   | BUILTIN_SET_INVALID (from builtinSetInvalidMethodTypeIR) 
   | BUILTIN_PUSH_FRONT (from builtinPushFrontMethodTypeIR) 
   | BUILTIN_POP_FRONT (from builtinPopFrontMethodTypeIR) 
   | BUILTIN_SIZE_OF (from builtinSizeMethodTypeIR) 
   | EXTERN_METHOD nameIR `( parameterIR* `) ':' typeIR (from externMethodTypeIR) 
   | EXTERN_METHOD ABSTRACT nameIR `( parameterIR* `) ':' typeIR (from externMethodTypeIR) 
   | PARSER_APPLY `( parameterIR* `) (from parserApplyMethodTypeIR) 
   | CONTROL_APPLY `( parameterIR* `) (from controlApplyMethodTypeIR) 
   | TABLE_APPLY ':' tableMetadataStructTypeIR (from tableApplyMethodTypeIR) 

syntax callableTypeIR = 
   | annotationList ACTION nameIR `( parameterIR* `) (from actionTypeIR) 
   | FUNCTION nameIR `( parameterIR* `) ':' typeIR (from definedFunctionTypeIR) 
   | EXTERN_FUNCTION nameIR `( parameterIR* `) ':' typeIR (from externFunctionTypeIR) 
   | BUILTIN_IS_VALID (from builtinIsValidMethodTypeIR) 
   | BUILTIN_SET_VALID (from builtinSetValidMethodTypeIR) 
   | BUILTIN_SET_INVALID (from builtinSetInvalidMethodTypeIR) 
   | BUILTIN_PUSH_FRONT (from builtinPushFrontMethodTypeIR) 
   | BUILTIN_POP_FRONT (from builtinPopFrontMethodTypeIR) 
   | BUILTIN_SIZE_OF (from builtinSizeMethodTypeIR) 
   | EXTERN_METHOD nameIR `( parameterIR* `) ':' typeIR (from externMethodTypeIR) 
   | EXTERN_METHOD ABSTRACT nameIR `( parameterIR* `) ':' typeIR (from externMethodTypeIR) 
   | PARSER_APPLY `( parameterIR* `) (from parserApplyMethodTypeIR) 
   | CONTROL_APPLY `( parameterIR* `) (from controlApplyMethodTypeIR) 
   | TABLE_APPLY ':' tableMetadataStructTypeIR (from tableApplyMethodTypeIR) 

def $id_of_parameterIR(parameterIR) : id =

  clause 0 : (_annotationList _direction _typeIR id _parameterInitializerOptIR) = id

def $is_default_parameterIR(parameterIR) : bool =

  clause 0 : (_annotationList _direction _typeIR _id ?()) = false

  clause -1 : (_annotationList _direction _typeIR _id _parameterInitializerOptIR) = true

def $annotationList_of_parameterIR(parameterIR) : annotationList =

  clause 0 : (annotationList _direction _typeIR _id _parameterInitializerOptIR) = annotationList

def $optional_annotation_of_parameterIR(parameterIR) : bool =

  clause 0 : (parameterIR) = $optional_annotation_of_parameterIR'(annotationList)
  -- if (annotationList = $annotationList_of_parameterIR(parameterIR))

def $optional_annotation_of_parameterIR'(annotationList) : bool =

  clause 0 : (annotationList) = $exists_(b*{b <- b*})
  -- if (annotation*{annotation <- annotation*} = $flatten_annotationList(annotationList))
  -- (if (b = $optional_annotation_of_parameterIR''(annotation)))*{annotation <- annotation*, b <- b*}

def $optional_annotation_of_parameterIR''(annotation) : bool =

  clause 0 : ('@' name) = true
  -- if ("optional" = $name(name))

  clause -1 : (annotation) = false

def $is_optional_parameterIR(parameterIR) : bool =

  clause 0 : (parameterIR) = $optional_annotation_of_parameterIR(parameterIR)

syntax actionTypeDefIR = actionTypeIR

syntax definedFunctionTypeDefIR = 
   | FUNCTION nameIR `< typeParameterIR* ',' typeParameterIR* `> `( parameterIR* `) ':' typeIR (from definedFunctionTypeDefIR) 

syntax externFunctionTypeDefIR = 
   | EXTERN_FUNCTION nameIR `< typeParameterIR* ',' typeParameterIR* `> `( parameterIR* `) ':' typeIR (from externFunctionTypeDefIR) 

syntax functionTypeDefIR = 
   | FUNCTION nameIR `< typeParameterIR* ',' typeParameterIR* `> `( parameterIR* `) ':' typeIR (from definedFunctionTypeDefIR) 
   | EXTERN_FUNCTION nameIR `< typeParameterIR* ',' typeParameterIR* `> `( parameterIR* `) ':' typeIR (from externFunctionTypeDefIR) 

syntax externMethodTypeDefIR = 
   | EXTERN_METHOD nameIR `< typeParameterIR* ',' typeParameterIR* `> `( parameterIR* `) ':' typeIR (from externMethodTypeDefIR) 
   | EXTERN_METHOD ABSTRACT nameIR `< typeParameterIR* ',' typeParameterIR* `> `( parameterIR* `) ':' typeIR (from externMethodTypeDefIR) 

syntax parserApplyMethodTypeDefIR = parserApplyMethodTypeIR

syntax controlApplyMethodTypeDefIR = controlApplyMethodTypeIR

syntax tableApplyMethodTypeDefIR = tableApplyMethodTypeIR

syntax methodTypeDefIR = 
   | EXTERN_METHOD nameIR `< typeParameterIR* ',' typeParameterIR* `> `( parameterIR* `) ':' typeIR (from externMethodTypeDefIR) 
   | EXTERN_METHOD ABSTRACT nameIR `< typeParameterIR* ',' typeParameterIR* `> `( parameterIR* `) ':' typeIR (from externMethodTypeDefIR) 
   | PARSER_APPLY `( parameterIR* `) (from parserApplyMethodTypeIR) 
   | CONTROL_APPLY `( parameterIR* `) (from controlApplyMethodTypeIR) 
   | TABLE_APPLY ':' tableMetadataStructTypeIR (from tableApplyMethodTypeIR) 

syntax callableTypeDefIR = 
   | annotationList ACTION nameIR `( parameterIR* `) (from actionTypeIR) 
   | FUNCTION nameIR `< typeParameterIR* ',' typeParameterIR* `> `( parameterIR* `) ':' typeIR (from definedFunctionTypeDefIR) 
   | EXTERN_FUNCTION nameIR `< typeParameterIR* ',' typeParameterIR* `> `( parameterIR* `) ':' typeIR (from externFunctionTypeDefIR) 
   | EXTERN_METHOD nameIR `< typeParameterIR* ',' typeParameterIR* `> `( parameterIR* `) ':' typeIR (from externMethodTypeDefIR) 
   | EXTERN_METHOD ABSTRACT nameIR `< typeParameterIR* ',' typeParameterIR* `> `( parameterIR* `) ':' typeIR (from externMethodTypeDefIR) 
   | PARSER_APPLY `( parameterIR* `) (from parserApplyMethodTypeIR) 
   | CONTROL_APPLY `( parameterIR* `) (from controlApplyMethodTypeIR) 
   | TABLE_APPLY ':' tableMetadataStructTypeIR (from tableApplyMethodTypeIR) 

def $callableTypeIR_of_callableTypeDefIR(callableTypeDefIR) : callableTypeIR =

  clause 0 : (actionTypeDefIR as callableTypeDefIR) = actionTypeDefIR as callableTypeIR

  clause 1 : (FUNCTION nameIR `< _typeParameterIR*{_typeParameterIR <- _typeParameterIR*} ',' _typeParameterIR'*{_typeParameterIR' <- _typeParameterIR'*} `> `( parameterIR*{parameterIR <- parameterIR*} `) ':' typeIR as callableTypeDefIR) = FUNCTION nameIR `( parameterIR*{parameterIR <- parameterIR*} `) ':' typeIR as callableTypeIR

  clause 2 : (EXTERN_FUNCTION nameIR `< _typeParameterIR*{_typeParameterIR <- _typeParameterIR*} ',' _typeParameterIR'*{_typeParameterIR' <- _typeParameterIR'*} `> `( parameterIR*{parameterIR <- parameterIR*} `) ':' typeIR as callableTypeDefIR) = EXTERN_FUNCTION nameIR `( parameterIR*{parameterIR <- parameterIR*} `) ':' typeIR as callableTypeIR

  clause 3 : (EXTERN_METHOD nameIR `< _typeParameterIR*{_typeParameterIR <- _typeParameterIR*} ',' _typeParameterIR'*{_typeParameterIR' <- _typeParameterIR'*} `> `( parameterIR*{parameterIR <- parameterIR*} `) ':' typeIR as callableTypeDefIR) = EXTERN_METHOD nameIR `( parameterIR*{parameterIR <- parameterIR*} `) ':' typeIR as callableTypeIR

  clause 4 : (EXTERN_METHOD ABSTRACT nameIR `< _typeParameterIR*{_typeParameterIR <- _typeParameterIR*} ',' _typeParameterIR'*{_typeParameterIR' <- _typeParameterIR'*} `> `( parameterIR*{parameterIR <- parameterIR*} `) ':' typeIR as callableTypeDefIR) = EXTERN_METHOD ABSTRACT nameIR `( parameterIR*{parameterIR <- parameterIR*} `) ':' typeIR as callableTypeIR

  clause 5 : (parserApplyMethodTypeDefIR as callableTypeDefIR) = parserApplyMethodTypeDefIR as callableTypeIR

  clause 6 : (controlApplyMethodTypeDefIR as callableTypeDefIR) = controlApplyMethodTypeDefIR as callableTypeIR

def $typeParameterListIR_of_callableTypeDefIR(callableTypeDefIR) : (typeParameterIR*, typeParameterIR*) =

  clause 0 : (actionTypeDefIR as callableTypeDefIR) = ([], [])

  clause 1 : (FUNCTION _nameIR `< typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*} ',' typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*} `> `( _parameterIR*{_parameterIR <- _parameterIR*} `) ':' _typeIR as callableTypeDefIR) = (typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*}, typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*})

  clause 2 : (EXTERN_FUNCTION _nameIR `< typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*} ',' typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*} `> `( _parameterIR*{_parameterIR <- _parameterIR*} `) ':' _typeIR as callableTypeDefIR) = (typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*}, typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*})

  clause 3 : (EXTERN_METHOD _nameIR `< typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*} ',' typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*} `> `( _parameterIR*{_parameterIR <- _parameterIR*} `) ':' _typeIR as callableTypeDefIR) = (typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*}, typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*})

  clause 4 : (EXTERN_METHOD ABSTRACT _nameIR `< typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*} ',' typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*} `> `( _parameterIR*{_parameterIR <- _parameterIR*} `) ':' _typeIR as callableTypeDefIR) = (typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*}, typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*})

  clause 5 : (parserApplyMethodTypeDefIR as callableTypeDefIR) = ([], [])

  clause 6 : (controlApplyMethodTypeDefIR as callableTypeDefIR) = ([], [])

def $parameterListIR_of_callableTypeDefIR(callableTypeDefIR) : parameterIR* =

  clause 0 : (actionTypeDefIR as callableTypeDefIR) = $parameterListIR_of_actionTypeDefIR(actionTypeDefIR)

  clause 1 : (functionTypeDefIR as callableTypeDefIR) = $parameterListIR_of_functionTypeDefIR(functionTypeDefIR)

  clause 2 : (methodTypeDefIR as callableTypeDefIR) = $parameterListIR_of_methodTypeDefIR(methodTypeDefIR)

def $parameterListIR_of_actionTypeDefIR(actionTypeDefIR) : parameterIR* =

  clause 0 : (_annotationList ACTION _nameIR `( parameterIR*{parameterIR <- parameterIR*} `)) = parameterIR*{parameterIR <- parameterIR*}

def $parameterListIR_of_functionTypeDefIR(functionTypeDefIR) : parameterIR* =

  clause 0 : (definedFunctionTypeDefIR as functionTypeDefIR) = $parameterListIR_of_definedFunctionTypeDefIR(definedFunctionTypeDefIR)

  clause 1 : (externFunctionTypeDefIR as functionTypeDefIR) = $parameterListIR_of_externFunctionTypeDefIR(externFunctionTypeDefIR)

def $parameterListIR_of_definedFunctionTypeDefIR(definedFunctionTypeDefIR) : parameterIR* =

  clause 0 : (FUNCTION _nameIR `< _typeParameterIR*{_typeParameterIR <- _typeParameterIR*} ',' _typeParameterIR'*{_typeParameterIR' <- _typeParameterIR'*} `> `( parameterIR*{parameterIR <- parameterIR*} `) ':' _typeIR) = parameterIR*{parameterIR <- parameterIR*}

def $parameterListIR_of_externFunctionTypeDefIR(externFunctionTypeDefIR) : parameterIR* =

  clause 0 : (EXTERN_FUNCTION _nameIR `< _typeParameterIR*{_typeParameterIR <- _typeParameterIR*} ',' _typeParameterIR'*{_typeParameterIR' <- _typeParameterIR'*} `> `( parameterIR*{parameterIR <- parameterIR*} `) ':' _typeIR) = parameterIR*{parameterIR <- parameterIR*}

def $parameterListIR_of_methodTypeDefIR(methodTypeDefIR) : parameterIR* =

  clause 0 : (externMethodTypeDefIR as methodTypeDefIR) = $parameterListIR_of_externMethodTypeDefIR(externMethodTypeDefIR)

  clause 1 : (parserApplyMethodTypeIR as methodTypeDefIR) = $parameterListIR_of_parserApplyMethodTypeIR(parserApplyMethodTypeIR)

  clause 2 : (controlApplyMethodTypeIR as methodTypeDefIR) = $parameterListIR_of_controlApplyMethodTypeIR(controlApplyMethodTypeIR)

  clause 3 : (tableApplyMethodTypeDefIR as methodTypeDefIR) = $parameterListIR_of_tableApplyMethodTypeDefIR(tableApplyMethodTypeDefIR)

def $parameterListIR_of_externMethodTypeDefIR(externMethodTypeDefIR) : parameterIR* =

  clause 0 : (EXTERN_METHOD _nameIR `< _typeParameterIR*{_typeParameterIR <- _typeParameterIR*} ',' _typeParameterIR'*{_typeParameterIR' <- _typeParameterIR'*} `> `( parameterIR*{parameterIR <- parameterIR*} `) ':' _typeIR) = parameterIR*{parameterIR <- parameterIR*}

  clause 1 : (EXTERN_METHOD ABSTRACT _nameIR `< _typeParameterIR*{_typeParameterIR <- _typeParameterIR*} ',' _typeParameterIR'*{_typeParameterIR' <- _typeParameterIR'*} `> `( parameterIR*{parameterIR <- parameterIR*} `) ':' _typeIR) = parameterIR*{parameterIR <- parameterIR*}

def $parameterListIR_of_parserApplyMethodTypeIR(parserApplyMethodTypeIR) : parameterIR* =

  clause 0 : (PARSER_APPLY `( parameterIR*{parameterIR <- parameterIR*} `)) = parameterIR*{parameterIR <- parameterIR*}

def $parameterListIR_of_controlApplyMethodTypeIR(controlApplyMethodTypeIR) : parameterIR* =

  clause 0 : (CONTROL_APPLY `( parameterIR*{parameterIR <- parameterIR*} `)) = parameterIR*{parameterIR <- parameterIR*}

def $parameterListIR_of_tableApplyMethodTypeDefIR(tableApplyMethodTypeDefIR) : parameterIR* =

  clause 0 : (tableApplyMethodTypeIR) = []

syntax constructorParameterIR = parameterIR

syntax constructorTypeIR = 
   | CONSTRUCTOR `( constructorParameterIR* `) ':' typeIR (from constructorTypeIR) 

syntax constructorTypeDefIR = 
   | CONSTRUCTOR `< typeParameterIR* ',' typeParameterIR* `> `( constructorParameterIR* `) ':' typeIR (from constructorTypeDefIR) 

def $parameterListIR_of_constructorTypeDefIR(constructorTypeDefIR) : parameterIR* =

  clause 0 : (CONSTRUCTOR `< _typeParameterIR*{_typeParameterIR <- _typeParameterIR*} ',' _typeParameterIR'*{_typeParameterIR' <- _typeParameterIR'*} `> `( constructorParameterIR*{constructorParameterIR <- constructorParameterIR*} `) ':' _typeIR) = constructorParameterIR*{constructorParameterIR <- constructorParameterIR*}

syntax bound = set<typeId>

var B : bound

def $free_typeIR(typeIR) : bound =

  clause 0 : (baseTypeIR as typeIR) = `{ [] `}

  clause 1 : (_NAME typeId as typeIR) = `{ [typeId] `}

  clause 2 : (TYPEDEF _typeId typeIR as typeIR) = $free_typeIR(typeIR)

  clause 3 : (TYPE _typeId typeIR as typeIR) = $free_typeIR(typeIR)

  clause 4 : (LIST `< typeIR `> as typeIR) = $free_typeIR(typeIR)

  clause 5 : (TUPLE `< typeIR*{typeIR <- typeIR*} `> as typeIR) = $unions_set<typeId>($free_typeIR(typeIR)*{typeIR <- typeIR*})

  clause 6 : (ARRAY typeIR `[ _nat `] as typeIR) = $free_typeIR(typeIR)

  clause 7 : (HEADER_STACK typeIR `[ _nat `] as typeIR) = $free_typeIR(typeIR)

  clause 8 : (STRUCT _typeId `< typeArgumentIR*{typeArgumentIR <- typeArgumentIR*} `> `{ _annotationList typeIR_field _nameIR ';'*{_annotationList <- _annotationList*, _nameIR <- _nameIR*, typeIR_field <- typeIR_field*} `} as typeIR) = $union_set<typeId>($unions_set<typeId>($free_typeIR(typeArgumentIR)*{typeArgumentIR <- typeArgumentIR*}), $unions_set<typeId>($free_typeIR(typeIR_field)*{typeIR_field <- typeIR_field*}))

  clause 9 : (HEADER _typeId `< typeArgumentIR*{typeArgumentIR <- typeArgumentIR*} `> `{ _annotationList typeIR_field _nameIR ';'*{_annotationList <- _annotationList*, _nameIR <- _nameIR*, typeIR_field <- typeIR_field*} `} as typeIR) = $union_set<typeId>($unions_set<typeId>($free_typeIR(typeArgumentIR)*{typeArgumentIR <- typeArgumentIR*}), $unions_set<typeId>($free_typeIR(typeIR_field)*{typeIR_field <- typeIR_field*}))

  clause 10 : (HEADER_UNION _typeId `< typeArgumentIR*{typeArgumentIR <- typeArgumentIR*} `> `{ _annotationList typeIR_field _nameIR ';'*{_annotationList <- _annotationList*, _nameIR <- _nameIR*, typeIR_field <- typeIR_field*} `} as typeIR) = $union_set<typeId>($unions_set<typeId>($free_typeIR(typeArgumentIR)*{typeArgumentIR <- typeArgumentIR*}), $unions_set<typeId>($free_typeIR(typeIR_field)*{typeIR_field <- typeIR_field*}))

  clause 11 : (ENUM _typeId `{ _nameIR*{_nameIR <- _nameIR*} `} as typeIR) = `{ [] `}

  clause 12 : (ENUM _typeId `< typeIR `> `{ _valueFieldIR*{_valueFieldIR <- _valueFieldIR*} `} as typeIR) = $free_typeIR(typeIR)

  clause 13 : (EXTERN _typeId `< typeArgumentIR*{typeArgumentIR <- typeArgumentIR*} `> `{ _callableId ':' externMethodTypeDefIR*{_callableId <- _callableId*, externMethodTypeDefIR <- externMethodTypeDefIR*} `} as typeIR) = $union_set<typeId>($unions_set<typeId>($free_typeIR(typeArgumentIR)*{typeArgumentIR <- typeArgumentIR*}), $unions_set<typeId>($free_callableTypeDefIR(externMethodTypeDefIR as callableTypeDefIR)*{externMethodTypeDefIR <- externMethodTypeDefIR*}))

  clause 14 : (PARSER _typeId `< typeArgumentIR*{typeArgumentIR <- typeArgumentIR*} `> `( parameterIR*{parameterIR <- parameterIR*} `) as typeIR) = $union_set<typeId>($unions_set<typeId>($free_typeIR(typeArgumentIR)*{typeArgumentIR <- typeArgumentIR*}), $unions_set<typeId>($free_parameterIR(parameterIR)*{parameterIR <- parameterIR*}))

  clause 15 : (CONTROL _typeId `< typeArgumentIR*{typeArgumentIR <- typeArgumentIR*} `> `( parameterIR*{parameterIR <- parameterIR*} `) as typeIR) = $union_set<typeId>($unions_set<typeId>($free_typeIR(typeArgumentIR)*{typeArgumentIR <- typeArgumentIR*}), $unions_set<typeId>($free_parameterIR(parameterIR)*{parameterIR <- parameterIR*}))

  clause 16 : (PACKAGE _typeId `< typeArgumentIR*{typeArgumentIR <- typeArgumentIR*} `> `{ typeIR*{typeIR <- typeIR*} `} as typeIR) = $union_set<typeId>($unions_set<typeId>($free_typeIR(typeArgumentIR)*{typeArgumentIR <- typeArgumentIR*}), $unions_set<typeId>($free_typeIR(typeIR)*{typeIR <- typeIR*}))

  clause 17 : (TABLE _typeId `{ _tableMetadataStructTypeIR `} as typeIR) = `{ [] `}

  clause 18 : (DEFAULT as typeIR) = `{ [] `}

  clause 19 : (HEADER_INVALID as typeIR) = `{ [] `}

  clause 20 : (SEQ `< typeIR*{typeIR <- typeIR*} `> as typeIR) = $unions_set<typeId>($free_typeIR(typeIR)*{typeIR <- typeIR*})

  clause 21 : (SEQ `< typeIR*{typeIR <- typeIR*} ',' '...' `> as typeIR) = $unions_set<typeId>($free_typeIR(typeIR)*{typeIR <- typeIR*})

  clause 22 : (RECORD `{ _annotationList typeIR _nameIR ';'*{_annotationList <- _annotationList*, _nameIR <- _nameIR*, typeIR <- typeIR*} `} as typeIR) = $unions_set<typeId>($free_typeIR(typeIR)*{typeIR <- typeIR*})

  clause 23 : (RECORD `{ _annotationList typeIR _nameIR ';'*{_annotationList <- _annotationList*, _nameIR <- _nameIR*, typeIR <- typeIR*} ',' '...' `} as typeIR) = $unions_set<typeId>($free_typeIR(typeIR)*{typeIR <- typeIR*})

  clause 24 : (SET `< typeIR `> as typeIR) = $free_typeIR(typeIR)

  clause 25 : (tableMetadataTypeIR as typeIR) = `{ [] `}

def $free_typeDefIR(typeDefIR) : bound =

  clause 0 : (typeDefIR) = $diff_set<typeId>(B_base, B_tparams)
  -- if ((typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*}, typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*}) = $typeParameterListIR_of_typeDefIR(typeDefIR))
  -- if (B_tparams = `{ typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*} ++ typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*} `})
  -- if (typeIR = $typeIR_of_typeDefIR(typeDefIR))
  -- if (B_base = $free_typeIR(typeIR))

def $free_parameterIR(parameterIR) : bound =

  clause 0 : (_annotationList _direction typeIR _id _parameterInitializerOptIR) = $free_typeIR(typeIR)

def $free_parameterIRs(parameterIR*) : bound =

  clause 0 : (parameterIR*{parameterIR <- parameterIR*}) = $unions_set<typeId>($free_parameterIR(parameterIR)*{parameterIR <- parameterIR*})

def $free_callableTypeIR(callableTypeIR) : bound =

  clause 0 : (_annotationList ACTION _nameIR `( parameterIR*{parameterIR <- parameterIR*} `) as callableTypeIR) = B_params
  -- if (B_params = $unions_set<typeId>($free_parameterIR(parameterIR)*{parameterIR <- parameterIR*}))

  clause 1 : (FUNCTION _nameIR `( parameterIR*{parameterIR <- parameterIR*} `) ':' typeIR as callableTypeIR) = $union_set<typeId>(B_params, B_ret)
  -- if (B_params = $unions_set<typeId>($free_parameterIR(parameterIR)*{parameterIR <- parameterIR*}))
  -- if (B_ret = $free_typeIR(typeIR))

  clause 2 : (EXTERN_FUNCTION _nameIR `( parameterIR*{parameterIR <- parameterIR*} `) ':' typeIR as callableTypeIR) = $union_set<typeId>(B_params, B_ret)
  -- if (B_params = $unions_set<typeId>($free_parameterIR(parameterIR)*{parameterIR <- parameterIR*}))
  -- if (B_ret = $free_typeIR(typeIR))

  clause 3 : (builtinMethodTypeIR as callableTypeIR) = `{ [] `}

  clause 4 : (EXTERN_METHOD _nameIR `( parameterIR*{parameterIR <- parameterIR*} `) ':' typeIR as callableTypeIR) = $union_set<typeId>(B_params, B_ret)
  -- if (B_params = $unions_set<typeId>($free_parameterIR(parameterIR)*{parameterIR <- parameterIR*}))
  -- if (B_ret = $free_typeIR(typeIR))

  clause 5 : (EXTERN_METHOD ABSTRACT _nameIR `( parameterIR*{parameterIR <- parameterIR*} `) ':' typeIR as callableTypeIR) = $union_set<typeId>(B_params, B_ret)
  -- if (B_params = $unions_set<typeId>($free_parameterIR(parameterIR)*{parameterIR <- parameterIR*}))
  -- if (B_ret = $free_typeIR(typeIR))

  clause 6 : (PARSER_APPLY `( parameterIR*{parameterIR <- parameterIR*} `) as callableTypeIR) = B_params
  -- if (B_params = $unions_set<typeId>($free_parameterIR(parameterIR)*{parameterIR <- parameterIR*}))

  clause 7 : (CONTROL_APPLY `( parameterIR*{parameterIR <- parameterIR*} `) as callableTypeIR) = B_params
  -- if (B_params = $unions_set<typeId>($free_parameterIR(parameterIR)*{parameterIR <- parameterIR*}))

  clause 8 : (TABLE_APPLY ':' _tableMetadataStructTypeIR as callableTypeIR) = `{ [] `}

def $free_callableTypeDefIR(callableTypeDefIR) : bound =

  clause 0 : (callableTypeDefIR) = $diff_set<typeId>(B_base, B_tparams)
  -- if ((typeId_tparam_expl*{typeId_tparam_expl <- typeId_tparam_expl*}, typeId_tparam_impl*{typeId_tparam_impl <- typeId_tparam_impl*}) = $typeParameterListIR_of_callableTypeDefIR(callableTypeDefIR))
  -- if (B_tparams = `{ typeId_tparam_expl*{typeId_tparam_expl <- typeId_tparam_expl*} ++ typeId_tparam_impl*{typeId_tparam_impl <- typeId_tparam_impl*} `})
  -- if (callableTypeIR = $callableTypeIR_of_callableTypeDefIR(callableTypeDefIR))
  -- if (B_base = $free_callableTypeIR(callableTypeIR))

syntax theta = map<typeId, typeIR>

def $empty_theta : theta =

  clause 0 :  = $empty_map<typeId, typeIR>

def $capture_avoiding_(theta, typeParameterIR*, bound) : (theta, typeParameterIR*) =

  clause 0 : (theta, typeParameterIR*{typeParameterIR <- typeParameterIR*}, B) = (theta_fresh, typeParameterIR_fresh*{typeParameterIR_fresh <- typeParameterIR_fresh*})
  -- if (`{ typeId_free*{typeId_free <- typeId_free*} `} = $diff_set<typeId>(B, `{ typeParameterIR*{typeParameterIR <- typeParameterIR*} `}))
  -- (if (?(typeIR_free) = $find_map<typeId, typeIR>(theta, typeId_free)))*{typeIR_free <- typeIR_free*, typeId_free <- typeId_free*}
  -- if (B_capture = $unions_set<typeId>($free_typeIR(typeIR_free)*{typeIR_free <- typeIR_free*}))
  -- if (typeParameterIR_fresh*{typeParameterIR_fresh <- typeParameterIR_fresh*} = $fresh_typeIds(|typeParameterIR*{typeParameterIR <- typeParameterIR*}|))
  -- (if ~$in_set<typeId>(typeParameterIR_fresh, B_capture))*{typeParameterIR_fresh <- typeParameterIR_fresh*}
  -- if (theta_fresh = $adds_map<typeId, typeIR>(theta, typeParameterIR*{typeParameterIR <- typeParameterIR*}, _NAME typeParameterIR_fresh as typeIR*{typeParameterIR_fresh <- typeParameterIR_fresh*}))

def $capture_avoiding(theta, typeId*, typeId*, bound) : (theta, typeId*, typeId*) =

  clause 0 : (theta, typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*}, typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*}, B) = (theta_fresh, typeParameterIR_expl_fresh*{typeParameterIR_expl_fresh <- typeParameterIR_expl_fresh*}, typeParameterIR_impl_fresh*{typeParameterIR_impl_fresh <- typeParameterIR_impl_fresh*})
  -- if (`{ typeId_free*{typeId_free <- typeId_free*} `} = $diff_set<typeId>(B, `{ typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*} ++ typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*} `}))
  -- (if (?(typeIR_free) = $find_map<typeId, typeIR>(theta, typeId_free)))*{typeIR_free <- typeIR_free*, typeId_free <- typeId_free*}
  -- if (B_capture = $unions_set<typeId>($free_typeIR(typeIR_free)*{typeIR_free <- typeIR_free*}))
  -- if (typeId_fresh*{typeId_fresh <- typeId_fresh*} = $fresh_typeIds(|typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*} ++ typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*}|))
  -- (if ~$in_set<typeId>(typeId_fresh, B_capture))*{typeId_fresh <- typeId_fresh*}
  -- if (typeParameterIR_expl_fresh*{typeParameterIR_expl_fresh <- typeParameterIR_expl_fresh*} = typeId_fresh*{typeId_fresh <- typeId_fresh*}[0 : |typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*}|])
  -- if (typeParameterIR_impl_fresh*{typeParameterIR_impl_fresh <- typeParameterIR_impl_fresh*} = typeId_fresh*{typeId_fresh <- typeId_fresh*}[|typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*}| : |typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*}|])
  -- if (theta_fresh = $adds_map<typeId, typeIR>(theta, typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*} ++ typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*}, _NAME typeParameterIR_expl_fresh as typeIR*{typeParameterIR_expl_fresh <- typeParameterIR_expl_fresh*} ++ _NAME typeParameterIR_impl_fresh as typeIR*{typeParameterIR_impl_fresh <- typeParameterIR_impl_fresh*}))

def $subst_typeIR(theta, typeIR) : typeIR =

  clause 0 : (`{ [] `}, typeIR) = typeIR

  clause -1 : (theta, typeIR) = $subst_typeIR'(theta, typeIR)

def $subst_typeIR'(theta, typeIR) : typeIR =

  clause 0 : (theta, baseTypeIR as typeIR) = baseTypeIR as typeIR

  clause 1 : (theta, _NAME typeId as typeIR) = typeIR
  -- if (?(typeIR) = $find_map<typeId, typeIR>(theta, typeId))

  clause 2 : (theta, _NAME typeId as typeIR) = _NAME typeId as typeIR
  -- if (?() = $find_map<typeId, typeIR>(theta, typeId))

  clause 3 : (theta, TYPEDEF typeId typeIR as typeIR) = TYPEDEF typeId typeIR_subst as typeIR
  -- if (typeIR_subst = $subst_typeIR'(theta, typeIR))

  clause 4 : (theta, TYPE typeId typeIR as typeIR) = TYPE typeId typeIR_subst as typeIR
  -- if (typeIR_subst = $subst_typeIR'(theta, typeIR))

  clause 5 : (theta, LIST `< typeIR `> as typeIR) = LIST `< typeIR_subst `> as typeIR
  -- if (typeIR_subst = $subst_typeIR'(theta, typeIR))

  clause 6 : (theta, TUPLE `< typeIR*{typeIR <- typeIR*} `> as typeIR) = TUPLE `< typeIR_subst*{typeIR_subst <- typeIR_subst*} `> as typeIR
  -- (if (typeIR_subst = $subst_typeIR'(theta, typeIR)))*{typeIR <- typeIR*, typeIR_subst <- typeIR_subst*}

  clause 7 : (theta, ARRAY typeIR `[ n_size `] as typeIR) = ARRAY typeIR_subst `[ n_size `] as typeIR
  -- if (typeIR_subst = $subst_typeIR'(theta, typeIR))

  clause 8 : (theta, HEADER_STACK typeIR `[ n_size `] as typeIR) = HEADER_STACK typeIR_subst `[ n_size `] as typeIR
  -- if (typeIR_subst = $subst_typeIR'(theta, typeIR))

  clause 9 : (theta, structTypeIR as typeIR) = structTypeIR_subst as typeIR
  -- if (STRUCT typeId `< typeArgumentIR*{typeArgumentIR <- typeArgumentIR*} `> `{ annotationList typeIR_field nameIR_field ';'*{annotationList <- annotationList*, nameIR_field <- nameIR_field*, typeIR_field <- typeIR_field*} `} = structTypeIR)
  -- (if (typeArgumentIR_subst = $subst_typeIR'(theta, typeArgumentIR)))*{typeArgumentIR <- typeArgumentIR*, typeArgumentIR_subst <- typeArgumentIR_subst*}
  -- (if (typeIR_field_subst = $subst_typeIR'(theta, typeIR_field)))*{typeIR_field <- typeIR_field*, typeIR_field_subst <- typeIR_field_subst*}
  -- if (structTypeIR_subst = STRUCT typeId `< typeArgumentIR_subst*{typeArgumentIR_subst <- typeArgumentIR_subst*} `> `{ annotationList typeIR_field_subst nameIR_field ';'*{annotationList <- annotationList*, nameIR_field <- nameIR_field*, typeIR_field_subst <- typeIR_field_subst*} `})

  clause 10 : (theta, headerTypeIR as typeIR) = headerTypeIR_subst as typeIR
  -- if (HEADER typeId `< typeArgumentIR*{typeArgumentIR <- typeArgumentIR*} `> `{ annotationList typeIR_field nameIR_field ';'*{annotationList <- annotationList*, nameIR_field <- nameIR_field*, typeIR_field <- typeIR_field*} `} = headerTypeIR)
  -- (if (typeArgumentIR_subst = $subst_typeIR'(theta, typeArgumentIR)))*{typeArgumentIR <- typeArgumentIR*, typeArgumentIR_subst <- typeArgumentIR_subst*}
  -- (if (typeIR_field_subst = $subst_typeIR'(theta, typeIR_field)))*{typeIR_field <- typeIR_field*, typeIR_field_subst <- typeIR_field_subst*}
  -- if (headerTypeIR_subst = HEADER typeId `< typeArgumentIR_subst*{typeArgumentIR_subst <- typeArgumentIR_subst*} `> `{ annotationList typeIR_field_subst nameIR_field ';'*{annotationList <- annotationList*, nameIR_field <- nameIR_field*, typeIR_field_subst <- typeIR_field_subst*} `})

  clause 11 : (theta, headerUnionTypeIR as typeIR) = headerUnionTypeIR_subst as typeIR
  -- if (HEADER_UNION typeId `< typeArgumentIR*{typeArgumentIR <- typeArgumentIR*} `> `{ annotationList typeIR_field nameIR_field ';'*{annotationList <- annotationList*, nameIR_field <- nameIR_field*, typeIR_field <- typeIR_field*} `} = headerUnionTypeIR)
  -- (if (typeArgumentIR_subst = $subst_typeIR'(theta, typeArgumentIR)))*{typeArgumentIR <- typeArgumentIR*, typeArgumentIR_subst <- typeArgumentIR_subst*}
  -- (if (typeIR_field_subst = $subst_typeIR'(theta, typeIR_field)))*{typeIR_field <- typeIR_field*, typeIR_field_subst <- typeIR_field_subst*}
  -- if (headerUnionTypeIR_subst = HEADER_UNION typeId `< typeArgumentIR_subst*{typeArgumentIR_subst <- typeArgumentIR_subst*} `> `{ annotationList typeIR_field_subst nameIR_field ';'*{annotationList <- annotationList*, nameIR_field <- nameIR_field*, typeIR_field_subst <- typeIR_field_subst*} `})

  clause 12 : (theta, ENUM typeId `{ id_field*{id_field <- id_field*} `} as typeIR) = ENUM typeId `{ id_field*{id_field <- id_field*} `} as typeIR

  clause 13 : (theta, ENUM typeId `< typeIR `> `{ valueFieldIR*{valueFieldIR <- valueFieldIR*} `} as typeIR) = ENUM typeId `< typeIR_subst `> `{ valueFieldIR*{valueFieldIR <- valueFieldIR*} `} as typeIR
  -- if (typeIR_subst = $subst_typeIR'(theta, typeIR))

  clause 14 : (theta, externObjectTypeIR as typeIR) = externObjectTypeIR_subst as typeIR
  -- if (EXTERN typeId `< typeArgumentIR*{typeArgumentIR <- typeArgumentIR*} `> `{ callableId ':' externMethodTypeDefIR*{callableId <- callableId*, externMethodTypeDefIR <- externMethodTypeDefIR*} `} = externObjectTypeIR)
  -- (if (typeArgumentIR_subst = $subst_typeIR'(theta, typeArgumentIR)))*{typeArgumentIR <- typeArgumentIR*, typeArgumentIR_subst <- typeArgumentIR_subst*}
  -- (if (externMethodTypeDefIR_subst as callableTypeDefIR = $subst_callableTypeDefIR(theta, externMethodTypeDefIR as callableTypeDefIR)))*{externMethodTypeDefIR <- externMethodTypeDefIR*, externMethodTypeDefIR_subst <- externMethodTypeDefIR_subst*}
  -- if (externObjectTypeIR_subst = EXTERN typeId `< typeArgumentIR_subst*{typeArgumentIR_subst <- typeArgumentIR_subst*} `> `{ callableId ':' externMethodTypeDefIR_subst*{callableId <- callableId*, externMethodTypeDefIR_subst <- externMethodTypeDefIR_subst*} `})

  clause 15 : (theta, parserObjectTypeIR as typeIR) = parserObjectTypeIR_subst as typeIR
  -- if (PARSER typeId `< typeArgumentIR*{typeArgumentIR <- typeArgumentIR*} `> `( parameterIR*{parameterIR <- parameterIR*} `) = parserObjectTypeIR)
  -- (if (typeArgumentIR_subst = $subst_typeIR'(theta, typeArgumentIR)))*{typeArgumentIR <- typeArgumentIR*, typeArgumentIR_subst <- typeArgumentIR_subst*}
  -- (if (parameterIR_subst = $subst_parameterIR'(theta, parameterIR)))*{parameterIR <- parameterIR*, parameterIR_subst <- parameterIR_subst*}
  -- if (parserObjectTypeIR_subst = PARSER typeId `< typeArgumentIR_subst*{typeArgumentIR_subst <- typeArgumentIR_subst*} `> `( parameterIR_subst*{parameterIR_subst <- parameterIR_subst*} `))

  clause 16 : (theta, controlObjectTypeIR as typeIR) = controlObjectTypeIR_subst as typeIR
  -- if (CONTROL typeId `< typeArgumentIR*{typeArgumentIR <- typeArgumentIR*} `> `( parameterIR*{parameterIR <- parameterIR*} `) = controlObjectTypeIR)
  -- (if (typeArgumentIR_subst = $subst_typeIR'(theta, typeArgumentIR)))*{typeArgumentIR <- typeArgumentIR*, typeArgumentIR_subst <- typeArgumentIR_subst*}
  -- (if (parameterIR_subst = $subst_parameterIR'(theta, parameterIR)))*{parameterIR <- parameterIR*, parameterIR_subst <- parameterIR_subst*}
  -- if (controlObjectTypeIR_subst = CONTROL typeId `< typeArgumentIR_subst*{typeArgumentIR_subst <- typeArgumentIR_subst*} `> `( parameterIR_subst*{parameterIR_subst <- parameterIR_subst*} `))

  clause 17 : (theta, packageObjectTypeIR as typeIR) = packageObjectTypeIR_subst as typeIR
  -- if (PACKAGE typeId `< typeArgumentIR*{typeArgumentIR <- typeArgumentIR*} `> `{ typeIR*{typeIR <- typeIR*} `} = packageObjectTypeIR)
  -- (if (typeArgumentIR_subst = $subst_typeIR'(theta, typeArgumentIR)))*{typeArgumentIR <- typeArgumentIR*, typeArgumentIR_subst <- typeArgumentIR_subst*}
  -- (if (typeIR_subst = $subst_typeIR'(theta, typeIR)))*{typeIR <- typeIR*, typeIR_subst <- typeIR_subst*}
  -- if (packageObjectTypeIR_subst = PACKAGE typeId `< typeArgumentIR_subst*{typeArgumentIR_subst <- typeArgumentIR_subst*} `> `{ typeIR_subst*{typeIR_subst <- typeIR_subst*} `})

  clause 18 : (theta, tableObjectTypeIR as typeIR) = tableObjectTypeIR as typeIR

  clause 19 : (theta, DEFAULT as typeIR) = DEFAULT as typeIR

  clause 20 : (theta, HEADER_INVALID as typeIR) = HEADER_INVALID as typeIR

  clause 21 : (theta, SEQ `< typeIR*{typeIR <- typeIR*} `> as typeIR) = SEQ `< typeIR_subst*{typeIR_subst <- typeIR_subst*} `> as typeIR
  -- (if (typeIR_subst = $subst_typeIR'(theta, typeIR)))*{typeIR <- typeIR*, typeIR_subst <- typeIR_subst*}

  clause 22 : (theta, SEQ `< typeIR*{typeIR <- typeIR*} ',' '...' `> as typeIR) = SEQ `< typeIR_subst*{typeIR_subst <- typeIR_subst*} ',' '...' `> as typeIR
  -- (if (typeIR_subst = $subst_typeIR'(theta, typeIR)))*{typeIR <- typeIR*, typeIR_subst <- typeIR_subst*}

  clause 23 : (theta, RECORD `{ annotationList typeIR_field id_field ';'*{annotationList <- annotationList*, id_field <- id_field*, typeIR_field <- typeIR_field*} `} as typeIR) = RECORD `{ annotationList typeIR_field_subst id_field ';'*{annotationList <- annotationList*, id_field <- id_field*, typeIR_field_subst <- typeIR_field_subst*} `} as typeIR
  -- (if (typeIR_field_subst = $subst_typeIR'(theta, typeIR_field)))*{typeIR_field <- typeIR_field*, typeIR_field_subst <- typeIR_field_subst*}

  clause 24 : (theta, RECORD `{ annotationList typeIR_field id_field ';'*{annotationList <- annotationList*, id_field <- id_field*, typeIR_field <- typeIR_field*} ',' '...' `} as typeIR) = RECORD `{ annotationList typeIR_field_subst id_field ';'*{annotationList <- annotationList*, id_field <- id_field*, typeIR_field_subst <- typeIR_field_subst*} ',' '...' `} as typeIR
  -- (if (typeIR_field_subst = $subst_typeIR'(theta, typeIR_field)))*{typeIR_field <- typeIR_field*, typeIR_field_subst <- typeIR_field_subst*}

  clause 25 : (theta, SET `< typeIR `> as typeIR) = SET `< typeIR_subst `> as typeIR
  -- if (typeIR_subst = $subst_typeIR'(theta, typeIR))

  clause 26 : (theta, tableMetadataTypeIR as typeIR) = tableMetadataTypeIR as typeIR

def $subst_parameterIR(theta, parameterIR) : parameterIR =

  clause 0 : (`{ [] `}, parameterIR) = parameterIR

  clause -1 : (theta, parameterIR) = $subst_parameterIR'(theta, parameterIR)

def $subst_parameterIR'(theta, parameterIR) : parameterIR =

  clause 0 : (theta, annotationList direction typeIR id parameterInitializerOptIR) = annotationList direction typeIR_subst id parameterInitializerOptIR
  -- if (typeIR_subst = $subst_typeIR'(theta, typeIR))

def $subst_callableTypeIR(theta, callableTypeIR) : callableTypeIR =

  clause 0 : (`{ [] `}, callableTypeIR) = callableTypeIR

  clause -1 : (theta, callableTypeIR) = $subst_callableTypeIR'(theta, callableTypeIR)

def $subst_callableTypeIR'(theta, callableTypeIR) : callableTypeIR =

  clause 0 : (theta, annotationList ACTION nameIR `( parameterIR*{parameterIR <- parameterIR*} `) as callableTypeIR) = annotationList ACTION nameIR `( parameterIR_subst*{parameterIR_subst <- parameterIR_subst*} `) as callableTypeIR
  -- (if (parameterIR_subst = $subst_parameterIR'(theta, parameterIR)))*{parameterIR <- parameterIR*, parameterIR_subst <- parameterIR_subst*}

  clause 1 : (theta, FUNCTION nameIR `( parameterIR*{parameterIR <- parameterIR*} `) ':' typeIR as callableTypeIR) = FUNCTION nameIR `( parameterIR_subst*{parameterIR_subst <- parameterIR_subst*} `) ':' typeIR_subst as callableTypeIR
  -- (if (parameterIR_subst = $subst_parameterIR'(theta, parameterIR)))*{parameterIR <- parameterIR*, parameterIR_subst <- parameterIR_subst*}
  -- if (typeIR_subst = $subst_typeIR'(theta, typeIR))

  clause 2 : (theta, EXTERN_FUNCTION nameIR `( parameterIR*{parameterIR <- parameterIR*} `) ':' typeIR as callableTypeIR) = EXTERN_FUNCTION nameIR `( parameterIR_subst*{parameterIR_subst <- parameterIR_subst*} `) ':' typeIR_subst as callableTypeIR
  -- (if (parameterIR_subst = $subst_parameterIR'(theta, parameterIR)))*{parameterIR <- parameterIR*, parameterIR_subst <- parameterIR_subst*}
  -- if (typeIR_subst = $subst_typeIR'(theta, typeIR))

  clause 3 : (theta, builtinMethodTypeIR as callableTypeIR) = builtinMethodTypeIR as callableTypeIR

  clause 4 : (theta, EXTERN_METHOD nameIR `( parameterIR*{parameterIR <- parameterIR*} `) ':' typeIR as callableTypeIR) = EXTERN_METHOD nameIR `( parameterIR_subst*{parameterIR_subst <- parameterIR_subst*} `) ':' typeIR_subst as callableTypeIR
  -- (if (parameterIR_subst = $subst_parameterIR'(theta, parameterIR)))*{parameterIR <- parameterIR*, parameterIR_subst <- parameterIR_subst*}
  -- if (typeIR_subst = $subst_typeIR'(theta, typeIR))

  clause 5 : (theta, EXTERN_METHOD ABSTRACT nameIR `( parameterIR*{parameterIR <- parameterIR*} `) ':' typeIR as callableTypeIR) = EXTERN_METHOD ABSTRACT nameIR `( parameterIR_subst*{parameterIR_subst <- parameterIR_subst*} `) ':' typeIR_subst as callableTypeIR
  -- (if (parameterIR_subst = $subst_parameterIR'(theta, parameterIR)))*{parameterIR <- parameterIR*, parameterIR_subst <- parameterIR_subst*}
  -- if (typeIR_subst = $subst_typeIR'(theta, typeIR))

  clause 6 : (theta, PARSER_APPLY `( parameterIR*{parameterIR <- parameterIR*} `) as callableTypeIR) = PARSER_APPLY `( parameterIR_subst*{parameterIR_subst <- parameterIR_subst*} `) as callableTypeIR
  -- (if (parameterIR_subst = $subst_parameterIR'(theta, parameterIR)))*{parameterIR <- parameterIR*, parameterIR_subst <- parameterIR_subst*}

  clause 7 : (theta, CONTROL_APPLY `( parameterIR*{parameterIR <- parameterIR*} `) as callableTypeIR) = CONTROL_APPLY `( parameterIR_subst*{parameterIR_subst <- parameterIR_subst*} `) as callableTypeIR
  -- (if (parameterIR_subst = $subst_parameterIR'(theta, parameterIR)))*{parameterIR <- parameterIR*, parameterIR_subst <- parameterIR_subst*}

  clause 8 : (theta, tableApplyMethodTypeIR as callableTypeIR) = tableApplyMethodTypeIR as callableTypeIR

def $subst_callableTypeDefIR(theta, callableTypeDefIR) : callableTypeDefIR =

  clause 0 : (`{ [] `}, callableTypeDefIR) = callableTypeDefIR

  clause -1 : (theta, callableTypeDefIR) = $subst_callableTypeDefIR'(theta, callableTypeDefIR)

def $subst_callableTypeDefIR'(theta, callableTypeDefIR) : callableTypeDefIR =

  clause 0 : (theta, actionTypeDefIR as callableTypeDefIR) = actionTypeDefIR_subst as callableTypeDefIR
  -- if (actionTypeDefIR_subst as callableTypeIR = $subst_callableTypeIR'(theta, actionTypeDefIR as callableTypeIR))

  clause 1 : (theta, FUNCTION nameIR `< typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*} ',' typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*} `> `( parameterIR*{parameterIR <- parameterIR*} `) ':' typeIR as callableTypeDefIR) = FUNCTION nameIR `< typeParameterIR_expl_fresh*{typeParameterIR_expl_fresh <- typeParameterIR_expl_fresh*} ',' typeParameterIR_impl_fresh*{typeParameterIR_impl_fresh <- typeParameterIR_impl_fresh*} `> `( parameterIR_subst*{parameterIR_subst <- parameterIR_subst*} `) ':' typeIR_subst as callableTypeDefIR
  -- if (B = $free_callableTypeIR(FUNCTION nameIR `( parameterIR*{parameterIR <- parameterIR*} `) ':' typeIR as callableTypeIR))
  -- if ((theta_fresh, typeParameterIR_expl_fresh*{typeParameterIR_expl_fresh <- typeParameterIR_expl_fresh*}, typeParameterIR_impl_fresh*{typeParameterIR_impl_fresh <- typeParameterIR_impl_fresh*}) = $capture_avoiding(theta, typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*}, typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*}, B))
  -- (if (parameterIR_subst = $subst_parameterIR(theta_fresh, parameterIR)))*{parameterIR <- parameterIR*, parameterIR_subst <- parameterIR_subst*}
  -- if (typeIR_subst = $subst_typeIR(theta_fresh, typeIR))

  clause 2 : (theta, EXTERN_FUNCTION nameIR `< typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*} ',' typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*} `> `( parameterIR*{parameterIR <- parameterIR*} `) ':' typeIR as callableTypeDefIR) = EXTERN_FUNCTION nameIR `< typeParameterIR_expl_fresh*{typeParameterIR_expl_fresh <- typeParameterIR_expl_fresh*} ',' typeParameterIR_impl_fresh*{typeParameterIR_impl_fresh <- typeParameterIR_impl_fresh*} `> `( parameterIR_subst*{parameterIR_subst <- parameterIR_subst*} `) ':' typeIR_subst as callableTypeDefIR
  -- if (B = $free_callableTypeIR(EXTERN_FUNCTION nameIR `( parameterIR*{parameterIR <- parameterIR*} `) ':' typeIR as callableTypeIR))
  -- if ((theta_fresh, typeParameterIR_expl_fresh*{typeParameterIR_expl_fresh <- typeParameterIR_expl_fresh*}, typeParameterIR_impl_fresh*{typeParameterIR_impl_fresh <- typeParameterIR_impl_fresh*}) = $capture_avoiding(theta, typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*}, typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*}, B))
  -- (if (parameterIR_subst = $subst_parameterIR(theta_fresh, parameterIR)))*{parameterIR <- parameterIR*, parameterIR_subst <- parameterIR_subst*}
  -- if (typeIR_subst = $subst_typeIR(theta_fresh, typeIR))

  clause 3 : (theta, EXTERN_METHOD nameIR `< typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*} ',' typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*} `> `( parameterIR*{parameterIR <- parameterIR*} `) ':' typeIR as callableTypeDefIR) = EXTERN_METHOD nameIR `< typeParameterIR_expl_fresh*{typeParameterIR_expl_fresh <- typeParameterIR_expl_fresh*} ',' typeParameterIR_impl_fresh*{typeParameterIR_impl_fresh <- typeParameterIR_impl_fresh*} `> `( parameterIR_subst*{parameterIR_subst <- parameterIR_subst*} `) ':' typeIR_subst as callableTypeDefIR
  -- if (B = $free_callableTypeIR(EXTERN_METHOD nameIR `( parameterIR*{parameterIR <- parameterIR*} `) ':' typeIR as callableTypeIR))
  -- if ((theta_fresh, typeParameterIR_expl_fresh*{typeParameterIR_expl_fresh <- typeParameterIR_expl_fresh*}, typeParameterIR_impl_fresh*{typeParameterIR_impl_fresh <- typeParameterIR_impl_fresh*}) = $capture_avoiding(theta, typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*}, typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*}, B))
  -- (if (parameterIR_subst = $subst_parameterIR(theta_fresh, parameterIR)))*{parameterIR <- parameterIR*, parameterIR_subst <- parameterIR_subst*}
  -- if (typeIR_subst = $subst_typeIR(theta_fresh, typeIR))

  clause 4 : (theta, EXTERN_METHOD ABSTRACT nameIR `< typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*} ',' typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*} `> `( parameterIR*{parameterIR <- parameterIR*} `) ':' typeIR as callableTypeDefIR) = EXTERN_METHOD ABSTRACT nameIR `< typeParameterIR_expl_fresh*{typeParameterIR_expl_fresh <- typeParameterIR_expl_fresh*} ',' typeParameterIR_impl_fresh*{typeParameterIR_impl_fresh <- typeParameterIR_impl_fresh*} `> `( parameterIR_subst*{parameterIR_subst <- parameterIR_subst*} `) ':' typeIR_subst as callableTypeDefIR
  -- if (B = $free_callableTypeIR(EXTERN_METHOD ABSTRACT nameIR `( parameterIR*{parameterIR <- parameterIR*} `) ':' typeIR as callableTypeIR))
  -- if ((theta_fresh, typeParameterIR_expl_fresh*{typeParameterIR_expl_fresh <- typeParameterIR_expl_fresh*}, typeParameterIR_impl_fresh*{typeParameterIR_impl_fresh <- typeParameterIR_impl_fresh*}) = $capture_avoiding(theta, typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*}, typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*}, B))
  -- (if (parameterIR_subst = $subst_parameterIR(theta_fresh, parameterIR)))*{parameterIR <- parameterIR*, parameterIR_subst <- parameterIR_subst*}
  -- if (typeIR_subst = $subst_typeIR(theta_fresh, typeIR))

  clause 5 : (theta, parserApplyMethodTypeDefIR as callableTypeDefIR) = parserApplyMethodTypeDefIR_subst as callableTypeDefIR
  -- if (parserApplyMethodTypeDefIR_subst as callableTypeIR = $subst_callableTypeIR'(theta, parserApplyMethodTypeDefIR as callableTypeIR))

  clause 6 : (theta, controlApplyMethodTypeDefIR as callableTypeDefIR) = controlApplyMethodTypeDefIR_subst as callableTypeDefIR
  -- if (controlApplyMethodTypeDefIR_subst as callableTypeIR = $subst_callableTypeIR'(theta, controlApplyMethodTypeDefIR as callableTypeIR))

def $subst_constructorTypeIR(theta, constructorTypeIR) : constructorTypeIR =

  clause 0 : (`{ [] `}, constructorTypeIR) = constructorTypeIR

  clause -1 : (theta, constructorTypeIR) = $subst_constructorTypeIR'(theta, constructorTypeIR)

def $subst_constructorTypeIR'(theta, constructorTypeIR) : constructorTypeIR =

  clause 0 : (theta, CONSTRUCTOR `( constructorParameterIR*{constructorParameterIR <- constructorParameterIR*} `) ':' typeIR) = CONSTRUCTOR `( constructorParameterIR_subst*{constructorParameterIR_subst <- constructorParameterIR_subst*} `) ':' typeIR_subst
  -- (if (constructorParameterIR_subst = $subst_parameterIR'(theta, constructorParameterIR)))*{constructorParameterIR <- constructorParameterIR*, constructorParameterIR_subst <- constructorParameterIR_subst*}
  -- if (typeIR_subst = $subst_typeIR'(theta, typeIR))

def $specialize_typeDefIR(typeDefIR, typeIR*) : typeIR =

  clause 0 : (typeDefIR_base, typeArgumentIR*{typeArgumentIR <- typeArgumentIR*}) = typeIR_spec
  -- if ((typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*}, typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*}) = $typeParameterListIR_of_typeDefIR(typeDefIR_base))
  -- if (typeParameterIR*{typeParameterIR <- typeParameterIR*} = typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*} ++ typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*})
  -- if (|typeParameterIR*{typeParameterIR <- typeParameterIR*}| = |typeArgumentIR*{typeArgumentIR <- typeArgumentIR*}|)
  -- if (theta = `{ typeParameterIR ':' typeArgumentIR*{typeArgumentIR <- typeArgumentIR*, typeParameterIR <- typeParameterIR*} `})
  -- if (typeIR_base = $typeIR_of_typeDefIR(typeDefIR_base))
  -- if (typeIR_spec = $subst_typeIR(theta, typeIR_base))

def $specialize_callableTypeDefIR(callableTypeDefIR, typeIR*) : (callableTypeIR, typeId*) =

  clause 0 : (callableTypeDefIR_base, typeArgumentIR*{typeArgumentIR <- typeArgumentIR*}) = (callableTypeIR_spec, typeId_fresh*{typeId_fresh <- typeId_fresh*})
  -- if ((typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*}, typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*}) = $typeParameterListIR_of_callableTypeDefIR(callableTypeDefIR_base))
  -- if (typeParameterIR*{typeParameterIR <- typeParameterIR*} = typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*} ++ typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*})
  -- if (|typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*}| = |typeArgumentIR*{typeArgumentIR <- typeArgumentIR*}|)
  -- if (typeId_fresh*{typeId_fresh <- typeId_fresh*} = $fresh_typeIds(|typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*}|))
  -- (if (typeArgumentIR_impl = _NAME typeId_fresh as typeIR))*{typeArgumentIR_impl <- typeArgumentIR_impl*, typeId_fresh <- typeId_fresh*}
  -- if (theta = `{ typeParameterIR_expl ':' typeArgumentIR*{typeArgumentIR <- typeArgumentIR*, typeParameterIR_expl <- typeParameterIR_expl*} ++ typeParameterIR_impl ':' typeArgumentIR_impl*{typeArgumentIR_impl <- typeArgumentIR_impl*, typeParameterIR_impl <- typeParameterIR_impl*} `})
  -- if (callableTypeIR_base = $callableTypeIR_of_callableTypeDefIR(callableTypeDefIR_base))
  -- if (callableTypeIR_spec = $subst_callableTypeIR(theta, callableTypeIR_base))

  clause 1 : (callableTypeDefIR_base, typeArgumentIR*{typeArgumentIR <- typeArgumentIR*}) = (callableTypeIR_spec, typeId_fresh*{typeId_fresh <- typeId_fresh*})
  -- if ((typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*}, typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*}) = $typeParameterListIR_of_callableTypeDefIR(callableTypeDefIR_base))
  -- if (typeParameterIR*{typeParameterIR <- typeParameterIR*} = typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*} ++ typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*})
  -- if ((|typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*}| > 0) /\ (|typeArgumentIR*{typeArgumentIR <- typeArgumentIR*}| = 0))
  -- if (typeId_fresh*{typeId_fresh <- typeId_fresh*} = $fresh_typeIds(|typeParameterIR*{typeParameterIR <- typeParameterIR*}|))
  -- (if (typeArgumentIR_fresh = _NAME typeId_fresh as typeIR))*{typeArgumentIR_fresh <- typeArgumentIR_fresh*, typeId_fresh <- typeId_fresh*}
  -- if (theta = `{ typeParameterIR ':' typeArgumentIR_fresh*{typeArgumentIR_fresh <- typeArgumentIR_fresh*, typeParameterIR <- typeParameterIR*} `})
  -- if (callableTypeIR_base = $callableTypeIR_of_callableTypeDefIR(callableTypeDefIR_base))
  -- if (callableTypeIR_spec = $subst_callableTypeIR(theta, callableTypeIR_base))

def $specialize_constructorTypeDefIR(constructorTypeDefIR, typeIR*) : (constructorTypeIR, typeId*) =

  clause 0 : (CONSTRUCTOR `< typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*} ',' typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*} `> `( constructorParameterIR*{constructorParameterIR <- constructorParameterIR*} `) ':' typeIR, typeArgumentIR*{typeArgumentIR <- typeArgumentIR*}) = (constructorTypeIR_spec, typeId_fresh*{typeId_fresh <- typeId_fresh*})
  -- if (typeParameterIR*{typeParameterIR <- typeParameterIR*} = typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*} ++ typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*})
  -- if (|typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*}| = |typeArgumentIR*{typeArgumentIR <- typeArgumentIR*}|)
  -- if (typeId_fresh*{typeId_fresh <- typeId_fresh*} = $fresh_typeIds(|typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*}|))
  -- (if (typeArgumentIR_impl = _NAME typeId_fresh as typeIR))*{typeArgumentIR_impl <- typeArgumentIR_impl*, typeId_fresh <- typeId_fresh*}
  -- if (theta = `{ typeParameterIR_expl ':' typeArgumentIR*{typeArgumentIR <- typeArgumentIR*, typeParameterIR_expl <- typeParameterIR_expl*} ++ typeParameterIR_impl ':' typeArgumentIR_impl*{typeArgumentIR_impl <- typeArgumentIR_impl*, typeParameterIR_impl <- typeParameterIR_impl*} `})
  -- if (constructorTypeIR_spec = $subst_constructorTypeIR(theta, CONSTRUCTOR `( constructorParameterIR*{constructorParameterIR <- constructorParameterIR*} `) ':' typeIR))

  clause 1 : (CONSTRUCTOR `< typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*} ',' typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*} `> `( constructorParameterIR*{constructorParameterIR <- constructorParameterIR*} `) ':' typeIR, typeArgumentIR*{typeArgumentIR <- typeArgumentIR*}) = (constructorTypeIR_spec, typeId_fresh*{typeId_fresh <- typeId_fresh*})
  -- if (typeParameterIR*{typeParameterIR <- typeParameterIR*} = typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*} ++ typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*})
  -- if ((|typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*}| > 0) /\ (|typeArgumentIR*{typeArgumentIR <- typeArgumentIR*}| = 0))
  -- if (typeId_fresh*{typeId_fresh <- typeId_fresh*} = $fresh_typeIds(|typeParameterIR*{typeParameterIR <- typeParameterIR*}|))
  -- (if (typeArgumentIR_fresh = _NAME typeId_fresh as typeIR))*{typeArgumentIR_fresh <- typeArgumentIR_fresh*, typeId_fresh <- typeId_fresh*}
  -- if (theta = `{ typeParameterIR ':' typeArgumentIR_fresh*{typeArgumentIR_fresh <- typeArgumentIR_fresh*, typeParameterIR <- typeParameterIR*} `})
  -- if (constructorTypeIR_spec = $subst_constructorTypeIR(theta, CONSTRUCTOR `( constructorParameterIR*{constructorParameterIR <- constructorParameterIR*} `) ':' typeIR))

relation Type_alpha: typeIR ~~ typeIR

  rulegroup baseTypeIR

    rule baseTypeIR: baseTypeIR as typeIR ~~ baseTypeIR as typeIR

  rulegroup nameTypeIR

    rule nameTypeIR: _NAME typeId as typeIR ~~ _NAME typeId as typeIR

  rulegroup typedefTypeIR

    rule left: TYPEDEF _typeId typeIR_a as typeIR ~~ typeIR_b
    -- if Type_alpha: typeIR_a ~~ typeIR_b holds

    rule right: typeIR_a ~~ TYPEDEF _typeId typeIR_b as typeIR
    -- if ~typeIR_a <: typedefTypeIR
    -- if Type_alpha: typeIR_a ~~ typeIR_b holds

  rulegroup newTypeIR

    rule newTypeIR: TYPE typeId typeIR_a as typeIR ~~ TYPE typeId typeIR_b as typeIR
    -- if Type_alpha: typeIR_a ~~ typeIR_b holds

  rulegroup listTypeIR

    rule listTypeIR: LIST `< typeIR_a `> as typeIR ~~ LIST `< typeIR_b `> as typeIR
    -- if Type_alpha: typeIR_a ~~ typeIR_b holds

  rulegroup tupleTypeIR

    rule tupleTypeIR: TUPLE `< typeIR_a*{typeIR_a <- typeIR_a*} `> as typeIR ~~ TUPLE `< typeIR_b*{typeIR_b <- typeIR_b*} `> as typeIR
    -- (if Type_alpha: typeIR_a ~~ typeIR_b holds)*{typeIR_a <- typeIR_a*, typeIR_b <- typeIR_b*}

  rulegroup arrayTypeIR

    rule arrayTypeIR: ARRAY typeIR_a `[ n_size `] as typeIR ~~ ARRAY typeIR_b `[ n_size `] as typeIR
    -- if Type_alpha: typeIR_a ~~ typeIR_b holds

  rulegroup headerStackTypeIR

    rule headerStackTypeIR: HEADER_STACK typeIR_a `[ n_size `] as typeIR ~~ HEADER_STACK typeIR_b `[ n_size `] as typeIR
    -- if Type_alpha: typeIR_a ~~ typeIR_b holds

  rulegroup structTypeIR

    rule structTypeIR: STRUCT typeId `< typeArgumentIR_a*{typeArgumentIR_a <- typeArgumentIR_a*} `> `{ _fieldTypeIR*{_fieldTypeIR <- _fieldTypeIR*} `} as typeIR ~~ STRUCT typeId `< typeArgumentIR_b*{typeArgumentIR_b <- typeArgumentIR_b*} `> `{ _fieldTypeIR'*{_fieldTypeIR' <- _fieldTypeIR'*} `} as typeIR
    -- (if Type_alpha: typeArgumentIR_a ~~ typeArgumentIR_b holds)*{typeArgumentIR_a <- typeArgumentIR_a*, typeArgumentIR_b <- typeArgumentIR_b*}

  rulegroup headerTypeIR

    rule headerTypeIR: HEADER typeId `< typeArgumentIR_a*{typeArgumentIR_a <- typeArgumentIR_a*} `> `{ _fieldTypeIR*{_fieldTypeIR <- _fieldTypeIR*} `} as typeIR ~~ HEADER typeId `< typeArgumentIR_b*{typeArgumentIR_b <- typeArgumentIR_b*} `> `{ _fieldTypeIR'*{_fieldTypeIR' <- _fieldTypeIR'*} `} as typeIR
    -- (if Type_alpha: typeArgumentIR_a ~~ typeArgumentIR_b holds)*{typeArgumentIR_a <- typeArgumentIR_a*, typeArgumentIR_b <- typeArgumentIR_b*}

  rulegroup headerUnionTypeIR

    rule headerUnionTypeIR: HEADER_UNION typeId `< typeArgumentIR_a*{typeArgumentIR_a <- typeArgumentIR_a*} `> `{ _fieldTypeIR*{_fieldTypeIR <- _fieldTypeIR*} `} as typeIR ~~ HEADER_UNION typeId `< typeArgumentIR_b*{typeArgumentIR_b <- typeArgumentIR_b*} `> `{ _fieldTypeIR'*{_fieldTypeIR' <- _fieldTypeIR'*} `} as typeIR
    -- (if Type_alpha: typeArgumentIR_a ~~ typeArgumentIR_b holds)*{typeArgumentIR_a <- typeArgumentIR_a*, typeArgumentIR_b <- typeArgumentIR_b*}

  rulegroup enumTypeIR

    rule non-serializable: ENUM typeId `{ nameIR_field*{nameIR_field <- nameIR_field*} `} as typeIR ~~ ENUM typeId `{ nameIR_field*{nameIR_field <- nameIR_field*} `} as typeIR

    rule serializable: ENUM typeId `< typeIR_a `> `{ nameIR_field '=' value_field ';'*{nameIR_field <- nameIR_field*, value_field <- value_field*} `} as typeIR ~~ ENUM typeId `< typeIR_b `> `{ nameIR_field '=' value_field ';'*{nameIR_field <- nameIR_field*, value_field <- value_field*} `} as typeIR
    -- if Type_alpha: typeIR_a ~~ typeIR_b holds

  rulegroup externObjectTypeIR

    rule externObjectTypeIR: EXTERN typeId `< typeArgumentIR_a*{typeArgumentIR_a <- typeArgumentIR_a*} `> _externMethodTypeDefEnv as typeIR ~~ EXTERN typeId `< typeArgumentIR_b*{typeArgumentIR_b <- typeArgumentIR_b*} `> _externMethodTypeDefEnv' as typeIR
    -- (if Type_alpha: typeArgumentIR_a ~~ typeArgumentIR_b holds)*{typeArgumentIR_a <- typeArgumentIR_a*, typeArgumentIR_b <- typeArgumentIR_b*}

  rulegroup parserObjectTypeIR

    rule parserObjectTypeIR: PARSER _typeId `< _typeArgumentIR*{_typeArgumentIR <- _typeArgumentIR*} `> `( parameterIR_a*{parameterIR_a <- parameterIR_a*} `) as typeIR ~~ PARSER _typeId' `< _typeArgumentIR'*{_typeArgumentIR' <- _typeArgumentIR'*} `> `( parameterIR_b*{parameterIR_b <- parameterIR_b*} `) as typeIR
    -- (if ParameterType_alpha: parameterIR_a ~~ parameterIR_b holds)*{parameterIR_a <- parameterIR_a*, parameterIR_b <- parameterIR_b*}

  rulegroup controlObjectTypeIR

    rule controlObjectTypeIR: CONTROL _typeId `< _typeArgumentIR*{_typeArgumentIR <- _typeArgumentIR*} `> `( parameterIR_a*{parameterIR_a <- parameterIR_a*} `) as typeIR ~~ CONTROL _typeId' `< _typeArgumentIR'*{_typeArgumentIR' <- _typeArgumentIR'*} `> `( parameterIR_b*{parameterIR_b <- parameterIR_b*} `) as typeIR
    -- (if ParameterType_alpha: parameterIR_a ~~ parameterIR_b holds)*{parameterIR_a <- parameterIR_a*, parameterIR_b <- parameterIR_b*}

  rulegroup packageObjectTypeIR

    rule packageObjectTypeIR: PACKAGE _typeId `< _typeArgumentIR*{_typeArgumentIR <- _typeArgumentIR*} `> `{ typeIR_a*{typeIR_a <- typeIR_a*} `} as typeIR ~~ PACKAGE _typeId' `< _typeArgumentIR'*{_typeArgumentIR' <- _typeArgumentIR'*} `> `{ typeIR_b*{typeIR_b <- typeIR_b*} `} as typeIR
    -- (if Type_alpha: typeIR_a ~~ typeIR_b holds)*{typeIR_a <- typeIR_a*, typeIR_b <- typeIR_b*}

  rulegroup tableObjectTypeIR

    rule tableObjectTypeIR: tableObjectTypeIR as typeIR ~~ tableObjectTypeIR as typeIR

  rulegroup defaultTypeIR

    rule defaultTypeIR: DEFAULT as typeIR ~~ DEFAULT as typeIR

  rulegroup invalidHeaderTypeIR

    rule invalidHeaderTypeIR: HEADER_INVALID as typeIR ~~ HEADER_INVALID as typeIR

  rulegroup sequenceTypeIR

    rule non-default: SEQ `< typeIR_a*{typeIR_a <- typeIR_a*} `> as typeIR ~~ SEQ `< typeIR_b*{typeIR_b <- typeIR_b*} `> as typeIR
    -- (if Type_alpha: typeIR_a ~~ typeIR_b holds)*{typeIR_a <- typeIR_a*, typeIR_b <- typeIR_b*}

    rule default: SEQ `< typeIR_a*{typeIR_a <- typeIR_a*} ',' '...' `> as typeIR ~~ SEQ `< typeIR_b*{typeIR_b <- typeIR_b*} ',' '...' `> as typeIR
    -- (if Type_alpha: typeIR_a ~~ typeIR_b holds)*{typeIR_a <- typeIR_a*, typeIR_b <- typeIR_b*}

  rulegroup recordTypeIR

    rule non-default: RECORD `{ annotationList typeIR_field_a nameIR_field ';'*{annotationList <- annotationList*, nameIR_field <- nameIR_field*, typeIR_field_a <- typeIR_field_a*} `} as typeIR ~~ RECORD `{ annotationList typeIR_field_b nameIR_field ';'*{annotationList <- annotationList*, nameIR_field <- nameIR_field*, typeIR_field_b <- typeIR_field_b*} `} as typeIR
    -- (if Type_alpha: typeIR_field_a ~~ typeIR_field_b holds)*{typeIR_field_a <- typeIR_field_a*, typeIR_field_b <- typeIR_field_b*}

    rule default: RECORD `{ annotationList typeIR_field_a nameIR_field ';'*{annotationList <- annotationList*, nameIR_field <- nameIR_field*, typeIR_field_a <- typeIR_field_a*} ',' '...' `} as typeIR ~~ RECORD `{ annotationList typeIR_field_b nameIR_field ';'*{annotationList <- annotationList*, nameIR_field <- nameIR_field*, typeIR_field_b <- typeIR_field_b*} ',' '...' `} as typeIR
    -- (if Type_alpha: typeIR_field_a ~~ typeIR_field_b holds)*{typeIR_field_a <- typeIR_field_a*, typeIR_field_b <- typeIR_field_b*}

  rulegroup setTypeIR

    rule setTypeIR: SET `< typeIR_a `> as typeIR ~~ SET `< typeIR_b `> as typeIR
    -- if Type_alpha: typeIR_a ~~ typeIR_b holds

  rulegroup tableMetadataTypeIR

    rule tableMetadataTypeIR: tableMetadataTypeIR as typeIR ~~ tableMetadataTypeIR as typeIR

relation ParameterType_alpha: parameterIR ~~ parameterIR

  rulegroup 

    rule : _annotationList direction typeIR_a _id _parameterInitializerOptIR ~~ _annotationList' direction typeIR_b _id' _parameterInitializerOptIR'
    -- if Type_alpha: typeIR_a ~~ typeIR_b holds

relation ExternMethodType_alpha: externMethodTypeIR ~~ externMethodTypeIR

  rulegroup 

    rule non-abstract: EXTERN_METHOD nameIR `( parameterIR_a*{parameterIR_a <- parameterIR_a*} `) ':' typeIR_a ~~ EXTERN_METHOD nameIR `( parameterIR_b*{parameterIR_b <- parameterIR_b*} `) ':' typeIR_b
    -- (if ParameterType_alpha: parameterIR_a ~~ parameterIR_b holds)*{parameterIR_a <- parameterIR_a*, parameterIR_b <- parameterIR_b*}
    -- if Type_alpha: typeIR_a ~~ typeIR_b holds

    rule abstract: EXTERN_METHOD ABSTRACT nameIR `( parameterIR_a*{parameterIR_a <- parameterIR_a*} `) ':' typeIR_a ~~ EXTERN_METHOD ABSTRACT nameIR `( parameterIR_b*{parameterIR_b <- parameterIR_b*} `) ':' typeIR_b
    -- (if ParameterType_alpha: parameterIR_a ~~ parameterIR_b holds)*{parameterIR_a <- parameterIR_a*, parameterIR_b <- parameterIR_b*}
    -- if Type_alpha: typeIR_a ~~ typeIR_b holds

relation ExternMethodTypeDef_alpha: externMethodTypeDefIR ~~ externMethodTypeDefIR

  rulegroup 

    rule : externMethodTypeDefIR_a ~~ externMethodTypeDefIR_b
    -- if ((typeParameterIR_expl_a*{typeParameterIR_expl_a <- typeParameterIR_expl_a*}, typeParameterIR_impl_a*{typeParameterIR_impl_a <- typeParameterIR_impl_a*}) = $typeParameterListIR_of_callableTypeDefIR(externMethodTypeDefIR_a as callableTypeDefIR))
    -- if ((typeParameterIR_expl_b*{typeParameterIR_expl_b <- typeParameterIR_expl_b*}, typeParameterIR_impl_b*{typeParameterIR_impl_b <- typeParameterIR_impl_b*}) = $typeParameterListIR_of_callableTypeDefIR(externMethodTypeDefIR_b as callableTypeDefIR))
    -- if (|typeParameterIR_expl_a*{typeParameterIR_expl_a <- typeParameterIR_expl_a*}| = |typeParameterIR_expl_b*{typeParameterIR_expl_b <- typeParameterIR_expl_b*}|)
    -- if (|typeParameterIR_impl_a*{typeParameterIR_impl_a <- typeParameterIR_impl_a*}| = |typeParameterIR_impl_b*{typeParameterIR_impl_b <- typeParameterIR_impl_b*}|)
    -- if (typeParameterIR_fresh*{typeParameterIR_fresh <- typeParameterIR_fresh*} = $fresh_typeIds(|typeParameterIR_expl_a*{typeParameterIR_expl_a <- typeParameterIR_expl_a*} ++ typeParameterIR_impl_a*{typeParameterIR_impl_a <- typeParameterIR_impl_a*}|))
    -- if (typeParameterIR_a*{typeParameterIR_a <- typeParameterIR_a*} = typeParameterIR_expl_a*{typeParameterIR_expl_a <- typeParameterIR_expl_a*} ++ typeParameterIR_impl_a*{typeParameterIR_impl_a <- typeParameterIR_impl_a*})
    -- if (theta_a = `{ typeParameterIR_a ':' _NAME typeParameterIR_fresh as typeIR*{typeParameterIR_a <- typeParameterIR_a*, typeParameterIR_fresh <- typeParameterIR_fresh*} `})
    -- if (externMethodTypeIR_a as callableTypeIR = $callableTypeIR_of_callableTypeDefIR(externMethodTypeDefIR_a as callableTypeDefIR))
    -- if (externMethodTypeIR_a_subst as callableTypeIR = $subst_callableTypeIR(theta_a, externMethodTypeIR_a as callableTypeIR))
    -- if (typeParameterIR_b*{typeParameterIR_b <- typeParameterIR_b*} = typeParameterIR_expl_b*{typeParameterIR_expl_b <- typeParameterIR_expl_b*} ++ typeParameterIR_impl_b*{typeParameterIR_impl_b <- typeParameterIR_impl_b*})
    -- if (theta_b = `{ typeParameterIR_b ':' _NAME typeParameterIR_fresh as typeIR*{typeParameterIR_b <- typeParameterIR_b*, typeParameterIR_fresh <- typeParameterIR_fresh*} `})
    -- if (externMethodTypeIR_b as callableTypeIR = $callableTypeIR_of_callableTypeDefIR(externMethodTypeDefIR_b as callableTypeDefIR))
    -- if (externMethodTypeIR_b_subst as callableTypeIR = $subst_callableTypeIR(theta_b, externMethodTypeIR_b as callableTypeIR))
    -- if ExternMethodType_alpha: externMethodTypeIR_a_subst ~~ externMethodTypeIR_b_subst holds

syntax ctk = 
   | LCTK (from ctk) 
   | CTK (from ctk) 
   | DYN (from ctk) 

def $join_ctk(ctk, ctk) : ctk =

  clause 0 : (LCTK, LCTK) = LCTK

  clause 1 : (LCTK, CTK) = CTK

  clause 2 : (CTK, LCTK) = CTK

  clause 3 : (CTK, CTK) = CTK

  clause -1 : (ctk_a, ctk_b) = DYN

def $joins_ctk(ctk*) : ctk =

  clause 0 : ([]) = LCTK

  clause 1 : ([ctk]) = ctk

  clause 2 : (ctk_a :: [ctk_b]) = $join_ctk(ctk_a, ctk_b)

  clause 3 : (ctk_a :: ctk_b :: ctk_c*{ctk_c <- ctk_c*}) = $joins_ctk(ctk_d :: ctk_c*{ctk_c <- ctk_c*})
  -- if (ctk_c*{ctk_c <- ctk_c*} =/= [])
  -- if (ctk_d = $join_ctk(ctk_a, ctk_b))

builtin def $pow2(nat) : int

builtin def $shl(int, int) : int

builtin def $shr(int, int) : int

builtin def $shr_arith(int, int, int) : int

builtin def $bneg(int) : int

builtin def $band(int, int) : int

builtin def $bxor(int, int) : int

builtin def $bor(int, int) : int

builtin def $bitacc(int, int, int) : int

builtin def $bitacc_replace(int, int, int, int) : int

def $un_op(unop, value) : value =

  clause 0 : ('~', value) = $un_bnot(value)

  clause 1 : ('!', value) = $un_lnot(value)

  clause 2 : ('+', value) = $un_plus(value)

  clause 3 : ('-', value) = $un_minus(value)

def $un_bnot(value) : value =

  clause 0 : (w W i as value) = w W i'' as value
  -- if (i' = $bneg(i))
  -- if (i'' = $ite<int>((i' >= 0 as int), i', ($pow2(w) + i')))

  clause 1 : (w S i as value) = w S i'' as value
  -- if (i' = $bneg(i))
  -- if (i'' = $ite<int>((i' >= 0 as int), i', ($pow2(w) + i')))

def $un_lnot(value) : value =

  clause 0 : (_B b as value) = _B ~b as value

def $un_plus(value) : value =

  clause 0 : (D i as value) = D i as value

  clause 1 : (w W i as value) = w W i as value

  clause 2 : (w S i as value) = w S i as value

def $un_minus(value) : value =

  clause 0 : (D i as value) = D -i as value

  clause 1 : (w W i as value) = w W i' as value
  -- if (i' = $int_to_bitstr(w as int, ($pow2(w) - i)))

  clause 2 : (w S i as value) = w S i' as value
  -- if (i' = $int_to_bitstr(w as int, $bitstr_to_int(w as int, -i)))

def $bin_op(binop, value, value) : value =

  clause 0 : ('+', value_l, value_r) = $bin_plus(value_l, value_r)

  clause 1 : ('|+|', value_l, value_r) = $bin_satplus(value_l, value_r)

  clause 2 : ('-', value_l, value_r) = $bin_minus(value_l, value_r)

  clause 3 : ('|-|', value_l, value_r) = $bin_satminus(value_l, value_r)

  clause 4 : ('*', value_l, value_r) = $bin_mul(value_l, value_r)

  clause 5 : ('/', value_l, value_r) = $bin_div(value_l, value_r)

  clause 6 : ('%', value_l, value_r) = $bin_mod(value_l, value_r)

  clause 7 : ('<<', value_l, value_r) = $bin_shl(value_l, value_r)

  clause 8 : ('>>', value_l, value_r) = $bin_shr(value_l, value_r)

  clause 9 : ('<=', value_l, value_r) = _B $bin_le(value_l, value_r) as value

  clause 10 : ('>=', value_l, value_r) = _B $bin_ge(value_l, value_r) as value

  clause 11 : ('<', value_l, value_r) = _B $bin_lt(value_l, value_r) as value

  clause 12 : ('>', value_l, value_r) = _B $bin_gt(value_l, value_r) as value

  clause 13 : ('==', value_l, value_r) = _B $bin_eq(value_l, value_r) as value

  clause 14 : ('!=', value_l, value_r) = _B $bin_ne(value_l, value_r) as value

  clause 15 : ('&', value_l, value_r) = $bin_band(value_l, value_r)

  clause 16 : ('^', value_l, value_r) = $bin_bxor(value_l, value_r)

  clause 17 : ('|', value_l, value_r) = $bin_bor(value_l, value_r)

  clause 18 : ('++', value_l, value_r) = $bin_concat(value_l, value_r)

def $bin_plus(value, value) : value =

  clause 0 : (D i_l as value, D i_r as value) = D (i_l + i_r) as value

  clause 1 : (w W i_l as value, w W i_r as value) = w W i' as value
  -- if (i_l' = $bitstr_to_int(w as int, i_l))
  -- if (i_r' = $bitstr_to_int(w as int, i_r))
  -- if (i' = $int_to_bitstr(w as int, (i_l' + i_r')))

  clause 2 : (w S i_l as value, w S i_r as value) = w S i' as value
  -- if (i_l' = $bitstr_to_int(w as int, i_l))
  -- if (i_r' = $bitstr_to_int(w as int, i_r))
  -- if (i' = $int_to_bitstr(w as int, (i_l' + i_r')))

def $bin_satplus(value, value) : value =

  clause 0 : (w W i_l as value, w W i_r as value) = w W i' as value
  -- if (i = (i_l + i_r))
  -- if (i_max = $pow2(w))
  -- if (i' = $ite<int>((i < i_max), i, (i_max - 1 as int)))

  clause 1 : (w S i_l as value, w S i_r as value) = w S i''' as value
  -- if (i_l' = $bitstr_to_int(w as int, i_l))
  -- if (i_r' = $bitstr_to_int(w as int, i_r))
  -- if (i' = (i_l' + i_r'))
  -- if (i' > 0 as int)
  -- if (w' as int = (w - 1))
  -- if (i_max = $pow2(w'))
  -- if (i'' = $ite<int>((i' < i_max), i', (i_max - 1 as int)))
  -- if (i''' = $int_to_bitstr(w as int, i''))

  clause 2 : (w S i_l as value, w S i_r as value) = w S i''' as value
  -- if (i_l' = $bitstr_to_int(w as int, i_l))
  -- if (i_r' = $bitstr_to_int(w as int, i_r))
  -- if (i' = (i_l' + i_r'))
  -- if (i' <= 0 as int)
  -- if (w' as int = (w - 1))
  -- if (i_min = -$pow2(w'))
  -- if (i'' = $ite<int>((i' >= i_min), i', i_min))
  -- if (i''' = $int_to_bitstr(w as int, i''))

def $bin_minus(value, value) : value =

  clause 0 : (D i_l as value, D i_r as value) = D (i_l - i_r) as value

  clause 1 : (w W i_l as value, w W i_r as value) = w W i' as value
  -- if (i_l' = $bitstr_to_int(w as int, i_l))
  -- if (i_r' = $bitstr_to_int(w as int, i_r))
  -- if (i' = $int_to_bitstr(w as int, (i_l' - i_r')))

  clause 2 : (w S i_l as value, w S i_r as value) = w S i' as value
  -- if (i_l' = $bitstr_to_int(w as int, i_l))
  -- if (i_r' = $bitstr_to_int(w as int, i_r))
  -- if (i' = $int_to_bitstr(w as int, (i_l' - i_r')))

def $bin_satminus(value, value) : value =

  clause 0 : (w W i_l as value, w W i_r as value) = w W i' as value
  -- if (i = (i_l - i_r))
  -- if (i' = $ite<int>((i >= 0 as int), i, 0 as int))

  clause 1 : (w S i_l as value, w S i_r as value) = w S i''' as value
  -- if (i_l' = $bitstr_to_int(w as int, i_l))
  -- if (i_r' = $bitstr_to_int(w as int, i_r))
  -- if (i' = (i_l' - i_r'))
  -- if (i' > 0 as int)
  -- if (w' as int = (w - 1))
  -- if (i_max = $pow2(w'))
  -- if (i'' = $ite<int>((i' < i_max), i', (i_max - 1 as int)))
  -- if (i''' = $int_to_bitstr(w as int, i''))

  clause 2 : (w S i_l as value, w S i_r as value) = w S i''' as value
  -- if (i_l' = $bitstr_to_int(w as int, i_l))
  -- if (i_r' = $bitstr_to_int(w as int, i_r))
  -- if (i' = (i_l' - i_r'))
  -- if (i' <= 0 as int)
  -- if (w' as int = (w - 1))
  -- if (i_min = -$pow2(w'))
  -- if (i'' = $ite<int>((i' >= i_min), i', i_min))
  -- if (i''' = $int_to_bitstr(w as int, i''))

def $bin_mul(value, value) : value =

  clause 0 : (D i_l as value, D i_r as value) = D (i_l * i_r) as value

  clause 1 : (w W i_l as value, w W i_r as value) = w W i' as value
  -- if (i_l' = $bitstr_to_int(w as int, i_l))
  -- if (i_r' = $bitstr_to_int(w as int, i_r))
  -- if (i' = $int_to_bitstr(w as int, (i_l' * i_r')))

  clause 2 : (w S i_l as value, w S i_r as value) = w S i' as value
  -- if (i_l' = $bitstr_to_int(w as int, i_l))
  -- if (i_r' = $bitstr_to_int(w as int, i_r))
  -- if (i' = $int_to_bitstr(w as int, (i_l' * i_r')))

def $bin_div(value, value) : value =

  clause 0 : (D i_l as value, D i_r as value) = D (i_l / i_r) as value

  clause 1 : (w W i_l as value, w W i_r as value) = w W i' as value
  -- if (i_l' = $bitstr_to_int(w as int, i_l))
  -- if (i_r' = $bitstr_to_int(w as int, i_r))
  -- if (i' = $int_to_bitstr(w as int, (i_l' / i_r')))

def $bin_mod(value, value) : value =

  clause 0 : (D i_l as value, D i_r as value) = D (i_l \ i_r) as value

  clause 1 : (w W i_l as value, w W i_r as value) = w W i' as value
  -- if (i_l' = $bitstr_to_int(w as int, i_l))
  -- if (i_r' = $bitstr_to_int(w as int, i_r))
  -- if (i' = $int_to_bitstr(w as int, (i_l' \ i_r')))

def $bin_shl(value, value) : value =

  clause 0 : (D i_l as value, D i_r as value) = D $shl(i_l, i_r) as value

  clause 1 : (D i_l as value, w_r W i_r as value) = D $shl(i_l, i_r) as value

  clause 2 : (D i_l as value, w_r S i_r as value) = D $shl(i_l, i_r') as value
  -- if (i_r' = $bitstr_to_int(w_r as int, i_r))

  clause 3 : (w_l W i_l as value, D i_r as value) = $bin_shl(w_l W i_l as value, w_l W $bitstr_to_int(w_l as int, i_r) as value)

  clause 4 : (w_l W i_l as value, w_r W i_r as value) = w_l W i' as value
  -- if (i' = $int_to_bitstr(w_l as int, $shl(i_l, i_r)))

  clause 5 : (w_l W i_l as value, w_r S i_r as value) = w_l W i' as value
  -- if (i_r' = $bitstr_to_int(w_r as int, i_r))
  -- if (i' = $int_to_bitstr(w_l as int, $shl(i_l, i_r')))

  clause 6 : (w_l S i_l as value, D i_r as value) = $bin_shl(w_l S i_l as value, w_l S $bitstr_to_int(w_l as int, i_r) as value)

  clause 7 : (w_l S i_l as value, w_r W i_r as value) = w_l S i' as value
  -- if (i_l' = $bitstr_to_int(w_l as int, i_l))
  -- if (i' = $int_to_bitstr(w_l as int, $shl(i_l', i_r)))

  clause 8 : (w_l S i_l as value, w_r S i_r as value) = w_l S i' as value
  -- if (i_l' = $bitstr_to_int(w_l as int, i_l))
  -- if (i_r' = $bitstr_to_int(w_r as int, i_r))
  -- if (i' = $int_to_bitstr(w_l as int, $shl(i_l', i_r')))

def $bin_shr(value, value) : value =

  clause 0 : (D i_l as value, D i_r as value) = D $shr(i_l, i_r) as value

  clause 1 : (D i_l as value, w_r W i_r as value) = D $shr(i_l, i_r) as value

  clause 2 : (D i_l as value, w_r S i_r as value) = D $shr(i_l, i_r') as value
  -- if (i_r' = $bitstr_to_int(w_r as int, i_r))

  clause 3 : (w_l W i_l as value, D i_r as value) = $bin_shr(w_l W i_l as value, w_l W $bitstr_to_int(w_l as int, i_r) as value)

  clause 4 : (w_l W i_l as value, w_r W i_r as value) = w_l W i' as value
  -- if (i' = $int_to_bitstr(w_l as int, $shr(i_l, i_r)))

  clause 5 : (w_l W i_l as value, w_r S i_r as value) = w_l W i' as value
  -- if (i_r' = $bitstr_to_int(w_r as int, i_r))
  -- if (i' = $int_to_bitstr(w_l as int, $shr(i_l, i_r')))

  clause 6 : (w_l S i_l as value, D i_r as value) = w_l S i'' as value
  -- if (i_l' = $bitstr_to_int(w_l as int, i_l))
  -- if (i_l' < 0 as int)
  -- if (w_l' as int = (w_l - 1))
  -- if (i' = $shr_arith(i_l, i_r, $pow2(w_l')))
  -- if (i'' = $int_to_bitstr(w_l as int, i'))

  clause 7 : (w_l S i_l as value, D i_r as value) = w_l S i'' as value
  -- if (i_l' = $bitstr_to_int(w_l as int, i_l))
  -- if (i_l' >= 0 as int)
  -- if (i' = $shr(i_l, i_r))
  -- if (i'' = $int_to_bitstr(w_l as int, i'))

  clause 8 : (w_l S i_l as value, w_r W i_r as value) = w_l S i'' as value
  -- if (i_l' = $bitstr_to_int(w_l as int, i_l))
  -- if (i_l' < 0 as int)
  -- if (w_l' as int = (w_l - 1))
  -- if (i' = $shr_arith(i_l, i_r, $pow2(w_l')))
  -- if (i'' = $int_to_bitstr(w_l as int, i'))

  clause 9 : (w_l S i_l as value, w_r W i_r as value) = w_l S i'' as value
  -- if (i_l' = $bitstr_to_int(w_l as int, i_l))
  -- if (i_l' >= 0 as int)
  -- if (i' = $shr(i_l, i_r))
  -- if (i'' = $int_to_bitstr(w_l as int, i'))

  clause 10 : (w_l S i_l as value, w_r S i_r as value) = w_l S i'' as value
  -- if (i_l' = $bitstr_to_int(w_l as int, i_l))
  -- if (i_r' = $bitstr_to_int(w_r as int, i_r))
  -- if (i_l' < 0 as int)
  -- if (w_l' as int = (w_l - 1))
  -- if (i' = $shr_arith(i_l, i_r, $pow2(w_l')))
  -- if (i'' = $int_to_bitstr(w_l as int, i'))

  clause 11 : (w_l S i_l as value, w_r S i_r as value) = w_l S i'' as value
  -- if (i_l' = $bitstr_to_int(w_l as int, i_l))
  -- if (i_r' = $bitstr_to_int(w_r as int, i_r))
  -- if (i_l' >= 0 as int)
  -- if (i' = $shr(i_l, i_r))
  -- if (i'' = $int_to_bitstr(w_l as int, i'))

def $bin_le(value, value) : bool =

  clause 0 : (D i_l as value, D i_r as value) = (i_l <= i_r)

  clause 1 : (w W i_l as value, w W i_r as value) = (i_l <= i_r)

  clause 2 : (w S i_l as value, w S i_r as value) = (i_l' <= i_r')
  -- if (i_l' = $bitstr_to_int(w as int, i_l))
  -- if (i_r' = $bitstr_to_int(w as int, i_r))

def $bin_ge(value, value) : bool =

  clause 0 : (D i_l as value, D i_r as value) = (i_l >= i_r)

  clause 1 : (w W i_l as value, w W i_r as value) = (i_l >= i_r)

  clause 2 : (w S i_l as value, w S i_r as value) = (i_l' >= i_r')
  -- if (i_l' = $bitstr_to_int(w as int, i_l))
  -- if (i_r' = $bitstr_to_int(w as int, i_r))

def $bin_lt(value, value) : bool =

  clause 0 : (D i_l as value, D i_r as value) = (i_l < i_r)

  clause 1 : (w W i_l as value, w W i_r as value) = (i_l < i_r)

  clause 2 : (w S i_l as value, w S i_r as value) = (i_l' < i_r')
  -- if (i_l' = $bitstr_to_int(w as int, i_l))
  -- if (i_r' = $bitstr_to_int(w as int, i_r))

def $bin_gt(value, value) : bool =

  clause 0 : (D i_l as value, D i_r as value) = (i_l > i_r)

  clause 1 : (w W i_l as value, w W i_r as value) = (i_l > i_r)

  clause 2 : (w S i_l as value, w S i_r as value) = (i_l' > i_r')
  -- if (i_l' = $bitstr_to_int(w as int, i_l))
  -- if (i_r' = $bitstr_to_int(w as int, i_r))

def $bin_eq(value, value) : bool =

  clause 0 : (_B b_a as value, _B b_b as value) = (b_a = b_b)

  clause 1 : (ERROR '.' id_a as value, ERROR '.' id_b as value) = (id_a = id_b)

  clause 2 : (MATCH_KIND '.' id_a as value, MATCH_KIND '.' id_b as value) = (id_a = id_b)

  clause 3 : (stringValue_a as value, stringValue_b as value) = (stringValue_a = stringValue_b)

  clause 4 : (D i_a as value, D i_b as value) = (i_a = i_b)

  clause 5 : (w_a W i_a as value, w_b W i_b as value) = ((w_a = w_b) /\ (i_a = i_b))

  clause 6 : (w_a S i_a as value, w_b S i_b as value) = ((w_a = w_b) /\ (i_a = i_b))

  clause 7 : (w_max_a '.' _nat V i_a as value, w_max_b '.' _nat' V i_b as value) = ((w_max_a = w_max_b) /\ (i_a = i_b))

  clause 8 : (LIST `[ value_a*{value_a <- value_a*} `] as value, LIST `[ value_b*{value_b <- value_b*} `] as value) = ((|value_a*{value_a <- value_a*}| = |value_b*{value_b <- value_b*}|) /\ $forall_($bin_eq(value_a, value_b)*{value_a <- value_a*, value_b <- value_b*}))

  clause 9 : (TUPLE `( value_a*{value_a <- value_a*} `) as value, TUPLE `( value_b*{value_b <- value_b*} `) as value) = ((|value_a*{value_a <- value_a*}| = |value_b*{value_b <- value_b*}|) /\ $forall_($bin_eq(value_a, value_b)*{value_a <- value_a*, value_b <- value_b*}))

  clause 10 : (ARRAY `[ value_a*{value_a <- value_a*} `] as value, ARRAY `[ value_b*{value_b <- value_b*} `] as value) = ((|value_a*{value_a <- value_a*}| = |value_b*{value_b <- value_b*}|) /\ $forall_($bin_eq(value_a, value_b)*{value_a <- value_a*, value_b <- value_b*}))

  clause 11 : (HEADER_STACK `[ value_a*{value_a <- value_a*} `( _nat `) `] as value, HEADER_STACK `[ value_b*{value_b <- value_b*} `( _nat' `) `] as value) = ((|value_a*{value_a <- value_a*}| = |value_b*{value_b <- value_b*}|) /\ $forall_($bin_eq(value_a, value_b)*{value_a <- value_a*, value_b <- value_b*}))

  clause 12 : (STRUCT typeId_a `{ fieldValue_a*{fieldValue_a <- fieldValue_a*} `} as value, STRUCT typeId_b `{ fieldValue_b*{fieldValue_b <- fieldValue_b*} `} as value) = ((((typeId_a = typeId_b) /\ (|fieldValue_a*{fieldValue_a <- fieldValue_a*}| = |fieldValue_b*{fieldValue_b <- fieldValue_b*}|)) /\ $forall_($bin_eq(value_field_a, value_field_b)*{value_field_a <- value_field_a*, value_field_b <- value_field_b*})) /\ $forall_((nameIR_field_a = nameIR_field_b)*{nameIR_field_a <- nameIR_field_a*, nameIR_field_b <- nameIR_field_b*}))
  -- (if (value_field_a nameIR_field_a ';' = fieldValue_a))*{fieldValue_a <- fieldValue_a*, nameIR_field_a <- nameIR_field_a*, value_field_a <- value_field_a*}
  -- (if (value_field_b nameIR_field_b ';' = fieldValue_b))*{fieldValue_b <- fieldValue_b*, nameIR_field_b <- nameIR_field_b*, value_field_b <- value_field_b*}

  clause 13 : (HEADER typeId_a `{ _b ';' fieldValue_a*{fieldValue_a <- fieldValue_a*} `} as value, HEADER typeId_b `{ _b' ';' fieldValue_b*{fieldValue_b <- fieldValue_b*} `} as value) = ((((typeId_a = typeId_b) /\ (|fieldValue_a*{fieldValue_a <- fieldValue_a*}| = |fieldValue_b*{fieldValue_b <- fieldValue_b*}|)) /\ $forall_($bin_eq(value_field_a, value_field_b)*{value_field_a <- value_field_a*, value_field_b <- value_field_b*})) /\ $forall_((nameIR_field_a = nameIR_field_b)*{nameIR_field_a <- nameIR_field_a*, nameIR_field_b <- nameIR_field_b*}))
  -- (if (value_field_a nameIR_field_a ';' = fieldValue_a))*{fieldValue_a <- fieldValue_a*, nameIR_field_a <- nameIR_field_a*, value_field_a <- value_field_a*}
  -- (if (value_field_b nameIR_field_b ';' = fieldValue_b))*{fieldValue_b <- fieldValue_b*, nameIR_field_b <- nameIR_field_b*, value_field_b <- value_field_b*}

  clause 14 : (HEADER_UNION typeId_a `{ fieldValue_a*{fieldValue_a <- fieldValue_a*} `} as value, HEADER_UNION typeId_b `{ fieldValue_b*{fieldValue_b <- fieldValue_b*} `} as value) = ((((typeId_a = typeId_b) /\ (|fieldValue_a*{fieldValue_a <- fieldValue_a*}| = |fieldValue_b*{fieldValue_b <- fieldValue_b*}|)) /\ $forall_($bin_eq(value_field_a, value_field_b)*{value_field_a <- value_field_a*, value_field_b <- value_field_b*})) /\ $forall_((nameIR_field_a = nameIR_field_b)*{nameIR_field_a <- nameIR_field_a*, nameIR_field_b <- nameIR_field_b*}))
  -- (if (value_field_a nameIR_field_a ';' = fieldValue_a))*{fieldValue_a <- fieldValue_a*, nameIR_field_a <- nameIR_field_a*, value_field_a <- value_field_a*}
  -- (if (value_field_b nameIR_field_b ';' = fieldValue_b))*{fieldValue_b <- fieldValue_b*, nameIR_field_b <- nameIR_field_b*, value_field_b <- value_field_b*}

  clause 15 : (typeId_a '.' nameIR_field_a as value, typeId_b '.' nameIR_field_b as value) = ((typeId_a = typeId_b) /\ (nameIR_field_a = nameIR_field_b))

  clause 16 : (typeId_a '.' _nameIR '.' value_field_a as value, typeId_b '.' _nameIR' '.' value_field_b as value) = ((typeId_a = typeId_b) /\ $bin_eq(value_field_a, value_field_b))

  clause 17 : ('{#}' as value, '{#}' as value) = true

def $bin_ne(value, value) : bool =

  clause 0 : (value_l, value_r) = ~$bin_eq(value_l, value_r)

def $bin_band(value, value) : value =

  clause 0 : (w W i_l as value, w W i_r as value) = w W i' as value
  -- if (i' = $int_to_bitstr(w as int, $band(i_l, i_r)))

  clause 1 : (w S i_l as value, w S i_r as value) = w S i' as value
  -- if (i_l' = $bitstr_to_int(w as int, i_l))
  -- if (i_r' = $bitstr_to_int(w as int, i_r))
  -- if (i' = $int_to_bitstr(w as int, $band(i_l', i_r')))

def $bin_bxor(value, value) : value =

  clause 0 : (w W i_l as value, w W i_r as value) = w W i' as value
  -- if (i' = $int_to_bitstr(w as int, $bxor(i_l, i_r)))

  clause 1 : (w S i_l as value, w S i_r as value) = w S i' as value
  -- if (i_l' = $bitstr_to_int(w as int, i_l))
  -- if (i_r' = $bitstr_to_int(w as int, i_r))
  -- if (i' = $int_to_bitstr(w as int, $bxor(i_l', i_r')))

def $bin_bor(value, value) : value =

  clause 0 : (w W i_l as value, w W i_r as value) = w W i' as value
  -- if (i' = $int_to_bitstr(w as int, $bor(i_l, i_r)))

  clause 1 : (w S i_l as value, w S i_r as value) = w S i' as value
  -- if (i_l' = $bitstr_to_int(w as int, i_l))
  -- if (i_r' = $bitstr_to_int(w as int, i_r))
  -- if (i' = $int_to_bitstr(w as int, $bor(i_l', i_r')))

def $bin_concat(value, value) : value =

  clause 0 : ('"' t_l '"' as value, '"' t_r '"' as value) = '"' t_l ++ t_r '"' as value

  clause 1 : (w_l W i_l as value, w_r W i_r as value) = w W i'' as value
  -- if (i_l' = $shl(i_l, w_r as int))
  -- if (i_l'' = (i_l' + i_r))
  -- if (w = (w_l + w_r))
  -- if (i'' = $int_to_bitstr(w as int, i_l''))

  clause 2 : (w_l W i_l as value, w_r S i_r as value) = w W i'' as value
  -- if (i_l' = $shl(i_l, w_r as int))
  -- if (i_l'' = (i_l' + i_r))
  -- if (w = (w_l + w_r))
  -- if (i'' = $int_to_bitstr(w as int, i_l''))

  clause 3 : (w_l S i_l as value, w_r W i_r as value) = w S i''' as value
  -- if (i_l' = $bitstr_to_int(w_l as int, i_l))
  -- if (i_l'' = $shl(i_l', w_r as int))
  -- if (i_l''' = (i_l'' + i_r))
  -- if (w = (w_l + w_r))
  -- if (i''' = $int_to_bitstr(w as int, i_l'''))

  clause 4 : (w_l S i_l as value, w_r S i_r as value) = w S i''' as value
  -- if (i_l' = $bitstr_to_int(w_l as int, i_l))
  -- if (i_l'' = $shl(i_l', w_r as int))
  -- if (i_l''' = (i_l'' + i_r))
  -- if (w = (w_l + w_r))
  -- if (i''' = $int_to_bitstr(w as int, i_l'''))

def $cast_op(typeIR, value) : value =

  clause 0 : (typeIR, boolValue as value) = $cast_bool(typeIR_unroll, boolValue)
  -- if (typeIR_unroll = $unroll_typeIR(typeIR))

  clause 1 : (typeIR, integerValue as value) = $cast_int(typeIR_unroll, integerValue)
  -- if (typeIR_unroll = $unroll_typeIR(typeIR))

  clause 2 : (typeIR, errorValue as value) = $cast_error(typeIR_unroll, errorValue)
  -- if (typeIR_unroll = $unroll_typeIR(typeIR))

  clause 3 : (typeIR, stringValue as value) = $cast_string(typeIR_unroll, stringValue)
  -- if (typeIR_unroll = $unroll_typeIR(typeIR))

  clause 4 : (typeIR, listValue as value) = $cast_list(typeIR_unroll, listValue)
  -- if (typeIR_unroll = $unroll_typeIR(typeIR))

  clause 5 : (typeIR, tupleValue as value) = $cast_tuple(typeIR_unroll, tupleValue)
  -- if (typeIR_unroll = $unroll_typeIR(typeIR))

  clause 6 : (typeIR, arrayValue as value) = $cast_array(typeIR_unroll, arrayValue)
  -- if (typeIR_unroll = $unroll_typeIR(typeIR))

  clause 7 : (typeIR, headerStackValue as value) = $cast_header_stack(typeIR_unroll, headerStackValue)
  -- if (typeIR_unroll = $unroll_typeIR(typeIR))

  clause 8 : (typeIR, structValue as value) = $cast_struct(typeIR_unroll, structValue)
  -- if (typeIR_unroll = $unroll_typeIR(typeIR))

  clause 9 : (typeIR, headerValue as value) = $cast_header(typeIR_unroll, headerValue)
  -- if (typeIR_unroll = $unroll_typeIR(typeIR))

  clause 10 : (typeIR, enumValue as value) = $cast_enum(typeIR_unroll, enumValue)
  -- if (typeIR_unroll = $unroll_typeIR(typeIR))

  clause 11 : (typeIR, sequenceValue as value) = $cast_sequence(typeIR_unroll, sequenceValue)
  -- if (typeIR_unroll = $unroll_typeIR(typeIR))

  clause 12 : (typeIR, recordValue as value) = $cast_record(typeIR_unroll, recordValue)
  -- if (typeIR_unroll = $unroll_typeIR(typeIR))

  clause 13 : (typeIR, DEFAULT as value) = $cast_default(typeIR_unroll, DEFAULT)
  -- if (typeIR_unroll = $unroll_typeIR(typeIR))

  clause 14 : (typeIR, invalidHeaderValue as value) = $cast_invalid_header(typeIR_unroll)
  -- if (typeIR_unroll = $unroll_typeIR(typeIR))

  clause 15 : (typeIR, setValue as value) = $cast_set(typeIR_unroll, setValue)
  -- if (typeIR_unroll = $unroll_typeIR(typeIR))

def $default(typeIR) : value =

  clause 0 : (BOOL as typeIR) = _B false as value

  clause 1 : (ERROR as typeIR) = ERROR '.' "NoError" as value

  clause 2 : (STRING as typeIR) = '"' text_empty '"' as value
  -- if (text_empty = "")

  clause 3 : (INT as typeIR) = D 0 as int as value

  clause 4 : (BIT `< w `> as typeIR) = w W 0 as int as value

  clause 5 : (INT `< w `> as typeIR) = w S 0 as int as value

  clause 6 : (VARBIT `< w `> as typeIR) = w '.' 0 V 0 as int as value

  clause 7 : (TYPEDEF _typeId typeIR as typeIR) = $default(typeIR)

  clause 8 : (TYPE _typeId typeIR as typeIR) = $default(typeIR)

  clause 9 : (TUPLE `< typeIR*{typeIR <- typeIR*} `> as typeIR) = TUPLE `( $default(typeIR)*{typeIR <- typeIR*} `) as value

  clause 10 : (ARRAY typeIR `[ n_s `] as typeIR) = ARRAY `[ value*{value <- value*} `] as value
  -- if (value*{value <- value*} = $repeat_<value>($default(typeIR), n_s))

  clause 11 : (HEADER_STACK typeIR `[ n_s `] as typeIR) = HEADER_STACK `[ value*{value <- value*} `( 0 `) `] as value
  -- if (value*{value <- value*} = $repeat_<value>($default(typeIR), n_s))

  clause 12 : (STRUCT typeId `< _typeArgumentIR*{_typeArgumentIR <- _typeArgumentIR*} `> `{ _annotationList typeIR_f id_f ';'*{_annotationList <- _annotationList*, id_f <- id_f*, typeIR_f <- typeIR_f*} `} as typeIR) = STRUCT typeId `{ $default(typeIR_f) id_f ';'*{id_f <- id_f*, typeIR_f <- typeIR_f*} `} as value

  clause 13 : (HEADER typeId `< _typeArgumentIR*{_typeArgumentIR <- _typeArgumentIR*} `> `{ _annotationList typeIR_f id_f ';'*{_annotationList <- _annotationList*, id_f <- id_f*, typeIR_f <- typeIR_f*} `} as typeIR) = HEADER typeId `{ false ';' $default(typeIR_f) id_f ';'*{id_f <- id_f*, typeIR_f <- typeIR_f*} `} as value

  clause 14 : (HEADER_UNION typeId `< _typeArgumentIR*{_typeArgumentIR <- _typeArgumentIR*} `> `{ _annotationList typeIR_f id_f ';'*{_annotationList <- _annotationList*, id_f <- id_f*, typeIR_f <- typeIR_f*} `} as typeIR) = HEADER_UNION typeId `{ $default(typeIR_f) id_f ';'*{id_f <- id_f*, typeIR_f <- typeIR_f*} `} as value

  clause 15 : (ENUM typeId `{ id_f_h :: _id*{_id <- _id*} `} as typeIR) = typeId '.' id_f_h as value

  clause 16 : (ENUM typeId `< typeIR `> `{ nameIR_field '=' value_field ';'*{nameIR_field <- nameIR_field*, value_field <- value_field*} `} as typeIR) = typeId '.' id_zero '.' value_zero as value
  -- if (value_zero = $cast_int(typeIR, D 0 as int as integerValue))
  -- if (?(id_zero) = $assoc_<value, id>(value_zero, (value_field, nameIR_field)*{nameIR_field <- nameIR_field*, value_field <- value_field*}))

  clause 17 : (ENUM typeId `< typeIR `> `{ nameIR_field '=' value_field ';'*{nameIR_field <- nameIR_field*, value_field <- value_field*} `} as typeIR) = typeId '.' id_zero '.' value_zero as value
  -- if (value_zero = $cast_int(typeIR, D 0 as int as integerValue))
  -- if (?() = $assoc_<value, id>(value_zero, (value_field, nameIR_field)*{nameIR_field <- nameIR_field*, value_field <- value_field*}))
  -- if (id_zero = "__UNSPECIFIED")

def $cast_to_enum(enumTypeIR, value) : value =

  clause 0 : (ENUM typeId `< typeIR `> `{ valueFieldIR*{valueFieldIR <- valueFieldIR*} `} as enumTypeIR, value) = $cast_to_enum'(typeId, typeIR, valueFieldIR*{valueFieldIR <- valueFieldIR*}, value)

def $cast_to_enum'(typeId, typeIR, valueFieldIR*, value) : value =

  clause 0 : (typeId, typeIR, [], value_target) = typeId '.' id_unnamed '.' value_idx as value
  -- if (value_idx = $cast_op(typeIR, value_target))
  -- if (id_unnamed = "__UNSPECIFIED")

  clause 1 : (typeId, typeIR, valueFieldIR_h :: valueFieldIR_t*{valueFieldIR_t <- valueFieldIR_t*}, value_target) = typeId '.' nameIR '.' value as value
  -- if (nameIR '=' value ';' = valueFieldIR_h)
  -- if $bin_eq(value, value_target)

  clause 2 : (typeId, typeIR, valueFieldIR_h :: valueFieldIR_t*{valueFieldIR_t <- valueFieldIR_t*}, value_target) = $cast_to_enum'(typeId, typeIR, valueFieldIR_t*{valueFieldIR_t <- valueFieldIR_t*}, value_target)
  -- if (nameIR '=' value ';' = valueFieldIR_h)
  -- if ~$bin_eq(value, value_target)

def $cast_bool(typeIR, boolValue) : value =

  clause 0 : (BOOL as typeIR, _B b) = _B b as value

  clause 1 : (BIT `< w `> as typeIR, _B true) = w W 1 as int as value

  clause 2 : (BIT `< w `> as typeIR, _B false) = w W 0 as int as value

  clause 3 : (TYPE _typeId typeIR as typeIR, boolValue) = $cast_bool(typeIR, boolValue)

  clause 4 : (SET `< typeIR `> as typeIR, boolValue) = SET `{ $cast_bool(typeIR, boolValue) `} as value

def $cast_int(typeIR, integerValue) : value =

  clause 0 : (BOOL as typeIR, D i as integerValue) = _B (i =/= 0 as int) as value

  clause 1 : (BOOL as typeIR, w W i as integerValue) = _B (i =/= 0 as int) as value

  clause 2 : (INT as typeIR, D i as integerValue) = D i as value

  clause 3 : (INT as typeIR, _nat W i as integerValue) = D i as value

  clause 4 : (INT as typeIR, w S i as integerValue) = D $bitstr_to_int(w as int, i) as value

  clause 5 : (BIT `< w_to `> as typeIR, D i as integerValue) = w_to W i_cast as value
  -- if (i_cast = $int_to_bitstr(w_to as int, i))

  clause 6 : (BIT `< w_to `> as typeIR, _nat W i as integerValue) = w_to W i_cast as value
  -- if (i_cast = $int_to_bitstr(w_to as int, i))

  clause 7 : (BIT `< w_to `> as typeIR, w_from S i as integerValue) = w_to W i_cast as value
  -- if (i_from = $bitstr_to_int(w_from as int, i))
  -- if (i_cast = $int_to_bitstr(w_to as int, i_from))

  clause 8 : (INT `< w_to `> as typeIR, D i as integerValue) = w_to S i_cast as value
  -- if (i_cast = $int_to_bitstr(w_to as int, i))

  clause 9 : (INT `< w_to `> as typeIR, _nat W i as integerValue) = w_to S i_cast as value
  -- if (i_cast = $int_to_bitstr(w_to as int, i))

  clause 10 : (INT `< w_to `> as typeIR, w_from S i as integerValue) = w_to S i_cast as value
  -- if (i_from = $bitstr_to_int(w_from as int, i))
  -- if (i_cast = $int_to_bitstr(w_to as int, i_from))

  clause 11 : (VARBIT `< w_max `> as typeIR, w_max '.' w V i) = w_max '.' w V i as value

  clause 12 : (TYPE _typeId typeIR as typeIR, D i as integerValue) = $cast_op(typeIR, D i as value)

  clause 13 : (TYPE _typeId typeIR as typeIR, w W i as integerValue) = $cast_op(typeIR, w W i as value)

  clause 14 : (TYPE _typeId typeIR as typeIR, w S i as integerValue) = $cast_op(typeIR, w S i as value)

  clause 15 : (enumTypeIR as typeIR, w W i as integerValue) = $cast_to_enum(enumTypeIR, w W i as value)

  clause 16 : (enumTypeIR as typeIR, w S i as integerValue) = $cast_to_enum(enumTypeIR, w S i as value)

  clause 17 : (SET `< typeIR `> as typeIR, D i as integerValue) = SET `{ $cast_op(typeIR, D i as value) `} as value

  clause 18 : (SET `< typeIR `> as typeIR, w W i as integerValue) = SET `{ $cast_op(typeIR, w W i as value) `} as value

  clause 19 : (SET `< typeIR `> as typeIR, w S i as integerValue) = SET `{ $cast_op(typeIR, w S i as value) `} as value

def $cast_error(typeIR, errorValue) : value =

