  rulegroup callExpressionIR

    rule static_assert: p TC |- prefixedNameIR as callableTargetIR `< typeArgumentIR*{typeArgumentIR <- typeArgumentIR*} `> `( argumentIR*{argumentIR <- argumentIR*} `) as expressionIR '#' _expressionNoteIR ~> boolValue as value
