syntax blockInstLayer = {type theta, callable callableDefEnv, state stateEnv, frame frame}

syntax localInstLayer = {type theta, frames frame*}

syntax instContext = {path objectId, global globalInstLayer, block blockInstLayer, local localInstLayer}

def $empty_instContext : instContext =

  clause 0 :  = IC
  -- let globalInstLayer = {constructor $empty_constructorDefEnv, type $empty_typeDefEnv, callable $empty_callableDefEnv, frame $empty_frame}
  -- let blockInstLayer = {type $empty_theta, callable $empty_callableDefEnv, state $empty_stateEnv, frame $empty_frame}
  -- let localInstLayer = {type $empty_theta, frames [$empty_frame]}
  -- let IC = {path [], global globalInstLayer, block blockInstLayer, local localInstLayer}

def $enter_i(instContext) : instContext =

  clause 0 : (IC) = IC[local.frames = $empty_frame :: IC.local.frames]

def $exit_i(instContext) : instContext =

  clause 0 : (IC) = IC[local.frames = frame_t*{frame_t <- frame_t*}]
  -- let frame*{frame <- frame*} = IC.local.frames
  -- if frame*{frame <- frame*} matches _ :: _
  -- let frame_h :: frame_t*{frame_t <- frame_t*} = frame*{frame <- frame*}

def $enter_path_i(instContext, id) : instContext =

  clause 0 : (IC, id) = IC[path = IC.path ++ [id]]

def $inherit_i(cursor, instContext) : instContext =

  clause 0 : (cursor, IC) = IC[block = blockInstLayer][local = localInstLayer]
  -- if cursor matches `GLOBAL`
  -- let blockInstLayer = {type $empty_theta, callable $empty_callableDefEnv, state $empty_stateEnv, frame $empty_frame}
  -- let localInstLayer = {type $empty_theta, frames [$empty_frame]}

  clause 1 : (cursor, IC) = IC[local = localInstLayer]
  -- if cursor matches `BLOCK`
  -- let localInstLayer = {type $empty_theta, frames [$empty_frame]}

  clause 2 : (cursor, IC) = IC
  -- if cursor matches `LOCAL`

def $add_var_i(cursor, instContext, id, value) : instContext =

  clause 0 : (cursor, IC, id, value) = IC[global.frame = frame]
  -- if cursor matches `GLOBAL`
  -- if ~$in_set<id>(id, $dom_map<id, value>(IC.global.frame))
  -- let frame = $add_map<id, value>(IC.global.frame, id, value)

  clause 1 : (cursor, IC, id, value) = IC[block.frame = frame]
  -- if cursor matches `BLOCK`
  -- if ~$in_set<id>(id, $dom_map<id, value>(IC.block.frame))
  -- let frame = $add_map<id, value>(IC.block.frame, id, value)

  clause 2 : (cursor, IC, id, value) = IC[local.frames = frame_h' :: frame_t*{frame_t <- frame_t*}]
  -- if cursor matches `LOCAL`
  -- let frame*{frame <- frame*} = IC.local.frames
  -- if frame*{frame <- frame*} matches _ :: _
  -- let frame_h :: frame_t*{frame_t <- frame_t*} = frame*{frame <- frame*}
  -- if ~$in_set<id>(id, $dom_map<id, value>(frame_h))
  -- let frame_h' = $add_map<id, value>(frame_h, id, value)

def $add_vars_i(cursor, instContext, id*, value*) : instContext =

  clause 0 : (p, IC, id*{id <- id*}, value*{value <- value*}) = IC
  -- if id*{id <- id*} matches []
  -- if value*{value <- value*} matches []

  clause 1 : (p, IC, id*{id <- id*}, value*{value <- value*}) = IC''
  -- if id*{id <- id*} matches _ :: _
  -- let id_h :: id_t*{id_t <- id_t*} = id*{id <- id*}
  -- if value*{value <- value*} matches _ :: _
  -- let value_h :: value_t*{value_t <- value_t*} = value*{value <- value*}
  -- let IC' = $add_var_i(p, IC, id_h, value_h)
  -- let IC'' = $add_vars_i(p, IC', id_t*{id_t <- id_t*}, value_t*{value_t <- value_t*})

def $add_typeDef_i(cursor, instContext, typeId, typeDefIR) : instContext =

  clause 0 : (cursor, IC, typeId, typeDefIR) = IC[global.type = typeDefEnv]
  -- if cursor matches `GLOBAL`
  -- let typeDefEnv = $add_map<typeId, typeDefIR>(IC.global.type, typeId, typeDefIR)

def $add_parserState_i(instContext, nameIR, parserStateIR) : instContext =

  clause 0 : (IC, nameIR, parserStateIR) = IC[block.state = stateEnv]
  -- if ~$in_set<nameIR>(nameIR, $dom_map<nameIR, parserStateIR>(IC.block.state))
  -- let stateEnv = $add_map<nameIR, parserStateIR>(IC.block.state, nameIR, parserStateIR)

def $add_type_i(cursor, instContext, typeId, typeIR) : instContext =

  clause 0 : (cursor, IC, typeId, typeIR) = IC[block.type = theta]
  -- if cursor matches `BLOCK`
