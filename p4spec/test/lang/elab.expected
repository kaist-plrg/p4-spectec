    -- if (definedFunctionCallee = FUNCTION nameIR `< typeParameterListIR `> `( parameterListIR '#' id_default*{id_default <- id_default*} `) blockStatementIR)

  rulegroup builtinPushFrontMethodCallee

    rule abort: p EC_0 ARCH_0 |- typedExpressionIR '.' "push_front" `< '_' `> `( argumentListIR `) : EC_1 ARCH_1 abortResult as calleeResult
