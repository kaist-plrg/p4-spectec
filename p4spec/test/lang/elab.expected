def $needs_priority_tableKeysPropertyIR(tableKeysPropertyIR) : bool =

  clause 0 : (key={ tableKeyIR*{tableKeyIR <- tableKeyIR*} }) = $exists_((nameIR_matchKind = "ternary")*{nameIR_matchKind <- nameIR_matchKind*})
