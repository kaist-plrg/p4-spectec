  clause 8 : (ARRAY typeIR `[ n_size `] as typeIR) = ($sizeof_maxSizeInBits'(typeIR) * n_size)

  clause 9 : (HEADER_STACK typeIR `[ n_size `] as typeIR) = ($sizeof_maxSizeInBits'(typeIR) * n_size)

  clause 10 : (STRUCT _typeId `< _typeArgumentIR*{_typeArgumentIR <- _typeArgumentIR*} `> `{ _annotationList typeIR _nameIR ';'*{_annotationList <- _annotationList*, _nameIR <- _nameIR*, typeIR <- typeIR*} `} as typeIR) = $sum_nat($sizeof_maxSizeInBits'(typeIR)*{typeIR <- typeIR*})

  clause 11 : (HEADER _typeId `< _typeArgumentIR*{_typeArgumentIR <- _typeArgumentIR*} `> `{ _annotationList typeIR _nameIR ';'*{_annotationList <- _annotationList*, _nameIR <- _nameIR*, typeIR <- typeIR*} `} as typeIR) = $sum_nat($sizeof_maxSizeInBits'(typeIR)*{typeIR <- typeIR*})

  clause 12 : (HEADER_UNION _typeId `< _typeArgumentIR*{_typeArgumentIR <- _typeArgumentIR*} `> `{ _annotationList typeIR _nameIR ';'*{_annotationList <- _annotationList*, _nameIR <- _nameIR*, typeIR <- typeIR*} `} as typeIR) = $max_nat($sizeof_maxSizeInBits'(typeIR)*{typeIR <- typeIR*})

def $sizeof_maxSizeInBytes(typeIR) : value =

  clause 0 : (typeIR) = D (n_size / 8) as int as value
  -- if (n_size = $sizeof_maxSizeInBits'(typeIR))

syntax prefixedNameIR = 
   | _BARE nameIR (from prefixedNameIR)  hint(print %0)
   | '.' nameIR (from prefixedNameIR) 

def $prefixedNonTypeName(prefixedNonTypeName) : prefixedNameIR =

  clause 0 : (nonTypeName as prefixedNonTypeName) = _BARE $name(nonTypeName as name)

  clause 1 : (_ID '.' nonTypeName) = '.' $name(nonTypeName as name)

def $prefixedTypeName(prefixedTypeName) : prefixedNameIR =

  clause 0 : (typeName as prefixedTypeName) = _BARE $name(typeName as name)

  clause 1 : (_TID '.' typeName) = '.' $name(typeName as name)

def $flatten_prefixedNameIR(prefixedNameIR) : nameIR =

  clause 0 : (_BARE nameIR) = nameIR

  clause 1 : ('.' nameIR) = "." ++ nameIR

syntax nameListIR = nameIR*

syntax typeParameterListIR = typeParameterIR*

syntax parameterListIR = parameterIR*

syntax constructorParameterListIR = parameterIR*

syntax namedValueIR = 
   | nameIR '=' value (from namedValueIR) 

syntax namedValueListIR = namedValueIR*

syntax namedExpressionIR = 
   | nameIR '=' typedExpressionIR (from namedExpressionIR) 

syntax namedExpressionListIR = namedExpressionIR*

syntax literalExpressionIR = literalExpression

syntax referenceExpressionIR = prefixedNameIR

syntax defaultExpressionIR = defaultExpression

syntax unaryExpressionIR = 
   | unop typedExpressionIR (from unaryExpressionIR) 

syntax binaryExpressionIR = 
   | typedExpressionIR binop typedExpressionIR (from binaryExpressionIR) 

syntax ternaryExpressionIR = 
   | typedExpressionIR '?' typedExpressionIR ':' typedExpressionIR (from ternaryExpressionIR) 

syntax castExpressionIR = 
   | `( typeIR `) typedExpressionIR (from castExpressionIR) 

syntax invalidHeaderExpressionIR = invalidHeaderExpression

syntax sequenceExpressionIR = 
   | SEQ `{ typedExpressionListIR `} (from sequenceExpressionIR) 
   | SEQ `{ typedExpressionListIR ',' '...' `} (from sequenceExpressionIR) 

syntax recordExpressionIR = 
   | RECORD `{ namedExpressionListIR `} (from recordExpressionIR) 
   | RECORD `{ namedExpressionListIR ',' '...' `} (from recordExpressionIR) 

syntax dataExpressionIR = 
   | '{#}' (from invalidHeaderExpression) 
   | SEQ `{ typedExpressionListIR `} (from sequenceExpressionIR) 
   | SEQ `{ typedExpressionListIR ',' '...' `} (from sequenceExpressionIR) 
   | RECORD `{ namedExpressionListIR `} (from recordExpressionIR) 
   | RECORD `{ namedExpressionListIR ',' '...' `} (from recordExpressionIR) 

syntax errorAccessExpressionIR = 
   | ERROR '.' nameIR (from errorAccessExpressionIR) 

syntax memberAccessExpressionIR = 
   | memberAccessBaseIR '.' nameIR (from memberAccessExpressionIR) 

syntax indexAccessExpressionIR = 
   | typedExpressionIR `[ typedExpressionIR `] (from indexAccessExpressionIR) 

syntax sliceAccessExpressionIR = 
   | typedExpressionIR `[ typedExpressionIR sliceop typedExpressionIR `] (from sliceAccessExpressionIR) 

syntax accessExpressionIR = 
   | ERROR '.' nameIR (from errorAccessExpressionIR) 
   | memberAccessBaseIR '.' nameIR (from memberAccessExpressionIR) 
   | typedExpressionIR `[ typedExpressionIR `] (from indexAccessExpressionIR) 
   | typedExpressionIR `[ typedExpressionIR sliceop typedExpressionIR `] (from sliceAccessExpressionIR) 

syntax callableTargetIR = 
   | _BARE nameIR (from prefixedNameIR)  hint(print %0)
   | '.' nameIR (from prefixedNameIR) 
   | typedExpressionIR '.' nameIR (from callableTargetIR) 
   | TYPE prefixedNameIR '.' nameIR (from callableTargetIR) 
   | `( callableTargetIR `) (from callableTargetIR) 

syntax constructorTargetIR = 
   | prefixedNameIR `< typeArgumentListIR `> (from constructorTargetIR) 

syntax callExpressionIR = 
   | constructorTargetIR `( argumentListIR `) (from callExpressionIR) 
   | callableTargetIR `< typeArgumentListIR `> `( argumentListIR `) (from callExpressionIR) 

syntax parenthesizedExpressionIR = 
   | `( typedExpressionIR `) (from parenthesizedExpressionIR) 

syntax expressionIR = 
   | TRUE (from booleanLiteral) 
   | FALSE (from booleanLiteral) 
   | D int (from integerLiteral)  hint(print %)
   | nat W int (from integerLiteral)  hint(print %#W#%)
   | nat S int (from integerLiteral)  hint(print %#S#%)
   | '"' text '"' (from stringLiteral)  hint(print '"'#%#'"')
   | _BARE nameIR (from prefixedNameIR)  hint(print %0)
   | '.' nameIR (from prefixedNameIR) 
   | '...' (from defaultExpression) 
   | unop typedExpressionIR (from unaryExpressionIR) 
   | typedExpressionIR binop typedExpressionIR (from binaryExpressionIR) 
   | typedExpressionIR '?' typedExpressionIR ':' typedExpressionIR (from ternaryExpressionIR) 
   | `( typeIR `) typedExpressionIR (from castExpressionIR) 
   | '{#}' (from invalidHeaderExpression) 
   | SEQ `{ typedExpressionListIR `} (from sequenceExpressionIR) 
   | SEQ `{ typedExpressionListIR ',' '...' `} (from sequenceExpressionIR) 
   | RECORD `{ namedExpressionListIR `} (from recordExpressionIR) 
   | RECORD `{ namedExpressionListIR ',' '...' `} (from recordExpressionIR) 
   | ERROR '.' nameIR (from errorAccessExpressionIR) 
   | memberAccessBaseIR '.' nameIR (from memberAccessExpressionIR) 
   | typedExpressionIR `[ typedExpressionIR `] (from indexAccessExpressionIR) 
   | typedExpressionIR `[ typedExpressionIR sliceop typedExpressionIR `] (from sliceAccessExpressionIR) 
   | constructorTargetIR `( argumentListIR `) (from callExpressionIR) 
   | callableTargetIR `< typeArgumentListIR `> `( argumentListIR `) (from callExpressionIR) 
   | `( typedExpressionIR `) (from parenthesizedExpressionIR) 

syntax expressionNoteIR = 
   | `( typeIR ctk `) (from expressionNoteIR)  hint(prose "a pair of type" %0 "and compile-time known-ness" %1) hint(prose_fields "type" "compile-time known-ness")

syntax typedExpressionIR = 
   | expressionIR '#' expressionNoteIR (from typedExpressionIR)  hint(print %0) hint(prose %0 "annotated with" %1) hint(prose_fields "expression" "note")

syntax typedExpressionListIR = typedExpressionIR*

syntax memberAccessBaseIR = 
   | TYPE prefixedNameIR (from memberAccessBaseIR) 
   | expressionIR '#' expressionNoteIR (from typedExpressionIR)  hint(print %0) hint(prose %0 "annotated with" %1) hint(prose_fields "expression" "note")

def $type_of_typedExpressionIR(typedExpressionIR) : typeIR =

  clause 0 : (typedExpressionIR) = typeIR
  -- if (_expressionIR '#' `( typeIR _ctk `) = typedExpressionIR)

def $ctk_of_typedExpressionIR(typedExpressionIR) : ctk =

  clause 0 : (typedExpressionIR) = ctk
  -- if (_expressionIR '#' `( _typeIR ctk `) = typedExpressionIR)

syntax simpleKeysetExpressionIR = 
   | expressionIR '#' expressionNoteIR (from typedExpressionIR)  hint(print %0) hint(prose %0 "annotated with" %1) hint(prose_fields "expression" "note")
   | typedExpressionIR '&&&' typedExpressionIR (from simpleKeysetExpressionIR) 
   | typedExpressionIR '..' typedExpressionIR (from simpleKeysetExpressionIR) 
   | DEFAULT (from simpleKeysetExpressionIR) 
   | '_' (from simpleKeysetExpressionIR) 

syntax simpleKeysetExpressionListIR = simpleKeysetExpressionIR*

syntax tupleKeysetExpressionIR = 
   | `( simpleKeysetExpressionListIR `) (from tupleKeysetExpressionIR) 

syntax keysetExpressionIR = 
   | expressionIR '#' expressionNoteIR (from typedExpressionIR)  hint(print %0) hint(prose %0 "annotated with" %1) hint(prose_fields "expression" "note")
   | typedExpressionIR '&&&' typedExpressionIR (from simpleKeysetExpressionIR) 
   | typedExpressionIR '..' typedExpressionIR (from simpleKeysetExpressionIR) 
   | DEFAULT (from simpleKeysetExpressionIR) 
   | '_' (from simpleKeysetExpressionIR) 
   | `( simpleKeysetExpressionListIR `) (from tupleKeysetExpressionIR) 

def $flatten_keysetExpressionIR(keysetExpressionIR) : simpleKeysetExpressionListIR =

  clause 0 : (simpleKeysetExpressionIR as keysetExpressionIR) = [simpleKeysetExpressionIR]

  clause 1 : (`( simpleKeysetExpressionListIR `) as keysetExpressionIR) = simpleKeysetExpressionListIR

syntax typeArgumentListIR = typeArgumentIR*

syntax argumentIR = 
   | expressionIR '#' expressionNoteIR (from typedExpressionIR)  hint(print %0) hint(prose %0 "annotated with" %1) hint(prose_fields "expression" "note")
   | nameIR '=' typedExpressionIR (from argumentIR) 
   | nameIR '=' '_' (from argumentIR) 
   | '_' (from argumentIR) 

syntax argumentListIR = argumentIR*

syntax lvalueIR = 
   | _BARE nameIR (from prefixedNameIR)  hint(print %0)
   | '.' nameIR (from prefixedNameIR) 
   | typedLvalueIR '.' nameIR (from lvalueIR) 
   | typedLvalueIR `[ typedExpressionIR `] (from lvalueIR) 
   | typedLvalueIR `[ typedExpressionIR sliceop typedExpressionIR `] (from lvalueIR) 
   | `( typedLvalueIR `) (from lvalueIR) 

syntax lvalueNoteIR = 
   | `( typeIR `) (from lvalueNoteIR) 

syntax typedLvalueIR = 
   | lvalueIR '#' lvalueNoteIR (from typedLvalueIR)  hint(print %0) hint(prose %0 "with note" %1) hint(prose_fields "lvalue" "note")

def $type_of_typedLvalueIR(typedLvalueIR) : typeIR =

  clause 0 : (typedLvalueIR) = typeIR
  -- if (_lvalueIR '#' `( typeIR `) = typedLvalueIR)

def $typedLvalueIR_as_typedExpressionIR(typedLvalueIR) : typedExpressionIR? =

  clause 0 : (referenceExpressionIR as lvalueIR '#' `( typeIR `)) = ?(referenceExpressionIR as expressionIR '#' `( typeIR DYN `))

  clause 1 : (typedLvalueIR '.' nameIR '#' `( typeIR `)) = ?(typedExpressionIR as memberAccessBaseIR '.' nameIR as expressionIR '#' `( typeIR DYN `))
  -- if (?(typedExpressionIR) = $typedLvalueIR_as_typedExpressionIR(typedLvalueIR))

  clause 2 : (typedLvalueIR_base `[ typedExpressionIR_index `] '#' `( typeIR `)) = ?(typedExpressionIR_base `[ typedExpressionIR_index `] as expressionIR '#' `( typeIR DYN `))
  -- if (?(typedExpressionIR_base) = $typedLvalueIR_as_typedExpressionIR(typedLvalueIR_base))

  clause 3 : (typedLvalueIR_base `[ typedExpressionIR_hi ':' typedExpressionIR_lo `] '#' `( typeIR `)) = ?(typedExpressionIR_base `[ typedExpressionIR_hi ':' typedExpressionIR_lo `] as expressionIR '#' `( typeIR DYN `))
  -- if (?(typedExpressionIR_base) = $typedLvalueIR_as_typedExpressionIR(typedLvalueIR_base))

  clause 4 : (typedLvalueIR_base `[ typedExpressionIR_l '+:' typedExpressionIR_w `] '#' `( typeIR `)) = ?(typedExpressionIR_base `[ typedExpressionIR_l '+:' typedExpressionIR_w `] as expressionIR '#' `( typeIR DYN `))
  -- if (?(typedExpressionIR_base) = $typedLvalueIR_as_typedExpressionIR(typedLvalueIR_base))

def $typedExpressionIR_as_typedLvalueIR(typedExpressionIR) : typedLvalueIR? =

  clause 0 : (referenceExpressionIR as expressionIR '#' `( typeIR _ctk `)) = ?(referenceExpressionIR as lvalueIR '#' `( typeIR `))

  clause 1 : (typedExpressionIR as memberAccessBaseIR '.' nameIR as expressionIR '#' `( typeIR _ctk `)) = ?(typedLvalueIR '.' nameIR '#' `( typeIR `))
  -- if (?(typedLvalueIR) = $typedExpressionIR_as_typedLvalueIR(typedExpressionIR))

  clause 2 : (typedExpressionIR_base `[ typedExpressionIR_index `] as expressionIR '#' `( typeIR _ctk `)) = ?(typedLvalueIR_base `[ typedExpressionIR_index `] '#' `( typeIR `))
  -- if (?(typedLvalueIR_base) = $typedExpressionIR_as_typedLvalueIR(typedExpressionIR_base))

  clause 3 : (typedExpressionIR_base `[ typedExpressionIR_hi ':' typedExpressionIR_lo `] as expressionIR '#' `( typeIR _ctk `)) = ?(typedLvalueIR_base `[ typedExpressionIR_hi ':' typedExpressionIR_lo `] '#' `( typeIR `))
  -- if (?(typedLvalueIR_base) = $typedExpressionIR_as_typedLvalueIR(typedExpressionIR_base))

  clause 4 : (typedExpressionIR_base `[ typedExpressionIR_l '+:' typedExpressionIR_w `] as expressionIR '#' `( typeIR _ctk `)) = ?(typedLvalueIR_base `[ typedExpressionIR_l '+:' typedExpressionIR_w `] '#' `( typeIR `))
  -- if (?(typedLvalueIR_base) = $typedExpressionIR_as_typedLvalueIR(typedExpressionIR_base))

  clause 5 : (`( typedExpressionIR `) as expressionIR '#' `( typeIR _ctk `)) = ?(`( typedLvalueIR `) '#' `( typeIR `))
  -- if (?(typedLvalueIR) = $typedExpressionIR_as_typedLvalueIR(typedExpressionIR))

syntax emptyStatementIR = emptyStatement

syntax assignmentStatementIR = 
   | typedLvalueIR assignop typedExpressionIR ';' (from assignmentStatementIR) 

syntax callStatementIR = 
   | callableTargetIR `< typeArgumentListIR `> `( argumentListIR `) ';' (from callStatementIR) 

syntax directApplicationStatementIR = 
   | constructorTargetIR '.' APPLY `( argumentListIR `) ';' (from directApplicationStatementIR) 

syntax returnStatementIR = 
   | RETURN ';' (from returnStatementIR) 
   | RETURN typedExpressionIR ';' (from returnStatementIR) 

syntax exitStatementIR = exitStatement

syntax blockStatementIR = 
   | annotationList `{ blockElementStatementListIR `} (from blockStatementIR) 

syntax conditionalStatementIR = 
   | IF `( typedExpressionIR `) statementIR (from conditionalStatementIR) 
   | IF `( typedExpressionIR `) statementIR ELSE statementIR (from conditionalStatementIR) 

syntax forUpdateStatementIR = 
   | callableTargetIR `< typeArgumentListIR `> `( argumentListIR `) (from forUpdateStatementIR) 
   | typedLvalueIR assignop typedExpressionIR (from forUpdateStatementIR) 

syntax forUpdateStatementListIR = forUpdateStatementIR*

syntax forInitStatementIR = 
   | annotationList typeIR nameIR initializerOptIR (from forInitStatementIR) 
   | callableTargetIR `< typeArgumentListIR `> `( argumentListIR `) (from forUpdateStatementIR) 
   | typedLvalueIR assignop typedExpressionIR (from forUpdateStatementIR) 

syntax forInitStatementListIR = forInitStatementIR*

syntax forCollectionExpressionIR = 
   | expressionIR '#' expressionNoteIR (from typedExpressionIR)  hint(print %0) hint(prose %0 "annotated with" %1) hint(prose_fields "expression" "note")
   | typedExpressionIR '..' typedExpressionIR (from forCollectionExpressionIR) 

syntax forStatementIR = 
   | annotationList FOR `( forInitStatementListIR ';' typedExpressionIR ';' forUpdateStatementListIR `) statementIR (from forStatementIR) 
   | annotationList FOR `( typeIR nameIR IN forCollectionExpressionIR `) statementIR (from forStatementIR) 
   | annotationList FOR `( annotationList typeIR nameIR IN forCollectionExpressionIR `) statementIR (from forStatementIR) 

syntax switchLabelIR = 
   | DEFAULT (from switchLabelIR) 
   | expressionIR '#' expressionNoteIR (from typedExpressionIR)  hint(print %0) hint(prose %0 "annotated with" %1) hint(prose_fields "expression" "note")

syntax switchCaseIR = 
   | switchLabelIR ':' blockStatementIR (from switchCaseIR) 
   | switchLabelIR ':' (from switchCaseIR) 

def $switchLabelIR_of_switchCaseIR(switchCaseIR) : switchLabelIR =

  clause 0 : (switchLabelIR ':' _blockStatementIR) = switchLabelIR

  clause 1 : (switchLabelIR ':') = switchLabelIR

syntax switchCaseListIR = switchCaseIR*

syntax switchStatementIR = 
   | SWITCH `( typedExpressionIR `) `{ switchCaseListIR `} (from switchStatementIR) 

syntax breakStatementIR = breakStatement

syntax continueStatementIR = continueStatement

syntax statementIR = 
   | ';' (from emptyStatement) 
   | typedLvalueIR assignop typedExpressionIR ';' (from assignmentStatementIR) 
   | callableTargetIR `< typeArgumentListIR `> `( argumentListIR `) ';' (from callStatementIR) 
   | constructorTargetIR '.' APPLY `( argumentListIR `) ';' (from directApplicationStatementIR) 
   | RETURN ';' (from returnStatementIR) 
   | RETURN typedExpressionIR ';' (from returnStatementIR) 
   | EXIT ';' (from exitStatement) 
   | annotationList `{ blockElementStatementListIR `} (from blockStatementIR) 
   | IF `( typedExpressionIR `) statementIR (from conditionalStatementIR) 
   | IF `( typedExpressionIR `) statementIR ELSE statementIR (from conditionalStatementIR) 
   | annotationList FOR `( forInitStatementListIR ';' typedExpressionIR ';' forUpdateStatementListIR `) statementIR (from forStatementIR) 
   | annotationList FOR `( typeIR nameIR IN forCollectionExpressionIR `) statementIR (from forStatementIR) 
   | annotationList FOR `( annotationList typeIR nameIR IN forCollectionExpressionIR `) statementIR (from forStatementIR) 
   | BREAK ';' (from breakStatement) 
   | CONTINUE ';' (from continueStatement) 
   | SWITCH `( typedExpressionIR `) `{ switchCaseListIR `} (from switchStatementIR) 

syntax constantDeclarationIR = 
   | annotationList CONST typeIR nameIR constantInitializerIR ';' (from constantDeclarationIR) 

syntax initializerOptIR = initializerIR?

syntax variableDeclarationIR = 
   | annotationList typeIR nameIR initializerOptIR ';' (from variableDeclarationIR) 

syntax blockElementStatementIR = 
   | annotationList CONST typeIR nameIR constantInitializerIR ';' (from constantDeclarationIR) 
   | annotationList typeIR nameIR initializerOptIR ';' (from variableDeclarationIR) 
   | ';' (from emptyStatement) 
   | typedLvalueIR assignop typedExpressionIR ';' (from assignmentStatementIR) 
   | callableTargetIR `< typeArgumentListIR `> `( argumentListIR `) ';' (from callStatementIR) 
   | constructorTargetIR '.' APPLY `( argumentListIR `) ';' (from directApplicationStatementIR) 
   | RETURN ';' (from returnStatementIR) 
   | RETURN typedExpressionIR ';' (from returnStatementIR) 
   | EXIT ';' (from exitStatement) 
   | annotationList `{ blockElementStatementListIR `} (from blockStatementIR) 
   | IF `( typedExpressionIR `) statementIR (from conditionalStatementIR) 
   | IF `( typedExpressionIR `) statementIR ELSE statementIR (from conditionalStatementIR) 
   | annotationList FOR `( forInitStatementListIR ';' typedExpressionIR ';' forUpdateStatementListIR `) statementIR (from forStatementIR) 
   | annotationList FOR `( typeIR nameIR IN forCollectionExpressionIR `) statementIR (from forStatementIR) 
   | annotationList FOR `( annotationList typeIR nameIR IN forCollectionExpressionIR `) statementIR (from forStatementIR) 
   | BREAK ';' (from breakStatement) 
   | CONTINUE ';' (from continueStatement) 
   | SWITCH `( typedExpressionIR `) `{ switchCaseListIR `} (from switchStatementIR) 

syntax blockElementStatementListIR = blockElementStatementIR*

syntax functionPrototypeIR = 
   | typeIR nameIR `< typeParameterListIR ',' typeParameterListIR `> `( parameterListIR `) (from functionPrototypeIR) 

syntax functionDeclarationIR = 
   | annotationList functionPrototypeIR blockStatementIR (from functionDeclarationIR) 

syntax actionDeclarationIR = 
   | annotationList ACTION nameIR `( parameterListIR `) blockStatementIR (from actionDeclarationIR) 

syntax objectInitializerIR = 
   | '=' `{ objectDeclarationListIR `} (from objectInitializerIR) 

syntax objectInitializerOptIR = objectInitializerIR?

syntax instantiationIR = 
   | annotationList typeIR constructorTargetIR `( argumentListIR `) nameIR objectInitializerOptIR ';' (from instantiationIR)  hint(prose_fields "annotations" "type" "constructor target" "arguments" "name" "object initializer")

syntax objectDeclarationIR = 
   | annotationList functionPrototypeIR blockStatementIR (from functionDeclarationIR) 
   | annotationList typeIR constructorTargetIR `( argumentListIR `) nameIR objectInitializerOptIR ';' (from instantiationIR)  hint(prose_fields "annotations" "type" "constructor target" "arguments" "name" "object initializer")

syntax objectDeclarationListIR = objectDeclarationIR*

def $flatten_objectInitializerOptIR(objectInitializerOptIR) : objectDeclarationListIR =

  clause 0 : (?()) = []

  clause 1 : (?('=' `{ objectDeclarationListIR `})) = objectDeclarationListIR

syntax errorDeclarationIR = 
   | ERROR `{ nameListIR `} (from errorDeclarationIR) 

syntax matchKindDeclarationIR = 
   | MATCH_KIND `{ nameListIR `} (from matchKindDeclarationIR) 

syntax enumTypeDeclarationIR = 
   | annotationList ENUM nameIR `{ nameListIR `} (from enumTypeDeclarationIR) 
   | annotationList ENUM typeIR nameIR `{ namedValueListIR `} (from enumTypeDeclarationIR) 

syntax typeFieldIR = 
   | annotationList typeIR nameIR ';' (from typeFieldIR) 

syntax typeFieldListIR = typeFieldIR*

syntax structTypeDeclarationIR = 
   | annotationList STRUCT nameIR `< typeParameterListIR `> `{ typeFieldListIR `} (from structTypeDeclarationIR) 

syntax headerTypeDeclarationIR = 
   | annotationList HEADER nameIR `< typeParameterListIR `> `{ typeFieldListIR `} (from headerTypeDeclarationIR) 

syntax headerUnionTypeDeclarationIR = 
   | annotationList HEADER_UNION nameIR `< typeParameterListIR `> `{ typeFieldListIR `} (from headerUnionTypeDeclarationIR) 

syntax derivedTypeDeclarationIR = 
   | annotationList ENUM nameIR `{ nameListIR `} (from enumTypeDeclarationIR) 
   | annotationList ENUM typeIR nameIR `{ namedValueListIR `} (from enumTypeDeclarationIR) 
   | annotationList STRUCT nameIR `< typeParameterListIR `> `{ typeFieldListIR `} (from structTypeDeclarationIR) 
   | annotationList HEADER nameIR `< typeParameterListIR `> `{ typeFieldListIR `} (from headerTypeDeclarationIR) 
   | annotationList HEADER_UNION nameIR `< typeParameterListIR `> `{ typeFieldListIR `} (from headerUnionTypeDeclarationIR) 

syntax typedefIR = 
   | VOID (from voidTypeIR) 
   | BOOL (from boolTypeIR) 
   | ERROR (from errorTypeIR) 
   | MATCH_KIND (from matchKindTypeIR) 
   | STRING (from stringTypeIR) 
   | INT (from intTypeIR) 
   | INT `< nat `> (from fixedIntTypeIR) 
   | BIT `< nat `> (from fixedBitTypeIR) 
   | VARBIT `< nat `> (from varBitTypeIR) 
   | _NAME typeId (from nameTypeIR)  hint(print %0)
   | TYPEDEF typeId typeIR (from typedefTypeIR)  hint(print %0)
   | TYPE typeId typeIR (from newTypeIR)  hint(print %0)
   | LIST `< typeIR `> (from listTypeIR) 
   | TUPLE `< typeIR* `> (from tupleTypeIR) 
   | ARRAY typeIR `[ nat `] (from arrayTypeIR) 
   | HEADER_STACK typeIR `[ nat `] (from headerStackTypeIR) 
   | STRUCT typeId `< typeArgumentIR* `> `{ fieldTypeIR* `} (from structTypeIR)  hint(print %0#"<"#%1#">")
   | HEADER typeId `< typeArgumentIR* `> `{ fieldTypeIR* `} (from headerTypeIR)  hint(print %0#"<"#%1#">")
   | HEADER_UNION typeId `< typeArgumentIR* `> `{ fieldTypeIR* `} (from headerUnionTypeIR)  hint(print %0#"<"#%1#">")
   | ENUM typeId `{ nameIR* `} (from simpleEnumTypeIR)  hint(print %0)
   | ENUM typeId `< typeIR `> `{ valueFieldIR* `} (from serializableEnumTypeIR)  hint(print %0)
   | EXTERN typeId `< typeArgumentIR* `> externMethodTypeDefEnv (from externObjectTypeIR)  hint(print %0#"<"#%1#">")
   | PARSER typeId `< typeArgumentIR* `> `( parameterIR* `) (from parserObjectTypeIR)  hint(print %0#"<"#%1#">")
   | CONTROL typeId `< typeArgumentIR* `> `( parameterIR* `) (from controlObjectTypeIR)  hint(print %0#"<"#%1#">")
   | PACKAGE typeId `< typeArgumentIR* `> `{ typeIR* `} (from packageObjectTypeIR)  hint(print %0#"<"#%1#">")
   | TABLE typeId `{ tableMetadataStructTypeIR `} (from tableObjectTypeIR)  hint(print %0)
   | DEFAULT (from defaultTypeIR) 
   | HEADER_INVALID (from invalidHeaderTypeIR) 
   | SEQ `< typeIR* `> (from sequenceTypeIR) 
   | SEQ `< typeIR* ',' '...' `> (from sequenceTypeIR) 
   | RECORD `{ fieldTypeIR* `} (from recordTypeIR) 
   | RECORD `{ fieldTypeIR* ',' '...' `} (from recordTypeIR) 
   | SET `< typeIR `> (from setTypeIR) 
   | TABLE_ENUM typeId `{ nameIR* `} (from tableMetadataEnumTypeIR)  hint(print %0)
   | TABLE_STRUCT typeId `{ HIT boolTypeIR ';' MISS boolTypeIR ';' ACTION_RUN tableMetadataEnumTypeIR ';' `} (from tableMetadataStructTypeIR)  hint(print %0)
   | annotationList ENUM nameIR `{ nameListIR `} (from enumTypeDeclarationIR) 
   | annotationList ENUM typeIR nameIR `{ namedValueListIR `} (from enumTypeDeclarationIR) 
   | annotationList STRUCT nameIR `< typeParameterListIR `> `{ typeFieldListIR `} (from structTypeDeclarationIR) 
   | annotationList HEADER nameIR `< typeParameterListIR `> `{ typeFieldListIR `} (from headerTypeDeclarationIR) 
   | annotationList HEADER_UNION nameIR `< typeParameterListIR `> `{ typeFieldListIR `} (from headerUnionTypeDeclarationIR) 

syntax typedefDeclarationIR = 
   | annotationList TYPEDEF typedefIR nameIR ';' (from typedefDeclarationIR) 
   | annotationList TYPE typeIR nameIR ';' (from typedefDeclarationIR) 

syntax externFunctionDeclarationIR = 
   | annotationList EXTERN functionPrototypeIR ';' (from externFunctionDeclarationIR) 

syntax externConstructorPrototypeIR = 
   | annotationList nameIR `< ',' typeParameterListIR `> `( parameterListIR `) ';' (from externConstructorPrototypeIR) 

syntax externConstructorPrototypeListIR = externConstructorPrototypeIR*

syntax externMethodPrototypeIR = 
   | annotationList functionPrototypeIR ';' (from externMethodPrototypeIR) 
   | annotationList ABSTRACT functionPrototypeIR ';' (from externMethodPrototypeIR) 

syntax externMethodPrototypeListIR = externMethodPrototypeIR*

syntax externObjectDeclarationIR = 
   | annotationList EXTERN nameIR `< typeParameterListIR ',' `> `{ externConstructorPrototypeListIR externMethodPrototypeListIR `} (from externObjectDeclarationIR) 

syntax externDeclarationIR = 
   | annotationList EXTERN functionPrototypeIR ';' (from externFunctionDeclarationIR) 
   | annotationList EXTERN nameIR `< typeParameterListIR ',' `> `{ externConstructorPrototypeListIR externMethodPrototypeListIR `} (from externObjectDeclarationIR) 

syntax selectCaseIR = 
   | keysetExpressionIR ':' nameIR ';' (from selectCaseIR) 

syntax selectCaseListIR = selectCaseIR*

syntax selectExpressionIR = 
   | SELECT `( typedExpressionListIR `) `{ selectCaseListIR `} (from selectExpressionIR) 

syntax stateExpressionIR = 
   | nameIR ';' (from stateExpressionIR) 
   | SELECT `( typedExpressionListIR `) `{ selectCaseListIR `} (from selectExpressionIR) 

syntax transitionStatementIR = 
   | TRANSITION stateExpressionIR (from transitionStatementIR) 

syntax valueSetDeclarationIR = 
   | annotationList VALUE_SET `< typeIR `> `( typedExpressionIR `) nameIR ';' (from valueSetDeclarationIR) 

syntax parserTypeDeclarationIR = 
   | annotationList PARSER nameIR `< typeParameterListIR ',' typeParameterListIR `> `( parameterListIR `) ';' (from parserTypeDeclarationIR) 

syntax parserBlockElementStatementListIR = parserBlockElementStatementIR*

syntax parserBlockStatementIR = 
   | annotationList `{ parserBlockElementStatementListIR `} (from parserBlockStatementIR) 

syntax parserConditionalStatementIR = 
   | IF `( typedExpressionIR `) parserStatementIR (from parserConditionalStatementIR) 
   | IF `( typedExpressionIR `) parserStatementIR ELSE parserStatementIR (from parserConditionalStatementIR) 

syntax parserStatementIR = 
   | ';' (from emptyStatement) 
   | typedLvalueIR assignop typedExpressionIR ';' (from assignmentStatementIR) 
   | callableTargetIR `< typeArgumentListIR `> `( argumentListIR `) ';' (from callStatementIR) 
   | constructorTargetIR '.' APPLY `( argumentListIR `) ';' (from directApplicationStatementIR) 
   | annotationList `{ parserBlockElementStatementListIR `} (from parserBlockStatementIR) 
   | IF `( typedExpressionIR `) parserStatementIR (from parserConditionalStatementIR) 
   | IF `( typedExpressionIR `) parserStatementIR ELSE parserStatementIR (from parserConditionalStatementIR) 

syntax parserBlockElementStatementIR = 
   | annotationList CONST typeIR nameIR constantInitializerIR ';' (from constantDeclarationIR) 
   | annotationList typeIR nameIR initializerOptIR ';' (from variableDeclarationIR) 
   | ';' (from emptyStatement) 
   | typedLvalueIR assignop typedExpressionIR ';' (from assignmentStatementIR) 
   | callableTargetIR `< typeArgumentListIR `> `( argumentListIR `) ';' (from callStatementIR) 
   | constructorTargetIR '.' APPLY `( argumentListIR `) ';' (from directApplicationStatementIR) 
   | annotationList `{ parserBlockElementStatementListIR `} (from parserBlockStatementIR) 
   | IF `( typedExpressionIR `) parserStatementIR (from parserConditionalStatementIR) 
   | IF `( typedExpressionIR `) parserStatementIR ELSE parserStatementIR (from parserConditionalStatementIR) 

syntax parserStateIR = 
   | annotationList STATE nameIR `{ parserBlockElementStatementListIR transitionStatementIR `} (from parserStateIR) 

syntax parserStateListIR = parserStateIR*

syntax parserLocalDeclarationIR = 
   | annotationList CONST typeIR nameIR constantInitializerIR ';' (from constantDeclarationIR) 
   | annotationList typeIR constructorTargetIR `( argumentListIR `) nameIR objectInitializerOptIR ';' (from instantiationIR)  hint(prose_fields "annotations" "type" "constructor target" "arguments" "name" "object initializer")
   | annotationList typeIR nameIR initializerOptIR ';' (from variableDeclarationIR) 
   | annotationList VALUE_SET `< typeIR `> `( typedExpressionIR `) nameIR ';' (from valueSetDeclarationIR) 

syntax parserLocalDeclarationListIR = parserLocalDeclarationIR*

syntax parserDeclarationIR = 
   | annotationList PARSER nameIR `< typeParameterListIR ',' typeParameterListIR `> `( parameterListIR `) `( constructorParameterListIR `) `{ parserLocalDeclarationListIR parserStateListIR `} (from parserDeclarationIR) 

syntax constIR = const

syntax constOptIR = constIR?

syntax tableKeyIR = 
   | typedExpressionIR '#' nameIR ':' nameIR annotationList ';' (from tableKeyIR) 

syntax tableKeyListIR = tableKeyIR*

syntax controlPlaneNameIR = nameIR?

syntax tableActionReferenceIR = 
   | prefixedNameIR controlPlaneNameIR `( argumentListIR `) (from tableActionReferenceIR) 

syntax tableActionIR = 
   | annotationList tableActionReferenceIR '#' `( parameterListIR ',' parameterListIR `) ';' (from tableActionIR) 

syntax tableActionListIR = tableActionIR*

syntax tableEntryPriorityIR = 
   | PRIORITY '=' integerLiteral ':' (from tableEntryPriorityIR) 

syntax tableEntryPriorityOptIR = tableEntryPriorityIR?

syntax tableEntryIR = 
   | constOptIR tableEntryPriorityOptIR keysetExpressionIR ':' tableActionReferenceIR annotationList ';' (from tableEntryIR) 

def $tableEntryPriorityOptIR_of_tableEntryIR(tableEntryIR) : tableEntryPriorityOptIR =

  clause 0 : (tableEntryIR) = tableEntryPriorityOptIR
  -- if (_constOptIR tableEntryPriorityOptIR _keysetExpressionIR ':' _tableActionReferenceIR _annotationList ';' = tableEntryIR)

syntax tableEntryListIR = tableEntryIR*

syntax tableKeysPropertyIR = 
   | KEY '=' `{ tableKeyListIR `} (from tableKeysPropertyIR) 

syntax tableActionsPropertyIR = 
   | ACTIONS '=' `{ tableActionListIR `} (from tableActionsPropertyIR) 

syntax tableDefaultActionPropertyIR = 
   | annotationList constOptIR DEFAULT_ACTION '=' tableActionReferenceIR ';' (from tableDefaultActionPropertyIR) 

syntax tableEntriesPropertyIR = 
   | annotationList constOptIR ENTRIES '=' `{ tableEntryListIR `} (from tableEntriesPropertyIR) 

syntax tableCustomPropertyIR = 
   | annotationList constOptIR CUSTOM nameIR initializerIR ';' (from tableCustomPropertyIR) 
   | annotationList constOptIR CUSTOM_CONST nameIR constantInitializerIR ';' (from tableCustomPropertyIR) 

syntax tablePropertyIR = 
   | KEY '=' `{ tableKeyListIR `} (from tableKeysPropertyIR) 
   | ACTIONS '=' `{ tableActionListIR `} (from tableActionsPropertyIR) 
   | annotationList constOptIR DEFAULT_ACTION '=' tableActionReferenceIR ';' (from tableDefaultActionPropertyIR) 
   | annotationList constOptIR ENTRIES '=' `{ tableEntryListIR `} (from tableEntriesPropertyIR) 
   | annotationList constOptIR CUSTOM nameIR initializerIR ';' (from tableCustomPropertyIR) 
   | annotationList constOptIR CUSTOM_CONST nameIR constantInitializerIR ';' (from tableCustomPropertyIR) 

syntax tablePropertyListIR = tablePropertyIR*

syntax tableDeclarationIR = 
   | annotationList TABLE typeIR nameIR `{ tablePropertyListIR `} (from tableDeclarationIR)  hint(print %0 TABLE %2 ``{%3`})

syntax controlTypeDeclarationIR = 
   | annotationList CONTROL nameIR `< typeParameterListIR ',' typeParameterListIR `> `( parameterListIR `) ';' (from controlTypeDeclarationIR) 

syntax controlBodyIR = blockStatementIR

syntax controlLocalDeclarationIR = 
   | annotationList CONST typeIR nameIR constantInitializerIR ';' (from constantDeclarationIR) 
   | annotationList typeIR constructorTargetIR `( argumentListIR `) nameIR objectInitializerOptIR ';' (from instantiationIR)  hint(prose_fields "annotations" "type" "constructor target" "arguments" "name" "object initializer")
   | annotationList typeIR nameIR initializerOptIR ';' (from variableDeclarationIR) 
   | annotationList ACTION nameIR `( parameterListIR `) blockStatementIR (from actionDeclarationIR) 
   | annotationList TABLE typeIR nameIR `{ tablePropertyListIR `} (from tableDeclarationIR)  hint(print %0 TABLE %2 ``{%3`})

syntax controlLocalDeclarationListIR = controlLocalDeclarationIR*

syntax controlDeclarationIR = 
   | annotationList CONTROL nameIR `< typeParameterListIR ',' typeParameterListIR `> `( parameterListIR `) `( constructorParameterListIR `) `{ controlLocalDeclarationListIR APPLY controlBodyIR `} (from controlDeclarationIR) 

syntax packageTypeDeclarationIR = 
   | annotationList PACKAGE nameIR `< typeParameterListIR ',' typeParameterListIR `> `( parameterListIR `) ';' (from packageTypeDeclarationIR) 

syntax typeDeclarationIR = 
   | annotationList ENUM nameIR `{ nameListIR `} (from enumTypeDeclarationIR) 
   | annotationList ENUM typeIR nameIR `{ namedValueListIR `} (from enumTypeDeclarationIR) 
   | annotationList STRUCT nameIR `< typeParameterListIR `> `{ typeFieldListIR `} (from structTypeDeclarationIR) 
   | annotationList HEADER nameIR `< typeParameterListIR `> `{ typeFieldListIR `} (from headerTypeDeclarationIR) 
   | annotationList HEADER_UNION nameIR `< typeParameterListIR `> `{ typeFieldListIR `} (from headerUnionTypeDeclarationIR) 
   | annotationList TYPEDEF typedefIR nameIR ';' (from typedefDeclarationIR) 
   | annotationList TYPE typeIR nameIR ';' (from typedefDeclarationIR) 
   | annotationList PARSER nameIR `< typeParameterListIR ',' typeParameterListIR `> `( parameterListIR `) ';' (from parserTypeDeclarationIR) 
   | annotationList CONTROL nameIR `< typeParameterListIR ',' typeParameterListIR `> `( parameterListIR `) ';' (from controlTypeDeclarationIR) 
   | annotationList PACKAGE nameIR `< typeParameterListIR ',' typeParameterListIR `> `( parameterListIR `) ';' (from packageTypeDeclarationIR) 

syntax declarationIR = 
   | annotationList CONST typeIR nameIR constantInitializerIR ';' (from constantDeclarationIR) 
   | annotationList typeIR constructorTargetIR `( argumentListIR `) nameIR objectInitializerOptIR ';' (from instantiationIR)  hint(prose_fields "annotations" "type" "constructor target" "arguments" "name" "object initializer")
   | annotationList functionPrototypeIR blockStatementIR (from functionDeclarationIR) 
   | annotationList ACTION nameIR `( parameterListIR `) blockStatementIR (from actionDeclarationIR) 
   | ERROR `{ nameListIR `} (from errorDeclarationIR) 
   | MATCH_KIND `{ nameListIR `} (from matchKindDeclarationIR) 
   | annotationList EXTERN functionPrototypeIR ';' (from externFunctionDeclarationIR) 
   | annotationList EXTERN nameIR `< typeParameterListIR ',' `> `{ externConstructorPrototypeListIR externMethodPrototypeListIR `} (from externObjectDeclarationIR) 
   | annotationList PARSER nameIR `< typeParameterListIR ',' typeParameterListIR `> `( parameterListIR `) `( constructorParameterListIR `) `{ parserLocalDeclarationListIR parserStateListIR `} (from parserDeclarationIR) 
   | annotationList CONTROL nameIR `< typeParameterListIR ',' typeParameterListIR `> `( parameterListIR `) `( constructorParameterListIR `) `{ controlLocalDeclarationListIR APPLY controlBodyIR `} (from controlDeclarationIR) 
   | annotationList ENUM nameIR `{ nameListIR `} (from enumTypeDeclarationIR) 
   | annotationList ENUM typeIR nameIR `{ namedValueListIR `} (from enumTypeDeclarationIR) 
   | annotationList STRUCT nameIR `< typeParameterListIR `> `{ typeFieldListIR `} (from structTypeDeclarationIR) 
   | annotationList HEADER nameIR `< typeParameterListIR `> `{ typeFieldListIR `} (from headerTypeDeclarationIR) 
   | annotationList HEADER_UNION nameIR `< typeParameterListIR `> `{ typeFieldListIR `} (from headerUnionTypeDeclarationIR) 
   | annotationList TYPEDEF typedefIR nameIR ';' (from typedefDeclarationIR) 
   | annotationList TYPE typeIR nameIR ';' (from typedefDeclarationIR) 
   | annotationList PARSER nameIR `< typeParameterListIR ',' typeParameterListIR `> `( parameterListIR `) ';' (from parserTypeDeclarationIR) 
   | annotationList CONTROL nameIR `< typeParameterListIR ',' typeParameterListIR `> `( parameterListIR `) ';' (from controlTypeDeclarationIR) 
   | annotationList PACKAGE nameIR `< typeParameterListIR ',' typeParameterListIR `> `( parameterListIR `) ';' (from packageTypeDeclarationIR) 

syntax p4programIR = 
   | declarationIR* ';' (from p4programIR) 

def $partition_parameterListIR(parameterIR*, nameIR*, nameIR*) : (parameterIR*, parameterIR*, parameterIR*) =

  clause 0 : ([], _nameIR*{_nameIR <- _nameIR*}, _nameIR'*{_nameIR' <- _nameIR'*}) = ([], [], [])

  clause 1 : (parameterIR_h :: parameterIR_t*{parameterIR_t <- parameterIR_t*}, nameIR_default*{nameIR_default <- nameIR_default*}, nameIR_optional*{nameIR_optional <- nameIR_optional*}) = (parameterIR_given*{parameterIR_given <- parameterIR_given*}, parameterIR_h :: parameterIR_default*{parameterIR_default <- parameterIR_default*}, parameterIR_optional*{parameterIR_optional <- parameterIR_optional*})
  -- if ((parameterIR_given*{parameterIR_given <- parameterIR_given*}, parameterIR_default*{parameterIR_default <- parameterIR_default*}, parameterIR_optional*{parameterIR_optional <- parameterIR_optional*}) = $partition_parameterListIR(parameterIR_t*{parameterIR_t <- parameterIR_t*}, nameIR_default*{nameIR_default <- nameIR_default*}, nameIR_optional*{nameIR_optional <- nameIR_optional*}))
  -- if (_annotationList _direction _typeIR nameIR_h _parameterInitializerOptIR = parameterIR_h)
  -- if nameIR_h <- nameIR_default*{nameIR_default <- nameIR_default*}

  clause 2 : (parameterIR_h :: parameterIR_t*{parameterIR_t <- parameterIR_t*}, nameIR_default*{nameIR_default <- nameIR_default*}, nameIR_optional*{nameIR_optional <- nameIR_optional*}) = (parameterIR_given*{parameterIR_given <- parameterIR_given*}, parameterIR_default*{parameterIR_default <- parameterIR_default*}, parameterIR_h :: parameterIR_optional*{parameterIR_optional <- parameterIR_optional*})
  -- if ((parameterIR_given*{parameterIR_given <- parameterIR_given*}, parameterIR_default*{parameterIR_default <- parameterIR_default*}, parameterIR_optional*{parameterIR_optional <- parameterIR_optional*}) = $partition_parameterListIR(parameterIR_t*{parameterIR_t <- parameterIR_t*}, nameIR_default*{nameIR_default <- nameIR_default*}, nameIR_optional*{nameIR_optional <- nameIR_optional*}))
  -- if (_annotationList _direction _typeIR nameIR_h _parameterInitializerOptIR = parameterIR_h)
  -- if nameIR_h <- nameIR_optional*{nameIR_optional <- nameIR_optional*}

  clause 3 : (parameterIR_h :: parameterIR_t*{parameterIR_t <- parameterIR_t*}, nameIR_default*{nameIR_default <- nameIR_default*}, nameIR_optional*{nameIR_optional <- nameIR_optional*}) = (parameterIR_h :: parameterIR_given*{parameterIR_given <- parameterIR_given*}, parameterIR_default*{parameterIR_default <- parameterIR_default*}, parameterIR_optional*{parameterIR_optional <- parameterIR_optional*})
  -- if ((parameterIR_given*{parameterIR_given <- parameterIR_given*}, parameterIR_default*{parameterIR_default <- parameterIR_default*}, parameterIR_optional*{parameterIR_optional <- parameterIR_optional*}) = $partition_parameterListIR(parameterIR_t*{parameterIR_t <- parameterIR_t*}, nameIR_default*{nameIR_default <- nameIR_default*}, nameIR_optional*{nameIR_optional <- nameIR_optional*}))
  -- if (_annotationList _direction _typeIR nameIR_h _parameterInitializerOptIR = parameterIR_h)
  -- if ~nameIR_h <- nameIR_default*{nameIR_default <- nameIR_default*}
  -- if ~nameIR_h <- nameIR_optional*{nameIR_optional <- nameIR_optional*}

syntax callAlign = 
   | GIVEN parameterIR* DEFAULT parameterIR* OPTIONAL parameterIR* (from callAlign) 

def $align_parameterListIR(parameterIR*, argumentIR*, nameIR*, nameIR*) : callAlign =

  clause 0 : (parameterIR*{parameterIR <- parameterIR*}, argumentIR*{argumentIR <- argumentIR*}, nameIR_default*{nameIR_default <- nameIR_default*}, nameIR_optional*{nameIR_optional <- nameIR_optional*}) = GIVEN parameterIR_given_aligned*{parameterIR_given_aligned <- parameterIR_given_aligned*} DEFAULT parameterIR_default*{parameterIR_default <- parameterIR_default*} OPTIONAL parameterIR_optional*{parameterIR_optional <- parameterIR_optional*}
  -- if ((parameterIR_given*{parameterIR_given <- parameterIR_given*}, parameterIR_default*{parameterIR_default <- parameterIR_default*}, parameterIR_optional*{parameterIR_optional <- parameterIR_optional*}) = $partition_parameterListIR(parameterIR*{parameterIR <- parameterIR*}, nameIR_default*{nameIR_default <- nameIR_default*}, nameIR_optional*{nameIR_optional <- nameIR_optional*}))
  -- (if (_annotationList _direction _typeIR nameIR_given _parameterInitializerOptIR = parameterIR_given))*{_annotationList <- _annotationList*, _direction <- _direction*, _parameterInitializerOptIR <- _parameterInitializerOptIR*, _typeIR <- _typeIR*, nameIR_given <- nameIR_given*, parameterIR_given <- parameterIR_given*}
  -- if (parameterIR_given_aligned*{parameterIR_given_aligned <- parameterIR_given_aligned*} = $align_parameterListIR_given(`{ nameIR_given ':' parameterIR_given*{nameIR_given <- nameIR_given*, parameterIR_given <- parameterIR_given*} `}, parameterIR_given*{parameterIR_given <- parameterIR_given*}, argumentIR*{argumentIR <- argumentIR*}))

def $align_parameterListIR_given(map<id, parameterIR>, parameterIR*, argumentIR*) : parameterIR* =

  clause 0 : (`{ id ':' parameterIR*{id <- id*, parameterIR <- parameterIR*} `}, [], []) = []

  clause 1 : (`{ id ':' parameterIR*{id <- id*, parameterIR <- parameterIR*} `}, parameterIR_h :: parameterIR_t*{parameterIR_t <- parameterIR_t*}, argumentIR_h :: argumentIR_t*{argumentIR_t <- argumentIR_t*}) = parameterIR_h :: parameterIR_aligned*{parameterIR_aligned <- parameterIR_aligned*}
  -- if (argumentIR_h = typedExpressionIR as argumentIR)
  -- if (parameterIR_aligned*{parameterIR_aligned <- parameterIR_aligned*} = $align_parameterListIR_given(`{ id ':' parameterIR*{id <- id*, parameterIR <- parameterIR*} `}, parameterIR_t*{parameterIR_t <- parameterIR_t*}, argumentIR_t*{argumentIR_t <- argumentIR_t*}))

  clause 2 : (`{ id ':' parameterIR*{id <- id*, parameterIR <- parameterIR*} `}, parameterIR_h :: parameterIR_t*{parameterIR_t <- parameterIR_t*}, argumentIR_h :: argumentIR_t*{argumentIR_t <- argumentIR_t*}) = parameterIR_h :: parameterIR_aligned*{parameterIR_aligned <- parameterIR_aligned*}
  -- if (argumentIR_h = '_')
  -- if (parameterIR_aligned*{parameterIR_aligned <- parameterIR_aligned*} = $align_parameterListIR_given(`{ id ':' parameterIR*{id <- id*, parameterIR <- parameterIR*} `}, parameterIR_t*{parameterIR_t <- parameterIR_t*}, argumentIR_t*{argumentIR_t <- argumentIR_t*}))

  clause 3 : (`{ id ':' parameterIR*{id <- id*, parameterIR <- parameterIR*} `}, parameterIR_h :: parameterIR_t*{parameterIR_t <- parameterIR_t*}, argumentIR_h :: argumentIR_t*{argumentIR_t <- argumentIR_t*}) = parameterIR_match :: parameterIR_aligned*{parameterIR_aligned <- parameterIR_aligned*}
  -- if (argumentIR_h = nameIR '=' _typedExpressionIR)
  -- if (?(parameterIR_match) = $find_map<id, parameterIR>(`{ id ':' parameterIR*{id <- id*, parameterIR <- parameterIR*} `}, nameIR))
  -- if (parameterIR_aligned*{parameterIR_aligned <- parameterIR_aligned*} = $align_parameterListIR_given(`{ id ':' parameterIR*{id <- id*, parameterIR <- parameterIR*} `}, parameterIR_t*{parameterIR_t <- parameterIR_t*}, argumentIR_t*{argumentIR_t <- argumentIR_t*}))

  clause 4 : (`{ id ':' parameterIR*{id <- id*, parameterIR <- parameterIR*} `}, parameterIR_h :: parameterIR_t*{parameterIR_t <- parameterIR_t*}, argumentIR_h :: argumentIR_t*{argumentIR_t <- argumentIR_t*}) = parameterIR_match :: parameterIR_aligned*{parameterIR_aligned <- parameterIR_aligned*}
  -- if (argumentIR_h = nameIR '=' '_')
  -- if (?(parameterIR_match) = $find_map<id, parameterIR>(`{ id ':' parameterIR*{id <- id*, parameterIR <- parameterIR*} `}, nameIR))
  -- if (parameterIR_aligned*{parameterIR_aligned <- parameterIR_aligned*} = $align_parameterListIR_given(`{ id ':' parameterIR*{id <- id*, parameterIR <- parameterIR*} `}, parameterIR_t*{parameterIR_t <- parameterIR_t*}, argumentIR_t*{argumentIR_t <- argumentIR_t*}))

syntax callTargetKey = 
   | nameIR `( id?* `) (from callTargetKey) 

syntax namedCallTargetKey = 
   | nameIR `( id* `) (from namedCallTargetKey) 

syntax unnamedCallTargetKey = 
   | nameIR `( nat `) (from unnamedCallTargetKey) 

syntax callTargetParameter = 
   | nameIR '#' bool '#' bool (from callTargetParameter) 

syntax callTargetValue = callTargetParameter*

syntax callTargetMatch = 
   | MATCH id* id* (from callTargetMatch)  hint(prose MATCH "with defaults" %0 and "optionals" %1)
   | NOMATCH (from callTargetMatch) 

syntax callResolution<V> = 
   | callableId ':' V '#' nameIR* '#' nameIR* (from callResolution<V>)  hint(prose_fields "call target id" "call target" "defaults" "optionals")

def $callTargetKey(nameIR, argumentListIR) : callTargetKey =

  clause 0 : (nameIR_f, argumentIR*{argumentIR <- argumentIR*}) = nameIR_f `( id_arg?{id_arg <- id_arg?}*{id_arg? <- id_arg?*} `)
  -- (if (id_arg?{id_arg <- id_arg?} = $callTargetKey'(argumentIR)))*{argumentIR <- argumentIR*, id_arg? <- id_arg?*}

def $callTargetKey'(argumentIR) : id? =

  clause 0 : (typedExpressionIR as argumentIR) = ?()

  clause 1 : (id_arg '=' _typedExpressionIR) = ?(id_arg)

  clause 2 : (id_arg '=' '_') = ?(id_arg)

  clause 3 : ('_') = ?()

def $match_overloaded_named<V>(pair<callTargetId, V>, namedCallTargetKey, $get_parameterListIR(V) : parameterListIR) : callTargetMatch =

  clause 0 : (callTargetId ':' V, nameIR_f `( id_arg*{id_arg <- id_arg*} `), $get_parameterListIR) = $ite<callTargetMatch>($eq_set<id>(`{ id_param*{id_param <- id_param*} `}, `{ id_arg*{id_arg <- id_arg*} `}), MATCH [] [], NOMATCH)
  -- if (nameIR_f `( id_param*{id_param <- id_param*} `) = callTargetId)
  -- if (parameterIR*{parameterIR <- parameterIR*} = $get_parameterListIR(V))
  -- (if (id_param = $id_of_parameterIR(parameterIR)))*{id_param <- id_param*, parameterIR <- parameterIR*}
  -- if (|id_param*{id_param <- id_param*}| = |id_arg*{id_arg <- id_arg*}|)

  clause 1 : (callTargetId ':' V, nameIR_f `( id_arg*{id_arg <- id_arg*} `), $get_parameterListIR) = MATCH id_default*{id_default <- id_default*} id_optional*{id_optional <- id_optional*}
  -- if (nameIR_f `( id_param*{id_param <- id_param*} `) = callTargetId)
  -- if (parameterIR*{parameterIR <- parameterIR*} = $get_parameterListIR(V))
  -- (if (id_param = $id_of_parameterIR(parameterIR)))*{id_param <- id_param*, parameterIR <- parameterIR*}
  -- (if (b_default = $is_default_parameterIR(parameterIR)))*{b_default <- b_default*, parameterIR <- parameterIR*}
  -- (if (b_optional = $is_optional_parameterIR(parameterIR)))*{b_optional <- b_optional*, parameterIR <- parameterIR*}
  -- if (|id_param*{id_param <- id_param*}| > |id_arg*{id_arg <- id_arg*}|)
  -- if (`{ id_param_omitted*{id_param_omitted <- id_param_omitted*} `} = $diff_set<id>(`{ id_param*{id_param <- id_param*} `}, `{ id_arg*{id_arg <- id_arg*} `}))
  -- if (id_default_param*{id_default_param <- id_default_param*} = $filter_<id>(id_param*{id_param <- id_param*}, $is_default_parameterIR(parameterIR)*{parameterIR <- parameterIR*}))
  -- if (id_default*{id_default <- id_default*} = $filter_<id>(id_param_omitted*{id_param_omitted <- id_param_omitted*}, id_param_omitted <- id_default_param*{id_default_param <- id_default_param*}*{id_param_omitted <- id_param_omitted*}))
  -- if (id_optional_param*{id_optional_param <- id_optional_param*} = $filter_<id>(id_param*{id_param <- id_param*}, $is_optional_parameterIR(parameterIR)*{parameterIR <- parameterIR*}))
  -- if (id_optional*{id_optional <- id_optional*} = $filter_<id>(id_param_omitted*{id_param_omitted <- id_param_omitted*}, id_param_omitted <- id_optional_param*{id_optional_param <- id_optional_param*}*{id_param_omitted <- id_param_omitted*}))
  -- if $eq_set<id>(`{ id_default*{id_default <- id_default*} ++ id_optional*{id_optional <- id_optional*} `}, `{ id_param_omitted*{id_param_omitted <- id_param_omitted*} `})

  clause -1 : (callTargetId ':' V, nameIR_f `( id_arg*{id_arg <- id_arg*} `), $get_parameterListIR) = NOMATCH

def $match_overloaded_unnamed<V>(pair<callTargetId, V>, unnamedCallTargetKey, $get_parameterListIR(V) : parameterListIR) : callTargetMatch =

  clause 0 : (callTargetId ':' V, nameIR_f `( n_arg `), $get_parameterListIR) = MATCH [] []
  -- if (nameIR_f `( id_param*{id_param <- id_param*} `) = callTargetId)
  -- if (parameterIR*{parameterIR <- parameterIR*} = $get_parameterListIR(V))
  -- (if (b_default = $is_default_parameterIR(parameterIR)))*{b_default <- b_default*, parameterIR <- parameterIR*}
  -- (if (b_optional = $is_optional_parameterIR(parameterIR)))*{b_optional <- b_optional*, parameterIR <- parameterIR*}
  -- if ~($exists_(b_default*{b_default <- b_default*}) /\ $exists_(b_optional*{b_optional <- b_optional*}))
  -- if (|id_param*{id_param <- id_param*}| = n_arg)

  clause 1 : (callTargetId ':' V, nameIR_f `( n_arg `), $get_parameterListIR) = MATCH id_default*{id_default <- id_default*} []
  -- if (nameIR_f `( id_param*{id_param <- id_param*} `) = callTargetId)
  -- if (parameterIR*{parameterIR <- parameterIR*} = $get_parameterListIR(V))
  -- (if (b_default = $is_default_parameterIR(parameterIR)))*{b_default <- b_default*, parameterIR <- parameterIR*}
  -- (if (b_optional = $is_optional_parameterIR(parameterIR)))*{b_optional <- b_optional*, parameterIR <- parameterIR*}
  -- if ~($exists_(b_default*{b_default <- b_default*}) /\ $exists_(b_optional*{b_optional <- b_optional*}))
  -- if (|id_param*{id_param <- id_param*}| > n_arg)
  -- if ((parameterIR_given*{parameterIR_given <- parameterIR_given*}, parameterIR_omitted*{parameterIR_omitted <- parameterIR_omitted*}) = $partition_<parameterIR>(parameterIR*{parameterIR <- parameterIR*}, n_arg))
  -- (if ~$is_optional_parameterIR(parameterIR_omitted))*{parameterIR_omitted <- parameterIR_omitted*}
  -- (if $is_default_parameterIR(parameterIR_omitted))*{parameterIR_omitted <- parameterIR_omitted*}
  -- (if (id_default = $id_of_parameterIR(parameterIR_omitted)))*{id_default <- id_default*, parameterIR_omitted <- parameterIR_omitted*}

  clause 2 : (callTargetId ':' V, nameIR_f `( n_arg `), $get_parameterListIR) = MATCH [] id_optional*{id_optional <- id_optional*}
  -- if (nameIR_f `( id_param*{id_param <- id_param*} `) = callTargetId)
  -- if (parameterIR*{parameterIR <- parameterIR*} = $get_parameterListIR(V))
  -- (if (b_default = $is_default_parameterIR(parameterIR)))*{b_default <- b_default*, parameterIR <- parameterIR*}
  -- (if (b_optional = $is_optional_parameterIR(parameterIR)))*{b_optional <- b_optional*, parameterIR <- parameterIR*}
  -- if ~($exists_(b_default*{b_default <- b_default*}) /\ $exists_(b_optional*{b_optional <- b_optional*}))
  -- if (|id_param*{id_param <- id_param*}| > n_arg)
  -- if ((parameterIR_given*{parameterIR_given <- parameterIR_given*}, parameterIR_omitted*{parameterIR_omitted <- parameterIR_omitted*}) = $partition_<parameterIR>(parameterIR*{parameterIR <- parameterIR*}, n_arg))
  -- (if ~$is_default_parameterIR(parameterIR_given))*{parameterIR_given <- parameterIR_given*}
  -- (if $is_optional_parameterIR(parameterIR_omitted))*{parameterIR_omitted <- parameterIR_omitted*}
  -- (if (id_optional = $id_of_parameterIR(parameterIR_omitted)))*{id_optional <- id_optional*, parameterIR_omitted <- parameterIR_omitted*}

  clause -1 : (callTargetId ':' V, nameIR_f `( n_arg `), $get_parameterListIR) = NOMATCH

def $find_overloadeds_named<V>(map<callableId, V>, namedCallTargetKey, $get_parameterListIR(V) : parameterListIR) : callResolution<V>* =

  clause 0 : (`{ [] `}, nameIR_f `( id_arg*{id_arg <- id_arg*} `), $get_parameterListIR) = []

  clause 1 : (`{ callTargetId_h ':' V_h :: callTargetId_t ':' V_t*{V_t <- V_t*, callTargetId_t <- callTargetId_t*} `}, nameIR_f `( id_arg*{id_arg <- id_arg*} `), $get_parameterListIR) = $find_overloadeds_named<V>(`{ callTargetId_t ':' V_t*{V_t <- V_t*, callTargetId_t <- callTargetId_t*} `}, nameIR_f `( id_arg*{id_arg <- id_arg*} `), $get_parameterListIR)
  -- if (NOMATCH = $match_overloaded_named<V>(callTargetId_h ':' V_h, nameIR_f `( id_arg*{id_arg <- id_arg*} `), $get_parameterListIR))

  clause 2 : (`{ callTargetId_h ':' V_h :: callTargetId_t ':' V_t*{V_t <- V_t*, callTargetId_t <- callTargetId_t*} `}, nameIR_f `( id_arg*{id_arg <- id_arg*} `), $get_parameterListIR) = callTargetId_h ':' V_h '#' id_default*{id_default <- id_default*} '#' id_optional*{id_optional <- id_optional*} :: $find_overloadeds_named<V>(`{ callTargetId_t ':' V_t*{V_t <- V_t*, callTargetId_t <- callTargetId_t*} `}, nameIR_f `( id_arg*{id_arg <- id_arg*} `), $get_parameterListIR)
  -- if (MATCH id_default*{id_default <- id_default*} id_optional*{id_optional <- id_optional*} = $match_overloaded_named<V>(callTargetId_h ':' V_h, nameIR_f `( id_arg*{id_arg <- id_arg*} `), $get_parameterListIR))

def $find_overloadeds_unnamed<V>(map<callableId, V>, unnamedCallTargetKey, $get_parameterListIR(V) : parameterListIR) : callResolution<V>* =

  clause 0 : (`{ [] `}, nameIR_f `( nat `), $get_parameterListIR) = []

  clause 1 : (`{ callTargetId_h ':' V_h :: callTargetId_t ':' V_t*{V_t <- V_t*, callTargetId_t <- callTargetId_t*} `}, nameIR_f `( n_arg `), $get_parameterListIR) = $find_overloadeds_unnamed<V>(`{ callTargetId_t ':' V_t*{V_t <- V_t*, callTargetId_t <- callTargetId_t*} `}, nameIR_f `( n_arg `), $get_parameterListIR)
  -- if (NOMATCH = $match_overloaded_unnamed<V>(callTargetId_h ':' V_h, nameIR_f `( n_arg `), $get_parameterListIR))

  clause 2 : (`{ callTargetId_h ':' V_h :: callTargetId_t ':' V_t*{V_t <- V_t*, callTargetId_t <- callTargetId_t*} `}, nameIR_f `( n_arg `), $get_parameterListIR) = callTargetId_h ':' V_h '#' id_default*{id_default <- id_default*} '#' id_optional*{id_optional <- id_optional*} :: $find_overloadeds_unnamed<V>(`{ callTargetId_t ':' V_t*{V_t <- V_t*, callTargetId_t <- callTargetId_t*} `}, nameIR_f `( n_arg `), $get_parameterListIR)
  -- if (MATCH id_default*{id_default <- id_default*} id_optional*{id_optional <- id_optional*} = $match_overloaded_unnamed<V>(callTargetId_h ':' V_h, nameIR_f `( n_arg `), $get_parameterListIR))

def $find_overloaded<V>(map<callTargetId, V>, callTargetKey, $get_parameterListIR(V) : parameterListIR) : callResolution<V>? =

  clause 0 : (`{ callableId ':' V*{V <- V*, callableId <- callableId*} `}, nameIR_f `( id_arg?{id_arg <- id_arg?}*{id_arg? <- id_arg?*} `), $get_parameterListIR) = ?()
  -- if (|id_arg?{id_arg <- id_arg?}*{id_arg? <- id_arg?*}| > 0)
  -- (if (?(id_arg_inner) = id_arg?{id_arg <- id_arg?}))*{id_arg? <- id_arg?*, id_arg_inner <- id_arg_inner*}
  -- if ([] = $find_overloadeds_named<V>(`{ callableId ':' V*{V <- V*, callableId <- callableId*} `}, nameIR_f `( id_arg_inner*{id_arg_inner <- id_arg_inner*} `), $get_parameterListIR))

  clause 1 : (`{ callableId ':' V*{V <- V*, callableId <- callableId*} `}, nameIR_f `( id_arg?{id_arg <- id_arg?}*{id_arg? <- id_arg?*} `), $get_parameterListIR) = ?(callableId_found ':' V_found '#' id_default*{id_default <- id_default*} '#' id_optional*{id_optional <- id_optional*})
  -- if (|id_arg?{id_arg <- id_arg?}*{id_arg? <- id_arg?*}| > 0)
  -- (if (?(id_arg_inner) = id_arg?{id_arg <- id_arg?}))*{id_arg? <- id_arg?*, id_arg_inner <- id_arg_inner*}
  -- if ([callableId_found ':' V_found '#' id_default*{id_default <- id_default*} '#' id_optional*{id_optional <- id_optional*}] = $find_overloadeds_named<V>(`{ callableId ':' V*{V <- V*, callableId <- callableId*} `}, nameIR_f `( id_arg_inner*{id_arg_inner <- id_arg_inner*} `), $get_parameterListIR))

  clause 2 : (`{ callableId ':' V*{V <- V*, callableId <- callableId*} `}, nameIR_f `( id_arg?{id_arg <- id_arg?}*{id_arg? <- id_arg?*} `), $get_parameterListIR) = ?()
  -- (if (id_arg?{id_arg <- id_arg?} = ?()))*{id_arg? <- id_arg?*}
  -- if ([] = $find_overloadeds_unnamed<V>(`{ callableId ':' V*{V <- V*, callableId <- callableId*} `}, nameIR_f `( |id_arg?{id_arg <- id_arg?}*{id_arg? <- id_arg?*}| `), $get_parameterListIR))

  clause 3 : (`{ callableId ':' V*{V <- V*, callableId <- callableId*} `}, nameIR_f `( id_arg?{id_arg <- id_arg?}*{id_arg? <- id_arg?*} `), $get_parameterListIR) = ?(callableId_found ':' V_found '#' id_omitted*{id_omitted <- id_omitted*} '#' id_optional*{id_optional <- id_optional*})
  -- (if (id_arg?{id_arg <- id_arg?} = ?()))*{id_arg? <- id_arg?*}
  -- if ([callableId_found ':' V_found '#' id_omitted*{id_omitted <- id_omitted*} '#' id_optional*{id_optional <- id_optional*}] = $find_overloadeds_unnamed<V>(`{ callableId ':' V*{V <- V*, callableId <- callableId*} `}, nameIR_f `( |id_arg?{id_arg <- id_arg?}*{id_arg? <- id_arg?*}| `), $get_parameterListIR))

def $find_non_overloaded<V>(map<callableId, V>, nameIR) : (callableId, V)? =

  clause 0 : (`{ callableId ':' V*{V <- V*, callableId <- callableId*} `}, nameIR_f) = ?((callableId_found, V_found))
  -- if ([(callableId_found, V_found)] = $find_non_overloadeds<V>(`{ callableId ':' V*{V <- V*, callableId <- callableId*} `}, nameIR_f))

  clause -1 : (`{ callableId ':' V*{V <- V*, callableId <- callableId*} `}, nameIR_f) = ?()

def $find_non_overloadeds<V>(map<callableId, V>, nameIR) : (callableId, V)* =

  clause 0 : (`{ [] `}, nameIR_f) = []

  clause 1 : (`{ callableId_h ':' V_h :: callableId_t ':' V_t*{V_t <- V_t*, callableId_t <- callableId_t*} `}, nameIR_f) = (callableId_h, V_h) :: (callableId_t_found, V_t_found)*{V_t_found <- V_t_found*, callableId_t_found <- callableId_t_found*}
  -- if (nameIR_f `( _id*{_id <- _id*} `) = callableId_h)
  -- if ((callableId_t_found, V_t_found)*{V_t_found <- V_t_found*, callableId_t_found <- callableId_t_found*} = $find_non_overloadeds<V>(`{ callableId_t ':' V_t*{V_t <- V_t*, callableId_t <- callableId_t*} `}, nameIR_f))

  clause 2 : (`{ callableId_h ':' V_h :: callableId_t ':' V_t*{V_t <- V_t*, callableId_t <- callableId_t*} `}, nameIR_f) = (callableId_t_found, V_t_found)*{V_t_found <- V_t_found*, callableId_t_found <- callableId_t_found*}
  -- if (nameIR_f_h `( _id*{_id <- _id*} `) = callableId_h)
  -- if (nameIR_f =/= nameIR_f_h)
  -- if ((callableId_t_found, V_t_found)*{V_t_found <- V_t_found*, callableId_t_found <- callableId_t_found*} = $find_non_overloadeds<V>(`{ callableId_t ':' V_t*{V_t <- V_t*, callableId_t <- callableId_t*} `}, nameIR_f))

def $name_annotation(annotationList) : nameIR* =

  clause 0 : (annotationList) = $concat_<nameIR>(nameIR_found*{nameIR_found <- nameIR_found*}*{nameIR_found* <- nameIR_found**})
  -- if (annotation*{annotation <- annotation*} = $flatten_annotationList(annotationList))
  -- (if (nameIR_opt?{nameIR_opt <- nameIR_opt?} = $name_annotation_opt(annotation)))*{annotation <- annotation*, nameIR_opt? <- nameIR_opt?*}
  -- if (nameIR_found*{nameIR_found <- nameIR_found*}*{nameIR_found* <- nameIR_found**} = $opt_as_seq_<nameIR>(nameIR_opt?{nameIR_opt <- nameIR_opt?})*{nameIR_opt? <- nameIR_opt?*})

def $name_annotation_opt(annotation) : nameIR? =

  clause 0 : ('@' name `( annotationBody `)) = ?($strip_prefix($strip_suffix(nameIR, "\""), "\""))
  -- if ("name" = $name(name))
  -- if (_EMPTY annotationToken = annotationBody)
  -- if (nameIR = $print_<annotationToken>(annotationToken))

  clause -1 : (annotation) = ?()

def $name_annotation_default(annotationList, nameIR) : nameIR =

  clause 0 : (annotationList, nameIR) = nameIR_found
  -- if ([nameIR_found] = $name_annotation(annotationList))

  clause 1 : (annotationList, nameIR) = nameIR
  -- if ([] = $name_annotation(annotationList))

def $find_name_annotation_opt(annotationList) : annotation? =

  clause 0 : (_EMPTY) = ?()

  clause 1 : (annotation as annotationList) = ?(annotation)
  -- if ('@' name `( annotationBody `) = annotation)
  -- if ("name" = $name(name))

  clause 2 : (annotation as annotationList) = ?()
  -- if ('@' name `( annotationBody `) = annotation)
  -- if ("name" =/= $name(name))

  clause 3 : (annotationListNonEmpty annotation as annotationList) = $find_name_annotation_opt(annotationListNonEmpty as annotationList)
  -- if (?() = $find_name_annotation_opt(annotation as annotationList))

  clause 4 : (annotationListNonEmpty annotation as annotationList) = ?(annotation_found)
  -- if (?(annotation_found) = $find_name_annotation_opt(annotation as annotationList))

  clause -1 : (_annotationList) = ?()

def $add_annotationList(annotationList, annotation?) : annotationList =

  clause 0 : (annotationList, ?()) = annotationList

  clause 1 : (_EMPTY, ?(annotation)) = annotation as annotationList

  clause 2 : (annotationListNonEmpty as annotationList, ?(annotation)) = annotationListNonEmpty annotation as annotationList

def $subexpressions_of_typedExpressionIR(typedExpressionIR) : typedExpressionListIR =

  clause 0 : (typedExpressionIR) = typedExpressionIR :: $subexpressions_of_expressionIR(expressionIR)
  -- if (expressionIR '#' _expressionNoteIR = typedExpressionIR)

def $subexpressions_of_typedExpressionListIR(typedExpressionListIR) : typedExpressionListIR =

  clause 0 : (typedExpressionIR*{typedExpressionIR <- typedExpressionIR*}) = $concat_<typedExpressionIR>($subexpressions_of_typedExpressionIR(typedExpressionIR)*{typedExpressionIR <- typedExpressionIR*})

def $subexpressions_of_expressionIR(expressionIR) : typedExpressionListIR =

  clause 0 : (unop typedExpressionIR as expressionIR) = $subexpressions_of_typedExpressionIR(typedExpressionIR)

  clause 1 : (typedExpressionIR_l binop typedExpressionIR_r as expressionIR) = $subexpressions_of_typedExpressionIR(typedExpressionIR_l) ++ $subexpressions_of_typedExpressionIR(typedExpressionIR_r)

  clause 2 : (typedExpressionIR_cond '?' typedExpressionIR_then ':' typedExpressionIR_else as expressionIR) = $subexpressions_of_typedExpressionIR(typedExpressionIR_cond) ++ $subexpressions_of_typedExpressionIR(typedExpressionIR_then) ++ $subexpressions_of_typedExpressionIR(typedExpressionIR_else)

  clause 3 : (`( typeIR `) typedExpressionIR as expressionIR) = $subexpressions_of_typedExpressionIR(typedExpressionIR)

  clause 4 : (SEQ `{ typedExpressionListIR `} as expressionIR) = $subexpressions_of_typedExpressionListIR(typedExpressionListIR)

  clause 5 : (SEQ `{ typedExpressionListIR ',' '...' `} as expressionIR) = $subexpressions_of_typedExpressionListIR(typedExpressionListIR)

  clause 6 : (RECORD `{ nameIR '=' typedExpressionIR*{nameIR <- nameIR*, typedExpressionIR <- typedExpressionIR*} `} as expressionIR) = $subexpressions_of_typedExpressionListIR(typedExpressionIR*{typedExpressionIR <- typedExpressionIR*})

  clause 7 : (RECORD `{ nameIR '=' typedExpressionIR*{nameIR <- nameIR*, typedExpressionIR <- typedExpressionIR*} ',' '...' `} as expressionIR) = $subexpressions_of_typedExpressionListIR(typedExpressionIR*{typedExpressionIR <- typedExpressionIR*})

  clause 8 : (typedExpressionIR as memberAccessBaseIR '.' nameIR as expressionIR) = $subexpressions_of_typedExpressionIR(typedExpressionIR)

  clause 9 : (typedExpressionIR_base `[ typedExpressionIR_index `] as expressionIR) = $subexpressions_of_typedExpressionIR(typedExpressionIR_base) ++ $subexpressions_of_typedExpressionIR(typedExpressionIR_index)

  clause 10 : (typedExpressionIR_base `[ typedExpressionIR_hi ':' typedExpressionIR_lo `] as expressionIR) = $subexpressions_of_typedExpressionIR(typedExpressionIR_base) ++ $subexpressions_of_typedExpressionIR(typedExpressionIR_hi) ++ $subexpressions_of_typedExpressionIR(typedExpressionIR_lo)

  clause 11 : (constructorTargetIR `( argumentIR*{argumentIR <- argumentIR*} `) as expressionIR) = $subexpressions_of_argumentListIR(argumentIR*{argumentIR <- argumentIR*})

  clause 12 : (callableTargetIR `< typeArgumentIR*{typeArgumentIR <- typeArgumentIR*} `> `( argumentIR*{argumentIR <- argumentIR*} `) as expressionIR) = $subexpressions_of_argumentListIR(argumentIR*{argumentIR <- argumentIR*})

  clause 13 : (`( typedExpressionIR `) as expressionIR) = $subexpressions_of_typedExpressionIR(typedExpressionIR)

  clause -1 : (_expressionIR) = []

def $subexpressions_of_argumentIR(argumentIR) : typedExpressionListIR =

  clause 0 : (typedExpressionIR as argumentIR) = $subexpressions_of_typedExpressionIR(typedExpressionIR)

  clause 1 : (nameIR '=' typedExpressionIR) = $subexpressions_of_typedExpressionIR(typedExpressionIR)

  clause -1 : (_argumentIR) = []

def $subexpressions_of_argumentListIR(argumentListIR) : typedExpressionListIR =

  clause 0 : (argumentIR*{argumentIR <- argumentIR*}) = $concat_<typedExpressionIR>($subexpressions_of_argumentIR(argumentIR)*{argumentIR <- argumentIR*})

def $sink<T> : T =

def $lift_nameIR_as_identifier(nameIR) : identifier =

  clause 0 : (nameIR) = _ID nameIR

def $lift_nameIR_as_typeIdentifier(nameIR) : typeIdentifier =

  clause 0 : (nameIR) = _TID nameIR

def $lift_nameIR_as_nonTypeName(nameIR) : nonTypeName =

  clause 0 : ("apply") = APPLY

  clause 1 : ("key") = KEY

  clause 2 : ("actions") = ACTIONS

  clause 3 : ("state") = STATE

  clause 4 : ("entries") = ENTRIES

  clause 5 : ("type") = TYPE

  clause 6 : ("priority") = PRIORITY

  clause -1 : (nameIR) = _ID nameIR as nonTypeName

def $lift_prefixedNameIR_as_prefixedNonTypeName(prefixedNameIR) : prefixedNonTypeName =

  clause 0 : (_BARE nameIR) = $lift_nameIR_as_nonTypeName(nameIR) as prefixedNonTypeName

  clause 1 : ('.' nameIR) = _ID '.' $lift_nameIR_as_nonTypeName(nameIR)

def $lift_nameIR_as_typeName(nameIR) : typeName =

  clause 0 : (nameIR) = $lift_nameIR_as_typeIdentifier(nameIR)

def $lift_prefixedNameIR_as_prefixedTypeName(prefixedNameIR) : prefixedTypeName =

  clause 0 : (_BARE nameIR) = $lift_nameIR_as_typeName(nameIR) as prefixedTypeName

  clause 1 : ('.' nameIR) = _TID '.' $lift_nameIR_as_typeName(nameIR)

def $lift_nameIR_as_tableCustomName(nameIR) : tableCustomName =

  clause 0 : ("apply") = APPLY

  clause 1 : ("state") = STATE

  clause 2 : ("type") = TYPE

  clause 3 : ("priority") = PRIORITY

  clause -1 : (nameIR) = $lift_nameIR_as_identifier(nameIR) as tableCustomName

def $lift_nameListIR_as_nonTypeNameList(nameIR*) : nameList =

  clause 0 : (nameIR*{nameIR <- nameIR*}) = nameList
  -- (if (name = $lift_nameIR_as_nonTypeName(nameIR) as name))*{name <- name*, nameIR <- nameIR*}
  -- if (nameList = $unflatten_nameList(name*{name <- name*}))

def $unflatten_nameList(name*) : nameList =

  clause 0 : (name_h :: name_t*{name_t <- name_t*}) = $unflatten_nameList'(name_h as nameList, name_t*{name_t <- name_t*})

def $unflatten_nameList'(nameList, name*) : nameList =

  clause 0 : (nameList, []) = nameList

  clause 1 : (nameList, name_h :: name_t*{name_t <- name_t*}) = $unflatten_nameList'(nameList ',' name_h, name_t*{name_t <- name_t*})

def $lift_nameIR_as_member(nameIR) : member =

  clause 0 : (nameIR) = $lift_nameIR_as_nonTypeName(nameIR) as member

def $lift_value(value) : expression =

  clause -1 : (value) = $sink<expression>
  -- debug value

def $lift_typeIR(typeIR) : type =

  clause 0 : (baseTypeIR as typeIR) = $lift_baseTypeIR(baseTypeIR) as type

  clause 1 : (nameTypeIR as typeIR) = $lift_nameTypeIR(nameTypeIR) as type

  clause 2 : (aliasTypeIR as typeIR) = $lift_aliasTypeIR(aliasTypeIR)

  clause 3 : (dataTypeIR as typeIR) = $lift_dataTypeIR(dataTypeIR)

  clause -1 : (typeIR) = $sink<type>
  -- debug typeIR

def $lift_baseTypeIR(baseTypeIR) : baseType =

  clause 0 : (BOOL as baseTypeIR) = BOOL

  clause 1 : (ERROR as baseTypeIR) = ERROR

  clause 2 : (ERROR as baseTypeIR) = ERROR

  clause 3 : (MATCH_KIND as baseTypeIR) = MATCH_KIND

  clause 4 : (STRING as baseTypeIR) = STRING

  clause 5 : (INT as baseTypeIR) = INT

  clause 6 : (INT `< w `> as baseTypeIR) = INT `< w as int `>

  clause 7 : (BIT `< w `> as baseTypeIR) = BIT `< w as int `>

  clause 8 : (VARBIT `< w `> as baseTypeIR) = VARBIT `< w as int `>

def $lift_typeDefIR_as_typeName(typeDefIR) : typeName =

  clause 0 : (_NAME typeId as typeDefIR) = typeName
  -- if (typeName = $lift_nameIR_as_typeName(typeId))

  clause 1 : (TYPEDEF typeId _typeIR as typeDefIR) = typeName
  -- if (typeName = $lift_nameIR_as_typeName(typeId))

  clause 2 : (TYPE typeId _typeIR as typeDefIR) = typeName
  -- if (typeName = $lift_nameIR_as_typeName(typeId))

  clause 3 : (STRUCT typeId `< _typeParameterIR*{_typeParameterIR <- _typeParameterIR*} `> `{ _fieldTypeIR*{_fieldTypeIR <- _fieldTypeIR*} `} as typeDefIR) = typeName
  -- if (typeName = $lift_nameIR_as_typeName(typeId))

  clause 4 : (HEADER typeId `< _typeParameterIR*{_typeParameterIR <- _typeParameterIR*} `> `{ _fieldTypeIR*{_fieldTypeIR <- _fieldTypeIR*} `} as typeDefIR) = typeName
  -- if (typeName = $lift_nameIR_as_typeName(typeId))

  clause 5 : (HEADER_UNION typeId `< _typeParameterIR*{_typeParameterIR <- _typeParameterIR*} `> `{ _fieldTypeIR*{_fieldTypeIR <- _fieldTypeIR*} `} as typeDefIR) = typeName
  -- if (typeName = $lift_nameIR_as_typeName(typeId))

  clause 6 : (ENUM typeId `{ _nameIR*{_nameIR <- _nameIR*} `} as typeDefIR) = typeName
  -- if (typeName = $lift_nameIR_as_typeName(typeId))

  clause 7 : (ENUM typeId `< _typeIR `> `{ _valueFieldIR*{_valueFieldIR <- _valueFieldIR*} `} as typeDefIR) = typeName
  -- if (typeName = $lift_nameIR_as_typeName(typeId))

  clause 8 : (EXTERN typeId `< _typeParameterIR*{_typeParameterIR <- _typeParameterIR*} ',' _typeParameterIR'*{_typeParameterIR' <- _typeParameterIR'*} `> _externMethodTypeDefEnv as typeDefIR) = typeName
  -- if (typeName = $lift_nameIR_as_typeName(typeId))

  clause 9 : (PARSER typeId `< _typeParameterIR*{_typeParameterIR <- _typeParameterIR*} ',' _typeParameterIR'*{_typeParameterIR' <- _typeParameterIR'*} `> `( _parameterIR*{_parameterIR <- _parameterIR*} `) as typeDefIR) = typeName
  -- if (typeName = $lift_nameIR_as_typeName(typeId))

  clause 10 : (CONTROL typeId `< _typeParameterIR*{_typeParameterIR <- _typeParameterIR*} ',' _typeParameterIR'*{_typeParameterIR' <- _typeParameterIR'*} `> `( _parameterIR*{_parameterIR <- _parameterIR*} `) as typeDefIR) = typeName
  -- if (typeName = $lift_nameIR_as_typeName(typeId))

  clause 11 : (PACKAGE typeId `< _typeParameterIR*{_typeParameterIR <- _typeParameterIR*} ',' _typeParameterIR'*{_typeParameterIR' <- _typeParameterIR'*} `> `{ _typeIR*{_typeIR <- _typeIR*} `} as typeDefIR) = typeName
  -- if (typeName = $lift_nameIR_as_typeName(typeId))

  clause 12 : (TABLE typeId `{ _tableMetadataStructTypeIR `} as typeDefIR) = typeName
  -- if (typeName = $lift_nameIR_as_typeName(typeId))

  clause -1 : (typeDefIR) = $sink<typeName>
  -- debug typeDefIR

def $lift_typeArgumentListIR(typeArgumentIR*) : typeArgumentList =

  clause 0 : (typeArgumentIR*{typeArgumentIR <- typeArgumentIR*}) = typeArgumentList
  -- (if (typeArgument = $lift_typeArgumentIR(typeArgumentIR)))*{typeArgument <- typeArgument*, typeArgumentIR <- typeArgumentIR*}
  -- if (typeArgumentList = $unflatten_typeArgumentList(typeArgument*{typeArgument <- typeArgument*}))

def $lift_nameTypeIR(nameTypeIR) : namedType =

  clause 0 : (_NAME typeId) = typeName as namedType
  -- if (typeName = $lift_nameIR_as_typeName(typeId))

def $lift_aliasTypeIR(aliasTypeIR) : type =

  clause 0 : (TYPEDEF typeId _typeIR as aliasTypeIR) = typeName as type
  -- if (typeName = $lift_nameIR_as_typeName(typeId))

  clause 1 : (TYPE typeId _typeIR as aliasTypeIR) = typeName as type
  -- if (typeName = $lift_nameIR_as_typeName(typeId))

def $lift_typeArgumentIR(typeArgumentIR) : typeArgument =

  clause 0 : (typeIR) = $lift_typeArgumentIR_as_realTypeArgument(typeIR) as typeArgument

def $lift_dataTypeIR(dataTypeIR) : type =

  clause 0 : (LIST `< typeIR `> as dataTypeIR) = LIST `< typeArgument `> as type
  -- if (typeArgument = $lift_typeArgumentIR(typeIR))

  clause 1 : (TUPLE `< typeIR*{typeIR <- typeIR*} `> as dataTypeIR) = TUPLE `< typeArgumentList `> as type
  -- if (typeArgumentList = $lift_typeArgumentListIR(typeIR*{typeIR <- typeIR*}))

  clause 2 : (ARRAY typeIR `[ n `] as dataTypeIR) = type `[ D n as int as expression `] as type
  -- if (type = $lift_typeIR(typeIR))

  clause 3 : (HEADER_STACK typeIR `[ n `] as dataTypeIR) = type `[ D n as int as expression `] as type
  -- if (type = $lift_typeIR(typeIR))

  clause 4 : (ENUM typeId `{ _nameIR*{_nameIR <- _nameIR*} `} as dataTypeIR) = typeName as type
  -- if (typeName = $lift_nameIR_as_typeName(typeId))

  clause 5 : (ENUM typeId `< typeIR `> `{ _valueFieldIR*{_valueFieldIR <- _valueFieldIR*} `} as dataTypeIR) = typeName as prefixedTypeName `< typeArgument as typeArgumentList `> as type
  -- if (typeName = $lift_nameIR_as_typeName(typeId))
  -- if (typeArgument = $lift_typeArgumentIR(typeIR))

def $lift_typeIR_as_typeOrVoid(typeIR) : typeOrVoid =

  clause 0 : (VOID as typeIR) = VOID

  clause 1 : (typeIR) = $lift_typeIR(typeIR) as typeOrVoid
  -- if (typeIR =/= VOID as typeIR)

def $lift_typeParameterIR(typeParameterIR) : typeParameter =

  clause 0 : (typeId) = typeParameter
  -- if (typeParameter = $lift_nameIR_as_typeName(typeId) as typeParameter)

def $lift_typeParameterListIR(typeParameterIR*) : typeParameterListOpt =

  clause 0 : (typeParameterIR*{typeParameterIR <- typeParameterIR*}) = typeParameterListOpt
  -- (if (typeParameter = $lift_typeParameterIR(typeParameterIR)))*{typeParameter <- typeParameter*, typeParameterIR <- typeParameterIR*}
  -- if (typeParameterListOpt = $unflatten_typeParameterListOpt(typeParameter*{typeParameter <- typeParameter*}))

def $unflatten_typeParameterListOpt(typeParameter*) : typeParameterListOpt =

  clause 0 : ([]) = _EMPTY

  clause 1 : (typeParameter_h :: typeParameter_t*{typeParameter_t <- typeParameter_t*}) = `< $unflatten_typeParameterList(typeParameter_h :: typeParameter_t*{typeParameter_t <- typeParameter_t*}) `>

def $unflatten_typeParameterList(typeParameter*) : typeParameterList =

  clause 0 : (typeParameter*{typeParameter <- typeParameter*}) = $unflatten_typeParameterList'(typeParameter_h as typeParameterList, typeParameter_t*{typeParameter_t <- typeParameter_t*})
  -- if (typeParameter_h :: typeParameter_t*{typeParameter_t <- typeParameter_t*} = typeParameter*{typeParameter <- typeParameter*})

def $unflatten_typeParameterList'(typeParameterList, typeParameter*) : typeParameterList =

  clause 0 : (typeParameterList, []) = typeParameterList

  clause 1 : (typeParameterList, typeParameter_h :: typeParameter_t*{typeParameter_t <- typeParameter_t*}) = $unflatten_typeParameterList'(typeParameterList ',' typeParameter_h, typeParameter_t*{typeParameter_t <- typeParameter_t*})

def $lift_constantInitializerOptIR_as_initializerOpt(constantInitializerIR?) : initializerOpt =

  clause 0 : (?()) = _EMPTY

  clause 1 : (?(constantInitializerIR)) = $lift_constantInitializerIR_as_initializer(constantInitializerIR) as initializerOpt

def $lift_parameterIR(parameterIR) : parameter =

  clause 0 : (annotationList direction typeIR nameIR constantInitializerIR?{constantInitializerIR <- constantInitializerIR?} as parameterInitializerOptIR) = annotationList direction type name initializerOpt
  -- if (type = $lift_typeIR(typeIR))
  -- if (name = $lift_nameIR_as_nonTypeName(nameIR) as name)
  -- if (initializerOpt = $lift_constantInitializerOptIR_as_initializerOpt(constantInitializerIR?{constantInitializerIR <- constantInitializerIR?}))

def $lift_parameterListIR(parameterIR*) : parameterList =

  clause 0 : (parameterIR*{parameterIR <- parameterIR*}) = parameterList
  -- (if (parameter = $lift_parameterIR(parameterIR)))*{parameter <- parameter*, parameterIR <- parameterIR*}
  -- if (parameterList = $unflatten_parameterList(parameter*{parameter <- parameter*}))

def $unflatten_parameterList(parameter*) : parameterList =

  clause 0 : ([]) = _EMPTY

  clause 1 : (parameter_h :: parameter_t*{parameter_t <- parameter_t*}) = $unflatten_nonEmptyParameterList(parameter_h :: parameter_t*{parameter_t <- parameter_t*}) as parameterList

def $unflatten_nonEmptyParameterList(parameter*) : nonEmptyParameterList =

  clause 0 : (parameter*{parameter <- parameter*}) = $unflatten_nonEmptyParameterList'(parameter_h as nonEmptyParameterList, parameter_t*{parameter_t <- parameter_t*})
  -- if (parameter_h :: parameter_t*{parameter_t <- parameter_t*} = parameter*{parameter <- parameter*})

def $unflatten_nonEmptyParameterList'(nonEmptyParameterList, parameter*) : nonEmptyParameterList =

  clause 0 : (nonEmptyParameterList, []) = nonEmptyParameterList

  clause 1 : (nonEmptyParameterList, parameter_h :: parameter_t*{parameter_t <- parameter_t*}) = $unflatten_nonEmptyParameterList'(nonEmptyParameterList ',' parameter_h, parameter_t*{parameter_t <- parameter_t*})

def $lift_constructorParameterIR(constructorParameterIR) : constructorParameter =

  clause 0 : (constructorParameterIR) = $lift_parameterIR(constructorParameterIR)

def $lift_constructorParameterListIR(constructorParameterIR*) : constructorParameterListOpt =

  clause 0 : (constructorParameterIR*{constructorParameterIR <- constructorParameterIR*}) = constructorParameterListOpt
  -- (if (constructorParameter = $lift_constructorParameterIR(constructorParameterIR)))*{constructorParameter <- constructorParameter*, constructorParameterIR <- constructorParameterIR*}
  -- if (constructorParameterListOpt = $unflatten_constructorParameterList(constructorParameter*{constructorParameter <- constructorParameter*}))

def $unflatten_constructorParameterList(constructorParameter*) : constructorParameterListOpt =

  clause 0 : ([]) = _EMPTY

  clause 1 : (constructorParameter*{constructorParameter <- constructorParameter*}) = `( $unflatten_parameterList(constructorParameter*{constructorParameter <- constructorParameter*}) `)
  -- if (constructorParameter*{constructorParameter <- constructorParameter*} =/= [])

def $lift_typedExpressionIR(typedExpressionIR) : expression =

  clause 0 : (expressionIR '#' _expressionNoteIR) = $lift_expressionIR(expressionIR)

def $lift_initializerIR(initializerIR) : initializer =

  clause 0 : ('=' typedExpressionIR) = '=' expression
  -- if (expression = $lift_typedExpressionIR(typedExpressionIR))

def $lift_initializerOptIR(initializerIR?) : initializerOpt =

  clause 0 : (?()) = _EMPTY

  clause 1 : (?(initializerIR)) = $lift_initializerIR(initializerIR) as initializerOpt

def $lift_constantInitializerIR_as_initializer(constantInitializerIR) : initializer =

  clause 0 : ('=' _VALUE value) = '=' expression
  -- if (expression = $lift_value(value))

def $lift_namedExpressionIR(namedExpressionIR) : namedExpression =

  clause 0 : (nameIR '=' typedExpressionIR) = name '=' expression
  -- if (name = $lift_nameIR_as_nonTypeName(nameIR) as name)
  -- if (expression = $lift_typedExpressionIR(typedExpressionIR))

def $lift_namedExpressionListIR(namedExpressionIR*) : namedExpressionList =

  clause 0 : (namedExpressionIR*{namedExpressionIR <- namedExpressionIR*}) = namedExpressionList
  -- (if (namedExpression = $lift_namedExpressionIR(namedExpressionIR)))*{namedExpression <- namedExpression*, namedExpressionIR <- namedExpressionIR*}
  -- if (namedExpressionList = $unflatten_namedExpressionList(namedExpression*{namedExpression <- namedExpression*}))

def $unflatten_namedExpressionList(namedExpression*) : namedExpressionList =

  clause 0 : (namedExpression*{namedExpression <- namedExpression*}) = $unflatten_namedExpressionList'(namedExpression_h as namedExpressionList, namedExpression_t*{namedExpression_t <- namedExpression_t*})
  -- if (namedExpression_h :: namedExpression_t*{namedExpression_t <- namedExpression_t*} = namedExpression*{namedExpression <- namedExpression*})

def $unflatten_namedExpressionList'(namedExpressionList, namedExpression*) : namedExpressionList =

  clause 0 : (namedExpressionList, []) = namedExpressionList

  clause 1 : (namedExpressionList, namedExpression_h :: namedExpression_t*{namedExpression_t <- namedExpression_t*}) = $unflatten_namedExpressionList'(namedExpressionList ',' namedExpression_h, namedExpression_t*{namedExpression_t <- namedExpression_t*})

def $lift_namedValueIR(namedValueIR) : namedExpression =

  clause 0 : (nameIR '=' value) = name '=' expression
  -- if (name = $lift_nameIR_as_nonTypeName(nameIR) as name)
  -- if (expression = $lift_value(value))

def $lift_namedValueListIR(namedValueIR*) : namedExpressionList =

  clause 0 : (namedValueIR*{namedValueIR <- namedValueIR*}) = namedExpressionList
  -- (if (namedExpression = $lift_namedValueIR(namedValueIR)))*{namedExpression <- namedExpression*, namedValueIR <- namedValueIR*}
  -- if (namedExpressionList = $unflatten_namedExpressionList(namedExpression*{namedExpression <- namedExpression*}))

def $lift_typedExpressionListIR(typedExpressionIR*) : expressionList =

  clause 0 : (typedExpressionIR*{typedExpressionIR <- typedExpressionIR*}) = expressionList
  -- (if (expression = $lift_typedExpressionIR(typedExpressionIR)))*{expression <- expression*, typedExpressionIR <- typedExpressionIR*}
  -- if (expressionList = $unflatten_expressionList(expression*{expression <- expression*}))

def $lift_literalExpressionIR(literalExpressionIR) : literalExpression =

  clause 0 : (literalExpression) = literalExpression

def $lift_referenceExpressionIR(referenceExpressionIR) : referenceExpression =

  clause 0 : (_BARE nameIR) = THIS
  -- if (nameIR = "this")

  clause 1 : (_BARE nameIR) = nonTypeName as referenceExpression
  -- if (nameIR =/= "this")
  -- if (nonTypeName = $lift_nameIR_as_nonTypeName(nameIR))

  clause 2 : ('.' nameIR) = _ID '.' nonTypeName as referenceExpression
  -- if (nonTypeName = $lift_nameIR_as_nonTypeName(nameIR))

def $lift_defaultExpressionIR(defaultExpressionIR) : defaultExpression =

  clause 0 : ('...') = '...'

def $lift_unaryExpressionIR(unaryExpressionIR) : unaryExpression =

  clause 0 : (unop typedExpressionIR) = unop expression
  -- if (expression = $lift_typedExpressionIR(typedExpressionIR))

def $lift_binaryExpressionIR(binaryExpressionIR) : binaryExpression =

  clause 0 : (typedExpressionIR_l binop typedExpressionIR_r) = expression_l binop expression_r
  -- if (expression_l = $lift_typedExpressionIR(typedExpressionIR_l))
  -- if (expression_r = $lift_typedExpressionIR(typedExpressionIR_r))

def $lift_ternaryExpressionIR(ternaryExpressionIR) : ternaryExpression =

  clause 0 : (typedExpressionIR_cond '?' typedExpressionIR_then ':' typedExpressionIR_else) = expression_cond '?' expression_then ':' expression_else
  -- if (expression_cond = $lift_typedExpressionIR(typedExpressionIR_cond))
  -- if (expression_then = $lift_typedExpressionIR(typedExpressionIR_then))
  -- if (expression_else = $lift_typedExpressionIR(typedExpressionIR_else))

def $lift_castExpressionIR(castExpressionIR) : expression =

  clause 0 : (`( typeIR `) typedExpressionIR) = expression
  -- if (typeIR_unroll = $unroll_typeIR(typeIR))
  -- if typeIR_unroll <: setTypeIR
  -- if (expression = $lift_typedExpressionIR(typedExpressionIR))

  clause 1 : (`( typeIR `) typedExpressionIR) = `( type `) expression as expression
  -- if (typeIR_unroll = $unroll_typeIR(typeIR))
  -- if ~typeIR_unroll <: setTypeIR
  -- if (type = $lift_typeIR(typeIR))
  -- if (expression = $lift_typedExpressionIR(typedExpressionIR))

def $unflatten_recordElementExpression(namedExpression*) : recordElementExpression =

  clause 0 : ([namedExpression_h]) = name_h '=' expression_h
  -- if (name_h '=' expression_h = namedExpression_h)

  clause 1 : (namedExpression_h :: namedExpression_t*{namedExpression_t <- namedExpression_t*}) = name_h '=' expression_h ',' namedExpressionList
  -- if (namedExpression_t*{namedExpression_t <- namedExpression_t*} =/= [])
  -- if (name_h '=' expression_h = namedExpression_h)
  -- if (namedExpressionList = $unflatten_namedExpressionList(namedExpression_t*{namedExpression_t <- namedExpression_t*}))

def $unflatten_recordElementExpression_with_default(namedExpression*) : recordElementExpression =

  clause 0 : ([namedExpression_h]) = name_h '=' expression_h ',' '...'
  -- if (name_h '=' expression_h = namedExpression_h)

  clause 1 : (namedExpression_h :: namedExpression_t*{namedExpression_t <- namedExpression_t*}) = name_h '=' expression_h ',' namedExpressionList ',' '...'
  -- if (namedExpression_t*{namedExpression_t <- namedExpression_t*} =/= [])
  -- if (name_h '=' expression_h = namedExpression_h)
  -- if (namedExpressionList = $unflatten_namedExpressionList(namedExpression_t*{namedExpression_t <- namedExpression_t*}))

def $lift_dataExpressionIR(dataExpressionIR) : dataExpression =

  clause 0 : ('{#}' as dataExpressionIR) = '{#}' as dataExpression

  clause 1 : (SEQ `{ typedExpressionIR*{typedExpressionIR <- typedExpressionIR*} `} as dataExpressionIR) = `{ expressionList as sequenceOrRecordElementExpression _EMPTY `} as dataExpression
  -- if (expressionList = $lift_typedExpressionListIR(typedExpressionIR*{typedExpressionIR <- typedExpressionIR*}))

  clause 2 : (SEQ `{ typedExpressionIR*{typedExpressionIR <- typedExpressionIR*} ',' '...' `} as dataExpressionIR) = `{ expressionList as sequenceOrRecordElementExpression _EMPTY `} as dataExpression
  -- (if (expression = $lift_typedExpressionIR(typedExpressionIR)))*{expression <- expression*, typedExpressionIR <- typedExpressionIR*}
  -- if (expression_with_default*{expression_with_default <- expression_with_default*} = expression*{expression <- expression*} ++ ['...' as expression])
  -- if (expressionList = $lift_typedExpressionListIR(typedExpressionIR*{typedExpressionIR <- typedExpressionIR*}))

  clause 3 : (RECORD `{ namedExpressionIR*{namedExpressionIR <- namedExpressionIR*} `} as dataExpressionIR) = `{ recordElementExpression as sequenceOrRecordElementExpression _EMPTY `} as dataExpression
  -- (if (namedExpression = $lift_namedExpressionIR(namedExpressionIR)))*{namedExpression <- namedExpression*, namedExpressionIR <- namedExpressionIR*}
  -- if (recordElementExpression = $unflatten_recordElementExpression(namedExpression*{namedExpression <- namedExpression*}))

  clause 4 : (RECORD `{ namedExpressionIR*{namedExpressionIR <- namedExpressionIR*} ',' '...' `} as dataExpressionIR) = `{ recordElementExpression as sequenceOrRecordElementExpression _EMPTY `} as dataExpression
  -- (if (namedExpression = $lift_namedExpressionIR(namedExpressionIR)))*{namedExpression <- namedExpression*, namedExpressionIR <- namedExpressionIR*}
  -- if (recordElementExpression = $unflatten_recordElementExpression_with_default(namedExpression*{namedExpression <- namedExpression*}))

def $lift_errorAccessExpressionIR(errorAccessExpressionIR) : errorAccessExpression =

  clause 0 : (ERROR '.' nameIR) = ERROR '.' member
  -- if (member = $lift_nameIR_as_member(nameIR))

def $lift_memberAccessBaseIR(memberAccessBaseIR) : memberAccessBase =

  clause 0 : (TYPE prefixedNameIR) = $lift_prefixedNameIR_as_prefixedTypeName(prefixedNameIR) as memberAccessBase

  clause 1 : (typedExpressionIR as memberAccessBaseIR) = $lift_typedExpressionIR(typedExpressionIR) as memberAccessBase

def $lift_memberAccessExpressionIR(memberAccessExpressionIR) : memberAccessExpression =

  clause 0 : (memberAccessBaseIR '.' nameIR) = memberAccessBase '.' member
  -- if (memberAccessBase = $lift_memberAccessBaseIR(memberAccessBaseIR))
  -- if (member = $lift_nameIR_as_member(nameIR))

def $lift_indexAccessExpressionIR(indexAccessExpressionIR) : indexAccessExpression =

  clause 0 : (typedExpressionIR_base `[ typedExpressionIR_index `]) = expression_base `[ expression_index `]
  -- if (expression_base = $lift_typedExpressionIR(typedExpressionIR_base))
  -- if (expression_index = $lift_typedExpressionIR(typedExpressionIR_index))

def $lift_sliceAccessExpressionIR(sliceAccessExpressionIR) : sliceAccessExpression =

  clause 0 : (typedExpressionIR_base `[ typedExpressionIR_hi ':' typedExpressionIR_lo `]) = expression_base `[ expression_hi ':' expression_lo `]
  -- if (expression_base = $lift_typedExpressionIR(typedExpressionIR_base))
  -- if (expression_hi = $lift_typedExpressionIR(typedExpressionIR_hi))
  -- if (expression_lo = $lift_typedExpressionIR(typedExpressionIR_lo))

def $lift_accessExpressionIR(accessExpressionIR) : accessExpression =

  clause 0 : (errorAccessExpressionIR as accessExpressionIR) = $lift_errorAccessExpressionIR(errorAccessExpressionIR) as accessExpression

  clause 1 : (memberAccessExpressionIR as accessExpressionIR) = $lift_memberAccessExpressionIR(memberAccessExpressionIR) as accessExpression

  clause 2 : (indexAccessExpressionIR as accessExpressionIR) = $lift_indexAccessExpressionIR(indexAccessExpressionIR) as accessExpression

  clause 3 : (sliceAccessExpressionIR as accessExpressionIR) = $lift_sliceAccessExpressionIR(sliceAccessExpressionIR) as accessExpression

def $lift_argumentListIR(argumentIR*) : argumentList =

  clause 0 : (argumentIR*{argumentIR <- argumentIR*}) = argumentList
  -- (if (argument = $lift_argumentIR(argumentIR)))*{argument <- argument*, argumentIR <- argumentIR*}
  -- if (argumentList = $unflatten_argumentList(argument*{argument <- argument*}))

def $lift_callableTargetIR_as_expression(callableTargetIR) : expression =

  clause 0 : (_BARE "this" as callableTargetIR) = THIS as expression

  clause 1 : (_BARE nameIR as callableTargetIR) = nonTypeName as expression
  -- if (nameIR =/= "this")
  -- if (nonTypeName = $lift_nameIR_as_nonTypeName(nameIR))

  clause 2 : ('.' nameIR as callableTargetIR) = _ID '.' nonTypeName as expression
  -- if (nonTypeName = $lift_nameIR_as_nonTypeName(nameIR))

  clause 3 : (typedExpressionIR '.' nameIR) = expression as memberAccessBase '.' member as expression
  -- if (expression = $lift_typedExpressionIR(typedExpressionIR))
  -- if (member = $lift_nameIR_as_member(nameIR))

  clause 4 : (TYPE _BARE "this" '.' nameIR) = THIS as memberAccessBase '.' member as expression
  -- if (member = $lift_nameIR_as_member(nameIR))

  clause 5 : (TYPE _BARE nameIR '.' nameIR_field) = nonTypeName as memberAccessBase '.' member as expression
  -- if (nameIR =/= "this")
  -- if (nonTypeName = $lift_nameIR_as_nonTypeName(nameIR))
  -- if (member = $lift_nameIR_as_member(nameIR_field))

  clause 6 : (TYPE '.' nameIR '.' nameIR_field) = _ID '.' nonTypeName as memberAccessBase '.' member as expression
  -- if (nonTypeName = $lift_nameIR_as_nonTypeName(nameIR))
  -- if (member = $lift_nameIR_as_member(nameIR_field))

  clause 7 : (`( callableTargetIR `)) = `( expression `) as expression
  -- if (expression = $lift_callableTargetIR_as_expression(callableTargetIR))

def $lift_typeArgumentListIR_as_realTypeArgumentList(typeArgumentIR*) : realTypeArgumentList =

  clause 0 : (typeArgumentIR*{typeArgumentIR <- typeArgumentIR*}) = realTypeArgumentList
  -- (if (realTypeArgument = $lift_typeArgumentIR_as_realTypeArgument(typeArgumentIR)))*{realTypeArgument <- realTypeArgument*, typeArgumentIR <- typeArgumentIR*}
  -- if (realTypeArgumentList = $unflatten_realTypeArgumentList(realTypeArgument*{realTypeArgument <- realTypeArgument*}))

def $lift_callExpressionIR(callExpressionIR) : callExpression =

  clause 0 : (constructorTargetIR `( argumentIR*{argumentIR <- argumentIR*} `)) = namedType as callTarget `( argumentList `)
  -- if (prefixedNameIR `< [] `> = constructorTargetIR)
  -- if (prefixedTypeName = $lift_prefixedNameIR_as_prefixedTypeName(prefixedNameIR))
  -- if (namedType = prefixedTypeName as namedType)
  -- if (argumentList = $lift_argumentListIR(argumentIR*{argumentIR <- argumentIR*}))

  clause 1 : (constructorTargetIR `( argumentIR*{argumentIR <- argumentIR*} `)) = namedType as callTarget `( argumentList `)
  -- if (prefixedNameIR `< typeArgumentIR*{typeArgumentIR <- typeArgumentIR*} `> = constructorTargetIR)
  -- if (typeArgumentIR*{typeArgumentIR <- typeArgumentIR*} =/= [])
  -- if (prefixedTypeName = $lift_prefixedNameIR_as_prefixedTypeName(prefixedNameIR))
  -- if (typeArgumentList = $lift_typeArgumentListIR(typeArgumentIR*{typeArgumentIR <- typeArgumentIR*}))
  -- if (namedType = prefixedTypeName `< typeArgumentList `> as namedType)
  -- if (argumentList = $lift_argumentListIR(argumentIR*{argumentIR <- argumentIR*}))

  clause 2 : (callableTargetIR `< [] `> `( argumentIR*{argumentIR <- argumentIR*} `)) = expression as callTarget `( argumentList `)
  -- if (expression = $lift_callableTargetIR_as_expression(callableTargetIR))
  -- if (argumentList = $lift_argumentListIR(argumentIR*{argumentIR <- argumentIR*}))

  clause 3 : (callableTargetIR `< typeArgumentIR*{typeArgumentIR <- typeArgumentIR*} `> `( argumentIR*{argumentIR <- argumentIR*} `)) = expression `< realTypeArgumentList `> `( argumentList `)
  -- if (expression = $lift_callableTargetIR_as_expression(callableTargetIR))
  -- if (typeArgumentIR*{typeArgumentIR <- typeArgumentIR*} =/= [])
  -- if (realTypeArgumentList = $lift_typeArgumentListIR_as_realTypeArgumentList(typeArgumentIR*{typeArgumentIR <- typeArgumentIR*}))
  -- if (argumentList = $lift_argumentListIR(argumentIR*{argumentIR <- argumentIR*}))

def $lift_parenthesizedExpressionIR(parenthesizedExpressionIR) : parenthesizedExpression =

  clause 0 : (`( typedExpressionIR `)) = `( expression `)
  -- if (expression = $lift_typedExpressionIR(typedExpressionIR))

def $lift_expressionIR(expressionIR) : expression =

  clause 0 : (literalExpressionIR as expressionIR) = $lift_literalExpressionIR(literalExpressionIR) as expression

  clause 1 : (referenceExpressionIR as expressionIR) = $lift_referenceExpressionIR(referenceExpressionIR) as expression

  clause 2 : (defaultExpressionIR as expressionIR) = $lift_defaultExpressionIR(defaultExpressionIR) as expression

  clause 3 : (unaryExpressionIR as expressionIR) = $lift_unaryExpressionIR(unaryExpressionIR) as expression

  clause 4 : (binaryExpressionIR as expressionIR) = $lift_binaryExpressionIR(binaryExpressionIR) as expression

  clause 5 : (ternaryExpressionIR as expressionIR) = $lift_ternaryExpressionIR(ternaryExpressionIR) as expression

  clause 6 : (castExpressionIR as expressionIR) = $lift_castExpressionIR(castExpressionIR)

  clause 7 : (dataExpressionIR as expressionIR) = $lift_dataExpressionIR(dataExpressionIR) as expression

  clause 8 : (accessExpressionIR as expressionIR) = $lift_accessExpressionIR(accessExpressionIR) as expression

  clause 9 : (callExpressionIR as expressionIR) = $lift_callExpressionIR(callExpressionIR) as expression

  clause 10 : (parenthesizedExpressionIR as expressionIR) = $lift_parenthesizedExpressionIR(parenthesizedExpressionIR) as expression

def $unflatten_expressionList(expression*) : expressionList =

  clause 0 : ([]) = _EMPTY

  clause 1 : (expression_h :: expression_t*{expression_t <- expression_t*}) = $unflatten_expressionList'(expression_h as expressionList, expression_t*{expression_t <- expression_t*})

def $unflatten_expressionList'(expressionList, expression*) : expressionList =

  clause 0 : (expressionList, []) = expressionList

  clause 1 : (expressionList, expression_h :: expression_t*{expression_t <- expression_t*}) = $unflatten_expressionList'(expressionList ',' expression_h, expression_t*{expression_t <- expression_t*})

def $lift_simpleKeysetExpressionIR(simpleKeysetExpressionIR) : simpleKeysetExpression =

  clause 0 : (typedExpressionIR as simpleKeysetExpressionIR) = expression as simpleKeysetExpression
  -- if (expression = $lift_typedExpressionIR(typedExpressionIR))

  clause 1 : (typedExpressionIR_base '&&&' typedExpressionIR_mask) = expression_base '&&&' expression_mask
  -- if (expression_base = $lift_typedExpressionIR(typedExpressionIR_base))
  -- if (expression_mask = $lift_typedExpressionIR(typedExpressionIR_mask))

  clause 2 : (typedExpressionIR_lb '..' typedExpressionIR_ub) = expression_lb '..' expression_ub
  -- if (expression_lb = $lift_typedExpressionIR(typedExpressionIR_lb))
  -- if (expression_ub = $lift_typedExpressionIR(typedExpressionIR_ub))

  clause 3 : (DEFAULT) = DEFAULT

  clause 4 : ('_') = '_'

def $lift_simpleKeysetExpressionListIR(simpleKeysetExpressionIR*) : simpleKeysetExpressionList =

  clause 0 : (simpleKeysetExpressionIR*{simpleKeysetExpressionIR <- simpleKeysetExpressionIR*}) = simpleKeysetExpressionList
  -- (if (simpleKeysetExpression = $lift_simpleKeysetExpressionIR(simpleKeysetExpressionIR)))*{simpleKeysetExpression <- simpleKeysetExpression*, simpleKeysetExpressionIR <- simpleKeysetExpressionIR*}
  -- if (simpleKeysetExpressionList = $unflatten_simpleKeysetExpressionList(simpleKeysetExpression*{simpleKeysetExpression <- simpleKeysetExpression*}))

def $unflatten_simpleKeysetExpressionList(simpleKeysetExpression*) : simpleKeysetExpressionList =

  clause 0 : (simpleKeysetExpression*{simpleKeysetExpression <- simpleKeysetExpression*}) = $unflatten_simpleKeysetExpressionList'(simpleKeysetExpression_h as simpleKeysetExpressionList, simpleKeysetExpression_t*{simpleKeysetExpression_t <- simpleKeysetExpression_t*})
  -- if (simpleKeysetExpression_h :: simpleKeysetExpression_t*{simpleKeysetExpression_t <- simpleKeysetExpression_t*} = simpleKeysetExpression*{simpleKeysetExpression <- simpleKeysetExpression*})

def $unflatten_simpleKeysetExpressionList'(simpleKeysetExpressionList, simpleKeysetExpression*) : simpleKeysetExpressionList =

  clause 0 : (simpleKeysetExpressionList, []) = simpleKeysetExpressionList

  clause 1 : (simpleKeysetExpressionList, simpleKeysetExpression_h :: simpleKeysetExpression_t*{simpleKeysetExpression_t <- simpleKeysetExpression_t*}) = $unflatten_simpleKeysetExpressionList'(simpleKeysetExpressionList ',' simpleKeysetExpression_h, simpleKeysetExpression_t*{simpleKeysetExpression_t <- simpleKeysetExpression_t*})

def $lift_tupleKeysetExpressionIR(tupleKeysetExpressionIR) : tupleKeysetExpression =

  clause 0 : (`( [typedExpressionIR_base '&&&' typedExpressionIR_mask] `)) = `( expression_base '&&&' expression_mask `)
  -- if (expression_base = $lift_typedExpressionIR(typedExpressionIR_base))
  -- if (expression_mask = $lift_typedExpressionIR(typedExpressionIR_mask))

  clause 1 : (`( [typedExpressionIR_lb '..' typedExpressionIR_ub] `)) = `( expression_lb '..' expression_ub `)
  -- if (expression_lb = $lift_typedExpressionIR(typedExpressionIR_lb))
  -- if (expression_ub = $lift_typedExpressionIR(typedExpressionIR_ub))

  clause 2 : (`( [DEFAULT] `)) = `( DEFAULT `)

  clause 3 : (`( ['_'] `)) = `( '_' `)

  clause 4 : (`( simpleKeysetExpressionIR*{simpleKeysetExpressionIR <- simpleKeysetExpressionIR*} `)) = `( simpleKeysetExpression_h ',' simpleKeysetExpressionList_t `)
  -- if (|simpleKeysetExpressionIR*{simpleKeysetExpressionIR <- simpleKeysetExpressionIR*}| > 1)
  -- if (simpleKeysetExpressionIR_h :: simpleKeysetExpressionIR_t*{simpleKeysetExpressionIR_t <- simpleKeysetExpressionIR_t*} = simpleKeysetExpressionIR*{simpleKeysetExpressionIR <- simpleKeysetExpressionIR*})
  -- if (simpleKeysetExpression_h = $lift_simpleKeysetExpressionIR(simpleKeysetExpressionIR_h))
  -- if (simpleKeysetExpressionList_t = $lift_simpleKeysetExpressionListIR(simpleKeysetExpressionIR_t*{simpleKeysetExpressionIR_t <- simpleKeysetExpressionIR_t*}))

def $lift_keysetExpressionIR(keysetExpressionIR) : keysetExpression =

  clause 0 : (simpleKeysetExpressionIR as keysetExpressionIR) = $lift_simpleKeysetExpressionIR(simpleKeysetExpressionIR) as keysetExpression

  clause 1 : (tupleKeysetExpressionIR as keysetExpressionIR) = $lift_tupleKeysetExpressionIR(tupleKeysetExpressionIR) as keysetExpression

def $lift_typeArgumentIR_as_realTypeArgument(typeArgumentIR) : realTypeArgument =

  clause 0 : (VOID as typeIR) = VOID

  clause -1 : (typeIR) = $lift_typeIR(typeIR) as realTypeArgument

def $unflatten_realTypeArgumentList(realTypeArgument*) : realTypeArgumentList =

  clause 0 : (realTypeArgument_h :: realTypeArgument_t*{realTypeArgument_t <- realTypeArgument_t*}) = $unflatten_realTypeArgumentList'(realTypeArgument_h as realTypeArgumentList, realTypeArgument_t*{realTypeArgument_t <- realTypeArgument_t*})

def $unflatten_realTypeArgumentList'(realTypeArgumentList, realTypeArgument*) : realTypeArgumentList =

  clause 0 : (realTypeArgumentList, []) = realTypeArgumentList

  clause 1 : (realTypeArgumentList, realTypeArgument_h :: realTypeArgument_t*{realTypeArgument_t <- realTypeArgument_t*}) = $unflatten_realTypeArgumentList'(realTypeArgumentList ',' realTypeArgument_h, realTypeArgument_t*{realTypeArgument_t <- realTypeArgument_t*})

def $unflatten_typeArgumentList(typeArgument*) : typeArgumentList =

  clause 0 : ([]) = _EMPTY

  clause 1 : (typeArgument_h :: typeArgument_t*{typeArgument_t <- typeArgument_t*}) = $unflatten_typeArgumentList'(typeArgument_h as typeArgumentList, typeArgument_t*{typeArgument_t <- typeArgument_t*})

def $unflatten_typeArgumentList'(typeArgumentList, typeArgument*) : typeArgumentList =

  clause 0 : (typeArgumentList, []) = typeArgumentList

  clause 1 : (typeArgumentList, typeArgument_h :: typeArgument_t*{typeArgument_t <- typeArgument_t*}) = $unflatten_typeArgumentList'(typeArgumentList ',' typeArgument_h, typeArgument_t*{typeArgument_t <- typeArgument_t*})

def $lift_argumentIR(argumentIR) : argument =

  clause 0 : (typedExpressionIR as argumentIR) = expression as argument
  -- if (expression = $lift_typedExpressionIR(typedExpressionIR))

  clause 1 : (nameIR '=' typedExpressionIR) = name '=' expression
  -- if (name = $lift_nameIR_as_nonTypeName(nameIR) as name)
  -- if (expression = $lift_typedExpressionIR(typedExpressionIR))

  clause 2 : (nameIR '=' '_') = name '=' '_'
  -- if (name = $lift_nameIR_as_nonTypeName(nameIR) as name)

  clause 3 : ('_') = '_'

def $unflatten_argumentList(argument*) : argumentList =

  clause 0 : ([]) = _EMPTY

  clause 1 : (argument_h :: argument_t*{argument_t <- argument_t*}) = $unflatten_argumentListNonEmpty(argument_h :: argument_t*{argument_t <- argument_t*}) as argumentList

def $unflatten_argumentListNonEmpty(argument*) : argumentListNonEmpty =

  clause 0 : (argument*{argument <- argument*}) = $unflatten_argumentListNonEmpty'(argument_h as argumentListNonEmpty, argument_t*{argument_t <- argument_t*})
  -- if (argument_h :: argument_t*{argument_t <- argument_t*} = argument*{argument <- argument*})

def $unflatten_argumentListNonEmpty'(argumentListNonEmpty, argument*) : argumentListNonEmpty =

  clause 0 : (argumentListNonEmpty, []) = argumentListNonEmpty

  clause 1 : (argumentListNonEmpty, argument_h :: argument_t*{argument_t <- argument_t*}) = $unflatten_argumentListNonEmpty'(argumentListNonEmpty ',' argument_h, argument_t*{argument_t <- argument_t*})

def $lift_statementIR(statementIR) : statement =

  clause 0 : (emptyStatementIR as statementIR) = $lift_emptyStatementIR(emptyStatementIR) as statement

  clause 1 : (assignmentStatementIR as statementIR) = $lift_assignmentStatementIR(assignmentStatementIR) as statement

  clause 2 : (callStatementIR as statementIR) = $lift_callStatementIR(callStatementIR) as statement

  clause 3 : (directApplicationStatementIR as statementIR) = $lift_directApplicationStatementIR(directApplicationStatementIR) as statement

  clause 4 : (returnStatementIR as statementIR) = $lift_returnStatementIR(returnStatementIR) as statement

  clause 5 : (exitStatementIR as statementIR) = $lift_exitStatementIR(exitStatementIR) as statement

  clause 6 : (blockStatementIR as statementIR) = $lift_blockStatementIR(blockStatementIR) as statement

  clause 7 : (conditionalStatementIR as statementIR) = $lift_conditionalStatementIR(conditionalStatementIR) as statement

  clause 8 : (switchStatementIR as statementIR) = $lift_switchStatementIR(switchStatementIR) as statement

  clause -1 : (statementIR) = $sink<statement>
  -- debug statementIR

def $lift_emptyStatementIR(emptyStatementIR) : emptyStatement =

  clause 0 : (';') = ';'

def $lift_typedLvalueIR(typedLvalueIR) : lvalue =

  clause 0 : (_BARE "this" as lvalueIR '#' _lvalueNoteIR) = THIS as lvalue

  clause 1 : (_BARE nameIR as lvalueIR '#' _lvalueNoteIR) = nonTypeName as lvalue
  -- if (nameIR =/= "this")
  -- if (nonTypeName = $lift_nameIR_as_nonTypeName(nameIR))

  clause 2 : ('.' nameIR as lvalueIR '#' _lvalueNoteIR) = _ID '.' nonTypeName as lvalue
  -- if (nonTypeName = $lift_nameIR_as_nonTypeName(nameIR))

  clause 3 : (typedLvalueIR '.' nameIR '#' _lvalueNoteIR) = lvalue '.' member
  -- if (lvalue = $lift_typedLvalueIR(typedLvalueIR))
  -- if (member = $lift_nameIR_as_member(nameIR))

  clause 4 : (typedLvalueIR `[ typedExpressionIR `] '#' _lvalueNoteIR) = lvalue `[ expression `]
  -- if (lvalue = $lift_typedLvalueIR(typedLvalueIR))
  -- if (expression = $lift_typedExpressionIR(typedExpressionIR))

  clause 5 : (typedLvalueIR `[ typedExpressionIR_hi ':' typedExpressionIR_lo `] '#' _lvalueNoteIR) = lvalue `[ expression_hi ':' expression_lo `]
  -- if (lvalue = $lift_typedLvalueIR(typedLvalueIR))
  -- if (expression_hi = $lift_typedExpressionIR(typedExpressionIR_hi))
  -- if (expression_lo = $lift_typedExpressionIR(typedExpressionIR_lo))

  clause 6 : (`( typedLvalueIR `) '#' _lvalueNoteIR) = `( lvalue `)
  -- if (lvalue = $lift_typedLvalueIR(typedLvalueIR))

def $lift_assignmentStatementIR(assignmentStatementIR) : assignmentStatement =

  clause 0 : (typedLvalueIR assignop typedExpressionIR ';') = lvalue assignop expression ';'
  -- if (lvalue = $lift_typedLvalueIR(typedLvalueIR))
  -- if (expression = $lift_typedExpressionIR(typedExpressionIR))

def $lift_callableTargetIR_as_lvalue(callableTargetIR) : lvalue =

  clause 0 : (_BARE "this" as callableTargetIR) = THIS as lvalue

  clause 1 : (_BARE nameIR as callableTargetIR) = nonTypeName as lvalue
  -- if (nameIR =/= "this")
  -- if (nonTypeName = $lift_nameIR_as_nonTypeName(nameIR))

  clause 2 : ('.' nameIR as callableTargetIR) = _ID '.' nonTypeName as lvalue
  -- if (nonTypeName = $lift_nameIR_as_nonTypeName(nameIR))

  clause 3 : (typedExpressionIR '.' nameIR) = lvalue '.' member
  -- if (?(typedLvalueIR) = $typedExpressionIR_as_typedLvalueIR(typedExpressionIR))
  -- if (lvalue = $lift_typedLvalueIR(typedLvalueIR))
  -- if (member = $lift_nameIR_as_member(nameIR))

  clause 4 : (TYPE _BARE "this" '.' nameIR) = THIS as lvalue '.' member
  -- if (member = $lift_nameIR_as_member(nameIR))

  clause 5 : (TYPE _BARE nameIR '.' nameIR_field) = nonTypeName as lvalue '.' member
  -- if (nameIR =/= "this")
  -- if (nonTypeName = $lift_nameIR_as_nonTypeName(nameIR))
  -- if (member = $lift_nameIR_as_member(nameIR_field))

  clause 6 : (TYPE '.' nameIR '.' nameIR_field) = _ID '.' nonTypeName as lvalue '.' member
  -- if (nonTypeName = $lift_nameIR_as_nonTypeName(nameIR))
  -- if (member = $lift_nameIR_as_member(nameIR_field))

  clause 7 : (`( callableTargetIR `)) = `( lvalue `)
  -- if (lvalue = $lift_callableTargetIR_as_lvalue(callableTargetIR))

def $lift_callStatementIR(callStatementIR) : callStatement =

  clause 0 : (callableTargetIR `< [] `> `( argumentIR*{argumentIR <- argumentIR*} `) ';') = lvalue `( argumentList `) ';'
  -- if (lvalue = $lift_callableTargetIR_as_lvalue(callableTargetIR))
  -- if (argumentList = $lift_argumentListIR(argumentIR*{argumentIR <- argumentIR*}))

  clause 1 : (callableTargetIR `< typeArgumentIR*{typeArgumentIR <- typeArgumentIR*} `> `( argumentIR*{argumentIR <- argumentIR*} `) ';') = lvalue `< typeArgumentList `> `( argumentList `) ';'
  -- if (lvalue = $lift_callableTargetIR_as_lvalue(callableTargetIR))
  -- if (typeArgumentList = $lift_typeArgumentListIR(typeArgumentIR*{typeArgumentIR <- typeArgumentIR*}))
  -- if (argumentList = $lift_argumentListIR(argumentIR*{argumentIR <- argumentIR*}))

def $lift_directApplicationStatementIR(directApplicationStatementIR) : directApplicationStatement =

  clause 0 : (constructorTargetIR '.' APPLY `( argumentIR*{argumentIR <- argumentIR*} `) ';') = prefixedTypeName as namedType '.' APPLY `( argumentList `) ';'
  -- if (prefixedNameIR `< [] `> = constructorTargetIR)
  -- if (prefixedTypeName = $lift_prefixedNameIR_as_prefixedTypeName(prefixedNameIR))
  -- if (argumentList = $lift_argumentListIR(argumentIR*{argumentIR <- argumentIR*}))

  clause 1 : (constructorTargetIR '.' APPLY `( argumentIR*{argumentIR <- argumentIR*} `) ';') = namedType '.' APPLY `( argumentList `) ';'
  -- if (prefixedNameIR `< typeArgumentIR*{typeArgumentIR <- typeArgumentIR*} `> = constructorTargetIR)
  -- if (|typeArgumentIR*{typeArgumentIR <- typeArgumentIR*}| > 0)
  -- if (prefixedTypeName = $lift_prefixedNameIR_as_prefixedTypeName(prefixedNameIR))
  -- if (typeArgumentList = $lift_typeArgumentListIR(typeArgumentIR*{typeArgumentIR <- typeArgumentIR*}))
  -- if (namedType = prefixedTypeName `< typeArgumentList `> as namedType)
  -- if (argumentList = $lift_argumentListIR(argumentIR*{argumentIR <- argumentIR*}))

def $lift_returnStatementIR(returnStatementIR) : returnStatement =

  clause 0 : (RETURN ';') = RETURN ';'

  clause 1 : (RETURN typedExpressionIR ';') = RETURN expression ';'
  -- if (expression = $lift_typedExpressionIR(typedExpressionIR))

def $lift_exitStatementIR(exitStatementIR) : exitStatement =

  clause 0 : (EXIT ';') = EXIT ';'

def $lift_constantDeclarationIR(constantDeclarationIR) : constantDeclaration =

  clause 0 : (constantDeclarationIR) = annotationList CONST type name initializer ';'
  -- if (annotationList CONST typeIR nameIR constantInitializerIR ';' = constantDeclarationIR)
  -- if (type = $lift_typeIR(typeIR))
  -- if (name = $lift_nameIR_as_nonTypeName(nameIR) as name)
  -- if (initializer = $lift_constantInitializerIR_as_initializer(constantInitializerIR))

def $lift_variableDeclarationIR(variableDeclarationIR) : variableDeclaration =

  clause 0 : (annotationList typeIR nameIR initializerIR?{initializerIR <- initializerIR?} ';') = annotationList type name initializerOpt ';'
  -- if (type = $lift_typeIR(typeIR))
  -- if (name = $lift_nameIR_as_nonTypeName(nameIR) as name)
  -- if (initializerOpt = $lift_initializerOptIR(initializerIR?{initializerIR <- initializerIR?}))

def $lift_blockElementStatementIR(blockElementStatementIR) : blockElementStatement =

  clause 0 : (constantDeclarationIR as blockElementStatementIR) = $lift_constantDeclarationIR(constantDeclarationIR) as blockElementStatement

  clause 1 : (variableDeclarationIR as blockElementStatementIR) = $lift_variableDeclarationIR(variableDeclarationIR) as blockElementStatement

  clause 2 : (statementIR as blockElementStatementIR) = $lift_statementIR(statementIR) as blockElementStatement

def $lift_blockElementStatementListIR(blockElementStatementIR*) : blockElementStatementList =

  clause 0 : (blockElementStatementIR*{blockElementStatementIR <- blockElementStatementIR*}) = blockElementStatementList
  -- (if (blockElementStatement = $lift_blockElementStatementIR(blockElementStatementIR)))*{blockElementStatement <- blockElementStatement*, blockElementStatementIR <- blockElementStatementIR*}
  -- if (blockElementStatementList = $unflatten_blockElementStatementList(blockElementStatement*{blockElementStatement <- blockElementStatement*}))

def $unflatten_blockElementStatementList(blockElementStatement*) : blockElementStatementList =

  clause 0 : (blockElementStatement*{blockElementStatement <- blockElementStatement*}) = $unflatten_blockElementStatementList'(_EMPTY, blockElementStatement*{blockElementStatement <- blockElementStatement*})

def $unflatten_blockElementStatementList'(blockElementStatementList, blockElementStatement*) : blockElementStatementList =

  clause 0 : (blockElementStatementList, []) = blockElementStatementList

  clause 1 : (blockElementStatementList, blockElementStatement_h :: blockElementStatement_t*{blockElementStatement_t <- blockElementStatement_t*}) = $unflatten_blockElementStatementList'(blockElementStatementList blockElementStatement_h, blockElementStatement_t*{blockElementStatement_t <- blockElementStatement_t*})

def $lift_blockStatementIR(blockStatementIR) : blockStatement =

  clause 0 : (annotationList `{ blockElementStatementIR*{blockElementStatementIR <- blockElementStatementIR*} `}) = annotationList `{ blockElementStatementList `}
  -- (if (blockElementStatement = $lift_blockElementStatementIR(blockElementStatementIR)))*{blockElementStatement <- blockElementStatement*, blockElementStatementIR <- blockElementStatementIR*}
  -- if (blockElementStatementList = $unflatten_blockElementStatementList(blockElementStatement*{blockElementStatement <- blockElementStatement*}))

def $lift_conditionalStatementIR(conditionalStatementIR) : conditionalStatement =

  clause 0 : (IF `( typedExpressionIR_cond `) statementIR_then) = IF `( expression_cond `) statement_then
  -- if (expression_cond = $lift_typedExpressionIR(typedExpressionIR_cond))
  -- if (statement_then = $lift_statementIR(statementIR_then))

  clause 1 : (IF `( typedExpressionIR_cond `) statementIR_then ELSE statementIR_else) = IF `( expression_cond `) statement_then ELSE statement_else
  -- if (expression_cond = $lift_typedExpressionIR(typedExpressionIR_cond))
  -- if (statement_then = $lift_statementIR(statementIR_then))
  -- if (statement_else = $lift_statementIR(statementIR_else))

def $lift_switchLabelIR(switchLabelIR) : switchLabel =

  clause 0 : (DEFAULT) = DEFAULT

  clause 1 : (typedExpressionIR as switchLabelIR) = expressionNonBrace as switchLabel
  -- if (expression = $lift_typedExpressionIR(typedExpressionIR))
  -- if (expressionNonBrace = $expression_as_expressionNonBrace(expression))

def $lift_switchCaseIR(switchCaseIR) : switchCase =

  clause 0 : (switchLabelIR ':' blockStatementIR) = switchLabel ':' blockStatement
  -- if (switchLabel = $lift_switchLabelIR(switchLabelIR))
  -- if (blockStatement = $lift_blockStatementIR(blockStatementIR))

  clause 1 : (switchLabelIR ':') = switchLabel ':'
  -- if (switchLabel = $lift_switchLabelIR(switchLabelIR))

def $lift_switchCaseListIR(switchCaseIR*) : switchCaseList =

  clause 0 : (switchCaseIR*{switchCaseIR <- switchCaseIR*}) = switchCaseList
  -- (if (switchCase = $lift_switchCaseIR(switchCaseIR)))*{switchCase <- switchCase*, switchCaseIR <- switchCaseIR*}
  -- if (switchCaseList = $unflatten_switchCaseList(switchCase*{switchCase <- switchCase*}))

def $unflatten_switchCaseList(switchCase*) : switchCaseList =

  clause 0 : (switchCase*{switchCase <- switchCase*}) = $unflatten_switchCaseList'(_EMPTY, switchCase*{switchCase <- switchCase*})

def $unflatten_switchCaseList'(switchCaseList, switchCase*) : switchCaseList =

  clause 0 : (switchCaseList, []) = switchCaseList

  clause 1 : (switchCaseList, switchCase_h :: switchCase_t*{switchCase_t <- switchCase_t*}) = $unflatten_switchCaseList'(switchCaseList switchCase_h, switchCase_t*{switchCase_t <- switchCase_t*})

def $lift_switchStatementIR(switchStatementIR) : switchStatement =

  clause 0 : (SWITCH `( typedExpressionIR `) `{ switchCaseIR*{switchCaseIR <- switchCaseIR*} `}) = SWITCH `( expression `) `{ switchCaseList `}
  -- if (expression = $lift_typedExpressionIR(typedExpressionIR))
  -- if (switchCaseList = $lift_switchCaseListIR(switchCaseIR*{switchCaseIR <- switchCaseIR*}))

def $lift_breakStatementIR(breakStatementIR) : breakStatement =

  clause 0 : (BREAK ';') = BREAK ';'

def $lift_continueStatementIR(continueStatementIR) : continueStatement =

  clause 0 : (CONTINUE ';') = CONTINUE ';'

def $lift_functionPrototypeIR(functionPrototypeIR) : functionPrototype =

  clause 0 : (typeIR nameIR `< typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*} ',' typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*} `> `( parameterIR*{parameterIR <- parameterIR*} `)) = typeOrVoid name typeParameterListOpt `( parameterList `)
  -- if (typeOrVoid = $lift_typeIR_as_typeOrVoid(typeIR))
  -- if (name = $lift_nameIR_as_nonTypeName(nameIR) as name)
  -- if (typeParameterIR*{typeParameterIR <- typeParameterIR*} = typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*} ++ typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*})
  -- if (typeParameterListOpt = $lift_typeParameterListIR(typeParameterIR*{typeParameterIR <- typeParameterIR*}))
  -- if (parameterList = $lift_parameterListIR(parameterIR*{parameterIR <- parameterIR*}))

def $lift_functionDeclarationIR(functionDeclarationIR) : functionDeclaration =

  clause 0 : (annotationList functionPrototypeIR blockStatementIR) = annotationList functionPrototype blockStatement
  -- if (functionPrototype = $lift_functionPrototypeIR(functionPrototypeIR))
  -- if (blockStatement = $lift_blockStatementIR(blockStatementIR))

def $lift_actionDeclarationIR(actionDeclarationIR) : actionDeclaration =

  clause 0 : (annotationList ACTION nameIR `( parameterIR*{parameterIR <- parameterIR*} `) blockStatementIR) = annotationList ACTION name `( parameterList `) blockStatement
  -- if (name = $lift_nameIR_as_nonTypeName(nameIR) as name)
  -- if (parameterList = $lift_parameterListIR(parameterIR*{parameterIR <- parameterIR*}))
  -- if (blockStatement = $lift_blockStatementIR(blockStatementIR))

def $lift_objectDeclarationIR(objectDeclarationIR) : objectDeclaration =

  clause 0 : (functionDeclarationIR as objectDeclarationIR) = $lift_functionDeclarationIR(functionDeclarationIR) as objectDeclaration

  clause 1 : (instantiationIR as objectDeclarationIR) = $lift_instantiationIR(instantiationIR) as objectDeclaration

def $lift_objectDeclarationListIR(objectDeclarationIR*) : objectDeclarationList =

  clause 0 : (objectDeclarationIR*{objectDeclarationIR <- objectDeclarationIR*}) = objectDeclarationList
  -- (if (objectDeclaration = $lift_objectDeclarationIR(objectDeclarationIR)))*{objectDeclaration <- objectDeclaration*, objectDeclarationIR <- objectDeclarationIR*}
  -- if (objectDeclarationList = $unflatten_objectDeclarationList(objectDeclaration*{objectDeclaration <- objectDeclaration*}))

def $lift_instantiationIR(instantiationIR) : instantiation =

  clause 0 : (annotationList typeIR constructorTargetIR `( argumentIR*{argumentIR <- argumentIR*} `) nameIR ?() ';') = annotationList type `( argumentList `) name ';'
  -- if (prefixedNameIR `< [] `> = constructorTargetIR)
  -- if (prefixedTypeName = $lift_prefixedNameIR_as_prefixedTypeName(prefixedNameIR))
  -- if (type = prefixedTypeName as type)
  -- if (argumentList = $lift_argumentListIR(argumentIR*{argumentIR <- argumentIR*}))
  -- if (name = $lift_nameIR_as_nonTypeName(nameIR) as name)

  clause 1 : (annotationList typeIR constructorTargetIR `( argumentIR*{argumentIR <- argumentIR*} `) nameIR ?() ';') = annotationList type `( argumentList `) name ';'
  -- if (prefixedNameIR `< typeArgumentIR*{typeArgumentIR <- typeArgumentIR*} `> = constructorTargetIR)
  -- if (|typeArgumentIR*{typeArgumentIR <- typeArgumentIR*}| > 0)
  -- if (prefixedTypeName = $lift_prefixedNameIR_as_prefixedTypeName(prefixedNameIR))
  -- if (typeArgumentList = $lift_typeArgumentListIR(typeArgumentIR*{typeArgumentIR <- typeArgumentIR*}))
  -- if (type = prefixedTypeName `< typeArgumentList `> as type)
  -- if (argumentList = $lift_argumentListIR(argumentIR*{argumentIR <- argumentIR*}))
  -- if (name = $lift_nameIR_as_nonTypeName(nameIR) as name)

  clause 2 : (annotationList typeIR constructorTargetIR `( argumentIR*{argumentIR <- argumentIR*} `) nameIR ?('=' `{ objectDeclarationIR*{objectDeclarationIR <- objectDeclarationIR*} `}) ';') = annotationList type `( argumentList `) name '=' `{ objectDeclarationList `} ';'
  -- if (prefixedNameIR `< [] `> = constructorTargetIR)
  -- if (prefixedTypeName = $lift_prefixedNameIR_as_prefixedTypeName(prefixedNameIR))
  -- if (type = prefixedTypeName as type)
  -- if (argumentList = $lift_argumentListIR(argumentIR*{argumentIR <- argumentIR*}))
  -- if (name = $lift_nameIR_as_nonTypeName(nameIR) as name)
  -- if (objectDeclarationList = $lift_objectDeclarationListIR(objectDeclarationIR*{objectDeclarationIR <- objectDeclarationIR*}))

  clause 3 : (annotationList typeIR constructorTargetIR `( argumentIR*{argumentIR <- argumentIR*} `) nameIR ?('=' `{ objectDeclarationIR*{objectDeclarationIR <- objectDeclarationIR*} `}) ';') = annotationList type `( argumentList `) name '=' `{ objectDeclarationList `} ';'
  -- if (prefixedNameIR `< typeArgumentIR*{typeArgumentIR <- typeArgumentIR*} `> = constructorTargetIR)
  -- if (|typeArgumentIR*{typeArgumentIR <- typeArgumentIR*}| > 0)
  -- if (prefixedTypeName = $lift_prefixedNameIR_as_prefixedTypeName(prefixedNameIR))
  -- if (typeArgumentIR*{typeArgumentIR <- typeArgumentIR*} =/= [])
  -- if (typeArgumentList = $lift_typeArgumentListIR(typeArgumentIR*{typeArgumentIR <- typeArgumentIR*}))
  -- if (type = prefixedTypeName `< typeArgumentList `> as type)
  -- if (argumentList = $lift_argumentListIR(argumentIR*{argumentIR <- argumentIR*}))
  -- if (name = $lift_nameIR_as_nonTypeName(nameIR) as name)
  -- if (objectDeclarationList = $lift_objectDeclarationListIR(objectDeclarationIR*{objectDeclarationIR <- objectDeclarationIR*}))

def $unflatten_objectDeclarationList(objectDeclaration*) : objectDeclarationList =

  clause 0 : (objectDeclaration*{objectDeclaration <- objectDeclaration*}) = $unflatten_objectDeclarationList'(_EMPTY, objectDeclaration*{objectDeclaration <- objectDeclaration*})

def $unflatten_objectDeclarationList'(objectDeclarationList, objectDeclaration*) : objectDeclarationList =

  clause 0 : (objectDeclarationList, []) = objectDeclarationList

  clause 1 : (objectDeclarationList, objectDeclaration_h :: objectDeclaration_t*{objectDeclaration_t <- objectDeclaration_t*}) = $unflatten_objectDeclarationList'(objectDeclarationList objectDeclaration_h, objectDeclaration_t*{objectDeclaration_t <- objectDeclaration_t*})

def $lift_errorDeclarationIR(errorDeclarationIR) : errorDeclaration =

  clause 0 : (ERROR `{ nameIR*{nameIR <- nameIR*} `}) = ERROR `{ nameList `}
  -- if (nameList = $lift_nameListIR_as_nonTypeNameList(nameIR*{nameIR <- nameIR*}))

def $lift_matchKindDeclarationIR(matchKindDeclarationIR) : matchKindDeclaration =

  clause 0 : (MATCH_KIND `{ nameIR*{nameIR <- nameIR*} `}) = MATCH_KIND `{ nameList _EMPTY `}
  -- if (nameList = $lift_nameListIR_as_nonTypeNameList(nameIR*{nameIR <- nameIR*}))

def $lift_enumTypeDeclarationIR(enumTypeDeclarationIR) : enumTypeDeclaration =

  clause 0 : (annotationList ENUM nameIR `{ nameIR_field*{nameIR_field <- nameIR_field*} `}) = annotationList ENUM name `{ nameList_field _EMPTY `}
  -- if (name = $lift_nameIR_as_typeName(nameIR) as name)
  -- if (nameList_field = $lift_nameListIR_as_nonTypeNameList(nameIR_field*{nameIR_field <- nameIR_field*}))

  clause 1 : (annotationList ENUM typeIR nameIR `{ namedValueListIR `}) = annotationList ENUM type name `{ namedExpressionList _EMPTY `}
  -- if (type = $lift_typeIR(typeIR))
  -- if (name = $lift_nameIR_as_typeName(nameIR) as name)
  -- if (namedExpressionList = $lift_namedValueListIR(namedValueListIR))

def $lift_typeFieldIR(typeFieldIR) : typeField =

  clause 0 : (annotationList typeIR nameIR ';') = annotationList type name ';'
  -- if (type = $lift_typeIR(typeIR))
  -- if (name = $lift_nameIR_as_nonTypeName(nameIR) as name)

def $lift_typeFieldListIR(typeFieldIR*) : typeFieldList =

  clause 0 : (typeFieldIR*{typeFieldIR <- typeFieldIR*}) = typeFieldList
  -- (if (typeField = $lift_typeFieldIR(typeFieldIR)))*{typeField <- typeField*, typeFieldIR <- typeFieldIR*}
  -- if (typeFieldList = $unflatten_typeFieldList(typeField*{typeField <- typeField*}))

def $unflatten_typeFieldList(typeField*) : typeFieldList =

  clause 0 : (typeField*{typeField <- typeField*}) = $unflatten_typeFieldList'(_EMPTY, typeField*{typeField <- typeField*})

def $unflatten_typeFieldList'(typeFieldList, typeField*) : typeFieldList =

  clause 0 : (typeFieldList, []) = typeFieldList

  clause 1 : (typeFieldList, typeField_h :: typeField_t*{typeField_t <- typeField_t*}) = $unflatten_typeFieldList'(typeFieldList typeField_h, typeField_t*{typeField_t <- typeField_t*})

def $lift_structTypeDeclarationIR(structTypeDeclarationIR) : structTypeDeclaration =

  clause 0 : (annotationList STRUCT nameIR `< typeParameterIR*{typeParameterIR <- typeParameterIR*} `> `{ typeFieldIR*{typeFieldIR <- typeFieldIR*} `}) = annotationList STRUCT name typeParameterListOpt `{ typeFieldList `}
  -- if (name = $lift_nameIR_as_typeName(nameIR) as name)
  -- if (typeParameterListOpt = $lift_typeParameterListIR(typeParameterIR*{typeParameterIR <- typeParameterIR*}))
  -- if (typeFieldList = $lift_typeFieldListIR(typeFieldIR*{typeFieldIR <- typeFieldIR*}))

def $lift_headerTypeDeclarationIR(headerTypeDeclarationIR) : headerTypeDeclaration =

  clause 0 : (annotationList HEADER nameIR `< typeParameterIR*{typeParameterIR <- typeParameterIR*} `> `{ typeFieldIR*{typeFieldIR <- typeFieldIR*} `}) = annotationList HEADER name typeParameterListOpt `{ typeFieldList `}
  -- if (name = $lift_nameIR_as_typeName(nameIR) as name)
  -- if (typeParameterListOpt = $lift_typeParameterListIR(typeParameterIR*{typeParameterIR <- typeParameterIR*}))
  -- if (typeFieldList = $lift_typeFieldListIR(typeFieldIR*{typeFieldIR <- typeFieldIR*}))

def $lift_headerUnionTypeDeclarationIR(headerUnionTypeDeclarationIR) : headerUnionTypeDeclaration =

  clause 0 : (annotationList HEADER_UNION nameIR `< typeParameterIR*{typeParameterIR <- typeParameterIR*} `> `{ typeFieldIR*{typeFieldIR <- typeFieldIR*} `}) = annotationList HEADER_UNION name typeParameterListOpt `{ typeFieldList `}
  -- if (name = $lift_nameIR_as_typeName(nameIR) as name)
  -- if (typeParameterListOpt = $lift_typeParameterListIR(typeParameterIR*{typeParameterIR <- typeParameterIR*}))
  -- if (typeFieldList = $lift_typeFieldListIR(typeFieldIR*{typeFieldIR <- typeFieldIR*}))

def $lift_derivedTypeDeclarationIR(derivedTypeDeclarationIR) : derivedTypeDeclaration =

  clause 0 : (enumTypeDeclarationIR as derivedTypeDeclarationIR) = $lift_enumTypeDeclarationIR(enumTypeDeclarationIR) as derivedTypeDeclaration

  clause 1 : (structTypeDeclarationIR as derivedTypeDeclarationIR) = $lift_structTypeDeclarationIR(structTypeDeclarationIR) as derivedTypeDeclaration

  clause 2 : (headerTypeDeclarationIR as derivedTypeDeclarationIR) = $lift_headerTypeDeclarationIR(headerTypeDeclarationIR) as derivedTypeDeclaration

  clause 3 : (headerUnionTypeDeclarationIR as derivedTypeDeclarationIR) = $lift_headerUnionTypeDeclarationIR(headerUnionTypeDeclarationIR) as derivedTypeDeclaration

def $lift_typedefIR(typedefIR) : typedef =

  clause 0 : (typeIR as typedefIR) = $lift_typeIR(typeIR) as typedef

  clause 1 : (derivedTypeDeclarationIR as typedefIR) = $lift_derivedTypeDeclarationIR(derivedTypeDeclarationIR) as typedef

def $lift_typedefDeclarationIR(typedefDeclarationIR) : typedefDeclaration =

  clause 0 : (annotationList TYPEDEF typeIR as typedefIR nameIR ';') = annotationList TYPEDEF type as typedef name ';'
  -- if (type = $lift_typeIR(typeIR))
  -- if (name = $lift_nameIR_as_typeName(nameIR) as name)

  clause 1 : (annotationList TYPEDEF derivedTypeDeclarationIR as typedefIR nameIR ';') = annotationList TYPEDEF derivedTypeDeclaration as typedef name ';'
  -- if (derivedTypeDeclaration = $lift_derivedTypeDeclarationIR(derivedTypeDeclarationIR))
  -- if (name = $lift_nameIR_as_typeName(nameIR) as name)

  clause 2 : (annotationList TYPE typeIR nameIR ';') = annotationList TYPE type name ';'
