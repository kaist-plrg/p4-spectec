syntax annotationList = 
   | `empty
   | @ name hint(print "@"#%0)
   | @ name ( annotationBody ) hint(print "@"#%0#"("#%1#")")
   | @ name [ structuredAnnotationBody ] hint(print "@"#%0#"["#%1#"]")
   | @pragma name annotationBody hint(print "@pragma" %0 %1)
   | annotationListNonEmpty annotation

def $flatten_annotationList(annotationList) : annotation* =

  clause 0 : (annotationList) = []
  -- if annotationList matches ``EMPTY`

  clause 1 : (annotationList) = [annotation]
  -- if annotationList <: annotation
  -- let annotation = annotationList as annotation

  clause 2 : (annotationList) = $flatten_annotationList(annotationListNonEmpty as annotationList) ++ [annotation]
