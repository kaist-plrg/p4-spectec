tbl def $compat_table_exact_optional_key(typeIR) : bool =
  row 0 :
    (BOOL as typeIR) -> true
  row 1 :
    (ERROR as typeIR) -> true
  row 2 :
    (integerTypeIR as typeIR) -> true
  row 3 :
    (TYPEDEF _typeId typeIR as typeIR) -> $compat_table_exact_optional_key(typeIR)
  row 4 :
    (TYPE _typeId typeIR as typeIR) -> $compat_table_exact_optional_key(typeIR)
  row 5 :
    (ENUM _typeId `{ _nameIR*{_nameIR <- _nameIR*} `} as typeIR) -> true
  row 6 :
    (ENUM _typeId `< typeIR `> `{ _valueFieldIR*{_valueFieldIR <- _valueFieldIR*} `} as typeIR) -> $compat_table_exact_optional_key(typeIR)
  row 7 :
    (_typeIR) -> false

tbl def $compat_table_lpm_ternary_range_key(typeIR) : bool =
  row 0 :
    (BOOL as typeIR) -> true
  row 1 :
    (INT as typeIR) -> true
  row 2 :
    (INT `< _nat `> as typeIR) -> true
  row 3 :
    (BIT `< _nat `> as typeIR) -> true
  row 4 :
    (TYPEDEF _typeId typeIR as typeIR) -> $compat_table_lpm_ternary_range_key(typeIR)
  row 5 :
    (TYPE _typeId typeIR as typeIR) -> $compat_table_lpm_ternary_range_key(typeIR)
  row 6 :
    (ENUM _typeId `< typeIR `> `{ _valueFieldIR*{_valueFieldIR <- _valueFieldIR*} `} as typeIR) -> $compat_table_lpm_ternary_range_key(typeIR)
  row 7 :
    (_typeIR) -> false

def $compat_table_key(nameIR, typeIR) : bool =

  clause 0 : (nameIR, typeIR) = true
  -- if (((nameIR = "exact") \/ (nameIR = "optional")) \/ (nameIR = "selector"))
  -- if $compat_table_exact_optional_key(typeIR)

  clause 1 : (nameIR, typeIR) = true
  -- if (((nameIR = "lpm") \/ (nameIR = "ternary")) \/ (nameIR = "range"))
  -- if $compat_table_lpm_ternary_range_key(typeIR)

  clause -1 : (nameIR, typeIR) = false

def $split_dataplane_parameters(parameterIR*) : (parameterIR*, parameterIR*) =

  clause 0 : ([]) = ([], [])

  clause 1 : (parameterIR_h :: parameterIR_t*{parameterIR_t <- parameterIR_t*}) = (parameterIR_data*{parameterIR_data <- parameterIR_data*}, parameterIR_h :: parameterIR_control*{parameterIR_control <- parameterIR_control*})
  -- if (_annotationList _EMPTY _typeIR _id _parameterInitializerOptIR = parameterIR_h)
  -- if ((parameterIR_data*{parameterIR_data <- parameterIR_data*}, parameterIR_control*{parameterIR_control <- parameterIR_control*}) = $split_dataplane_parameters(parameterIR_t*{parameterIR_t <- parameterIR_t*}))

  clause 2 : (parameterIR_h :: parameterIR_t*{parameterIR_t <- parameterIR_t*}) = (parameterIR_h :: parameterIR_data*{parameterIR_data <- parameterIR_data*}, parameterIR_control*{parameterIR_control <- parameterIR_control*})
  -- if (_annotationList direction _typeIR _id _parameterInitializerOptIR = parameterIR_h)
  -- if (direction =/= _EMPTY)
  -- if ((parameterIR_data*{parameterIR_data <- parameterIR_data*}, parameterIR_control*{parameterIR_control <- parameterIR_control*}) = $split_dataplane_parameters(parameterIR_t*{parameterIR_t <- parameterIR_t*}))

