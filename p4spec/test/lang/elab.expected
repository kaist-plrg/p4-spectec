    -- if (|typeIR_key*{typeIR_key <- typeIR_key*}| > 1)
    -- SelectCase_keyset_simple_ok: TC SEQ `< typeIR_key*{typeIR_key <- typeIR_key*} `> as typeIR |- '_' : simpleKeysetExpressionIR

  rulegroup tupleKeysetExpression

    rule mask: TC [typeIR_key] |- `( expression_l '&&&' expression_r `) as keysetExpression : `( [simpleKeysetExpressionIR] `) as keysetExpressionIR
    -- SelectCase_keyset_simple_ok: TC typeIR_key |- expression_l '&&&' expression_r : simpleKeysetExpressionIR

    rule range: TC [typeIR_key] |- `( expression_l '..' expression_r `) as keysetExpression : `( [simpleKeysetExpressionIR] `) as keysetExpressionIR
    -- SelectCase_keyset_simple_ok: TC typeIR_key |- expression_l '..' expression_r : simpleKeysetExpressionIR

    rule default-one-to-one: TC [typeIR_key] |- `( DEFAULT `) as keysetExpression : `( [simpleKeysetExpressionIR] `) as keysetExpressionIR
    -- SelectCase_keyset_simple_ok: TC typeIR_key |- DEFAULT : simpleKeysetExpressionIR

    rule default-many-to-one: TC typeIR_key*{typeIR_key <- typeIR_key*} |- `( DEFAULT `) as keysetExpression : `( [simpleKeysetExpressionIR] `) as keysetExpressionIR
    -- if (|typeIR_key*{typeIR_key <- typeIR_key*}| > 1)
    -- SelectCase_keyset_simple_ok: TC SEQ `< typeIR_key*{typeIR_key <- typeIR_key*} `> as typeIR |- DEFAULT : simpleKeysetExpressionIR

    rule dontcare-one-to-one: TC [typeIR_key] |- `( '_' `) as keysetExpression : `( [simpleKeysetExpressionIR] `) as keysetExpressionIR
    -- SelectCase_keyset_simple_ok: TC typeIR_key |- '_' : simpleKeysetExpressionIR

    rule dontcare-many-to-one: TC typeIR_key*{typeIR_key <- typeIR_key*} |- `( '_' `) as keysetExpression : `( [simpleKeysetExpressionIR] `) as keysetExpressionIR
    -- if (|typeIR_key*{typeIR_key <- typeIR_key*}| > 1)
