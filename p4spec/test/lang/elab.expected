  -- (if (controlLocalDeclaration = $lift_controlLocalDeclarationIR(controlLocalDeclarationIR)))*{controlLocalDeclaration <- controlLocalDeclaration*, controlLocalDeclarationIR <- controlLocalDeclarationIR*}
  -- if (controlLocalDeclarationList = $unflatten_controlLocalDeclarationList(controlLocalDeclaration*{controlLocalDeclaration <- controlLocalDeclaration*}))

def $unflatten_controlLocalDeclarationList(controlLocalDeclaration*) : controlLocalDeclarationList =

  clause 0 : (controlLocalDeclaration*{controlLocalDeclaration <- controlLocalDeclaration*}) = $unflatten_controlLocalDeclarationList'(_EMPTY, controlLocalDeclaration*{controlLocalDeclaration <- controlLocalDeclaration*})

def $unflatten_controlLocalDeclarationList'(controlLocalDeclarationList, controlLocalDeclaration*) : controlLocalDeclarationList =

  clause 0 : (controlLocalDeclarationList, []) = controlLocalDeclarationList

  clause 1 : (controlLocalDeclarationList, controlLocalDeclaration_h :: controlLocalDeclaration_t*{controlLocalDeclaration_t <- controlLocalDeclaration_t*}) = $unflatten_controlLocalDeclarationList'(controlLocalDeclarationList controlLocalDeclaration_h, controlLocalDeclaration_t*{controlLocalDeclaration_t <- controlLocalDeclaration_t*})

def $lift_controlDeclarationIR(controlDeclarationIR) : controlDeclaration =

  clause 0 : (annotationList CONTROL nameIR `< typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*} ',' typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*} `> `( parameterIR*{parameterIR <- parameterIR*} `) `( constructorParameterIR*{constructorParameterIR <- constructorParameterIR*} `) `{ controlLocalDeclarationIR*{controlLocalDeclarationIR <- controlLocalDeclarationIR*} APPLY controlBodyIR `}) = annotationList CONTROL name typeParameterListOpt `( parameterList `) constructorParameterListOpt `{ controlLocalDeclarationList APPLY controlBody `}
  -- if (name = $lift_nameIR_as_nonTypeName(nameIR) as name)
  -- if (typeParameterIR*{typeParameterIR <- typeParameterIR*} = typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*} ++ typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*})
  -- if (typeParameterListOpt = $lift_typeParameterListIR(typeParameterIR*{typeParameterIR <- typeParameterIR*}))
  -- if (parameterList = $lift_parameterListIR(parameterIR*{parameterIR <- parameterIR*}))
  -- if (constructorParameterListOpt = $lift_constructorParameterListIR(constructorParameterIR*{constructorParameterIR <- constructorParameterIR*}))
  -- if (controlLocalDeclarationList = $lift_controlLocalDeclarationListIR(controlLocalDeclarationIR*{controlLocalDeclarationIR <- controlLocalDeclarationIR*}))
  -- if (controlBody = $lift_controlBodyIR(controlBodyIR))

def $lift_packageTypeDeclarationIR(packageTypeDeclarationIR) : packageTypeDeclaration =

  clause 0 : (annotationList PACKAGE nameIR `< typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*} ',' typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*} `> `( parameterIR*{parameterIR <- parameterIR*} `) ';') = annotationList PACKAGE name typeParameterListOpt `( parameterList `) ';'
  -- if (name = $lift_nameIR_as_nonTypeName(nameIR) as name)
  -- if (typeParameterIR*{typeParameterIR <- typeParameterIR*} = typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*} ++ typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*})
  -- if (typeParameterListOpt = $lift_typeParameterListIR(typeParameterIR*{typeParameterIR <- typeParameterIR*}))
  -- if (parameterList = $lift_parameterListIR(parameterIR*{parameterIR <- parameterIR*}))

def $lift_typeDeclarationIR(typeDeclarationIR) : typeDeclaration =

  clause 0 : (derivedTypeDeclarationIR as typeDeclarationIR) = $lift_derivedTypeDeclarationIR(derivedTypeDeclarationIR) as typeDeclaration

  clause 1 : (typedefDeclarationIR as typeDeclarationIR) = $lift_typedefDeclarationIR(typedefDeclarationIR) as typeDeclaration

  clause 2 : (parserTypeDeclarationIR as typeDeclarationIR) = $lift_parserTypeDeclarationIR(parserTypeDeclarationIR) as typeDeclaration

  clause 3 : (controlTypeDeclarationIR as typeDeclarationIR) = $lift_controlTypeDeclarationIR(controlTypeDeclarationIR) as typeDeclaration

  clause 4 : (packageTypeDeclarationIR as typeDeclarationIR) = $lift_packageTypeDeclarationIR(packageTypeDeclarationIR) as typeDeclaration

def $lift_declarationIR(declarationIR) : declaration =

  clause 0 : (constantDeclarationIR as declarationIR) = $lift_constantDeclarationIR(constantDeclarationIR) as declaration

  clause 1 : (instantiationIR as declarationIR) = $lift_instantiationIR(instantiationIR) as declaration

  clause 2 : (functionDeclarationIR as declarationIR) = $lift_functionDeclarationIR(functionDeclarationIR) as declaration

  clause 3 : (actionDeclarationIR as declarationIR) = $lift_actionDeclarationIR(actionDeclarationIR) as declaration

  clause 4 : (errorDeclarationIR as declarationIR) = $lift_errorDeclarationIR(errorDeclarationIR) as declaration

  clause 5 : (matchKindDeclarationIR as declarationIR) = $lift_matchKindDeclarationIR(matchKindDeclarationIR) as declaration

  clause 6 : (externDeclarationIR as declarationIR) = $lift_externDeclarationIR(externDeclarationIR) as declaration

  clause 7 : (parserDeclarationIR as declarationIR) = $lift_parserDeclarationIR(parserDeclarationIR) as declaration

  clause 8 : (controlDeclarationIR as declarationIR) = $lift_controlDeclarationIR(controlDeclarationIR) as declaration

  clause 9 : (typeDeclarationIR as declarationIR) = $lift_typeDeclarationIR(typeDeclarationIR) as declaration

  clause -1 : (declarationIR) = $sink<declaration>
  -- debug declarationIR

def $lift_p4programIR(p4programIR) : p4program =

  clause 0 : (declarationIR*{declarationIR <- declarationIR*} ';') = $unflatten_p4program(declaration*{declaration <- declaration*})
  -- (if (declaration = $lift_declarationIR(declarationIR)))*{declaration <- declaration*, declarationIR <- declarationIR*}

def $unflatten_p4program(declaration*) : p4program =

  clause 0 : (declaration*{declaration <- declaration*}) = $unflatten_p4program'(_EMPTY, declaration*{declaration <- declaration*})

def $unflatten_p4program'(p4program, declaration*) : p4program =

  clause 0 : (p4program, []) = p4program

  clause 1 : (p4program, declaration_h :: declaration_t*{declaration_t <- declaration_t*}) = $unflatten_p4program'(p4program declaration_h, declaration_t*{declaration_t <- declaration_t*})

syntax flow = 
   | CONT (from flow) 
   | RET (from flow) 

var f : flow

def $join_flow(flow, flow) : flow =

  clause 0 : (RET, RET) = RET

  clause -1 : (f_a, f_b) = CONT

syntax loop = 
   | IN (from loop) 
   | OUT (from loop) 

var l : loop

syntax varTypeIR = 
   | direction typeIR ctk value? (from varTypeIR)  hint(prose_fields "direction" "type" "compile-time known-ness" "default value")

syntax typeFrame = map<id, varTypeIR>

def $empty_typeFrame : typeFrame =

  clause 0 :  = $empty_map<id, varTypeIR>

syntax typeDefEnv = map<typeId, typeDefIR>

def $empty_typeDefEnv : typeDefEnv =

  clause 0 :  = $empty_map<typeId, typeDefIR>

syntax callableTypeDefEnv = map<callableId, callableTypeDefIR>

def $empty_callableTypeDefEnv : callableTypeDefEnv =

  clause 0 :  = $empty_map<callableId, callableTypeDefIR>

syntax constructorTypeDefEnv = map<constructorId, constructorTypeDefIR>

def $empty_constructorTypeDefEnv : constructorTypeDefEnv =

  clause 0 :  = $empty_map<constructorId, constructorTypeDefIR>

syntax globalTypingLayer = {CONSTRUCTOR constructorTypeDefEnv, TYPE typeDefEnv, CALLABLE callableTypeDefEnv, FRAME typeFrame}

syntax blockKind = 
   | _EMPTY (from blockKind) 
   | EXTERN (from blockKind) 
   | PARSER (from blockKind) 
   | CONTROL (from blockKind) 
   | PACKAGE (from blockKind) 

syntax blockTypingLayer = {KIND blockKind, TYPE typeDefEnv, CALLABLE callableTypeDefEnv, FRAME typeFrame}

syntax actionLocalKind = 
   | ACTION (from actionLocalKind) 

syntax definedFunctionLocalKind = 
   | FUNCTION ':' typeIR (from definedFunctionLocalKind) 

syntax externFunctionLocalKind = 
   | EXTERN_FUNCTION ':' typeIR (from externFunctionLocalKind) 

syntax functionLocalKind = 
   | FUNCTION ':' typeIR (from definedFunctionLocalKind) 
   | EXTERN_FUNCTION ':' typeIR (from externFunctionLocalKind) 

syntax externMethodLocalKind = 
   | EXTERN_METHOD ':' typeIR (from externMethodLocalKind) 
   | EXTERN_METHOD ABSTRACT ':' typeIR (from externMethodLocalKind) 

syntax methodLocalKind = 
   | EXTERN_METHOD ':' typeIR (from externMethodLocalKind) 
   | EXTERN_METHOD ABSTRACT ':' typeIR (from externMethodLocalKind) 
   | PARSER_STATE (from methodLocalKind) 
   | CONTROL_APPLY_METHOD (from methodLocalKind) 
   | TABLE_APPLY_METHOD (from methodLocalKind) 

syntax localKind = 
   | _EMPTY (from localKind) 
   | ACTION (from actionLocalKind) 
   | FUNCTION ':' typeIR (from definedFunctionLocalKind) 
   | EXTERN_FUNCTION ':' typeIR (from externFunctionLocalKind) 
   | EXTERN_METHOD ':' typeIR (from externMethodLocalKind) 
   | EXTERN_METHOD ABSTRACT ':' typeIR (from externMethodLocalKind) 
   | PARSER_STATE (from methodLocalKind) 
   | CONTROL_APPLY_METHOD (from methodLocalKind) 
   | TABLE_APPLY_METHOD (from methodLocalKind) 

syntax localTypingLayer = {KIND localKind, TYPE typeDefEnv, FRAMES typeFrame*}

syntax typingContext = {CONTROL flow, LOOP loop, GLOBAL globalTypingLayer, BLOCK blockTypingLayer, LOCAL localTypingLayer}

var TC : typingContext

def $empty_typingContext : typingContext =

  clause 0 :  = TC
  -- if (globalTypingLayer = {CONSTRUCTOR $empty_constructorTypeDefEnv, TYPE $empty_typeDefEnv, CALLABLE $empty_callableTypeDefEnv, FRAME $empty_typeFrame})
  -- if (blockTypingLayer = {KIND _EMPTY, TYPE $empty_typeDefEnv, CALLABLE $empty_callableTypeDefEnv, FRAME $empty_typeFrame})
  -- if (localTypingLayer = {KIND _EMPTY, TYPE $empty_typeDefEnv, FRAMES [$empty_typeFrame]})
  -- if (TC = {CONTROL CONT, LOOP OUT, GLOBAL globalTypingLayer, BLOCK blockTypingLayer, LOCAL localTypingLayer})

def $bound(cursor, typingContext) : bound =

  clause 0 : (GLOBAL, TC) = `{ [] `}

  clause 1 : (BLOCK, TC) = $dom_map<typeId, typeDefIR>(TC.BLOCK.TYPE)

  clause 2 : (LOCAL, TC) = $union_set<typeId>(B_block, B_local)
  -- if (B_block = $bound(BLOCK, TC))
  -- if (B_local = $dom_map<typeId, typeDefIR>(TC.LOCAL.TYPE))

def $enter_t(typingContext) : typingContext =

  clause 0 : (TC) = TC[LOCAL.FRAMES = $empty_typeFrame :: TC.LOCAL.FRAMES]

def $exit_t(typingContext) : typingContext =

  clause 0 : (TC) = TC[LOCAL.FRAMES = typeFrame_t*{typeFrame_t <- typeFrame_t*}]
  -- if (typeFrame_h :: typeFrame_t*{typeFrame_t <- typeFrame_t*} = TC.LOCAL.FRAMES)

def $join_control_t(typingContext, typingContext) : flow =

  clause 0 : (TC_a, TC_b) = $join_flow(TC_a.CONTROL, TC_b.CONTROL)

def $set_control_t(typingContext, flow) : typingContext =

  clause 0 : (TC, flow) = TC[CONTROL = flow]

def $enter_loop_t(typingContext) : typingContext =

  clause 0 : (TC) = TC[LOOP = IN]

def $set_loop_t(typingContext, loop) : typingContext =

  clause 0 : (TC, loop) = TC[LOOP = loop]

def $add_var_t(cursor, typingContext, id, varTypeIR) : typingContext =

  clause 0 : (GLOBAL, TC, id, varTypeIR) = TC'
  -- if (typeFrame = TC.GLOBAL.FRAME)
  -- if ~$in_set<id>(id, $dom_map<id, varTypeIR>(typeFrame))
  -- if (_direction typeIR _ctk _value?{_value <- _value?} = varTypeIR)
  -- if (typeIR_unroll = $unroll_typeIR(typeIR))
  -- if ((id = "main") => typeIR_unroll <: packageObjectTypeIR)
  -- if (typeFrame_update = $add_map<nameIR, varTypeIR>(typeFrame, id, varTypeIR))
  -- if (TC' = TC[GLOBAL.FRAME = typeFrame_update])

  clause 1 : (BLOCK, TC, id, varTypeIR) = TC'
  -- if (typeFrame = TC.BLOCK.FRAME)
  -- if ~$in_set<id>(id, $dom_map<id, varTypeIR>(typeFrame))
  -- if (id =/= "main")
  -- if (typeFrame_update = $add_map<nameIR, varTypeIR>(TC.BLOCK.FRAME, id, varTypeIR))
  -- if (TC' = TC[BLOCK.FRAME = typeFrame_update])

  clause 2 : (LOCAL, TC, id, varTypeIR) = TC'
  -- if (typeFrame_h :: typeFrame_t*{typeFrame_t <- typeFrame_t*} = TC.LOCAL.FRAMES)
  -- if ~$in_set<id>(id, $dom_map<id, varTypeIR>(typeFrame_h))
  -- if (id =/= "main")
  -- if (typeFrame_h_update = $add_map<id, varTypeIR>(typeFrame_h, id, varTypeIR))
  -- if (typeFrame*{typeFrame <- typeFrame*} = typeFrame_h_update :: typeFrame_t*{typeFrame_t <- typeFrame_t*})
  -- if (TC' = TC[LOCAL.FRAMES = typeFrame*{typeFrame <- typeFrame*}])

def $add_vars_t(cursor, typingContext, id*, varTypeIR*) : typingContext =

  clause 0 : (p, TC, [], []) = TC

  clause 1 : (p, TC, id_h :: id_t*{id_t <- id_t*}, varTypeIR_h :: varTypeIR_t*{varTypeIR_t <- varTypeIR_t*}) = TC''
  -- if (TC' = $add_var_t(p, TC, id_h, varTypeIR_h))
  -- if (TC'' = $add_vars_t(p, TC', id_t*{id_t <- id_t*}, varTypeIR_t*{varTypeIR_t <- varTypeIR_t*}))

def $add_parameter_t(cursor, typingContext, parameterIR) : typingContext =

  clause 0 : (cursor, TC, _annotationList _EMPTY typeIR id _parameterInitializerOptIR) = TC'
  -- if (varTypeIR = _EMPTY typeIR CTK ?())
  -- if (TC' = $add_var_t(cursor, TC, id, varTypeIR))

  clause 1 : (cursor, TC, _annotationList direction typeIR id _parameterInitializerOptIR) = TC'
  -- if (direction =/= _EMPTY)
  -- if (varTypeIR = direction typeIR DYN ?())
  -- if (TC' = $add_var_t(cursor, TC, id, varTypeIR))

def $add_parameters_t(cursor, typingContext, parameterIR*) : typingContext =

  clause 0 : (cursor, TC, []) = TC

  clause 1 : (cursor, TC, parameterIR_h :: parameterIR_t*{parameterIR_t <- parameterIR_t*}) = TC''
  -- if (TC' = $add_parameter_t(cursor, TC, parameterIR_h))
  -- if (TC'' = $add_parameters_t(cursor, TC', parameterIR_t*{parameterIR_t <- parameterIR_t*}))

def $add_constructorParameter_t(typingContext, parameterIR) : typingContext =

  clause 0 : (TC, _annotationList direction typeIR id _parameterInitializerOptIR) = TC'
  -- if (varTypeIR = direction typeIR CTK ?())
  -- if (TC' = $add_var_t(BLOCK, TC, id, varTypeIR))

def $add_constructorParameters_t(typingContext, parameterIR*) : typingContext =

  clause 0 : (TC, []) = TC

  clause 1 : (TC, parameterIR_h :: parameterIR_t*{parameterIR_t <- parameterIR_t*}) = TC''
  -- if (TC' = $add_constructorParameter_t(TC, parameterIR_h))
  -- if (TC'' = $add_constructorParameters_t(TC', parameterIR_t*{parameterIR_t <- parameterIR_t*}))

def $add_typeDef_t(cursor, typingContext, typeId, typeDefIR) : typingContext =

  clause 0 : (GLOBAL, TC, typeId, typeDefIR) = TC'
  -- if (typeDefEnv = TC.GLOBAL.TYPE)
  -- if ~$in_set<typeId>(typeId, $dom_map<typeId, typeDefIR>(typeDefEnv))
  -- if (typeDefEnv_update = $add_map<typeId, typeDefIR>(typeDefEnv, typeId, typeDefIR))
  -- if (TC' = TC[GLOBAL.TYPE = typeDefEnv_update])

  clause 1 : (BLOCK, TC, typeId, typeDefIR) = TC'
  -- if (typeDefEnv = TC.BLOCK.TYPE)
  -- if ~$in_set<typeId>(typeId, $dom_map<typeId, typeDefIR>(typeDefEnv))
  -- if (typeDefEnv_update = $add_map<typeId, typeDefIR>(typeDefEnv, typeId, typeDefIR))
  -- if (TC' = TC[BLOCK.TYPE = typeDefEnv_update])

  clause 2 : (LOCAL, TC, typeId, typeDefIR) = TC'
  -- if (typeDefEnv = TC.LOCAL.TYPE)
  -- if ~$in_set<typeId>(typeId, $dom_map<typeId, typeDefIR>(typeDefEnv))
  -- if (typeDefEnv_update = $add_map<typeId, typeDefIR>(typeDefEnv, typeId, typeDefIR))
  -- if (TC' = TC[LOCAL.TYPE = typeDefEnv_update])

def $add_typeDefs_t(cursor, typingContext, typeId*, typeDefIR*) : typingContext =

  clause 0 : (p, TC, [], []) = TC

  clause 1 : (p, TC, typeId_h :: typeId_t*{typeId_t <- typeId_t*}, typeDefIR_h :: typeDefIR_t*{typeDefIR_t <- typeDefIR_t*}) = TC''
  -- if (TC' = $add_typeDef_t(p, TC, typeId_h, typeDefIR_h))
  -- if (TC'' = $add_typeDefs_t(p, TC', typeId_t*{typeId_t <- typeId_t*}, typeDefIR_t*{typeDefIR_t <- typeDefIR_t*}))

def $add_typeParameters_t(cursor, typingContext, typeId*) : typingContext =

  clause 0 : (p, TC, typeId*{typeId <- typeId*}) = $add_typeDefs_t(p, TC, typeId*{typeId <- typeId*}, _NAME typeId as typeDefIR*{typeId <- typeId*})

def $add_callableDef_overload_t(cursor, typingContext, callableId, callableTypeDefIR) : typingContext =

  clause 0 : (GLOBAL, TC, callableId, callableTypeDefIR) = TC'
  -- if (callableTypeDefEnv = TC.GLOBAL.CALLABLE)
  -- if ~$in_set<callableId>(callableId, $dom_map<callableId, callableTypeDefIR>(callableTypeDefEnv))
  -- if (callableTypeDefEnv_update = $add_map<callableId, callableTypeDefIR>(callableTypeDefEnv, callableId, callableTypeDefIR))
  -- if (TC' = TC[GLOBAL.CALLABLE = callableTypeDefEnv_update])

  clause 1 : (BLOCK, TC, callableId, callableTypeDefIR) = TC'
  -- if (callableTypeDefEnv = TC.BLOCK.CALLABLE)
  -- if ~$in_set<callableId>(callableId, $dom_map<callableId, callableTypeDefIR>(callableTypeDefEnv))
  -- if (callableTypeDefEnv_update = $add_map<callableId, callableTypeDefIR>(callableTypeDefEnv, callableId, callableTypeDefIR))
  -- if (TC' = TC[BLOCK.CALLABLE = callableTypeDefEnv_update])

def $add_callableDef_non_overload_t(cursor, typingContext, callableId, callableTypeDefIR) : typingContext =

  clause 0 : (GLOBAL, TC, callableId, callableTypeDefIR) = TC'
  -- if (callableTypeDefEnv = TC.GLOBAL.CALLABLE)
  -- if (nameIR `( _id*{_id <- _id*} `) = callableId)
  -- if (`{ nameIR_k `( _id'*{_id' <- _id'*} `)*{_id'* <- _id'**, nameIR_k <- nameIR_k*} `} = $dom_map<callableId, callableTypeDefIR>(callableTypeDefEnv))
  -- if ~$in_set<nameIR>(nameIR, `{ nameIR_k*{nameIR_k <- nameIR_k*} `})
  -- if (callableTypeDefEnv_update = $add_map<callableId, callableTypeDefIR>(callableTypeDefEnv, callableId, callableTypeDefIR))
  -- if (TC' = TC[GLOBAL.CALLABLE = callableTypeDefEnv_update])

  clause 1 : (BLOCK, TC, callableId, callableTypeDefIR) = TC'
  -- if (callableTypeDefEnv = TC.BLOCK.CALLABLE)
  -- if (nameIR `( _id*{_id <- _id*} `) = callableId)
  -- if (`{ nameIR_k `( _id'*{_id' <- _id'*} `)*{_id'* <- _id'**, nameIR_k <- nameIR_k*} `} = $dom_map<callableId, callableTypeDefIR>(callableTypeDefEnv))
  -- if ~$in_set<nameIR>(nameIR, `{ nameIR_k*{nameIR_k <- nameIR_k*} `})
  -- if (callableTypeDefEnv_update = $add_map<callableId, callableTypeDefIR>(callableTypeDefEnv, callableId, callableTypeDefIR))
  -- if (TC' = TC[BLOCK.CALLABLE = callableTypeDefEnv_update])

def $add_constructorDef_t(typingContext, callableId, constructorTypeDefIR) : typingContext =

  clause 0 : (TC, callableId, constructorTypeDefIR) = TC'
  -- if (constructorTypeDefEnv = TC.GLOBAL.CONSTRUCTOR)
  -- if ~$in_set<callableId>(callableId, $dom_map<callableId, constructorTypeDefIR>(constructorTypeDefEnv))
  -- if (constructorTypeDefEnv_update = $add_map<callableId, constructorTypeDefIR>(constructorTypeDefEnv, callableId, constructorTypeDefIR))
  -- if (TC' = TC[GLOBAL.CONSTRUCTOR = constructorTypeDefEnv_update])

def $add_constructorDef_non_overload_t(typingContext, callableId, constructorTypeDefIR) : typingContext =

  clause 0 : (TC, callableId, constructorTypeDefIR) = TC'
  -- if (constructorTypeDefEnv = TC.GLOBAL.CONSTRUCTOR)
  -- if (nameIR `( _id*{_id <- _id*} `) = callableId)
  -- if (`{ nameIR_k `( _id'*{_id' <- _id'*} `)*{_id'* <- _id'**, nameIR_k <- nameIR_k*} `} = $dom_map<callableId, constructorTypeDefIR>(constructorTypeDefEnv))
  -- if ~$in_set<nameIR>(nameIR, `{ nameIR_k*{nameIR_k <- nameIR_k*} `})
  -- if (constructorTypeDefEnv_update = $add_map<callableId, constructorTypeDefIR>(constructorTypeDefEnv, callableId, constructorTypeDefIR))
  -- if (TC' = TC[GLOBAL.CONSTRUCTOR = constructorTypeDefEnv_update])

def $add_constructorDefs_t(typingContext, callableId*, constructorTypeDefIR*) : typingContext =

  clause 0 : (TC, [], []) = TC

  clause 1 : (TC, callableId_h :: callableId_t*{callableId_t <- callableId_t*}, constructorTypeDefIR_h :: constructorTypeDefIR_t*{constructorTypeDefIR_t <- constructorTypeDefIR_t*}) = TC''
  -- if (TC' = $add_constructorDef_t(TC, callableId_h, constructorTypeDefIR_h))
  -- if (TC'' = $add_constructorDefs_t(TC', callableId_t*{callableId_t <- callableId_t*}, constructorTypeDefIR_t*{constructorTypeDefIR_t <- constructorTypeDefIR_t*}))

def $find_var_t(prefixedNameIR, cursor, typingContext) : varTypeIR? =

  clause 0 : ('.' id, p, TC) = $find_map<id, varTypeIR>(typeFrame, id)
  -- if (typeFrame = TC.GLOBAL.FRAME)

  clause 1 : (_BARE id, GLOBAL, TC) = $find_map<id, varTypeIR>(typeFrame, id)
  -- if (typeFrame = TC.GLOBAL.FRAME)

  clause 2 : (_BARE id, BLOCK, TC) = ?(varTypeIR)
  -- if (typeFrame = TC.BLOCK.FRAME)
  -- if (?(varTypeIR) = $find_map<id, varTypeIR>(typeFrame, id))

  clause 3 : (_BARE id, BLOCK, TC) = $find_var_t(_BARE id, GLOBAL, TC)
  -- if (typeFrame = TC.BLOCK.FRAME)
  -- if (?() = $find_map<id, varTypeIR>(typeFrame, id))

  clause 4 : (_BARE id, LOCAL, TC) = ?(varTypeIR)
  -- if (typeFrame*{typeFrame <- typeFrame*} = TC.LOCAL.FRAMES)
  -- if (?(varTypeIR) = $find_maps<id, varTypeIR>(typeFrame*{typeFrame <- typeFrame*}, id))

  clause 5 : (_BARE id, LOCAL, TC) = $find_var_t(_BARE id, BLOCK, TC)
  -- if (typeFrame*{typeFrame <- typeFrame*} = TC.LOCAL.FRAMES)
  -- if (?() = $find_maps<id, varTypeIR>(typeFrame*{typeFrame <- typeFrame*}, id))

def $find_var_value_t(prefixedNameIR, cursor, typingContext) : value =

  clause 0 : (prefixedNameIR, p, TC) = value
  -- if (?(_direction _typeIR _ctk ?(value)) = $find_var_t(prefixedNameIR, p, TC))

def $find_typeDef_t(cursor, typingContext, prefixedNameIR) : typeDefIR? =

  clause 0 : (p, TC, '.' typeId) = $find_map<typeId, typeDefIR>(typeDefEnv, typeId)
  -- if (typeDefEnv = TC.GLOBAL.TYPE)

  clause 1 : (GLOBAL, TC, _BARE typeId) = $find_map<typeId, typeDefIR>(typeDefEnv, typeId)
  -- if (typeDefEnv = TC.GLOBAL.TYPE)

  clause 2 : (BLOCK, TC, _BARE typeId) = ?(typeDefIR)
  -- if (typeDefEnv = TC.BLOCK.TYPE)
  -- if (?(typeDefIR) = $find_map<typeId, typeDefIR>(typeDefEnv, typeId))

  clause 3 : (BLOCK, TC, _BARE typeId) = $find_typeDef_t(GLOBAL, TC, _BARE typeId)
  -- if (typeDefEnv = TC.BLOCK.TYPE)
  -- if (?() = $find_map<typeId, typeDefIR>(typeDefEnv, typeId))

  clause 4 : (LOCAL, TC, _BARE typeId) = ?(typeDefIR)
  -- if (typeDefEnv*{typeDefEnv <- typeDefEnv*} = [TC.LOCAL.TYPE])
  -- if (?(typeDefIR) = $find_maps<typeId, typeDefIR>(typeDefEnv*{typeDefEnv <- typeDefEnv*}, typeId))

  clause 5 : (LOCAL, TC, _BARE typeId) = $find_typeDef_t(BLOCK, TC, _BARE typeId)
  -- if (typeDefEnv*{typeDefEnv <- typeDefEnv*} = [TC.LOCAL.TYPE])
  -- if (?() = $find_maps<typeId, typeDefIR>(typeDefEnv*{typeDefEnv <- typeDefEnv*}, typeId))

def $find_callableDef_overloaded_t(cursor, typingContext, prefixedNameIR, argumentIR*) : callResolution<callableTypeDefIR>? =

  clause 0 : (GLOBAL, TC, '.' nameIR, argumentIR*{argumentIR <- argumentIR*}) = $find_overloaded<callableTypeDefIR>(callableTypeDefEnv, callTargetKey, $parameterListIR_of_callableTypeDefIR)
  -- if (callableTypeDefEnv = TC.GLOBAL.CALLABLE)
  -- if (callTargetKey = $callTargetKey(nameIR, argumentIR*{argumentIR <- argumentIR*}))

  clause 1 : (GLOBAL, TC, _BARE nameIR, argumentIR*{argumentIR <- argumentIR*}) = $find_overloaded<callableTypeDefIR>(callableTypeDefEnv, callTargetKey, $parameterListIR_of_callableTypeDefIR)
  -- if (callableTypeDefEnv = TC.GLOBAL.CALLABLE)
  -- if (callTargetKey = $callTargetKey(nameIR, argumentIR*{argumentIR <- argumentIR*}))

  clause 2 : (BLOCK, TC, _BARE nameIR, argumentIR*{argumentIR <- argumentIR*}) = ?(callableId ':' callableTypeDefIR '#' id_default*{id_default <- id_default*} '#' id_optional*{id_optional <- id_optional*})
  -- if (callableTypeDefEnv = TC.BLOCK.CALLABLE)
  -- if (callTargetKey = $callTargetKey(nameIR, argumentIR*{argumentIR <- argumentIR*}))
  -- if (?(callableId ':' callableTypeDefIR '#' id_default*{id_default <- id_default*} '#' id_optional*{id_optional <- id_optional*}) = $find_overloaded<callableTypeDefIR>(callableTypeDefEnv, callTargetKey, $parameterListIR_of_callableTypeDefIR))

  clause 3 : (BLOCK, TC, _BARE nameIR, argumentIR*{argumentIR <- argumentIR*}) = $find_callableDef_overloaded_t(GLOBAL, TC, _BARE nameIR, argumentIR*{argumentIR <- argumentIR*})
  -- if (callableTypeDefEnv = TC.BLOCK.CALLABLE)
  -- if (callTargetKey = $callTargetKey(nameIR, argumentIR*{argumentIR <- argumentIR*}))
  -- if (?() = $find_overloaded<callableTypeDefIR>(callableTypeDefEnv, callTargetKey, $parameterListIR_of_callableTypeDefIR))

  clause 4 : (LOCAL, TC, _BARE nameIR, argumentIR*{argumentIR <- argumentIR*}) = $find_callableDef_overloaded_t(BLOCK, TC, _BARE nameIR, argumentIR*{argumentIR <- argumentIR*})

def $find_callableDef_non_overloaded_t(cursor, typingContext, prefixedNameIR) : (callableId, callableTypeDefIR)? =

  clause 0 : (p, TC, '.' nameIR) = $find_non_overloaded<callableTypeDefIR>(TC.GLOBAL.CALLABLE, nameIR)

  clause 1 : (GLOBAL, TC, _BARE nameIR) = $find_non_overloaded<callableTypeDefIR>(TC.GLOBAL.CALLABLE, nameIR)

  clause 2 : (BLOCK, TC, _BARE nameIR) = ?((callableId, callableTypeDefIR))
  -- if (?((callableId, callableTypeDefIR)) = $find_non_overloaded<callableTypeDefIR>(TC.BLOCK.CALLABLE, nameIR))

  clause 3 : (BLOCK, TC, _BARE nameIR) = $find_callableDef_non_overloaded_t(GLOBAL, TC, _BARE nameIR)
  -- if (?() = $find_non_overloaded<callableTypeDefIR>(TC.BLOCK.CALLABLE, nameIR))

  clause 4 : (LOCAL, TC, _BARE nameIR) = $find_callableDef_non_overloaded_t(BLOCK, TC, _BARE nameIR)

def $find_constructorDef_overloaded_t(typingContext, prefixedNameIR, argumentIR*) : callResolution<constructorTypeDefIR>? =

  clause 0 : (TC, '.' nameIR, argumentIR*{argumentIR <- argumentIR*}) = $find_overloaded<constructorTypeDefIR>(TC.GLOBAL.CONSTRUCTOR, callTargetKey, $parameterListIR_of_constructorTypeDefIR)
  -- if (callTargetKey = $callTargetKey(nameIR, argumentIR*{argumentIR <- argumentIR*}))

  clause 1 : (TC, _BARE nameIR, argumentIR*{argumentIR <- argumentIR*}) = $find_overloaded<constructorTypeDefIR>(TC.GLOBAL.CONSTRUCTOR, callTargetKey, $parameterListIR_of_constructorTypeDefIR)
  -- if (callTargetKey = $callTargetKey(nameIR, argumentIR*{argumentIR <- argumentIR*}))

def $find_local_return_type_t(typingContext) : typeIR? =

  clause 0 : (TC) = ?(typeIR_ret)
  -- if (FUNCTION ':' typeIR_ret as localKind = TC.LOCAL.KIND)

  clause 1 : (TC) = ?(typeIR_ret)
  -- if (EXTERN_FUNCTION ':' typeIR_ret as localKind = TC.LOCAL.KIND)

  clause 2 : (TC) = ?(VOID as typeIR)
  -- if (ACTION as localKind = TC.LOCAL.KIND)

  clause 3 : (TC) = ?(typeIR_ret)
  -- if (EXTERN_METHOD ':' typeIR_ret as localKind = TC.LOCAL.KIND)

  clause 4 : (TC) = ?(typeIR_ret)
  -- if (EXTERN_METHOD ABSTRACT ':' typeIR_ret as localKind = TC.LOCAL.KIND)

  clause 5 : (TC) = ?(VOID as typeIR)
  -- if (CONTROL_APPLY_METHOD as localKind = TC.LOCAL.KIND)

  clause -1 : (TC) = ?()

syntax matchKey = 
   | typeIR ':' nameIR (from matchKey) 

syntax matchAction = 
   | prefixedNameIR `( parameterIR* '@' argumentListIR `) (from matchAction) 

syntax matchPriority = {DELTA nat, LARGEST_WINS bool}

syntax matchEntries = {SIZE nat, CONST bool}

syntax matchMode = 
   | NONE (from matchMode) 
   | LPM nat (from matchMode) 
   | PRI (from matchMode) 

syntax tableContext = {KEYS matchKey*, ACTIONS matchAction*, PRIORITIES matchPriority, ENTRIES matchEntries, MODE matchMode}

var TBLC : tableContext

syntax tableEntryState = 
   | LPM nat (from tableEntryState) 
   | NON_LPM (from tableEntryState) 

var TBLS : tableEntryState

def $empty_tableContext : tableContext =

  clause 0 :  = {KEYS [], ACTIONS [], PRIORITIES matchPriority, ENTRIES matchEntries, MODE NONE}
  -- if (matchPriority = {DELTA 1, LARGEST_WINS true})
  -- if (matchEntries = {SIZE 0, CONST true})

def $add_key_tbl(tableContext, id, typeIR) : tableContext =

  clause 0 : (TBLC, id, typeIR) = TBLC[KEYS = TBLC.KEYS ++ [matchKey]]
  -- if (matchKey = typeIR ':' id)

def $add_action_tbl(tableContext, prefixedNameIR, parameterIR*, argumentListIR) : tableContext =

  clause 0 : (TBLC, prefixedNameIR, parameterIR*{parameterIR <- parameterIR*}, argumentListIR) = TBLC[ACTIONS = TBLC.ACTIONS ++ [matchAction]]
  -- if (matchAction = prefixedNameIR `( parameterIR*{parameterIR <- parameterIR*} '@' argumentListIR `))

def $is_lpm_key(tableKeyIR) : bool =

  clause 0 : (_typedExpressionIR '#' _nameIR ':' nameIR _annotationList ';') = $is_lpm_key'(nameIR)

def $is_lpm_key'(nameIR) : bool =

  clause 0 : ("lpm") = true

  clause -1 : (nameIR) = false

def $requires_priority(tableKeyIR) : bool =

  clause 0 : (_typedExpressionIR '#' _nameIR ':' nameIR _annotationList ';') = $requires_priority'(nameIR)

def $requires_priority'(nameIR) : bool =

  clause 0 : ("range") = true

  clause 1 : ("ternary") = true

  clause 2 : ("optional") = true

  clause -1 : (nameIR) = false

def $update_mode_tbl(tableContext, tableKeyIR*) : tableContext =

  clause 0 : (TBLC, tableKeyIR*{tableKeyIR <- tableKeyIR*}) = TBLC[MODE = PRI]
  -- (if (b_pri = $requires_priority(tableKeyIR)))*{b_pri <- b_pri*, tableKeyIR <- tableKeyIR*}
  -- if $exists_(b_pri*{b_pri <- b_pri*})

  clause 1 : (TBLC, tableKeyIR*{tableKeyIR <- tableKeyIR*}) = TBLC[MODE = LPM n]
  -- (if (b_pri = $requires_priority(tableKeyIR)))*{b_pri <- b_pri*, tableKeyIR <- tableKeyIR*}
  -- if ~$exists_(b_pri*{b_pri <- b_pri*})
  -- (if (b_lpm = $is_lpm_key(tableKeyIR)))*{b_lpm <- b_lpm*, tableKeyIR <- tableKeyIR*}
  -- if ([tableKeyIR_lpm] = $filter_<tableKeyIR>(tableKeyIR*{tableKeyIR <- tableKeyIR*}, b_lpm*{b_lpm <- b_lpm*}))
  -- if (typedExpressionIR '#' _nameIR ':' "lpm" _annotationList ';' = tableKeyIR_lpm)
  -- if (typeIR = $type_of_typedExpressionIR(typedExpressionIR))
  -- if (integerTypeIR as typeIR = $unroll_aliasType(typeIR))
  -- if (?(n) = $width_of_integerTypeIR(integerTypeIR))

  clause 2 : (TBLC, tableKeyIR*{tableKeyIR <- tableKeyIR*}) = TBLC[MODE = NONE]
  -- (if (b_pri = $requires_priority(tableKeyIR)))*{b_pri <- b_pri*, tableKeyIR <- tableKeyIR*}
  -- if ~$exists_(b_pri*{b_pri <- b_pri*})
  -- (if (b_lpm = $is_lpm_key(tableKeyIR)))*{b_lpm <- b_lpm*, tableKeyIR <- tableKeyIR*}
  -- if ~$exists_(b_lpm*{b_lpm <- b_lpm*})

def $find_action(tableContext, prefixedNameIR) : (parameterIR*, argumentListIR)? =

  clause 0 : (TBLC, prefixedNameIR) = $find_action'(TBLC.ACTIONS, prefixedNameIR)

def $find_action'(matchAction*, prefixedNameIR) : (parameterIR*, argumentListIR)? =

  clause 0 : ([], prefixedNameIR) = ?()

  clause 1 : (matchAction_h :: matchAction_t*{matchAction_t <- matchAction_t*}, prefixedNameIR) = ?((parameterIR*{parameterIR <- parameterIR*}, argumentListIR))
  -- if (prefixedNameIR `( parameterIR*{parameterIR <- parameterIR*} '@' argumentListIR `) = matchAction_h)

  clause 2 : (matchAction_h :: matchAction_t*{matchAction_t <- matchAction_t*}, prefixedNameIR) = $find_action'(matchAction_t*{matchAction_t <- matchAction_t*}, prefixedNameIR)
  -- if (prefixedNameIR_h `( _parameterIR*{_parameterIR <- _parameterIR*} '@' _argumentListIR `) = matchAction_h)
  -- if (prefixedNameIR_h =/= prefixedNameIR)

def $set_priorities_of_tableEntryListIR(tableContext, tableEntryState*, tableEntryListIR) : tableEntryListIR =

  clause 0 : (TBLC, TBLS*{TBLS <- TBLS*}, tableEntryIR*{tableEntryIR <- tableEntryIR*}) = tableEntryIR*{tableEntryIR <- tableEntryIR*}
  -- if (TBLC.MODE = NONE)
  -- (if (?() = $tableEntryPriorityOptIR_of_tableEntryIR(tableEntryIR)))*{tableEntryIR <- tableEntryIR*}

  clause 1 : (TBLC, TBLS*{TBLS <- TBLS*}, tableEntryIR*{tableEntryIR <- tableEntryIR*}) = tableEntryIR_updated*{tableEntryIR_updated <- tableEntryIR_updated*}
  -- if (TBLC.MODE = LPM n)
  -- (if (LPM n_prefix = TBLS))*{TBLS <- TBLS*, n_prefix <- n_prefix*}
  -- (if (?() = $tableEntryPriorityOptIR_of_tableEntryIR(tableEntryIR)))*{tableEntryIR <- tableEntryIR*}
  -- (if (tableEntryIR_updated = $set_priority_of_tableEntryIR(tableEntryIR, n_prefix)))*{n_prefix <- n_prefix*, tableEntryIR <- tableEntryIR*, tableEntryIR_updated <- tableEntryIR_updated*}

  clause 2 : (TBLC, TBLS*{TBLS <- TBLS*}, []) = []
  -- if (TBLC.MODE = PRI)

  clause 3 : (TBLC, TBLS*{TBLS <- TBLS*}, tableEntryIR_h :: tableEntryIR_t*{tableEntryIR_t <- tableEntryIR_t*}) = tableEntryIR_h_updated :: tableEntryIR_t_updated*{tableEntryIR_t_updated <- tableEntryIR_t_updated*}
  -- if (TBLC.MODE = PRI)
  -- if (?() = $tableEntryPriorityOptIR_of_tableEntryIR(tableEntryIR_h))
  -- (if (?() = $tableEntryPriorityOptIR_of_tableEntryIR(tableEntryIR_t)))*{tableEntryIR_t <- tableEntryIR_t*}
  -- if (b_lw = TBLC.PRIORITIES.LARGEST_WINS)
  -- if (n_size = TBLC.ENTRIES.SIZE)
  -- if (n_delta = TBLC.PRIORITIES.DELTA)
  -- if (n as int = $ite<int>(b_lw, (((n_size - 1) * n_delta as int) + 1 as int), 1 as int))
  -- if (tableEntryIR_h_updated = $set_priority_of_tableEntryIR(tableEntryIR_h, n))
  -- if (tableEntryIR_t_updated*{tableEntryIR_t_updated <- tableEntryIR_t_updated*} = $set_priorities_of_tableEntryListIR'(TBLC, n, tableEntryIR_t*{tableEntryIR_t <- tableEntryIR_t*}))

  clause 4 : (TBLC, TBLS*{TBLS <- TBLS*}, tableEntryIR_h :: tableEntryIR_t*{tableEntryIR_t <- tableEntryIR_t*}) = tableEntryIR_h_updated :: tableEntryIR_t_updated*{tableEntryIR_t_updated <- tableEntryIR_t_updated*}
  -- if (TBLC.MODE = PRI)
  -- if ~TBLC.ENTRIES.CONST
  -- if (?(PRIORITY '=' integerLiteral ':') = $tableEntryPriorityOptIR_of_tableEntryIR(tableEntryIR_h))
  -- if (?(n) = $nat_of_integerValue(integerLiteral as integerValue))
  -- if (tableEntryIR_h_updated = $set_priority_of_tableEntryIR(tableEntryIR_h, n))
  -- if (tableEntryIR_t_updated*{tableEntryIR_t_updated <- tableEntryIR_t_updated*} = $set_priorities_of_tableEntryListIR'(TBLC, n, tableEntryIR_t*{tableEntryIR_t <- tableEntryIR_t*}))

def $set_priorities_of_tableEntryListIR'(tableContext, nat, tableEntryIR*) : tableEntryIR* =

  clause 0 : (TBLC, n_last, []) = []

  clause 1 : (TBLC, n_last, tableEntryIR_h :: tableEntryIR_t*{tableEntryIR_t <- tableEntryIR_t*}) = tableEntryIR_h_updated :: tableEntryIR_t_updated*{tableEntryIR_t_updated <- tableEntryIR_t_updated*}
  -- if (?() = $tableEntryPriorityOptIR_of_tableEntryIR(tableEntryIR_h))
  -- if (b_lw = TBLC.PRIORITIES.LARGEST_WINS)
  -- if (n_delta = TBLC.PRIORITIES.DELTA)
  -- if (n as int = $ite<int>(b_lw, (n_last - n_delta), (n_last + n_delta) as int))
  -- if (tableEntryIR_h_updated = $set_priority_of_tableEntryIR(tableEntryIR_h, n))
  -- if (tableEntryIR_t_updated*{tableEntryIR_t_updated <- tableEntryIR_t_updated*} = $set_priorities_of_tableEntryListIR'(TBLC, n, tableEntryIR_t*{tableEntryIR_t <- tableEntryIR_t*}))

  clause 2 : (TBLC, n_last, tableEntryIR_h :: tableEntryIR_t*{tableEntryIR_t <- tableEntryIR_t*}) = tableEntryIR_h_updated :: tableEntryIR_t_updated*{tableEntryIR_t_updated <- tableEntryIR_t_updated*}
  -- if (?(PRIORITY '=' integerLiteral ':') = $tableEntryPriorityOptIR_of_tableEntryIR(tableEntryIR_h))
  -- if (?(n) = $nat_of_integerValue(integerLiteral as integerValue))
  -- if (tableEntryIR_h_updated = $set_priority_of_tableEntryIR(tableEntryIR_h, n))
  -- if (tableEntryIR_t_updated*{tableEntryIR_t_updated <- tableEntryIR_t_updated*} = $set_priorities_of_tableEntryListIR'(TBLC, n, tableEntryIR_t*{tableEntryIR_t <- tableEntryIR_t*}))

def $set_priority_of_tableEntryIR(tableEntryIR, nat) : tableEntryIR =

  clause 0 : (tableEntryIR, n) = tableEntryIR_updated
  -- if (constOptIR _tableEntryPriorityOptIR keysetExpressionIR ':' tableActionReferenceIR annotationList ';' = tableEntryIR)
  -- if (tableEntryPriorityIR = PRIORITY '=' D n as int ':')
  -- if (tableEntryIR_updated = constOptIR ?(tableEntryPriorityIR) keysetExpressionIR ':' tableActionReferenceIR annotationList ';')

def $join_tableEntryState(tableEntryState, tableEntryState) : tableEntryState =

  clause 0 : (NON_LPM, LPM n) = LPM n

  clause 1 : (LPM n, NON_LPM) = LPM n

  clause 2 : (NON_LPM, NON_LPM) = NON_LPM

def $tableEntry_lpm_prefix(value) : nat =

  clause 0 : (value) = $tableEntry_lpm_prefix'(value, 0)

def $tableEntry_lpm_prefix'(value, nat) : nat =

  clause 0 : (0 W _i as value, n_prefix) = n_prefix

  clause 1 : (w W n as int as value, n_prefix) = $tableEntry_lpm_prefix'(value', (n_prefix + 1))
  -- if (w > 0)
  -- if (w' as int = (w - 1))
  -- if ((n \ 2) =/= 0)
  -- if (n' as int = ((n - 1) / 2 as int))
  -- if (value' = w' W n' as int as value)

  clause 2 : (w W n as int as value, 0) = $tableEntry_lpm_prefix'(value', 0)
  -- if (w > 0)
  -- if (w' as int = (w - 1))
  -- if ((n \ 2) = 0)
  -- if (value' = w' W (n / 2) as int as value)

relation Type_wf: bound |- typeIR

  rulegroup baseTypeIR

    rule baseTypeIR: B |- baseTypeIR as typeIR

  rulegroup nameTypeIR

    rule nameTypeIR: B |- _NAME typeId as typeIR
    -- if $in_set<typeId>(typeId, B)

  rulegroup typedefTypeIR

    rule typedefTypeIR: B |- TYPEDEF _typeId typeIR as typeIR
    -- if $nestable_typedef(typeIR)
    -- if Type_wf: B |- typeIR holds

  rulegroup newTypeIR

    rule newTypeIR: B |- TYPE _typeId typeIR as typeIR
    -- if $nestable_new(typeIR)
    -- if Type_wf: B |- typeIR holds

  rulegroup listTypeIR

    rule listTypeIR: B |- LIST `< typeIR `> as typeIR
    -- if $nestable_list(typeIR)
    -- if Type_wf: B |- typeIR holds

  rulegroup tupleTypeIR

    rule tupleTypeIR: B |- TUPLE `< typeIR*{typeIR <- typeIR*} `> as typeIR
    -- (if $nestable_tuple(typeIR))*{typeIR <- typeIR*}
    -- (if Type_wf: B |- typeIR holds)*{typeIR <- typeIR*}

  rulegroup arrayTypeIR

    rule arrayTypeIR: B |- ARRAY typeIR `[ _nat `] as typeIR
    -- if $nestable_array(typeIR)
    -- if Type_wf: B |- typeIR holds

  rulegroup headerStackTypeIR

    rule headerStackTypeIR: B |- HEADER_STACK typeIR `[ _nat `] as typeIR
    -- if $nestable_headerStack(typeIR)
    -- if Type_wf: B |- typeIR holds

  rulegroup structTypeIR

    rule structTypeIR: B |- STRUCT _typeId `< _typeArgumentIR*{_typeArgumentIR <- _typeArgumentIR*} `> `{ _annotationList typeIR_field nameIR_field ';'*{_annotationList <- _annotationList*, nameIR_field <- nameIR_field*, typeIR_field <- typeIR_field*} `} as typeIR
    -- if $distinct_<nameIR>(nameIR_field*{nameIR_field <- nameIR_field*})
    -- (if $nestable_struct(typeIR_field))*{typeIR_field <- typeIR_field*}
    -- (if Type_wf: B |- typeIR_field holds)*{typeIR_field <- typeIR_field*}

  rulegroup headerTypeIR

    rule headerTypeIR: B |- HEADER _typeId `< _typeArgumentIR*{_typeArgumentIR <- _typeArgumentIR*} `> `{ _annotationList typeIR_field nameIR_field ';'*{_annotationList <- _annotationList*, nameIR_field <- nameIR_field*, typeIR_field <- typeIR_field*} `} as typeIR
    -- if $distinct_<nameIR>(nameIR_field*{nameIR_field <- nameIR_field*})
    -- (if $nestable_header(typeIR_field))*{typeIR_field <- typeIR_field*}
    -- (if Type_wf: B |- typeIR_field holds)*{typeIR_field <- typeIR_field*}

  rulegroup headerUnionTypeIR

    rule headerUnionTypeIR: B |- HEADER_UNION _typeId `< _typeArgumentIR*{_typeArgumentIR <- _typeArgumentIR*} `> `{ _annotationList typeIR_field nameIR_field ';'*{_annotationList <- _annotationList*, nameIR_field <- nameIR_field*, typeIR_field <- typeIR_field*} `} as typeIR
    -- if $distinct_<nameIR>(nameIR_field*{nameIR_field <- nameIR_field*})
    -- (if $nestable_headerUnion(typeIR_field))*{typeIR_field <- typeIR_field*}
    -- (if Type_wf: B |- typeIR_field holds)*{typeIR_field <- typeIR_field*}

  rulegroup enumTypeIR

    rule non-serializable: B |- ENUM _typeId `{ nameIR_field*{nameIR_field <- nameIR_field*} `} as typeIR
    -- if $distinct_<nameIR>(nameIR_field*{nameIR_field <- nameIR_field*})

    rule serializable: B |- ENUM _typeId `< typeIR `> `{ nameIR_field '=' _value ';'*{_value <- _value*, nameIR_field <- nameIR_field*} `} as typeIR
    -- if $distinct_<nameIR>(nameIR_field*{nameIR_field <- nameIR_field*})
    -- if $nestable_enum_serializable(typeIR)
    -- if Type_wf: B |- typeIR holds

  rulegroup externObjectTypeIR

    rule externObjectTypeIR: B |- EXTERN _typeId `< _typeArgumentIR*{_typeArgumentIR <- _typeArgumentIR*} `> `{ _callableId ':' externMethodTypeDefIR*{_callableId <- _callableId*, externMethodTypeDefIR <- externMethodTypeDefIR*} `} as typeIR
    -- (if CallableTypeDef_wf: B |- externMethodTypeDefIR as callableTypeDefIR holds)*{externMethodTypeDefIR <- externMethodTypeDefIR*}

  rulegroup parserObjectTypeIR

    rule parserObjectTypeIR: B |- PARSER _typeId `< _typeArgumentIR*{_typeArgumentIR <- _typeArgumentIR*} `> `( parameterIR*{parameterIR <- parameterIR*} `) as typeIR
    -- (if ParameterType_wf: B |- parameterIR holds)*{parameterIR <- parameterIR*}

  rulegroup controlObjectTypeIR

    rule controlObjectTypeIR: B |- CONTROL _typeId `< _typeArgumentIR*{_typeArgumentIR <- _typeArgumentIR*} `> `( parameterIR*{parameterIR <- parameterIR*} `) as typeIR
    -- (if ParameterType_wf: B |- parameterIR holds)*{parameterIR <- parameterIR*}

  rulegroup packageObjectTypeIR

    rule packageObjectTypeIR: B |- PACKAGE _typeId `< _typeArgumentIR*{_typeArgumentIR <- _typeArgumentIR*} `> `{ typeIR*{typeIR <- typeIR*} `} as typeIR
    -- (if Type_wf: B |- typeIR holds)*{typeIR <- typeIR*}

  rulegroup tableObjectTypeIR

    rule tableObjectTypeIR: B |- TABLE _typeId `{ tableMetadataStructTypeIR `} as typeIR
    -- if Type_wf: B |- tableMetadataStructTypeIR as typeIR holds

  rulegroup defaultTypeIR

    rule defaultTypeIR: B |- DEFAULT as typeIR

  rulegroup invalidHeaderTypeIR

    rule invalidHeaderTypeIR: B |- HEADER_INVALID as typeIR

  rulegroup sequenceTypeIR

    rule non-default: B |- SEQ `< typeIR*{typeIR <- typeIR*} `> as typeIR
    -- (if Type_wf: B |- typeIR holds)*{typeIR <- typeIR*}

    rule default: B |- SEQ `< typeIR*{typeIR <- typeIR*} ',' '...' `> as typeIR
    -- (if Type_wf: B |- typeIR holds)*{typeIR <- typeIR*}

  rulegroup recordTypeIR

    rule non-default: B |- RECORD `{ _annotationList typeIR_field nameIR_field ';'*{_annotationList <- _annotationList*, nameIR_field <- nameIR_field*, typeIR_field <- typeIR_field*} `} as typeIR
    -- if $distinct_<nameIR>(nameIR_field*{nameIR_field <- nameIR_field*})
    -- (if Type_wf: B |- typeIR_field holds)*{typeIR_field <- typeIR_field*}

    rule default: B |- RECORD `{ _annotationList typeIR_field nameIR_field ';'*{_annotationList <- _annotationList*, nameIR_field <- nameIR_field*, typeIR_field <- typeIR_field*} ',' '...' `} as typeIR
    -- if $distinct_<nameIR>(nameIR_field*{nameIR_field <- nameIR_field*})
    -- (if Type_wf: B |- typeIR_field holds)*{typeIR_field <- typeIR_field*}

  rulegroup setTypeIR

    rule setTypeIR: B |- SET `< typeIR `> as typeIR
    -- if $nestable_set(typeIR)
    -- if Type_wf: B |- typeIR holds

  rulegroup tableMetadataTypeIR

    rule enum: B |- TABLE_ENUM _typeId `{ nameIR*{nameIR <- nameIR*} `} as typeIR
    -- if $distinct_<nameIR>(nameIR*{nameIR <- nameIR*})

    rule struct: B |- TABLE_STRUCT _typeId `{ HIT _boolTypeIR ';' MISS _boolTypeIR' ';' ACTION_RUN tableMetadataEnumTypeIR ';' `} as typeIR
    -- if Type_wf: B |- tableMetadataEnumTypeIR as typeIR holds

relation TypeDef_wf: bound |- typeDefIR

  rulegroup 

    rule : B |- typeDefIR
    -- if ((typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*}, typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*}) = $typeParameterListIR_of_typeDefIR(typeDefIR))
    -- if (typeParameterIR*{typeParameterIR <- typeParameterIR*} = typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*} ++ typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*})
    -- if $distinct_<typeId>(typeParameterIR*{typeParameterIR <- typeParameterIR*})
    -- if (typeIR_base = $typeIR_of_typeDefIR(typeDefIR))
    -- if (B_inner = $union_set<typeId>(B, `{ typeParameterIR*{typeParameterIR <- typeParameterIR*} `}))
    -- if Type_wf: B_inner |- typeIR_base holds

relation ParameterType_wf: bound |- parameterIR

  rulegroup 

    rule non-default: B |- _annotationList direction typeIR _id ?()
    -- if Type_wf: B |- typeIR holds
    -- if (typeIR_unroll = $unroll_typeIR(typeIR))
    -- if ~typeIR_unroll <: synthesizedTypeIR
    -- if ((((typeIR_unroll = INT as typeIR) \/ typeIR_unroll <: stringTypeIR) \/ typeIR_unroll <: objectTypeIR) => (direction = _EMPTY))

    rule default: B |- annotationList direction typeIR _id ?(parameterInitializerIR)
    -- if Type_wf: B |- typeIR holds
    -- if (typeIR_unroll = $unroll_typeIR(typeIR))
    -- if ~typeIR_unroll <: synthesizedTypeIR
    -- if ((((typeIR_unroll = INT as typeIR) \/ typeIR_unroll <: stringTypeIR) \/ typeIR_unroll <: objectTypeIR) => (direction = _EMPTY))
    -- if ((direction = IN) \/ (direction = _EMPTY))
    -- if ~$optional_annotation_of_parameterIR'(annotationList)

relation ReturnType_wf: bound |- typeIR

  rulegroup 

    rule : B |- typeIR_ret
    -- if Type_wf: B |- typeIR_ret holds
    -- if (typeIR_unroll = $unroll_typeIR(typeIR_ret))
    -- if ((~(typeIR_unroll = INT as typeIR) /\ ~typeIR_unroll <: synthesizedTypeIR) /\ ~typeIR_unroll <: objectTypeIR)

relation CallableType_wf: bound |- callableTypeIR

  rulegroup actionTypeIR

    rule actionTypeIR: B |- _annotationList ACTION _nameIR `( parameterIR*{parameterIR <- parameterIR*} `) as callableTypeIR
    -- (if ParameterType_wf: B |- parameterIR holds)*{parameterIR <- parameterIR*}
    -- (if ~$is_optional_parameterIR(parameterIR))*{parameterIR <- parameterIR*}
    -- (if (_annotationList' direction typeIR _id _parameterInitializerOptIR = parameterIR))*{_annotationList' <- _annotationList'*, _id <- _id*, _parameterInitializerOptIR <- _parameterInitializerOptIR*, direction <- direction*, parameterIR <- parameterIR*, typeIR <- typeIR*}
    -- if $directionless_trailing(direction*{direction <- direction*})
    -- (if $nestable_action(typeIR))*{typeIR <- typeIR*}

  rulegroup definedFunctionTypeIR

    rule definedFunctionTypeIR: B |- FUNCTION _nameIR `( parameterIR*{parameterIR <- parameterIR*} `) ':' typeIR_ret as callableTypeIR
    -- (if ParameterType_wf: B |- parameterIR holds)*{parameterIR <- parameterIR*}
    -- (if ~$is_optional_parameterIR(parameterIR))*{parameterIR <- parameterIR*}
