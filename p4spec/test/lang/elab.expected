  -- let intTypeIR = typeIR as intTypeIR
  -- if (intTypeIR = int)
  -- if integerValue <: integerLiteral
  -- let integerLiteral = integerValue as integerLiteral
  -- if integerLiteral matches `%W%`
  -- let _nat w i = integerLiteral

  clause 4 : (typeIR, integerValue) = d $bitstr_to_int(w as int, i) as value
  -- if typeIR <: intTypeIR
