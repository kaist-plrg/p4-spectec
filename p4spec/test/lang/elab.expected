def $cast_op(typeIR, value) : value =

  clause 0 : (typeIR, value) = $cast_bool(typeIR_unroll, boolValue)
  -- if value <: boolValue
  -- let boolValue = value as boolValue
  -- let typeIR_unroll = $unroll_typeIR(typeIR)

  clause 1 : (typeIR, value) = $cast_int(typeIR_unroll, integerValue)
