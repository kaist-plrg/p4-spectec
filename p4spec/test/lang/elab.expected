def $merge_frames(frame, frame) : frame =

  clause 0 : (frame, `{ id ':' value*{id <- id*, value <- value*} `}) = $adds_map<id, value>(frame, id*{id <- id*}, value*{value <- value*})

def $merge_externMethodDefEnvs(externMethodDefEnv, callableDefEnv) : externMethodDefEnv =

  clause 0 : (externMethodDefEnv, `{ [] `}) = externMethodDefEnv

  clause 1 : (externMethodDefEnv, `{ callableId_h ':' callableDef_h :: callableId_t ':' callableDef_t*{callableDef_t <- callableDef_t*, callableId_t <- callableId_t*} `}) = $merge_externMethodDefEnvs(externMethodDefEnv_post, `{ callableId_t ':' callableDef_t*{callableDef_t <- callableDef_t*, callableId_t <- callableId_t*} `})
  -- if (FUNCTION nameIR `< typeParameterListIR `> `( parameterListIR `) blockStatementIR as callableDef = callableDef_h)
  -- if (externMethodDef_h = EXTERN_METHOD nameIR `< typeParameterListIR `> `( parameterListIR `) ?(blockStatementIR))
  -- if (externMethodDefEnv_post = $update_map<callableId, externMethodDef>(externMethodDefEnv, callableId_h, externMethodDef_h))

relation ObjectDecl_inst: instContext store |- objectDeclarationIR : instContext store

  rulegroup 

    rule functionDeclarationIR: IC_0 STO |- functionDeclarationIR as objectDeclarationIR : IC_1 STO
    -- FuncDecl_inst: BLOCK IC_0 |- functionDeclarationIR : IC_1

    rule instantiationIR: IC_0 STO_0 |- instantiationIR as objectDeclarationIR : IC_1 STO_1
    -- InstDecl_inst: GLOBAL IC_0 STO_0 |- instantiationIR : IC_1 STO_1 _constantDeclarationIR

relation ObjectDecls_inst: instContext store |- objectDeclarationListIR : instContext store

  rulegroup 

    rule nil: IC STO |- [] : IC STO

    rule cons: IC_0 STO_0 |- objectDeclarationIR_h :: objectDeclarationIR_t*{objectDeclarationIR_t <- objectDeclarationIR_t*} : IC_2 STO_2
    -- ObjectDecl_inst: IC_0 STO_0 |- objectDeclarationIR_h : IC_1 STO_1
    -- ObjectDecls_inst: IC_1 STO_1 |- objectDeclarationIR_t*{objectDeclarationIR_t <- objectDeclarationIR_t*} : IC_2 STO_2

def $callableId_of_externMethodPrototypeIR(externMethodPrototypeIR) : callableId =

  clause 0 : (_annotationList _typeIR nameIR `< _typeParameterListIR ',' _typeParameterListIR' `> `( parameterListIR `) ';') = $callableId_IR(nameIR, parameterListIR)

  clause 1 : (_annotationList ABSTRACT _typeIR nameIR `< _typeParameterListIR ',' _typeParameterListIR' `> `( parameterListIR `) ';') = $callableId_IR(nameIR, parameterListIR)

def $callableId_of_externConstructorPrototypeIR(externConstructorPrototypeIR) : callableId =

  clause 0 : (_annotationList nameIR `< ',' _typeParameterListIR `> `( parameterIR*{parameterIR <- parameterIR*} `) ';') = $callableId_IR(nameIR, parameterIR*{parameterIR <- parameterIR*})

def $constructor_of_externConstructorPrototypeIR(typeParameterListIR, externMethodPrototypeListIR, externConstructorPrototypeIR) : constructorDef =

  clause 0 : (typeParameterListIR_expl, externMethodPrototypeListIR, _annotationList nameIR `< ',' typeParameterListIR_impl `> `( parameterIR*{parameterIR <- parameterIR*} `) ';') = constructorDef
  -- if (typeParameterListIR = typeParameterListIR_expl ++ typeParameterListIR_impl)
  -- if (constructorDef = EXTERN nameIR `< typeParameterListIR `> `( parameterIR*{parameterIR <- parameterIR*} `) `{ externMethodPrototypeListIR `} as constructorDef)

def $init_table(tablePropertyListIR) : tableObjectProperty =

  clause 0 : (tablePropertyIR*{tablePropertyIR <- tablePropertyIR*}) = TBL
  -- if (tableKeysPropertyIR = $init_tableKeys(tablePropertyIR*{tablePropertyIR <- tablePropertyIR*}))
  -- if ([tableActionsPropertyIR] as tablePropertyIR* = $filter_<tablePropertyIR>(tablePropertyIR*{tablePropertyIR <- tablePropertyIR*}, tablePropertyIR <: tableActionsPropertyIR*{tablePropertyIR <- tablePropertyIR*}))
  -- if ([tableDefaultActionPropertyIR] as tablePropertyIR* = $filter_<tablePropertyIR>(tablePropertyIR*{tablePropertyIR <- tablePropertyIR*}, tablePropertyIR <: tableDefaultActionPropertyIR*{tablePropertyIR <- tablePropertyIR*}))
  -- if (tableEntriesPropertyIR = $init_tableEntries(tablePropertyIR*{tablePropertyIR <- tablePropertyIR*}))
  -- if (tableCustomPropertyIR*{tableCustomPropertyIR <- tableCustomPropertyIR*} as tablePropertyIR* = $filter_<tablePropertyIR>(tablePropertyIR*{tablePropertyIR <- tablePropertyIR*}, tablePropertyIR <: tableCustomPropertyIR*{tablePropertyIR <- tablePropertyIR*}))
  -- if (TBL = {KEYS tableKeysPropertyIR, ACTIONS tableActionsPropertyIR, DEFAULT_ACTION tableDefaultActionPropertyIR, ENTRIES tableEntriesPropertyIR, CUSTOMS tableCustomPropertyIR*{tableCustomPropertyIR <- tableCustomPropertyIR*}})

def $init_tableKeys(tablePropertyListIR) : tableKeysPropertyIR =

  clause 0 : (tablePropertyIR*{tablePropertyIR <- tablePropertyIR*}) = tableKeysPropertyIR
  -- if ([tableKeysPropertyIR] as tablePropertyIR* = $filter_<tablePropertyIR>(tablePropertyIR*{tablePropertyIR <- tablePropertyIR*}, tablePropertyIR <: tableKeysPropertyIR*{tablePropertyIR <- tablePropertyIR*}))

  clause 1 : (tablePropertyIR*{tablePropertyIR <- tablePropertyIR*}) = KEY '=' `{ [] `}
  -- if ([] = $filter_<tablePropertyIR>(tablePropertyIR*{tablePropertyIR <- tablePropertyIR*}, tablePropertyIR <: tableKeysPropertyIR*{tablePropertyIR <- tablePropertyIR*}))

def $init_tableEntries(tablePropertyListIR) : tableEntriesPropertyIR =

  clause 0 : (tablePropertyIR*{tablePropertyIR <- tablePropertyIR*}) = tableEntriesPropertyIR
  -- if ([tableEntriesPropertyIR] as tablePropertyIR* = $filter_<tablePropertyIR>(tablePropertyIR*{tablePropertyIR <- tablePropertyIR*}, tablePropertyIR <: tableEntriesPropertyIR*{tablePropertyIR <- tablePropertyIR*}))

  clause 1 : (tablePropertyIR*{tablePropertyIR <- tablePropertyIR*}) = _EMPTY ?() ENTRIES '=' `{ [] `}
  -- if ([] = $filter_<tablePropertyIR>(tablePropertyIR*{tablePropertyIR <- tablePropertyIR*}, tablePropertyIR <: tableEntriesPropertyIR*{tablePropertyIR <- tablePropertyIR*}))

syntax globalEvalLayer = globalInstLayer

syntax blockEvalLayer = blockInstLayer

syntax localEvalLayer = localInstLayer

syntax evalContext = {GLOBAL globalEvalLayer, BLOCK blockEvalLayer, LOCAL localEvalLayer}

var EC : evalContext

def $enter_e(evalContext) : evalContext =

  clause 0 : (EC) = EC[LOCAL.FRAMES = $empty_frame :: EC.LOCAL.FRAMES]

def $exit_e(evalContext) : evalContext =

  clause 0 : (EC) = EC[LOCAL.FRAMES = frame_t*{frame_t <- frame_t*}]
  -- if (EC.LOCAL.FRAMES = frame_h :: frame_t*{frame_t <- frame_t*})

def $inherit_e(cursor, evalContext) : evalContext =

  clause 0 : (GLOBAL, EC) = EC[BLOCK = blockEvalLayer][LOCAL = localEvalLayer]
  -- if (blockEvalLayer = {TYPE $empty_theta, CALLABLE $empty_callableDefEnv, STATE $empty_stateEnv, FRAME $empty_frame})
  -- if (localEvalLayer = {TYPE $empty_theta, FRAMES [$empty_frame]})

  clause 1 : (BLOCK, EC) = EC[LOCAL = localEvalLayer]
  -- if (localEvalLayer = {TYPE $empty_theta, FRAMES [$empty_frame]})

  clause 2 : (LOCAL, EC) = EC

def $copy_e(cursor, evalContext, evalContext) : evalContext =

  clause 0 : (GLOBAL, EC_from, EC_to) = EC_to[GLOBAL = EC_from.GLOBAL]

  clause 1 : (BLOCK, EC_from, EC_to) = EC_to[GLOBAL = EC_from.GLOBAL][BLOCK = EC_from.BLOCK]

  clause 2 : (LOCAL, EC_from, EC_to) = EC_to[GLOBAL = EC_from.GLOBAL][BLOCK = EC_from.BLOCK][LOCAL = EC_from.LOCAL]

def $add_var_e(cursor, evalContext, prefixedNameIR, value) : evalContext =

  clause 0 : (GLOBAL, EC, '.' id, value) = EC[GLOBAL.FRAME = frame]
  -- if (frame = $add_map<id, value>(EC.GLOBAL.FRAME, id, value))

  clause 1 : (GLOBAL, EC, _BARE id, value) = EC[GLOBAL.FRAME = frame]
  -- if (frame = $add_map<id, value>(EC.GLOBAL.FRAME, id, value))

  clause 2 : (BLOCK, EC, _BARE id, value) = EC[BLOCK.FRAME = frame]
  -- if (frame = $add_map<id, value>(EC.BLOCK.FRAME, id, value))

  clause 3 : (LOCAL, EC, _BARE id, value) = EC[LOCAL.FRAMES = frame_h' :: frame_t*{frame_t <- frame_t*}]
  -- if (EC.LOCAL.FRAMES = frame_h :: frame_t*{frame_t <- frame_t*})
  -- if (frame_h' = $add_map<id, value>(frame_h, id, value))

def $add_vars_e(cursor, evalContext, prefixedNameIR*, value*) : evalContext =

  clause 0 : (p, EC, [], []) = EC

  clause 1 : (p, EC, prefixedNameIR_h :: prefixedNameIR_t*{prefixedNameIR_t <- prefixedNameIR_t*}, value_h :: value_t*{value_t <- value_t*}) = EC''
  -- if (EC' = $add_var_e(p, EC, prefixedNameIR_h, value_h))
  -- if (EC'' = $add_vars_e(p, EC', prefixedNameIR_t*{prefixedNameIR_t <- prefixedNameIR_t*}, value_t*{value_t <- value_t*}))

def $update_var_e(cursor, evalContext, prefixedNameIR, value) : evalContext =

  clause 0 : (p, EC, '.' id, value) = EC[GLOBAL.FRAME = frame]
  -- if (frame = $update_map<id, value>(EC.GLOBAL.FRAME, id, value))

  clause 1 : (GLOBAL, EC, _BARE id, value) = EC[GLOBAL.FRAME = frame']
  -- if (frame = EC.GLOBAL.FRAME)
  -- if $in_set<id>(id, $dom_map<id, value>(frame))
  -- if (frame' = $update_map<id, value>(frame, id, value))

  clause 2 : (BLOCK, EC, _BARE id, value) = EC[BLOCK.FRAME = frame']
  -- if (frame = EC.BLOCK.FRAME)
  -- if $in_set<id>(id, $dom_map<id, value>(frame))
  -- if (frame' = $update_map<id, value>(frame, id, value))

  clause 3 : (BLOCK, EC, _BARE id, value) = $update_var_e(GLOBAL, EC, _BARE id, value)
  -- if (frame = EC.BLOCK.FRAME)
  -- if ~$in_set<id>(id, $dom_map<id, value>(frame))

  clause 4 : (LOCAL, EC, _BARE id, value) = $update_var_e(BLOCK, EC, _BARE id, value)
  -- if ([] = EC.LOCAL.FRAMES)

  clause 5 : (LOCAL, EC, _BARE id, value) = EC[LOCAL.FRAMES = frame_h' :: frame_t*{frame_t <- frame_t*}]
  -- if (frame_h :: frame_t*{frame_t <- frame_t*} = EC.LOCAL.FRAMES)
  -- if $in_set<id>(id, $dom_map<id, value>(frame_h))
  -- if (frame_h' = $update_map<id, value>(frame_h, id, value))

  clause 6 : (LOCAL, EC, _BARE id, value) = EC_pop'[LOCAL.FRAMES = frame_h :: EC_pop'.LOCAL.FRAMES]
  -- if (frame_h :: frame_t*{frame_t <- frame_t*} = EC.LOCAL.FRAMES)
  -- if ~$in_set<id>(id, $dom_map<id, value>(frame_h))
  -- if (EC_pop = EC[LOCAL.FRAMES = frame_t*{frame_t <- frame_t*}])
  -- if (EC_pop' = $update_var_e(LOCAL, EC_pop, _BARE id, value))

def $find_var_e(prefixedNameIR, cursor, evalContext) : value =

  clause 0 : ('.' id, p, EC) = value
  -- if (?(value) = $find_map<id, value>(EC.GLOBAL.FRAME, id))

  clause 1 : (_BARE id, GLOBAL, EC) = value
  -- if (?(value) = $find_map<id, value>(EC.GLOBAL.FRAME, id))

  clause 2 : (_BARE id, BLOCK, EC) = value
  -- if (?(value) = $find_map<id, value>(EC.BLOCK.FRAME, id))

  clause 3 : (_BARE id, BLOCK, EC) = $find_var_e(_BARE id, GLOBAL, EC)
  -- if (?() = $find_map<id, value>(EC.BLOCK.FRAME, id))

  clause 4 : (_BARE id, LOCAL, EC) = value
  -- if (?(value) = $find_maps<id, value>(EC.LOCAL.FRAMES, id))

  clause 5 : (_BARE id, LOCAL, EC) = $find_var_e(_BARE id, BLOCK, EC)
  -- if (?() = $find_maps<id, value>(EC.LOCAL.FRAMES, id))

def $find_typeDef_e(cursor, evalContext, prefixedNameIR) : typeDefIR? =

  clause 0 : (_p, EC, _BARE nameIR) = $find_map<typeId, typeDefIR>(EC.GLOBAL.TYPE, nameIR)

  clause 1 : (_p, EC, '.' nameIR) = $find_map<typeId, typeDefIR>(EC.GLOBAL.TYPE, nameIR)

def $find_type_e(cursor, evalContext, nameIR) : typeIR? =

  clause 0 : (BLOCK, EC, nameIR) = $find_map<typeId, typeIR>(EC.BLOCK.TYPE, nameIR)

  clause 1 : (LOCAL, EC, nameIR) = ?(typeIR)
  -- if (?(typeIR) = $find_map<typeId, typeIR>(EC.LOCAL.TYPE, nameIR))

  clause 2 : (LOCAL, EC, nameIR) = $find_type_e(BLOCK, EC, nameIR)
  -- if (?() = $find_map<typeId, typeIR>(EC.LOCAL.TYPE, nameIR))

def $find_callableDef_overloaded_e(cursor, evalContext, prefixedNameIR, argumentIR*) : callResolution<(cursor, callableDef)>? =

  clause 0 : (GLOBAL, EC, _BARE nameIR, argumentIR*{argumentIR <- argumentIR*}) = ?(callableId ':' (GLOBAL, callableDef) '#' id_default*{id_default <- id_default*} '#' id_optional*{id_optional <- id_optional*})
  -- if (callTargetKey = $callTargetKey(nameIR, argumentIR*{argumentIR <- argumentIR*}))
  -- if (?(callableId ':' callableDef '#' id_default*{id_default <- id_default*} '#' id_optional*{id_optional <- id_optional*}) = $find_overloaded<callableDef>(EC.GLOBAL.CALLABLE, callTargetKey, $parameterListIR_of_callableDef))

  clause 1 : (GLOBAL, EC, _BARE nameIR, argumentIR*{argumentIR <- argumentIR*}) = ?()
  -- if (callTargetKey = $callTargetKey(nameIR, argumentIR*{argumentIR <- argumentIR*}))
  -- if (?() = $find_overloaded<callableDef>(EC.GLOBAL.CALLABLE, callTargetKey, $parameterListIR_of_callableDef))

  clause 2 : (GLOBAL, EC, '.' nameIR, argumentIR*{argumentIR <- argumentIR*}) = ?(callableId ':' (GLOBAL, callableDef) '#' id_default*{id_default <- id_default*} '#' id_optional*{id_optional <- id_optional*})
  -- if (callTargetKey = $callTargetKey(nameIR, argumentIR*{argumentIR <- argumentIR*}))
  -- if (?(callableId ':' callableDef '#' id_default*{id_default <- id_default*} '#' id_optional*{id_optional <- id_optional*}) = $find_overloaded<callableDef>(EC.GLOBAL.CALLABLE, callTargetKey, $parameterListIR_of_callableDef))

  clause 3 : (GLOBAL, EC, '.' nameIR, argumentIR*{argumentIR <- argumentIR*}) = ?()
  -- if (callTargetKey = $callTargetKey(nameIR, argumentIR*{argumentIR <- argumentIR*}))
  -- if (?() = $find_overloaded<callableDef>(EC.GLOBAL.CALLABLE, callTargetKey, $parameterListIR_of_callableDef))

  clause 4 : (BLOCK, EC, _BARE nameIR, argumentIR*{argumentIR <- argumentIR*}) = ?(callableId ':' (BLOCK, callableDef) '#' id_default*{id_default <- id_default*} '#' id_optional*{id_optional <- id_optional*})
  -- if (callTargetKey = $callTargetKey(nameIR, argumentIR*{argumentIR <- argumentIR*}))
  -- if (?(callableId ':' callableDef '#' id_default*{id_default <- id_default*} '#' id_optional*{id_optional <- id_optional*}) = $find_overloaded<callableDef>(EC.BLOCK.CALLABLE, callTargetKey, $parameterListIR_of_callableDef))

  clause 5 : (BLOCK, EC, _BARE nameIR, argumentIR*{argumentIR <- argumentIR*}) = $find_callableDef_overloaded_e(GLOBAL, EC, _BARE nameIR, argumentIR*{argumentIR <- argumentIR*})
  -- if (callTargetKey = $callTargetKey(nameIR, argumentIR*{argumentIR <- argumentIR*}))
  -- if (?() = $find_overloaded<callableDef>(EC.BLOCK.CALLABLE, callTargetKey, $parameterListIR_of_callableDef))

  clause 6 : (LOCAL, EC, _BARE nameIR, argumentIR*{argumentIR <- argumentIR*}) = $find_callableDef_overloaded_e(BLOCK, EC, _BARE nameIR, argumentIR*{argumentIR <- argumentIR*})

def $find_constructorDef_e(evalContext, prefixedNameIR, argumentIR*) : callResolution<constructorDef>? =

  clause 0 : (EC, _BARE nameIR, argumentIR*{argumentIR <- argumentIR*}) = $find_overloaded<constructorDef>(EC.GLOBAL.CONSTRUCTOR, callTargetKey, $parameterListIR_of_constructorDef)
  -- if (callTargetKey = $callTargetKey(nameIR, argumentIR*{argumentIR <- argumentIR*}))

  clause 1 : (EC, '.' nameIR, argumentIR*{argumentIR <- argumentIR*}) = $find_overloaded<constructorDef>(EC.GLOBAL.CONSTRUCTOR, callTargetKey, $parameterListIR_of_constructorDef)
  -- if (callTargetKey = $callTargetKey(nameIR, argumentIR*{argumentIR <- argumentIR*}))

def $find_parserState_e(evalContext, nameIR) : parserStateIR? =

  clause 0 : (EC, nameIR) = $find_map<nameIR, parserStateIR>(EC.BLOCK.STATE, nameIR)

def $subst_type_e(cursor, evalContext, typeIR) : typeIR =

  clause 0 : (GLOBAL, EC, typeIR) = typeIR

  clause 1 : (BLOCK, EC, typeIR) = typeIR_subst
  -- if (theta = EC.BLOCK.TYPE)
  -- if (typeIR_subst = $subst_typeIR(theta, typeIR))

  clause 2 : (LOCAL, EC, typeIR) = typeIR_subst
  -- if (theta_block = EC.BLOCK.TYPE)
  -- if (theta_local = EC.LOCAL.TYPE)
  -- if (theta = $extend_map<typeId, typeIR>(theta_block, theta_local))
  -- if (typeIR_subst = $subst_typeIR(theta, typeIR))

extern syntax archState

extern def $init_archState : archState

syntax arch = {STATE archState, STORE store}

var ARCH : arch

def $add_object_e(arch, objectId, object) : arch =

  clause 0 : (ARCH, objectId, object) = ARCH[STORE = STO]
  -- if (STO = $add_map<objectId, object>(ARCH.STORE, objectId, object))

def $find_archState_e(arch) : archState =

  clause 0 : (ARCH) = ARCH.STATE

def $find_object_e(arch, objectId) : object? =

  clause 0 : (ARCH, objectId) = $find_map<objectId, object>(ARCH.STORE, objectId)

def $find_object_qualified_e(arch, objectId) : object? =

  clause 0 : (ARCH, objectId) = $find_object_e(ARCH, objectId)

def $find_object_unqualified_e(arch, id) : object? =

  clause 0 : (ARCH, id) = ?(object_id_found)
  -- if (`{ objectId ':' object*{object <- object*, objectId <- objectId*} `} = ARCH.STORE)
  -- (if (object_id?{object_id <- object_id?} = $ite<object?>($objectId_ends_with(objectId, id), ?(object), ?())))*{object <- object*, objectId <- objectId*, object_id? <- object_id?*}
  -- if ([?(object_id_found)] = $filter_<object?>(object_id?{object_id <- object_id?}*{object_id? <- object_id?*}, (object_id?{object_id <- object_id?} =/= ?())*{object_id? <- object_id?*}))

  clause -1 : (ARCH, id) = ?()

def $find_objectState_e(arch, objectId) : objectState? =

  clause 0 : (ARCH, objectId) = ?(objectState)
  -- if (?(externObject as object) = $find_object_e(ARCH, objectId))
  -- if (EXTERN _typeId `< _theta `> `{ objectState _frame _externMethodDefEnv `} = externObject)

  clause -1 : (ARCH, objectId) = ?()

def $update_archState_e(arch, archState) : arch =

  clause 0 : (ARCH, archState) = ARCH[STATE = archState]

def $update_object_qualified_e(arch, objectId, object) : arch =

  clause 0 : (ARCH_0, objectId, object) = ARCH_1
  -- if (?() =/= $find_object_qualified_e(ARCH_0, objectId))
  -- if (ARCH_1 = $add_object_e(ARCH_0, objectId, object))

def $update_object_unqualified_e(arch, id, object) : arch =

  clause 0 : (ARCH_0, id, object) = ARCH_1
  -- if (`{ objectId ':' _object*{_object <- _object*, objectId <- objectId*} `} = ARCH_0.STORE)
  -- (if (objectId_id?{objectId_id <- objectId_id?} = $ite<objectId?>($objectId_ends_with(objectId, id), ?(objectId), ?())))*{objectId <- objectId*, objectId_id? <- objectId_id?*}
  -- if ([?(objectId_found)] = $filter_<objectId?>(objectId_id?{objectId_id <- objectId_id?}*{objectId_id? <- objectId_id?*}, (objectId_id?{objectId_id <- objectId_id?} =/= ?())*{objectId_id? <- objectId_id?*}))
  -- if (ARCH_1 = $add_object_e(ARCH_0, objectId_found, object))

def $update_objectState_e(arch, objectId, objectState) : arch? =

  clause 0 : (ARCH_0, objectId, objectState) = ?(ARCH_1)
  -- if (?(externObject as object) = $find_object_e(ARCH_0, objectId))
  -- if (EXTERN typeId `< theta `> `{ _objectState frame externMethodDefEnv `} = externObject)
  -- if (externObject_update = EXTERN typeId `< theta `> `{ objectState frame externMethodDefEnv `})
  -- if (ARCH_1 = $add_object_e(ARCH_0, objectId, externObject_update as object))

  clause -1 : (ARCH, objectId, objectState) = ?()

syntax continueEmptyResult = 
   | _EMPTY (from continueEmptyResult) 

syntax continueResult<X> = 
   | _CONT X (from continueResult<X>) 

syntax exitResult = 
   | EXIT (from exitResult) 

syntax returnResult = 
   | RETURN value? (from returnResult) 

syntax acceptTransitionResult = 
   | ACCEPT (from acceptTransitionResult) 

syntax rejectTransitionResult = 
   | REJECT errorValue (from rejectTransitionResult) 

syntax stateTransitionResult = 
   | STATE id (from stateTransitionResult) 

syntax abortResult = 
   | EXIT (from exitResult) 
   | REJECT errorValue (from rejectTransitionResult) 

syntax expressionResult = 
   | _CONT value (from continueResult<value>) 
   | EXIT (from exitResult) 
   | REJECT errorValue (from rejectTransitionResult) 

relation Expr_eval: cursor evalContext arch |- typedExpressionIR : evalContext arch expressionResult

  rulegroup literalExpressionIR

    rule booleanLiteral: p EC ARCH |- booleanLiteral as expressionIR '#' _expressionNoteIR : EC ARCH expressionResult
    -- if (boolValue = $ite<boolValue>((booleanLiteral = TRUE), _B true, _B false))
    -- if (expressionResult = _CONT boolValue as value as expressionResult)

    rule integerLiteral: p EC ARCH |- integerLiteral as expressionIR '#' _expressionNoteIR : EC ARCH expressionResult
    -- if (expressionResult = _CONT integerLiteral as value as expressionResult)

    rule stringLiteral: p EC ARCH |- stringLiteral as expressionIR '#' _expressionNoteIR : EC ARCH expressionResult
    -- if (expressionResult = _CONT stringLiteral as value as expressionResult)

  rulegroup referenceExpressionIR

    rule referenceExpressionIR: p EC ARCH |- prefixedNameIR as expressionIR '#' _expressionNoteIR : EC ARCH expressionResult
    -- if (value = $find_var_e(prefixedNameIR, p, EC))
    -- if (expressionResult = _CONT value as expressionResult)

  rulegroup defaultExpressionIR

    rule defaultExpressionIR: p EC ARCH |- '...' as expressionIR '#' _expressionNoteIR : EC ARCH expressionResult
    -- if (expressionResult = _CONT DEFAULT as value as expressionResult)

  rulegroup unaryExpressionIR

    rule abort: p EC_0 ARCH_0 |- unop typedExpressionIR as expressionIR '#' _expressionNoteIR : EC_1 ARCH_1 abortResult as expressionResult
    -- Expr_eval: p EC_0 ARCH_0 |- typedExpressionIR : EC_1 ARCH_1 abortResult as expressionResult

    rule cont: p EC_0 ARCH_0 |- unop typedExpressionIR as expressionIR '#' _expressionNoteIR : EC_1 ARCH_1 expressionResult
    -- Expr_eval: p EC_0 ARCH_0 |- typedExpressionIR : EC_1 ARCH_1 _CONT value as expressionResult
    -- if (expressionResult = _CONT $un_op(unop, value) as expressionResult)

  rulegroup binaryExpressionIR

    rule non-short-circuit-abort: p EC_0 ARCH_0 |- typedExpressionIR_l binop typedExpressionIR_r as expressionIR '#' _expressionNoteIR : EC_1 ARCH_1 abortResult as expressionResult
    -- if ~binop <- ['&&', '||']
    -- Exprs_eval: p EC_0 ARCH_0 |- [typedExpressionIR_l, typedExpressionIR_r] : EC_1 ARCH_1 abortResult as expressionListResult

    rule non-short-circuit-cont: p EC_0 ARCH_0 |- typedExpressionIR_l binop typedExpressionIR_r as expressionIR '#' _expressionNoteIR : EC_1 ARCH_1 expressionResult
    -- if ~binop <- ['&&', '||']
    -- Exprs_eval: p EC_0 ARCH_0 |- [typedExpressionIR_l, typedExpressionIR_r] : EC_1 ARCH_1 _CONT [value_l, value_r] as expressionListResult
    -- if (expressionResult = _CONT $bin_op(binop, value_l, value_r) as expressionResult)

    rule land-abort: p EC_0 ARCH_0 |- typedExpressionIR_l '&&' typedExpressionIR_r as expressionIR '#' _expressionNoteIR : EC_1 ARCH_1 abortResult as expressionResult
    -- Expr_eval: p EC_0 ARCH_0 |- typedExpressionIR_l : EC_1 ARCH_1 abortResult as expressionResult

    rule land-false: p EC_0 ARCH_0 |- typedExpressionIR_l '&&' typedExpressionIR_r as expressionIR '#' _expressionNoteIR : EC_1 ARCH_1 expressionResult
    -- Expr_eval: p EC_0 ARCH_0 |- typedExpressionIR_l : EC_1 ARCH_1 _CONT _B false as value as expressionResult
    -- if (expressionResult = _CONT _B false as value as expressionResult)

    rule land-true: p EC_0 ARCH_0 |- typedExpressionIR_l '&&' typedExpressionIR_r as expressionIR '#' _expressionNoteIR : EC_2 ARCH_2 expressionResult_r
    -- Expr_eval: p EC_0 ARCH_0 |- typedExpressionIR_l : EC_1 ARCH_1 _CONT _B true as value as expressionResult
    -- Expr_eval: p EC_1 ARCH_1 |- typedExpressionIR_r : EC_2 ARCH_2 expressionResult_r

    rule lor-abort: p EC_0 ARCH_0 |- typedExpressionIR_l '||' typedExpressionIR_r as expressionIR '#' _expressionNoteIR : EC_1 ARCH_1 abortResult as expressionResult
    -- Expr_eval: p EC_0 ARCH_0 |- typedExpressionIR_l : EC_1 ARCH_1 abortResult as expressionResult

    rule lor-true: p EC_0 ARCH_0 |- typedExpressionIR_l '||' typedExpressionIR_r as expressionIR '#' _expressionNoteIR : EC_1 ARCH_1 expressionResult
    -- Expr_eval: p EC_0 ARCH_0 |- typedExpressionIR_l : EC_1 ARCH_1 _CONT _B true as value as expressionResult
    -- if (expressionResult = _CONT _B true as value as expressionResult)

    rule lor-false: p EC_0 ARCH_0 |- typedExpressionIR_l '||' typedExpressionIR_r as expressionIR '#' _expressionNoteIR : EC_2 ARCH_2 expressionResult_r
    -- Expr_eval: p EC_0 ARCH_0 |- typedExpressionIR_l : EC_1 ARCH_1 _CONT _B false as value as expressionResult
    -- Expr_eval: p EC_1 ARCH_1 |- typedExpressionIR_r : EC_2 ARCH_2 expressionResult_r

  rulegroup ternaryExpressionIR

    rule cond-abort: p EC_0 ARCH_0 |- typedExpressionIR_cond '?' typedExpressionIR_true ':' typedExpressionIR_false as expressionIR '#' _expressionNoteIR : EC_1 ARCH_1 abortResult as expressionResult
    -- Expr_eval: p EC_0 ARCH_0 |- typedExpressionIR_cond : EC_1 ARCH_1 abortResult as expressionResult

    rule cond-true: p EC_0 ARCH_0 |- typedExpressionIR_cond '?' typedExpressionIR_true ':' typedExpressionIR_false as expressionIR '#' _expressionNoteIR : EC_2 ARCH_2 expressionResult_true
    -- Expr_eval: p EC_0 ARCH_0 |- typedExpressionIR_cond : EC_1 ARCH_1 _CONT _B true as value as expressionResult
    -- Expr_eval: p EC_1 ARCH_1 |- typedExpressionIR_true : EC_2 ARCH_2 expressionResult_true

    rule cond-false: p EC_0 ARCH_0 |- typedExpressionIR_cond '?' typedExpressionIR_true ':' typedExpressionIR_false as expressionIR '#' _expressionNoteIR : EC_2 ARCH_2 expressionResult_false
    -- Expr_eval: p EC_0 ARCH_0 |- typedExpressionIR_cond : EC_1 ARCH_1 _CONT _B false as value as expressionResult
    -- Expr_eval: p EC_1 ARCH_1 |- typedExpressionIR_false : EC_2 ARCH_2 expressionResult_false

  rulegroup castExpressionIR

    rule abort: p EC_0 ARCH_0 |- `( typeIR `) typedExpressionIR as expressionIR '#' _expressionNoteIR : EC_1 ARCH_1 abortResult as expressionResult
    -- Expr_eval: p EC_0 ARCH_0 |- typedExpressionIR : EC_1 ARCH_1 abortResult as expressionResult

    rule cont: p EC_0 ARCH_0 |- `( typeIR `) typedExpressionIR as expressionIR '#' _expressionNoteIR : EC_1 ARCH_1 _CONT value_cast as expressionResult
    -- Expr_eval: p EC_0 ARCH_0 |- typedExpressionIR : EC_1 ARCH_1 _CONT value as expressionResult
    -- if (value_cast = $cast_op(typeIR, value))

  rulegroup invalidHeaderExpressionIR

    rule invalidHeaderExpressionIR: p EC ARCH |- '{#}' as expressionIR '#' _expressionNoteIR : EC ARCH expressionResult
    -- if (expressionResult = _CONT '{#}' as value as expressionResult)

  rulegroup sequenceExpressionIR

    rule non-default-abort: p EC_0 ARCH_0 |- SEQ `{ typedExpressionListIR `} as expressionIR '#' _expressionNoteIR : EC_1 ARCH_1 abortResult as expressionResult
    -- Exprs_eval: p EC_0 ARCH_0 |- typedExpressionListIR : EC_1 ARCH_1 abortResult as expressionListResult

    rule non-default-cont: p EC_0 ARCH_0 |- SEQ `{ typedExpressionListIR `} as expressionIR '#' _expressionNoteIR : EC_1 ARCH_1 expressionResult
    -- Exprs_eval: p EC_0 ARCH_0 |- typedExpressionListIR : EC_1 ARCH_1 _CONT value*{value <- value*} as expressionListResult
    -- if (expressionResult = _CONT SEQ `( value*{value <- value*} `) as value as expressionResult)

    rule default-abort: p EC_0 ARCH_0 |- SEQ `{ typedExpressionListIR ',' '...' `} as expressionIR '#' _expressionNoteIR : EC_1 ARCH_1 abortResult as expressionResult
    -- Exprs_eval: p EC_0 ARCH_0 |- typedExpressionListIR : EC_1 ARCH_1 abortResult as expressionListResult

    rule default-cont: p EC_0 ARCH_0 |- SEQ `{ typedExpressionListIR ',' '...' `} as expressionIR '#' _expressionNoteIR : EC_1 ARCH_1 expressionResult
    -- Exprs_eval: p EC_0 ARCH_0 |- typedExpressionListIR : EC_1 ARCH_1 _CONT value*{value <- value*} as expressionListResult
    -- if (expressionResult = _CONT SEQ `( value*{value <- value*} ',' '...' `) as value as expressionResult)

  rulegroup recordExpressionIR

    rule non-default-abort: p EC_0 ARCH_0 |- RECORD `{ nameIR '=' typedExpressionIR*{nameIR <- nameIR*, typedExpressionIR <- typedExpressionIR*} `} as expressionIR '#' _expressionNoteIR : EC_1 ARCH_1 abortResult as expressionResult
    -- Exprs_eval: p EC_0 ARCH_0 |- typedExpressionIR*{typedExpressionIR <- typedExpressionIR*} : EC_1 ARCH_1 abortResult as expressionListResult

    rule non-default-cont: p EC_0 ARCH_0 |- RECORD `{ nameIR '=' typedExpressionIR*{nameIR <- nameIR*, typedExpressionIR <- typedExpressionIR*} `} as expressionIR '#' _expressionNoteIR : EC_1 ARCH_1 expressionResult
    -- Exprs_eval: p EC_0 ARCH_0 |- typedExpressionIR*{typedExpressionIR <- typedExpressionIR*} : EC_1 ARCH_1 _CONT value*{value <- value*} as expressionListResult
    -- if (expressionResult = _CONT RECORD `{ value nameIR ';'*{nameIR <- nameIR*, value <- value*} `} as value as expressionResult)

    rule default-abort: p EC_0 ARCH_0 |- RECORD `{ nameIR '=' typedExpressionIR*{nameIR <- nameIR*, typedExpressionIR <- typedExpressionIR*} ',' '...' `} as expressionIR '#' _expressionNoteIR : EC_1 ARCH_1 abortResult as expressionResult
    -- Exprs_eval: p EC_0 ARCH_0 |- typedExpressionIR*{typedExpressionIR <- typedExpressionIR*} : EC_1 ARCH_1 abortResult as expressionListResult

    rule default-cont: p EC_0 ARCH_0 |- RECORD `{ nameIR '=' typedExpressionIR*{nameIR <- nameIR*, typedExpressionIR <- typedExpressionIR*} ',' '...' `} as expressionIR '#' _expressionNoteIR : EC_1 ARCH_1 expressionResult
    -- Exprs_eval: p EC_0 ARCH_0 |- typedExpressionIR*{typedExpressionIR <- typedExpressionIR*} : EC_1 ARCH_1 _CONT value*{value <- value*} as expressionListResult
    -- if (expressionResult = _CONT RECORD `{ value nameIR ';'*{nameIR <- nameIR*, value <- value*} ',' '...' `} as value as expressionResult)

  rulegroup errorAccessExpressionIR

    rule errorAccessExpressionIR: p EC ARCH |- ERROR '.' nameIR as expressionIR '#' _expressionNoteIR : EC ARCH expressionResult
    -- if (nameIR_error = "error." ++ nameIR)
    -- if (value_error = $find_var_e(_BARE nameIR_error, p, EC))
    -- if (expressionResult = _CONT value_error as expressionResult)

  rulegroup memberAccessExpressionIR-type

    rule enum: p EC ARCH |- TYPE prefixedNameIR '.' nameIR as expressionIR '#' _expressionNoteIR : EC ARCH expressionResult
    -- if (?(ENUM typeId `{ _nameIR*{_nameIR <- _nameIR*} `} as typeDefIR) = $find_typeDef_e(p, EC, prefixedNameIR))
    -- if (expressionResult = _CONT typeId '.' nameIR as value as expressionResult)

    rule serenum: p EC ARCH |- TYPE prefixedNameIR '.' nameIR as expressionIR '#' _expressionNoteIR : EC ARCH expressionResult
    -- if (?(ENUM typeId `< _typeIR `> `{ nameIR_member '=' value_member ';'*{nameIR_member <- nameIR_member*, value_member <- value_member*} `} as typeDefIR) = $find_typeDef_e(p, EC, prefixedNameIR))
    -- if (?(value) = $assoc_<nameIR, value>(nameIR, (nameIR_member, value_member)*{nameIR_member <- nameIR_member*, value_member <- value_member*}))
    -- if (expressionResult = _CONT typeId '.' nameIR '.' value as value as expressionResult)

  rulegroup memberAccessExpressionIR-typedExpressionIR

    rule abort: p EC_0 ARCH_0 |- typedExpressionIR_base as memberAccessBaseIR '.' nameIR as expressionIR '#' `( typeIR_base _ctk `) : EC_1 ARCH_1 abortResult as expressionResult
    -- Expr_eval: p EC_0 ARCH_0 |- typedExpressionIR_base : EC_1 ARCH_1 abortResult as expressionResult

    rule stack-size: p EC_0 ARCH_0 |- typedExpressionIR_base as memberAccessBaseIR '.' nameIR as expressionIR '#' `( typeIR_base _ctk `) : EC_1 ARCH_1 expressionResult
    -- Expr_eval: p EC_0 ARCH_0 |- typedExpressionIR_base : EC_1 ARCH_1 _CONT headerStackValue_base as value as expressionResult
