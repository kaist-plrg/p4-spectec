  -- let callableTypeDefEnv = TC.global.callable
  -- let callTargetKey = $callTargetKey(nameIR, argumentIR*{argumentIR <- argumentIR*})

  clause 1 : (cursor, TC, prefixedNameIR, argumentIR*{argumentIR <- argumentIR*}) = $find_overloaded<callableTypeDefIR>(callableTypeDefEnv, callTargetKey, $parameterListIR_of_callableTypeDefIR)
  -- if cursor matches `GLOBAL`
