def $reverse_bytes_of_hex(text) : text =

  clause 0 : (t) = "0x" ++ $reverse_bytes_of_hex'(t[2 : n_len_bytes])
  -- if (t[0 : 2] = "0x")
  -- if (n_len = |t|)
  -- if (n_len_bytes as int = (n_len - 2))

def $reverse_bytes_of_hex'(text) : text =

  clause 0 : (t) = t
  -- if (|t| <= 2)

  clause 1 : (t) = t_bytes_rev ++ t_byte
  -- if (n_len = |t|)
  -- if (n_len > 2)
  -- if (t_byte = t[0 : 2])
  -- if (n_len_bytes as int = (n_len - 2))
  -- if (t_bytes = t[2 : n_len_bytes])
  -- if (t_bytes_rev = $reverse_bytes_of_hex'(t_bytes))

