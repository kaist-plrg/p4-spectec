    -- output: % % |- % : TC_2 parameterIR*{parameterIR <- parameterIR*} # typeId_fresh*{typeId_fresh <- typeId_fresh*}

def $is_function_localKind(localKind) : bool =

  clause 0 : (localKind) = true
  -- if localKind <: functionLocalKind
  -- let functionLocalKind = localKind as functionLocalKind

  clause -1 : (_localKind) = false

