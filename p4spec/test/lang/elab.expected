  clause 6 : (ENUM _typeId `< typeIR `> `{ _valueFieldIR*{_valueFieldIR <- _valueFieldIR*} `} as typeIR) = $sizeof_minSizeInBits'(typeIR)

  clause 7 : (TUPLE `< typeIR*{typeIR <- typeIR*} `> as typeIR) = $sum_nat($sizeof_minSizeInBits'(typeIR)*{typeIR <- typeIR*})

  clause 8 : (ARRAY typeIR `[ n_size `] as typeIR) = ($sizeof_minSizeInBits'(typeIR) * n_size)

