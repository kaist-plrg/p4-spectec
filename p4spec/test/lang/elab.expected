    (tableObjectTypeIR as typeIR) -> false
  row 4 :
    (_typeIR) -> true

tbl def $nestable_constructor_control(typeIR) : bool =
  row 0 :
    (TYPEDEF _typeId typeIR as typeIR) -> $nestable_constructor_control(typeIR)
  row 1 :
    (parserObjectTypeIR as typeIR) -> false
  row 2 :
    (packageObjectTypeIR as typeIR) -> false
  row 3 :
    (tableObjectTypeIR as typeIR) -> false
  row 4 :
    (_typeIR) -> true

tbl def $nestable_constructor_package(typeIR) : bool =
  row 0 :
    (TYPEDEF _typeId typeIR as typeIR) -> $nestable_constructor_package(typeIR)
  row 1 :
    (tableObjectTypeIR as typeIR) -> false
  row 2 :
    (_typeIR) -> true

tbl def $definable_constructor(typeIR) : bool =
  row 0 :
    (TYPEDEF _typeId typeIR as typeIR) -> $definable_constructor(typeIR)
  row 1 :
    (externObjectTypeIR as typeIR) -> true
  row 2 :
    (parserObjectTypeIR as typeIR) -> true
  row 3 :
    (controlObjectTypeIR as typeIR) -> true
  row 4 :
    (packageObjectTypeIR as typeIR) -> true
  row 5 :
    (_typeIR) -> false

extern relation ExternFunctionCall_eval_lctk: typingContext |- nameIR `( nameIR* `) ~> value

relation Expr_eval_lctk: cursor typingContext |- typedExpressionIR ~> value

  rulegroup literalExpressionIR

    rule booleanLiteral: p TC |- booleanLiteral as expressionIR '#' _expressionNoteIR ~> boolValue as value
    -- if (boolValue = $ite<boolValue>((booleanLiteral = TRUE), _B true, _B false))

    rule integerLiteral: p TC |- integerLiteral as expressionIR '#' _expressionNoteIR ~> integerLiteral as value

    rule stringLiteral: p TC |- stringLiteral as expressionIR '#' _expressionNoteIR ~> stringLiteral as value

  rulegroup referenceExpressionIR

    rule referenceExpressionIR: p TC |- prefixedNameIR as expressionIR '#' _expressionNoteIR ~> value
    -- if (value = $find_var_value_t(prefixedNameIR, p, TC))

  rulegroup defaultExpressionIR

    rule defaultExpressionIR: p TC |- '...' as expressionIR '#' _expressionNoteIR ~> DEFAULT as value

  rulegroup unaryExpressionIR

    rule unaryExpressionIR: p TC |- unop typedExpressionIR as expressionIR '#' _expressionNoteIR ~> $un_op(unop, value)
    -- Expr_eval_lctk: p TC |- typedExpressionIR ~> value

  rulegroup binaryExpressionIR

    rule non-short-circuit: p TC |- typedExpressionIR_l binop typedExpressionIR_r as expressionIR '#' _expressionNoteIR ~> $bin_op(binop, value_l, value_r)
    -- if ~binop <- ['&&', '||']
    -- Expr_eval_lctk: p TC |- typedExpressionIR_l ~> value_l
    -- Expr_eval_lctk: p TC |- typedExpressionIR_r ~> value_r

    rule land-false: p TC |- typedExpressionIR_l '&&' typedExpressionIR_r as expressionIR '#' _expressionNoteIR ~> _B false as value
    -- Expr_eval_lctk: p TC |- typedExpressionIR_l ~> _B false as value

    rule land-true: p TC |- typedExpressionIR_l '&&' typedExpressionIR_r as expressionIR '#' _expressionNoteIR ~> value_r
    -- Expr_eval_lctk: p TC |- typedExpressionIR_l ~> _B true as value
    -- Expr_eval_lctk: p TC |- typedExpressionIR_r ~> value_r

    rule lor-true: p TC |- typedExpressionIR_l '||' typedExpressionIR_r as expressionIR '#' _expressionNoteIR ~> _B true as value
    -- Expr_eval_lctk: p TC |- typedExpressionIR_l ~> _B true as value

    rule lor-false: p TC |- typedExpressionIR_l '||' typedExpressionIR_r as expressionIR '#' _expressionNoteIR ~> value_r
    -- Expr_eval_lctk: p TC |- typedExpressionIR_l ~> _B false as value
    -- Expr_eval_lctk: p TC |- typedExpressionIR_r ~> value_r

  rulegroup ternaryExpressionIR

    rule true: p TC |- typedExpressionIR_cond '?' typedExpressionIR_true ':' typedExpressionIR_false as expressionIR '#' _expressionNoteIR ~> value_true
    -- Expr_eval_lctk: p TC |- typedExpressionIR_cond ~> _B true as value
    -- Expr_eval_lctk: p TC |- typedExpressionIR_true ~> value_true

    rule false: p TC |- typedExpressionIR_cond '?' typedExpressionIR_true ':' typedExpressionIR_false as expressionIR '#' _expressionNoteIR ~> value_false
    -- Expr_eval_lctk: p TC |- typedExpressionIR_cond ~> _B false as value
    -- Expr_eval_lctk: p TC |- typedExpressionIR_false ~> value_false

  rulegroup castExpressionIR

    rule castExpressionIR: p TC |- `( typeIR `) typedExpressionIR as expressionIR '#' _expressionNoteIR ~> value_cast
    -- Expr_eval_lctk: p TC |- typedExpressionIR ~> value
    -- if (value_cast = $cast_op(typeIR, value))

  rulegroup invalidHeaderExpressionIR

    rule invalidHeaderExpressionIR: p TC |- '{#}' as expressionIR '#' _expressionNoteIR ~> '{#}' as value

  rulegroup sequenceExpressionIR

    rule non-default: p TC |- SEQ `{ typedExpressionIR*{typedExpressionIR <- typedExpressionIR*} `} as expressionIR '#' _expressionNoteIR ~> SEQ `( value*{value <- value*} `) as value
    -- (Expr_eval_lctk: p TC |- typedExpressionIR ~> value)*{typedExpressionIR <- typedExpressionIR*, value <- value*}

    rule default: p TC |- SEQ `{ typedExpressionIR*{typedExpressionIR <- typedExpressionIR*} ',' '...' `} as expressionIR '#' _expressionNoteIR ~> SEQ `( value*{value <- value*} ',' '...' `) as value
    -- (Expr_eval_lctk: p TC |- typedExpressionIR ~> value)*{typedExpressionIR <- typedExpressionIR*, value <- value*}

  rulegroup recordExpressionIR

    rule non-default: p TC |- RECORD `{ nameIR '=' typedExpressionIR*{nameIR <- nameIR*, typedExpressionIR <- typedExpressionIR*} `} as expressionIR '#' _expressionNoteIR ~> RECORD `{ value nameIR ';'*{nameIR <- nameIR*, value <- value*} `} as value
    -- (Expr_eval_lctk: p TC |- typedExpressionIR ~> value)*{typedExpressionIR <- typedExpressionIR*, value <- value*}

    rule default: p TC |- RECORD `{ nameIR '=' typedExpressionIR*{nameIR <- nameIR*, typedExpressionIR <- typedExpressionIR*} ',' '...' `} as expressionIR '#' _expressionNoteIR ~> RECORD `{ value nameIR ';'*{nameIR <- nameIR*, value <- value*} ',' '...' `} as value
