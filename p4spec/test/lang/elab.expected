    rule cons-fallthrough-match-no-block: id |- switchCaseIR_h :: switchCaseIR_t*{switchCaseIR_t <- switchCaseIR_t*} : ?()
    -- if (switchLabelIR_h ':' = switchCaseIR_h)
    -- if $match_switchLabelIR_table(id, switchLabelIR_h)
    -- if ([] = $filter_<switchCaseIR>(switchCaseIR_t*{switchCaseIR_t <- switchCaseIR_t*}, $is_non_fallthrough_switchCaseIR(switchCaseIR_t)*{switchCaseIR_t <- switchCaseIR_t*}))

    rule cons-fallthrough-no-match: id |- switchCaseIR_h :: switchCaseIR_t*{switchCaseIR_t <- switchCaseIR_t*} : blockStatementIR?{blockStatementIR <- blockStatementIR?}
    -- if (switchLabelIR_h ':' = switchCaseIR_h)
    -- if ~$match_switchLabelIR_table(id, switchLabelIR_h)
    -- SwitchCases_table_eval: id |- switchCaseIR_t*{switchCaseIR_t <- switchCaseIR_t*} : blockStatementIR?{blockStatementIR <- blockStatementIR?}

def $is_non_fallthrough_switchCaseIR(switchCaseIR) : bool =

  clause 0 : (switchLabelIR ':' blockStatementIR) = true

  clause 1 : (switchLabelIR ':') = false

