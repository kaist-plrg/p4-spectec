syntax actctxt = 
   | ACTION (from actctxt) 
   | NOACTION (from actctxt) 

relation Call_convention_expr_ok: cursor typingContext actctxt |- parameterIR '@' typedExpressionIR : typedExpressionIR

  rulegroup in

    rule in: p TC actctxt |- _annotationList IN typeIR_param _id _parameterInitializerOptIR '@' typedExpressionIR_arg : typedExpressionIR_arg_cast
