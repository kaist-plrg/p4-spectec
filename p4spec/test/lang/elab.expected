    -- if (typeIR_arg = $type_of_typedExpressionIR(typedExpressionIR_arg))
    -- if Type_alpha: typeIR_param ~~ typeIR_arg holds
    -- if (?(typedLvalueIR_arg) = $typedExpressionIR_as_typedLvalueIR(typedExpressionIR_arg))
    -- if (lvalue_arg = $lift_typedLvalueIR(typedLvalueIR_arg))
    -- Lvalue_ok: p TC |- lvalue_arg : _typedLvalueIR

  rulegroup directionless

    rule action: p TC ACTION |- _annotationList _EMPTY typeIR_param _id _parameterInitializerOptIR '@' typedExpressionIR_arg : typedExpressionIR_arg_cast
    -- if (?(typedExpressionIR_arg_cast) = $cast_unary(typedExpressionIR_arg, typeIR_param))

    rule non-action: p TC NOACTION |- _annotationList _EMPTY typeIR_param _id _parameterInitializerOptIR '@' typedExpressionIR_arg : typedExpressionIR_arg_cast
    -- if (?(typedExpressionIR_arg_cast) = $cast_unary(typedExpressionIR_arg, typeIR_param))
    -- if (DYN =/= $ctk_of_typedExpressionIR(typedExpressionIR_arg))

relation Call_convention_arg_ok: cursor typingContext actctxt |- parameterIR '@' argumentIR : argumentIR

  rulegroup 

    rule typedExpression: p TC actctxt |- parameterIR '@' typedExpressionIR as argumentIR : typedExpressionIR_cast as argumentIR
    -- Call_convention_expr_ok: p TC actctxt |- parameterIR '@' typedExpressionIR : typedExpressionIR_cast

    rule nameIR-typedExpression: p TC actctxt |- parameterIR '@' nameIR '=' typedExpressionIR : nameIR '=' typedExpressionIR_cast
    -- Call_convention_expr_ok: p TC actctxt |- parameterIR '@' typedExpressionIR : typedExpressionIR_cast

    rule nameIR-dontcare: p TC actctxt |- parameterIR '@' nameIR '=' '_' : nameIR '=' '_'
    -- if (_annotationList OUT _typeIR _id _parameterInitializerOptIR = parameterIR)

    rule dontcare: p TC actctxt |- parameterIR '@' '_' : '_'
