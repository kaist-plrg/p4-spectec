    rule keys-cont-matches-cont-action-cont: EC_0 ARCH_0 |- typeId TBL : EC_3 ARCH_3 RETURN ?(tableMetadataStructValue as value) as tableResult
    -- if (KEY '=' `{ tableKeyListIR `} = TBL.KEYS)
