def $match_switchLabelIR_table(id, switchLabelIR) : bool =

  clause 0 : (id, DEFAULT) = true

  clause 1 : (id, _BARE id as expressionIR '#' _expressionNoteIR as switchLabelIR) = true

  clause -1 : (id, _switchLabelIR) = false

relation SwitchCases_table_eval: id |- switchCaseListIR : blockStatementIR?

  rulegroup 

    rule nil: id |- [] : ?()

    rule cons-non-fallthrough-match: id |- switchCaseIR_h :: switchCaseIR_t*{switchCaseIR_t <- switchCaseIR_t*} : ?(blockStatementIR_h)
    -- if (switchLabelIR_h ':' blockStatementIR_h = switchCaseIR_h)
    -- if $match_switchLabelIR_table(id, switchLabelIR_h)

    rule cons-non-fallthrough-no-match: id |- switchCaseIR_h :: switchCaseIR_t*{switchCaseIR_t <- switchCaseIR_t*} : blockStatementIR?{blockStatementIR <- blockStatementIR?}
    -- if (switchLabelIR_h ':' blockStatementIR_h = switchCaseIR_h)
    -- if ~$match_switchLabelIR_table(id, switchLabelIR_h)
    -- SwitchCases_table_eval: id |- switchCaseIR_t*{switchCaseIR_t <- switchCaseIR_t*} : blockStatementIR?{blockStatementIR <- blockStatementIR?}

    rule cons-fallthrough-match: id |- switchCaseIR_h :: switchCaseIR_t*{switchCaseIR_t <- switchCaseIR_t*} : ?(blockStatementIR)
    -- if (switchLabelIR_h ':' = switchCaseIR_h)
