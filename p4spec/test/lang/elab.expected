def $fresh_typeIds(nat) : typeId* =

  clause 0 : (nat) = []
  -- if (nat = 0)

  clause 1 : (n) = $fresh_typeId :: $fresh_typeIds(n')
  -- if (n =/= 0)
  -- let int = (n - 1)
