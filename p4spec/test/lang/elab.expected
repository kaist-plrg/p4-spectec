def $subst_externMethodTypeDefEnv(externMethodTypeDefEnv, externMethodTypeDefEnv) : externMethodTypeDefEnv =

  clause 0 : (externMethodTypeDefEnv_extern, `{ [] `}) = externMethodTypeDefEnv_extern

  clause 1 : (externMethodTypeDefEnv_extern, `{ callableId_init_h ':' externMethodTypeDefIR_init_h :: callableId_init_t ':' externMethodTypeDefIR_init_t*{callableId_init_t <- callableId_init_t*, externMethodTypeDefIR_init_t <- externMethodTypeDefIR_init_t*} `}) = $subst_externMethodTypeDefEnv(externMethodTypeDefEnv_extern_subst, `{ callableId_init_t ':' externMethodTypeDefIR_init_t*{callableId_init_t <- callableId_init_t*, externMethodTypeDefIR_init_t <- externMethodTypeDefIR_init_t*} `})
  -- if (nameIR_init_h `( _id*{_id <- _id*} `) = callableId_init_h)
  -- if (?((callableId, externMethodTypeDefIR_abstract)) = $find_non_overloaded<externMethodTypeDefIR>(externMethodTypeDefEnv_extern, nameIR_init_h))
  -- if (EXTERN_METHOD ABSTRACT nameIR `< typeId_expl*{typeId_expl <- typeId_expl*} ',' typeId_impl*{typeId_impl <- typeId_impl*} `> `( parameterIR*{parameterIR <- parameterIR*} `) ':' typeIR_ret = externMethodTypeDefIR_abstract)
  -- if (externMethodTypeDefIR_concrete = EXTERN_METHOD nameIR `< typeId_expl*{typeId_expl <- typeId_expl*} ',' typeId_impl*{typeId_impl <- typeId_impl*} `> `( parameterIR*{parameterIR <- parameterIR*} `) ':' typeIR_ret)
  -- if ExternMethodTypeDef_alpha: externMethodTypeDefIR_concrete ~~ externMethodTypeDefIR_init_h holds
  -- if (externMethodTypeDefEnv_extern_subst = $update_map<callableId, externMethodTypeDefIR>(externMethodTypeDefEnv_extern, callableId, externMethodTypeDefIR_concrete))

