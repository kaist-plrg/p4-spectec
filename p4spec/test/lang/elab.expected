  -- let (callableId_t_found, V_t_found)*{V_t_found <- V_t_found*, callableId_t_found <- callableId_t_found*} = $find_non_overloadeds<V>({ callableId_t : V_t*{V_t <- V_t*, callableId_t <- callableId_t*} }, nameIR_f)

def $name_annotation(annotationList) : nameIR* =

  clause 0 : (annotationList) = $concat_<nameIR>(nameIR_found*{nameIR_found <- nameIR_found*}*{nameIR_found* <- nameIR_found**})
  -- let annotation*{annotation <- annotation*} = $flatten_annotationList(annotationList)
  -- (let nameIR_opt?{nameIR_opt <- nameIR_opt?} = $name_annotation_opt(annotation))*{annotation <- annotation*, nameIR_opt? -> nameIR_opt?*}
  -- let nameIR_found*{nameIR_found <- nameIR_found*}*{nameIR_found* <- nameIR_found**} = $opt_as_seq_<nameIR>(nameIR_opt?{nameIR_opt <- nameIR_opt?})*{nameIR_opt? <- nameIR_opt?*}

def $name_annotation_opt(annotation) : nameIR? =

  clause 0 : (annotation) = ?($strip_prefix($strip_suffix(nameIR, "\""), "\""))
  -- if annotation matches `@%(%)`
  -- let @ name ( annotationBody ) = annotation
  -- if ("name" = $name(name))
  -- let annotationBody'' = annotationBody
  -- if annotationBody'' matches `%%`
  -- let annotationBody' annotationToken = annotationBody''
  -- if annotationBody' matches ``EMPTY`
  -- let nameIR = $print_<annotationToken>(annotationToken)

  clause -1 : (annotation) = ?()

def $name_annotation_default(annotationList, nameIR) : nameIR =

  clause 0 : (annotationList, nameIR) = nameIR_found
  -- let nameIR'*{nameIR' <- nameIR'*} = $name_annotation(annotationList)
  -- if nameIR'*{nameIR' <- nameIR'*} matches [ _/1 ]
  -- let [nameIR_found] = nameIR'*{nameIR' <- nameIR'*}

  clause 1 : (annotationList, nameIR) = nameIR
  -- if ([] = $name_annotation(annotationList))

def $find_name_annotation_opt(annotationList) : annotation? =

  clause 0 : (annotationList) = ?()
  -- if annotationList matches ``EMPTY`

  clause 1 : (annotationList) = ?(annotation)
  -- if annotationList <: annotation
  -- let annotation = annotationList as annotation
  -- let annotation' = annotation
  -- if annotation' matches `@%(%)`
  -- let @ name ( annotationBody ) = annotation'
  -- if ("name" = $name(name))

  clause 2 : (annotationList) = ?()
  -- if annotationList <: annotation
  -- let annotation = annotationList as annotation
  -- let annotation' = annotation
  -- if annotation' matches `@%(%)`
  -- let @ name ( annotationBody ) = annotation'
  -- if ("name" =/= $name(name))

  clause 3 : (annotationList) = $find_name_annotation_opt(annotationListNonEmpty as annotationList)
  -- if annotationList <: annotationListNonEmpty
  -- let annotationListNonEmpty' = annotationList as annotationListNonEmpty
  -- if annotationListNonEmpty' matches `%%`
  -- let annotationListNonEmpty annotation = annotationListNonEmpty'
  -- if (?() = $find_name_annotation_opt(annotation as annotationList))

  clause 4 : (annotationList) = ?(annotation_found)
  -- if annotationList <: annotationListNonEmpty
  -- let annotationListNonEmpty' = annotationList as annotationListNonEmpty
  -- if annotationListNonEmpty' matches `%%`
  -- let annotationListNonEmpty annotation = annotationListNonEmpty'
  -- let annotation'?{annotation' <- annotation'?} = $find_name_annotation_opt(annotation as annotationList)
  -- if annotation'?{annotation' <- annotation'?} matches (_)
  -- let ?(annotation_found) = annotation'?{annotation' <- annotation'?}

  clause -1 : (_annotationList) = ?()

def $add_annotationList(annotationList, annotation?) : annotationList =

  clause 0 : (annotationList, annotation?{annotation <- annotation?}) = annotationList
  -- if annotation?{annotation <- annotation?} matches ()

  clause 1 : (annotationList, annotation'?{annotation' <- annotation'?}) = annotation as annotationList
  -- if annotationList matches ``EMPTY`
  -- if annotation'?{annotation' <- annotation'?} matches (_)
  -- let ?(annotation) = annotation'?{annotation' <- annotation'?}

  clause 2 : (annotationList, annotation'?{annotation' <- annotation'?}) = annotationListNonEmpty annotation as annotationList
