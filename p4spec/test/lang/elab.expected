def $callableId_of_externMethodPrototype(externMethodPrototype) : callableId =

  clause 0 : (externMethodPrototype) = $callableId(name, parameterList)
  -- if externMethodPrototype matches `%%;`
  -- let _annotationList _typeOrVoid name _typeParameterListOpt ( parameterList ) ; = externMethodPrototype

  clause 1 : (externMethodPrototype) = $callableId(name, parameterList)
  -- if externMethodPrototype matches `%ABSTRACT%;`
  -- let _annotationList abstract _typeOrVoid name _typeParameterListOpt ( parameterList ) ; = externMethodPrototype

def $type_of_externMethodPrototypeIR(externMethodPrototypeIR) : externMethodTypeDefIR =

  clause 0 : (externMethodPrototypeIR) = externMethodTypeDefIR
  -- if externMethodPrototypeIR matches `%%;`
  -- let _annotationList typeIR_ret nameIR < typeParameterListIR_expl , typeParameterListIR_impl >( parameterIR*{parameterIR <- parameterIR*} ) ; = externMethodPrototypeIR
  -- let externMethodTypeDefIR = extern_method nameIR < typeParameterListIR_expl , typeParameterListIR_impl >( parameterIR*{parameterIR <- parameterIR*} ): typeIR_ret

  clause 1 : (externMethodPrototypeIR) = externMethodTypeDefIR
  -- if externMethodPrototypeIR matches `%ABSTRACT%;`
  -- let _annotationList abstract typeIR_ret nameIR < typeParameterListIR_expl , typeParameterListIR_impl >( parameterIR*{parameterIR <- parameterIR*} ) ; = externMethodPrototypeIR
  -- let externMethodTypeDefIR = extern_methodabstract nameIR < typeParameterListIR_expl , typeParameterListIR_impl >( parameterIR*{parameterIR <- parameterIR*} ): typeIR_ret

def $constructorId_of_externConstructorPrototype(externConstructorPrototype) : constructorId =

  clause 0 : (_annotationList typeIdentifier ( parameterList );) = $callableId(typeIdentifier as name, parameterList)

