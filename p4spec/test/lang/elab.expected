syntax instctxt = 
   | named
   | anon

relation Inst_ok: cursor typingContext instctxt |- constructorTypeIR < typeArgumentListIR # typeId* >( argumentListIR # id* # id* ): typeIR < typeArgumentListIR >( argumentListIR )

  rulegroup package

   match

    (signature) global TC instctxt |- constructorTypeIR < typeArgumentIR*{typeArgumentIR <- typeArgumentIR*} # typeId_infer*{typeId_infer <- typeId_infer*} >( argumentIR*{argumentIR <- argumentIR*} # id_default*{id_default <- id_default*} # id_optional*{id_optional <- id_optional*} ): % < % >( % )
    cursor TC instctxt |- constructorTypeIR < typeArgumentIR*{typeArgumentIR <- typeArgumentIR*} # typeId_infer*{typeId_infer <- typeId_infer*} >( argumentIR*{argumentIR <- argumentIR*} # id_default*{id_default <- id_default*} # id_optional*{id_optional <- id_optional*} ): % < % >( % )
    -- if cursor matches `GLOBAL`

   paths

    rulepath package
    -- let constructor( parameterIR*{parameterIR <- parameterIR*} ): typeIR_object = constructorTypeIR
    -- let typeIR = $unroll_typeIR(typeIR_object)
    -- if typeIR <: packageObjectTypeIR
    -- let package _typeId < _typeArgumentIR*{_typeArgumentIR <- _typeArgumentIR*} >{ _typeIR*{_typeIR <- _typeIR*} } = typeIR as packageObjectTypeIR
    -- let given parameterIR_aligned*{parameterIR_aligned <- parameterIR_aligned*} default _parameterIR*{_parameterIR <- _parameterIR*} = $align_parameterListIR(parameterIR*{parameterIR <- parameterIR*}, argumentIR*{argumentIR <- argumentIR*}, id_default*{id_default <- id_default*}, id_optional*{id_optional <- id_optional*})
    -- let inference = $infer(typeId_infer*{typeId_infer <- typeId_infer*}, parameterIR_aligned*{parameterIR_aligned <- parameterIR_aligned*}, argumentIR*{argumentIR <- argumentIR*})
    -- (let typeIR'?{typeIR' <- typeIR'?} = $find_map<typeId, typeIR>(inference, typeId_infer))*{typeId_infer <- typeId_infer*, typeIR'? -> typeIR'?*}
    -- (if typeIR'?{typeIR' <- typeIR'?} matches (_))*{typeIR'? <- typeIR'?*}
    -- (let ?(typeIR_inferred) = typeIR'?{typeIR' <- typeIR'?})*{typeIR'? <- typeIR'?*, typeIR_inferred -> typeIR_inferred*}
    -- let typeArgumentIR_inferred*{typeArgumentIR_inferred <- typeArgumentIR_inferred*} = typeArgumentIR*{typeArgumentIR <- typeArgumentIR*} ++ typeIR_inferred*{typeIR_inferred <- typeIR_inferred*}
    -- (let parameterIR_aligned_inferred = $subst_parameterIR(inference, parameterIR_aligned))*{parameterIR_aligned <- parameterIR_aligned*, parameterIR_aligned_inferred -> parameterIR_aligned_inferred*}
    -- let typeIR_object_inferred = $subst_typeIR(inference, typeIR_object)
    -- let constructorTypeIR_inferred = constructor( parameterIR_aligned_inferred*{parameterIR_aligned_inferred <- parameterIR_aligned_inferred*} ): typeIR_object_inferred
    -- if ConstructorType_wf: $bound(global, TC) |- constructorTypeIR_inferred holds
    -- if $instantiable(global, TC, instctxt, typeIR_object_inferred)
    -- Call_convention_ok: block TC noaction |- parameterIR_aligned_inferred*{parameterIR_aligned_inferred <- parameterIR_aligned_inferred*} @ argumentIR*{argumentIR <- argumentIR*} : argumentIR_cast*{argumentIR_cast <- argumentIR_cast*}
    -- output: % % % |- % < % # % >( % # % # % ): typeIR_object_inferred < typeArgumentIR_inferred*{typeArgumentIR_inferred <- typeArgumentIR_inferred*} >( argumentIR_cast*{argumentIR_cast <- argumentIR_cast*} )

  rulegroup non-package

   match

    (signature) p TC instctxt |- constructorTypeIR < typeArgumentIR*{typeArgumentIR <- typeArgumentIR*} # typeId_infer*{typeId_infer <- typeId_infer*} >( argumentIR*{argumentIR <- argumentIR*} # id_default*{id_default <- id_default*} # id_optional*{id_optional <- id_optional*} ): % < % >( % )
    p TC instctxt |- constructorTypeIR < typeArgumentIR*{typeArgumentIR <- typeArgumentIR*} # typeId_infer*{typeId_infer <- typeId_infer*} >( argumentIR*{argumentIR <- argumentIR*} # id_default*{id_default <- id_default*} # id_optional*{id_optional <- id_optional*} ): % < % >( % )

   paths

    rulepath non-package
    -- let constructor( parameterIR*{parameterIR <- parameterIR*} ): typeIR_object = constructorTypeIR
    -- let typeIR_object_unroll = $unroll_typeIR(typeIR_object)
    -- if ~typeIR_object_unroll <: packageObjectTypeIR
    -- let given parameterIR_aligned*{parameterIR_aligned <- parameterIR_aligned*} default _parameterIR*{_parameterIR <- _parameterIR*} = $align_parameterListIR(parameterIR*{parameterIR <- parameterIR*}, argumentIR*{argumentIR <- argumentIR*}, id_default*{id_default <- id_default*}, id_optional*{id_optional <- id_optional*})
    -- let inference = $infer(typeId_infer*{typeId_infer <- typeId_infer*}, parameterIR_aligned*{parameterIR_aligned <- parameterIR_aligned*}, argumentIR*{argumentIR <- argumentIR*})
    -- (let typeIR?{typeIR <- typeIR?} = $find_map<typeId, typeIR>(inference, typeId_infer))*{typeId_infer <- typeId_infer*, typeIR? -> typeIR?*}
    -- (if typeIR?{typeIR <- typeIR?} matches (_))*{typeIR? <- typeIR?*}
    -- (let ?(typeIR_inferred) = typeIR?{typeIR <- typeIR?})*{typeIR? <- typeIR?*, typeIR_inferred -> typeIR_inferred*}
    -- let typeArgumentIR_inferred*{typeArgumentIR_inferred <- typeArgumentIR_inferred*} = typeArgumentIR*{typeArgumentIR <- typeArgumentIR*} ++ typeIR_inferred*{typeIR_inferred <- typeIR_inferred*}
    -- (let parameterIR_aligned_inferred = $subst_parameterIR(inference, parameterIR_aligned))*{parameterIR_aligned <- parameterIR_aligned*, parameterIR_aligned_inferred -> parameterIR_aligned_inferred*}
    -- let typeIR_object_inferred = $subst_typeIR(inference, typeIR_object)
    -- let constructorTypeIR_inferred = constructor( parameterIR_aligned_inferred*{parameterIR_aligned_inferred <- parameterIR_aligned_inferred*} ): typeIR_object_inferred
    -- if ConstructorType_wf: $bound(p, TC) |- constructorTypeIR_inferred holds
    -- if $instantiable(p, TC, instctxt, typeIR_object_inferred)
    -- Call_convention_ok: p TC noaction |- parameterIR_aligned_inferred*{parameterIR_aligned_inferred <- parameterIR_aligned_inferred*} @ argumentIR*{argumentIR <- argumentIR*} : argumentIR_cast*{argumentIR_cast <- argumentIR_cast*}
    -- output: % % % |- % < % # % >( % # % # % ): typeIR_object_inferred < typeArgumentIR_inferred*{typeArgumentIR_inferred <- typeArgumentIR_inferred*} >( argumentIR_cast*{argumentIR_cast <- argumentIR_cast*} )

def $reduce_serenum(typedExpressionIR) : typedExpressionIR =

  clause 0 : (typedExpressionIR) = typedExpressionIR_reduced
  -- let typeIR = $type_of_typedExpressionIR(typedExpressionIR)
  -- let ctk = $ctk_of_typedExpressionIR(typedExpressionIR)
  -- let typeIR' = $unroll_typeIR(typeIR)
  -- if typeIR' <: serializableEnumTypeIR
  -- let enum _typeId < typeIR_underlying >{ _valueFieldIR*{_valueFieldIR <- _valueFieldIR*} } = typeIR' as serializableEnumTypeIR
  -- let typedExpressionIR_reduced = ( typeIR_underlying ) typedExpressionIR as expressionIR # ( typeIR_underlying ctk )

  clause -1 : (typedExpressionIR) = typedExpressionIR

def $reduce_serenum_unary(typedExpressionIR, $check(typeIR) : bool) : typedExpressionIR? =

  clause 0 : (typedExpressionIR, $check) = ?(typedExpressionIR)
  -- let _expressionIR # ( typeIR _ctk ) = typedExpressionIR
  -- if $check(typeIR)

  clause 1 : (typedExpressionIR, $check) = $reduce_serenum_unary(typedExpressionIR_cast, $check)
  -- let _expressionIR # ( typeIR ctk ) = typedExpressionIR
  -- if ~$check(typeIR)
  -- let typeIR' = $unroll_typeIR(typeIR)
  -- if typeIR' <: serializableEnumTypeIR
  -- let enum _typeId < typeIR_underlying >{ _valueFieldIR*{_valueFieldIR <- _valueFieldIR*} } = typeIR' as serializableEnumTypeIR
  -- let typedExpressionIR_cast = ( typeIR_underlying ) typedExpressionIR as expressionIR # ( typeIR_underlying ctk )

  clause -1 : (typedExpressionIR, $check) = ?()

def $reduce_serenum_binary(typedExpressionIR, typedExpressionIR, $check(typeIR, typeIR) : bool) : (typedExpressionIR, typedExpressionIR)? =

  clause 0 : (typedExpressionIR_l, typedExpressionIR_r, $check) = ?((typedExpressionIR_l, typedExpressionIR_r))
  -- let _expressionIR # ( typeIR_l _ctk ) = typedExpressionIR_l
  -- let _expressionIR' # ( typeIR_r _ctk' ) = typedExpressionIR_r
  -- if $check(typeIR_l, typeIR_r)

  clause 1 : (typedExpressionIR_l, typedExpressionIR_r, $check) = $reduce_serenum_binary(typedExpressionIR_l_cast, typedExpressionIR_r, $check)
  -- let _expressionIR # ( typeIR_l ctk_l ) = typedExpressionIR_l
  -- let _expressionIR' # ( typeIR_r _ctk ) = typedExpressionIR_r
  -- if ~$check(typeIR_l, typeIR_r)
  -- let typeIR = $unroll_typeIR(typeIR_l)
  -- if typeIR <: serializableEnumTypeIR
  -- let enum _typeId < typeIR_l_underlying >{ _valueFieldIR*{_valueFieldIR <- _valueFieldIR*} } = typeIR as serializableEnumTypeIR
  -- let typedExpressionIR_l_cast = ( typeIR_l_underlying ) typedExpressionIR_l as expressionIR # ( typeIR_l_underlying ctk_l )

  clause 2 : (typedExpressionIR_l, typedExpressionIR_r, $check) = $reduce_serenum_binary(typedExpressionIR_l, typedExpressionIR_r_cast, $check)
  -- let _expressionIR # ( typeIR_l _ctk ) = typedExpressionIR_l
  -- let _expressionIR' # ( typeIR_r ctk_r ) = typedExpressionIR_r
  -- if ~$check(typeIR_l, typeIR_r)
  -- if ~$unroll_typeIR(typeIR_l) <: serializableEnumTypeIR
  -- let typeIR = $unroll_typeIR(typeIR_r)
  -- if typeIR <: serializableEnumTypeIR
  -- let enum _typeId < typeIR_r_underlying >{ _valueFieldIR*{_valueFieldIR <- _valueFieldIR*} } = typeIR as serializableEnumTypeIR
  -- let typedExpressionIR_r_cast = ( typeIR_r_underlying ) typedExpressionIR_r as expressionIR # ( typeIR_r_underlying ctk_r )

  clause -1 : (typedExpressionIR_l, typedExpressionIR_r, $check) = ?()

def $cast_unary(typedExpressionIR, typeIR) : typedExpressionIR? =

  clause 0 : (typedExpressionIR, typeIR_to) = ?(typedExpressionIR)
  -- let _expressionIR # ( typeIR _ctk ) = typedExpressionIR
  -- if Type_alpha: typeIR ~~ typeIR_to holds

  clause 1 : (typedExpressionIR, typeIR_to) = ?(typedExpressionIR_cast)
  -- let _expressionIR # ( typeIR ctk ) = typedExpressionIR
  -- if Type_alpha: typeIR ~~ typeIR_to does not hold
  -- if Cast_impl: typeIR -> typeIR_to holds
  -- let typedExpressionIR_cast = ( typeIR_to ) typedExpressionIR as expressionIR # ( typeIR_to ctk )

def $cast_binary(typedExpressionIR, typedExpressionIR) : (typedExpressionIR, typedExpressionIR)? =

  clause 0 : (typedExpressionIR_l, typedExpressionIR_r) = ?((typedExpressionIR_l, typedExpressionIR_r))
  -- let _expressionIR # ( typeIR_l _ctk ) = typedExpressionIR_l
  -- let _expressionIR' # ( typeIR_r _ctk' ) = typedExpressionIR_r
  -- if Type_alpha: typeIR_l ~~ typeIR_r holds

  clause 1 : (typedExpressionIR_l, typedExpressionIR_r) = ?((typedExpressionIR_l_cast, typedExpressionIR_r))
  -- let _expressionIR # ( typeIR_l ctk_l ) = typedExpressionIR_l
  -- let _expressionIR' # ( typeIR_r _ctk ) = typedExpressionIR_r
  -- if Type_alpha: typeIR_l ~~ typeIR_r does not hold
  -- if Cast_impl: typeIR_l -> typeIR_r holds
  -- let typedExpressionIR_l_cast = ( typeIR_r ) typedExpressionIR_l as expressionIR # ( typeIR_r ctk_l )

  clause 2 : (typedExpressionIR_l, typedExpressionIR_r) = ?((typedExpressionIR_l, typedExpressionIR_r_cast))
  -- let _expressionIR # ( typeIR_l _ctk ) = typedExpressionIR_l
  -- let _expressionIR' # ( typeIR_r ctk_r ) = typedExpressionIR_r
  -- if Type_alpha: typeIR_l ~~ typeIR_r does not hold
  -- if Cast_impl: typeIR_l -> typeIR_r does not hold
  -- if Cast_impl: typeIR_r -> typeIR_l holds
  -- let typedExpressionIR_r_cast = ( typeIR_l ) typedExpressionIR_r as expressionIR # ( typeIR_l ctk_r )

  clause 3 : (typedExpressionIR_l, typedExpressionIR_r) = $cast_binary(typedExpressionIR_l_cast, typedExpressionIR_r)
  -- let _expressionIR # ( typeIR_l ctk_l ) = typedExpressionIR_l
  -- let _expressionIR' # ( typeIR_r _ctk ) = typedExpressionIR_r
  -- if Type_alpha: typeIR_l ~~ typeIR_r does not hold
  -- if Cast_impl: typeIR_l -> typeIR_r does not hold
  -- if Cast_impl: typeIR_r -> typeIR_l does not hold
  -- let typedExpressionIR_l_cast = $reduce_serenum(typedExpressionIR_l)
  -- if (typedExpressionIR_l =/= typedExpressionIR_l_cast)

  clause 4 : (typedExpressionIR_l, typedExpressionIR_r) = $cast_binary(typedExpressionIR_l, typedExpressionIR_r_cast)
  -- let _expressionIR # ( typeIR_l _ctk ) = typedExpressionIR_l
  -- let _expressionIR' # ( typeIR_r ctk_r ) = typedExpressionIR_r
  -- if Type_alpha: typeIR_l ~~ typeIR_r does not hold
  -- if Cast_impl: typeIR_l -> typeIR_r does not hold
  -- if Cast_impl: typeIR_r -> typeIR_l does not hold
  -- let typedExpressionIR_l_cast = $reduce_serenum(typedExpressionIR_l)
  -- if (typedExpressionIR_l = typedExpressionIR_l_cast)
  -- let typedExpressionIR_r_cast = $reduce_serenum(typedExpressionIR_r)
  -- if (typedExpressionIR_r =/= typedExpressionIR_r_cast)

  clause -1 : (typedExpressionIR_l, typedExpressionIR_r) = ?()

tbl def $compat_lnot(typeIR) : bool =
  row 0 :
    (signature) bool as typeIR
    (typeIR) -> true
    -- if typeIR <: boolTypeIR
    -- let boolTypeIR = typeIR as boolTypeIR
    -- if (boolTypeIR = bool)
  row 1 :
    (signature) typedef _typeId typeIR as typeIR
    (typeIR') -> $compat_lnot(typeIR)
    -- if typeIR' <: typedefTypeIR
    -- let typedef _typeId typeIR = typeIR' as typedefTypeIR
  row 2 :
    (signature) _typeIR
    (_typeIR) -> false

tbl def $compat_bnot(typeIR) : bool =
  row 0 :
    (signature) int< _nat > as typeIR
    (typeIR) -> true
    -- if typeIR <: fixedIntTypeIR
    -- let int< _nat > = typeIR as fixedIntTypeIR
  row 1 :
    (signature) bit< _nat > as typeIR
    (typeIR) -> true
    -- if typeIR <: fixedBitTypeIR
    -- let bit< _nat > = typeIR as fixedBitTypeIR
  row 2 :
    (signature) typedef _typeId typeIR as typeIR
    (typeIR') -> $compat_bnot(typeIR)
    -- if typeIR' <: typedefTypeIR
    -- let typedef _typeId typeIR = typeIR' as typedefTypeIR
  row 3 :
    (signature) _typeIR
    (_typeIR) -> false

tbl def $compat_uplusminus(typeIR) : bool =
  row 0 :
    (signature) int as typeIR
    (typeIR) -> true
    -- if typeIR <: intTypeIR
    -- let intTypeIR = typeIR as intTypeIR
    -- if (intTypeIR = int)
  row 1 :
    (signature) int< _nat > as typeIR
    (typeIR) -> true
    -- if typeIR <: fixedIntTypeIR
    -- let int< _nat > = typeIR as fixedIntTypeIR
  row 2 :
    (signature) bit< _nat > as typeIR
    (typeIR) -> true
    -- if typeIR <: fixedBitTypeIR
    -- let bit< _nat > = typeIR as fixedBitTypeIR
  row 3 :
    (signature) typedef _typeId typeIR as typeIR
    (typeIR') -> $compat_uplusminus(typeIR)
    -- if typeIR' <: typedefTypeIR
    -- let typedef _typeId typeIR = typeIR' as typedefTypeIR
  row 4 :
    (signature) _typeIR
    (_typeIR) -> false

tbl def $compat_plusminusmult(typeIR, typeIR) : bool =
  row 0 :
    (signature) int as typeIR, int as typeIR
    (typeIR, typeIR') -> true
    -- if typeIR <: intTypeIR
    -- let intTypeIR = typeIR as intTypeIR
    -- if (intTypeIR = int)
    -- if typeIR' <: intTypeIR
    -- let intTypeIR' = typeIR' as intTypeIR
    -- if (intTypeIR' = int)
  row 1 :
    (signature) int< w_l > as typeIR, int< w_r > as typeIR
    (typeIR, typeIR') -> (w_l = w_r)
    -- if typeIR <: fixedIntTypeIR
    -- let int< w_l > = typeIR as fixedIntTypeIR
    -- if typeIR' <: fixedIntTypeIR
    -- let int< w_r > = typeIR' as fixedIntTypeIR
  row 2 :
    (signature) bit< w_l > as typeIR, bit< w_r > as typeIR
    (typeIR, typeIR') -> (w_l = w_r)
    -- if typeIR <: fixedBitTypeIR
    -- let bit< w_l > = typeIR as fixedBitTypeIR
    -- if typeIR' <: fixedBitTypeIR
    -- let bit< w_r > = typeIR' as fixedBitTypeIR
  row 3 :
    (signature) typedef _typeId typeIR_l as typeIR, typeIR_r
    (typeIR, typeIR_r) -> $compat_plusminusmult(typeIR_l, typeIR_r)
    -- if typeIR <: typedefTypeIR
    -- let typedef _typeId typeIR_l = typeIR as typedefTypeIR
  row 4 :
    (signature) typeIR_l, typedef _typeId typeIR_r as typeIR
    (typeIR_l, typeIR) -> $compat_plusminusmult(typeIR_l, typeIR_r)
    -- if typeIR <: typedefTypeIR
    -- let typedef _typeId typeIR_r = typeIR as typedefTypeIR
  row 5 :
    (signature) _typeIR, _typeIR'
    (_typeIR, _typeIR') -> false

