relation Call_convention_ok: cursor typingContext actctxt |- parameterIR* '@' argumentListIR : argumentListIR

  rulegroup 

    rule nil: p TC actctxt |- [] '@' [] : []

    rule cons: p TC actctxt |- parameterIR_h :: parameterIR_t*{parameterIR_t <- parameterIR_t*} '@' argumentIR_h :: argumentIR_t*{argumentIR_t <- argumentIR_t*} : argumentIR_h_cast :: argumentIR_t_cast*{argumentIR_t_cast <- argumentIR_t_cast*}
    -- Call_convention_arg_ok: p TC actctxt |- parameterIR_h '@' argumentIR_h : argumentIR_h_cast
    -- Call_convention_ok: p TC actctxt |- parameterIR_t*{parameterIR_t <- parameterIR_t*} '@' argumentIR_t*{argumentIR_t <- argumentIR_t*} : argumentIR_t_cast*{argumentIR_t_cast <- argumentIR_t_cast*}

def $is_static_callableTypeIR(callableTypeIR) : ctk =

  clause 0 : (EXTERN_FUNCTION "static_assert" `( _parameterIR*{_parameterIR <- _parameterIR*} `) ':' _typeIR as callableTypeIR) = LCTK

  clause 1 : (builtinSizeMethodTypeIR as callableTypeIR) = LCTK

  clause -1 : (_callableTypeIR) = DYN

def $is_static_assert_callableTypeIR(callableTypeIR) : bool =

  clause 0 : (EXTERN_FUNCTION "static_assert" `( _parameterIR*{_parameterIR <- _parameterIR*} `) ':' _typeIR as callableTypeIR) = true

  clause -1 : (_callableTypeIR) = false

relation CallableTarget_ok: cursor typingContext |- callableTarget : callableTargetIR

  rulegroup 

    rule prefixedNonTypeName: p TC |- prefixedNonTypeName as callableTarget : prefixedNameIR as callableTargetIR
    -- if (prefixedNameIR = $prefixedNonTypeName(prefixedNonTypeName))

    rule this: p TC |- THIS as expression : _BARE "this" as callableTargetIR

    rule memberAccessExpression-prefixedTypeName: p TC |- prefixedTypeName as memberAccessBase '.' member as expression : TYPE prefixedNameIR '.' nameIR
    -- if (prefixedNameIR = $prefixedTypeName(prefixedTypeName))
    -- if (nameIR = $name(member))

    rule memberAccessExpression-expression: p TC |- expression_base as memberAccessBase '.' member as expression : typedExpressionIR_base '.' nameIR
    -- if (nameIR = $name(member))
