    -- if ((constructorTypeIR, typeId_impl*{typeId_impl <- typeId_impl*}) = $specialize_constructorTypeDefIR(constructorTypeDefIR, typeArgumentIR*{typeArgumentIR <- typeArgumentIR*}))

    rule non-aliased-some-type: p TC |- prefixedNameIR `< typeArgumentIR*{typeArgumentIR <- typeArgumentIR*} `> `( argumentIR*{argumentIR <- argumentIR*} `) : constructorTypeIR `< '#' typeId_impl*{typeId_impl <- typeId_impl*} `> `( '#' id_default*{id_default <- id_default*} '#' id_optional*{id_optional <- id_optional*} `)
    -- if (?(typeDefIR) = $find_typeDef_t(p, TC, prefixedNameIR))
    -- if ~typeDefIR <: typedefTypeIR
    -- if (?(callableId ':' constructorTypeDefIR '#' id_default*{id_default <- id_default*} '#' id_optional*{id_optional <- id_optional*}) = $find_constructorDef_overloaded_t(TC, prefixedNameIR, argumentIR*{argumentIR <- argumentIR*}))
    -- if ((constructorTypeIR, typeId_impl*{typeId_impl <- typeId_impl*}) = $specialize_constructorTypeDefIR(constructorTypeDefIR, typeArgumentIR*{typeArgumentIR <- typeArgumentIR*}))

    rule aliased: p TC |- prefixedNameIR `< [] `> `( argumentIR*{argumentIR <- argumentIR*} `) : constructorTypeIR `< '#' typeId_impl*{typeId_impl <- typeId_impl*} `> `( '#' id_default*{id_default <- id_default*} '#' id_optional*{id_optional <- id_optional*} `)
    -- if (?(TYPEDEF nameIR_alias typeIR_alias as typeDefIR) = $find_typeDef_t(p, TC, prefixedNameIR))
    -- if ((nameIR, typeArgumentIR*{typeArgumentIR <- typeArgumentIR*}) = $resolve_type_alias(typeIR_alias))
    -- if (?(callableId ':' constructorTypeDefIR '#' id_default*{id_default <- id_default*} '#' id_optional*{id_optional <- id_optional*}) = $find_constructorDef_overloaded_t(TC, _BARE nameIR, argumentIR*{argumentIR <- argumentIR*}))
    -- if ((constructorTypeIR, typeId_impl*{typeId_impl <- typeId_impl*}) = $specialize_constructorTypeDefIR(constructorTypeDefIR, typeArgumentIR*{typeArgumentIR <- typeArgumentIR*}))

syntax instctxt = 
   | NAMED (from instctxt) 
   | ANON (from instctxt) 

relation Inst_ok: cursor typingContext instctxt |- constructorTypeIR `< typeArgumentListIR '#' typeId* `> `( argumentListIR '#' id* '#' id* `) : typeIR `< typeArgumentListIR `> `( argumentListIR `)

  rulegroup 

    rule package: p TC instctxt |- constructorTypeIR `< typeArgumentIR*{typeArgumentIR <- typeArgumentIR*} '#' typeId_infer*{typeId_infer <- typeId_infer*} `> `( argumentIR*{argumentIR <- argumentIR*} '#' id_default*{id_default <- id_default*} '#' id_optional*{id_optional <- id_optional*} `) : typeIR_object_inferred `< typeArgumentIR_inferred*{typeArgumentIR_inferred <- typeArgumentIR_inferred*} `> `( argumentIR_cast*{argumentIR_cast <- argumentIR_cast*} `)
    -- if (CONSTRUCTOR `( parameterIR*{parameterIR <- parameterIR*} `) ':' typeIR_object = constructorTypeIR)
    -- if (GIVEN parameterIR_aligned*{parameterIR_aligned <- parameterIR_aligned*} DEFAULT _parameterIR*{_parameterIR <- _parameterIR*} OPTIONAL parameterIR_optional*{parameterIR_optional <- parameterIR_optional*} = $align_parameterListIR(parameterIR*{parameterIR <- parameterIR*}, argumentIR*{argumentIR <- argumentIR*}, id_default*{id_default <- id_default*}, id_optional*{id_optional <- id_optional*}))
    -- if (inference = $infer(typeId_infer*{typeId_infer <- typeId_infer*}, parameterIR_aligned*{parameterIR_aligned <- parameterIR_aligned*}, parameterIR_optional*{parameterIR_optional <- parameterIR_optional*}, argumentIR*{argumentIR <- argumentIR*}))
    -- (if (typeArgumentIR_inferred = $subst_typeIR(inference, typeArgumentIR)))*{typeArgumentIR <- typeArgumentIR*, typeArgumentIR_inferred <- typeArgumentIR_inferred*}
    -- (if (parameterIR_aligned_inferred = $subst_parameterIR(inference, parameterIR_aligned)))*{parameterIR_aligned <- parameterIR_aligned*, parameterIR_aligned_inferred <- parameterIR_aligned_inferred*}
    -- if (typeIR_object_inferred = $subst_typeIR(inference, typeIR_object))
    -- if (constructorTypeIR_inferred = CONSTRUCTOR `( parameterIR_aligned_inferred*{parameterIR_aligned_inferred <- parameterIR_aligned_inferred*} `) ':' typeIR_object_inferred)
    -- if ConstructorType_wf: $bound(p, TC) |- constructorTypeIR_inferred holds
    -- if $instantiable(p, TC, instctxt, typeIR_object_inferred)
    -- if (typeIR_object_unroll = $unroll_typeIR(typeIR_object))
    -- if typeIR_object_unroll <: packageObjectTypeIR
    -- if (p = GLOBAL)
    -- Call_convention_ok: BLOCK TC NOACTION |- parameterIR_aligned_inferred*{parameterIR_aligned_inferred <- parameterIR_aligned_inferred*} '@' argumentIR*{argumentIR <- argumentIR*} : argumentIR_cast*{argumentIR_cast <- argumentIR_cast*}

    rule non-package: p TC instctxt |- constructorTypeIR `< typeArgumentIR*{typeArgumentIR <- typeArgumentIR*} '#' typeId_infer*{typeId_infer <- typeId_infer*} `> `( argumentIR*{argumentIR <- argumentIR*} '#' id_default*{id_default <- id_default*} '#' id_optional*{id_optional <- id_optional*} `) : typeIR_object_inferred `< typeArgumentIR_inferred*{typeArgumentIR_inferred <- typeArgumentIR_inferred*} `> `( argumentIR_cast*{argumentIR_cast <- argumentIR_cast*} `)
    -- if (CONSTRUCTOR `( parameterIR*{parameterIR <- parameterIR*} `) ':' typeIR_object = constructorTypeIR)
    -- if (GIVEN parameterIR_aligned*{parameterIR_aligned <- parameterIR_aligned*} DEFAULT _parameterIR*{_parameterIR <- _parameterIR*} OPTIONAL parameterIR_optional*{parameterIR_optional <- parameterIR_optional*} = $align_parameterListIR(parameterIR*{parameterIR <- parameterIR*}, argumentIR*{argumentIR <- argumentIR*}, id_default*{id_default <- id_default*}, id_optional*{id_optional <- id_optional*}))
    -- if (inference = $infer(typeId_infer*{typeId_infer <- typeId_infer*}, parameterIR_aligned*{parameterIR_aligned <- parameterIR_aligned*}, parameterIR_optional*{parameterIR_optional <- parameterIR_optional*}, argumentIR*{argumentIR <- argumentIR*}))
    -- (if (typeArgumentIR_inferred = $subst_typeIR(inference, typeArgumentIR)))*{typeArgumentIR <- typeArgumentIR*, typeArgumentIR_inferred <- typeArgumentIR_inferred*}
    -- (if (parameterIR_aligned_inferred = $subst_parameterIR(inference, parameterIR_aligned)))*{parameterIR_aligned <- parameterIR_aligned*, parameterIR_aligned_inferred <- parameterIR_aligned_inferred*}
    -- if (typeIR_object_inferred = $subst_typeIR(inference, typeIR_object))
    -- if (constructorTypeIR_inferred = CONSTRUCTOR `( parameterIR_aligned_inferred*{parameterIR_aligned_inferred <- parameterIR_aligned_inferred*} `) ':' typeIR_object_inferred)
    -- if ConstructorType_wf: $bound(p, TC) |- constructorTypeIR_inferred holds
    -- if $instantiable(p, TC, instctxt, typeIR_object_inferred)
    -- if (typeIR_object_unroll = $unroll_typeIR(typeIR_object))
    -- if ~typeIR_object_unroll <: packageObjectTypeIR
    -- Call_convention_ok: p TC NOACTION |- parameterIR_aligned_inferred*{parameterIR_aligned_inferred <- parameterIR_aligned_inferred*} '@' argumentIR*{argumentIR <- argumentIR*} : argumentIR_cast*{argumentIR_cast <- argumentIR_cast*}

def $chain_casts(typeIR*, typeIR**) : typeIR** =

  clause 0 : (typeIR_cur*{typeIR_cur <- typeIR_cur*}, typeIR_chain*{typeIR_chain <- typeIR_chain*}*{typeIR_chain* <- typeIR_chain**}) = []
  -- if ([] = $concat_<typeIR>(typeIR_chain*{typeIR_chain <- typeIR_chain*}*{typeIR_chain* <- typeIR_chain**}))

  clause 1 : (typeIR_cur*{typeIR_cur <- typeIR_cur*}, typeIR_chain*{typeIR_chain <- typeIR_chain*}*{typeIR_chain* <- typeIR_chain**}) = typeIR_next*{typeIR_next <- typeIR_next*} :: $chain_casts(typeIR_next*{typeIR_next <- typeIR_next*}, typeIR_chain_rest*{typeIR_chain_rest <- typeIR_chain_rest*}*{typeIR_chain_rest* <- typeIR_chain_rest**})
  -- if ([] =/= $concat_<typeIR>(typeIR_chain*{typeIR_chain <- typeIR_chain*}*{typeIR_chain* <- typeIR_chain**}))
  -- (if ((typeIR_next, typeIR_chain_rest*{typeIR_chain_rest <- typeIR_chain_rest*}) = $chain_casts'(typeIR_cur, typeIR_chain*{typeIR_chain <- typeIR_chain*})))*{typeIR_chain* <- typeIR_chain**, typeIR_chain_rest* <- typeIR_chain_rest**, typeIR_cur <- typeIR_cur*, typeIR_next <- typeIR_next*}

def $chain_casts'(typeIR, typeIR*) : (typeIR, typeIR*) =

  clause 0 : (typeIR_cur, []) = (typeIR_cur, [])

  clause 1 : (typeIR_cur, typeIR_h :: typeIR_t*{typeIR_t <- typeIR_t*}) = (typeIR_h, typeIR_t*{typeIR_t <- typeIR_t*})

def $chain_casts_sequenceTypeIR(typeIR*, typeIR**, typeIR) : typeIR* =

  clause 0 : (typeIR_a*{typeIR_a <- typeIR_a*}, typeIR_cast_elem*{typeIR_cast_elem <- typeIR_cast_elem*}*{typeIR_cast_elem* <- typeIR_cast_elem**}, typeIR_b) = typeIR_cast_agg*{typeIR_cast_agg <- typeIR_cast_agg*} ++ [typeIR_b]
  -- if (typeIR_cast_step*{typeIR_cast_step <- typeIR_cast_step*}*{typeIR_cast_step* <- typeIR_cast_step**} = $chain_casts(typeIR_a*{typeIR_a <- typeIR_a*}, typeIR_cast_elem*{typeIR_cast_elem <- typeIR_cast_elem*}*{typeIR_cast_elem* <- typeIR_cast_elem**}))
  -- (if (typeIR_cast_agg = SEQ `< typeIR_cast_step*{typeIR_cast_step <- typeIR_cast_step*} `> as typeIR))*{typeIR_cast_agg <- typeIR_cast_agg*, typeIR_cast_step* <- typeIR_cast_step**}

def $chain_casts_sequenceTypeIR_default(typeIR*, typeIR**, typeIR) : typeIR* =

  clause 0 : (typeIR_a*{typeIR_a <- typeIR_a*}, typeIR_cast_elem*{typeIR_cast_elem <- typeIR_cast_elem*}*{typeIR_cast_elem* <- typeIR_cast_elem**}, typeIR_b) = typeIR_cast_agg*{typeIR_cast_agg <- typeIR_cast_agg*} ++ [typeIR_b]
  -- if (typeIR_cast_step*{typeIR_cast_step <- typeIR_cast_step*}*{typeIR_cast_step* <- typeIR_cast_step**} = $chain_casts(typeIR_a*{typeIR_a <- typeIR_a*}, typeIR_cast_elem*{typeIR_cast_elem <- typeIR_cast_elem*}*{typeIR_cast_elem* <- typeIR_cast_elem**}))
  -- (if (typeIR_cast_agg = SEQ `< typeIR_cast_step*{typeIR_cast_step <- typeIR_cast_step*} ',' '...' `> as typeIR))*{typeIR_cast_agg <- typeIR_cast_agg*, typeIR_cast_step* <- typeIR_cast_step**}

def $chain_casts_recordTypeIR(fieldTypeIR*, typeIR**, typeIR) : typeIR* =

  clause 0 : (annotationList_a typeIR_a id_a ';'*{annotationList_a <- annotationList_a*, id_a <- id_a*, typeIR_a <- typeIR_a*}, typeIR_cast_elem*{typeIR_cast_elem <- typeIR_cast_elem*}*{typeIR_cast_elem* <- typeIR_cast_elem**}, typeIR_b) = typeIR_cast_agg*{typeIR_cast_agg <- typeIR_cast_agg*} ++ [typeIR_b]
  -- if (typeIR_cast_step*{typeIR_cast_step <- typeIR_cast_step*}*{typeIR_cast_step* <- typeIR_cast_step**} = $chain_casts(typeIR_a*{typeIR_a <- typeIR_a*}, typeIR_cast_elem*{typeIR_cast_elem <- typeIR_cast_elem*}*{typeIR_cast_elem* <- typeIR_cast_elem**}))
  -- (if (typeIR_cast_agg = RECORD `{ annotationList_a typeIR_cast_step id_a ';'*{annotationList_a <- annotationList_a*, id_a <- id_a*, typeIR_cast_step <- typeIR_cast_step*} `} as typeIR))*{typeIR_cast_agg <- typeIR_cast_agg*, typeIR_cast_step* <- typeIR_cast_step**}

def $chain_casts_recordTypeIR_default(fieldTypeIR*, typeIR**, typeIR) : typeIR* =

  clause 0 : (annotationList_a typeIR_a id_a ';'*{annotationList_a <- annotationList_a*, id_a <- id_a*, typeIR_a <- typeIR_a*}, typeIR_cast_elem*{typeIR_cast_elem <- typeIR_cast_elem*}*{typeIR_cast_elem* <- typeIR_cast_elem**}, typeIR_b) = typeIR_cast_agg*{typeIR_cast_agg <- typeIR_cast_agg*} ++ [typeIR_b]
  -- if (typeIR_cast_step*{typeIR_cast_step <- typeIR_cast_step*}*{typeIR_cast_step* <- typeIR_cast_step**} = $chain_casts(typeIR_a*{typeIR_a <- typeIR_a*}, typeIR_cast_elem*{typeIR_cast_elem <- typeIR_cast_elem*}*{typeIR_cast_elem* <- typeIR_cast_elem**}))
  -- (if (typeIR_cast_agg = RECORD `{ annotationList_a typeIR_cast_step id_a ';'*{annotationList_a <- annotationList_a*, id_a <- id_a*, typeIR_cast_step <- typeIR_cast_step*} ',' '...' `} as typeIR))*{typeIR_cast_agg <- typeIR_cast_agg*, typeIR_cast_step* <- typeIR_cast_step**}

def $reduce_serenum(typedExpressionIR) : typedExpressionIR =

  clause 0 : (typedExpressionIR) = typedExpressionIR_reduced
  -- if (typeIR = $type_of_typedExpressionIR(typedExpressionIR))
  -- if (ctk = $ctk_of_typedExpressionIR(typedExpressionIR))
  -- if (ENUM _typeId `< typeIR_underlying `> `{ _valueFieldIR*{_valueFieldIR <- _valueFieldIR*} `} as typeIR = $unroll_typeIR(typeIR))
  -- if (typedExpressionIR_reduced = `( typeIR_underlying `) typedExpressionIR as expressionIR '#' `( typeIR_underlying ctk `))

  clause -1 : (typedExpressionIR) = typedExpressionIR

def $reduce_serenum_unary(typedExpressionIR, $check(typeIR) : bool) : typedExpressionIR? =

  clause 0 : (typedExpressionIR, $check) = ?(typedExpressionIR)
  -- if (_expressionIR '#' `( typeIR _ctk `) = typedExpressionIR)
  -- if $check(typeIR)

  clause 1 : (typedExpressionIR, $check) = $reduce_serenum_unary(typedExpressionIR_cast, $check)
  -- if (_expressionIR '#' `( typeIR ctk `) = typedExpressionIR)
  -- if ~$check(typeIR)
  -- if (ENUM _typeId `< typeIR_underlying `> `{ _valueFieldIR*{_valueFieldIR <- _valueFieldIR*} `} as typeIR = $unroll_typeIR(typeIR))
  -- if (typedExpressionIR_cast = `( typeIR_underlying `) typedExpressionIR as expressionIR '#' `( typeIR_underlying ctk `))

  clause -1 : (typedExpressionIR, $check) = ?()

def $reduce_serenum_binary(typedExpressionIR, typedExpressionIR, $check(typeIR, typeIR) : bool) : (typedExpressionIR, typedExpressionIR)? =

  clause 0 : (typedExpressionIR_l, typedExpressionIR_r, $check) = ?((typedExpressionIR_l, typedExpressionIR_r))
  -- if (_expressionIR '#' `( typeIR_l _ctk `) = typedExpressionIR_l)
  -- if (_expressionIR' '#' `( typeIR_r _ctk' `) = typedExpressionIR_r)
  -- if $check(typeIR_l, typeIR_r)

  clause 1 : (typedExpressionIR_l, typedExpressionIR_r, $check) = $reduce_serenum_binary(typedExpressionIR_l_cast, typedExpressionIR_r, $check)
  -- if (_expressionIR '#' `( typeIR_l ctk_l `) = typedExpressionIR_l)
  -- if (_expressionIR' '#' `( typeIR_r _ctk `) = typedExpressionIR_r)
  -- if ~$check(typeIR_l, typeIR_r)
  -- if (ENUM _typeId `< typeIR_l_underlying `> `{ _valueFieldIR*{_valueFieldIR <- _valueFieldIR*} `} as typeIR = $unroll_typeIR(typeIR_l))
  -- if (typedExpressionIR_l_cast = `( typeIR_l_underlying `) typedExpressionIR_l as expressionIR '#' `( typeIR_l_underlying ctk_l `))

  clause 2 : (typedExpressionIR_l, typedExpressionIR_r, $check) = $reduce_serenum_binary(typedExpressionIR_l, typedExpressionIR_r_cast, $check)
  -- if (_expressionIR '#' `( typeIR_l _ctk `) = typedExpressionIR_l)
  -- if (_expressionIR' '#' `( typeIR_r ctk_r `) = typedExpressionIR_r)
  -- if ~$check(typeIR_l, typeIR_r)
  -- if ~$unroll_typeIR(typeIR_l) <: serializableEnumTypeIR
  -- if (ENUM _typeId `< typeIR_r_underlying `> `{ _valueFieldIR*{_valueFieldIR <- _valueFieldIR*} `} as typeIR = $unroll_typeIR(typeIR_r))
  -- if (typedExpressionIR_r_cast = `( typeIR_r_underlying `) typedExpressionIR_r as expressionIR '#' `( typeIR_r_underlying ctk_r `))

  clause -1 : (typedExpressionIR_l, typedExpressionIR_r, $check) = ?()

def $apply_cast(typedExpressionIR, typeIR*) : typedExpressionIR =

  clause 0 : (typedExpressionIR, []) = typedExpressionIR

  clause 1 : (typedExpressionIR, typeIR_h :: typeIR_t*{typeIR_t <- typeIR_t*}) = $apply_cast(typedExpressionIR_cast, typeIR_t*{typeIR_t <- typeIR_t*})
  -- if (_expressionIR '#' `( _typeIR ctk `) = typedExpressionIR)
  -- if (typedExpressionIR_cast = `( typeIR_h `) typedExpressionIR as expressionIR '#' `( typeIR_h ctk `))

def $cast_unary(typedExpressionIR, typeIR) : typedExpressionIR? =

  clause 0 : (typedExpressionIR, typeIR_to) = ?(typedExpressionIR_cast)
  -- if (_expressionIR '#' `( typeIR _ctk `) = typedExpressionIR)
  -- Cast_impl: typeIR -> typeIR_to : OK typeIR_cast*{typeIR_cast <- typeIR_cast*}
  -- if (typedExpressionIR_cast = $apply_cast(typedExpressionIR, typeIR_cast*{typeIR_cast <- typeIR_cast*}))

  clause -1 : (typedExpressionIR, typeIR_to) = ?()

def $cast_binary(typedExpressionIR, typedExpressionIR) : (typedExpressionIR, typedExpressionIR)? =

  clause 0 : (typedExpressionIR_l, typedExpressionIR_r) = ?((typedExpressionIR_l_cast, typedExpressionIR_r))
  -- if (_expressionIR '#' `( typeIR_l _ctk `) = typedExpressionIR_l)
  -- if (_expressionIR' '#' `( typeIR_r _ctk' `) = typedExpressionIR_r)
  -- Cast_impl: typeIR_l -> typeIR_r : OK typeIR_cast*{typeIR_cast <- typeIR_cast*}
  -- if (typedExpressionIR_l_cast = $apply_cast(typedExpressionIR_l, typeIR_cast*{typeIR_cast <- typeIR_cast*}))

  clause 1 : (typedExpressionIR_l, typedExpressionIR_r) = ?((typedExpressionIR_l, typedExpressionIR_r_cast))
  -- if (_expressionIR '#' `( typeIR_l _ctk `) = typedExpressionIR_l)
  -- if (_expressionIR' '#' `( typeIR_r _ctk' `) = typedExpressionIR_r)
  -- Cast_impl: typeIR_l -> typeIR_r : FAIL
  -- Cast_impl: typeIR_r -> typeIR_l : OK typeIR_cast*{typeIR_cast <- typeIR_cast*}
  -- if (typedExpressionIR_r_cast = $apply_cast(typedExpressionIR_r, typeIR_cast*{typeIR_cast <- typeIR_cast*}))

  clause 2 : (typedExpressionIR_l, typedExpressionIR_r) = $cast_binary(typedExpressionIR_l_cast, typedExpressionIR_r)
  -- if (_expressionIR '#' `( typeIR_l _ctk `) = typedExpressionIR_l)
  -- if (_expressionIR' '#' `( typeIR_r _ctk' `) = typedExpressionIR_r)
  -- Cast_impl: typeIR_l -> typeIR_r : FAIL
  -- Cast_impl: typeIR_r -> typeIR_l : FAIL
  -- if (typedExpressionIR_l_cast = $reduce_serenum(typedExpressionIR_l))
  -- if (typedExpressionIR_l =/= typedExpressionIR_l_cast)

  clause 3 : (typedExpressionIR_l, typedExpressionIR_r) = $cast_binary(typedExpressionIR_l, typedExpressionIR_r_cast)
  -- if (_expressionIR '#' `( typeIR_l _ctk `) = typedExpressionIR_l)
  -- if (_expressionIR' '#' `( typeIR_r _ctk' `) = typedExpressionIR_r)
  -- Cast_impl: typeIR_l -> typeIR_r : FAIL
  -- Cast_impl: typeIR_r -> typeIR_l : FAIL
  -- if (typedExpressionIR_l_cast = $reduce_serenum(typedExpressionIR_l))
  -- if (typedExpressionIR_l = typedExpressionIR_l_cast)
  -- if (typedExpressionIR_r_cast = $reduce_serenum(typedExpressionIR_r))
  -- if (typedExpressionIR_r =/= typedExpressionIR_r_cast)

  clause -1 : (typedExpressionIR_l, typedExpressionIR_r) = ?()

tbl def $compat_lnot(typeIR) : bool =
  row 0 :
    (BOOL as typeIR) -> true
  row 1 :
    (TYPEDEF _typeId typeIR as typeIR) -> $compat_lnot(typeIR)
  row 2 :
    (_typeIR) -> false

tbl def $compat_bnot(typeIR) : bool =
  row 0 :
    (INT `< _nat `> as typeIR) -> true
  row 1 :
    (BIT `< _nat `> as typeIR) -> true
  row 2 :
    (TYPEDEF _typeId typeIR as typeIR) -> $compat_bnot(typeIR)
  row 3 :
    (_typeIR) -> false

tbl def $compat_uplusminus(typeIR) : bool =
  row 0 :
    (INT as typeIR) -> true
  row 1 :
    (INT `< _nat `> as typeIR) -> true
  row 2 :
    (BIT `< _nat `> as typeIR) -> true
  row 3 :
    (TYPEDEF _typeId typeIR as typeIR) -> $compat_uplusminus(typeIR)
  row 4 :
    (_typeIR) -> false

tbl def $compat_plusminusmult(typeIR, typeIR) : bool =
  row 0 :
    (INT as typeIR, INT as typeIR) -> true
  row 1 :
    (INT `< w_l `> as typeIR, INT `< w_r `> as typeIR) -> (w_l = w_r)
  row 2 :
    (BIT `< w_l `> as typeIR, BIT `< w_r `> as typeIR) -> (w_l = w_r)
  row 3 :
    (TYPEDEF _typeId typeIR_l as typeIR, typeIR_r) -> $compat_plusminusmult(typeIR_l, typeIR_r)
  row 4 :
    (typeIR_l, TYPEDEF _typeId typeIR_r as typeIR) -> $compat_plusminusmult(typeIR_l, typeIR_r)
  row 5 :
    (_typeIR, _typeIR') -> false

tbl def $compat_satplusminus(typeIR, typeIR) : bool =
  row 0 :
    (INT `< w_l `> as typeIR, INT `< w_r `> as typeIR) -> (w_l = w_r)
  row 1 :
    (BIT `< w_l `> as typeIR, BIT `< w_r `> as typeIR) -> (w_l = w_r)
  row 2 :
    (TYPEDEF _typeId typeIR_l as typeIR, typeIR_r) -> $compat_satplusminus(typeIR_l, typeIR_r)
  row 3 :
    (typeIR_l, TYPEDEF _typeId typeIR_r as typeIR) -> $compat_satplusminus(typeIR_l, typeIR_r)
  row 4 :
    (_typeIR, _typeIR') -> false

tbl def $compat_divmod(typeIR, typeIR) : bool =
  row 0 :
    (INT as typeIR, INT as typeIR) -> true
  row 1 :
    (BIT `< w_l `> as typeIR, BIT `< w_r `> as typeIR) -> (w_l = w_r)
  row 2 :
    (TYPEDEF _typeId typeIR_l as typeIR, typeIR_r) -> $compat_divmod(typeIR_l, typeIR_r)
  row 3 :
    (typeIR_l, TYPEDEF _typeId typeIR_r as typeIR) -> $compat_divmod(typeIR_l, typeIR_r)
  row 4 :
    (_typeIR, _typeIR') -> false

tbl def $compat_shift(typeIR, typeIR) : bool =
  row 0 :
    (INT as typeIR, INT as typeIR) -> true
  row 1 :
    (INT as typeIR, INT `< _nat `> as typeIR) -> true
  row 2 :
    (INT as typeIR, BIT `< _nat `> as typeIR) -> true
  row 3 :
    (INT `< _nat `> as typeIR, INT as typeIR) -> true
  row 4 :
    (INT `< _nat `> as typeIR, INT `< _nat' `> as typeIR) -> true
  row 5 :
    (INT `< _nat `> as typeIR, BIT `< _nat' `> as typeIR) -> true
  row 6 :
    (BIT `< _nat `> as typeIR, INT as typeIR) -> true
  row 7 :
    (BIT `< _nat `> as typeIR, INT `< _nat' `> as typeIR) -> true
  row 8 :
    (BIT `< _nat `> as typeIR, BIT `< _nat' `> as typeIR) -> true
  row 9 :
    (TYPEDEF _typeId typeIR_l as typeIR, typeIR_r) -> $compat_shift(typeIR_l, typeIR_r)
  row 10 :
    (typeIR_l, TYPEDEF _typeId typeIR_r as typeIR) -> $compat_shift(typeIR_l, typeIR_r)
  row 11 :
    (_typeIR, _typeIR') -> false

tbl def $compat_compare(typeIR, typeIR) : bool =
  row 0 :
    (INT as typeIR, INT as typeIR) -> true
  row 1 :
    (INT `< w_l `> as typeIR, INT `< w_r `> as typeIR) -> (w_l = w_r)
  row 2 :
    (BIT `< w_l `> as typeIR, BIT `< w_r `> as typeIR) -> (w_l = w_r)
  row 3 :
    (TYPEDEF _typeId typeIR_l as typeIR, typeIR_r) -> $compat_compare(typeIR_l, typeIR_r)
  row 4 :
    (typeIR_l, TYPEDEF _typeId typeIR_r as typeIR) -> $compat_compare(typeIR_l, typeIR_r)
  row 5 :
    (_typeIR, _typeIR') -> false

tbl def $compat_bitwise(typeIR, typeIR) : bool =
  row 0 :
    (INT `< w_l `> as typeIR, INT `< w_r `> as typeIR) -> (w_l = w_r)
  row 1 :
    (BIT `< w_l `> as typeIR, BIT `< w_r `> as typeIR) -> (w_l = w_r)
  row 2 :
    (TYPEDEF _typeId typeIR_l as typeIR, typeIR_r) -> $compat_bitwise(typeIR_l, typeIR_r)
  row 3 :
    (typeIR_l, TYPEDEF _typeId typeIR_r as typeIR) -> $compat_bitwise(typeIR_l, typeIR_r)
  row 4 :
    (_typeIR, _typeIR') -> false

tbl def $compat_concat(typeIR, typeIR) : bool =
  row 0 :
    (STRING as typeIR, STRING as typeIR) -> true
  row 1 :
    (INT `< _nat `> as typeIR, INT `< _nat' `> as typeIR) -> true
  row 2 :
    (INT `< _nat `> as typeIR, BIT `< _nat' `> as typeIR) -> true
  row 3 :
    (BIT `< _nat `> as typeIR, INT `< _nat' `> as typeIR) -> true
  row 4 :
    (BIT `< _nat `> as typeIR, BIT `< _nat' `> as typeIR) -> true
  row 5 :
    (TYPEDEF _typeId typeIR_l as typeIR, typeIR_r) -> $compat_concat(typeIR_l, typeIR_r)
  row 6 :
    (typeIR_l, TYPEDEF _typeId typeIR_r as typeIR) -> $compat_concat(typeIR_l, typeIR_r)
  row 7 :
    (_typeIR, _typeIR') -> false

def $result_concat(typeIR, typeIR) : typeIR =

  clause 0 : (STRING as typeIR, STRING as typeIR) = STRING as typeIR

  clause 1 : (INT `< w_a `> as typeIR, INT `< w_b `> as typeIR) = INT `< (w_a + w_b) `> as typeIR

  clause 2 : (INT `< w_a `> as typeIR, BIT `< w_b `> as typeIR) = INT `< (w_a + w_b) `> as typeIR

  clause 3 : (BIT `< w_a `> as typeIR, INT `< w_b `> as typeIR) = BIT `< (w_a + w_b) `> as typeIR

  clause 4 : (BIT `< w_a `> as typeIR, BIT `< w_b `> as typeIR) = BIT `< (w_a + w_b) `> as typeIR

  clause 5 : (TYPEDEF _typeId typeIR_l as typeIR, typeIR_r) = $result_concat(typeIR_l, typeIR_r)

  clause 6 : (typeIR_l, TYPEDEF _typeId typeIR_r as typeIR) = $result_concat(typeIR_l, typeIR_r)
  -- if ~typeIR_l <: typedefTypeIR

tbl def $compat_logical(typeIR, typeIR) : bool =
  row 0 :
    (BOOL as typeIR, BOOL as typeIR) -> true
  row 1 :
    (TYPEDEF _typeId typeIR_l as typeIR, typeIR_r) -> $compat_logical(typeIR_l, typeIR_r)
  row 2 :
    (typeIR_l, TYPEDEF _typeId typeIR_r as typeIR) -> $compat_logical(typeIR_l, typeIR_r)
  row 3 :
    (_typeIR, _typeIR') -> false

tbl def $compat_array_index(typeIR) : bool =
  row 0 :
    (INT as typeIR) -> true
  row 1 :
    (INT `< _nat `> as typeIR) -> true
  row 2 :
    (BIT `< _nat `> as typeIR) -> true
  row 3 :
    (TYPEDEF _typeId typeIR as typeIR) -> $compat_array_index(typeIR)
  row 4 :
    (_typeIR) -> false

tbl def $compat_bitslice_base(typeIR) : bool =
  row 0 :
    (INT as typeIR) -> true
  row 1 :
    (INT `< w `> as typeIR) -> (w > 0)
  row 2 :
    (BIT `< _nat `> as typeIR) -> true
  row 3 :
    (TYPEDEF _typeId typeIR as typeIR) -> $compat_bitslice_base(typeIR)
  row 4 :
    (_typeIR) -> false

tbl def $compat_bitslice_range_index(typeIR) : bool =
  row 0 :
    (INT as typeIR) -> true
  row 1 :
    (INT `< _nat `> as typeIR) -> true
  row 2 :
    (BIT `< _nat `> as typeIR) -> true
  row 3 :
    (TYPEDEF _typeId typeIR as typeIR) -> $compat_bitslice_range_index(typeIR)
  row 4 :
    (_typeIR) -> false

tbl def $compat_bitslice_offset_index(typeIR) : bool =
  row 0 :
    (INT as typeIR) -> true
  row 1 :
    (INT `< _nat `> as typeIR) -> true
  row 2 :
    (BIT `< _nat `> as typeIR) -> true
  row 3 :
    (TYPEDEF _typeId typeIR as typeIR) -> $compat_bitslice_offset_index(typeIR)
  row 4 :
    (_typeIR) -> false

tbl def $compat_bitslice_offset_width(typeIR) : bool =
  row 0 :
    (INT as typeIR) -> true
  row 1 :
    (INT `< _nat `> as typeIR) -> true
  row 2 :
    (BIT `< _nat `> as typeIR) -> true
  row 3 :
    (TYPEDEF _typeId typeIR as typeIR) -> $compat_bitslice_offset_width(typeIR)
  row 4 :
    (_typeIR) -> false

def $is_valid_bitslice(typeIR, nat, nat) : bool =

  clause 0 : (INT as typeIR, n_lo, n_hi) = (n_lo <= n_hi)

  clause 1 : (INT `< w `> as typeIR, n_lo, n_hi) = (((n_lo <= n_hi) /\ (n_hi <= w)) /\ (w_slice <= w))
  -- if (w_slice as int = ((n_hi - n_lo) + 1 as int))

  clause 2 : (BIT `< w `> as typeIR, n_lo, n_hi) = (((n_lo <= n_hi) /\ (n_hi <= w)) /\ (w_slice <= w))
  -- if (w_slice as int = ((n_hi - n_lo) + 1 as int))

  clause 3 : (TYPEDEF _typeId typeIR as typeIR, n_lo, n_hi) = $is_valid_bitslice(typeIR, n_lo, n_hi)

  clause -1 : (_typeIR, _nat, _nat') = false

def $is_concrete_extern_object(typeIR) : bool =

  clause 0 : (typeIR) = $is_concrete_extern_object'($unroll_typeIR(typeIR))

def $is_concrete_extern_object'(typeIR) : bool =

  clause 0 : (typeIR) = true
  -- if ~typeIR <: externObjectTypeIR

  clause 1 : (EXTERN _typeId `< _typeArgumentIR*{_typeArgumentIR <- _typeArgumentIR*} `> `{ _callableId ':' externMethodTypeDefIR*{_callableId <- _callableId*, externMethodTypeDefIR <- externMethodTypeDefIR*} `} as typeIR) = true
  -- (if $is_concrete_extern_object''(externMethodTypeDefIR))*{externMethodTypeDefIR <- externMethodTypeDefIR*}

  clause -1 : (typeIR) = false

def $is_concrete_extern_object''(externMethodTypeDefIR) : bool =

  clause 0 : (EXTERN_METHOD _nameIR `< _typeParameterIR*{_typeParameterIR <- _typeParameterIR*} ',' _typeParameterIR'*{_typeParameterIR' <- _typeParameterIR'*} `> `( _parameterIR*{_parameterIR <- _parameterIR*} `) ':' _typeIR) = true

  clause -1 : (externMethodTypeDefIR) = false

