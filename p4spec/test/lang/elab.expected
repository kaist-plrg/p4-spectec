  clause 2 : ({ pair<callableId, V>*{pair<callableId, V> <- pair<callableId, V>*} }, nameIR_f) = (callableId_t_found, V_t_found)*{V_t_found <- V_t_found*, callableId_t_found <- callableId_t_found*}
