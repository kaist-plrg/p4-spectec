   | ref objectId

syntax defaultValue = 
   | default

syntax invalidHeaderValue = 
   | {#}

syntax sequenceValue = 
   | seq( value* )
   | seq( value* ,...)

syntax recordValue = 
   | record{ fieldValue* }
   | record{ fieldValue* ,...}

syntax setValue = 
   | set{ value }
   | set{ value* ( nat )}
   | set{ value &&& value }
   | set{ value .. value }
   | set{...}

syntax tableMetadataEnumValue = 
   | table_enum typeId . nameIR

syntax tableMetadataStructValue = 
   | table_struct typeId {hit boolValue ;miss boolValue ;action_run tableMetadataEnumValue ;}

syntax tableMetadataValue = 
   | table_enum typeId . nameIR
   | table_struct typeId {hit boolValue ;miss boolValue ;action_run tableMetadataEnumValue ;}

syntax synthesizedValue = 
   | default
   | {#}
   | seq( value* )
   | seq( value* ,...)
   | record{ fieldValue* }
   | record{ fieldValue* ,...}
   | set{ value }
   | set{ value* ( nat )}
   | set{ value &&& value }
   | set{ value .. value }
   | set{...}
   | table_enum typeId . nameIR
   | table_struct typeId {hit boolValue ;miss boolValue ;action_run tableMetadataEnumValue ;}

syntax value = 
   | `b bool
   | error. nameIR
   | match_kind. nameIR
   | " text " hint(print "#%#")
   | d int hint(print %)
   | nat w int hint(print %#W#%)
   | nat s int hint(print %#S#%)
   | nat . nat v int
   | list[ value* ]
   | tuple( value* )
   | header_stack[ value* ( nat ; nat )]
   | struct typeId { fieldValue* }
   | header typeId { bool ; fieldValue* }
   | header_union typeId { fieldValue* }
   | typeId . nameIR
   | typeId . nameIR . value
   | ref objectId
   | default
   | {#}
   | seq( value* )
   | seq( value* ,...)
   | record{ fieldValue* }
   | record{ fieldValue* ,...}
   | set{ value }
   | set{ value* ( nat )}
   | set{ value &&& value }
   | set{ value .. value }
   | set{...}
   | table_enum typeId . nameIR
   | table_struct typeId {hit boolValue ;miss boolValue ;action_run tableMetadataEnumValue ;}

