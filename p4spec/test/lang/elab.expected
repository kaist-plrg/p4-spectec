    rule header-stack: EC_0 ARCH_0 |- typedExpressionIR as forCollectionExpressionIR : EC_1 ARCH_1 _CONT value*{value <- value*} as expressionListResult
    -- Expr_eval: LOCAL EC_0 ARCH_0 |- typedExpressionIR : EC_1 ARCH_1 _CONT headerStackValue as value as expressionResult
