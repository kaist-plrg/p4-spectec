def $callableId(name, parameterList) : callableId =

  clause 0 : (name, parameterList) = $name(name) ( $callableId'(parameterList) )

def $callableId'(parameterList) : id* =

  clause 0 : (parameterList) = []
  -- if parameterList matches ``EMPTY`

  clause 1 : (parameterList) = [$name(name)]
  -- if parameterList <: parameter
  -- let _annotationList _direction _type name _initializerOpt = parameterList as parameter

  clause 2 : (parameterList) = $callableId'(nonEmptyParameterList as parameterList) ++ [$name(name)]
  -- if parameterList <: nonEmptyParameterList
  -- let nonEmptyParameterList' = parameterList as nonEmptyParameterList
  -- if nonEmptyParameterList' matches `%,%`
  -- let nonEmptyParameterList , _annotationList _direction _type name _initializerOpt = nonEmptyParameterList'

def $constructorId(name, constructorParameterListOpt) : constructorId =

  clause 0 : (name, constructorParameterListOpt) = $name(name) ( [] )
  -- if constructorParameterListOpt matches ``EMPTY`

  clause 1 : (name, constructorParameterListOpt) = $callableId(name, parameterList)
  -- if constructorParameterListOpt matches `(%)`
  -- let ( parameterList ) = constructorParameterListOpt

