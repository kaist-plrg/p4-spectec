  -- let typeIR_unroll = $unroll_typeIR(typeIR)

  clause 8 : (typeIR, value) = $cast_sequence(typeIR_unroll, sequenceValue)
  -- if value <: sequenceValue
  -- let sequenceValue = value as sequenceValue
  -- let typeIR_unroll = $unroll_typeIR(typeIR)

  clause 9 : (typeIR, value) = $cast_record(typeIR_unroll, recordValue)
  -- if value <: recordValue
  -- let recordValue = value as recordValue
