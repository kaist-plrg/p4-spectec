  rulegroup referenceExpressionIR

   match

    (signature) p TC |- prefixedNameIR as expressionIR # ( _typeIR _ctk )
    p TC |- expressionIR # ( _typeIR _ctk )
    -- if expressionIR <: prefixedNameIR
    -- let prefixedNameIR = expressionIR as prefixedNameIR

   paths

    rulepath referenceExpressionIR
    -- let varTypeIR?{varTypeIR <- varTypeIR?} = $find_var_t(prefixedNameIR, p, TC)
    -- if varTypeIR?{varTypeIR <- varTypeIR?} matches (_)
    -- let ?(direction _typeIR' ctk _value?{_value <- _value?}) = varTypeIR?{varTypeIR <- varTypeIR?}
    -- if ctk matches `DYN`
    -- if ((direction = out) \/ (direction = inout))
    -- the relation holds

  rulegroup accessExpressionIR-memberAccessExpressionIR

   match

    (signature) p TC |- typedExpressionIR_base as memberAccessBaseIR . nameIR as expressionIR # ( _typeIR _ctk )
    p TC |- expressionIR # ( _typeIR _ctk )
    -- if expressionIR <: memberAccessExpressionIR
    -- let memberAccessBaseIR . nameIR = expressionIR as memberAccessExpressionIR
    -- if memberAccessBaseIR <: typedExpressionIR
    -- let typedExpressionIR_base = memberAccessBaseIR as typedExpressionIR

   paths

    rulepath headerstack-next-last
    -- if Expr_lvalue_ok: p TC |- typedExpressionIR_base holds
    -- let typeIR_base = $type_of_typedExpressionIR(typedExpressionIR_base)
    -- let typeIR' = $unroll_typeIR(typeIR_base)
    -- if typeIR' <: headerStackTypeIR
    -- let typeIR [ _nat ] = typeIR' as headerStackTypeIR
    -- if ((nameIR = "next") \/ (nameIR = "last"))
    -- if (((p = block) /\ (TC.block.kind = parser)) \/ ((p = local) /\ (TC.local.kind = parser_state as localKind)))
    -- the relation holds

    rulepath non-headerstack
    -- if Expr_lvalue_ok: p TC |- typedExpressionIR_base holds
    -- let typeIR_base = $type_of_typedExpressionIR(typedExpressionIR_base)
    -- let typeIR_unroll = $unroll_typeIR(typeIR_base)
    -- if ~typeIR_unroll <: headerStackTypeIR
    -- the relation holds

  rulegroup accessExpressionIR-indexAccessExpressionIR

   match

    (signature) p TC |- typedExpressionIR_base [ typedExpressionIR_index ] as expressionIR # ( _typeIR _ctk )
    p TC |- expressionIR # ( _typeIR _ctk )
    -- if expressionIR <: indexAccessExpressionIR
    -- let typedExpressionIR_base [ typedExpressionIR_index ] = expressionIR as indexAccessExpressionIR

   paths

    rulepath accessExpressionIR-indexAccessExpressionIR
    -- if Expr_lvalue_ok: p TC |- typedExpressionIR_base holds
    -- the relation holds

  rulegroup accessExpressionIR-sliceAccessExpressionIR

   match

    (signature) p TC |- typedExpressionIR_base [ typedExpressionIR_hi : typedExpressionIR_lo ] as expressionIR # ( _typeIR _ctk )
    p TC |- expressionIR # ( _typeIR _ctk )
    -- if expressionIR <: sliceAccessExpressionIR
    -- let typedExpressionIR_base [ typedExpressionIR_hi : typedExpressionIR_lo ] = expressionIR as sliceAccessExpressionIR

   paths

    rulepath accessExpressionIR-sliceAccessExpressionIR
    -- if Expr_lvalue_ok: p TC |- typedExpressionIR_base holds
    -- the relation holds

syntax infer = 
   | knownas typeIR
   | unknown

syntax constraint = map<typeId, infer>

def $empty_constraint(typeId*) : constraint =

  clause 0 : (typeId*{typeId <- typeId*}) = { typeId : unknown*{typeId <- typeId*} }

syntax inference = map<typeId, typeIR>

def $infer(typeId*, parameterIR*, argumentIR*) : inference =

  clause 0 : (typeId*{typeId <- typeId*}, parameterIR*{parameterIR <- parameterIR*}, argumentIR*{argumentIR <- argumentIR*}) = $empty_map<typeId, typeIR>
  -- if typeId*{typeId <- typeId*} matches []

  clause 1 : (typeId_infer*{typeId_infer <- typeId_infer*}, parameterIR*{parameterIR <- parameterIR*}, argumentIR*{argumentIR <- argumentIR*}) = inference_resolved
  -- if (typeId_infer*{typeId_infer <- typeId_infer*} =/= [])
  -- let constraint_init = $empty_constraint(typeId_infer*{typeId_infer <- typeId_infer*})
  -- (let constraint_pair = $infer'(constraint_init, parameterIR, argumentIR))*{argumentIR <- argumentIR*, parameterIR <- parameterIR*, constraint_pair -> constraint_pair*}
  -- let constraint_inferred = $merge_constraints(constraint_init, constraint_pair*{constraint_pair <- constraint_pair*})
  -- let inference = $resolve_constraint(constraint_inferred)
  -- let inference_resolved = $resolve_inference(inference)

def $infer'(constraint, parameterIR, argumentIR) : constraint =

  clause 0 : (constraint, parameterIR, argumentIR) = $gen_constraint(constraint, typeIR_param, typeIR_arg)
  -- if argumentIR <: typedExpressionIR
  -- let typedExpressionIR = argumentIR as typedExpressionIR
  -- let _annotationList _direction typeIR_param _id _parameterInitializerOptIR = parameterIR
  -- let typeIR_arg = $type_of_typedExpressionIR(typedExpressionIR)

  clause 1 : (constraint, parameterIR, argumentIR) = $gen_constraint(constraint, typeIR_param, typeIR_arg)
  -- if argumentIR matches `%=%`
  -- let nameIR = typedExpressionIR = argumentIR
  -- let _annotationList _direction typeIR_param _id _parameterInitializerOptIR = parameterIR
  -- let typeIR_arg = $type_of_typedExpressionIR(typedExpressionIR)

  clause 2 : (constraint, parameterIR, argumentIR) = constraint
  -- if argumentIR matches `%=_`
  -- let nameIR =_ = argumentIR

  clause 3 : (constraint, parameterIR, argumentIR) = constraint
  -- if argumentIR matches `_`

def $resolve_inference(inference) : inference =

  clause 0 : ({ typeId : typeIR*{typeIR <- typeIR*, typeId <- typeId*} }) = { typeId : typeIR_resolved*{typeIR_resolved <- typeIR_resolved*, typeId <- typeId*} }
  -- (let typeIR_resolved = $resolve_inference'(typeIR))*{typeIR <- typeIR*, typeIR_resolved -> typeIR_resolved*}

def $resolve_inference'(typeIR) : typeIR =

  clause 0 : (typeIR) = typeIR_resolved
  -- let typeIR' = $unroll_typeIR(typeIR)
  -- if typeIR' <: sequenceTypeIR
  -- let sequenceTypeIR = typeIR' as sequenceTypeIR
  -- if sequenceTypeIR matches `SEQ<%>`
  -- let seq< typeIR_arg*{typeIR_arg <- typeIR_arg*} > = sequenceTypeIR
  -- let typeIR_resolved = tuple< typeIR_arg*{typeIR_arg <- typeIR_arg*} > as typeIR

  clause -1 : (typeIR) = typeIR

def $gen_constraint(constraint, typeIR, typeIR) : constraint =

  clause 0 : (constraint, typeIR, typeIR_arg) = $update_map<typeId, infer>(constraint, typeId_param, knownas typeIR_arg)
  -- if typeIR <: nameTypeIR
  -- let ` typeId_param = typeIR as nameTypeIR
  -- if $in_set<typeId>(typeId_param, $dom_map<typeId, infer>(constraint))

  clause 1 : (constraint, typeIR, typeIR_arg) = $gen_constraint(constraint, typeIR_param, typeIR_arg)
  -- if typeIR <: typedefTypeIR
  -- let typedef _typeId typeIR_param = typeIR as typedefTypeIR

  clause 2 : (constraint, typeIR_param, typeIR) = $gen_constraint(constraint, typeIR_param, typeIR_arg)
  -- if typeIR <: typedefTypeIR
  -- let typedef _typeId typeIR_arg = typeIR as typedefTypeIR
  -- if ~typeIR_param <: nameTypeIR
  -- if ~typeIR_param <: typedefTypeIR

  clause 3 : (constraint, typeIR, typeIR') = $gen_constraint(constraint, typeIR_param, typeIR_arg)
  -- if typeIR <: newTypeIR
  -- let type typeId typeIR_param = typeIR as newTypeIR
  -- if typeIR' <: newTypeIR
  -- let type typeId' typeIR_arg = typeIR' as newTypeIR
  -- if (typeId = typeId')

  clause 4 : (constraint, typeIR, typeIR') = $gen_constraint(constraint, typeIR_param, typeIR_arg)
  -- if typeIR <: listTypeIR
  -- let list< typeIR_param > = typeIR as listTypeIR
  -- if typeIR' <: listTypeIR
  -- let list< typeIR_arg > = typeIR' as listTypeIR

  clause 5 : (constraint, typeIR, typeIR') = $gen_constraints(constraint, typeIR_param*{typeIR_param <- typeIR_param*}, typeIR_arg*{typeIR_arg <- typeIR_arg*})
  -- if typeIR <: tupleTypeIR
  -- let tuple< typeIR_param*{typeIR_param <- typeIR_param*} > = typeIR as tupleTypeIR
  -- if typeIR' <: tupleTypeIR
  -- let tuple< typeIR_arg*{typeIR_arg <- typeIR_arg*} > = typeIR' as tupleTypeIR

  clause 6 : (constraint, typeIR, typeIR') = $gen_constraint(constraint, typeIR_param, typeIR_arg)
  -- if typeIR <: headerStackTypeIR
  -- let typeIR_param [ n_size ] = typeIR as headerStackTypeIR
  -- if typeIR' <: headerStackTypeIR
  -- let typeIR_arg [ n_size' ] = typeIR' as headerStackTypeIR
  -- if (n_size = n_size')

  clause 7 : (constraint, typeIR, typeIR') = $gen_constraints(constraint, typeIR_arg_a*{typeIR_arg_a <- typeIR_arg_a*}, typeIR_arg_b*{typeIR_arg_b <- typeIR_arg_b*})
  -- if typeIR <: structTypeIR
  -- let struct typeId < typeIR_arg_a*{typeIR_arg_a <- typeIR_arg_a*} >{ _fieldTypeIR*{_fieldTypeIR <- _fieldTypeIR*} } = typeIR as structTypeIR
  -- if typeIR' <: structTypeIR
  -- let struct typeId' < typeIR_arg_b*{typeIR_arg_b <- typeIR_arg_b*} >{ _fieldTypeIR'*{_fieldTypeIR' <- _fieldTypeIR'*} } = typeIR' as structTypeIR
  -- if (typeId = typeId')

  clause 8 : (constraint, typeIR, typeIR') = $gen_constraints(constraint, typeIR_arg_a*{typeIR_arg_a <- typeIR_arg_a*}, typeIR_arg_b*{typeIR_arg_b <- typeIR_arg_b*})
  -- if typeIR <: headerTypeIR
  -- let header typeId < typeIR_arg_a*{typeIR_arg_a <- typeIR_arg_a*} >{ _fieldTypeIR*{_fieldTypeIR <- _fieldTypeIR*} } = typeIR as headerTypeIR
  -- if typeIR' <: headerTypeIR
  -- let header typeId' < typeIR_arg_b*{typeIR_arg_b <- typeIR_arg_b*} >{ _fieldTypeIR'*{_fieldTypeIR' <- _fieldTypeIR'*} } = typeIR' as headerTypeIR
  -- if (typeId = typeId')

  clause 9 : (constraint, typeIR, typeIR') = $gen_constraints(constraint, typeIR_arg_a*{typeIR_arg_a <- typeIR_arg_a*}, typeIR_arg_b*{typeIR_arg_b <- typeIR_arg_b*})
  -- if typeIR <: headerUnionTypeIR
  -- let header_union typeId < typeIR_arg_a*{typeIR_arg_a <- typeIR_arg_a*} >{ _fieldTypeIR*{_fieldTypeIR <- _fieldTypeIR*} } = typeIR as headerUnionTypeIR
  -- if typeIR' <: headerUnionTypeIR
  -- let header_union typeId' < typeIR_arg_b*{typeIR_arg_b <- typeIR_arg_b*} >{ _fieldTypeIR'*{_fieldTypeIR' <- _fieldTypeIR'*} } = typeIR' as headerUnionTypeIR
  -- if (typeId = typeId')

  clause 10 : (constraint, typeIR, typeIR') = $gen_constraints(constraint, typeIR_arg_a*{typeIR_arg_a <- typeIR_arg_a*}, typeIR_arg_b*{typeIR_arg_b <- typeIR_arg_b*})
  -- if typeIR <: externObjectTypeIR
  -- let extern typeId < typeIR_arg_a*{typeIR_arg_a <- typeIR_arg_a*} > { _pair<callableId, externMethodTypeDefIR>*{_pair<callableId, externMethodTypeDefIR> <- _pair<callableId, externMethodTypeDefIR>*} } = typeIR as externObjectTypeIR
  -- if typeIR' <: externObjectTypeIR
  -- let extern typeId' < typeIR_arg_b*{typeIR_arg_b <- typeIR_arg_b*} > { _pair<callableId, externMethodTypeDefIR>'*{_pair<callableId, externMethodTypeDefIR>' <- _pair<callableId, externMethodTypeDefIR>'*} } = typeIR' as externObjectTypeIR
  -- if (typeId = typeId')

  clause 11 : (constraint, typeIR, typeIR') = $gen_constraints(constraint, typeIR_param*{typeIR_param <- typeIR_param*}, typeIR_arg*{typeIR_arg <- typeIR_arg*})
  -- if typeIR <: parserObjectTypeIR
  -- let parser _typeId < _typeArgumentIR*{_typeArgumentIR <- _typeArgumentIR*} >( parameterIR_param*{parameterIR_param <- parameterIR_param*} ) = typeIR as parserObjectTypeIR
  -- if typeIR' <: parserObjectTypeIR
  -- let parser _typeId' < _typeArgumentIR'*{_typeArgumentIR' <- _typeArgumentIR'*} >( parameterIR_arg*{parameterIR_arg <- parameterIR_arg*} ) = typeIR' as parserObjectTypeIR
  -- (let _annotationList direction typeIR_param _id _parameterInitializerOptIR = parameterIR_param)*{parameterIR_param <- parameterIR_param*, _annotationList -> _annotationList*, _id -> _id*, _parameterInitializerOptIR -> _parameterInitializerOptIR*, direction -> direction*, typeIR_param -> typeIR_param*}
  -- (let _annotationList' direction' typeIR_arg _id' _parameterInitializerOptIR' = parameterIR_arg)*{parameterIR_arg <- parameterIR_arg*, _annotationList' -> _annotationList'*, _id' -> _id'*, _parameterInitializerOptIR' -> _parameterInitializerOptIR'*, direction' -> direction'*, typeIR_arg -> typeIR_arg*}
  -- (if (direction' = direction))*{direction <- direction*, direction' <- direction'*}

  clause 12 : (constraint, typeIR, typeIR') = $gen_constraints(constraint, typeIR_param*{typeIR_param <- typeIR_param*}, typeIR_arg*{typeIR_arg <- typeIR_arg*})
  -- if typeIR <: controlObjectTypeIR
  -- let control _typeId < _typeArgumentIR*{_typeArgumentIR <- _typeArgumentIR*} >( parameterIR_param*{parameterIR_param <- parameterIR_param*} ) = typeIR as controlObjectTypeIR
  -- if typeIR' <: controlObjectTypeIR
  -- let control _typeId' < _typeArgumentIR'*{_typeArgumentIR' <- _typeArgumentIR'*} >( parameterIR_arg*{parameterIR_arg <- parameterIR_arg*} ) = typeIR' as controlObjectTypeIR
  -- (let _annotationList direction typeIR_param _id _parameterInitializerOptIR = parameterIR_param)*{parameterIR_param <- parameterIR_param*, _annotationList -> _annotationList*, _id -> _id*, _parameterInitializerOptIR -> _parameterInitializerOptIR*, direction -> direction*, typeIR_param -> typeIR_param*}
  -- (let _annotationList' direction' typeIR_arg _id' _parameterInitializerOptIR' = parameterIR_arg)*{parameterIR_arg <- parameterIR_arg*, _annotationList' -> _annotationList'*, _id' -> _id'*, _parameterInitializerOptIR' -> _parameterInitializerOptIR'*, direction' -> direction'*, typeIR_arg -> typeIR_arg*}
  -- (if (direction' = direction))*{direction <- direction*, direction' <- direction'*}

  clause 13 : (constraint, typeIR, typeIR') = $gen_constraints(constraint, typeIR_param*{typeIR_param <- typeIR_param*}, typeIR_arg*{typeIR_arg <- typeIR_arg*})
  -- if typeIR <: packageObjectTypeIR
  -- let package _typeId < _typeArgumentIR*{_typeArgumentIR <- _typeArgumentIR*} >{ typeIR_param*{typeIR_param <- typeIR_param*} } = typeIR as packageObjectTypeIR
  -- if typeIR' <: packageObjectTypeIR
  -- let package _typeId' < _typeArgumentIR'*{_typeArgumentIR' <- _typeArgumentIR'*} >{ typeIR_arg*{typeIR_arg <- typeIR_arg*} } = typeIR' as packageObjectTypeIR

  clause -1 : (constraint, typeIR_param, typeIR_arg) = constraint

def $gen_constraints(constraint, typeIR*, typeIR*) : constraint =

  clause 0 : (constraint, typeIR_param*{typeIR_param <- typeIR_param*}, typeIR_arg*{typeIR_arg <- typeIR_arg*}) = $merge_constraints(constraint, constraint_pair*{constraint_pair <- constraint_pair*})
  -- (let constraint_pair = $gen_constraint(constraint, typeIR_param, typeIR_arg))*{typeIR_arg <- typeIR_arg*, typeIR_param <- typeIR_param*, constraint_pair -> constraint_pair*}

def $merge_constraint(constraint, constraint) : constraint =

  clause 0 : (constraint_pre, constraint_post) = $merge_constraint'(constraint_pre, constraint_post, typeId_pre*{typeId_pre <- typeId_pre*}, { [] })
  -- let { typeId_pre*{typeId_pre <- typeId_pre*} } = $dom_map<typeId, infer>(constraint_pre)
  -- let { typeId_post*{typeId_post <- typeId_post*} } = $dom_map<typeId, infer>(constraint_post)
  -- if $eq_set<typeId>({ typeId_pre*{typeId_pre <- typeId_pre*} }, { typeId_post*{typeId_post <- typeId_post*} })

def $merge_constraint'(constraint, constraint, typeId*, constraint) : constraint =

  clause 0 : (constraint_pre, constraint_post, typeId*{typeId <- typeId*}, constraint) = constraint
  -- if typeId*{typeId <- typeId*} matches []

  clause 1 : (constraint_pre, constraint_post, typeId*{typeId <- typeId*}, constraint) = $merge_constraint'(constraint_pre, constraint_post, typeId_t*{typeId_t <- typeId_t*}, constraint_updated)
  -- if typeId*{typeId <- typeId*} matches _ :: _
  -- let typeId_h :: typeId_t*{typeId_t <- typeId_t*} = typeId*{typeId <- typeId*}
  -- if (?(unknown) = $find_map<typeId, infer>(constraint_pre, typeId_h))
  -- if (?(unknown) = $find_map<typeId, infer>(constraint_post, typeId_h))
  -- let constraint_updated = $update_map<typeId, infer>(constraint, typeId_h, unknown)

  clause 2 : (constraint_pre, constraint_post, typeId*{typeId <- typeId*}, constraint) = $merge_constraint'(constraint_pre, constraint_post, typeId_t*{typeId_t <- typeId_t*}, constraint_updated)
  -- if typeId*{typeId <- typeId*} matches _ :: _
  -- let typeId_h :: typeId_t*{typeId_t <- typeId_t*} = typeId*{typeId <- typeId*}
  -- if (?(unknown) = $find_map<typeId, infer>(constraint_pre, typeId_h))
  -- let infer'?{infer' <- infer'?} = $find_map<typeId, infer>(constraint_post, typeId_h)
  -- if infer'?{infer' <- infer'?} matches (_)
  -- let ?(infer) = infer'?{infer' <- infer'?}
  -- if infer matches `KNOWNAS%`
  -- let knownas typeIR_post = infer
  -- let constraint_updated = $update_map<typeId, infer>(constraint, typeId_h, knownas typeIR_post)

  clause 3 : (constraint_pre, constraint_post, typeId*{typeId <- typeId*}, constraint) = $merge_constraint'(constraint_pre, constraint_post, typeId_t*{typeId_t <- typeId_t*}, constraint_updated)
  -- if typeId*{typeId <- typeId*} matches _ :: _
  -- let typeId_h :: typeId_t*{typeId_t <- typeId_t*} = typeId*{typeId <- typeId*}
  -- let infer'?{infer' <- infer'?} = $find_map<typeId, infer>(constraint_pre, typeId_h)
  -- if infer'?{infer' <- infer'?} matches (_)
  -- let ?(infer) = infer'?{infer' <- infer'?}
  -- if infer matches `KNOWNAS%`
  -- let knownas typeIR_pre = infer
  -- if (?(unknown) = $find_map<typeId, infer>(constraint_post, typeId_h))
  -- let constraint_updated = $update_map<typeId, infer>(constraint, typeId_h, knownas typeIR_pre)

  clause 4 : (constraint_pre, constraint_post, typeId*{typeId <- typeId*}, constraint) = $merge_constraint'(constraint_pre, constraint_post, typeId_t*{typeId_t <- typeId_t*}, constraint_updated)
  -- if typeId*{typeId <- typeId*} matches _ :: _
  -- let typeId_h :: typeId_t*{typeId_t <- typeId_t*} = typeId*{typeId <- typeId*}
  -- let infer'?{infer' <- infer'?} = $find_map<typeId, infer>(constraint_pre, typeId_h)
  -- if infer'?{infer' <- infer'?} matches (_)
  -- let ?(infer) = infer'?{infer' <- infer'?}
  -- if infer matches `KNOWNAS%`
  -- let knownas typeIR_pre = infer
  -- let infer'''?{infer''' <- infer'''?} = $find_map<typeId, infer>(constraint_post, typeId_h)
  -- if infer'''?{infer''' <- infer'''?} matches (_)
  -- let ?(infer'') = infer'''?{infer''' <- infer'''?}
  -- if infer'' matches `KNOWNAS%`
  -- let knownas typeIR_post = infer''
  -- if Cast_impl: typeIR_pre -> typeIR_post holds
  -- let constraint_updated = $update_map<typeId, infer>(constraint, typeId_h, knownas typeIR_post)

  clause 5 : (constraint_pre, constraint_post, typeId*{typeId <- typeId*}, constraint) = $merge_constraint'(constraint_pre, constraint_post, typeId_t*{typeId_t <- typeId_t*}, constraint_updated)
  -- if typeId*{typeId <- typeId*} matches _ :: _
  -- let typeId_h :: typeId_t*{typeId_t <- typeId_t*} = typeId*{typeId <- typeId*}
  -- let infer'?{infer' <- infer'?} = $find_map<typeId, infer>(constraint_pre, typeId_h)
  -- if infer'?{infer' <- infer'?} matches (_)
  -- let ?(infer) = infer'?{infer' <- infer'?}
  -- if infer matches `KNOWNAS%`
  -- let knownas typeIR_pre = infer
  -- let infer'''?{infer''' <- infer'''?} = $find_map<typeId, infer>(constraint_post, typeId_h)
  -- if infer'''?{infer''' <- infer'''?} matches (_)
  -- let ?(infer'') = infer'''?{infer''' <- infer'''?}
  -- if infer'' matches `KNOWNAS%`
  -- let knownas typeIR_post = infer''
  -- if Cast_impl: typeIR_pre -> typeIR_post does not hold
  -- if Cast_impl: typeIR_post -> typeIR_pre holds
  -- let constraint_updated = $update_map<typeId, infer>(constraint, typeId_h, knownas typeIR_pre)

def $merge_constraints(constraint, constraint*) : constraint =

  clause 0 : (constraint_pre, constraint*{constraint <- constraint*}) = constraint_pre
  -- if constraint*{constraint <- constraint*} matches []

  clause 1 : (constraint_pre_0, constraint*{constraint <- constraint*}) = constraint_pre_2
  -- if constraint*{constraint <- constraint*} matches _ :: _
  -- let constraint_post_h :: constraint_post_t*{constraint_post_t <- constraint_post_t*} = constraint*{constraint <- constraint*}
  -- let constraint_pre_1 = $merge_constraint(constraint_pre_0, constraint_post_h)
  -- let constraint_pre_2 = $merge_constraints(constraint_pre_1, constraint_post_t*{constraint_post_t <- constraint_post_t*})

def $resolve_constraint(constraint) : inference =

  clause 0 : ({ typeId : infer*{infer <- infer*, typeId <- typeId*} }) = { typeId : typeIR*{typeIR <- typeIR*, typeId <- typeId*} }
  -- (let infer' = infer)*{infer <- infer*, infer' -> infer'*}
  -- (if infer' matches `KNOWNAS%`)*{infer' <- infer'*}
  -- (let knownas typeIR = infer')*{infer' <- infer'*, typeIR -> typeIR*}

def $resolve_type_alias(typeIR) : (nameIR, typeIR*) =

  clause 0 : (typeIR) = $resolve_type_alias(typeIR_alias)
  -- if typeIR <: typedefTypeIR
  -- let typedef nameIR_alias typeIR_alias = typeIR as typedefTypeIR

  clause 1 : (typeIR) = (nameIR_alias, typeIR_arg*{typeIR_arg <- typeIR_arg*})
  -- if typeIR <: externObjectTypeIR
  -- let extern nameIR_alias < typeIR_arg*{typeIR_arg <- typeIR_arg*} > _externMethodTypeDefEnv = typeIR as externObjectTypeIR

  clause 2 : (typeIR) = (nameIR_alias, typeIR_arg*{typeIR_arg <- typeIR_arg*})
  -- if typeIR <: packageObjectTypeIR
  -- let package nameIR_alias < typeIR_arg*{typeIR_arg <- typeIR_arg*} >{ _typeIR*{_typeIR <- _typeIR*} } = typeIR as packageObjectTypeIR

def $instantiable_extern(cursor, typingContext, instctxt) : bool =

  clause 0 : (cursor, TC, instctxt) = true
  -- if cursor matches `GLOBAL`

  clause 1 : (cursor, TC, instctxt) = true
  -- if cursor matches `BLOCK`

  clause 2 : (cursor, TC, instctxt) = true
  -- if cursor matches `LOCAL`

def $instantiable_parser(cursor, typingContext, instctxt) : bool =

  clause 0 : (cursor, TC, instctxt) = (instctxt = anon)
  -- if cursor matches `GLOBAL`

  clause 1 : (cursor, TC, instctxt) = ((blockKind = parser) \/ (blockKind = package))
  -- if cursor matches `BLOCK`
  -- let blockKind = TC.block.kind

  clause 2 : (cursor, TC, instctxt) = (localKind = parser_state as localKind)
  -- if cursor matches `LOCAL`
  -- let localKind = TC.local.kind

def $instantiable_control(cursor, typingContext, instctxt) : bool =

  clause 0 : (cursor, TC, instctxt) = (instctxt = anon)
  -- if cursor matches `GLOBAL`

  clause 1 : (cursor, TC, instctxt) = ((blockKind = control) \/ (blockKind = package))
  -- if cursor matches `BLOCK`
  -- let blockKind = TC.block.kind

  clause 2 : (cursor, TC, instctxt) = (localKind = control_apply_method as localKind)
  -- if cursor matches `LOCAL`
  -- let localKind = TC.local.kind

def $instantiable_package(cursor, typingContext, instctxt) : bool =

  clause 0 : (cursor, TC, instctxt) = true
  -- if cursor matches `GLOBAL`

  clause 1 : (cursor, TC, instctxt) = (blockKind = package)
  -- if cursor matches `BLOCK`
  -- let blockKind = TC.block.kind

  clause 2 : (cursor, TC, instctxt) = false
  -- if cursor matches `LOCAL`

def $instantiable_table(cursor, typingContext, instctxt) : bool =

  clause 0 : (cursor, TC, instctxt) = false
  -- if cursor matches `GLOBAL`

  clause 1 : (cursor, TC, instctxt) = (blockKind = control)
  -- if cursor matches `BLOCK`
  -- let blockKind = TC.block.kind

  clause 2 : (cursor, TC, instctxt) = false
  -- if cursor matches `LOCAL`

def $instantiable(cursor, typingContext, instctxt, typeIR) : bool =

  clause 0 : (p, TC, instctxt, typeIR) = $instantiable_extern(p, TC, instctxt)
  -- let typeIR_unroll = $unroll_typeIR(typeIR)
  -- if typeIR_unroll <: externObjectTypeIR

  clause 1 : (p, TC, instctxt, typeIR) = $instantiable_parser(p, TC, instctxt)
  -- let typeIR_unroll = $unroll_typeIR(typeIR)
  -- if typeIR_unroll <: parserObjectTypeIR

  clause 2 : (p, TC, instctxt, typeIR) = $instantiable_control(p, TC, instctxt)
  -- let typeIR_unroll = $unroll_typeIR(typeIR)
  -- if typeIR_unroll <: controlObjectTypeIR

  clause 3 : (p, TC, instctxt, typeIR) = $instantiable_package(p, TC, instctxt)
  -- let typeIR_unroll = $unroll_typeIR(typeIR)
  -- if typeIR_unroll <: packageObjectTypeIR

  clause 4 : (p, TC, instctxt, typeIR) = $instantiable_table(p, TC, instctxt)
  -- let typeIR_unroll = $unroll_typeIR(typeIR)
  -- if typeIR_unroll <: tableObjectTypeIR

def $callable_action(cursor, typingContext) : bool =

  clause 0 : (cursor, TC) = false
  -- if cursor matches `GLOBAL`

  clause 1 : (cursor, TC) = false
  -- if cursor matches `BLOCK`

  clause 2 : (cursor, TC) = ((localKind = action as localKind) \/ (localKind = control_apply_method as localKind))
  -- if cursor matches `LOCAL`
  -- let localKind = TC.local.kind

def $callable_definedFunction(cursor, typingContext) : bool =

  clause 0 : (cursor, TC) = false
  -- if cursor matches `GLOBAL`

  clause 1 : (cursor, TC) = ((blockKind = parser) \/ (blockKind = control))
  -- if cursor matches `BLOCK`
  -- let blockKind = TC.block.kind

  clause 2 : (cursor, TC) = ~localKind <: externMethodLocalKind
  -- if cursor matches `LOCAL`
  -- let localKind = TC.local.kind

def $callable_externFunction(cursor, typingContext, nameIR) : bool =

  clause 0 : (cursor, TC, nameIR) = false
  -- if cursor matches `GLOBAL`
  -- if (nameIR = "verify")

  clause 1 : (cursor, TC, nameIR) = true
  -- if cursor matches `GLOBAL`
  -- if (nameIR =/= "verify")

  clause 2 : (cursor, TC, nameIR) = (blockKind = parser)
  -- if cursor matches `BLOCK`
  -- if (nameIR = "verify")
  -- let blockKind = TC.block.kind

  clause 3 : (cursor, TC, nameIR) = ((blockKind = parser) \/ (blockKind = control))
  -- if cursor matches `BLOCK`
  -- if (nameIR =/= "verify")
  -- let blockKind = TC.block.kind

  clause 4 : (cursor, TC, nameIR) = (localKind = parser_state as localKind)
  -- if cursor matches `LOCAL`
  -- if (nameIR = "verify")
  -- let localKind = TC.local.kind

  clause 5 : (cursor, TC, nameIR) = true
  -- if cursor matches `LOCAL`
  -- if (nameIR =/= "verify")

def $callable_builtinMethod(cursor, typingContext) : bool =

  clause 0 : (cursor, TC) = true
  -- if cursor matches `GLOBAL`

  clause 1 : (cursor, TC) = true
  -- if cursor matches `BLOCK`

  clause 2 : (cursor, TC) = true
  -- if cursor matches `LOCAL`

def $callable_externMethod(cursor, typingContext) : bool =

  clause 0 : (cursor, TC) = false
  -- if cursor matches `GLOBAL`

  clause 1 : (cursor, TC) = ((blockKind = parser) \/ (blockKind = control))
  -- if cursor matches `BLOCK`
  -- let blockKind = TC.block.kind

  clause 2 : (cursor, TC) = true
  -- if cursor matches `LOCAL`

def $callable_externAbstractMethod(cursor, typingContext) : bool =

  clause 0 : (cursor, TC) = false
  -- if cursor matches `GLOBAL`

  clause 1 : (cursor, TC) = ((blockKind = parser) \/ (blockKind = control))
  -- if cursor matches `BLOCK`
  -- let blockKind = TC.block.kind

  clause 2 : (cursor, TC) = true
  -- if cursor matches `LOCAL`

def $callable_parserApplyMethod(cursor, typingContext) : bool =

  clause 0 : (cursor, TC) = false
  -- if cursor matches `GLOBAL`

  clause 1 : (cursor, TC) = false
  -- if cursor matches `BLOCK`

  clause 2 : (cursor, TC) = (localKind = parser_state as localKind)
  -- if cursor matches `LOCAL`
  -- let localKind = TC.local.kind

def $callable_controlApplyMethod(cursor, typingContext) : bool =

  clause 0 : (cursor, TC) = false
  -- if cursor matches `GLOBAL`

  clause 1 : (cursor, TC) = false
  -- if cursor matches `BLOCK`

  clause 2 : (cursor, TC) = (localKind = control_apply_method as localKind)
  -- if cursor matches `LOCAL`
  -- let localKind = TC.local.kind

def $callable_tableApplyMethod(cursor, typingContext) : bool =

  clause 0 : (cursor, TC) = false
  -- if cursor matches `GLOBAL`

  clause 1 : (cursor, TC) = false
  -- if cursor matches `BLOCK`

  clause 2 : (cursor, TC) = ((localKind = control_apply_method as localKind) \/ (localKind = table_apply_method as localKind))
  -- if cursor matches `LOCAL`
  -- let localKind = TC.local.kind

def $callableId_IR(nameIR, parameterListIR) : callableId =

  clause 0 : (nameIR, parameterIR*{parameterIR <- parameterIR*}) = nameIR ( id*{id <- id*} )
  -- (let _annotationList _direction _typeIR id _parameterInitializerOptIR = parameterIR)*{parameterIR <- parameterIR*, _annotationList -> _annotationList*, _direction -> _direction*, _parameterInitializerOptIR -> _parameterInitializerOptIR*, _typeIR -> _typeIR*, id -> id*}

syntax storageReference = 
   | ` nameIR hint(print %0)
   | . nameIR
   | storageReference . nameIR
   | storageReference [ value ]
   | storageReference [ value : value ]

syntax actionDef = 
   | action nameIR ( parameterListIR ) blockStatementIR

syntax definedFunctionDef = 
   | function nameIR < typeParameterListIR >( parameterListIR ) blockStatementIR

syntax externFunctionDef = 
   | extern_function nameIR < typeParameterListIR >( parameterListIR )

syntax functionDef = 
   | function nameIR < typeParameterListIR >( parameterListIR ) blockStatementIR
   | extern_function nameIR < typeParameterListIR >( parameterListIR )

syntax externMethodDef = 
   | extern_method nameIR < typeParameterListIR >( parameterListIR ) blockStatementIR?
   | extern_methodabstract nameIR < typeParameterListIR >( parameterListIR )

syntax parserApplyMethodDef = 
   | parser_apply( parameterListIR ){ parserLocalDeclarationListIR ; stateEnv }

syntax controlApplyMethodDef = 
   | control_apply( parameterListIR ){ controlLocalDeclarationListIR ; actionDefEnv ; controlBodyIR }

syntax tableApplyMethodDef = 
   | table_apply{ tablePropertyListIR }

syntax methodDef = 
   | extern_method nameIR < typeParameterListIR >( parameterListIR ) blockStatementIR?
   | extern_methodabstract nameIR < typeParameterListIR >( parameterListIR )
   | parser_apply( parameterListIR ){ parserLocalDeclarationListIR ; stateEnv }
   | control_apply( parameterListIR ){ controlLocalDeclarationListIR ; actionDefEnv ; controlBodyIR }
   | table_apply{ tablePropertyListIR }

syntax callableDef = 
   | action nameIR ( parameterListIR ) blockStatementIR
   | function nameIR < typeParameterListIR >( parameterListIR ) blockStatementIR
   | extern_function nameIR < typeParameterListIR >( parameterListIR )
   | extern_method nameIR < typeParameterListIR >( parameterListIR ) blockStatementIR?
   | extern_methodabstract nameIR < typeParameterListIR >( parameterListIR )
   | parser_apply( parameterListIR ){ parserLocalDeclarationListIR ; stateEnv }
   | control_apply( parameterListIR ){ controlLocalDeclarationListIR ; actionDefEnv ; controlBodyIR }
   | table_apply{ tablePropertyListIR }

def $parameterListIR_of_callableDef(callableDef) : parameterIR* =

  clause 0 : (callableDef) = $parameterListIR_of_actionDef(actionDef)
  -- if callableDef <: actionDef
  -- let actionDef = callableDef as actionDef

  clause 1 : (callableDef) = $parameterListIR_of_functionDef(functionDef)
  -- if callableDef <: functionDef
  -- let functionDef = callableDef as functionDef

  clause 2 : (callableDef) = $parameterListIR_of_methodDef(methodDef)
  -- if callableDef <: methodDef
  -- let methodDef = callableDef as methodDef

def $parameterListIR_of_actionDef(actionDef) : parameterIR* =

  clause 0 : (action _nameIR ( parameterListIR ) _blockStatementIR) = parameterListIR

def $parameterListIR_of_functionDef(functionDef) : parameterIR* =

  clause 0 : (functionDef) = $parameterListIR_of_definedFunctionDef(definedFunctionDef)
  -- if functionDef <: definedFunctionDef
  -- let definedFunctionDef = functionDef as definedFunctionDef

  clause 1 : (functionDef) = $parameterListIR_of_externFunctionDef(externFunctionDef)
  -- if functionDef <: externFunctionDef
  -- let externFunctionDef = functionDef as externFunctionDef

def $parameterListIR_of_definedFunctionDef(definedFunctionDef) : parameterIR* =

  clause 0 : (function _nameIR < _typeParameterListIR >( parameterListIR ) _blockStatementIR) = parameterListIR

def $parameterListIR_of_externFunctionDef(externFunctionDef) : parameterIR* =

  clause 0 : (extern_function _nameIR < _typeParameterListIR >( parameterListIR )) = parameterListIR

def $parameterListIR_of_methodDef(methodDef) : parameterIR* =

  clause 0 : (methodDef) = $parameterListIR_of_externMethodDef(externMethodDef)
  -- if methodDef <: externMethodDef
  -- let externMethodDef = methodDef as externMethodDef

  clause 1 : (methodDef) = $parameterListIR_of_parserApplyMethodDef(parserApplyMethodDef)
  -- if methodDef <: parserApplyMethodDef
  -- let parserApplyMethodDef = methodDef as parserApplyMethodDef

  clause 2 : (methodDef) = $parameterListIR_of_controlApplyMethodDef(controlApplyMethodDef)
  -- if methodDef <: controlApplyMethodDef
  -- let controlApplyMethodDef = methodDef as controlApplyMethodDef

  clause 3 : (methodDef) = $parameterListIR_of_tableApplyMethodDef(tableApplyMethodDef)
  -- if methodDef <: tableApplyMethodDef
  -- let tableApplyMethodDef = methodDef as tableApplyMethodDef

def $parameterListIR_of_externMethodDef(externMethodDef) : parameterIR* =

  clause 0 : (externMethodDef) = parameterListIR
  -- if externMethodDef matches `EXTERN_METHOD%<%>(%)%`
  -- let extern_method _nameIR < _typeParameterListIR >( parameterListIR ) _blockStatementIR?{_blockStatementIR <- _blockStatementIR?} = externMethodDef

def $parameterListIR_of_parserApplyMethodDef(parserApplyMethodDef) : parameterIR* =

  clause 0 : (parser_apply( parameterListIR ){ _parserLocalDeclarationListIR ; _stateEnv }) = parameterListIR

def $parameterListIR_of_controlApplyMethodDef(controlApplyMethodDef) : parameterIR* =

  clause 0 : (control_apply( parameterListIR ){ _controlLocalDeclarationListIR ; _actionDefEnv ; _controlBodyIR }) = parameterListIR

def $parameterListIR_of_tableApplyMethodDef(tableApplyMethodDef) : parameterIR* =

  clause 0 : (table_apply{ _tablePropertyListIR }) = []

syntax actionCallee = 
   | action cursor . nameIR ( parameterListIR # id* ) blockStatementIR

syntax definedFunctionCallee = 
   | function nameIR < typeParameterListIR >( parameterListIR # id* ) blockStatementIR

syntax externFunctionCallee = 
   | extern_function nameIR < typeParameterListIR >( parameterListIR # id* # id* )

syntax functionCallee = 
   | function nameIR < typeParameterListIR >( parameterListIR # id* ) blockStatementIR
   | extern_function nameIR < typeParameterListIR >( parameterListIR # id* # id* )

syntax builtinMethodCallee = 
   | builtin_method storageReference . nameIR < typeArgumentListIR >( parameterListIR )

syntax externMethodCallee = 
   | extern_method objectId . nameIR < typeParameterListIR >( parameterListIR # id* # id* ){ theta ; frame ; blockStatementIR? }

syntax parserApplyMethodCallee = 
   | parser objectId .apply( parameterListIR # id* ){ theta ; frame ; parserLocalDeclarationListIR ; stateEnv }

syntax controlApplyMethodCallee = 
   | control objectId .apply( parameterListIR # id* ){ theta ; frame ; controlLocalDeclarationListIR ; actionDefEnv ; controlBodyIR }

syntax tableApplyMethodCallee = 
   | table objectId .apply{ frame ; tableObjectProperty }

syntax methodCallee = 
   | builtin_method storageReference . nameIR < typeArgumentListIR >( parameterListIR )
   | extern_method objectId . nameIR < typeParameterListIR >( parameterListIR # id* # id* ){ theta ; frame ; blockStatementIR? }
   | parser objectId .apply( parameterListIR # id* ){ theta ; frame ; parserLocalDeclarationListIR ; stateEnv }
   | control objectId .apply( parameterListIR # id* ){ theta ; frame ; controlLocalDeclarationListIR ; actionDefEnv ; controlBodyIR }
   | table objectId .apply{ frame ; tableObjectProperty }

syntax callee = 
   | action cursor . nameIR ( parameterListIR # id* ) blockStatementIR
   | function nameIR < typeParameterListIR >( parameterListIR # id* ) blockStatementIR
   | extern_function nameIR < typeParameterListIR >( parameterListIR # id* # id* )
   | builtin_method storageReference . nameIR < typeArgumentListIR >( parameterListIR )
   | extern_method objectId . nameIR < typeParameterListIR >( parameterListIR # id* # id* ){ theta ; frame ; blockStatementIR? }
   | parser objectId .apply( parameterListIR # id* ){ theta ; frame ; parserLocalDeclarationListIR ; stateEnv }
   | control objectId .apply( parameterListIR # id* ){ theta ; frame ; controlLocalDeclarationListIR ; actionDefEnv ; controlBodyIR }
   | table objectId .apply{ frame ; tableObjectProperty }

syntax externObjectConstructorDef = 
   | extern nameIR < typeParameterListIR >( constructorParameterListIR ){ externMethodPrototypeListIR }

syntax parserObjectConstructorDef = 
   | parser< typeParameterListIR >( parameterListIR )( constructorParameterListIR ){ parserLocalDeclarationListIR parserStateListIR }

syntax controlObjectConstructorDef = 
   | control< typeParameterListIR >( parameterListIR )( constructorParameterListIR ){ controlLocalDeclarationListIR apply controlBodyIR }

syntax packageObjectConstructorDef = 
   | package< typeParameterListIR >( constructorParameterListIR )

syntax constructorDef = 
   | extern nameIR < typeParameterListIR >( constructorParameterListIR ){ externMethodPrototypeListIR }
   | parser< typeParameterListIR >( parameterListIR )( constructorParameterListIR ){ parserLocalDeclarationListIR parserStateListIR }
   | control< typeParameterListIR >( parameterListIR )( constructorParameterListIR ){ controlLocalDeclarationListIR apply controlBodyIR }
   | package< typeParameterListIR >( constructorParameterListIR )

def $parameterListIR_of_constructorDef(constructorDef) : parameterIR* =

  clause 0 : (constructorDef) = constructorParameterListIR
  -- if constructorDef <: externObjectConstructorDef
  -- let extern _nameIR < _typeParameterListIR >( constructorParameterListIR ){ _externMethodPrototypeListIR } = constructorDef as externObjectConstructorDef

  clause 1 : (constructorDef) = constructorParameterListIR
  -- if constructorDef <: parserObjectConstructorDef
  -- let parser< _typeParameterListIR >( _parameterListIR )( constructorParameterListIR ){ _parserLocalDeclarationListIR _parserStateListIR } = constructorDef as parserObjectConstructorDef

  clause 2 : (constructorDef) = constructorParameterListIR
  -- if constructorDef <: controlObjectConstructorDef
  -- let control< _typeParameterListIR >( _parameterListIR )( constructorParameterListIR ){ _controlLocalDeclarationListIR apply _controlBodyIR } = constructorDef as controlObjectConstructorDef

  clause 3 : (constructorDef) = constructorParameterListIR
  -- if constructorDef <: packageObjectConstructorDef
  -- let package< _typeParameterListIR >( constructorParameterListIR ) = constructorDef as packageObjectConstructorDef

extern syntax objectState

syntax externMethodDefEnv = map<callableId, externMethodDef>

extern def $init_objectState(nameIR, typeIR*, value*) : objectState

syntax externObject = 
   | extern typeId < theta >{ objectState frame externMethodDefEnv }

syntax parserObject = 
   | parser< theta >( parameterListIR ){ frame parserLocalDeclarationListIR stateEnv }

syntax actionDefEnv = map<callableId, actionDef>

syntax controlObject = 
   | control< theta >( parameterListIR ){ frame controlLocalDeclarationListIR actionDefEnv controlBodyIR }

syntax packageObject = 
   | package< theta >{ frame }

syntax tableObjectProperty = {keys tableKeysPropertyIR, actions tableActionsPropertyIR, default_action tableDefaultActionPropertyIR, entries tableEntriesPropertyIR, customs tableCustomPropertyIR*}

syntax tableObject = 
   | table typeId { frame tableObjectProperty }

syntax valueSetObject = 
   | value_set{ value* ( nat )}

syntax object = 
   | extern typeId < theta >{ objectState frame externMethodDefEnv }
   | parser< theta >( parameterListIR ){ frame parserLocalDeclarationListIR stateEnv }
   | control< theta >( parameterListIR ){ frame controlLocalDeclarationListIR actionDefEnv controlBodyIR }
   | package< theta >{ frame }
   | table typeId { frame tableObjectProperty }
   | value_set{ value* ( nat )}

syntax tableEntryPriorityInterface = int?

syntax tableKeyValueInterface = 
   | `bin text
   | `hex text
   | `dec text
   | text `slash nat

syntax tableKeyInterface = (nameIR, tableKeyValueInterface)

syntax tableKeysetInterface = tableKeyInterface*

syntax tableActionArgumentInterface = (nameIR, int)

syntax tableActionInterface = (nameIR, tableActionArgumentInterface*)

def $text_of_number_tableKeyValueInterface(tableKeyValueInterface) : text? =

  clause 0 : (tableKeyValueInterface) = ?("0b" ++ t)
  -- if tableKeyValueInterface matches ``BIN%`
  -- let `bin t = tableKeyValueInterface

  clause 1 : (tableKeyValueInterface) = ?("0x" ++ t)
  -- if tableKeyValueInterface matches ``HEX%`
  -- let `hex t = tableKeyValueInterface

  clause 2 : (tableKeyValueInterface) = ?(t)
  -- if tableKeyValueInterface matches ``DEC%`
  -- let `dec t = tableKeyValueInterface

  clause 3 : (tableKeyValueInterface) = ?()
  -- if tableKeyValueInterface matches `%`SLASH%`
  -- let _text `slash _nat = tableKeyValueInterface

def $tableObject_create_entry_priority(tableEntryPriorityInterface) : tableEntryPriorityOptIR =

  clause 0 : (int?{int <- int?}) = ?()
  -- if int?{int <- int?} matches ()

  clause 1 : (tableEntryPriorityInterface) = ?(priority= d n_priority as int :)
