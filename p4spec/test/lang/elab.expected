def $callableId_of_externMethodPrototype(externMethodPrototype) : callableId =

  clause 0 : (_annotationList _typeOrVoid name _typeParameterListOpt `( parameterList `) ';') = $callableId(name, parameterList)

  clause 1 : (_annotationList ABSTRACT _typeOrVoid name _typeParameterListOpt `( parameterList `) ';') = $callableId(name, parameterList)

def $type_of_externMethodPrototypeIR(externMethodPrototypeIR) : externMethodTypeDefIR =

  clause 0 : (_annotationList typeIR_ret nameIR `< typeParameterListIR_expl ',' typeParameterListIR_impl `> `( parameterIR*{parameterIR <- parameterIR*} `) ';') = externMethodTypeDefIR
  -- if (externMethodTypeDefIR = EXTERN_METHOD nameIR `< typeParameterListIR_expl ',' typeParameterListIR_impl `> `( parameterIR*{parameterIR <- parameterIR*} `) ':' typeIR_ret)

  clause 1 : (_annotationList ABSTRACT typeIR_ret nameIR `< typeParameterListIR_expl ',' typeParameterListIR_impl `> `( parameterIR*{parameterIR <- parameterIR*} `) ';') = externMethodTypeDefIR
  -- if (externMethodTypeDefIR = EXTERN_METHOD ABSTRACT nameIR `< typeParameterListIR_expl ',' typeParameterListIR_impl `> `( parameterIR*{parameterIR <- parameterIR*} `) ':' typeIR_ret)

def $constructorId_of_externConstructorPrototype(externConstructorPrototype) : constructorId =

  clause 0 : (_annotationList typeIdentifier `( parameterList `) ';') = $callableId(typeIdentifier as name, parameterList)

