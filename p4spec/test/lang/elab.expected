  clause 2 : (switchLabel*{switchLabel <- switchLabel*}) = $check_switchLabel_default(switchLabel_t*{switchLabel_t <- switchLabel_t*})
  -- if switchLabel*{switchLabel <- switchLabel*} matches _ :: _
  -- let switchLabel_h :: switchLabel_t*{switchLabel_t <- switchLabel_t*} = switchLabel*{switchLabel <- switchLabel*}
  -- if (switchLabel_h =/= default)

