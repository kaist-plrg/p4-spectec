def $subst_typeIR(theta, typeIR) : typeIR =

  clause 0 : (set<pair<typeId, typeIR>>, typeIR) = typeIR
  -- if (set<pair<typeId, typeIR>> = { [] })

  clause -1 : (theta, typeIR) = $subst_typeIR'(theta, typeIR)

def $subst_typeIR'(theta, typeIR) : typeIR =

  clause 0 : (theta, typeIR) = baseTypeIR as typeIR
  -- if typeIR <: baseTypeIR
  -- let baseTypeIR = typeIR as baseTypeIR

  clause 1 : (theta, typeIR') = typeIR
  -- if typeIR' <: nameTypeIR
