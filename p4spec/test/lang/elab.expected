relation TypeArgument_ok: cursor typingContext |- typeArgument : typeArgumentIR '#' typeId*

  rulegroup 

    rule type: p TC |- type as typeArgument : typeIR '#' typeId_impl*{typeId_impl <- typeId_impl*}
    -- Type_ok: p TC |- type as typeOrVoid : typeIR '#' typeId_impl*{typeId_impl <- typeId_impl*}

    rule void: p TC |- VOID as typeArgument : VOID as typeIR '#' []

    rule dontcare: p TC |- '_' as typeArgument : _NAME typeId_impl as typeIR '#' [typeId_impl]
    -- if (typeId_impl = $fresh_typeId)

    rule nonTypeName: p TC |- nonTypeName as typeArgument : _NAME typeId as typeIR '#' []
    -- if (typeId = $name(nonTypeName as name))
    -- if Type_wf: $bound(p, TC) |- _NAME typeId as typeIR holds

relation TypeArguments_ok: cursor typingContext |- typeArgument* : typeArgumentListIR '#' typeId*

  rulegroup 

    rule nil: p TC |- [] : [] '#' []

    rule cons: p TC |- typeArgument_h :: typeArgument_t*{typeArgument_t <- typeArgument_t*} : typeArgumentIR_h :: typeArgumentIR_t*{typeArgumentIR_t <- typeArgumentIR_t*} '#' typeId_impl*{typeId_impl <- typeId_impl*}
    -- TypeArgument_ok: p TC |- typeArgument_h : typeArgumentIR_h '#' typeId_impl_h*{typeId_impl_h <- typeId_impl_h*}
    -- TypeArguments_ok: p TC |- typeArgument_t*{typeArgument_t <- typeArgument_t*} : typeArgumentIR_t*{typeArgumentIR_t <- typeArgumentIR_t*} '#' typeId_impl_t*{typeId_impl_t <- typeId_impl_t*}
    -- if (typeId_impl*{typeId_impl <- typeId_impl*} = typeId_impl_h*{typeId_impl_h <- typeId_impl_h*} ++ typeId_impl_t*{typeId_impl_t <- typeId_impl_t*})

relation TypeArgumentList_ok: cursor typingContext |- typeArgumentList : typeArgumentListIR '#' typeId*

  rulegroup 

    rule : p TC |- typeArgumentList : typeArgumentIR*{typeArgumentIR <- typeArgumentIR*} '#' typeId_impl*{typeId_impl <- typeId_impl*}
    -- if (typeArgument*{typeArgument <- typeArgument*} = $flatten_typeArgumentList(typeArgumentList))
    -- TypeArguments_ok: p TC |- typeArgument*{typeArgument <- typeArgument*} : typeArgumentIR*{typeArgumentIR <- typeArgumentIR*} '#' typeId_impl*{typeId_impl <- typeId_impl*}

syntax castResult = 
   | OK typeIR* (from castResult) 
   | FAIL (from castResult) 

relation Cast_expl: typeIR -> typeIR : castResult

  rulegroup 

    rule equals: typeIR_a -> typeIR_b : OK [typeIR_b]
    -- if (typeIR_a_unroll = $unroll_typeIR(typeIR_a))
    -- if (typeIR_b_unroll = $unroll_typeIR(typeIR_b))
    -- if Type_alpha: typeIR_a_unroll ~~ typeIR_b_unroll holds

    rule not-equals: typeIR_a -> typeIR_b : castResult
    -- if (typeIR_a_unroll = $unroll_typeIR(typeIR_a))
    -- if (typeIR_b_unroll = $unroll_typeIR(typeIR_b))
    -- if Type_alpha: typeIR_a_unroll ~~ typeIR_b_unroll does not hold
    -- Cast_expl_neq: typeIR_a_unroll -> typeIR_b_unroll : castResult

relation Cast_expl_neq: typeIR -> typeIR : castResult

  rulegroup boolean-fixBit

    rule boolean-fixBit: BOOL as typeIR -> BIT `< 1 `> as typeIR : OK [BIT `< 1 `> as typeIR]

  rulegroup arbitraryInt

    rule boolean: INT as typeIR -> BOOL as typeIR : OK [BOOL as typeIR]

    rule fixInt: INT as typeIR -> INT `< w `> as typeIR : OK [INT `< w `> as typeIR]

    rule fixBit: INT as typeIR -> BIT `< w `> as typeIR : OK [BIT `< w `> as typeIR]

  rulegroup fixInt

    rule arbitraryInt: INT `< _nat `> as typeIR -> INT as typeIR : OK [INT as typeIR]

    rule fixInt: INT `< w_a `> as typeIR -> INT `< w_b `> as typeIR : OK [INT `< w_b `> as typeIR]

    rule fixBit: INT `< w `> as typeIR -> BIT `< w `> as typeIR : OK [BIT `< w `> as typeIR]

  rulegroup fixBit

    rule boolean: BIT `< 1 `> as typeIR -> BOOL as typeIR : OK [BOOL as typeIR]

    rule arbitraryInt: BIT `< _nat `> as typeIR -> INT as typeIR : OK [INT as typeIR]

    rule fixInt: BIT `< w `> as typeIR -> INT `< w `> as typeIR : OK [INT `< w `> as typeIR]

    rule fixBit: BIT `< w_a `> as typeIR -> BIT `< w_b `> as typeIR : OK [BIT `< w_b `> as typeIR]

  rulegroup newTypeIR

    rule left: TYPE _typeId typeIR_a as typeIR -> typeIR_b : OK typeIR_a :: typeIR_cast*{typeIR_cast <- typeIR_cast*}
    -- Cast_impl: typeIR_a -> typeIR_b : OK typeIR_cast*{typeIR_cast <- typeIR_cast*}

    rule right: typeIR_a -> newTypeIR as typeIR : OK typeIR_cast*{typeIR_cast <- typeIR_cast*} ++ [newTypeIR] as typeIR*
    -- if (TYPE _typeId typeIR_b = newTypeIR)
    -- Cast_impl: typeIR_a -> typeIR_b : OK typeIR_cast*{typeIR_cast <- typeIR_cast*}

  rulegroup enumTypeIR-serializable

    rule left: ENUM _typeId `< typeIR_a `> `{ _valueFieldIR*{_valueFieldIR <- _valueFieldIR*} `} as typeIR -> typeIR_b : OK typeIR_a :: typeIR_cast*{typeIR_cast <- typeIR_cast*}
    -- Cast_impl: typeIR_a -> typeIR_b : OK typeIR_cast*{typeIR_cast <- typeIR_cast*}

    rule right: typeIR_a -> serializableEnumTypeIR as typeIR : OK typeIR_cast*{typeIR_cast <- typeIR_cast*} ++ [serializableEnumTypeIR] as typeIR*
    -- if (ENUM _typeId `< typeIR_b `> `{ _valueFieldIR*{_valueFieldIR <- _valueFieldIR*} `} = serializableEnumTypeIR)
    -- Cast_impl: typeIR_a -> typeIR_b : OK typeIR_cast*{typeIR_cast <- typeIR_cast*}

  rulegroup defaultTypeIR

    rule defaultTypeIR: DEFAULT as typeIR -> typeIR_b : OK [typeIR_b]
    -- if $is_defaultable_typeIR(typeIR_b)

  rulegroup invalidHeaderTypeIR

    rule headerTypeIR: HEADER_INVALID as typeIR -> headerTypeIR as typeIR : OK [headerTypeIR] as typeIR*

    rule headerUnionTypeIR: HEADER_INVALID as typeIR -> headerUnionTypeIR as typeIR : OK [headerUnionTypeIR] as typeIR*

  rulegroup sequenceTypeIR-non-default

    rule listTypeIR: SEQ `< typeIR_a*{typeIR_a <- typeIR_a*} `> as typeIR -> listTypeIR as typeIR : OK typeIR_cast_agg*{typeIR_cast_agg <- typeIR_cast_agg*}
    -- if (LIST `< typeIR_b `> = listTypeIR)
    -- (Cast_expl: typeIR_a -> typeIR_b : OK typeIR_cast*{typeIR_cast <- typeIR_cast*})*{typeIR_a <- typeIR_a*, typeIR_cast* <- typeIR_cast**}
    -- if (typeIR_cast_agg*{typeIR_cast_agg <- typeIR_cast_agg*} = $chain_casts_sequenceTypeIR(typeIR_a*{typeIR_a <- typeIR_a*}, typeIR_cast*{typeIR_cast <- typeIR_cast*}*{typeIR_cast* <- typeIR_cast**}, listTypeIR as typeIR))

    rule tupleTypeIR: SEQ `< typeIR_a*{typeIR_a <- typeIR_a*} `> as typeIR -> tupleTypeIR as typeIR : OK typeIR_cast_agg*{typeIR_cast_agg <- typeIR_cast_agg*}
    -- if (TUPLE `< typeIR_b*{typeIR_b <- typeIR_b*} `> = tupleTypeIR)
    -- (Cast_expl: typeIR_a -> typeIR_b : OK typeIR_cast*{typeIR_cast <- typeIR_cast*})*{typeIR_a <- typeIR_a*, typeIR_b <- typeIR_b*, typeIR_cast* <- typeIR_cast**}
    -- if (typeIR_cast_agg*{typeIR_cast_agg <- typeIR_cast_agg*} = $chain_casts_sequenceTypeIR(typeIR_a*{typeIR_a <- typeIR_a*}, typeIR_cast*{typeIR_cast <- typeIR_cast*}*{typeIR_cast* <- typeIR_cast**}, tupleTypeIR as typeIR))

    rule arrayTypeIR: SEQ `< typeIR_a*{typeIR_a <- typeIR_a*} `> as typeIR -> arrayTypeIR as typeIR : OK typeIR_cast_agg*{typeIR_cast_agg <- typeIR_cast_agg*}
    -- if (ARRAY typeIR_b `[ n_size `] = arrayTypeIR)
    -- if (|typeIR_a*{typeIR_a <- typeIR_a*}| = n_size)
    -- (Cast_expl: typeIR_a -> typeIR_b : OK typeIR_cast*{typeIR_cast <- typeIR_cast*})*{typeIR_a <- typeIR_a*, typeIR_cast* <- typeIR_cast**}
    -- if (typeIR_cast_agg*{typeIR_cast_agg <- typeIR_cast_agg*} = $chain_casts_sequenceTypeIR(typeIR_a*{typeIR_a <- typeIR_a*}, typeIR_cast*{typeIR_cast <- typeIR_cast*}*{typeIR_cast* <- typeIR_cast**}, arrayTypeIR as typeIR))

    rule headerStackTypeIR: SEQ `< typeIR_a*{typeIR_a <- typeIR_a*} `> as typeIR -> headerStackTypeIR as typeIR : OK typeIR_cast_agg*{typeIR_cast_agg <- typeIR_cast_agg*}
    -- if (HEADER_STACK typeIR_b `[ n_size `] = headerStackTypeIR)
    -- if (|typeIR_a*{typeIR_a <- typeIR_a*}| = n_size)
    -- (Cast_expl: typeIR_a -> typeIR_b : OK typeIR_cast*{typeIR_cast <- typeIR_cast*})*{typeIR_a <- typeIR_a*, typeIR_cast* <- typeIR_cast**}
    -- if (typeIR_cast_agg*{typeIR_cast_agg <- typeIR_cast_agg*} = $chain_casts_sequenceTypeIR(typeIR_a*{typeIR_a <- typeIR_a*}, typeIR_cast*{typeIR_cast <- typeIR_cast*}*{typeIR_cast* <- typeIR_cast**}, headerStackTypeIR as typeIR))

    rule structTypeIR: SEQ `< typeIR_a*{typeIR_a <- typeIR_a*} `> as typeIR -> structTypeIR as typeIR : OK typeIR_cast_agg*{typeIR_cast_agg <- typeIR_cast_agg*}
    -- if (STRUCT _typeId `< _typeArgumentIR*{_typeArgumentIR <- _typeArgumentIR*} `> `{ _annotationList typeIR_field_b _nameIR ';'*{_annotationList <- _annotationList*, _nameIR <- _nameIR*, typeIR_field_b <- typeIR_field_b*} `} = structTypeIR)
    -- (Cast_expl: typeIR_a -> typeIR_field_b : OK typeIR_cast*{typeIR_cast <- typeIR_cast*})*{typeIR_a <- typeIR_a*, typeIR_cast* <- typeIR_cast**, typeIR_field_b <- typeIR_field_b*}
    -- if (typeIR_cast_agg*{typeIR_cast_agg <- typeIR_cast_agg*} = $chain_casts_sequenceTypeIR(typeIR_a*{typeIR_a <- typeIR_a*}, typeIR_cast*{typeIR_cast <- typeIR_cast*}*{typeIR_cast* <- typeIR_cast**}, structTypeIR as typeIR))

    rule headerTypeIR: SEQ `< typeIR_a*{typeIR_a <- typeIR_a*} `> as typeIR -> headerTypeIR as typeIR : OK typeIR_cast_agg*{typeIR_cast_agg <- typeIR_cast_agg*}
    -- if (HEADER _typeId `< _typeArgumentIR*{_typeArgumentIR <- _typeArgumentIR*} `> `{ _annotationList typeIR_field_b _nameIR ';'*{_annotationList <- _annotationList*, _nameIR <- _nameIR*, typeIR_field_b <- typeIR_field_b*} `} = headerTypeIR)
    -- (Cast_expl: typeIR_a -> typeIR_field_b : OK typeIR_cast*{typeIR_cast <- typeIR_cast*})*{typeIR_a <- typeIR_a*, typeIR_cast* <- typeIR_cast**, typeIR_field_b <- typeIR_field_b*}
    -- if (typeIR_cast_agg*{typeIR_cast_agg <- typeIR_cast_agg*} = $chain_casts_sequenceTypeIR(typeIR_a*{typeIR_a <- typeIR_a*}, typeIR_cast*{typeIR_cast <- typeIR_cast*}*{typeIR_cast* <- typeIR_cast**}, headerTypeIR as typeIR))

  rulegroup sequenceTypeIR-default

    rule tupleTypeIR: SEQ `< typeIR_a*{typeIR_a <- typeIR_a*} ',' '...' `> as typeIR -> tupleTypeIR as typeIR : OK typeIR_cast_agg*{typeIR_cast_agg <- typeIR_cast_agg*}
    -- if (TUPLE `< typeIR_b*{typeIR_b <- typeIR_b*} `> = tupleTypeIR)
