tbl def $compat_table_exact_optional_key(typeIR) : bool =
  row 0 :
    (signature) bool as typeIR
    (typeIR) -> true
    -- if typeIR <: boolTypeIR
    -- let boolTypeIR = typeIR as boolTypeIR
    -- if (boolTypeIR = bool)
  row 1 :
    (signature) error as typeIR
    (typeIR) -> true
    -- if typeIR <: errorTypeIR
    -- let errorTypeIR = typeIR as errorTypeIR
    -- if (errorTypeIR = error)
  row 2 :
    (signature) integerTypeIR as typeIR
    (typeIR) -> true
    -- if typeIR <: integerTypeIR
    -- let integerTypeIR = typeIR as integerTypeIR
  row 3 :
    (signature) typedef _typeId typeIR as typeIR
    (typeIR') -> $compat_table_exact_optional_key(typeIR)
    -- if typeIR' <: typedefTypeIR
    -- let typedef _typeId typeIR = typeIR' as typedefTypeIR
  row 4 :
    (signature) type _typeId typeIR as typeIR
    (typeIR') -> $compat_table_exact_optional_key(typeIR)
    -- if typeIR' <: newTypeIR
    -- let type _typeId typeIR = typeIR' as newTypeIR
  row 5 :
    (signature) enum _typeId { _nameIR*{_nameIR <- _nameIR*} } as typeIR
    (typeIR) -> true
    -- if typeIR <: simpleEnumTypeIR
    -- let enum _typeId { _nameIR*{_nameIR <- _nameIR*} } = typeIR as simpleEnumTypeIR
  row 6 :
    (signature) enum _typeId < typeIR >{ _valueFieldIR*{_valueFieldIR <- _valueFieldIR*} } as typeIR
    (typeIR') -> $compat_table_exact_optional_key(typeIR)
    -- if typeIR' <: serializableEnumTypeIR
    -- let enum _typeId < typeIR >{ _valueFieldIR*{_valueFieldIR <- _valueFieldIR*} } = typeIR' as serializableEnumTypeIR
  row 7 :
    (signature) _typeIR
    (_typeIR) -> false

tbl def $compat_table_lpm_ternary_range_key(typeIR) : bool =
  row 0 :
    (signature) int as typeIR
    (typeIR) -> true
    -- if typeIR <: intTypeIR
    -- let intTypeIR = typeIR as intTypeIR
    -- if (intTypeIR = int)
  row 1 :
    (signature) int< _nat > as typeIR
    (typeIR) -> true
    -- if typeIR <: fixedIntTypeIR
    -- let int< _nat > = typeIR as fixedIntTypeIR
  row 2 :
    (signature) bit< _nat > as typeIR
    (typeIR) -> true
    -- if typeIR <: fixedBitTypeIR
    -- let bit< _nat > = typeIR as fixedBitTypeIR
  row 3 :
    (signature) typedef _typeId typeIR as typeIR
    (typeIR') -> $compat_table_lpm_ternary_range_key(typeIR)
    -- if typeIR' <: typedefTypeIR
    -- let typedef _typeId typeIR = typeIR' as typedefTypeIR
  row 4 :
    (signature) type _typeId typeIR as typeIR
    (typeIR') -> $compat_table_lpm_ternary_range_key(typeIR)
    -- if typeIR' <: newTypeIR
    -- let type _typeId typeIR = typeIR' as newTypeIR
  row 5 :
    (signature) enum _typeId < typeIR >{ _valueFieldIR*{_valueFieldIR <- _valueFieldIR*} } as typeIR
    (typeIR') -> $compat_table_lpm_ternary_range_key(typeIR)
    -- if typeIR' <: serializableEnumTypeIR
    -- let enum _typeId < typeIR >{ _valueFieldIR*{_valueFieldIR <- _valueFieldIR*} } = typeIR' as serializableEnumTypeIR
  row 6 :
    (signature) _typeIR
    (_typeIR) -> false

def $compat_table_key(nameIR, typeIR) : bool =

  clause 0 : (nameIR, typeIR) = true
  -- if ((nameIR = "exact") \/ (nameIR = "optional"))
  -- if $compat_table_exact_optional_key(typeIR)

  clause 1 : (nameIR, typeIR) = true
  -- if (((nameIR = "lpm") \/ (nameIR = "ternary")) \/ (nameIR = "range"))
  -- if $compat_table_lpm_ternary_range_key(typeIR)

  clause -1 : (nameIR, typeIR) = false

def $split_dataplane_parameters(parameterIR*) : (parameterIR*, parameterIR*) =

  clause 0 : (parameterIR*{parameterIR <- parameterIR*}) = ([], [])
  -- if parameterIR*{parameterIR <- parameterIR*} matches []

  clause 1 : (parameterIR*{parameterIR <- parameterIR*}) = (parameterIR_data*{parameterIR_data <- parameterIR_data*}, parameterIR_h :: parameterIR_control*{parameterIR_control <- parameterIR_control*})
  -- if parameterIR*{parameterIR <- parameterIR*} matches _ :: _
  -- let parameterIR_h :: parameterIR_t*{parameterIR_t <- parameterIR_t*} = parameterIR*{parameterIR <- parameterIR*}
  -- let _annotationList direction _typeIR _id _parameterInitializerOptIR = parameterIR_h
  -- if direction matches ``EMPTY`
  -- let (parameterIR_data*{parameterIR_data <- parameterIR_data*}, parameterIR_control*{parameterIR_control <- parameterIR_control*}) = $split_dataplane_parameters(parameterIR_t*{parameterIR_t <- parameterIR_t*})

  clause 2 : (parameterIR*{parameterIR <- parameterIR*}) = (parameterIR_h :: parameterIR_data*{parameterIR_data <- parameterIR_data*}, parameterIR_control*{parameterIR_control <- parameterIR_control*})
  -- if parameterIR*{parameterIR <- parameterIR*} matches _ :: _
  -- let parameterIR_h :: parameterIR_t*{parameterIR_t <- parameterIR_t*} = parameterIR*{parameterIR <- parameterIR*}
  -- let _annotationList direction _typeIR _id _parameterInitializerOptIR = parameterIR_h
  -- if (direction =/= `empty)
  -- let (parameterIR_data*{parameterIR_data <- parameterIR_data*}, parameterIR_control*{parameterIR_control <- parameterIR_control*}) = $split_dataplane_parameters(parameterIR_t*{parameterIR_t <- parameterIR_t*})

