syntax copyInArgumentResult = 
   | _CONT storageReference? (from continueResult<storageReference?>) 
   | EXIT (from exitResult) 
   | REJECT errorValue (from rejectTransitionResult) 

relation Copy_in_arg: arch |- cursor evalContext parameterIR '@' cursor evalContext argumentIR ~> arch evalContext evalContext '#' copyInArgumentResult

  rulegroup directionless-in

    rule abort: ARCH_0 |- p_caller EC_caller_0 _annotationList direction typeIR nameIR _parameterInitializerOptIR '@' p_callee EC_callee_0 argumentIR ~> ARCH_1 EC_caller_1 EC_callee_0 '#' abortResult as copyInArgumentResult
    -- if ((direction = _EMPTY) \/ (direction = IN))
    -- Argument_eval: p_caller EC_caller_0 ARCH_0 |- argumentIR : EC_caller_1 ARCH_1 abortResult as expressionResult

    rule cont: ARCH_0 |- p_caller EC_caller_0 _annotationList direction typeIR nameIR _parameterInitializerOptIR '@' p_callee EC_callee_0 argumentIR ~> ARCH_1 EC_caller_1 EC_callee_1 '#' _CONT ?() as copyInArgumentResult
    -- if ((direction = _EMPTY) \/ (direction = IN))
    -- Argument_eval: p_caller EC_caller_0 ARCH_0 |- argumentIR : EC_caller_1 ARCH_1 _CONT value as expressionResult
    -- if (EC_callee_1 = $add_var_e(p_callee, EC_callee_0, _BARE nameIR, value))

  rulegroup inout

    rule abort: ARCH_0 |- p_caller EC_caller_0 _annotationList INOUT typeIR nameIR _parameterInitializerOptIR '@' p_callee EC_callee_0 argumentIR ~> ARCH_1 EC_caller_1 EC_callee_0 '#' abortResult as copyInArgumentResult
    -- Argument_eval_lvalue: p_caller EC_caller_0 ARCH_0 |- argumentIR : EC_caller_1 ARCH_1 abortResult as storageReferenceResult

    rule cont: ARCH_0 |- p_caller EC_caller_0 _annotationList INOUT typeIR nameIR _parameterInitializerOptIR '@' p_callee EC_callee_0 argumentIR ~> ARCH_1 EC_caller_1 EC_callee_1 '#' _CONT ?(storageReference) as copyInArgumentResult
    -- Argument_eval_lvalue: p_caller EC_caller_0 ARCH_0 |- argumentIR : EC_caller_1 ARCH_1 _CONT ?(storageReference) as storageReferenceResult
    -- Lvalue_read: p_caller EC_caller_1 ARCH_1 |- storageReference : value
    -- if (EC_callee_1 = $add_var_e(p_callee, EC_callee_0, _BARE nameIR, value))

  rulegroup out

    rule abort: ARCH_0 |- p_caller EC_caller_0 _annotationList OUT typeIR nameIR _parameterInitializerOptIR '@' p_callee EC_callee_0 argumentIR ~> ARCH_1 EC_caller_1 EC_callee_0 '#' abortResult as copyInArgumentResult
    -- Argument_eval_lvalue: p_caller EC_caller_0 ARCH_0 |- argumentIR : EC_caller_1 ARCH_1 abortResult as storageReferenceResult

    rule cont: ARCH_0 |- p_caller EC_caller_0 _annotationList OUT typeIR nameIR _parameterInitializerOptIR '@' p_callee EC_callee_0 argumentIR ~> ARCH_1 EC_caller_1 EC_callee_1 '#' _CONT storageReference?{storageReference <- storageReference?} as copyInArgumentResult
    -- Argument_eval_lvalue: p_caller EC_caller_0 ARCH_0 |- argumentIR : EC_caller_1 ARCH_1 _CONT storageReference?{storageReference <- storageReference?} as storageReferenceResult
    -- if (typeIR_subst = $subst_type_e(p_callee, EC_callee_0, typeIR))
    -- if (value_init = $default(typeIR_subst))
    -- if (EC_callee_1 = $add_var_e(p_callee, EC_callee_0, _BARE nameIR, value_init))

syntax copyInResult = 
   | _CONT storageReference?* (from continueResult<storageReference?*>) 
   | EXIT (from exitResult) 
   | REJECT errorValue (from rejectTransitionResult) 

relation Copy_in: cursor arch |- cursor evalContext parameterListIR '@' cursor evalContext argumentListIR ~> arch evalContext evalContext '#' copyInResult

  rulegroup 

    rule nil: p_shared ARCH |- p_caller EC_caller [] '@' p_callee EC_callee_0 [] ~> ARCH EC_caller EC_callee_1 '#' _CONT [] as copyInResult
    -- if (EC_callee_1 = $copy_e(p_shared, EC_caller, EC_callee_0))

    rule cons-head-abort: p_shared ARCH_0 |- p_caller EC_caller_0 parameterIR_h :: parameterIR_t*{parameterIR_t <- parameterIR_t*} '@' p_callee EC_callee_0 argumentIR_h :: argumentIR_t*{argumentIR_t <- argumentIR_t*} ~> ARCH_1 EC_caller_1 EC_callee_1 '#' abortResult as copyInResult
    -- Copy_in_arg: ARCH_0 |- p_caller EC_caller_0 parameterIR_h '@' p_callee EC_callee_0 argumentIR_h ~> ARCH_1 EC_caller_1 EC_callee_1 '#' abortResult as copyInArgumentResult

    rule cons-head-cont-tail-abort: p_shared ARCH_0 |- p_caller EC_caller_0 parameterIR_h :: parameterIR_t*{parameterIR_t <- parameterIR_t*} '@' p_callee EC_callee_0 argumentIR_h :: argumentIR_t*{argumentIR_t <- argumentIR_t*} ~> ARCH_2 EC_caller_2 EC_callee_2 '#' abortResult as copyInResult
    -- Copy_in_arg: ARCH_0 |- p_caller EC_caller_0 parameterIR_h '@' p_callee EC_callee_0 argumentIR_h ~> ARCH_1 EC_caller_1 EC_callee_1 '#' _CONT storageReference_h?{storageReference_h <- storageReference_h?} as copyInArgumentResult
    -- Copy_in: p_shared ARCH_1 |- p_caller EC_caller_1 parameterIR_t*{parameterIR_t <- parameterIR_t*} '@' p_callee EC_callee_1 argumentIR_t*{argumentIR_t <- argumentIR_t*} ~> ARCH_2 EC_caller_2 EC_callee_2 '#' abortResult as copyInResult

    rule cons-head-cont-tail-cont: p_shared ARCH_0 |- p_caller EC_caller_0 parameterIR_h :: parameterIR_t*{parameterIR_t <- parameterIR_t*} '@' p_callee EC_callee_0 argumentIR_h :: argumentIR_t*{argumentIR_t <- argumentIR_t*} ~> ARCH_2 EC_caller_2 EC_callee_2 '#' _CONT storageReference?{storageReference <- storageReference?}*{storageReference? <- storageReference?*} as copyInResult
    -- Copy_in_arg: ARCH_0 |- p_caller EC_caller_0 parameterIR_h '@' p_callee EC_callee_0 argumentIR_h ~> ARCH_1 EC_caller_1 EC_callee_1 '#' _CONT storageReference_h?{storageReference_h <- storageReference_h?} as copyInArgumentResult
    -- Copy_in: p_shared ARCH_1 |- p_caller EC_caller_1 parameterIR_t*{parameterIR_t <- parameterIR_t*} '@' p_callee EC_callee_1 argumentIR_t*{argumentIR_t <- argumentIR_t*} ~> ARCH_2 EC_caller_2 EC_callee_2 '#' _CONT storageReference_t?{storageReference_t <- storageReference_t?}*{storageReference_t? <- storageReference_t?*} as copyInResult
    -- if (storageReference?{storageReference <- storageReference?}*{storageReference? <- storageReference?*} = storageReference_h?{storageReference_h <- storageReference_h?} :: storageReference_t?{storageReference_t <- storageReference_t?}*{storageReference_t? <- storageReference_t?*})

relation Copy_in_default: parameterListIR '@' cursor evalContext ~> evalContext

  rulegroup 

    rule : parameterIR*{parameterIR <- parameterIR*} '@' p_callee EC_callee_0 ~> EC_callee_1
    -- (if (_annotationList _direction _typeIR nameIR ?('=' _VALUE value as parameterInitializerIR) = parameterIR))*{_annotationList <- _annotationList*, _direction <- _direction*, _typeIR <- _typeIR*, nameIR <- nameIR*, parameterIR <- parameterIR*, value <- value*}
    -- if (EC_callee_1 = $add_vars_e(p_callee, EC_callee_0, _BARE nameIR*{nameIR <- nameIR*}, value*{value <- value*}))

relation Copy_out_argument: arch |- cursor evalContext parameterIR '@' cursor evalContext storageReference? ~> evalContext

  rulegroup in-directionless

    rule in-directionless: ARCH |- p_caller EC_caller_0 _annotationList direction typeIR nameIR _parameterInitializerOptIR '@' p_callee EC_callee ?() ~> EC_caller_0
    -- if ((direction = IN) \/ (direction = _EMPTY))

  rulegroup out-inout

    rule dontcare: ARCH |- p_caller EC_caller _annotationList direction typeIR nameIR _parameterInitializerOptIR '@' p_callee EC_callee ?() ~> EC_caller
    -- if ((direction = OUT) \/ (direction = INOUT))

    rule non-dontcare: ARCH |- p_caller EC_caller_0 _annotationList direction typeIR nameIR _parameterInitializerOptIR '@' p_callee EC_callee ?(storageReference) ~> EC_caller_1
    -- if ((direction = OUT) \/ (direction = INOUT))
    -- if (value = $find_var_e(_BARE nameIR, p_callee, EC_callee))
    -- Lvalue_write: p_caller EC_caller_0 ARCH |- storageReference := value : EC_caller_1

relation Copy_out: cursor arch |- cursor evalContext parameterListIR '@' cursor evalContext storageReference?* ~> evalContext

  rulegroup 

    rule : p_shared ARCH |- p_caller EC_caller_0 parameterListIR '@' p_callee EC_callee storageReference?{storageReference <- storageReference?}*{storageReference? <- storageReference?*} ~> EC_caller_2
    -- if (EC_caller_1 = $copy_e(p_shared, EC_callee, EC_caller_0))
    -- Copy_out_inner: ARCH |- p_caller EC_caller_1 parameterListIR '@' p_callee EC_callee storageReference?{storageReference <- storageReference?}*{storageReference? <- storageReference?*} ~> EC_caller_2

relation Call_eval: cursor evalContext arch |- callee '@' `< typeArgumentListIR `> `( argumentListIR `) : evalContext arch callResult

  rulegroup actionCallee

    rule copyin-exit: p EC_0 ARCH_0 |- actionCallee as callee '@' `< [] `> `( argumentListIR `) : EC_1 ARCH_1 EXIT as callResult
    -- if (ACTION p_shared '.' nameIR `( parameterIR*{parameterIR <- parameterIR*} '#' id_default*{id_default <- id_default*} `) blockStatementIR = actionCallee)
    -- if (EC_callee_0 = $inherit_e(p_shared, EC_0))
    -- if (GIVEN parameterIR_aligned*{parameterIR_aligned <- parameterIR_aligned*} DEFAULT parameterIR_default*{parameterIR_default <- parameterIR_default*} OPTIONAL _parameterIR*{_parameterIR <- _parameterIR*} = $align_parameterListIR(parameterIR*{parameterIR <- parameterIR*}, argumentListIR, id_default*{id_default <- id_default*}, []))
    -- Copy_in: p_shared ARCH_0 |- p EC_0 parameterIR_aligned*{parameterIR_aligned <- parameterIR_aligned*} '@' LOCAL EC_callee_0 argumentListIR ~> ARCH_1 EC_1 EC_callee_1 '#' EXIT as copyInResult

    rule copyin-cont-ActionBody-exit: p EC_0 ARCH_0 |- actionCallee as callee '@' `< [] `> `( argumentListIR `) : EC_2 ARCH_2 EXIT as callResult
    -- if (ACTION p_shared '.' nameIR `( parameterIR*{parameterIR <- parameterIR*} '#' id_default*{id_default <- id_default*} `) blockStatementIR = actionCallee)
    -- if (EC_callee_0 = $inherit_e(p_shared, EC_0))
