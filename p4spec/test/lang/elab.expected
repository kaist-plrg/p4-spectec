def $insert_NoAction_tablePropertyIR(tableContext, tablePropertyIR*) : (tableContext, tablePropertyIR*) =

  clause 0 : (TBLC, []) = (TBLC, [])

  clause 1 : (TBLC_0, tablePropertyIR_h :: tablePropertyIR_t*{tablePropertyIR_t <- tablePropertyIR_t*}) = (TBLC_1, tablePropertyIR_h_updated :: tablePropertyIR_t*{tablePropertyIR_t <- tablePropertyIR_t*})
  -- if (ACTIONS '=' `{ tableActionIR*{tableActionIR <- tableActionIR*} `} as tablePropertyIR = tablePropertyIR_h)
  -- (if (_annotationList tableActionReferenceIR '#' `( _parameterListIR ',' _parameterListIR' `) ';' = tableActionIR))*{_annotationList <- _annotationList*, _parameterListIR <- _parameterListIR*, _parameterListIR' <- _parameterListIR'*, tableActionIR <- tableActionIR*, tableActionReferenceIR <- tableActionReferenceIR*}
  -- if (tableActionReferenceIR_NoAction = '.' "NoAction" ?() `( [] `))
  -- if ~tableActionReferenceIR_NoAction <- tableActionReferenceIR*{tableActionReferenceIR <- tableActionReferenceIR*}
  -- if (TBLC_1 = $add_action_tbl(TBLC_0, '.' "NoAction", [], []))
  -- if (tableActionIR_NoAction = _EMPTY tableActionReferenceIR_NoAction '#' `( [] ',' [] `) ';')
  -- if (tablePropertyIR_h_updated = ACTIONS '=' `{ tableActionIR*{tableActionIR <- tableActionIR*} ++ [tableActionIR_NoAction] `} as tablePropertyIR)

  clause 2 : (TBLC_0, tablePropertyIR_h :: tablePropertyIR_t*{tablePropertyIR_t <- tablePropertyIR_t*}) = (TBLC_0, tablePropertyIR_h :: tablePropertyIR_t*{tablePropertyIR_t <- tablePropertyIR_t*})
  -- if (ACTIONS '=' `{ tableActionIR*{tableActionIR <- tableActionIR*} `} as tablePropertyIR = tablePropertyIR_h)
  -- (if (_annotationList tableActionReferenceIR '#' `( _parameterListIR ',' _parameterListIR' `) ';' = tableActionIR))*{_annotationList <- _annotationList*, _parameterListIR <- _parameterListIR*, _parameterListIR' <- _parameterListIR'*, tableActionIR <- tableActionIR*, tableActionReferenceIR <- tableActionReferenceIR*}
  -- if (tableActionReferenceIR_NoAction = '.' "NoAction" ?() `( [] `))
  -- if tableActionReferenceIR_NoAction <- tableActionReferenceIR*{tableActionReferenceIR <- tableActionReferenceIR*}

  clause 3 : (TBLC_0, tablePropertyIR_h :: tablePropertyIR_t*{tablePropertyIR_t <- tablePropertyIR_t*}) = (TBLC_1, tablePropertyIR_h :: tablePropertyIR_t_updated*{tablePropertyIR_t_updated <- tablePropertyIR_t_updated*})
  -- if ~tablePropertyIR_h <: tableActionsPropertyIR
  -- if ((TBLC_1, tablePropertyIR_t_updated*{tablePropertyIR_t_updated <- tablePropertyIR_t_updated*}) = $insert_NoAction_tablePropertyIR(TBLC_0, tablePropertyIR_t*{tablePropertyIR_t <- tablePropertyIR_t*}))

relation ControlLocalDecls_ok: typingContext |- controlLocalDeclaration* : typingContext controlLocalDeclarationIR*

  rulegroup 

    rule nil: TC |- [] : TC []

    rule cons: TC_0 |- controlLocalDeclaration_h :: controlLocalDeclaration_t*{controlLocalDeclaration_t <- controlLocalDeclaration_t*} : TC_2 controlLocalDeclarationIR_h :: controlLocalDeclarationIR_t*{controlLocalDeclarationIR_t <- controlLocalDeclarationIR_t*}
    -- ControlLocalDecl_ok: TC_0 |- controlLocalDeclaration_h : TC_1 controlLocalDeclarationIR_h
    -- ControlLocalDecls_ok: TC_1 |- controlLocalDeclaration_t*{controlLocalDeclaration_t <- controlLocalDeclaration_t*} : TC_2 controlLocalDeclarationIR_t*{controlLocalDeclarationIR_t <- controlLocalDeclarationIR_t*}

syntax strict = 
   | STRICT (from strict) 
   | LAX (from strict) 

syntax strictness = map<typeId, strict>

def $empty_strictness(typeId*) : strictness =

  clause 0 : (typeId*{typeId <- typeId*}) = `{ typeId ':' STRICT*{typeId <- typeId*} `}

syntax infer = 
   | KNOWN AS typeIR (from infer) 
   | UNKNOWN (from infer) 

syntax constraint = map<typeId, infer>

def $empty_constraint(typeId*) : constraint =

  clause 0 : (typeId*{typeId <- typeId*}) = `{ typeId ':' UNKNOWN*{typeId <- typeId*} `}

syntax inference = map<typeId, typeIR>

def $infer(typeId*, parameterIR*, parameterIR*, argumentIR*) : inference =

  clause 0 : ([], parameterIR*{parameterIR <- parameterIR*}, parameterIR_optional*{parameterIR_optional <- parameterIR_optional*}, argumentIR*{argumentIR <- argumentIR*}) = $empty_map<typeId, typeIR>

  clause 1 : (typeId_infer*{typeId_infer <- typeId_infer*}, parameterIR*{parameterIR <- parameterIR*}, parameterIR_optional*{parameterIR_optional <- parameterIR_optional*}, argumentIR*{argumentIR <- argumentIR*}) = inference_resolved
  -- if (typeId_infer*{typeId_infer <- typeId_infer*} =/= [])
  -- if (strictness_init = $empty_strictness(typeId_infer*{typeId_infer <- typeId_infer*}))
  -- if (B = $free_parameterIRs(parameterIR*{parameterIR <- parameterIR*}))
  -- if (B_optional = $free_parameterIRs(parameterIR_optional*{parameterIR_optional <- parameterIR_optional*}))
  -- if (`{ typeId_free*{typeId_free <- typeId_free*} `} = $diff_set<typeId>(B_optional, B))
  -- if (strict*{strict <- strict*} = $repeat_<strict>(LAX, |typeId_free*{typeId_free <- typeId_free*}|))
  -- if (strictness = $adds_map<typeId, strict>(strictness_init, typeId_free*{typeId_free <- typeId_free*}, strict*{strict <- strict*}))
  -- if (constraint_init = $empty_constraint(typeId_infer*{typeId_infer <- typeId_infer*}))
  -- (if (constraint_pair = $infer_pair(constraint_init, parameterIR, argumentIR)))*{argumentIR <- argumentIR*, constraint_pair <- constraint_pair*, parameterIR <- parameterIR*}
  -- if (constraint_inferred = $merge_constraints(constraint_init, constraint_pair*{constraint_pair <- constraint_pair*}))
  -- if (inference = $resolve_constraint(strictness, constraint_inferred))
  -- if (inference_resolved = $resolve_inference(inference))

def $infer_pair(constraint, parameterIR, argumentIR) : constraint =

  clause 0 : (constraint, parameterIR, typedExpressionIR as argumentIR) = $gen_constraint_pair(constraint, typeIR_param, typeIR_arg)
  -- if (_annotationList _direction typeIR_param _id _parameterInitializerOptIR = parameterIR)
  -- if (typeIR_arg = $type_of_typedExpressionIR(typedExpressionIR))

  clause 1 : (constraint, parameterIR, nameIR '=' typedExpressionIR) = $gen_constraint_pair(constraint, typeIR_param, typeIR_arg)
  -- if (_annotationList _direction typeIR_param _id _parameterInitializerOptIR = parameterIR)
  -- if (typeIR_arg = $type_of_typedExpressionIR(typedExpressionIR))

  clause 2 : (constraint, parameterIR, nameIR '=' '_') = constraint

  clause 3 : (constraint, parameterIR, '_') = constraint

def $resolve_inference(inference) : inference =

  clause 0 : (`{ typeId ':' typeIR*{typeIR <- typeIR*, typeId <- typeId*} `}) = `{ typeId ':' typeIR_resolved*{typeIR_resolved <- typeIR_resolved*, typeId <- typeId*} `}
  -- (if (typeIR_resolved = $resolve_inference'(typeIR)))*{typeIR <- typeIR*, typeIR_resolved <- typeIR_resolved*}

def $resolve_inference'(typeIR) : typeIR =

  clause 0 : (typeIR) = typeIR_resolved
  -- if (SEQ `< typeIR_arg*{typeIR_arg <- typeIR_arg*} `> as typeIR = $unroll_typeIR(typeIR))
  -- if (typeIR_resolved = TUPLE `< typeIR_arg*{typeIR_arg <- typeIR_arg*} `> as typeIR)

  clause -1 : (typeIR) = typeIR

def $gen_constraint(constraint, typeIR*, typeIR*) : constraint =

  clause 0 : (constraint, typeIR_param*{typeIR_param <- typeIR_param*}, typeIR_arg*{typeIR_arg <- typeIR_arg*}) = $merge_constraints(constraint, constraint_pair*{constraint_pair <- constraint_pair*})
  -- (if (constraint_pair = $gen_constraint_pair(constraint, typeIR_param, typeIR_arg)))*{constraint_pair <- constraint_pair*, typeIR_arg <- typeIR_arg*, typeIR_param <- typeIR_param*}

def $gen_constraint_pair(constraint, typeIR, typeIR) : constraint =

  clause 0 : (constraint, _NAME typeId_param as typeIR, typeIR_arg) = $update_map<typeId, infer>(constraint, typeId_param, KNOWN AS typeIR_arg)
  -- if $in_set<typeId>(typeId_param, $dom_map<typeId, infer>(constraint))

  clause 1 : (constraint, TYPEDEF _typeId typeIR_param as typeIR, typeIR_arg) = $gen_constraint_pair(constraint, typeIR_param, typeIR_arg)

  clause 2 : (constraint, typeIR_param, TYPEDEF _typeId typeIR_arg as typeIR) = $gen_constraint_pair(constraint, typeIR_param, typeIR_arg)
  -- if ~typeIR_param <: nameTypeIR
  -- if ~typeIR_param <: typedefTypeIR

  clause 3 : (constraint, TYPE typeId typeIR_param as typeIR, TYPE typeId typeIR_arg as typeIR) = $gen_constraint_pair(constraint, typeIR_param, typeIR_arg)

  clause 4 : (constraint, LIST `< typeIR_param `> as typeIR, LIST `< typeIR_arg `> as typeIR) = $gen_constraint_pair(constraint, typeIR_param, typeIR_arg)

  clause 5 : (constraint, TUPLE `< typeIR_param*{typeIR_param <- typeIR_param*} `> as typeIR, TUPLE `< typeIR_arg*{typeIR_arg <- typeIR_arg*} `> as typeIR) = $gen_constraint(constraint, typeIR_param*{typeIR_param <- typeIR_param*}, typeIR_arg*{typeIR_arg <- typeIR_arg*})

  clause 6 : (constraint, ARRAY typeIR_param `[ n_size `] as typeIR, ARRAY typeIR_arg `[ n_size `] as typeIR) = $gen_constraint_pair(constraint, typeIR_param, typeIR_arg)

  clause 7 : (constraint, HEADER_STACK typeIR_param `[ n_size `] as typeIR, HEADER_STACK typeIR_arg `[ n_size `] as typeIR) = $gen_constraint_pair(constraint, typeIR_param, typeIR_arg)

  clause 8 : (constraint, STRUCT typeId `< typeIR_arg_a*{typeIR_arg_a <- typeIR_arg_a*} `> `{ _fieldTypeIR*{_fieldTypeIR <- _fieldTypeIR*} `} as typeIR, STRUCT typeId `< typeIR_arg_b*{typeIR_arg_b <- typeIR_arg_b*} `> `{ _fieldTypeIR'*{_fieldTypeIR' <- _fieldTypeIR'*} `} as typeIR) = $gen_constraint(constraint, typeIR_arg_a*{typeIR_arg_a <- typeIR_arg_a*}, typeIR_arg_b*{typeIR_arg_b <- typeIR_arg_b*})

  clause 9 : (constraint, HEADER typeId `< typeIR_arg_a*{typeIR_arg_a <- typeIR_arg_a*} `> `{ _fieldTypeIR*{_fieldTypeIR <- _fieldTypeIR*} `} as typeIR, HEADER typeId `< typeIR_arg_b*{typeIR_arg_b <- typeIR_arg_b*} `> `{ _fieldTypeIR'*{_fieldTypeIR' <- _fieldTypeIR'*} `} as typeIR) = $gen_constraint(constraint, typeIR_arg_a*{typeIR_arg_a <- typeIR_arg_a*}, typeIR_arg_b*{typeIR_arg_b <- typeIR_arg_b*})

  clause 10 : (constraint, HEADER_UNION typeId `< typeIR_arg_a*{typeIR_arg_a <- typeIR_arg_a*} `> `{ _fieldTypeIR*{_fieldTypeIR <- _fieldTypeIR*} `} as typeIR, HEADER_UNION typeId `< typeIR_arg_b*{typeIR_arg_b <- typeIR_arg_b*} `> `{ _fieldTypeIR'*{_fieldTypeIR' <- _fieldTypeIR'*} `} as typeIR) = $gen_constraint(constraint, typeIR_arg_a*{typeIR_arg_a <- typeIR_arg_a*}, typeIR_arg_b*{typeIR_arg_b <- typeIR_arg_b*})

  clause 11 : (constraint, EXTERN typeId `< typeIR_arg_a*{typeIR_arg_a <- typeIR_arg_a*} `> `{ _pair<callableId, externMethodTypeDefIR>*{_pair<callableId, externMethodTypeDefIR> <- _pair<callableId, externMethodTypeDefIR>*} `} as typeIR, EXTERN typeId `< typeIR_arg_b*{typeIR_arg_b <- typeIR_arg_b*} `> `{ _pair<callableId, externMethodTypeDefIR>'*{_pair<callableId, externMethodTypeDefIR>' <- _pair<callableId, externMethodTypeDefIR>'*} `} as typeIR) = $gen_constraint(constraint, typeIR_arg_a*{typeIR_arg_a <- typeIR_arg_a*}, typeIR_arg_b*{typeIR_arg_b <- typeIR_arg_b*})

  clause 12 : (constraint, PARSER _typeId `< _typeArgumentIR*{_typeArgumentIR <- _typeArgumentIR*} `> `( parameterIR_param*{parameterIR_param <- parameterIR_param*} `) as typeIR, PARSER _typeId' `< _typeArgumentIR'*{_typeArgumentIR' <- _typeArgumentIR'*} `> `( parameterIR_arg*{parameterIR_arg <- parameterIR_arg*} `) as typeIR) = $gen_constraint(constraint, typeIR_param*{typeIR_param <- typeIR_param*}, typeIR_arg*{typeIR_arg <- typeIR_arg*})
  -- (if (_annotationList direction typeIR_param _id _parameterInitializerOptIR = parameterIR_param))*{_annotationList <- _annotationList*, _id <- _id*, _parameterInitializerOptIR <- _parameterInitializerOptIR*, direction <- direction*, parameterIR_param <- parameterIR_param*, typeIR_param <- typeIR_param*}
  -- (if (_annotationList' direction typeIR_arg _id' _parameterInitializerOptIR' = parameterIR_arg))*{_annotationList' <- _annotationList'*, _id' <- _id'*, _parameterInitializerOptIR' <- _parameterInitializerOptIR'*, direction <- direction*, parameterIR_arg <- parameterIR_arg*, typeIR_arg <- typeIR_arg*}

  clause 13 : (constraint, CONTROL _typeId `< _typeArgumentIR*{_typeArgumentIR <- _typeArgumentIR*} `> `( parameterIR_param*{parameterIR_param <- parameterIR_param*} `) as typeIR, CONTROL _typeId' `< _typeArgumentIR'*{_typeArgumentIR' <- _typeArgumentIR'*} `> `( parameterIR_arg*{parameterIR_arg <- parameterIR_arg*} `) as typeIR) = $gen_constraint(constraint, typeIR_param*{typeIR_param <- typeIR_param*}, typeIR_arg*{typeIR_arg <- typeIR_arg*})
  -- (if (_annotationList direction typeIR_param _id _parameterInitializerOptIR = parameterIR_param))*{_annotationList <- _annotationList*, _id <- _id*, _parameterInitializerOptIR <- _parameterInitializerOptIR*, direction <- direction*, parameterIR_param <- parameterIR_param*, typeIR_param <- typeIR_param*}
  -- (if (_annotationList' direction typeIR_arg _id' _parameterInitializerOptIR' = parameterIR_arg))*{_annotationList' <- _annotationList'*, _id' <- _id'*, _parameterInitializerOptIR' <- _parameterInitializerOptIR'*, direction <- direction*, parameterIR_arg <- parameterIR_arg*, typeIR_arg <- typeIR_arg*}

  clause 14 : (constraint, PACKAGE _typeId `< _typeArgumentIR*{_typeArgumentIR <- _typeArgumentIR*} `> `{ typeIR_param*{typeIR_param <- typeIR_param*} `} as typeIR, PACKAGE _typeId' `< _typeArgumentIR'*{_typeArgumentIR' <- _typeArgumentIR'*} `> `{ typeIR_arg*{typeIR_arg <- typeIR_arg*} `} as typeIR) = $gen_constraint(constraint, typeIR_param*{typeIR_param <- typeIR_param*}, typeIR_arg*{typeIR_arg <- typeIR_arg*})

  clause -1 : (constraint, typeIR_param, typeIR_arg) = constraint

def $merge_constraint(constraint, constraint) : constraint =

  clause 0 : (constraint_pre, constraint_post) = $merge_constraint'(constraint_pre, constraint_post, typeId_pre*{typeId_pre <- typeId_pre*}, `{ [] `})
  -- if (`{ typeId_pre*{typeId_pre <- typeId_pre*} `} = $dom_map<typeId, infer>(constraint_pre))
  -- if (`{ typeId_post*{typeId_post <- typeId_post*} `} = $dom_map<typeId, infer>(constraint_post))
  -- if $eq_set<typeId>(`{ typeId_pre*{typeId_pre <- typeId_pre*} `}, `{ typeId_post*{typeId_post <- typeId_post*} `})

def $merge_constraint'(constraint, constraint, typeId*, constraint) : constraint =

  clause 0 : (constraint_pre, constraint_post, [], constraint) = constraint

  clause 1 : (constraint_pre, constraint_post, typeId_h :: typeId_t*{typeId_t <- typeId_t*}, constraint) = $merge_constraint'(constraint_pre, constraint_post, typeId_t*{typeId_t <- typeId_t*}, constraint_updated)
  -- if (?(UNKNOWN) = $find_map<typeId, infer>(constraint_pre, typeId_h))
  -- if (?(UNKNOWN) = $find_map<typeId, infer>(constraint_post, typeId_h))
  -- if (constraint_updated = $update_map<typeId, infer>(constraint, typeId_h, UNKNOWN))

  clause 2 : (constraint_pre, constraint_post, typeId_h :: typeId_t*{typeId_t <- typeId_t*}, constraint) = $merge_constraint'(constraint_pre, constraint_post, typeId_t*{typeId_t <- typeId_t*}, constraint_updated)
  -- if (?(UNKNOWN) = $find_map<typeId, infer>(constraint_pre, typeId_h))
  -- if (?(KNOWN AS typeIR_post) = $find_map<typeId, infer>(constraint_post, typeId_h))
  -- if (constraint_updated = $update_map<typeId, infer>(constraint, typeId_h, KNOWN AS typeIR_post))

  clause 3 : (constraint_pre, constraint_post, typeId_h :: typeId_t*{typeId_t <- typeId_t*}, constraint) = $merge_constraint'(constraint_pre, constraint_post, typeId_t*{typeId_t <- typeId_t*}, constraint_updated)
  -- if (?(KNOWN AS typeIR_pre) = $find_map<typeId, infer>(constraint_pre, typeId_h))
  -- if (?(UNKNOWN) = $find_map<typeId, infer>(constraint_post, typeId_h))
  -- if (constraint_updated = $update_map<typeId, infer>(constraint, typeId_h, KNOWN AS typeIR_pre))

  clause 4 : (constraint_pre, constraint_post, typeId_h :: typeId_t*{typeId_t <- typeId_t*}, constraint) = $merge_constraint'(constraint_pre, constraint_post, typeId_t*{typeId_t <- typeId_t*}, constraint_updated)
  -- if (?(KNOWN AS typeIR_pre) = $find_map<typeId, infer>(constraint_pre, typeId_h))
  -- if (?(KNOWN AS typeIR_post) = $find_map<typeId, infer>(constraint_post, typeId_h))
  -- Cast_impl: typeIR_pre -> typeIR_post : OK _typeIR*{_typeIR <- _typeIR*}
  -- if (constraint_updated = $update_map<typeId, infer>(constraint, typeId_h, KNOWN AS typeIR_post))

  clause 5 : (constraint_pre, constraint_post, typeId_h :: typeId_t*{typeId_t <- typeId_t*}, constraint) = $merge_constraint'(constraint_pre, constraint_post, typeId_t*{typeId_t <- typeId_t*}, constraint_updated)
  -- if (?(KNOWN AS typeIR_pre) = $find_map<typeId, infer>(constraint_pre, typeId_h))
  -- if (?(KNOWN AS typeIR_post) = $find_map<typeId, infer>(constraint_post, typeId_h))
  -- Cast_impl: typeIR_pre -> typeIR_post : FAIL
  -- Cast_impl: typeIR_post -> typeIR_pre : OK _typeIR*{_typeIR <- _typeIR*}
  -- if (constraint_updated = $update_map<typeId, infer>(constraint, typeId_h, KNOWN AS typeIR_pre))

def $merge_constraints(constraint, constraint*) : constraint =

  clause 0 : (constraint_pre, []) = constraint_pre

  clause 1 : (constraint_pre_0, constraint_post_h :: constraint_post_t*{constraint_post_t <- constraint_post_t*}) = constraint_pre_2
  -- if (constraint_pre_1 = $merge_constraint(constraint_pre_0, constraint_post_h))
  -- if (constraint_pre_2 = $merge_constraints(constraint_pre_1, constraint_post_t*{constraint_post_t <- constraint_post_t*}))

def $resolve_constraint(strictness, constraint) : inference =

  clause 0 : (strictness, `{ [] `}) = `{ [] `}

  clause 1 : (strictness, `{ typeId_h ':' infer_h :: typeId_t ':' infer_t*{infer_t <- infer_t*, typeId_t <- typeId_t*} `}) = `{ typeId_h ':' typeIR_h :: typeId_t ':' typeIR_t*{typeIR_t <- typeIR_t*, typeId_t <- typeId_t*} `}
  -- if (KNOWN AS typeIR_h = infer_h)
  -- if (`{ typeId_t ':' typeIR_t*{typeIR_t <- typeIR_t*, typeId_t <- typeId_t*} `} = $resolve_constraint(strictness, `{ typeId_t ':' infer_t*{infer_t <- infer_t*, typeId_t <- typeId_t*} `}))

  clause 2 : (strictness, `{ typeId_h ':' infer_h :: typeId_t ':' infer_t*{infer_t <- infer_t*, typeId_t <- typeId_t*} `}) = `{ typeId_h ':' BOOL as typeIR :: typeId_t ':' typeIR_t*{typeIR_t <- typeIR_t*, typeId_t <- typeId_t*} `}
  -- if (UNKNOWN = infer_h)
  -- if ($find_map<typeId, strict>(strictness, typeId_h) = ?(LAX))
  -- if (`{ typeId_t ':' typeIR_t*{typeIR_t <- typeIR_t*, typeId_t <- typeId_t*} `} = $resolve_constraint(strictness, `{ typeId_t ':' infer_t*{infer_t <- infer_t*, typeId_t <- typeId_t*} `}))

def $resolve_type_alias(typeIR) : (nameIR, typeIR*) =

  clause 0 : (TYPEDEF nameIR_alias typeIR_alias as typeIR) = $resolve_type_alias(typeIR_alias)

  clause 1 : (EXTERN nameIR_alias `< typeIR_arg*{typeIR_arg <- typeIR_arg*} `> _externMethodTypeDefEnv as typeIR) = (nameIR_alias, typeIR_arg*{typeIR_arg <- typeIR_arg*})

  clause 2 : (PACKAGE nameIR_alias `< typeIR_arg*{typeIR_arg <- typeIR_arg*} `> `{ _typeIR*{_typeIR <- _typeIR*} `} as typeIR) = (nameIR_alias, typeIR_arg*{typeIR_arg <- typeIR_arg*})

def $instantiable_extern(cursor, typingContext, instctxt) : bool =

  clause 0 : (GLOBAL, TC, instctxt) = true

  clause 1 : (BLOCK, TC, instctxt) = true

  clause 2 : (LOCAL, TC, instctxt) = true

def $instantiable_parser(cursor, typingContext, instctxt) : bool =

  clause 0 : (GLOBAL, TC, instctxt) = (instctxt = ANON)

  clause 1 : (BLOCK, TC, instctxt) = ((blockKind = PARSER) \/ (blockKind = PACKAGE))
  -- if (blockKind = TC.BLOCK.KIND)

  clause 2 : (LOCAL, TC, instctxt) = (localKind = PARSER_STATE as localKind)
  -- if (localKind = TC.LOCAL.KIND)

def $instantiable_control(cursor, typingContext, instctxt) : bool =

  clause 0 : (GLOBAL, TC, instctxt) = (instctxt = ANON)

  clause 1 : (BLOCK, TC, instctxt) = ((blockKind = CONTROL) \/ (blockKind = PACKAGE))
  -- if (blockKind = TC.BLOCK.KIND)

  clause 2 : (LOCAL, TC, instctxt) = (localKind = CONTROL_APPLY_METHOD as localKind)
  -- if (localKind = TC.LOCAL.KIND)

def $instantiable_package(cursor, typingContext, instctxt) : bool =

  clause 0 : (GLOBAL, TC, instctxt) = true

  clause 1 : (BLOCK, TC, instctxt) = (blockKind = PACKAGE)
  -- if (blockKind = TC.BLOCK.KIND)

  clause 2 : (LOCAL, TC, instctxt) = false

def $instantiable_table(cursor, typingContext, instctxt) : bool =

  clause 0 : (GLOBAL, TC, instctxt) = false

  clause 1 : (BLOCK, TC, instctxt) = (blockKind = CONTROL)
  -- if (blockKind = TC.BLOCK.KIND)

  clause 2 : (LOCAL, TC, instctxt) = false

def $instantiable(cursor, typingContext, instctxt, typeIR) : bool =

  clause 0 : (p, TC, instctxt, typeIR) = $instantiable_extern(p, TC, instctxt)
  -- if (typeIR_unroll = $unroll_typeIR(typeIR))
  -- if typeIR_unroll <: externObjectTypeIR

  clause 1 : (p, TC, instctxt, typeIR) = $instantiable_parser(p, TC, instctxt)
  -- if (typeIR_unroll = $unroll_typeIR(typeIR))
  -- if typeIR_unroll <: parserObjectTypeIR

  clause 2 : (p, TC, instctxt, typeIR) = $instantiable_control(p, TC, instctxt)
  -- if (typeIR_unroll = $unroll_typeIR(typeIR))
  -- if typeIR_unroll <: controlObjectTypeIR

  clause 3 : (p, TC, instctxt, typeIR) = $instantiable_package(p, TC, instctxt)
  -- if (typeIR_unroll = $unroll_typeIR(typeIR))
  -- if typeIR_unroll <: packageObjectTypeIR

  clause 4 : (p, TC, instctxt, typeIR) = $instantiable_table(p, TC, instctxt)
  -- if (typeIR_unroll = $unroll_typeIR(typeIR))
  -- if typeIR_unroll <: tableObjectTypeIR

def $callable_action(cursor, typingContext) : bool =

  clause 0 : (GLOBAL, TC) = false

  clause 1 : (BLOCK, TC) = false

  clause 2 : (LOCAL, TC) = ((localKind = ACTION as localKind) \/ (localKind = CONTROL_APPLY_METHOD as localKind))
  -- if (localKind = TC.LOCAL.KIND)

def $callable_definedFunction(cursor, typingContext) : bool =

  clause 0 : (GLOBAL, TC) = false

  clause 1 : (BLOCK, TC) = ((blockKind = PARSER) \/ (blockKind = CONTROL))
  -- if (blockKind = TC.BLOCK.KIND)

  clause 2 : (LOCAL, TC) = ~localKind <: externMethodLocalKind
  -- if (localKind = TC.LOCAL.KIND)

def $callable_externFunction(cursor, typingContext, nameIR) : bool =

  clause 0 : (GLOBAL, TC, nameIR) = false
  -- if (nameIR = "verify")

  clause 1 : (GLOBAL, TC, nameIR) = true
  -- if (nameIR =/= "verify")

  clause 2 : (BLOCK, TC, nameIR) = (blockKind = PARSER)
  -- if (nameIR = "verify")
  -- if (blockKind = TC.BLOCK.KIND)

  clause 3 : (BLOCK, TC, nameIR) = ((blockKind = PARSER) \/ (blockKind = CONTROL))
  -- if (nameIR =/= "verify")
  -- if (blockKind = TC.BLOCK.KIND)

  clause 4 : (LOCAL, TC, nameIR) = (localKind = PARSER_STATE as localKind)
  -- if (nameIR = "verify")
  -- if (localKind = TC.LOCAL.KIND)

  clause 5 : (LOCAL, TC, nameIR) = true
  -- if (nameIR =/= "verify")

def $callable_externMethod(cursor, typingContext) : bool =

  clause 0 : (GLOBAL, TC) = false

  clause 1 : (BLOCK, TC) = ((blockKind = PARSER) \/ (blockKind = CONTROL))
  -- if (blockKind = TC.BLOCK.KIND)

  clause 2 : (LOCAL, TC) = true

def $callable_parserApplyMethod(cursor, typingContext) : bool =

  clause 0 : (GLOBAL, TC) = false

  clause 1 : (BLOCK, TC) = false

  clause 2 : (LOCAL, TC) = (localKind = PARSER_STATE as localKind)
  -- if (localKind = TC.LOCAL.KIND)

def $callable_controlApplyMethod(cursor, typingContext) : bool =

  clause 0 : (GLOBAL, TC) = false

  clause 1 : (BLOCK, TC) = false

  clause 2 : (LOCAL, TC) = (localKind = CONTROL_APPLY_METHOD as localKind)
  -- if (localKind = TC.LOCAL.KIND)

def $callable_tableApplyMethod(cursor, typingContext) : bool =

  clause 0 : (GLOBAL, TC) = false

  clause 1 : (BLOCK, TC) = false

  clause 2 : (LOCAL, TC) = ((localKind = CONTROL_APPLY_METHOD as localKind) \/ (localKind = TABLE_APPLY_METHOD as localKind))
  -- if (localKind = TC.LOCAL.KIND)

def $callableId_IR(nameIR, parameterListIR) : callableId =

  clause 0 : (nameIR, parameterIR*{parameterIR <- parameterIR*}) = nameIR `( id*{id <- id*} `)
  -- (if (_annotationList _direction _typeIR id _parameterInitializerOptIR = parameterIR))*{_annotationList <- _annotationList*, _direction <- _direction*, _parameterInitializerOptIR <- _parameterInitializerOptIR*, _typeIR <- _typeIR*, id <- id*, parameterIR <- parameterIR*}

syntax storageReference = 
   | _BARE nameIR (from prefixedNameIR)  hint(print %0)
   | '.' nameIR (from prefixedNameIR) 
   | storageReference '.' nameIR (from storageReference) 
   | storageReference `[ value `] (from storageReference) 
   | storageReference `[ value sliceop value `] (from storageReference) 

syntax actionDef = 
   | annotationList ACTION nameIR `( parameterListIR `) blockStatementIR (from actionDef) 

syntax definedFunctionDef = 
   | FUNCTION nameIR `< typeParameterListIR `> `( parameterListIR `) blockStatementIR (from definedFunctionDef) 

syntax externFunctionDef = 
   | EXTERN_FUNCTION nameIR `< typeParameterListIR `> `( parameterListIR `) (from externFunctionDef) 

syntax functionDef = 
   | FUNCTION nameIR `< typeParameterListIR `> `( parameterListIR `) blockStatementIR (from definedFunctionDef) 
   | EXTERN_FUNCTION nameIR `< typeParameterListIR `> `( parameterListIR `) (from externFunctionDef) 

syntax externMethodDef = 
   | EXTERN_METHOD nameIR `< typeParameterListIR `> `( parameterListIR `) blockStatementIR? (from externMethodDef) 
   | EXTERN_METHOD ABSTRACT nameIR `< typeParameterListIR `> `( parameterListIR `) (from externMethodDef) 

syntax parserApplyMethodDef = 
   | PARSER_APPLY `( parameterListIR `) `{ parserLocalDeclarationListIR ';' stateEnv `} (from parserApplyMethodDef) 

syntax controlApplyMethodDef = 
   | CONTROL_APPLY `( parameterListIR `) `{ controlLocalDeclarationListIR ';' actionDefEnv ';' controlBodyIR `} (from controlApplyMethodDef) 

syntax tableApplyMethodDef = 
   | TABLE_APPLY `{ tablePropertyListIR `} (from tableApplyMethodDef) 

syntax methodDef = 
   | EXTERN_METHOD nameIR `< typeParameterListIR `> `( parameterListIR `) blockStatementIR? (from externMethodDef) 
   | EXTERN_METHOD ABSTRACT nameIR `< typeParameterListIR `> `( parameterListIR `) (from externMethodDef) 
   | PARSER_APPLY `( parameterListIR `) `{ parserLocalDeclarationListIR ';' stateEnv `} (from parserApplyMethodDef) 
   | CONTROL_APPLY `( parameterListIR `) `{ controlLocalDeclarationListIR ';' actionDefEnv ';' controlBodyIR `} (from controlApplyMethodDef) 
   | TABLE_APPLY `{ tablePropertyListIR `} (from tableApplyMethodDef) 

syntax callableDef = 
   | annotationList ACTION nameIR `( parameterListIR `) blockStatementIR (from actionDef) 
   | FUNCTION nameIR `< typeParameterListIR `> `( parameterListIR `) blockStatementIR (from definedFunctionDef) 
   | EXTERN_FUNCTION nameIR `< typeParameterListIR `> `( parameterListIR `) (from externFunctionDef) 
   | EXTERN_METHOD nameIR `< typeParameterListIR `> `( parameterListIR `) blockStatementIR? (from externMethodDef) 
   | EXTERN_METHOD ABSTRACT nameIR `< typeParameterListIR `> `( parameterListIR `) (from externMethodDef) 
   | PARSER_APPLY `( parameterListIR `) `{ parserLocalDeclarationListIR ';' stateEnv `} (from parserApplyMethodDef) 
   | CONTROL_APPLY `( parameterListIR `) `{ controlLocalDeclarationListIR ';' actionDefEnv ';' controlBodyIR `} (from controlApplyMethodDef) 
   | TABLE_APPLY `{ tablePropertyListIR `} (from tableApplyMethodDef) 

def $parameterListIR_of_callableDef(callableDef) : parameterIR* =

  clause 0 : (actionDef as callableDef) = $parameterListIR_of_actionDef(actionDef)

  clause 1 : (functionDef as callableDef) = $parameterListIR_of_functionDef(functionDef)

  clause 2 : (methodDef as callableDef) = $parameterListIR_of_methodDef(methodDef)

def $parameterListIR_of_actionDef(actionDef) : parameterIR* =

  clause 0 : (annotationList ACTION _nameIR `( parameterListIR `) _blockStatementIR) = parameterListIR

def $parameterListIR_of_functionDef(functionDef) : parameterIR* =

  clause 0 : (definedFunctionDef as functionDef) = $parameterListIR_of_definedFunctionDef(definedFunctionDef)

  clause 1 : (externFunctionDef as functionDef) = $parameterListIR_of_externFunctionDef(externFunctionDef)

def $parameterListIR_of_definedFunctionDef(definedFunctionDef) : parameterIR* =

  clause 0 : (FUNCTION _nameIR `< _typeParameterListIR `> `( parameterListIR `) _blockStatementIR) = parameterListIR

def $parameterListIR_of_externFunctionDef(externFunctionDef) : parameterIR* =

  clause 0 : (EXTERN_FUNCTION _nameIR `< _typeParameterListIR `> `( parameterListIR `)) = parameterListIR

def $parameterListIR_of_methodDef(methodDef) : parameterIR* =

  clause 0 : (externMethodDef as methodDef) = $parameterListIR_of_externMethodDef(externMethodDef)

  clause 1 : (parserApplyMethodDef as methodDef) = $parameterListIR_of_parserApplyMethodDef(parserApplyMethodDef)

  clause 2 : (controlApplyMethodDef as methodDef) = $parameterListIR_of_controlApplyMethodDef(controlApplyMethodDef)

  clause 3 : (tableApplyMethodDef as methodDef) = $parameterListIR_of_tableApplyMethodDef(tableApplyMethodDef)

def $parameterListIR_of_externMethodDef(externMethodDef) : parameterIR* =

  clause 0 : (EXTERN_METHOD _nameIR `< _typeParameterListIR `> `( parameterListIR `) _blockStatementIR?{_blockStatementIR <- _blockStatementIR?}) = parameterListIR

def $parameterListIR_of_parserApplyMethodDef(parserApplyMethodDef) : parameterIR* =

  clause 0 : (PARSER_APPLY `( parameterListIR `) `{ _parserLocalDeclarationListIR ';' _stateEnv `}) = parameterListIR

def $parameterListIR_of_controlApplyMethodDef(controlApplyMethodDef) : parameterIR* =

  clause 0 : (CONTROL_APPLY `( parameterListIR `) `{ _controlLocalDeclarationListIR ';' _actionDefEnv ';' _controlBodyIR `}) = parameterListIR

def $parameterListIR_of_tableApplyMethodDef(tableApplyMethodDef) : parameterIR* =

  clause 0 : (TABLE_APPLY `{ _tablePropertyListIR `}) = []

syntax actionCallee = 
   | ACTION cursor '.' nameIR `( parameterListIR '#' id* `) blockStatementIR (from actionCallee) 

syntax definedFunctionCallee = 
   | FUNCTION nameIR `< typeParameterListIR `> `( parameterListIR '#' id* `) blockStatementIR (from definedFunctionCallee) 

syntax externFunctionCallee = 
   | EXTERN_FUNCTION nameIR `< typeParameterListIR `> `( parameterListIR '#' id* '#' id* `) (from externFunctionCallee) 

syntax functionCallee = 
   | FUNCTION nameIR `< typeParameterListIR `> `( parameterListIR '#' id* `) blockStatementIR (from definedFunctionCallee) 
   | EXTERN_FUNCTION nameIR `< typeParameterListIR `> `( parameterListIR '#' id* '#' id* `) (from externFunctionCallee) 

syntax builtinIsValidMethodCallee = 
   | BUILTIN_IS_VALID storageReference (from builtinIsValidMethodCallee) 

syntax builtinSetValidMethodCallee = 
   | BUILTIN_SET_VALID storageReference (from builtinSetValidMethodCallee) 

syntax builtinSetInvalidMethodCallee = 
   | BUILTIN_SET_INVALID storageReference (from builtinSetInvalidMethodCallee) 

syntax builtinPushFrontMethodCallee = 
   | BUILTIN_PUSH_FRONT storageReference (from builtinPushFrontMethodCallee) 

syntax builtinPopFrontMethodCallee = 
   | BUILTIN_POP_FRONT storageReference (from builtinPopFrontMethodCallee) 

syntax builtinSizeMethodCallee = 
   | BUILTIN_SIZE_OF nameIR typeIR (from builtinSizeMethodCallee) 

syntax builtinMethodCallee = 
   | BUILTIN_IS_VALID storageReference (from builtinIsValidMethodCallee) 
   | BUILTIN_SET_VALID storageReference (from builtinSetValidMethodCallee) 
   | BUILTIN_SET_INVALID storageReference (from builtinSetInvalidMethodCallee) 
   | BUILTIN_PUSH_FRONT storageReference (from builtinPushFrontMethodCallee) 
   | BUILTIN_POP_FRONT storageReference (from builtinPopFrontMethodCallee) 
   | BUILTIN_SIZE_OF nameIR typeIR (from builtinSizeMethodCallee) 

syntax externMethodCallee = 
   | EXTERN_METHOD objectId '.' nameIR `< typeParameterListIR `> `( parameterListIR '#' id* '#' id* `) `{ theta ';' frame ';' blockStatementIR? `} (from externMethodCallee) 

syntax parserApplyMethodCallee = 
   | PARSER objectId '.' APPLY `( parameterListIR '#' id* `) `{ theta ';' frame ';' parserLocalDeclarationListIR ';' stateEnv `} (from parserApplyMethodCallee) 

syntax controlApplyMethodCallee = 
   | CONTROL objectId '.' APPLY `( parameterListIR '#' id* `) `{ theta ';' frame ';' controlLocalDeclarationListIR ';' actionDefEnv ';' controlBodyIR `} (from controlApplyMethodCallee) 

syntax tableApplyMethodCallee = 
   | TABLE objectId '.' APPLY `{ frame ';' tableObjectProperty `} (from tableApplyMethodCallee) 

syntax methodCallee = 
   | BUILTIN_IS_VALID storageReference (from builtinIsValidMethodCallee) 
   | BUILTIN_SET_VALID storageReference (from builtinSetValidMethodCallee) 
   | BUILTIN_SET_INVALID storageReference (from builtinSetInvalidMethodCallee) 
   | BUILTIN_PUSH_FRONT storageReference (from builtinPushFrontMethodCallee) 
   | BUILTIN_POP_FRONT storageReference (from builtinPopFrontMethodCallee) 
   | BUILTIN_SIZE_OF nameIR typeIR (from builtinSizeMethodCallee) 
   | EXTERN_METHOD objectId '.' nameIR `< typeParameterListIR `> `( parameterListIR '#' id* '#' id* `) `{ theta ';' frame ';' blockStatementIR? `} (from externMethodCallee) 
   | PARSER objectId '.' APPLY `( parameterListIR '#' id* `) `{ theta ';' frame ';' parserLocalDeclarationListIR ';' stateEnv `} (from parserApplyMethodCallee) 
   | CONTROL objectId '.' APPLY `( parameterListIR '#' id* `) `{ theta ';' frame ';' controlLocalDeclarationListIR ';' actionDefEnv ';' controlBodyIR `} (from controlApplyMethodCallee) 
   | TABLE objectId '.' APPLY `{ frame ';' tableObjectProperty `} (from tableApplyMethodCallee) 

syntax callee = 
   | ACTION cursor '.' nameIR `( parameterListIR '#' id* `) blockStatementIR (from actionCallee) 
   | FUNCTION nameIR `< typeParameterListIR `> `( parameterListIR '#' id* `) blockStatementIR (from definedFunctionCallee) 
   | EXTERN_FUNCTION nameIR `< typeParameterListIR `> `( parameterListIR '#' id* '#' id* `) (from externFunctionCallee) 
   | BUILTIN_IS_VALID storageReference (from builtinIsValidMethodCallee) 
   | BUILTIN_SET_VALID storageReference (from builtinSetValidMethodCallee) 
   | BUILTIN_SET_INVALID storageReference (from builtinSetInvalidMethodCallee) 
   | BUILTIN_PUSH_FRONT storageReference (from builtinPushFrontMethodCallee) 
   | BUILTIN_POP_FRONT storageReference (from builtinPopFrontMethodCallee) 
   | BUILTIN_SIZE_OF nameIR typeIR (from builtinSizeMethodCallee) 
   | EXTERN_METHOD objectId '.' nameIR `< typeParameterListIR `> `( parameterListIR '#' id* '#' id* `) `{ theta ';' frame ';' blockStatementIR? `} (from externMethodCallee) 
   | PARSER objectId '.' APPLY `( parameterListIR '#' id* `) `{ theta ';' frame ';' parserLocalDeclarationListIR ';' stateEnv `} (from parserApplyMethodCallee) 
   | CONTROL objectId '.' APPLY `( parameterListIR '#' id* `) `{ theta ';' frame ';' controlLocalDeclarationListIR ';' actionDefEnv ';' controlBodyIR `} (from controlApplyMethodCallee) 
   | TABLE objectId '.' APPLY `{ frame ';' tableObjectProperty `} (from tableApplyMethodCallee) 

syntax externObjectConstructorDef = 
   | EXTERN nameIR `< typeParameterListIR `> `( constructorParameterListIR `) `{ externMethodPrototypeListIR `} (from externObjectConstructorDef) 

syntax parserObjectConstructorDef = 
   | PARSER `< typeParameterListIR `> `( parameterListIR `) `( constructorParameterListIR `) `{ parserLocalDeclarationListIR parserStateListIR `} (from parserObjectConstructorDef) 

syntax controlObjectConstructorDef = 
   | CONTROL `< typeParameterListIR `> `( parameterListIR `) `( constructorParameterListIR `) `{ controlLocalDeclarationListIR APPLY controlBodyIR `} (from controlObjectConstructorDef) 

syntax packageObjectConstructorDef = 
   | PACKAGE `< typeParameterListIR `> `( constructorParameterListIR `) (from packageObjectConstructorDef) 

syntax constructorDef = 
   | EXTERN nameIR `< typeParameterListIR `> `( constructorParameterListIR `) `{ externMethodPrototypeListIR `} (from externObjectConstructorDef) 
   | PARSER `< typeParameterListIR `> `( parameterListIR `) `( constructorParameterListIR `) `{ parserLocalDeclarationListIR parserStateListIR `} (from parserObjectConstructorDef) 
   | CONTROL `< typeParameterListIR `> `( parameterListIR `) `( constructorParameterListIR `) `{ controlLocalDeclarationListIR APPLY controlBodyIR `} (from controlObjectConstructorDef) 
   | PACKAGE `< typeParameterListIR `> `( constructorParameterListIR `) (from packageObjectConstructorDef) 

def $parameterListIR_of_constructorDef(constructorDef) : parameterIR* =

  clause 0 : (EXTERN _nameIR `< _typeParameterListIR `> `( constructorParameterListIR `) `{ _externMethodPrototypeListIR `} as constructorDef) = constructorParameterListIR

  clause 1 : (PARSER `< _typeParameterListIR `> `( _parameterListIR `) `( constructorParameterListIR `) `{ _parserLocalDeclarationListIR _parserStateListIR `} as constructorDef) = constructorParameterListIR

  clause 2 : (CONTROL `< _typeParameterListIR `> `( _parameterListIR `) `( constructorParameterListIR `) `{ _controlLocalDeclarationListIR APPLY _controlBodyIR `} as constructorDef) = constructorParameterListIR

  clause 3 : (PACKAGE `< _typeParameterListIR `> `( constructorParameterListIR `) as constructorDef) = constructorParameterListIR

extern syntax objectState

syntax externMethodDefEnv = map<callableId, externMethodDef>

extern def $init_objectState(nameIR, typeIR*, id*, value*) : objectState

syntax externObject = 
   | EXTERN typeId `< theta `> `{ objectState frame externMethodDefEnv `} (from externObject) 

syntax parserObject = 
   | PARSER `< theta `> `( parameterListIR `) `{ frame parserLocalDeclarationListIR stateEnv `} (from parserObject) 

syntax actionDefEnv = map<callableId, actionDef>

syntax controlObject = 
   | CONTROL `< theta `> `( parameterListIR `) `{ frame controlLocalDeclarationListIR actionDefEnv controlBodyIR `} (from controlObject) 

syntax packageObject = 
   | PACKAGE `< theta `> `{ frame `} (from packageObject) 

syntax tableObjectProperty = {KEYS tableKeysPropertyIR, ACTIONS tableActionsPropertyIR, DEFAULT_ACTION tableDefaultActionPropertyIR, ENTRIES tableEntriesPropertyIR, CUSTOMS tableCustomPropertyIR*}

var TBL : tableObjectProperty

syntax tableObject = 
   | TABLE typeId `{ frame tableObjectProperty `} (from tableObject) 

syntax valueSetObject = 
   | VALUE_SET `{ value* `( nat `) `} (from valueSetObject) 

syntax object = 
   | EXTERN typeId `< theta `> `{ objectState frame externMethodDefEnv `} (from externObject) 
   | PARSER `< theta `> `( parameterListIR `) `{ frame parserLocalDeclarationListIR stateEnv `} (from parserObject) 
   | CONTROL `< theta `> `( parameterListIR `) `{ frame controlLocalDeclarationListIR actionDefEnv controlBodyIR `} (from controlObject) 
   | PACKAGE `< theta `> `{ frame `} (from packageObject) 
   | TABLE typeId `{ frame tableObjectProperty `} (from tableObject) 
   | VALUE_SET `{ value* `( nat `) `} (from valueSetObject) 

syntax frame = map<id, value>

def $empty_frame : frame =

  clause 0 :  = $empty_map<id, value>

syntax stateEnv = map<id, parserStateIR>

def $empty_stateEnv : stateEnv =

  clause 0 :  = $empty_map<id, parserStateIR>

syntax callableDefEnv = map<callableId, callableDef>

def $empty_callableDefEnv : callableDefEnv =

  clause 0 :  = $empty_map<callableId, callableDef>

syntax constructorDefEnv = map<callableId, constructorDef>

def $empty_constructorDefEnv : constructorDefEnv =

  clause 0 :  = $empty_map<callableId, constructorDef>

syntax store = map<objectId, object>

var STO : store

def $empty_store : store =

  clause 0 :  = store
  -- if (store = $empty_map<objectId, object>)

def $add_store(store, objectId, object) : store =

  clause 0 : (store, objectId, object) = store'
  -- if (store' = $add_map<objectId, object>(store, objectId, object))

def $find_store(store, objectId) : object =

  clause 0 : (store, objectId) = object
  -- if (?(object) = $find_map<objectId, object>(store, objectId))

syntax globalInstLayer = {CONSTRUCTOR constructorDefEnv, TYPE typeDefEnv, CALLABLE callableDefEnv, FRAME frame}

syntax blockInstLayer = {TYPE theta, CALLABLE callableDefEnv, STATE stateEnv, FRAME frame}

syntax localInstLayer = {TYPE theta, FRAMES frame*}

syntax instContext = {PATH objectId, GLOBAL globalInstLayer, BLOCK blockInstLayer, LOCAL localInstLayer}

var IC : instContext

def $empty_instContext : instContext =

  clause 0 :  = IC
  -- if (globalInstLayer = {CONSTRUCTOR $empty_constructorDefEnv, TYPE $empty_typeDefEnv, CALLABLE $empty_callableDefEnv, FRAME $empty_frame})
  -- if (blockInstLayer = {TYPE $empty_theta, CALLABLE $empty_callableDefEnv, STATE $empty_stateEnv, FRAME $empty_frame})
  -- if (localInstLayer = {TYPE $empty_theta, FRAMES [$empty_frame]})
  -- if (IC = {PATH [], GLOBAL globalInstLayer, BLOCK blockInstLayer, LOCAL localInstLayer})

def $enter_i(instContext) : instContext =

  clause 0 : (IC) = IC[LOCAL.FRAMES = $empty_frame :: IC.LOCAL.FRAMES]

def $exit_i(instContext) : instContext =

  clause 0 : (IC) = IC[LOCAL.FRAMES = frame_t*{frame_t <- frame_t*}]
  -- if (IC.LOCAL.FRAMES = frame_h :: frame_t*{frame_t <- frame_t*})

def $enter_path_i(instContext, id) : instContext =

  clause 0 : (IC, id) = IC[PATH = IC.PATH ++ [id]]

def $inherit_i(cursor, instContext) : instContext =

  clause 0 : (GLOBAL, IC) = IC[BLOCK = blockInstLayer][LOCAL = localInstLayer]
  -- if (blockInstLayer = {TYPE $empty_theta, CALLABLE $empty_callableDefEnv, STATE $empty_stateEnv, FRAME $empty_frame})
  -- if (localInstLayer = {TYPE $empty_theta, FRAMES [$empty_frame]})

  clause 1 : (BLOCK, IC) = IC[LOCAL = localInstLayer]
  -- if (localInstLayer = {TYPE $empty_theta, FRAMES [$empty_frame]})

  clause 2 : (LOCAL, IC) = IC

def $add_var_i(cursor, instContext, id, value) : instContext =

  clause 0 : (GLOBAL, IC, id, value) = IC[GLOBAL.FRAME = frame]
  -- if ~$in_set<id>(id, $dom_map<id, value>(IC.GLOBAL.FRAME))
  -- if (frame = $add_map<id, value>(IC.GLOBAL.FRAME, id, value))

  clause 1 : (BLOCK, IC, id, value) = IC[BLOCK.FRAME = frame]
  -- if ~$in_set<id>(id, $dom_map<id, value>(IC.BLOCK.FRAME))
  -- if (frame = $add_map<id, value>(IC.BLOCK.FRAME, id, value))

  clause 2 : (LOCAL, IC, id, value) = IC[LOCAL.FRAMES = frame_h' :: frame_t*{frame_t <- frame_t*}]
  -- if (IC.LOCAL.FRAMES = frame_h :: frame_t*{frame_t <- frame_t*})
  -- if ~$in_set<id>(id, $dom_map<id, value>(frame_h))
  -- if (frame_h' = $add_map<id, value>(frame_h, id, value))

def $add_vars_i(cursor, instContext, id*, value*) : instContext =

  clause 0 : (p, IC, [], []) = IC

  clause 1 : (p, IC, id_h :: id_t*{id_t <- id_t*}, value_h :: value_t*{value_t <- value_t*}) = IC''
  -- if (IC' = $add_var_i(p, IC, id_h, value_h))
  -- if (IC'' = $add_vars_i(p, IC', id_t*{id_t <- id_t*}, value_t*{value_t <- value_t*}))

def $add_typeDef_i(cursor, instContext, typeId, typeDefIR) : instContext =

  clause 0 : (GLOBAL, IC, typeId, typeDefIR) = IC[GLOBAL.TYPE = typeDefEnv]
  -- if (typeDefEnv = $add_map<typeId, typeDefIR>(IC.GLOBAL.TYPE, typeId, typeDefIR))

def $add_parserState_i(instContext, nameIR, parserStateIR) : instContext =

  clause 0 : (IC, nameIR, parserStateIR) = IC[BLOCK.STATE = stateEnv]
  -- if ~$in_set<nameIR>(nameIR, $dom_map<nameIR, parserStateIR>(IC.BLOCK.STATE))
  -- if (stateEnv = $add_map<nameIR, parserStateIR>(IC.BLOCK.STATE, nameIR, parserStateIR))

def $add_type_i(cursor, instContext, typeId, typeIR) : instContext =

  clause 0 : (BLOCK, IC, typeId, typeIR) = IC[BLOCK.TYPE = theta]
  -- if (theta = $add_map<typeId, typeIR>(IC.BLOCK.TYPE, typeId, typeIR))

  clause 1 : (LOCAL, IC, typeId, typeIR) = IC[LOCAL.TYPE = theta]
  -- if (theta = $add_map<typeId, typeIR>(IC.LOCAL.TYPE, typeId, typeIR))

def $add_types_i(cursor, instContext, typeId*, typeIR*) : instContext =

  clause 0 : (p, IC, [], []) = IC

  clause 1 : (p, IC, typeId_h :: typeId_t*{typeId_t <- typeId_t*}, typeIR_h :: typeIR_t*{typeIR_t <- typeIR_t*}) = $add_types_i(p, IC', typeId_t*{typeId_t <- typeId_t*}, typeIR_t*{typeIR_t <- typeIR_t*})
  -- if (IC' = $add_type_i(p, IC, typeId_h, typeIR_h))

def $add_callableDef_overload_i(cursor, instContext, callableId, callableDef) : instContext =

  clause 0 : (GLOBAL, IC, callableId, callableDef) = IC[GLOBAL.CALLABLE = callableDefEnv]
  -- if ~$in_set<callableId>(callableId, $dom_map<callableId, callableDef>(IC.GLOBAL.CALLABLE))
  -- if (callableDefEnv = $add_map<callableId, callableDef>(IC.GLOBAL.CALLABLE, callableId, callableDef))

  clause 1 : (BLOCK, IC, callableId, callableDef) = IC[BLOCK.CALLABLE = callableDefEnv]
  -- if ~$in_set<callableId>(callableId, $dom_map<callableId, callableDef>(IC.BLOCK.CALLABLE))
  -- if (callableDefEnv = $add_map<callableId, callableDef>(IC.BLOCK.CALLABLE, callableId, callableDef))

def $add_callableDef_non_overload_i(cursor, instContext, callableId, callableDef) : instContext =

  clause 0 : (GLOBAL, IC, callableId, callableDef) = IC[GLOBAL.CALLABLE = callableDefEnv]
  -- if (id `( _id*{_id <- _id*} `) = callableId)
  -- if (`{ id_k `( _id'*{_id' <- _id'*} `)*{_id'* <- _id'**, id_k <- id_k*} `} = $dom_map<callableId, callableDef>(IC.GLOBAL.CALLABLE))
  -- if ~$in_set<id>(id, `{ id_k*{id_k <- id_k*} `})
  -- if (callableDefEnv = $add_map<callableId, callableDef>(IC.GLOBAL.CALLABLE, callableId, callableDef))

  clause 1 : (BLOCK, IC, callableId, callableDef) = IC[BLOCK.CALLABLE = callableDefEnv]
  -- if (id `( _id*{_id <- _id*} `) = callableId)
  -- if (`{ id_k `( _id'*{_id' <- _id'*} `)*{_id'* <- _id'**, id_k <- id_k*} `} = $dom_map<callableId, callableDef>(IC.BLOCK.CALLABLE))
  -- if ~$in_set<id>(id, `{ id_k*{id_k <- id_k*} `})
  -- if (callableDefEnv = $add_map<callableId, callableDef>(IC.BLOCK.CALLABLE, callableId, callableDef))

def $find_callableDef_non_overload_i(cursor, instContext, prefixedNameIR) : (cursor, callableId, callableDef)? =

  clause 0 : (p, IC, '.' nameIR) = ?()
  -- if (?() = $find_non_overloaded<callableDef>(IC.GLOBAL.CALLABLE, nameIR))

  clause 1 : (p, IC, '.' nameIR) = ?((GLOBAL, callableId, callableDef))
  -- if (?((callableId, callableDef)) = $find_non_overloaded<callableDef>(IC.GLOBAL.CALLABLE, nameIR))

  clause 2 : (GLOBAL, IC, _BARE nameIR) = $find_callableDef_non_overload_i(GLOBAL, IC, '.' nameIR)

  clause 3 : (BLOCK, IC, _BARE nameIR) = ?((BLOCK, callableId, callableDef))
  -- if (?((callableId, callableDef)) = $find_non_overloaded<callableDef>(IC.BLOCK.CALLABLE, nameIR))

  clause 4 : (BLOCK, IC, _BARE nameIR) = $find_callableDef_non_overload_i(GLOBAL, IC, _BARE nameIR)
  -- if (?() = $find_non_overloaded<callableDef>(IC.BLOCK.CALLABLE, nameIR))

  clause 5 : (LOCAL, IC, _BARE nameIR) = $find_callableDef_non_overload_i(BLOCK, IC, _BARE nameIR)

def $add_constructorDef_i(instContext, callableId, constructorDef) : instContext =

  clause 0 : (IC, callableId, constructorDef) = IC[GLOBAL.CONSTRUCTOR = constructorDefEnv]
  -- if (constructorDefEnv = $add_map<callableId, constructorDef>(IC.GLOBAL.CONSTRUCTOR, callableId, constructorDef))

def $add_constructorDefs_i(instContext, callableId*, constructorDef*) : instContext =

  clause 0 : (IC, [], []) = IC

  clause 1 : (IC, callableId_h :: callableId_t*{callableId_t <- callableId_t*}, constructorDef_h :: constructorDef_t*{constructorDef_t <- constructorDef_t*}) = IC''
  -- if (IC' = $add_constructorDef_i(IC, callableId_h, constructorDef_h))
  -- if (IC'' = $add_constructorDefs_i(IC', callableId_t*{callableId_t <- callableId_t*}, constructorDef_t*{constructorDef_t <- constructorDef_t*}))

def $find_var_i(prefixedNameIR, cursor, instContext) : value =

  clause 0 : ('.' id, p, IC) = value
  -- if (?(value) = $find_map<id, value>(IC.GLOBAL.FRAME, id))

  clause 1 : (_BARE id, GLOBAL, IC) = value
  -- if (?(value) = $find_map<id, value>(IC.GLOBAL.FRAME, id))

  clause 2 : (_BARE id, BLOCK, IC) = value
  -- if (?(value) = $find_map<id, value>(IC.BLOCK.FRAME, id))

  clause 3 : (_BARE id, BLOCK, IC) = $find_var_i(_BARE id, GLOBAL, IC)
  -- if (?() = $find_map<id, value>(IC.BLOCK.FRAME, id))

  clause 4 : (_BARE id, LOCAL, IC) = value
  -- if (?(value) = $find_maps<id, value>(IC.LOCAL.FRAMES, id))

  clause 5 : (_BARE id, LOCAL, IC) = $find_var_i(_BARE id, BLOCK, IC)
  -- if (?() = $find_maps<id, value>(IC.LOCAL.FRAMES, id))

def $find_typeDef_i(cursor, instContext, prefixedNameIR) : typeDefIR? =

  clause 0 : (_p, IC, _BARE nameIR) = $find_map<typeId, typeDefIR>(IC.GLOBAL.TYPE, nameIR)

  clause 1 : (_p, IC, '.' nameIR) = $find_map<typeId, typeDefIR>(IC.GLOBAL.TYPE, nameIR)

def $find_constructorDef_i(instContext, prefixedNameIR, argumentIR*) : callResolution<constructorDef>? =

  clause 0 : (IC, _BARE nameIR, argumentIR*{argumentIR <- argumentIR*}) = $find_overloaded<constructorDef>(IC.GLOBAL.CONSTRUCTOR, callTargetKey, $parameterListIR_of_constructorDef)
  -- if (callTargetKey = $callTargetKey(nameIR, argumentIR*{argumentIR <- argumentIR*}))

  clause 1 : (IC, '.' nameIR, argumentIR*{argumentIR <- argumentIR*}) = $find_overloaded<constructorDef>(IC.GLOBAL.CONSTRUCTOR, callTargetKey, $parameterListIR_of_constructorDef)
  -- if (callTargetKey = $callTargetKey(nameIR, argumentIR*{argumentIR <- argumentIR*}))

def $subst_type_i(cursor, instContext, typeIR) : typeIR =

  clause 0 : (GLOBAL, IC, typeIR) = typeIR

  clause 1 : (BLOCK, IC, typeIR) = typeIR_subst
  -- if (theta = IC.BLOCK.TYPE)
  -- if (typeIR_subst = $subst_typeIR(theta, typeIR))

  clause 2 : (LOCAL, IC, typeIR) = typeIR_subst
  -- if (theta_block = IC.BLOCK.TYPE)
  -- if (theta_local = IC.LOCAL.TYPE)
  -- if (theta = $extend_map<typeId, typeIR>(theta_block, theta_local))
  -- if (typeIR_subst = $subst_typeIR(theta, typeIR))

relation Expr_inst: cursor instContext store |- typedExpressionIR : store value

  rulegroup literalExpressionIR

    rule booleanLiteral: p IC STO |- booleanLiteral as expressionIR '#' _expressionNoteIR : STO boolValue as value
    -- if (boolValue = $ite<boolValue>((booleanLiteral = TRUE), _B true, _B false))

    rule integerLiteral: p IC STO |- integerLiteral as expressionIR '#' _expressionNoteIR : STO integerLiteral as value

    rule stringLiteral: p IC STO |- stringLiteral as expressionIR '#' _expressionNoteIR : STO stringLiteral as value

  rulegroup referenceExpressionIR

    rule referenceExpressionIR: p IC STO |- prefixedNameIR as expressionIR '#' _expressionNoteIR : STO value
    -- if (value = $find_var_i(prefixedNameIR, p, IC))

  rulegroup defaultExpressionIR

    rule defaultExpressionIR: p IC STO |- '...' as expressionIR '#' _expressionNoteIR : STO DEFAULT as value

  rulegroup unaryExpressionIR

    rule unaryExpressionIR: p IC STO_0 |- unop typedExpressionIR as expressionIR '#' _expressionNoteIR : STO_1 $un_op(unop, value)
    -- Expr_inst: p IC STO_0 |- typedExpressionIR : STO_1 value

  rulegroup binaryExpressionIR

    rule non-short-circuit: p IC STO_0 |- typedExpressionIR_l binop typedExpressionIR_r as expressionIR '#' _expressionNoteIR : STO_2 $bin_op(binop, value_l, value_r)
    -- if ~binop <- ['&&', '||']
    -- Expr_inst: p IC STO_0 |- typedExpressionIR_l : STO_1 value_l
    -- Expr_inst: p IC STO_1 |- typedExpressionIR_r : STO_2 value_r

    rule land-false: p IC STO_0 |- typedExpressionIR_l '&&' typedExpressionIR_r as expressionIR '#' _expressionNoteIR : STO_1 _B false as value
    -- Expr_inst: p IC STO_0 |- typedExpressionIR_l : STO_1 _B false as value

    rule land-true: p IC STO_0 |- typedExpressionIR_l '&&' typedExpressionIR_r as expressionIR '#' _expressionNoteIR : STO_2 value_r
    -- Expr_inst: p IC STO_0 |- typedExpressionIR_l : STO_1 _B true as value
    -- Expr_inst: p IC STO_1 |- typedExpressionIR_r : STO_2 value_r

    rule lor-true: p IC STO_0 |- typedExpressionIR_l '||' typedExpressionIR_r as expressionIR '#' _expressionNoteIR : STO_1 _B true as value
    -- Expr_inst: p IC STO_0 |- typedExpressionIR_l : STO_1 _B true as value

    rule lor-false: p IC STO_0 |- typedExpressionIR_l '||' typedExpressionIR_r as expressionIR '#' _expressionNoteIR : STO_2 value_r
    -- Expr_inst: p IC STO_0 |- typedExpressionIR_l : STO_1 _B false as value
    -- Expr_inst: p IC STO_1 |- typedExpressionIR_r : STO_2 value_r

  rulegroup ternaryExpressionIR

    rule true: p IC STO_0 |- typedExpressionIR_cond '?' typedExpressionIR_true ':' typedExpressionIR_false as expressionIR '#' _expressionNoteIR : STO_2 value_true
    -- Expr_inst: p IC STO_0 |- typedExpressionIR_cond : STO_1 _B true as value
    -- Expr_inst: p IC STO_1 |- typedExpressionIR_true : STO_2 value_true

    rule false: p IC STO_0 |- typedExpressionIR_cond '?' typedExpressionIR_true ':' typedExpressionIR_false as expressionIR '#' _expressionNoteIR : STO_2 value_false
    -- Expr_inst: p IC STO_0 |- typedExpressionIR_cond : STO_1 _B false as value
    -- Expr_inst: p IC STO_1 |- typedExpressionIR_false : STO_2 value_false

  rulegroup castExpressionIR

    rule castExpressionIR: p IC STO_0 |- `( typeIR `) typedExpressionIR as expressionIR '#' _expressionNoteIR : STO_1 value_cast
    -- Expr_inst: p IC STO_0 |- typedExpressionIR : STO_1 value
    -- if (value_cast = $cast_op(typeIR, value))

  rulegroup invalidHeaderExpressionIR

    rule invalidHeaderExpressionIR: p IC STO |- '{#}' as expressionIR '#' _expressionNoteIR : STO '{#}' as value

  rulegroup sequenceExpressionIR

    rule non-default: p IC STO_0 |- SEQ `{ typedExpressionListIR `} as expressionIR '#' _expressionNoteIR : STO_1 SEQ `( value*{value <- value*} `) as value
    -- Exprs_inst: p IC STO_0 |- typedExpressionListIR : STO_1 value*{value <- value*}

    rule default: p IC STO_0 |- SEQ `{ typedExpressionListIR ',' '...' `} as expressionIR '#' _expressionNoteIR : STO_1 SEQ `( value*{value <- value*} ',' '...' `) as value
    -- Exprs_inst: p IC STO_0 |- typedExpressionListIR : STO_1 value*{value <- value*}

  rulegroup recordExpressionIR

    rule non-default: p IC STO_0 |- RECORD `{ nameIR '=' typedExpressionIR*{nameIR <- nameIR*, typedExpressionIR <- typedExpressionIR*} `} as expressionIR '#' _expressionNoteIR : STO_1 RECORD `{ value nameIR ';'*{nameIR <- nameIR*, value <- value*} `} as value
    -- Exprs_inst: p IC STO_0 |- typedExpressionIR*{typedExpressionIR <- typedExpressionIR*} : STO_1 value*{value <- value*}

    rule default: p IC STO_0 |- RECORD `{ nameIR '=' typedExpressionIR*{nameIR <- nameIR*, typedExpressionIR <- typedExpressionIR*} ',' '...' `} as expressionIR '#' _expressionNoteIR : STO_1 RECORD `{ value nameIR ';'*{nameIR <- nameIR*, value <- value*} ',' '...' `} as value
    -- Exprs_inst: p IC STO_0 |- typedExpressionIR*{typedExpressionIR <- typedExpressionIR*} : STO_1 value*{value <- value*}

  rulegroup errorAccessExpressionIR

    rule errorAccessExpressionIR: p IC STO |- ERROR '.' nameIR as expressionIR '#' _expressionNoteIR : STO value_error
    -- if (nameIR_error = "error." ++ nameIR)
    -- if (value_error = $find_var_i(_BARE nameIR_error, p, IC))

  rulegroup memberAccessExpressionIR-type

    rule enum: p IC STO |- TYPE prefixedNameIR '.' nameIR as expressionIR '#' _expressionNoteIR : STO typeId '.' nameIR as value
    -- if (?(ENUM typeId `{ _nameIR*{_nameIR <- _nameIR*} `} as typeDefIR) = $find_typeDef_i(p, IC, prefixedNameIR))

    rule serenum: p IC STO |- TYPE prefixedNameIR '.' nameIR as expressionIR '#' _expressionNoteIR : STO typeId '.' nameIR '.' value as value
    -- if (?(ENUM typeId `< _typeIR `> `{ id_member '=' value_member ';'*{id_member <- id_member*, value_member <- value_member*} `} as typeDefIR) = $find_typeDef_i(p, IC, prefixedNameIR))
    -- if (?(value) = $assoc_<nameIR, value>(nameIR, (id_member, value_member)*{id_member <- id_member*, value_member <- value_member*}))

  rulegroup memberAccessExpressionIR-typedExpressionIR

    rule header-stack-size: p IC STO |- typedExpressionIR_base as memberAccessBaseIR '.' nameIR as expressionIR '#' _expressionNoteIR : STO 32 W n_size as int as value
    -- if (typeIR_base = $type_of_typedExpressionIR(typedExpressionIR_base))
    -- if (HEADER_STACK _typeIR `[ n_size `] as typeIR = $unroll_typeIR(typeIR_base))
    -- if (nameIR = "size")

    rule struct: p IC STO_0 |- typedExpressionIR_base as memberAccessBaseIR '.' nameIR as expressionIR '#' _expressionNoteIR : STO_1 value
    -- Expr_inst: p IC STO_0 |- typedExpressionIR_base : STO_1 structValue as value
    -- if (STRUCT _typeId `{ value_field id_field ';'*{id_field <- id_field*, value_field <- value_field*} `} = structValue)
    -- if (?(value) = $assoc_<id, value>(nameIR, (id_field, value_field)*{id_field <- id_field*, value_field <- value_field*}))

    rule header: p IC STO_0 |- typedExpressionIR_base as memberAccessBaseIR '.' nameIR as expressionIR '#' _expressionNoteIR : STO_1 value
    -- Expr_inst: p IC STO_0 |- typedExpressionIR_base : STO_1 headerValue as value
    -- if (HEADER _typeId `{ _b ';' value_field id_field ';'*{id_field <- id_field*, value_field <- value_field*} `} = headerValue)
    -- if (?(value) = $assoc_<id, value>(nameIR, (id_field, value_field)*{id_field <- id_field*, value_field <- value_field*}))

    rule header-union: p IC STO_0 |- typedExpressionIR_base as memberAccessBaseIR '.' nameIR as expressionIR '#' _expressionNoteIR : STO_1 value
    -- Expr_inst: p IC STO_0 |- typedExpressionIR_base : STO_1 headerUnionValue as value
    -- if (HEADER_UNION _typeId `{ value_field id_field ';'*{id_field <- id_field*, value_field <- value_field*} `} = headerUnionValue)
    -- if (?(value) = $assoc_<id, value>(nameIR, (id_field, value_field)*{id_field <- id_field*, value_field <- value_field*}))

  rulegroup indexAccessExpressionIR

    rule tuple: p IC STO_0 |- typedExpressionIR_base `[ typedExpressionIR_index `] as expressionIR '#' _expressionNoteIR : STO_2 value
    -- Expr_inst: p IC STO_0 |- typedExpressionIR_base : STO_1 value_base
    -- Expr_inst: p IC STO_1 |- typedExpressionIR_index : STO_2 integerValue_index as value
    -- if (TUPLE `( value_e*{value_e <- value_e*} `) as value = value_base)
    -- if (?(n_index) = $nat_of_integerValue(integerValue_index))
    -- if (n_index < |value_e*{value_e <- value_e*}|)
    -- if (value = value_e*{value_e <- value_e*}[n_index])

    rule array: p IC STO_0 |- typedExpressionIR_base `[ typedExpressionIR_index `] as expressionIR '#' _expressionNoteIR : STO_2 value
    -- Expr_inst: p IC STO_0 |- typedExpressionIR_base : STO_1 value_base
    -- Expr_inst: p IC STO_1 |- typedExpressionIR_index : STO_2 integerValue_index as value
    -- if (ARRAY `[ value_e*{value_e <- value_e*} `] as value = value_base)
    -- if (?(n_index) = $nat_of_integerValue(integerValue_index))
    -- if (n_index < |value_e*{value_e <- value_e*}|)
    -- if (value = value_e*{value_e <- value_e*}[n_index])

    rule stack: p IC STO_0 |- typedExpressionIR_base `[ typedExpressionIR_index `] as expressionIR '#' _expressionNoteIR : STO_2 value
    -- Expr_inst: p IC STO_0 |- typedExpressionIR_base : STO_1 value_base
    -- Expr_inst: p IC STO_1 |- typedExpressionIR_index : STO_2 integerValue_index as value
    -- if (HEADER_STACK `[ value_e*{value_e <- value_e*} `( _nat `) `] as value = value_base)
    -- if (?(n_index) = $nat_of_integerValue(integerValue_index))
    -- if (n_index < |value_e*{value_e <- value_e*}|)
    -- if (value = value_e*{value_e <- value_e*}[n_index])

  rulegroup sliceAccessExpressionIR

    rule range: p IC STO_0 |- typedExpressionIR_base `[ typedExpressionIR_hi ':' typedExpressionIR_lo `] as expressionIR '#' _expressionNoteIR : STO_3 $bitacc_range_op(value_base, value_hi, value_lo)
    -- Expr_inst: p IC STO_0 |- typedExpressionIR_base : STO_1 value_base
    -- Expr_inst: p IC STO_1 |- typedExpressionIR_hi : STO_2 value_hi
    -- Expr_inst: p IC STO_2 |- typedExpressionIR_lo : STO_3 value_lo

    rule offset: p IC STO_0 |- typedExpressionIR_base `[ typedExpressionIR_l '+:' typedExpressionIR_w `] as expressionIR '#' _expressionNoteIR : STO_3 $bitacc_offset_op(value_base, value_l, value_w)
    -- Expr_inst: p IC STO_0 |- typedExpressionIR_base : STO_1 value_base
    -- Expr_inst: p IC STO_1 |- typedExpressionIR_l : STO_2 value_l
    -- Expr_inst: p IC STO_2 |- typedExpressionIR_w : STO_3 value_w

  rulegroup callExpressionIR-constructor

    rule callExpressionIR-constructor: p IC STO_0 |- prefixedNameIR `< typeArgumentListIR `> `( argumentListIR `) as expressionIR '#' _expressionNoteIR : STO_2 value_ref
    -- Constructor_inst: p IC |- prefixedNameIR `< typeArgumentListIR `> `( argumentListIR `) : constructorDef `< typeArgumentListIR_inst `> `( '#' id_default*{id_default <- id_default*} '#' id_optional*{id_optional <- id_optional*} `)
    -- Constructor_call: p IC STO_0 |- constructorDef `< typeArgumentListIR_inst `> `( argumentListIR '#' id_default*{id_default <- id_default*} '#' id_optional*{id_optional <- id_optional*} `) : STO_1 object
    -- if (STO_2 = $add_store(STO_1, IC.PATH, object))
    -- if (value_ref = REF IC.PATH as value)

  rulegroup callExpressionIR-callable

    rule expression: p IC STO |- typedExpressionIR_base '.' nameIR `< _typeArgumentListIR `> `( _argumentListIR `) as expressionIR '#' _expressionNoteIR : STO $sizeof(typeIR_base, nameIR)
    -- if (_expressionIR '#' `( typeIR_base _ctk `) = typedExpressionIR_base)
    -- if nameIR <- ["minSizeInBits", "minSizeInBytes", "maxSizeInBits", "maxSizeInBytes"]

    rule type-monomorphic: p IC STO |- TYPE prefixedNameIR '.' nameIR `< _typeArgumentListIR `> `( _argumentListIR `) as expressionIR '#' _expressionNoteIR : STO $sizeof(typeIR_base, nameIR)
    -- if (?(typeDefIR_base) = $find_typeDef_i(p, IC, prefixedNameIR))
    -- if $is_monomorphic_typeDefIR(typeDefIR_base)
