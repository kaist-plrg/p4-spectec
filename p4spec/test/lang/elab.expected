    rulepath non-default
    -- let sequenceExpressionIR' = sequenceExpressionIR
    -- if sequenceExpressionIR' matches `SEQ{%}`
    -- let seq{ typedExpressionListIR } = sequenceExpressionIR'
    -- Exprs_inst: p IC STO_0 |- typedExpressionListIR : STO_1 value*{value <- value*}
    -- output: % % % |- % : STO_1 seq( value*{value <- value*} ) as value

    rulepath default
    -- let sequenceExpressionIR' = sequenceExpressionIR
    -- if sequenceExpressionIR' matches `SEQ{%,...}`
    -- let seq{ typedExpressionListIR ,...} = sequenceExpressionIR'
    -- Exprs_inst: p IC STO_0 |- typedExpressionListIR : STO_1 value*{value <- value*}
    -- output: % % % |- % : STO_1 seq( value*{value <- value*} ,...) as value

  rulegroup recordExpressionIR

   match

    (signature) p IC STO_0 |- recordExpressionIR as expressionIR # _expressionNoteIR : % %
    p IC STO_0 |- expressionIR # _expressionNoteIR : % %
    -- if expressionIR <: recordExpressionIR
    -- let recordExpressionIR = expressionIR as recordExpressionIR

   paths

    rulepath non-default
    -- let recordExpressionIR' = recordExpressionIR
    -- if recordExpressionIR' matches `RECORD{%}`
    -- let record{ nameIR = typedExpressionIR*{nameIR <- nameIR*, typedExpressionIR <- typedExpressionIR*} } = recordExpressionIR'
    -- Exprs_inst: p IC STO_0 |- typedExpressionIR*{typedExpressionIR <- typedExpressionIR*} : STO_1 value*{value <- value*}
    -- output: % % % |- % : STO_1 record{ value nameIR ;*{nameIR <- nameIR*, value <- value*} } as value

    rulepath default
    -- let recordExpressionIR' = recordExpressionIR
    -- if recordExpressionIR' matches `RECORD{%,...}`
    -- let record{ nameIR = typedExpressionIR*{nameIR <- nameIR*, typedExpressionIR <- typedExpressionIR*} ,...} = recordExpressionIR'
    -- Exprs_inst: p IC STO_0 |- typedExpressionIR*{typedExpressionIR <- typedExpressionIR*} : STO_1 value*{value <- value*}
    -- output: % % % |- % : STO_1 record{ value nameIR ;*{nameIR <- nameIR*, value <- value*} ,...} as value

  rulegroup errorAccessExpressionIR

   match

    (signature) p IC STO |- error. nameIR as expressionIR # _expressionNoteIR : % %
    p IC STO |- expressionIR # _expressionNoteIR : % %
    -- if expressionIR <: errorAccessExpressionIR
    -- let error. nameIR = expressionIR as errorAccessExpressionIR

   paths

    rulepath errorAccessExpressionIR
    -- let nameIR_error = "error." ++ nameIR
    -- let value_error = $find_var_i(` nameIR_error, p, IC)
    -- output: % % % |- % : STO value_error

  rulegroup memberAccessExpressionIR-type

   match

    (signature) p IC STO |- type prefixedNameIR . nameIR as expressionIR # _expressionNoteIR : % %
    p IC STO |- expressionIR # _expressionNoteIR : % %
    -- if expressionIR <: memberAccessExpressionIR
    -- let memberAccessBaseIR . nameIR = expressionIR as memberAccessExpressionIR
    -- if memberAccessBaseIR matches `TYPE%`
    -- let type prefixedNameIR = memberAccessBaseIR

   paths

    rulepath enum
    -- let typeDefIR'?{typeDefIR' <- typeDefIR'?} = $find_typeDef_i(p, IC, prefixedNameIR)
    -- if typeDefIR'?{typeDefIR' <- typeDefIR'?} matches (_)
    -- let ?(typeDefIR) = typeDefIR'?{typeDefIR' <- typeDefIR'?}
    -- if typeDefIR <: simpleEnumTypeIR
    -- let enum typeId { _nameIR*{_nameIR <- _nameIR*} } = typeDefIR as simpleEnumTypeIR
    -- output: % % % |- % : STO typeId . nameIR as value

    rulepath serenum
    -- let typeDefIR'?{typeDefIR' <- typeDefIR'?} = $find_typeDef_i(p, IC, prefixedNameIR)
    -- if typeDefIR'?{typeDefIR' <- typeDefIR'?} matches (_)
    -- let ?(typeDefIR) = typeDefIR'?{typeDefIR' <- typeDefIR'?}
    -- if typeDefIR <: serializableEnumTypeIR
    -- let enum typeId < _typeIR >{ id_member = value_member ;*{id_member <- id_member*, value_member <- value_member*} } = typeDefIR as serializableEnumTypeIR
