syntax callResult = 
   | EXIT (from exitResult) 
   | REJECT errorValue (from rejectTransitionResult) 
   | RETURN value? (from returnResult) 

syntax forBreakResult = 
   | BREAK (from forBreakResult) 

syntax forContinueResult = 
   | CONTINUE (from forContinueResult) 

syntax forResult = 
   | BREAK (from forBreakResult) 
   | CONTINUE (from forContinueResult) 

syntax statementResult = 
   | _EMPTY (from continueEmptyResult) 
   | EXIT (from exitResult) 
   | REJECT errorValue (from rejectTransitionResult) 
   | RETURN value? (from returnResult) 
   | BREAK (from forBreakResult) 
   | CONTINUE (from forContinueResult) 

relation Stmt_eval: cursor evalContext arch |- statementIR : evalContext arch statementResult

  rulegroup emptyStatementIR

    rule emptyStatementIR: p EC ARCH |- ';' as statementIR : EC ARCH _EMPTY as statementResult

  rulegroup assignmentStatementIR

    rule typedLvalueIR-abort: p EC_0 ARCH_0 |- typedLvalueIR assignop typedExpressionIR ';' as statementIR : EC_1 ARCH_1 abortResult as statementResult
