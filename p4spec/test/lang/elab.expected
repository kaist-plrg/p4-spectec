  -- let match id_default*{id_default <- id_default*} id_optional*{id_optional <- id_optional*} = callTargetMatch

def $find_overloaded<V>(map<callTargetId, V>, callTargetKey, $get_parameterListIR(V) : parameterListIR) : callResolution<V>? =

  clause 0 : ({ callableId : V*{V <- V*, callableId <- callableId*} }, nameIR_f ( id_arg?{id_arg <- id_arg?}*{id_arg? <- id_arg?*} ), $get_parameterListIR) = ?()
  -- if (|id_arg?{id_arg <- id_arg?}*{id_arg? <- id_arg?*}| > 0)
  -- (let id?{id <- id?} = id_arg?{id_arg <- id_arg?})*{id_arg? <- id_arg?*, id? -> id?*}
  -- (if id?{id <- id?} matches (_))*{id? <- id?*}
  -- (let ?(id_arg_inner) = id?{id <- id?})*{id? <- id?*, id_arg_inner -> id_arg_inner*}
  -- if ([] = $find_overloadeds_named<V>({ callableId : V*{V <- V*, callableId <- callableId*} }, nameIR_f ( id_arg_inner*{id_arg_inner <- id_arg_inner*} ), $get_parameterListIR))

  clause 1 : ({ callableId : V*{V <- V*, callableId <- callableId*} }, nameIR_f ( id_arg?{id_arg <- id_arg?}*{id_arg? <- id_arg?*} ), $get_parameterListIR) = ?(callableId_found : V_found # id_default*{id_default <- id_default*} # id_optional*{id_optional <- id_optional*})
  -- if (|id_arg?{id_arg <- id_arg?}*{id_arg? <- id_arg?*}| > 0)
  -- (let id?{id <- id?} = id_arg?{id_arg <- id_arg?})*{id_arg? <- id_arg?*, id? -> id?*}
  -- (if id?{id <- id?} matches (_))*{id? <- id?*}
  -- (let ?(id_arg_inner) = id?{id <- id?})*{id? <- id?*, id_arg_inner -> id_arg_inner*}
  -- let callResolution<V>*{callResolution<V> <- callResolution<V>*} = $find_overloadeds_named<V>({ callableId : V*{V <- V*, callableId <- callableId*} }, nameIR_f ( id_arg_inner*{id_arg_inner <- id_arg_inner*} ), $get_parameterListIR)
  -- if callResolution<V>*{callResolution<V> <- callResolution<V>*} matches [ _/1 ]
  -- let [callableId_found : V_found # id_default*{id_default <- id_default*} # id_optional*{id_optional <- id_optional*}] = callResolution<V>*{callResolution<V> <- callResolution<V>*}

  clause 2 : ({ callableId : V*{V <- V*, callableId <- callableId*} }, nameIR_f ( id_arg?{id_arg <- id_arg?}*{id_arg? <- id_arg?*} ), $get_parameterListIR) = ?()
  -- (if (id_arg?{id_arg <- id_arg?} = ?()))*{id_arg? <- id_arg?*}
  -- if ([] = $find_overloadeds_unnamed<V>({ callableId : V*{V <- V*, callableId <- callableId*} }, nameIR_f ( |id_arg?{id_arg <- id_arg?}*{id_arg? <- id_arg?*}| ), $get_parameterListIR))

  clause 3 : ({ callableId : V*{V <- V*, callableId <- callableId*} }, nameIR_f ( id_arg?{id_arg <- id_arg?}*{id_arg? <- id_arg?*} ), $get_parameterListIR) = ?(callableId_found : V_found # id_omitted*{id_omitted <- id_omitted*} # id_optional*{id_optional <- id_optional*})
  -- (if (id_arg?{id_arg <- id_arg?} = ?()))*{id_arg? <- id_arg?*}
  -- let callResolution<V>*{callResolution<V> <- callResolution<V>*} = $find_overloadeds_unnamed<V>({ callableId : V*{V <- V*, callableId <- callableId*} }, nameIR_f ( |id_arg?{id_arg <- id_arg?}*{id_arg? <- id_arg?*}| ), $get_parameterListIR)
  -- if callResolution<V>*{callResolution<V> <- callResolution<V>*} matches [ _/1 ]
  -- let [callableId_found : V_found # id_omitted*{id_omitted <- id_omitted*} # id_optional*{id_optional <- id_optional*}] = callResolution<V>*{callResolution<V> <- callResolution<V>*}

def $find_non_overloaded<V>(map<callableId, V>, nameIR) : (callableId, V)? =

  clause 0 : ({ callableId : V*{V <- V*, callableId <- callableId*} }, nameIR_f) = ?((callableId_found, V_found))
  -- let (callableId, V)*{(callableId, V) <- (callableId, V)*} = $find_non_overloadeds<V>({ callableId : V*{V <- V*, callableId <- callableId*} }, nameIR_f)
  -- if (callableId, V)*{(callableId, V) <- (callableId, V)*} matches [ _/1 ]
  -- let [(callableId_found, V_found)] = (callableId, V)*{(callableId, V) <- (callableId, V)*}

  clause -1 : ({ callableId : V*{V <- V*, callableId <- callableId*} }, nameIR_f) = ?()

def $find_non_overloadeds<V>(map<callableId, V>, nameIR) : (callableId, V)* =

  clause 0 : (set<pair<callableId, V>>, nameIR_f) = []
  -- if (set<pair<callableId, V>> = { [] })

  clause 1 : ({ pair<callableId, V>*{pair<callableId, V> <- pair<callableId, V>*} }, nameIR_f) = (callableId_h, V_h) :: (callableId_t_found, V_t_found)*{V_t_found <- V_t_found*, callableId_t_found <- callableId_t_found*}
  -- if pair<callableId, V>*{pair<callableId, V> <- pair<callableId, V>*} matches _ :: _
  -- let callableId_h : V_h :: callableId_t : V_t*{V_t <- V_t*, callableId_t <- callableId_t*} = pair<callableId, V>*{pair<callableId, V> <- pair<callableId, V>*}
  -- let nameIR ( _id*{_id <- _id*} ) = callableId_h
  -- if (nameIR = nameIR_f)
