relation Expr_inst: cursor instContext store |- typedExpressionIR : store value

  rulegroup literalExpressionIR

   match

    (signature) p IC STO |- expressionIR # _expressionNoteIR : % %
    p IC STO |- expressionIR # _expressionNoteIR : % %

   paths

    rulepath booleanLiteral
    -- let expressionIR' = expressionIR
    -- if expressionIR' <: booleanLiteral
    -- let booleanLiteral = expressionIR' as booleanLiteral
    -- let boolValue = $ite<boolValue>((booleanLiteral = true), `b true, `b false)
    -- output: % % % |- % : STO boolValue as value

    rulepath integerLiteral
    -- let expressionIR' = expressionIR
    -- if expressionIR' <: integerLiteral
    -- let integerLiteral = expressionIR' as integerLiteral
    -- output: % % % |- % : STO integerLiteral as value

    rulepath stringLiteral
    -- let expressionIR' = expressionIR
    -- if expressionIR' <: stringLiteral
    -- let stringLiteral = expressionIR' as stringLiteral
    -- output: % % % |- % : STO stringLiteral as value

  rulegroup referenceExpressionIR

   match

    (signature) p IC STO |- prefixedNameIR as expressionIR # _expressionNoteIR : % %
    p IC STO |- expressionIR # _expressionNoteIR : % %
    -- if expressionIR <: prefixedNameIR
    -- let prefixedNameIR = expressionIR as prefixedNameIR

   paths

    rulepath referenceExpressionIR
    -- let value = $find_var_i(prefixedNameIR, p, IC)
    -- output: % % % |- % : STO value

  rulegroup defaultExpressionIR

   match

    (signature) p IC STO |- ... as expressionIR # _expressionNoteIR : % %
    p IC STO |- expressionIR # _expressionNoteIR : % %
    -- if expressionIR <: defaultExpression
    -- let defaultExpression = expressionIR as defaultExpression
    -- if (defaultExpression = ...)

   paths

    rulepath defaultExpressionIR
    -- output: % % % |- % : STO default as value

  rulegroup unaryExpressionIR

   match

    (signature) p IC STO_0 |- unop typedExpressionIR as expressionIR # _expressionNoteIR : % %
    p IC STO_0 |- expressionIR # _expressionNoteIR : % %
    -- if expressionIR <: unaryExpressionIR
    -- let unop typedExpressionIR = expressionIR as unaryExpressionIR

   paths

    rulepath unaryExpressionIR
    -- Expr_inst: p IC STO_0 |- typedExpressionIR : STO_1 value
    -- output: % % % |- % : STO_1 $un_op(unop, value)

  rulegroup binaryExpressionIR

   match

    (signature) p IC STO_0 |- typedExpressionIR_l binop' typedExpressionIR_r as expressionIR # _expressionNoteIR : % %
    p IC STO_0 |- expressionIR # _expressionNoteIR : % %
    -- if expressionIR <: binaryExpressionIR
    -- let typedExpressionIR_l binop' typedExpressionIR_r = expressionIR as binaryExpressionIR

   paths

    rulepath non-short-circuit
    -- let binop = binop'
    -- if ~binop <- [&&, ||]
    -- Expr_inst: p IC STO_0 |- typedExpressionIR_l : STO_1 value_l
    -- Expr_inst: p IC STO_1 |- typedExpressionIR_r : STO_2 value_r
    -- output: % % % |- % : STO_2 $bin_op(binop, value_l, value_r)

    rulepath land-false
    -- if (binop' = &&)
    -- Expr_inst: p IC STO_0 |- typedExpressionIR_l : STO_1 value
    -- if (value = `b false as value)
    -- output: % % % |- % : STO_1 `b false as value

    rulepath land-true
    -- if (binop' = &&)
    -- Expr_inst: p IC STO_0 |- typedExpressionIR_l : STO_1 value
    -- if (value = `b true as value)
    -- Expr_inst: p IC STO_1 |- typedExpressionIR_r : STO_2 value_r
    -- output: % % % |- % : STO_2 value_r

    rulepath lor-true
    -- if (binop' = ||)
    -- Expr_inst: p IC STO_0 |- typedExpressionIR_l : STO_1 value
    -- if (value = `b true as value)
    -- output: % % % |- % : STO_1 `b true as value

    rulepath lor-false
    -- if (binop' = ||)
    -- Expr_inst: p IC STO_0 |- typedExpressionIR_l : STO_1 value
    -- if (value = `b false as value)
    -- Expr_inst: p IC STO_1 |- typedExpressionIR_r : STO_2 value_r
    -- output: % % % |- % : STO_2 value_r

  rulegroup ternaryExpressionIR

   match

    (signature) p IC STO_0 |- typedExpressionIR_cond ? typedExpressionIR_true : typedExpressionIR_false as expressionIR # _expressionNoteIR : % %
    p IC STO_0 |- expressionIR # _expressionNoteIR : % %
    -- if expressionIR <: ternaryExpressionIR
    -- let typedExpressionIR_cond ? typedExpressionIR_true : typedExpressionIR_false = expressionIR as ternaryExpressionIR

   paths

    rulepath true
    -- Expr_inst: p IC STO_0 |- typedExpressionIR_cond : STO_1 value
    -- if (value = `b true as value)
    -- Expr_inst: p IC STO_1 |- typedExpressionIR_true : STO_2 value_true
    -- output: % % % |- % : STO_2 value_true

    rulepath false
    -- Expr_inst: p IC STO_0 |- typedExpressionIR_cond : STO_1 value
    -- if (value = `b false as value)
    -- Expr_inst: p IC STO_1 |- typedExpressionIR_false : STO_2 value_false
    -- output: % % % |- % : STO_2 value_false

  rulegroup castExpressionIR

   match

    (signature) p IC STO_0 |- ( typeIR ) typedExpressionIR as expressionIR # _expressionNoteIR : % %
    p IC STO_0 |- expressionIR # _expressionNoteIR : % %
    -- if expressionIR <: castExpressionIR
    -- let ( typeIR ) typedExpressionIR = expressionIR as castExpressionIR

   paths

    rulepath castExpressionIR
    -- Expr_inst: p IC STO_0 |- typedExpressionIR : STO_1 value
    -- let value_cast = $cast_op(typeIR, value)
    -- output: % % % |- % : STO_1 value_cast

  rulegroup invalidHeaderExpressionIR

   match

    (signature) p IC STO |- {#} as expressionIR # _expressionNoteIR : % %
    p IC STO |- expressionIR # _expressionNoteIR : % %
    -- if expressionIR <: invalidHeaderExpression
