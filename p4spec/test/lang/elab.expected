    -- if value'?{value' <- value'?} matches (_)
    -- let ?(value) = value'?{value' <- value'?}
    -- output: % % % |- % : STO typeId . nameIR . value as value

  rulegroup memberAccessExpressionIR-typedExpressionIR

   match

    (signature) p IC store |- typedExpressionIR_base as memberAccessBaseIR . nameIR as expressionIR # _expressionNoteIR : % %
    p IC store |- expressionIR # _expressionNoteIR : % %
    -- if expressionIR <: memberAccessExpressionIR
    -- let memberAccessBaseIR . nameIR = expressionIR as memberAccessExpressionIR
    -- if memberAccessBaseIR <: typedExpressionIR
    -- let typedExpressionIR_base = memberAccessBaseIR as typedExpressionIR

   paths

    rulepath header-stack-size
    -- let STO = store
    -- let typeIR_base = $type_of_typedExpressionIR(typedExpressionIR_base)
    -- let typeIR = $unroll_typeIR(typeIR_base)
    -- if typeIR <: headerStackTypeIR
    -- let _typeIR [ n_size ] = typeIR as headerStackTypeIR
    -- if (nameIR = "size")
    -- output: % % % |- % : STO d n_size as int as value

    rulepath struct
    -- let STO_0 = store
    -- Expr_inst: p IC STO_0 |- typedExpressionIR_base : STO_1 value'
