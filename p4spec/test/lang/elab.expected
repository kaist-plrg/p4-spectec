syntax prefixedNameIR = 
   | ` nameIR hint(print %0)
   | . nameIR

def $prefixedNonTypeName(prefixedNonTypeName) : prefixedNameIR =

  clause 0 : (prefixedNonTypeName) = ` $name(nonTypeName as name)
  -- if prefixedNonTypeName <: nonTypeName
  -- let nonTypeName = prefixedNonTypeName as nonTypeName

  clause 1 : (prefixedNonTypeName) = . $name(nonTypeName as name)
  -- if prefixedNonTypeName matches ``ID.%`
  -- let `id. nonTypeName = prefixedNonTypeName

def $prefixedTypeName(prefixedTypeName) : prefixedNameIR =

  clause 0 : (prefixedTypeName) = ` $name(typeName as name)
  -- if prefixedTypeName <: typeName
  -- let typeName = prefixedTypeName as typeName

  clause 1 : (prefixedTypeName) = . $name(typeName as name)
  -- if prefixedTypeName matches ``TID.%`
  -- let `tid. typeName = prefixedTypeName

def $flatten_prefixedNameIR(prefixedNameIR) : nameIR =

  clause 0 : (prefixedNameIR) = nameIR
  -- if prefixedNameIR matches ``%`
  -- let ` nameIR = prefixedNameIR

  clause 1 : (prefixedNameIR) = "." ++ nameIR
  -- if prefixedNameIR matches `.%`
  -- let . nameIR = prefixedNameIR

syntax nameListIR = nameIR*

syntax typeParameterListIR = typeParameterIR*

syntax parameterListIR = parameterIR*

syntax constructorParameterListIR = parameterIR*

syntax namedValueIR = 
   | nameIR = value

syntax namedValueListIR = namedValueIR*

syntax namedExpressionIR = 
   | nameIR = typedExpressionIR

syntax namedExpressionListIR = namedExpressionIR*

syntax literalExpressionIR = literalExpression

syntax referenceExpressionIR = prefixedNameIR

syntax defaultExpressionIR = defaultExpression

syntax unaryExpressionIR = 
   | unop typedExpressionIR

syntax binaryExpressionIR = 
   | typedExpressionIR binop typedExpressionIR

syntax ternaryExpressionIR = 
   | typedExpressionIR ? typedExpressionIR : typedExpressionIR

syntax castExpressionIR = 
   | ( typeIR ) typedExpressionIR

syntax invalidHeaderExpressionIR = invalidHeaderExpression

syntax sequenceExpressionIR = 
   | seq{ typedExpressionListIR }
   | seq{ typedExpressionListIR ,...}

syntax recordExpressionIR = 
   | record{ namedExpressionListIR }
   | record{ namedExpressionListIR ,...}

syntax dataExpressionIR = 
   | {#}
   | seq{ typedExpressionListIR }
   | seq{ typedExpressionListIR ,...}
   | record{ namedExpressionListIR }
   | record{ namedExpressionListIR ,...}

syntax errorAccessExpressionIR = 
   | error. nameIR

syntax memberAccessExpressionIR = 
   | memberAccessBaseIR . nameIR

syntax indexAccessExpressionIR = 
   | typedExpressionIR [ typedExpressionIR ]

syntax sliceAccessExpressionIR = 
   | typedExpressionIR [ typedExpressionIR : typedExpressionIR ]

syntax accessExpressionIR = 
   | error. nameIR
   | memberAccessBaseIR . nameIR
   | typedExpressionIR [ typedExpressionIR ]
   | typedExpressionIR [ typedExpressionIR : typedExpressionIR ]

syntax callableTargetIR = 
   | ` nameIR hint(print %0)
   | . nameIR
   | typedExpressionIR . nameIR
   | type prefixedNameIR . nameIR
   | ( callableTargetIR )

syntax constructorTargetIR = 
   | prefixedNameIR < typeArgumentListIR >

syntax callExpressionIR = 
   | constructorTargetIR ( argumentListIR )
   | callableTargetIR < typeArgumentListIR >( argumentListIR )

syntax parenthesizedExpressionIR = 
   | ( typedExpressionIR )

syntax expressionIR = 
   | true
   | false
   | d int hint(print %)
   | nat w int hint(print %#W#%)
   | nat s int hint(print %#S#%)
   | " text " hint(print "#%#")
   | ` nameIR hint(print %0)
   | . nameIR
   | ...
   | unop typedExpressionIR
   | typedExpressionIR binop typedExpressionIR
   | typedExpressionIR ? typedExpressionIR : typedExpressionIR
   | ( typeIR ) typedExpressionIR
   | {#}
   | seq{ typedExpressionListIR }
   | seq{ typedExpressionListIR ,...}
   | record{ namedExpressionListIR }
   | record{ namedExpressionListIR ,...}
   | error. nameIR
   | memberAccessBaseIR . nameIR
   | typedExpressionIR [ typedExpressionIR ]
   | typedExpressionIR [ typedExpressionIR : typedExpressionIR ]
   | constructorTargetIR ( argumentListIR )
   | callableTargetIR < typeArgumentListIR >( argumentListIR )
   | ( typedExpressionIR )

syntax expressionNoteIR = 
   | ( typeIR ctk ) hint(prose "a pair of type" %0 "and compile-time known-ness" %1) hint(prose_fields "type" "compile-time known-ness")

syntax typedExpressionIR = 
   | expressionIR # expressionNoteIR hint(print %0) hint(prose %0 "annotated with" %1) hint(prose_fields "expression" "note")

syntax typedExpressionListIR = typedExpressionIR*

syntax memberAccessBaseIR = 
   | type prefixedNameIR
   | expressionIR # expressionNoteIR hint(print %0) hint(prose %0 "annotated with" %1) hint(prose_fields "expression" "note")

def $type_of_typedExpressionIR(typedExpressionIR) : typeIR =

  clause 0 : (typedExpressionIR) = typeIR
  -- let _expressionIR # ( typeIR _ctk ) = typedExpressionIR

def $ctk_of_typedExpressionIR(typedExpressionIR) : ctk =

  clause 0 : (typedExpressionIR) = ctk
  -- let _expressionIR # ( _typeIR ctk ) = typedExpressionIR

syntax simpleKeysetExpressionIR = 
   | expressionIR # expressionNoteIR hint(print %0) hint(prose %0 "annotated with" %1) hint(prose_fields "expression" "note")
   | typedExpressionIR &&& typedExpressionIR
   | typedExpressionIR .. typedExpressionIR
   | default
   | _

syntax simpleKeysetExpressionListIR = simpleKeysetExpressionIR*

syntax tupleKeysetExpressionIR = 
   | ( simpleKeysetExpressionListIR )

syntax keysetExpressionIR = 
   | expressionIR # expressionNoteIR hint(print %0) hint(prose %0 "annotated with" %1) hint(prose_fields "expression" "note")
   | typedExpressionIR &&& typedExpressionIR
   | typedExpressionIR .. typedExpressionIR
   | default
   | _
   | ( simpleKeysetExpressionListIR )

def $flatten_keysetExpressionIR(keysetExpressionIR) : simpleKeysetExpressionListIR =

  clause 0 : (keysetExpressionIR) = [simpleKeysetExpressionIR]
  -- if keysetExpressionIR <: simpleKeysetExpressionIR
  -- let simpleKeysetExpressionIR = keysetExpressionIR as simpleKeysetExpressionIR

  clause 1 : (keysetExpressionIR) = simpleKeysetExpressionListIR
  -- if keysetExpressionIR <: tupleKeysetExpressionIR
  -- let ( simpleKeysetExpressionListIR ) = keysetExpressionIR as tupleKeysetExpressionIR

syntax typeArgumentListIR = typeArgumentIR*

syntax argumentIR = 
   | expressionIR # expressionNoteIR hint(print %0) hint(prose %0 "annotated with" %1) hint(prose_fields "expression" "note")
   | nameIR = typedExpressionIR
   | nameIR =_
   | _

syntax argumentListIR = argumentIR*

syntax lvalueIR = 
   | ` nameIR hint(print %0)
   | . nameIR
   | typedLvalueIR . nameIR
   | typedLvalueIR [ typedExpressionIR ]
   | typedLvalueIR [ typedExpressionIR : typedExpressionIR ]
   | ( typedLvalueIR )

syntax lvalueNoteIR = 
   | ( typeIR )

syntax typedLvalueIR = 
   | lvalueIR # lvalueNoteIR hint(print %0) hint(prose %0 "with note" %1) hint(prose_fields "lvalue" "note")

def $type_of_typedLvalueIR(typedLvalueIR) : typeIR =

  clause 0 : (typedLvalueIR) = typeIR
  -- let _lvalueIR # ( typeIR ) = typedLvalueIR

def $typedLvalueIR_as_typedExpressionIR(typedLvalueIR) : typedExpressionIR? =

  clause 0 : (lvalueIR # ( typeIR )) = ?(referenceExpressionIR as expressionIR # ( typeIR dyn ))
  -- if lvalueIR <: referenceExpressionIR
  -- let referenceExpressionIR = lvalueIR as referenceExpressionIR

  clause 1 : (lvalueIR # ( typeIR )) = ?(typedExpressionIR as memberAccessBaseIR . nameIR as expressionIR # ( typeIR dyn ))
  -- if lvalueIR matches `%.%`
  -- let typedLvalueIR . nameIR = lvalueIR
  -- let typedExpressionIR'?{typedExpressionIR' <- typedExpressionIR'?} = $typedLvalueIR_as_typedExpressionIR(typedLvalueIR)
  -- if typedExpressionIR'?{typedExpressionIR' <- typedExpressionIR'?} matches (_)
  -- let ?(typedExpressionIR) = typedExpressionIR'?{typedExpressionIR' <- typedExpressionIR'?}

  clause 2 : (lvalueIR # ( typeIR )) = ?(typedExpressionIR_base [ typedExpressionIR_index ] as expressionIR # ( typeIR dyn ))
  -- if lvalueIR matches `%[%]`
  -- let typedLvalueIR_base [ typedExpressionIR_index ] = lvalueIR
  -- let typedExpressionIR?{typedExpressionIR <- typedExpressionIR?} = $typedLvalueIR_as_typedExpressionIR(typedLvalueIR_base)
  -- if typedExpressionIR?{typedExpressionIR <- typedExpressionIR?} matches (_)
  -- let ?(typedExpressionIR_base) = typedExpressionIR?{typedExpressionIR <- typedExpressionIR?}

  clause 3 : (lvalueIR # ( typeIR )) = ?(typedExpressionIR_base [ typedExpressionIR_hi : typedExpressionIR_lo ] as expressionIR # ( typeIR dyn ))
  -- if lvalueIR matches `%[%:%]`
  -- let typedLvalueIR_base [ typedExpressionIR_hi : typedExpressionIR_lo ] = lvalueIR
  -- let typedExpressionIR?{typedExpressionIR <- typedExpressionIR?} = $typedLvalueIR_as_typedExpressionIR(typedLvalueIR_base)
  -- if typedExpressionIR?{typedExpressionIR <- typedExpressionIR?} matches (_)
  -- let ?(typedExpressionIR_base) = typedExpressionIR?{typedExpressionIR <- typedExpressionIR?}

def $typedExpressionIR_as_typedLvalueIR(typedExpressionIR) : typedLvalueIR? =

  clause 0 : (expressionIR # ( typeIR _ctk )) = ?(referenceExpressionIR as lvalueIR # ( typeIR ))
  -- if expressionIR <: referenceExpressionIR
  -- let referenceExpressionIR = expressionIR as referenceExpressionIR

  clause 1 : (expressionIR # ( typeIR _ctk )) = ?(typedLvalueIR . nameIR # ( typeIR ))
  -- if expressionIR <: memberAccessExpressionIR
  -- let memberAccessBaseIR . nameIR = expressionIR as memberAccessExpressionIR
  -- if memberAccessBaseIR <: typedExpressionIR
  -- let typedExpressionIR = memberAccessBaseIR as typedExpressionIR
  -- let typedLvalueIR'?{typedLvalueIR' <- typedLvalueIR'?} = $typedExpressionIR_as_typedLvalueIR(typedExpressionIR)
  -- if typedLvalueIR'?{typedLvalueIR' <- typedLvalueIR'?} matches (_)
  -- let ?(typedLvalueIR) = typedLvalueIR'?{typedLvalueIR' <- typedLvalueIR'?}

  clause 2 : (expressionIR # ( typeIR _ctk )) = ?(typedLvalueIR_base [ typedExpressionIR_index ] # ( typeIR ))
  -- if expressionIR <: indexAccessExpressionIR
  -- let typedExpressionIR_base [ typedExpressionIR_index ] = expressionIR as indexAccessExpressionIR
  -- let typedLvalueIR?{typedLvalueIR <- typedLvalueIR?} = $typedExpressionIR_as_typedLvalueIR(typedExpressionIR_base)
  -- if typedLvalueIR?{typedLvalueIR <- typedLvalueIR?} matches (_)
  -- let ?(typedLvalueIR_base) = typedLvalueIR?{typedLvalueIR <- typedLvalueIR?}

  clause 3 : (expressionIR # ( typeIR _ctk )) = ?(typedLvalueIR_base [ typedExpressionIR_hi : typedExpressionIR_lo ] # ( typeIR ))
  -- if expressionIR <: sliceAccessExpressionIR
  -- let typedExpressionIR_base [ typedExpressionIR_hi : typedExpressionIR_lo ] = expressionIR as sliceAccessExpressionIR
  -- let typedLvalueIR?{typedLvalueIR <- typedLvalueIR?} = $typedExpressionIR_as_typedLvalueIR(typedExpressionIR_base)
  -- if typedLvalueIR?{typedLvalueIR <- typedLvalueIR?} matches (_)
  -- let ?(typedLvalueIR_base) = typedLvalueIR?{typedLvalueIR <- typedLvalueIR?}

  clause 4 : (expressionIR # ( typeIR _ctk )) = ?(( typedLvalueIR ) # ( typeIR ))
  -- if expressionIR <: parenthesizedExpressionIR
  -- let ( typedExpressionIR ) = expressionIR as parenthesizedExpressionIR
  -- let typedLvalueIR'?{typedLvalueIR' <- typedLvalueIR'?} = $typedExpressionIR_as_typedLvalueIR(typedExpressionIR)
  -- if typedLvalueIR'?{typedLvalueIR' <- typedLvalueIR'?} matches (_)
  -- let ?(typedLvalueIR) = typedLvalueIR'?{typedLvalueIR' <- typedLvalueIR'?}

syntax emptyStatementIR = emptyStatement

syntax assignmentStatementIR = 
   | typedLvalueIR assignop typedExpressionIR ;

syntax callStatementIR = 
   | callableTargetIR < typeArgumentListIR >( argumentListIR );

syntax directApplicationStatementIR = 
   | constructorTargetIR .apply( argumentListIR );

syntax returnStatementIR = 
   | return;
   | return typedExpressionIR ;

syntax exitStatementIR = exitStatement

syntax blockStatementIR = 
   | annotationList { blockElementStatementListIR }

syntax conditionalStatementIR = 
   | if( typedExpressionIR ) statementIR
   | if( typedExpressionIR ) statementIR else statementIR

syntax forUpdateStatementIR = 
   | callableTargetIR < typeArgumentListIR >( argumentListIR )
   | typedLvalueIR assignop typedExpressionIR

syntax forUpdateStatementListIR = forUpdateStatementIR*

syntax forInitStatementIR = 
   | annotationList typeIR nameIR initializerOptIR
   | callableTargetIR < typeArgumentListIR >( argumentListIR )
   | typedLvalueIR assignop typedExpressionIR

syntax forInitStatementListIR = forInitStatementIR*

syntax forCollectionExpressionIR = 
   | expressionIR # expressionNoteIR hint(print %0) hint(prose %0 "annotated with" %1) hint(prose_fields "expression" "note")
   | typedExpressionIR .. typedExpressionIR

syntax forStatementIR = 
   | annotationList for( forInitStatementListIR ; typedExpressionIR ; forUpdateStatementListIR ) statementIR
   | annotationList for( typeIR nameIR in forCollectionExpressionIR ) statementIR
   | annotationList for( annotationList typeIR nameIR in forCollectionExpressionIR ) statementIR

syntax switchLabelIR = 
   | default
   | expressionIR # expressionNoteIR hint(print %0) hint(prose %0 "annotated with" %1) hint(prose_fields "expression" "note")

syntax switchCaseIR = 
   | switchLabelIR : blockStatementIR
   | switchLabelIR :

syntax switchCaseListIR = switchCaseIR*

syntax switchStatementIR = 
   | switch( typedExpressionIR ){ switchCaseListIR }

syntax breakStatementIR = breakStatement

syntax continueStatementIR = continueStatement

syntax statementIR = 
   | ;
   | typedLvalueIR assignop typedExpressionIR ;
   | callableTargetIR < typeArgumentListIR >( argumentListIR );
   | constructorTargetIR .apply( argumentListIR );
   | return;
   | return typedExpressionIR ;
   | exit;
   | annotationList { blockElementStatementListIR }
   | if( typedExpressionIR ) statementIR
   | if( typedExpressionIR ) statementIR else statementIR
   | annotationList for( forInitStatementListIR ; typedExpressionIR ; forUpdateStatementListIR ) statementIR
   | annotationList for( typeIR nameIR in forCollectionExpressionIR ) statementIR
   | annotationList for( annotationList typeIR nameIR in forCollectionExpressionIR ) statementIR
   | break;
   | continue;
   | switch( typedExpressionIR ){ switchCaseListIR }

syntax constantDeclarationIR = 
   | annotationList const typeIR nameIR constantInitializerIR ;

syntax initializerOptIR = initializerIR?

syntax variableDeclarationIR = 
   | annotationList typeIR nameIR initializerOptIR ;

syntax blockElementStatementIR = 
   | annotationList const typeIR nameIR constantInitializerIR ;
   | annotationList typeIR nameIR initializerOptIR ;
   | ;
   | typedLvalueIR assignop typedExpressionIR ;
   | callableTargetIR < typeArgumentListIR >( argumentListIR );
   | constructorTargetIR .apply( argumentListIR );
   | return;
   | return typedExpressionIR ;
   | exit;
   | annotationList { blockElementStatementListIR }
   | if( typedExpressionIR ) statementIR
   | if( typedExpressionIR ) statementIR else statementIR
   | annotationList for( forInitStatementListIR ; typedExpressionIR ; forUpdateStatementListIR ) statementIR
   | annotationList for( typeIR nameIR in forCollectionExpressionIR ) statementIR
   | annotationList for( annotationList typeIR nameIR in forCollectionExpressionIR ) statementIR
   | break;
   | continue;
   | switch( typedExpressionIR ){ switchCaseListIR }

syntax blockElementStatementListIR = blockElementStatementIR*

syntax functionPrototypeIR = 
   | typeIR nameIR < typeParameterListIR , typeParameterListIR >( parameterListIR )

syntax functionDeclarationIR = 
   | annotationList functionPrototypeIR blockStatementIR

syntax actionDeclarationIR = 
   | annotationList action nameIR ( parameterListIR ) blockStatementIR

syntax objectInitializerIR = 
   | ={ objectDeclarationListIR }

syntax objectInitializerOptIR = objectInitializerIR?

syntax instantiationIR = 
   | annotationList typeIR constructorTargetIR ( argumentListIR ) nameIR objectInitializerOptIR ; hint(prose_fields "annotations" "type" "constructor target" "arguments" "name" "object initializer")

syntax objectDeclarationIR = 
   | annotationList functionPrototypeIR blockStatementIR
   | annotationList typeIR constructorTargetIR ( argumentListIR ) nameIR objectInitializerOptIR ; hint(prose_fields "annotations" "type" "constructor target" "arguments" "name" "object initializer")

syntax objectDeclarationListIR = objectDeclarationIR*

def $flatten_objectInitializerOptIR(objectInitializerOptIR) : objectDeclarationListIR =

  clause 0 : (objectInitializerIR?{objectInitializerIR <- objectInitializerIR?}) = []
  -- if objectInitializerIR?{objectInitializerIR <- objectInitializerIR?} matches ()

  clause 1 : (objectInitializerOptIR) = objectDeclarationListIR
  -- if objectInitializerOptIR matches (_)
  -- let ?(={ objectDeclarationListIR }) = objectInitializerOptIR

syntax errorDeclarationIR = 
   | error{ nameListIR }

syntax matchKindDeclarationIR = 
   | match_kind{ nameListIR }

syntax enumTypeDeclarationIR = 
   | annotationList enum nameIR { nameListIR }
   | annotationList enum typeIR nameIR { namedValueListIR }

syntax typeFieldIR = 
   | annotationList typeIR nameIR ;

syntax typeFieldListIR = typeFieldIR*

syntax structTypeDeclarationIR = 
   | annotationList struct nameIR < typeParameterListIR >{ typeFieldListIR }

syntax headerTypeDeclarationIR = 
   | annotationList header nameIR < typeParameterListIR >{ typeFieldListIR }

syntax headerUnionTypeDeclarationIR = 
   | annotationList header_union nameIR < typeParameterListIR >{ typeFieldListIR }

syntax derivedTypeDeclarationIR = 
   | annotationList enum nameIR { nameListIR }
   | annotationList enum typeIR nameIR { namedValueListIR }
   | annotationList struct nameIR < typeParameterListIR >{ typeFieldListIR }
   | annotationList header nameIR < typeParameterListIR >{ typeFieldListIR }
   | annotationList header_union nameIR < typeParameterListIR >{ typeFieldListIR }

syntax typedefIR = 
   | void
   | bool
   | error
   | match_kind
   | string
   | int
   | int< nat >
   | bit< nat >
   | varbit< nat >
   | ` typeId hint(print %0)
   | typedef typeId typeIR hint(print %0)
   | type typeId typeIR hint(print %0)
   | list< typeIR >
   | tuple< typeIR* >
   | typeIR [ nat ]
   | struct typeId < typeArgumentIR* >{ fieldTypeIR* } hint(print %0#"<"#%1#">")
   | header typeId < typeArgumentIR* >{ fieldTypeIR* } hint(print %0#"<"#%1#">")
   | header_union typeId < typeArgumentIR* >{ fieldTypeIR* } hint(print %0#"<"#%1#">")
   | enum typeId { nameIR* } hint(print %0)
   | enum typeId < typeIR >{ valueFieldIR* } hint(print %0)
   | extern typeId < typeArgumentIR* > externMethodTypeDefEnv hint(print %0#"<"#%1#">")
   | parser typeId < typeArgumentIR* >( parameterIR* ) hint(print %0#"<"#%1#">")
   | control typeId < typeArgumentIR* >( parameterIR* ) hint(print %0#"<"#%1#">")
   | package typeId < typeArgumentIR* >{ typeIR* } hint(print %0#"<"#%1#">")
   | table typeId { tableMetadataStructTypeIR } hint(print %0)
   | default
   | header_invalid
   | seq< typeIR* >
   | seq< typeIR* ,...>
   | record{ fieldTypeIR* }
   | record{ fieldTypeIR* ,...}
   | set< typeIR >
   | table_enum typeId { nameIR* } hint(print %0)
   | table_struct typeId {hit boolTypeIR ;miss boolTypeIR ;action_run tableMetadataEnumTypeIR ;} hint(print %0)
   | annotationList enum nameIR { nameListIR }
   | annotationList enum typeIR nameIR { namedValueListIR }
   | annotationList struct nameIR < typeParameterListIR >{ typeFieldListIR }
   | annotationList header nameIR < typeParameterListIR >{ typeFieldListIR }
   | annotationList header_union nameIR < typeParameterListIR >{ typeFieldListIR }

syntax typedefDeclarationIR = 
   | annotationList typedef typedefIR nameIR ;
   | annotationList type typeIR nameIR ;

syntax externFunctionDeclarationIR = 
   | annotationList extern functionPrototypeIR ;

syntax externConstructorPrototypeIR = 
   | annotationList nameIR <, typeParameterListIR >( parameterListIR );

syntax externConstructorPrototypeListIR = externConstructorPrototypeIR*

syntax externMethodPrototypeIR = 
   | annotationList functionPrototypeIR ;
   | annotationList abstract functionPrototypeIR ;

syntax externMethodPrototypeListIR = externMethodPrototypeIR*

syntax externObjectDeclarationIR = 
   | annotationList extern nameIR < typeParameterListIR ,>{ externConstructorPrototypeListIR externMethodPrototypeListIR }

syntax externDeclarationIR = 
   | annotationList extern functionPrototypeIR ;
   | annotationList extern nameIR < typeParameterListIR ,>{ externConstructorPrototypeListIR externMethodPrototypeListIR }

syntax selectCaseIR = 
   | keysetExpressionIR : nameIR ;

syntax selectCaseListIR = selectCaseIR*

syntax selectExpressionIR = 
   | select( typedExpressionListIR ){ selectCaseListIR }

syntax stateExpressionIR = 
   | nameIR ;
   | select( typedExpressionListIR ){ selectCaseListIR }

syntax transitionStatementIR = 
   | transition stateExpressionIR

syntax valueSetDeclarationIR = 
   | annotationList value_set< typeIR >( typedExpressionIR ) nameIR ;

syntax parserTypeDeclarationIR = 
   | annotationList parser nameIR < typeParameterListIR , typeParameterListIR >( parameterListIR );

syntax parserBlockStatementIR = 
   | annotationList { parserStatementListIR }

syntax parserConditionalStatementIR = 
   | if( typedExpressionIR ) parserStatementIR
   | if( typedExpressionIR ) parserStatementIR else parserStatementIR

syntax parserStatementIR = 
   | annotationList const typeIR nameIR constantInitializerIR ;
   | annotationList typeIR nameIR initializerOptIR ;
   | ;
   | typedLvalueIR assignop typedExpressionIR ;
   | callableTargetIR < typeArgumentListIR >( argumentListIR );
   | constructorTargetIR .apply( argumentListIR );
   | annotationList { parserStatementListIR }
   | if( typedExpressionIR ) parserStatementIR
   | if( typedExpressionIR ) parserStatementIR else parserStatementIR

syntax parserStatementListIR = parserStatementIR*

syntax parserStateIR = 
   | annotationList state nameIR { parserStatementListIR transitionStatementIR }

syntax parserStateListIR = parserStateIR*

syntax parserLocalDeclarationIR = 
   | annotationList const typeIR nameIR constantInitializerIR ;
   | annotationList typeIR constructorTargetIR ( argumentListIR ) nameIR objectInitializerOptIR ; hint(prose_fields "annotations" "type" "constructor target" "arguments" "name" "object initializer")
   | annotationList typeIR nameIR initializerOptIR ;
   | annotationList value_set< typeIR >( typedExpressionIR ) nameIR ;

syntax parserLocalDeclarationListIR = parserLocalDeclarationIR*

syntax parserDeclarationIR = 
   | annotationList parser nameIR < typeParameterListIR , typeParameterListIR >( parameterListIR )( constructorParameterListIR ){ parserLocalDeclarationListIR parserStateListIR }

syntax constIR = const

syntax constOptIR = constIR?

syntax tableKeyIR = 
   | typedExpressionIR : nameIR annotationList ;

syntax tableKeyListIR = tableKeyIR*

syntax tableActionReferenceIR = 
   | prefixedNameIR ( argumentListIR )

syntax tableActionIR = 
   | annotationList tableActionReferenceIR #( parameterListIR , parameterListIR );

syntax tableActionListIR = tableActionIR*

syntax tableEntryPriorityIR = 
   | priority= integerLiteral :

syntax tableEntryPriorityOptIR = tableEntryPriorityIR?

syntax tableEntryIR = 
   | constOptIR tableEntryPriorityOptIR keysetExpressionIR : tableActionReferenceIR annotationList ;

syntax tableEntryListIR = tableEntryIR*

syntax tableKeysPropertyIR = 
   | key={ tableKeyListIR }

syntax tableActionsPropertyIR = 
   | actions={ tableActionListIR }

syntax tableDefaultActionPropertyIR = 
   | annotationList constOptIR default_action= tableActionReferenceIR ;

syntax tableEntriesPropertyIR = 
   | annotationList constOptIR entries={ tableEntryListIR }

syntax tableCustomPropertyIR = 
   | annotationList constOptIR custom nameIR initializerIR ;
   | annotationList constOptIR custom_const nameIR constantInitializerIR ;

syntax tablePropertyIR = 
   | key={ tableKeyListIR }
   | actions={ tableActionListIR }
   | annotationList constOptIR default_action= tableActionReferenceIR ;
   | annotationList constOptIR entries={ tableEntryListIR }
   | annotationList constOptIR custom nameIR initializerIR ;
   | annotationList constOptIR custom_const nameIR constantInitializerIR ;

syntax tablePropertyListIR = tablePropertyIR*

syntax tableDeclarationIR = 
   | annotationList table typeIR nameIR { tablePropertyListIR } hint(print %0 TABLE %2 `{%3})

syntax controlTypeDeclarationIR = 
   | annotationList control nameIR < typeParameterListIR , typeParameterListIR >( parameterListIR );

syntax controlBodyIR = blockStatementIR

syntax controlLocalDeclarationIR = 
   | annotationList const typeIR nameIR constantInitializerIR ;
   | annotationList typeIR constructorTargetIR ( argumentListIR ) nameIR objectInitializerOptIR ; hint(prose_fields "annotations" "type" "constructor target" "arguments" "name" "object initializer")
   | annotationList typeIR nameIR initializerOptIR ;
   | annotationList action nameIR ( parameterListIR ) blockStatementIR
   | annotationList table typeIR nameIR { tablePropertyListIR } hint(print %0 TABLE %2 `{%3})

syntax controlLocalDeclarationListIR = controlLocalDeclarationIR*

syntax controlDeclarationIR = 
   | annotationList control nameIR < typeParameterListIR , typeParameterListIR >( parameterListIR )( constructorParameterListIR ){ controlLocalDeclarationListIR apply controlBodyIR }

syntax packageTypeDeclarationIR = 
   | annotationList package nameIR < typeParameterListIR , typeParameterListIR >( parameterListIR );

syntax typeDeclarationIR = 
   | annotationList enum nameIR { nameListIR }
   | annotationList enum typeIR nameIR { namedValueListIR }
   | annotationList struct nameIR < typeParameterListIR >{ typeFieldListIR }
   | annotationList header nameIR < typeParameterListIR >{ typeFieldListIR }
   | annotationList header_union nameIR < typeParameterListIR >{ typeFieldListIR }
   | annotationList typedef typedefIR nameIR ;
   | annotationList type typeIR nameIR ;
   | annotationList parser nameIR < typeParameterListIR , typeParameterListIR >( parameterListIR );
   | annotationList control nameIR < typeParameterListIR , typeParameterListIR >( parameterListIR );
   | annotationList package nameIR < typeParameterListIR , typeParameterListIR >( parameterListIR );

syntax declarationIR = 
   | annotationList const typeIR nameIR constantInitializerIR ;
   | annotationList typeIR constructorTargetIR ( argumentListIR ) nameIR objectInitializerOptIR ; hint(prose_fields "annotations" "type" "constructor target" "arguments" "name" "object initializer")
   | annotationList functionPrototypeIR blockStatementIR
   | annotationList action nameIR ( parameterListIR ) blockStatementIR
   | error{ nameListIR }
   | match_kind{ nameListIR }
   | annotationList extern functionPrototypeIR ;
   | annotationList extern nameIR < typeParameterListIR ,>{ externConstructorPrototypeListIR externMethodPrototypeListIR }
   | annotationList parser nameIR < typeParameterListIR , typeParameterListIR >( parameterListIR )( constructorParameterListIR ){ parserLocalDeclarationListIR parserStateListIR }
   | annotationList control nameIR < typeParameterListIR , typeParameterListIR >( parameterListIR )( constructorParameterListIR ){ controlLocalDeclarationListIR apply controlBodyIR }
   | annotationList enum nameIR { nameListIR }
   | annotationList enum typeIR nameIR { namedValueListIR }
   | annotationList struct nameIR < typeParameterListIR >{ typeFieldListIR }
   | annotationList header nameIR < typeParameterListIR >{ typeFieldListIR }
   | annotationList header_union nameIR < typeParameterListIR >{ typeFieldListIR }
   | annotationList typedef typedefIR nameIR ;
   | annotationList type typeIR nameIR ;
   | annotationList parser nameIR < typeParameterListIR , typeParameterListIR >( parameterListIR );
   | annotationList control nameIR < typeParameterListIR , typeParameterListIR >( parameterListIR );
   | annotationList package nameIR < typeParameterListIR , typeParameterListIR >( parameterListIR );

syntax p4programIR = 
   | declarationIR* ;

def $partition_parameterListIR(parameterIR*, nameIR*, nameIR*) : (parameterIR*, parameterIR*, parameterIR*) =

  clause 0 : (parameterIR*{parameterIR <- parameterIR*}, _nameIR*{_nameIR <- _nameIR*}, _nameIR'*{_nameIR' <- _nameIR'*}) = ([], [], [])
  -- if parameterIR*{parameterIR <- parameterIR*} matches []

  clause 1 : (parameterIR*{parameterIR <- parameterIR*}, nameIR_default*{nameIR_default <- nameIR_default*}, nameIR_optional*{nameIR_optional <- nameIR_optional*}) = (parameterIR_given*{parameterIR_given <- parameterIR_given*}, parameterIR_h :: parameterIR_default*{parameterIR_default <- parameterIR_default*}, parameterIR_optional*{parameterIR_optional <- parameterIR_optional*})
  -- if parameterIR*{parameterIR <- parameterIR*} matches _ :: _
  -- let parameterIR_h :: parameterIR_t*{parameterIR_t <- parameterIR_t*} = parameterIR*{parameterIR <- parameterIR*}
  -- let (parameterIR_given*{parameterIR_given <- parameterIR_given*}, parameterIR_default*{parameterIR_default <- parameterIR_default*}, parameterIR_optional*{parameterIR_optional <- parameterIR_optional*}) = $partition_parameterListIR(parameterIR_t*{parameterIR_t <- parameterIR_t*}, nameIR_default*{nameIR_default <- nameIR_default*}, nameIR_optional*{nameIR_optional <- nameIR_optional*})
  -- let _annotationList _direction _typeIR nameIR_h _parameterInitializerOptIR = parameterIR_h
  -- if nameIR_h <- nameIR_default*{nameIR_default <- nameIR_default*}

  clause 2 : (parameterIR*{parameterIR <- parameterIR*}, nameIR_default*{nameIR_default <- nameIR_default*}, nameIR_optional*{nameIR_optional <- nameIR_optional*}) = (parameterIR_given*{parameterIR_given <- parameterIR_given*}, parameterIR_default*{parameterIR_default <- parameterIR_default*}, parameterIR_h :: parameterIR_optional*{parameterIR_optional <- parameterIR_optional*})
  -- if parameterIR*{parameterIR <- parameterIR*} matches _ :: _
  -- let parameterIR_h :: parameterIR_t*{parameterIR_t <- parameterIR_t*} = parameterIR*{parameterIR <- parameterIR*}
  -- let (parameterIR_given*{parameterIR_given <- parameterIR_given*}, parameterIR_default*{parameterIR_default <- parameterIR_default*}, parameterIR_optional*{parameterIR_optional <- parameterIR_optional*}) = $partition_parameterListIR(parameterIR_t*{parameterIR_t <- parameterIR_t*}, nameIR_default*{nameIR_default <- nameIR_default*}, nameIR_optional*{nameIR_optional <- nameIR_optional*})
  -- let _annotationList _direction _typeIR nameIR_h _parameterInitializerOptIR = parameterIR_h
  -- if nameIR_h <- nameIR_optional*{nameIR_optional <- nameIR_optional*}

  clause 3 : (parameterIR*{parameterIR <- parameterIR*}, nameIR_default*{nameIR_default <- nameIR_default*}, nameIR_optional*{nameIR_optional <- nameIR_optional*}) = (parameterIR_h :: parameterIR_given*{parameterIR_given <- parameterIR_given*}, parameterIR_default*{parameterIR_default <- parameterIR_default*}, parameterIR_optional*{parameterIR_optional <- parameterIR_optional*})
  -- if parameterIR*{parameterIR <- parameterIR*} matches _ :: _
  -- let parameterIR_h :: parameterIR_t*{parameterIR_t <- parameterIR_t*} = parameterIR*{parameterIR <- parameterIR*}
  -- let (parameterIR_given*{parameterIR_given <- parameterIR_given*}, parameterIR_default*{parameterIR_default <- parameterIR_default*}, parameterIR_optional*{parameterIR_optional <- parameterIR_optional*}) = $partition_parameterListIR(parameterIR_t*{parameterIR_t <- parameterIR_t*}, nameIR_default*{nameIR_default <- nameIR_default*}, nameIR_optional*{nameIR_optional <- nameIR_optional*})
  -- let _annotationList _direction _typeIR nameIR_h _parameterInitializerOptIR = parameterIR_h
  -- if ~nameIR_h <- nameIR_default*{nameIR_default <- nameIR_default*}
  -- if ~nameIR_h <- nameIR_optional*{nameIR_optional <- nameIR_optional*}

syntax callAlign = 
   | given parameterIR* default parameterIR*

def $align_parameterListIR(parameterIR*, argumentIR*, nameIR*, nameIR*) : callAlign =

  clause 0 : (parameterIR*{parameterIR <- parameterIR*}, argumentIR*{argumentIR <- argumentIR*}, nameIR_default*{nameIR_default <- nameIR_default*}, nameIR_optional*{nameIR_optional <- nameIR_optional*}) = given parameterIR_given_aligned*{parameterIR_given_aligned <- parameterIR_given_aligned*} default parameterIR_default*{parameterIR_default <- parameterIR_default*}
  -- let (parameterIR_given*{parameterIR_given <- parameterIR_given*}, parameterIR_default*{parameterIR_default <- parameterIR_default*}, parameterIR_optional*{parameterIR_optional <- parameterIR_optional*}) = $partition_parameterListIR(parameterIR*{parameterIR <- parameterIR*}, nameIR_default*{nameIR_default <- nameIR_default*}, nameIR_optional*{nameIR_optional <- nameIR_optional*})
  -- (let _annotationList _direction _typeIR nameIR_given _parameterInitializerOptIR = parameterIR_given)*{parameterIR_given <- parameterIR_given*, _annotationList -> _annotationList*, _direction -> _direction*, _parameterInitializerOptIR -> _parameterInitializerOptIR*, _typeIR -> _typeIR*, nameIR_given -> nameIR_given*}
  -- let parameterIR_given_aligned*{parameterIR_given_aligned <- parameterIR_given_aligned*} = $align_parameterListIR_given({ nameIR_given : parameterIR_given*{nameIR_given <- nameIR_given*, parameterIR_given <- parameterIR_given*} }, parameterIR_given*{parameterIR_given <- parameterIR_given*}, argumentIR*{argumentIR <- argumentIR*})

def $align_parameterListIR_given(map<id, parameterIR>, parameterIR*, argumentIR*) : parameterIR* =

  clause 0 : ({ id : parameterIR*{id <- id*, parameterIR <- parameterIR*} }, parameterIR'*{parameterIR' <- parameterIR'*}, argumentIR*{argumentIR <- argumentIR*}) = []
  -- if parameterIR'*{parameterIR' <- parameterIR'*} matches []
  -- if argumentIR*{argumentIR <- argumentIR*} matches []

  clause 1 : ({ id : parameterIR*{id <- id*, parameterIR <- parameterIR*} }, parameterIR'*{parameterIR' <- parameterIR'*}, argumentIR*{argumentIR <- argumentIR*}) = parameterIR_h :: parameterIR_aligned*{parameterIR_aligned <- parameterIR_aligned*}
  -- if parameterIR'*{parameterIR' <- parameterIR'*} matches _ :: _
  -- let parameterIR_h :: parameterIR_t*{parameterIR_t <- parameterIR_t*} = parameterIR'*{parameterIR' <- parameterIR'*}
  -- if argumentIR*{argumentIR <- argumentIR*} matches _ :: _
  -- let argumentIR_h :: argumentIR_t*{argumentIR_t <- argumentIR_t*} = argumentIR*{argumentIR <- argumentIR*}
  -- let argumentIR' = argumentIR_h
  -- if argumentIR' <: typedExpressionIR
  -- let typedExpressionIR = argumentIR' as typedExpressionIR
  -- let parameterIR_aligned*{parameterIR_aligned <- parameterIR_aligned*} = $align_parameterListIR_given({ id : parameterIR*{id <- id*, parameterIR <- parameterIR*} }, parameterIR_t*{parameterIR_t <- parameterIR_t*}, argumentIR_t*{argumentIR_t <- argumentIR_t*})

  clause 2 : ({ id : parameterIR*{id <- id*, parameterIR <- parameterIR*} }, parameterIR'*{parameterIR' <- parameterIR'*}, argumentIR*{argumentIR <- argumentIR*}) = parameterIR_h :: parameterIR_aligned*{parameterIR_aligned <- parameterIR_aligned*}
  -- if parameterIR'*{parameterIR' <- parameterIR'*} matches _ :: _
  -- let parameterIR_h :: parameterIR_t*{parameterIR_t <- parameterIR_t*} = parameterIR'*{parameterIR' <- parameterIR'*}
  -- if argumentIR*{argumentIR <- argumentIR*} matches _ :: _
  -- let argumentIR_h :: argumentIR_t*{argumentIR_t <- argumentIR_t*} = argumentIR*{argumentIR <- argumentIR*}
  -- if (argumentIR_h = _)
  -- let parameterIR_aligned*{parameterIR_aligned <- parameterIR_aligned*} = $align_parameterListIR_given({ id : parameterIR*{id <- id*, parameterIR <- parameterIR*} }, parameterIR_t*{parameterIR_t <- parameterIR_t*}, argumentIR_t*{argumentIR_t <- argumentIR_t*})

  clause 3 : ({ id : parameterIR*{id <- id*, parameterIR <- parameterIR*} }, parameterIR'*{parameterIR' <- parameterIR'*}, argumentIR*{argumentIR <- argumentIR*}) = parameterIR_match :: parameterIR_aligned*{parameterIR_aligned <- parameterIR_aligned*}
  -- if parameterIR'*{parameterIR' <- parameterIR'*} matches _ :: _
  -- let parameterIR_h :: parameterIR_t*{parameterIR_t <- parameterIR_t*} = parameterIR'*{parameterIR' <- parameterIR'*}
  -- if argumentIR*{argumentIR <- argumentIR*} matches _ :: _
  -- let argumentIR_h :: argumentIR_t*{argumentIR_t <- argumentIR_t*} = argumentIR*{argumentIR <- argumentIR*}
  -- let argumentIR' = argumentIR_h
  -- if argumentIR' matches `%=%`
  -- let nameIR = _typedExpressionIR = argumentIR'
  -- let parameterIR''?{parameterIR'' <- parameterIR''?} = $find_map<id, parameterIR>({ id : parameterIR*{id <- id*, parameterIR <- parameterIR*} }, nameIR)
  -- if parameterIR''?{parameterIR'' <- parameterIR''?} matches (_)
  -- let ?(parameterIR_match) = parameterIR''?{parameterIR'' <- parameterIR''?}
  -- let parameterIR_aligned*{parameterIR_aligned <- parameterIR_aligned*} = $align_parameterListIR_given({ id : parameterIR*{id <- id*, parameterIR <- parameterIR*} }, parameterIR_t*{parameterIR_t <- parameterIR_t*}, argumentIR_t*{argumentIR_t <- argumentIR_t*})

  clause 4 : ({ id : parameterIR*{id <- id*, parameterIR <- parameterIR*} }, parameterIR'*{parameterIR' <- parameterIR'*}, argumentIR*{argumentIR <- argumentIR*}) = parameterIR_match :: parameterIR_aligned*{parameterIR_aligned <- parameterIR_aligned*}
  -- if parameterIR'*{parameterIR' <- parameterIR'*} matches _ :: _
  -- let parameterIR_h :: parameterIR_t*{parameterIR_t <- parameterIR_t*} = parameterIR'*{parameterIR' <- parameterIR'*}
  -- if argumentIR*{argumentIR <- argumentIR*} matches _ :: _
  -- let argumentIR_h :: argumentIR_t*{argumentIR_t <- argumentIR_t*} = argumentIR*{argumentIR <- argumentIR*}
  -- let argumentIR' = argumentIR_h
  -- if argumentIR' matches `%=_`
  -- let nameIR =_ = argumentIR'
  -- let parameterIR''?{parameterIR'' <- parameterIR''?} = $find_map<id, parameterIR>({ id : parameterIR*{id <- id*, parameterIR <- parameterIR*} }, nameIR)
  -- if parameterIR''?{parameterIR'' <- parameterIR''?} matches (_)
  -- let ?(parameterIR_match) = parameterIR''?{parameterIR'' <- parameterIR''?}
  -- let parameterIR_aligned*{parameterIR_aligned <- parameterIR_aligned*} = $align_parameterListIR_given({ id : parameterIR*{id <- id*, parameterIR <- parameterIR*} }, parameterIR_t*{parameterIR_t <- parameterIR_t*}, argumentIR_t*{argumentIR_t <- argumentIR_t*})

syntax callTargetKey = 
   | nameIR ( id?* )

syntax namedCallTargetKey = 
   | nameIR ( id* )

syntax unnamedCallTargetKey = 
   | nameIR ( nat )

syntax callTargetParameter = 
   | nameIR # bool # bool

syntax callTargetValue = callTargetParameter*

syntax callTargetMatch = 
   | match id* id* hint(prose MATCH "with defaults" %0 and "optionals" %1)
   | nomatch

syntax callResolution<V> = 
   | callableId : V # nameIR* # nameIR* hint(prose_fields "call target id" "call target" "defaults" "optionals")

def $callTargetKey(nameIR, argumentListIR) : callTargetKey =

  clause 0 : (nameIR_f, argumentIR*{argumentIR <- argumentIR*}) = nameIR_f ( id_arg?{id_arg <- id_arg?}*{id_arg? <- id_arg?*} )
  -- (let id_arg?{id_arg <- id_arg?} = $callTargetKey'(argumentIR))*{argumentIR <- argumentIR*, id_arg? -> id_arg?*}

def $callTargetKey'(argumentIR) : id? =

  clause 0 : (argumentIR) = ?()
  -- if argumentIR <: typedExpressionIR
  -- let typedExpressionIR = argumentIR as typedExpressionIR

  clause 1 : (argumentIR) = ?(id_arg)
  -- if argumentIR matches `%=%`
  -- let id_arg = _typedExpressionIR = argumentIR

  clause 2 : (argumentIR) = ?(id_arg)
  -- if argumentIR matches `%=_`
  -- let id_arg =_ = argumentIR

  clause 3 : (argumentIR) = ?()
  -- if argumentIR matches `_`

def $match_overloaded_named<V>(pair<callTargetId, V>, namedCallTargetKey, $get_parameterListIR(V) : parameterListIR) : callTargetMatch =

  clause 0 : (callTargetId : V, nameIR_f ( id_arg*{id_arg <- id_arg*} ), $get_parameterListIR) = $ite<callTargetMatch>($eq_set<id>({ id_param*{id_param <- id_param*} }, { id_arg*{id_arg <- id_arg*} }), match [] [], nomatch)
  -- let nameIR ( id_param*{id_param <- id_param*} ) = callTargetId
  -- if (nameIR = nameIR_f)
  -- let parameterIR*{parameterIR <- parameterIR*} = $get_parameterListIR(V)
  -- (if (id_param = $id_of_parameterIR(parameterIR)))*{id_param <- id_param*, parameterIR <- parameterIR*}
  -- if (|id_param*{id_param <- id_param*}| = |id_arg*{id_arg <- id_arg*}|)

  clause 1 : (callTargetId : V, nameIR_f ( id_arg*{id_arg <- id_arg*} ), $get_parameterListIR) = match id_default*{id_default <- id_default*} id_optional*{id_optional <- id_optional*}
  -- let nameIR ( id_param*{id_param <- id_param*} ) = callTargetId
  -- if (nameIR = nameIR_f)
  -- let parameterIR*{parameterIR <- parameterIR*} = $get_parameterListIR(V)
