def $bound(cursor, typingContext) : bound =

  clause 0 : (cursor, TC) = { [] }
  -- if cursor matches `GLOBAL`

  clause 1 : (cursor, TC) = $dom_map<typeId, typeDefIR>(TC.block.type)
  -- if cursor matches `BLOCK`

  clause 2 : (cursor, TC) = $union_set<typeId>(B_block, B_local)
  -- if cursor matches `LOCAL`
