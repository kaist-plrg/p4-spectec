    -- Exprs_eval: LOCAL EC_0 ARCH_0 |- typedExpressionIR_key*{typedExpressionIR_key <- typedExpressionIR_key*} : EC_1 ARCH_1 _CONT value_key*{value_key <- value_key*} as expressionListResult
