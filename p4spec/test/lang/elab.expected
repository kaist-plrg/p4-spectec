  -- let ` nameIR = prefixedNameIR
  -- let callableTypeDefEnv = TC.global.callable
  -- let callTargetKey = $callTargetKey(nameIR, argumentIR*{argumentIR <- argumentIR*})

  clause 2 : (cursor, TC, prefixedNameIR, argumentIR*{argumentIR <- argumentIR*}) = ?(callableId : callableTypeDefIR # id_default*{id_default <- id_default*} # id_optional*{id_optional <- id_optional*})
  -- if cursor matches `BLOCK`
  -- if prefixedNameIR matches ``%`
  -- let ` nameIR = prefixedNameIR
  -- let callableTypeDefEnv = TC.block.callable
  -- let callTargetKey = $callTargetKey(nameIR, argumentIR*{argumentIR <- argumentIR*})
  -- let callResolution<callableTypeDefIR>?{callResolution<callableTypeDefIR> <- callResolution<callableTypeDefIR>?} = $find_overloaded<callableTypeDefIR>(callableTypeDefEnv, callTargetKey, $parameterListIR_of_callableTypeDefIR)
  -- if callResolution<callableTypeDefIR>?{callResolution<callableTypeDefIR> <- callResolution<callableTypeDefIR>?} matches (_)
  -- let ?(callableId : callableTypeDefIR # id_default*{id_default <- id_default*} # id_optional*{id_optional <- id_optional*}) = callResolution<callableTypeDefIR>?{callResolution<callableTypeDefIR> <- callResolution<callableTypeDefIR>?}

  clause 3 : (cursor, TC, prefixedNameIR, argumentIR*{argumentIR <- argumentIR*}) = $find_callableDef_overloaded_t(global, TC, ` nameIR, argumentIR*{argumentIR <- argumentIR*})
  -- if cursor matches `BLOCK`
  -- if prefixedNameIR matches ``%`
  -- let ` nameIR = prefixedNameIR
  -- let callableTypeDefEnv = TC.block.callable
  -- let callTargetKey = $callTargetKey(nameIR, argumentIR*{argumentIR <- argumentIR*})
  -- if (?() = $find_overloaded<callableTypeDefIR>(callableTypeDefEnv, callTargetKey, $parameterListIR_of_callableTypeDefIR))

  clause 4 : (cursor, TC, prefixedNameIR, argumentIR*{argumentIR <- argumentIR*}) = $find_callableDef_overloaded_t(block, TC, ` nameIR, argumentIR*{argumentIR <- argumentIR*})
  -- if cursor matches `LOCAL`
  -- if prefixedNameIR matches ``%`
  -- let ` nameIR = prefixedNameIR

