  -- let listValue = value as listValue
  -- let typeIR_unroll = $unroll_typeIR(typeIR)

  clause 4 : (typeIR, value) = $cast_header_stack(typeIR_unroll, headerStackValue)
  -- if value <: headerStackValue
  -- let headerStackValue = value as headerStackValue
