  rulegroup builtinPopFrontMethodCallee

    rule abort: p EC_0 ARCH_0 |- typedExpressionIR '.' "pop_front" `< '_' `> `( argumentListIR `) : EC_1 ARCH_1 abortResult as calleeResult
