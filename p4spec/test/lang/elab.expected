  -- let extern_methodabstract nameIR < typeId_expl*{typeId_expl <- typeId_expl*} , typeId_impl*{typeId_impl <- typeId_impl*} >( parameterIR*{parameterIR <- parameterIR*} ): typeIR_ret = externMethodTypeDefIR
