extern relation ExternFunctionCall_eval: evalContext arch |- nameIR `( nameIR* `) : evalContext arch callResult

extern relation ExternMethodCall_eval: evalContext arch |- objectId '.' nameIR `( nameIR* `) : evalContext arch callResult

def $match_keysets(setValue*, value*) : bool =

  clause 0 : ([], []) = true

  clause 1 : ([SET `{ '...' `}], value_key*{value_key <- value_key*}) = true

  clause 2 : ([setValue], [value_key]) = $match_keyset(setValue, value_key)
  -- if (setValue =/= SET `{ '...' `})

  clause 3 : (setValue_h :: setValue_t*{setValue_t <- setValue_t*}, value_key_h :: value_key_t*{value_key_t <- value_key_t*}) = $match_keysets(setValue_t*{setValue_t <- setValue_t*}, value_key_t*{value_key_t <- value_key_t*})
  -- if (setValue_t*{setValue_t <- setValue_t*} =/= [])
  -- if (value_key_t*{value_key_t <- value_key_t*} =/= [])
  -- if $match_keyset(setValue_h, value_key_h)

  clause 4 : (setValue_h :: setValue_t*{setValue_t <- setValue_t*}, value_key_h :: value_key_t*{value_key_t <- value_key_t*}) = false
  -- if (setValue_t*{setValue_t <- setValue_t*} =/= [])
  -- if (value_key_t*{value_key_t <- value_key_t*} =/= [])
  -- if ~$match_keyset(setValue_h, value_key_h)

def $match_keyset(setValue, value) : bool =

  clause 0 : (SET `{ '...' `}, value_key) = true

  clause 1 : (SET `{ value `}, value_key) = $bin_eq(value, value_key)

  clause 2 : (SET `{ value*{value <- value*} `( _nat `) `}, value_key) = $exists_($bin_eq(value, value_key)*{value <- value*})

  clause 3 : (SET `{ value_base '&&&' value_mask `}, value_key) = $bin_eq($bin_band(value_base, value_mask), $bin_band(value_key, value_mask))

  clause 4 : (SET `{ value_base '..' value_limit `}, value_key) = ($bin_le(value_base, value_key) /\ $bin_le(value_key, value_limit))

syntax simpleKeysetExpressionResult = 
   | _CONT setValue (from continueResult<setValue>) 
   | EXIT (from exitResult) 
   | REJECT errorValue (from rejectTransitionResult) 

relation Eval_keyset_simple: evalContext arch |- simpleKeysetExpressionIR : evalContext arch simpleKeysetExpressionResult

  rulegroup typedExpressionIR

    rule abort: EC_0 ARCH_0 |- typedExpressionIR as simpleKeysetExpressionIR : EC_1 ARCH_1 abortResult as simpleKeysetExpressionResult
    -- Expr_eval: LOCAL EC_0 ARCH_0 |- typedExpressionIR : EC_1 ARCH_1 abortResult as expressionResult

    rule cont-setValue: EC_0 ARCH_0 |- typedExpressionIR as simpleKeysetExpressionIR : EC_1 ARCH_1 _CONT setValue as simpleKeysetExpressionResult
    -- Expr_eval: LOCAL EC_0 ARCH_0 |- typedExpressionIR : EC_1 ARCH_1 _CONT setValue as value as expressionResult

    rule cont-objectReferenceValue: EC_0 ARCH_0 |- typedExpressionIR as simpleKeysetExpressionIR : EC_1 ARCH_1 _CONT setValue as simpleKeysetExpressionResult
    -- Expr_eval: LOCAL EC_0 ARCH_0 |- typedExpressionIR : EC_1 ARCH_1 _CONT REF objectId as value as expressionResult
    -- if (?(VALUE_SET `{ value*{value <- value*} `( n_size `) `} as object) = $find_object_e(ARCH_1, objectId))
    -- if (setValue = SET `{ value*{value <- value*} `( n_size `) `})

  rulegroup mask

