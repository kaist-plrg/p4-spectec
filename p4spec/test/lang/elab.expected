    rule cons: p IC STO_0 |- switchCaseIR_h :: switchCaseIR_t*{switchCaseIR_t <- switchCaseIR_t*} : STO_2 switchCaseIR_h' :: switchCaseIR_t'*{switchCaseIR_t' <- switchCaseIR_t'*}
    -- SwitchCase_inst: p IC STO_0 |- switchCaseIR_h : STO_1 switchCaseIR_h'
