tbl def $nestable_typedef(typeIR) : bool =
  row 0 :
    (signature) bool as typeIR
    (typeIR) -> true
    -- if typeIR <: boolTypeIR
    -- let boolTypeIR = typeIR as boolTypeIR
    -- if (boolTypeIR = bool)
  row 1 :
    (signature) error as typeIR
    (typeIR) -> true
    -- if typeIR <: errorTypeIR
    -- let errorTypeIR = typeIR as errorTypeIR
    -- if (errorTypeIR = error)
  row 2 :
    (signature) string as typeIR
    (typeIR) -> true
    -- if typeIR <: stringTypeIR
    -- let stringTypeIR = typeIR as stringTypeIR
    -- if (stringTypeIR = string)
  row 3 :
    (signature) integerTypeIR as typeIR
    (typeIR) -> true
    -- if typeIR <: integerTypeIR
    -- let integerTypeIR = typeIR as integerTypeIR
  row 4 :
    (signature) nameTypeIR as typeIR
    (typeIR) -> true
    -- if typeIR <: nameTypeIR
    -- let nameTypeIR = typeIR as nameTypeIR
  row 5 :
    (signature) typedef _typeId typeIR as typeIR
    (typeIR') -> $nestable_typedef(typeIR)
    -- if typeIR' <: typedefTypeIR
    -- let typedef _typeId typeIR = typeIR' as typedefTypeIR
  row 6 :
    (signature) newTypeIR as typeIR
