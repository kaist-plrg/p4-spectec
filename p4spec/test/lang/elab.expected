  clause 1 : (cursor, IC, typeId, typeIR) = IC[local.type = theta]
  -- if cursor matches `LOCAL`
  -- let theta = $add_map<typeId, typeIR>(IC.local.type, typeId, typeIR)

def $add_types_i(cursor, instContext, typeId*, typeIR*) : instContext =

  clause 0 : (p, IC, typeId*{typeId <- typeId*}, typeIR*{typeIR <- typeIR*}) = IC
  -- if typeId*{typeId <- typeId*} matches []
  -- if typeIR*{typeIR <- typeIR*} matches []

  clause 1 : (p, IC, typeId*{typeId <- typeId*}, typeIR*{typeIR <- typeIR*}) = $add_types_i(p, IC', typeId_t*{typeId_t <- typeId_t*}, typeIR_t*{typeIR_t <- typeIR_t*})
  -- if typeId*{typeId <- typeId*} matches _ :: _
  -- let typeId_h :: typeId_t*{typeId_t <- typeId_t*} = typeId*{typeId <- typeId*}
  -- if typeIR*{typeIR <- typeIR*} matches _ :: _
  -- let typeIR_h :: typeIR_t*{typeIR_t <- typeIR_t*} = typeIR*{typeIR <- typeIR*}
  -- let IC' = $add_type_i(p, IC, typeId_h, typeIR_h)

def $add_callableDef_overload_i(cursor, instContext, callableId, callableDef) : instContext =

  clause 0 : (cursor, IC, callableId, callableDef) = IC[global.callable = callableDefEnv]
