def $directionless_trailing(direction*) : bool =

  clause 0 : (direction*{direction <- direction*}) = $directionless_trailing'(true, $rev_<direction>(direction*{direction <- direction*}))

def $directionless_trailing'(bool, direction*) : bool =

  clause 0 : (_b, []) = true

  clause 1 : (true, _EMPTY :: direction_t*{direction_t <- direction_t*}) = $directionless_trailing'(true, direction_t*{direction_t <- direction_t*})

  clause 2 : (false, _EMPTY :: direction_t*{direction_t <- direction_t*}) = false

  clause 3 : (_b, direction_h :: direction_t*{direction_t <- direction_t*}) = $directionless_trailing'(false, direction_t*{direction_t <- direction_t*})
  -- if (direction_h =/= _EMPTY)

