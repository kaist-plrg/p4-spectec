  rulegroup 

    rule instantiation: p TC_0 typeFrame externMethodTypeDefEnv |- instantiation as objectDeclaration : typeFrame_init externMethodTypeDefEnv instantiationIR as objectDeclarationIR
    -- InstDecl_ok: p TC_0 |- instantiation : TC_1 instantiationIR
    -- if (_annotationList _typeIR _constructorTargetIR `( _argumentListIR `) nameIR _objectInitializerOptIR ';' = instantiationIR)
    -- if (?(varTypeIR) = $find_var_t(_BARE nameIR, p, TC_1))
    -- if (typeFrame_init = $update_map<id, varTypeIR>(typeFrame, nameIR, varTypeIR))

    rule functionDeclaration: p TC_0 typeFrame externMethodTypeDefEnv |- annotationList typeOrVoid name typeParameterListOpt `( parameterList `) blockStatement as objectDeclaration : typeFrame externMethodTypeDefEnv_init functionDeclarationIR as objectDeclarationIR
