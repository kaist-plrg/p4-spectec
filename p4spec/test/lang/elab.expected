  -- let w_max_a . _nat v i_a = integerValue
  -- if value' <: integerValue
  -- let integerValue' = value' as integerValue
  -- if integerValue' matches `%.%V%`
  -- let w_max_b . _nat' v i_b = integerValue'

  clause 8 : (value, value') = ((|value_a*{value_a <- value_a*}| = |value_b*{value_b <- value_b*}|) /\ $forall_($bin_eq(value_a, value_b)*{value_a <- value_a*, value_b <- value_b*}))
