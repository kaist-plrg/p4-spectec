  -- let localEvalLayer = {type $empty_theta, frames [$empty_frame]}

  clause 1 : (cursor, EC) = EC[local = localEvalLayer]
  -- if cursor matches `BLOCK`
  -- let localEvalLayer = {type $empty_theta, frames [$empty_frame]}

  clause 2 : (cursor, EC) = EC
  -- if cursor matches `LOCAL`

def $copy_e(cursor, evalContext, evalContext) : evalContext =

  clause 0 : (cursor, EC_from, EC_to) = EC_to[global = EC_from.global]
