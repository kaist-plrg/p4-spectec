    -- Expr_eval: LOCAL EC_0 ARCH_0 |- typedExpressionIR_l : EC_1 ARCH_1 abortResult as expressionResult

    rule left-cont-right-abort: EC_0 ARCH_0 |- typedExpressionIR_l '..' typedExpressionIR_r : EC_2 ARCH_2 abortResult as expressionListResult
    -- Expr_eval: LOCAL EC_0 ARCH_0 |- typedExpressionIR_l : EC_1 ARCH_1 _CONT value_l as expressionResult
    -- Expr_eval: LOCAL EC_1 ARCH_1 |- typedExpressionIR_r : EC_2 ARCH_2 abortResult as expressionResult

    rule left-cont-right-cont: EC_0 ARCH_0 |- typedExpressionIR_l '..' typedExpressionIR_r : EC_2 ARCH_2 _CONT value*{value <- value*} as expressionListResult
    -- Expr_eval: LOCAL EC_0 ARCH_0 |- typedExpressionIR_l : EC_1 ARCH_1 _CONT value_l as expressionResult
    -- Expr_eval: LOCAL EC_1 ARCH_1 |- typedExpressionIR_r : EC_2 ARCH_2 _CONT value_r as expressionResult
    -- if (typeIR = $type_of_typedExpressionIR(typedExpressionIR_l))
    -- if (value*{value <- value*} = $values_of_setValue(SET `< typeIR `>, SET `{ value_l '..' value_r `}))

def $values_of_setValue(setTypeIR, setValue) : value* =

  clause 0 : (SET `< typeIR `>, SET `{ value_l '..' value_r `}) = value_l :: $values_of_setValue(SET `< typeIR `>, SET `{ value_l_inc '..' value_r `})
  -- if $bin_lt(value_l, value_r)
  -- if (value_one = $cast_op(typeIR, D 1 as int as value))
  -- if (value_l_inc = $bin_plus(value_l, value_one))

  clause 1 : (SET `< typeIR `>, SET `{ value_l '..' value_r `}) = [value_l]
  -- if $bin_eq(value_l, value_r)

  clause 2 : (SET `< typeIR `>, SET `{ value_l '..' value_r `}) = []
  -- if $bin_gt(value_l, value_r)

