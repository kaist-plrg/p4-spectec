syntax assignop = 
   | =
   | +=
   | -=
   | |+|=
   | |-|=
   | *=
   | /=
   | %=
   | <<=
   | >>=
   | &=
   | ^=
   | |=

syntax assignmentStatement = 
   | lvalue assignop expression ;

def $assignop_as_binop(assignop) : binop? =

  clause 0 : (assignop) = ?(+)
  -- if assignop matches `+=`

  clause 1 : (assignop) = ?(-)
  -- if assignop matches `-=`

  clause 2 : (assignop) = ?(|+|)
  -- if assignop matches `|+|=`

  clause 3 : (assignop) = ?(|-|)
  -- if assignop matches `|-|=`

  clause 4 : (assignop) = ?(*)
  -- if assignop matches `*=`

  clause 5 : (assignop) = ?(/)
  -- if assignop matches `/=`

  clause 6 : (assignop) = ?(%)
  -- if assignop matches `%=`

  clause 7 : (assignop) = ?(<<)
  -- if assignop matches `<<=`

  clause 8 : (assignop) = ?(>>)
  -- if assignop matches `>>=`

  clause 9 : (assignop) = ?(&)
  -- if assignop matches `&=`

  clause 10 : (assignop) = ?(^)
  -- if assignop matches `^=`

  clause 11 : (assignop) = ?(|)
  -- if assignop matches `|=`

  clause -1 : (assignop) = ?()

