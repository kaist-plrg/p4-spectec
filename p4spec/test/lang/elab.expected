syntax callResult = 
   | exit
   | reject errorValue
   | return value?

syntax forBreakResult = 
   | break

syntax forContinueResult = 
   | continue

syntax forResult = 
   | break
   | continue

syntax statementResult = 
   | `empty
   | exit
   | reject errorValue
   | return value?
   | break
   | continue

