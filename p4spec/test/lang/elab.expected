  clause 1 : (TC) = ?(typeIR_ret)
  -- let localKind = TC.local.kind
  -- if localKind <: externFunctionLocalKind
  -- let extern_function: typeIR_ret = localKind as externFunctionLocalKind

  clause 2 : (TC) = ?(void as typeIR)
  -- if (action as localKind = TC.local.kind)

  clause 3 : (TC) = ?(typeIR_ret)
  -- let localKind = TC.local.kind
  -- if localKind <: externMethodLocalKind
  -- let externMethodLocalKind = localKind as externMethodLocalKind
  -- if externMethodLocalKind matches `EXTERN_METHOD:%`
  -- let extern_method: typeIR_ret = externMethodLocalKind

  clause 4 : (TC) = ?(typeIR_ret)
  -- let localKind = TC.local.kind
  -- if localKind <: externMethodLocalKind
  -- let externMethodLocalKind = localKind as externMethodLocalKind
  -- if externMethodLocalKind matches `EXTERN_METHODABSTRACT:%`
  -- let extern_methodabstract: typeIR_ret = externMethodLocalKind

  clause 5 : (TC) = ?(void as typeIR)
  -- if (control_apply_method as localKind = TC.local.kind)

  clause -1 : (TC) = ?()

syntax matchKey = 
   | typeIR : nameIR

syntax matchAction = 
   | prefixedNameIR ( parameterIR* @ argumentListIR )

syntax matchPriority = {values nat*, init bool, delta nat, largest_wins bool}

syntax matchEntries = {size nat, const bool}

syntax matchMode = 
   | nopri
   | noprilpm nat
   | pri
   | prilpm

syntax tableContext = {keys matchKey*, actions matchAction*, priorities matchPriority, entries matchEntries, mode matchMode}

syntax tableEntryState = 
   | lpm nat
   | non_lpm

def $empty_tableContext : tableContext =

  clause 0 :  = {keys [], actions [], priorities matchPriority, entries matchEntries, mode nopri}
  -- let matchPriority = {values [], init false, delta 1, largest_wins true}
  -- let matchEntries = {size 0, const true}

def $add_key_tbl(tableContext, id, typeIR) : tableContext =

  clause 0 : (TBLC, id, typeIR) = TBLC[keys = TBLC.keys ++ [matchKey]]
  -- let matchKey = typeIR : id

def $add_action_tbl(tableContext, prefixedNameIR, parameterIR*, argumentListIR) : tableContext =

  clause 0 : (TBLC, prefixedNameIR, parameterIR*{parameterIR <- parameterIR*}, argumentListIR) = TBLC[actions = TBLC.actions ++ [matchAction]]
  -- let matchAction = prefixedNameIR ( parameterIR*{parameterIR <- parameterIR*} @ argumentListIR )

def $add_table_priority(tableContext, nat) : tableContext =

  clause 0 : (TBLC, n) = TBLC[priorities.values = TBLC.priorities.values ++ [n]]

def $update_mode_tbl(tableContext, id, typeIR) : tableContext =

  clause 0 : (TBLC, text, typeIR) = TBLC[mode = noprilpm n]
  -- if (text = "lpm")
  -- if typeIR <: fixedIntTypeIR
  -- let int< n > = typeIR as fixedIntTypeIR
  -- if (TBLC.mode = nopri)

  clause 1 : (TBLC, text, typeIR) = TBLC[mode = noprilpm n]
  -- if (text = "lpm")
  -- if typeIR <: fixedBitTypeIR
  -- let bit< n > = typeIR as fixedBitTypeIR
  -- if (TBLC.mode = nopri)

  clause 2 : (TBLC, text, typeIR) = TBLC[mode = noprilpm n]
  -- if (text = "lpm")
  -- if typeIR <: varBitTypeIR
  -- let varbit< n > = typeIR as varBitTypeIR
  -- if (TBLC.mode = nopri)

  clause 3 : (TBLC, text, typeIR') = $update_mode_tbl(TBLC, "lpm", typeIR)
  -- if (text = "lpm")
  -- if typeIR' <: typedefTypeIR
  -- let typedef _typeId typeIR = typeIR' as typedefTypeIR

  clause 4 : (TBLC, text, typeIR') = $update_mode_tbl(TBLC, "lpm", typeIR)
  -- if (text = "lpm")
  -- if typeIR' <: newTypeIR
  -- let type _typeId typeIR = typeIR' as newTypeIR

  clause 5 : (TBLC, text, typeIR) = TBLC[mode = prilpm]
  -- if (text = "lpm")
  -- if ~typeIR <: aliasTypeIR
  -- if (TBLC.mode = pri)

  clause 6 : (TBLC, text, _typeIR) = TBLC[mode = pri]
  -- if (text = "range")
  -- if (TBLC.mode = nopri)

  clause 7 : (TBLC, text, _typeIR) = TBLC[mode = pri]
  -- if (text = "ternary")
  -- if (TBLC.mode = nopri)

  clause 8 : (TBLC, text, _typeIR) = TBLC[mode = pri]
  -- if (text = "optional")
  -- if (TBLC.mode = nopri)

  clause 9 : (TBLC, text, _typeIR) = TBLC[mode = prilpm]
  -- if (text = "range")
  -- let matchMode = TBLC.mode
  -- if matchMode matches `NOPRILPM%`
  -- let noprilpm _nat = matchMode

  clause 10 : (TBLC, text, _typeIR) = TBLC[mode = prilpm]
  -- if (text = "ternary")
  -- let matchMode = TBLC.mode
  -- if matchMode matches `NOPRILPM%`
  -- let noprilpm _nat = matchMode

  clause 11 : (TBLC, text, _typeIR) = TBLC[mode = prilpm]
  -- if (text = "optional")
  -- let matchMode = TBLC.mode
  -- if matchMode matches `NOPRILPM%`
  -- let noprilpm _nat = matchMode

  clause -1 : (TBLC, _id, _typeIR) = TBLC

def $find_action(tableContext, prefixedNameIR) : (parameterIR*, argumentListIR)? =

  clause 0 : (TBLC, prefixedNameIR) = $find_action'(TBLC.actions, prefixedNameIR)

def $find_action'(matchAction*, prefixedNameIR) : (parameterIR*, argumentListIR)? =

  clause 0 : (matchAction*{matchAction <- matchAction*}, prefixedNameIR) = ?()
  -- if matchAction*{matchAction <- matchAction*} matches []

  clause 1 : (matchAction*{matchAction <- matchAction*}, prefixedNameIR) = ?((parameterIR*{parameterIR <- parameterIR*}, argumentListIR))
  -- if matchAction*{matchAction <- matchAction*} matches _ :: _
  -- let matchAction_h :: matchAction_t*{matchAction_t <- matchAction_t*} = matchAction*{matchAction <- matchAction*}
  -- let prefixedNameIR' ( parameterIR*{parameterIR <- parameterIR*} @ argumentListIR ) = matchAction_h
  -- if (prefixedNameIR' = prefixedNameIR)

  clause 2 : (matchAction*{matchAction <- matchAction*}, prefixedNameIR) = $find_action'(matchAction_t*{matchAction_t <- matchAction_t*}, prefixedNameIR)
  -- if matchAction*{matchAction <- matchAction*} matches _ :: _
  -- let matchAction_h :: matchAction_t*{matchAction_t <- matchAction_t*} = matchAction*{matchAction <- matchAction*}
  -- let prefixedNameIR_h ( _parameterIR*{_parameterIR <- _parameterIR*} @ _argumentListIR ) = matchAction_h
  -- if (prefixedNameIR_h =/= prefixedNameIR)

def $find_table_priority_last(tableContext) : nat =

  clause 0 : (TBLC) = n*{n <- n*}[n_last]
  -- let n*{n <- n*} = TBLC.priorities.values
  -- let int = (|n*{n <- n*}| - 1)
  -- if int <: nat
  -- let n_last = int as nat

def $join_tableEntryState(tableEntryState, tableEntryState) : tableEntryState =

  clause 0 : (tableEntryState, tableEntryState') = lpm n
  -- if tableEntryState matches `NON_LPM`
  -- if tableEntryState' matches `LPM%`
  -- let lpm n = tableEntryState'

  clause 1 : (tableEntryState, tableEntryState') = lpm n
  -- if tableEntryState matches `LPM%`
  -- let lpm n = tableEntryState
  -- if tableEntryState' matches `NON_LPM`

  clause 2 : (tableEntryState, tableEntryState') = non_lpm
  -- if tableEntryState matches `NON_LPM`
  -- if tableEntryState' matches `NON_LPM`

def $tableEntry_lpm_prefix(value) : nat =

  clause 0 : (value) = $tableEntry_lpm_prefix'(value, 0)

def $tableEntry_lpm_prefix'(value, nat) : nat =

  clause 0 : (value, n_prefix) = n_prefix
  -- if value <: integerLiteral
  -- let integerLiteral = value as integerLiteral
  -- if integerLiteral matches `%W%`
  -- let nat w _int = integerLiteral
  -- if (nat = 0)

  clause 1 : (value, n_prefix) = $tableEntry_lpm_prefix'(value', (n_prefix + 1))
  -- if value <: integerLiteral
  -- let integerLiteral = value as integerLiteral
  -- if integerLiteral matches `%W%`
  -- let w w int = integerLiteral
  -- if int <: nat
  -- let n = int as nat
  -- if (w > 0)
  -- let int' = (w - 1)
  -- if int' <: nat
  -- let w' = int' as nat
  -- if ((n \ 2) =/= 0)
  -- let int'' = ((n - 1) / 2 as int)
  -- if int'' <: nat
  -- let n' = int'' as nat
  -- let value' = w' w n' as int as value

  clause 2 : (value, nat) = $tableEntry_lpm_prefix'(value', 0)
  -- if value <: integerLiteral
  -- let integerLiteral = value as integerLiteral
  -- if integerLiteral matches `%W%`
  -- let w w int = integerLiteral
  -- if int <: nat
  -- let n = int as nat
  -- if (nat = 0)
  -- if (w > 0)
  -- let int' = (w - 1)
  -- if int' <: nat
  -- let w' = int' as nat
  -- if ((n \ 2) = 0)
  -- let value' = w' w (n / 2) as int as value

relation Type_wf: bound |- typeIR

  rulegroup baseTypeIR

   match

    (signature) B |- baseTypeIR as typeIR
    B |- typeIR
    -- if typeIR <: baseTypeIR
    -- let baseTypeIR = typeIR as baseTypeIR

   paths

    rulepath baseTypeIR
    -- the relation holds

  rulegroup nameTypeIR

   match

    (signature) B |- ` typeId as typeIR
    B |- typeIR
    -- if typeIR <: nameTypeIR
    -- let ` typeId = typeIR as nameTypeIR

   paths

    rulepath nameTypeIR
    -- if $in_set<typeId>(typeId, B)
    -- the relation holds

  rulegroup typedefTypeIR

   match

    (signature) B |- typedef _typeId typeIR as typeIR
    B |- typeIR'
    -- if typeIR' <: typedefTypeIR
    -- let typedef _typeId typeIR = typeIR' as typedefTypeIR

   paths

    rulepath typedefTypeIR
    -- if $nestable_typedef(typeIR)
    -- if Type_wf: B |- typeIR holds
    -- the relation holds

  rulegroup newTypeIR

   match

    (signature) B |- type _typeId typeIR as typeIR
    B |- typeIR'
    -- if typeIR' <: newTypeIR
    -- let type _typeId typeIR = typeIR' as newTypeIR

   paths

    rulepath newTypeIR
    -- if $nestable_new(typeIR)
    -- if Type_wf: B |- typeIR holds
    -- the relation holds

  rulegroup listTypeIR

   match

    (signature) B |- list< typeIR > as typeIR
    B |- typeIR'
    -- if typeIR' <: listTypeIR
    -- let list< typeIR > = typeIR' as listTypeIR

   paths

    rulepath listTypeIR
    -- if $nestable_list(typeIR)
    -- if Type_wf: B |- typeIR holds
    -- the relation holds

  rulegroup tupleTypeIR

   match

    (signature) B |- tuple< typeIR*{typeIR <- typeIR*} > as typeIR
    B |- typeIR'
    -- if typeIR' <: tupleTypeIR
    -- let tuple< typeIR*{typeIR <- typeIR*} > = typeIR' as tupleTypeIR

   paths

    rulepath tupleTypeIR
    -- (if $nestable_tuple(typeIR))*{typeIR <- typeIR*}
    -- (if Type_wf: B |- typeIR holds)*{typeIR <- typeIR*}
    -- the relation holds

  rulegroup headerStackTypeIR

   match

    (signature) B |- typeIR [ _nat ] as typeIR
    B |- typeIR'
    -- if typeIR' <: headerStackTypeIR
    -- let typeIR [ _nat ] = typeIR' as headerStackTypeIR

   paths

    rulepath headerStackTypeIR
    -- if $nestable_headerStack(typeIR)
    -- if Type_wf: B |- typeIR holds
    -- the relation holds

  rulegroup structTypeIR

   match

    (signature) B |- struct _typeId < _typeArgumentIR*{_typeArgumentIR <- _typeArgumentIR*} >{ _annotationList typeIR_field nameIR_field ;*{_annotationList <- _annotationList*, nameIR_field <- nameIR_field*, typeIR_field <- typeIR_field*} } as typeIR
    B |- typeIR
    -- if typeIR <: structTypeIR
    -- let struct _typeId < _typeArgumentIR*{_typeArgumentIR <- _typeArgumentIR*} >{ _annotationList typeIR_field nameIR_field ;*{_annotationList <- _annotationList*, nameIR_field <- nameIR_field*, typeIR_field <- typeIR_field*} } = typeIR as structTypeIR

   paths

    rulepath structTypeIR
    -- if $distinct_<nameIR>(nameIR_field*{nameIR_field <- nameIR_field*})
    -- (if $nestable_struct(typeIR_field))*{typeIR_field <- typeIR_field*}
    -- (if Type_wf: B |- typeIR_field holds)*{typeIR_field <- typeIR_field*}
    -- the relation holds

  rulegroup headerTypeIR

   match

    (signature) B |- header _typeId < _typeArgumentIR*{_typeArgumentIR <- _typeArgumentIR*} >{ _annotationList typeIR_field nameIR_field ;*{_annotationList <- _annotationList*, nameIR_field <- nameIR_field*, typeIR_field <- typeIR_field*} } as typeIR
    B |- typeIR
    -- if typeIR <: headerTypeIR
    -- let header _typeId < _typeArgumentIR*{_typeArgumentIR <- _typeArgumentIR*} >{ _annotationList typeIR_field nameIR_field ;*{_annotationList <- _annotationList*, nameIR_field <- nameIR_field*, typeIR_field <- typeIR_field*} } = typeIR as headerTypeIR

   paths

    rulepath headerTypeIR
    -- if $distinct_<nameIR>(nameIR_field*{nameIR_field <- nameIR_field*})
    -- (if $nestable_header(typeIR_field))*{typeIR_field <- typeIR_field*}
    -- (if Type_wf: B |- typeIR_field holds)*{typeIR_field <- typeIR_field*}
    -- the relation holds

  rulegroup headerUnionTypeIR

   match

