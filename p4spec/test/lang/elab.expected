  rulegroup 

    rule empty: TC_0 nameIR_state*{nameIR_state <- nameIR_state*} |- _EMPTY : TRANSITION "reject" ';'

    rule name: TC_0 nameIR_state*{nameIR_state <- nameIR_state*} |- TRANSITION name ';' : transitionStatementIR
