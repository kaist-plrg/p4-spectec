def $assignop_as_binop(assignop) : binop? =

  clause 0 : ('+=') = ?('+')

  clause 1 : ('-=') = ?('-')

  clause 2 : ('|+|=') = ?('|+|')

  clause 3 : ('|-|=') = ?('|-|')

  clause 4 : ('*=') = ?('*')

  clause 5 : ('/=') = ?('/')

  clause 6 : ('%=') = ?('%')

  clause 7 : ('<<=') = ?('<<')

  clause 8 : ('>>=') = ?('>>')

  clause 9 : ('&=') = ?('&')

  clause 10 : ('^=') = ?('^')

  clause 11 : ('|=') = ?('|')

  clause -1 : (assignop) = ?()

