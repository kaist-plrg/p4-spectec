def $lvalue_as_expression(lvalue) : expression =

  clause 0 : (referenceExpression as lvalue) = referenceExpression as expression

  clause 1 : (lvalue_base '.' member) = expression_base as memberAccessBase '.' member as expression
  -- if (expression_base = $lvalue_as_expression(lvalue_base))

  clause 2 : (lvalue_base `[ expression_index `]) = expression_base `[ expression_index `] as expression
  -- if (expression_base = $lvalue_as_expression(lvalue_base))

  clause 3 : (lvalue_base `[ expression_hi ':' expression_lo `]) = expression_base `[ expression_hi ':' expression_lo `] as expression
  -- if (expression_base = $lvalue_as_expression(lvalue_base))

  clause 4 : (lvalue_base `[ expression_hi '+:' expression_lo `]) = expression_base `[ expression_hi '+:' expression_lo `] as expression
  -- if (expression_base = $lvalue_as_expression(lvalue_base))

  clause 5 : (`( lvalue `)) = `( expression `) as expression
  -- if (expression = $lvalue_as_expression(lvalue))

def $expression_as_lvalue(expression) : lvalue? =

  clause 0 : (referenceExpression as expression) = ?(referenceExpression as lvalue)

  clause 1 : (expression as memberAccessBase '.' member as expression) = ?(lvalue '.' member)
  -- if (?(lvalue) = $expression_as_lvalue(expression))

  clause 2 : (expression_base `[ expression_index `] as expression) = ?(lvalue_base `[ expression_index `])
  -- if (?(lvalue_base) = $expression_as_lvalue(expression_base))

  clause 3 : (expression_base `[ expression_hi ':' expression_lo `] as expression) = ?(lvalue_base `[ expression_hi ':' expression_lo `])
  -- if (?(lvalue_base) = $expression_as_lvalue(expression_base))

  clause 4 : (expression_base `[ expression_hi '+:' expression_lo `] as expression) = ?(lvalue_base `[ expression_hi '+:' expression_lo `])
  -- if (?(lvalue_base) = $expression_as_lvalue(expression_base))

  clause 5 : (`( expression `) as expression) = ?(`( lvalue `))
  -- if (?(lvalue) = $expression_as_lvalue(expression))

