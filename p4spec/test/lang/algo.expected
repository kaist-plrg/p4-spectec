  -- let name = $lift_nameIR_as_nonTypeName(nameIR) as name

  clause 2 : (annotationList typeIR constructorTargetIR `( argumentIR*{argumentIR <- argumentIR*} `) nameIR objectInitializerOptIR ';') = annotationList type `( argumentList `) name '=' `{ objectDeclarationList `} ';'
  -- if objectInitializerOptIR matches (_)
  -- let ?('=' `{ objectDeclarationIR*{objectDeclarationIR <- objectDeclarationIR*} `}) = objectInitializerOptIR
  -- let prefixedNameIR `< typeArgumentIR*{typeArgumentIR <- typeArgumentIR*} `> = constructorTargetIR
  -- if typeArgumentIR*{typeArgumentIR <- typeArgumentIR*} matches []
  -- let prefixedTypeName = $lift_prefixedNameIR_as_prefixedTypeName(prefixedNameIR)
  -- let type = prefixedTypeName as type
