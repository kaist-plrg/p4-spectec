  -- let initializerOpt = $lift_constantInitializerOptIR_as_initializerOpt(constantInitializerIR?{constantInitializerIR <- constantInitializerIR?})

def $lift_parameterListIR(parameterIR*) : parameterList =

  clause 0 : (parameterIR*{parameterIR <- parameterIR*}) = parameterList
