  clause 0 : (typeArgumentIR*{typeArgumentIR <- typeArgumentIR*}) = typeArgumentList
  -- (let typeArgument = $lift_typeArgumentIR(typeArgumentIR))*{typeArgumentIR <- typeArgumentIR*, typeArgument -> typeArgument*}
  -- let typeArgumentList = $unflatten_typeArgumentList(typeArgument*{typeArgument <- typeArgument*})

def $lift_nameTypeIR(nameTypeIR) : namedType =

  clause 0 : (_NAME typeId) = typeName as namedType
  -- let typeName = $lift_nameIR_as_typeName(typeId)

def $lift_aliasTypeIR(aliasTypeIR) : type =

  clause 0 : (aliasTypeIR) = typeName as type
  -- if aliasTypeIR <: typedefTypeIR
  -- let TYPEDEF typeId _typeIR = aliasTypeIR as typedefTypeIR
  -- let typeName = $lift_nameIR_as_typeName(typeId)

  clause 1 : (aliasTypeIR) = typeName as type
