   | expressionList ',' expression (from expressionList) 
   | name '=' expression (from recordElementExpression) 
   | name '=' expression ',' '...' (from recordElementExpression) 
   | name '=' expression ',' namedExpressionList (from recordElementExpression) 
   | name '=' expression ',' namedExpressionList ',' '...' (from recordElementExpression) 

syntax callableTarget = expression

syntax constructorTarget = namedType

syntax callTarget = 
   | TRUE (from booleanLiteral) 
   | FALSE (from booleanLiteral) 
