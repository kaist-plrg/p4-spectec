extern relation ExternFunctionCall_eval_lctk: typingContext |- nameIR `( nameIR* `) ~> value

relation Expr_eval_lctk: cursor typingContext |- typedExpressionIR ~> value

  rulegroup literalExpressionIR

   match

    (signature) p TC |- expressionIR '#' _expressionNoteIR ~> %
    p TC |- expressionIR '#' _expressionNoteIR ~> %

   paths

    rulepath booleanLiteral
    -- let expressionIR' = expressionIR
    -- if expressionIR' <: booleanLiteral
    -- let booleanLiteral = expressionIR' as booleanLiteral
    -- let boolValue = $ite<boolValue>((booleanLiteral = TRUE), _B true, _B false)
    -- output: % % |- % ~> boolValue as value

    rulepath integerLiteral
    -- let expressionIR' = expressionIR
    -- if expressionIR' <: integerLiteral
    -- let integerLiteral = expressionIR' as integerLiteral
    -- output: % % |- % ~> integerLiteral as value

    rulepath stringLiteral
    -- let expressionIR' = expressionIR
    -- if expressionIR' <: stringLiteral
    -- let stringLiteral = expressionIR' as stringLiteral
    -- output: % % |- % ~> stringLiteral as value

  rulegroup referenceExpressionIR

   match

    (signature) p TC |- prefixedNameIR as expressionIR '#' _expressionNoteIR ~> %
    p TC |- expressionIR '#' _expressionNoteIR ~> %
    -- if expressionIR <: prefixedNameIR
    -- let prefixedNameIR = expressionIR as prefixedNameIR

   paths

    rulepath referenceExpressionIR
    -- let value = $find_var_value_t(prefixedNameIR, p, TC)
    -- output: % % |- % ~> value

  rulegroup defaultExpressionIR

   match

    (signature) p TC |- '...' as expressionIR '#' _expressionNoteIR ~> %
    p TC |- expressionIR '#' _expressionNoteIR ~> %
    -- if expressionIR <: defaultExpression
    -- let defaultExpression = expressionIR as defaultExpression
    -- if (defaultExpression = '...')

   paths

    rulepath defaultExpressionIR
    -- output: % % |- % ~> DEFAULT as value

  rulegroup unaryExpressionIR

   match

    (signature) p TC |- unop typedExpressionIR as expressionIR '#' _expressionNoteIR ~> %
    p TC |- expressionIR '#' _expressionNoteIR ~> %
    -- if expressionIR <: unaryExpressionIR
    -- let unop typedExpressionIR = expressionIR as unaryExpressionIR

   paths

    rulepath unaryExpressionIR
    -- Expr_eval_lctk: p TC |- typedExpressionIR ~> value
    -- output: % % |- % ~> $un_op(unop, value)

  rulegroup binaryExpressionIR

   match

    (signature) p TC |- typedExpressionIR_l binop' typedExpressionIR_r as expressionIR '#' _expressionNoteIR ~> %
    p TC |- expressionIR '#' _expressionNoteIR ~> %
    -- if expressionIR <: binaryExpressionIR
    -- let typedExpressionIR_l binop' typedExpressionIR_r = expressionIR as binaryExpressionIR

   paths

    rulepath non-short-circuit
    -- let binop = binop'
    -- if ~binop <- ['&&', '||']
    -- Expr_eval_lctk: p TC |- typedExpressionIR_l ~> value_l
    -- Expr_eval_lctk: p TC |- typedExpressionIR_r ~> value_r
    -- output: % % |- % ~> $bin_op(binop, value_l, value_r)

    rulepath land-false
    -- if (binop' = '&&')
    -- Expr_eval_lctk: p TC |- typedExpressionIR_l ~> value
    -- if (value = _B false as value)
    -- output: % % |- % ~> _B false as value

    rulepath land-true
    -- if (binop' = '&&')
    -- Expr_eval_lctk: p TC |- typedExpressionIR_l ~> value
    -- if (value = _B true as value)
    -- Expr_eval_lctk: p TC |- typedExpressionIR_r ~> value_r
    -- output: % % |- % ~> value_r

    rulepath lor-true
    -- if (binop' = '||')
    -- Expr_eval_lctk: p TC |- typedExpressionIR_l ~> value
    -- if (value = _B true as value)
    -- output: % % |- % ~> _B true as value

    rulepath lor-false
    -- if (binop' = '||')
    -- Expr_eval_lctk: p TC |- typedExpressionIR_l ~> value
    -- if (value = _B false as value)
    -- Expr_eval_lctk: p TC |- typedExpressionIR_r ~> value_r
    -- output: % % |- % ~> value_r

  rulegroup ternaryExpressionIR

   match

    (signature) p TC |- typedExpressionIR_cond '?' typedExpressionIR_true ':' typedExpressionIR_false as expressionIR '#' _expressionNoteIR ~> %
    p TC |- expressionIR '#' _expressionNoteIR ~> %
    -- if expressionIR <: ternaryExpressionIR
    -- let typedExpressionIR_cond '?' typedExpressionIR_true ':' typedExpressionIR_false = expressionIR as ternaryExpressionIR

   paths

    rulepath true
    -- Expr_eval_lctk: p TC |- typedExpressionIR_cond ~> value
    -- if (value = _B true as value)
    -- Expr_eval_lctk: p TC |- typedExpressionIR_true ~> value_true
    -- output: % % |- % ~> value_true

    rulepath false
    -- Expr_eval_lctk: p TC |- typedExpressionIR_cond ~> value
    -- if (value = _B false as value)
    -- Expr_eval_lctk: p TC |- typedExpressionIR_false ~> value_false
    -- output: % % |- % ~> value_false

  rulegroup castExpressionIR

   match

    (signature) p TC |- `( typeIR `) typedExpressionIR as expressionIR '#' _expressionNoteIR ~> %
    p TC |- expressionIR '#' _expressionNoteIR ~> %
    -- if expressionIR <: castExpressionIR
    -- let `( typeIR `) typedExpressionIR = expressionIR as castExpressionIR

   paths

    rulepath castExpressionIR
    -- Expr_eval_lctk: p TC |- typedExpressionIR ~> value
    -- let value_cast = $cast_op(typeIR, value)
    -- output: % % |- % ~> value_cast

  rulegroup invalidHeaderExpressionIR

   match

    (signature) p TC |- '{#}' as expressionIR '#' _expressionNoteIR ~> %
    p TC |- expressionIR '#' _expressionNoteIR ~> %
    -- if expressionIR <: invalidHeaderExpression
    -- let invalidHeaderExpression = expressionIR as invalidHeaderExpression
    -- if (invalidHeaderExpression = '{#}')

   paths

    rulepath invalidHeaderExpressionIR
    -- output: % % |- % ~> '{#}' as value

  rulegroup sequenceExpressionIR

   match

    (signature) p TC |- sequenceExpressionIR as expressionIR '#' _expressionNoteIR ~> %
    p TC |- expressionIR '#' _expressionNoteIR ~> %
    -- if expressionIR <: sequenceExpressionIR
    -- let sequenceExpressionIR = expressionIR as sequenceExpressionIR

   paths

    rulepath non-default
    -- let sequenceExpressionIR' = sequenceExpressionIR
    -- if sequenceExpressionIR' matches `SEQ {%}`
    -- let SEQ `{ typedExpressionIR*{typedExpressionIR <- typedExpressionIR*} `} = sequenceExpressionIR'
    -- (Expr_eval_lctk: p TC |- typedExpressionIR ~> value)*{typedExpressionIR <- typedExpressionIR*, value -> value*}
    -- output: % % |- % ~> SEQ `( value*{value <- value*} `) as value

    rulepath default
    -- let sequenceExpressionIR' = sequenceExpressionIR
    -- if sequenceExpressionIR' matches `SEQ {% , ...}`
    -- let SEQ `{ typedExpressionIR*{typedExpressionIR <- typedExpressionIR*} ',' '...' `} = sequenceExpressionIR'
    -- (Expr_eval_lctk: p TC |- typedExpressionIR ~> value)*{typedExpressionIR <- typedExpressionIR*, value -> value*}
    -- output: % % |- % ~> SEQ `( value*{value <- value*} ',' '...' `) as value

  rulegroup recordExpressionIR

   match

    (signature) p TC |- recordExpressionIR as expressionIR '#' _expressionNoteIR ~> %
    p TC |- expressionIR '#' _expressionNoteIR ~> %
    -- if expressionIR <: recordExpressionIR
    -- let recordExpressionIR = expressionIR as recordExpressionIR

   paths

    rulepath non-default
    -- let recordExpressionIR' = recordExpressionIR
    -- if recordExpressionIR' matches `RECORD {%}`
    -- let RECORD `{ nameIR '=' typedExpressionIR*{nameIR <- nameIR*, typedExpressionIR <- typedExpressionIR*} `} = recordExpressionIR'
    -- (Expr_eval_lctk: p TC |- typedExpressionIR ~> value)*{typedExpressionIR <- typedExpressionIR*, value -> value*}
    -- output: % % |- % ~> RECORD `{ value nameIR ';'*{nameIR <- nameIR*, value <- value*} `} as value

    rulepath default
    -- let recordExpressionIR' = recordExpressionIR
    -- if recordExpressionIR' matches `RECORD {% , ...}`
    -- let RECORD `{ nameIR '=' typedExpressionIR*{nameIR <- nameIR*, typedExpressionIR <- typedExpressionIR*} ',' '...' `} = recordExpressionIR'
    -- (Expr_eval_lctk: p TC |- typedExpressionIR ~> value)*{typedExpressionIR <- typedExpressionIR*, value -> value*}
    -- output: % % |- % ~> RECORD `{ value nameIR ';'*{nameIR <- nameIR*, value <- value*} ',' '...' `} as value

  rulegroup errorAccessExpressionIR

   match

    (signature) p TC |- ERROR '.' nameIR as expressionIR '#' `( _typeIR _ctk `) ~> %
    p TC |- expressionIR '#' `( _typeIR _ctk `) ~> %
    -- if expressionIR <: errorAccessExpressionIR
    -- let ERROR '.' nameIR = expressionIR as errorAccessExpressionIR

   paths

    rulepath errorAccessExpressionIR
    -- let nameIR_error = "error." ++ nameIR
    -- let value_error = $find_var_value_t(_BARE nameIR_error, p, TC)
    -- output: % % |- % ~> value_error

  rulegroup memberAccessExpressionIR-type

   match

    (signature) p TC |- TYPE prefixedNameIR_base '.' nameIR as expressionIR '#' _expressionNoteIR ~> %
    p TC |- expressionIR '#' _expressionNoteIR ~> %
    -- if expressionIR <: memberAccessExpressionIR
    -- let memberAccessBaseIR '.' nameIR = expressionIR as memberAccessExpressionIR
    -- if memberAccessBaseIR matches `TYPE %`
    -- let TYPE prefixedNameIR_base = memberAccessBaseIR

   paths

    rulepath enum
    -- let typeDefIR?{typeDefIR <- typeDefIR?} = $find_typeDef_t(p, TC, prefixedNameIR_base)
    -- if typeDefIR?{typeDefIR <- typeDefIR?} matches (_)
    -- let ?(typeDefIR_base) = typeDefIR?{typeDefIR <- typeDefIR?}
    -- if $is_monomorphic_typeDefIR(typeDefIR_base)
    -- let typeIR_base = $typeIR_of_typeDefIR(typeDefIR_base)
    -- let typeIR' = $unroll_typeIR(typeIR_base)
    -- if typeIR' <: simpleEnumTypeIR
    -- let ENUM typeId `{ nameIR_field*{nameIR_field <- nameIR_field*} `} = typeIR' as simpleEnumTypeIR
    -- if nameIR <- nameIR_field*{nameIR_field <- nameIR_field*}
    -- output: % % |- % ~> typeId '.' nameIR as value

