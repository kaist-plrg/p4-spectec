    rulepath listTypeIR
    -- if Type_alpha: typeIR_a ~~ typeIR_b holds
    -- the relation holds

  rulegroup tupleTypeIR

   match

    (signature) TUPLE `< typeIR_a*{typeIR_a <- typeIR_a*} `> as typeIR ~~ TUPLE `< typeIR_b*{typeIR_b <- typeIR_b*} `> as typeIR
    typeIR ~~ typeIR'
    -- if typeIR <: tupleTypeIR
