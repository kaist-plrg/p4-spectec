  clause 1 : (switchCaseIR) = switchLabel ':'
  -- if switchCaseIR matches `% :`
  -- let switchLabelIR ':' = switchCaseIR
  -- let switchLabel = $lift_switchLabelIR(switchLabelIR)

def $lift_switchCaseListIR(switchCaseIR*) : switchCaseList =

