    -- if typeIR' <: headerUnionTypeIR
    -- let HEADER_UNION typeId' `< typeArgumentIR_b*{typeArgumentIR_b <- typeArgumentIR_b*} `> `{ _fieldTypeIR'*{_fieldTypeIR' <- _fieldTypeIR'*} `} = typeIR' as headerUnionTypeIR
    -- if (typeId = typeId')

   paths

    rulepath headerUnionTypeIR
    -- if (|typeArgumentIR_a*{typeArgumentIR_a <- typeArgumentIR_a*}| = |typeArgumentIR_b*{typeArgumentIR_b <- typeArgumentIR_b*}|)
    -- (if Type_alpha: typeArgumentIR_a ~~ typeArgumentIR_b holds)*{typeArgumentIR_a <- typeArgumentIR_a*, typeArgumentIR_b <- typeArgumentIR_b*}
    -- the relation holds

  rulegroup enumTypeIR

   match

    (signature) typeIR ~~ typeIR'
    typeIR ~~ typeIR'

   paths

    rulepath non-serializable
    -- let typeIR'' = typeIR
    -- if typeIR'' <: simpleEnumTypeIR
    -- let ENUM typeId `{ nameIR_field*{nameIR_field <- nameIR_field*} `} = typeIR'' as simpleEnumTypeIR
    -- if (typeIR' = ENUM typeId `{ nameIR_field*{nameIR_field <- nameIR_field*} `} as typeIR)
