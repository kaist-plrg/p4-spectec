  -- let typeParameter_h :: typeParameter_t*{typeParameter_t <- typeParameter_t*} = typeParameter*{typeParameter <- typeParameter*}

def $lift_constantInitializerOptIR_as_initializerOpt(constantInitializerIR?) : initializerOpt =

  clause 0 : (constantInitializerIR?{constantInitializerIR <- constantInitializerIR?}) = _EMPTY
  -- if constantInitializerIR?{constantInitializerIR <- constantInitializerIR?} matches ()

  clause 1 : (constantInitializerIR'?{constantInitializerIR' <- constantInitializerIR'?}) = $lift_constantInitializerIR_as_initializer(constantInitializerIR) as initializerOpt
