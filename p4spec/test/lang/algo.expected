  clause 1 : (annotationList typeIR constructorTargetIR `( argumentIR*{argumentIR <- argumentIR*} `) nameIR objectInitializerIR?{objectInitializerIR <- objectInitializerIR?} ';') = annotationList type `( argumentList `) name ';'
  -- if objectInitializerIR?{objectInitializerIR <- objectInitializerIR?} matches ()
