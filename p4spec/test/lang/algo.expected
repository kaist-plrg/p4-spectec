  -- let recordElementExpression = $unflatten_recordElementExpression(namedExpression*{namedExpression <- namedExpression*})

  clause 4 : (dataExpressionIR) = `{ recordElementExpression as sequenceOrRecordElementExpression _EMPTY `} as dataExpression
