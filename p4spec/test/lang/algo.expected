  -- let name = $lift_nameIR_as_nonTypeName(nameIR) as name
  -- let objectDeclarationList = $lift_objectDeclarationListIR(objectDeclarationIR*{objectDeclarationIR <- objectDeclarationIR*})

  clause 3 : (annotationList typeIR constructorTargetIR `( argumentIR*{argumentIR <- argumentIR*} `) nameIR objectInitializerOptIR ';') = annotationList type `( argumentList `) name '=' `{ objectDeclarationList `} ';'
