relation Type_alpha: typeIR ~~ typeIR

  rulegroup baseTypeIR

   match

    (signature) baseTypeIR as typeIR ~~ baseTypeIR as typeIR
    typeIR ~~ typeIR'
    -- if typeIR <: baseTypeIR
    -- let baseTypeIR = typeIR as baseTypeIR
    -- if typeIR' <: baseTypeIR
    -- let baseTypeIR' = typeIR' as baseTypeIR
    -- if (baseTypeIR = baseTypeIR')

   paths

    rulepath baseTypeIR
    -- the relation holds

  rulegroup nameTypeIR

   match

    (signature) _NAME typeId as typeIR ~~ _NAME typeId as typeIR
    typeIR ~~ typeIR'
    -- if typeIR <: nameTypeIR
    -- let _NAME typeId = typeIR as nameTypeIR
    -- if typeIR' <: nameTypeIR
    -- let _NAME typeId' = typeIR' as nameTypeIR
