var b : bool

var i : int

var n : nat

var w : nat

var t : text

def $ite<X>(bool, X, X) : X =

  clause 0 : (b, X_t, X_f) = X_t
  -- if (b = true)

  clause 1 : (b, X_t, X_f) = X_f
  -- if (b = false)

builtin def $sum_nat(nat*) : nat

builtin def $max_nat(nat*) : nat

builtin def $min_nat(nat*) : nat

builtin def $sum_int(int*) : int

builtin def $max_int(int*) : int

builtin def $min_int(int*) : int

builtin def $text_to_int(text) : int

builtin def $int_to_text(int) : text

builtin def $split_text(text, text) : text*

def $concat_text(text*) : text =

  clause 0 : (t*{t <- t*}) = ""
  -- if t*{t <- t*} matches []

  clause 1 : (t*{t <- t*}) = t_h ++ $concat_text(t_t*{t_t <- t_t*})
  -- if t*{t <- t*} matches _ :: _
  -- let t_h :: t_t*{t_t <- t_t*} = t*{t <- t*}

def $join_text(text*, text) : text =

  clause 0 : (t*{t <- t*}, t_sep) = ""
  -- if t*{t <- t*} matches []

  clause 1 : (t*{t <- t*}, t_sep) = t_h
  -- if t*{t <- t*} matches [ _/1 ]
  -- let [t_h] = t*{t <- t*}

  clause 2 : (t'*{t' <- t'*}, t_sep) = t_h1 ++ t_sep ++ $join_text(t_h2 :: t_t*{t_t <- t_t*}, t_sep)
  -- if t'*{t' <- t'*} matches _ :: _
  -- let t_h1 :: t*{t <- t*} = t'*{t' <- t'*}
  -- if t*{t <- t*} matches _ :: _
  -- let t_h2 :: t_t*{t_t <- t_t*} = t*{t <- t*}

def $replace_text(text, text, text) : text =

  clause 0 : (t, t_old, t_new) = $replace_text'(0, |t|, t, t_old, t_new)

def $replace_text'(nat, nat, text, text, text) : text =

  clause 0 : (n_len, n_len', t, t_old, t_new) = t
  -- if (n_len = n_len')

  clause 1 : (n, n_len, t, t_old, t_new) = $replace_text'((n + 1), n_len, t_replaced, t_old, t_new)
  -- if (n < n_len)
  -- if (n < |t|)
  -- let t_replaced = $ite<text>((t[n] = t_old), t[[n] = t_new], t)

def $replace_text_except(text, text, text) : text =

  clause 0 : (t, t_old, t_new) = $replace_text_except'(0, |t|, t, t_old, t_new)

def $replace_text_except'(nat, nat, text, text, text) : text =

  clause 0 : (n_len, n_len', t, t_old, t_new) = t
  -- if (n_len = n_len')

  clause 1 : (n, n_len, t, t_old, t_new) = $replace_text_except'((n + 1), n_len, t_replaced, t_old, t_new)
  -- if (n < n_len)
  -- if (n < |t|)
  -- let t_replaced = $ite<text>((t[n] = t_old), t, t[[n] = t_new])

builtin def $strip_prefix(text, text) : text

builtin def $strip_suffix(text, text) : text

builtin def $strip_all_whitespace(text) : text

def $starts_with(text, text) : bool =

  clause 0 : (t, t_prefix) = true
  -- if (|t_prefix| <= |t|)
  -- if (t[0 : |t_prefix|] = t_prefix)

  clause -1 : (t, t_prefix) = false

def $ends_with(text, text) : bool =

  clause 0 : (t, t_suffix) = true
  -- if (|t_suffix| <= |t|)
  -- let i = (|t| - |t_suffix|)
  -- if i <: nat
  -- let n_start = i as nat
  -- if (t[n_start : |t_suffix|] = t_suffix)

  clause -1 : (t, t_suffix) = false

def $strip_prefix_rec(text, text) : text =

  clause 0 : (t, t_prefix) = $strip_prefix_rec(t_stripped, t_prefix)
  -- if $starts_with(t, t_prefix)
  -- let t_stripped = $strip_prefix(t, t_prefix)

  clause 1 : (t, t_prefix) = t
  -- if ~$starts_with(t, t_prefix)

def $strip_suffix_rec(text, text) : text =

  clause 0 : (t, t_suffix) = $strip_suffix_rec(t_stripped, t_suffix)
  -- if $ends_with(t, t_suffix)
  -- let t_stripped = $strip_suffix(t, t_suffix)

  clause 1 : (t, t_suffix) = t
  -- if ~$ends_with(t, t_suffix)

def $contains(text, text) : bool =

  clause 0 : (t, t_c) = $contains'(0, |t|, t, t_c)

def $contains'(nat, nat, text, text) : bool =

  clause 0 : (n_len, n_len', t, t_c) = false
  -- if (n_len = n_len')

  clause 1 : (n, n_len, t, t_c) = true
  -- if (n < n_len)
  -- if (n < |t|)
  -- if (t[n] = t_c)

  clause 2 : (n, n_len, t, t_c) = $contains'((n + 1), n_len, t, t_c)
  -- if (n < n_len)
  -- if (n < |t|)
  -- if (t[n] =/= t_c)

def $is_some_<X>(X?) : bool =

  clause 0 : (X?{X <- X?}) = false
  -- if X?{X <- X?} matches ()

  clause 1 : (X'?{X' <- X'?}) = true
  -- if X'?{X' <- X'?} matches (_)
  -- let ?(X) = X'?{X' <- X'?}

def $opt_as_seq_<X>(X?) : X* =

  clause 0 : (X?{X <- X?}) = []
  -- if X?{X <- X?} matches ()

  clause 1 : (X'?{X' <- X'?}) = [X]
  -- if X'?{X' <- X'?} matches (_)
  -- let ?(X) = X'?{X' <- X'?}

def $exists_(bool*) : bool =

  clause 0 : (b*{b <- b*}) = false
  -- if b*{b <- b*} matches []

  clause 1 : (b*{b <- b*}) = (b_h \/ $exists_(b_t*{b_t <- b_t*}))
  -- if b*{b <- b*} matches _ :: _
  -- let b_h :: b_t*{b_t <- b_t*} = b*{b <- b*}

def $forall_(bool*) : bool =

  clause 0 : (b*{b <- b*}) = true
  -- if b*{b <- b*} matches []

  clause 1 : (b*{b <- b*}) = (b_h /\ $forall_(b_t*{b_t <- b_t*}))
  -- if b*{b <- b*} matches _ :: _
  -- let b_h :: b_t*{b_t <- b_t*} = b*{b <- b*}

def $init_(nat) : nat* =

  clause 0 : (nat) = []
  -- if (nat = 0)

  clause 1 : (n) = n' :: $init_(n')
  -- if (n =/= 0)
  -- let i = (n - 1)
  -- if i <: nat
  -- let n' = i as nat

def $repeat_<X>(X, nat) : X* =

  clause 0 : (X, nat) = []
  -- if (nat = 0)

  clause 1 : (X, n) = [X] ++ $repeat_<X>(X, n')
  -- if (n =/= 0)
  -- let i = (n - 1)
  -- if i <: nat
  -- let n' = i as nat

builtin def $rev_<X>(X*) : X*

builtin def $concat_<X>(X**) : X*

builtin def $partition_<X>(X*, nat) : (X*, X*)

def $filter_<X>(X*, bool*) : X* =

  clause 0 : (X*{X <- X*}, b*{b <- b*}) = []
  -- if X*{X <- X*} matches []
  -- if b*{b <- b*} matches []

  clause 1 : (X*{X <- X*}, b*{b <- b*}) = X_h :: $filter_<X>(X_t*{X_t <- X_t*}, b_t*{b_t <- b_t*})
  -- if X*{X <- X*} matches _ :: _
  -- let X_h :: X_t*{X_t <- X_t*} = X*{X <- X*}
  -- if b*{b <- b*} matches _ :: _
  -- let b_h :: b_t*{b_t <- b_t*} = b*{b <- b*}
  -- if b_h

  clause 2 : (X*{X <- X*}, b*{b <- b*}) = $filter_<X>(X_t*{X_t <- X_t*}, b_t*{b_t <- b_t*})
  -- if X*{X <- X*} matches _ :: _
  -- let X_h :: X_t*{X_t <- X_t*} = X*{X <- X*}
  -- if b*{b <- b*} matches _ :: _
  -- let b_h :: b_t*{b_t <- b_t*} = b*{b <- b*}
  -- if ~b_h

builtin def $assoc_<X, Y>(X, (X, Y)*) : Y?

builtin def $sort_<X>((nat, X)*) : (nat, X)*

builtin def $distinct_<K>(K*) : bool

syntax set<K> = 
   | `{ K* `} (from set<K>) 

def $empty_set<K> : set<K> =

  clause 0 :  = `{ [] `}

def $in_set<K>(K, set<K>) : bool =

  clause 0 : (K, `{ K_e*{K_e <- K_e*} `}) = K <- K_e*{K_e <- K_e*}

builtin def $intersect_set<K>(set<K>, set<K>) : set<K>

builtin def $union_set<K>(set<K>, set<K>) : set<K>

builtin def $unions_set<K>(set<K>*) : set<K>

builtin def $diff_set<K>(set<K>, set<K>) : set<K>

builtin def $sub_set<K>(set<K>, set<K>) : bool

builtin def $eq_set<K>(set<K>, set<K>) : bool

syntax pair<K, V> = 
   | K ':' V (from pair<K, V>) 

syntax map<K, V> = set<pair<K, V>>

def $empty_map<K, V> : map<K, V> =

  clause 0 :  = `{ [] `}

def $dom_map<K, V>(map<K, V>) : set<K> =

  clause 0 : (`{ K ':' V*{K <- K*, V <- V*} `}) = `{ K*{K <- K*} `}

def $codom_map<K, V>(map<K, V>) : set<V> =

  clause 0 : (`{ K ':' V*{K <- K*, V <- V*} `}) = `{ V*{V <- V*} `}

builtin def $find_map<K, V>(map<K, V>, K) : V?

builtin def $find_maps<K, V>(map<K, V>*, K) : V?

builtin def $add_map<K, V>(map<K, V>, K, V) : map<K, V>

builtin def $adds_map<K, V>(map<K, V>, K*, V*) : map<K, V>

builtin def $update_map<K, V>(map<K, V>, K, V) : map<K, V>

def $extend_map<K, V>(map<K, V>, map<K, V>) : map<K, V> =

  clause 0 : (`{ K_a ':' V_a*{K_a <- K_a*, V_a <- V_a*} `}, `{ K_b ':' V_b*{K_b <- K_b*, V_b <- V_b*} `}) = `{ K_c ':' V_c*{K_c <- K_c*, V_c <- V_c*} `}
  -- let `{ K_c ':' V_c*{K_c <- K_c*, V_c <- V_c*} `} = $adds_map<K, V>(`{ K_a ':' V_a*{K_a <- K_a*, V_a <- V_a*} `}, K_b*{K_b <- K_b*}, V_b*{V_b <- V_b*})

builtin def $print_<X>(X) : text

def $modulo(nat, nat) : nat? =

  clause 0 : (n_a, n_b) = ?((n_a \ n_b))
  -- if (n_b =/= 0)

  clause 1 : (n_a, n_b) = ?()
  -- if (n_b = 0)

def $modulo_42(nat) : nat =

  clause 0 : (n) = n_result
  -- let nat?{nat <- nat?} = $modulo(n, 42)
  -- if nat?{nat <- nat?} matches (_)
  -- let ?(n_result) = nat?{nat <- nat?}

syntax trailingCommaOpt = 
   | _EMPTY (from trailingCommaOpt) 
   | ',' (from trailingCommaOpt) 

syntax booleanLiteral = 
   | TRUE (from booleanLiteral) 
   | FALSE (from booleanLiteral) 

syntax integerLiteral = 
   | D int (from integerLiteral)  hint(print %)
   | nat W int (from integerLiteral)  hint(print %#W#%)
   | nat S int (from integerLiteral)  hint(print %#S#%)

syntax stringLiteral = 
   | '"' text '"' (from stringLiteral)  hint(print '"'#%#'"')

syntax identifier = 
   | _ID text (from identifier) 

syntax typeIdentifier = 
   | _TID text (from typeIdentifier) 

syntax nonTypeName = 
   | _ID text (from identifier) 
   | APPLY (from nonTypeName) 
   | KEY (from nonTypeName) 
   | ACTIONS (from nonTypeName) 
   | STATE (from nonTypeName) 
   | ENTRIES (from nonTypeName) 
   | TYPE (from nonTypeName) 
   | PRIORITY (from nonTypeName) 

syntax prefixedNonTypeName = 
   | _ID text (from identifier) 
   | APPLY (from nonTypeName) 
   | KEY (from nonTypeName) 
   | ACTIONS (from nonTypeName) 
   | STATE (from nonTypeName) 
   | ENTRIES (from nonTypeName) 
   | TYPE (from nonTypeName) 
   | PRIORITY (from nonTypeName) 
   | _ID '.' nonTypeName (from prefixedNonTypeName) 

syntax typeName = typeIdentifier

syntax prefixedTypeName = 
   | _TID text (from typeIdentifier) 
   | _TID '.' typeName (from prefixedTypeName) 

syntax tableCustomName = 
   | _ID text (from identifier) 
   | _TID text (from typeIdentifier) 
   | APPLY (from tableCustomName) 
   | STATE (from tableCustomName) 
   | TYPE (from tableCustomName) 
   | PRIORITY (from tableCustomName) 

syntax name = 
   | _ID text (from identifier) 
   | APPLY (from nonTypeName) 
   | KEY (from nonTypeName) 
   | ACTIONS (from nonTypeName) 
   | STATE (from nonTypeName) 
   | ENTRIES (from nonTypeName) 
   | TYPE (from nonTypeName) 
   | PRIORITY (from nonTypeName) 
   | _TID text (from typeIdentifier) 
   | LIST (from name) 

syntax nameList = 
   | _ID text (from identifier) 
   | APPLY (from nonTypeName) 
   | KEY (from nonTypeName) 
   | ACTIONS (from nonTypeName) 
   | STATE (from nonTypeName) 
   | ENTRIES (from nonTypeName) 
   | TYPE (from nonTypeName) 
   | PRIORITY (from nonTypeName) 
   | _TID text (from typeIdentifier) 
   | LIST (from name) 
   | nameList ',' name (from nameList) 

def $flatten_nameList(nameList) : name* =

  clause 0 : (nameList) = [name]
  -- if nameList <: name
  -- let name = nameList as name

  clause 1 : (nameList') = $flatten_nameList(nameList) ++ [name]
  -- if nameList' matches `% , %`
  -- let nameList ',' name = nameList'

syntax member = name

syntax direction = 
   | _EMPTY (from direction) 
   | IN (from direction) 
   | OUT (from direction) 
   | INOUT (from direction) 

syntax baseType = 
   | BOOL (from baseType) 
   | ERROR (from baseType) 
   | MATCH_KIND (from baseType) 
   | STRING (from baseType) 
   | INT (from baseType) 
   | INT `< int `> (from baseType) 
   | INT `< `( expression `) `> (from baseType) 
   | BIT (from baseType) 
   | BIT `< int `> (from baseType) 
   | BIT `< `( expression `) `> (from baseType) 
   | VARBIT `< int `> (from baseType) 
   | VARBIT `< `( expression `) `> (from baseType) 

syntax specializedType = 
   | prefixedTypeName `< typeArgumentList `> (from specializedType) 

syntax namedType = 
   | _TID text (from typeIdentifier) 
   | _TID '.' typeName (from prefixedTypeName) 
   | prefixedTypeName `< typeArgumentList `> (from specializedType) 

syntax arrayType = 
   | type `[ expression `] (from arrayType) 

syntax listType = 
   | LIST `< typeArgument `> (from listType) 

syntax tupleType = 
   | TUPLE `< typeArgumentList `> (from tupleType) 

syntax type = 
   | BOOL (from baseType) 
   | ERROR (from baseType) 
   | MATCH_KIND (from baseType) 
   | STRING (from baseType) 
   | INT (from baseType) 
   | INT `< int `> (from baseType) 
   | INT `< `( expression `) `> (from baseType) 
   | BIT (from baseType) 
   | BIT `< int `> (from baseType) 
   | BIT `< `( expression `) `> (from baseType) 
   | VARBIT `< int `> (from baseType) 
   | VARBIT `< `( expression `) `> (from baseType) 
   | _TID text (from typeIdentifier) 
   | _TID '.' typeName (from prefixedTypeName) 
   | prefixedTypeName `< typeArgumentList `> (from specializedType) 
   | type `[ expression `] (from arrayType) 
   | LIST `< typeArgument `> (from listType) 
   | TUPLE `< typeArgumentList `> (from tupleType) 

syntax typeOrVoid = 
   | BOOL (from baseType) 
   | ERROR (from baseType) 
   | MATCH_KIND (from baseType) 
   | STRING (from baseType) 
   | INT (from baseType) 
   | INT `< int `> (from baseType) 
   | INT `< `( expression `) `> (from baseType) 
   | BIT (from baseType) 
   | BIT `< int `> (from baseType) 
   | BIT `< `( expression `) `> (from baseType) 
   | VARBIT `< int `> (from baseType) 
   | VARBIT `< `( expression `) `> (from baseType) 
   | _TID text (from typeIdentifier) 
   | _TID '.' typeName (from prefixedTypeName) 
   | prefixedTypeName `< typeArgumentList `> (from specializedType) 
   | type `[ expression `] (from arrayType) 
   | LIST `< typeArgument `> (from listType) 
   | TUPLE `< typeArgumentList `> (from tupleType) 
   | VOID (from typeOrVoid) 
   | _ID text (from identifier) 

syntax typeParameter = name

syntax typeParameterList = 
   | _ID text (from identifier) 
   | APPLY (from nonTypeName) 
   | KEY (from nonTypeName) 
   | ACTIONS (from nonTypeName) 
   | STATE (from nonTypeName) 
   | ENTRIES (from nonTypeName) 
   | TYPE (from nonTypeName) 
   | PRIORITY (from nonTypeName) 
   | _TID text (from typeIdentifier) 
   | LIST (from name) 
   | typeParameterList ',' typeParameter (from typeParameterList) 

def $flatten_typeParameterList(typeParameterList) : typeParameter* =

  clause 0 : (typeParameterList) = [typeParameter]
  -- if typeParameterList <: typeParameter
  -- let typeParameter = typeParameterList as typeParameter

  clause 1 : (typeParameterList') = $flatten_typeParameterList(typeParameterList) ++ [typeParameter]
  -- if typeParameterList' matches `% , %`
  -- let typeParameterList ',' typeParameter = typeParameterList'

syntax typeParameterListOpt = 
   | _EMPTY (from typeParameterListOpt) 
   | `< typeParameterList `> (from typeParameterListOpt) 

def $flatten_typeParameterListOpt(typeParameterListOpt) : typeParameter* =

  clause 0 : (typeParameterListOpt) = []
  -- if typeParameterListOpt matches `/* empty */`

  clause 1 : (typeParameterListOpt) = $flatten_typeParameterList(typeParameterList)
  -- if typeParameterListOpt matches `<%>`
  -- let `< typeParameterList `> = typeParameterListOpt

syntax parameter = 
   | annotationList direction type name initializerOpt (from parameter) 

syntax nonEmptyParameterList = 
   | annotationList direction type name initializerOpt (from parameter) 
   | nonEmptyParameterList ',' parameter (from nonEmptyParameterList) 

syntax parameterList = 
   | _EMPTY (from parameterList) 
   | annotationList direction type name initializerOpt (from parameter) 
   | nonEmptyParameterList ',' parameter (from nonEmptyParameterList) 

def $flatten_parameterList(parameterList) : parameter* =

  clause 0 : (parameterList) = []
  -- if parameterList matches `/* empty */`

  clause 1 : (parameterList) = [parameter]
  -- if parameterList <: parameter
  -- let parameter = parameterList as parameter

  clause 2 : (parameterList) = $flatten_parameterList(nonEmptyParameterList as parameterList) ++ [parameter]
  -- if parameterList <: nonEmptyParameterList
  -- let nonEmptyParameterList' = parameterList as nonEmptyParameterList
  -- if nonEmptyParameterList' matches `% , %`
  -- let nonEmptyParameterList ',' parameter = nonEmptyParameterList'

syntax constructorParameter = parameter

syntax constructorParameterList = parameterList

syntax constructorParameterListOpt = 
   | _EMPTY (from constructorParameterListOpt) 
   | `( parameterList `) (from constructorParameterListOpt) 

def $flatten_constructorParameterListOpt(constructorParameterListOpt) : constructorParameter* =

  clause 0 : (constructorParameterListOpt) = []
  -- if constructorParameterListOpt matches `/* empty */`

  clause 1 : (constructorParameterListOpt) = $flatten_parameterList(parameterList)
  -- if constructorParameterListOpt matches `(%)`
  -- let `( parameterList `) = constructorParameterListOpt

syntax namedExpression = 
   | name '=' expression (from namedExpression) 

syntax namedExpressionList = 
   | name '=' expression (from namedExpression) 
   | namedExpressionList ',' namedExpression (from namedExpressionList) 

def $flatten_namedExpressionList(namedExpressionList) : namedExpression* =

  clause 0 : (namedExpressionList) = [namedExpression]
  -- if namedExpressionList <: namedExpression
  -- let namedExpression = namedExpressionList as namedExpression

  clause 1 : (namedExpressionList') = $flatten_namedExpressionList(namedExpressionList) ++ [namedExpression]
  -- if namedExpressionList' matches `% , %`
  -- let namedExpressionList ',' namedExpression = namedExpressionList'

syntax literalExpression = 
   | TRUE (from booleanLiteral) 
   | FALSE (from booleanLiteral) 
   | D int (from integerLiteral)  hint(print %)
   | nat W int (from integerLiteral)  hint(print %#W#%)
   | nat S int (from integerLiteral)  hint(print %#S#%)
   | '"' text '"' (from stringLiteral)  hint(print '"'#%#'"')

syntax referenceExpression = 
   | _ID text (from identifier) 
   | APPLY (from nonTypeName) 
   | KEY (from nonTypeName) 
   | ACTIONS (from nonTypeName) 
   | STATE (from nonTypeName) 
   | ENTRIES (from nonTypeName) 
   | TYPE (from nonTypeName) 
   | PRIORITY (from nonTypeName) 
   | _ID '.' nonTypeName (from prefixedNonTypeName) 
   | THIS (from referenceExpression) 

syntax defaultExpression = 
   | '...' (from defaultExpression) 

syntax unop = 
   | '!' (from unop) 
   | '~' (from unop) 
   | '-' (from unop) 
   | '+' (from unop) 

syntax unaryExpression = 
   | unop expression (from unaryExpression) 

syntax binop = 
   | '*' (from binop) 
   | '/' (from binop) 
   | '%' (from binop) 
   | '+' (from binop) 
   | '-' (from binop) 
   | '|+|' (from binop) 
   | '|-|' (from binop) 
   | '<<' (from binop) 
   | '>>' (from binop) 
   | '<=' (from binop) 
   | '>=' (from binop) 
   | '<' (from binop) 
   | '>' (from binop) 
   | '!=' (from binop) 
   | '==' (from binop) 
   | '&' (from binop) 
   | '^' (from binop) 
   | '|' (from binop) 
   | '++' (from binop) 
   | '&&' (from binop) 
   | '||' (from binop) 

syntax binaryExpression = 
   | expression binop expression (from binaryExpression) 

syntax binaryExpressionNonBrace = 
   | expressionNonBrace binop expression (from binaryExpressionNonBrace) 

syntax ternaryExpression = 
   | expression '?' expression ':' expression (from ternaryExpression) 

syntax ternaryExpressionNonBrace = 
   | expressionNonBrace '?' expression ':' expression (from ternaryExpressionNonBrace) 

syntax castExpression = 
   | `( type `) expression (from castExpression) 

syntax invalidHeaderExpression = 
   | '{#}' (from invalidHeaderExpression) 

syntax sequenceOrRecordExpression = 
   | `{ sequenceOrRecordElementExpression trailingCommaOpt `} (from sequenceOrRecordExpression) 

syntax dataExpression = 
   | '{#}' (from invalidHeaderExpression) 
   | `{ sequenceOrRecordElementExpression trailingCommaOpt `} (from sequenceOrRecordExpression) 

syntax errorAccessExpression = 
   | ERROR '.' member (from errorAccessExpression) 

syntax memberAccessExpression = 
   | memberAccessBase '.' member (from memberAccessExpression) 

syntax indexAccessExpression = 
   | expression `[ expression `] (from indexAccessExpression) 

syntax sliceop = 
   | ':' (from sliceop) 
   | '+:' (from sliceop) 

syntax sliceAccessExpression = 
   | expression `[ expression sliceop expression `] (from sliceAccessExpression) 

syntax accessExpression = 
   | ERROR '.' member (from errorAccessExpression) 
   | memberAccessBase '.' member (from memberAccessExpression) 
   | expression `[ expression `] (from indexAccessExpression) 
   | expression `[ expression sliceop expression `] (from sliceAccessExpression) 

syntax memberAccessExpressionNonBrace = 
   | memberAccessBaseNonBrace '.' member (from memberAccessExpressionNonBrace) 

syntax indexAccessExpressionNonBrace = 
   | expressionNonBrace `[ expression `] (from indexAccessExpressionNonBrace) 

syntax sliceAccessExpressionNonBrace = 
   | expressionNonBrace `[ expression sliceop expression `] (from sliceAccessExpressionNonBrace) 

syntax accessExpressionNonBrace = 
   | ERROR '.' member (from errorAccessExpression) 
   | memberAccessBaseNonBrace '.' member (from memberAccessExpressionNonBrace) 
   | expressionNonBrace `[ expression `] (from indexAccessExpressionNonBrace) 
   | expressionNonBrace `[ expression sliceop expression `] (from sliceAccessExpressionNonBrace) 

syntax callExpression = 
   | callTarget `( argumentList `) (from callExpression) 
   | callableTarget `< realTypeArgumentList `> `( argumentList `) (from callExpression) 

syntax callExpressionNonBrace = 
   | callTargetNonBrace `( argumentList `) (from callExpressionNonBrace) 
   | callableTargetNonBrace `< realTypeArgumentList `> `( argumentList `) (from callExpressionNonBrace) 

syntax parenthesizedExpression = 
   | `( expression `) (from parenthesizedExpression) 

syntax expression = 
   | TRUE (from booleanLiteral) 
   | FALSE (from booleanLiteral) 
   | D int (from integerLiteral)  hint(print %)
   | nat W int (from integerLiteral)  hint(print %#W#%)
   | nat S int (from integerLiteral)  hint(print %#S#%)
   | '"' text '"' (from stringLiteral)  hint(print '"'#%#'"')
   | _ID text (from identifier) 
   | APPLY (from nonTypeName) 
   | KEY (from nonTypeName) 
   | ACTIONS (from nonTypeName) 
   | STATE (from nonTypeName) 
   | ENTRIES (from nonTypeName) 
   | TYPE (from nonTypeName) 
   | PRIORITY (from nonTypeName) 
   | _ID '.' nonTypeName (from prefixedNonTypeName) 
   | THIS (from referenceExpression) 
   | '...' (from defaultExpression) 
   | unop expression (from unaryExpression) 
   | expression binop expression (from binaryExpression) 
   | expression '?' expression ':' expression (from ternaryExpression) 
   | `( type `) expression (from castExpression) 
   | '{#}' (from invalidHeaderExpression) 
   | `{ sequenceOrRecordElementExpression trailingCommaOpt `} (from sequenceOrRecordExpression) 
   | ERROR '.' member (from errorAccessExpression) 
   | memberAccessBase '.' member (from memberAccessExpression) 
   | expression `[ expression `] (from indexAccessExpression) 
   | expression `[ expression sliceop expression `] (from sliceAccessExpression) 
   | callTarget `( argumentList `) (from callExpression) 
   | callableTarget `< realTypeArgumentList `> `( argumentList `) (from callExpression) 
   | `( expression `) (from parenthesizedExpression) 

syntax expressionList = 
   | _EMPTY (from expressionList) 
   | TRUE (from booleanLiteral) 
   | FALSE (from booleanLiteral) 
   | D int (from integerLiteral)  hint(print %)
   | nat W int (from integerLiteral)  hint(print %#W#%)
   | nat S int (from integerLiteral)  hint(print %#S#%)
   | '"' text '"' (from stringLiteral)  hint(print '"'#%#'"')
   | _ID text (from identifier) 
   | APPLY (from nonTypeName) 
   | KEY (from nonTypeName) 
   | ACTIONS (from nonTypeName) 
   | STATE (from nonTypeName) 
   | ENTRIES (from nonTypeName) 
   | TYPE (from nonTypeName) 
   | PRIORITY (from nonTypeName) 
   | _ID '.' nonTypeName (from prefixedNonTypeName) 
   | THIS (from referenceExpression) 
   | '...' (from defaultExpression) 
   | unop expression (from unaryExpression) 
   | expression binop expression (from binaryExpression) 
   | expression '?' expression ':' expression (from ternaryExpression) 
   | `( type `) expression (from castExpression) 
   | '{#}' (from invalidHeaderExpression) 
   | `{ sequenceOrRecordElementExpression trailingCommaOpt `} (from sequenceOrRecordExpression) 
   | ERROR '.' member (from errorAccessExpression) 
   | memberAccessBase '.' member (from memberAccessExpression) 
   | expression `[ expression `] (from indexAccessExpression) 
   | expression `[ expression sliceop expression `] (from sliceAccessExpression) 
   | callTarget `( argumentList `) (from callExpression) 
   | callableTarget `< realTypeArgumentList `> `( argumentList `) (from callExpression) 
   | `( expression `) (from parenthesizedExpression) 
   | expressionList ',' expression (from expressionList) 

def $flatten_expressionList(expressionList) : expression* =

  clause 0 : (expressionList) = []
  -- if expressionList matches `/* empty */`

  clause 1 : (expressionList) = [expression]
  -- if expressionList <: expression
  -- let expression = expressionList as expression

  clause 2 : (expressionList') = $flatten_expressionList(expressionList) ++ [expression]
  -- if expressionList' matches `% , %`
  -- let expressionList ',' expression = expressionList'

syntax memberAccessBase = 
