  clause 4 : (p, TC, prefixedNameIR, argumentIR*{argumentIR <- argumentIR*}) = $find_callableDef_overloaded_t(BLOCK, TC, _BARE nameIR, argumentIR*{argumentIR <- argumentIR*})
  -- if p matches `LOCAL`
  -- if prefixedNameIR matches `_BARE %`
  -- let _BARE nameIR = prefixedNameIR

def $find_callableDef_non_overloaded_t(cursor, typingContext, prefixedNameIR) : (callableId, callableTypeDefIR)? =

  clause 0 : (p, TC, prefixedNameIR) = $find_non_overloaded<callableTypeDefIR>(TC.GLOBAL.CALLABLE, nameIR)
  -- if prefixedNameIR matches `. %`
  -- let '.' nameIR = prefixedNameIR

  clause 1 : (p, TC, prefixedNameIR) = $find_non_overloaded<callableTypeDefIR>(TC.GLOBAL.CALLABLE, nameIR)
  -- if p matches `GLOBAL`
  -- if prefixedNameIR matches `_BARE %`
  -- let _BARE nameIR = prefixedNameIR

  clause 2 : (p, TC, prefixedNameIR) = ?((callableId, callableTypeDefIR))
  -- if p matches `BLOCK`
  -- if prefixedNameIR matches `_BARE %`
  -- let _BARE nameIR = prefixedNameIR
