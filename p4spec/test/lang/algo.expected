  -- let switchCaseList = $lift_switchCaseListIR(switchCaseIR*{switchCaseIR <- switchCaseIR*})

def $lift_breakStatementIR(breakStatementIR) : breakStatement =

  clause 0 : (breakStatement) = BREAK ';'
  -- if (breakStatement = BREAK ';')

def $lift_continueStatementIR(continueStatementIR) : continueStatement =

  clause 0 : (continueStatement) = CONTINUE ';'
  -- if (continueStatement = CONTINUE ';')

