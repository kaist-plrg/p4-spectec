tbl def $compat_switch(typeIR) : bool =
  row 0 :
    (signature) ERROR as typeIR
    (typeIR) -> true
    -- if typeIR <: errorTypeIR
    -- let errorTypeIR = typeIR as errorTypeIR
    -- if (errorTypeIR = ERROR)
  row 1 :
    (signature) INT `< _nat `> as typeIR
    (typeIR) -> true
    -- if typeIR <: fixedIntTypeIR
    -- let INT `< _nat `> = typeIR as fixedIntTypeIR
  row 2 :
    (signature) BIT `< _nat `> as typeIR
    (typeIR) -> true
    -- if typeIR <: fixedBitTypeIR
    -- let BIT `< _nat `> = typeIR as fixedBitTypeIR
  row 3 :
    (signature) TYPEDEF _typeId typeIR as typeIR
    (typeIR') -> $compat_switch(typeIR)
    -- if typeIR' <: typedefTypeIR
    -- let TYPEDEF _typeId typeIR = typeIR' as typedefTypeIR
  row 4 :
    (signature) enumTypeIR as typeIR
    (typeIR) -> true
    -- if typeIR <: enumTypeIR
    -- let enumTypeIR = typeIR as enumTypeIR
  row 5 :
    (signature) _typeIR
    (_typeIR) -> false

