def $match_switchLabelIR_table(id, switchLabelIR) : bool =

  clause 0 : (id, switchLabelIR) = true
  -- if switchLabelIR matches `DEFAULT`

  clause 1 : (id, switchLabelIR) = true
  -- if switchLabelIR <: typedExpressionIR
  -- let expressionIR '#' _expressionNoteIR = switchLabelIR as typedExpressionIR
  -- if expressionIR <: prefixedNameIR
  -- let prefixedNameIR = expressionIR as prefixedNameIR
  -- if prefixedNameIR matches `_BARE %`
  -- let _BARE id' = prefixedNameIR
  -- if (id = id')

  clause -1 : (id, _switchLabelIR) = false

