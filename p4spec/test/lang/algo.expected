  -- let i_cast = $int_to_bitstr(w_to as int, i_from)

  clause 11 : (typeIR, integerValue) = w_max '.' w V i as value
  -- if typeIR <: varBitTypeIR
  -- let VARBIT `< w_max `> = typeIR as varBitTypeIR
  -- if integerValue matches `% . % V %`
  -- let w_max' '.' w V i = integerValue
