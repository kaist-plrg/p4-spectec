    -- if typeIR' <: tupleTypeIR
    -- let TUPLE `< typeIR_b*{typeIR_b <- typeIR_b*} `> = typeIR' as tupleTypeIR

   paths

    rulepath tupleTypeIR
    -- if (|typeIR_a*{typeIR_a <- typeIR_a*}| = |typeIR_b*{typeIR_b <- typeIR_b*}|)
    -- (if Type_alpha: typeIR_a ~~ typeIR_b holds)*{typeIR_a <- typeIR_a*, typeIR_b <- typeIR_b*}
    -- the relation holds

  rulegroup arrayTypeIR

   match

    (signature) ARRAY typeIR_a `[ n_size `] as typeIR ~~ ARRAY typeIR_b `[ n_size `] as typeIR
    typeIR ~~ typeIR'
    -- if typeIR <: arrayTypeIR
    -- let ARRAY typeIR_a `[ n_size `] = typeIR as arrayTypeIR
    -- if typeIR' <: arrayTypeIR
    -- let ARRAY typeIR_b `[ n_size' `] = typeIR' as arrayTypeIR
    -- if (n_size = n_size')

   paths

    rulepath arrayTypeIR
    -- if Type_alpha: typeIR_a ~~ typeIR_b holds
    -- the relation holds

  rulegroup headerStackTypeIR

   match

    (signature) HEADER_STACK typeIR_a `[ n_size `] as typeIR ~~ HEADER_STACK typeIR_b `[ n_size `] as typeIR
    typeIR ~~ typeIR'
    -- if typeIR <: headerStackTypeIR
    -- let HEADER_STACK typeIR_a `[ n_size `] = typeIR as headerStackTypeIR
    -- if typeIR' <: headerStackTypeIR
    -- let HEADER_STACK typeIR_b `[ n_size' `] = typeIR' as headerStackTypeIR
    -- if (n_size = n_size')

   paths

    rulepath headerStackTypeIR
    -- if Type_alpha: typeIR_a ~~ typeIR_b holds
    -- the relation holds

  rulegroup structTypeIR

   match

    (signature) STRUCT typeId `< typeArgumentIR_a*{typeArgumentIR_a <- typeArgumentIR_a*} `> `{ _fieldTypeIR*{_fieldTypeIR <- _fieldTypeIR*} `} as typeIR ~~ STRUCT typeId `< typeArgumentIR_b*{typeArgumentIR_b <- typeArgumentIR_b*} `> `{ _fieldTypeIR'*{_fieldTypeIR' <- _fieldTypeIR'*} `} as typeIR
