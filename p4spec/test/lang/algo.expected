def $subst_constructorTypeIR(theta, constructorTypeIR) : constructorTypeIR =

  clause 0 : (set<pair<typeId, typeIR>>, constructorTypeIR) = constructorTypeIR
  -- if (set<pair<typeId, typeIR>> = `{ [] `})

  clause -1 : (theta, constructorTypeIR) = $subst_constructorTypeIR'(theta, constructorTypeIR)

def $subst_constructorTypeIR'(theta, constructorTypeIR) : constructorTypeIR =

  clause 0 : (theta, CONSTRUCTOR `( constructorParameterIR*{constructorParameterIR <- constructorParameterIR*} `) ':' typeIR) = CONSTRUCTOR `( constructorParameterIR_subst*{constructorParameterIR_subst <- constructorParameterIR_subst*} `) ':' typeIR_subst
  -- (let constructorParameterIR_subst = $subst_parameterIR'(theta, constructorParameterIR))*{constructorParameterIR <- constructorParameterIR*, constructorParameterIR_subst -> constructorParameterIR_subst*}
  -- let typeIR_subst = $subst_typeIR'(theta, typeIR)

