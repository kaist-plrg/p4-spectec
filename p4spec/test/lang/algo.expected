def $expressionNonBrace_as_expression(expressionNonBrace) : expression =

  clause 0 : (expressionNonBrace) = literalExpression as expression
  -- if expressionNonBrace <: literalExpression
  -- let literalExpression = expressionNonBrace as literalExpression

  clause 1 : (expressionNonBrace) = referenceExpression as expression
  -- if expressionNonBrace <: referenceExpression
  -- let referenceExpression = expressionNonBrace as referenceExpression

  clause 2 : (expressionNonBrace) = unaryExpression as expression
  -- if expressionNonBrace <: unaryExpression
  -- let unaryExpression = expressionNonBrace as unaryExpression

  clause 3 : (expressionNonBrace) = expression_l binop expression_r as expression
  -- if expressionNonBrace <: binaryExpressionNonBrace
  -- let expressionNonBrace_l binop expression_r = expressionNonBrace as binaryExpressionNonBrace
  -- let expression_l = $expressionNonBrace_as_expression(expressionNonBrace_l)

  clause 4 : (expressionNonBrace) = expression_cond '?' expression_true ':' expression_false as expression
  -- if expressionNonBrace <: ternaryExpressionNonBrace
  -- let expressionNonBrace_cond '?' expression_true ':' expression_false = expressionNonBrace as ternaryExpressionNonBrace
  -- let expression_cond = $expressionNonBrace_as_expression(expressionNonBrace_cond)

  clause 5 : (expressionNonBrace) = castExpression as expression
  -- if expressionNonBrace <: castExpression
  -- let castExpression = expressionNonBrace as castExpression

  clause 6 : (expressionNonBrace) = errorAccessExpression as expression
  -- if expressionNonBrace <: errorAccessExpression
  -- let errorAccessExpression = expressionNonBrace as errorAccessExpression

  clause 7 : (expressionNonBrace) = prefixedTypeName as memberAccessBase '.' member as expression
  -- if expressionNonBrace <: memberAccessExpressionNonBrace
  -- let memberAccessBaseNonBrace '.' member = expressionNonBrace as memberAccessExpressionNonBrace
  -- if memberAccessBaseNonBrace <: prefixedTypeName
  -- let prefixedTypeName = memberAccessBaseNonBrace as prefixedTypeName

  clause 8 : (expressionNonBrace) = expression_base as memberAccessBase '.' member as expression
  -- if expressionNonBrace <: memberAccessExpressionNonBrace
  -- let memberAccessBaseNonBrace '.' member = expressionNonBrace as memberAccessExpressionNonBrace
  -- if memberAccessBaseNonBrace <: expressionNonBrace
  -- let expressionNonBrace_base = memberAccessBaseNonBrace as expressionNonBrace
  -- let expression_base = $expressionNonBrace_as_expression(expressionNonBrace_base)

  clause 9 : (expressionNonBrace) = expression_base `[ expression_index `] as expression
  -- if expressionNonBrace <: indexAccessExpressionNonBrace
  -- let expressionNonBrace_base `[ expression_index `] = expressionNonBrace as indexAccessExpressionNonBrace
  -- let expression_base = $expressionNonBrace_as_expression(expressionNonBrace_base)

  clause 10 : (expressionNonBrace) = expression_base `[ expression_hi ':' expression_lo `] as expression
  -- if expressionNonBrace <: sliceAccessExpressionNonBrace
  -- let expressionNonBrace_base `[ expression_hi sliceop expression_lo `] = expressionNonBrace as sliceAccessExpressionNonBrace
  -- if sliceop matches `:`
  -- let expression_base = $expressionNonBrace_as_expression(expressionNonBrace_base)

  clause 11 : (expressionNonBrace) = expression_base `[ expression_l '+:' expression_w `] as expression
  -- if expressionNonBrace <: sliceAccessExpressionNonBrace
  -- let expressionNonBrace_base `[ expression_l sliceop expression_w `] = expressionNonBrace as sliceAccessExpressionNonBrace
  -- if sliceop matches `+:`
  -- let expression_base = $expressionNonBrace_as_expression(expressionNonBrace_base)

  clause 12 : (expressionNonBrace') = expression as callTarget `( argumentList `) as expression
  -- if expressionNonBrace' <: callExpressionNonBrace
  -- let callExpressionNonBrace = expressionNonBrace' as callExpressionNonBrace
  -- if callExpressionNonBrace matches `% (%)`
  -- let callTargetNonBrace `( argumentList `) = callExpressionNonBrace
  -- if callTargetNonBrace <: expressionNonBrace
  -- let expressionNonBrace = callTargetNonBrace as expressionNonBrace
  -- let expression = $expressionNonBrace_as_expression(expressionNonBrace)

  clause 13 : (expressionNonBrace) = constructorTarget as callTarget `( argumentList `) as expression
  -- if expressionNonBrace <: callExpressionNonBrace
  -- let callExpressionNonBrace = expressionNonBrace as callExpressionNonBrace
  -- if callExpressionNonBrace matches `% (%)`
  -- let callTargetNonBrace `( argumentList `) = callExpressionNonBrace
  -- if callTargetNonBrace <: constructorTarget
  -- let constructorTarget = callTargetNonBrace as constructorTarget

  clause 14 : (expressionNonBrace') = expression `< realTypeArgumentList `> `( argumentList `) as expression
  -- if expressionNonBrace' <: callExpressionNonBrace
  -- let callExpressionNonBrace = expressionNonBrace' as callExpressionNonBrace
  -- if callExpressionNonBrace matches `% <%> (%)`
  -- let expressionNonBrace `< realTypeArgumentList `> `( argumentList `) = callExpressionNonBrace
  -- let expression = $expressionNonBrace_as_expression(expressionNonBrace)

  clause 15 : (expressionNonBrace) = parenthesizedExpression as expression
  -- if expressionNonBrace <: parenthesizedExpression
  -- let parenthesizedExpression = expressionNonBrace as parenthesizedExpression

def $expression_as_expressionNonBrace(expression) : expressionNonBrace =

  clause 0 : (expression) = literalExpression as expressionNonBrace
  -- if expression <: literalExpression
  -- let literalExpression = expression as literalExpression

  clause 1 : (expression) = referenceExpression as expressionNonBrace
  -- if expression <: referenceExpression
  -- let referenceExpression = expression as referenceExpression

  clause 2 : (expression) = unaryExpression as expressionNonBrace
  -- if expression <: unaryExpression
  -- let unaryExpression = expression as unaryExpression

  clause 3 : (expression) = expressionNonBrace_l binop expression_r as expressionNonBrace
  -- if expression <: binaryExpression
  -- let expression_l binop expression_r = expression as binaryExpression
  -- let expressionNonBrace_l = $expression_as_expressionNonBrace(expression_l)

  clause 4 : (expression) = expressionNonBrace_cond '?' expression_true ':' expression_false as expressionNonBrace
  -- if expression <: ternaryExpression
  -- let expression_cond '?' expression_true ':' expression_false = expression as ternaryExpression
  -- let expressionNonBrace_cond = $expression_as_expressionNonBrace(expression_cond)

  clause 5 : (expression) = castExpression as expressionNonBrace
  -- if expression <: castExpression
  -- let castExpression = expression as castExpression

  clause 6 : (expression) = errorAccessExpression as expressionNonBrace
  -- if expression <: errorAccessExpression
  -- let errorAccessExpression = expression as errorAccessExpression

  clause 7 : (expression) = prefixedTypeName as memberAccessBaseNonBrace '.' member as expressionNonBrace
  -- if expression <: memberAccessExpression
  -- let memberAccessBase '.' member = expression as memberAccessExpression
  -- if memberAccessBase <: prefixedTypeName
  -- let prefixedTypeName = memberAccessBase as prefixedTypeName

  clause 8 : (expression) = expressionNonBrace_base as memberAccessBaseNonBrace '.' member as expressionNonBrace
  -- if expression <: memberAccessExpression
  -- let memberAccessBase '.' member = expression as memberAccessExpression
  -- if memberAccessBase <: expression
  -- let expression_base = memberAccessBase as expression
  -- let expressionNonBrace_base = $expression_as_expressionNonBrace(expression_base)

  clause 9 : (expression) = expressionNonBrace_base `[ expression_index `] as expressionNonBrace
  -- if expression <: indexAccessExpression
  -- let expression_base `[ expression_index `] = expression as indexAccessExpression
  -- let expressionNonBrace_base = $expression_as_expressionNonBrace(expression_base)

  clause 10 : (expression) = expressionNonBrace_base `[ expression_hi ':' expression_lo `] as expressionNonBrace
  -- if expression <: sliceAccessExpression
  -- let expression_base `[ expression_hi sliceop expression_lo `] = expression as sliceAccessExpression
  -- if sliceop matches `:`
  -- let expressionNonBrace_base = $expression_as_expressionNonBrace(expression_base)

  clause 11 : (expression') = expressionNonBrace as callTargetNonBrace `( argumentList `) as expressionNonBrace
  -- if expression' <: callExpression
  -- let callExpression = expression' as callExpression
  -- if callExpression matches `% (%)`
  -- let callTarget `( argumentList `) = callExpression
  -- if callTarget <: expression
  -- let expression = callTarget as expression
  -- let expressionNonBrace = $expression_as_expressionNonBrace(expression)

  clause 12 : (expression) = constructorTarget as callTargetNonBrace `( argumentList `) as expressionNonBrace
  -- if expression <: callExpression
  -- let callExpression = expression as callExpression
  -- if callExpression matches `% (%)`
  -- let callTarget `( argumentList `) = callExpression
  -- if callTarget <: constructorTarget
  -- let constructorTarget = callTarget as constructorTarget

  clause 13 : (expression') = expressionNonBrace `< realTypeArgumentList `> `( argumentList `) as expressionNonBrace
  -- if expression' <: callExpression
  -- let callExpression = expression' as callExpression
  -- if callExpression matches `% <%> (%)`
  -- let expression `< realTypeArgumentList `> `( argumentList `) = callExpression
  -- let expressionNonBrace = $expression_as_expressionNonBrace(expression)

  clause 14 : (expression) = parenthesizedExpression as expressionNonBrace
  -- if expression <: parenthesizedExpression
  -- let parenthesizedExpression = expression as parenthesizedExpression

syntax simpleKeysetExpression = 
   | TRUE (from booleanLiteral) 
   | FALSE (from booleanLiteral) 
   | D int (from integerLiteral)  hint(print %)
   | nat W int (from integerLiteral)  hint(print %#W#%)
   | nat S int (from integerLiteral)  hint(print %#S#%)
   | '"' text '"' (from stringLiteral)  hint(print '"'#%#'"')
   | _ID text (from identifier) 
   | APPLY (from nonTypeName) 
   | KEY (from nonTypeName) 
   | ACTIONS (from nonTypeName) 
   | STATE (from nonTypeName) 
   | ENTRIES (from nonTypeName) 
   | TYPE (from nonTypeName) 
   | PRIORITY (from nonTypeName) 
   | _ID '.' nonTypeName (from prefixedNonTypeName) 
   | THIS (from referenceExpression) 
   | '...' (from defaultExpression) 
   | unop expression (from unaryExpression) 
   | expression binop expression (from binaryExpression) 
   | expression '?' expression ':' expression (from ternaryExpression) 
   | `( type `) expression (from castExpression) 
   | '{#}' (from invalidHeaderExpression) 
   | `{ sequenceOrRecordElementExpression trailingCommaOpt `} (from sequenceOrRecordExpression) 
   | ERROR '.' member (from errorAccessExpression) 
   | memberAccessBase '.' member (from memberAccessExpression) 
   | expression `[ expression `] (from indexAccessExpression) 
   | expression `[ expression sliceop expression `] (from sliceAccessExpression) 
   | callTarget `( argumentList `) (from callExpression) 
   | callableTarget `< realTypeArgumentList `> `( argumentList `) (from callExpression) 
   | `( expression `) (from parenthesizedExpression) 
   | expression '&&&' expression (from simpleKeysetExpression) 
   | expression '..' expression (from simpleKeysetExpression) 
   | DEFAULT (from simpleKeysetExpression) 
   | '_' (from simpleKeysetExpression) 

syntax simpleKeysetExpressionList = 
   | TRUE (from booleanLiteral) 
   | FALSE (from booleanLiteral) 
   | D int (from integerLiteral)  hint(print %)
   | nat W int (from integerLiteral)  hint(print %#W#%)
   | nat S int (from integerLiteral)  hint(print %#S#%)
   | '"' text '"' (from stringLiteral)  hint(print '"'#%#'"')
   | _ID text (from identifier) 
   | APPLY (from nonTypeName) 
   | KEY (from nonTypeName) 
   | ACTIONS (from nonTypeName) 
   | STATE (from nonTypeName) 
   | ENTRIES (from nonTypeName) 
   | TYPE (from nonTypeName) 
   | PRIORITY (from nonTypeName) 
   | _ID '.' nonTypeName (from prefixedNonTypeName) 
   | THIS (from referenceExpression) 
   | '...' (from defaultExpression) 
   | unop expression (from unaryExpression) 
   | expression binop expression (from binaryExpression) 
   | expression '?' expression ':' expression (from ternaryExpression) 
   | `( type `) expression (from castExpression) 
   | '{#}' (from invalidHeaderExpression) 
   | `{ sequenceOrRecordElementExpression trailingCommaOpt `} (from sequenceOrRecordExpression) 
   | ERROR '.' member (from errorAccessExpression) 
   | memberAccessBase '.' member (from memberAccessExpression) 
   | expression `[ expression `] (from indexAccessExpression) 
   | expression `[ expression sliceop expression `] (from sliceAccessExpression) 
   | callTarget `( argumentList `) (from callExpression) 
   | callableTarget `< realTypeArgumentList `> `( argumentList `) (from callExpression) 
   | `( expression `) (from parenthesizedExpression) 
   | expression '&&&' expression (from simpleKeysetExpression) 
   | expression '..' expression (from simpleKeysetExpression) 
   | DEFAULT (from simpleKeysetExpression) 
   | '_' (from simpleKeysetExpression) 
   | simpleKeysetExpressionList ',' simpleKeysetExpression (from simpleKeysetExpressionList) 

def $flatten_simpleKeysetExpressionList(simpleKeysetExpressionList) : simpleKeysetExpression* =

  clause 0 : (simpleKeysetExpressionList) = [simpleKeysetExpression]
  -- if simpleKeysetExpressionList <: simpleKeysetExpression
