    -- output: % |- % : TC_2 controlLocalDeclarationIR_h :: controlLocalDeclarationIR_t*{controlLocalDeclarationIR_t <- controlLocalDeclarationIR_t*}

syntax strict = 
   | STRICT (from strict) 
   | LAX (from strict) 

syntax strictness = map<typeId, strict>

def $empty_strictness(typeId*) : strictness =

  clause 0 : (typeId*{typeId <- typeId*}) = `{ typeId ':' STRICT*{typeId <- typeId*} `}

syntax infer = 
   | KNOWN AS typeIR (from infer) 
   | UNKNOWN (from infer) 

syntax constraint = map<typeId, infer>

def $empty_constraint(typeId*) : constraint =

  clause 0 : (typeId*{typeId <- typeId*}) = `{ typeId ':' UNKNOWN*{typeId <- typeId*} `}

syntax inference = map<typeId, typeIR>

def $infer(typeId*, parameterIR*, parameterIR*, argumentIR*) : inference =

  clause 0 : (typeId*{typeId <- typeId*}, parameterIR*{parameterIR <- parameterIR*}, parameterIR_optional*{parameterIR_optional <- parameterIR_optional*}, argumentIR*{argumentIR <- argumentIR*}) = $empty_map<typeId, typeIR>
  -- if typeId*{typeId <- typeId*} matches []

  clause 1 : (typeId_infer*{typeId_infer <- typeId_infer*}, parameterIR*{parameterIR <- parameterIR*}, parameterIR_optional*{parameterIR_optional <- parameterIR_optional*}, argumentIR*{argumentIR <- argumentIR*}) = inference_resolved
