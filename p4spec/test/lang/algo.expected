  -- (let constructorParameter = $lift_constructorParameterIR(constructorParameterIR))*{constructorParameterIR <- constructorParameterIR*, constructorParameter -> constructorParameter*}
  -- let constructorParameterListOpt = $unflatten_constructorParameterList(constructorParameter*{constructorParameter <- constructorParameter*})

def $unflatten_constructorParameterList(constructorParameter*) : constructorParameterListOpt =

  clause 0 : (constructorParameter*{constructorParameter <- constructorParameter*}) = _EMPTY
  -- if constructorParameter*{constructorParameter <- constructorParameter*} matches []

  clause 1 : (constructorParameter*{constructorParameter <- constructorParameter*}) = `( $unflatten_parameterList(constructorParameter*{constructorParameter <- constructorParameter*}) `)
  -- if (constructorParameter*{constructorParameter <- constructorParameter*} =/= [])

def $lift_typedExpressionIR(typedExpressionIR) : expression =

  clause 0 : (expressionIR '#' _expressionNoteIR) = $lift_expressionIR(expressionIR)

def $lift_initializerIR(initializerIR) : initializer =

  clause 0 : ('=' typedExpressionIR) = '=' expression
  -- let expression = $lift_typedExpressionIR(typedExpressionIR)

def $lift_initializerOptIR(initializerIR?) : initializerOpt =

  clause 0 : (initializerIR?{initializerIR <- initializerIR?}) = _EMPTY
