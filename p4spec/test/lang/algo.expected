  -- let value_h :: value_t*{value_t <- value_t*} = value*{value <- value*}
  -- let (value_h_updated, b_t*{b_t <- b_t*}) = $write_value_from_bits'(value_h, n_var, b*{b <- b*})
  -- let (value_t_updated*{value_t_updated <- value_t_updated*}, b_rest*{b_rest <- b_rest*}) = $write_values_from_bits'(value_t*{value_t <- value_t*}, n_var, b_t*{b_t <- b_t*})

def $write_value_fields_from_bits'(fieldValue*, nat, bool*) : (fieldValue*, bool*) =

  clause 0 : (fieldValue*{fieldValue <- fieldValue*}, n_var, b*{b <- b*}) = ([], b*{b <- b*})
  -- if fieldValue*{fieldValue <- fieldValue*} matches []

  clause 1 : (fieldValue*{fieldValue <- fieldValue*}, n_var, b*{b <- b*}) = (fieldValue_h_updated :: fieldValue_t_updated*{fieldValue_t_updated <- fieldValue_t_updated*}, b_rest*{b_rest <- b_rest*})
  -- if fieldValue*{fieldValue <- fieldValue*} matches _ :: _
  -- let fieldValue_h :: fieldValue_t*{fieldValue_t <- fieldValue_t*} = fieldValue*{fieldValue <- fieldValue*}
  -- let (fieldValue_h_updated, b_t*{b_t <- b_t*}) = $write_value_field_from_bits'(fieldValue_h, n_var, b*{b <- b*})
  -- let (fieldValue_t_updated*{fieldValue_t_updated <- fieldValue_t_updated*}, b_rest*{b_rest <- b_rest*}) = $write_value_fields_from_bits'(fieldValue_t*{fieldValue_t <- fieldValue_t*}, n_var, b_t*{b_t <- b_t*})

def $write_value_field_from_bits'(fieldValue, nat, bool*) : (fieldValue, bool*) =

  clause 0 : (value id ';', n_var, b*{b <- b*}) = (value_updated id ';', b_rest*{b_rest <- b_rest*})
  -- let (value_updated, b_rest*{b_rest <- b_rest*}) = $write_value_from_bits'(value, n_var, b*{b <- b*})

def $write_bits_from_value(value) : bool* =

  clause 0 : (value) = [b]
  -- if value <: boolValue
  -- let _B b = value as boolValue

  clause 1 : (value) = $int_to_bits_signed(w, i)
  -- if value <: integerLiteral
  -- let integerLiteral = value as integerLiteral
  -- if integerLiteral matches `% S %`
  -- let w S i = integerLiteral

  clause 2 : (value) = $int_to_bits_unsigned(w, i)
  -- if value <: integerLiteral
  -- let integerLiteral = value as integerLiteral
  -- if integerLiteral matches `% W %`
  -- let w W i = integerLiteral

  clause 3 : (value) = $int_to_bits_unsigned(w, i)
  -- if value <: integerValue
  -- let integerValue = value as integerValue
  -- if integerValue matches `% . % V %`
  -- let _nat '.' w V i = integerValue

  clause 4 : (value) = $concat_<bool>($write_bits_from_value(value_element)*{value_element <- value_element*})
  -- if value <: arrayValue
  -- let ARRAY `[ value_element*{value_element <- value_element*} `] = value as arrayValue

  clause 5 : (value) = $concat_<bool>($write_bits_from_value(value_element)*{value_element <- value_element*})
  -- if value <: headerStackValue
  -- let HEADER_STACK `[ value_element*{value_element <- value_element*} `( _nat `) `] = value as headerStackValue

  clause 6 : (value) = $concat_<bool>($write_bits_from_value(value_field)*{value_field <- value_field*})
  -- if value <: structValue
  -- let STRUCT _typeId `{ value_field id_field ';'*{id_field <- id_field*, value_field <- value_field*} `} = value as structValue

  clause 7 : (value) = $concat_<bool>($write_bits_from_value(value_field)*{value_field <- value_field*})
  -- if value <: headerValue
  -- let HEADER _typeId `{ b ';' value_field id_field ';'*{id_field <- id_field*, value_field <- value_field*} `} = value as headerValue
  -- if (b = true)

  clause 8 : (value) = []
  -- if value <: headerValue
  -- let HEADER _typeId `{ b ';' _fieldValue*{_fieldValue <- _fieldValue*} `} = value as headerValue
  -- if (b = false)

  clause 9 : (value') = $concat_<bool>($write_bits_from_value(value)*{value <- value*})
  -- if value' <: headerUnionValue
  -- let HEADER_UNION _typeId `{ value id ';'*{id <- id*, value <- value*} `} = value' as headerUnionValue

  clause 10 : (value') = $write_bits_from_value(value)
  -- if value' <: enumValue
  -- let enumValue = value' as enumValue
  -- if enumValue matches `% . % . %`
  -- let typeId '.' id '.' value = enumValue

syntax voidTypeIR = 
   | VOID (from voidTypeIR) 

syntax boolTypeIR = 
   | BOOL (from boolTypeIR) 

syntax errorTypeIR = 
   | ERROR (from errorTypeIR) 

syntax matchKindTypeIR = 
   | MATCH_KIND (from matchKindTypeIR) 

syntax stringTypeIR = 
   | STRING (from stringTypeIR) 

syntax intTypeIR = 
   | INT (from intTypeIR) 

syntax fixedIntTypeIR = 
   | INT `< nat `> (from fixedIntTypeIR) 

syntax fixedBitTypeIR = 
   | BIT `< nat `> (from fixedBitTypeIR) 

syntax varBitTypeIR = 
   | VARBIT `< nat `> (from varBitTypeIR) 

syntax integerTypeIR = 
   | INT (from intTypeIR) 
   | INT `< nat `> (from fixedIntTypeIR) 
   | BIT `< nat `> (from fixedBitTypeIR) 
   | VARBIT `< nat `> (from varBitTypeIR) 

syntax baseTypeIR = 
   | VOID (from voidTypeIR) 
   | BOOL (from boolTypeIR) 
   | ERROR (from errorTypeIR) 
   | MATCH_KIND (from matchKindTypeIR) 
   | STRING (from stringTypeIR) 
   | INT (from intTypeIR) 
   | INT `< nat `> (from fixedIntTypeIR) 
   | BIT `< nat `> (from fixedBitTypeIR) 
   | VARBIT `< nat `> (from varBitTypeIR) 

syntax nameTypeIR = 
   | _NAME typeId (from nameTypeIR)  hint(print %0)

syntax typedefTypeIR = 
   | TYPEDEF typeId typeIR (from typedefTypeIR)  hint(print %0)

syntax newTypeIR = 
   | TYPE typeId typeIR (from newTypeIR)  hint(print %0)

syntax aliasTypeIR = 
   | TYPEDEF typeId typeIR (from typedefTypeIR)  hint(print %0)
   | TYPE typeId typeIR (from newTypeIR)  hint(print %0)

syntax listTypeIR = 
   | LIST `< typeIR `> (from listTypeIR) 

syntax tupleTypeIR = 
   | TUPLE `< typeIR* `> (from tupleTypeIR) 

syntax arrayTypeIR = 
   | ARRAY typeIR `[ nat `] (from arrayTypeIR) 

syntax headerStackTypeIR = 
   | HEADER_STACK typeIR `[ nat `] (from headerStackTypeIR) 

syntax fieldTypeIR = 
   | annotationList typeIR nameIR ';' (from fieldTypeIR) 

syntax structTypeIR = 
   | STRUCT typeId `< typeArgumentIR* `> `{ fieldTypeIR* `} (from structTypeIR)  hint(print %0#"<"#%1#">")

syntax headerTypeIR = 
   | HEADER typeId `< typeArgumentIR* `> `{ fieldTypeIR* `} (from headerTypeIR)  hint(print %0#"<"#%1#">")

syntax headerUnionTypeIR = 
   | HEADER_UNION typeId `< typeArgumentIR* `> `{ fieldTypeIR* `} (from headerUnionTypeIR)  hint(print %0#"<"#%1#">")

syntax valueFieldIR = 
   | nameIR '=' value ';' (from valueFieldIR) 

syntax simpleEnumTypeIR = 
   | ENUM typeId `{ nameIR* `} (from simpleEnumTypeIR)  hint(print %0)

syntax serializableEnumTypeIR = 
   | ENUM typeId `< typeIR `> `{ valueFieldIR* `} (from serializableEnumTypeIR)  hint(print %0)

syntax enumTypeIR = 
   | ENUM typeId `{ nameIR* `} (from simpleEnumTypeIR)  hint(print %0)
   | ENUM typeId `< typeIR `> `{ valueFieldIR* `} (from serializableEnumTypeIR)  hint(print %0)

syntax dataTypeIR = 
   | LIST `< typeIR `> (from listTypeIR) 
   | TUPLE `< typeIR* `> (from tupleTypeIR) 
   | ARRAY typeIR `[ nat `] (from arrayTypeIR) 
   | HEADER_STACK typeIR `[ nat `] (from headerStackTypeIR) 
   | STRUCT typeId `< typeArgumentIR* `> `{ fieldTypeIR* `} (from structTypeIR)  hint(print %0#"<"#%1#">")
   | HEADER typeId `< typeArgumentIR* `> `{ fieldTypeIR* `} (from headerTypeIR)  hint(print %0#"<"#%1#">")
   | HEADER_UNION typeId `< typeArgumentIR* `> `{ fieldTypeIR* `} (from headerUnionTypeIR)  hint(print %0#"<"#%1#">")
   | ENUM typeId `{ nameIR* `} (from simpleEnumTypeIR)  hint(print %0)
   | ENUM typeId `< typeIR `> `{ valueFieldIR* `} (from serializableEnumTypeIR)  hint(print %0)

syntax externMethodTypeDefEnv = map<callableId, externMethodTypeDefIR>

syntax externObjectTypeIR = 
   | EXTERN typeId `< typeArgumentIR* `> externMethodTypeDefEnv (from externObjectTypeIR)  hint(print %0#"<"#%1#">")

syntax parserObjectTypeIR = 
   | PARSER typeId `< typeArgumentIR* `> `( parameterIR* `) (from parserObjectTypeIR)  hint(print %0#"<"#%1#">")

syntax controlObjectTypeIR = 
   | CONTROL typeId `< typeArgumentIR* `> `( parameterIR* `) (from controlObjectTypeIR)  hint(print %0#"<"#%1#">")

syntax packageObjectTypeIR = 
   | PACKAGE typeId `< typeArgumentIR* `> `{ typeIR* `} (from packageObjectTypeIR)  hint(print %0#"<"#%1#">")

syntax tableObjectTypeIR = 
   | TABLE typeId `{ tableMetadataStructTypeIR `} (from tableObjectTypeIR)  hint(print %0)

syntax objectTypeIR = 
   | EXTERN typeId `< typeArgumentIR* `> externMethodTypeDefEnv (from externObjectTypeIR)  hint(print %0#"<"#%1#">")
   | PARSER typeId `< typeArgumentIR* `> `( parameterIR* `) (from parserObjectTypeIR)  hint(print %0#"<"#%1#">")
   | CONTROL typeId `< typeArgumentIR* `> `( parameterIR* `) (from controlObjectTypeIR)  hint(print %0#"<"#%1#">")
   | PACKAGE typeId `< typeArgumentIR* `> `{ typeIR* `} (from packageObjectTypeIR)  hint(print %0#"<"#%1#">")
   | TABLE typeId `{ tableMetadataStructTypeIR `} (from tableObjectTypeIR)  hint(print %0)

syntax defaultTypeIR = 
   | DEFAULT (from defaultTypeIR) 

syntax invalidHeaderTypeIR = 
   | HEADER_INVALID (from invalidHeaderTypeIR) 

syntax sequenceTypeIR = 
   | SEQ `< typeIR* `> (from sequenceTypeIR) 
   | SEQ `< typeIR* ',' '...' `> (from sequenceTypeIR) 

syntax recordTypeIR = 
   | RECORD `{ fieldTypeIR* `} (from recordTypeIR) 
   | RECORD `{ fieldTypeIR* ',' '...' `} (from recordTypeIR) 

syntax setTypeIR = 
   | SET `< typeIR `> (from setTypeIR) 

syntax tableMetadataEnumTypeIR = 
   | TABLE_ENUM typeId `{ nameIR* `} (from tableMetadataEnumTypeIR)  hint(print %0)

syntax tableMetadataStructTypeIR = 
   | TABLE_STRUCT typeId `{ HIT boolTypeIR ';' MISS boolTypeIR ';' ACTION_RUN tableMetadataEnumTypeIR ';' `} (from tableMetadataStructTypeIR)  hint(print %0)

syntax tableMetadataTypeIR = 
   | TABLE_ENUM typeId `{ nameIR* `} (from tableMetadataEnumTypeIR)  hint(print %0)
   | TABLE_STRUCT typeId `{ HIT boolTypeIR ';' MISS boolTypeIR ';' ACTION_RUN tableMetadataEnumTypeIR ';' `} (from tableMetadataStructTypeIR)  hint(print %0)

syntax synthesizedTypeIR = 
   | DEFAULT (from defaultTypeIR) 
   | HEADER_INVALID (from invalidHeaderTypeIR) 
   | SEQ `< typeIR* `> (from sequenceTypeIR) 
   | SEQ `< typeIR* ',' '...' `> (from sequenceTypeIR) 
   | RECORD `{ fieldTypeIR* `} (from recordTypeIR) 
   | RECORD `{ fieldTypeIR* ',' '...' `} (from recordTypeIR) 
   | SET `< typeIR `> (from setTypeIR) 
   | TABLE_ENUM typeId `{ nameIR* `} (from tableMetadataEnumTypeIR)  hint(print %0)
   | TABLE_STRUCT typeId `{ HIT boolTypeIR ';' MISS boolTypeIR ';' ACTION_RUN tableMetadataEnumTypeIR ';' `} (from tableMetadataStructTypeIR)  hint(print %0)

syntax typeIR = 
   | VOID (from voidTypeIR) 
   | BOOL (from boolTypeIR) 
   | ERROR (from errorTypeIR) 
   | MATCH_KIND (from matchKindTypeIR) 
   | STRING (from stringTypeIR) 
   | INT (from intTypeIR) 
   | INT `< nat `> (from fixedIntTypeIR) 
   | BIT `< nat `> (from fixedBitTypeIR) 
   | VARBIT `< nat `> (from varBitTypeIR) 
   | _NAME typeId (from nameTypeIR)  hint(print %0)
   | TYPEDEF typeId typeIR (from typedefTypeIR)  hint(print %0)
   | TYPE typeId typeIR (from newTypeIR)  hint(print %0)
   | LIST `< typeIR `> (from listTypeIR) 
   | TUPLE `< typeIR* `> (from tupleTypeIR) 
   | ARRAY typeIR `[ nat `] (from arrayTypeIR) 
   | HEADER_STACK typeIR `[ nat `] (from headerStackTypeIR) 
   | STRUCT typeId `< typeArgumentIR* `> `{ fieldTypeIR* `} (from structTypeIR)  hint(print %0#"<"#%1#">")
   | HEADER typeId `< typeArgumentIR* `> `{ fieldTypeIR* `} (from headerTypeIR)  hint(print %0#"<"#%1#">")
   | HEADER_UNION typeId `< typeArgumentIR* `> `{ fieldTypeIR* `} (from headerUnionTypeIR)  hint(print %0#"<"#%1#">")
   | ENUM typeId `{ nameIR* `} (from simpleEnumTypeIR)  hint(print %0)
   | ENUM typeId `< typeIR `> `{ valueFieldIR* `} (from serializableEnumTypeIR)  hint(print %0)
   | EXTERN typeId `< typeArgumentIR* `> externMethodTypeDefEnv (from externObjectTypeIR)  hint(print %0#"<"#%1#">")
   | PARSER typeId `< typeArgumentIR* `> `( parameterIR* `) (from parserObjectTypeIR)  hint(print %0#"<"#%1#">")
   | CONTROL typeId `< typeArgumentIR* `> `( parameterIR* `) (from controlObjectTypeIR)  hint(print %0#"<"#%1#">")
   | PACKAGE typeId `< typeArgumentIR* `> `{ typeIR* `} (from packageObjectTypeIR)  hint(print %0#"<"#%1#">")
   | TABLE typeId `{ tableMetadataStructTypeIR `} (from tableObjectTypeIR)  hint(print %0)
   | DEFAULT (from defaultTypeIR) 
   | HEADER_INVALID (from invalidHeaderTypeIR) 
   | SEQ `< typeIR* `> (from sequenceTypeIR) 
   | SEQ `< typeIR* ',' '...' `> (from sequenceTypeIR) 
   | RECORD `{ fieldTypeIR* `} (from recordTypeIR) 
   | RECORD `{ fieldTypeIR* ',' '...' `} (from recordTypeIR) 
   | SET `< typeIR `> (from setTypeIR) 
   | TABLE_ENUM typeId `{ nameIR* `} (from tableMetadataEnumTypeIR)  hint(print %0)
   | TABLE_STRUCT typeId `{ HIT boolTypeIR ';' MISS boolTypeIR ';' ACTION_RUN tableMetadataEnumTypeIR ';' `} (from tableMetadataStructTypeIR)  hint(print %0)

syntax typeArgumentIR = typeIR

syntax typeParameterIR = typeId

syntax nameTypeDefIR = nameTypeIR

syntax aliasTypeDefIR = aliasTypeIR

syntax structTypeDefIR = 
   | STRUCT typeId `< typeParameterIR* `> `{ fieldTypeIR* `} (from structTypeDefIR) 

syntax headerTypeDefIR = 
   | HEADER typeId `< typeParameterIR* `> `{ fieldTypeIR* `} (from headerTypeDefIR) 

syntax headerUnionTypeDefIR = 
   | HEADER_UNION typeId `< typeParameterIR* `> `{ fieldTypeIR* `} (from headerUnionTypeDefIR) 

syntax enumTypeDefIR = enumTypeIR

syntax dataTypeDefIR = 
   | STRUCT typeId `< typeParameterIR* `> `{ fieldTypeIR* `} (from structTypeDefIR) 
   | HEADER typeId `< typeParameterIR* `> `{ fieldTypeIR* `} (from headerTypeDefIR) 
   | HEADER_UNION typeId `< typeParameterIR* `> `{ fieldTypeIR* `} (from headerUnionTypeDefIR) 
   | ENUM typeId `{ nameIR* `} (from simpleEnumTypeIR)  hint(print %0)
   | ENUM typeId `< typeIR `> `{ valueFieldIR* `} (from serializableEnumTypeIR)  hint(print %0)

syntax externObjectTypeDefIR = 
   | EXTERN typeId `< typeParameterIR* ',' typeParameterIR* `> externMethodTypeDefEnv (from externObjectTypeDefIR) 

syntax parserObjectTypeDefIR = 
   | PARSER typeId `< typeParameterIR* ',' typeParameterIR* `> `( parameterIR* `) (from parserObjectTypeDefIR) 

syntax controlObjectTypeDefIR = 
   | CONTROL typeId `< typeParameterIR* ',' typeParameterIR* `> `( parameterIR* `) (from controlObjectTypeDefIR) 

syntax packageObjectTypeDefIR = 
   | PACKAGE typeId `< typeParameterIR* ',' typeParameterIR* `> `{ typeIR* `} (from packageObjectTypeDefIR) 

syntax tableObjectTypeDefIR = tableObjectTypeIR

syntax objectTypeDefIR = 
   | EXTERN typeId `< typeParameterIR* ',' typeParameterIR* `> externMethodTypeDefEnv (from externObjectTypeDefIR) 
   | PARSER typeId `< typeParameterIR* ',' typeParameterIR* `> `( parameterIR* `) (from parserObjectTypeDefIR) 
   | CONTROL typeId `< typeParameterIR* ',' typeParameterIR* `> `( parameterIR* `) (from controlObjectTypeDefIR) 
   | PACKAGE typeId `< typeParameterIR* ',' typeParameterIR* `> `{ typeIR* `} (from packageObjectTypeDefIR) 
   | TABLE typeId `{ tableMetadataStructTypeIR `} (from tableObjectTypeIR)  hint(print %0)

syntax typeDefIR = 
   | _NAME typeId (from nameTypeIR)  hint(print %0)
   | TYPEDEF typeId typeIR (from typedefTypeIR)  hint(print %0)
   | TYPE typeId typeIR (from newTypeIR)  hint(print %0)
   | STRUCT typeId `< typeParameterIR* `> `{ fieldTypeIR* `} (from structTypeDefIR) 
   | HEADER typeId `< typeParameterIR* `> `{ fieldTypeIR* `} (from headerTypeDefIR) 
   | HEADER_UNION typeId `< typeParameterIR* `> `{ fieldTypeIR* `} (from headerUnionTypeDefIR) 
   | ENUM typeId `{ nameIR* `} (from simpleEnumTypeIR)  hint(print %0)
   | ENUM typeId `< typeIR `> `{ valueFieldIR* `} (from serializableEnumTypeIR)  hint(print %0)
   | EXTERN typeId `< typeParameterIR* ',' typeParameterIR* `> externMethodTypeDefEnv (from externObjectTypeDefIR) 
   | PARSER typeId `< typeParameterIR* ',' typeParameterIR* `> `( parameterIR* `) (from parserObjectTypeDefIR) 
   | CONTROL typeId `< typeParameterIR* ',' typeParameterIR* `> `( parameterIR* `) (from controlObjectTypeDefIR) 
   | PACKAGE typeId `< typeParameterIR* ',' typeParameterIR* `> `{ typeIR* `} (from packageObjectTypeDefIR) 
   | TABLE typeId `{ tableMetadataStructTypeIR `} (from tableObjectTypeIR)  hint(print %0)

def $unroll_typeIR(typeIR) : typeIR =

  clause 0 : (typeIR') = $unroll_typeIR(typeIR)
  -- if typeIR' <: typedefTypeIR
  -- let TYPEDEF _typeId typeIR = typeIR' as typedefTypeIR

  clause -1 : (typeIR) = typeIR

def $unroll_aliasType(typeIR) : typeIR =

  clause 0 : (typeIR') = $unroll_aliasType(typeIR)
  -- if typeIR' <: newTypeIR
  -- let TYPE _typeId typeIR = typeIR' as newTypeIR

  clause 1 : (typeIR') = $unroll_aliasType(typeIR)
  -- if typeIR' <: typedefTypeIR
  -- let TYPEDEF _typeId typeIR = typeIR' as typedefTypeIR

  clause -1 : (typeIR) = typeIR

def $width_of_integerTypeIR(integerTypeIR) : nat? =

  clause 0 : (integerTypeIR) = ?()
  -- if integerTypeIR <: intTypeIR
  -- let intTypeIR = integerTypeIR as intTypeIR
  -- if (intTypeIR = INT)

  clause 1 : (integerTypeIR) = ?(n)
  -- if integerTypeIR <: fixedIntTypeIR
  -- let INT `< n `> = integerTypeIR as fixedIntTypeIR

  clause 2 : (integerTypeIR) = ?(n)
  -- if integerTypeIR <: fixedBitTypeIR
  -- let BIT `< n `> = integerTypeIR as fixedBitTypeIR

  clause 3 : (integerTypeIR) = ?(n)
  -- if integerTypeIR <: varBitTypeIR
  -- let VARBIT `< n `> = integerTypeIR as varBitTypeIR

tbl def $is_defaultable_typeIR(typeIR) : bool =
  row 0 :
    (signature) BOOL as typeIR
    (typeIR) -> true
    -- if typeIR <: boolTypeIR
    -- let boolTypeIR = typeIR as boolTypeIR
    -- if (boolTypeIR = BOOL)
  row 1 :
    (signature) ERROR as typeIR
    (typeIR) -> true
    -- if typeIR <: errorTypeIR
    -- let errorTypeIR = typeIR as errorTypeIR
    -- if (errorTypeIR = ERROR)
  row 2 :
    (signature) STRING as typeIR
    (typeIR) -> true
    -- if typeIR <: stringTypeIR
    -- let stringTypeIR = typeIR as stringTypeIR
    -- if (stringTypeIR = STRING)
  row 3 :
    (signature) integerTypeIR as typeIR
    (typeIR) -> true
    -- if typeIR <: integerTypeIR
    -- let integerTypeIR = typeIR as integerTypeIR
  row 4 :
    (signature) TYPEDEF _typeId typeIR as typeIR
    (typeIR') -> $is_defaultable_typeIR(typeIR)
    -- if typeIR' <: typedefTypeIR
    -- let TYPEDEF _typeId typeIR = typeIR' as typedefTypeIR
  row 5 :
    (signature) TYPE _typeId typeIR as typeIR
    (typeIR') -> $is_defaultable_typeIR(typeIR)
    -- if typeIR' <: newTypeIR
    -- let TYPE _typeId typeIR = typeIR' as newTypeIR
  row 6 :
    (signature) TUPLE `< typeIR*{typeIR <- typeIR*} `> as typeIR
    (typeIR') -> $forall_($is_defaultable_typeIR(typeIR)*{typeIR <- typeIR*})
    -- if typeIR' <: tupleTypeIR
    -- let TUPLE `< typeIR*{typeIR <- typeIR*} `> = typeIR' as tupleTypeIR
  row 7 :
    (signature) ARRAY typeIR `[ _nat `] as typeIR
    (typeIR') -> $is_defaultable_typeIR(typeIR)
    -- if typeIR' <: arrayTypeIR
    -- let ARRAY typeIR `[ _nat `] = typeIR' as arrayTypeIR
  row 8 :
    (signature) HEADER_STACK typeIR `[ _nat `] as typeIR
    (typeIR') -> $is_defaultable_typeIR(typeIR)
    -- if typeIR' <: headerStackTypeIR
    -- let HEADER_STACK typeIR `[ _nat `] = typeIR' as headerStackTypeIR
  row 9 :
    (signature) STRUCT _typeId `< _typeArgumentIR*{_typeArgumentIR <- _typeArgumentIR*} `> `{ _annotationList typeIR _nameIR ';'*{_annotationList <- _annotationList*, _nameIR <- _nameIR*, typeIR <- typeIR*} `} as typeIR
    (typeIR') -> $forall_($is_defaultable_typeIR(typeIR)*{typeIR <- typeIR*})
    -- if typeIR' <: structTypeIR
    -- let STRUCT _typeId `< _typeArgumentIR*{_typeArgumentIR <- _typeArgumentIR*} `> `{ _annotationList typeIR _nameIR ';'*{_annotationList <- _annotationList*, _nameIR <- _nameIR*, typeIR <- typeIR*} `} = typeIR' as structTypeIR
  row 10 :
    (signature) HEADER _typeId `< _typeArgumentIR*{_typeArgumentIR <- _typeArgumentIR*} `> `{ _annotationList typeIR _nameIR ';'*{_annotationList <- _annotationList*, _nameIR <- _nameIR*, typeIR <- typeIR*} `} as typeIR
    (typeIR') -> $forall_($is_defaultable_typeIR(typeIR)*{typeIR <- typeIR*})
    -- if typeIR' <: headerTypeIR
    -- let HEADER _typeId `< _typeArgumentIR*{_typeArgumentIR <- _typeArgumentIR*} `> `{ _annotationList typeIR _nameIR ';'*{_annotationList <- _annotationList*, _nameIR <- _nameIR*, typeIR <- typeIR*} `} = typeIR' as headerTypeIR
  row 11 :
    (signature) HEADER_UNION _typeId `< _typeArgumentIR*{_typeArgumentIR <- _typeArgumentIR*} `> `{ _annotationList typeIR _nameIR ';'*{_annotationList <- _annotationList*, _nameIR <- _nameIR*, typeIR <- typeIR*} `} as typeIR
    (typeIR') -> $forall_($is_defaultable_typeIR(typeIR)*{typeIR <- typeIR*})
    -- if typeIR' <: headerUnionTypeIR
    -- let HEADER_UNION _typeId `< _typeArgumentIR*{_typeArgumentIR <- _typeArgumentIR*} `> `{ _annotationList typeIR _nameIR ';'*{_annotationList <- _annotationList*, _nameIR <- _nameIR*, typeIR <- typeIR*} `} = typeIR' as headerUnionTypeIR
  row 12 :
    (signature) ENUM _typeId `{ _nameIR*{_nameIR <- _nameIR*} `} as typeIR
    (typeIR) -> true
    -- if typeIR <: simpleEnumTypeIR
    -- let ENUM _typeId `{ _nameIR*{_nameIR <- _nameIR*} `} = typeIR as simpleEnumTypeIR
  row 13 :
    (signature) ENUM _typeId `< typeIR `> `{ _valueFieldIR*{_valueFieldIR <- _valueFieldIR*} `} as typeIR
    (typeIR') -> $is_defaultable_typeIR(typeIR)
    -- if typeIR' <: serializableEnumTypeIR
    -- let ENUM _typeId `< typeIR `> `{ _valueFieldIR*{_valueFieldIR <- _valueFieldIR*} `} = typeIR' as serializableEnumTypeIR
  row 14 :
    (signature) _typeIR
    (_typeIR) -> false

tbl def $is_equalable_typeIR(typeIR) : bool =
  row 0 :
    (signature) VOID as typeIR
    (typeIR) -> false
    -- if typeIR <: voidTypeIR
    -- let voidTypeIR = typeIR as voidTypeIR
    -- if (voidTypeIR = VOID)
  row 1 :
    (signature) _NAME typeId as typeIR
    (typeIR) -> false
    -- if typeIR <: nameTypeIR
    -- let _NAME typeId = typeIR as nameTypeIR
  row 2 :
    (signature) TYPEDEF _typeId typeIR as typeIR
    (typeIR') -> $is_equalable_typeIR(typeIR)
    -- if typeIR' <: typedefTypeIR
    -- let TYPEDEF _typeId typeIR = typeIR' as typedefTypeIR
  row 3 :
    (signature) externObjectTypeIR as typeIR
    (typeIR) -> false
    -- if typeIR <: externObjectTypeIR
    -- let externObjectTypeIR = typeIR as externObjectTypeIR
  row 4 :
    (signature) parserObjectTypeIR as typeIR
    (typeIR) -> false
    -- if typeIR <: parserObjectTypeIR
    -- let parserObjectTypeIR = typeIR as parserObjectTypeIR
  row 5 :
    (signature) controlObjectTypeIR as typeIR
    (typeIR) -> false
    -- if typeIR <: controlObjectTypeIR
    -- let controlObjectTypeIR = typeIR as controlObjectTypeIR
  row 6 :
    (signature) packageObjectTypeIR as typeIR
    (typeIR) -> false
    -- if typeIR <: packageObjectTypeIR
    -- let packageObjectTypeIR = typeIR as packageObjectTypeIR
  row 7 :
    (signature) tableObjectTypeIR as typeIR
    (typeIR) -> false
    -- if typeIR <: tableObjectTypeIR
    -- let tableObjectTypeIR = typeIR as tableObjectTypeIR
  row 8 :
    (signature) DEFAULT as typeIR
    (typeIR) -> false
    -- if typeIR <: defaultTypeIR
    -- let defaultTypeIR = typeIR as defaultTypeIR
    -- if (defaultTypeIR = DEFAULT)
  row 9 :
    (signature) sequenceTypeIR as typeIR
    (typeIR) -> false
    -- if typeIR <: sequenceTypeIR
    -- let sequenceTypeIR = typeIR as sequenceTypeIR
  row 10 :
    (signature) recordTypeIR as typeIR
    (typeIR) -> false
    -- if typeIR <: recordTypeIR
    -- let recordTypeIR = typeIR as recordTypeIR
  row 11 :
    (signature) HEADER_INVALID as typeIR
    (typeIR) -> false
    -- if typeIR <: invalidHeaderTypeIR
    -- let invalidHeaderTypeIR = typeIR as invalidHeaderTypeIR
    -- if (invalidHeaderTypeIR = HEADER_INVALID)
  row 12 :
    (signature) setTypeIR as typeIR
    (typeIR) -> false
    -- if typeIR <: setTypeIR
    -- let setTypeIR = typeIR as setTypeIR
  row 13 :
    (signature) tableMetadataTypeIR as typeIR
    (typeIR) -> false
    -- if typeIR <: tableMetadataTypeIR
    -- let tableMetadataTypeIR = typeIR as tableMetadataTypeIR
  row 14 :
    (signature) _typeIR
    (_typeIR) -> true

tbl def $is_assignable_typeIR(typeIR) : bool =
  row 0 :
    (signature) VOID as typeIR
    (typeIR) -> false
    -- if typeIR <: voidTypeIR
    -- let voidTypeIR = typeIR as voidTypeIR
    -- if (voidTypeIR = VOID)
  row 1 :
    (signature) STRING as typeIR
    (typeIR) -> false
    -- if typeIR <: stringTypeIR
    -- let stringTypeIR = typeIR as stringTypeIR
    -- if (stringTypeIR = STRING)
  row 2 :
    (signature) INT as typeIR
    (typeIR) -> false
    -- if typeIR <: intTypeIR
    -- let intTypeIR = typeIR as intTypeIR
    -- if (intTypeIR = INT)
  row 3 :
    (signature) TYPEDEF _typeId typeIR as typeIR
    (typeIR') -> $is_assignable_typeIR(typeIR)
    -- if typeIR' <: typedefTypeIR
    -- let TYPEDEF _typeId typeIR = typeIR' as typedefTypeIR
  row 4 :
    (signature) objectTypeIR as typeIR
    (typeIR) -> false
    -- if typeIR <: objectTypeIR
    -- let objectTypeIR = typeIR as objectTypeIR
  row 5 :
    (signature) synthesizedTypeIR as typeIR
    (typeIR) -> false
    -- if typeIR <: synthesizedTypeIR
    -- let synthesizedTypeIR = typeIR as synthesizedTypeIR
  row 6 :
    (signature) _typeIR
    (_typeIR) -> true

tbl def $is_serializable_typeIR(typeIR) : bool =
  row 0 :
    (signature) BOOL as typeIR
    (typeIR) -> true
    -- if typeIR <: boolTypeIR
    -- let boolTypeIR = typeIR as boolTypeIR
    -- if (boolTypeIR = BOOL)
  row 1 :
    (signature) INT `< _nat `> as typeIR
    (typeIR) -> true
    -- if typeIR <: fixedIntTypeIR
    -- let INT `< _nat `> = typeIR as fixedIntTypeIR
  row 2 :
    (signature) BIT `< _nat `> as typeIR
    (typeIR) -> true
    -- if typeIR <: fixedBitTypeIR
    -- let BIT `< _nat `> = typeIR as fixedBitTypeIR
  row 3 :
    (signature) VARBIT `< _nat `> as typeIR
    (typeIR) -> true
    -- if typeIR <: varBitTypeIR
    -- let VARBIT `< _nat `> = typeIR as varBitTypeIR
  row 4 :
    (signature) TYPEDEF _typeId typeIR as typeIR
    (typeIR') -> $is_serializable_typeIR(typeIR)
    -- if typeIR' <: typedefTypeIR
    -- let TYPEDEF _typeId typeIR = typeIR' as typedefTypeIR
  row 5 :
    (signature) TYPE _typeId typeIR as typeIR
    (typeIR') -> $is_serializable_typeIR(typeIR)
    -- if typeIR' <: newTypeIR
    -- let TYPE _typeId typeIR = typeIR' as newTypeIR
  row 6 :
    (signature) ENUM _typeId `< typeIR `> `{ _valueFieldIR*{_valueFieldIR <- _valueFieldIR*} `} as typeIR
    (typeIR') -> $is_serializable_typeIR(typeIR)
    -- if typeIR' <: serializableEnumTypeIR
    -- let ENUM _typeId `< typeIR `> `{ _valueFieldIR*{_valueFieldIR <- _valueFieldIR*} `} = typeIR' as serializableEnumTypeIR
  row 7 :
    (signature) TUPLE `< typeIR*{typeIR <- typeIR*} `> as typeIR
    (typeIR') -> $forall_($is_serializable_typeIR(typeIR)*{typeIR <- typeIR*})
    -- if typeIR' <: tupleTypeIR
    -- let TUPLE `< typeIR*{typeIR <- typeIR*} `> = typeIR' as tupleTypeIR
  row 8 :
    (signature) ARRAY typeIR `[ _nat `] as typeIR
    (typeIR') -> $is_serializable_typeIR(typeIR)
    -- if typeIR' <: arrayTypeIR
    -- let ARRAY typeIR `[ _nat `] = typeIR' as arrayTypeIR
  row 9 :
    (signature) HEADER_STACK typeIR `[ _nat `] as typeIR
    (typeIR') -> $is_serializable_typeIR(typeIR)
    -- if typeIR' <: headerStackTypeIR
    -- let HEADER_STACK typeIR `[ _nat `] = typeIR' as headerStackTypeIR
  row 10 :
    (signature) STRUCT _typeId `< _typeArgumentIR*{_typeArgumentIR <- _typeArgumentIR*} `> `{ _annotationList typeIR _nameIR ';'*{_annotationList <- _annotationList*, _nameIR <- _nameIR*, typeIR <- typeIR*} `} as typeIR
    (typeIR') -> $forall_($is_serializable_typeIR(typeIR)*{typeIR <- typeIR*})
    -- if typeIR' <: structTypeIR
    -- let STRUCT _typeId `< _typeArgumentIR*{_typeArgumentIR <- _typeArgumentIR*} `> `{ _annotationList typeIR _nameIR ';'*{_annotationList <- _annotationList*, _nameIR <- _nameIR*, typeIR <- typeIR*} `} = typeIR' as structTypeIR
  row 11 :
    (signature) HEADER _typeId `< _typeArgumentIR*{_typeArgumentIR <- _typeArgumentIR*} `> `{ _annotationList typeIR _nameIR ';'*{_annotationList <- _annotationList*, _nameIR <- _nameIR*, typeIR <- typeIR*} `} as typeIR
    (typeIR') -> $forall_($is_serializable_typeIR(typeIR)*{typeIR <- typeIR*})
    -- if typeIR' <: headerTypeIR
    -- let HEADER _typeId `< _typeArgumentIR*{_typeArgumentIR <- _typeArgumentIR*} `> `{ _annotationList typeIR _nameIR ';'*{_annotationList <- _annotationList*, _nameIR <- _nameIR*, typeIR <- typeIR*} `} = typeIR' as headerTypeIR
  row 12 :
    (signature) HEADER_UNION _typeId `< _typeArgumentIR*{_typeArgumentIR <- _typeArgumentIR*} `> `{ _annotationList typeIR _nameIR ';'*{_annotationList <- _annotationList*, _nameIR <- _nameIR*, typeIR <- typeIR*} `} as typeIR
    (typeIR') -> $forall_($is_serializable_typeIR(typeIR)*{typeIR <- typeIR*})
    -- if typeIR' <: headerUnionTypeIR
    -- let HEADER_UNION _typeId `< _typeArgumentIR*{_typeArgumentIR <- _typeArgumentIR*} `> `{ _annotationList typeIR _nameIR ';'*{_annotationList <- _annotationList*, _nameIR <- _nameIR*, typeIR <- typeIR*} `} = typeIR' as headerUnionTypeIR
  row 13 :
    (signature) _typeIR
    (_typeIR) -> false

def $typeId_of_typeDefIR(typeDefIR) : typeId =

  clause 0 : (typeDefIR) = typeId
  -- if typeDefIR <: nameTypeIR
  -- let _NAME typeId = typeDefIR as nameTypeIR

  clause 1 : (typeDefIR) = typeId
  -- if typeDefIR <: typedefTypeIR
  -- let TYPEDEF typeId _typeIR = typeDefIR as typedefTypeIR

  clause 2 : (typeDefIR) = typeId
  -- if typeDefIR <: newTypeIR
  -- let TYPE typeId _typeIR = typeDefIR as newTypeIR

  clause 3 : (typeDefIR) = typeId
  -- if typeDefIR <: structTypeDefIR
  -- let STRUCT typeId `< _typeParameterIR*{_typeParameterIR <- _typeParameterIR*} `> `{ _fieldTypeIR*{_fieldTypeIR <- _fieldTypeIR*} `} = typeDefIR as structTypeDefIR

  clause 4 : (typeDefIR) = typeId
  -- if typeDefIR <: headerTypeDefIR
  -- let HEADER typeId `< _typeParameterIR*{_typeParameterIR <- _typeParameterIR*} `> `{ _fieldTypeIR*{_fieldTypeIR <- _fieldTypeIR*} `} = typeDefIR as headerTypeDefIR

  clause 5 : (typeDefIR) = typeId
  -- if typeDefIR <: headerUnionTypeDefIR
  -- let HEADER_UNION typeId `< _typeParameterIR*{_typeParameterIR <- _typeParameterIR*} `> `{ _fieldTypeIR*{_fieldTypeIR <- _fieldTypeIR*} `} = typeDefIR as headerUnionTypeDefIR

  clause 6 : (typeDefIR) = typeId
  -- if typeDefIR <: simpleEnumTypeIR
  -- let ENUM typeId `{ _nameIR*{_nameIR <- _nameIR*} `} = typeDefIR as simpleEnumTypeIR

  clause 7 : (typeDefIR) = typeId
  -- if typeDefIR <: serializableEnumTypeIR
  -- let ENUM typeId `< _typeIR `> `{ _valueFieldIR*{_valueFieldIR <- _valueFieldIR*} `} = typeDefIR as serializableEnumTypeIR

  clause 8 : (typeDefIR) = typeId
  -- if typeDefIR <: externObjectTypeDefIR
  -- let EXTERN typeId `< _typeParameterIR*{_typeParameterIR <- _typeParameterIR*} ',' _typeParameterIR'*{_typeParameterIR' <- _typeParameterIR'*} `> `{ _pair<callableId, externMethodTypeDefIR>*{_pair<callableId, externMethodTypeDefIR> <- _pair<callableId, externMethodTypeDefIR>*} `} = typeDefIR as externObjectTypeDefIR

  clause 9 : (typeDefIR) = typeId
  -- if typeDefIR <: parserObjectTypeDefIR
  -- let PARSER typeId `< _typeParameterIR*{_typeParameterIR <- _typeParameterIR*} ',' _typeParameterIR'*{_typeParameterIR' <- _typeParameterIR'*} `> `( _parameterIR*{_parameterIR <- _parameterIR*} `) = typeDefIR as parserObjectTypeDefIR

  clause 10 : (typeDefIR) = typeId
  -- if typeDefIR <: controlObjectTypeDefIR
  -- let CONTROL typeId `< _typeParameterIR*{_typeParameterIR <- _typeParameterIR*} ',' _typeParameterIR'*{_typeParameterIR' <- _typeParameterIR'*} `> `( _parameterIR*{_parameterIR <- _parameterIR*} `) = typeDefIR as controlObjectTypeDefIR

  clause 11 : (typeDefIR) = typeId
  -- if typeDefIR <: packageObjectTypeDefIR
  -- let PACKAGE typeId `< _typeParameterIR*{_typeParameterIR <- _typeParameterIR*} ',' _typeParameterIR'*{_typeParameterIR' <- _typeParameterIR'*} `> `{ _typeIR*{_typeIR <- _typeIR*} `} = typeDefIR as packageObjectTypeDefIR

  clause 12 : (typeDefIR) = typeId
  -- if typeDefIR <: tableObjectTypeIR
  -- let TABLE typeId `{ _tableMetadataStructTypeIR `} = typeDefIR as tableObjectTypeIR

def $typeIR_of_typeDefIR(typeDefIR) : typeIR =

  clause 0 : (typeDefIR) = nameTypeDefIR as typeIR
  -- if typeDefIR <: nameTypeDefIR
  -- let nameTypeDefIR = typeDefIR as nameTypeDefIR

  clause 1 : (typeDefIR) = aliasTypeDefIR as typeIR
  -- if typeDefIR <: aliasTypeDefIR
  -- let aliasTypeDefIR = typeDefIR as aliasTypeDefIR

  clause 2 : (typeDefIR) = STRUCT typeId `< _NAME typeParameterIR as typeIR*{typeParameterIR <- typeParameterIR*} `> `{ fieldTypeIR*{fieldTypeIR <- fieldTypeIR*} `} as typeIR
  -- if typeDefIR <: structTypeDefIR
  -- let STRUCT typeId `< typeParameterIR*{typeParameterIR <- typeParameterIR*} `> `{ fieldTypeIR*{fieldTypeIR <- fieldTypeIR*} `} = typeDefIR as structTypeDefIR

  clause 3 : (typeDefIR) = HEADER typeId `< _NAME typeParameterIR as typeIR*{typeParameterIR <- typeParameterIR*} `> `{ fieldTypeIR*{fieldTypeIR <- fieldTypeIR*} `} as typeIR
  -- if typeDefIR <: headerTypeDefIR
  -- let HEADER typeId `< typeParameterIR*{typeParameterIR <- typeParameterIR*} `> `{ fieldTypeIR*{fieldTypeIR <- fieldTypeIR*} `} = typeDefIR as headerTypeDefIR

  clause 4 : (typeDefIR) = HEADER_UNION typeId `< _NAME typeParameterIR as typeIR*{typeParameterIR <- typeParameterIR*} `> `{ fieldTypeIR*{fieldTypeIR <- fieldTypeIR*} `} as typeIR
  -- if typeDefIR <: headerUnionTypeDefIR
  -- let HEADER_UNION typeId `< typeParameterIR*{typeParameterIR <- typeParameterIR*} `> `{ fieldTypeIR*{fieldTypeIR <- fieldTypeIR*} `} = typeDefIR as headerUnionTypeDefIR

  clause 5 : (typeDefIR) = enumTypeDefIR as typeIR
  -- if typeDefIR <: enumTypeDefIR
  -- let enumTypeDefIR = typeDefIR as enumTypeDefIR

  clause 6 : (typeDefIR) = EXTERN typeId `< _NAME typeParameterIR as typeIR*{typeParameterIR <- typeParameterIR*} `> `{ callableId ':' externMethodTypeDefIR*{callableId <- callableId*, externMethodTypeDefIR <- externMethodTypeDefIR*} `} as typeIR
  -- if typeDefIR <: externObjectTypeDefIR
  -- let EXTERN typeId `< typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*} ',' typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*} `> `{ callableId ':' externMethodTypeDefIR*{callableId <- callableId*, externMethodTypeDefIR <- externMethodTypeDefIR*} `} = typeDefIR as externObjectTypeDefIR
  -- let typeParameterIR*{typeParameterIR <- typeParameterIR*} = typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*} ++ typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*}

  clause 7 : (typeDefIR) = PARSER typeId `< _NAME typeParameterIR as typeIR*{typeParameterIR <- typeParameterIR*} `> `( parameterIR*{parameterIR <- parameterIR*} `) as typeIR
  -- if typeDefIR <: parserObjectTypeDefIR
  -- let PARSER typeId `< typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*} ',' typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*} `> `( parameterIR*{parameterIR <- parameterIR*} `) = typeDefIR as parserObjectTypeDefIR
  -- let typeParameterIR*{typeParameterIR <- typeParameterIR*} = typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*} ++ typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*}

  clause 8 : (typeDefIR) = CONTROL typeId `< _NAME typeParameterIR as typeIR*{typeParameterIR <- typeParameterIR*} `> `( parameterIR*{parameterIR <- parameterIR*} `) as typeIR
  -- if typeDefIR <: controlObjectTypeDefIR
  -- let CONTROL typeId `< typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*} ',' typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*} `> `( parameterIR*{parameterIR <- parameterIR*} `) = typeDefIR as controlObjectTypeDefIR
  -- let typeParameterIR*{typeParameterIR <- typeParameterIR*} = typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*} ++ typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*}

  clause 9 : (typeDefIR) = PACKAGE typeId `< _NAME typeParameterIR as typeIR*{typeParameterIR <- typeParameterIR*} `> `{ typeIR*{typeIR <- typeIR*} `} as typeIR
  -- if typeDefIR <: packageObjectTypeDefIR
  -- let PACKAGE typeId `< typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*} ',' typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*} `> `{ typeIR*{typeIR <- typeIR*} `} = typeDefIR as packageObjectTypeDefIR
  -- let typeParameterIR*{typeParameterIR <- typeParameterIR*} = typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*} ++ typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*}

  clause 10 : (typeDefIR) = tableObjectTypeDefIR as typeIR
  -- if typeDefIR <: tableObjectTypeDefIR
  -- let tableObjectTypeDefIR = typeDefIR as tableObjectTypeDefIR

def $typeParameterListIR_of_typeDefIR(typeDefIR) : (typeParameterIR*, typeParameterIR*) =

  clause 0 : (typeDefIR) = ([], [])
  -- if typeDefIR <: nameTypeDefIR
  -- let nameTypeDefIR = typeDefIR as nameTypeDefIR

  clause 1 : (typeDefIR) = ([], [])
  -- if typeDefIR <: aliasTypeDefIR
  -- let aliasTypeDefIR = typeDefIR as aliasTypeDefIR

  clause 2 : (typeDefIR) = (typeParameterIR*{typeParameterIR <- typeParameterIR*}, [])
  -- if typeDefIR <: structTypeDefIR
  -- let STRUCT _typeId `< typeParameterIR*{typeParameterIR <- typeParameterIR*} `> `{ _fieldTypeIR*{_fieldTypeIR <- _fieldTypeIR*} `} = typeDefIR as structTypeDefIR

  clause 3 : (typeDefIR) = (typeParameterIR*{typeParameterIR <- typeParameterIR*}, [])
  -- if typeDefIR <: headerTypeDefIR
  -- let HEADER _typeId `< typeParameterIR*{typeParameterIR <- typeParameterIR*} `> `{ _fieldTypeIR*{_fieldTypeIR <- _fieldTypeIR*} `} = typeDefIR as headerTypeDefIR

  clause 4 : (typeDefIR) = (typeParameterIR*{typeParameterIR <- typeParameterIR*}, [])
  -- if typeDefIR <: headerUnionTypeDefIR
  -- let HEADER_UNION _typeId `< typeParameterIR*{typeParameterIR <- typeParameterIR*} `> `{ _fieldTypeIR*{_fieldTypeIR <- _fieldTypeIR*} `} = typeDefIR as headerUnionTypeDefIR

  clause 5 : (typeDefIR) = ([], [])
  -- if typeDefIR <: enumTypeDefIR
  -- let enumTypeDefIR = typeDefIR as enumTypeDefIR

  clause 6 : (typeDefIR) = (typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*}, typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*})
  -- if typeDefIR <: externObjectTypeDefIR
  -- let EXTERN _typeId `< typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*} ',' typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*} `> `{ _pair<callableId, externMethodTypeDefIR>*{_pair<callableId, externMethodTypeDefIR> <- _pair<callableId, externMethodTypeDefIR>*} `} = typeDefIR as externObjectTypeDefIR

  clause 7 : (typeDefIR) = (typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*}, typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*})
  -- if typeDefIR <: parserObjectTypeDefIR
  -- let PARSER _typeId `< typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*} ',' typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*} `> `( _parameterIR*{_parameterIR <- _parameterIR*} `) = typeDefIR as parserObjectTypeDefIR

  clause 8 : (typeDefIR) = (typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*}, typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*})
  -- if typeDefIR <: controlObjectTypeDefIR
  -- let CONTROL _typeId `< typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*} ',' typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*} `> `( _parameterIR*{_parameterIR <- _parameterIR*} `) = typeDefIR as controlObjectTypeDefIR

  clause 9 : (typeDefIR) = (typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*}, typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*})
  -- if typeDefIR <: packageObjectTypeDefIR
  -- let PACKAGE _typeId `< typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*} ',' typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*} `> `{ _typeIR*{_typeIR <- _typeIR*} `} = typeDefIR as packageObjectTypeDefIR

  clause 10 : (typeDefIR) = ([], [])
  -- if typeDefIR <: tableObjectTypeDefIR
  -- let tableObjectTypeDefIR = typeDefIR as tableObjectTypeDefIR

def $is_monomorphic_typeDefIR(typeDefIR) : bool =

  clause 0 : (typeDefIR) = true
  -- if typeDefIR <: nameTypeDefIR
  -- let nameTypeDefIR = typeDefIR as nameTypeDefIR

  clause 1 : (typeDefIR) = true
  -- if typeDefIR <: aliasTypeDefIR
  -- let aliasTypeDefIR = typeDefIR as aliasTypeDefIR

  clause 2 : (typeDefIR) = true
  -- if typeDefIR <: enumTypeDefIR
  -- let enumTypeDefIR = typeDefIR as enumTypeDefIR

  clause 3 : (typeDefIR) = true
  -- if typeDefIR <: tableObjectTypeDefIR
  -- let tableObjectTypeDefIR = typeDefIR as tableObjectTypeDefIR

  clause -1 : (typeDefIR) = false

def $is_polymorphic_typeDefIR(typeDefIR) : bool =

  clause 0 : (typeDefIR) = ~$is_monomorphic_typeDefIR(typeDefIR)

syntax initializerIR = 
   | '=' typedExpressionIR (from initializerIR) 

syntax constantInitializerIR = 
   | '=' _VALUE value (from constantInitializerIR) 

syntax parameterInitializerIR = 
   | '=' typedExpressionIR (from initializerIR) 
   | '=' _VALUE value (from constantInitializerIR) 

syntax parameterInitializerOptIR = parameterInitializerIR?

syntax parameterIR = 
   | annotationList direction typeIR id parameterInitializerOptIR (from parameterIR)  hint(prose_fields "annotations" "direction" "type" "name" "default initializer")

syntax actionTypeIR = 
   | annotationList ACTION nameIR `( parameterIR* `) (from actionTypeIR) 

syntax definedFunctionTypeIR = 
   | FUNCTION nameIR `( parameterIR* `) ':' typeIR (from definedFunctionTypeIR) 

syntax externFunctionTypeIR = 
   | EXTERN_FUNCTION nameIR `( parameterIR* `) ':' typeIR (from externFunctionTypeIR) 

syntax functionTypeIR = 
   | FUNCTION nameIR `( parameterIR* `) ':' typeIR (from definedFunctionTypeIR) 
   | EXTERN_FUNCTION nameIR `( parameterIR* `) ':' typeIR (from externFunctionTypeIR) 

syntax builtinIsValidMethodTypeIR = 
   | BUILTIN_IS_VALID (from builtinIsValidMethodTypeIR) 

syntax builtinSetValidMethodTypeIR = 
   | BUILTIN_SET_VALID (from builtinSetValidMethodTypeIR) 

syntax builtinSetInvalidMethodTypeIR = 
   | BUILTIN_SET_INVALID (from builtinSetInvalidMethodTypeIR) 

syntax builtinPushFrontMethodTypeIR = 
   | BUILTIN_PUSH_FRONT (from builtinPushFrontMethodTypeIR) 

syntax builtinPopFrontMethodTypeIR = 
   | BUILTIN_POP_FRONT (from builtinPopFrontMethodTypeIR) 

syntax builtinSizeMethodTypeIR = 
   | BUILTIN_SIZE_OF (from builtinSizeMethodTypeIR) 

syntax builtinMethodTypeIR = 
   | BUILTIN_IS_VALID (from builtinIsValidMethodTypeIR) 
   | BUILTIN_SET_VALID (from builtinSetValidMethodTypeIR) 
   | BUILTIN_SET_INVALID (from builtinSetInvalidMethodTypeIR) 
   | BUILTIN_PUSH_FRONT (from builtinPushFrontMethodTypeIR) 
   | BUILTIN_POP_FRONT (from builtinPopFrontMethodTypeIR) 
   | BUILTIN_SIZE_OF (from builtinSizeMethodTypeIR) 

def $signature_of_builtinMethodTypeIR(builtinMethodTypeIR) : (parameterIR*, typeIR) =

  clause 0 : (builtinMethodTypeIR) = ([], BOOL as typeIR)
  -- if builtinMethodTypeIR <: builtinIsValidMethodTypeIR
  -- let builtinIsValidMethodTypeIR = builtinMethodTypeIR as builtinIsValidMethodTypeIR
  -- if (builtinIsValidMethodTypeIR = BUILTIN_IS_VALID)

  clause 1 : (builtinMethodTypeIR) = ([], VOID as typeIR)
  -- if builtinMethodTypeIR <: builtinSetValidMethodTypeIR
  -- let builtinSetValidMethodTypeIR = builtinMethodTypeIR as builtinSetValidMethodTypeIR
  -- if (builtinSetValidMethodTypeIR = BUILTIN_SET_VALID)

  clause 2 : (builtinMethodTypeIR) = ([], VOID as typeIR)
  -- if builtinMethodTypeIR <: builtinSetInvalidMethodTypeIR
  -- let builtinSetInvalidMethodTypeIR = builtinMethodTypeIR as builtinSetInvalidMethodTypeIR
  -- if (builtinSetInvalidMethodTypeIR = BUILTIN_SET_INVALID)

  clause 3 : (builtinMethodTypeIR) = ([_EMPTY _EMPTY INT as typeIR "count" ?()], VOID as typeIR)
  -- if builtinMethodTypeIR <: builtinPushFrontMethodTypeIR
  -- let builtinPushFrontMethodTypeIR = builtinMethodTypeIR as builtinPushFrontMethodTypeIR
  -- if (builtinPushFrontMethodTypeIR = BUILTIN_PUSH_FRONT)

  clause 4 : (builtinMethodTypeIR) = ([_EMPTY _EMPTY INT as typeIR "count" ?()], VOID as typeIR)
  -- if builtinMethodTypeIR <: builtinPopFrontMethodTypeIR
  -- let builtinPopFrontMethodTypeIR = builtinMethodTypeIR as builtinPopFrontMethodTypeIR
  -- if (builtinPopFrontMethodTypeIR = BUILTIN_POP_FRONT)

  clause 5 : (builtinMethodTypeIR) = ([], INT as typeIR)
  -- if builtinMethodTypeIR <: builtinSizeMethodTypeIR
  -- let builtinSizeMethodTypeIR = builtinMethodTypeIR as builtinSizeMethodTypeIR
  -- if (builtinSizeMethodTypeIR = BUILTIN_SIZE_OF)

syntax externMethodTypeIR = 
   | EXTERN_METHOD nameIR `( parameterIR* `) ':' typeIR (from externMethodTypeIR) 
   | EXTERN_METHOD ABSTRACT nameIR `( parameterIR* `) ':' typeIR (from externMethodTypeIR) 

syntax parserApplyMethodTypeIR = 
   | PARSER_APPLY `( parameterIR* `) (from parserApplyMethodTypeIR) 

syntax controlApplyMethodTypeIR = 
   | CONTROL_APPLY `( parameterIR* `) (from controlApplyMethodTypeIR) 

syntax tableApplyMethodTypeIR = 
   | TABLE_APPLY ':' tableMetadataStructTypeIR (from tableApplyMethodTypeIR) 

syntax methodTypeIR = 
   | BUILTIN_IS_VALID (from builtinIsValidMethodTypeIR) 
   | BUILTIN_SET_VALID (from builtinSetValidMethodTypeIR) 
   | BUILTIN_SET_INVALID (from builtinSetInvalidMethodTypeIR) 
   | BUILTIN_PUSH_FRONT (from builtinPushFrontMethodTypeIR) 
   | BUILTIN_POP_FRONT (from builtinPopFrontMethodTypeIR) 
   | BUILTIN_SIZE_OF (from builtinSizeMethodTypeIR) 
   | EXTERN_METHOD nameIR `( parameterIR* `) ':' typeIR (from externMethodTypeIR) 
   | EXTERN_METHOD ABSTRACT nameIR `( parameterIR* `) ':' typeIR (from externMethodTypeIR) 
   | PARSER_APPLY `( parameterIR* `) (from parserApplyMethodTypeIR) 
   | CONTROL_APPLY `( parameterIR* `) (from controlApplyMethodTypeIR) 
   | TABLE_APPLY ':' tableMetadataStructTypeIR (from tableApplyMethodTypeIR) 

syntax callableTypeIR = 
   | annotationList ACTION nameIR `( parameterIR* `) (from actionTypeIR) 
   | FUNCTION nameIR `( parameterIR* `) ':' typeIR (from definedFunctionTypeIR) 
   | EXTERN_FUNCTION nameIR `( parameterIR* `) ':' typeIR (from externFunctionTypeIR) 
   | BUILTIN_IS_VALID (from builtinIsValidMethodTypeIR) 
   | BUILTIN_SET_VALID (from builtinSetValidMethodTypeIR) 
   | BUILTIN_SET_INVALID (from builtinSetInvalidMethodTypeIR) 
   | BUILTIN_PUSH_FRONT (from builtinPushFrontMethodTypeIR) 
   | BUILTIN_POP_FRONT (from builtinPopFrontMethodTypeIR) 
   | BUILTIN_SIZE_OF (from builtinSizeMethodTypeIR) 
   | EXTERN_METHOD nameIR `( parameterIR* `) ':' typeIR (from externMethodTypeIR) 
   | EXTERN_METHOD ABSTRACT nameIR `( parameterIR* `) ':' typeIR (from externMethodTypeIR) 
   | PARSER_APPLY `( parameterIR* `) (from parserApplyMethodTypeIR) 
   | CONTROL_APPLY `( parameterIR* `) (from controlApplyMethodTypeIR) 
   | TABLE_APPLY ':' tableMetadataStructTypeIR (from tableApplyMethodTypeIR) 

def $id_of_parameterIR(parameterIR) : id =

  clause 0 : (_annotationList _direction _typeIR id _parameterInitializerOptIR) = id

def $is_default_parameterIR(parameterIR) : bool =

  clause 0 : (_annotationList _direction _typeIR _id parameterInitializerIR?{parameterInitializerIR <- parameterInitializerIR?}) = false
  -- if parameterInitializerIR?{parameterInitializerIR <- parameterInitializerIR?} matches ()

  clause -1 : (_annotationList _direction _typeIR _id _parameterInitializerOptIR) = true

def $annotationList_of_parameterIR(parameterIR) : annotationList =

  clause 0 : (annotationList _direction _typeIR _id _parameterInitializerOptIR) = annotationList

def $optional_annotation_of_parameterIR(parameterIR) : bool =

  clause 0 : (parameterIR) = $optional_annotation_of_parameterIR'(annotationList)
  -- let annotationList = $annotationList_of_parameterIR(parameterIR)

def $optional_annotation_of_parameterIR'(annotationList) : bool =

  clause 0 : (annotationList) = $exists_(b*{b <- b*})
  -- let annotation*{annotation <- annotation*} = $flatten_annotationList(annotationList)
  -- (let b = $optional_annotation_of_parameterIR''(annotation))*{annotation <- annotation*, b -> b*}

def $optional_annotation_of_parameterIR''(annotation) : bool =

  clause 0 : (annotation) = true
  -- if annotation matches `@ %`
  -- let '@' name = annotation
  -- if ("optional" = $name(name))

  clause -1 : (annotation) = false

def $is_optional_parameterIR(parameterIR) : bool =

  clause 0 : (parameterIR) = $optional_annotation_of_parameterIR(parameterIR)

syntax actionTypeDefIR = actionTypeIR

syntax definedFunctionTypeDefIR = 
   | FUNCTION nameIR `< typeParameterIR* ',' typeParameterIR* `> `( parameterIR* `) ':' typeIR (from definedFunctionTypeDefIR) 

syntax externFunctionTypeDefIR = 
   | EXTERN_FUNCTION nameIR `< typeParameterIR* ',' typeParameterIR* `> `( parameterIR* `) ':' typeIR (from externFunctionTypeDefIR) 

syntax functionTypeDefIR = 
   | FUNCTION nameIR `< typeParameterIR* ',' typeParameterIR* `> `( parameterIR* `) ':' typeIR (from definedFunctionTypeDefIR) 
   | EXTERN_FUNCTION nameIR `< typeParameterIR* ',' typeParameterIR* `> `( parameterIR* `) ':' typeIR (from externFunctionTypeDefIR) 

syntax externMethodTypeDefIR = 
   | EXTERN_METHOD nameIR `< typeParameterIR* ',' typeParameterIR* `> `( parameterIR* `) ':' typeIR (from externMethodTypeDefIR) 
   | EXTERN_METHOD ABSTRACT nameIR `< typeParameterIR* ',' typeParameterIR* `> `( parameterIR* `) ':' typeIR (from externMethodTypeDefIR) 

syntax parserApplyMethodTypeDefIR = parserApplyMethodTypeIR

syntax controlApplyMethodTypeDefIR = controlApplyMethodTypeIR

syntax tableApplyMethodTypeDefIR = tableApplyMethodTypeIR

syntax methodTypeDefIR = 
   | EXTERN_METHOD nameIR `< typeParameterIR* ',' typeParameterIR* `> `( parameterIR* `) ':' typeIR (from externMethodTypeDefIR) 
   | EXTERN_METHOD ABSTRACT nameIR `< typeParameterIR* ',' typeParameterIR* `> `( parameterIR* `) ':' typeIR (from externMethodTypeDefIR) 
   | PARSER_APPLY `( parameterIR* `) (from parserApplyMethodTypeIR) 
   | CONTROL_APPLY `( parameterIR* `) (from controlApplyMethodTypeIR) 
   | TABLE_APPLY ':' tableMetadataStructTypeIR (from tableApplyMethodTypeIR) 

syntax callableTypeDefIR = 
   | annotationList ACTION nameIR `( parameterIR* `) (from actionTypeIR) 
   | FUNCTION nameIR `< typeParameterIR* ',' typeParameterIR* `> `( parameterIR* `) ':' typeIR (from definedFunctionTypeDefIR) 
   | EXTERN_FUNCTION nameIR `< typeParameterIR* ',' typeParameterIR* `> `( parameterIR* `) ':' typeIR (from externFunctionTypeDefIR) 
   | EXTERN_METHOD nameIR `< typeParameterIR* ',' typeParameterIR* `> `( parameterIR* `) ':' typeIR (from externMethodTypeDefIR) 
   | EXTERN_METHOD ABSTRACT nameIR `< typeParameterIR* ',' typeParameterIR* `> `( parameterIR* `) ':' typeIR (from externMethodTypeDefIR) 
   | PARSER_APPLY `( parameterIR* `) (from parserApplyMethodTypeIR) 
   | CONTROL_APPLY `( parameterIR* `) (from controlApplyMethodTypeIR) 
   | TABLE_APPLY ':' tableMetadataStructTypeIR (from tableApplyMethodTypeIR) 

def $callableTypeIR_of_callableTypeDefIR(callableTypeDefIR) : callableTypeIR =

  clause 0 : (callableTypeDefIR) = actionTypeDefIR as callableTypeIR
  -- if callableTypeDefIR <: actionTypeDefIR
  -- let actionTypeDefIR = callableTypeDefIR as actionTypeDefIR

  clause 1 : (callableTypeDefIR) = FUNCTION nameIR `( parameterIR*{parameterIR <- parameterIR*} `) ':' typeIR as callableTypeIR
  -- if callableTypeDefIR <: definedFunctionTypeDefIR
  -- let FUNCTION nameIR `< _typeParameterIR*{_typeParameterIR <- _typeParameterIR*} ',' _typeParameterIR'*{_typeParameterIR' <- _typeParameterIR'*} `> `( parameterIR*{parameterIR <- parameterIR*} `) ':' typeIR = callableTypeDefIR as definedFunctionTypeDefIR

  clause 2 : (callableTypeDefIR) = EXTERN_FUNCTION nameIR `( parameterIR*{parameterIR <- parameterIR*} `) ':' typeIR as callableTypeIR
  -- if callableTypeDefIR <: externFunctionTypeDefIR
  -- let EXTERN_FUNCTION nameIR `< _typeParameterIR*{_typeParameterIR <- _typeParameterIR*} ',' _typeParameterIR'*{_typeParameterIR' <- _typeParameterIR'*} `> `( parameterIR*{parameterIR <- parameterIR*} `) ':' typeIR = callableTypeDefIR as externFunctionTypeDefIR

  clause 3 : (callableTypeDefIR) = EXTERN_METHOD nameIR `( parameterIR*{parameterIR <- parameterIR*} `) ':' typeIR as callableTypeIR
  -- if callableTypeDefIR <: externMethodTypeDefIR
  -- let externMethodTypeDefIR = callableTypeDefIR as externMethodTypeDefIR
  -- if externMethodTypeDefIR matches `EXTERN_METHOD % <% , %> (%) : %`
  -- let EXTERN_METHOD nameIR `< _typeParameterIR*{_typeParameterIR <- _typeParameterIR*} ',' _typeParameterIR'*{_typeParameterIR' <- _typeParameterIR'*} `> `( parameterIR*{parameterIR <- parameterIR*} `) ':' typeIR = externMethodTypeDefIR

  clause 4 : (callableTypeDefIR) = EXTERN_METHOD ABSTRACT nameIR `( parameterIR*{parameterIR <- parameterIR*} `) ':' typeIR as callableTypeIR
  -- if callableTypeDefIR <: externMethodTypeDefIR
  -- let externMethodTypeDefIR = callableTypeDefIR as externMethodTypeDefIR
  -- if externMethodTypeDefIR matches `EXTERN_METHOD ABSTRACT % <% , %> (%) : %`
  -- let EXTERN_METHOD ABSTRACT nameIR `< _typeParameterIR*{_typeParameterIR <- _typeParameterIR*} ',' _typeParameterIR'*{_typeParameterIR' <- _typeParameterIR'*} `> `( parameterIR*{parameterIR <- parameterIR*} `) ':' typeIR = externMethodTypeDefIR

  clause 5 : (callableTypeDefIR) = parserApplyMethodTypeDefIR as callableTypeIR
  -- if callableTypeDefIR <: parserApplyMethodTypeDefIR
  -- let parserApplyMethodTypeDefIR = callableTypeDefIR as parserApplyMethodTypeDefIR

  clause 6 : (callableTypeDefIR) = controlApplyMethodTypeDefIR as callableTypeIR
  -- if callableTypeDefIR <: controlApplyMethodTypeDefIR
  -- let controlApplyMethodTypeDefIR = callableTypeDefIR as controlApplyMethodTypeDefIR

def $typeParameterListIR_of_callableTypeDefIR(callableTypeDefIR) : (typeParameterIR*, typeParameterIR*) =

  clause 0 : (callableTypeDefIR) = ([], [])
  -- if callableTypeDefIR <: actionTypeDefIR
  -- let actionTypeDefIR = callableTypeDefIR as actionTypeDefIR

  clause 1 : (callableTypeDefIR) = (typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*}, typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*})
  -- if callableTypeDefIR <: definedFunctionTypeDefIR
  -- let FUNCTION _nameIR `< typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*} ',' typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*} `> `( _parameterIR*{_parameterIR <- _parameterIR*} `) ':' _typeIR = callableTypeDefIR as definedFunctionTypeDefIR

  clause 2 : (callableTypeDefIR) = (typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*}, typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*})
  -- if callableTypeDefIR <: externFunctionTypeDefIR
  -- let EXTERN_FUNCTION _nameIR `< typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*} ',' typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*} `> `( _parameterIR*{_parameterIR <- _parameterIR*} `) ':' _typeIR = callableTypeDefIR as externFunctionTypeDefIR

  clause 3 : (callableTypeDefIR) = (typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*}, typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*})
  -- if callableTypeDefIR <: externMethodTypeDefIR
  -- let externMethodTypeDefIR = callableTypeDefIR as externMethodTypeDefIR
  -- if externMethodTypeDefIR matches `EXTERN_METHOD % <% , %> (%) : %`
  -- let EXTERN_METHOD _nameIR `< typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*} ',' typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*} `> `( _parameterIR*{_parameterIR <- _parameterIR*} `) ':' _typeIR = externMethodTypeDefIR

  clause 4 : (callableTypeDefIR) = (typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*}, typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*})
  -- if callableTypeDefIR <: externMethodTypeDefIR
  -- let externMethodTypeDefIR = callableTypeDefIR as externMethodTypeDefIR
  -- if externMethodTypeDefIR matches `EXTERN_METHOD ABSTRACT % <% , %> (%) : %`
  -- let EXTERN_METHOD ABSTRACT _nameIR `< typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*} ',' typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*} `> `( _parameterIR*{_parameterIR <- _parameterIR*} `) ':' _typeIR = externMethodTypeDefIR

  clause 5 : (callableTypeDefIR) = ([], [])
  -- if callableTypeDefIR <: parserApplyMethodTypeDefIR
  -- let parserApplyMethodTypeDefIR = callableTypeDefIR as parserApplyMethodTypeDefIR

  clause 6 : (callableTypeDefIR) = ([], [])
  -- if callableTypeDefIR <: controlApplyMethodTypeDefIR
  -- let controlApplyMethodTypeDefIR = callableTypeDefIR as controlApplyMethodTypeDefIR

def $parameterListIR_of_callableTypeDefIR(callableTypeDefIR) : parameterIR* =

  clause 0 : (callableTypeDefIR) = $parameterListIR_of_actionTypeDefIR(actionTypeDefIR)
  -- if callableTypeDefIR <: actionTypeDefIR
  -- let actionTypeDefIR = callableTypeDefIR as actionTypeDefIR

  clause 1 : (callableTypeDefIR) = $parameterListIR_of_functionTypeDefIR(functionTypeDefIR)
  -- if callableTypeDefIR <: functionTypeDefIR
  -- let functionTypeDefIR = callableTypeDefIR as functionTypeDefIR

  clause 2 : (callableTypeDefIR) = $parameterListIR_of_methodTypeDefIR(methodTypeDefIR)
  -- if callableTypeDefIR <: methodTypeDefIR
  -- let methodTypeDefIR = callableTypeDefIR as methodTypeDefIR

def $parameterListIR_of_actionTypeDefIR(actionTypeDefIR) : parameterIR* =

  clause 0 : (_annotationList ACTION _nameIR `( parameterIR*{parameterIR <- parameterIR*} `)) = parameterIR*{parameterIR <- parameterIR*}

def $parameterListIR_of_functionTypeDefIR(functionTypeDefIR) : parameterIR* =

  clause 0 : (functionTypeDefIR) = $parameterListIR_of_definedFunctionTypeDefIR(definedFunctionTypeDefIR)
  -- if functionTypeDefIR <: definedFunctionTypeDefIR
  -- let definedFunctionTypeDefIR = functionTypeDefIR as definedFunctionTypeDefIR

  clause 1 : (functionTypeDefIR) = $parameterListIR_of_externFunctionTypeDefIR(externFunctionTypeDefIR)
  -- if functionTypeDefIR <: externFunctionTypeDefIR
  -- let externFunctionTypeDefIR = functionTypeDefIR as externFunctionTypeDefIR

def $parameterListIR_of_definedFunctionTypeDefIR(definedFunctionTypeDefIR) : parameterIR* =

  clause 0 : (FUNCTION _nameIR `< _typeParameterIR*{_typeParameterIR <- _typeParameterIR*} ',' _typeParameterIR'*{_typeParameterIR' <- _typeParameterIR'*} `> `( parameterIR*{parameterIR <- parameterIR*} `) ':' _typeIR) = parameterIR*{parameterIR <- parameterIR*}

def $parameterListIR_of_externFunctionTypeDefIR(externFunctionTypeDefIR) : parameterIR* =

  clause 0 : (EXTERN_FUNCTION _nameIR `< _typeParameterIR*{_typeParameterIR <- _typeParameterIR*} ',' _typeParameterIR'*{_typeParameterIR' <- _typeParameterIR'*} `> `( parameterIR*{parameterIR <- parameterIR*} `) ':' _typeIR) = parameterIR*{parameterIR <- parameterIR*}

def $parameterListIR_of_methodTypeDefIR(methodTypeDefIR) : parameterIR* =

  clause 0 : (methodTypeDefIR) = $parameterListIR_of_externMethodTypeDefIR(externMethodTypeDefIR)
  -- if methodTypeDefIR <: externMethodTypeDefIR
  -- let externMethodTypeDefIR = methodTypeDefIR as externMethodTypeDefIR

  clause 1 : (methodTypeDefIR) = $parameterListIR_of_parserApplyMethodTypeIR(parserApplyMethodTypeIR)
  -- if methodTypeDefIR <: parserApplyMethodTypeIR
  -- let parserApplyMethodTypeIR = methodTypeDefIR as parserApplyMethodTypeIR

  clause 2 : (methodTypeDefIR) = $parameterListIR_of_controlApplyMethodTypeIR(controlApplyMethodTypeIR)
  -- if methodTypeDefIR <: controlApplyMethodTypeIR
  -- let controlApplyMethodTypeIR = methodTypeDefIR as controlApplyMethodTypeIR

  clause 3 : (methodTypeDefIR) = $parameterListIR_of_tableApplyMethodTypeDefIR(tableApplyMethodTypeDefIR)
  -- if methodTypeDefIR <: tableApplyMethodTypeDefIR
  -- let tableApplyMethodTypeDefIR = methodTypeDefIR as tableApplyMethodTypeDefIR

def $parameterListIR_of_externMethodTypeDefIR(externMethodTypeDefIR) : parameterIR* =

  clause 0 : (externMethodTypeDefIR) = parameterIR*{parameterIR <- parameterIR*}
  -- if externMethodTypeDefIR matches `EXTERN_METHOD % <% , %> (%) : %`
  -- let EXTERN_METHOD _nameIR `< _typeParameterIR*{_typeParameterIR <- _typeParameterIR*} ',' _typeParameterIR'*{_typeParameterIR' <- _typeParameterIR'*} `> `( parameterIR*{parameterIR <- parameterIR*} `) ':' _typeIR = externMethodTypeDefIR

  clause 1 : (externMethodTypeDefIR) = parameterIR*{parameterIR <- parameterIR*}
  -- if externMethodTypeDefIR matches `EXTERN_METHOD ABSTRACT % <% , %> (%) : %`
  -- let EXTERN_METHOD ABSTRACT _nameIR `< _typeParameterIR*{_typeParameterIR <- _typeParameterIR*} ',' _typeParameterIR'*{_typeParameterIR' <- _typeParameterIR'*} `> `( parameterIR*{parameterIR <- parameterIR*} `) ':' _typeIR = externMethodTypeDefIR

def $parameterListIR_of_parserApplyMethodTypeIR(parserApplyMethodTypeIR) : parameterIR* =

  clause 0 : (PARSER_APPLY `( parameterIR*{parameterIR <- parameterIR*} `)) = parameterIR*{parameterIR <- parameterIR*}

def $parameterListIR_of_controlApplyMethodTypeIR(controlApplyMethodTypeIR) : parameterIR* =

  clause 0 : (CONTROL_APPLY `( parameterIR*{parameterIR <- parameterIR*} `)) = parameterIR*{parameterIR <- parameterIR*}

def $parameterListIR_of_tableApplyMethodTypeDefIR(tableApplyMethodTypeDefIR) : parameterIR* =

  clause 0 : (tableApplyMethodTypeIR) = []

syntax constructorParameterIR = parameterIR

syntax constructorTypeIR = 
   | CONSTRUCTOR `( constructorParameterIR* `) ':' typeIR (from constructorTypeIR) 

syntax constructorTypeDefIR = 
   | CONSTRUCTOR `< typeParameterIR* ',' typeParameterIR* `> `( constructorParameterIR* `) ':' typeIR (from constructorTypeDefIR) 

def $parameterListIR_of_constructorTypeDefIR(constructorTypeDefIR) : parameterIR* =

  clause 0 : (CONSTRUCTOR `< _typeParameterIR*{_typeParameterIR <- _typeParameterIR*} ',' _typeParameterIR'*{_typeParameterIR' <- _typeParameterIR'*} `> `( constructorParameterIR*{constructorParameterIR <- constructorParameterIR*} `) ':' _typeIR) = constructorParameterIR*{constructorParameterIR <- constructorParameterIR*}

syntax bound = set<typeId>

var B : bound

def $free_typeIR(typeIR) : bound =

  clause 0 : (typeIR) = `{ [] `}
  -- if typeIR <: baseTypeIR
  -- let baseTypeIR = typeIR as baseTypeIR

  clause 1 : (typeIR) = `{ [typeId] `}
  -- if typeIR <: nameTypeIR
  -- let _NAME typeId = typeIR as nameTypeIR

  clause 2 : (typeIR') = $free_typeIR(typeIR)
  -- if typeIR' <: typedefTypeIR
  -- let TYPEDEF _typeId typeIR = typeIR' as typedefTypeIR

  clause 3 : (typeIR') = $free_typeIR(typeIR)
  -- if typeIR' <: newTypeIR
  -- let TYPE _typeId typeIR = typeIR' as newTypeIR

  clause 4 : (typeIR') = $free_typeIR(typeIR)
  -- if typeIR' <: listTypeIR
  -- let LIST `< typeIR `> = typeIR' as listTypeIR

  clause 5 : (typeIR') = $unions_set<typeId>($free_typeIR(typeIR)*{typeIR <- typeIR*})
  -- if typeIR' <: tupleTypeIR
  -- let TUPLE `< typeIR*{typeIR <- typeIR*} `> = typeIR' as tupleTypeIR

  clause 6 : (typeIR') = $free_typeIR(typeIR)
  -- if typeIR' <: arrayTypeIR
  -- let ARRAY typeIR `[ _nat `] = typeIR' as arrayTypeIR

  clause 7 : (typeIR') = $free_typeIR(typeIR)
  -- if typeIR' <: headerStackTypeIR
  -- let HEADER_STACK typeIR `[ _nat `] = typeIR' as headerStackTypeIR

  clause 8 : (typeIR) = $union_set<typeId>($unions_set<typeId>($free_typeIR(typeArgumentIR)*{typeArgumentIR <- typeArgumentIR*}), $unions_set<typeId>($free_typeIR(typeIR_field)*{typeIR_field <- typeIR_field*}))
  -- if typeIR <: structTypeIR
  -- let STRUCT _typeId `< typeArgumentIR*{typeArgumentIR <- typeArgumentIR*} `> `{ _annotationList typeIR_field _nameIR ';'*{_annotationList <- _annotationList*, _nameIR <- _nameIR*, typeIR_field <- typeIR_field*} `} = typeIR as structTypeIR

  clause 9 : (typeIR) = $union_set<typeId>($unions_set<typeId>($free_typeIR(typeArgumentIR)*{typeArgumentIR <- typeArgumentIR*}), $unions_set<typeId>($free_typeIR(typeIR_field)*{typeIR_field <- typeIR_field*}))
  -- if typeIR <: headerTypeIR
  -- let HEADER _typeId `< typeArgumentIR*{typeArgumentIR <- typeArgumentIR*} `> `{ _annotationList typeIR_field _nameIR ';'*{_annotationList <- _annotationList*, _nameIR <- _nameIR*, typeIR_field <- typeIR_field*} `} = typeIR as headerTypeIR

  clause 10 : (typeIR) = $union_set<typeId>($unions_set<typeId>($free_typeIR(typeArgumentIR)*{typeArgumentIR <- typeArgumentIR*}), $unions_set<typeId>($free_typeIR(typeIR_field)*{typeIR_field <- typeIR_field*}))
  -- if typeIR <: headerUnionTypeIR
  -- let HEADER_UNION _typeId `< typeArgumentIR*{typeArgumentIR <- typeArgumentIR*} `> `{ _annotationList typeIR_field _nameIR ';'*{_annotationList <- _annotationList*, _nameIR <- _nameIR*, typeIR_field <- typeIR_field*} `} = typeIR as headerUnionTypeIR

  clause 11 : (typeIR) = `{ [] `}
  -- if typeIR <: simpleEnumTypeIR
  -- let ENUM _typeId `{ _nameIR*{_nameIR <- _nameIR*} `} = typeIR as simpleEnumTypeIR

  clause 12 : (typeIR') = $free_typeIR(typeIR)
  -- if typeIR' <: serializableEnumTypeIR
  -- let ENUM _typeId `< typeIR `> `{ _valueFieldIR*{_valueFieldIR <- _valueFieldIR*} `} = typeIR' as serializableEnumTypeIR

  clause 13 : (typeIR) = $union_set<typeId>($unions_set<typeId>($free_typeIR(typeArgumentIR)*{typeArgumentIR <- typeArgumentIR*}), $unions_set<typeId>($free_callableTypeDefIR(externMethodTypeDefIR as callableTypeDefIR)*{externMethodTypeDefIR <- externMethodTypeDefIR*}))
  -- if typeIR <: externObjectTypeIR
  -- let EXTERN _typeId `< typeArgumentIR*{typeArgumentIR <- typeArgumentIR*} `> `{ _callableId ':' externMethodTypeDefIR*{_callableId <- _callableId*, externMethodTypeDefIR <- externMethodTypeDefIR*} `} = typeIR as externObjectTypeIR

  clause 14 : (typeIR) = $union_set<typeId>($unions_set<typeId>($free_typeIR(typeArgumentIR)*{typeArgumentIR <- typeArgumentIR*}), $unions_set<typeId>($free_parameterIR(parameterIR)*{parameterIR <- parameterIR*}))
  -- if typeIR <: parserObjectTypeIR
  -- let PARSER _typeId `< typeArgumentIR*{typeArgumentIR <- typeArgumentIR*} `> `( parameterIR*{parameterIR <- parameterIR*} `) = typeIR as parserObjectTypeIR

  clause 15 : (typeIR) = $union_set<typeId>($unions_set<typeId>($free_typeIR(typeArgumentIR)*{typeArgumentIR <- typeArgumentIR*}), $unions_set<typeId>($free_parameterIR(parameterIR)*{parameterIR <- parameterIR*}))
  -- if typeIR <: controlObjectTypeIR
  -- let CONTROL _typeId `< typeArgumentIR*{typeArgumentIR <- typeArgumentIR*} `> `( parameterIR*{parameterIR <- parameterIR*} `) = typeIR as controlObjectTypeIR

  clause 16 : (typeIR') = $union_set<typeId>($unions_set<typeId>($free_typeIR(typeArgumentIR)*{typeArgumentIR <- typeArgumentIR*}), $unions_set<typeId>($free_typeIR(typeIR)*{typeIR <- typeIR*}))
  -- if typeIR' <: packageObjectTypeIR
  -- let PACKAGE _typeId `< typeArgumentIR*{typeArgumentIR <- typeArgumentIR*} `> `{ typeIR*{typeIR <- typeIR*} `} = typeIR' as packageObjectTypeIR

  clause 17 : (typeIR) = `{ [] `}
  -- if typeIR <: tableObjectTypeIR
  -- let TABLE _typeId `{ _tableMetadataStructTypeIR `} = typeIR as tableObjectTypeIR

  clause 18 : (typeIR) = `{ [] `}
  -- if typeIR <: defaultTypeIR
  -- let defaultTypeIR = typeIR as defaultTypeIR
  -- if (defaultTypeIR = DEFAULT)

  clause 19 : (typeIR) = `{ [] `}
  -- if typeIR <: invalidHeaderTypeIR
  -- let invalidHeaderTypeIR = typeIR as invalidHeaderTypeIR
  -- if (invalidHeaderTypeIR = HEADER_INVALID)

  clause 20 : (typeIR') = $unions_set<typeId>($free_typeIR(typeIR)*{typeIR <- typeIR*})
  -- if typeIR' <: sequenceTypeIR
  -- let sequenceTypeIR = typeIR' as sequenceTypeIR
  -- if sequenceTypeIR matches `SEQ <%>`
  -- let SEQ `< typeIR*{typeIR <- typeIR*} `> = sequenceTypeIR

  clause 21 : (typeIR') = $unions_set<typeId>($free_typeIR(typeIR)*{typeIR <- typeIR*})
  -- if typeIR' <: sequenceTypeIR
  -- let sequenceTypeIR = typeIR' as sequenceTypeIR
  -- if sequenceTypeIR matches `SEQ <% , ...>`
  -- let SEQ `< typeIR*{typeIR <- typeIR*} ',' '...' `> = sequenceTypeIR

  clause 22 : (typeIR') = $unions_set<typeId>($free_typeIR(typeIR)*{typeIR <- typeIR*})
  -- if typeIR' <: recordTypeIR
  -- let recordTypeIR = typeIR' as recordTypeIR
  -- if recordTypeIR matches `RECORD {%}`
  -- let RECORD `{ _annotationList typeIR _nameIR ';'*{_annotationList <- _annotationList*, _nameIR <- _nameIR*, typeIR <- typeIR*} `} = recordTypeIR

  clause 23 : (typeIR') = $unions_set<typeId>($free_typeIR(typeIR)*{typeIR <- typeIR*})
  -- if typeIR' <: recordTypeIR
  -- let recordTypeIR = typeIR' as recordTypeIR
  -- if recordTypeIR matches `RECORD {% , ...}`
  -- let RECORD `{ _annotationList typeIR _nameIR ';'*{_annotationList <- _annotationList*, _nameIR <- _nameIR*, typeIR <- typeIR*} ',' '...' `} = recordTypeIR

  clause 24 : (typeIR') = $free_typeIR(typeIR)
  -- if typeIR' <: setTypeIR
  -- let SET `< typeIR `> = typeIR' as setTypeIR

  clause 25 : (typeIR) = `{ [] `}
  -- if typeIR <: tableMetadataTypeIR
  -- let tableMetadataTypeIR = typeIR as tableMetadataTypeIR

def $free_typeDefIR(typeDefIR) : bound =

  clause 0 : (typeDefIR) = $diff_set<typeId>(B_base, B_tparams)
  -- let (typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*}, typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*}) = $typeParameterListIR_of_typeDefIR(typeDefIR)
  -- let B_tparams = `{ typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*} ++ typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*} `}
  -- let typeIR = $typeIR_of_typeDefIR(typeDefIR)
  -- let B_base = $free_typeIR(typeIR)

def $free_parameterIR(parameterIR) : bound =

  clause 0 : (_annotationList _direction typeIR _id _parameterInitializerOptIR) = $free_typeIR(typeIR)

def $free_parameterIRs(parameterIR*) : bound =

  clause 0 : (parameterIR*{parameterIR <- parameterIR*}) = $unions_set<typeId>($free_parameterIR(parameterIR)*{parameterIR <- parameterIR*})

def $free_callableTypeIR(callableTypeIR) : bound =

  clause 0 : (callableTypeIR) = B_params
  -- if callableTypeIR <: actionTypeIR
  -- let _annotationList ACTION _nameIR `( parameterIR*{parameterIR <- parameterIR*} `) = callableTypeIR as actionTypeIR
  -- let B_params = $unions_set<typeId>($free_parameterIR(parameterIR)*{parameterIR <- parameterIR*})

  clause 1 : (callableTypeIR) = $union_set<typeId>(B_params, B_ret)
  -- if callableTypeIR <: definedFunctionTypeIR
  -- let FUNCTION _nameIR `( parameterIR*{parameterIR <- parameterIR*} `) ':' typeIR = callableTypeIR as definedFunctionTypeIR
  -- let B_params = $unions_set<typeId>($free_parameterIR(parameterIR)*{parameterIR <- parameterIR*})
  -- let B_ret = $free_typeIR(typeIR)

  clause 2 : (callableTypeIR) = $union_set<typeId>(B_params, B_ret)
  -- if callableTypeIR <: externFunctionTypeIR
  -- let EXTERN_FUNCTION _nameIR `( parameterIR*{parameterIR <- parameterIR*} `) ':' typeIR = callableTypeIR as externFunctionTypeIR
  -- let B_params = $unions_set<typeId>($free_parameterIR(parameterIR)*{parameterIR <- parameterIR*})
  -- let B_ret = $free_typeIR(typeIR)

  clause 3 : (callableTypeIR) = `{ [] `}
  -- if callableTypeIR <: builtinMethodTypeIR
  -- let builtinMethodTypeIR = callableTypeIR as builtinMethodTypeIR

  clause 4 : (callableTypeIR) = $union_set<typeId>(B_params, B_ret)
  -- if callableTypeIR <: externMethodTypeIR
  -- let externMethodTypeIR = callableTypeIR as externMethodTypeIR
  -- if externMethodTypeIR matches `EXTERN_METHOD % (%) : %`
  -- let EXTERN_METHOD _nameIR `( parameterIR*{parameterIR <- parameterIR*} `) ':' typeIR = externMethodTypeIR
  -- let B_params = $unions_set<typeId>($free_parameterIR(parameterIR)*{parameterIR <- parameterIR*})
  -- let B_ret = $free_typeIR(typeIR)

  clause 5 : (callableTypeIR) = $union_set<typeId>(B_params, B_ret)
  -- if callableTypeIR <: externMethodTypeIR
  -- let externMethodTypeIR = callableTypeIR as externMethodTypeIR
  -- if externMethodTypeIR matches `EXTERN_METHOD ABSTRACT % (%) : %`
  -- let EXTERN_METHOD ABSTRACT _nameIR `( parameterIR*{parameterIR <- parameterIR*} `) ':' typeIR = externMethodTypeIR
  -- let B_params = $unions_set<typeId>($free_parameterIR(parameterIR)*{parameterIR <- parameterIR*})
  -- let B_ret = $free_typeIR(typeIR)

  clause 6 : (callableTypeIR) = B_params
  -- if callableTypeIR <: parserApplyMethodTypeIR
  -- let PARSER_APPLY `( parameterIR*{parameterIR <- parameterIR*} `) = callableTypeIR as parserApplyMethodTypeIR
  -- let B_params = $unions_set<typeId>($free_parameterIR(parameterIR)*{parameterIR <- parameterIR*})

  clause 7 : (callableTypeIR) = B_params
  -- if callableTypeIR <: controlApplyMethodTypeIR
  -- let CONTROL_APPLY `( parameterIR*{parameterIR <- parameterIR*} `) = callableTypeIR as controlApplyMethodTypeIR
  -- let B_params = $unions_set<typeId>($free_parameterIR(parameterIR)*{parameterIR <- parameterIR*})

  clause 8 : (callableTypeIR) = `{ [] `}
  -- if callableTypeIR <: tableApplyMethodTypeIR
  -- let TABLE_APPLY ':' _tableMetadataStructTypeIR = callableTypeIR as tableApplyMethodTypeIR

def $free_callableTypeDefIR(callableTypeDefIR) : bound =

  clause 0 : (callableTypeDefIR) = $diff_set<typeId>(B_base, B_tparams)
  -- let (typeId_tparam_expl*{typeId_tparam_expl <- typeId_tparam_expl*}, typeId_tparam_impl*{typeId_tparam_impl <- typeId_tparam_impl*}) = $typeParameterListIR_of_callableTypeDefIR(callableTypeDefIR)
  -- let B_tparams = `{ typeId_tparam_expl*{typeId_tparam_expl <- typeId_tparam_expl*} ++ typeId_tparam_impl*{typeId_tparam_impl <- typeId_tparam_impl*} `}
  -- let callableTypeIR = $callableTypeIR_of_callableTypeDefIR(callableTypeDefIR)
  -- let B_base = $free_callableTypeIR(callableTypeIR)

syntax theta = map<typeId, typeIR>

def $empty_theta : theta =

  clause 0 :  = $empty_map<typeId, typeIR>

def $capture_avoiding_(theta, typeParameterIR*, bound) : (theta, typeParameterIR*) =

  clause 0 : (theta, typeParameterIR*{typeParameterIR <- typeParameterIR*}, B) = (theta_fresh, typeParameterIR_fresh*{typeParameterIR_fresh <- typeParameterIR_fresh*})
  -- let `{ typeId_free*{typeId_free <- typeId_free*} `} = $diff_set<typeId>(B, `{ typeParameterIR*{typeParameterIR <- typeParameterIR*} `})
  -- (let typeIR?{typeIR <- typeIR?} = $find_map<typeId, typeIR>(theta, typeId_free))*{typeId_free <- typeId_free*, typeIR? -> typeIR?*}
  -- (if typeIR?{typeIR <- typeIR?} matches (_))*{typeIR? <- typeIR?*}
  -- (let ?(typeIR_free) = typeIR?{typeIR <- typeIR?})*{typeIR? <- typeIR?*, typeIR_free -> typeIR_free*}
  -- let B_capture = $unions_set<typeId>($free_typeIR(typeIR_free)*{typeIR_free <- typeIR_free*})
  -- let typeParameterIR_fresh*{typeParameterIR_fresh <- typeParameterIR_fresh*} = $fresh_typeIds(|typeParameterIR*{typeParameterIR <- typeParameterIR*}|)
  -- (if ~$in_set<typeId>(typeParameterIR_fresh, B_capture))*{typeParameterIR_fresh <- typeParameterIR_fresh*}
  -- let theta_fresh = $adds_map<typeId, typeIR>(theta, typeParameterIR*{typeParameterIR <- typeParameterIR*}, _NAME typeParameterIR_fresh as typeIR*{typeParameterIR_fresh <- typeParameterIR_fresh*})

def $capture_avoiding(theta, typeId*, typeId*, bound) : (theta, typeId*, typeId*) =

  clause 0 : (theta, typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*}, typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*}, B) = (theta_fresh, typeParameterIR_expl_fresh*{typeParameterIR_expl_fresh <- typeParameterIR_expl_fresh*}, typeParameterIR_impl_fresh*{typeParameterIR_impl_fresh <- typeParameterIR_impl_fresh*})
  -- let `{ typeId_free*{typeId_free <- typeId_free*} `} = $diff_set<typeId>(B, `{ typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*} ++ typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*} `})
  -- (let typeIR?{typeIR <- typeIR?} = $find_map<typeId, typeIR>(theta, typeId_free))*{typeId_free <- typeId_free*, typeIR? -> typeIR?*}
  -- (if typeIR?{typeIR <- typeIR?} matches (_))*{typeIR? <- typeIR?*}
  -- (let ?(typeIR_free) = typeIR?{typeIR <- typeIR?})*{typeIR? <- typeIR?*, typeIR_free -> typeIR_free*}
  -- let B_capture = $unions_set<typeId>($free_typeIR(typeIR_free)*{typeIR_free <- typeIR_free*})
  -- let typeId_fresh*{typeId_fresh <- typeId_fresh*} = $fresh_typeIds(|typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*} ++ typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*}|)
  -- (if ~$in_set<typeId>(typeId_fresh, B_capture))*{typeId_fresh <- typeId_fresh*}
  -- let typeParameterIR_expl_fresh*{typeParameterIR_expl_fresh <- typeParameterIR_expl_fresh*} = typeId_fresh*{typeId_fresh <- typeId_fresh*}[0 : |typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*}|]
  -- let typeParameterIR_impl_fresh*{typeParameterIR_impl_fresh <- typeParameterIR_impl_fresh*} = typeId_fresh*{typeId_fresh <- typeId_fresh*}[|typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*}| : |typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*}|]
  -- let theta_fresh = $adds_map<typeId, typeIR>(theta, typeParameterIR_expl*{typeParameterIR_expl <- typeParameterIR_expl*} ++ typeParameterIR_impl*{typeParameterIR_impl <- typeParameterIR_impl*}, _NAME typeParameterIR_expl_fresh as typeIR*{typeParameterIR_expl_fresh <- typeParameterIR_expl_fresh*} ++ _NAME typeParameterIR_impl_fresh as typeIR*{typeParameterIR_impl_fresh <- typeParameterIR_impl_fresh*})

def $subst_typeIR(theta, typeIR) : typeIR =

  clause 0 : (set<pair<typeId, typeIR>>, typeIR) = typeIR
  -- if (set<pair<typeId, typeIR>> = `{ [] `})

  clause -1 : (theta, typeIR) = $subst_typeIR'(theta, typeIR)

def $subst_typeIR'(theta, typeIR) : typeIR =

  clause 0 : (theta, typeIR) = baseTypeIR as typeIR
  -- if typeIR <: baseTypeIR
  -- let baseTypeIR = typeIR as baseTypeIR

  clause 1 : (theta, typeIR') = typeIR
  -- if typeIR' <: nameTypeIR
  -- let _NAME typeId = typeIR' as nameTypeIR
  -- let typeIR''?{typeIR'' <- typeIR''?} = $find_map<typeId, typeIR>(theta, typeId)
  -- if typeIR''?{typeIR'' <- typeIR''?} matches (_)
  -- let ?(typeIR) = typeIR''?{typeIR'' <- typeIR''?}

  clause 2 : (theta, typeIR) = _NAME typeId as typeIR
  -- if typeIR <: nameTypeIR
  -- let _NAME typeId = typeIR as nameTypeIR
  -- if (?() = $find_map<typeId, typeIR>(theta, typeId))

  clause 3 : (theta, typeIR') = TYPEDEF typeId typeIR_subst as typeIR
  -- if typeIR' <: typedefTypeIR
  -- let TYPEDEF typeId typeIR = typeIR' as typedefTypeIR
  -- let typeIR_subst = $subst_typeIR'(theta, typeIR)

  clause 4 : (theta, typeIR') = TYPE typeId typeIR_subst as typeIR
  -- if typeIR' <: newTypeIR
  -- let TYPE typeId typeIR = typeIR' as newTypeIR
  -- let typeIR_subst = $subst_typeIR'(theta, typeIR)

  clause 5 : (theta, typeIR') = LIST `< typeIR_subst `> as typeIR
  -- if typeIR' <: listTypeIR
  -- let LIST `< typeIR `> = typeIR' as listTypeIR
  -- let typeIR_subst = $subst_typeIR'(theta, typeIR)

  clause 6 : (theta, typeIR') = TUPLE `< typeIR_subst*{typeIR_subst <- typeIR_subst*} `> as typeIR
  -- if typeIR' <: tupleTypeIR
  -- let TUPLE `< typeIR*{typeIR <- typeIR*} `> = typeIR' as tupleTypeIR
  -- (let typeIR_subst = $subst_typeIR'(theta, typeIR))*{typeIR <- typeIR*, typeIR_subst -> typeIR_subst*}

  clause 7 : (theta, typeIR') = ARRAY typeIR_subst `[ n_size `] as typeIR
  -- if typeIR' <: arrayTypeIR
  -- let ARRAY typeIR `[ n_size `] = typeIR' as arrayTypeIR
  -- let typeIR_subst = $subst_typeIR'(theta, typeIR)

  clause 8 : (theta, typeIR') = HEADER_STACK typeIR_subst `[ n_size `] as typeIR
  -- if typeIR' <: headerStackTypeIR
  -- let HEADER_STACK typeIR `[ n_size `] = typeIR' as headerStackTypeIR
  -- let typeIR_subst = $subst_typeIR'(theta, typeIR)

  clause 9 : (theta, typeIR) = structTypeIR_subst as typeIR
  -- if typeIR <: structTypeIR
  -- let structTypeIR = typeIR as structTypeIR
  -- let STRUCT typeId `< typeArgumentIR*{typeArgumentIR <- typeArgumentIR*} `> `{ annotationList typeIR_field nameIR_field ';'*{annotationList <- annotationList*, nameIR_field <- nameIR_field*, typeIR_field <- typeIR_field*} `} = structTypeIR
  -- (let typeArgumentIR_subst = $subst_typeIR'(theta, typeArgumentIR))*{typeArgumentIR <- typeArgumentIR*, typeArgumentIR_subst -> typeArgumentIR_subst*}
  -- (let typeIR_field_subst = $subst_typeIR'(theta, typeIR_field))*{typeIR_field <- typeIR_field*, typeIR_field_subst -> typeIR_field_subst*}
  -- let structTypeIR_subst = STRUCT typeId `< typeArgumentIR_subst*{typeArgumentIR_subst <- typeArgumentIR_subst*} `> `{ annotationList typeIR_field_subst nameIR_field ';'*{annotationList <- annotationList*, nameIR_field <- nameIR_field*, typeIR_field_subst <- typeIR_field_subst*} `}

  clause 10 : (theta, typeIR) = headerTypeIR_subst as typeIR
  -- if typeIR <: headerTypeIR
  -- let headerTypeIR = typeIR as headerTypeIR
  -- let HEADER typeId `< typeArgumentIR*{typeArgumentIR <- typeArgumentIR*} `> `{ annotationList typeIR_field nameIR_field ';'*{annotationList <- annotationList*, nameIR_field <- nameIR_field*, typeIR_field <- typeIR_field*} `} = headerTypeIR
  -- (let typeArgumentIR_subst = $subst_typeIR'(theta, typeArgumentIR))*{typeArgumentIR <- typeArgumentIR*, typeArgumentIR_subst -> typeArgumentIR_subst*}
  -- (let typeIR_field_subst = $subst_typeIR'(theta, typeIR_field))*{typeIR_field <- typeIR_field*, typeIR_field_subst -> typeIR_field_subst*}
  -- let headerTypeIR_subst = HEADER typeId `< typeArgumentIR_subst*{typeArgumentIR_subst <- typeArgumentIR_subst*} `> `{ annotationList typeIR_field_subst nameIR_field ';'*{annotationList <- annotationList*, nameIR_field <- nameIR_field*, typeIR_field_subst <- typeIR_field_subst*} `}

  clause 11 : (theta, typeIR) = headerUnionTypeIR_subst as typeIR
  -- if typeIR <: headerUnionTypeIR
  -- let headerUnionTypeIR = typeIR as headerUnionTypeIR
  -- let HEADER_UNION typeId `< typeArgumentIR*{typeArgumentIR <- typeArgumentIR*} `> `{ annotationList typeIR_field nameIR_field ';'*{annotationList <- annotationList*, nameIR_field <- nameIR_field*, typeIR_field <- typeIR_field*} `} = headerUnionTypeIR
  -- (let typeArgumentIR_subst = $subst_typeIR'(theta, typeArgumentIR))*{typeArgumentIR <- typeArgumentIR*, typeArgumentIR_subst -> typeArgumentIR_subst*}
  -- (let typeIR_field_subst = $subst_typeIR'(theta, typeIR_field))*{typeIR_field <- typeIR_field*, typeIR_field_subst -> typeIR_field_subst*}
  -- let headerUnionTypeIR_subst = HEADER_UNION typeId `< typeArgumentIR_subst*{typeArgumentIR_subst <- typeArgumentIR_subst*} `> `{ annotationList typeIR_field_subst nameIR_field ';'*{annotationList <- annotationList*, nameIR_field <- nameIR_field*, typeIR_field_subst <- typeIR_field_subst*} `}

  clause 12 : (theta, typeIR) = ENUM typeId `{ id_field*{id_field <- id_field*} `} as typeIR
  -- if typeIR <: simpleEnumTypeIR
  -- let ENUM typeId `{ id_field*{id_field <- id_field*} `} = typeIR as simpleEnumTypeIR

  clause 13 : (theta, typeIR') = ENUM typeId `< typeIR_subst `> `{ valueFieldIR*{valueFieldIR <- valueFieldIR*} `} as typeIR
  -- if typeIR' <: serializableEnumTypeIR
  -- let ENUM typeId `< typeIR `> `{ valueFieldIR*{valueFieldIR <- valueFieldIR*} `} = typeIR' as serializableEnumTypeIR
  -- let typeIR_subst = $subst_typeIR'(theta, typeIR)

  clause 14 : (theta, typeIR) = externObjectTypeIR_subst as typeIR
  -- if typeIR <: externObjectTypeIR
  -- let externObjectTypeIR = typeIR as externObjectTypeIR
  -- let EXTERN typeId `< typeArgumentIR*{typeArgumentIR <- typeArgumentIR*} `> `{ callableId ':' externMethodTypeDefIR*{callableId <- callableId*, externMethodTypeDefIR <- externMethodTypeDefIR*} `} = externObjectTypeIR
  -- (let typeArgumentIR_subst = $subst_typeIR'(theta, typeArgumentIR))*{typeArgumentIR <- typeArgumentIR*, typeArgumentIR_subst -> typeArgumentIR_subst*}
  -- (let callableTypeDefIR = $subst_callableTypeDefIR(theta, externMethodTypeDefIR as callableTypeDefIR))*{externMethodTypeDefIR <- externMethodTypeDefIR*, callableTypeDefIR -> callableTypeDefIR*}
  -- (if callableTypeDefIR <: externMethodTypeDefIR)*{callableTypeDefIR <- callableTypeDefIR*}
  -- (let externMethodTypeDefIR_subst = callableTypeDefIR as externMethodTypeDefIR)*{callableTypeDefIR <- callableTypeDefIR*, externMethodTypeDefIR_subst -> externMethodTypeDefIR_subst*}
  -- let externObjectTypeIR_subst = EXTERN typeId `< typeArgumentIR_subst*{typeArgumentIR_subst <- typeArgumentIR_subst*} `> `{ callableId ':' externMethodTypeDefIR_subst*{callableId <- callableId*, externMethodTypeDefIR_subst <- externMethodTypeDefIR_subst*} `}

  clause 15 : (theta, typeIR) = parserObjectTypeIR_subst as typeIR
  -- if typeIR <: parserObjectTypeIR
  -- let parserObjectTypeIR = typeIR as parserObjectTypeIR
  -- let PARSER typeId `< typeArgumentIR*{typeArgumentIR <- typeArgumentIR*} `> `( parameterIR*{parameterIR <- parameterIR*} `) = parserObjectTypeIR
  -- (let typeArgumentIR_subst = $subst_typeIR'(theta, typeArgumentIR))*{typeArgumentIR <- typeArgumentIR*, typeArgumentIR_subst -> typeArgumentIR_subst*}
  -- (let parameterIR_subst = $subst_parameterIR'(theta, parameterIR))*{parameterIR <- parameterIR*, parameterIR_subst -> parameterIR_subst*}
  -- let parserObjectTypeIR_subst = PARSER typeId `< typeArgumentIR_subst*{typeArgumentIR_subst <- typeArgumentIR_subst*} `> `( parameterIR_subst*{parameterIR_subst <- parameterIR_subst*} `)

  clause 16 : (theta, typeIR) = controlObjectTypeIR_subst as typeIR
  -- if typeIR <: controlObjectTypeIR
  -- let controlObjectTypeIR = typeIR as controlObjectTypeIR
  -- let CONTROL typeId `< typeArgumentIR*{typeArgumentIR <- typeArgumentIR*} `> `( parameterIR*{parameterIR <- parameterIR*} `) = controlObjectTypeIR
  -- (let typeArgumentIR_subst = $subst_typeIR'(theta, typeArgumentIR))*{typeArgumentIR <- typeArgumentIR*, typeArgumentIR_subst -> typeArgumentIR_subst*}
  -- (let parameterIR_subst = $subst_parameterIR'(theta, parameterIR))*{parameterIR <- parameterIR*, parameterIR_subst -> parameterIR_subst*}
  -- let controlObjectTypeIR_subst = CONTROL typeId `< typeArgumentIR_subst*{typeArgumentIR_subst <- typeArgumentIR_subst*} `> `( parameterIR_subst*{parameterIR_subst <- parameterIR_subst*} `)

  clause 17 : (theta, typeIR') = packageObjectTypeIR_subst as typeIR
  -- if typeIR' <: packageObjectTypeIR
  -- let packageObjectTypeIR = typeIR' as packageObjectTypeIR
  -- let PACKAGE typeId `< typeArgumentIR*{typeArgumentIR <- typeArgumentIR*} `> `{ typeIR*{typeIR <- typeIR*} `} = packageObjectTypeIR
  -- (let typeArgumentIR_subst = $subst_typeIR'(theta, typeArgumentIR))*{typeArgumentIR <- typeArgumentIR*, typeArgumentIR_subst -> typeArgumentIR_subst*}
  -- (let typeIR_subst = $subst_typeIR'(theta, typeIR))*{typeIR <- typeIR*, typeIR_subst -> typeIR_subst*}
  -- let packageObjectTypeIR_subst = PACKAGE typeId `< typeArgumentIR_subst*{typeArgumentIR_subst <- typeArgumentIR_subst*} `> `{ typeIR_subst*{typeIR_subst <- typeIR_subst*} `}

  clause 18 : (theta, typeIR) = tableObjectTypeIR as typeIR
  -- if typeIR <: tableObjectTypeIR
  -- let tableObjectTypeIR = typeIR as tableObjectTypeIR

  clause 19 : (theta, typeIR) = DEFAULT as typeIR
  -- if typeIR <: defaultTypeIR
  -- let defaultTypeIR = typeIR as defaultTypeIR
  -- if (defaultTypeIR = DEFAULT)

  clause 20 : (theta, typeIR) = HEADER_INVALID as typeIR
  -- if typeIR <: invalidHeaderTypeIR
  -- let invalidHeaderTypeIR = typeIR as invalidHeaderTypeIR
  -- if (invalidHeaderTypeIR = HEADER_INVALID)

  clause 21 : (theta, typeIR') = SEQ `< typeIR_subst*{typeIR_subst <- typeIR_subst*} `> as typeIR
  -- if typeIR' <: sequenceTypeIR
  -- let sequenceTypeIR = typeIR' as sequenceTypeIR
  -- if sequenceTypeIR matches `SEQ <%>`
  -- let SEQ `< typeIR*{typeIR <- typeIR*} `> = sequenceTypeIR
  -- (let typeIR_subst = $subst_typeIR'(theta, typeIR))*{typeIR <- typeIR*, typeIR_subst -> typeIR_subst*}

  clause 22 : (theta, typeIR') = SEQ `< typeIR_subst*{typeIR_subst <- typeIR_subst*} ',' '...' `> as typeIR
  -- if typeIR' <: sequenceTypeIR
  -- let sequenceTypeIR = typeIR' as sequenceTypeIR
  -- if sequenceTypeIR matches `SEQ <% , ...>`
  -- let SEQ `< typeIR*{typeIR <- typeIR*} ',' '...' `> = sequenceTypeIR
  -- (let typeIR_subst = $subst_typeIR'(theta, typeIR))*{typeIR <- typeIR*, typeIR_subst -> typeIR_subst*}

  clause 23 : (theta, typeIR) = RECORD `{ annotationList typeIR_field_subst id_field ';'*{annotationList <- annotationList*, id_field <- id_field*, typeIR_field_subst <- typeIR_field_subst*} `} as typeIR
  -- if typeIR <: recordTypeIR
  -- let recordTypeIR = typeIR as recordTypeIR
  -- if recordTypeIR matches `RECORD {%}`
  -- let RECORD `{ annotationList typeIR_field id_field ';'*{annotationList <- annotationList*, id_field <- id_field*, typeIR_field <- typeIR_field*} `} = recordTypeIR
  -- (let typeIR_field_subst = $subst_typeIR'(theta, typeIR_field))*{typeIR_field <- typeIR_field*, typeIR_field_subst -> typeIR_field_subst*}

  clause 24 : (theta, typeIR) = RECORD `{ annotationList typeIR_field_subst id_field ';'*{annotationList <- annotationList*, id_field <- id_field*, typeIR_field_subst <- typeIR_field_subst*} ',' '...' `} as typeIR
  -- if typeIR <: recordTypeIR
  -- let recordTypeIR = typeIR as recordTypeIR
  -- if recordTypeIR matches `RECORD {% , ...}`
  -- let RECORD `{ annotationList typeIR_field id_field ';'*{annotationList <- annotationList*, id_field <- id_field*, typeIR_field <- typeIR_field*} ',' '...' `} = recordTypeIR
  -- (let typeIR_field_subst = $subst_typeIR'(theta, typeIR_field))*{typeIR_field <- typeIR_field*, typeIR_field_subst -> typeIR_field_subst*}

  clause 25 : (theta, typeIR') = SET `< typeIR_subst `> as typeIR
  -- if typeIR' <: setTypeIR
  -- let SET `< typeIR `> = typeIR' as setTypeIR
  -- let typeIR_subst = $subst_typeIR'(theta, typeIR)

  clause 26 : (theta, typeIR) = tableMetadataTypeIR as typeIR
  -- if typeIR <: tableMetadataTypeIR
  -- let tableMetadataTypeIR = typeIR as tableMetadataTypeIR

def $subst_parameterIR(theta, parameterIR) : parameterIR =

  clause 0 : (set<pair<typeId, typeIR>>, parameterIR) = parameterIR
  -- if (set<pair<typeId, typeIR>> = `{ [] `})

  clause -1 : (theta, parameterIR) = $subst_parameterIR'(theta, parameterIR)

def $subst_parameterIR'(theta, parameterIR) : parameterIR =

  clause 0 : (theta, annotationList direction typeIR id parameterInitializerOptIR) = annotationList direction typeIR_subst id parameterInitializerOptIR
  -- let typeIR_subst = $subst_typeIR'(theta, typeIR)

def $subst_callableTypeIR(theta, callableTypeIR) : callableTypeIR =

  clause 0 : (set<pair<typeId, typeIR>>, callableTypeIR) = callableTypeIR
  -- if (set<pair<typeId, typeIR>> = `{ [] `})

  clause -1 : (theta, callableTypeIR) = $subst_callableTypeIR'(theta, callableTypeIR)

def $subst_callableTypeIR'(theta, callableTypeIR) : callableTypeIR =

  clause 0 : (theta, callableTypeIR) = annotationList ACTION nameIR `( parameterIR_subst*{parameterIR_subst <- parameterIR_subst*} `) as callableTypeIR
  -- if callableTypeIR <: actionTypeIR
  -- let annotationList ACTION nameIR `( parameterIR*{parameterIR <- parameterIR*} `) = callableTypeIR as actionTypeIR
  -- (let parameterIR_subst = $subst_parameterIR'(theta, parameterIR))*{parameterIR <- parameterIR*, parameterIR_subst -> parameterIR_subst*}

  clause 1 : (theta, callableTypeIR) = FUNCTION nameIR `( parameterIR_subst*{parameterIR_subst <- parameterIR_subst*} `) ':' typeIR_subst as callableTypeIR
  -- if callableTypeIR <: definedFunctionTypeIR
  -- let FUNCTION nameIR `( parameterIR*{parameterIR <- parameterIR*} `) ':' typeIR = callableTypeIR as definedFunctionTypeIR
  -- (let parameterIR_subst = $subst_parameterIR'(theta, parameterIR))*{parameterIR <- parameterIR*, parameterIR_subst -> parameterIR_subst*}
  -- let typeIR_subst = $subst_typeIR'(theta, typeIR)

  clause 2 : (theta, callableTypeIR) = EXTERN_FUNCTION nameIR `( parameterIR_subst*{parameterIR_subst <- parameterIR_subst*} `) ':' typeIR_subst as callableTypeIR
  -- if callableTypeIR <: externFunctionTypeIR
  -- let EXTERN_FUNCTION nameIR `( parameterIR*{parameterIR <- parameterIR*} `) ':' typeIR = callableTypeIR as externFunctionTypeIR
  -- (let parameterIR_subst = $subst_parameterIR'(theta, parameterIR))*{parameterIR <- parameterIR*, parameterIR_subst -> parameterIR_subst*}
  -- let typeIR_subst = $subst_typeIR'(theta, typeIR)

  clause 3 : (theta, callableTypeIR) = builtinMethodTypeIR as callableTypeIR
  -- if callableTypeIR <: builtinMethodTypeIR
  -- let builtinMethodTypeIR = callableTypeIR as builtinMethodTypeIR

  clause 4 : (theta, callableTypeIR) = EXTERN_METHOD nameIR `( parameterIR_subst*{parameterIR_subst <- parameterIR_subst*} `) ':' typeIR_subst as callableTypeIR
  -- if callableTypeIR <: externMethodTypeIR
  -- let externMethodTypeIR = callableTypeIR as externMethodTypeIR
  -- if externMethodTypeIR matches `EXTERN_METHOD % (%) : %`
  -- let EXTERN_METHOD nameIR `( parameterIR*{parameterIR <- parameterIR*} `) ':' typeIR = externMethodTypeIR
  -- (let parameterIR_subst = $subst_parameterIR'(theta, parameterIR))*{parameterIR <- parameterIR*, parameterIR_subst -> parameterIR_subst*}
  -- let typeIR_subst = $subst_typeIR'(theta, typeIR)

  clause 5 : (theta, callableTypeIR) = EXTERN_METHOD ABSTRACT nameIR `( parameterIR_subst*{parameterIR_subst <- parameterIR_subst*} `) ':' typeIR_subst as callableTypeIR
  -- if callableTypeIR <: externMethodTypeIR
  -- let externMethodTypeIR = callableTypeIR as externMethodTypeIR
  -- if externMethodTypeIR matches `EXTERN_METHOD ABSTRACT % (%) : %`
  -- let EXTERN_METHOD ABSTRACT nameIR `( parameterIR*{parameterIR <- parameterIR*} `) ':' typeIR = externMethodTypeIR
  -- (let parameterIR_subst = $subst_parameterIR'(theta, parameterIR))*{parameterIR <- parameterIR*, parameterIR_subst -> parameterIR_subst*}
  -- let typeIR_subst = $subst_typeIR'(theta, typeIR)

  clause 6 : (theta, callableTypeIR) = PARSER_APPLY `( parameterIR_subst*{parameterIR_subst <- parameterIR_subst*} `) as callableTypeIR
  -- if callableTypeIR <: parserApplyMethodTypeIR
  -- let PARSER_APPLY `( parameterIR*{parameterIR <- parameterIR*} `) = callableTypeIR as parserApplyMethodTypeIR
  -- (let parameterIR_subst = $subst_parameterIR'(theta, parameterIR))*{parameterIR <- parameterIR*, parameterIR_subst -> parameterIR_subst*}

  clause 7 : (theta, callableTypeIR) = CONTROL_APPLY `( parameterIR_subst*{parameterIR_subst <- parameterIR_subst*} `) as callableTypeIR
  -- if callableTypeIR <: controlApplyMethodTypeIR
  -- let CONTROL_APPLY `( parameterIR*{parameterIR <- parameterIR*} `) = callableTypeIR as controlApplyMethodTypeIR
  -- (let parameterIR_subst = $subst_parameterIR'(theta, parameterIR))*{parameterIR <- parameterIR*, parameterIR_subst -> parameterIR_subst*}

  clause 8 : (theta, callableTypeIR) = tableApplyMethodTypeIR as callableTypeIR
  -- if callableTypeIR <: tableApplyMethodTypeIR
  -- let tableApplyMethodTypeIR = callableTypeIR as tableApplyMethodTypeIR

def $subst_callableTypeDefIR(theta, callableTypeDefIR) : callableTypeDefIR =

  clause 0 : (set<pair<typeId, typeIR>>, callableTypeDefIR) = callableTypeDefIR
  -- if (set<pair<typeId, typeIR>> = `{ [] `})

  clause -1 : (theta, callableTypeDefIR) = $subst_callableTypeDefIR'(theta, callableTypeDefIR)

def $subst_callableTypeDefIR'(theta, callableTypeDefIR) : callableTypeDefIR =

  clause 0 : (theta, callableTypeDefIR) = actionTypeDefIR_subst as callableTypeDefIR
  -- if callableTypeDefIR <: actionTypeDefIR
  -- let actionTypeDefIR = callableTypeDefIR as actionTypeDefIR
  -- let callableTypeIR = $subst_callableTypeIR'(theta, actionTypeDefIR as callableTypeIR)
  -- if callableTypeIR <: actionTypeDefIR
