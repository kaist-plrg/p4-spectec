    rulepath serializable
    -- let typeIR'' = typeIR
    -- if typeIR'' <: serializableEnumTypeIR
    -- let ENUM typeId `< typeIR_a `> `{ nameIR_field '=' value_field ';'*{nameIR_field <- nameIR_field*, value_field <- value_field*} `} = typeIR'' as serializableEnumTypeIR
    -- let typeIR''' = typeIR'
    -- if typeIR''' <: serializableEnumTypeIR
    -- let ENUM typeId' `< typeIR_b `> `{ valueFieldIR*{valueFieldIR <- valueFieldIR*} `} = typeIR''' as serializableEnumTypeIR
    -- if (typeId' = typeId)
    -- if (valueFieldIR*{valueFieldIR <- valueFieldIR*} = nameIR_field '=' value_field ';'*{nameIR_field <- nameIR_field*, value_field <- value_field*})
    -- if Type_alpha: typeIR_a ~~ typeIR_b holds
    -- the relation holds

  rulegroup externObjectTypeIR

   match

    (signature) EXTERN typeId `< typeArgumentIR_a*{typeArgumentIR_a <- typeArgumentIR_a*} `> _externMethodTypeDefEnv as typeIR ~~ EXTERN typeId `< typeArgumentIR_b*{typeArgumentIR_b <- typeArgumentIR_b*} `> _externMethodTypeDefEnv' as typeIR
    typeIR ~~ typeIR'
    -- if typeIR <: externObjectTypeIR
    -- let EXTERN typeId `< typeArgumentIR_a*{typeArgumentIR_a <- typeArgumentIR_a*} `> _externMethodTypeDefEnv = typeIR as externObjectTypeIR
    -- if typeIR' <: externObjectTypeIR
    -- let EXTERN typeId' `< typeArgumentIR_b*{typeArgumentIR_b <- typeArgumentIR_b*} `> _externMethodTypeDefEnv' = typeIR' as externObjectTypeIR
    -- if (typeId = typeId')

   paths

    rulepath externObjectTypeIR
    -- if (|typeArgumentIR_a*{typeArgumentIR_a <- typeArgumentIR_a*}| = |typeArgumentIR_b*{typeArgumentIR_b <- typeArgumentIR_b*}|)
    -- (if Type_alpha: typeArgumentIR_a ~~ typeArgumentIR_b holds)*{typeArgumentIR_a <- typeArgumentIR_a*, typeArgumentIR_b <- typeArgumentIR_b*}
    -- the relation holds

