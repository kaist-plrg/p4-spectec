  clause 1 : (initializerIR'?{initializerIR' <- initializerIR'?}) = $lift_initializerIR(initializerIR) as initializerOpt
  -- if initializerIR'?{initializerIR' <- initializerIR'?} matches (_)
  -- let ?(initializerIR) = initializerIR'?{initializerIR' <- initializerIR'?}

