  -- if prefixedNameIR matches `. %`
  -- let '.' nameIR = prefixedNameIR
  -- let nonTypeName = $lift_nameIR_as_nonTypeName(nameIR)

  clause 3 : (callableTargetIR) = expression as memberAccessBase '.' member as expression
