    -- let INT `< _nat `> = typeIR as fixedIntTypeIR
  row 2 :
    (signature) BIT `< _nat `> as typeIR
    (typeIR) -> true
    -- if typeIR <: fixedBitTypeIR
    -- let BIT `< _nat `> = typeIR as fixedBitTypeIR
  row 3 :
    (signature) nameTypeIR as typeIR
    (typeIR) -> true
    -- if typeIR <: nameTypeIR
    -- let nameTypeIR = typeIR as nameTypeIR
  row 4 :
    (signature) TYPEDEF _typeId typeIR as typeIR
    (typeIR') -> $nestable_tuple_in_set(typeIR)
    -- if typeIR' <: typedefTypeIR
    -- let TYPEDEF _typeId typeIR = typeIR' as typedefTypeIR
  row 5 :
    (signature) newTypeIR as typeIR
    (typeIR) -> true
    -- if typeIR <: newTypeIR
    -- let newTypeIR = typeIR as newTypeIR
  row 6 :
    (signature) TUPLE `< typeIR*{typeIR <- typeIR*} `> as typeIR
    (typeIR') -> $forall_($nestable_tuple_in_set(typeIR)*{typeIR <- typeIR*})
    -- if typeIR' <: tupleTypeIR
    -- let TUPLE `< typeIR*{typeIR <- typeIR*} `> = typeIR' as tupleTypeIR
  row 7 :
    (signature) enumTypeIR as typeIR
    (typeIR) -> true
    -- if typeIR <: enumTypeIR
    -- let enumTypeIR = typeIR as enumTypeIR
  row 8 :
    (signature) _typeIR
    (_typeIR) -> false

