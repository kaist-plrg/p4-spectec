  -- if simpleKeysetExpressionListIR matches [ _/1 ]
  -- let [simpleKeysetExpressionIR] = simpleKeysetExpressionListIR
  -- if simpleKeysetExpressionIR matches `% &&& %`
  -- let typedExpressionIR_base '&&&' typedExpressionIR_mask = simpleKeysetExpressionIR
  -- let expression_base = $lift_typedExpressionIR(typedExpressionIR_base)
  -- let expression_mask = $lift_typedExpressionIR(typedExpressionIR_mask)

  clause 1 : (`( simpleKeysetExpressionListIR `)) = `( expression_lb '..' expression_ub `)
  -- if simpleKeysetExpressionListIR matches [ _/1 ]
  -- let [simpleKeysetExpressionIR] = simpleKeysetExpressionListIR
  -- if simpleKeysetExpressionIR matches `% .. %`
  -- let typedExpressionIR_lb '..' typedExpressionIR_ub = simpleKeysetExpressionIR
  -- let expression_lb = $lift_typedExpressionIR(typedExpressionIR_lb)
  -- let expression_ub = $lift_typedExpressionIR(typedExpressionIR_ub)

  clause 2 : (tupleKeysetExpressionIR) = `( DEFAULT `)
  -- if (tupleKeysetExpressionIR = `( [DEFAULT] `))

  clause 3 : (tupleKeysetExpressionIR) = `( '_' `)
  -- if (tupleKeysetExpressionIR = `( ['_'] `))

  clause 4 : (`( simpleKeysetExpressionIR*{simpleKeysetExpressionIR <- simpleKeysetExpressionIR*} `)) = `( simpleKeysetExpression_h ',' simpleKeysetExpressionList_t `)
  -- if (|simpleKeysetExpressionIR*{simpleKeysetExpressionIR <- simpleKeysetExpressionIR*}| > 1)
  -- let simpleKeysetExpressionIR'*{simpleKeysetExpressionIR' <- simpleKeysetExpressionIR'*} = simpleKeysetExpressionIR*{simpleKeysetExpressionIR <- simpleKeysetExpressionIR*}
  -- if simpleKeysetExpressionIR'*{simpleKeysetExpressionIR' <- simpleKeysetExpressionIR'*} matches _ :: _
  -- let simpleKeysetExpressionIR_h :: simpleKeysetExpressionIR_t*{simpleKeysetExpressionIR_t <- simpleKeysetExpressionIR_t*} = simpleKeysetExpressionIR'*{simpleKeysetExpressionIR' <- simpleKeysetExpressionIR'*}
  -- let simpleKeysetExpression_h = $lift_simpleKeysetExpressionIR(simpleKeysetExpressionIR_h)
  -- let simpleKeysetExpressionList_t = $lift_simpleKeysetExpressionListIR(simpleKeysetExpressionIR_t*{simpleKeysetExpressionIR_t <- simpleKeysetExpressionIR_t*})

def $lift_keysetExpressionIR(keysetExpressionIR) : keysetExpression =

  clause 0 : (keysetExpressionIR) = $lift_simpleKeysetExpressionIR(simpleKeysetExpressionIR) as keysetExpression
  -- if keysetExpressionIR <: simpleKeysetExpressionIR
  -- let simpleKeysetExpressionIR = keysetExpressionIR as simpleKeysetExpressionIR

  clause 1 : (keysetExpressionIR) = $lift_tupleKeysetExpressionIR(tupleKeysetExpressionIR) as keysetExpression
  -- if keysetExpressionIR <: tupleKeysetExpressionIR
  -- let tupleKeysetExpressionIR = keysetExpressionIR as tupleKeysetExpressionIR

def $lift_typeArgumentIR_as_realTypeArgument(typeArgumentIR) : realTypeArgument =

  clause 0 : (typeIR) = VOID
  -- if typeIR <: voidTypeIR
  -- let voidTypeIR = typeIR as voidTypeIR
  -- if (voidTypeIR = VOID)

  clause -1 : (typeIR) = $lift_typeIR(typeIR) as realTypeArgument

def $unflatten_realTypeArgumentList(realTypeArgument*) : realTypeArgumentList =

  clause 0 : (realTypeArgument*{realTypeArgument <- realTypeArgument*}) = $unflatten_realTypeArgumentList'(realTypeArgument_h as realTypeArgumentList, realTypeArgument_t*{realTypeArgument_t <- realTypeArgument_t*})
  -- if realTypeArgument*{realTypeArgument <- realTypeArgument*} matches _ :: _
  -- let realTypeArgument_h :: realTypeArgument_t*{realTypeArgument_t <- realTypeArgument_t*} = realTypeArgument*{realTypeArgument <- realTypeArgument*}

def $unflatten_realTypeArgumentList'(realTypeArgumentList, realTypeArgument*) : realTypeArgumentList =

  clause 0 : (realTypeArgumentList, realTypeArgument*{realTypeArgument <- realTypeArgument*}) = realTypeArgumentList
  -- if realTypeArgument*{realTypeArgument <- realTypeArgument*} matches []

  clause 1 : (realTypeArgumentList, realTypeArgument*{realTypeArgument <- realTypeArgument*}) = $unflatten_realTypeArgumentList'(realTypeArgumentList ',' realTypeArgument_h, realTypeArgument_t*{realTypeArgument_t <- realTypeArgument_t*})
  -- if realTypeArgument*{realTypeArgument <- realTypeArgument*} matches _ :: _
  -- let realTypeArgument_h :: realTypeArgument_t*{realTypeArgument_t <- realTypeArgument_t*} = realTypeArgument*{realTypeArgument <- realTypeArgument*}

def $unflatten_typeArgumentList(typeArgument*) : typeArgumentList =

  clause 0 : (typeArgument*{typeArgument <- typeArgument*}) = _EMPTY
  -- if typeArgument*{typeArgument <- typeArgument*} matches []

  clause 1 : (typeArgument*{typeArgument <- typeArgument*}) = $unflatten_typeArgumentList'(typeArgument_h as typeArgumentList, typeArgument_t*{typeArgument_t <- typeArgument_t*})
  -- if typeArgument*{typeArgument <- typeArgument*} matches _ :: _
  -- let typeArgument_h :: typeArgument_t*{typeArgument_t <- typeArgument_t*} = typeArgument*{typeArgument <- typeArgument*}

def $unflatten_typeArgumentList'(typeArgumentList, typeArgument*) : typeArgumentList =

  clause 0 : (typeArgumentList, typeArgument*{typeArgument <- typeArgument*}) = typeArgumentList
  -- if typeArgument*{typeArgument <- typeArgument*} matches []

  clause 1 : (typeArgumentList, typeArgument*{typeArgument <- typeArgument*}) = $unflatten_typeArgumentList'(typeArgumentList ',' typeArgument_h, typeArgument_t*{typeArgument_t <- typeArgument_t*})
  -- if typeArgument*{typeArgument <- typeArgument*} matches _ :: _
  -- let typeArgument_h :: typeArgument_t*{typeArgument_t <- typeArgument_t*} = typeArgument*{typeArgument <- typeArgument*}

def $lift_argumentIR(argumentIR) : argument =

  clause 0 : (argumentIR) = expression as argument
  -- if argumentIR <: typedExpressionIR
  -- let typedExpressionIR = argumentIR as typedExpressionIR
  -- let expression = $lift_typedExpressionIR(typedExpressionIR)

  clause 1 : (argumentIR) = name '=' expression
  -- if argumentIR matches `% = %`
  -- let nameIR '=' typedExpressionIR = argumentIR
  -- let name = $lift_nameIR_as_nonTypeName(nameIR) as name
  -- let expression = $lift_typedExpressionIR(typedExpressionIR)

  clause 2 : (argumentIR) = name '=' '_'
  -- if argumentIR matches `% = _`
  -- let nameIR '=' '_' = argumentIR
  -- let name = $lift_nameIR_as_nonTypeName(nameIR) as name

  clause 3 : (argumentIR) = '_'
  -- if argumentIR matches `_`

def $unflatten_argumentList(argument*) : argumentList =

  clause 0 : (argument*{argument <- argument*}) = _EMPTY
  -- if argument*{argument <- argument*} matches []

  clause 1 : (argument*{argument <- argument*}) = $unflatten_argumentListNonEmpty(argument_h :: argument_t*{argument_t <- argument_t*}) as argumentList
  -- if argument*{argument <- argument*} matches _ :: _
  -- let argument_h :: argument_t*{argument_t <- argument_t*} = argument*{argument <- argument*}

def $unflatten_argumentListNonEmpty(argument*) : argumentListNonEmpty =

  clause 0 : (argument*{argument <- argument*}) = $unflatten_argumentListNonEmpty'(argument_h as argumentListNonEmpty, argument_t*{argument_t <- argument_t*})
  -- let argument'*{argument' <- argument'*} = argument*{argument <- argument*}
  -- if argument'*{argument' <- argument'*} matches _ :: _
  -- let argument_h :: argument_t*{argument_t <- argument_t*} = argument'*{argument' <- argument'*}

def $unflatten_argumentListNonEmpty'(argumentListNonEmpty, argument*) : argumentListNonEmpty =

  clause 0 : (argumentListNonEmpty, argument*{argument <- argument*}) = argumentListNonEmpty
  -- if argument*{argument <- argument*} matches []

  clause 1 : (argumentListNonEmpty, argument*{argument <- argument*}) = $unflatten_argumentListNonEmpty'(argumentListNonEmpty ',' argument_h, argument_t*{argument_t <- argument_t*})
  -- if argument*{argument <- argument*} matches _ :: _
  -- let argument_h :: argument_t*{argument_t <- argument_t*} = argument*{argument <- argument*}

def $lift_statementIR(statementIR) : statement =

  clause 0 : (statementIR) = $lift_emptyStatementIR(emptyStatementIR) as statement
  -- if statementIR <: emptyStatementIR
  -- let emptyStatementIR = statementIR as emptyStatementIR

  clause 1 : (statementIR) = $lift_assignmentStatementIR(assignmentStatementIR) as statement
  -- if statementIR <: assignmentStatementIR
  -- let assignmentStatementIR = statementIR as assignmentStatementIR

  clause 2 : (statementIR) = $lift_callStatementIR(callStatementIR) as statement
  -- if statementIR <: callStatementIR
  -- let callStatementIR = statementIR as callStatementIR

  clause 3 : (statementIR) = $lift_directApplicationStatementIR(directApplicationStatementIR) as statement
  -- if statementIR <: directApplicationStatementIR
  -- let directApplicationStatementIR = statementIR as directApplicationStatementIR

  clause 4 : (statementIR) = $lift_returnStatementIR(returnStatementIR) as statement
  -- if statementIR <: returnStatementIR
  -- let returnStatementIR = statementIR as returnStatementIR

  clause 5 : (statementIR) = $lift_exitStatementIR(exitStatementIR) as statement
  -- if statementIR <: exitStatementIR
  -- let exitStatementIR = statementIR as exitStatementIR

  clause 6 : (statementIR) = $lift_blockStatementIR(blockStatementIR) as statement
  -- if statementIR <: blockStatementIR
  -- let blockStatementIR = statementIR as blockStatementIR

  clause 7 : (statementIR) = $lift_conditionalStatementIR(conditionalStatementIR) as statement
  -- if statementIR <: conditionalStatementIR
  -- let conditionalStatementIR = statementIR as conditionalStatementIR

  clause 8 : (statementIR) = $lift_switchStatementIR(switchStatementIR) as statement
  -- if statementIR <: switchStatementIR
  -- let switchStatementIR = statementIR as switchStatementIR

  clause -1 : (statementIR) = $sink<statement>
  -- debug statementIR

def $lift_emptyStatementIR(emptyStatementIR) : emptyStatement =

  clause 0 : (emptyStatement) = ';'
  -- if (emptyStatement = ';')

def $lift_typedLvalueIR(typedLvalueIR) : lvalue =

  clause 0 : (lvalueIR '#' _lvalueNoteIR) = THIS as lvalue
  -- if (lvalueIR = _BARE "this" as lvalueIR)

  clause 1 : (lvalueIR '#' _lvalueNoteIR) = nonTypeName as lvalue
  -- if lvalueIR <: prefixedNameIR
  -- let prefixedNameIR = lvalueIR as prefixedNameIR
  -- if prefixedNameIR matches `_BARE %`
  -- let _BARE nameIR = prefixedNameIR
  -- if (nameIR =/= "this")
  -- let nonTypeName = $lift_nameIR_as_nonTypeName(nameIR)

  clause 2 : (lvalueIR '#' _lvalueNoteIR) = _ID '.' nonTypeName as lvalue
  -- if lvalueIR <: prefixedNameIR
  -- let prefixedNameIR = lvalueIR as prefixedNameIR
  -- if prefixedNameIR matches `. %`
  -- let '.' nameIR = prefixedNameIR
  -- let nonTypeName = $lift_nameIR_as_nonTypeName(nameIR)

  clause 3 : (lvalueIR '#' _lvalueNoteIR) = lvalue '.' member
  -- if lvalueIR matches `% . %`
  -- let typedLvalueIR '.' nameIR = lvalueIR
  -- let lvalue = $lift_typedLvalueIR(typedLvalueIR)
  -- let member = $lift_nameIR_as_member(nameIR)

  clause 4 : (lvalueIR '#' _lvalueNoteIR) = lvalue `[ expression `]
  -- if lvalueIR matches `% [%]`
  -- let typedLvalueIR `[ typedExpressionIR `] = lvalueIR
  -- let lvalue = $lift_typedLvalueIR(typedLvalueIR)
  -- let expression = $lift_typedExpressionIR(typedExpressionIR)

  clause 5 : (lvalueIR '#' _lvalueNoteIR) = lvalue `[ expression_hi ':' expression_lo `]
  -- if lvalueIR matches `% [% % %]`
  -- let typedLvalueIR `[ typedExpressionIR_hi sliceop typedExpressionIR_lo `] = lvalueIR
  -- if sliceop matches `:`
  -- let lvalue = $lift_typedLvalueIR(typedLvalueIR)
  -- let expression_hi = $lift_typedExpressionIR(typedExpressionIR_hi)
  -- let expression_lo = $lift_typedExpressionIR(typedExpressionIR_lo)

  clause 6 : (lvalueIR '#' _lvalueNoteIR) = `( lvalue `)
  -- if lvalueIR matches `(%)`
  -- let `( typedLvalueIR `) = lvalueIR
  -- let lvalue = $lift_typedLvalueIR(typedLvalueIR)

def $lift_assignmentStatementIR(assignmentStatementIR) : assignmentStatement =

  clause 0 : (typedLvalueIR assignop typedExpressionIR ';') = lvalue assignop expression ';'
  -- let lvalue = $lift_typedLvalueIR(typedLvalueIR)
  -- let expression = $lift_typedExpressionIR(typedExpressionIR)

def $lift_callableTargetIR_as_lvalue(callableTargetIR) : lvalue =

  clause 0 : (callableTargetIR) = THIS as lvalue
  -- if (callableTargetIR = _BARE "this" as callableTargetIR)

  clause 1 : (callableTargetIR) = nonTypeName as lvalue
  -- if callableTargetIR <: prefixedNameIR
  -- let prefixedNameIR = callableTargetIR as prefixedNameIR
  -- if prefixedNameIR matches `_BARE %`
  -- let _BARE nameIR = prefixedNameIR
  -- if (nameIR =/= "this")
  -- let nonTypeName = $lift_nameIR_as_nonTypeName(nameIR)

  clause 2 : (callableTargetIR) = _ID '.' nonTypeName as lvalue
  -- if callableTargetIR <: prefixedNameIR
  -- let prefixedNameIR = callableTargetIR as prefixedNameIR
  -- if prefixedNameIR matches `. %`
  -- let '.' nameIR = prefixedNameIR
  -- let nonTypeName = $lift_nameIR_as_nonTypeName(nameIR)

  clause 3 : (callableTargetIR) = lvalue '.' member
  -- if callableTargetIR matches `% . %`
  -- let typedExpressionIR '.' nameIR = callableTargetIR
  -- let typedLvalueIR'?{typedLvalueIR' <- typedLvalueIR'?} = $typedExpressionIR_as_typedLvalueIR(typedExpressionIR)
  -- if typedLvalueIR'?{typedLvalueIR' <- typedLvalueIR'?} matches (_)
  -- let ?(typedLvalueIR) = typedLvalueIR'?{typedLvalueIR' <- typedLvalueIR'?}
  -- let lvalue = $lift_typedLvalueIR(typedLvalueIR)
  -- let member = $lift_nameIR_as_member(nameIR)

  clause 4 : (callableTargetIR) = THIS as lvalue '.' member
  -- if callableTargetIR matches `TYPE % . %`
  -- let TYPE prefixedNameIR '.' nameIR = callableTargetIR
  -- if (prefixedNameIR = _BARE "this")
  -- let member = $lift_nameIR_as_member(nameIR)

  clause 5 : (callableTargetIR) = nonTypeName as lvalue '.' member
  -- if callableTargetIR matches `TYPE % . %`
  -- let TYPE prefixedNameIR '.' nameIR_field = callableTargetIR
  -- if prefixedNameIR matches `_BARE %`
  -- let _BARE nameIR = prefixedNameIR
  -- if (nameIR =/= "this")
  -- let nonTypeName = $lift_nameIR_as_nonTypeName(nameIR)
  -- let member = $lift_nameIR_as_member(nameIR_field)

  clause 6 : (callableTargetIR) = _ID '.' nonTypeName as lvalue '.' member
  -- if callableTargetIR matches `TYPE % . %`
  -- let TYPE prefixedNameIR '.' nameIR_field = callableTargetIR
  -- if prefixedNameIR matches `. %`
  -- let '.' nameIR = prefixedNameIR
  -- let nonTypeName = $lift_nameIR_as_nonTypeName(nameIR)
  -- let member = $lift_nameIR_as_member(nameIR_field)

  clause 7 : (callableTargetIR') = `( lvalue `)
  -- if callableTargetIR' matches `(%)`
  -- let `( callableTargetIR `) = callableTargetIR'
  -- let lvalue = $lift_callableTargetIR_as_lvalue(callableTargetIR)

def $lift_callStatementIR(callStatementIR) : callStatement =

  clause 0 : (callableTargetIR `< typeArgumentIR*{typeArgumentIR <- typeArgumentIR*} `> `( argumentIR*{argumentIR <- argumentIR*} `) ';') = lvalue `( argumentList `) ';'
  -- if typeArgumentIR*{typeArgumentIR <- typeArgumentIR*} matches []
  -- let lvalue = $lift_callableTargetIR_as_lvalue(callableTargetIR)
  -- let argumentList = $lift_argumentListIR(argumentIR*{argumentIR <- argumentIR*})

  clause 1 : (callableTargetIR `< typeArgumentIR*{typeArgumentIR <- typeArgumentIR*} `> `( argumentIR*{argumentIR <- argumentIR*} `) ';') = lvalue `< typeArgumentList `> `( argumentList `) ';'
  -- let lvalue = $lift_callableTargetIR_as_lvalue(callableTargetIR)
  -- let typeArgumentList = $lift_typeArgumentListIR(typeArgumentIR*{typeArgumentIR <- typeArgumentIR*})
  -- let argumentList = $lift_argumentListIR(argumentIR*{argumentIR <- argumentIR*})

def $lift_directApplicationStatementIR(directApplicationStatementIR) : directApplicationStatement =

  clause 0 : (constructorTargetIR '.' APPLY `( argumentIR*{argumentIR <- argumentIR*} `) ';') = prefixedTypeName as namedType '.' APPLY `( argumentList `) ';'
  -- let prefixedNameIR `< typeArgumentIR*{typeArgumentIR <- typeArgumentIR*} `> = constructorTargetIR
  -- if typeArgumentIR*{typeArgumentIR <- typeArgumentIR*} matches []
  -- let prefixedTypeName = $lift_prefixedNameIR_as_prefixedTypeName(prefixedNameIR)
  -- let argumentList = $lift_argumentListIR(argumentIR*{argumentIR <- argumentIR*})

  clause 1 : (constructorTargetIR '.' APPLY `( argumentIR*{argumentIR <- argumentIR*} `) ';') = namedType '.' APPLY `( argumentList `) ';'
  -- let prefixedNameIR `< typeArgumentIR*{typeArgumentIR <- typeArgumentIR*} `> = constructorTargetIR
  -- if (|typeArgumentIR*{typeArgumentIR <- typeArgumentIR*}| > 0)
  -- let prefixedTypeName = $lift_prefixedNameIR_as_prefixedTypeName(prefixedNameIR)
  -- let typeArgumentList = $lift_typeArgumentListIR(typeArgumentIR*{typeArgumentIR <- typeArgumentIR*})
  -- let namedType = prefixedTypeName `< typeArgumentList `> as namedType
  -- let argumentList = $lift_argumentListIR(argumentIR*{argumentIR <- argumentIR*})

def $lift_returnStatementIR(returnStatementIR) : returnStatement =

  clause 0 : (returnStatementIR) = RETURN ';'
  -- if returnStatementIR matches `RETURN ;`

  clause 1 : (returnStatementIR) = RETURN expression ';'
  -- if returnStatementIR matches `RETURN % ;`
  -- let RETURN typedExpressionIR ';' = returnStatementIR
  -- let expression = $lift_typedExpressionIR(typedExpressionIR)

def $lift_exitStatementIR(exitStatementIR) : exitStatement =

  clause 0 : (exitStatement) = EXIT ';'
  -- if (exitStatement = EXIT ';')

def $lift_constantDeclarationIR(constantDeclarationIR) : constantDeclaration =

  clause 0 : (constantDeclarationIR) = annotationList CONST type name initializer ';'
  -- let annotationList CONST typeIR nameIR constantInitializerIR ';' = constantDeclarationIR
  -- let type = $lift_typeIR(typeIR)
  -- let name = $lift_nameIR_as_nonTypeName(nameIR) as name
  -- let initializer = $lift_constantInitializerIR_as_initializer(constantInitializerIR)

def $lift_variableDeclarationIR(variableDeclarationIR) : variableDeclaration =

  clause 0 : (annotationList typeIR nameIR initializerIR?{initializerIR <- initializerIR?} ';') = annotationList type name initializerOpt ';'
  -- let type = $lift_typeIR(typeIR)
  -- let name = $lift_nameIR_as_nonTypeName(nameIR) as name
  -- let initializerOpt = $lift_initializerOptIR(initializerIR?{initializerIR <- initializerIR?})

def $lift_blockElementStatementIR(blockElementStatementIR) : blockElementStatement =

  clause 0 : (blockElementStatementIR) = $lift_constantDeclarationIR(constantDeclarationIR) as blockElementStatement
  -- if blockElementStatementIR <: constantDeclarationIR
  -- let constantDeclarationIR = blockElementStatementIR as constantDeclarationIR

  clause 1 : (blockElementStatementIR) = $lift_variableDeclarationIR(variableDeclarationIR) as blockElementStatement
  -- if blockElementStatementIR <: variableDeclarationIR
  -- let variableDeclarationIR = blockElementStatementIR as variableDeclarationIR

  clause 2 : (blockElementStatementIR) = $lift_statementIR(statementIR) as blockElementStatement
  -- if blockElementStatementIR <: statementIR
  -- let statementIR = blockElementStatementIR as statementIR

def $lift_blockElementStatementListIR(blockElementStatementIR*) : blockElementStatementList =

  clause 0 : (blockElementStatementIR*{blockElementStatementIR <- blockElementStatementIR*}) = blockElementStatementList
  -- (let blockElementStatement = $lift_blockElementStatementIR(blockElementStatementIR))*{blockElementStatementIR <- blockElementStatementIR*, blockElementStatement -> blockElementStatement*}
  -- let blockElementStatementList = $unflatten_blockElementStatementList(blockElementStatement*{blockElementStatement <- blockElementStatement*})

def $unflatten_blockElementStatementList(blockElementStatement*) : blockElementStatementList =

  clause 0 : (blockElementStatement*{blockElementStatement <- blockElementStatement*}) = $unflatten_blockElementStatementList'(_EMPTY, blockElementStatement*{blockElementStatement <- blockElementStatement*})

def $unflatten_blockElementStatementList'(blockElementStatementList, blockElementStatement*) : blockElementStatementList =

  clause 0 : (blockElementStatementList, blockElementStatement*{blockElementStatement <- blockElementStatement*}) = blockElementStatementList
  -- if blockElementStatement*{blockElementStatement <- blockElementStatement*} matches []

  clause 1 : (blockElementStatementList, blockElementStatement*{blockElementStatement <- blockElementStatement*}) = $unflatten_blockElementStatementList'(blockElementStatementList blockElementStatement_h, blockElementStatement_t*{blockElementStatement_t <- blockElementStatement_t*})
  -- if blockElementStatement*{blockElementStatement <- blockElementStatement*} matches _ :: _
  -- let blockElementStatement_h :: blockElementStatement_t*{blockElementStatement_t <- blockElementStatement_t*} = blockElementStatement*{blockElementStatement <- blockElementStatement*}

def $lift_blockStatementIR(blockStatementIR) : blockStatement =

  clause 0 : (annotationList `{ blockElementStatementIR*{blockElementStatementIR <- blockElementStatementIR*} `}) = annotationList `{ blockElementStatementList `}
  -- (let blockElementStatement = $lift_blockElementStatementIR(blockElementStatementIR))*{blockElementStatementIR <- blockElementStatementIR*, blockElementStatement -> blockElementStatement*}
  -- let blockElementStatementList = $unflatten_blockElementStatementList(blockElementStatement*{blockElementStatement <- blockElementStatement*})

def $lift_conditionalStatementIR(conditionalStatementIR) : conditionalStatement =

  clause 0 : (conditionalStatementIR) = IF `( expression_cond `) statement_then
  -- if conditionalStatementIR matches `IF (%) %`
  -- let IF `( typedExpressionIR_cond `) statementIR_then = conditionalStatementIR
  -- let expression_cond = $lift_typedExpressionIR(typedExpressionIR_cond)
