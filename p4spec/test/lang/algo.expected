  clause 2 : (prefixedNameIR) = _ID '.' nonTypeName as referenceExpression
  -- if prefixedNameIR matches `. %`
  -- let '.' nameIR = prefixedNameIR
  -- let nonTypeName = $lift_nameIR_as_nonTypeName(nameIR)

def $lift_defaultExpressionIR(defaultExpressionIR) : defaultExpression =

  clause 0 : (defaultExpression) = '...'
