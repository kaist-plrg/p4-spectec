def $callableId_of_externMethodPrototype(externMethodPrototype) : callableId =

  clause 0 : (externMethodPrototype) = $callableId(name, parameterList)
  -- if externMethodPrototype matches `% % ;`
  -- let _annotationList _typeOrVoid name _typeParameterListOpt `( parameterList `) ';' = externMethodPrototype

