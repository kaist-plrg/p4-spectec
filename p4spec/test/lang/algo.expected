def $find_callableDef_overloaded_t(cursor, typingContext, prefixedNameIR, argumentIR*) : callResolution<callableTypeDefIR>? =

  clause 0 : (p, TC, prefixedNameIR, argumentIR*{argumentIR <- argumentIR*}) = $find_overloaded<callableTypeDefIR>(callableTypeDefEnv, callTargetKey, $parameterListIR_of_callableTypeDefIR)
