  -- let stateEnv = $add_map<nameIR, parserStateIR>(IC.BLOCK.STATE, nameIR, parserStateIR)

def $add_type_i(cursor, instContext, typeId, typeIR) : instContext =

  clause 0 : (p, IC, typeId, typeIR) = IC[BLOCK.TYPE = theta]
  -- if p matches `BLOCK`
