def $find_var_i(prefixedNameIR, cursor, instContext) : value =

  clause 0 : (prefixedNameIR, p, IC) = value
  -- if prefixedNameIR matches `. %`
  -- let '.' id = prefixedNameIR
  -- let value'?{value' <- value'?} = $find_map<id, value>(IC.GLOBAL.FRAME, id)
