    -- let TYPEDEF _typeId typeIR_b = typeIR'' as typedefTypeIR
    -- if ~typeIR_a <: typedefTypeIR
    -- if Type_alpha: typeIR_a ~~ typeIR_b holds
    -- the relation holds

  rulegroup newTypeIR

   match

    (signature) TYPE typeId typeIR_a as typeIR ~~ TYPE typeId typeIR_b as typeIR
    typeIR ~~ typeIR'
    -- if typeIR <: newTypeIR
    -- let TYPE typeId typeIR_a = typeIR as newTypeIR
    -- if typeIR' <: newTypeIR
    -- let TYPE typeId' typeIR_b = typeIR' as newTypeIR
    -- if (typeId = typeId')

   paths

    rulepath newTypeIR
    -- if Type_alpha: typeIR_a ~~ typeIR_b holds
    -- the relation holds

  rulegroup listTypeIR

   match

    (signature) LIST `< typeIR_a `> as typeIR ~~ LIST `< typeIR_b `> as typeIR
    typeIR ~~ typeIR'
    -- if typeIR <: listTypeIR
    -- let LIST `< typeIR_a `> = typeIR as listTypeIR
    -- if typeIR' <: listTypeIR
    -- let LIST `< typeIR_b `> = typeIR' as listTypeIR

