def $bin_eq(value, value) : bool =

  clause 0 : (value, value') = (b_a = b_b)
  -- if value <: boolValue
  -- let _B b_a = value as boolValue
  -- if value' <: boolValue
  -- let _B b_b = value' as boolValue

  clause 1 : (value, value') = (id_a = id_b)
  -- if value <: errorValue
  -- let ERROR '.' id_a = value as errorValue
  -- if value' <: errorValue
  -- let ERROR '.' id_b = value' as errorValue

  clause 2 : (value, value') = (id_a = id_b)
  -- if value <: matchKindValue
  -- let MATCH_KIND '.' id_a = value as matchKindValue
  -- if value' <: matchKindValue
  -- let MATCH_KIND '.' id_b = value' as matchKindValue

  clause 3 : (value, value') = (stringValue_a = stringValue_b)
  -- if value <: stringValue
  -- let stringValue_a = value as stringValue
  -- if value' <: stringValue
  -- let stringValue_b = value' as stringValue

  clause 4 : (value, value') = (i_a = i_b)
  -- if value <: integerLiteral
  -- let integerLiteral = value as integerLiteral
  -- if integerLiteral matches `D %`
  -- let D i_a = integerLiteral
  -- if value' <: integerLiteral
  -- let integerLiteral' = value' as integerLiteral
  -- if integerLiteral' matches `D %`
  -- let D i_b = integerLiteral'

  clause 5 : (value, value') = ((w_a = w_b) /\ (i_a = i_b))
  -- if value <: integerLiteral
  -- let integerLiteral = value as integerLiteral
  -- if integerLiteral matches `% W %`
  -- let w_a W i_a = integerLiteral
  -- if value' <: integerLiteral
  -- let integerLiteral' = value' as integerLiteral
  -- if integerLiteral' matches `% W %`
  -- let w_b W i_b = integerLiteral'

  clause 6 : (value, value') = ((w_a = w_b) /\ (i_a = i_b))
  -- if value <: integerLiteral
  -- let integerLiteral = value as integerLiteral
  -- if integerLiteral matches `% S %`
  -- let w_a S i_a = integerLiteral
  -- if value' <: integerLiteral
  -- let integerLiteral' = value' as integerLiteral
  -- if integerLiteral' matches `% S %`
  -- let w_b S i_b = integerLiteral'

  clause 7 : (value, value') = ((w_max_a = w_max_b) /\ (i_a = i_b))
  -- if value <: integerValue
  -- let integerValue = value as integerValue
  -- if integerValue matches `% . % V %`
  -- let w_max_a '.' _nat V i_a = integerValue
  -- if value' <: integerValue
  -- let integerValue' = value' as integerValue
  -- if integerValue' matches `% . % V %`
  -- let w_max_b '.' _nat' V i_b = integerValue'

  clause 8 : (value, value') = ((|value_a*{value_a <- value_a*}| = |value_b*{value_b <- value_b*}|) /\ $forall_($bin_eq(value_a, value_b)*{value_a <- value_a*, value_b <- value_b*}))
  -- if value <: listValue
  -- let LIST `[ value_a*{value_a <- value_a*} `] = value as listValue
  -- if value' <: listValue
  -- let LIST `[ value_b*{value_b <- value_b*} `] = value' as listValue
  -- if (|value_a*{value_a <- value_a*}| = |value_b*{value_b <- value_b*}|)

  clause 9 : (value, value') = ((|value_a*{value_a <- value_a*}| = |value_b*{value_b <- value_b*}|) /\ $forall_($bin_eq(value_a, value_b)*{value_a <- value_a*, value_b <- value_b*}))
  -- if value <: tupleValue
  -- let TUPLE `( value_a*{value_a <- value_a*} `) = value as tupleValue
  -- if value' <: tupleValue
  -- let TUPLE `( value_b*{value_b <- value_b*} `) = value' as tupleValue
  -- if (|value_a*{value_a <- value_a*}| = |value_b*{value_b <- value_b*}|)

  clause 10 : (value, value') = ((|value_a*{value_a <- value_a*}| = |value_b*{value_b <- value_b*}|) /\ $forall_($bin_eq(value_a, value_b)*{value_a <- value_a*, value_b <- value_b*}))
  -- if value <: arrayValue
  -- let ARRAY `[ value_a*{value_a <- value_a*} `] = value as arrayValue
  -- if value' <: arrayValue
  -- let ARRAY `[ value_b*{value_b <- value_b*} `] = value' as arrayValue
  -- if (|value_a*{value_a <- value_a*}| = |value_b*{value_b <- value_b*}|)

  clause 11 : (value, value') = ((|value_a*{value_a <- value_a*}| = |value_b*{value_b <- value_b*}|) /\ $forall_($bin_eq(value_a, value_b)*{value_a <- value_a*, value_b <- value_b*}))
  -- if value <: headerStackValue
  -- let HEADER_STACK `[ value_a*{value_a <- value_a*} `( _nat `) `] = value as headerStackValue
  -- if value' <: headerStackValue
  -- let HEADER_STACK `[ value_b*{value_b <- value_b*} `( _nat' `) `] = value' as headerStackValue
  -- if (|value_a*{value_a <- value_a*}| = |value_b*{value_b <- value_b*}|)

  clause 12 : (value, value') = ((((typeId_a = typeId_b) /\ (|fieldValue_a*{fieldValue_a <- fieldValue_a*}| = |fieldValue_b*{fieldValue_b <- fieldValue_b*}|)) /\ $forall_($bin_eq(value_field_a, value_field_b)*{value_field_a <- value_field_a*, value_field_b <- value_field_b*})) /\ $forall_((nameIR_field_a = nameIR_field_b)*{nameIR_field_a <- nameIR_field_a*, nameIR_field_b <- nameIR_field_b*}))
  -- if value <: structValue
  -- let STRUCT typeId_a `{ fieldValue_a*{fieldValue_a <- fieldValue_a*} `} = value as structValue
  -- if value' <: structValue
  -- let STRUCT typeId_b `{ fieldValue_b*{fieldValue_b <- fieldValue_b*} `} = value' as structValue
  -- (let value_field_a nameIR_field_a ';' = fieldValue_a)*{fieldValue_a <- fieldValue_a*, nameIR_field_a -> nameIR_field_a*, value_field_a -> value_field_a*}
  -- (let value_field_b nameIR_field_b ';' = fieldValue_b)*{fieldValue_b <- fieldValue_b*, nameIR_field_b -> nameIR_field_b*, value_field_b -> value_field_b*}
  -- if (|value_field_a*{value_field_a <- value_field_a*}| = |value_field_b*{value_field_b <- value_field_b*}|)
  -- if (|nameIR_field_a*{nameIR_field_a <- nameIR_field_a*}| = |nameIR_field_b*{nameIR_field_b <- nameIR_field_b*}|)

  clause 13 : (value, value') = ((((typeId_a = typeId_b) /\ (|fieldValue_a*{fieldValue_a <- fieldValue_a*}| = |fieldValue_b*{fieldValue_b <- fieldValue_b*}|)) /\ $forall_($bin_eq(value_field_a, value_field_b)*{value_field_a <- value_field_a*, value_field_b <- value_field_b*})) /\ $forall_((nameIR_field_a = nameIR_field_b)*{nameIR_field_a <- nameIR_field_a*, nameIR_field_b <- nameIR_field_b*}))
  -- if value <: headerValue
  -- let HEADER typeId_a `{ _b ';' fieldValue_a*{fieldValue_a <- fieldValue_a*} `} = value as headerValue
  -- if value' <: headerValue
  -- let HEADER typeId_b `{ _b' ';' fieldValue_b*{fieldValue_b <- fieldValue_b*} `} = value' as headerValue
  -- (let value_field_a nameIR_field_a ';' = fieldValue_a)*{fieldValue_a <- fieldValue_a*, nameIR_field_a -> nameIR_field_a*, value_field_a -> value_field_a*}
  -- (let value_field_b nameIR_field_b ';' = fieldValue_b)*{fieldValue_b <- fieldValue_b*, nameIR_field_b -> nameIR_field_b*, value_field_b -> value_field_b*}
  -- if (|value_field_a*{value_field_a <- value_field_a*}| = |value_field_b*{value_field_b <- value_field_b*}|)
  -- if (|nameIR_field_a*{nameIR_field_a <- nameIR_field_a*}| = |nameIR_field_b*{nameIR_field_b <- nameIR_field_b*}|)

  clause 14 : (value, value') = ((((typeId_a = typeId_b) /\ (|fieldValue_a*{fieldValue_a <- fieldValue_a*}| = |fieldValue_b*{fieldValue_b <- fieldValue_b*}|)) /\ $forall_($bin_eq(value_field_a, value_field_b)*{value_field_a <- value_field_a*, value_field_b <- value_field_b*})) /\ $forall_((nameIR_field_a = nameIR_field_b)*{nameIR_field_a <- nameIR_field_a*, nameIR_field_b <- nameIR_field_b*}))
  -- if value <: headerUnionValue
  -- let HEADER_UNION typeId_a `{ fieldValue_a*{fieldValue_a <- fieldValue_a*} `} = value as headerUnionValue
  -- if value' <: headerUnionValue
  -- let HEADER_UNION typeId_b `{ fieldValue_b*{fieldValue_b <- fieldValue_b*} `} = value' as headerUnionValue
  -- (let value_field_a nameIR_field_a ';' = fieldValue_a)*{fieldValue_a <- fieldValue_a*, nameIR_field_a -> nameIR_field_a*, value_field_a -> value_field_a*}
  -- (let value_field_b nameIR_field_b ';' = fieldValue_b)*{fieldValue_b <- fieldValue_b*, nameIR_field_b -> nameIR_field_b*, value_field_b -> value_field_b*}
  -- if (|value_field_a*{value_field_a <- value_field_a*}| = |value_field_b*{value_field_b <- value_field_b*}|)
  -- if (|nameIR_field_a*{nameIR_field_a <- nameIR_field_a*}| = |nameIR_field_b*{nameIR_field_b <- nameIR_field_b*}|)

  clause 15 : (value, value') = ((typeId_a = typeId_b) /\ (nameIR_field_a = nameIR_field_b))
  -- if value <: enumValue
  -- let enumValue = value as enumValue
  -- if enumValue matches `% . %`
  -- let typeId_a '.' nameIR_field_a = enumValue
  -- if value' <: enumValue
  -- let enumValue' = value' as enumValue
  -- if enumValue' matches `% . %`
  -- let typeId_b '.' nameIR_field_b = enumValue'

  clause 16 : (value, value') = ((typeId_a = typeId_b) /\ $bin_eq(value_field_a, value_field_b))
  -- if value <: enumValue
  -- let enumValue = value as enumValue
  -- if enumValue matches `% . % . %`
  -- let typeId_a '.' _nameIR '.' value_field_a = enumValue
  -- if value' <: enumValue
  -- let enumValue' = value' as enumValue
  -- if enumValue' matches `% . % . %`
  -- let typeId_b '.' _nameIR' '.' value_field_b = enumValue'

  clause 17 : (value, value') = true
  -- if value <: invalidHeaderValue
  -- let invalidHeaderValue = value as invalidHeaderValue
  -- if (invalidHeaderValue = '{#}')
  -- if value' <: invalidHeaderValue
  -- let invalidHeaderValue' = value' as invalidHeaderValue
  -- if (invalidHeaderValue' = '{#}')

def $bin_ne(value, value) : bool =

  clause 0 : (value_l, value_r) = ~$bin_eq(value_l, value_r)

