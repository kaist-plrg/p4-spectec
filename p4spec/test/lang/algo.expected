def $lift_referenceExpressionIR(referenceExpressionIR) : referenceExpression =

  clause 0 : (prefixedNameIR) = THIS
  -- if prefixedNameIR matches `_BARE %`
  -- let _BARE nameIR = prefixedNameIR
