  -- let TYPE typeId _typeIR = aliasTypeIR as newTypeIR
  -- let typeName = $lift_nameIR_as_typeName(typeId)

def $lift_typeArgumentIR(typeArgumentIR) : typeArgument =

  clause 0 : (typeIR) = $lift_typeArgumentIR_as_realTypeArgument(typeIR) as typeArgument

def $lift_dataTypeIR(dataTypeIR) : type =

  clause 0 : (dataTypeIR) = LIST `< typeArgument `> as type
  -- if dataTypeIR <: listTypeIR
  -- let LIST `< typeIR `> = dataTypeIR as listTypeIR
  -- let typeArgument = $lift_typeArgumentIR(typeIR)

  clause 1 : (dataTypeIR) = TUPLE `< typeArgumentList `> as type
  -- if dataTypeIR <: tupleTypeIR
  -- let TUPLE `< typeIR*{typeIR <- typeIR*} `> = dataTypeIR as tupleTypeIR
  -- let typeArgumentList = $lift_typeArgumentListIR(typeIR*{typeIR <- typeIR*})

  clause 2 : (dataTypeIR) = type `[ D n as int as expression `] as type
  -- if dataTypeIR <: arrayTypeIR
  -- let ARRAY typeIR `[ n `] = dataTypeIR as arrayTypeIR
  -- let type = $lift_typeIR(typeIR)

  clause 3 : (dataTypeIR) = type `[ D n as int as expression `] as type
  -- if dataTypeIR <: headerStackTypeIR
  -- let HEADER_STACK typeIR `[ n `] = dataTypeIR as headerStackTypeIR
  -- let type = $lift_typeIR(typeIR)

  clause 4 : (dataTypeIR) = typeName as type
  -- if dataTypeIR <: simpleEnumTypeIR
  -- let ENUM typeId `{ _nameIR*{_nameIR <- _nameIR*} `} = dataTypeIR as simpleEnumTypeIR
  -- let typeName = $lift_nameIR_as_typeName(typeId)

  clause 5 : (dataTypeIR) = typeName as prefixedTypeName `< typeArgument as typeArgumentList `> as type
  -- if dataTypeIR <: serializableEnumTypeIR
  -- let ENUM typeId `< typeIR `> `{ _valueFieldIR*{_valueFieldIR <- _valueFieldIR*} `} = dataTypeIR as serializableEnumTypeIR
  -- let typeName = $lift_nameIR_as_typeName(typeId)
  -- let typeArgument = $lift_typeArgumentIR(typeIR)

