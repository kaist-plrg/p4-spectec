def $chain_casts(typeIR*, typeIR**) : typeIR** =

  clause 0 : (typeIR_cur*{typeIR_cur <- typeIR_cur*}, typeIR_chain*{typeIR_chain <- typeIR_chain*}*{typeIR_chain* <- typeIR_chain**}) = []
  -- if ([] = $concat_<typeIR>(typeIR_chain*{typeIR_chain <- typeIR_chain*}*{typeIR_chain* <- typeIR_chain**}))

  clause 1 : (typeIR_cur*{typeIR_cur <- typeIR_cur*}, typeIR_chain*{typeIR_chain <- typeIR_chain*}*{typeIR_chain* <- typeIR_chain**}) = typeIR_next*{typeIR_next <- typeIR_next*} :: $chain_casts(typeIR_next*{typeIR_next <- typeIR_next*}, typeIR_chain_rest*{typeIR_chain_rest <- typeIR_chain_rest*}*{typeIR_chain_rest* <- typeIR_chain_rest**})
  -- if ([] =/= $concat_<typeIR>(typeIR_chain*{typeIR_chain <- typeIR_chain*}*{typeIR_chain* <- typeIR_chain**}))
  -- if (|typeIR_chain*{typeIR_chain <- typeIR_chain*}*{typeIR_chain* <- typeIR_chain**}| = |typeIR_cur*{typeIR_cur <- typeIR_cur*}|)
  -- (let (typeIR_next, typeIR_chain_rest*{typeIR_chain_rest <- typeIR_chain_rest*}) = $chain_casts'(typeIR_cur, typeIR_chain*{typeIR_chain <- typeIR_chain*}))*{typeIR_chain* <- typeIR_chain**, typeIR_cur <- typeIR_cur*, typeIR_chain_rest* -> typeIR_chain_rest**, typeIR_next -> typeIR_next*}

def $chain_casts'(typeIR, typeIR*) : (typeIR, typeIR*) =

  clause 0 : (typeIR_cur, typeIR*{typeIR <- typeIR*}) = (typeIR_cur, [])
  -- if typeIR*{typeIR <- typeIR*} matches []

  clause 1 : (typeIR_cur, typeIR*{typeIR <- typeIR*}) = (typeIR_h, typeIR_t*{typeIR_t <- typeIR_t*})
  -- if typeIR*{typeIR <- typeIR*} matches _ :: _
  -- let typeIR_h :: typeIR_t*{typeIR_t <- typeIR_t*} = typeIR*{typeIR <- typeIR*}

def $chain_casts_sequenceTypeIR(typeIR*, typeIR**, typeIR) : typeIR* =

  clause 0 : (typeIR_a*{typeIR_a <- typeIR_a*}, typeIR_cast_elem*{typeIR_cast_elem <- typeIR_cast_elem*}*{typeIR_cast_elem* <- typeIR_cast_elem**}, typeIR_b) = typeIR_cast_agg*{typeIR_cast_agg <- typeIR_cast_agg*} ++ [typeIR_b]
  -- let typeIR_cast_step*{typeIR_cast_step <- typeIR_cast_step*}*{typeIR_cast_step* <- typeIR_cast_step**} = $chain_casts(typeIR_a*{typeIR_a <- typeIR_a*}, typeIR_cast_elem*{typeIR_cast_elem <- typeIR_cast_elem*}*{typeIR_cast_elem* <- typeIR_cast_elem**})
  -- (let typeIR_cast_agg = SEQ `< typeIR_cast_step*{typeIR_cast_step <- typeIR_cast_step*} `> as typeIR)*{typeIR_cast_step* <- typeIR_cast_step**, typeIR_cast_agg -> typeIR_cast_agg*}

def $chain_casts_sequenceTypeIR_default(typeIR*, typeIR**, typeIR) : typeIR* =

  clause 0 : (typeIR_a*{typeIR_a <- typeIR_a*}, typeIR_cast_elem*{typeIR_cast_elem <- typeIR_cast_elem*}*{typeIR_cast_elem* <- typeIR_cast_elem**}, typeIR_b) = typeIR_cast_agg*{typeIR_cast_agg <- typeIR_cast_agg*} ++ [typeIR_b]
  -- let typeIR_cast_step*{typeIR_cast_step <- typeIR_cast_step*}*{typeIR_cast_step* <- typeIR_cast_step**} = $chain_casts(typeIR_a*{typeIR_a <- typeIR_a*}, typeIR_cast_elem*{typeIR_cast_elem <- typeIR_cast_elem*}*{typeIR_cast_elem* <- typeIR_cast_elem**})
  -- (let typeIR_cast_agg = SEQ `< typeIR_cast_step*{typeIR_cast_step <- typeIR_cast_step*} ',' '...' `> as typeIR)*{typeIR_cast_step* <- typeIR_cast_step**, typeIR_cast_agg -> typeIR_cast_agg*}

def $chain_casts_recordTypeIR(fieldTypeIR*, typeIR**, typeIR) : typeIR* =

  clause 0 : (annotationList_a typeIR_a id_a ';'*{annotationList_a <- annotationList_a*, id_a <- id_a*, typeIR_a <- typeIR_a*}, typeIR_cast_elem*{typeIR_cast_elem <- typeIR_cast_elem*}*{typeIR_cast_elem* <- typeIR_cast_elem**}, typeIR_b) = typeIR_cast_agg*{typeIR_cast_agg <- typeIR_cast_agg*} ++ [typeIR_b]
  -- let typeIR_cast_step*{typeIR_cast_step <- typeIR_cast_step*}*{typeIR_cast_step* <- typeIR_cast_step**} = $chain_casts(typeIR_a*{typeIR_a <- typeIR_a*}, typeIR_cast_elem*{typeIR_cast_elem <- typeIR_cast_elem*}*{typeIR_cast_elem* <- typeIR_cast_elem**})
  -- (if ((|annotationList_a*{annotationList_a <- annotationList_a*}| = |id_a*{id_a <- id_a*}|) /\ (|id_a*{id_a <- id_a*}| = |typeIR_cast_step*{typeIR_cast_step <- typeIR_cast_step*}|)))*{typeIR_cast_step* <- typeIR_cast_step**}
  -- (let typeIR_cast_agg = RECORD `{ annotationList_a typeIR_cast_step id_a ';'*{annotationList_a <- annotationList_a*, id_a <- id_a*, typeIR_cast_step <- typeIR_cast_step*} `} as typeIR)*{typeIR_cast_step* <- typeIR_cast_step**, typeIR_cast_agg -> typeIR_cast_agg*}

def $chain_casts_recordTypeIR_default(fieldTypeIR*, typeIR**, typeIR) : typeIR* =

  clause 0 : (annotationList_a typeIR_a id_a ';'*{annotationList_a <- annotationList_a*, id_a <- id_a*, typeIR_a <- typeIR_a*}, typeIR_cast_elem*{typeIR_cast_elem <- typeIR_cast_elem*}*{typeIR_cast_elem* <- typeIR_cast_elem**}, typeIR_b) = typeIR_cast_agg*{typeIR_cast_agg <- typeIR_cast_agg*} ++ [typeIR_b]
  -- let typeIR_cast_step*{typeIR_cast_step <- typeIR_cast_step*}*{typeIR_cast_step* <- typeIR_cast_step**} = $chain_casts(typeIR_a*{typeIR_a <- typeIR_a*}, typeIR_cast_elem*{typeIR_cast_elem <- typeIR_cast_elem*}*{typeIR_cast_elem* <- typeIR_cast_elem**})
  -- (if ((|annotationList_a*{annotationList_a <- annotationList_a*}| = |id_a*{id_a <- id_a*}|) /\ (|id_a*{id_a <- id_a*}| = |typeIR_cast_step*{typeIR_cast_step <- typeIR_cast_step*}|)))*{typeIR_cast_step* <- typeIR_cast_step**}
  -- (let typeIR_cast_agg = RECORD `{ annotationList_a typeIR_cast_step id_a ';'*{annotationList_a <- annotationList_a*, id_a <- id_a*, typeIR_cast_step <- typeIR_cast_step*} ',' '...' `} as typeIR)*{typeIR_cast_step* <- typeIR_cast_step**, typeIR_cast_agg -> typeIR_cast_agg*}

def $reduce_serenum(typedExpressionIR) : typedExpressionIR =

  clause 0 : (typedExpressionIR) = typedExpressionIR_reduced
  -- let typeIR = $type_of_typedExpressionIR(typedExpressionIR)
  -- let ctk = $ctk_of_typedExpressionIR(typedExpressionIR)
  -- let typeIR' = $unroll_typeIR(typeIR)
  -- if typeIR' <: serializableEnumTypeIR
  -- let ENUM _typeId `< typeIR_underlying `> `{ _valueFieldIR*{_valueFieldIR <- _valueFieldIR*} `} = typeIR' as serializableEnumTypeIR
  -- let typedExpressionIR_reduced = `( typeIR_underlying `) typedExpressionIR as expressionIR '#' `( typeIR_underlying ctk `)

  clause -1 : (typedExpressionIR) = typedExpressionIR

def $reduce_serenum_unary(typedExpressionIR, $check(typeIR) : bool) : typedExpressionIR? =

  clause 0 : (typedExpressionIR, $check) = ?(typedExpressionIR)
  -- let _expressionIR '#' `( typeIR _ctk `) = typedExpressionIR
  -- if $check(typeIR)

  clause 1 : (typedExpressionIR, $check) = $reduce_serenum_unary(typedExpressionIR_cast, $check)
  -- let _expressionIR '#' `( typeIR ctk `) = typedExpressionIR
  -- if ~$check(typeIR)
  -- let typeIR' = $unroll_typeIR(typeIR)
  -- if typeIR' <: serializableEnumTypeIR
  -- let ENUM _typeId `< typeIR_underlying `> `{ _valueFieldIR*{_valueFieldIR <- _valueFieldIR*} `} = typeIR' as serializableEnumTypeIR
  -- let typedExpressionIR_cast = `( typeIR_underlying `) typedExpressionIR as expressionIR '#' `( typeIR_underlying ctk `)

  clause -1 : (typedExpressionIR, $check) = ?()

def $reduce_serenum_binary(typedExpressionIR, typedExpressionIR, $check(typeIR, typeIR) : bool) : (typedExpressionIR, typedExpressionIR)? =

  clause 0 : (typedExpressionIR_l, typedExpressionIR_r, $check) = ?((typedExpressionIR_l, typedExpressionIR_r))
  -- let _expressionIR '#' `( typeIR_l _ctk `) = typedExpressionIR_l
  -- let _expressionIR' '#' `( typeIR_r _ctk' `) = typedExpressionIR_r
  -- if $check(typeIR_l, typeIR_r)

  clause 1 : (typedExpressionIR_l, typedExpressionIR_r, $check) = $reduce_serenum_binary(typedExpressionIR_l_cast, typedExpressionIR_r, $check)
  -- let _expressionIR '#' `( typeIR_l ctk_l `) = typedExpressionIR_l
  -- let _expressionIR' '#' `( typeIR_r _ctk `) = typedExpressionIR_r
  -- if ~$check(typeIR_l, typeIR_r)
  -- let typeIR = $unroll_typeIR(typeIR_l)
  -- if typeIR <: serializableEnumTypeIR
  -- let ENUM _typeId `< typeIR_l_underlying `> `{ _valueFieldIR*{_valueFieldIR <- _valueFieldIR*} `} = typeIR as serializableEnumTypeIR
  -- let typedExpressionIR_l_cast = `( typeIR_l_underlying `) typedExpressionIR_l as expressionIR '#' `( typeIR_l_underlying ctk_l `)

  clause 2 : (typedExpressionIR_l, typedExpressionIR_r, $check) = $reduce_serenum_binary(typedExpressionIR_l, typedExpressionIR_r_cast, $check)
  -- let _expressionIR '#' `( typeIR_l _ctk `) = typedExpressionIR_l
  -- let _expressionIR' '#' `( typeIR_r ctk_r `) = typedExpressionIR_r
  -- if ~$check(typeIR_l, typeIR_r)
  -- if ~$unroll_typeIR(typeIR_l) <: serializableEnumTypeIR
  -- let typeIR = $unroll_typeIR(typeIR_r)
  -- if typeIR <: serializableEnumTypeIR
  -- let ENUM _typeId `< typeIR_r_underlying `> `{ _valueFieldIR*{_valueFieldIR <- _valueFieldIR*} `} = typeIR as serializableEnumTypeIR
  -- let typedExpressionIR_r_cast = `( typeIR_r_underlying `) typedExpressionIR_r as expressionIR '#' `( typeIR_r_underlying ctk_r `)

  clause -1 : (typedExpressionIR_l, typedExpressionIR_r, $check) = ?()

def $apply_cast(typedExpressionIR, typeIR*) : typedExpressionIR =

  clause 0 : (typedExpressionIR, typeIR*{typeIR <- typeIR*}) = typedExpressionIR
  -- if typeIR*{typeIR <- typeIR*} matches []

  clause 1 : (typedExpressionIR, typeIR*{typeIR <- typeIR*}) = $apply_cast(typedExpressionIR_cast, typeIR_t*{typeIR_t <- typeIR_t*})
  -- if typeIR*{typeIR <- typeIR*} matches _ :: _
  -- let typeIR_h :: typeIR_t*{typeIR_t <- typeIR_t*} = typeIR*{typeIR <- typeIR*}
  -- let _expressionIR '#' `( _typeIR ctk `) = typedExpressionIR
  -- let typedExpressionIR_cast = `( typeIR_h `) typedExpressionIR as expressionIR '#' `( typeIR_h ctk `)

def $cast_unary(typedExpressionIR, typeIR) : typedExpressionIR? =

  clause 0 : (typedExpressionIR, typeIR_to) = ?(typedExpressionIR_cast)
  -- let _expressionIR '#' `( typeIR _ctk `) = typedExpressionIR
  -- Cast_impl: typeIR -> typeIR_to : castResult
  -- if castResult matches `OK %`
  -- let OK typeIR_cast*{typeIR_cast <- typeIR_cast*} = castResult
  -- let typedExpressionIR_cast = $apply_cast(typedExpressionIR, typeIR_cast*{typeIR_cast <- typeIR_cast*})

  clause -1 : (typedExpressionIR, typeIR_to) = ?()

def $cast_binary(typedExpressionIR, typedExpressionIR) : (typedExpressionIR, typedExpressionIR)? =

  clause 0 : (typedExpressionIR_l, typedExpressionIR_r) = ?((typedExpressionIR_l_cast, typedExpressionIR_r))
  -- let _expressionIR '#' `( typeIR_l _ctk `) = typedExpressionIR_l
  -- let _expressionIR' '#' `( typeIR_r _ctk' `) = typedExpressionIR_r
  -- Cast_impl: typeIR_l -> typeIR_r : castResult
  -- if castResult matches `OK %`
  -- let OK typeIR_cast*{typeIR_cast <- typeIR_cast*} = castResult
  -- let typedExpressionIR_l_cast = $apply_cast(typedExpressionIR_l, typeIR_cast*{typeIR_cast <- typeIR_cast*})

  clause 1 : (typedExpressionIR_l, typedExpressionIR_r) = ?((typedExpressionIR_l, typedExpressionIR_r_cast))
  -- let _expressionIR '#' `( typeIR_l _ctk `) = typedExpressionIR_l
  -- let _expressionIR' '#' `( typeIR_r _ctk' `) = typedExpressionIR_r
  -- Cast_impl: typeIR_l -> typeIR_r : castResult
  -- if castResult matches `FAIL`
  -- Cast_impl: typeIR_r -> typeIR_l : castResult'
  -- if castResult' matches `OK %`
  -- let OK typeIR_cast*{typeIR_cast <- typeIR_cast*} = castResult'
  -- let typedExpressionIR_r_cast = $apply_cast(typedExpressionIR_r, typeIR_cast*{typeIR_cast <- typeIR_cast*})

  clause 2 : (typedExpressionIR_l, typedExpressionIR_r) = $cast_binary(typedExpressionIR_l_cast, typedExpressionIR_r)
  -- let _expressionIR '#' `( typeIR_l _ctk `) = typedExpressionIR_l
  -- let _expressionIR' '#' `( typeIR_r _ctk' `) = typedExpressionIR_r
  -- Cast_impl: typeIR_l -> typeIR_r : castResult
  -- if castResult matches `FAIL`
  -- Cast_impl: typeIR_r -> typeIR_l : castResult'
  -- if castResult' matches `FAIL`
  -- let typedExpressionIR_l_cast = $reduce_serenum(typedExpressionIR_l)
  -- if (typedExpressionIR_l =/= typedExpressionIR_l_cast)

  clause 3 : (typedExpressionIR_l, typedExpressionIR_r) = $cast_binary(typedExpressionIR_l, typedExpressionIR_r_cast)
  -- let _expressionIR '#' `( typeIR_l _ctk `) = typedExpressionIR_l
  -- let _expressionIR' '#' `( typeIR_r _ctk' `) = typedExpressionIR_r
  -- Cast_impl: typeIR_l -> typeIR_r : castResult
  -- if castResult matches `FAIL`
  -- Cast_impl: typeIR_r -> typeIR_l : castResult'
  -- if castResult' matches `FAIL`
  -- let typedExpressionIR_l_cast = $reduce_serenum(typedExpressionIR_l)
  -- if (typedExpressionIR_l = typedExpressionIR_l_cast)
  -- let typedExpressionIR_r_cast = $reduce_serenum(typedExpressionIR_r)
  -- if (typedExpressionIR_r =/= typedExpressionIR_r_cast)

  clause -1 : (typedExpressionIR_l, typedExpressionIR_r) = ?()

tbl def $compat_lnot(typeIR) : bool =
  row 0 :
    (signature) BOOL as typeIR
    (typeIR) -> true
    -- if typeIR <: boolTypeIR
    -- let boolTypeIR = typeIR as boolTypeIR
    -- if (boolTypeIR = BOOL)
  row 1 :
    (signature) TYPEDEF _typeId typeIR as typeIR
    (typeIR') -> $compat_lnot(typeIR)
    -- if typeIR' <: typedefTypeIR
    -- let TYPEDEF _typeId typeIR = typeIR' as typedefTypeIR
  row 2 :
    (signature) _typeIR
    (_typeIR) -> false

