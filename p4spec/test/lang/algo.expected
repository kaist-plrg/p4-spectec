  -- if (typeId = typeId')

  clause 9 : (constraint, typeIR, typeIR') = $gen_constraint(constraint, typeIR_arg_a*{typeIR_arg_a <- typeIR_arg_a*}, typeIR_arg_b*{typeIR_arg_b <- typeIR_arg_b*})
