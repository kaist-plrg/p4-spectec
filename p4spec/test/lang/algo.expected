  -- if typeParameter*{typeParameter <- typeParameter*} matches []

  clause 1 : (typeParameterList, typeParameter*{typeParameter <- typeParameter*}) = $unflatten_typeParameterList'(typeParameterList ',' typeParameter_h, typeParameter_t*{typeParameter_t <- typeParameter_t*})
