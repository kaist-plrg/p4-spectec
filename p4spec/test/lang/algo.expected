  -- let '.' nameIR = prefixedNameIR

def $find_constructorDef_i(instContext, prefixedNameIR, argumentIR*) : callResolution<constructorDef>? =

  clause 0 : (IC, prefixedNameIR, argumentIR*{argumentIR <- argumentIR*}) = $find_overloaded<constructorDef>(IC.GLOBAL.CONSTRUCTOR, callTargetKey, $parameterListIR_of_constructorDef)
