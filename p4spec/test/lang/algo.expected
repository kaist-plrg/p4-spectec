  -- let setValue = value as setValue
  -- let typeIR_unroll = $unroll_typeIR(typeIR)

def $default(typeIR) : value =

  clause 0 : (typeIR) = _B false as value
  -- if typeIR <: boolTypeIR
  -- let boolTypeIR = typeIR as boolTypeIR
  -- if (boolTypeIR = BOOL)

  clause 1 : (typeIR) = ERROR '.' "NoError" as value
  -- if typeIR <: errorTypeIR
  -- let errorTypeIR = typeIR as errorTypeIR
  -- if (errorTypeIR = ERROR)

  clause 2 : (typeIR) = '"' text_empty '"' as value
  -- if typeIR <: stringTypeIR
  -- let stringTypeIR = typeIR as stringTypeIR
  -- if (stringTypeIR = STRING)
  -- let text_empty = ""

  clause 3 : (typeIR) = D 0 as int as value
  -- if typeIR <: intTypeIR
  -- let intTypeIR = typeIR as intTypeIR
  -- if (intTypeIR = INT)

  clause 4 : (typeIR) = w W 0 as int as value
  -- if typeIR <: fixedBitTypeIR
  -- let BIT `< w `> = typeIR as fixedBitTypeIR

  clause 5 : (typeIR) = w S 0 as int as value
  -- if typeIR <: fixedIntTypeIR
  -- let INT `< w `> = typeIR as fixedIntTypeIR

  clause 6 : (typeIR) = w '.' 0 V 0 as int as value
  -- if typeIR <: varBitTypeIR
  -- let VARBIT `< w `> = typeIR as varBitTypeIR

  clause 7 : (typeIR') = $default(typeIR)
  -- if typeIR' <: typedefTypeIR
  -- let TYPEDEF _typeId typeIR = typeIR' as typedefTypeIR

  clause 8 : (typeIR') = $default(typeIR)
  -- if typeIR' <: newTypeIR
  -- let TYPE _typeId typeIR = typeIR' as newTypeIR

  clause 9 : (typeIR') = TUPLE `( $default(typeIR)*{typeIR <- typeIR*} `) as value
  -- if typeIR' <: tupleTypeIR
  -- let TUPLE `< typeIR*{typeIR <- typeIR*} `> = typeIR' as tupleTypeIR

  clause 10 : (typeIR') = ARRAY `[ value*{value <- value*} `] as value
  -- if typeIR' <: arrayTypeIR
  -- let ARRAY typeIR `[ n_s `] = typeIR' as arrayTypeIR
  -- let value*{value <- value*} = $repeat_<value>($default(typeIR), n_s)

  clause 11 : (typeIR') = HEADER_STACK `[ value*{value <- value*} `( 0 `) `] as value
  -- if typeIR' <: headerStackTypeIR
  -- let HEADER_STACK typeIR `[ n_s `] = typeIR' as headerStackTypeIR
  -- let value*{value <- value*} = $repeat_<value>($default(typeIR), n_s)

  clause 12 : (typeIR) = STRUCT typeId `{ $default(typeIR_f) id_f ';'*{id_f <- id_f*, typeIR_f <- typeIR_f*} `} as value
  -- if typeIR <: structTypeIR
  -- let STRUCT typeId `< _typeArgumentIR*{_typeArgumentIR <- _typeArgumentIR*} `> `{ _annotationList typeIR_f id_f ';'*{_annotationList <- _annotationList*, id_f <- id_f*, typeIR_f <- typeIR_f*} `} = typeIR as structTypeIR

  clause 13 : (typeIR) = HEADER typeId `{ false ';' $default(typeIR_f) id_f ';'*{id_f <- id_f*, typeIR_f <- typeIR_f*} `} as value
  -- if typeIR <: headerTypeIR
  -- let HEADER typeId `< _typeArgumentIR*{_typeArgumentIR <- _typeArgumentIR*} `> `{ _annotationList typeIR_f id_f ';'*{_annotationList <- _annotationList*, id_f <- id_f*, typeIR_f <- typeIR_f*} `} = typeIR as headerTypeIR

  clause 14 : (typeIR) = HEADER_UNION typeId `{ $default(typeIR_f) id_f ';'*{id_f <- id_f*, typeIR_f <- typeIR_f*} `} as value
  -- if typeIR <: headerUnionTypeIR
  -- let HEADER_UNION typeId `< _typeArgumentIR*{_typeArgumentIR <- _typeArgumentIR*} `> `{ _annotationList typeIR_f id_f ';'*{_annotationList <- _annotationList*, id_f <- id_f*, typeIR_f <- typeIR_f*} `} = typeIR as headerUnionTypeIR

  clause 15 : (typeIR) = typeId '.' id_f_h as value
  -- if typeIR <: simpleEnumTypeIR
  -- let ENUM typeId `{ id*{id <- id*} `} = typeIR as simpleEnumTypeIR
  -- if id*{id <- id*} matches _ :: _
  -- let id_f_h :: _id*{_id <- _id*} = id*{id <- id*}

  clause 16 : (typeIR') = typeId '.' id_zero '.' value_zero as value
  -- if typeIR' <: serializableEnumTypeIR
  -- let ENUM typeId `< typeIR `> `{ nameIR_field '=' value_field ';'*{nameIR_field <- nameIR_field*, value_field <- value_field*} `} = typeIR' as serializableEnumTypeIR
  -- let value_zero = $cast_int(typeIR, D 0 as int as integerValue)
  -- let id?{id <- id?} = $assoc_<value, id>(value_zero, (value_field, nameIR_field)*{nameIR_field <- nameIR_field*, value_field <- value_field*})
  -- if id?{id <- id?} matches (_)
  -- let ?(id_zero) = id?{id <- id?}

  clause 17 : (typeIR') = typeId '.' id_zero '.' value_zero as value
  -- if typeIR' <: serializableEnumTypeIR
  -- let ENUM typeId `< typeIR `> `{ nameIR_field '=' value_field ';'*{nameIR_field <- nameIR_field*, value_field <- value_field*} `} = typeIR' as serializableEnumTypeIR
  -- let value_zero = $cast_int(typeIR, D 0 as int as integerValue)
  -- if (?() = $assoc_<value, id>(value_zero, (value_field, nameIR_field)*{nameIR_field <- nameIR_field*, value_field <- value_field*}))
  -- let id_zero = "__UNSPECIFIED"

def $cast_to_enum(enumTypeIR, value) : value =

  clause 0 : (enumTypeIR, value) = $cast_to_enum'(typeId, typeIR, valueFieldIR*{valueFieldIR <- valueFieldIR*}, value)
  -- if enumTypeIR <: serializableEnumTypeIR
  -- let ENUM typeId `< typeIR `> `{ valueFieldIR*{valueFieldIR <- valueFieldIR*} `} = enumTypeIR as serializableEnumTypeIR

def $cast_to_enum'(typeId, typeIR, valueFieldIR*, value) : value =

  clause 0 : (typeId, typeIR, valueFieldIR*{valueFieldIR <- valueFieldIR*}, value_target) = typeId '.' id_unnamed '.' value_idx as value
  -- if valueFieldIR*{valueFieldIR <- valueFieldIR*} matches []
  -- let value_idx = $cast_op(typeIR, value_target)
  -- let id_unnamed = "__UNSPECIFIED"

  clause 1 : (typeId, typeIR, valueFieldIR*{valueFieldIR <- valueFieldIR*}, value_target) = typeId '.' nameIR '.' value as value
  -- if valueFieldIR*{valueFieldIR <- valueFieldIR*} matches _ :: _
  -- let valueFieldIR_h :: valueFieldIR_t*{valueFieldIR_t <- valueFieldIR_t*} = valueFieldIR*{valueFieldIR <- valueFieldIR*}
  -- let nameIR '=' value ';' = valueFieldIR_h
  -- if $bin_eq(value, value_target)

  clause 2 : (typeId, typeIR, valueFieldIR*{valueFieldIR <- valueFieldIR*}, value_target) = $cast_to_enum'(typeId, typeIR, valueFieldIR_t*{valueFieldIR_t <- valueFieldIR_t*}, value_target)
  -- if valueFieldIR*{valueFieldIR <- valueFieldIR*} matches _ :: _
  -- let valueFieldIR_h :: valueFieldIR_t*{valueFieldIR_t <- valueFieldIR_t*} = valueFieldIR*{valueFieldIR <- valueFieldIR*}
  -- let nameIR '=' value ';' = valueFieldIR_h
  -- if ~$bin_eq(value, value_target)

def $cast_bool(typeIR, boolValue) : value =

  clause 0 : (typeIR, _B b) = _B b as value
  -- if typeIR <: boolTypeIR
  -- let boolTypeIR = typeIR as boolTypeIR
  -- if (boolTypeIR = BOOL)

  clause 1 : (typeIR, boolValue) = w W 1 as int as value
  -- if typeIR <: fixedBitTypeIR
  -- let BIT `< w `> = typeIR as fixedBitTypeIR
  -- if (boolValue = _B true)

  clause 2 : (typeIR, boolValue) = w W 0 as int as value
  -- if typeIR <: fixedBitTypeIR
  -- let BIT `< w `> = typeIR as fixedBitTypeIR
  -- if (boolValue = _B false)

  clause 3 : (typeIR', boolValue) = $cast_bool(typeIR, boolValue)
  -- if typeIR' <: newTypeIR
  -- let TYPE _typeId typeIR = typeIR' as newTypeIR

  clause 4 : (typeIR', boolValue) = SET `{ $cast_bool(typeIR, boolValue) `} as value
  -- if typeIR' <: setTypeIR
  -- let SET `< typeIR `> = typeIR' as setTypeIR

def $cast_int(typeIR, integerValue) : value =

  clause 0 : (typeIR, integerValue) = _B (i =/= 0 as int) as value
  -- if typeIR <: boolTypeIR
  -- let boolTypeIR = typeIR as boolTypeIR
  -- if (boolTypeIR = BOOL)
  -- if integerValue <: integerLiteral
  -- let integerLiteral = integerValue as integerLiteral
