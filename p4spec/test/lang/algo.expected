relation Type_wf: bound |- typeIR

  rulegroup baseTypeIR

   match

    (signature) B |- baseTypeIR as typeIR
    B |- typeIR
    -- if typeIR <: baseTypeIR
    -- let baseTypeIR = typeIR as baseTypeIR

   paths

    rulepath baseTypeIR
    -- the relation holds

  rulegroup nameTypeIR

   match

    (signature) B |- _NAME typeId as typeIR
