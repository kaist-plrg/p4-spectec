  -- if (intTypeIR = INT)
  -- if integerValue <: integerLiteral
  -- let integerLiteral = integerValue as integerLiteral
  -- if integerLiteral matches `D %`
  -- let D i = integerLiteral

  clause 3 : (typeIR, integerValue) = D i as value
