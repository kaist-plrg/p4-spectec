tbl def $compat_range(typeIR, typeIR) : bool =
  row 0 :
    (signature) INT as typeIR, INT as typeIR
    (typeIR, typeIR') -> true
    -- if typeIR <: intTypeIR
    -- let intTypeIR = typeIR as intTypeIR
    -- if (intTypeIR = INT)
    -- if typeIR' <: intTypeIR
    -- let intTypeIR' = typeIR' as intTypeIR
    -- if (intTypeIR' = INT)
  row 1 :
    (signature) INT `< w_l `> as typeIR, INT `< w_r `> as typeIR
    (typeIR, typeIR') -> (w_l = w_r)
    -- if typeIR <: fixedIntTypeIR
    -- let INT `< w_l `> = typeIR as fixedIntTypeIR
    -- if typeIR' <: fixedIntTypeIR
    -- let INT `< w_r `> = typeIR' as fixedIntTypeIR
  row 2 :
    (signature) BIT `< w_l `> as typeIR, BIT `< w_r `> as typeIR
    (typeIR, typeIR') -> (w_l = w_r)
    -- if typeIR <: fixedBitTypeIR
    -- let BIT `< w_l `> = typeIR as fixedBitTypeIR
    -- if typeIR' <: fixedBitTypeIR
    -- let BIT `< w_r `> = typeIR' as fixedBitTypeIR
  row 3 :
    (signature) TYPEDEF _typeId typeIR_l as typeIR, typeIR_r
    (typeIR, typeIR_r) -> $compat_range(typeIR_l, typeIR_r)
    -- if typeIR <: typedefTypeIR
    -- let TYPEDEF _typeId typeIR_l = typeIR as typedefTypeIR
  row 4 :
    (signature) typeIR_l, TYPEDEF _typeId typeIR_r as typeIR
    (typeIR_l, typeIR) -> $compat_range(typeIR_l, typeIR_r)
    -- if typeIR <: typedefTypeIR
    -- let TYPEDEF _typeId typeIR_r = typeIR as typedefTypeIR
  row 5 :
    (signature) _typeIR, _typeIR'
    (_typeIR, _typeIR') -> false

def $check_switchLabelIR_default(switchLabelIR*) : bool =

  clause 0 : (switchLabelIR*{switchLabelIR <- switchLabelIR*}) = true
  -- if switchLabelIR*{switchLabelIR <- switchLabelIR*} matches []

  clause 1 : (switchLabelIR*{switchLabelIR <- switchLabelIR*}) = (switchLabelIR_t*{switchLabelIR_t <- switchLabelIR_t*} = [])
  -- if switchLabelIR*{switchLabelIR <- switchLabelIR*} matches _ :: _
  -- let switchLabelIR_h :: switchLabelIR_t*{switchLabelIR_t <- switchLabelIR_t*} = switchLabelIR*{switchLabelIR <- switchLabelIR*}
  -- if (switchLabelIR_h = DEFAULT)

  clause 2 : (switchLabelIR*{switchLabelIR <- switchLabelIR*}) = $check_switchLabelIR_default(switchLabelIR_t*{switchLabelIR_t <- switchLabelIR_t*})
  -- if switchLabelIR*{switchLabelIR <- switchLabelIR*} matches _ :: _
  -- let switchLabelIR_h :: switchLabelIR_t*{switchLabelIR_t <- switchLabelIR_t*} = switchLabelIR*{switchLabelIR <- switchLabelIR*}
  -- if (switchLabelIR_h =/= DEFAULT)

