def $unflatten_parameterList(parameter*) : parameterList =

  clause 0 : (parameter*{parameter <- parameter*}) = _EMPTY
  -- if parameter*{parameter <- parameter*} matches []

  clause 1 : (parameter*{parameter <- parameter*}) = $unflatten_nonEmptyParameterList(parameter_h :: parameter_t*{parameter_t <- parameter_t*}) as parameterList
  -- if parameter*{parameter <- parameter*} matches _ :: _
  -- let parameter_h :: parameter_t*{parameter_t <- parameter_t*} = parameter*{parameter <- parameter*}

def $unflatten_nonEmptyParameterList(parameter*) : nonEmptyParameterList =

  clause 0 : (parameter*{parameter <- parameter*}) = $unflatten_nonEmptyParameterList'(parameter_h as nonEmptyParameterList, parameter_t*{parameter_t <- parameter_t*})
  -- let parameter'*{parameter' <- parameter'*} = parameter*{parameter <- parameter*}
  -- if parameter'*{parameter' <- parameter'*} matches _ :: _
  -- let parameter_h :: parameter_t*{parameter_t <- parameter_t*} = parameter'*{parameter' <- parameter'*}

def $unflatten_nonEmptyParameterList'(nonEmptyParameterList, parameter*) : nonEmptyParameterList =

  clause 0 : (nonEmptyParameterList, parameter*{parameter <- parameter*}) = nonEmptyParameterList
  -- if parameter*{parameter <- parameter*} matches []

  clause 1 : (nonEmptyParameterList, parameter*{parameter <- parameter*}) = $unflatten_nonEmptyParameterList'(nonEmptyParameterList ',' parameter_h, parameter_t*{parameter_t <- parameter_t*})
  -- if parameter*{parameter <- parameter*} matches _ :: _
  -- let parameter_h :: parameter_t*{parameter_t <- parameter_t*} = parameter*{parameter <- parameter*}

def $lift_constructorParameterIR(constructorParameterIR) : constructorParameter =

  clause 0 : (constructorParameterIR) = $lift_parameterIR(constructorParameterIR)

def $lift_constructorParameterListIR(constructorParameterIR*) : constructorParameterListOpt =

