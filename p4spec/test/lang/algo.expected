def $update_objectState_e(arch, objectId, objectState) : arch? =

  clause 0 : (ARCH_0, objectId, objectState) = ?(ARCH_1)
  -- let object'?{object' <- object'?} = $find_object_e(ARCH_0, objectId)
  -- if object'?{object' <- object'?} matches (_)
  -- let ?(object) = object'?{object' <- object'?}
  -- if object <: externObject
  -- let externObject = object as externObject
  -- let EXTERN typeId `< theta `> `{ _objectState frame externMethodDefEnv `} = externObject
  -- let externObject_update = EXTERN typeId `< theta `> `{ objectState frame externMethodDefEnv `}
  -- let ARCH_1 = $add_object_e(ARCH_0, objectId, externObject_update as object)

  clause -1 : (ARCH, objectId, objectState) = ?()

syntax continueEmptyResult = 
   | _EMPTY (from continueEmptyResult) 

syntax continueResult<X> = 
   | _CONT X (from continueResult<X>) 

syntax exitResult = 
   | EXIT (from exitResult) 

syntax returnResult = 
   | RETURN value? (from returnResult) 

syntax acceptTransitionResult = 
   | ACCEPT (from acceptTransitionResult) 

syntax rejectTransitionResult = 
   | REJECT errorValue (from rejectTransitionResult) 

syntax stateTransitionResult = 
   | STATE id (from stateTransitionResult) 

syntax abortResult = 
   | EXIT (from exitResult) 
   | REJECT errorValue (from rejectTransitionResult) 

syntax expressionResult = 
   | _CONT value (from continueResult<value>) 
   | EXIT (from exitResult) 
   | REJECT errorValue (from rejectTransitionResult) 

relation Expr_eval: cursor evalContext arch |- typedExpressionIR : evalContext arch expressionResult

  rulegroup literalExpressionIR

