  -- let ?(value) = value'?{value' <- value'?}

  clause 1 : (prefixedNameIR, p, IC) = value
  -- if prefixedNameIR matches `_BARE %`
  -- let _BARE id = prefixedNameIR
  -- if p matches `GLOBAL`
  -- let value'?{value' <- value'?} = $find_map<id, value>(IC.GLOBAL.FRAME, id)
  -- if value'?{value' <- value'?} matches (_)
  -- let ?(value) = value'?{value' <- value'?}

  clause 2 : (prefixedNameIR, p, IC) = value
  -- if prefixedNameIR matches `_BARE %`
  -- let _BARE id = prefixedNameIR
  -- if p matches `BLOCK`
  -- let value'?{value' <- value'?} = $find_map<id, value>(IC.BLOCK.FRAME, id)
  -- if value'?{value' <- value'?} matches (_)
  -- let ?(value) = value'?{value' <- value'?}

  clause 3 : (prefixedNameIR, p, IC) = $find_var_i(_BARE id, GLOBAL, IC)
  -- if prefixedNameIR matches `_BARE %`
  -- let _BARE id = prefixedNameIR
  -- if p matches `BLOCK`
  -- if (?() = $find_map<id, value>(IC.BLOCK.FRAME, id))

  clause 4 : (prefixedNameIR, p, IC) = value
  -- if prefixedNameIR matches `_BARE %`
  -- let _BARE id = prefixedNameIR
  -- if p matches `LOCAL`
  -- let value'?{value' <- value'?} = $find_maps<id, value>(IC.LOCAL.FRAMES, id)
  -- if value'?{value' <- value'?} matches (_)
  -- let ?(value) = value'?{value' <- value'?}

  clause 5 : (prefixedNameIR, p, IC) = $find_var_i(_BARE id, BLOCK, IC)
  -- if prefixedNameIR matches `_BARE %`
  -- let _BARE id = prefixedNameIR
  -- if p matches `LOCAL`
  -- if (?() = $find_maps<id, value>(IC.LOCAL.FRAMES, id))

def $find_typeDef_i(cursor, instContext, prefixedNameIR) : typeDefIR? =

  clause 0 : (_p, IC, prefixedNameIR) = $find_map<typeId, typeDefIR>(IC.GLOBAL.TYPE, nameIR)
