  rulegroup headerUnionTypeIR

   match

    (signature) HEADER_UNION typeId `< typeArgumentIR_a*{typeArgumentIR_a <- typeArgumentIR_a*} `> `{ _fieldTypeIR*{_fieldTypeIR <- _fieldTypeIR*} `} as typeIR ~~ HEADER_UNION typeId `< typeArgumentIR_b*{typeArgumentIR_b <- typeArgumentIR_b*} `> `{ _fieldTypeIR'*{_fieldTypeIR' <- _fieldTypeIR'*} `} as typeIR
    typeIR ~~ typeIR'
    -- if typeIR <: headerUnionTypeIR
