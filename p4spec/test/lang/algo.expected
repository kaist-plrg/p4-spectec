def $lift_switchStatementIR(switchStatementIR) : switchStatement =

  clause 0 : (SWITCH `( typedExpressionIR `) `{ switchCaseIR*{switchCaseIR <- switchCaseIR*} `}) = SWITCH `( expression `) `{ switchCaseList `}
