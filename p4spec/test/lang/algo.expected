def $unflatten_switchCaseList'(switchCaseList, switchCase*) : switchCaseList =

  clause 0 : (switchCaseList, switchCase*{switchCase <- switchCase*}) = switchCaseList
  -- if switchCase*{switchCase <- switchCase*} matches []

  clause 1 : (switchCaseList, switchCase*{switchCase <- switchCase*}) = $unflatten_switchCaseList'(switchCaseList switchCase_h, switchCase_t*{switchCase_t <- switchCase_t*})
