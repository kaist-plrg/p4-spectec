    -- if typeIR' <: headerTypeIR
    -- let HEADER typeId' `< typeArgumentIR_b*{typeArgumentIR_b <- typeArgumentIR_b*} `> `{ _fieldTypeIR'*{_fieldTypeIR' <- _fieldTypeIR'*} `} = typeIR' as headerTypeIR
    -- if (typeId = typeId')

   paths

    rulepath headerTypeIR
    -- if (|typeArgumentIR_a*{typeArgumentIR_a <- typeArgumentIR_a*}| = |typeArgumentIR_b*{typeArgumentIR_b <- typeArgumentIR_b*}|)
