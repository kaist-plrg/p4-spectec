syntax ctk = 
   | LCTK (from ctk) 
   | CTK (from ctk) 
   | DYN (from ctk) 

def $join_ctk(ctk, ctk) : ctk =

  clause 0 : (ctk, ctk') = LCTK
  -- if ctk matches `LCTK`
  -- if ctk' matches `LCTK`

  clause 1 : (ctk, ctk') = CTK
  -- if ctk matches `LCTK`
  -- if ctk' matches `CTK`

  clause 2 : (ctk, ctk') = CTK
  -- if ctk matches `CTK`
  -- if ctk' matches `LCTK`

  clause 3 : (ctk, ctk') = CTK
  -- if ctk matches `CTK`
  -- if ctk' matches `CTK`

  clause -1 : (ctk_a, ctk_b) = DYN

def $joins_ctk(ctk*) : ctk =

  clause 0 : (ctk*{ctk <- ctk*}) = LCTK
  -- if ctk*{ctk <- ctk*} matches []

  clause 1 : (ctk'*{ctk' <- ctk'*}) = ctk
  -- if ctk'*{ctk' <- ctk'*} matches [ _/1 ]
  -- let [ctk] = ctk'*{ctk' <- ctk'*}

  clause 2 : (ctk'*{ctk' <- ctk'*}) = $join_ctk(ctk_a, ctk_b)
  -- if ctk'*{ctk' <- ctk'*} matches _ :: _
  -- let ctk_a :: ctk*{ctk <- ctk*} = ctk'*{ctk' <- ctk'*}
  -- if ctk*{ctk <- ctk*} matches [ _/1 ]
  -- let [ctk_b] = ctk*{ctk <- ctk*}

  clause 3 : (ctk'*{ctk' <- ctk'*}) = $joins_ctk(ctk_d :: ctk_c*{ctk_c <- ctk_c*})
  -- if ctk'*{ctk' <- ctk'*} matches _ :: _
  -- let ctk_a :: ctk*{ctk <- ctk*} = ctk'*{ctk' <- ctk'*}
  -- if ctk*{ctk <- ctk*} matches _ :: _
  -- let ctk_b :: ctk_c*{ctk_c <- ctk_c*} = ctk*{ctk <- ctk*}
  -- if (ctk_c*{ctk_c <- ctk_c*} =/= [])
  -- let ctk_d = $join_ctk(ctk_a, ctk_b)

builtin def $pow2(nat) : int

builtin def $shl(int, int) : int

builtin def $shr(int, int) : int

builtin def $shr_arith(int, int, int) : int

builtin def $bneg(int) : int

builtin def $band(int, int) : int

builtin def $bxor(int, int) : int

builtin def $bor(int, int) : int

builtin def $bitacc(int, int, int) : int

builtin def $bitacc_replace(int, int, int, int) : int

def $un_op(unop, value) : value =

  clause 0 : (unop, value) = $un_bnot(value)
  -- if unop matches `~`

  clause 1 : (unop, value) = $un_lnot(value)
  -- if unop matches `!`

  clause 2 : (unop, value) = $un_plus(value)
  -- if unop matches `+`

  clause 3 : (unop, value) = $un_minus(value)
  -- if unop matches `-`

def $un_bnot(value) : value =

  clause 0 : (value) = w W i'' as value
  -- if value <: integerLiteral
  -- let integerLiteral = value as integerLiteral
  -- if integerLiteral matches `% W %`
  -- let w W i = integerLiteral
  -- let i' = $bneg(i)
  -- let i'' = $ite<int>((i' >= 0 as int), i', ($pow2(w) + i'))

  clause 1 : (value) = w S i'' as value
  -- if value <: integerLiteral
  -- let integerLiteral = value as integerLiteral
  -- if integerLiteral matches `% S %`
  -- let w S i = integerLiteral
  -- let i' = $bneg(i)
  -- let i'' = $ite<int>((i' >= 0 as int), i', ($pow2(w) + i'))

def $un_lnot(value) : value =

  clause 0 : (value) = _B ~b as value
  -- if value <: boolValue
  -- let _B b = value as boolValue

def $un_plus(value) : value =

  clause 0 : (value) = D i as value
  -- if value <: integerLiteral
  -- let integerLiteral = value as integerLiteral
  -- if integerLiteral matches `D %`
  -- let D i = integerLiteral

  clause 1 : (value) = w W i as value
  -- if value <: integerLiteral
  -- let integerLiteral = value as integerLiteral
  -- if integerLiteral matches `% W %`
  -- let w W i = integerLiteral

  clause 2 : (value) = w S i as value
  -- if value <: integerLiteral
  -- let integerLiteral = value as integerLiteral
  -- if integerLiteral matches `% S %`
  -- let w S i = integerLiteral

def $un_minus(value) : value =

  clause 0 : (value) = D -i as value
  -- if value <: integerLiteral
  -- let integerLiteral = value as integerLiteral
  -- if integerLiteral matches `D %`
  -- let D i = integerLiteral

  clause 1 : (value) = w W i' as value
  -- if value <: integerLiteral
  -- let integerLiteral = value as integerLiteral
  -- if integerLiteral matches `% W %`
  -- let w W i = integerLiteral
  -- let i' = $int_to_bitstr(w as int, ($pow2(w) - i))

  clause 2 : (value) = w S i' as value
  -- if value <: integerLiteral
  -- let integerLiteral = value as integerLiteral
  -- if integerLiteral matches `% S %`
  -- let w S i = integerLiteral
  -- let i' = $int_to_bitstr(w as int, $bitstr_to_int(w as int, -i))

def $bin_op(binop, value, value) : value =

  clause 0 : (binop, value_l, value_r) = $bin_plus(value_l, value_r)
  -- if binop matches `+`

  clause 1 : (binop, value_l, value_r) = $bin_satplus(value_l, value_r)
  -- if binop matches `|+|`

  clause 2 : (binop, value_l, value_r) = $bin_minus(value_l, value_r)
  -- if binop matches `-`

  clause 3 : (binop, value_l, value_r) = $bin_satminus(value_l, value_r)
  -- if binop matches `|-|`

  clause 4 : (binop, value_l, value_r) = $bin_mul(value_l, value_r)
  -- if binop matches `*`

  clause 5 : (binop, value_l, value_r) = $bin_div(value_l, value_r)
  -- if binop matches `/`

  clause 6 : (binop, value_l, value_r) = $bin_mod(value_l, value_r)
  -- if binop matches `%`

  clause 7 : (binop, value_l, value_r) = $bin_shl(value_l, value_r)
  -- if binop matches `<<`

  clause 8 : (binop, value_l, value_r) = $bin_shr(value_l, value_r)
  -- if binop matches `>>`

  clause 9 : (binop, value_l, value_r) = _B $bin_le(value_l, value_r) as value
  -- if binop matches `<=`

  clause 10 : (binop, value_l, value_r) = _B $bin_ge(value_l, value_r) as value
  -- if binop matches `>=`

  clause 11 : (binop, value_l, value_r) = _B $bin_lt(value_l, value_r) as value
  -- if binop matches `<`

  clause 12 : (binop, value_l, value_r) = _B $bin_gt(value_l, value_r) as value
  -- if binop matches `>`

  clause 13 : (binop, value_l, value_r) = _B $bin_eq(value_l, value_r) as value
  -- if binop matches `==`

  clause 14 : (binop, value_l, value_r) = _B $bin_ne(value_l, value_r) as value
  -- if binop matches `!=`

  clause 15 : (binop, value_l, value_r) = $bin_band(value_l, value_r)
  -- if binop matches `&`

  clause 16 : (binop, value_l, value_r) = $bin_bxor(value_l, value_r)
  -- if binop matches `^`

  clause 17 : (binop, value_l, value_r) = $bin_bor(value_l, value_r)
  -- if binop matches `|`

  clause 18 : (binop, value_l, value_r) = $bin_concat(value_l, value_r)
  -- if binop matches `++`

def $bin_plus(value, value) : value =

  clause 0 : (value, value') = D (i_l + i_r) as value
  -- if value <: integerLiteral
  -- let integerLiteral = value as integerLiteral
  -- if integerLiteral matches `D %`
  -- let D i_l = integerLiteral
  -- if value' <: integerLiteral
  -- let integerLiteral' = value' as integerLiteral
  -- if integerLiteral' matches `D %`
  -- let D i_r = integerLiteral'

  clause 1 : (value, value') = w W i' as value
  -- if value <: integerLiteral
  -- let integerLiteral = value as integerLiteral
  -- if integerLiteral matches `% W %`
  -- let w W i_l = integerLiteral
  -- if value' <: integerLiteral
  -- let integerLiteral' = value' as integerLiteral
  -- if integerLiteral' matches `% W %`
  -- let w' W i_r = integerLiteral'
  -- if (w = w')
  -- let i_l' = $bitstr_to_int(w as int, i_l)
