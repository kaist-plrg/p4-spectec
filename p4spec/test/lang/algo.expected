  -- let expression = $lift_typedExpressionIR(typedExpressionIR)

def $lift_expressionIR(expressionIR) : expression =

  clause 0 : (expressionIR) = $lift_literalExpressionIR(literalExpressionIR) as expression
  -- if expressionIR <: literalExpressionIR
  -- let literalExpressionIR = expressionIR as literalExpressionIR

  clause 1 : (expressionIR) = $lift_referenceExpressionIR(referenceExpressionIR) as expression
  -- if expressionIR <: referenceExpressionIR
  -- let referenceExpressionIR = expressionIR as referenceExpressionIR

  clause 2 : (expressionIR) = $lift_defaultExpressionIR(defaultExpressionIR) as expression
  -- if expressionIR <: defaultExpressionIR
  -- let defaultExpressionIR = expressionIR as defaultExpressionIR

  clause 3 : (expressionIR) = $lift_unaryExpressionIR(unaryExpressionIR) as expression
  -- if expressionIR <: unaryExpressionIR
  -- let unaryExpressionIR = expressionIR as unaryExpressionIR

  clause 4 : (expressionIR) = $lift_binaryExpressionIR(binaryExpressionIR) as expression
  -- if expressionIR <: binaryExpressionIR
  -- let binaryExpressionIR = expressionIR as binaryExpressionIR

  clause 5 : (expressionIR) = $lift_ternaryExpressionIR(ternaryExpressionIR) as expression
  -- if expressionIR <: ternaryExpressionIR
  -- let ternaryExpressionIR = expressionIR as ternaryExpressionIR

  clause 6 : (expressionIR) = $lift_castExpressionIR(castExpressionIR)
  -- if expressionIR <: castExpressionIR
  -- let castExpressionIR = expressionIR as castExpressionIR

  clause 7 : (expressionIR) = $lift_dataExpressionIR(dataExpressionIR) as expression
  -- if expressionIR <: dataExpressionIR
  -- let dataExpressionIR = expressionIR as dataExpressionIR

  clause 8 : (expressionIR) = $lift_accessExpressionIR(accessExpressionIR) as expression
  -- if expressionIR <: accessExpressionIR
  -- let accessExpressionIR = expressionIR as accessExpressionIR

  clause 9 : (expressionIR) = $lift_callExpressionIR(callExpressionIR) as expression
  -- if expressionIR <: callExpressionIR
  -- let callExpressionIR = expressionIR as callExpressionIR

  clause 10 : (expressionIR) = $lift_parenthesizedExpressionIR(parenthesizedExpressionIR) as expression
  -- if expressionIR <: parenthesizedExpressionIR
  -- let parenthesizedExpressionIR = expressionIR as parenthesizedExpressionIR

def $unflatten_expressionList(expression*) : expressionList =

  clause 0 : (expression*{expression <- expression*}) = _EMPTY
  -- if expression*{expression <- expression*} matches []

  clause 1 : (expression*{expression <- expression*}) = $unflatten_expressionList'(expression_h as expressionList, expression_t*{expression_t <- expression_t*})
  -- if expression*{expression <- expression*} matches _ :: _
  -- let expression_h :: expression_t*{expression_t <- expression_t*} = expression*{expression <- expression*}

def $unflatten_expressionList'(expressionList, expression*) : expressionList =

  clause 0 : (expressionList, expression*{expression <- expression*}) = expressionList
  -- if expression*{expression <- expression*} matches []

  clause 1 : (expressionList, expression*{expression <- expression*}) = $unflatten_expressionList'(expressionList ',' expression_h, expression_t*{expression_t <- expression_t*})
  -- if expression*{expression <- expression*} matches _ :: _
  -- let expression_h :: expression_t*{expression_t <- expression_t*} = expression*{expression <- expression*}

