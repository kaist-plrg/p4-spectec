  -- (let typeParameter = $lift_typeParameterIR(typeParameterIR))*{typeParameterIR <- typeParameterIR*, typeParameter -> typeParameter*}
  -- let typeParameterListOpt = $unflatten_typeParameterListOpt(typeParameter*{typeParameter <- typeParameter*})

def $unflatten_typeParameterListOpt(typeParameter*) : typeParameterListOpt =

  clause 0 : (typeParameter*{typeParameter <- typeParameter*}) = _EMPTY
  -- if typeParameter*{typeParameter <- typeParameter*} matches []

  clause 1 : (typeParameter*{typeParameter <- typeParameter*}) = `< $unflatten_typeParameterList(typeParameter_h :: typeParameter_t*{typeParameter_t <- typeParameter_t*}) `>
