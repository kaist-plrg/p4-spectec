relation ParserStmt_ok: TC |- parserStatement : % %

1. Case analysis on parserStatement

  1. Case (let emptyStatement be %, % has type emptyStatement)

    1. Group emptyStatement: TC |- (emptyStatement as parserStatement) : % %

      1. (Stmt_ok: (LOCAL) TC |- (emptyStatement as statement) : TC' statementIR)

      2. If ((TC' = TC)), then

        1. (Let emptyStatementIR be statementIR, statementIR has type emptyStatementIR)

