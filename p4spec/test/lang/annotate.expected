2. (Let B_tparams be (`{ (typeId_tparam_expl)*{typeId_tparam_expl <- typeId_tparam_expl*} ++ (typeId_tparam_impl)*{typeId_tparam_impl <- typeId_tparam_impl*} `}))

3. (Let callableTypeIR be $callableTypeIR_of_callableTypeDefIR(callableTypeDefIR))

