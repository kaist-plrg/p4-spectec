relation Enum_serializable_field_ok: TC_0 nameIR_enum typeIR |- (name '=' expression) : % %

1. Group : TC_0 nameIR_enum typeIR |- (name '=' expression) : % %

  1. (Expr_ok: (BLOCK) TC_0 |- expression : typedExpressionIR)

  2. (Let typedExpressionIR_cast be ! $cast_unary(typedExpressionIR, typeIR))

    1. If (($ctk_of_typedExpressionIR(typedExpressionIR_cast) matches pattern `LCTK`)), then

      1. (Expr_eval_lctk: (BLOCK) TC_0 |- typedExpressionIR_cast ~> value)

      2. (Let nameIR be $name(name))

      3. (Let varTypeIR be ((_EMPTY) typeIR (LCTK) ?(value)))

      4. (Let TC_1 be $add_var_t((BLOCK), TC_0, nameIR, varTypeIR))

      5. Result in: % % % |- % : TC_1 (nameIR '=' value)

    1. Else Dangling#9397

