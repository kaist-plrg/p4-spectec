  2. Case (let (_annotationList ABSTRACT (_typeIR nameIR `< _typeParameterListIR ',' _typeParameterListIR' `> `( parameterListIR `)) ';') be %, % matches pattern `% ABSTRACT % ;`)

    1. Return $callableId_IR(nameIR, parameterListIR)

def $callableId_of_externConstructorPrototypeIR((_annotationList nameIR `< ',' _typeParameterListIR `> `( (parameterIR)*{parameterIR <- parameterIR*} `) ';'))

1. Return $callableId_IR(nameIR, (parameterIR)*{parameterIR <- parameterIR*})

def $constructor_of_externConstructorPrototypeIR(typeParameterListIR_expl, externMethodPrototypeListIR, (_annotationList nameIR `< ',' typeParameterListIR_impl `> `( (parameterIR)*{parameterIR <- parameterIR*} `) ';'))

1. (Let typeParameterListIR be typeParameterListIR_expl ++ typeParameterListIR_impl)

2. (Let constructorDef be ((EXTERN nameIR `< typeParameterListIR `> `( (parameterIR)*{parameterIR <- parameterIR*} `) `{ externMethodPrototypeListIR `}) as constructorDef))

3. Return constructorDef

def $init_table((tablePropertyIR)*{tablePropertyIR <- tablePropertyIR*})

1. (Let tableKeysPropertyIR be $init_tableKeys((tablePropertyIR)*{tablePropertyIR <- tablePropertyIR*}))

2. (Let (tablePropertyIR')*{tablePropertyIR' <- tablePropertyIR'*} be $filter_<tablePropertyIR>((tablePropertyIR)*{tablePropertyIR <- tablePropertyIR*}, ((tablePropertyIR has type tableActionsPropertyIR))*{tablePropertyIR <- tablePropertyIR*}))

3. (Let (tableActionsPropertyIR')*{tableActionsPropertyIR' <- tableActionsPropertyIR'*} be (tablePropertyIR')*{tablePropertyIR' <- tablePropertyIR'*}, (tablePropertyIR')*{tablePropertyIR' <- tablePropertyIR'*} has type tableActionsPropertyIR*)

  1. (Let [tableActionsPropertyIR] be (tableActionsPropertyIR')*{tableActionsPropertyIR' <- tableActionsPropertyIR'*}, (tableActionsPropertyIR')*{tableActionsPropertyIR' <- tableActionsPropertyIR'*} matches pattern [ _/1 ])

    1. (Let (tablePropertyIR'')*{tablePropertyIR'' <- tablePropertyIR''*} be $filter_<tablePropertyIR>((tablePropertyIR)*{tablePropertyIR <- tablePropertyIR*}, ((tablePropertyIR has type tableDefaultActionPropertyIR))*{tablePropertyIR <- tablePropertyIR*}))

    2. (Let (tableDefaultActionPropertyIR')*{tableDefaultActionPropertyIR' <- tableDefaultActionPropertyIR'*} be (tablePropertyIR'')*{tablePropertyIR'' <- tablePropertyIR''*}, (tablePropertyIR'')*{tablePropertyIR'' <- tablePropertyIR''*} has type tableDefaultActionPropertyIR*)

      1. (Let [tableDefaultActionPropertyIR] be (tableDefaultActionPropertyIR')*{tableDefaultActionPropertyIR' <- tableDefaultActionPropertyIR'*}, (tableDefaultActionPropertyIR')*{tableDefaultActionPropertyIR' <- tableDefaultActionPropertyIR'*} matches pattern [ _/1 ])

        1. (Let tableEntriesPropertyIR be $init_tableEntries((tablePropertyIR)*{tablePropertyIR <- tablePropertyIR*}))

        2. (Let (tablePropertyIR''')*{tablePropertyIR''' <- tablePropertyIR'''*} be $filter_<tablePropertyIR>((tablePropertyIR)*{tablePropertyIR <- tablePropertyIR*}, ((tablePropertyIR has type tableCustomPropertyIR))*{tablePropertyIR <- tablePropertyIR*}))

        3. (Let (tableCustomPropertyIR)*{tableCustomPropertyIR <- tableCustomPropertyIR*} be (tablePropertyIR''')*{tablePropertyIR''' <- tablePropertyIR'''*}, (tablePropertyIR''')*{tablePropertyIR''' <- tablePropertyIR'''*} has type tableCustomPropertyIR*)

          1. (Let TBL be {KEYS tableKeysPropertyIR, ACTIONS tableActionsPropertyIR, DEFAULT_ACTION tableDefaultActionPropertyIR, ENTRIES tableEntriesPropertyIR, CUSTOMS (tableCustomPropertyIR)*{tableCustomPropertyIR <- tableCustomPropertyIR*}})

          2. Return TBL

def $init_tableKeys((tablePropertyIR)*{tablePropertyIR <- tablePropertyIR*})

1. Block (2 arms)

Arm 1:

  1. (Let (tablePropertyIR')*{tablePropertyIR' <- tablePropertyIR'*} be $filter_<tablePropertyIR>((tablePropertyIR)*{tablePropertyIR <- tablePropertyIR*}, ((tablePropertyIR has type tableKeysPropertyIR))*{tablePropertyIR <- tablePropertyIR*}))

  2. (Let (tableKeysPropertyIR')*{tableKeysPropertyIR' <- tableKeysPropertyIR'*} be (tablePropertyIR')*{tablePropertyIR' <- tablePropertyIR'*}, (tablePropertyIR')*{tablePropertyIR' <- tablePropertyIR'*} has type tableKeysPropertyIR*)

    1. (Let [tableKeysPropertyIR] be (tableKeysPropertyIR')*{tableKeysPropertyIR' <- tableKeysPropertyIR'*}, (tableKeysPropertyIR')*{tableKeysPropertyIR' <- tableKeysPropertyIR'*} matches pattern [ _/1 ])

      1. Return tableKeysPropertyIR

Arm 2:

  1. If (($filter_<tablePropertyIR>((tablePropertyIR)*{tablePropertyIR <- tablePropertyIR*}, ((tablePropertyIR has type tableKeysPropertyIR))*{tablePropertyIR <- tablePropertyIR*}) matches pattern [])), then

    1. Return (KEY '=' `{ [] `})

  1. Else Dangling#11264

def $init_tableEntries((tablePropertyIR)*{tablePropertyIR <- tablePropertyIR*})

1. Block (2 arms)

Arm 1:

  1. (Let (tablePropertyIR')*{tablePropertyIR' <- tablePropertyIR'*} be $filter_<tablePropertyIR>((tablePropertyIR)*{tablePropertyIR <- tablePropertyIR*}, ((tablePropertyIR has type tableEntriesPropertyIR))*{tablePropertyIR <- tablePropertyIR*}))

  2. (Let (tableEntriesPropertyIR')*{tableEntriesPropertyIR' <- tableEntriesPropertyIR'*} be (tablePropertyIR')*{tablePropertyIR' <- tablePropertyIR'*}, (tablePropertyIR')*{tablePropertyIR' <- tablePropertyIR'*} has type tableEntriesPropertyIR*)

    1. (Let [tableEntriesPropertyIR] be (tableEntriesPropertyIR')*{tableEntriesPropertyIR' <- tableEntriesPropertyIR'*}, (tableEntriesPropertyIR')*{tableEntriesPropertyIR' <- tableEntriesPropertyIR'*} matches pattern [ _/1 ])

      1. Return tableEntriesPropertyIR

Arm 2:

  1. If (($filter_<tablePropertyIR>((tablePropertyIR)*{tablePropertyIR <- tablePropertyIR*}, ((tablePropertyIR has type tableEntriesPropertyIR))*{tablePropertyIR <- tablePropertyIR*}) matches pattern [])), then

    1. Return ((_EMPTY) ?() ENTRIES '=' `{ [] `})

  1. Else Dangling#11272

syntax globalEvalLayer = globalInstLayer

syntax blockEvalLayer = blockInstLayer

syntax localEvalLayer = localInstLayer

syntax evalContext = {GLOBAL globalEvalLayer, BLOCK blockEvalLayer, LOCAL localEvalLayer}

var EC : evalContext

def $enter_e(EC)

1. Return EC[LOCAL.FRAMES = $empty_frame :: EC.LOCAL.FRAMES]

def $exit_e(EC)

1. (Let (frame)*{frame <- frame*} be EC.LOCAL.FRAMES)

2. (Let frame_h :: (frame_t)*{frame_t <- frame_t*} be (frame)*{frame <- frame*}, (frame)*{frame <- frame*} matches pattern _ :: _)

  1. Return EC[LOCAL.FRAMES = (frame_t)*{frame_t <- frame_t*}]

def $inherit_e(p, EC)

1. Case analysis on p

  1. Case (% matches pattern `GLOBAL`)

    1. (Let blockEvalLayer be {TYPE $empty_theta, CALLABLE $empty_callableDefEnv, STATE $empty_stateEnv, FRAME $empty_frame})

    2. (Let localEvalLayer be {TYPE $empty_theta, FRAMES [$empty_frame]})

    3. Return EC[BLOCK = blockEvalLayer][LOCAL = localEvalLayer]

  2. Case (% matches pattern `BLOCK`)

    1. (Let localEvalLayer be {TYPE $empty_theta, FRAMES [$empty_frame]})

    2. Return EC[LOCAL = localEvalLayer]

  3. Case (% matches pattern `LOCAL`)

    1. Return EC

def $copy_e(p, EC_from, EC_to)

1. Case analysis on p

  1. Case (% matches pattern `GLOBAL`)

    1. Return EC_to[GLOBAL = EC_from.GLOBAL]

  2. Case (% matches pattern `BLOCK`)

    1. Return EC_to[GLOBAL = EC_from.GLOBAL][BLOCK = EC_from.BLOCK]

  3. Case (% matches pattern `LOCAL`)

    1. Return EC_to[GLOBAL = EC_from.GLOBAL][BLOCK = EC_from.BLOCK][LOCAL = EC_from.LOCAL]

def $add_var_e(p, EC, prefixedNameIR, value)

1. Case analysis on p

  1. Case (% matches pattern `GLOBAL`)

    1. Case analysis on prefixedNameIR

      1. Case (let ('.' id) be %, % matches pattern `. %`)

        1. (Let frame be $add_map<id, value>(EC.GLOBAL.FRAME, id, value))

        2. Return EC[GLOBAL.FRAME = frame]

      2. Case (let (_BARE id) be %, % matches pattern `_BARE %`)

        1. (Let frame be $add_map<id, value>(EC.GLOBAL.FRAME, id, value))

        2. Return EC[GLOBAL.FRAME = frame]

  2. Case (% matches pattern `BLOCK`)

    1. (Let (_BARE id) be prefixedNameIR, prefixedNameIR matches pattern `_BARE %`)

      1. (Let frame be $add_map<id, value>(EC.BLOCK.FRAME, id, value))

      2. Return EC[BLOCK.FRAME = frame]

  3. Case (% matches pattern `LOCAL`)

    1. (Let (_BARE id) be prefixedNameIR, prefixedNameIR matches pattern `_BARE %`)

      1. (Let (frame)*{frame <- frame*} be EC.LOCAL.FRAMES)

      2. (Let frame_h :: (frame_t)*{frame_t <- frame_t*} be (frame)*{frame <- frame*}, (frame)*{frame <- frame*} matches pattern _ :: _)

        1. (Let frame_h' be $add_map<id, value>(frame_h, id, value))

        2. Return EC[LOCAL.FRAMES = frame_h' :: (frame_t)*{frame_t <- frame_t*}]

def $add_vars_e(p, EC, (prefixedNameIR)*{prefixedNameIR <- prefixedNameIR*}, (value)*{value <- value*})

1. Case analysis on (prefixedNameIR)*{prefixedNameIR <- prefixedNameIR*}

  1. Case (% matches pattern [])

    1. If (((value)*{value <- value*} matches pattern [])), then

      1. Return EC

    1. Else Dangling#11310

  2. Case (let prefixedNameIR_h :: (prefixedNameIR_t)*{prefixedNameIR_t <- prefixedNameIR_t*} be %, % matches pattern _ :: _)

    1. (Let value_h :: (value_t)*{value_t <- value_t*} be (value)*{value <- value*}, (value)*{value <- value*} matches pattern _ :: _)

      1. (Let EC' be $add_var_e(p, EC, prefixedNameIR_h, value_h))

      2. (Let EC'' be $add_vars_e(p, EC', (prefixedNameIR_t)*{prefixedNameIR_t <- prefixedNameIR_t*}, (value_t)*{value_t <- value_t*}))

      3. Return EC''

def $update_var_e(p, EC, prefixedNameIR, value)

1. Block (2 arms)

Arm 1:

  1. (Let ('.' id) be prefixedNameIR, prefixedNameIR matches pattern `. %`)

    1. (Let frame be $update_map<id, value>(EC.GLOBAL.FRAME, id, value))

    2. Return EC[GLOBAL.FRAME = frame]

Arm 2:

  1. Case analysis on p

    1. Case (% matches pattern `GLOBAL`)

      1. (Let (_BARE id) be prefixedNameIR, prefixedNameIR matches pattern `_BARE %`)

        1. (Let frame be EC.GLOBAL.FRAME)

        2. If ($in_set<id>(id, $dom_map<id, value>(frame))), then

          1. (Let frame' be $update_map<id, value>(frame, id, value))

          2. Return EC[GLOBAL.FRAME = frame']

        2. Else Dangling#11326

    2. Case (% matches pattern `BLOCK`)

      1. (Let (_BARE id) be prefixedNameIR, prefixedNameIR matches pattern `_BARE %`)

        1. (Let frame be EC.BLOCK.FRAME)

        2. Case analysis on $in_set<id>(id, $dom_map<id, value>(frame))

          1. Case true

            1. (Let frame' be $update_map<id, value>(frame, id, value))

            2. Return EC[BLOCK.FRAME = frame']

          2. Case false

            1. Return $update_var_e((GLOBAL), EC, (_BARE id), value)

    3. Case (% matches pattern `LOCAL`)

      1. (Let (_BARE id) be prefixedNameIR, prefixedNameIR matches pattern `_BARE %`)

        1. Block (2 arms)

        Arm 1:

          1. If ((EC.LOCAL.FRAMES matches pattern [])), then

            1. Return $update_var_e((BLOCK), EC, (_BARE id), value)

          1. Else Dangling#11338

        Arm 2:

          1. (Let (frame)*{frame <- frame*} be EC.LOCAL.FRAMES)

          2. (Let frame_h :: (frame_t)*{frame_t <- frame_t*} be (frame)*{frame <- frame*}, (frame)*{frame <- frame*} matches pattern _ :: _)

            1. Case analysis on $in_set<id>(id, $dom_map<id, value>(frame_h))

              1. Case true

                1. (Let frame_h' be $update_map<id, value>(frame_h, id, value))

                2. Return EC[LOCAL.FRAMES = frame_h' :: (frame_t)*{frame_t <- frame_t*}]

              2. Case false

                1. (Let EC_pop be EC[LOCAL.FRAMES = (frame_t)*{frame_t <- frame_t*}])

                2. (Let EC_pop' be $update_var_e((LOCAL), EC_pop, (_BARE id), value))

                3. Return EC_pop'[LOCAL.FRAMES = frame_h :: EC_pop'.LOCAL.FRAMES]

def $find_var_e(prefixedNameIR, p, EC)

1. Case analysis on prefixedNameIR

  1. Case (let ('.' id) be %, % matches pattern `. %`)

    1. (Let value be ! $find_map<id, value>(EC.GLOBAL.FRAME, id))

      1. Return value

  2. Case (let (_BARE id) be %, % matches pattern `_BARE %`)

    1. Case analysis on p

      1. Case (% matches pattern `GLOBAL`)

        1. (Let value be ! $find_map<id, value>(EC.GLOBAL.FRAME, id))

          1. Return value

      2. Case (% matches pattern `BLOCK`)

        1. Block (2 arms)

        Arm 1:

          1. (Let value be ! $find_map<id, value>(EC.BLOCK.FRAME, id))

            1. Return value

        Arm 2:

          1. If (($find_map<id, value>(EC.BLOCK.FRAME, id) matches pattern ())), then

            1. Return $find_var_e((_BARE id), (GLOBAL), EC)

          1. Else Dangling#11365

      3. Case (% matches pattern `LOCAL`)

        1. Block (2 arms)

        Arm 1:

          1. (Let value be ! $find_maps<id, value>(EC.LOCAL.FRAMES, id))

            1. Return value

        Arm 2:

          1. If (($find_maps<id, value>(EC.LOCAL.FRAMES, id) matches pattern ())), then

            1. Return $find_var_e((_BARE id), (BLOCK), EC)

          1. Else Dangling#11371

def $find_typeDef_e(_p, EC, prefixedNameIR)

1. Case analysis on prefixedNameIR

  1. Case (let (_BARE nameIR) be %, % matches pattern `_BARE %`)

    1. Return $find_map<typeId, typeDefIR>(EC.GLOBAL.TYPE, nameIR)

  2. Case (let ('.' nameIR) be %, % matches pattern `. %`)

    1. Return $find_map<typeId, typeDefIR>(EC.GLOBAL.TYPE, nameIR)

def $find_type_e(p, EC, nameIR)

1. Case analysis on p

  1. Case (% matches pattern `BLOCK`)

    1. Return $find_map<typeId, typeIR>(EC.BLOCK.TYPE, nameIR)

  2. Case (% matches pattern `LOCAL`)

    1. Block (2 arms)

    Arm 1:

      1. (Let typeIR be ! $find_map<typeId, typeIR>(EC.LOCAL.TYPE, nameIR))

        1. Return ?(typeIR)

    Arm 2:

      1. If (($find_map<typeId, typeIR>(EC.LOCAL.TYPE, nameIR) matches pattern ())), then

        1. Return $find_type_e((BLOCK), EC, nameIR)

      1. Else Dangling#11384

1. Else Dangling#11378

def $find_callableDef_overloaded_e(p, EC, prefixedNameIR, (argumentIR)*{argumentIR <- argumentIR*})

1. Case analysis on p

  1. Case (% matches pattern `GLOBAL`)

    1. Case analysis on prefixedNameIR

      1. Case (let (_BARE nameIR) be %, % matches pattern `_BARE %`)

        1. (Let callTargetKey be $callTargetKey(nameIR, (argumentIR)*{argumentIR <- argumentIR*}))

        2. Block (2 arms)

        Arm 1:

          1. (Let (callableId ':' callableDef '#' (id_default)*{id_default <- id_default*} '#' (id_optional)*{id_optional <- id_optional*}) be ! $find_overloaded<callableDef>(EC.GLOBAL.CALLABLE, callTargetKey, $parameterListIR_of_callableDef))

            1. Return ?((callableId ':' ((GLOBAL), callableDef) '#' (id_default)*{id_default <- id_default*} '#' (id_optional)*{id_optional <- id_optional*}))

        Arm 2:

          1. If (($find_overloaded<callableDef>(EC.GLOBAL.CALLABLE, callTargetKey, $parameterListIR_of_callableDef) matches pattern ())), then

            1. Return ?()

          1. Else Dangling#11394

      2. Case (let ('.' nameIR) be %, % matches pattern `. %`)

        1. (Let callTargetKey be $callTargetKey(nameIR, (argumentIR)*{argumentIR <- argumentIR*}))

        2. Block (2 arms)

        Arm 1:

          1. (Let (callableId ':' callableDef '#' (id_default)*{id_default <- id_default*} '#' (id_optional)*{id_optional <- id_optional*}) be ! $find_overloaded<callableDef>(EC.GLOBAL.CALLABLE, callTargetKey, $parameterListIR_of_callableDef))

            1. Return ?((callableId ':' ((GLOBAL), callableDef) '#' (id_default)*{id_default <- id_default*} '#' (id_optional)*{id_optional <- id_optional*}))

        Arm 2:

          1. If (($find_overloaded<callableDef>(EC.GLOBAL.CALLABLE, callTargetKey, $parameterListIR_of_callableDef) matches pattern ())), then

            1. Return ?()

          1. Else Dangling#11402

  2. Case (% matches pattern `BLOCK`)

    1. (Let (_BARE nameIR) be prefixedNameIR, prefixedNameIR matches pattern `_BARE %`)

      1. (Let callTargetKey be $callTargetKey(nameIR, (argumentIR)*{argumentIR <- argumentIR*}))

      2. Block (2 arms)

      Arm 1:

        1. (Let (callableId ':' callableDef '#' (id_default)*{id_default <- id_default*} '#' (id_optional)*{id_optional <- id_optional*}) be ! $find_overloaded<callableDef>(EC.BLOCK.CALLABLE, callTargetKey, $parameterListIR_of_callableDef))

          1. Return ?((callableId ':' ((BLOCK), callableDef) '#' (id_default)*{id_default <- id_default*} '#' (id_optional)*{id_optional <- id_optional*}))

      Arm 2:

        1. If (($find_overloaded<callableDef>(EC.BLOCK.CALLABLE, callTargetKey, $parameterListIR_of_callableDef) matches pattern ())), then

          1. Return $find_callableDef_overloaded_e((GLOBAL), EC, (_BARE nameIR), (argumentIR)*{argumentIR <- argumentIR*})

        1. Else Dangling#11411

  3. Case (% matches pattern `LOCAL`)

    1. (Let (_BARE nameIR) be prefixedNameIR, prefixedNameIR matches pattern `_BARE %`)

      1. Return $find_callableDef_overloaded_e((BLOCK), EC, (_BARE nameIR), (argumentIR)*{argumentIR <- argumentIR*})

def $find_constructorDef_e(EC, prefixedNameIR, (argumentIR)*{argumentIR <- argumentIR*})

1. Case analysis on prefixedNameIR

  1. Case (let (_BARE nameIR) be %, % matches pattern `_BARE %`)

    1. (Let callTargetKey be $callTargetKey(nameIR, (argumentIR)*{argumentIR <- argumentIR*}))

    2. Return $find_overloaded<constructorDef>(EC.GLOBAL.CONSTRUCTOR, callTargetKey, $parameterListIR_of_constructorDef)

  2. Case (let ('.' nameIR) be %, % matches pattern `. %`)

    1. (Let callTargetKey be $callTargetKey(nameIR, (argumentIR)*{argumentIR <- argumentIR*}))

    2. Return $find_overloaded<constructorDef>(EC.GLOBAL.CONSTRUCTOR, callTargetKey, $parameterListIR_of_constructorDef)

def $find_parserState_e(EC, nameIR)

1. Return $find_map<nameIR, parserStateIR>(EC.BLOCK.STATE, nameIR)

def $subst_type_e(p, EC, typeIR)

1. Case analysis on p

  1. Case (% matches pattern `GLOBAL`)

    1. Return typeIR

  2. Case (% matches pattern `BLOCK`)

    1. (Let theta be EC.BLOCK.TYPE)

    2. (Let typeIR_subst be $subst_typeIR(theta, typeIR))

    3. Return typeIR_subst

  3. Case (% matches pattern `LOCAL`)

    1. (Let theta_block be EC.BLOCK.TYPE)

    2. (Let theta_local be EC.LOCAL.TYPE)

    3. (Let theta be $extend_map<typeId, typeIR>(theta_block, theta_local))

    4. (Let typeIR_subst be $subst_typeIR(theta, typeIR))

    5. Return typeIR_subst

extern syntax archState

extern def $init_archState

syntax arch = {STATE archState, STORE store}

var ARCH : arch

def $add_object_e(ARCH, objectId, object)

1. (Let STO be $add_map<objectId, object>(ARCH.STORE, objectId, object))

2. Return ARCH[STORE = STO]

def $find_archState_e(ARCH)

1. Return ARCH.STATE

def $find_object_e(ARCH, objectId)

1. Return $find_map<objectId, object>(ARCH.STORE, objectId)

def $find_object_qualified_e(ARCH, objectId)

1. Return $find_object_e(ARCH, objectId)

def $find_object_unqualified_e(ARCH, id)

1. (Let (`{ ((objectId ':' object))*{object <- object*, objectId <- objectId*} `}) be ARCH.STORE)

2. (Let (object_id)?{object_id <- object_id?} be $ite<object?>($objectId_ends_with(objectId, id), ?(object), ?()))*

3. (Let ((object'')?{object'' <- object''?})*{object''? <- object''?*} be $filter_<object?>(((object_id)?{object_id <- object_id?})*{object_id? <- object_id?*}, (((object_id)?{object_id <- object_id?} =/= ?()))*{object_id? <- object_id?*}))

4. (Let [(object')?{object' <- object'?}] be ((object'')?{object'' <- object''?})*{object''? <- object''?*}, ((object'')?{object'' <- object''?})*{object''? <- object''?*} matches pattern [ _/1 ])

  1. (Let ?(object_id_found) be (object')?{object' <- object'?}, (object')?{object' <- object'?} matches pattern (_))

    1. Return ?(object_id_found)

5. Otherwise,

  1. Return ?()

def $find_objectState_e(ARCH, objectId)

1. (Let object be ! $find_object_e(ARCH, objectId))

  1. (Let externObject be object, object has type externObject)

    1. (Let (EXTERN _typeId `< _theta `> `{ objectState _frame _externMethodDefEnv `}) be externObject)

    2. Return ?(objectState)

2. Otherwise,

  1. Return ?()

def $update_archState_e(ARCH, archState)

1. Return ARCH[STATE = archState]

def $update_object_qualified_e(ARCH_0, objectId, object)

1. If (($find_object_qualified_e(ARCH_0, objectId) matches pattern (_))), then

  1. (Let ARCH_1 be $add_object_e(ARCH_0, objectId, object))

  2. Return ARCH_1

1. Else Dangling#11457

def $update_object_unqualified_e(ARCH_0, id, object)

1. (Let (`{ ((objectId ':' _object))*{_object <- _object*, objectId <- objectId*} `}) be ARCH_0.STORE)

2. (Let (objectId_id)?{objectId_id <- objectId_id?} be $ite<objectId?>($objectId_ends_with(objectId, id), ?(objectId), ?()))*

3. (Let ((objectId'')?{objectId'' <- objectId''?})*{objectId''? <- objectId''?*} be $filter_<objectId?>(((objectId_id)?{objectId_id <- objectId_id?})*{objectId_id? <- objectId_id?*}, (((objectId_id)?{objectId_id <- objectId_id?} =/= ?()))*{objectId_id? <- objectId_id?*}))

4. (Let [(objectId')?{objectId' <- objectId'?}] be ((objectId'')?{objectId'' <- objectId''?})*{objectId''? <- objectId''?*}, ((objectId'')?{objectId'' <- objectId''?})*{objectId''? <- objectId''?*} matches pattern [ _/1 ])

  1. (Let ?(objectId_found) be (objectId')?{objectId' <- objectId'?}, (objectId')?{objectId' <- objectId'?} matches pattern (_))

    1. (Let ARCH_1 be $add_object_e(ARCH_0, objectId_found, object))

    2. Return ARCH_1

def $update_objectState_e(ARCH_0, objectId, objectState)

1. (Let object be ! $find_object_e(ARCH_0, objectId))

  1. (Let externObject be object, object has type externObject)

    1. (Let (EXTERN typeId `< theta `> `{ _objectState frame externMethodDefEnv `}) be externObject)

    2. (Let externObject_update be (EXTERN typeId `< theta `> `{ objectState frame externMethodDefEnv `}))

    3. (Let ARCH_1 be $add_object_e(ARCH_0, objectId, (externObject_update as object)))

    4. Return ?(ARCH_1)

2. Otherwise,

  1. Return ?()

syntax continueEmptyResult = 
   | _EMPTY (from continueEmptyResult) 

syntax continueResult<X> = 
   | _CONT X (from continueResult<X>) 

syntax exitResult = 
   | EXIT (from exitResult) 

syntax returnResult = 
   | RETURN value? (from returnResult) 

syntax acceptTransitionResult = 
   | ACCEPT (from acceptTransitionResult) 

syntax rejectTransitionResult = 
   | REJECT errorValue (from rejectTransitionResult) 

syntax stateTransitionResult = 
   | STATE id (from stateTransitionResult) 

syntax abortResult = 
   | EXIT (from exitResult) 
   | REJECT errorValue (from rejectTransitionResult) 

syntax expressionResult = 
   | _CONT value (from continueResult<value>) 
   | EXIT (from exitResult) 
   | REJECT errorValue (from rejectTransitionResult) 

relation Expr_eval: p EC ARCH |- (expressionIR '#' expressionNoteIR) : % % %

1. Block (2 arms)

Arm 1:

  1. Group literalExpressionIR: p EC ARCH |- (expressionIR '#' expressionNoteIR) : % % %

    1. Case analysis on expressionIR

      1. Case (let booleanLiteral be %, % has type booleanLiteral)

        1. (Let boolValue be $ite<boolValue>((booleanLiteral = (TRUE)), (_B true), (_B false)))

        2. (Let expressionResult be ((_CONT (boolValue as value)) as expressionResult))

        3. Result in: % % % |- % : EC ARCH expressionResult

      2. Case (let integerLiteral be %, % has type integerLiteral)

        1. (Let expressionResult be ((_CONT (integerLiteral as value)) as expressionResult))

        2. Result in: % % % |- % : EC ARCH expressionResult

      3. Case (let stringLiteral be %, % has type stringLiteral)

        1. (Let expressionResult be ((_CONT (stringLiteral as value)) as expressionResult))

        2. Result in: % % % |- % : EC ARCH expressionResult

    1. Else Dangling#11480

Arm 2:

  1. Case analysis on expressionIR

    1. Case (let prefixedNameIR be %, % has type prefixedNameIR)

      1. Group referenceExpressionIR: p EC ARCH |- ((prefixedNameIR as expressionIR) '#' expressionNoteIR) : % % %

        1. (Let value be $find_var_e(prefixedNameIR, p, EC))

        2. (Let expressionResult be ((_CONT value) as expressionResult))

        3. Result in: % % % |- % : EC ARCH expressionResult

    2. Case (let defaultExpression be %, % has type defaultExpression)

      1. Group defaultExpressionIR: p EC ARCH |- ((('...') as expressionIR) '#' expressionNoteIR) : % % %

        1. (Let expressionResult be ((_CONT ((DEFAULT) as value)) as expressionResult))

        2. Result in: % % % |- % : EC ARCH expressionResult

    3. Case (let (unop typedExpressionIR) be %, % has type unaryExpressionIR)

      1. Group unaryExpressionIR: p EC ARCH |- (((unop typedExpressionIR) as expressionIR) '#' expressionNoteIR) : % % %

        1. (Expr_eval: p EC ARCH |- typedExpressionIR : EC_1 ARCH_1 expressionResult')

