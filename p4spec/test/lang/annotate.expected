syntax calleeResult = 
   | _CONT callee (from continueResult<callee>) 
   | EXIT (from exitResult) 
   | REJECT errorValue (from rejectTransitionResult) 

relation Callee_eval: p EC ARCH |- callableTargetIR' `< '_' `> `( argumentListIR `) : % % %

1. Block (5 arms)

Arm 1:

  1. Case analysis on callableTargetIR'

    1. Case (let referenceExpressionIR be %, % has type referenceExpressionIR)

      1. Block (3 arms)

      Arm 1:

        1. Group actionCallee: p EC ARCH |- (referenceExpressionIR as callableTargetIR) `< '_' `> `( argumentListIR `) : % % %

          1. (Let (_callableId ':' (cursor, callableDef) '#' (id_default)*{id_default <- id_default*} '#' (_nameIR)*{_nameIR <- _nameIR*}) be ! $find_callableDef_overloaded_e(p, EC, referenceExpressionIR, argumentListIR))

            1. (Let (p_ref, actionDef) be (cursor, callableDef), (cursor, callableDef) has type (cursor, actionDef))

              1. (Let (_annotationList ACTION nameIR `( parameterListIR `) blockStatementIR) be actionDef)

              2. (Let actionCallee be (ACTION p_ref '.' nameIR `( parameterListIR '#' (id_default)*{id_default <- id_default*} `) blockStatementIR))

              3. Result in: % % % |- % `< '_' `> `( % `) : EC ARCH ((_CONT (actionCallee as callee)) as calleeResult)

      Arm 2:

        1. Group externFunctionCallee: p EC ARCH |- (referenceExpressionIR as callableTargetIR) `< '_' `> `( argumentListIR `) : % % %

          1. (Let (_callableId ':' (_p, callableDef) '#' (id_default)*{id_default <- id_default*} '#' (id_optional)*{id_optional <- id_optional*}) be ! $find_callableDef_overloaded_e(p, EC, referenceExpressionIR, argumentListIR))

            1. (Let externFunctionDef be callableDef, callableDef has type externFunctionDef)

              1. (Let (EXTERN_FUNCTION nameIR `< typeParameterListIR `> `( parameterListIR `)) be externFunctionDef)

              2. (Let externFunctionCallee be (EXTERN_FUNCTION nameIR `< typeParameterListIR `> `( parameterListIR '#' (id_default)*{id_default <- id_default*} '#' (id_optional)*{id_optional <- id_optional*} `)))

              3. Result in: % % % |- % `< '_' `> `( % `) : EC ARCH ((_CONT (externFunctionCallee as callee)) as calleeResult)

      Arm 3:

        1. Group definedFunctionCallee: p EC ARCH |- (referenceExpressionIR as callableTargetIR) `< '_' `> `( argumentListIR `) : % % %

          1. (Let (_callableId ':' (_p, callableDef) '#' (id_default)*{id_default <- id_default*} '#' (_nameIR)*{_nameIR <- _nameIR*}) be ! $find_callableDef_overloaded_e(p, EC, referenceExpressionIR, argumentListIR))

            1. (Let definedFunctionDef be callableDef, callableDef has type definedFunctionDef)

              1. (Let (FUNCTION nameIR `< typeParameterListIR `> `( parameterListIR `) blockStatementIR) be definedFunctionDef)

              2. (Let definedFunctionCallee be (FUNCTION nameIR `< typeParameterListIR `> `( parameterListIR '#' (id_default)*{id_default <- id_default*} `) blockStatementIR))

