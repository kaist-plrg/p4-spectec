        3. Case (let (text_key_prefix_value _SLASH n_key_prefix_width) be %, % matches pattern `% _SLASH %`)

          1. (Let text_key_prefix_value_rev be $reverse_bytes_of_hex(text_key_prefix_value))

          2. (Let i_key_prefix_value be $text_to_int(text_key_prefix_value_rev))

          3. (Let n_key_type_width be $sizeof_maxSizeInBits'(typeIR))

          4. If ((n_key_prefix_width <= n_key_type_width)), then

            1. (Let i be (n_key_type_width - n_key_prefix_width))

            2. (Let n_key_remaining_width be i, i has type nat)

