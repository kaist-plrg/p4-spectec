        2. (Let [(callableId_found ':' V_found '#' (id_default)*{id_default <- id_default*} '#' (id_optional)*{id_optional <- id_optional*})] be (callResolution<V>)*{callResolution<V> <- callResolution<V>*}, (callResolution<V>)*{callResolution<V> <- callResolution<V>*} matches pattern [ _/1 ])

          1. Return ?((callableId_found ':' V_found '#' (id_default)*{id_default <- id_default*} '#' (id_optional)*{id_optional <- id_optional*}))

    1. Else Dangling#2968

  1. Else Dangling#2967

Arm 2:

  1. If (((id_arg)?{id_arg <- id_arg?} matches pattern ()))*{id_arg? <- id_arg?*}, then

    1. Block (2 arms)

    Arm 1:

      1. If (($find_overloadeds_unnamed<V>((`{ ((callableId ':' V))*{V <- V*, callableId <- callableId*} `}), (nameIR_f `( |((id_arg)?{id_arg <- id_arg?})*{id_arg? <- id_arg?*}| `)), $get_parameterListIR) matches pattern [])), then

