                1. (Let int be $pow2(n_key_type_width))

                2. (Let int' be $pow2(n_key_remaining_width))

                3. (Let i_key_mask_value be (int - int'))

                4. (Let typedExpressionIR_mask_cast be ! $cast_control_plane(EC, typedExpressionIR_base, typeIR))

