    2. Return ((CONTROL_APPLY `( (parameterIR_subst)*{parameterIR_subst <- parameterIR_subst*} `)) as callableTypeIR)

  8. Case (let tableApplyMethodTypeIR be %, % has type tableApplyMethodTypeIR)

    1. Return (tableApplyMethodTypeIR as callableTypeIR)

