                      1. (Let (HEADER _typeId `{ _b ';' ((value_field id_field ';'))*{id_field <- id_field*, value_field <- value_field*} `}) be headerValue_base)

                      2. (Let value_member be ! $assoc_<nameIR, value>(nameIR, ((id_field, value_field))*{id_field <- id_field*, value_field <- value_field*}))

