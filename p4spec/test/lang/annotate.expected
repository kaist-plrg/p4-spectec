  1. Case analysis on (parserLocalDeclarationIR)*{parserLocalDeclarationIR <- parserLocalDeclarationIR*}

    1. Case (% matches pattern [])

      1. Result in: % % |- % : EC ARCH ((_EMPTY) as parserStatementResult)

    2. Case (let parserLocalDeclarationIR_h :: parserLocalDeclarationListIR_t be %, % matches pattern _ :: _)

      1. (ParserLocalDecl_eval: EC ARCH |- parserLocalDeclarationIR_h : EC_1 ARCH_1 parserDeclarationResult)

      2. Case analysis on parserDeclarationResult

