  14. Case (let (EXTERN _typeId `< (typeArgumentIR)*{typeArgumentIR <- typeArgumentIR*} `> (`{ ((_callableId ':' externMethodTypeDefIR))*{_callableId <- _callableId*, externMethodTypeDefIR <- externMethodTypeDefIR*} `})) be %, % has type externObjectTypeIR)

