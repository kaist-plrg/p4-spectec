relation Parameter_ok: p TC |- (annotationList direction type name initializerOpt) : % '#' %

1. Group : p TC |- (annotationList direction type name initializerOpt) : % '#' %

  1. Case analysis on initializerOpt

    1. Case (% matches pattern `/* empty */`)

      1. (Type_ok: p TC |- (type as typeOrVoid) : typeIR '#' (typeId_fresh)*{typeId_fresh <- typeId_fresh*})

      2. (Let bound be $bound(p, TC))

      3. (Let B be $union_set<typeId>(bound, (`{ (typeId_fresh)*{typeId_fresh <- typeId_fresh*} `})))

      4. If (Type_wf: B |- typeIR) holds, then

        1. (Let nameIR be $name(name))

        2. (Let parameterIR be (annotationList direction typeIR nameIR ?()))

        3. Result in: % % |- % : parameterIR '#' (typeId_fresh)*{typeId_fresh <- typeId_fresh*}

      4. Else Dangling#7334

    2. Case (let ('=' expression_init) be %, % has type initializer)

      1. (Type_ok: p TC |- (type as typeOrVoid) : typeIR '#' (typeId_fresh)*{typeId_fresh <- typeId_fresh*})

      2. (Let bound' be $bound(p, TC))

      3. (Let B be $union_set<typeId>(bound', (`{ (typeId_fresh)*{typeId_fresh <- typeId_fresh*} `})))

      4. If (Type_wf: B |- typeIR) holds, then

        1. (Expr_ok: p TC |- expression_init : typedExpressionIR_init)

        2. (Let typeIR_init be $type_of_typedExpressionIR(typedExpressionIR_init))

        3. Case analysis on $ctk_of_typedExpressionIR(typedExpressionIR_init)

          1. Case (% matches pattern `CTK`)

            1. (Let typedExpressionIR_init_cast be ! $cast_unary(typedExpressionIR_init, typeIR))

              1. (Let nameIR be $name(name))

              2. (Let parameterInitializerIR be (('=' typedExpressionIR_init_cast) as parameterInitializerIR))

              3. (Let parameterIR be (annotationList direction typeIR nameIR ?(parameterInitializerIR)))

              4. Result in: % % |- % : parameterIR '#' (typeId_fresh)*{typeId_fresh <- typeId_fresh*}

          2. Case (% matches pattern `LCTK`)

            1. (Let typedExpressionIR_init_cast be ! $cast_unary(typedExpressionIR_init, typeIR))

              1. (Let nameIR be $name(name))

              2. (Expr_eval_lctk: p TC |- typedExpressionIR_init_cast ~> value_init)

              3. (Let parameterInitializerIR be (('=' _VALUE value_init) as parameterInitializerIR))

              4. (Let parameterIR be (annotationList direction typeIR nameIR ?(parameterInitializerIR)))

              5. Result in: % % |- % : parameterIR '#' (typeId_fresh)*{typeId_fresh <- typeId_fresh*}

        3. Else Dangling#7344

      4. Else Dangling#7341

