        1. (TypeParameterListOpt_ok: (LOCAL) TC_0 |- typeParameterListOpt : TC_1 (typeId_expl)*{typeId_expl <- typeId_expl*})

        2. (Type_ok: (LOCAL) TC_1 |- typeOrVoid : typeIR_ret '#' (typeId)*{typeId <- typeId*})

        3. If (((typeId)*{typeId <- typeId*} matches pattern [])), then

          1. (Let TC_2 be TC_1[LOCAL.KIND = ((EXTERN_METHOD ':' typeIR_ret) as localKind)])

          2. (ParameterList_ok: (LOCAL) TC_2 |- parameterList : TC_3 (parameterIR)*{parameterIR <- parameterIR*} '#' (typeId_impl)*{typeId_impl <- typeId_impl*})

          3. (Let externMethodTypeDefIR be (EXTERN_METHOD nameIR `< (typeId_expl)*{typeId_expl <- typeId_expl*} ',' (typeId_impl)*{typeId_impl <- typeId_impl*} `> `( (parameterIR)*{parameterIR <- parameterIR*} `) ':' typeIR_ret))

          4. (Let bound be $bound((BLOCK), TC_0))

          5. If (CallableTypeDef_wf: bound |- (externMethodTypeDefIR as callableTypeDefIR)) holds, then

            1. (Let externMethodPrototypeIR be (annotationList (typeIR_ret nameIR `< (typeId_expl)*{typeId_expl <- typeId_expl*} ',' (typeId_impl)*{typeId_impl <- typeId_impl*} `> `( (parameterIR)*{parameterIR <- parameterIR*} `)) ';'))

            2. Result in: % % |- % : externMethodPrototypeIR

          5. Else Dangling#7395

        3. Else Dangling#7391

      3. Else Dangling#7388

    2. Case (let (annotationList ABSTRACT functionPrototype ';') be %, % matches pattern `% ABSTRACT % ;`)

      1. (Let (typeOrVoid name typeParameterListOpt `( parameterList `)) be functionPrototype)

      2. (Let nameIR be $name(name))

