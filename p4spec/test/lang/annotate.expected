def $expressionNonBrace_as_expression(expressionNonBrace')

1. Case analysis on expressionNonBrace'

  1. Case (let literalExpression be %, % has type literalExpression)

    1. Return (literalExpression as expression)

  2. Case (let referenceExpression be %, % has type referenceExpression)

    1. Return (referenceExpression as expression)

  3. Case (let unaryExpression be %, % has type unaryExpression)

    1. Return (unaryExpression as expression)

  4. Case (let (expressionNonBrace_l binop expression_r) be %, % has type binaryExpressionNonBrace)

    1. (Let expression_l be $expressionNonBrace_as_expression(expressionNonBrace_l))

    2. Return ((expression_l binop expression_r) as expression)

  5. Case (let (expressionNonBrace_cond '?' expression_true ':' expression_false) be %, % has type ternaryExpressionNonBrace)

    1. (Let expression_cond be $expressionNonBrace_as_expression(expressionNonBrace_cond))

    2. Return ((expression_cond '?' expression_true ':' expression_false) as expression)

  6. Case (let castExpression be %, % has type castExpression)

    1. Return (castExpression as expression)

  7. Case (let errorAccessExpression be %, % has type errorAccessExpression)

    1. Return (errorAccessExpression as expression)

  8. Case (let (memberAccessBaseNonBrace '.' member) be %, % has type memberAccessExpressionNonBrace)

    1. Case analysis on memberAccessBaseNonBrace

      1. Case (let prefixedTypeName be %, % has type prefixedTypeName)

        1. Return (((prefixedTypeName as memberAccessBase) '.' member) as expression)

      2. Case (let expressionNonBrace_base be %, % has type expressionNonBrace)

        1. (Let expression_base be $expressionNonBrace_as_expression(expressionNonBrace_base))

        2. Return (((expression_base as memberAccessBase) '.' member) as expression)

  9. Case (let (expressionNonBrace_base `[ expression_index `]) be %, % has type indexAccessExpressionNonBrace)

    1. (Let expression_base be $expressionNonBrace_as_expression(expressionNonBrace_base))

    2. Return ((expression_base `[ expression_index `]) as expression)

  10. Case (let (expressionNonBrace_base `[ expression_hi sliceop expression_lo `]) be %, % has type sliceAccessExpressionNonBrace)

    1. Case analysis on sliceop

      1. Case (% matches pattern `:`)

        1. (Let expression_base be $expressionNonBrace_as_expression(expressionNonBrace_base))

        2. Return ((expression_base `[ expression_hi (':') expression_lo `]) as expression)

      2. Case (% matches pattern `+:`)

        1. (Let expression_base be $expressionNonBrace_as_expression(expressionNonBrace_base))

        2. Return ((expression_base `[ expression_hi ('+:') expression_lo `]) as expression)

  11. Case (let callExpressionNonBrace be %, % has type callExpressionNonBrace)

    1. Case analysis on callExpressionNonBrace

      1. Case (let (callTargetNonBrace `( argumentList `)) be %, % matches pattern `% (%)`)

        1. Case analysis on callTargetNonBrace

          1. Case (let expressionNonBrace be %, % has type expressionNonBrace)

            1. (Let expression be $expressionNonBrace_as_expression(expressionNonBrace))

            2. Return (((expression as callTarget) `( argumentList `)) as expression)

          2. Case (let constructorTarget be %, % has type constructorTarget)

            1. Return (((constructorTarget as callTarget) `( argumentList `)) as expression)

      2. Case (let (expressionNonBrace `< realTypeArgumentList `> `( argumentList `)) be %, % matches pattern `% <%> (%)`)

        1. (Let expression be $expressionNonBrace_as_expression(expressionNonBrace))

        2. Return ((expression `< realTypeArgumentList `> `( argumentList `)) as expression)

  12. Case (let parenthesizedExpression be %, % has type parenthesizedExpression)

    1. Return (parenthesizedExpression as expression)

def $expression_as_expressionNonBrace(expression')

1. Case analysis on expression'

  1. Case (let literalExpression be %, % has type literalExpression)

    1. Return (literalExpression as expressionNonBrace)

  2. Case (let referenceExpression be %, % has type referenceExpression)

    1. Return (referenceExpression as expressionNonBrace)

  3. Case (let unaryExpression be %, % has type unaryExpression)

    1. Return (unaryExpression as expressionNonBrace)

  4. Case (let (expression_l binop expression_r) be %, % has type binaryExpression)

    1. (Let expressionNonBrace_l be $expression_as_expressionNonBrace(expression_l))

    2. Return ((expressionNonBrace_l binop expression_r) as expressionNonBrace)

  5. Case (let (expression_cond '?' expression_true ':' expression_false) be %, % has type ternaryExpression)

    1. (Let expressionNonBrace_cond be $expression_as_expressionNonBrace(expression_cond))

    2. Return ((expressionNonBrace_cond '?' expression_true ':' expression_false) as expressionNonBrace)

  6. Case (let castExpression be %, % has type castExpression)

    1. Return (castExpression as expressionNonBrace)

  7. Case (let errorAccessExpression be %, % has type errorAccessExpression)

    1. Return (errorAccessExpression as expressionNonBrace)

  8. Case (let (memberAccessBase '.' member) be %, % has type memberAccessExpression)

    1. Case analysis on memberAccessBase

      1. Case (let prefixedTypeName be %, % has type prefixedTypeName)

        1. Return (((prefixedTypeName as memberAccessBaseNonBrace) '.' member) as expressionNonBrace)

      2. Case (let expression_base be %, % has type expression)

        1. (Let expressionNonBrace_base be $expression_as_expressionNonBrace(expression_base))

        2. Return (((expressionNonBrace_base as memberAccessBaseNonBrace) '.' member) as expressionNonBrace)

  9. Case (let (expression_base `[ expression_index `]) be %, % has type indexAccessExpression)

    1. (Let expressionNonBrace_base be $expression_as_expressionNonBrace(expression_base))

    2. Return ((expressionNonBrace_base `[ expression_index `]) as expressionNonBrace)

  10. Case (let (expression_base `[ expression_hi sliceop expression_lo `]) be %, % has type sliceAccessExpression)

    1. If ((sliceop matches pattern `:`)), then

      1. (Let expressionNonBrace_base be $expression_as_expressionNonBrace(expression_base))

      2. Return ((expressionNonBrace_base `[ expression_hi (':') expression_lo `]) as expressionNonBrace)

    1. Else Dangling#220

  11. Case (let callExpression be %, % has type callExpression)

    1. Case analysis on callExpression

      1. Case (let (callTarget `( argumentList `)) be %, % matches pattern `% (%)`)

        1. Case analysis on callTarget

          1. Case (let expression be %, % has type expression)

            1. (Let expressionNonBrace be $expression_as_expressionNonBrace(expression))

            2. Return (((expressionNonBrace as callTargetNonBrace) `( argumentList `)) as expressionNonBrace)

          2. Case (let constructorTarget be %, % has type constructorTarget)

            1. Return (((constructorTarget as callTargetNonBrace) `( argumentList `)) as expressionNonBrace)

      2. Case (let (expression `< realTypeArgumentList `> `( argumentList `)) be %, % matches pattern `% <%> (%)`)

        1. (Let expressionNonBrace be $expression_as_expressionNonBrace(expression))

        2. Return ((expressionNonBrace `< realTypeArgumentList `> `( argumentList `)) as expressionNonBrace)

  12. Case (let parenthesizedExpression be %, % has type parenthesizedExpression)

    1. Return (parenthesizedExpression as expressionNonBrace)

1. Else Dangling#192

