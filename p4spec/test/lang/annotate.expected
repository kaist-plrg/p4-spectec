tbl def $nestable_typedef(typeIR'')
=

  Row : ((BOOL) as typeIR) -> true:

    1. (Let boolTypeIR be typeIR'', typeIR'' has type boolTypeIR)

      1. Return true

  Row : ((ERROR) as typeIR) -> true:

    1. (Let errorTypeIR be typeIR'', typeIR'' has type errorTypeIR)

      1. Return true

  Row : ((STRING) as typeIR) -> true:

    1. (Let stringTypeIR be typeIR'', typeIR'' has type stringTypeIR)

      1. Return true

  Row : (integerTypeIR as typeIR) -> true:

    1. If ((typeIR'' has type integerTypeIR)), then

      1. Return true

  Row : (nameTypeIR as typeIR) -> true:

    1. If ((typeIR'' has type nameTypeIR)), then

      1. Return true

  Row : ((TYPEDEF _typeId typeIR) as typeIR) -> $nestable_typedef(typeIR):

    1. (Let (TYPEDEF _typeId typeIR) be typeIR'', typeIR'' has type typedefTypeIR)

      1. Return $nestable_typedef(typeIR)

  Row : (newTypeIR as typeIR) -> true:

    1. If ((typeIR'' has type newTypeIR)), then

