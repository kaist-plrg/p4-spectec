syntax tablePropertyIR = 
   | KEY '=' `{ tableKeyListIR `} (from tableKeysPropertyIR) 
   | ACTIONS '=' `{ tableActionListIR `} (from tableActionsPropertyIR) 
   | annotationList constOptIR DEFAULT_ACTION '=' tableActionReferenceIR ';' (from tableDefaultActionPropertyIR) 
   | annotationList constOptIR ENTRIES '=' `{ tableEntryListIR `} (from tableEntriesPropertyIR) 
   | annotationList constOptIR CUSTOM nameIR initializerIR ';' (from tableCustomPropertyIR) 
   | annotationList constOptIR CUSTOM_CONST nameIR constantInitializerIR ';' (from tableCustomPropertyIR) 

syntax tablePropertyListIR = tablePropertyIR*

syntax tableDeclarationIR = 
   | annotationList TABLE typeIR nameIR `{ tablePropertyListIR `} (from tableDeclarationIR)  hint(print %0 TABLE %2 ``{%3`})

syntax controlTypeDeclarationIR = 
   | annotationList CONTROL nameIR `< typeParameterListIR ',' typeParameterListIR `> `( parameterListIR `) ';' (from controlTypeDeclarationIR) 

syntax controlBodyIR = blockStatementIR

syntax controlLocalDeclarationIR = 
   | annotationList CONST typeIR nameIR constantInitializerIR ';' (from constantDeclarationIR) 
   | annotationList typeIR constructorTargetIR `( argumentListIR `) nameIR objectInitializerOptIR ';' (from instantiationIR)  hint(prose_fields "annotations" "type" "constructor target" "arguments" "name" "object initializer")
   | annotationList typeIR nameIR initializerOptIR ';' (from variableDeclarationIR) 
   | annotationList ACTION nameIR `( parameterListIR `) blockStatementIR (from actionDeclarationIR) 
   | annotationList TABLE typeIR nameIR `{ tablePropertyListIR `} (from tableDeclarationIR)  hint(print %0 TABLE %2 ``{%3`})

syntax controlLocalDeclarationListIR = controlLocalDeclarationIR*

syntax controlDeclarationIR = 
   | annotationList CONTROL nameIR `< typeParameterListIR ',' typeParameterListIR `> `( parameterListIR `) `( constructorParameterListIR `) `{ controlLocalDeclarationListIR APPLY controlBodyIR `} (from controlDeclarationIR) 

syntax packageTypeDeclarationIR = 
   | annotationList PACKAGE nameIR `< typeParameterListIR ',' typeParameterListIR `> `( parameterListIR `) ';' (from packageTypeDeclarationIR) 

syntax typeDeclarationIR = 
   | annotationList ENUM nameIR `{ nameListIR `} (from enumTypeDeclarationIR) 
   | annotationList ENUM typeIR nameIR `{ namedValueListIR `} (from enumTypeDeclarationIR) 
   | annotationList STRUCT nameIR `< typeParameterListIR `> `{ typeFieldListIR `} (from structTypeDeclarationIR) 
   | annotationList HEADER nameIR `< typeParameterListIR `> `{ typeFieldListIR `} (from headerTypeDeclarationIR) 
   | annotationList HEADER_UNION nameIR `< typeParameterListIR `> `{ typeFieldListIR `} (from headerUnionTypeDeclarationIR) 
   | annotationList TYPEDEF typedefIR nameIR ';' (from typedefDeclarationIR) 
   | annotationList TYPE typeIR nameIR ';' (from typedefDeclarationIR) 
   | annotationList PARSER nameIR `< typeParameterListIR ',' typeParameterListIR `> `( parameterListIR `) ';' (from parserTypeDeclarationIR) 
   | annotationList CONTROL nameIR `< typeParameterListIR ',' typeParameterListIR `> `( parameterListIR `) ';' (from controlTypeDeclarationIR) 
   | annotationList PACKAGE nameIR `< typeParameterListIR ',' typeParameterListIR `> `( parameterListIR `) ';' (from packageTypeDeclarationIR) 

syntax declarationIR = 
   | annotationList CONST typeIR nameIR constantInitializerIR ';' (from constantDeclarationIR) 
   | annotationList typeIR constructorTargetIR `( argumentListIR `) nameIR objectInitializerOptIR ';' (from instantiationIR)  hint(prose_fields "annotations" "type" "constructor target" "arguments" "name" "object initializer")
   | annotationList functionPrototypeIR blockStatementIR (from functionDeclarationIR) 
   | annotationList ACTION nameIR `( parameterListIR `) blockStatementIR (from actionDeclarationIR) 
   | ERROR `{ nameListIR `} (from errorDeclarationIR) 
   | MATCH_KIND `{ nameListIR `} (from matchKindDeclarationIR) 
   | annotationList EXTERN functionPrototypeIR ';' (from externFunctionDeclarationIR) 
   | annotationList EXTERN nameIR `< typeParameterListIR ',' `> `{ externConstructorPrototypeListIR externMethodPrototypeListIR `} (from externObjectDeclarationIR) 
   | annotationList PARSER nameIR `< typeParameterListIR ',' typeParameterListIR `> `( parameterListIR `) `( constructorParameterListIR `) `{ parserLocalDeclarationListIR parserStateListIR `} (from parserDeclarationIR) 
   | annotationList CONTROL nameIR `< typeParameterListIR ',' typeParameterListIR `> `( parameterListIR `) `( constructorParameterListIR `) `{ controlLocalDeclarationListIR APPLY controlBodyIR `} (from controlDeclarationIR) 
   | annotationList ENUM nameIR `{ nameListIR `} (from enumTypeDeclarationIR) 
   | annotationList ENUM typeIR nameIR `{ namedValueListIR `} (from enumTypeDeclarationIR) 
   | annotationList STRUCT nameIR `< typeParameterListIR `> `{ typeFieldListIR `} (from structTypeDeclarationIR) 
   | annotationList HEADER nameIR `< typeParameterListIR `> `{ typeFieldListIR `} (from headerTypeDeclarationIR) 
   | annotationList HEADER_UNION nameIR `< typeParameterListIR `> `{ typeFieldListIR `} (from headerUnionTypeDeclarationIR) 
   | annotationList TYPEDEF typedefIR nameIR ';' (from typedefDeclarationIR) 
   | annotationList TYPE typeIR nameIR ';' (from typedefDeclarationIR) 
   | annotationList PARSER nameIR `< typeParameterListIR ',' typeParameterListIR `> `( parameterListIR `) ';' (from parserTypeDeclarationIR) 
   | annotationList CONTROL nameIR `< typeParameterListIR ',' typeParameterListIR `> `( parameterListIR `) ';' (from controlTypeDeclarationIR) 
   | annotationList PACKAGE nameIR `< typeParameterListIR ',' typeParameterListIR `> `( parameterListIR `) ';' (from packageTypeDeclarationIR) 

syntax p4programIR = 
   | declarationIR* ';' (from p4programIR) 

def $partition_parameterListIR((parameterIR)*{parameterIR <- parameterIR*}, (nameIR)*{nameIR <- nameIR*}, (nameIR')*{nameIR' <- nameIR'*})

1. Case analysis on (parameterIR)*{parameterIR <- parameterIR*}

  1. Case (% matches pattern [])

    1. Return ([], [], [])

  2. Case (let parameterIR_h :: (parameterIR_t)*{parameterIR_t <- parameterIR_t*} be %, % matches pattern _ :: _)

    1. (Let ((parameterIR_given)*{parameterIR_given <- parameterIR_given*}, (parameterIR_default)*{parameterIR_default <- parameterIR_default*}, (parameterIR_optional)*{parameterIR_optional <- parameterIR_optional*}) be $partition_parameterListIR((parameterIR_t)*{parameterIR_t <- parameterIR_t*}, (nameIR)*{nameIR <- nameIR*}, (nameIR')*{nameIR' <- nameIR'*}))

    2. (Destruct (_annotationList, _direction, _typeIR, nameIR_h, _parameterInitializerOptIR) = parameterIR_h)

    3. Block (2 arms)

    Arm 1:

      1. Case analysis on nameIR_h is in (nameIR)*{nameIR <- nameIR*}

        1. Case true

          1. Return ((parameterIR_given)*{parameterIR_given <- parameterIR_given*}, parameterIR_h :: (parameterIR_default)*{parameterIR_default <- parameterIR_default*}, (parameterIR_optional)*{parameterIR_optional <- parameterIR_optional*})

        2. Case false

          1. If (~nameIR_h is in (nameIR')*{nameIR' <- nameIR'*}), then

            1. Return (parameterIR_h :: (parameterIR_given)*{parameterIR_given <- parameterIR_given*}, (parameterIR_default)*{parameterIR_default <- parameterIR_default*}, (parameterIR_optional)*{parameterIR_optional <- parameterIR_optional*})

          1. Else Dangling#2868

    Arm 2:

      1. If (nameIR_h is in (nameIR')*{nameIR' <- nameIR'*}), then

        1. Return ((parameterIR_given)*{parameterIR_given <- parameterIR_given*}, (parameterIR_default)*{parameterIR_default <- parameterIR_default*}, parameterIR_h :: (parameterIR_optional)*{parameterIR_optional <- parameterIR_optional*})

      1. Else Dangling#2870

syntax callAlign = 
   | GIVEN parameterIR* DEFAULT parameterIR* OPTIONAL parameterIR* (from callAlign) 

def $align_parameterListIR((parameterIR)*{parameterIR <- parameterIR*}, (argumentIR)*{argumentIR <- argumentIR*}, (nameIR_default)*{nameIR_default <- nameIR_default*}, (nameIR_optional)*{nameIR_optional <- nameIR_optional*})

1. (Let ((parameterIR_given)*{parameterIR_given <- parameterIR_given*}, (parameterIR_default)*{parameterIR_default <- parameterIR_default*}, (parameterIR_optional)*{parameterIR_optional <- parameterIR_optional*}) be $partition_parameterListIR((parameterIR)*{parameterIR <- parameterIR*}, (nameIR_default)*{nameIR_default <- nameIR_default*}, (nameIR_optional)*{nameIR_optional <- nameIR_optional*}))

2. (Let (_annotationList _direction _typeIR nameIR_given _parameterInitializerOptIR) be parameterIR_given)*

3. (Let (parameterIR_given_aligned)*{parameterIR_given_aligned <- parameterIR_given_aligned*} be $align_parameterListIR_given((`{ ((nameIR_given ':' parameterIR_given))*{nameIR_given <- nameIR_given*, parameterIR_given <- parameterIR_given*} `}), (parameterIR_given)*{parameterIR_given <- parameterIR_given*}, (argumentIR)*{argumentIR <- argumentIR*}))

4. Return (GIVEN (parameterIR_given_aligned)*{parameterIR_given_aligned <- parameterIR_given_aligned*} DEFAULT (parameterIR_default)*{parameterIR_default <- parameterIR_default*} OPTIONAL (parameterIR_optional)*{parameterIR_optional <- parameterIR_optional*})

def $align_parameterListIR_given((`{ ((id ':' parameterIR))*{id <- id*, parameterIR <- parameterIR*} `}), (parameterIR')*{parameterIR' <- parameterIR'*}, (argumentIR)*{argumentIR <- argumentIR*})

1. Case analysis on (parameterIR')*{parameterIR' <- parameterIR'*}

  1. Case (% matches pattern [])

    1. If (((argumentIR)*{argumentIR <- argumentIR*} matches pattern [])), then

      1. Return []

    1. Else Dangling#2877

  2. Case (let parameterIR_h :: (parameterIR_t)*{parameterIR_t <- parameterIR_t*} be %, % matches pattern _ :: _)

    1. (Let argumentIR_h :: (argumentIR_t)*{argumentIR_t <- argumentIR_t*} be (argumentIR)*{argumentIR <- argumentIR*}, (argumentIR)*{argumentIR <- argumentIR*} matches pattern _ :: _)

      1. Case analysis on argumentIR_h

        1. Case (% has type typedExpressionIR)

          1. (Let (parameterIR_aligned)*{parameterIR_aligned <- parameterIR_aligned*} be $align_parameterListIR_given((`{ ((id ':' parameterIR))*{id <- id*, parameterIR <- parameterIR*} `}), (parameterIR_t)*{parameterIR_t <- parameterIR_t*}, (argumentIR_t)*{argumentIR_t <- argumentIR_t*}))

          2. Return parameterIR_h :: (parameterIR_aligned)*{parameterIR_aligned <- parameterIR_aligned*}

        2. Case (% matches pattern `_`)

          1. (Let (parameterIR_aligned)*{parameterIR_aligned <- parameterIR_aligned*} be $align_parameterListIR_given((`{ ((id ':' parameterIR))*{id <- id*, parameterIR <- parameterIR*} `}), (parameterIR_t)*{parameterIR_t <- parameterIR_t*}, (argumentIR_t)*{argumentIR_t <- argumentIR_t*}))

          2. Return parameterIR_h :: (parameterIR_aligned)*{parameterIR_aligned <- parameterIR_aligned*}

        3. Case (let (nameIR '=' _typedExpressionIR) be %, % matches pattern `% = %`)

          1. (Let parameterIR_match be ! $find_map<id, parameterIR>((`{ ((id ':' parameterIR))*{id <- id*, parameterIR <- parameterIR*} `}), nameIR))

            1. (Let (parameterIR_aligned)*{parameterIR_aligned <- parameterIR_aligned*} be $align_parameterListIR_given((`{ ((id ':' parameterIR))*{id <- id*, parameterIR <- parameterIR*} `}), (parameterIR_t)*{parameterIR_t <- parameterIR_t*}, (argumentIR_t)*{argumentIR_t <- argumentIR_t*}))

            2. Return parameterIR_match :: (parameterIR_aligned)*{parameterIR_aligned <- parameterIR_aligned*}

        4. Case (let (nameIR '=' '_') be %, % matches pattern `% = _`)

          1. (Let parameterIR_match be ! $find_map<id, parameterIR>((`{ ((id ':' parameterIR))*{id <- id*, parameterIR <- parameterIR*} `}), nameIR))

            1. (Let (parameterIR_aligned)*{parameterIR_aligned <- parameterIR_aligned*} be $align_parameterListIR_given((`{ ((id ':' parameterIR))*{id <- id*, parameterIR <- parameterIR*} `}), (parameterIR_t)*{parameterIR_t <- parameterIR_t*}, (argumentIR_t)*{argumentIR_t <- argumentIR_t*}))

            2. Return parameterIR_match :: (parameterIR_aligned)*{parameterIR_aligned <- parameterIR_aligned*}

syntax callTargetKey = 
   | nameIR `( id?* `) (from callTargetKey) 

syntax namedCallTargetKey = 
   | nameIR `( id* `) (from namedCallTargetKey) 

syntax unnamedCallTargetKey = 
   | nameIR `( nat `) (from unnamedCallTargetKey) 

syntax callTargetParameter = 
   | nameIR '#' bool '#' bool (from callTargetParameter) 

syntax callTargetValue = callTargetParameter*

syntax callTargetMatch = 
   | MATCH id* id* (from callTargetMatch)  hint(prose MATCH "with defaults" %0 and "optionals" %1)
   | NOMATCH (from callTargetMatch) 

syntax callResolution<V> = 
   | callableId ':' V '#' nameIR* '#' nameIR* (from callResolution<V>)  hint(prose_fields "call target id" "call target" "defaults" "optionals")

def $callTargetKey(nameIR_f, (argumentIR)*{argumentIR <- argumentIR*})

1. (Let (id_arg)?{id_arg <- id_arg?} be $callTargetKey'(argumentIR))*

2. Return (nameIR_f `( ((id_arg)?{id_arg <- id_arg?})*{id_arg? <- id_arg?*} `))

def $callTargetKey'(argumentIR)

1. Case analysis on argumentIR

  1. Case (% has type typedExpressionIR)

    1. Return ?()

  2. Case (let (id_arg '=' _typedExpressionIR) be %, % matches pattern `% = %`)

    1. Return ?(id_arg)

  3. Case (let (id_arg '=' '_') be %, % matches pattern `% = _`)

    1. Return ?(id_arg)

  4. Case (% matches pattern `_`)

    1. Return ?()

def $match_overloaded_named<V>((callTargetId ':' V), (nameIR_f `( (id_arg)*{id_arg <- id_arg*} `)), $get_parameterListIR(V) : parameterListIR)

1. (Let (nameIR `( (id_param)*{id_param <- id_param*} `)) be callTargetId)

2. If ((nameIR = nameIR_f)), then

  1. (Let (parameterIR)*{parameterIR <- parameterIR*} be $get_parameterListIR(V))

  2. If ((|(id_param)*{id_param <- id_param*}| = |(parameterIR)*{parameterIR <- parameterIR*}|)), then

    1. If ((id_param = $id_of_parameterIR(parameterIR)))*{id_param <- id_param*, parameterIR <- parameterIR*}, then

      1. Block (2 arms)

      Arm 1:

        1. If ((|(id_param)*{id_param <- id_param*}| = |(id_arg)*{id_arg <- id_arg*}|)), then

          1. (Let bool be $eq_set<id>((`{ (id_param)*{id_param <- id_param*} `}), (`{ (id_arg)*{id_arg <- id_arg*} `})))

          2. Return $ite<callTargetMatch>(bool, (MATCH [] []), (NOMATCH))

      Arm 2:

        1. (Let b_default be $is_default_parameterIR(parameterIR))*

        2. (Let b_optional be $is_optional_parameterIR(parameterIR))*

        3. If ((|(id_param)*{id_param <- id_param*}| > |(id_arg)*{id_arg <- id_arg*}|)), then

          1. (Let (`{ (id_param_omitted)*{id_param_omitted <- id_param_omitted*} `}) be $diff_set<id>((`{ (id_param)*{id_param <- id_param*} `}), (`{ (id_arg)*{id_arg <- id_arg*} `})))

          2. (Let bool'' be $is_default_parameterIR(parameterIR))*

          3. (Let (id_default_param)*{id_default_param <- id_default_param*} be $filter_<id>((id_param)*{id_param <- id_param*}, (bool'')*{bool'' <- bool''*}))

          4. (Let (id_default)*{id_default <- id_default*} be $filter_<id>((id_param_omitted)*{id_param_omitted <- id_param_omitted*}, (id_param_omitted is in (id_default_param)*{id_default_param <- id_default_param*})*{id_param_omitted <- id_param_omitted*}))

          5. (Let bool' be $is_optional_parameterIR(parameterIR))*

          6. (Let (id_optional_param)*{id_optional_param <- id_optional_param*} be $filter_<id>((id_param)*{id_param <- id_param*}, (bool')*{bool' <- bool'*}))

          7. (Let (id_optional)*{id_optional <- id_optional*} be $filter_<id>((id_param_omitted)*{id_param_omitted <- id_param_omitted*}, (id_param_omitted is in (id_optional_param)*{id_optional_param <- id_optional_param*})*{id_param_omitted <- id_param_omitted*}))

          8. If ($eq_set<id>((`{ (id_default)*{id_default <- id_default*} ++ (id_optional)*{id_optional <- id_optional*} `}), (`{ (id_param_omitted)*{id_param_omitted <- id_param_omitted*} `}))), then

            1. Return (MATCH (id_default)*{id_default <- id_default*} (id_optional)*{id_optional <- id_optional*})

3. Otherwise,

  1. Return (NOMATCH)

def $match_overloaded_unnamed<V>((callTargetId ':' V), (nameIR_f `( n_arg `)), $get_parameterListIR(V) : parameterListIR)

1. (Let (nameIR `( (id_param)*{id_param <- id_param*} `)) be callTargetId)

2. If ((nameIR = nameIR_f)), then

  1. (Let (parameterIR)*{parameterIR <- parameterIR*} be $get_parameterListIR(V))

  2. (Let b_default be $is_default_parameterIR(parameterIR))*

  3. (Let b_optional be $is_optional_parameterIR(parameterIR))*

  4. If (~($exists_((b_default)*{b_default <- b_default*}) /\ $exists_((b_optional)*{b_optional <- b_optional*}))), then

    1. Block (2 arms)

    Arm 1:

      1. If ((|(id_param)*{id_param <- id_param*}| = n_arg)), then

        1. Return (MATCH [] [])

    Arm 2:

      1. If ((|(id_param)*{id_param <- id_param*}| > n_arg)), then

        1. (Let ((parameterIR_given)*{parameterIR_given <- parameterIR_given*}, (parameterIR_omitted)*{parameterIR_omitted <- parameterIR_omitted*}) be $partition_<parameterIR>((parameterIR)*{parameterIR <- parameterIR*}, n_arg))

        2. Block (2 arms)

        Arm 1:

          1. If (~$is_optional_parameterIR(parameterIR_omitted))*{parameterIR_omitted <- parameterIR_omitted*}, then

            1. If ($is_default_parameterIR(parameterIR_omitted))*{parameterIR_omitted <- parameterIR_omitted*}, then

              1. (Let id_default be $id_of_parameterIR(parameterIR_omitted))*

              2. Return (MATCH (id_default)*{id_default <- id_default*} [])

        Arm 2:

          1. If (~$is_default_parameterIR(parameterIR_given))*{parameterIR_given <- parameterIR_given*}, then

            1. If ($is_optional_parameterIR(parameterIR_omitted))*{parameterIR_omitted <- parameterIR_omitted*}, then

              1. (Let id_optional be $id_of_parameterIR(parameterIR_omitted))*

              2. Return (MATCH [] (id_optional)*{id_optional <- id_optional*})

3. Otherwise,

  1. Return (NOMATCH)

def $find_overloadeds_named<V>(set<pair<callableId, V>>, (nameIR_f `( (id_arg)*{id_arg <- id_arg*} `)), $get_parameterListIR(V) : parameterListIR)

1. Block (2 arms)

Arm 1:

  1. If ((set<pair<callableId, V>> = (`{ [] `}))), then

    1. Return []

  1. Else Dangling#2945

Arm 2:

  1. (Let (`{ (pair<callableId, V>)*{pair<callableId, V> <- pair<callableId, V>*} `}) be set<pair<callableId, V>>)

  2. (Let (callTargetId_h ':' V_h) :: ((callTargetId_t ':' V_t))*{V_t <- V_t*, callTargetId_t <- callTargetId_t*} be (pair<callableId, V>)*{pair<callableId, V> <- pair<callableId, V>*}, (pair<callableId, V>)*{pair<callableId, V> <- pair<callableId, V>*} matches pattern _ :: _)

    1. Block (2 arms)

    Arm 1:

      1. If (($match_overloaded_named<V>((callTargetId_h ':' V_h), (nameIR_f `( (id_arg)*{id_arg <- id_arg*} `)), $get_parameterListIR) matches pattern `NOMATCH`)), then

        1. Return $find_overloadeds_named<V>((`{ ((callTargetId_t ':' V_t))*{V_t <- V_t*, callTargetId_t <- callTargetId_t*} `}), (nameIR_f `( (id_arg)*{id_arg <- id_arg*} `)), $get_parameterListIR)

      1. Else Dangling#2950

    Arm 2:

      1. (Let callTargetMatch be $match_overloaded_named<V>((callTargetId_h ':' V_h), (nameIR_f `( (id_arg)*{id_arg <- id_arg*} `)), $get_parameterListIR))

      2. (Let (MATCH (id_default)*{id_default <- id_default*} (id_optional)*{id_optional <- id_optional*}) be callTargetMatch, callTargetMatch matches pattern `MATCH % %`)

        1. (Let (callResolution<V>)*{callResolution<V> <- callResolution<V>*} be $find_overloadeds_named<V>((`{ ((callTargetId_t ':' V_t))*{V_t <- V_t*, callTargetId_t <- callTargetId_t*} `}), (nameIR_f `( (id_arg)*{id_arg <- id_arg*} `)), $get_parameterListIR))

        2. Return (callTargetId_h ':' V_h '#' (id_default)*{id_default <- id_default*} '#' (id_optional)*{id_optional <- id_optional*}) :: (callResolution<V>)*{callResolution<V> <- callResolution<V>*}

