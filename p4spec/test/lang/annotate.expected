    1. Case (% matches pattern [])

      1. Return true

    2. Case (let direction_h :: (direction_t)*{direction_t <- direction_t*} be %, % matches pattern _ :: _)

      1. If (~(direction_h matches pattern `/* empty */`)), then

        1. Return $directionless_trailing'(false, (direction_t)*{direction_t <- direction_t*})

      1. Else Dangling#5277

Arm 2:

  1. Case analysis on b

    1. Case (% = true)

      1. (Let direction :: (direction_t)*{direction_t <- direction_t*} be (direction')*{direction' <- direction'*}, (direction')*{direction' <- direction'*} matches pattern _ :: _)

        1. If ((direction matches pattern `/* empty */`)), then

          1. Return $directionless_trailing'(true, (direction_t)*{direction_t <- direction_t*})

        1. Else Dangling#5282

    2. Case (% = false)

      1. (Let direction :: (direction_t)*{direction_t <- direction_t*} be (direction')*{direction' <- direction'*}, (direction')*{direction' <- direction'*} matches pattern _ :: _)

        1. If ((direction matches pattern `/* empty */`)), then

          1. Return false

        1. Else Dangling#5286

tbl def $nestable_action(typeIR'')
=

  Row : ((INT) as typeIR) -> false:

    1. (Let intTypeIR be typeIR'', typeIR'' has type intTypeIR)

      1. Return false

  Row : ((TYPEDEF _typeId typeIR) as typeIR) -> $nestable_action(typeIR):

    1. (Let (TYPEDEF _typeId typeIR) be typeIR'', typeIR'' has type typedefTypeIR)

      1. Return $nestable_action(typeIR)

  Row : (objectTypeIR as typeIR) -> false:

    1. If ((typeIR'' has type objectTypeIR)), then

      1. Return false

  Row : (synthesizedTypeIR as typeIR) -> false:

    1. If ((typeIR'' has type synthesizedTypeIR)), then

      1. Return false

  Row : _typeIR -> true:

    1. Return true

