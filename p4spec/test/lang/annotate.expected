def $subst_callableTypeIR'(theta, callableTypeIR)

1. Case analysis on callableTypeIR

  1. Case (let (annotationList ACTION nameIR `( (parameterIR)*{parameterIR <- parameterIR*} `)) be %, % has type actionTypeIR)

    1. (Let parameterIR_subst be $subst_parameterIR'(theta, parameterIR))*

    2. Return ((annotationList ACTION nameIR `( (parameterIR_subst)*{parameterIR_subst <- parameterIR_subst*} `)) as callableTypeIR)

  2. Case (let (FUNCTION nameIR `( (parameterIR)*{parameterIR <- parameterIR*} `) ':' typeIR) be %, % has type definedFunctionTypeIR)

    1. (Let parameterIR_subst be $subst_parameterIR'(theta, parameterIR))*

    2. (Let typeIR_subst be $subst_typeIR'(theta, typeIR))

    3. Return ((FUNCTION nameIR `( (parameterIR_subst)*{parameterIR_subst <- parameterIR_subst*} `) ':' typeIR_subst) as callableTypeIR)

  3. Case (let (EXTERN_FUNCTION nameIR `( (parameterIR)*{parameterIR <- parameterIR*} `) ':' typeIR) be %, % has type externFunctionTypeIR)

    1. (Let parameterIR_subst be $subst_parameterIR'(theta, parameterIR))*

    2. (Let typeIR_subst be $subst_typeIR'(theta, typeIR))

    3. Return ((EXTERN_FUNCTION nameIR `( (parameterIR_subst)*{parameterIR_subst <- parameterIR_subst*} `) ':' typeIR_subst) as callableTypeIR)

  4. Case (let builtinMethodTypeIR be %, % has type builtinMethodTypeIR)

    1. Return (builtinMethodTypeIR as callableTypeIR)

  5. Case (let externMethodTypeIR be %, % has type externMethodTypeIR)

    1. Case analysis on externMethodTypeIR

      1. Case (let (EXTERN_METHOD nameIR `( (parameterIR)*{parameterIR <- parameterIR*} `) ':' typeIR) be %, % matches pattern `EXTERN_METHOD % (%) : %`)

        1. (Let parameterIR_subst be $subst_parameterIR'(theta, parameterIR))*

        2. (Let typeIR_subst be $subst_typeIR'(theta, typeIR))

        3. Return ((EXTERN_METHOD nameIR `( (parameterIR_subst)*{parameterIR_subst <- parameterIR_subst*} `) ':' typeIR_subst) as callableTypeIR)

      2. Case (let (EXTERN_METHOD ABSTRACT nameIR `( (parameterIR)*{parameterIR <- parameterIR*} `) ':' typeIR) be %, % matches pattern `EXTERN_METHOD ABSTRACT % (%) : %`)

        1. (Let parameterIR_subst be $subst_parameterIR'(theta, parameterIR))*

        2. (Let typeIR_subst be $subst_typeIR'(theta, typeIR))

        3. Return ((EXTERN_METHOD ABSTRACT nameIR `( (parameterIR_subst)*{parameterIR_subst <- parameterIR_subst*} `) ':' typeIR_subst) as callableTypeIR)

  6. Case (let (PARSER_APPLY `( (parameterIR)*{parameterIR <- parameterIR*} `)) be %, % has type parserApplyMethodTypeIR)

    1. (Let parameterIR_subst be $subst_parameterIR'(theta, parameterIR))*

    2. Return ((PARSER_APPLY `( (parameterIR_subst)*{parameterIR_subst <- parameterIR_subst*} `)) as callableTypeIR)

  7. Case (let (CONTROL_APPLY `( (parameterIR)*{parameterIR <- parameterIR*} `)) be %, % has type controlApplyMethodTypeIR)

