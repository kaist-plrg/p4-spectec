    1. Case analysis on integerLiteral

      1. Case (let (D i) be %, % matches pattern `D %`)

        1. Return i

      2. Case (let (w S i) be %, % matches pattern `% S %`)

        1. Return $bitstr_to_int((w as int), i)

      3. Case (let (w W i) be %, % matches pattern `% W %`)

        1. Return i

  2. Case (let (_nat '.' _nat' V i) be %, % matches pattern `% . % V %`)

    1. Return i

def $nat_of_integerValue(integerValue)

1. (Let i be $int_of_integerValue(integerValue))

2. (Let n be i, i has type nat)

  1. Return ?(n)

3. Otherwise,

  1. Return ?()

