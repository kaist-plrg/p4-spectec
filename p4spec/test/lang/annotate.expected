def $subst_callableTypeDefIR'(theta, callableTypeDefIR)

1. Case analysis on callableTypeDefIR

  1. Case (let actionTypeDefIR be %, % has type actionTypeDefIR)

    1. (Let callableTypeIR be $subst_callableTypeIR'(theta, (actionTypeDefIR as callableTypeIR)))

    2. (Let actionTypeDefIR_subst be callableTypeIR, callableTypeIR has type actionTypeDefIR)

      1. Return (actionTypeDefIR_subst as callableTypeDefIR)

  2. Case (let (FUNCTION nameIR `< (typeParameterIR_expl)*{typeParameterIR_expl <- typeParameterIR_expl*} ',' (typeParameterIR_impl)*{typeParameterIR_impl <- typeParameterIR_impl*} `> `( (parameterIR)*{parameterIR <- parameterIR*} `) ':' typeIR) be %, % has type definedFunctionTypeDefIR)

    1. (Let B be $free_callableTypeIR(((FUNCTION nameIR `( (parameterIR)*{parameterIR <- parameterIR*} `) ':' typeIR) as callableTypeIR)))

    2. (Let (theta_fresh, (typeParameterIR_expl_fresh)*{typeParameterIR_expl_fresh <- typeParameterIR_expl_fresh*}, (typeParameterIR_impl_fresh)*{typeParameterIR_impl_fresh <- typeParameterIR_impl_fresh*}) be $capture_avoiding(theta, (typeParameterIR_expl)*{typeParameterIR_expl <- typeParameterIR_expl*}, (typeParameterIR_impl)*{typeParameterIR_impl <- typeParameterIR_impl*}, B))

    3. (Let parameterIR_subst be $subst_parameterIR(theta_fresh, parameterIR))*

    4. (Let typeIR_subst be $subst_typeIR(theta_fresh, typeIR))

    5. Return ((FUNCTION nameIR `< (typeParameterIR_expl_fresh)*{typeParameterIR_expl_fresh <- typeParameterIR_expl_fresh*} ',' (typeParameterIR_impl_fresh)*{typeParameterIR_impl_fresh <- typeParameterIR_impl_fresh*} `> `( (parameterIR_subst)*{parameterIR_subst <- parameterIR_subst*} `) ':' typeIR_subst) as callableTypeDefIR)

  3. Case (let (EXTERN_FUNCTION nameIR `< (typeParameterIR_expl)*{typeParameterIR_expl <- typeParameterIR_expl*} ',' (typeParameterIR_impl)*{typeParameterIR_impl <- typeParameterIR_impl*} `> `( (parameterIR)*{parameterIR <- parameterIR*} `) ':' typeIR) be %, % has type externFunctionTypeDefIR)

    1. (Let B be $free_callableTypeIR(((EXTERN_FUNCTION nameIR `( (parameterIR)*{parameterIR <- parameterIR*} `) ':' typeIR) as callableTypeIR)))

    2. (Let (theta_fresh, (typeParameterIR_expl_fresh)*{typeParameterIR_expl_fresh <- typeParameterIR_expl_fresh*}, (typeParameterIR_impl_fresh)*{typeParameterIR_impl_fresh <- typeParameterIR_impl_fresh*}) be $capture_avoiding(theta, (typeParameterIR_expl)*{typeParameterIR_expl <- typeParameterIR_expl*}, (typeParameterIR_impl)*{typeParameterIR_impl <- typeParameterIR_impl*}, B))

    3. (Let parameterIR_subst be $subst_parameterIR(theta_fresh, parameterIR))*

    4. (Let typeIR_subst be $subst_typeIR(theta_fresh, typeIR))

    5. Return ((EXTERN_FUNCTION nameIR `< (typeParameterIR_expl_fresh)*{typeParameterIR_expl_fresh <- typeParameterIR_expl_fresh*} ',' (typeParameterIR_impl_fresh)*{typeParameterIR_impl_fresh <- typeParameterIR_impl_fresh*} `> `( (parameterIR_subst)*{parameterIR_subst <- parameterIR_subst*} `) ':' typeIR_subst) as callableTypeDefIR)

  4. Case (let externMethodTypeDefIR be %, % has type externMethodTypeDefIR)

    1. Case analysis on externMethodTypeDefIR

      1. Case (let (EXTERN_METHOD nameIR `< (typeParameterIR_expl)*{typeParameterIR_expl <- typeParameterIR_expl*} ',' (typeParameterIR_impl)*{typeParameterIR_impl <- typeParameterIR_impl*} `> `( (parameterIR)*{parameterIR <- parameterIR*} `) ':' typeIR) be %, % matches pattern `EXTERN_METHOD % <% , %> (%) : %`)

        1. (Let B be $free_callableTypeIR(((EXTERN_METHOD nameIR `( (parameterIR)*{parameterIR <- parameterIR*} `) ':' typeIR) as callableTypeIR)))

        2. (Let (theta_fresh, (typeParameterIR_expl_fresh)*{typeParameterIR_expl_fresh <- typeParameterIR_expl_fresh*}, (typeParameterIR_impl_fresh)*{typeParameterIR_impl_fresh <- typeParameterIR_impl_fresh*}) be $capture_avoiding(theta, (typeParameterIR_expl)*{typeParameterIR_expl <- typeParameterIR_expl*}, (typeParameterIR_impl)*{typeParameterIR_impl <- typeParameterIR_impl*}, B))

        3. (Let parameterIR_subst be $subst_parameterIR(theta_fresh, parameterIR))*

        4. (Let typeIR_subst be $subst_typeIR(theta_fresh, typeIR))

        5. Return ((EXTERN_METHOD nameIR `< (typeParameterIR_expl_fresh)*{typeParameterIR_expl_fresh <- typeParameterIR_expl_fresh*} ',' (typeParameterIR_impl_fresh)*{typeParameterIR_impl_fresh <- typeParameterIR_impl_fresh*} `> `( (parameterIR_subst)*{parameterIR_subst <- parameterIR_subst*} `) ':' typeIR_subst) as callableTypeDefIR)

      2. Case (let (EXTERN_METHOD ABSTRACT nameIR `< (typeParameterIR_expl)*{typeParameterIR_expl <- typeParameterIR_expl*} ',' (typeParameterIR_impl)*{typeParameterIR_impl <- typeParameterIR_impl*} `> `( (parameterIR)*{parameterIR <- parameterIR*} `) ':' typeIR) be %, % matches pattern `EXTERN_METHOD ABSTRACT % <% , %> (%) : %`)

        1. (Let B be $free_callableTypeIR(((EXTERN_METHOD ABSTRACT nameIR `( (parameterIR)*{parameterIR <- parameterIR*} `) ':' typeIR) as callableTypeIR)))

        2. (Let (theta_fresh, (typeParameterIR_expl_fresh)*{typeParameterIR_expl_fresh <- typeParameterIR_expl_fresh*}, (typeParameterIR_impl_fresh)*{typeParameterIR_impl_fresh <- typeParameterIR_impl_fresh*}) be $capture_avoiding(theta, (typeParameterIR_expl)*{typeParameterIR_expl <- typeParameterIR_expl*}, (typeParameterIR_impl)*{typeParameterIR_impl <- typeParameterIR_impl*}, B))

        3. (Let parameterIR_subst be $subst_parameterIR(theta_fresh, parameterIR))*

        4. (Let typeIR_subst be $subst_typeIR(theta_fresh, typeIR))

        5. Return ((EXTERN_METHOD ABSTRACT nameIR `< (typeParameterIR_expl_fresh)*{typeParameterIR_expl_fresh <- typeParameterIR_expl_fresh*} ',' (typeParameterIR_impl_fresh)*{typeParameterIR_impl_fresh <- typeParameterIR_impl_fresh*} `> `( (parameterIR_subst)*{parameterIR_subst <- parameterIR_subst*} `) ':' typeIR_subst) as callableTypeDefIR)

  5. Case (let parserApplyMethodTypeDefIR be %, % has type parserApplyMethodTypeDefIR)

    1. (Let callableTypeIR be $subst_callableTypeIR'(theta, (parserApplyMethodTypeDefIR as callableTypeIR)))

    2. (Let parserApplyMethodTypeDefIR_subst be callableTypeIR, callableTypeIR has type parserApplyMethodTypeDefIR)

      1. Return (parserApplyMethodTypeDefIR_subst as callableTypeDefIR)

  6. Case (let controlApplyMethodTypeDefIR be %, % has type controlApplyMethodTypeDefIR)

    1. (Let callableTypeIR be $subst_callableTypeIR'(theta, (controlApplyMethodTypeDefIR as callableTypeIR)))

    2. (Let controlApplyMethodTypeDefIR_subst be callableTypeIR, callableTypeIR has type controlApplyMethodTypeDefIR)

      1. Return (controlApplyMethodTypeDefIR_subst as callableTypeDefIR)

1. Else Dangling#1184

