                    2. (Let n_size be |(value_elem)*{value_elem <- value_elem*}|)

                    3. (Let i_index be $int_of_integerValue(integerValue_index))

                    4. (Let b_in_bounds be ((i_index < (n_size as int)) /\ (i_index >= (0 as int))))

                    5. (Let i be $ite<int>(b_in_bounds, i_index, (n_size - 1)))

