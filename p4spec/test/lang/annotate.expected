relation InstDecl_non_objectInitializer_ok: p TC_0 |- annotationList prefixedTypeName `< typeArgumentList `> `( argumentList `) name ';' : % %

1. Group : p TC_0 |- annotationList prefixedTypeName `< typeArgumentList `> `( argumentList `) name ';' : % %

  1. (TypeArgumentList_ok: p TC_0 |- typeArgumentList : (typeArgumentIR)*{typeArgumentIR <- typeArgumentIR*} '#' (typeId_impl)*{typeId_impl <- typeId_impl*})

  2. (ArgumentList_ok: p TC_0 |- argumentList : (argumentIR)*{argumentIR <- argumentIR*})

  3. (Let prefixedNameIR be $prefixedTypeName(prefixedTypeName))

  4. (Let constructorTargetIR be (prefixedNameIR `< (typeArgumentIR)*{typeArgumentIR <- typeArgumentIR*} `>))

  5. (ConstructorType_ok: p TC_0 |- constructorTargetIR `( (argumentIR)*{argumentIR <- argumentIR*} `) : constructorTypeIR `< '#' (typeId_inserted)*{typeId_inserted <- typeId_inserted*} `> `( '#' (id_default)*{id_default <- id_default*} '#' (id_optional)*{id_optional <- id_optional*} `))

  6. (Let (typeArgumentIR_infer)*{typeArgumentIR_infer <- typeArgumentIR_infer*} be (typeArgumentIR)*{typeArgumentIR <- typeArgumentIR*} ++ (((_NAME typeId_inserted) as typeIR))*{typeId_inserted <- typeId_inserted*})

  7. (Let (typeId_infer)*{typeId_infer <- typeId_infer*} be (typeId_impl)*{typeId_impl <- typeId_impl*} ++ (typeId_inserted)*{typeId_inserted <- typeId_inserted*})

  8. (Inst_ok: p TC_0 (NAMED) |- constructorTypeIR `< (typeArgumentIR_infer)*{typeArgumentIR_infer <- typeArgumentIR_infer*} '#' (typeId_infer)*{typeId_infer <- typeId_infer*} `> `( (argumentIR)*{argumentIR <- argumentIR*} '#' (id_default)*{id_default <- id_default*} '#' (id_optional)*{id_optional <- id_optional*} `) : typeIR_object `< (typeArgumentIR_inferred)*{typeArgumentIR_inferred <- typeArgumentIR_inferred*} `> `( (argumentIR_cast)*{argumentIR_cast <- argumentIR_cast*} `))

  9. If ($is_concrete_extern_object(typeIR_object)), then

    1. (Let nameIR be $name(name))

    2. (Let TC_1 be $add_var_t(p, TC_0, nameIR, ((_EMPTY) typeIR_object (CTK) ?())))

    3. (Let constructorTargetIR_inferred be (prefixedNameIR `< (typeArgumentIR_inferred)*{typeArgumentIR_inferred <- typeArgumentIR_inferred*} `>))

    4. (Let instantiationIR be (annotationList typeIR_object constructorTargetIR_inferred `( (argumentIR_cast)*{argumentIR_cast <- argumentIR_cast*} `) nameIR ?() ';'))

    5. Result in: % % |- % % `< % `> `( % `) % ';' : TC_1 instantiationIR

  9. Else Dangling#9300

relation ObjectDecl_ok: p TC_0 typeFrame externMethodTypeDefEnv |- objectDeclaration : % % %

1. Group : p TC_0 typeFrame externMethodTypeDefEnv |- objectDeclaration : % % %

  1. Case analysis on objectDeclaration

    1. Case (let instantiation be %, % has type instantiation)

      1. (InstDecl_ok: p TC_0 |- instantiation : TC_1 instantiationIR)

      2. (Destruct (_annotationList, _typeIR, _constructorTargetIR, _argumentListIR, nameIR, _objectInitializerOptIR) = instantiationIR)

      3. (Let varTypeIR be ! $find_var_t((_BARE nameIR), p, TC_1))

        1. (Let typeFrame_init be $update_map<id, varTypeIR>(typeFrame, nameIR, varTypeIR))

        2. Result in: % % % % |- % : typeFrame_init externMethodTypeDefEnv (instantiationIR as objectDeclarationIR)

    2. Case (let (annotationList (typeOrVoid name typeParameterListOpt `( parameterList `)) blockStatement) be %, % has type functionDeclaration)

      1. (Let TC_1 be TC_0[BLOCK.KIND = (EXTERN)])

      2. (Let TC_2 be TC_1[BLOCK.FRAME = typeFrame])

      3. (TypeParameterListOpt_ok: (LOCAL) TC_2 |- typeParameterListOpt : TC_3 (typeId_expl)*{typeId_expl <- typeId_expl*})

      4. (ParameterList_ok: (LOCAL) TC_3 |- parameterList : TC_4 (parameterIR)*{parameterIR <- parameterIR*} '#' (typeId_impl)*{typeId_impl <- typeId_impl*})

      5. (Type_ok: (LOCAL) TC_3 |- typeOrVoid : typeIR_ret '#' (typeId)*{typeId <- typeId*})

      6. If (((typeId)*{typeId <- typeId*} matches pattern [])), then

        1. (Let TC_5 be TC_4[LOCAL.KIND = ((EXTERN_METHOD ':' typeIR_ret) as localKind)])

        2. (Let TC_6 be TC_5[CONTROL = (CONT)][LOOP = (OUT)])

        3. (Block_ok: TC_6 |- blockStatement : TC_7 blockStatementIR)

        4. If (((TC_7.CONTROL = (RET)) \/ (typeIR_ret = ((VOID) as typeIR)))), then

          1. (Let callableId be $callableId(name, parameterList))

          2. (Let nameIR be $name(name))

          3. (Let externMethodTypeDefIR be (EXTERN_METHOD nameIR `< (typeId_expl)*{typeId_expl <- typeId_expl*} ',' (typeId_impl)*{typeId_impl <- typeId_impl*} `> `( (parameterIR)*{parameterIR <- parameterIR*} `) ':' typeIR_ret))

          4. (Let bound be $bound(p, TC_0))

          5. If (CallableTypeDef_wf: bound |- (externMethodTypeDefIR as callableTypeDefIR)) holds, then

            1. (Let externMethodTypeDefEnv_init be $update_map<callableId, externMethodTypeDefIR>(externMethodTypeDefEnv, callableId, externMethodTypeDefIR))

            2. (Let functionDeclarationIR be (annotationList (typeIR_ret nameIR `< (typeId_expl)*{typeId_expl <- typeId_expl*} ',' (typeId_impl)*{typeId_impl <- typeId_impl*} `> `( (parameterIR)*{parameterIR <- parameterIR*} `)) blockStatementIR))

            3. Result in: % % % % |- % : typeFrame externMethodTypeDefEnv_init (functionDeclarationIR as objectDeclarationIR)

          5. Else Dangling#9330

        4. Else Dangling#9326

      6. Else Dangling#9322

