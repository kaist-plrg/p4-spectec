relation TableProperty_ok: TC TBLC_0 |- tableProperty : % %

1. Case analysis on tableProperty

  1. Case (let (KEY '=' `{ tableKeyList `}) be %, % matches pattern `KEY = {%}`)

    1. Group key: TC TBLC_0 |- (KEY '=' `{ tableKeyList `}) : % %

      1. (Let (tableKey)*{tableKey <- tableKey*} be $flatten_tableKeyList(tableKeyList))

      2. (TableKeys_ok: TC TBLC_0 |- (tableKey)*{tableKey <- tableKey*} : TBLC_1 (tableKeyIR)*{tableKeyIR <- tableKeyIR*})

      3. (Let TBLC_2 be $update_mode_tbl(TBLC_1, (tableKeyIR)*{tableKeyIR <- tableKeyIR*}))

      4. Result in: % % |- % : TBLC_2 ((KEY '=' `{ (tableKeyIR)*{tableKeyIR <- tableKeyIR*} `}) as tablePropertyIR)

  2. Case (let (ACTIONS '=' `{ tableActionList `}) be %, % matches pattern `ACTIONS = {%}`)

    1. Group actions: TC TBLC_0 |- (ACTIONS '=' `{ tableActionList `}) : % %

      1. (Let (tableAction)*{tableAction <- tableAction*} be $flatten_tableActionList(tableActionList))

      2. (TableActions_ok: TC TBLC_0 |- (tableAction)*{tableAction <- tableAction*} : TBLC_1 (tableActionIR)*{tableActionIR <- tableActionIR*})

      3. Result in: % % |- % : TBLC_1 ((ACTIONS '=' `{ (tableActionIR)*{tableActionIR <- tableActionIR*} `}) as tablePropertyIR)

  3. Case (let (annotationList constOpt ENTRIES '=' `{ tableEntryList `}) be %, % matches pattern `% % ENTRIES = {%}`)

    1. Group entries: TC TBLC_0 |- (annotationList constOpt ENTRIES '=' `{ tableEntryList `}) : % %

      1. (Let (tableEntry)*{tableEntry <- tableEntry*} be $flatten_tableEntryList(tableEntryList))

      2. If (((|TBLC_0.KEYS| = 0) => (|(tableEntry)*{tableEntry <- tableEntry*}| = 0))), then

        1. (Let TBLC_1 be TBLC_0[ENTRIES.SIZE = |(tableEntry)*{tableEntry <- tableEntry*}|])

        2. (Let constOptIR be $flatten_constOpt(constOpt))

        3. (Let TBLC_2 be TBLC_1[ENTRIES.CONST = (constOptIR = ?((CONST)))])

        4. (TableEntry_ok: TC TBLC_2 |- tableEntry : TBLS tableEntryIR)*

        5. (Let (tableEntryIR_pri)*{tableEntryIR_pri <- tableEntryIR_pri*} be $set_priorities_of_tableEntryListIR(TBLC_2, (TBLS)*{TBLS <- TBLS*}, (tableEntryIR)*{tableEntryIR <- tableEntryIR*}))

        6. Result in: % % |- % : TBLC_2 ((annotationList constOptIR ENTRIES '=' `{ (tableEntryIR_pri)*{tableEntryIR_pri <- tableEntryIR_pri*} `}) as tablePropertyIR)

      2. Else Dangling#7807

  4. Case (% matches pattern `% % % % ;`)

    1. Block (2 arms)

    Arm 1:

      1. (Let (annotationList constOpt tableCustomName initializer ';') be tableProperty)

      2. Group default-action: TC TBLC_0 |- (annotationList constOpt tableCustomName initializer ';') : % %

        1. If (("default_action" = $tableCustomName(tableCustomName))), then

          1. (TableDefaultAction_ok: TC TBLC_0 |- initializer : tableActionReferenceIR)

          2. (Let constOptIR be $flatten_constOpt(constOpt))

          3. (Let tablePropertyIR be ((annotationList constOptIR DEFAULT_ACTION '=' tableActionReferenceIR ';') as tablePropertyIR))

          4. Result in: % % |- % : TBLC_0 tablePropertyIR

        1. Else Dangling#7816

    Arm 2:

      1. (Let (annotationList constOpt tableCustomName ('=' expression) ';') be tableProperty)

      2. Block (2 arms)

      Arm 1:

        1. Group priority: TC TBLC_0 |- (annotationList constOpt tableCustomName ('=' expression) ';') : % %

          1. Block (2 arms)

          Arm 1:

            1. If (("largest_priority_wins" = $tableCustomName(tableCustomName))), then

              1. (Expr_ok: (LOCAL) TC |- expression : typedExpressionIR)

              2. (Let typeIR be $type_of_typedExpressionIR(typedExpressionIR))

              3. If (($ctk_of_typedExpressionIR(typedExpressionIR) matches pattern `LCTK`)), then

                1. If ((((BOOL) as typeIR) = $unroll_typeIR(typeIR))), then

                  1. (Expr_eval_lctk: (LOCAL) TC |- typedExpressionIR ~> value)

                  2. (Let (_B b_lw) be value, value has type boolValue)

                    1. (Let TBLC_1 be TBLC_0[PRIORITIES.LARGEST_WINS = b_lw])

                    2. (Let constOptIR be $flatten_constOpt(constOpt))

                    3. (Let tablePropertyIR be ((annotationList constOptIR CUSTOM_CONST "largest_priority_wins" ('=' _VALUE ((_B b_lw) as value)) ';') as tablePropertyIR))

                    4. Result in: % % |- % : TBLC_1 tablePropertyIR

