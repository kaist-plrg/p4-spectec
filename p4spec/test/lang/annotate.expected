    6. Case (let (TUPLE `< (typeIR)*{typeIR <- typeIR*} `>) be %, % has type tupleTypeIR)

      1. Group tupleTypeIR: B |- ((TUPLE `< (typeIR)*{typeIR <- typeIR*} `>) as typeIR)

        1. If ($nestable_tuple(typeIR))*{typeIR <- typeIR*}, then

          1. If (Type_wf: B |- typeIR)*{typeIR <- typeIR*} holds, then

            1. The relation holds

          1. Else Dangling#4675

        1. Else Dangling#4674

    7. Case (let (ARRAY typeIR `[ nat `]) be %, % has type arrayTypeIR)

      1. Group arrayTypeIR: B |- ((ARRAY typeIR `[ nat `]) as typeIR)

        1. If ($nestable_array(typeIR)), then

          1. If (Type_wf: B |- typeIR) holds, then

            1. The relation holds

          1. Else Dangling#4680

        1. Else Dangling#4679

    8. Case (let (HEADER_STACK typeIR `[ nat `]) be %, % has type headerStackTypeIR)

      1. Group headerStackTypeIR: B |- ((HEADER_STACK typeIR `[ nat `]) as typeIR)

        1. If ($nestable_headerStack(typeIR)), then

          1. If (Type_wf: B |- typeIR) holds, then

            1. The relation holds

          1. Else Dangling#4685

        1. Else Dangling#4684

    9. Case (let (STRUCT typeId `< (typeArgumentIR)*{typeArgumentIR <- typeArgumentIR*} `> `{ ((annotationList typeIR_field nameIR_field ';'))*{annotationList <- annotationList*, nameIR_field <- nameIR_field*, typeIR_field <- typeIR_field*} `}) be %, % has type structTypeIR)

      1. Group structTypeIR: B |- ((STRUCT typeId `< (typeArgumentIR)*{typeArgumentIR <- typeArgumentIR*} `> `{ ((annotationList typeIR_field nameIR_field ';'))*{annotationList <- annotationList*, nameIR_field <- nameIR_field*, typeIR_field <- typeIR_field*} `}) as typeIR)

        1. If ($distinct_<nameIR>((nameIR_field)*{nameIR_field <- nameIR_field*})), then

          1. If ($nestable_struct(typeIR_field))*{typeIR_field <- typeIR_field*}, then

            1. If (Type_wf: B |- typeIR_field)*{typeIR_field <- typeIR_field*} holds, then

              1. The relation holds

            1. Else Dangling#4691

          1. Else Dangling#4690

