                  2. (Let (_CONT (storageReference')?{storageReference' <- storageReference'?}) be storageReferenceResult, storageReferenceResult has type continueResult<storageReference?>)

                    1. (Let ?(storageReference) be (storageReference')?{storageReference' <- storageReference'?}, (storageReference')?{storageReference' <- storageReference'?} matches pattern (_))

                      1. (Let builtinPushFrontMethodCallee be (BUILTIN_PUSH_FRONT storageReference))

                      2. Result in: % % % |- % `< '_' `> `( % `) : EC_1 ARCH_1 ((_CONT (builtinPushFrontMethodCallee as callee)) as calleeResult)

