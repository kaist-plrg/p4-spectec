tbl def $compat_table_exact_optional_key(typeIR'')
=

  Row : ((BOOL) as typeIR) -> true:

    1. (Let boolTypeIR be typeIR'', typeIR'' has type boolTypeIR)

      1. Return true

  Row : ((ERROR) as typeIR) -> true:

    1. (Let errorTypeIR be typeIR'', typeIR'' has type errorTypeIR)

      1. Return true

  Row : (integerTypeIR as typeIR) -> true:

    1. If ((typeIR'' has type integerTypeIR)), then

      1. Return true

  Row : ((TYPEDEF _typeId typeIR) as typeIR) -> $compat_table_exact_optional_key(typeIR):

    1. (Let (TYPEDEF _typeId typeIR) be typeIR'', typeIR'' has type typedefTypeIR)

      1. Return $compat_table_exact_optional_key(typeIR)

  Row : ((TYPE _typeId typeIR) as typeIR) -> $compat_table_exact_optional_key(typeIR):

    1. (Let (TYPE _typeId typeIR) be typeIR'', typeIR'' has type newTypeIR)

      1. Return $compat_table_exact_optional_key(typeIR)

  Row : ((ENUM _typeId `{ (_nameIR)*{_nameIR <- _nameIR*} `}) as typeIR) -> true:

    1. If ((typeIR'' has type simpleEnumTypeIR)), then

      1. Return true

  Row : ((ENUM _typeId `< typeIR `> `{ (_valueFieldIR)*{_valueFieldIR <- _valueFieldIR*} `}) as typeIR) -> $compat_table_exact_optional_key(typeIR):

    1. (Let (ENUM _typeId `< typeIR `> `{ (_valueFieldIR)*{_valueFieldIR <- _valueFieldIR*} `}) be typeIR'', typeIR'' has type serializableEnumTypeIR)

      1. Return $compat_table_exact_optional_key(typeIR)

  Row : _typeIR -> false:

    1. Return false

tbl def $compat_table_lpm_ternary_range_key(typeIR'')
=

  Row : ((BOOL) as typeIR) -> true:

    1. (Let boolTypeIR be typeIR'', typeIR'' has type boolTypeIR)

      1. Return true

  Row : ((INT) as typeIR) -> true:

    1. (Let intTypeIR be typeIR'', typeIR'' has type intTypeIR)

      1. Return true

  Row : ((INT `< _nat `>) as typeIR) -> true:

    1. If ((typeIR'' has type fixedIntTypeIR)), then

      1. Return true

  Row : ((BIT `< _nat `>) as typeIR) -> true:

    1. If ((typeIR'' has type fixedBitTypeIR)), then

      1. Return true

  Row : ((TYPEDEF _typeId typeIR) as typeIR) -> $compat_table_lpm_ternary_range_key(typeIR):

    1. (Let (TYPEDEF _typeId typeIR) be typeIR'', typeIR'' has type typedefTypeIR)

      1. Return $compat_table_lpm_ternary_range_key(typeIR)

  Row : ((TYPE _typeId typeIR) as typeIR) -> $compat_table_lpm_ternary_range_key(typeIR):

    1. (Let (TYPE _typeId typeIR) be typeIR'', typeIR'' has type newTypeIR)

      1. Return $compat_table_lpm_ternary_range_key(typeIR)

  Row : ((ENUM _typeId `< typeIR `> `{ (_valueFieldIR)*{_valueFieldIR <- _valueFieldIR*} `}) as typeIR) -> $compat_table_lpm_ternary_range_key(typeIR):

    1. (Let (ENUM _typeId `< typeIR `> `{ (_valueFieldIR)*{_valueFieldIR <- _valueFieldIR*} `}) be typeIR'', typeIR'' has type serializableEnumTypeIR)

      1. Return $compat_table_lpm_ternary_range_key(typeIR)

  Row : _typeIR -> false:

    1. Return false

def $compat_table_key(nameIR, typeIR)

1. Block (2 arms)

Arm 1:

  1. If ((((nameIR = "exact") \/ (nameIR = "optional")) \/ (nameIR = "selector"))), then

    1. If ($compat_table_exact_optional_key(typeIR)), then

      1. Return true

Arm 2:

  1. If ((((nameIR = "lpm") \/ (nameIR = "ternary")) \/ (nameIR = "range"))), then

    1. If ($compat_table_lpm_ternary_range_key(typeIR)), then

      1. Return true

2. Otherwise,

  1. Return false

def $split_dataplane_parameters((parameterIR)*{parameterIR <- parameterIR*})

1. Case analysis on (parameterIR)*{parameterIR <- parameterIR*}

  1. Case (% matches pattern [])

    1. Return ([], [])

  2. Case (let parameterIR_h :: (parameterIR_t)*{parameterIR_t <- parameterIR_t*} be %, % matches pattern _ :: _)

    1. (Destruct (_annotationList, direction, _typeIR, _id, _parameterInitializerOptIR) = parameterIR_h)

    2. Case analysis on (direction matches pattern `/* empty */`)

      1. Case true

        1. (Let ((parameterIR_data)*{parameterIR_data <- parameterIR_data*}, (parameterIR_control)*{parameterIR_control <- parameterIR_control*}) be $split_dataplane_parameters((parameterIR_t)*{parameterIR_t <- parameterIR_t*}))

        2. Return ((parameterIR_data)*{parameterIR_data <- parameterIR_data*}, parameterIR_h :: (parameterIR_control)*{parameterIR_control <- parameterIR_control*})

      2. Case false

        1. (Let ((parameterIR_data)*{parameterIR_data <- parameterIR_data*}, (parameterIR_control)*{parameterIR_control <- parameterIR_control*}) be $split_dataplane_parameters((parameterIR_t)*{parameterIR_t <- parameterIR_t*}))

        2. Return (parameterIR_h :: (parameterIR_data)*{parameterIR_data <- parameterIR_data*}, (parameterIR_control)*{parameterIR_control <- parameterIR_control*})

def $is_table_application(typedExpressionIR)

