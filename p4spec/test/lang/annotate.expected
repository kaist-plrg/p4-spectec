def $write_bits_from_value(value')

1. Block (2 arms)

Arm 1:

  1. Case analysis on value'

    1. Case (let (_B b) be %, % has type boolValue)

      1. Return [b]

    2. Case (let integerLiteral be %, % has type integerLiteral)

      1. Case analysis on integerLiteral

        1. Case (let (w S i) be %, % matches pattern `% S %`)

          1. Return $int_to_bits_signed(w, i)

        2. Case (let (w W i) be %, % matches pattern `% W %`)

          1. Return $int_to_bits_unsigned(w, i)

      1. Else Dangling#569

    3. Case (let (ARRAY `[ (value_element)*{value_element <- value_element*} `]) be %, % has type arrayValue)

      1. (Let (bool)*{bool <- bool*} be $write_bits_from_value(value_element))*

      2. Return $concat_<bool>(((bool)*{bool <- bool*})*{bool* <- bool**})

    4. Case (let (HEADER_STACK `[ (value_element)*{value_element <- value_element*} `( _nat `) `]) be %, % has type headerStackValue)

      1. (Let (bool')*{bool' <- bool'*} be $write_bits_from_value(value_element))*

      2. Return $concat_<bool>(((bool')*{bool' <- bool'*})*{bool'* <- bool'**})

    5. Case (let (STRUCT _typeId `{ ((value_field id_field ';'))*{id_field <- id_field*, value_field <- value_field*} `}) be %, % has type structValue)

      1. (Let (bool'')*{bool'' <- bool''*} be $write_bits_from_value(value_field))*

      2. Return $concat_<bool>(((bool'')*{bool'' <- bool''*})*{bool''* <- bool''**})

    6. Case (% has type headerValue)

      1. Block (2 arms)

      Arm 1:

        1. (Let (HEADER _typeId `{ b ';' ((value_field id_field ';'))*{id_field <- id_field*, value_field <- value_field*} `}) be (value' as headerValue))

        2. If ((b = true)), then

          1. (Let (bool''')*{bool''' <- bool'''*} be $write_bits_from_value(value_field))*

          2. Return $concat_<bool>(((bool''')*{bool''' <- bool'''*})*{bool'''* <- bool'''**})

        2. Else Dangling#581

      Arm 2:

        1. (Let (HEADER _typeId `{ b ';' (_fieldValue)*{_fieldValue <- _fieldValue*} `}) be (value' as headerValue))

        2. If ((b = false)), then

          1. Return []

        2. Else Dangling#584

    7. Case (let (HEADER_UNION _typeId `{ ((value id ';'))*{id <- id*, value <- value*} `}) be %, % has type headerUnionValue)

      1. (Let (bool'''')*{bool'''' <- bool''''*} be $write_bits_from_value(value))*

      2. Return $concat_<bool>(((bool'''')*{bool'''' <- bool''''*})*{bool''''* <- bool''''**})

    8. Case (let enumValue be %, % has type enumValue)

      1. (Let (typeId '.' id '.' value) be enumValue, enumValue matches pattern `% . % . %`)

        1. Return $write_bits_from_value(value)

  1. Else Dangling#565

Arm 2:

  1. (Let integerValue be value', value' has type integerValue)

    1. (Let (_nat '.' w V i) be integerValue, integerValue matches pattern `% . % V %`)

      1. Return $int_to_bits_unsigned(w, i)

syntax voidTypeIR = 
   | VOID (from voidTypeIR) 

syntax boolTypeIR = 
   | BOOL (from boolTypeIR) 

syntax errorTypeIR = 
   | ERROR (from errorTypeIR) 

syntax matchKindTypeIR = 
   | MATCH_KIND (from matchKindTypeIR) 

syntax stringTypeIR = 
   | STRING (from stringTypeIR) 

syntax intTypeIR = 
   | INT (from intTypeIR) 

syntax fixedIntTypeIR = 
   | INT `< nat `> (from fixedIntTypeIR) 

syntax fixedBitTypeIR = 
   | BIT `< nat `> (from fixedBitTypeIR) 

syntax varBitTypeIR = 
   | VARBIT `< nat `> (from varBitTypeIR) 

syntax integerTypeIR = 
   | INT (from intTypeIR) 
   | INT `< nat `> (from fixedIntTypeIR) 
   | BIT `< nat `> (from fixedBitTypeIR) 
   | VARBIT `< nat `> (from varBitTypeIR) 

syntax baseTypeIR = 
   | VOID (from voidTypeIR) 
   | BOOL (from boolTypeIR) 
   | ERROR (from errorTypeIR) 
   | MATCH_KIND (from matchKindTypeIR) 
   | STRING (from stringTypeIR) 
   | INT (from intTypeIR) 
   | INT `< nat `> (from fixedIntTypeIR) 
   | BIT `< nat `> (from fixedBitTypeIR) 
   | VARBIT `< nat `> (from varBitTypeIR) 

syntax nameTypeIR = 
   | _NAME typeId (from nameTypeIR)  hint(print %0)

syntax typedefTypeIR = 
   | TYPEDEF typeId typeIR (from typedefTypeIR)  hint(print %0)

syntax newTypeIR = 
   | TYPE typeId typeIR (from newTypeIR)  hint(print %0)

syntax aliasTypeIR = 
   | TYPEDEF typeId typeIR (from typedefTypeIR)  hint(print %0)
   | TYPE typeId typeIR (from newTypeIR)  hint(print %0)

syntax listTypeIR = 
   | LIST `< typeIR `> (from listTypeIR) 

syntax tupleTypeIR = 
   | TUPLE `< typeIR* `> (from tupleTypeIR) 

syntax arrayTypeIR = 
   | ARRAY typeIR `[ nat `] (from arrayTypeIR) 

syntax headerStackTypeIR = 
   | HEADER_STACK typeIR `[ nat `] (from headerStackTypeIR) 

syntax fieldTypeIR = 
   | annotationList typeIR nameIR ';' (from fieldTypeIR) 

syntax structTypeIR = 
   | STRUCT typeId `< typeArgumentIR* `> `{ fieldTypeIR* `} (from structTypeIR)  hint(print %0#"<"#%1#">")

syntax headerTypeIR = 
   | HEADER typeId `< typeArgumentIR* `> `{ fieldTypeIR* `} (from headerTypeIR)  hint(print %0#"<"#%1#">")

syntax headerUnionTypeIR = 
   | HEADER_UNION typeId `< typeArgumentIR* `> `{ fieldTypeIR* `} (from headerUnionTypeIR)  hint(print %0#"<"#%1#">")

syntax valueFieldIR = 
   | nameIR '=' value ';' (from valueFieldIR) 

syntax simpleEnumTypeIR = 
   | ENUM typeId `{ nameIR* `} (from simpleEnumTypeIR)  hint(print %0)

syntax serializableEnumTypeIR = 
   | ENUM typeId `< typeIR `> `{ valueFieldIR* `} (from serializableEnumTypeIR)  hint(print %0)

syntax enumTypeIR = 
   | ENUM typeId `{ nameIR* `} (from simpleEnumTypeIR)  hint(print %0)
   | ENUM typeId `< typeIR `> `{ valueFieldIR* `} (from serializableEnumTypeIR)  hint(print %0)

syntax dataTypeIR = 
   | LIST `< typeIR `> (from listTypeIR) 
   | TUPLE `< typeIR* `> (from tupleTypeIR) 
   | ARRAY typeIR `[ nat `] (from arrayTypeIR) 
   | HEADER_STACK typeIR `[ nat `] (from headerStackTypeIR) 
   | STRUCT typeId `< typeArgumentIR* `> `{ fieldTypeIR* `} (from structTypeIR)  hint(print %0#"<"#%1#">")
   | HEADER typeId `< typeArgumentIR* `> `{ fieldTypeIR* `} (from headerTypeIR)  hint(print %0#"<"#%1#">")
   | HEADER_UNION typeId `< typeArgumentIR* `> `{ fieldTypeIR* `} (from headerUnionTypeIR)  hint(print %0#"<"#%1#">")
   | ENUM typeId `{ nameIR* `} (from simpleEnumTypeIR)  hint(print %0)
   | ENUM typeId `< typeIR `> `{ valueFieldIR* `} (from serializableEnumTypeIR)  hint(print %0)

syntax externMethodTypeDefEnv = map<callableId, externMethodTypeDefIR>

syntax externObjectTypeIR = 
   | EXTERN typeId `< typeArgumentIR* `> externMethodTypeDefEnv (from externObjectTypeIR)  hint(print %0#"<"#%1#">")

syntax parserObjectTypeIR = 
   | PARSER typeId `< typeArgumentIR* `> `( parameterIR* `) (from parserObjectTypeIR)  hint(print %0#"<"#%1#">")

syntax controlObjectTypeIR = 
   | CONTROL typeId `< typeArgumentIR* `> `( parameterIR* `) (from controlObjectTypeIR)  hint(print %0#"<"#%1#">")

syntax packageObjectTypeIR = 
   | PACKAGE typeId `< typeArgumentIR* `> `{ typeIR* `} (from packageObjectTypeIR)  hint(print %0#"<"#%1#">")

syntax tableObjectTypeIR = 
   | TABLE typeId `{ tableMetadataStructTypeIR `} (from tableObjectTypeIR)  hint(print %0)

syntax objectTypeIR = 
   | EXTERN typeId `< typeArgumentIR* `> externMethodTypeDefEnv (from externObjectTypeIR)  hint(print %0#"<"#%1#">")
   | PARSER typeId `< typeArgumentIR* `> `( parameterIR* `) (from parserObjectTypeIR)  hint(print %0#"<"#%1#">")
   | CONTROL typeId `< typeArgumentIR* `> `( parameterIR* `) (from controlObjectTypeIR)  hint(print %0#"<"#%1#">")
   | PACKAGE typeId `< typeArgumentIR* `> `{ typeIR* `} (from packageObjectTypeIR)  hint(print %0#"<"#%1#">")
   | TABLE typeId `{ tableMetadataStructTypeIR `} (from tableObjectTypeIR)  hint(print %0)

syntax defaultTypeIR = 
   | DEFAULT (from defaultTypeIR) 

syntax invalidHeaderTypeIR = 
   | HEADER_INVALID (from invalidHeaderTypeIR) 

syntax sequenceTypeIR = 
   | SEQ `< typeIR* `> (from sequenceTypeIR) 
   | SEQ `< typeIR* ',' '...' `> (from sequenceTypeIR) 

syntax recordTypeIR = 
   | RECORD `{ fieldTypeIR* `} (from recordTypeIR) 
   | RECORD `{ fieldTypeIR* ',' '...' `} (from recordTypeIR) 

syntax setTypeIR = 
   | SET `< typeIR `> (from setTypeIR) 

syntax tableMetadataEnumTypeIR = 
   | TABLE_ENUM typeId `{ nameIR* `} (from tableMetadataEnumTypeIR)  hint(print %0)

syntax tableMetadataStructTypeIR = 
   | TABLE_STRUCT typeId `{ HIT boolTypeIR ';' MISS boolTypeIR ';' ACTION_RUN tableMetadataEnumTypeIR ';' `} (from tableMetadataStructTypeIR)  hint(print %0)

syntax tableMetadataTypeIR = 
   | TABLE_ENUM typeId `{ nameIR* `} (from tableMetadataEnumTypeIR)  hint(print %0)
   | TABLE_STRUCT typeId `{ HIT boolTypeIR ';' MISS boolTypeIR ';' ACTION_RUN tableMetadataEnumTypeIR ';' `} (from tableMetadataStructTypeIR)  hint(print %0)

syntax synthesizedTypeIR = 
   | DEFAULT (from defaultTypeIR) 
   | HEADER_INVALID (from invalidHeaderTypeIR) 
   | SEQ `< typeIR* `> (from sequenceTypeIR) 
   | SEQ `< typeIR* ',' '...' `> (from sequenceTypeIR) 
   | RECORD `{ fieldTypeIR* `} (from recordTypeIR) 
   | RECORD `{ fieldTypeIR* ',' '...' `} (from recordTypeIR) 
   | SET `< typeIR `> (from setTypeIR) 
   | TABLE_ENUM typeId `{ nameIR* `} (from tableMetadataEnumTypeIR)  hint(print %0)
   | TABLE_STRUCT typeId `{ HIT boolTypeIR ';' MISS boolTypeIR ';' ACTION_RUN tableMetadataEnumTypeIR ';' `} (from tableMetadataStructTypeIR)  hint(print %0)

syntax typeIR = 
   | VOID (from voidTypeIR) 
   | BOOL (from boolTypeIR) 
   | ERROR (from errorTypeIR) 
   | MATCH_KIND (from matchKindTypeIR) 
   | STRING (from stringTypeIR) 
   | INT (from intTypeIR) 
   | INT `< nat `> (from fixedIntTypeIR) 
   | BIT `< nat `> (from fixedBitTypeIR) 
   | VARBIT `< nat `> (from varBitTypeIR) 
   | _NAME typeId (from nameTypeIR)  hint(print %0)
   | TYPEDEF typeId typeIR (from typedefTypeIR)  hint(print %0)
   | TYPE typeId typeIR (from newTypeIR)  hint(print %0)
   | LIST `< typeIR `> (from listTypeIR) 
   | TUPLE `< typeIR* `> (from tupleTypeIR) 
   | ARRAY typeIR `[ nat `] (from arrayTypeIR) 
   | HEADER_STACK typeIR `[ nat `] (from headerStackTypeIR) 
   | STRUCT typeId `< typeArgumentIR* `> `{ fieldTypeIR* `} (from structTypeIR)  hint(print %0#"<"#%1#">")
   | HEADER typeId `< typeArgumentIR* `> `{ fieldTypeIR* `} (from headerTypeIR)  hint(print %0#"<"#%1#">")
   | HEADER_UNION typeId `< typeArgumentIR* `> `{ fieldTypeIR* `} (from headerUnionTypeIR)  hint(print %0#"<"#%1#">")
   | ENUM typeId `{ nameIR* `} (from simpleEnumTypeIR)  hint(print %0)
   | ENUM typeId `< typeIR `> `{ valueFieldIR* `} (from serializableEnumTypeIR)  hint(print %0)
   | EXTERN typeId `< typeArgumentIR* `> externMethodTypeDefEnv (from externObjectTypeIR)  hint(print %0#"<"#%1#">")
   | PARSER typeId `< typeArgumentIR* `> `( parameterIR* `) (from parserObjectTypeIR)  hint(print %0#"<"#%1#">")
   | CONTROL typeId `< typeArgumentIR* `> `( parameterIR* `) (from controlObjectTypeIR)  hint(print %0#"<"#%1#">")
   | PACKAGE typeId `< typeArgumentIR* `> `{ typeIR* `} (from packageObjectTypeIR)  hint(print %0#"<"#%1#">")
   | TABLE typeId `{ tableMetadataStructTypeIR `} (from tableObjectTypeIR)  hint(print %0)
   | DEFAULT (from defaultTypeIR) 
   | HEADER_INVALID (from invalidHeaderTypeIR) 
   | SEQ `< typeIR* `> (from sequenceTypeIR) 
   | SEQ `< typeIR* ',' '...' `> (from sequenceTypeIR) 
   | RECORD `{ fieldTypeIR* `} (from recordTypeIR) 
   | RECORD `{ fieldTypeIR* ',' '...' `} (from recordTypeIR) 
   | SET `< typeIR `> (from setTypeIR) 
   | TABLE_ENUM typeId `{ nameIR* `} (from tableMetadataEnumTypeIR)  hint(print %0)
   | TABLE_STRUCT typeId `{ HIT boolTypeIR ';' MISS boolTypeIR ';' ACTION_RUN tableMetadataEnumTypeIR ';' `} (from tableMetadataStructTypeIR)  hint(print %0)

syntax typeArgumentIR = typeIR

syntax typeParameterIR = typeId

syntax nameTypeDefIR = nameTypeIR

syntax aliasTypeDefIR = aliasTypeIR

syntax structTypeDefIR = 
   | STRUCT typeId `< typeParameterIR* `> `{ fieldTypeIR* `} (from structTypeDefIR) 

syntax headerTypeDefIR = 
   | HEADER typeId `< typeParameterIR* `> `{ fieldTypeIR* `} (from headerTypeDefIR) 

syntax headerUnionTypeDefIR = 
   | HEADER_UNION typeId `< typeParameterIR* `> `{ fieldTypeIR* `} (from headerUnionTypeDefIR) 

syntax enumTypeDefIR = enumTypeIR

syntax dataTypeDefIR = 
   | STRUCT typeId `< typeParameterIR* `> `{ fieldTypeIR* `} (from structTypeDefIR) 
   | HEADER typeId `< typeParameterIR* `> `{ fieldTypeIR* `} (from headerTypeDefIR) 
   | HEADER_UNION typeId `< typeParameterIR* `> `{ fieldTypeIR* `} (from headerUnionTypeDefIR) 
   | ENUM typeId `{ nameIR* `} (from simpleEnumTypeIR)  hint(print %0)
   | ENUM typeId `< typeIR `> `{ valueFieldIR* `} (from serializableEnumTypeIR)  hint(print %0)

syntax externObjectTypeDefIR = 
   | EXTERN typeId `< typeParameterIR* ',' typeParameterIR* `> externMethodTypeDefEnv (from externObjectTypeDefIR) 

syntax parserObjectTypeDefIR = 
   | PARSER typeId `< typeParameterIR* ',' typeParameterIR* `> `( parameterIR* `) (from parserObjectTypeDefIR) 

syntax controlObjectTypeDefIR = 
   | CONTROL typeId `< typeParameterIR* ',' typeParameterIR* `> `( parameterIR* `) (from controlObjectTypeDefIR) 

syntax packageObjectTypeDefIR = 
   | PACKAGE typeId `< typeParameterIR* ',' typeParameterIR* `> `{ typeIR* `} (from packageObjectTypeDefIR) 

syntax tableObjectTypeDefIR = tableObjectTypeIR

syntax objectTypeDefIR = 
   | EXTERN typeId `< typeParameterIR* ',' typeParameterIR* `> externMethodTypeDefEnv (from externObjectTypeDefIR) 
   | PARSER typeId `< typeParameterIR* ',' typeParameterIR* `> `( parameterIR* `) (from parserObjectTypeDefIR) 
   | CONTROL typeId `< typeParameterIR* ',' typeParameterIR* `> `( parameterIR* `) (from controlObjectTypeDefIR) 
   | PACKAGE typeId `< typeParameterIR* ',' typeParameterIR* `> `{ typeIR* `} (from packageObjectTypeDefIR) 
   | TABLE typeId `{ tableMetadataStructTypeIR `} (from tableObjectTypeIR)  hint(print %0)

syntax typeDefIR = 
   | _NAME typeId (from nameTypeIR)  hint(print %0)
   | TYPEDEF typeId typeIR (from typedefTypeIR)  hint(print %0)
   | TYPE typeId typeIR (from newTypeIR)  hint(print %0)
   | STRUCT typeId `< typeParameterIR* `> `{ fieldTypeIR* `} (from structTypeDefIR) 
   | HEADER typeId `< typeParameterIR* `> `{ fieldTypeIR* `} (from headerTypeDefIR) 
   | HEADER_UNION typeId `< typeParameterIR* `> `{ fieldTypeIR* `} (from headerUnionTypeDefIR) 
   | ENUM typeId `{ nameIR* `} (from simpleEnumTypeIR)  hint(print %0)
   | ENUM typeId `< typeIR `> `{ valueFieldIR* `} (from serializableEnumTypeIR)  hint(print %0)
   | EXTERN typeId `< typeParameterIR* ',' typeParameterIR* `> externMethodTypeDefEnv (from externObjectTypeDefIR) 
   | PARSER typeId `< typeParameterIR* ',' typeParameterIR* `> `( parameterIR* `) (from parserObjectTypeDefIR) 
   | CONTROL typeId `< typeParameterIR* ',' typeParameterIR* `> `( parameterIR* `) (from controlObjectTypeDefIR) 
   | PACKAGE typeId `< typeParameterIR* ',' typeParameterIR* `> `{ typeIR* `} (from packageObjectTypeDefIR) 
   | TABLE typeId `{ tableMetadataStructTypeIR `} (from tableObjectTypeIR)  hint(print %0)

def $unroll_typeIR(typeIR')

1. (Let (TYPEDEF _typeId typeIR) be typeIR', typeIR' has type typedefTypeIR)

  1. Return $unroll_typeIR(typeIR)

2. Otherwise,

  1. Return typeIR'

def $unroll_aliasType(typeIR')

1. Case analysis on typeIR'

  1. Case (let (TYPE _typeId typeIR) be %, % has type newTypeIR)

    1. Return $unroll_aliasType(typeIR)

  2. Case (let (TYPEDEF _typeId typeIR) be %, % has type typedefTypeIR)

    1. Return $unroll_aliasType(typeIR)

2. Otherwise,

  1. Return typeIR'

def $width_of_integerTypeIR(integerTypeIR)

1. Case analysis on integerTypeIR

  1. Case (let intTypeIR be %, % has type intTypeIR)

    1. Return ?()

  2. Case (let (INT `< n `>) be %, % has type fixedIntTypeIR)

    1. Return ?(n)

  3. Case (let (BIT `< n `>) be %, % has type fixedBitTypeIR)

    1. Return ?(n)

  4. Case (let (VARBIT `< n `>) be %, % has type varBitTypeIR)

    1. Return ?(n)

tbl def $is_defaultable_typeIR(typeIR'')
=

  Row : ((BOOL) as typeIR) -> true:

    1. (Let boolTypeIR be typeIR'', typeIR'' has type boolTypeIR)

      1. Return true

  Row : ((ERROR) as typeIR) -> true:

    1. (Let errorTypeIR be typeIR'', typeIR'' has type errorTypeIR)

      1. Return true

  Row : ((STRING) as typeIR) -> true:

    1. (Let stringTypeIR be typeIR'', typeIR'' has type stringTypeIR)

      1. Return true

  Row : (integerTypeIR as typeIR) -> true:

    1. If ((typeIR'' has type integerTypeIR)), then

      1. Return true

  Row : ((TYPEDEF _typeId typeIR) as typeIR) -> $is_defaultable_typeIR(typeIR):

    1. (Let (TYPEDEF _typeId typeIR) be typeIR'', typeIR'' has type typedefTypeIR)

      1. Return $is_defaultable_typeIR(typeIR)

  Row : ((TYPE _typeId typeIR) as typeIR) -> $is_defaultable_typeIR(typeIR):

    1. (Let (TYPE _typeId typeIR) be typeIR'', typeIR'' has type newTypeIR)

      1. Return $is_defaultable_typeIR(typeIR)

  Row : ((TUPLE `< (typeIR)*{typeIR <- typeIR*} `>) as typeIR) -> $forall_(($is_defaultable_typeIR(typeIR))*{typeIR <- typeIR*}):

    1. (Let (TUPLE `< (typeIR)*{typeIR <- typeIR*} `>) be typeIR'', typeIR'' has type tupleTypeIR)

      1. (Let bool be $is_defaultable_typeIR(typeIR))*

      2. Return $forall_((bool)*{bool <- bool*})

  Row : ((ARRAY typeIR `[ _nat `]) as typeIR) -> $is_defaultable_typeIR(typeIR):

    1. (Let (ARRAY typeIR `[ _nat `]) be typeIR'', typeIR'' has type arrayTypeIR)

      1. Return $is_defaultable_typeIR(typeIR)

  Row : ((HEADER_STACK typeIR `[ _nat `]) as typeIR) -> $is_defaultable_typeIR(typeIR):

    1. (Let (HEADER_STACK typeIR `[ _nat `]) be typeIR'', typeIR'' has type headerStackTypeIR)

      1. Return $is_defaultable_typeIR(typeIR)

  Row : ((STRUCT _typeId `< (_typeArgumentIR)*{_typeArgumentIR <- _typeArgumentIR*} `> `{ ((_annotationList typeIR _nameIR ';'))*{_annotationList <- _annotationList*, _nameIR <- _nameIR*, typeIR <- typeIR*} `}) as typeIR) -> $forall_(($is_defaultable_typeIR(typeIR))*{typeIR <- typeIR*}):

    1. (Let (STRUCT _typeId `< (_typeArgumentIR)*{_typeArgumentIR <- _typeArgumentIR*} `> `{ ((_annotationList typeIR _nameIR ';'))*{_annotationList <- _annotationList*, _nameIR <- _nameIR*, typeIR <- typeIR*} `}) be typeIR'', typeIR'' has type structTypeIR)

      1. (Let bool be $is_defaultable_typeIR(typeIR))*

      2. Return $forall_((bool)*{bool <- bool*})

  Row : ((HEADER _typeId `< (_typeArgumentIR)*{_typeArgumentIR <- _typeArgumentIR*} `> `{ ((_annotationList typeIR _nameIR ';'))*{_annotationList <- _annotationList*, _nameIR <- _nameIR*, typeIR <- typeIR*} `}) as typeIR) -> $forall_(($is_defaultable_typeIR(typeIR))*{typeIR <- typeIR*}):

    1. (Let (HEADER _typeId `< (_typeArgumentIR)*{_typeArgumentIR <- _typeArgumentIR*} `> `{ ((_annotationList typeIR _nameIR ';'))*{_annotationList <- _annotationList*, _nameIR <- _nameIR*, typeIR <- typeIR*} `}) be typeIR'', typeIR'' has type headerTypeIR)

      1. (Let bool be $is_defaultable_typeIR(typeIR))*

      2. Return $forall_((bool)*{bool <- bool*})

  Row : ((HEADER_UNION _typeId `< (_typeArgumentIR)*{_typeArgumentIR <- _typeArgumentIR*} `> `{ ((_annotationList typeIR _nameIR ';'))*{_annotationList <- _annotationList*, _nameIR <- _nameIR*, typeIR <- typeIR*} `}) as typeIR) -> $forall_(($is_defaultable_typeIR(typeIR))*{typeIR <- typeIR*}):

    1. (Let (HEADER_UNION _typeId `< (_typeArgumentIR)*{_typeArgumentIR <- _typeArgumentIR*} `> `{ ((_annotationList typeIR _nameIR ';'))*{_annotationList <- _annotationList*, _nameIR <- _nameIR*, typeIR <- typeIR*} `}) be typeIR'', typeIR'' has type headerUnionTypeIR)

      1. (Let bool be $is_defaultable_typeIR(typeIR))*

      2. Return $forall_((bool)*{bool <- bool*})

  Row : ((ENUM _typeId `{ (_nameIR)*{_nameIR <- _nameIR*} `}) as typeIR) -> true:

    1. If ((typeIR'' has type simpleEnumTypeIR)), then

      1. Return true

  Row : ((ENUM _typeId `< typeIR `> `{ (_valueFieldIR)*{_valueFieldIR <- _valueFieldIR*} `}) as typeIR) -> $is_defaultable_typeIR(typeIR):

    1. (Let (ENUM _typeId `< typeIR `> `{ (_valueFieldIR)*{_valueFieldIR <- _valueFieldIR*} `}) be typeIR'', typeIR'' has type serializableEnumTypeIR)

      1. Return $is_defaultable_typeIR(typeIR)

  Row : _typeIR -> false:

    1. Return false

tbl def $is_equalable_typeIR(typeIR'')
=

  Row : ((VOID) as typeIR) -> false:

    1. (Let voidTypeIR be typeIR'', typeIR'' has type voidTypeIR)

      1. Return false

  Row : ((_NAME typeId) as typeIR) -> false:

    1. If ((typeIR'' has type nameTypeIR)), then

      1. Return false

  Row : ((TYPEDEF _typeId typeIR) as typeIR) -> $is_equalable_typeIR(typeIR):

    1. (Let (TYPEDEF _typeId typeIR) be typeIR'', typeIR'' has type typedefTypeIR)

      1. Return $is_equalable_typeIR(typeIR)

  Row : (externObjectTypeIR as typeIR) -> false:

    1. If ((typeIR'' has type externObjectTypeIR)), then

      1. Return false

  Row : (parserObjectTypeIR as typeIR) -> false:

    1. If ((typeIR'' has type parserObjectTypeIR)), then

      1. Return false

  Row : (controlObjectTypeIR as typeIR) -> false:

    1. If ((typeIR'' has type controlObjectTypeIR)), then

      1. Return false

  Row : (packageObjectTypeIR as typeIR) -> false:

    1. If ((typeIR'' has type packageObjectTypeIR)), then

      1. Return false

  Row : (tableObjectTypeIR as typeIR) -> false:

    1. If ((typeIR'' has type tableObjectTypeIR)), then

      1. Return false

  Row : ((DEFAULT) as typeIR) -> false:

    1. (Let defaultTypeIR be typeIR'', typeIR'' has type defaultTypeIR)

      1. Return false

  Row : (sequenceTypeIR as typeIR) -> false:

    1. If ((typeIR'' has type sequenceTypeIR)), then

      1. Return false

  Row : (recordTypeIR as typeIR) -> false:

    1. If ((typeIR'' has type recordTypeIR)), then

      1. Return false

  Row : ((HEADER_INVALID) as typeIR) -> false:

    1. (Let invalidHeaderTypeIR be typeIR'', typeIR'' has type invalidHeaderTypeIR)

      1. Return false

  Row : (setTypeIR as typeIR) -> false:

    1. If ((typeIR'' has type setTypeIR)), then

      1. Return false

  Row : (tableMetadataTypeIR as typeIR) -> false:

    1. If ((typeIR'' has type tableMetadataTypeIR)), then

      1. Return false

  Row : _typeIR -> true:

    1. Return true

tbl def $is_assignable_typeIR(typeIR'')
=

  Row : ((VOID) as typeIR) -> false:

    1. (Let voidTypeIR be typeIR'', typeIR'' has type voidTypeIR)

      1. Return false

  Row : ((STRING) as typeIR) -> false:

    1. (Let stringTypeIR be typeIR'', typeIR'' has type stringTypeIR)

      1. Return false

  Row : ((INT) as typeIR) -> false:

    1. (Let intTypeIR be typeIR'', typeIR'' has type intTypeIR)

      1. Return false

  Row : ((TYPEDEF _typeId typeIR) as typeIR) -> $is_assignable_typeIR(typeIR):

    1. (Let (TYPEDEF _typeId typeIR) be typeIR'', typeIR'' has type typedefTypeIR)

      1. Return $is_assignable_typeIR(typeIR)

  Row : (objectTypeIR as typeIR) -> false:

    1. If ((typeIR'' has type objectTypeIR)), then

      1. Return false

  Row : (synthesizedTypeIR as typeIR) -> false:

    1. If ((typeIR'' has type synthesizedTypeIR)), then

      1. Return false

  Row : _typeIR -> true:

    1. Return true

tbl def $is_serializable_typeIR(typeIR'')
=

  Row : ((BOOL) as typeIR) -> true:

    1. (Let boolTypeIR be typeIR'', typeIR'' has type boolTypeIR)

      1. Return true

  Row : ((INT `< _nat `>) as typeIR) -> true:

    1. If ((typeIR'' has type fixedIntTypeIR)), then

      1. Return true

  Row : ((BIT `< _nat `>) as typeIR) -> true:

    1. If ((typeIR'' has type fixedBitTypeIR)), then

      1. Return true

  Row : ((VARBIT `< _nat `>) as typeIR) -> true:

    1. If ((typeIR'' has type varBitTypeIR)), then

      1. Return true

  Row : ((TYPEDEF _typeId typeIR) as typeIR) -> $is_serializable_typeIR(typeIR):

    1. (Let (TYPEDEF _typeId typeIR) be typeIR'', typeIR'' has type typedefTypeIR)

      1. Return $is_serializable_typeIR(typeIR)

  Row : ((TYPE _typeId typeIR) as typeIR) -> $is_serializable_typeIR(typeIR):

    1. (Let (TYPE _typeId typeIR) be typeIR'', typeIR'' has type newTypeIR)

      1. Return $is_serializable_typeIR(typeIR)

  Row : ((ENUM _typeId `< typeIR `> `{ (_valueFieldIR)*{_valueFieldIR <- _valueFieldIR*} `}) as typeIR) -> $is_serializable_typeIR(typeIR):

    1. (Let (ENUM _typeId `< typeIR `> `{ (_valueFieldIR)*{_valueFieldIR <- _valueFieldIR*} `}) be typeIR'', typeIR'' has type serializableEnumTypeIR)

      1. Return $is_serializable_typeIR(typeIR)

  Row : ((TUPLE `< (typeIR)*{typeIR <- typeIR*} `>) as typeIR) -> $forall_(($is_serializable_typeIR(typeIR))*{typeIR <- typeIR*}):

    1. (Let (TUPLE `< (typeIR)*{typeIR <- typeIR*} `>) be typeIR'', typeIR'' has type tupleTypeIR)

      1. (Let bool be $is_serializable_typeIR(typeIR))*

      2. Return $forall_((bool)*{bool <- bool*})

  Row : ((ARRAY typeIR `[ _nat `]) as typeIR) -> $is_serializable_typeIR(typeIR):

    1. (Let (ARRAY typeIR `[ _nat `]) be typeIR'', typeIR'' has type arrayTypeIR)

      1. Return $is_serializable_typeIR(typeIR)

  Row : ((HEADER_STACK typeIR `[ _nat `]) as typeIR) -> $is_serializable_typeIR(typeIR):

    1. (Let (HEADER_STACK typeIR `[ _nat `]) be typeIR'', typeIR'' has type headerStackTypeIR)

      1. Return $is_serializable_typeIR(typeIR)

  Row : ((STRUCT _typeId `< (_typeArgumentIR)*{_typeArgumentIR <- _typeArgumentIR*} `> `{ ((_annotationList typeIR _nameIR ';'))*{_annotationList <- _annotationList*, _nameIR <- _nameIR*, typeIR <- typeIR*} `}) as typeIR) -> $forall_(($is_serializable_typeIR(typeIR))*{typeIR <- typeIR*}):

    1. (Let (STRUCT _typeId `< (_typeArgumentIR)*{_typeArgumentIR <- _typeArgumentIR*} `> `{ ((_annotationList typeIR _nameIR ';'))*{_annotationList <- _annotationList*, _nameIR <- _nameIR*, typeIR <- typeIR*} `}) be typeIR'', typeIR'' has type structTypeIR)

      1. (Let bool be $is_serializable_typeIR(typeIR))*

      2. Return $forall_((bool)*{bool <- bool*})

  Row : ((HEADER _typeId `< (_typeArgumentIR)*{_typeArgumentIR <- _typeArgumentIR*} `> `{ ((_annotationList typeIR _nameIR ';'))*{_annotationList <- _annotationList*, _nameIR <- _nameIR*, typeIR <- typeIR*} `}) as typeIR) -> $forall_(($is_serializable_typeIR(typeIR))*{typeIR <- typeIR*}):

    1. (Let (HEADER _typeId `< (_typeArgumentIR)*{_typeArgumentIR <- _typeArgumentIR*} `> `{ ((_annotationList typeIR _nameIR ';'))*{_annotationList <- _annotationList*, _nameIR <- _nameIR*, typeIR <- typeIR*} `}) be typeIR'', typeIR'' has type headerTypeIR)

      1. (Let bool be $is_serializable_typeIR(typeIR))*

      2. Return $forall_((bool)*{bool <- bool*})

  Row : ((HEADER_UNION _typeId `< (_typeArgumentIR)*{_typeArgumentIR <- _typeArgumentIR*} `> `{ ((_annotationList typeIR _nameIR ';'))*{_annotationList <- _annotationList*, _nameIR <- _nameIR*, typeIR <- typeIR*} `}) as typeIR) -> $forall_(($is_serializable_typeIR(typeIR))*{typeIR <- typeIR*}):

    1. (Let (HEADER_UNION _typeId `< (_typeArgumentIR)*{_typeArgumentIR <- _typeArgumentIR*} `> `{ ((_annotationList typeIR _nameIR ';'))*{_annotationList <- _annotationList*, _nameIR <- _nameIR*, typeIR <- typeIR*} `}) be typeIR'', typeIR'' has type headerUnionTypeIR)

      1. (Let bool be $is_serializable_typeIR(typeIR))*

      2. Return $forall_((bool)*{bool <- bool*})

  Row : _typeIR -> false:

    1. Return false

def $typeId_of_typeDefIR(typeDefIR)

1. Case analysis on typeDefIR

  1. Case (let (_NAME typeId) be %, % has type nameTypeIR)

    1. Return typeId

  2. Case (let (TYPEDEF typeId _typeIR) be %, % has type typedefTypeIR)

    1. Return typeId

  3. Case (let (TYPE typeId _typeIR) be %, % has type newTypeIR)

    1. Return typeId

  4. Case (let (STRUCT typeId `< (_typeParameterIR)*{_typeParameterIR <- _typeParameterIR*} `> `{ (_fieldTypeIR)*{_fieldTypeIR <- _fieldTypeIR*} `}) be %, % has type structTypeDefIR)

    1. Return typeId

  5. Case (let (HEADER typeId `< (_typeParameterIR)*{_typeParameterIR <- _typeParameterIR*} `> `{ (_fieldTypeIR)*{_fieldTypeIR <- _fieldTypeIR*} `}) be %, % has type headerTypeDefIR)

    1. Return typeId

  6. Case (let (HEADER_UNION typeId `< (_typeParameterIR)*{_typeParameterIR <- _typeParameterIR*} `> `{ (_fieldTypeIR)*{_fieldTypeIR <- _fieldTypeIR*} `}) be %, % has type headerUnionTypeDefIR)

    1. Return typeId

  7. Case (let (ENUM typeId `{ (_nameIR)*{_nameIR <- _nameIR*} `}) be %, % has type simpleEnumTypeIR)

    1. Return typeId

  8. Case (let (ENUM typeId `< _typeIR `> `{ (_valueFieldIR)*{_valueFieldIR <- _valueFieldIR*} `}) be %, % has type serializableEnumTypeIR)

    1. Return typeId

  9. Case (let (EXTERN typeId `< (_typeParameterIR)*{_typeParameterIR <- _typeParameterIR*} ',' (_typeParameterIR')*{_typeParameterIR' <- _typeParameterIR'*} `> (`{ (_pair<callableId, externMethodTypeDefIR>)*{_pair<callableId, externMethodTypeDefIR> <- _pair<callableId, externMethodTypeDefIR>*} `})) be %, % has type externObjectTypeDefIR)

    1. Return typeId

  10. Case (let (PARSER typeId `< (_typeParameterIR)*{_typeParameterIR <- _typeParameterIR*} ',' (_typeParameterIR')*{_typeParameterIR' <- _typeParameterIR'*} `> `( (_parameterIR)*{_parameterIR <- _parameterIR*} `)) be %, % has type parserObjectTypeDefIR)

    1. Return typeId

  11. Case (let (CONTROL typeId `< (_typeParameterIR)*{_typeParameterIR <- _typeParameterIR*} ',' (_typeParameterIR')*{_typeParameterIR' <- _typeParameterIR'*} `> `( (_parameterIR)*{_parameterIR <- _parameterIR*} `)) be %, % has type controlObjectTypeDefIR)

    1. Return typeId

  12. Case (let (PACKAGE typeId `< (_typeParameterIR)*{_typeParameterIR <- _typeParameterIR*} ',' (_typeParameterIR')*{_typeParameterIR' <- _typeParameterIR'*} `> `{ (_typeIR)*{_typeIR <- _typeIR*} `}) be %, % has type packageObjectTypeDefIR)

    1. Return typeId

  13. Case (let (TABLE typeId `{ _tableMetadataStructTypeIR `}) be %, % has type tableObjectTypeIR)

    1. Return typeId

def $typeIR_of_typeDefIR(typeDefIR)

1. Case analysis on typeDefIR

  1. Case (let nameTypeDefIR be %, % has type nameTypeDefIR)

    1. Return (nameTypeDefIR as typeIR)

  2. Case (let aliasTypeDefIR be %, % has type aliasTypeDefIR)

    1. Return (aliasTypeDefIR as typeIR)

  3. Case (let (STRUCT typeId `< (typeParameterIR)*{typeParameterIR <- typeParameterIR*} `> `{ (fieldTypeIR)*{fieldTypeIR <- fieldTypeIR*} `}) be %, % has type structTypeDefIR)

    1. Return ((STRUCT typeId `< (((_NAME typeParameterIR) as typeIR))*{typeParameterIR <- typeParameterIR*} `> `{ (fieldTypeIR)*{fieldTypeIR <- fieldTypeIR*} `}) as typeIR)

  4. Case (let (HEADER typeId `< (typeParameterIR)*{typeParameterIR <- typeParameterIR*} `> `{ (fieldTypeIR)*{fieldTypeIR <- fieldTypeIR*} `}) be %, % has type headerTypeDefIR)

    1. Return ((HEADER typeId `< (((_NAME typeParameterIR) as typeIR))*{typeParameterIR <- typeParameterIR*} `> `{ (fieldTypeIR)*{fieldTypeIR <- fieldTypeIR*} `}) as typeIR)

  5. Case (let (HEADER_UNION typeId `< (typeParameterIR)*{typeParameterIR <- typeParameterIR*} `> `{ (fieldTypeIR)*{fieldTypeIR <- fieldTypeIR*} `}) be %, % has type headerUnionTypeDefIR)

    1. Return ((HEADER_UNION typeId `< (((_NAME typeParameterIR) as typeIR))*{typeParameterIR <- typeParameterIR*} `> `{ (fieldTypeIR)*{fieldTypeIR <- fieldTypeIR*} `}) as typeIR)

  6. Case (let enumTypeDefIR be %, % has type enumTypeDefIR)

    1. Return (enumTypeDefIR as typeIR)

  7. Case (let (EXTERN typeId `< (typeParameterIR_expl)*{typeParameterIR_expl <- typeParameterIR_expl*} ',' (typeParameterIR_impl)*{typeParameterIR_impl <- typeParameterIR_impl*} `> (`{ ((callableId ':' externMethodTypeDefIR))*{callableId <- callableId*, externMethodTypeDefIR <- externMethodTypeDefIR*} `})) be %, % has type externObjectTypeDefIR)

    1. (Let (typeParameterIR)*{typeParameterIR <- typeParameterIR*} be (typeParameterIR_expl)*{typeParameterIR_expl <- typeParameterIR_expl*} ++ (typeParameterIR_impl)*{typeParameterIR_impl <- typeParameterIR_impl*})

    2. Return ((EXTERN typeId `< (((_NAME typeParameterIR) as typeIR))*{typeParameterIR <- typeParameterIR*} `> (`{ ((callableId ':' externMethodTypeDefIR))*{callableId <- callableId*, externMethodTypeDefIR <- externMethodTypeDefIR*} `})) as typeIR)

  8. Case (let (PARSER typeId `< (typeParameterIR_expl)*{typeParameterIR_expl <- typeParameterIR_expl*} ',' (typeParameterIR_impl)*{typeParameterIR_impl <- typeParameterIR_impl*} `> `( (parameterIR)*{parameterIR <- parameterIR*} `)) be %, % has type parserObjectTypeDefIR)

    1. (Let (typeParameterIR)*{typeParameterIR <- typeParameterIR*} be (typeParameterIR_expl)*{typeParameterIR_expl <- typeParameterIR_expl*} ++ (typeParameterIR_impl)*{typeParameterIR_impl <- typeParameterIR_impl*})

    2. Return ((PARSER typeId `< (((_NAME typeParameterIR) as typeIR))*{typeParameterIR <- typeParameterIR*} `> `( (parameterIR)*{parameterIR <- parameterIR*} `)) as typeIR)

  9. Case (let (CONTROL typeId `< (typeParameterIR_expl)*{typeParameterIR_expl <- typeParameterIR_expl*} ',' (typeParameterIR_impl)*{typeParameterIR_impl <- typeParameterIR_impl*} `> `( (parameterIR)*{parameterIR <- parameterIR*} `)) be %, % has type controlObjectTypeDefIR)

    1. (Let (typeParameterIR)*{typeParameterIR <- typeParameterIR*} be (typeParameterIR_expl)*{typeParameterIR_expl <- typeParameterIR_expl*} ++ (typeParameterIR_impl)*{typeParameterIR_impl <- typeParameterIR_impl*})

    2. Return ((CONTROL typeId `< (((_NAME typeParameterIR) as typeIR))*{typeParameterIR <- typeParameterIR*} `> `( (parameterIR)*{parameterIR <- parameterIR*} `)) as typeIR)

  10. Case (let (PACKAGE typeId `< (typeParameterIR_expl)*{typeParameterIR_expl <- typeParameterIR_expl*} ',' (typeParameterIR_impl)*{typeParameterIR_impl <- typeParameterIR_impl*} `> `{ (typeIR)*{typeIR <- typeIR*} `}) be %, % has type packageObjectTypeDefIR)

    1. (Let (typeParameterIR)*{typeParameterIR <- typeParameterIR*} be (typeParameterIR_expl)*{typeParameterIR_expl <- typeParameterIR_expl*} ++ (typeParameterIR_impl)*{typeParameterIR_impl <- typeParameterIR_impl*})

    2. Return ((PACKAGE typeId `< (((_NAME typeParameterIR) as typeIR))*{typeParameterIR <- typeParameterIR*} `> `{ (typeIR)*{typeIR <- typeIR*} `}) as typeIR)

  11. Case (let tableObjectTypeDefIR be %, % has type tableObjectTypeDefIR)

    1. Return (tableObjectTypeDefIR as typeIR)

def $typeParameterListIR_of_typeDefIR(typeDefIR)

1. Case analysis on typeDefIR

  1. Case (% has type nameTypeDefIR)

    1. Return ([], [])

