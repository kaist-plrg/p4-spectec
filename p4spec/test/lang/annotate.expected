def $specialize_typeDefIR(typeDefIR_base, (typeArgumentIR)*{typeArgumentIR <- typeArgumentIR*})

1. (Let ((typeParameterIR_expl)*{typeParameterIR_expl <- typeParameterIR_expl*}, (typeParameterIR_impl)*{typeParameterIR_impl <- typeParameterIR_impl*}) be $typeParameterListIR_of_typeDefIR(typeDefIR_base))

2. (Let (typeParameterIR)*{typeParameterIR <- typeParameterIR*} be (typeParameterIR_expl)*{typeParameterIR_expl <- typeParameterIR_expl*} ++ (typeParameterIR_impl)*{typeParameterIR_impl <- typeParameterIR_impl*})

3. If ((|(typeParameterIR)*{typeParameterIR <- typeParameterIR*}| = |(typeArgumentIR)*{typeArgumentIR <- typeArgumentIR*}|)), then

  1. (Let theta be (`{ ((typeParameterIR ':' typeArgumentIR))*{typeArgumentIR <- typeArgumentIR*, typeParameterIR <- typeParameterIR*} `}))

  2. (Let typeIR_base be $typeIR_of_typeDefIR(typeDefIR_base))

  3. (Let typeIR_spec be $subst_typeIR(theta, typeIR_base))

  4. Return typeIR_spec

