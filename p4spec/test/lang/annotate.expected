syntax expressionListResult = 
   | _CONT value* (from continueResult<value*>) 
   | EXIT (from exitResult) 
   | REJECT errorValue (from rejectTransitionResult) 

relation Exprs_eval: p EC ARCH |- (typedExpressionIR)*{typedExpressionIR <- typedExpressionIR*} : % % %

1. Group : p EC ARCH |- (typedExpressionIR)*{typedExpressionIR <- typedExpressionIR*} : % % %

  1. Case analysis on (typedExpressionIR)*{typedExpressionIR <- typedExpressionIR*}

    1. Case (% matches pattern [])

      1. Result in: % % % |- % : EC ARCH ((_CONT []) as expressionListResult)

    2. Case (let typedExpressionIR_h :: (typedExpressionIR_t)*{typedExpressionIR_t <- typedExpressionIR_t*} be %, % matches pattern _ :: _)

      1. (Expr_eval: p EC ARCH |- typedExpressionIR_h : EC_1 ARCH_1 expressionResult)

      2. Case analysis on expressionResult

        1. Case (let abortResult be %, % has type abortResult)

          1. Result in: % % % |- % : EC_1 ARCH_1 (abortResult as expressionListResult)

        2. Case (let (_CONT value_h) be %, % has type continueResult<value>)

          1. (Exprs_eval: p EC_1 ARCH_1 |- (typedExpressionIR_t)*{typedExpressionIR_t <- typedExpressionIR_t*} : EC_2 ARCH_2 expressionListResult)

          2. Case analysis on expressionListResult

            1. Case (let abortResult be %, % has type abortResult)

              1. Result in: % % % |- % : EC_2 ARCH_2 (abortResult as expressionListResult)

            2. Case (let (_CONT (value_t)*{value_t <- value_t*}) be %, % has type continueResult<value*>)

              1. Result in: % % % |- % : EC_2 ARCH_2 ((_CONT value_h :: (value_t)*{value_t <- value_t*}) as expressionListResult)

syntax keysetExpressionResult = 
   | _CONT setValue* (from continueResult<setValue*>) 
   | EXIT (from exitResult) 
   | REJECT errorValue (from rejectTransitionResult) 

relation Eval_keyset: EC_0 ARCH_0 |- keysetExpressionIR : % % %

1. Group : EC_0 ARCH_0 |- keysetExpressionIR : % % %

  1. (Let simpleKeysetExpressionListIR be $flatten_keysetExpressionIR(keysetExpressionIR))

  2. (Eval_keysets_simple: EC_0 ARCH_0 |- simpleKeysetExpressionListIR : EC_1 ARCH_1 keysetExpressionResult)

  3. Result in: % % |- % : EC_1 ARCH_1 keysetExpressionResult

relation Argument_eval: p EC_0 ARCH_0 |- argumentIR : % % %

1. Group : p EC_0 ARCH_0 |- argumentIR : % % %

  1. Case analysis on argumentIR

    1. Case (let typedExpressionIR be %, % has type typedExpressionIR)

      1. (Expr_eval: p EC_0 ARCH_0 |- typedExpressionIR : EC_1 ARCH_1 expressionResult)

      2. Result in: % % % |- % : EC_1 ARCH_1 expressionResult

    2. Case (let (nameIR '=' typedExpressionIR) be %, % matches pattern `% = %`)

      1. (Expr_eval: p EC_0 ARCH_0 |- typedExpressionIR : EC_1 ARCH_1 expressionResult)

      2. Result in: % % % |- % : EC_1 ARCH_1 expressionResult

  1. Else Dangling#11802

syntax storageReferenceResult = 
   | _CONT storageReference? (from continueResult<storageReference?>) 
   | EXIT (from exitResult) 
   | REJECT errorValue (from rejectTransitionResult) 

relation Argument_eval_lvalue: p EC ARCH |- argumentIR : % % %

1. Group : p EC ARCH |- argumentIR : % % %

  1. Case analysis on argumentIR

    1. Case (let typedExpressionIR be %, % has type typedExpressionIR)

      1. (Let typedLvalueIR be ! $typedExpressionIR_as_typedLvalueIR(typedExpressionIR))

        1. (Lvalue_eval: p EC ARCH |- typedLvalueIR : EC_1 ARCH_1 storageReferenceResult)

        2. Result in: % % % |- % : EC_1 ARCH_1 storageReferenceResult

    2. Case (let (nameIR '=' typedExpressionIR) be %, % matches pattern `% = %`)

      1. (Let typedLvalueIR be ! $typedExpressionIR_as_typedLvalueIR(typedExpressionIR))

        1. (Lvalue_eval: p EC ARCH |- typedLvalueIR : EC_1 ARCH_1 storageReferenceResult)

        2. Result in: % % % |- % : EC_1 ARCH_1 storageReferenceResult

    3. Case (% matches pattern `% = _`)

      1. Result in: % % % |- % : EC ARCH ((_CONT ?()) as storageReferenceResult)

    4. Case (% matches pattern `_`)

      1. Result in: % % % |- % : EC ARCH ((_CONT ?()) as storageReferenceResult)

relation Lvalue_eval: p EC ARCH |- (lvalueIR '#' lvalueNoteIR) : % % %

1. Case analysis on lvalueIR

  1. Case (let referenceExpressionIR be %, % has type referenceExpressionIR)

    1. Group referenceExpressionIR: p EC ARCH |- ((referenceExpressionIR as lvalueIR) '#' lvalueNoteIR) : % % %

      1. Result in: % % % |- % : EC ARCH ((_CONT ?((referenceExpressionIR as storageReference))) as storageReferenceResult)

  2. Case (let (typedLvalueIR '.' nameIR) be %, % matches pattern `% . %`)

    1. Group memberAccess: p EC ARCH |- ((typedLvalueIR '.' nameIR) '#' lvalueNoteIR) : % % %

      1. (Lvalue_eval: p EC ARCH |- typedLvalueIR : EC_1 ARCH_1 storageReferenceResult')

      2. Case analysis on storageReferenceResult'

        1. Case (let abortResult be %, % has type abortResult)

          1. Result in: % % % |- % : EC_1 ARCH_1 (abortResult as storageReferenceResult)

        2. Case (let (_CONT (storageReference')?{storageReference' <- storageReference'?}) be %, % has type continueResult<storageReference?>)

          1. (Let ?(storageReference) be (storageReference')?{storageReference' <- storageReference'?}, (storageReference')?{storageReference' <- storageReference'?} matches pattern (_))

            1. (Lvalue_read: p EC_1 ARCH_1 |- storageReference : value)

            2. Case analysis on (value has type headerStackValue)

              1. Case true

                1. (Let headerStackValue be (value as headerStackValue))

                2. (Let (HEADER_STACK `[ (value_element)*{value_element <- value_element*} `( n_idx `) `]) be headerStackValue)

                3. Block (4 arms)

                Arm 1:

                  1. If ((nameIR = "next")), then

                    1. (Let n_size be |(value_element)*{value_element <- value_element*}|)

                    2. If ((n_idx >= n_size)), then

                      1. (Let rejectTransitionResult be (REJECT (ERROR '.' "StackOutOfBounds")))

                      2. Result in: % % % |- % : EC_1 ARCH_1 (rejectTransitionResult as storageReferenceResult)

                    2. Else Dangling#11844

                  1. Else Dangling#11842

                Arm 2:

                  1. (Let n_size be |(value_element)*{value_element <- value_element*}|)

                  2. If ((nameIR = "next")), then

                    1. If ((n_idx < n_size)), then

                      1. (Let storageReferenceResult be ((_CONT ?((storageReference '.' nameIR))) as storageReferenceResult))

                      2. Result in: % % % |- % : EC_1 ARCH_1 storageReferenceResult

                    1. Else Dangling#11849

                  2. Else Dangling#11848

                Arm 3:

                  1. If ((nameIR = "last")), then

                    1. (Let n_size be |(value_element)*{value_element <- value_element*}|)

                    2. If (((n_idx < 1) \/ (n_idx > n_size))), then

                      1. (Let rejectTransitionResult be (REJECT (ERROR '.' "StackOutOfBounds")))

                      2. Result in: % % % |- % : EC_1 ARCH_1 (rejectTransitionResult as storageReferenceResult)

                    2. Else Dangling#11854

                  1. Else Dangling#11852

                Arm 4:

                  1. (Let n_size be |(value_element)*{value_element <- value_element*}|)

                  2. If ((nameIR = "last")), then

                    1. If (~((n_idx < 1) \/ (n_idx > n_size))), then

                      1. (Let storageReferenceResult be ((_CONT ?((storageReference '.' nameIR))) as storageReferenceResult))

                      2. Result in: % % % |- % : EC_1 ARCH_1 storageReferenceResult

                    1. Else Dangling#11859

                  2. Else Dangling#11858

              2. Case false

                1. (Let storageReferenceResult be ((_CONT ?((storageReference '.' nameIR))) as storageReferenceResult))

                2. Result in: % % % |- % : EC_1 ARCH_1 storageReferenceResult

  3. Case (let (typedLvalueIR `[ typedExpressionIR `]) be %, % matches pattern `% [%]`)

    1. Group indexAccess: p EC ARCH |- ((typedLvalueIR `[ typedExpressionIR `]) '#' lvalueNoteIR) : % % %

      1. (Lvalue_eval: p EC ARCH |- typedLvalueIR : EC_1 ARCH_1 storageReferenceResult')

      2. Case analysis on storageReferenceResult'

        1. Case (let abortResult be %, % has type abortResult)

          1. Result in: % % % |- % : EC_1 ARCH_1 (abortResult as storageReferenceResult)

        2. Case (let (_CONT (storageReference')?{storageReference' <- storageReference'?}) be %, % has type continueResult<storageReference?>)

          1. (Let ?(storageReference) be (storageReference')?{storageReference' <- storageReference'?}, (storageReference')?{storageReference' <- storageReference'?} matches pattern (_))

            1. (Expr_eval: p EC_1 ARCH_1 |- typedExpressionIR : EC_2 ARCH_2 expressionResult)

            2. Case analysis on expressionResult

              1. Case (let abortResult be %, % has type abortResult)

                1. Result in: % % % |- % : EC_2 ARCH_2 (abortResult as storageReferenceResult)

              2. Case (let (_CONT value) be %, % has type continueResult<value>)

                1. (Let integerValue_index be value, value has type integerValue)

                  1. (Let storageReferenceResult be ((_CONT ?((storageReference `[ (integerValue_index as value) `]))) as storageReferenceResult))

                  2. Result in: % % % |- % : EC_2 ARCH_2 storageReferenceResult

  4. Case (let (typedLvalueIR `[ typedExpressionIR_l sliceop typedExpressionIR_r `]) be %, % matches pattern `% [% % %]`)

    1. Group sliceAccess: p EC ARCH |- ((typedLvalueIR `[ typedExpressionIR_l sliceop typedExpressionIR_r `]) '#' lvalueNoteIR) : % % %

      1. (Lvalue_eval: p EC ARCH |- typedLvalueIR : EC_1 ARCH_1 storageReferenceResult')

      2. Case analysis on storageReferenceResult'

        1. Case (let abortResult be %, % has type abortResult)

          1. Result in: % % % |- % : EC_1 ARCH_1 (abortResult as storageReferenceResult)

        2. Case (let (_CONT (storageReference')?{storageReference' <- storageReference'?}) be %, % has type continueResult<storageReference?>)

          1. (Let ?(storageReference) be (storageReference')?{storageReference' <- storageReference'?}, (storageReference')?{storageReference' <- storageReference'?} matches pattern (_))

            1. (Exprs_eval: p EC_1 ARCH_1 |- [typedExpressionIR_l, typedExpressionIR_r] : EC_2 ARCH_2 expressionListResult)

            2. Case analysis on expressionListResult

              1. Case (let abortResult be %, % has type abortResult)

                1. Result in: % % % |- % : EC_2 ARCH_2 (abortResult as storageReferenceResult)

              2. Case (let (_CONT (value)*{value <- value*}) be %, % has type continueResult<value*>)

                1. (Let [value_l, value_r] be (value)*{value <- value*}, (value)*{value <- value*} matches pattern [ _/2 ])

                  1. (Let storageReferenceResult be ((_CONT ?((storageReference `[ value_l sliceop value_r `]))) as storageReferenceResult))

                  2. Result in: % % % |- % : EC_1 ARCH_1 storageReferenceResult

  5. Case (let (`( typedLvalueIR `)) be %, % matches pattern `(%)`)

    1. Group parenthesized: p EC ARCH |- ((`( typedLvalueIR `)) '#' lvalueNoteIR) : % % %

      1. (Lvalue_eval: p EC ARCH |- typedLvalueIR : EC_1 ARCH_1 storageReferenceResult)

      2. Result in: % % % |- % : EC_1 ARCH_1 storageReferenceResult

relation Lvalue_read: p EC ARCH |- storageReference' : %

1. Case analysis on storageReference'

  1. Case (let prefixedNameIR be %, % has type prefixedNameIR)

    1. Group referenceExpressionIR: p EC ARCH |- (prefixedNameIR as storageReference) : %

      1. (Let value be $find_var_e(prefixedNameIR, p, EC))

      2. Result in: % % % |- % : value

  2. Case (let (storageReference '.' nameIR) be %, % matches pattern `% . %`)

    1. Group memberAccess: p EC ARCH |- (storageReference '.' nameIR) : %

      1. (Lvalue_read: p EC ARCH |- storageReference : value_base)

      2. Case analysis on value_base

        1. Case (let (REF objectId) be %, % has type objectReferenceValue)

          1. (Let object be ! $find_object_e(ARCH, objectId))

            1. (Let (PACKAGE `< _theta `> `{ frame `}) be object, object has type packageObject)

              1. (Let value be ! $find_map<nameIR, value>(frame, nameIR))

                1. Result in: % % % |- % : value

        2. Case (let headerStackValue_base be %, % has type headerStackValue)

          1. (Let (HEADER_STACK `[ (value_element)*{value_element <- value_element*} `( n_idx `) `]) be headerStackValue_base)

          2. Case analysis on nameIR

            1. Case (% = "next")

              1. (Let n_size be |(value_element)*{value_element <- value_element*}|)

              2. If ((n_idx < n_size)), then

                1. If ((n_idx < |(value_element)*{value_element <- value_element*}|)), then

                  1. (Let value be (value_element)*{value_element <- value_element*}[n_idx])

                  2. Result in: % % % |- % : value

                1. Else Dangling#11928

              2. Else Dangling#11927

            2. Case (% = "last")

              1. (Let n_size be |(value_element)*{value_element <- value_element*}|)

              2. If (~((n_idx < 1) \/ (n_idx > n_size))), then

                1. (Let i be (n_idx - 1))

                2. (Let n_idx_last be i, i has type nat)

                  1. If ((n_idx_last < |(value_element)*{value_element <- value_element*}|)), then

                    1. (Let value be (value_element)*{value_element <- value_element*}[n_idx_last])

                    2. Result in: % % % |- % : value

                  1. Else Dangling#11936

              2. Else Dangling#11932

          2. Else Dangling#11925

        3. Case (let structValue_base be %, % has type structValue)

          1. (Let (STRUCT _typeId `{ ((value_field nameIR_field ';'))*{nameIR_field <- nameIR_field*, value_field <- value_field*} `}) be structValue_base)

          2. (Let value be ! $assoc_<id, value>(nameIR, ((nameIR_field, value_field))*{nameIR_field <- nameIR_field*, value_field <- value_field*}))

            1. Result in: % % % |- % : value

        4. Case (let headerValue_base be %, % has type headerValue)

          1. (Let (HEADER _typeId `{ _b ';' ((value_field nameIR_field ';'))*{nameIR_field <- nameIR_field*, value_field <- value_field*} `}) be headerValue_base)

          2. (Let value be ! $assoc_<id, value>(nameIR, ((nameIR_field, value_field))*{nameIR_field <- nameIR_field*, value_field <- value_field*}))

            1. Result in: % % % |- % : value

        5. Case (let headerUnionValue_base be %, % has type headerUnionValue)

          1. (Let (HEADER_UNION _typeId `{ ((value_field nameIR_field ';'))*{nameIR_field <- nameIR_field*, value_field <- value_field*} `}) be headerUnionValue_base)

          2. (Let value be ! $assoc_<id, value>(nameIR, ((nameIR_field, value_field))*{nameIR_field <- nameIR_field*, value_field <- value_field*}))

            1. Result in: % % % |- % : value

      2. Else Dangling#11912

  3. Case (let (storageReference `[ value' `]) be %, % matches pattern `% [%]`)

    1. (Let integerValue_index be value', value' has type integerValue)

      1. Group indexAccess: p EC ARCH |- (storageReference `[ (integerValue_index as value) `]) : %

        1. (Lvalue_read: p EC ARCH |- storageReference : value'')

        2. Case analysis on value''

          1. Case (let arrayValue_base be %, % has type arrayValue)

            1. (Let (ARRAY `[ (value_element)*{value_element <- value_element*} `]) be arrayValue_base)

            2. (Let n_size be |(value_element)*{value_element <- value_element*}|)

            3. (Let i_idx be $int_of_integerValue(integerValue_index))

            4. (Let b_in_bounds be ((i_idx < (n_size as int)) /\ (i_idx >= (0 as int))))

            5. Case analysis on b_in_bounds

              1. Case true

                1. (Let n_idx be i_idx, i_idx has type nat)

                  1. If ((n_idx < |(value_element)*{value_element <- value_element*}|)), then

                    1. (Let value be (value_element)*{value_element <- value_element*}[n_idx])

                    2. Result in: % % % |- % : value

                  1. Else Dangling#11971

              2. Case false

                1. If ((0 < |(value_element)*{value_element <- value_element*}|)), then

                  1. (Let value''' be (value_element)*{value_element <- value_element*}[0])

                  2. (Let (HEADER typeId `{ b_valid ';' (fieldValue)*{fieldValue <- fieldValue*} `}) be value''', value''' has type headerValue)

                    1. (Let value be ((HEADER typeId `{ false ';' (fieldValue)*{fieldValue <- fieldValue*} `}) as value))

                    2. Result in: % % % |- % : value

                1. Else Dangling#11974

          2. Case (let headerStackValue_base be %, % has type headerStackValue)

            1. (Let (HEADER_STACK `[ (value_element)*{value_element <- value_element*} `( _nat `) `]) be headerStackValue_base)

            2. (Let n_size be |(value_element)*{value_element <- value_element*}|)

            3. (Let i_idx be $int_of_integerValue(integerValue_index))

            4. (Let b_in_bounds be ((i_idx < (n_size as int)) /\ (i_idx >= (0 as int))))

            5. Case analysis on b_in_bounds

              1. Case true

                1. (Let n_idx be i_idx, i_idx has type nat)

                  1. If ((n_idx < |(value_element)*{value_element <- value_element*}|)), then

                    1. (Let value be (value_element)*{value_element <- value_element*}[n_idx])

                    2. Result in: % % % |- % : value

                  1. Else Dangling#11988

              2. Case false

                1. If ((0 < |(value_element)*{value_element <- value_element*}|)), then

                  1. (Let value''' be (value_element)*{value_element <- value_element*}[0])

                  2. (Let (HEADER typeId `{ b_valid ';' (fieldValue)*{fieldValue <- fieldValue*} `}) be value''', value''' has type headerValue)

                    1. (Let value be ((HEADER typeId `{ false ';' (fieldValue)*{fieldValue <- fieldValue*} `}) as value))

                    2. Result in: % % % |- % : value

                1. Else Dangling#11991

        2. Else Dangling#11962

  4. Case (let (storageReference `[ value' sliceop value'' `]) be %, % matches pattern `% [% % %]`)

    1. Group sliceAccess: p EC ARCH |- (storageReference `[ value' sliceop value'' `]) : %

      1. Case analysis on sliceop

        1. Case (% matches pattern `:`)

          1. (Lvalue_read: p EC ARCH |- storageReference : value_base)

          2. (Let value be $bitacc_range_op(value_base, value', value''))

          3. Result in: % % % |- % : value

        2. Case (% matches pattern `+:`)

          1. (Lvalue_read: p EC ARCH |- storageReference : value_base)

          2. (Let value be $bitacc_offset_op(value_base, value', value''))

          3. Result in: % % % |- % : value

relation Lvalue_write: p EC_0 ARCH |- storageReference' := value : %

1. Case analysis on storageReference'

  1. Case (let prefixedNameIR be %, % has type prefixedNameIR)

    1. Group referenceExpressionIR: p EC_0 ARCH |- (prefixedNameIR as storageReference) := value : %

      1. (Let EC_1 be $update_var_e(p, EC_0, prefixedNameIR, value))

      2. Result in: % % % |- % := % : EC_1

  2. Case (let (storageReference '.' nameIR) be %, % matches pattern `% . %`)

    1. Group memberAccess: p EC_0 ARCH |- (storageReference '.' nameIR) := value : %

      1. (Lvalue_read: p EC_0 ARCH |- storageReference : value')

      2. Case analysis on value'

        1. Case (let headerStackValue_base be %, % has type headerStackValue)

          1. (Let (HEADER_STACK `[ (value_element)*{value_element <- value_element*} `( n_idx `) `]) be headerStackValue_base)

          2. Case analysis on nameIR

            1. Case (% = "next")

              1. (Let (value_element_update)*{value_element_update <- value_element_update*} be (value_element)*{value_element <- value_element*}[[n_idx] = value])

              2. (Let headerStackValue_base_update be (HEADER_STACK `[ (value_element_update)*{value_element_update <- value_element_update*} `( (n_idx + 1) `) `]))

              3. (Lvalue_write: p EC_0 ARCH |- storageReference := (headerStackValue_base_update as value) : EC_1)

              4. Result in: % % % |- % := % : EC_1

            2. Case (% = "last")

              1. (Let i be (n_idx - 1))

              2. (Let n_idx_last be i, i has type nat)

                1. (Let (value_element_update)*{value_element_update <- value_element_update*} be (value_element)*{value_element <- value_element*}[[n_idx_last] = value])

                2. (Let headerStackValue_base_update be (HEADER_STACK `[ (value_element_update)*{value_element_update <- value_element_update*} `( n_idx `) `]))

                3. (Lvalue_write: p EC_0 ARCH |- storageReference := (headerStackValue_base_update as value) : EC_1)

                4. Result in: % % % |- % := % : EC_1

          2. Else Dangling#12017

        2. Case (let structValue_base be %, % has type structValue)

          1. (Let (STRUCT typeId `{ (fieldValue)*{fieldValue <- fieldValue*} `}) be structValue_base)

          2. (Let (fieldValue_update)*{fieldValue_update <- fieldValue_update*} be $update_fieldValue((fieldValue)*{fieldValue <- fieldValue*}, nameIR, value))

          3. (Let structValue_base_update be (STRUCT typeId `{ (fieldValue_update)*{fieldValue_update <- fieldValue_update*} `}))

          4. (Lvalue_write: p EC_0 ARCH |- storageReference := (structValue_base_update as value) : EC_1)

          5. Result in: % % % |- % := % : EC_1

        3. Case (let headerValue_base be %, % has type headerValue)

          1. (Let (HEADER typeId `{ b_valid ';' (fieldValue)*{fieldValue <- fieldValue*} `}) be headerValue_base)

          2. (Let (fieldValue_update)*{fieldValue_update <- fieldValue_update*} be $update_fieldValue((fieldValue)*{fieldValue <- fieldValue*}, nameIR, value))

          3. (Let headerValue_base_update be (HEADER typeId `{ b_valid ';' (fieldValue_update)*{fieldValue_update <- fieldValue_update*} `}))

          4. (Lvalue_write: p EC_0 ARCH |- storageReference := (headerValue_base_update as value) : EC_1)

          5. Result in: % % % |- % := % : EC_1

        4. Case (let headerUnionValue_base be %, % has type headerUnionValue)

          1. (Let (HEADER_UNION typeId `{ (fieldValue)*{fieldValue <- fieldValue*} `}) be headerUnionValue_base)

          2. (Let ((value_field nameIR_field ';'))*{nameIR_field <- nameIR_field*, value_field <- value_field*} be (fieldValue)*{fieldValue <- fieldValue*})

          3. (Let value_old be ! $assoc_<nameIR, value>(nameIR, ((nameIR_field, value_field))*{nameIR_field <- nameIR_field*, value_field <- value_field*}))

            1. (Let (HEADER _typeId `{ b_valid_old ';' (_fieldValue)*{_fieldValue <- _fieldValue*} `}) be value_old, value_old has type headerValue)

              1. (Let (fieldValue_update)*{fieldValue_update <- fieldValue_update*} be $update_fieldValue((fieldValue)*{fieldValue <- fieldValue*}, nameIR, value))

              2. (Let (HEADER _typeId' `{ b_valid_new ';' (_fieldValue')*{_fieldValue' <- _fieldValue'*} `}) be value, value has type headerValue)

                1. (Let b_toggled be ((~b_valid_old /\ b_valid_new) \/ (b_valid_old /\ ~b_valid_new)))

                2. Case analysis on b_toggled

                  1. Case false

                    1. (Let headerUnionValue_base_update be (HEADER_UNION typeId `{ (fieldValue_update)*{fieldValue_update <- fieldValue_update*} `}))

                    2. (Lvalue_write: p EC_0 ARCH |- storageReference := (headerUnionValue_base_update as value) : EC_1)

                    3. Result in: % % % |- % := % : EC_1

                  2. Case true

                    1. (Let (fieldValue_update')*{fieldValue_update' <- fieldValue_update'*} be $update_headerUnion((fieldValue_update)*{fieldValue_update <- fieldValue_update*}, nameIR))

                    2. (Let headerUnionValue_base_update be (HEADER_UNION typeId `{ (fieldValue_update')*{fieldValue_update' <- fieldValue_update'*} `}))

                    3. (Lvalue_write: p EC_0 ARCH |- storageReference := (headerUnionValue_base_update as value) : EC_1)

                    4. Result in: % % % |- % := % : EC_1

      2. Else Dangling#12014

  3. Case (let (storageReference `[ value' `]) be %, % matches pattern `% [%]`)

    1. (Let integerValue_index be value', value' has type integerValue)

      1. Group indexAccess: p EC_0 ARCH |- (storageReference `[ (integerValue_index as value) `]) := value : %

        1. (Lvalue_read: p EC_0 ARCH |- storageReference : value'')

        2. Case analysis on value''

          1. Case (let arrayValue_base be %, % has type arrayValue)

            1. (Let (ARRAY `[ (value_element)*{value_element <- value_element*} `]) be arrayValue_base)

            2. (Let n_size be |(value_element)*{value_element <- value_element*}|)

            3. (Let i_idx be $int_of_integerValue(integerValue_index))

            4. (Let b_in_bounds be ((i_idx < (n_size as int)) /\ (i_idx >= (0 as int))))

            5. Case analysis on b_in_bounds

              1. Case true

                1. (Let n_idx be i_idx, i_idx has type nat)

                  1. (Let (value_element_update)*{value_element_update <- value_element_update*} be (value_element)*{value_element <- value_element*}[[n_idx] = value])

                  2. (Let arrayValue_base_update be (ARRAY `[ (value_element_update)*{value_element_update <- value_element_update*} `]))

                  3. (Lvalue_write: p EC_0 ARCH |- storageReference := (arrayValue_base_update as value) : EC_1)

                  4. Result in: % % % |- % := % : EC_1

              2. Case false

                1. Result in: % % % |- % := % : EC_0

          2. Case (let headerStackValue_base be %, % has type headerStackValue)

            1. (Let (HEADER_STACK `[ (value_element)*{value_element <- value_element*} `( n_base_idx `) `]) be headerStackValue_base)

            2. (Let n_size be |(value_element)*{value_element <- value_element*}|)

            3. (Let i_idx be $int_of_integerValue(integerValue_index))

            4. (Let b_in_bounds be ((i_idx < (n_size as int)) /\ (i_idx >= (0 as int))))

            5. Case analysis on b_in_bounds

              1. Case true

                1. (Let n_idx be i_idx, i_idx has type nat)

                  1. (Let (value_element_update)*{value_element_update <- value_element_update*} be (value_element)*{value_element <- value_element*}[[n_idx] = value])

                  2. (Let headerStackValue_base_update be (HEADER_STACK `[ (value_element_update)*{value_element_update <- value_element_update*} `( n_base_idx `) `]))

                  3. (Lvalue_write: p EC_0 ARCH |- storageReference := (headerStackValue_base_update as value) : EC_1)

                  4. Result in: % % % |- % := % : EC_1

              2. Case false

                1. Result in: % % % |- % := % : EC_0

        2. Else Dangling#12066

  4. Case (let (storageReference `[ value' sliceop value'' `]) be %, % matches pattern `% [% % %]`)

    1. Group sliceAccess: p EC_0 ARCH |- (storageReference `[ value' sliceop value'' `]) := value : %

      1. Case analysis on sliceop

        1. Case (% matches pattern `:`)

          1. (Lvalue_read: p EC_0 ARCH |- storageReference : value_base)

