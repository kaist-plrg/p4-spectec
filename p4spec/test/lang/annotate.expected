def $subst_externMethodTypeDefEnv(externMethodTypeDefEnv_extern, set<pair<callableId, externMethodTypeDefIR>>)

1. Block (2 arms)

Arm 1:

  1. If ((set<pair<callableId, externMethodTypeDefIR>> = (`{ [] `}))), then

    1. Return externMethodTypeDefEnv_extern

  1. Else Dangling#9345

Arm 2:

  1. (Let (`{ (pair<callableId, externMethodTypeDefIR>)*{pair<callableId, externMethodTypeDefIR> <- pair<callableId, externMethodTypeDefIR>*} `}) be set<pair<callableId, externMethodTypeDefIR>>)

  2. (Let (callableId_init_h ':' externMethodTypeDefIR_init_h) :: ((callableId_init_t ':' externMethodTypeDefIR_init_t))*{callableId_init_t <- callableId_init_t*, externMethodTypeDefIR_init_t <- externMethodTypeDefIR_init_t*} be (pair<callableId, externMethodTypeDefIR>)*{pair<callableId, externMethodTypeDefIR> <- pair<callableId, externMethodTypeDefIR>*}, (pair<callableId, externMethodTypeDefIR>)*{pair<callableId, externMethodTypeDefIR> <- pair<callableId, externMethodTypeDefIR>*} matches pattern _ :: _)

    1. (Let (nameIR_init_h `( (_id)*{_id <- _id*} `)) be callableId_init_h)

    2. (Let (callableId, externMethodTypeDefIR_abstract) be ! $find_non_overloaded<externMethodTypeDefIR>(externMethodTypeDefEnv_extern, nameIR_init_h))

      1. (Let (EXTERN_METHOD ABSTRACT nameIR `< (typeId_expl)*{typeId_expl <- typeId_expl*} ',' (typeId_impl)*{typeId_impl <- typeId_impl*} `> `( (parameterIR)*{parameterIR <- parameterIR*} `) ':' typeIR_ret) be externMethodTypeDefIR_abstract, externMethodTypeDefIR_abstract matches pattern `EXTERN_METHOD ABSTRACT % <% , %> (%) : %`)

        1. (Let externMethodTypeDefIR_concrete be (EXTERN_METHOD nameIR `< (typeId_expl)*{typeId_expl <- typeId_expl*} ',' (typeId_impl)*{typeId_impl <- typeId_impl*} `> `( (parameterIR)*{parameterIR <- parameterIR*} `) ':' typeIR_ret))

        2. If (ExternMethodTypeDef_alpha: externMethodTypeDefIR_concrete ~~ externMethodTypeDefIR_init_h) holds, then

          1. (Let externMethodTypeDefEnv_extern_subst be $update_map<callableId, externMethodTypeDefIR>(externMethodTypeDefEnv_extern, callableId, externMethodTypeDefIR_concrete))

          2. Return $subst_externMethodTypeDefEnv(externMethodTypeDefEnv_extern_subst, (`{ ((callableId_init_t ':' externMethodTypeDefIR_init_t))*{callableId_init_t <- callableId_init_t*, externMethodTypeDefIR_init_t <- externMethodTypeDefIR_init_t*} `}))

        2. Else Dangling#9357

relation InstDecl_objectInitializer_ok: p TC_0 |- annotationList prefixedTypeName `< typeArgumentList `> `( argumentList `) name '=' `{ objectDeclarationList `} ';' : % %

1. Group : p TC_0 |- annotationList prefixedTypeName `< typeArgumentList `> `( argumentList `) name '=' `{ objectDeclarationList `} ';' : % %

  1. (TypeArgumentList_ok: p TC_0 |- typeArgumentList : (typeArgumentIR)*{typeArgumentIR <- typeArgumentIR*} '#' (typeId_impl)*{typeId_impl <- typeId_impl*})

  2. (ArgumentList_ok: p TC_0 |- argumentList : (argumentIR)*{argumentIR <- argumentIR*})

  3. (Let prefixedNameIR be $prefixedTypeName(prefixedTypeName))

  4. (Let constructorTargetIR be (prefixedNameIR `< (typeArgumentIR)*{typeArgumentIR <- typeArgumentIR*} `>))

  5. (ConstructorType_ok: p TC_0 |- constructorTargetIR `( (argumentIR)*{argumentIR <- argumentIR*} `) : constructorTypeIR `< '#' (typeId_inserted)*{typeId_inserted <- typeId_inserted*} `> `( '#' (id_default)*{id_default <- id_default*} '#' (id_optional)*{id_optional <- id_optional*} `))

  6. (Let (typeArgumentIR_infer)*{typeArgumentIR_infer <- typeArgumentIR_infer*} be (typeArgumentIR)*{typeArgumentIR <- typeArgumentIR*} ++ (((_NAME typeId_inserted) as typeIR))*{typeId_inserted <- typeId_inserted*})

  7. (Let (typeId_infer)*{typeId_infer <- typeId_infer*} be (typeId_impl)*{typeId_impl <- typeId_impl*} ++ (typeId_inserted)*{typeId_inserted <- typeId_inserted*})

  8. (Inst_ok: p TC_0 (NAMED) |- constructorTypeIR `< (typeArgumentIR_infer)*{typeArgumentIR_infer <- typeArgumentIR_infer*} '#' (typeId_infer)*{typeId_infer <- typeId_infer*} `> `( (argumentIR)*{argumentIR <- argumentIR*} '#' (id_default)*{id_default <- id_default*} '#' (id_optional)*{id_optional <- id_optional*} `) : typeIR_object `< (typeArgumentIR_inferred)*{typeArgumentIR_inferred <- typeArgumentIR_inferred*} `> `( (argumentIR_cast)*{argumentIR_cast <- argumentIR_cast*} `))

  9. (Let typeIR be $unroll_typeIR(typeIR_object))

  10. (Let (EXTERN typeId_extern `< (typeIR_arg)*{typeIR_arg <- typeIR_arg*} `> externMethodTypeDefEnv_extern) be typeIR, typeIR has type externObjectTypeIR)

    1. (Let TC_1 be $add_var_t((LOCAL), TC_0, "this", ((_EMPTY) typeIR_object (CTK) ?())))

    2. (ObjectDeclList_ok: p TC_1 |- objectDeclarationList : typeFrame_init externMethodTypeDefEnv_init (objectDeclarationIR)*{objectDeclarationIR <- objectDeclarationIR*})

    3. (Let externMethodTypeDefEnv_init_subst be $subst_externMethodTypeDefEnv(externMethodTypeDefEnv_extern, externMethodTypeDefEnv_init))

    4. (Let typeIR_object_init be ((EXTERN typeId_extern `< (typeIR_arg)*{typeIR_arg <- typeIR_arg*} `> externMethodTypeDefEnv_init_subst) as typeIR))

    5. If ($is_concrete_extern_object(typeIR_object_init)), then

      1. (Let nameIR be $name(name))

      2. (Let TC_2 be $add_var_t(p, TC_0, nameIR, ((_EMPTY) typeIR_object_init (CTK) ?())))

      3. (Let constructorTargetIR_inferred be (prefixedNameIR `< (typeArgumentIR_inferred)*{typeArgumentIR_inferred <- typeArgumentIR_inferred*} `>))

      4. (Let instantiationIR be (annotationList typeIR_object_init constructorTargetIR_inferred `( (argumentIR_cast)*{argumentIR_cast <- argumentIR_cast*} `) nameIR ?(('=' `{ (objectDeclarationIR)*{objectDeclarationIR <- objectDeclarationIR*} `})) ';'))

      5. Result in: % % |- % % `< % `> `( % `) % '=' `{ % `} ';' : TC_2 instantiationIR

    5. Else Dangling#9376

def $split_externConstructorOrMethodPrototypeList(externConstructorOrMethodPrototypeList)

1. (Let (externConstructorOrMethodPrototype)*{externConstructorOrMethodPrototype <- externConstructorOrMethodPrototype*} be $flatten_externConstructorOrMethodPrototypeList(externConstructorOrMethodPrototypeList))

