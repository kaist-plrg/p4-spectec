relation SelectCase_keyset_simple_ok: TC typeIR_key |- simpleKeysetExpression : %

1. Case analysis on simpleKeysetExpression

  1. Case (let expression be %, % has type expression)

    1. Group expression: TC typeIR_key |- (expression as simpleKeysetExpression) : %

      1. (Expr_ok: (LOCAL) TC |- expression : typedExpressionIR)

      2. (Let typeIR be $type_of_typedExpressionIR(typedExpressionIR))

      3. (Let typeIR' be $unroll_typeIR(typeIR))

      4. Case analysis on (typeIR' has type setTypeIR)

        1. Case true

          1. (Let (SET `< typeIR_base `>) be (typeIR' as setTypeIR))

          2. If (Type_alpha: typeIR_base ~~ typeIR_key) holds, then

            1. Result in: % % |- % : (typedExpressionIR as simpleKeysetExpressionIR)

          2. Else,

            1. (Cast_impl: typeIR_base -> typeIR_key : castResult)

            2. If ((castResult matches pattern `OK %`)), then

              1. (Let typeIR_cast be ((SET `< typeIR_key `>) as typeIR))

              2. (Let typedExpressionIR_cast be (((`( typeIR_cast `) typedExpressionIR) as expressionIR) '#' (`( typeIR_cast (DYN) `))))

              3. Result in: % % |- % : (typedExpressionIR_cast as simpleKeysetExpressionIR)

            2. Else Dangling#9426

        2. Case false

          1. (Cast_impl: typeIR -> typeIR_key : castResult)

          2. If ((castResult matches pattern `OK %`)), then

            1. (Let typeIR_cast be ((SET `< typeIR_key `>) as typeIR))

            2. (Let typedExpressionIR_cast be (((`( typeIR_cast `) typedExpressionIR) as expressionIR) '#' (`( typeIR_cast (DYN) `))))

            3. Result in: % % |- % : (typedExpressionIR_cast as simpleKeysetExpressionIR)

          2. Else Dangling#9431

  2. Case (let (expression_l '&&&' expression_r) be %, % matches pattern `% &&& %`)

    1. Group mask: TC typeIR_key |- (expression_l '&&&' expression_r) : %

      1. (Expr_ok: (LOCAL) TC |- expression_l : typedExpressionIR_l)

      2. (Expr_ok: (LOCAL) TC |- expression_r : typedExpressionIR_r)

      3. (Let (typedExpressionIR_l_cast, typedExpressionIR_r_cast) be ! $cast_binary(typedExpressionIR_l, typedExpressionIR_r))

        1. (Let (typedExpressionIR_l_reduced, typedExpressionIR_r_reduced) be ! $reduce_serenum_binary(typedExpressionIR_l_cast, typedExpressionIR_r_cast, $compat_mask))

          1. (Let typeIR_reduced be $type_of_typedExpressionIR(typedExpressionIR_l_reduced))

          2. (Let typedExpressionIR_l_casted be ! $cast_unary(typedExpressionIR_l_reduced, typeIR_key))

            1. (Let typedExpressionIR_r_casted be ! $cast_unary(typedExpressionIR_r_reduced, typeIR_key))

              1. Result in: % % |- % : (typedExpressionIR_l_casted '&&&' typedExpressionIR_r_casted)

  3. Case (let (expression_l '..' expression_r) be %, % matches pattern `% .. %`)

    1. Group range: TC typeIR_key |- (expression_l '..' expression_r) : %

      1. (Expr_ok: (LOCAL) TC |- expression_l : typedExpressionIR_l)

      2. (Expr_ok: (LOCAL) TC |- expression_r : typedExpressionIR_r)

      3. (Let (typedExpressionIR_l_cast, typedExpressionIR_r_cast) be ! $cast_binary(typedExpressionIR_l, typedExpressionIR_r))

        1. (Let (typedExpressionIR_l_reduced, typedExpressionIR_r_reduced) be ! $reduce_serenum_binary(typedExpressionIR_l_cast, typedExpressionIR_r_cast, $compat_range))

          1. (Let typeIR_reduced be $type_of_typedExpressionIR(typedExpressionIR_l_reduced))

          2. If ((typeIR_reduced = $type_of_typedExpressionIR(typedExpressionIR_r_reduced))), then

            1. (Let typedExpressionIR_l_casted be ! $cast_unary(typedExpressionIR_l_reduced, typeIR_key))

              1. (Let typedExpressionIR_r_casted be ! $cast_unary(typedExpressionIR_r_reduced, typeIR_key))

                1. Result in: % % |- % : (typedExpressionIR_l_casted '..' typedExpressionIR_r_casted)

          2. Else Dangling#9464

  4. Case (% matches pattern `DEFAULT`)

    1. Group default: TC typeIR_key |- (DEFAULT) : %

      1. Result in: % % |- % : (DEFAULT)

  5. Case (% matches pattern `_`)

    1. Group dontcare: TC typeIR_key |- ('_') : %

      1. Result in: % % |- % : ('_')

tbl def $compat_mask(typeIR'', typeIR''')
=

  Row : ((INT) as typeIR), ((INT) as typeIR) -> true:

    1. (Let intTypeIR be typeIR'', typeIR'' has type intTypeIR)

      1. (Let intTypeIR' be typeIR''', typeIR''' has type intTypeIR)

        1. Return true

  Row : ((INT `< w_l `>) as typeIR), ((INT `< w_r `>) as typeIR) -> (w_l = w_r):

    1. (Let (INT `< w_l `>) be typeIR'', typeIR'' has type fixedIntTypeIR)

      1. (Let (INT `< w_r `>) be typeIR''', typeIR''' has type fixedIntTypeIR)

        1. Return (w_l = w_r)

  Row : ((BIT `< w_l `>) as typeIR), ((BIT `< w_r `>) as typeIR) -> (w_l = w_r):

    1. (Let (BIT `< w_l `>) be typeIR'', typeIR'' has type fixedBitTypeIR)

      1. (Let (BIT `< w_r `>) be typeIR''', typeIR''' has type fixedBitTypeIR)

        1. Return (w_l = w_r)

  Row : ((TYPEDEF _typeId typeIR_l) as typeIR), typeIR_r -> $compat_mask(typeIR_l, typeIR_r):

    1. (Let (TYPEDEF _typeId typeIR_l) be typeIR'', typeIR'' has type typedefTypeIR)

      1. Return $compat_mask(typeIR_l, typeIR''')

  Row : typeIR_l, ((TYPEDEF _typeId typeIR_r) as typeIR) -> $compat_mask(typeIR_l, typeIR_r):

    1. (Let (TYPEDEF _typeId typeIR_r) be typeIR''', typeIR''' has type typedefTypeIR)

      1. Return $compat_mask(typeIR'', typeIR_r)

  Row : _typeIR, _typeIR' -> false:

    1. Return false

