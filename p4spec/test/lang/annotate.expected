2. If (((|(annotationList_a)*{annotationList_a <- annotationList_a*}| = |(id_a)*{id_a <- id_a*}|) /\ (|(id_a)*{id_a <- id_a*}| = |(typeIR_cast_step)*{typeIR_cast_step <- typeIR_cast_step*}|)))*{typeIR_cast_step* <- typeIR_cast_step**}, then

