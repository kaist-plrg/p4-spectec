Arm 1:

  1. If ((|((id_arg)?{id_arg <- id_arg?})*{id_arg? <- id_arg?*}| > 0)), then

    1. If (((id_arg)?{id_arg <- id_arg?} matches pattern (_)))*{id_arg? <- id_arg?*}, then

