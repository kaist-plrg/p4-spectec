  2. Case (let assignmentStatement be %, % has type assignmentStatement)

    1. Group assignmentStatement: TC |- (assignmentStatement as parserStatement) : % %

      1. (Stmt_ok: (LOCAL) TC |- (assignmentStatement as statement) : TC_1 statementIR)

      2. (Let assignmentStatementIR be statementIR, statementIR has type assignmentStatementIR)

