def $find_local_return_type_t(TC)

1. Block (4 arms)

Arm 1:

  1. (Let localKind be TC.LOCAL.KIND)

  2. Case analysis on localKind

    1. Case (let (FUNCTION ':' typeIR_ret) be %, % has type definedFunctionLocalKind)

      1. Return ?(typeIR_ret)

    2. Case (let (EXTERN_FUNCTION ':' typeIR_ret) be %, % has type externFunctionLocalKind)

      1. Return ?(typeIR_ret)

Arm 2:

  1. If ((((ACTION) as localKind) = TC.LOCAL.KIND)), then

    1. Return ?(((VOID) as typeIR))

Arm 3:

  1. (Let localKind be TC.LOCAL.KIND)

  2. (Let externMethodLocalKind be localKind, localKind has type externMethodLocalKind)

    1. Case analysis on externMethodLocalKind

      1. Case (let (EXTERN_METHOD ':' typeIR_ret) be %, % matches pattern `EXTERN_METHOD : %`)

        1. Return ?(typeIR_ret)

      2. Case (let (EXTERN_METHOD ABSTRACT ':' typeIR_ret) be %, % matches pattern `EXTERN_METHOD ABSTRACT : %`)

        1. Return ?(typeIR_ret)

Arm 4:

  1. If ((((CONTROL_APPLY_METHOD) as localKind) = TC.LOCAL.KIND)), then

    1. Return ?(((VOID) as typeIR))

2. Otherwise,

  1. Return ?()

syntax matchKey = 
   | typeIR ':' nameIR (from matchKey) 

syntax matchAction = 
   | prefixedNameIR `( parameterIR* '@' argumentListIR `) (from matchAction) 

syntax matchPriority = {DELTA nat, LARGEST_WINS bool}

syntax matchEntries = {SIZE nat, CONST bool}

syntax matchMode = 
   | NONE (from matchMode) 
   | LPM nat (from matchMode) 
   | PRI (from matchMode) 

syntax tableContext = {KEYS matchKey*, ACTIONS matchAction*, PRIORITIES matchPriority, ENTRIES matchEntries, MODE matchMode}

var TBLC : tableContext

syntax tableEntryState = 
   | LPM nat (from tableEntryState) 
   | NON_LPM (from tableEntryState) 

var TBLS : tableEntryState

def $empty_tableContext

1. (Let matchPriority be {DELTA 1, LARGEST_WINS true})

2. (Let matchEntries be {SIZE 0, CONST true})

3. Return {KEYS [], ACTIONS [], PRIORITIES matchPriority, ENTRIES matchEntries, MODE (NONE)}

def $add_key_tbl(TBLC, id, typeIR)

1. (Let matchKey be (typeIR ':' id))

2. Return TBLC[KEYS = TBLC.KEYS ++ [matchKey]]

def $add_action_tbl(TBLC, prefixedNameIR, (parameterIR)*{parameterIR <- parameterIR*}, argumentListIR)

1. (Let matchAction be (prefixedNameIR `( (parameterIR)*{parameterIR <- parameterIR*} '@' argumentListIR `)))

2. Return TBLC[ACTIONS = TBLC.ACTIONS ++ [matchAction]]

def $is_lpm_key((_typedExpressionIR '#' _nameIR ':' nameIR _annotationList ';'))

1. Return $is_lpm_key'(nameIR)

def $is_lpm_key'(t)

1. If ((t = "lpm")), then

  1. Return true

2. Otherwise,

  1. Return false

def $requires_priority((_typedExpressionIR '#' _nameIR ':' nameIR _annotationList ';'))

1. Return $requires_priority'(nameIR)

def $requires_priority'(t)

1. Case analysis on t

  1. Case (% = "range")

    1. Return true

  2. Case (% = "ternary")

    1. Return true

  3. Case (% = "optional")

    1. Return true

2. Otherwise,

  1. Return false

def $update_mode_tbl(TBLC, (tableKeyIR)*{tableKeyIR <- tableKeyIR*})

1. (Let b_pri be $requires_priority(tableKeyIR))*

2. Case analysis on $exists_((b_pri)*{b_pri <- b_pri*})

  1. Case true

    1. Return TBLC[MODE = (PRI)]

  2. Case false

    1. (Let b_lpm be $is_lpm_key(tableKeyIR))*

    2. Block (2 arms)

    Arm 1:

      1. (Let (tableKeyIR')*{tableKeyIR' <- tableKeyIR'*} be $filter_<tableKeyIR>((tableKeyIR)*{tableKeyIR <- tableKeyIR*}, (b_lpm)*{b_lpm <- b_lpm*}))

      2. (Let [tableKeyIR_lpm] be (tableKeyIR')*{tableKeyIR' <- tableKeyIR'*}, (tableKeyIR')*{tableKeyIR' <- tableKeyIR'*} matches pattern [ _/1 ])

        1. (Let (typedExpressionIR '#' _nameIR ':' t _annotationList ';') be tableKeyIR_lpm)

        2. If ((t = "lpm")), then

          1. (Let typeIR be $type_of_typedExpressionIR(typedExpressionIR))

          2. (Let typeIR' be $unroll_aliasType(typeIR))

          3. (Let integerTypeIR be typeIR', typeIR' has type integerTypeIR)

            1. (Let n be ! $width_of_integerTypeIR(integerTypeIR))

              1. Return TBLC[MODE = (LPM n)]

        2. Else Dangling#4533

    Arm 2:

      1. If (~$exists_((b_lpm)*{b_lpm <- b_lpm*})), then

        1. Return TBLC[MODE = (NONE)]

      1. Else Dangling#4542

def $find_action(TBLC, prefixedNameIR)

1. Return $find_action'(TBLC.ACTIONS, prefixedNameIR)

def $find_action'((matchAction)*{matchAction <- matchAction*}, prefixedNameIR)

1. Case analysis on (matchAction)*{matchAction <- matchAction*}

  1. Case (% matches pattern [])

    1. Return ?()

  2. Case (let matchAction_h :: (matchAction_t)*{matchAction_t <- matchAction_t*} be %, % matches pattern _ :: _)

    1. (Let (prefixedNameIR' `( (parameterIR)*{parameterIR <- parameterIR*} '@' argumentListIR `)) be matchAction_h)

    2. Case analysis on prefixedNameIR'

      1. Case (% = prefixedNameIR)

        1. Return ?(((parameterIR)*{parameterIR <- parameterIR*}, argumentListIR))

      2. Case (% =/= prefixedNameIR)

        1. Return $find_action'((matchAction_t)*{matchAction_t <- matchAction_t*}, prefixedNameIR)

def $set_priorities_of_tableEntryListIR(TBLC, (TBLS)*{TBLS <- TBLS*}, (tableEntryIR)*{tableEntryIR <- tableEntryIR*})

1. Block (3 arms)

Arm 1:

  1. If ((TBLC.MODE matches pattern `NONE`)), then

    1. If (($tableEntryPriorityOptIR_of_tableEntryIR(tableEntryIR) matches pattern ()))*{tableEntryIR <- tableEntryIR*}, then

      1. Return (tableEntryIR)*{tableEntryIR <- tableEntryIR*}

    1. Else Dangling#4553

  1. Else Dangling#4552

Arm 2:

  1. (Let matchMode be TBLC.MODE)

  2. If ((matchMode matches pattern `LPM %`)), then

    1. If ((TBLS matches pattern `LPM %`))*{TBLS <- TBLS*}, then

      1. (Let (LPM n_prefix) be TBLS)*

      2. If (($tableEntryPriorityOptIR_of_tableEntryIR(tableEntryIR) matches pattern ()))*{tableEntryIR <- tableEntryIR*}, then

        1. If ((|(n_prefix)*{n_prefix <- n_prefix*}| = |(tableEntryIR)*{tableEntryIR <- tableEntryIR*}|)), then

          1. (Let tableEntryIR_updated be $set_priority_of_tableEntryIR(tableEntryIR, n_prefix))*

          2. Return (tableEntryIR_updated)*{tableEntryIR_updated <- tableEntryIR_updated*}

        1. Else Dangling#4560

      2. Else Dangling#4559

    1. Else Dangling#4557

  2. Else Dangling#4556

Arm 3:

  1. Case analysis on (tableEntryIR)*{tableEntryIR <- tableEntryIR*}

    1. Case (% matches pattern [])

      1. If ((TBLC.MODE matches pattern `PRI`)), then

        1. Return []

      1. Else Dangling#4564

    2. Case (let tableEntryIR_h :: (tableEntryIR_t)*{tableEntryIR_t <- tableEntryIR_t*} be %, % matches pattern _ :: _)

      1. If ((TBLC.MODE matches pattern `PRI`)), then

        1. Block (2 arms)

        Arm 1:

          1. If (($tableEntryPriorityOptIR_of_tableEntryIR(tableEntryIR_h) matches pattern ())), then

            1. If (($tableEntryPriorityOptIR_of_tableEntryIR(tableEntryIR_t) matches pattern ()))*{tableEntryIR_t <- tableEntryIR_t*}, then

              1. (Let b_lw be TBLC.PRIORITIES.LARGEST_WINS)

              2. (Let n_size be TBLC.ENTRIES.SIZE)

              3. (Let n_delta be TBLC.PRIORITIES.DELTA)

              4. (Let i be $ite<int>(b_lw, (((n_size - 1) * (n_delta as int)) + (1 as int)), (1 as int)))

              5. (Let n be i, i has type nat)

                1. (Let tableEntryIR_h_updated be $set_priority_of_tableEntryIR(tableEntryIR_h, n))

                2. (Let (tableEntryIR_t_updated)*{tableEntryIR_t_updated <- tableEntryIR_t_updated*} be $set_priorities_of_tableEntryListIR'(TBLC, n, (tableEntryIR_t)*{tableEntryIR_t <- tableEntryIR_t*}))

                3. Return tableEntryIR_h_updated :: (tableEntryIR_t_updated)*{tableEntryIR_t_updated <- tableEntryIR_t_updated*}

            1. Else Dangling#4569

          1. Else Dangling#4568

        Arm 2:

          1. If (~TBLC.ENTRIES.CONST), then

            1. (Let (PRIORITY '=' integerLiteral ':') be ! $tableEntryPriorityOptIR_of_tableEntryIR(tableEntryIR_h))

              1. (Let n be ! $nat_of_integerValue((integerLiteral as integerValue)))

                1. (Let tableEntryIR_h_updated be $set_priority_of_tableEntryIR(tableEntryIR_h, n))

                2. (Let (tableEntryIR_t_updated)*{tableEntryIR_t_updated <- tableEntryIR_t_updated*} be $set_priorities_of_tableEntryListIR'(TBLC, n, (tableEntryIR_t)*{tableEntryIR_t <- tableEntryIR_t*}))

                3. Return tableEntryIR_h_updated :: (tableEntryIR_t_updated)*{tableEntryIR_t_updated <- tableEntryIR_t_updated*}

          1. Else Dangling#4579

      1. Else Dangling#4567

def $set_priorities_of_tableEntryListIR'(TBLC, n_last, (tableEntryIR)*{tableEntryIR <- tableEntryIR*})

1. Case analysis on (tableEntryIR)*{tableEntryIR <- tableEntryIR*}

  1. Case (% matches pattern [])

    1. Return []

  2. Case (let tableEntryIR_h :: (tableEntryIR_t)*{tableEntryIR_t <- tableEntryIR_t*} be %, % matches pattern _ :: _)

    1. Block (2 arms)

    Arm 1:

      1. If (($tableEntryPriorityOptIR_of_tableEntryIR(tableEntryIR_h) matches pattern ())), then

        1. (Let b_lw be TBLC.PRIORITIES.LARGEST_WINS)

        2. (Let n_delta be TBLC.PRIORITIES.DELTA)

        3. (Let i be $ite<int>(b_lw, (n_last - n_delta), ((n_last + n_delta) as int)))

        4. (Let n be i, i has type nat)

          1. (Let tableEntryIR_h_updated be $set_priority_of_tableEntryIR(tableEntryIR_h, n))

          2. (Let (tableEntryIR_t_updated)*{tableEntryIR_t_updated <- tableEntryIR_t_updated*} be $set_priorities_of_tableEntryListIR'(TBLC, n, (tableEntryIR_t)*{tableEntryIR_t <- tableEntryIR_t*}))

          3. Return tableEntryIR_h_updated :: (tableEntryIR_t_updated)*{tableEntryIR_t_updated <- tableEntryIR_t_updated*}

      1. Else Dangling#4592

    Arm 2:

      1. (Let (PRIORITY '=' integerLiteral ':') be ! $tableEntryPriorityOptIR_of_tableEntryIR(tableEntryIR_h))

        1. (Let n be ! $nat_of_integerValue((integerLiteral as integerValue)))

          1. (Let tableEntryIR_h_updated be $set_priority_of_tableEntryIR(tableEntryIR_h, n))

          2. (Let (tableEntryIR_t_updated)*{tableEntryIR_t_updated <- tableEntryIR_t_updated*} be $set_priorities_of_tableEntryListIR'(TBLC, n, (tableEntryIR_t)*{tableEntryIR_t <- tableEntryIR_t*}))

          3. Return tableEntryIR_h_updated :: (tableEntryIR_t_updated)*{tableEntryIR_t_updated <- tableEntryIR_t_updated*}

def $set_priority_of_tableEntryIR(tableEntryIR, n)

1. (Let (constOptIR _tableEntryPriorityOptIR keysetExpressionIR ':' tableActionReferenceIR annotationList ';') be tableEntryIR)

2. (Let tableEntryPriorityIR be (PRIORITY '=' (D (n as int)) ':'))

3. (Let tableEntryIR_updated be (constOptIR ?(tableEntryPriorityIR) keysetExpressionIR ':' tableActionReferenceIR annotationList ';'))

4. Return tableEntryIR_updated

def $join_tableEntryState(TBLS, TBLS')

1. Case analysis on TBLS

  1. Case (% matches pattern `NON_LPM`)

    1. Case analysis on TBLS'

      1. Case (let (LPM n) be %, % matches pattern `LPM %`)

        1. Return (LPM n)

      2. Case (% matches pattern `NON_LPM`)

        1. Return (NON_LPM)

  2. Case (let (LPM n) be %, % matches pattern `LPM %`)

    1. If ((TBLS' matches pattern `NON_LPM`)), then

      1. Return (LPM n)

    1. Else Dangling#4620

def $tableEntry_lpm_prefix(value)

1. Return $tableEntry_lpm_prefix'(value, 0)

def $tableEntry_lpm_prefix'(value, n_prefix)

1. (Let integerLiteral be value, value has type integerLiteral)

  1. (Let (nat W _i) be integerLiteral, integerLiteral matches pattern `% W %`)

    1. Block (2 arms)

    Arm 1:

      1. If ((nat = 0)), then

        1. Return n_prefix

      1. Else Dangling#4627

    Arm 2:

      1. (Let n be _i, _i has type nat)

        1. Block (2 arms)

        Arm 1:

          1. If ((nat > 0)), then

            1. (Let i be (nat - 1))

            2. (Let w be i, i has type nat)

              1. If (((n \ 2) =/= 0)), then

                1. (Let i' be ((n - 1) / (2 as int)))

                2. (Let n' be i', i' has type nat)

                  1. (Let value' be ((w W (n' as int)) as value))

                  2. Return $tableEntry_lpm_prefix'(value', (n_prefix + 1))

              1. Else Dangling#4635

          1. Else Dangling#4631

        Arm 2:

          1. If ((n_prefix = 0)), then

            1. If ((nat > 0)), then

              1. (Let i be (nat - 1))

              2. (Let w be i, i has type nat)

                1. If (((n \ 2) = 0)), then

                  1. (Let value' be ((w W ((n / 2) as int)) as value))

                  2. Return $tableEntry_lpm_prefix'(value', 0)

                1. Else Dangling#4646

            1. Else Dangling#4642

          1. Else Dangling#4641

relation Type_wf: B |- typeIR'

1. Block (4 arms)

Arm 1:

  1. Case analysis on typeIR'

    1. Case (let baseTypeIR be %, % has type baseTypeIR)

      1. Group baseTypeIR: B |- (baseTypeIR as typeIR)

        1. The relation holds

    2. Case (let (_NAME typeId) be %, % has type nameTypeIR)

      1. Group nameTypeIR: B |- ((_NAME typeId) as typeIR)

        1. If ($in_set<typeId>(typeId, B)), then

          1. The relation holds

        1. Else Dangling#4655

    3. Case (let (TYPEDEF typeId typeIR) be %, % has type typedefTypeIR)

      1. Group typedefTypeIR: B |- ((TYPEDEF typeId typeIR) as typeIR)

        1. If ($nestable_typedef(typeIR)), then

          1. If (Type_wf: B |- typeIR) holds, then

            1. The relation holds

          1. Else Dangling#4660

        1. Else Dangling#4659

    4. Case (let (TYPE typeId typeIR) be %, % has type newTypeIR)

      1. Group newTypeIR: B |- ((TYPE typeId typeIR) as typeIR)

        1. If ($nestable_new(typeIR)), then

          1. If (Type_wf: B |- typeIR) holds, then

            1. The relation holds

          1. Else Dangling#4665

        1. Else Dangling#4664

    5. Case (let (LIST `< typeIR `>) be %, % has type listTypeIR)

      1. Group listTypeIR: B |- ((LIST `< typeIR `>) as typeIR)

        1. If ($nestable_list(typeIR)), then

          1. If (Type_wf: B |- typeIR) holds, then

            1. The relation holds

