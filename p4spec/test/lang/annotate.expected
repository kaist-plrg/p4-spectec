        1. (Let (callableId ':' constructorTypeDefIR '#' (id_default)*{id_default <- id_default*} '#' (id_optional)*{id_optional <- id_optional*}) be ! $find_constructorDef_overloaded_t(TC, prefixedNameIR, (argumentIR)*{argumentIR <- argumentIR*}))

          1. (Let (constructorTypeIR, (typeId_impl)*{typeId_impl <- typeId_impl*}) be $specialize_constructorTypeDefIR(constructorTypeDefIR, (typeArgumentIR')*{typeArgumentIR' <- typeArgumentIR'*}))

          2. Result in: % % |- % `( % `) : constructorTypeIR `< '#' (typeId_impl)*{typeId_impl <- typeId_impl*} `> `( '#' (id_default)*{id_default <- id_default*} '#' (id_optional)*{id_optional <- id_optional*} `)

      1. Else Dangling#8636

  Arm 3:

    1. If (((typeArgumentIR')*{typeArgumentIR' <- typeArgumentIR'*} matches pattern [])), then

      1. (Let typeDefIR' be ! $find_typeDef_t(p, TC, prefixedNameIR))

        1. (Let (TYPEDEF nameIR_alias typeIR_alias) be typeDefIR', typeDefIR' has type typedefTypeIR)

          1. (Let (nameIR, (typeArgumentIR)*{typeArgumentIR <- typeArgumentIR*}) be $resolve_type_alias(typeIR_alias))

          2. (Let (callableId ':' constructorTypeDefIR '#' (id_default)*{id_default <- id_default*} '#' (id_optional)*{id_optional <- id_optional*}) be ! $find_constructorDef_overloaded_t(TC, (_BARE nameIR), (argumentIR)*{argumentIR <- argumentIR*}))

            1. (Let (constructorTypeIR, (typeId_impl)*{typeId_impl <- typeId_impl*}) be $specialize_constructorTypeDefIR(constructorTypeDefIR, (typeArgumentIR)*{typeArgumentIR <- typeArgumentIR*}))

            2. Result in: % % |- % `( % `) : constructorTypeIR `< '#' (typeId_impl)*{typeId_impl <- typeId_impl*} `> `( '#' (id_default)*{id_default <- id_default*} '#' (id_optional)*{id_optional <- id_optional*} `)

    1. Else Dangling#8642

syntax instctxt = 
   | NAMED (from instctxt) 
   | ANON (from instctxt) 

relation Inst_ok: p TC instctxt |- constructorTypeIR `< (typeArgumentIR)*{typeArgumentIR <- typeArgumentIR*} '#' (typeId_infer)*{typeId_infer <- typeId_infer*} `> `( (argumentIR)*{argumentIR <- argumentIR*} '#' (id_default)*{id_default <- id_default*} '#' (id_optional)*{id_optional <- id_optional*} `) : % `< % `> `( % `)

1. Group : p TC instctxt |- constructorTypeIR `< (typeArgumentIR)*{typeArgumentIR <- typeArgumentIR*} '#' (typeId_infer)*{typeId_infer <- typeId_infer*} `> `( (argumentIR)*{argumentIR <- argumentIR*} '#' (id_default)*{id_default <- id_default*} '#' (id_optional)*{id_optional <- id_optional*} `) : % `< % `> `( % `)

  1. (Let (CONSTRUCTOR `( (parameterIR)*{parameterIR <- parameterIR*} `) ':' typeIR_object) be constructorTypeIR)

  2. (Let (GIVEN (parameterIR_aligned)*{parameterIR_aligned <- parameterIR_aligned*} DEFAULT (_parameterIR)*{_parameterIR <- _parameterIR*} OPTIONAL (parameterIR_optional)*{parameterIR_optional <- parameterIR_optional*}) be $align_parameterListIR((parameterIR)*{parameterIR <- parameterIR*}, (argumentIR)*{argumentIR <- argumentIR*}, (id_default)*{id_default <- id_default*}, (id_optional)*{id_optional <- id_optional*}))

  3. (Let inference be $infer((typeId_infer)*{typeId_infer <- typeId_infer*}, (parameterIR_aligned)*{parameterIR_aligned <- parameterIR_aligned*}, (parameterIR_optional)*{parameterIR_optional <- parameterIR_optional*}, (argumentIR)*{argumentIR <- argumentIR*}))

  4. (Let typeArgumentIR_inferred be $subst_typeIR(inference, typeArgumentIR))*

  5. (Let parameterIR_aligned_inferred be $subst_parameterIR(inference, parameterIR_aligned))*

  6. (Let typeIR_object_inferred be $subst_typeIR(inference, typeIR_object))

  7. (Let constructorTypeIR_inferred be (CONSTRUCTOR `( (parameterIR_aligned_inferred)*{parameterIR_aligned_inferred <- parameterIR_aligned_inferred*} `) ':' typeIR_object_inferred))

  8. (Let bound be $bound(p, TC))

  9. If (ConstructorType_wf: bound |- constructorTypeIR_inferred) holds, then

    1. If ($instantiable(p, TC, instctxt, typeIR_object_inferred)), then

      1. (Let typeIR_object_unroll be $unroll_typeIR(typeIR_object))

      2. Case analysis on (typeIR_object_unroll has type packageObjectTypeIR)

        1. Case true

          1. If ((p matches pattern `GLOBAL`)), then

            1. (Call_convention_ok: (BLOCK) TC (NOACTION) |- (parameterIR_aligned_inferred)*{parameterIR_aligned_inferred <- parameterIR_aligned_inferred*} '@' (argumentIR)*{argumentIR <- argumentIR*} : (argumentIR_cast)*{argumentIR_cast <- argumentIR_cast*})

            2. Result in: % % % |- % `< % '#' % `> `( % '#' % '#' % `) : typeIR_object_inferred `< (typeArgumentIR_inferred)*{typeArgumentIR_inferred <- typeArgumentIR_inferred*} `> `( (argumentIR_cast)*{argumentIR_cast <- argumentIR_cast*} `)

          1. Else Dangling#8666

        2. Case false

          1. (Call_convention_ok: p TC (NOACTION) |- (parameterIR_aligned_inferred)*{parameterIR_aligned_inferred <- parameterIR_aligned_inferred*} '@' (argumentIR)*{argumentIR <- argumentIR*} : (argumentIR_cast)*{argumentIR_cast <- argumentIR_cast*})

          2. Result in: % % % |- % `< % '#' % `> `( % '#' % '#' % `) : typeIR_object_inferred `< (typeArgumentIR_inferred)*{typeArgumentIR_inferred <- typeArgumentIR_inferred*} `> `( (argumentIR_cast)*{argumentIR_cast <- argumentIR_cast*} `)

    1. Else Dangling#8663

  9. Else Dangling#8662

def $chain_casts((typeIR_cur)*{typeIR_cur <- typeIR_cur*}, ((typeIR_chain)*{typeIR_chain <- typeIR_chain*})*{typeIR_chain* <- typeIR_chain**})

1. Case analysis on $concat_<typeIR>(((typeIR_chain)*{typeIR_chain <- typeIR_chain*})*{typeIR_chain* <- typeIR_chain**})

  1. Case (% matches pattern [])

    1. Return []

  2. Case (% matches pattern _ :: _)

    1. If ((|((typeIR_chain)*{typeIR_chain <- typeIR_chain*})*{typeIR_chain* <- typeIR_chain**}| = |(typeIR_cur)*{typeIR_cur <- typeIR_cur*}|)), then

      1. (Let (typeIR_next, (typeIR_chain_rest)*{typeIR_chain_rest <- typeIR_chain_rest*}) be $chain_casts'(typeIR_cur, (typeIR_chain)*{typeIR_chain <- typeIR_chain*}))*

      2. (Let ((typeIR)*{typeIR <- typeIR*})*{typeIR* <- typeIR**} be $chain_casts((typeIR_next)*{typeIR_next <- typeIR_next*}, ((typeIR_chain_rest)*{typeIR_chain_rest <- typeIR_chain_rest*})*{typeIR_chain_rest* <- typeIR_chain_rest**}))

      3. Return (typeIR_next)*{typeIR_next <- typeIR_next*} :: ((typeIR)*{typeIR <- typeIR*})*{typeIR* <- typeIR**}

    1. Else Dangling#8673

def $chain_casts'(typeIR_cur, (typeIR)*{typeIR <- typeIR*})

1. Case analysis on (typeIR)*{typeIR <- typeIR*}

  1. Case (% matches pattern [])

    1. Return (typeIR_cur, [])

  2. Case (let typeIR_h :: (typeIR_t)*{typeIR_t <- typeIR_t*} be %, % matches pattern _ :: _)

    1. Return (typeIR_h, (typeIR_t)*{typeIR_t <- typeIR_t*})

def $chain_casts_sequenceTypeIR((typeIR_a)*{typeIR_a <- typeIR_a*}, ((typeIR_cast_elem)*{typeIR_cast_elem <- typeIR_cast_elem*})*{typeIR_cast_elem* <- typeIR_cast_elem**}, typeIR_b)

1. (Let ((typeIR_cast_step)*{typeIR_cast_step <- typeIR_cast_step*})*{typeIR_cast_step* <- typeIR_cast_step**} be $chain_casts((typeIR_a)*{typeIR_a <- typeIR_a*}, ((typeIR_cast_elem)*{typeIR_cast_elem <- typeIR_cast_elem*})*{typeIR_cast_elem* <- typeIR_cast_elem**}))

2. (Let typeIR_cast_agg be ((SEQ `< (typeIR_cast_step)*{typeIR_cast_step <- typeIR_cast_step*} `>) as typeIR))*

3. Return (typeIR_cast_agg)*{typeIR_cast_agg <- typeIR_cast_agg*} ++ [typeIR_b]

