    1. Return $sizeof_maxSizeInBits'(typeIR)

  6. Case (let (TYPE _typeId typeIR) be %, % has type newTypeIR)

    1. Return $sizeof_maxSizeInBits'(typeIR)

  7. Case (let (ENUM _typeId `< typeIR `> `{ (_valueFieldIR)*{_valueFieldIR <- _valueFieldIR*} `}) be %, % has type serializableEnumTypeIR)

    1. Return $sizeof_maxSizeInBits'(typeIR)

  8. Case (let (TUPLE `< (typeIR)*{typeIR <- typeIR*} `>) be %, % has type tupleTypeIR)

    1. (Let nat be $sizeof_maxSizeInBits'(typeIR))*

    2. Return $sum_nat((nat)*{nat <- nat*})

  9. Case (let (ARRAY typeIR `[ n_size `]) be %, % has type arrayTypeIR)

    1. (Let nat' be $sizeof_maxSizeInBits'(typeIR))

    2. Return (nat' * n_size)

  10. Case (let (HEADER_STACK typeIR `[ n_size `]) be %, % has type headerStackTypeIR)

    1. (Let nat'' be $sizeof_maxSizeInBits'(typeIR))

