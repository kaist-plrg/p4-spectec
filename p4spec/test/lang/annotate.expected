        1. (Let TC_4 be $add_typeDef_t((GLOBAL), TC_0, nameIR, (controlObjectTypeDefIR as typeDefIR)))

        2. (Let controlTypeDeclarationIR be (annotationList CONTROL nameIR `< (typeId_expl)*{typeId_expl <- typeId_expl*} ',' (typeId_impl)*{typeId_impl <- typeId_impl*} `> `( (parameterIR)*{parameterIR <- parameterIR*} `) ';'))

        3. Result in: % |- % : TC_4 (controlTypeDeclarationIR as declarationIR)

      7. Else Dangling#8278

  18. Case (let (annotationList PACKAGE name typeParameterListOpt `( parameterList `) ';') be %, % has type packageTypeDeclaration)

    1. Group packageTypeDeclaration: TC_0 |- ((annotationList PACKAGE name typeParameterListOpt `( parameterList `) ';') as declaration) : % %

      1. (Let B be $bound((GLOBAL), TC_0))

      2. (Let TC_1 be TC_0[BLOCK.KIND = (PACKAGE)])

      3. (TypeParameterListOpt_ok: (BLOCK) TC_1 |- typeParameterListOpt : TC_2 (typeId_expl)*{typeId_expl <- typeId_expl*})

      4. (ConstructorParameterListOpt_ok: TC_2 |- (`( parameterList `)) : TC_3 (constructorParameterIR)*{constructorParameterIR <- constructorParameterIR*} '#' (typeId_impl)*{typeId_impl <- typeId_impl*})

      5. (Let nameIR be $name(name))

      6. (Let (_annotationList _direction typeIR_package_inner _id _parameterInitializerOptIR) be constructorParameterIR)*

      7. (Let packageObjectTypeDefIR be (PACKAGE nameIR `< (typeId_expl)*{typeId_expl <- typeId_expl*} ',' (typeId_impl)*{typeId_impl <- typeId_impl*} `> `{ (typeIR_package_inner)*{typeIR_package_inner <- typeIR_package_inner*} `}))

      8. If (TypeDef_wf: B |- (packageObjectTypeDefIR as typeDefIR)) holds, then

