syntax nameList = 
   | _ID text (from identifier) 
   | APPLY (from nonTypeName) 
   | KEY (from nonTypeName) 
   | ACTIONS (from nonTypeName) 
   | STATE (from nonTypeName) 
   | ENTRIES (from nonTypeName) 
   | TYPE (from nonTypeName) 
   | PRIORITY (from nonTypeName) 
   | _TID text (from typeIdentifier) 
   | LIST (from name) 
   | nameList ',' name (from nameList) 

def $flatten_nameList(nameList')

1. Case analysis on nameList'

  1. Case (let name be %, % has type name)

    1. Return [name]

  2. Case (let (nameList ',' name) be %, % matches pattern `% , %`)

    1. (Let (name')*{name' <- name'*} be $flatten_nameList(nameList))

    2. Return (name')*{name' <- name'*} ++ [name]

syntax member = name

syntax direction = 
