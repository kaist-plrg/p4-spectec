syntax tableResult = 
   | EXIT (from exitResult) 
   | RETURN value? (from returnResult) 

relation Table_eval: EC_0 ARCH_0 |- typeId TBL : % % %

1. Group : EC_0 ARCH_0 |- typeId TBL : % % %

  1. (Let (KEY '=' `{ tableKeyListIR `}) be TBL.KEYS)

  2. (TableKeys_eval: EC_0 ARCH_0 |- tableKeyListIR : EC_1 ARCH_1 tableKeysResult)

  3. Case analysis on tableKeysResult

    1. Case (let exitResult be %, % has type exitResult)

      1. Result in: % % |- % % : EC_1 ARCH_1 ((EXIT) as tableResult)

    2. Case (let (_CONT (tableKeyValue)*{tableKeyValue <- tableKeyValue*}) be %, % has type continueResult<tableKeyValue*>)

      1. (Let (_annotationList _constOptIR ENTRIES '=' `{ tableEntryListIR `}) be TBL.ENTRIES)

      2. (TableMatches_eval: EC_1 ARCH_1 |- (tableKeyValue)*{tableKeyValue <- tableKeyValue*} '@' tableEntryListIR : EC_2 ARCH_2 tableMatchesResult)

      3. Case analysis on tableMatchesResult

        1. Case (let exitResult be %, % has type exitResult)

          1. Result in: % % |- % % : EC_2 ARCH_2 ((EXIT) as tableResult)

        2. Case (let (_CONT (tableMatch)*{tableMatch <- tableMatch*}) be %, % has type continueResult<tableMatch*>)

          1. (Let (prefixedNameIR _controlPlaneNameIR `( argumentListIR `)) be $select_action(TBL, (tableMatch)*{tableMatch <- tableMatch*}))

          2. (Stmt_eval: (LOCAL) EC_2 ARCH_2 |- (((prefixedNameIR as callableTargetIR) `< [] `> `( argumentListIR `) ';') as statementIR) : EC_3 ARCH_3 statementResult)

          3. Case analysis on statementResult

            1. Case (let exitResult be %, % has type exitResult)

              1. Result in: % % |- % % : EC_3 ARCH_3 ((EXIT) as tableResult)

            2. Case (let continueEmptyResult be %, % has type continueEmptyResult)

              1. (Let b_hit be ~((tableMatch)*{tableMatch <- tableMatch*} = []))

              2. (Let b_miss be ~b_hit)

              3. (Let nameIR be $flatten_prefixedNameIR(prefixedNameIR))

              4. (Let tableMetadataEnumValue be (TABLE_ENUM "action_list(" ++ typeId ++ ")" '.' nameIR))

              5. (Let tableMetadataStructValue be (TABLE_STRUCT "apply_result(" ++ typeId ++ ")" `{ HIT (_B b_hit) ';' MISS (_B b_miss) ';' ACTION_RUN tableMetadataEnumValue ';' `}))

              6. Result in: % % |- % % : EC_3 ARCH_3 ((RETURN ?((tableMetadataStructValue as value))) as tableResult)

          3. Else Dangling#12443

