      3. (Lvalue_write: (GLOBAL) EC_0 ARCH |- storageReference_h := value_h : EC_1)

      4. (V1Model_copy_meta_fields: EC_capture EC_1 ARCH |- (nameIR_t)*{nameIR_t <- nameIR_t*} : EC_2)

      5. Result in: % % % |- % : EC_2

