relation TableEntry_keyset_simple_ok: TC TBLC |- (typeIR_key ':' t) '@' simpleKeysetExpression : % %

1. Block (2 arms)

Arm 1:

  1. Case analysis on simpleKeysetExpression

    1. Case (let expression be %, % has type expression)

      1. Group expression: TC TBLC |- (typeIR_key ':' t) '@' (expression as simpleKeysetExpression) : % %

        1. Case analysis on t

          1. Case (% = "lpm")

            1. (Let matchMode be TBLC.MODE)

            2. (Let (LPM n) be matchMode, matchMode matches pattern `LPM %`)

              1. (Expr_ok: (LOCAL) TC |- expression : typedExpressionIR)

              2. (Let typeIR be $type_of_typedExpressionIR(typedExpressionIR))

              3. (Let ctk be $ctk_of_typedExpressionIR(typedExpressionIR))

              4. (Cast_impl: typeIR -> typeIR_key : castResult)

              5. If ((castResult matches pattern `OK %`)), then

                1. (Let typeIR_set be ((SET `< typeIR_key `>) as typeIR))

                2. (Let typedExpressionIR_set be (((`( typeIR_set `) typedExpressionIR) as expressionIR) '#' (`( typeIR_set ctk `))))

                3. Result in: % % |- % '@' % : (LPM n) (typedExpressionIR_set as simpleKeysetExpressionIR)

              5. Else Dangling#9652

          2. Case (% =/= "lpm")

            1. Case analysis on $is_singleton_list_expression(expression)

              1. Case true

                1. (Let (`{ sequenceOrRecordElementExpression trailingCommaOpt `}) be expression, expression has type sequenceOrRecordExpression)

                  1. (Let expression_elem be sequenceOrRecordElementExpression, sequenceOrRecordElementExpression has type expression)

                    1. If ((trailingCommaOpt matches pattern `/* empty */`)), then

                      1. (Expr_ok: (LOCAL) TC |- expression_elem : typedExpressionIR)

                      2. (Let typeIR be $type_of_typedExpressionIR(typedExpressionIR))

                      3. (Let ctk be $ctk_of_typedExpressionIR(typedExpressionIR))

                      4. (Cast_impl: typeIR -> typeIR_key : castResult)

                      5. If ((castResult matches pattern `OK %`)), then

                        1. (Let typeIR_set be ((SET `< typeIR_key `>) as typeIR))

                        2. (Let typedExpressionIR_set be (((`( typeIR_set `) typedExpressionIR) as expressionIR) '#' (`( typeIR_set ctk `))))

                        3. Result in: % % |- % '@' % : (NON_LPM) (typedExpressionIR_set as simpleKeysetExpressionIR)

                      5. Else Dangling#9666

                    1. Else Dangling#9661

              2. Case false

                1. (Expr_ok: (LOCAL) TC |- expression : typedExpressionIR)

                2. (Let typeIR be $type_of_typedExpressionIR(typedExpressionIR))

                3. (Let ctk be $ctk_of_typedExpressionIR(typedExpressionIR))

                4. (Cast_impl: typeIR -> typeIR_key : castResult)

                5. If ((castResult matches pattern `OK %`)), then

                  1. (Let typeIR_set be ((SET `< typeIR_key `>) as typeIR))

                  2. (Let typedExpressionIR_set be (((`( typeIR_set `) typedExpressionIR) as expressionIR) '#' (`( typeIR_set ctk `))))

                  3. Result in: % % |- % '@' % : (NON_LPM) (typedExpressionIR_set as simpleKeysetExpressionIR)

                5. Else Dangling#9674

    2. Case (let (expression_l '&&&' expression_r) be %, % matches pattern `% &&& %`)

      1. Group mask: TC TBLC |- (typeIR_key ':' t) '@' (expression_l '&&&' expression_r) : % %

        1. Case analysis on t

          1. Case (% = "lpm")

            1. (Let matchMode be TBLC.MODE)

            2. (Let (LPM n) be matchMode, matchMode matches pattern `LPM %`)

              1. (Expr_ok: (LOCAL) TC |- expression_l : typedExpressionIR_l)

              2. (Expr_ok: (LOCAL) TC |- expression_r : typedExpressionIR_r)

              3. (Let typedExpressionIR_l_cast be ! $cast_unary(typedExpressionIR_l, typeIR_key))

                1. (Let typedExpressionIR_r_cast be ! $cast_unary(typedExpressionIR_r, typeIR_key))

                  1. (Let (typedExpressionIR_l_reduced, typedExpressionIR_r_reduced) be ! $reduce_serenum_binary(typedExpressionIR_l_cast, typedExpressionIR_r_cast, $compat_mask))

                    1. (Let ctk_r_reduced be $ctk_of_typedExpressionIR(typedExpressionIR_r_reduced))

                    2. If ((ctk_r_reduced matches pattern `LCTK`)), then

                      1. (Expr_eval_lctk: (LOCAL) TC |- typedExpressionIR_r_reduced ~> value)

                      2. (Let integerValue_r be value, value has type integerValue)

                        1. (Let n_r be ! $nat_of_integerValue(integerValue_r))

                          1. (Let int be $int_to_bitstr((n as int), (n_r as int)))

                          2. (Let n_prefix be $tableEntry_lpm_prefix(((n W int) as value)))

                          3. Result in: % % |- % '@' % : (LPM n_prefix) (typedExpressionIR_l_reduced '&&&' typedExpressionIR_r_reduced)

                    2. Else Dangling#9696

          2. Case (% = "ternary")

            1. (Expr_ok: (LOCAL) TC |- expression_l : typedExpressionIR_l)

            2. (Expr_ok: (LOCAL) TC |- expression_r : typedExpressionIR_r)

            3. (Let typedExpressionIR_l_cast be ! $cast_unary(typedExpressionIR_l, typeIR_key))

              1. (Let typedExpressionIR_r_cast be ! $cast_unary(typedExpressionIR_r, typeIR_key))

                1. (Let (typedExpressionIR_l_reduced, typedExpressionIR_r_reduced) be ! $reduce_serenum_binary(typedExpressionIR_l_cast, typedExpressionIR_r_cast, $compat_mask))

                  1. Result in: % % |- % '@' % : (NON_LPM) (typedExpressionIR_l_reduced '&&&' typedExpressionIR_r_reduced)

        1. Else Dangling#9680

    3. Case (% matches pattern `DEFAULT`)

      1. Group default: TC TBLC |- (typeIR_key ':' t) '@' (DEFAULT) : % %

        1. Case analysis on t

          1. Case (% = "lpm")

            1. (Let matchMode be TBLC.MODE)

            2. (Let (LPM n) be matchMode, matchMode matches pattern `LPM %`)

              1. Result in: % % |- % '@' % : (LPM n) (DEFAULT)

          2. Case (% =/= "lpm")

            1. If ((t =/= "exact")), then

              1. Result in: % % |- % '@' % : (NON_LPM) (DEFAULT)

            1. Else Dangling#9723

    4. Case (% matches pattern `_`)

      1. Group dontcare: TC TBLC |- (typeIR_key ':' t) '@' ('_') : % %

        1. Case analysis on t

          1. Case (% = "lpm")

            1. (Let matchMode be TBLC.MODE)

            2. If ((matchMode matches pattern `LPM %`)), then

              1. Result in: % % |- % '@' % : (LPM 0) ('_')

            2. Else Dangling#9728

          2. Case (% =/= "lpm")

            1. If ((t =/= "exact")), then

              1. Result in: % % |- % '@' % : (NON_LPM) ('_')

            1. Else Dangling#9730

  1. Else Dangling#9641

Arm 2:

  1. If ((t = "range")), then

    1. (Let (expression_l '..' expression_r) be simpleKeysetExpression, simpleKeysetExpression matches pattern `% .. %`)

      1. Group range: TC TBLC |- (typeIR_key ':' "range") '@' (expression_l '..' expression_r) : % %

        1. (Expr_ok: (LOCAL) TC |- expression_l : typedExpressionIR_l)

        2. (Expr_ok: (LOCAL) TC |- expression_r : typedExpressionIR_r)

        3. (Let typedExpressionIR_l_cast be ! $cast_unary(typedExpressionIR_l, typeIR_key))

          1. (Let typedExpressionIR_r_cast be ! $cast_unary(typedExpressionIR_r, typeIR_key))

            1. (Let (typedExpressionIR_l_reduced, typedExpressionIR_r_reduced) be ! $reduce_serenum_binary(typedExpressionIR_l_cast, typedExpressionIR_r_cast, $compat_range))

              1. Result in: % % |- % '@' % : (NON_LPM) (typedExpressionIR_l_reduced '..' typedExpressionIR_r_reduced)

  1. Else Dangling#9732

def $is_singleton_list_expression(expression)

1. (Let (`{ sequenceOrRecordElementExpression trailingCommaOpt `}) be expression, expression has type sequenceOrRecordExpression)

  1. If ((sequenceOrRecordElementExpression has type expression)), then

