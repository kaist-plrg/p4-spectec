def $find_non_overloaded<V>((`{ ((callableId ':' V))*{V <- V*, callableId <- callableId*} `}), nameIR_f)

1. (Let ((callableId, V))*{(callableId, V) <- (callableId, V)*} be $find_non_overloadeds<V>((`{ ((callableId ':' V))*{V <- V*, callableId <- callableId*} `}), nameIR_f))

2. (Let [(callableId_found, V_found)] be ((callableId, V))*{(callableId, V) <- (callableId, V)*}, ((callableId, V))*{(callableId, V) <- (callableId, V)*} matches pattern [ _/1 ])

  1. Return ?((callableId_found, V_found))

3. Otherwise,

  1. Return ?()

def $find_non_overloadeds<V>(set<pair<callableId, V>>, nameIR_f)

1. Block (2 arms)

Arm 1:

  1. If ((set<pair<callableId, V>> = (`{ [] `}))), then

    1. Return []

  1. Else Dangling#2988

Arm 2:

  1. (Let (`{ (pair<callableId, V>)*{pair<callableId, V> <- pair<callableId, V>*} `}) be set<pair<callableId, V>>)

  2. (Let (callableId_h ':' V_h) :: ((callableId_t ':' V_t))*{V_t <- V_t*, callableId_t <- callableId_t*} be (pair<callableId, V>)*{pair<callableId, V> <- pair<callableId, V>*}, (pair<callableId, V>)*{pair<callableId, V> <- pair<callableId, V>*} matches pattern _ :: _)

    1. (Let (nameIR `( (_id)*{_id <- _id*} `)) be callableId_h)

    2. Case analysis on nameIR

      1. Case (% = nameIR_f)

        1. (Let ((callableId_t_found, V_t_found))*{V_t_found <- V_t_found*, callableId_t_found <- callableId_t_found*} be $find_non_overloadeds<V>((`{ ((callableId_t ':' V_t))*{V_t <- V_t*, callableId_t <- callableId_t*} `}), nameIR_f))

        2. Return (callableId_h, V_h) :: ((callableId_t_found, V_t_found))*{V_t_found <- V_t_found*, callableId_t_found <- callableId_t_found*}

      2. Case (% =/= nameIR_f)

        1. (Let ((callableId_t_found, V_t_found))*{V_t_found <- V_t_found*, callableId_t_found <- callableId_t_found*} be $find_non_overloadeds<V>((`{ ((callableId_t ':' V_t))*{V_t <- V_t*, callableId_t <- callableId_t*} `}), nameIR_f))

        2. Return ((callableId_t_found, V_t_found))*{V_t_found <- V_t_found*, callableId_t_found <- callableId_t_found*}

def $name_annotation(annotationList)

1. (Let (annotation)*{annotation <- annotation*} be $flatten_annotationList(annotationList))

2. (Let (nameIR_opt)?{nameIR_opt <- nameIR_opt?} be $name_annotation_opt(annotation))*

3. (Let ((nameIR_found)*{nameIR_found <- nameIR_found*})*{nameIR_found* <- nameIR_found**} be ($opt_as_seq_<nameIR>((nameIR_opt)?{nameIR_opt <- nameIR_opt?}))*{nameIR_opt? <- nameIR_opt?*})

4. Return $concat_<nameIR>(((nameIR_found)*{nameIR_found <- nameIR_found*})*{nameIR_found* <- nameIR_found**})

def $name_annotation_opt(annotation)

1. (Let ('@' name `( annotationBody `)) be annotation, annotation matches pattern `@ % (%)`)

  1. If (("name" = $name(name))), then

    1. (Let (annotationBody' annotationToken) be annotationBody, annotationBody matches pattern `% %`)

      1. If ((annotationBody' matches pattern `/* empty */`)), then

        1. (Let nameIR be $print_<annotationToken>(annotationToken))

        2. (Let text' be $strip_suffix(nameIR, "\""))

        3. (Let text be $strip_prefix(text', "\""))

        4. Return ?(text)

2. Otherwise,

  1. Return ?()

def $name_annotation_default(annotationList, nameIR)

1. Block (2 arms)

Arm 1:

  1. (Let (nameIR')*{nameIR' <- nameIR'*} be $name_annotation(annotationList))

  2. (Let [nameIR_found] be (nameIR')*{nameIR' <- nameIR'*}, (nameIR')*{nameIR' <- nameIR'*} matches pattern [ _/1 ])

    1. Return nameIR_found

Arm 2:

  1. If (($name_annotation(annotationList) matches pattern [])), then

    1. Return nameIR

  1. Else Dangling#3016

def $find_name_annotation_opt(annotationList)

1. Block (2 arms)

Arm 1:

  1. Case analysis on annotationList

    1. Case (% matches pattern `/* empty */`)

      1. Return ?()

    2. Case (let annotation be %, % has type annotation)

      1. (Let ('@' name `( annotationBody `)) be annotation, annotation matches pattern `@ % (%)`)

        1. Case analysis on "name"

          1. Case (% = $name(name))

            1. Return ?(annotation)

          2. Case (% =/= $name(name))

            1. Return ?()

Arm 2:

  1. (Let annotationListNonEmpty' be annotationList, annotationList has type annotationListNonEmpty)

    1. (Let (annotationListNonEmpty annotation) be annotationListNonEmpty', annotationListNonEmpty' matches pattern `% %`)

      1. Block (2 arms)

      Arm 1:

        1. If (($find_name_annotation_opt((annotation as annotationList)) matches pattern ())), then

          1. Return $find_name_annotation_opt((annotationListNonEmpty as annotationList))

      Arm 2:

        1. (Let annotation_found be ! $find_name_annotation_opt((annotation as annotationList)))

          1. Return ?(annotation_found)

2. Otherwise,

  1. Return ?()

def $add_annotationList(annotationList, (annotation')?{annotation' <- annotation'?})

1. Block (2 arms)

Arm 1:

  1. If (((annotation')?{annotation' <- annotation'?} matches pattern ())), then

    1. Return annotationList

  1. Else Dangling#3037

Arm 2:

  1. Case analysis on annotationList

    1. Case (% matches pattern `/* empty */`)

      1. (Let ?(annotation) be (annotation')?{annotation' <- annotation'?}, (annotation')?{annotation' <- annotation'?} matches pattern (_))

        1. Return (annotation as annotationList)

    2. Case (let annotationListNonEmpty be %, % has type annotationListNonEmpty)

      1. (Let ?(annotation) be (annotation')?{annotation' <- annotation'?}, (annotation')?{annotation' <- annotation'?} matches pattern (_))

        1. Return ((annotationListNonEmpty annotation) as annotationList)

def $subexpressions_of_typedExpressionIR(typedExpressionIR)

1. (Destruct (expressionIR, _expressionNoteIR) = typedExpressionIR)

2. (Let typedExpressionListIR be $subexpressions_of_expressionIR(expressionIR))

3. Return typedExpressionIR :: typedExpressionListIR

def $subexpressions_of_typedExpressionListIR((typedExpressionIR)*{typedExpressionIR <- typedExpressionIR*})

1. (Let typedExpressionListIR be $subexpressions_of_typedExpressionIR(typedExpressionIR))*

2. Return $concat_<typedExpressionIR>((typedExpressionListIR)*{typedExpressionListIR <- typedExpressionListIR*})

def $subexpressions_of_expressionIR(expressionIR)

1. Case analysis on expressionIR

  1. Case (let (unop typedExpressionIR) be %, % has type unaryExpressionIR)

    1. Return $subexpressions_of_typedExpressionIR(typedExpressionIR)

  2. Case (let (typedExpressionIR_l binop typedExpressionIR_r) be %, % has type binaryExpressionIR)

    1. (Let typedExpressionListIR' be $subexpressions_of_typedExpressionIR(typedExpressionIR_l))

    2. (Let typedExpressionListIR'' be $subexpressions_of_typedExpressionIR(typedExpressionIR_r))

    3. Return typedExpressionListIR' ++ typedExpressionListIR''

  3. Case (let (typedExpressionIR_cond '?' typedExpressionIR_then ':' typedExpressionIR_else) be %, % has type ternaryExpressionIR)

    1. (Let typedExpressionListIR''' be $subexpressions_of_typedExpressionIR(typedExpressionIR_cond))

    2. (Let typedExpressionListIR'''' be $subexpressions_of_typedExpressionIR(typedExpressionIR_then))

    3. (Let typedExpressionListIR''''' be $subexpressions_of_typedExpressionIR(typedExpressionIR_else))

    4. Return typedExpressionListIR''' ++ typedExpressionListIR'''' ++ typedExpressionListIR'''''

  4. Case (let (`( typeIR `) typedExpressionIR) be %, % has type castExpressionIR)

    1. Return $subexpressions_of_typedExpressionIR(typedExpressionIR)

  5. Case (let sequenceExpressionIR be %, % has type sequenceExpressionIR)

    1. Case analysis on sequenceExpressionIR

      1. Case (let (SEQ `{ typedExpressionListIR `}) be %, % matches pattern `SEQ {%}`)

        1. Return $subexpressions_of_typedExpressionListIR(typedExpressionListIR)

      2. Case (let (SEQ `{ typedExpressionListIR ',' '...' `}) be %, % matches pattern `SEQ {% , ...}`)

        1. Return $subexpressions_of_typedExpressionListIR(typedExpressionListIR)

  6. Case (let recordExpressionIR be %, % has type recordExpressionIR)

    1. Case analysis on recordExpressionIR

      1. Case (let (RECORD `{ ((nameIR '=' typedExpressionIR))*{nameIR <- nameIR*, typedExpressionIR <- typedExpressionIR*} `}) be %, % matches pattern `RECORD {%}`)

        1. Return $subexpressions_of_typedExpressionListIR((typedExpressionIR)*{typedExpressionIR <- typedExpressionIR*})

      2. Case (let (RECORD `{ ((nameIR '=' typedExpressionIR))*{nameIR <- nameIR*, typedExpressionIR <- typedExpressionIR*} ',' '...' `}) be %, % matches pattern `RECORD {% , ...}`)

        1. Return $subexpressions_of_typedExpressionListIR((typedExpressionIR)*{typedExpressionIR <- typedExpressionIR*})

  7. Case (let (memberAccessBaseIR '.' nameIR) be %, % has type memberAccessExpressionIR)

    1. (Let typedExpressionIR be memberAccessBaseIR, memberAccessBaseIR has type typedExpressionIR)

      1. Return $subexpressions_of_typedExpressionIR(typedExpressionIR)

  8. Case (let (typedExpressionIR_base `[ typedExpressionIR_index `]) be %, % has type indexAccessExpressionIR)

    1. (Let typedExpressionListIR'''''' be $subexpressions_of_typedExpressionIR(typedExpressionIR_base))

    2. (Let typedExpressionListIR''''''' be $subexpressions_of_typedExpressionIR(typedExpressionIR_index))

    3. Return typedExpressionListIR'''''' ++ typedExpressionListIR'''''''

  9. Case (let (typedExpressionIR_base `[ typedExpressionIR_hi sliceop typedExpressionIR_lo `]) be %, % has type sliceAccessExpressionIR)

    1. If ((sliceop matches pattern `:`)), then

      1. (Let typedExpressionListIR'''''''' be $subexpressions_of_typedExpressionIR(typedExpressionIR_base))

      2. (Let typedExpressionListIR''''''''' be $subexpressions_of_typedExpressionIR(typedExpressionIR_hi))

      3. (Let typedExpressionListIR'''''''''' be $subexpressions_of_typedExpressionIR(typedExpressionIR_lo))

      4. Return typedExpressionListIR'''''''' ++ typedExpressionListIR''''''''' ++ typedExpressionListIR''''''''''

  10. Case (let callExpressionIR be %, % has type callExpressionIR)

    1. Case analysis on callExpressionIR

      1. Case (let (constructorTargetIR `( (argumentIR)*{argumentIR <- argumentIR*} `)) be %, % matches pattern `% (%)`)

        1. Return $subexpressions_of_argumentListIR((argumentIR)*{argumentIR <- argumentIR*})

      2. Case (let (callableTargetIR `< (typeArgumentIR)*{typeArgumentIR <- typeArgumentIR*} `> `( (argumentIR)*{argumentIR <- argumentIR*} `)) be %, % matches pattern `% <%> (%)`)

        1. Return $subexpressions_of_argumentListIR((argumentIR)*{argumentIR <- argumentIR*})

  11. Case (let (`( typedExpressionIR `)) be %, % has type parenthesizedExpressionIR)

    1. Return $subexpressions_of_typedExpressionIR(typedExpressionIR)

2. Otherwise,

  1. Return []

def $subexpressions_of_argumentIR(argumentIR)

1. Case analysis on argumentIR

  1. Case (let typedExpressionIR be %, % has type typedExpressionIR)

    1. Return $subexpressions_of_typedExpressionIR(typedExpressionIR)

  2. Case (let (nameIR '=' typedExpressionIR) be %, % matches pattern `% = %`)

    1. Return $subexpressions_of_typedExpressionIR(typedExpressionIR)

2. Otherwise,

  1. Return []

def $subexpressions_of_argumentListIR((argumentIR)*{argumentIR <- argumentIR*})

1. (Let typedExpressionListIR be $subexpressions_of_argumentIR(argumentIR))*

2. Return $concat_<typedExpressionIR>((typedExpressionListIR)*{typedExpressionListIR <- typedExpressionListIR*})

