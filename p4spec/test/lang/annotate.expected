                2. Case (let (_CONT value) be %, % has type continueResult<value>)

                  1. Case analysis on value

                    1. Case (let headerStackValue_base be %, % has type headerStackValue)

                      1. (Let (HEADER_STACK `[ (value_elem)*{value_elem <- value_elem*} `( _nat `) `]) be headerStackValue_base)

                      2. Case analysis on nameIR

                        1. Case (% = "size")

                          1. (Let n_size be |(value_elem)*{value_elem <- value_elem*}|)

                          2. (Let expressionResult be ((_CONT ((32 W (n_size as int)) as value)) as expressionResult))

                          3. Result in: % % % |- % : EC_1 ARCH_1 expressionResult

                        2. Case (% = "last")

                          1. (Let n_size be |(value_elem)*{value_elem <- value_elem*}|)

                          2. (Let b_out_of_bounds be ((_nat < 1) \/ (_nat > n_size)))

                          3. Case analysis on b_out_of_bounds

                            1. Case true

                              1. (Let rejectTransitionResult be (REJECT (ERROR '.' "StackOutOfBounds")))

                              2. Result in: % % % |- % : EC_1 ARCH_1 (rejectTransitionResult as expressionResult)

                            2. Case false

                              1. (Let i be (_nat - 1))

                              2. (Let n_idx_last be i, i has type nat)

