          1. (ControlLocalDecls_inst: IC_1 STO_1 |- (controlLocalDeclarationIR_t)*{controlLocalDeclarationIR_t <- controlLocalDeclarationIR_t*} : IC_2 STO_2 (controlLocalDeclarationIR_t_inst)*{controlLocalDeclarationIR_t_inst <- controlLocalDeclarationIR_t_inst*})

          2. Result in: % % |- % : IC_2 STO_2 (controlLocalDeclarationIR_t_inst)*{controlLocalDeclarationIR_t_inst <- controlLocalDeclarationIR_t_inst*}

        2. Case (let ?(controlLocalDeclarationIR_h_inst) be %, % matches pattern (_))

          1. (ControlLocalDecls_inst: IC_1 STO_1 |- (controlLocalDeclarationIR_t)*{controlLocalDeclarationIR_t <- controlLocalDeclarationIR_t*} : IC_2 STO_2 (controlLocalDeclarationIR_t_inst)*{controlLocalDeclarationIR_t_inst <- controlLocalDeclarationIR_t_inst*})

