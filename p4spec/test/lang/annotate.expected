def $reduce_serenum(typedExpressionIR)

1. (Let typeIR be $type_of_typedExpressionIR(typedExpressionIR))

2. (Let ctk be $ctk_of_typedExpressionIR(typedExpressionIR))

3. (Let typeIR' be $unroll_typeIR(typeIR))

4. (Let (ENUM _typeId `< typeIR_underlying `> `{ (_valueFieldIR)*{_valueFieldIR <- _valueFieldIR*} `}) be typeIR', typeIR' has type serializableEnumTypeIR)

  1. (Let typedExpressionIR_reduced be (((`( typeIR_underlying `) typedExpressionIR) as expressionIR) '#' (`( typeIR_underlying ctk `))))

  2. Return typedExpressionIR_reduced

5. Otherwise,

  1. Return typedExpressionIR

def $reduce_serenum_unary(typedExpressionIR, $check(typeIR) : bool)

1. (Destruct (_expressionIR, (`( typeIR ctk `))) = typedExpressionIR)

2. Case analysis on $check(typeIR)

  1. Case true

    1. Return ?(typedExpressionIR)

  2. Case false

    1. (Let typeIR' be $unroll_typeIR(typeIR))

    2. (Let (ENUM _typeId `< typeIR_underlying `> `{ (_valueFieldIR)*{_valueFieldIR <- _valueFieldIR*} `}) be typeIR', typeIR' has type serializableEnumTypeIR)

      1. (Let typedExpressionIR_cast be (((`( typeIR_underlying `) typedExpressionIR) as expressionIR) '#' (`( typeIR_underlying ctk `))))

      2. Return $reduce_serenum_unary(typedExpressionIR_cast, $check)

3. Otherwise,

  1. Return ?()

def $reduce_serenum_binary(typedExpressionIR_l, typedExpressionIR_r, $check(typeIR, typeIR') : bool)

1. (Destruct (_expressionIR, (`( typeIR_l ctk `))) = typedExpressionIR_l)

2. (Destruct (_expressionIR', (`( typeIR_r _ctk `))) = typedExpressionIR_r)

3. Case analysis on $check(typeIR_l, typeIR_r)

  1. Case true

    1. Return ?((typedExpressionIR_l, typedExpressionIR_r))

  2. Case false

    1. Block (2 arms)

    Arm 1:

      1. (Let typeIR be $unroll_typeIR(typeIR_l))

      2. (Let (ENUM _typeId `< typeIR_l_underlying `> `{ (_valueFieldIR)*{_valueFieldIR <- _valueFieldIR*} `}) be typeIR, typeIR has type serializableEnumTypeIR)

        1. (Let typedExpressionIR_l_cast be (((`( typeIR_l_underlying `) typedExpressionIR_l) as expressionIR) '#' (`( typeIR_l_underlying ctk `))))

        2. Return $reduce_serenum_binary(typedExpressionIR_l_cast, typedExpressionIR_r, $check)

    Arm 2:

      1. If (~($unroll_typeIR(typeIR_l) has type serializableEnumTypeIR)), then

        1. (Let typeIR be $unroll_typeIR(typeIR_r))

        2. (Let (ENUM _typeId `< typeIR_r_underlying `> `{ (_valueFieldIR)*{_valueFieldIR <- _valueFieldIR*} `}) be typeIR, typeIR has type serializableEnumTypeIR)

          1. (Let typedExpressionIR_r_cast be (((`( typeIR_r_underlying `) typedExpressionIR_r) as expressionIR) '#' (`( typeIR_r_underlying _ctk `))))

          2. Return $reduce_serenum_binary(typedExpressionIR_l, typedExpressionIR_r_cast, $check)

4. Otherwise,

  1. Return ?()

def $apply_cast(typedExpressionIR, (typeIR)*{typeIR <- typeIR*})

1. Case analysis on (typeIR)*{typeIR <- typeIR*}

  1. Case (% matches pattern [])

    1. Return typedExpressionIR

  2. Case (let typeIR_h :: (typeIR_t)*{typeIR_t <- typeIR_t*} be %, % matches pattern _ :: _)

    1. (Destruct (_expressionIR, (`( _typeIR ctk `))) = typedExpressionIR)

    2. (Let typedExpressionIR_cast be (((`( typeIR_h `) typedExpressionIR) as expressionIR) '#' (`( typeIR_h ctk `))))

    3. Return $apply_cast(typedExpressionIR_cast, (typeIR_t)*{typeIR_t <- typeIR_t*})

def $cast_unary(typedExpressionIR, typeIR_to)

1. (Destruct (_expressionIR, (`( typeIR _ctk `))) = typedExpressionIR)

2. (Cast_impl: typeIR -> typeIR_to : castResult)

3. (Let (OK (typeIR_cast)*{typeIR_cast <- typeIR_cast*}) be castResult, castResult matches pattern `OK %`)

  1. (Let typedExpressionIR_cast be $apply_cast(typedExpressionIR, (typeIR_cast)*{typeIR_cast <- typeIR_cast*}))

  2. Return ?(typedExpressionIR_cast)

4. Otherwise,

  1. Return ?()

def $cast_binary(typedExpressionIR_l, typedExpressionIR_r)

1. (Destruct (_expressionIR, (`( typeIR_l _ctk `))) = typedExpressionIR_l)

2. (Destruct (_expressionIR', (`( typeIR_r _ctk' `))) = typedExpressionIR_r)

3. (Cast_impl: typeIR_l -> typeIR_r : castResult)

4. Case analysis on castResult

  1. Case (let (OK (typeIR_cast)*{typeIR_cast <- typeIR_cast*}) be %, % matches pattern `OK %`)

    1. (Let typedExpressionIR_l_cast be $apply_cast(typedExpressionIR_l, (typeIR_cast)*{typeIR_cast <- typeIR_cast*}))

    2. Return ?((typedExpressionIR_l_cast, typedExpressionIR_r))

  2. Case (% matches pattern `FAIL`)

    1. (Cast_impl: typeIR_r -> typeIR_l : castResult')

    2. Case analysis on castResult'

      1. Case (let (OK (typeIR_cast)*{typeIR_cast <- typeIR_cast*}) be %, % matches pattern `OK %`)

        1. (Let typedExpressionIR_r_cast be $apply_cast(typedExpressionIR_r, (typeIR_cast)*{typeIR_cast <- typeIR_cast*}))

        2. Return ?((typedExpressionIR_l, typedExpressionIR_r_cast))

      2. Case (% matches pattern `FAIL`)

        1. (Let typedExpressionIR_l_cast be $reduce_serenum(typedExpressionIR_l))

        2. Block (2 arms)

        Arm 1:

          1. If ((typedExpressionIR_l =/= typedExpressionIR_l_cast)), then

            1. Return $cast_binary(typedExpressionIR_l_cast, typedExpressionIR_r)

        Arm 2:

          1. If ((typedExpressionIR_l = typedExpressionIR_l_cast)), then

            1. (Let typedExpressionIR_r_cast be $reduce_serenum(typedExpressionIR_r))

            2. If ((typedExpressionIR_r =/= typedExpressionIR_r_cast)), then

              1. Return $cast_binary(typedExpressionIR_l, typedExpressionIR_r_cast)

5. Otherwise,

  1. Return ?()

tbl def $compat_lnot(typeIR'')
=

  Row : ((BOOL) as typeIR) -> true:

    1. (Let boolTypeIR be typeIR'', typeIR'' has type boolTypeIR)

      1. Return true

  Row : ((TYPEDEF _typeId typeIR) as typeIR) -> $compat_lnot(typeIR):

    1. (Let (TYPEDEF _typeId typeIR) be typeIR'', typeIR'' has type typedefTypeIR)

      1. Return $compat_lnot(typeIR)

  Row : _typeIR -> false:

    1. Return false

