def $cast_control_plane(EC, typedExpressionIR, typeIR_to)

1. Block (2 arms)

Arm 1:

  1. (Let typedExpressionIR_cast be ! $cast_unary(typedExpressionIR, typeIR_to))

    1. Return ?(typedExpressionIR_cast)

Arm 2:

  1. If (($cast_unary(typedExpressionIR, typeIR_to) matches pattern ())), then

    1. Block (3 arms)

    Arm 1:

      1. If ((((BOOL) as typeIR) = typeIR_to)), then

        1. If ((((INT) as typeIR) = $type_of_typedExpressionIR(typedExpressionIR))), then

          1. (Let ctk be $ctk_of_typedExpressionIR(typedExpressionIR))

          2. (Let typedExpressionIR_cast be (((`( typeIR_to `) typedExpressionIR) as expressionIR) '#' (`( typeIR_to ctk `))))

          3. Return ?(typedExpressionIR_cast)

    Arm 2:

      1. If ((((ERROR) as typeIR) = typeIR_to)), then

        1. (Destruct (expressionIR, (`( typeIR ctk `))) = typedExpressionIR)

        2. (Let integerLiteral be expressionIR, expressionIR has type integerLiteral)

          1. (Let (D i) be integerLiteral, integerLiteral matches pattern `D %`)

            1. (Let n be i, i has type nat)

              1. (Let intTypeIR be typeIR, typeIR has type intTypeIR)

                1. (Let (`{ (value_frame)*{value_frame <- value_frame*} `}) be $codom_map<id, value>(EC.GLOBAL.FRAME))

                2. (Let (value_error)*{value_error <- value_error*} be $filter_<value>((value_frame)*{value_frame <- value_frame*}, ((value_frame has type errorValue))*{value_frame <- value_frame*}))

                3. If ((n < |(value_error)*{value_error <- value_error*}|)), then

                  1. (Let value be (value_error)*{value_error <- value_error*}[n])

                  2. (Let (ERROR '.' nameIR_error) be value, value has type errorValue)

                    1. (Let typedExpressionIR_error be (((ERROR '.' nameIR_error) as expressionIR) '#' (`( typeIR_to ctk `))))

                    2. Return ?(typedExpressionIR_error)

    Arm 3:

      1. Case analysis on typeIR_to

        1. Case (let (TYPEDEF _typeId typeIR_base) be %, % has type typedefTypeIR)

          1. (Let typedExpressionIR_typedef be ! $cast_control_plane(EC, typedExpressionIR, typeIR_base))

            1. (Let ctk be $ctk_of_typedExpressionIR(typedExpressionIR_typedef))

            2. (Let typedExpressionIR_cast be (((`( typeIR_to `) typedExpressionIR_typedef) as expressionIR) '#' (`( typeIR_to ctk `))))

            3. Return ?(typedExpressionIR_cast)

        2. Case (let (TYPE _typeId typeIR_base) be %, % has type newTypeIR)

          1. (Let typedExpressionIR_newtype be ! $cast_control_plane(EC, typedExpressionIR, typeIR_base))

            1. (Let ctk be $ctk_of_typedExpressionIR(typedExpressionIR_newtype))

            2. (Let typedExpressionIR_cast be (((`( typeIR_to `) typedExpressionIR_newtype) as expressionIR) '#' (`( typeIR_to ctk `))))

            3. Return ?(typedExpressionIR_cast)

        3. Case (let (ENUM _typeId `< typeIR_base `> `{ (_valueFieldIR)*{_valueFieldIR <- _valueFieldIR*} `}) be %, % has type serializableEnumTypeIR)

          1. (Let typedExpressionIR_enum be ! $cast_control_plane(EC, typedExpressionIR, typeIR_base))

            1. (Let ctk be $ctk_of_typedExpressionIR(typedExpressionIR_enum))

            2. (Let typedExpressionIR_cast be (((`( typeIR_to `) typedExpressionIR_enum) as expressionIR) '#' (`( typeIR_to ctk `))))

            3. Return ?(typedExpressionIR_cast)

2. Otherwise,

  1. Return ?()

def $reverse_bytes_of_hex(t)

1. If ((t[0 : 2] = "0x")), then

  1. (Let n_len be |t|)

  2. (Let i be (n_len - 2))

  3. (Let n_len_bytes be i, i has type nat)

    1. (Let text be $reverse_bytes_of_hex'(t[2 : n_len_bytes]))

    2. Return "0x" ++ text

1. Else Dangling#13682

def $reverse_bytes_of_hex'(t)

1. Block (2 arms)

Arm 1:

  1. If ((|t| <= 2)), then

    1. Return t

  1. Else Dangling#13688

Arm 2:

  1. (Let n_len be |t|)

  2. If ((n_len > 2)), then

    1. (Let t_byte be t[0 : 2])

    2. (Let i be (n_len - 2))

    3. (Let n_len_bytes be i, i has type nat)

      1. (Let t_bytes be t[2 : n_len_bytes])

      2. (Let t_bytes_rev be $reverse_bytes_of_hex'(t_bytes))

      3. Return t_bytes_rev ++ t_byte

  2. Else Dangling#13691

