def $chain_casts_recordTypeIR(((annotationList_a typeIR_a id_a ';'))*{annotationList_a <- annotationList_a*, id_a <- id_a*, typeIR_a <- typeIR_a*}, ((typeIR_cast_elem)*{typeIR_cast_elem <- typeIR_cast_elem*})*{typeIR_cast_elem* <- typeIR_cast_elem**}, typeIR_b)

