syntax strict = 
   | STRICT (from strict) 
   | LAX (from strict) 

syntax strictness = map<typeId, strict>

def $empty_strictness((typeId)*{typeId <- typeId*})

1. Return (`{ ((typeId ':' (STRICT)))*{typeId <- typeId*} `})

syntax infer = 
   | KNOWN AS typeIR (from infer) 
   | UNKNOWN (from infer) 

syntax constraint = map<typeId, infer>

def $empty_constraint((typeId)*{typeId <- typeId*})

1. Return (`{ ((typeId ':' (UNKNOWN)))*{typeId <- typeId*} `})

syntax inference = map<typeId, typeIR>

def $infer((typeId)*{typeId <- typeId*}, (parameterIR)*{parameterIR <- parameterIR*}, (parameterIR_optional)*{parameterIR_optional <- parameterIR_optional*}, (argumentIR)*{argumentIR <- argumentIR*})

1. Case analysis on (typeId)*{typeId <- typeId*}

  1. Case (% matches pattern [])

    1. Return $empty_map<typeId, typeIR>

  2. Case (% matches pattern _ :: _)

    1. (Let strictness_init be $empty_strictness((typeId)*{typeId <- typeId*}))

    2. (Let B be $free_parameterIRs((parameterIR)*{parameterIR <- parameterIR*}))

    3. (Let B_optional be $free_parameterIRs((parameterIR_optional)*{parameterIR_optional <- parameterIR_optional*}))

    4. (Let (`{ (typeId_free)*{typeId_free <- typeId_free*} `}) be $diff_set<typeId>(B_optional, B))

    5. (Let (strict)*{strict <- strict*} be $repeat_<strict>((LAX), |(typeId_free)*{typeId_free <- typeId_free*}|))

    6. (Let strictness be $adds_map<typeId, strict>(strictness_init, (typeId_free)*{typeId_free <- typeId_free*}, (strict)*{strict <- strict*}))

    7. (Let constraint_init be $empty_constraint((typeId)*{typeId <- typeId*}))

    8. If ((|(argumentIR)*{argumentIR <- argumentIR*}| = |(parameterIR)*{parameterIR <- parameterIR*}|)), then

      1. (Let constraint_pair be $infer_pair(constraint_init, parameterIR, argumentIR))*

      2. (Let constraint_inferred be $merge_constraints(constraint_init, (constraint_pair)*{constraint_pair <- constraint_pair*}))

      3. (Let inference be $resolve_constraint(strictness, constraint_inferred))

      4. (Let inference_resolved be $resolve_inference(inference))

      5. Return inference_resolved

    8. Else Dangling#9814

def $infer_pair(constraint, parameterIR, argumentIR)

1. Case analysis on argumentIR

  1. Case (let typedExpressionIR be %, % has type typedExpressionIR)

    1. (Destruct (_annotationList, _direction, typeIR_param, _id, _parameterInitializerOptIR) = parameterIR)

    2. (Let typeIR_arg be $type_of_typedExpressionIR(typedExpressionIR))

    3. Return $gen_constraint_pair(constraint, typeIR_param, typeIR_arg)

  2. Case (let (nameIR '=' typedExpressionIR) be %, % matches pattern `% = %`)

    1. (Destruct (_annotationList, _direction, typeIR_param, _id, _parameterInitializerOptIR) = parameterIR)

    2. (Let typeIR_arg be $type_of_typedExpressionIR(typedExpressionIR))

    3. Return $gen_constraint_pair(constraint, typeIR_param, typeIR_arg)

  3. Case (% matches pattern `% = _`)

    1. Return constraint

  4. Case (% matches pattern `_`)

    1. Return constraint

def $resolve_inference((`{ ((typeId ':' typeIR))*{typeIR <- typeIR*, typeId <- typeId*} `}))

1. (Let typeIR_resolved be $resolve_inference'(typeIR))*

2. Return (`{ ((typeId ':' typeIR_resolved))*{typeIR_resolved <- typeIR_resolved*, typeId <- typeId*} `})

def $resolve_inference'(typeIR)

1. (Let typeIR' be $unroll_typeIR(typeIR))

2. (Let sequenceTypeIR be typeIR', typeIR' has type sequenceTypeIR)

  1. (Let (SEQ `< (typeIR_arg)*{typeIR_arg <- typeIR_arg*} `>) be sequenceTypeIR, sequenceTypeIR matches pattern `SEQ <%>`)

    1. (Let typeIR_resolved be ((TUPLE `< (typeIR_arg)*{typeIR_arg <- typeIR_arg*} `>) as typeIR))

    2. Return typeIR_resolved

3. Otherwise,

  1. Return typeIR

def $gen_constraint(constraint, (typeIR_param)*{typeIR_param <- typeIR_param*}, (typeIR_arg)*{typeIR_arg <- typeIR_arg*})

1. If ((|(typeIR_arg)*{typeIR_arg <- typeIR_arg*}| = |(typeIR_param)*{typeIR_param <- typeIR_param*}|)), then

  1. (Let constraint_pair be $gen_constraint_pair(constraint, typeIR_param, typeIR_arg))*

  2. Return $merge_constraints(constraint, (constraint_pair)*{constraint_pair <- constraint_pair*})

1. Else Dangling#9841

def $gen_constraint_pair(constraint, typeIR, typeIR_arg')

1. Block (2 arms)

Arm 1:

  1. Case analysis on typeIR

    1. Case (let (_NAME typeId_param) be %, % has type nameTypeIR)

      1. If ($in_set<typeId>(typeId_param, $dom_map<typeId, infer>(constraint))), then

        1. Return $update_map<typeId, infer>(constraint, typeId_param, (KNOWN AS typeIR_arg'))

    2. Case (let (TYPEDEF _typeId typeIR_param) be %, % has type typedefTypeIR)

      1. Return $gen_constraint_pair(constraint, typeIR_param, typeIR_arg')

    3. Case (let (TYPE typeId typeIR_param) be %, % has type newTypeIR)

      1. (Let (TYPE typeId' typeIR_arg) be typeIR_arg', typeIR_arg' has type newTypeIR)

        1. If ((typeId = typeId')), then

          1. Return $gen_constraint_pair(constraint, typeIR_param, typeIR_arg)

    4. Case (let (LIST `< typeIR_param `>) be %, % has type listTypeIR)

      1. (Let (LIST `< typeIR_arg `>) be typeIR_arg', typeIR_arg' has type listTypeIR)

        1. Return $gen_constraint_pair(constraint, typeIR_param, typeIR_arg)

    5. Case (let (TUPLE `< (typeIR_param)*{typeIR_param <- typeIR_param*} `>) be %, % has type tupleTypeIR)

      1. (Let (TUPLE `< (typeIR_arg)*{typeIR_arg <- typeIR_arg*} `>) be typeIR_arg', typeIR_arg' has type tupleTypeIR)

        1. Return $gen_constraint(constraint, (typeIR_param)*{typeIR_param <- typeIR_param*}, (typeIR_arg)*{typeIR_arg <- typeIR_arg*})

    6. Case (let (ARRAY typeIR_param `[ n_size `]) be %, % has type arrayTypeIR)

      1. (Let (ARRAY typeIR_arg `[ n_size' `]) be typeIR_arg', typeIR_arg' has type arrayTypeIR)

        1. If ((n_size = n_size')), then

          1. Return $gen_constraint_pair(constraint, typeIR_param, typeIR_arg)

    7. Case (let (HEADER_STACK typeIR_param `[ n_size `]) be %, % has type headerStackTypeIR)

      1. (Let (HEADER_STACK typeIR_arg `[ n_size' `]) be typeIR_arg', typeIR_arg' has type headerStackTypeIR)

        1. If ((n_size = n_size')), then

          1. Return $gen_constraint_pair(constraint, typeIR_param, typeIR_arg)

    8. Case (let (STRUCT typeId `< (typeIR_arg_a)*{typeIR_arg_a <- typeIR_arg_a*} `> `{ (_fieldTypeIR)*{_fieldTypeIR <- _fieldTypeIR*} `}) be %, % has type structTypeIR)

      1. (Let (STRUCT typeId' `< (typeIR_arg_b)*{typeIR_arg_b <- typeIR_arg_b*} `> `{ (_fieldTypeIR')*{_fieldTypeIR' <- _fieldTypeIR'*} `}) be typeIR_arg', typeIR_arg' has type structTypeIR)

        1. If ((typeId = typeId')), then

          1. Return $gen_constraint(constraint, (typeIR_arg_a)*{typeIR_arg_a <- typeIR_arg_a*}, (typeIR_arg_b)*{typeIR_arg_b <- typeIR_arg_b*})

    9. Case (let (HEADER typeId `< (typeIR_arg_a)*{typeIR_arg_a <- typeIR_arg_a*} `> `{ (_fieldTypeIR)*{_fieldTypeIR <- _fieldTypeIR*} `}) be %, % has type headerTypeIR)

      1. (Let (HEADER typeId' `< (typeIR_arg_b)*{typeIR_arg_b <- typeIR_arg_b*} `> `{ (_fieldTypeIR')*{_fieldTypeIR' <- _fieldTypeIR'*} `}) be typeIR_arg', typeIR_arg' has type headerTypeIR)

        1. If ((typeId = typeId')), then

          1. Return $gen_constraint(constraint, (typeIR_arg_a)*{typeIR_arg_a <- typeIR_arg_a*}, (typeIR_arg_b)*{typeIR_arg_b <- typeIR_arg_b*})

    10. Case (let (HEADER_UNION typeId `< (typeIR_arg_a)*{typeIR_arg_a <- typeIR_arg_a*} `> `{ (_fieldTypeIR)*{_fieldTypeIR <- _fieldTypeIR*} `}) be %, % has type headerUnionTypeIR)

      1. (Let (HEADER_UNION typeId' `< (typeIR_arg_b)*{typeIR_arg_b <- typeIR_arg_b*} `> `{ (_fieldTypeIR')*{_fieldTypeIR' <- _fieldTypeIR'*} `}) be typeIR_arg', typeIR_arg' has type headerUnionTypeIR)

        1. If ((typeId = typeId')), then

          1. Return $gen_constraint(constraint, (typeIR_arg_a)*{typeIR_arg_a <- typeIR_arg_a*}, (typeIR_arg_b)*{typeIR_arg_b <- typeIR_arg_b*})

    11. Case (let (EXTERN typeId `< (typeIR_arg_a)*{typeIR_arg_a <- typeIR_arg_a*} `> (`{ (_pair<callableId, externMethodTypeDefIR>)*{_pair<callableId, externMethodTypeDefIR> <- _pair<callableId, externMethodTypeDefIR>*} `})) be %, % has type externObjectTypeIR)

      1. (Let (EXTERN typeId' `< (typeIR_arg_b)*{typeIR_arg_b <- typeIR_arg_b*} `> (`{ (_pair<callableId, externMethodTypeDefIR>')*{_pair<callableId, externMethodTypeDefIR>' <- _pair<callableId, externMethodTypeDefIR>'*} `})) be typeIR_arg', typeIR_arg' has type externObjectTypeIR)

        1. If ((typeId = typeId')), then

          1. Return $gen_constraint(constraint, (typeIR_arg_a)*{typeIR_arg_a <- typeIR_arg_a*}, (typeIR_arg_b)*{typeIR_arg_b <- typeIR_arg_b*})

    12. Case (let (PARSER _typeId `< (_typeArgumentIR)*{_typeArgumentIR <- _typeArgumentIR*} `> `( (parameterIR_param)*{parameterIR_param <- parameterIR_param*} `)) be %, % has type parserObjectTypeIR)

      1. (Let (PARSER _typeId' `< (_typeArgumentIR')*{_typeArgumentIR' <- _typeArgumentIR'*} `> `( (parameterIR_arg)*{parameterIR_arg <- parameterIR_arg*} `)) be typeIR_arg', typeIR_arg' has type parserObjectTypeIR)

        1. (Let (_annotationList direction typeIR_param _id _parameterInitializerOptIR) be parameterIR_param)*

        2. (Let (_annotationList' direction' typeIR_arg _id' _parameterInitializerOptIR') be parameterIR_arg)*

        3. If ((|(direction)*{direction <- direction*}| = |(direction')*{direction' <- direction'*}|)), then

          1. If ((direction' = direction))*{direction <- direction*, direction' <- direction'*}, then

            1. Return $gen_constraint(constraint, (typeIR_param)*{typeIR_param <- typeIR_param*}, (typeIR_arg)*{typeIR_arg <- typeIR_arg*})

    13. Case (let (CONTROL _typeId `< (_typeArgumentIR)*{_typeArgumentIR <- _typeArgumentIR*} `> `( (parameterIR_param)*{parameterIR_param <- parameterIR_param*} `)) be %, % has type controlObjectTypeIR)

      1. (Let (CONTROL _typeId' `< (_typeArgumentIR')*{_typeArgumentIR' <- _typeArgumentIR'*} `> `( (parameterIR_arg)*{parameterIR_arg <- parameterIR_arg*} `)) be typeIR_arg', typeIR_arg' has type controlObjectTypeIR)

        1. (Let (_annotationList direction typeIR_param _id _parameterInitializerOptIR) be parameterIR_param)*

        2. (Let (_annotationList' direction' typeIR_arg _id' _parameterInitializerOptIR') be parameterIR_arg)*

        3. If ((|(direction)*{direction <- direction*}| = |(direction')*{direction' <- direction'*}|)), then

          1. If ((direction' = direction))*{direction <- direction*, direction' <- direction'*}, then

            1. Return $gen_constraint(constraint, (typeIR_param)*{typeIR_param <- typeIR_param*}, (typeIR_arg)*{typeIR_arg <- typeIR_arg*})

    14. Case (let (PACKAGE _typeId `< (_typeArgumentIR)*{_typeArgumentIR <- _typeArgumentIR*} `> `{ (typeIR_param)*{typeIR_param <- typeIR_param*} `}) be %, % has type packageObjectTypeIR)

      1. (Let (PACKAGE _typeId' `< (_typeArgumentIR')*{_typeArgumentIR' <- _typeArgumentIR'*} `> `{ (typeIR_arg)*{typeIR_arg <- typeIR_arg*} `}) be typeIR_arg', typeIR_arg' has type packageObjectTypeIR)

        1. Return $gen_constraint(constraint, (typeIR_param)*{typeIR_param <- typeIR_param*}, (typeIR_arg)*{typeIR_arg <- typeIR_arg*})

Arm 2:

  1. (Let (TYPEDEF _typeId typeIR_arg) be typeIR_arg', typeIR_arg' has type typedefTypeIR)

    1. If (~(typeIR has type nameTypeIR)), then

      1. If (~(typeIR has type typedefTypeIR)), then

        1. Return $gen_constraint_pair(constraint, typeIR, typeIR_arg)

2. Otherwise,

  1. Return constraint

def $merge_constraint(constraint_pre, constraint_post)

1. (Let (`{ (typeId_pre)*{typeId_pre <- typeId_pre*} `}) be $dom_map<typeId, infer>(constraint_pre))

2. (Let (`{ (typeId_post)*{typeId_post <- typeId_post*} `}) be $dom_map<typeId, infer>(constraint_post))

3. If ($eq_set<typeId>((`{ (typeId_pre)*{typeId_pre <- typeId_pre*} `}), (`{ (typeId_post)*{typeId_post <- typeId_post*} `}))), then

  1. Return $merge_constraint'(constraint_pre, constraint_post, (typeId_pre)*{typeId_pre <- typeId_pre*}, (`{ [] `}))

3. Else Dangling#9921

def $merge_constraint'(constraint_pre, constraint_post, (typeId)*{typeId <- typeId*}, constraint)

1. Case analysis on (typeId)*{typeId <- typeId*}

  1. Case (% matches pattern [])

    1. Return constraint

  2. Case (let typeId_h :: (typeId_t)*{typeId_t <- typeId_t*} be %, % matches pattern _ :: _)

    1. Block (2 arms)

    Arm 1:

      1. If ((?((UNKNOWN)) = $find_map<typeId, infer>(constraint_pre, typeId_h))), then

        1. Block (2 arms)

        Arm 1:

          1. If ((?((UNKNOWN)) = $find_map<typeId, infer>(constraint_post, typeId_h))), then

            1. (Let constraint_updated be $update_map<typeId, infer>(constraint, typeId_h, (UNKNOWN)))

            2. Return $merge_constraint'(constraint_pre, constraint_post, (typeId_t)*{typeId_t <- typeId_t*}, constraint_updated)

          1. Else Dangling#9927

        Arm 2:

          1. (Let infer be ! $find_map<typeId, infer>(constraint_post, typeId_h))

            1. (Let (KNOWN AS typeIR_post) be infer, infer matches pattern `KNOWN AS %`)

              1. (Let constraint_updated be $update_map<typeId, infer>(constraint, typeId_h, (KNOWN AS typeIR_post)))

              2. Return $merge_constraint'(constraint_pre, constraint_post, (typeId_t)*{typeId_t <- typeId_t*}, constraint_updated)

      1. Else Dangling#9926

    Arm 2:

      1. (Let infer be ! $find_map<typeId, infer>(constraint_pre, typeId_h))

        1. (Let (KNOWN AS typeIR_pre) be infer, infer matches pattern `KNOWN AS %`)

          1. Block (2 arms)

          Arm 1:

            1. If ((?((UNKNOWN)) = $find_map<typeId, infer>(constraint_post, typeId_h))), then

              1. (Let constraint_updated be $update_map<typeId, infer>(constraint, typeId_h, (KNOWN AS typeIR_pre)))

              2. Return $merge_constraint'(constraint_pre, constraint_post, (typeId_t)*{typeId_t <- typeId_t*}, constraint_updated)

            1. Else Dangling#9942

          Arm 2:

            1. (Let infer'' be ! $find_map<typeId, infer>(constraint_post, typeId_h))

              1. (Let (KNOWN AS typeIR_post) be infer'', infer'' matches pattern `KNOWN AS %`)

                1. (Cast_impl: typeIR_pre -> typeIR_post : castResult)

                2. Case analysis on castResult

                  1. Case (% matches pattern `OK %`)

                    1. (Let constraint_updated be $update_map<typeId, infer>(constraint, typeId_h, (KNOWN AS typeIR_post)))

                    2. Return $merge_constraint'(constraint_pre, constraint_post, (typeId_t)*{typeId_t <- typeId_t*}, constraint_updated)

                  2. Case (% matches pattern `FAIL`)

                    1. (Cast_impl: typeIR_post -> typeIR_pre : castResult')

                    2. If ((castResult' matches pattern `OK %`)), then

                      1. (Let constraint_updated be $update_map<typeId, infer>(constraint, typeId_h, (KNOWN AS typeIR_pre)))

                      2. Return $merge_constraint'(constraint_pre, constraint_post, (typeId_t)*{typeId_t <- typeId_t*}, constraint_updated)

                    2. Else Dangling#9955

def $merge_constraints(constraint_pre, (constraint)*{constraint <- constraint*})

1. Case analysis on (constraint)*{constraint <- constraint*}

  1. Case (% matches pattern [])

    1. Return constraint_pre

  2. Case (let constraint_post_h :: (constraint_post_t)*{constraint_post_t <- constraint_post_t*} be %, % matches pattern _ :: _)

    1. (Let constraint_pre_1 be $merge_constraint(constraint_pre, constraint_post_h))

    2. (Let constraint_pre_2 be $merge_constraints(constraint_pre_1, (constraint_post_t)*{constraint_post_t <- constraint_post_t*}))

    3. Return constraint_pre_2

def $resolve_constraint(strictness, set<pair<typeId, infer>>)

1. Block (2 arms)

Arm 1:

  1. If ((set<pair<typeId, infer>> = (`{ [] `}))), then

    1. Return (`{ [] `})

  1. Else Dangling#9964

Arm 2:

  1. (Let (`{ (pair<typeId, infer>)*{pair<typeId, infer> <- pair<typeId, infer>*} `}) be set<pair<typeId, infer>>)

  2. (Let (typeId_h ':' infer_h) :: ((typeId_t ':' infer_t))*{infer_t <- infer_t*, typeId_t <- typeId_t*} be (pair<typeId, infer>)*{pair<typeId, infer> <- pair<typeId, infer>*}, (pair<typeId, infer>)*{pair<typeId, infer> <- pair<typeId, infer>*} matches pattern _ :: _)

    1. Case analysis on infer_h

      1. Case (let (KNOWN AS typeIR_h) be %, % matches pattern `KNOWN AS %`)

        1. (Let (`{ ((typeId ':' typeIR_t))*{typeIR_t <- typeIR_t*, typeId <- typeId*} `}) be $resolve_constraint(strictness, (`{ ((typeId_t ':' infer_t))*{infer_t <- infer_t*, typeId_t <- typeId_t*} `})))

        2. If ((|(typeId_t)*{typeId_t <- typeId_t*}| = |(typeId)*{typeId <- typeId*}|)), then

          1. If ((typeId = typeId_t))*{typeId_t <- typeId_t*, typeId <- typeId*}, then

            1. Return (`{ (typeId_h ':' typeIR_h) :: ((typeId_t ':' typeIR_t))*{typeIR_t <- typeIR_t*, typeId_t <- typeId_t*} `})

          1. Else Dangling#9973

        2. Else Dangling#9972

      2. Case (% matches pattern `UNKNOWN`)

        1. If (($find_map<typeId, strict>(strictness, typeId_h) = ?((LAX)))), then

          1. (Let (`{ ((typeId ':' typeIR_t))*{typeIR_t <- typeIR_t*, typeId <- typeId*} `}) be $resolve_constraint(strictness, (`{ ((typeId_t ':' infer_t))*{infer_t <- infer_t*, typeId_t <- typeId_t*} `})))

          2. If ((|(typeId_t)*{typeId_t <- typeId_t*}| = |(typeId)*{typeId <- typeId*}|)), then

            1. If ((typeId = typeId_t))*{typeId_t <- typeId_t*, typeId <- typeId*}, then

              1. Return (`{ (typeId_h ':' ((BOOL) as typeIR)) :: ((typeId_t ':' typeIR_t))*{typeIR_t <- typeIR_t*, typeId_t <- typeId_t*} `})

            1. Else Dangling#9978

          2. Else Dangling#9977

        1. Else Dangling#9975

def $resolve_type_alias(typeIR)

1. Case analysis on typeIR

  1. Case (let (TYPEDEF nameIR_alias typeIR_alias) be %, % has type typedefTypeIR)

    1. Return $resolve_type_alias(typeIR_alias)

  2. Case (let (EXTERN nameIR_alias `< (typeIR_arg)*{typeIR_arg <- typeIR_arg*} `> _externMethodTypeDefEnv) be %, % has type externObjectTypeIR)

    1. Return (nameIR_alias, (typeIR_arg)*{typeIR_arg <- typeIR_arg*})

  3. Case (let (PACKAGE nameIR_alias `< (typeIR_arg)*{typeIR_arg <- typeIR_arg*} `> `{ (_typeIR)*{_typeIR <- _typeIR*} `}) be %, % has type packageObjectTypeIR)

    1. Return (nameIR_alias, (typeIR_arg)*{typeIR_arg <- typeIR_arg*})

1. Else Dangling#9980

def $instantiable_extern(p, TC, instctxt)

1. Case analysis on p

  1. Case (% matches pattern `GLOBAL`)

    1. Return true

  2. Case (% matches pattern `BLOCK`)

    1. Return true

  3. Case (% matches pattern `LOCAL`)

    1. Return true

def $instantiable_parser(p, TC, instctxt)

1. Case analysis on p

  1. Case (% matches pattern `GLOBAL`)

    1. Return (instctxt = (ANON))

  2. Case (% matches pattern `BLOCK`)

    1. (Let blockKind be TC.BLOCK.KIND)

    2. Return ((blockKind = (PARSER)) \/ (blockKind = (PACKAGE)))

  3. Case (% matches pattern `LOCAL`)

    1. (Let localKind be TC.LOCAL.KIND)

    2. Return (localKind = ((PARSER_STATE) as localKind))

def $instantiable_control(p, TC, instctxt)

1. Case analysis on p

  1. Case (% matches pattern `GLOBAL`)

    1. Return (instctxt = (ANON))

  2. Case (% matches pattern `BLOCK`)

    1. (Let blockKind be TC.BLOCK.KIND)

    2. Return ((blockKind = (CONTROL)) \/ (blockKind = (PACKAGE)))

  3. Case (% matches pattern `LOCAL`)

    1. (Let localKind be TC.LOCAL.KIND)

    2. Return (localKind = ((CONTROL_APPLY_METHOD) as localKind))

def $instantiable_package(p, TC, instctxt)

1. Case analysis on p

  1. Case (% matches pattern `GLOBAL`)

    1. Return true

  2. Case (% matches pattern `BLOCK`)

    1. (Let blockKind be TC.BLOCK.KIND)

    2. Return (blockKind = (PACKAGE))

  3. Case (% matches pattern `LOCAL`)

    1. Return false

def $instantiable_table(p, TC, instctxt)

1. Case analysis on p

  1. Case (% matches pattern `GLOBAL`)

    1. Return false

  2. Case (% matches pattern `BLOCK`)

    1. (Let blockKind be TC.BLOCK.KIND)

    2. Return (blockKind = (CONTROL))

  3. Case (% matches pattern `LOCAL`)

    1. Return false

def $instantiable(p, TC, instctxt, typeIR)

1. (Let typeIR_unroll be $unroll_typeIR(typeIR))

2. Case analysis on typeIR_unroll

  1. Case (% has type externObjectTypeIR)

    1. Return $instantiable_extern(p, TC, instctxt)

  2. Case (% has type parserObjectTypeIR)

    1. Return $instantiable_parser(p, TC, instctxt)

  3. Case (% has type controlObjectTypeIR)

    1. Return $instantiable_control(p, TC, instctxt)

  4. Case (% has type packageObjectTypeIR)

    1. Return $instantiable_package(p, TC, instctxt)

  5. Case (% has type tableObjectTypeIR)

    1. Return $instantiable_table(p, TC, instctxt)

2. Else Dangling#10014

def $callable_action(p, TC)

1. Case analysis on p

  1. Case (% matches pattern `GLOBAL`)

    1. Return false

  2. Case (% matches pattern `BLOCK`)

    1. Return false

  3. Case (% matches pattern `LOCAL`)

    1. (Let localKind be TC.LOCAL.KIND)

    2. Return ((localKind = ((ACTION) as localKind)) \/ (localKind = ((CONTROL_APPLY_METHOD) as localKind)))

def $callable_definedFunction(p, TC)

1. Case analysis on p

  1. Case (% matches pattern `GLOBAL`)

    1. Return false

  2. Case (% matches pattern `BLOCK`)

    1. (Let blockKind be TC.BLOCK.KIND)

    2. Return ((blockKind = (PARSER)) \/ (blockKind = (CONTROL)))

  3. Case (% matches pattern `LOCAL`)

    1. (Let localKind be TC.LOCAL.KIND)

    2. Return ~(localKind has type externMethodLocalKind)

def $callable_externFunction(p, TC, nameIR)

1. Case analysis on p

  1. Case (% matches pattern `GLOBAL`)

    1. Case analysis on nameIR

      1. Case (% = "verify")

        1. Return false

      2. Case (% =/= "verify")

        1. Return true

  2. Case (% matches pattern `BLOCK`)

    1. Case analysis on nameIR

      1. Case (% = "verify")

        1. (Let blockKind be TC.BLOCK.KIND)

        2. Return (blockKind = (PARSER))

      2. Case (% =/= "verify")

        1. (Let blockKind be TC.BLOCK.KIND)

        2. Return ((blockKind = (PARSER)) \/ (blockKind = (CONTROL)))

  3. Case (% matches pattern `LOCAL`)

    1. Case analysis on nameIR

      1. Case (% = "verify")

        1. (Let localKind be TC.LOCAL.KIND)

        2. Return (localKind = ((PARSER_STATE) as localKind))

      2. Case (% =/= "verify")

        1. Return true

def $callable_externMethod(p, TC)

1. Case analysis on p

  1. Case (% matches pattern `GLOBAL`)

    1. Return false

  2. Case (% matches pattern `BLOCK`)

    1. (Let blockKind be TC.BLOCK.KIND)

    2. Return ((blockKind = (PARSER)) \/ (blockKind = (CONTROL)))

  3. Case (% matches pattern `LOCAL`)

    1. Return true

