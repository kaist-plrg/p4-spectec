relation VarDecl_eval: p EC_0 ARCH |- (annotationList typeIR nameIR (initializerIR)?{initializerIR <- initializerIR?} ';') : % % %

1. Group : p EC_0 ARCH |- (annotationList typeIR nameIR (initializerIR)?{initializerIR <- initializerIR?} ';') : % % %

  1. Case analysis on (initializerIR)?{initializerIR <- initializerIR?}

    1. Case (% matches pattern ())

