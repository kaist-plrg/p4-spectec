syntax ctk = 
   | LCTK (from ctk) 
   | CTK (from ctk) 
   | DYN (from ctk) 

def $join_ctk(ctk, ctk')

1. Case analysis on ctk

  1. Case (% matches pattern `LCTK`)

    1. Case analysis on ctk'

      1. Case (% matches pattern `LCTK`)

        1. Return (LCTK)

      2. Case (% matches pattern `CTK`)

        1. Return (CTK)

  2. Case (% matches pattern `CTK`)

    1. Case analysis on ctk'

      1. Case (% matches pattern `LCTK`)

        1. Return (CTK)

      2. Case (% matches pattern `CTK`)

        1. Return (CTK)

2. Otherwise,

  1. Return (DYN)

def $joins_ctk((ctk')*{ctk' <- ctk'*})

1. Case analysis on (ctk')*{ctk' <- ctk'*}

  1. Case (% matches pattern [])

    1. Return (LCTK)

  2. Case (let [ctk] be %, % matches pattern [ _/1 ])

    1. Return ctk

  3. Case (let ctk_a :: (ctk)*{ctk <- ctk*} be %, % matches pattern _ :: _)

    1. Case analysis on (ctk)*{ctk <- ctk*}

      1. Case (let [ctk_b] be %, % matches pattern [ _/1 ])

        1. Return $join_ctk(ctk_a, ctk_b)

      2. Case (let ctk_b :: (ctk_c)*{ctk_c <- ctk_c*} be %, % matches pattern _ :: _)

        1. If (((ctk_c)*{ctk_c <- ctk_c*} matches pattern _ :: _)), then

          1. (Let ctk_d be $join_ctk(ctk_a, ctk_b))

          2. Return $joins_ctk(ctk_d :: (ctk_c)*{ctk_c <- ctk_c*})

        1. Else Dangling#1527

    1. Else Dangling#1523

1. Else Dangling#1518

