syntax baseType = 
   | BOOL (from baseType) 
   | ERROR (from baseType) 
   | MATCH_KIND (from baseType) 
   | STRING (from baseType) 
   | INT (from baseType) 
   | INT `< int `> (from baseType) 
   | INT `< `( expression `) `> (from baseType) 
   | BIT (from baseType) 
   | BIT `< int `> (from baseType) 
   | BIT `< `( expression `) `> (from baseType) 
   | VARBIT `< int `> (from baseType) 
   | VARBIT `< `( expression `) `> (from baseType) 

syntax specializedType = 
   | prefixedTypeName `< typeArgumentList `> (from specializedType) 

syntax namedType = 
   | _TID text (from typeIdentifier) 
   | _TID '.' typeName (from prefixedTypeName) 
   | prefixedTypeName `< typeArgumentList `> (from specializedType) 

syntax arrayType = 
   | type `[ expression `] (from arrayType) 

syntax listType = 
   | LIST `< typeArgument `> (from listType) 

syntax tupleType = 
   | TUPLE `< typeArgumentList `> (from tupleType) 

syntax type = 
   | BOOL (from baseType) 
   | ERROR (from baseType) 
   | MATCH_KIND (from baseType) 
   | STRING (from baseType) 
   | INT (from baseType) 
   | INT `< int `> (from baseType) 
   | INT `< `( expression `) `> (from baseType) 
   | BIT (from baseType) 
   | BIT `< int `> (from baseType) 
   | BIT `< `( expression `) `> (from baseType) 
   | VARBIT `< int `> (from baseType) 
   | VARBIT `< `( expression `) `> (from baseType) 
   | _TID text (from typeIdentifier) 
   | _TID '.' typeName (from prefixedTypeName) 
   | prefixedTypeName `< typeArgumentList `> (from specializedType) 
   | type `[ expression `] (from arrayType) 
   | LIST `< typeArgument `> (from listType) 
   | TUPLE `< typeArgumentList `> (from tupleType) 

syntax typeOrVoid = 
   | BOOL (from baseType) 
   | ERROR (from baseType) 
   | MATCH_KIND (from baseType) 
   | STRING (from baseType) 
   | INT (from baseType) 
   | INT `< int `> (from baseType) 
   | INT `< `( expression `) `> (from baseType) 
   | BIT (from baseType) 
