def $lift_nameIR_as_identifier(nameIR)

1. Return (_ID nameIR)

def $lift_nameIR_as_typeIdentifier(nameIR)

1. Return (_TID nameIR)

def $lift_nameIR_as_nonTypeName(t)

1. Case analysis on t

  1. Case (% = "apply")

    1. Return (APPLY)

  2. Case (% = "key")

    1. Return (KEY)

  3. Case (% = "actions")

    1. Return (ACTIONS)

  4. Case (% = "state")

    1. Return (STATE)

  5. Case (% = "entries")

    1. Return (ENTRIES)

  6. Case (% = "type")

    1. Return (TYPE)

  7. Case (% = "priority")

    1. Return (PRIORITY)

2. Otherwise,

  1. Return ((_ID t) as nonTypeName)

def $lift_prefixedNameIR_as_prefixedNonTypeName(prefixedNameIR)

1. Case analysis on prefixedNameIR

  1. Case (let (_BARE nameIR) be %, % matches pattern `_BARE %`)

    1. (Let nonTypeName be $lift_nameIR_as_nonTypeName(nameIR))

    2. Return (nonTypeName as prefixedNonTypeName)

  2. Case (let ('.' nameIR) be %, % matches pattern `. %`)

    1. (Let nonTypeName' be $lift_nameIR_as_nonTypeName(nameIR))

    2. Return (_ID '.' nonTypeName')

def $lift_nameIR_as_typeName(nameIR)

1. Return $lift_nameIR_as_typeIdentifier(nameIR)

def $lift_prefixedNameIR_as_prefixedTypeName(prefixedNameIR)

1. Case analysis on prefixedNameIR

  1. Case (let (_BARE nameIR) be %, % matches pattern `_BARE %`)

    1. (Let typeName be $lift_nameIR_as_typeName(nameIR))

    2. Return (typeName as prefixedTypeName)

  2. Case (let ('.' nameIR) be %, % matches pattern `. %`)

    1. (Let typeName' be $lift_nameIR_as_typeName(nameIR))

    2. Return (_TID '.' typeName')

def $lift_nameIR_as_tableCustomName(t)

1. Case analysis on t

  1. Case (% = "apply")

    1. Return (APPLY)

  2. Case (% = "state")

    1. Return (STATE)

  3. Case (% = "type")

    1. Return (TYPE)

  4. Case (% = "priority")

    1. Return (PRIORITY)

2. Otherwise,

  1. (Let identifier be $lift_nameIR_as_identifier(t))

  2. Return (identifier as tableCustomName)

