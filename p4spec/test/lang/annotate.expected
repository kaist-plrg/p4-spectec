  3. Case (let callStatement be %, % has type callStatement)

    1. Group callStatement: TC |- (callStatement as parserStatement) : % %

      1. (Stmt_ok: (LOCAL) TC |- (callStatement as statement) : TC_1 statementIR)

      2. (Let callStatementIR be statementIR, statementIR has type callStatementIR)

        1. Result in: % |- % : TC_1 (callStatementIR as parserStatementIR)

  4. Case (let directApplicationStatement be %, % has type directApplicationStatement)

    1. Group directApplicationStatement: TC |- (directApplicationStatement as parserStatement) : % %

      1. (Stmt_ok: (LOCAL) TC |- (directApplicationStatement as statement) : TC_1 statementIR)

      2. (Let directApplicationStatementIR be statementIR, statementIR has type directApplicationStatementIR)

        1. Result in: % |- % : TC_1 (directApplicationStatementIR as parserStatementIR)

  5. Case (let parserBlockStatement be %, % has type parserBlockStatement)

    1. Group parserBlockStatement: TC |- (parserBlockStatement as parserStatement) : % %

      1. (Let TC_1 be $enter_t(TC))

      2. (ParserBlock_ok: TC_1 |- parserBlockStatement : TC_2 parserBlockStatementIR)

      3. (Let TC_3 be $exit_t(TC_2))

      4. Result in: % |- % : TC_1 (parserBlockStatementIR as parserStatementIR)

  6. Case (let parserConditionalStatement be %, % has type parserConditionalStatement)

    1. Group parserConditionalStatement: TC |- (parserConditionalStatement as parserStatement) : % %

      1. Case analysis on parserConditionalStatement

        1. Case (let (IF `( expression_cond `) parserStatement_then) be %, % matches pattern `IF (%) %`)

          1. (Expr_ok: (LOCAL) TC |- expression_cond : typedExpressionIR_cond)

          2. (Let typeIR_cond be $type_of_typedExpressionIR(typedExpressionIR_cond))

          3. If ((((BOOL) as typeIR) = $unroll_typeIR(typeIR_cond))), then

            1. (ParserStmt_ok: TC |- parserStatement_then : TC_then parserStatementIR_then)

            2. Result in: % |- % : TC ((IF `( typedExpressionIR_cond `) parserStatementIR_then) as parserStatementIR)

          3. Else Dangling#7488

        2. Case (let (IF `( expression_cond `) parserStatement_then ELSE parserStatement_else) be %, % matches pattern `IF (%) % ELSE %`)

          1. (Expr_ok: (LOCAL) TC |- expression_cond : typedExpressionIR_cond)

          2. (Let typeIR_cond be $type_of_typedExpressionIR(typedExpressionIR_cond))

          3. If ((((BOOL) as typeIR) = $unroll_typeIR(typeIR_cond))), then

            1. (ParserStmt_ok: TC |- parserStatement_then : TC_then parserStatementIR_then)

            2. (ParserStmt_ok: TC |- parserStatement_else : TC_else parserStatementIR_else)

            3. Result in: % |- % : TC ((IF `( typedExpressionIR_cond `) parserStatementIR_then ELSE parserStatementIR_else) as parserStatementIR)

          3. Else Dangling#7494

