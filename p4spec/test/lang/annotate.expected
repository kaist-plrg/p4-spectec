    1. Return ((typeParameterIR_expl)*{typeParameterIR_expl <- typeParameterIR_expl*}, (typeParameterIR_impl)*{typeParameterIR_impl <- typeParameterIR_impl*})

  10. Case (let (PACKAGE _typeId `< (typeParameterIR_expl)*{typeParameterIR_expl <- typeParameterIR_expl*} ',' (typeParameterIR_impl)*{typeParameterIR_impl <- typeParameterIR_impl*} `> `{ (_typeIR)*{_typeIR <- _typeIR*} `}) be %, % has type packageObjectTypeDefIR)

    1. Return ((typeParameterIR_expl)*{typeParameterIR_expl <- typeParameterIR_expl*}, (typeParameterIR_impl)*{typeParameterIR_impl <- typeParameterIR_impl*})

