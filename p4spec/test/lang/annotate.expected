    1. (Let nat''' be $sizeof_maxSizeInBits'(typeIR))*

    2. Return $sum_nat((nat''')*{nat''' <- nat'''*})

  12. Case (let (HEADER _typeId `< (_typeArgumentIR)*{_typeArgumentIR <- _typeArgumentIR*} `> `{ ((_annotationList typeIR _nameIR ';'))*{_annotationList <- _annotationList*, _nameIR <- _nameIR*, typeIR <- typeIR*} `}) be %, % has type headerTypeIR)

    1. (Let nat'''' be $sizeof_maxSizeInBits'(typeIR))*

