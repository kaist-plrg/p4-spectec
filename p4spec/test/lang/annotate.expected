def $write_value_from_bits'(value', n_var, (b)*{b <- b*})

1. Block (2 arms)

Arm 1:

  1. Case analysis on value'

    1. Case (% has type boolValue)

      1. (Let b_h :: (b_t)*{b_t <- b_t*} be (b)*{b <- b*}, (b)*{b <- b*} matches pattern _ :: _)

        1. Return (((_B b_h) as value), (b_t)*{b_t <- b_t*})

    2. Case (let integerLiteral be %, % has type integerLiteral)

      1. Case analysis on integerLiteral

        1. Case (let (w W _i) be %, % matches pattern `% W %`)

          1. If ((|(b)*{b <- b*}| >= w)), then

            1. (Let (b_h)*{b_h <- b_h*} be (b)*{b <- b*}[0 : w])

            2. (Let i' be (|(b)*{b <- b*}| - w))

            3. (Let n_t be i', i' has type nat)

              1. (Let (b_t)*{b_t <- b_t*} be (b)*{b <- b*}[w : n_t])

              2. (Let int be $bits_to_int_unsigned((b_h)*{b_h <- b_h*}))

              3. (Let i be $int_to_bitstr((w as int), int))

              4. Return (((w W i) as value), (b_t)*{b_t <- b_t*})

          1. Else Dangling#503

        2. Case (let (w S _i) be %, % matches pattern `% S %`)

          1. If ((|(b)*{b <- b*}| >= w)), then

            1. (Let (b_h)*{b_h <- b_h*} be (b)*{b <- b*}[0 : w])

            2. (Let i' be (|(b)*{b <- b*}| - w))

            3. (Let n_t be i', i' has type nat)

              1. (Let (b_t)*{b_t <- b_t*} be (b)*{b <- b*}[w : n_t])

              2. (Let int' be $bits_to_int_signed((b_h)*{b_h <- b_h*}))

              3. (Let i be $int_to_bitstr((w as int), int'))

              4. Return (((w S i) as value), (b_t)*{b_t <- b_t*})

          1. Else Dangling#512

      1. Else Dangling#501

    3. Case (let (STRUCT typeId `{ (fieldValue)*{fieldValue <- fieldValue*} `}) be %, % has type structValue)

      1. (Let ((fieldValue_updated)*{fieldValue_updated <- fieldValue_updated*}, (b_rest)*{b_rest <- b_rest*}) be $write_value_fields_from_bits'((fieldValue)*{fieldValue <- fieldValue*}, n_var, (b)*{b <- b*}))

      2. Return (((STRUCT typeId `{ (fieldValue_updated)*{fieldValue_updated <- fieldValue_updated*} `}) as value), (b_rest)*{b_rest <- b_rest*})

    4. Case (let (HEADER typeId `{ _b ';' (fieldValue)*{fieldValue <- fieldValue*} `}) be %, % has type headerValue)

      1. (Let ((fieldValue_updated)*{fieldValue_updated <- fieldValue_updated*}, (b_rest)*{b_rest <- b_rest*}) be $write_value_fields_from_bits'((fieldValue)*{fieldValue <- fieldValue*}, n_var, (b)*{b <- b*}))

      2. Return (((HEADER typeId `{ true ';' (fieldValue_updated)*{fieldValue_updated <- fieldValue_updated*} `}) as value), (b_rest)*{b_rest <- b_rest*})

    5. Case (let enumValue be %, % has type enumValue)

      1. (Let (typeId '.' nameIR '.' value) be enumValue, enumValue matches pattern `% . % . %`)

        1. (Let (value_updated, (b_rest)*{b_rest <- b_rest*}) be $write_value_from_bits'(value, n_var, (b)*{b <- b*}))

        2. Return (((typeId '.' "__UNSPECIFIED" '.' value_updated) as value), (b_rest)*{b_rest <- b_rest*})

    6. Case (let (ARRAY `[ (value)*{value <- value*} `]) be %, % has type arrayValue)

      1. (Let ((value_updated)*{value_updated <- value_updated*}, (b_rest)*{b_rest <- b_rest*}) be $write_values_from_bits'((value)*{value <- value*}, n_var, (b)*{b <- b*}))

      2. Return (((ARRAY `[ (value_updated)*{value_updated <- value_updated*} `]) as value), (b_rest)*{b_rest <- b_rest*})

    7. Case (let (HEADER_STACK `[ (value)*{value <- value*} `( n_idx `) `]) be %, % has type headerStackValue)

      1. (Let ((value_updated)*{value_updated <- value_updated*}, (b_rest)*{b_rest <- b_rest*}) be $write_values_from_bits'((value)*{value <- value*}, n_var, (b)*{b <- b*}))

      2. Return (((HEADER_STACK `[ (value_updated)*{value_updated <- value_updated*} `( n_idx `) `]) as value), (b_rest)*{b_rest <- b_rest*})

  1. Else Dangling#496

Arm 2:

  1. (Let integerValue be value', value' has type integerValue)

    1. (Let (n_max '.' _nat V i) be integerValue, integerValue matches pattern `% . % V %`)

      1. Case analysis on n_var

        1. Case (% = 0)

          1. Return (((n_max '.' 0 V i) as value), (b)*{b <- b*})

        2. Case (% =/= 0)

          1. If ((|(b)*{b <- b*}| >= n_var)), then

            1. (Let (b_h)*{b_h <- b_h*} be (b)*{b <- b*}[0 : n_var])

            2. (Let i' be (|(b)*{b <- b*}| - n_var))

            3. (Let n_t be i', i' has type nat)

              1. (Let (b_t)*{b_t <- b_t*} be (b)*{b <- b*}[n_var : n_t])

              2. (Let int'' be $bits_to_int_signed((b_h)*{b_h <- b_h*}))

              3. (Let i' be $int_to_bitstr((n_var as int), int''))

              4. Return (((n_max '.' n_var V i') as value), (b_t)*{b_t <- b_t*})

          1. Else Dangling#543

