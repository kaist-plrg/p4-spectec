def $lift_controlDeclarationIR((annotationList CONTROL nameIR `< (typeParameterIR_expl)*{typeParameterIR_expl <- typeParameterIR_expl*} ',' (typeParameterIR_impl)*{typeParameterIR_impl <- typeParameterIR_impl*} `> `( (parameterIR)*{parameterIR <- parameterIR*} `) `( (constructorParameterIR)*{constructorParameterIR <- constructorParameterIR*} `) `{ (controlLocalDeclarationIR)*{controlLocalDeclarationIR <- controlLocalDeclarationIR*} APPLY controlBodyIR `}))

1. (Let nonTypeName be $lift_nameIR_as_nonTypeName(nameIR))

2. (Let name be (nonTypeName as name))

3. (Let (typeParameterIR)*{typeParameterIR <- typeParameterIR*} be (typeParameterIR_expl)*{typeParameterIR_expl <- typeParameterIR_expl*} ++ (typeParameterIR_impl)*{typeParameterIR_impl <- typeParameterIR_impl*})

4. (Let typeParameterListOpt be $lift_typeParameterListIR((typeParameterIR)*{typeParameterIR <- typeParameterIR*}))

5. (Let parameterList be $lift_parameterListIR((parameterIR)*{parameterIR <- parameterIR*}))

6. (Let constructorParameterListOpt be $lift_constructorParameterListIR((constructorParameterIR)*{constructorParameterIR <- constructorParameterIR*}))

7. (Let controlLocalDeclarationList be $lift_controlLocalDeclarationListIR((controlLocalDeclarationIR)*{controlLocalDeclarationIR <- controlLocalDeclarationIR*}))

8. (Let controlBody be $lift_controlBodyIR(controlBodyIR))

9. Return (annotationList CONTROL name typeParameterListOpt `( parameterList `) constructorParameterListOpt `{ controlLocalDeclarationList APPLY controlBody `})

def $lift_packageTypeDeclarationIR((annotationList PACKAGE nameIR `< (typeParameterIR_expl)*{typeParameterIR_expl <- typeParameterIR_expl*} ',' (typeParameterIR_impl)*{typeParameterIR_impl <- typeParameterIR_impl*} `> `( (parameterIR)*{parameterIR <- parameterIR*} `) ';'))

1. (Let nonTypeName be $lift_nameIR_as_nonTypeName(nameIR))

2. (Let name be (nonTypeName as name))

3. (Let (typeParameterIR)*{typeParameterIR <- typeParameterIR*} be (typeParameterIR_expl)*{typeParameterIR_expl <- typeParameterIR_expl*} ++ (typeParameterIR_impl)*{typeParameterIR_impl <- typeParameterIR_impl*})

4. (Let typeParameterListOpt be $lift_typeParameterListIR((typeParameterIR)*{typeParameterIR <- typeParameterIR*}))

5. (Let parameterList be $lift_parameterListIR((parameterIR)*{parameterIR <- parameterIR*}))

6. Return (annotationList PACKAGE name typeParameterListOpt `( parameterList `) ';')

def $lift_typeDeclarationIR(typeDeclarationIR)

1. Case analysis on typeDeclarationIR

  1. Case (let derivedTypeDeclarationIR be %, % has type derivedTypeDeclarationIR)

    1. (Let derivedTypeDeclaration be $lift_derivedTypeDeclarationIR(derivedTypeDeclarationIR))

    2. Return (derivedTypeDeclaration as typeDeclaration)

  2. Case (let typedefDeclarationIR be %, % has type typedefDeclarationIR)

    1. (Let typedefDeclaration be $lift_typedefDeclarationIR(typedefDeclarationIR))

    2. Return (typedefDeclaration as typeDeclaration)

  3. Case (let parserTypeDeclarationIR be %, % has type parserTypeDeclarationIR)

    1. (Let parserTypeDeclaration be $lift_parserTypeDeclarationIR(parserTypeDeclarationIR))

    2. Return (parserTypeDeclaration as typeDeclaration)

  4. Case (let controlTypeDeclarationIR be %, % has type controlTypeDeclarationIR)

    1. (Let controlTypeDeclaration be $lift_controlTypeDeclarationIR(controlTypeDeclarationIR))

    2. Return (controlTypeDeclaration as typeDeclaration)

  5. Case (let packageTypeDeclarationIR be %, % has type packageTypeDeclarationIR)

    1. (Let packageTypeDeclaration be $lift_packageTypeDeclarationIR(packageTypeDeclarationIR))

    2. Return (packageTypeDeclaration as typeDeclaration)

def $lift_declarationIR(declarationIR)

1. Case analysis on declarationIR

  1. Case (let constantDeclarationIR be %, % has type constantDeclarationIR)

    1. (Let constantDeclaration be $lift_constantDeclarationIR(constantDeclarationIR))

    2. Return (constantDeclaration as declaration)

  2. Case (let instantiationIR be %, % has type instantiationIR)

    1. (Let instantiation be $lift_instantiationIR(instantiationIR))

    2. Return (instantiation as declaration)

  3. Case (let functionDeclarationIR be %, % has type functionDeclarationIR)

    1. (Let functionDeclaration be $lift_functionDeclarationIR(functionDeclarationIR))

    2. Return (functionDeclaration as declaration)

  4. Case (let actionDeclarationIR be %, % has type actionDeclarationIR)

    1. (Let actionDeclaration be $lift_actionDeclarationIR(actionDeclarationIR))

    2. Return (actionDeclaration as declaration)

  5. Case (let errorDeclarationIR be %, % has type errorDeclarationIR)

    1. (Let errorDeclaration be $lift_errorDeclarationIR(errorDeclarationIR))

    2. Return (errorDeclaration as declaration)

  6. Case (let matchKindDeclarationIR be %, % has type matchKindDeclarationIR)

    1. (Let matchKindDeclaration be $lift_matchKindDeclarationIR(matchKindDeclarationIR))

    2. Return (matchKindDeclaration as declaration)

  7. Case (let externDeclarationIR be %, % has type externDeclarationIR)

    1. (Let externDeclaration be $lift_externDeclarationIR(externDeclarationIR))

    2. Return (externDeclaration as declaration)

  8. Case (let parserDeclarationIR be %, % has type parserDeclarationIR)

    1. (Let parserDeclaration be $lift_parserDeclarationIR(parserDeclarationIR))

    2. Return (parserDeclaration as declaration)

  9. Case (let controlDeclarationIR be %, % has type controlDeclarationIR)

    1. (Let controlDeclaration be $lift_controlDeclarationIR(controlDeclarationIR))

    2. Return (controlDeclaration as declaration)

  10. Case (let typeDeclarationIR be %, % has type typeDeclarationIR)

    1. (Let typeDeclaration be $lift_typeDeclarationIR(typeDeclarationIR))

    2. Return (typeDeclaration as declaration)

2. Otherwise,

  1. Debug: declarationIR

  2. Return $sink<declaration>

def $lift_p4programIR(((declarationIR)*{declarationIR <- declarationIR*} ';'))

1. (Let declaration be $lift_declarationIR(declarationIR))*

2. Return $unflatten_p4program((declaration)*{declaration <- declaration*})

def $unflatten_p4program((declaration)*{declaration <- declaration*})

1. Return $unflatten_p4program'((_EMPTY), (declaration)*{declaration <- declaration*})

def $unflatten_p4program'(p4program, (declaration)*{declaration <- declaration*})

1. Case analysis on (declaration)*{declaration <- declaration*}

  1. Case (% matches pattern [])

    1. Return p4program

  2. Case (let declaration_h :: (declaration_t)*{declaration_t <- declaration_t*} be %, % matches pattern _ :: _)

    1. Return $unflatten_p4program'((p4program declaration_h), (declaration_t)*{declaration_t <- declaration_t*})

syntax flow = 
   | CONT (from flow) 
   | RET (from flow) 

var f : flow

def $join_flow(f, f')

1. If ((f matches pattern `RET`)), then

  1. If ((f' matches pattern `RET`)), then

    1. Return (RET)

2. Otherwise,

  1. Return (CONT)

syntax loop = 
   | IN (from loop) 
   | OUT (from loop) 

var l : loop

syntax varTypeIR = 
   | direction typeIR ctk value? (from varTypeIR)  hint(prose_fields "direction" "type" "compile-time known-ness" "default value")

syntax typeFrame = map<id, varTypeIR>

def $empty_typeFrame

1. Return $empty_map<id, varTypeIR>

syntax typeDefEnv = map<typeId, typeDefIR>

def $empty_typeDefEnv

1. Return $empty_map<typeId, typeDefIR>

syntax callableTypeDefEnv = map<callableId, callableTypeDefIR>

def $empty_callableTypeDefEnv

1. Return $empty_map<callableId, callableTypeDefIR>

syntax constructorTypeDefEnv = map<constructorId, constructorTypeDefIR>

def $empty_constructorTypeDefEnv

1. Return $empty_map<constructorId, constructorTypeDefIR>

syntax globalTypingLayer = {CONSTRUCTOR constructorTypeDefEnv, TYPE typeDefEnv, CALLABLE callableTypeDefEnv, FRAME typeFrame}

syntax blockKind = 
   | _EMPTY (from blockKind) 
   | EXTERN (from blockKind) 
   | PARSER (from blockKind) 
   | CONTROL (from blockKind) 
   | PACKAGE (from blockKind) 

syntax blockTypingLayer = {KIND blockKind, TYPE typeDefEnv, CALLABLE callableTypeDefEnv, FRAME typeFrame}

syntax actionLocalKind = 
   | ACTION (from actionLocalKind) 

syntax definedFunctionLocalKind = 
   | FUNCTION ':' typeIR (from definedFunctionLocalKind) 

syntax externFunctionLocalKind = 
   | EXTERN_FUNCTION ':' typeIR (from externFunctionLocalKind) 

syntax functionLocalKind = 
   | FUNCTION ':' typeIR (from definedFunctionLocalKind) 
   | EXTERN_FUNCTION ':' typeIR (from externFunctionLocalKind) 

syntax externMethodLocalKind = 
   | EXTERN_METHOD ':' typeIR (from externMethodLocalKind) 
   | EXTERN_METHOD ABSTRACT ':' typeIR (from externMethodLocalKind) 

syntax methodLocalKind = 
   | EXTERN_METHOD ':' typeIR (from externMethodLocalKind) 
   | EXTERN_METHOD ABSTRACT ':' typeIR (from externMethodLocalKind) 
   | PARSER_STATE (from methodLocalKind) 
   | CONTROL_APPLY_METHOD (from methodLocalKind) 
   | TABLE_APPLY_METHOD (from methodLocalKind) 

syntax localKind = 
   | _EMPTY (from localKind) 
   | ACTION (from actionLocalKind) 
   | FUNCTION ':' typeIR (from definedFunctionLocalKind) 
   | EXTERN_FUNCTION ':' typeIR (from externFunctionLocalKind) 
   | EXTERN_METHOD ':' typeIR (from externMethodLocalKind) 
   | EXTERN_METHOD ABSTRACT ':' typeIR (from externMethodLocalKind) 
   | PARSER_STATE (from methodLocalKind) 
   | CONTROL_APPLY_METHOD (from methodLocalKind) 
   | TABLE_APPLY_METHOD (from methodLocalKind) 

syntax localTypingLayer = {KIND localKind, TYPE typeDefEnv, FRAMES typeFrame*}

syntax typingContext = {CONTROL flow, LOOP loop, GLOBAL globalTypingLayer, BLOCK blockTypingLayer, LOCAL localTypingLayer}

var TC : typingContext

def $empty_typingContext

1. (Let globalTypingLayer be {CONSTRUCTOR $empty_constructorTypeDefEnv, TYPE $empty_typeDefEnv, CALLABLE $empty_callableTypeDefEnv, FRAME $empty_typeFrame})

2. (Let blockTypingLayer be {KIND (_EMPTY), TYPE $empty_typeDefEnv, CALLABLE $empty_callableTypeDefEnv, FRAME $empty_typeFrame})

3. (Let localTypingLayer be {KIND (_EMPTY), TYPE $empty_typeDefEnv, FRAMES [$empty_typeFrame]})

4. (Let TC be {CONTROL (CONT), LOOP (OUT), GLOBAL globalTypingLayer, BLOCK blockTypingLayer, LOCAL localTypingLayer})

5. Return TC

def $bound(p, TC)

1. Case analysis on p

  1. Case (% matches pattern `GLOBAL`)

    1. Return (`{ [] `})

  2. Case (% matches pattern `BLOCK`)

    1. Return $dom_map<typeId, typeDefIR>(TC.BLOCK.TYPE)

  3. Case (% matches pattern `LOCAL`)

    1. (Let B_block be $bound((BLOCK), TC))

    2. (Let B_local be $dom_map<typeId, typeDefIR>(TC.LOCAL.TYPE))

    3. Return $union_set<typeId>(B_block, B_local)

def $enter_t(TC)

1. Return TC[LOCAL.FRAMES = $empty_typeFrame :: TC.LOCAL.FRAMES]

def $exit_t(TC)

1. (Let (typeFrame)*{typeFrame <- typeFrame*} be TC.LOCAL.FRAMES)

2. (Let typeFrame_h :: (typeFrame_t)*{typeFrame_t <- typeFrame_t*} be (typeFrame)*{typeFrame <- typeFrame*}, (typeFrame)*{typeFrame <- typeFrame*} matches pattern _ :: _)

  1. Return TC[LOCAL.FRAMES = (typeFrame_t)*{typeFrame_t <- typeFrame_t*}]

def $join_control_t(TC_a, TC_b)

1. Return $join_flow(TC_a.CONTROL, TC_b.CONTROL)

def $set_control_t(TC, flow)

1. Return TC[CONTROL = flow]

def $enter_loop_t(TC)

1. Return TC[LOOP = (IN)]

def $set_loop_t(TC, loop)

1. Return TC[LOOP = loop]

def $add_var_t(p, TC, id, varTypeIR)

1. Case analysis on p

  1. Case (% matches pattern `GLOBAL`)

    1. (Let typeFrame be TC.GLOBAL.FRAME)

    2. If (~$in_set<id>(id, $dom_map<id, varTypeIR>(typeFrame))), then

      1. (Destruct (_direction, typeIR, _ctk, (_value)?{_value <- _value?}) = varTypeIR)

      2. (Let typeIR_unroll be $unroll_typeIR(typeIR))

      3. If (((id = "main") => (typeIR_unroll has type packageObjectTypeIR))), then

        1. (Let typeFrame_update be $add_map<nameIR, varTypeIR>(typeFrame, id, varTypeIR))

        2. (Let TC' be TC[GLOBAL.FRAME = typeFrame_update])

        3. Return TC'

      3. Else Dangling#4263

    2. Else Dangling#4260

  2. Case (% matches pattern `BLOCK`)

    1. (Let typeFrame be TC.BLOCK.FRAME)

    2. If (~$in_set<id>(id, $dom_map<id, varTypeIR>(typeFrame))), then

      1. If ((id =/= "main")), then

        1. (Let typeFrame_update be $add_map<nameIR, varTypeIR>(TC.BLOCK.FRAME, id, varTypeIR))

        2. (Let TC' be TC[BLOCK.FRAME = typeFrame_update])

        3. Return TC'

      1. Else Dangling#4269

    2. Else Dangling#4268

  3. Case (% matches pattern `LOCAL`)

    1. (Let (typeFrame')*{typeFrame' <- typeFrame'*} be TC.LOCAL.FRAMES)

    2. (Let typeFrame_h :: (typeFrame_t)*{typeFrame_t <- typeFrame_t*} be (typeFrame')*{typeFrame' <- typeFrame'*}, (typeFrame')*{typeFrame' <- typeFrame'*} matches pattern _ :: _)

      1. If (~$in_set<id>(id, $dom_map<id, varTypeIR>(typeFrame_h))), then

        1. If ((id =/= "main")), then

          1. (Let typeFrame_h_update be $add_map<id, varTypeIR>(typeFrame_h, id, varTypeIR))

          2. (Let (typeFrame)*{typeFrame <- typeFrame*} be typeFrame_h_update :: (typeFrame_t)*{typeFrame_t <- typeFrame_t*})

          3. (Let TC' be TC[LOCAL.FRAMES = (typeFrame)*{typeFrame <- typeFrame*}])

          4. Return TC'

        1. Else Dangling#4277

      1. Else Dangling#4276

def $add_vars_t(p, TC, (id)*{id <- id*}, (varTypeIR)*{varTypeIR <- varTypeIR*})

1. Case analysis on (id)*{id <- id*}

  1. Case (% matches pattern [])

    1. If (((varTypeIR)*{varTypeIR <- varTypeIR*} matches pattern [])), then

      1. Return TC

    1. Else Dangling#4283

  2. Case (let id_h :: (id_t)*{id_t <- id_t*} be %, % matches pattern _ :: _)

    1. (Let varTypeIR_h :: (varTypeIR_t)*{varTypeIR_t <- varTypeIR_t*} be (varTypeIR)*{varTypeIR <- varTypeIR*}, (varTypeIR)*{varTypeIR <- varTypeIR*} matches pattern _ :: _)

      1. (Let TC' be $add_var_t(p, TC, id_h, varTypeIR_h))

      2. (Let TC'' be $add_vars_t(p, TC', (id_t)*{id_t <- id_t*}, (varTypeIR_t)*{varTypeIR_t <- varTypeIR_t*}))

      3. Return TC''

def $add_parameter_t(cursor, TC, (_annotationList direction typeIR id _parameterInitializerOptIR))

1. Case analysis on (direction matches pattern `/* empty */`)

  1. Case true

    1. (Let varTypeIR be ((_EMPTY) typeIR (CTK) ?()))

    2. (Let TC' be $add_var_t(cursor, TC, id, varTypeIR))

    3. Return TC'

  2. Case false

    1. (Let varTypeIR be (direction typeIR (DYN) ?()))

    2. (Let TC' be $add_var_t(cursor, TC, id, varTypeIR))

    3. Return TC'

