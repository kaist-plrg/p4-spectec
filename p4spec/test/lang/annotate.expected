def $match_keysets((setValue')*{setValue' <- setValue'*}, (value)*{value <- value*})

1. Block (2 arms)

Arm 1:

  1. Case analysis on (setValue')*{setValue' <- setValue'*}

    1. Case (% matches pattern [])

      1. If (((value)*{value <- value*} matches pattern [])), then

        1. Return true

      1. Else Dangling#13145

    2. Case (let [setValue] be %, % matches pattern [ _/1 ])

      1. (Let [value_key] be (value)*{value <- value*}, (value)*{value <- value*} matches pattern [ _/1 ])

        1. If (~(setValue matches pattern `SET {...}`)), then

          1. Return $match_keyset(setValue, value_key)

        1. Else Dangling#13150

    3. Case (let setValue_h :: (setValue_t)*{setValue_t <- setValue_t*} be %, % matches pattern _ :: _)

      1. (Let value_key_h :: (value_key_t)*{value_key_t <- value_key_t*} be (value)*{value <- value*}, (value)*{value <- value*} matches pattern _ :: _)

        1. If (((setValue_t)*{setValue_t <- setValue_t*} matches pattern _ :: _)), then

          1. If (((value_key_t)*{value_key_t <- value_key_t*} matches pattern _ :: _)), then

            1. Case analysis on $match_keyset(setValue_h, value_key_h)

              1. Case true

                1. Return $match_keysets((setValue_t)*{setValue_t <- setValue_t*}, (value_key_t)*{value_key_t <- value_key_t*})

              2. Case false

                1. Return false

          1. Else Dangling#13156

        1. Else Dangling#13155

  1. Else Dangling#13144

Arm 2:

  1. If (((setValue')*{setValue' <- setValue'*} = [(SET `{ '...' `})])), then

    1. Return true

  1. Else Dangling#13160

def $match_keyset(setValue, value_key)

1. Case analysis on setValue

  1. Case (% matches pattern `SET {...}`)

    1. Return true

  2. Case (let (SET `{ value `}) be %, % matches pattern `SET {%}`)

    1. Return $bin_eq(value, value_key)

  3. Case (let (SET `{ (value)*{value <- value*} `( _nat `) `}) be %, % matches pattern `SET {% (%)}`)

    1. (Let bool be $bin_eq(value, value_key))*

    2. Return $exists_((bool)*{bool <- bool*})

  4. Case (let (SET `{ value_base '&&&' value_mask `}) be %, % matches pattern `SET {% &&& %}`)

    1. (Let value' be $bin_band(value_base, value_mask))

    2. (Let value'' be $bin_band(value_key, value_mask))

    3. Return $bin_eq(value', value'')

  5. Case (let (SET `{ value_base '..' value_limit `}) be %, % matches pattern `SET {% .. %}`)

    1. (Let bool' be $bin_le(value_base, value_key))

    2. (Let bool'' be $bin_le(value_key, value_limit))

    3. Return (bool' /\ bool'')

