def $free_callableTypeIR(callableTypeIR)

1. Case analysis on callableTypeIR

  1. Case (let (_annotationList ACTION _nameIR `( (parameterIR)*{parameterIR <- parameterIR*} `)) be %, % has type actionTypeIR)

    1. (Let bound be $free_parameterIR(parameterIR))*

