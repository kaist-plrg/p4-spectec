      2. Case (let (annotationList TYPE typeIR nameIR ';') be %, % matches pattern `% TYPE % % ;`)

        1. Group typedefDeclarationIR-newtype: IC_0 STO |- ((annotationList TYPE typeIR nameIR ';') as declarationIR) : % %

