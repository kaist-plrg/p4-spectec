relation ConstDecl_inst: p IC_0 |- (annotationList CONST typeIR nameIR ('=' _VALUE value) ';') : %

1. Group : p IC_0 |- (annotationList CONST typeIR nameIR ('=' _VALUE value) ';') : %

  1. (Let IC_1 be $add_var_i(p, IC_0, nameIR, value))

  2. Result in: % % |- % : IC_1

relation InstDecl_inst: p IC_0 STO_0 |- (annotationList typeIR constructorTargetIR `( argumentListIR `) nameIR objectInitializerOptIR ';') : % % %

1. Group : p IC_0 STO_0 |- (annotationList typeIR constructorTargetIR `( argumentListIR `) nameIR objectInitializerOptIR ';') : % % %

  1. (Let (prefixedNameIR `< typeArgumentListIR `>) be constructorTargetIR)

  2. (Constructor_inst: p IC_0 |- prefixedNameIR `< typeArgumentListIR `> `( argumentListIR `) : constructorDef `< typeArgumentListIR_inst `> `( '#' (id_default)*{id_default <- id_default*} '#' (id_optional)*{id_optional <- id_optional*} `))

  3. Block (2 arms)

  Arm 1:

    1. (Let IC_inner be $enter_path_i(IC_0, nameIR))

    2. (Constructor_call: p IC_inner STO_0 |- constructorDef `< typeArgumentListIR_inst `> `( argumentListIR '#' (id_default)*{id_default <- id_default*} '#' (id_optional)*{id_optional <- id_optional*} `) : STO_1 object)

    3. (Let (EXTERN typeId `< theta `> `{ objectState frame externMethodDefEnv `}) be object, object has type externObject)

      1. (Let IC_decl be $inherit_i((GLOBAL), IC_0))

      2. (Let objectDeclarationListIR be $flatten_objectInitializerOptIR(objectInitializerOptIR))

      3. (ObjectDecls_inst: IC_decl STO_1 |- objectDeclarationListIR : IC_decl_post STO_2)

      4. (Let frame_merged be $merge_frames(frame, IC_decl_post.BLOCK.FRAME))

      5. (Let externMethodDefEnv_merged be $merge_externMethodDefEnvs(externMethodDefEnv, IC_decl_post.BLOCK.CALLABLE))

      6. (Let object_merged be ((EXTERN typeId `< theta `> `{ objectState frame_merged externMethodDefEnv_merged `}) as object))

      7. (Let objectId be IC_0.PATH ++ [nameIR])

      8. (Let STO_3 be $add_store(STO_2, objectId, object_merged))

      9. (Let IC_1 be $add_var_i(p, IC_0, nameIR, ((REF objectId) as value)))

      10. (Let constantDeclarationIR be ((_EMPTY) CONST typeIR nameIR ('=' _VALUE ((REF objectId) as value)) ';'))

      11. Result in: % % % |- % : IC_1 STO_3 constantDeclarationIR

  Arm 2:

    1. (Let nameIR' be $name_annotation_default(annotationList, nameIR))

    2. (Let IC_inner be $enter_path_i(IC_0, nameIR'))

    3. (Constructor_call: p IC_inner STO_0 |- constructorDef `< typeArgumentListIR_inst `> `( argumentListIR '#' (id_default)*{id_default <- id_default*} '#' (id_optional)*{id_optional <- id_optional*} `) : STO_1 object)

    4. If (~(object has type externObject)), then

      1. (Let objectId be IC_0.PATH ++ [nameIR])

      2. (Let STO_2 be $add_store(STO_1, objectId, object))

      3. (Let IC_1 be $add_var_i(p, IC_0, nameIR, ((REF objectId) as value)))

      4. (Let constantDeclarationIR be ((_EMPTY) CONST typeIR nameIR ('=' _VALUE ((REF objectId) as value)) ';'))

      5. Result in: % % % |- % : IC_1 STO_2 constantDeclarationIR

    4. Else Dangling#10860

