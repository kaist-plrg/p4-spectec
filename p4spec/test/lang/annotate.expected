      1. If (($match_overloaded_unnamed<V>((callTargetId_h ':' V_h), (nameIR_f `( nat `)), $get_parameterListIR) matches pattern `NOMATCH`)), then

        1. Return $find_overloadeds_unnamed<V>((`{ ((callTargetId_t ':' V_t))*{V_t <- V_t*, callTargetId_t <- callTargetId_t*} `}), (nameIR_f `( nat `)), $get_parameterListIR)

      1. Else Dangling#2961

    Arm 2:

      1. (Let callTargetMatch be $match_overloaded_unnamed<V>((callTargetId_h ':' V_h), (nameIR_f `( nat `)), $get_parameterListIR))

      2. (Let (MATCH (id_default)*{id_default <- id_default*} (id_optional)*{id_optional <- id_optional*}) be callTargetMatch, callTargetMatch matches pattern `MATCH % %`)

        1. (Let (callResolution<V>)*{callResolution<V> <- callResolution<V>*} be $find_overloadeds_unnamed<V>((`{ ((callTargetId_t ':' V_t))*{V_t <- V_t*, callTargetId_t <- callTargetId_t*} `}), (nameIR_f `( nat `)), $get_parameterListIR))

        2. Return (callTargetId_h ':' V_h '#' (id_default)*{id_default <- id_default*} '#' (id_optional)*{id_optional <- id_optional*}) :: (callResolution<V>)*{callResolution<V> <- callResolution<V>*}

def $find_overloaded<V>((`{ ((callableId ':' V))*{V <- V*, callableId <- callableId*} `}), (nameIR_f `( ((id_arg)?{id_arg <- id_arg?})*{id_arg? <- id_arg?*} `)), $get_parameterListIR(V) : parameterListIR)

