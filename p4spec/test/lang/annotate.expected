        5. If (ConstructorTypeDef_wf: B |- constructorTypeDefIR) holds, then

          1. (Let TC_5 be $add_constructorDef_non_overload_t(TC_4, constructorId, constructorTypeDefIR))

          2. (Let packageTypeDeclarationIR be (annotationList PACKAGE nameIR `< (typeId_expl)*{typeId_expl <- typeId_expl*} ',' (typeId_impl)*{typeId_impl <- typeId_impl*} `> `( (constructorParameterIR)*{constructorParameterIR <- constructorParameterIR*} `) ';'))

          3. Result in: % |- % : TC_5 (packageTypeDeclarationIR as declarationIR)

        5. Else Dangling#8296

      8. Else Dangling#8291

relation Decls_ok: TC |- (declaration)*{declaration <- declaration*} : % %

1. Group : TC |- (declaration)*{declaration <- declaration*} : % %

  1. Case analysis on (declaration)*{declaration <- declaration*}

    1. Case (% matches pattern [])

      1. Result in: % |- % : TC []

    2. Case (let declaration_h :: (declaration_t)*{declaration_t <- declaration_t*} be %, % matches pattern _ :: _)

      1. (Decl_ok: TC |- declaration_h : TC_1 declarationIR_h)

      2. (Decls_ok: TC_1 |- (declaration_t)*{declaration_t <- declaration_t*} : TC_2 (declarationIR_t)*{declarationIR_t <- declarationIR_t*})

      3. Result in: % |- % : TC_2 declarationIR_h :: (declarationIR_t)*{declarationIR_t <- declarationIR_t*}

relation Program_ok: |- p4program : %

1. Group : |- p4program : %

  1. (Let (declaration)*{declaration <- declaration*} be $flatten_p4program(p4program))

  2. (Let TC_0 be $empty_typingContext)

  3. (Decls_ok: TC_0 |- (declaration)*{declaration <- declaration*} : TC_1 (declarationIR)*{declarationIR <- declarationIR*})

  4. Result in: |- % : ((declarationIR)*{declarationIR <- declarationIR*} ';')

syntax actctxt = 
   | ACTION (from actctxt) 
   | NOACTION (from actctxt) 

relation Call_convention_expr_ok: p TC actctxt |- (annotationList direction typeIR_param id parameterInitializerOptIR) '@' typedExpressionIR_arg : %

1. Block (3 arms)

Arm 1:

  1. If ((direction matches pattern `IN`)), then

    1. Group in: p TC actctxt |- (annotationList (IN) typeIR_param id parameterInitializerOptIR) '@' typedExpressionIR_arg : %

      1. (Let typedExpressionIR_arg_cast be ! $cast_unary(typedExpressionIR_arg, typeIR_param))

        1. Result in: % % % |- % '@' % : typedExpressionIR_arg_cast

  1. Else Dangling#8312

Arm 2:

  1. Group out-inout: p TC actctxt |- (annotationList direction typeIR_param id parameterInitializerOptIR) '@' typedExpressionIR_arg : %

    1. If (((direction = (OUT)) \/ (direction = (INOUT)))), then

      1. (Let typeIR_arg be $type_of_typedExpressionIR(typedExpressionIR_arg))

      2. If (Type_alpha: typeIR_param ~~ typeIR_arg) holds, then

        1. (Let typedLvalueIR_arg be ! $typedExpressionIR_as_typedLvalueIR(typedExpressionIR_arg))

          1. (Let lvalue_arg be $lift_typedLvalueIR(typedLvalueIR_arg))

          2. (Lvalue_ok: p TC |- lvalue_arg : _typedLvalueIR)

          3. Result in: % % % |- % '@' % : typedExpressionIR_arg

      2. Else Dangling#8321

    1. Else Dangling#8319

Arm 3:

  1. If ((direction matches pattern `/* empty */`)), then

    1. Group directionless: p TC actctxt |- (annotationList (_EMPTY) typeIR_param id parameterInitializerOptIR) '@' typedExpressionIR_arg : %

      1. Case analysis on actctxt

        1. Case (% matches pattern `ACTION`)

          1. (Let typedExpressionIR_arg_cast be ! $cast_unary(typedExpressionIR_arg, typeIR_param))

            1. Result in: % % % |- % '@' % : typedExpressionIR_arg_cast

        2. Case (% matches pattern `NOACTION`)

          1. (Let typedExpressionIR_arg_cast be ! $cast_unary(typedExpressionIR_arg, typeIR_param))

            1. If (~($ctk_of_typedExpressionIR(typedExpressionIR_arg) matches pattern `DYN`)), then

              1. Result in: % % % |- % '@' % : typedExpressionIR_arg_cast

            1. Else Dangling#8338

  1. Else Dangling#8328

relation Call_convention_arg_ok: p TC actctxt |- parameterIR '@' argumentIR : %

1. Group : p TC actctxt |- parameterIR '@' argumentIR : %

  1. Case analysis on argumentIR

    1. Case (let typedExpressionIR be %, % has type typedExpressionIR)

      1. (Call_convention_expr_ok: p TC actctxt |- parameterIR '@' typedExpressionIR : typedExpressionIR_cast)

      2. Result in: % % % |- % '@' % : (typedExpressionIR_cast as argumentIR)

    2. Case (let (nameIR '=' typedExpressionIR) be %, % matches pattern `% = %`)

      1. (Call_convention_expr_ok: p TC actctxt |- parameterIR '@' typedExpressionIR : typedExpressionIR_cast)

      2. Result in: % % % |- % '@' % : (nameIR '=' typedExpressionIR_cast)

    3. Case (let (nameIR '=' '_') be %, % matches pattern `% = _`)

      1. (Destruct (_annotationList, direction, _typeIR, _id, _parameterInitializerOptIR) = parameterIR)

      2. If ((direction matches pattern `OUT`)), then

        1. Result in: % % % |- % '@' % : (nameIR '=' '_')

      2. Else Dangling#8350

    4. Case (% matches pattern `_`)

      1. (Destruct (_annotationList, direction, _typeIR, _id, _parameterInitializerOptIR) = parameterIR)

      2. If ((direction matches pattern `OUT`)), then

        1. Result in: % % % |- % '@' % : ('_')

      2. Else Dangling#8353

relation Call_convention_ok: p TC actctxt |- (parameterIR)*{parameterIR <- parameterIR*} '@' (argumentIR)*{argumentIR <- argumentIR*} : %

1. Group : p TC actctxt |- (parameterIR)*{parameterIR <- parameterIR*} '@' (argumentIR)*{argumentIR <- argumentIR*} : %

  1. Case analysis on (parameterIR)*{parameterIR <- parameterIR*}

    1. Case (% matches pattern [])

      1. If (((argumentIR)*{argumentIR <- argumentIR*} matches pattern [])), then

        1. Result in: % % % |- % '@' % : []

      1. Else Dangling#8357

    2. Case (let parameterIR_h :: (parameterIR_t)*{parameterIR_t <- parameterIR_t*} be %, % matches pattern _ :: _)

      1. (Let argumentIR_h :: (argumentIR_t)*{argumentIR_t <- argumentIR_t*} be (argumentIR)*{argumentIR <- argumentIR*}, (argumentIR)*{argumentIR <- argumentIR*} matches pattern _ :: _)

        1. (Call_convention_arg_ok: p TC actctxt |- parameterIR_h '@' argumentIR_h : argumentIR_h_cast)

        2. (Call_convention_ok: p TC actctxt |- (parameterIR_t)*{parameterIR_t <- parameterIR_t*} '@' (argumentIR_t)*{argumentIR_t <- argumentIR_t*} : (argumentIR_t_cast)*{argumentIR_t_cast <- argumentIR_t_cast*})

        3. Result in: % % % |- % '@' % : argumentIR_h_cast :: (argumentIR_t_cast)*{argumentIR_t_cast <- argumentIR_t_cast*}

def $is_static_callableTypeIR(callableTypeIR)

1. Case analysis on callableTypeIR

  1. Case (let (EXTERN_FUNCTION t `( (_parameterIR)*{_parameterIR <- _parameterIR*} `) ':' _typeIR) be %, % has type externFunctionTypeIR)

    1. If ((t = "static_assert")), then

      1. Return (LCTK)

  2. Case (% has type builtinSizeMethodTypeIR)

    1. Return (LCTK)

2. Otherwise,

  1. Return (DYN)

def $is_static_assert_callableTypeIR(callableTypeIR)

1. (Let (EXTERN_FUNCTION t `( (_parameterIR)*{_parameterIR <- _parameterIR*} `) ':' _typeIR) be callableTypeIR, callableTypeIR has type externFunctionTypeIR)

  1. If ((t = "static_assert")), then

    1. Return true

2. Otherwise,

  1. Return false

relation CallableTarget_ok: p TC |- callableTarget : %

1. Group : p TC |- callableTarget : %

  1. Block (2 arms)

  Arm 1:

    1. Case analysis on callableTarget

      1. Case (let prefixedNonTypeName be %, % has type prefixedNonTypeName)

        1. (Let prefixedNameIR be $prefixedNonTypeName(prefixedNonTypeName))

        2. Result in: % % |- % : (prefixedNameIR as callableTargetIR)

      2. Case (let (memberAccessBase '.' member) be %, % has type memberAccessExpression)

        1. Case analysis on memberAccessBase

          1. Case (let prefixedTypeName be %, % has type prefixedTypeName)

            1. (Let prefixedNameIR be $prefixedTypeName(prefixedTypeName))

            2. (Let nameIR be $name(member))

            3. Result in: % % |- % : (TYPE prefixedNameIR '.' nameIR)

          2. Case (let expression_base be %, % has type expression)

            1. (Let nameIR be $name(member))

            2. (Expr_ok: p TC |- expression_base : typedExpressionIR_base)

            3. Result in: % % |- % : (typedExpressionIR_base '.' nameIR)

      3. Case (let (`( expression `)) be %, % has type parenthesizedExpression)

        1. (CallableTarget_ok: p TC |- expression : callableTargetIR)

        2. Result in: % % |- % : (`( callableTargetIR `))

    1. Else Dangling#8377

  Arm 2:

    1. If ((callableTarget = ((THIS) as expression))), then

      1. Result in: % % |- % : ((_BARE "this") as callableTargetIR)

    1. Else Dangling#8394

relation CallableTarget_lvalue_ok: p TC |- lvalue : %

1. Group : p TC |- lvalue : %

  1. (Let expression be $lvalue_as_expression(lvalue))

  2. (CallableTarget_ok: p TC |- expression : callableTargetIR)

  3. Result in: % % |- % : callableTargetIR

relation CallableType_ok: p TC |- callableTargetIR' `< (typeArgumentIR)*{typeArgumentIR <- typeArgumentIR*} `> `( (argumentIR')*{argumentIR' <- argumentIR'*} `) : % `< '#' % `> `( '#' % '#' % `)

1. Case analysis on callableTargetIR'

  1. Case (let prefixedNameIR be %, % has type prefixedNameIR)

    1. Block (2 arms)

    Arm 1:

      1. If (((typeArgumentIR)*{typeArgumentIR <- typeArgumentIR*} matches pattern [])), then

        1. Group actionTypeIR: p TC |- (prefixedNameIR as callableTargetIR) `< [] `> `( (argumentIR')*{argumentIR' <- argumentIR'*} `) : % `< '#' % `> `( '#' % '#' % `)

          1. (Let (callableId ':' callableTypeDefIR '#' (id_default)*{id_default <- id_default*} '#' (id_optional)*{id_optional <- id_optional*}) be ! $find_callableDef_overloaded_t(p, TC, prefixedNameIR, (argumentIR')*{argumentIR' <- argumentIR'*}))

            1. (Let actionTypeIR be callableTypeDefIR, callableTypeDefIR has type actionTypeIR)

              1. Result in: % % |- % `< % `> `( % `) : (actionTypeIR as callableTypeIR) `< '#' [] `> `( '#' (id_default)*{id_default <- id_default*} '#' (id_optional)*{id_optional <- id_optional*} `)

      1. Else Dangling#8402

    Arm 2:

      1. Group functionTypeIR: p TC |- (prefixedNameIR as callableTargetIR) `< (typeArgumentIR)*{typeArgumentIR <- typeArgumentIR*} `> `( (argumentIR')*{argumentIR' <- argumentIR'*} `) : % `< '#' % `> `( '#' % '#' % `)

        1. (Let (callableId ':' callableTypeDefIR '#' (id_default)*{id_default <- id_default*} '#' (id_optional)*{id_optional <- id_optional*}) be ! $find_callableDef_overloaded_t(p, TC, prefixedNameIR, (argumentIR')*{argumentIR' <- argumentIR'*}))

          1. (Let functionTypeDefIR be callableTypeDefIR, callableTypeDefIR has type functionTypeDefIR)

            1. (Let (callableTypeIR, typeId*) be $specialize_callableTypeDefIR((functionTypeDefIR as callableTypeDefIR), (typeArgumentIR)*{typeArgumentIR <- typeArgumentIR*}))

            2. (Let (functionTypeIR, (typeId_impl)*{typeId_impl <- typeId_impl*}) be (callableTypeIR, typeId*), (callableTypeIR, typeId*) has type (functionTypeIR, typeId*))

              1. Result in: % % |- % `< % `> `( % `) : (functionTypeIR as callableTypeIR) `< '#' (typeId_impl)*{typeId_impl <- typeId_impl*} `> `( '#' (id_default)*{id_default <- id_default*} '#' (id_optional)*{id_optional <- id_optional*} `)

  2. Case (let (typedExpressionIR_base '.' nameIR) be %, % matches pattern `% . %`)

    1. Block (4 arms)

    Arm 1:

      1. If (((typeArgumentIR)*{typeArgumentIR <- typeArgumentIR*} matches pattern [])), then

        1. If (((argumentIR')*{argumentIR' <- argumentIR'*} matches pattern [])), then

          1. Block (2 arms)

          Arm 1:

            1. Group builtinMethodTypeIR-size: p TC |- (typedExpressionIR_base '.' nameIR) `< [] `> `( [] `) : % `< '#' % `> `( '#' % '#' % `)

              1. If (nameIR is in ["minSizeInBits", "minSizeInBytes", "maxSizeInBits", "maxSizeInBytes"]), then

                1. (Let typeIR_base be $type_of_typedExpressionIR(typedExpressionIR_base))

                2. If ($is_serializable_typeIR(typeIR_base)), then

                  1. (Let methodTypeIR be ((BUILTIN_SIZE_OF) as methodTypeIR))

                  2. Result in: % % |- % `< % `> `( % `) : (methodTypeIR as callableTypeIR) `< '#' [] `> `( '#' [] '#' [] `)

                2. Else Dangling#8426

              1. Else Dangling#8424

          Arm 2:

            1. Group builtinMethodTypeIR-header: p TC |- (typedExpressionIR_base '.' nameIR) `< [] `> `( [] `) : % `< '#' % `> `( '#' % '#' % `)

              1. Case analysis on nameIR

                1. Case (% = "isValid")

                  1. (Let typeIR_base be $type_of_typedExpressionIR(typedExpressionIR_base))

                  2. (Let typeIR be $unroll_typeIR(typeIR_base))

                  3. If ((typeIR has type headerTypeIR)), then

                    1. (Let methodTypeIR be ((BUILTIN_IS_VALID) as methodTypeIR))

                    2. Result in: % % |- % `< % `> `( % `) : (methodTypeIR as callableTypeIR) `< '#' [] `> `( '#' [] '#' [] `)

                  3. Else Dangling#8433

                2. Case (% = "setValid")

                  1. (Let typeIR_base be $type_of_typedExpressionIR(typedExpressionIR_base))

                  2. (Let typeIR be $unroll_typeIR(typeIR_base))

                  3. If ((typeIR has type headerTypeIR)), then

                    1. (Let methodTypeIR be ((BUILTIN_SET_VALID) as methodTypeIR))

                    2. Result in: % % |- % `< % `> `( % `) : (methodTypeIR as callableTypeIR) `< '#' [] `> `( '#' [] '#' [] `)

                  3. Else Dangling#8438

                3. Case (% = "setInvalid")

                  1. (Let typeIR_base be $type_of_typedExpressionIR(typedExpressionIR_base))

                  2. (Let typeIR be $unroll_typeIR(typeIR_base))

                  3. If ((typeIR has type headerTypeIR)), then

                    1. (Let methodTypeIR be ((BUILTIN_SET_INVALID) as methodTypeIR))

                    2. Result in: % % |- % `< % `> `( % `) : (methodTypeIR as callableTypeIR) `< '#' [] `> `( '#' [] '#' [] `)

                  3. Else Dangling#8443

              1. Else Dangling#8430

        1. Else Dangling#8422

      1. Else Dangling#8421

    Arm 2:

      1. Case analysis on nameIR

        1. Case (% = "push_front")

          1. If (((typeArgumentIR)*{typeArgumentIR <- typeArgumentIR*} matches pattern [])), then

            1. (Let [argumentIR] be (argumentIR')*{argumentIR' <- argumentIR'*}, (argumentIR')*{argumentIR' <- argumentIR'*} matches pattern [ _/1 ])

              1. Group builtinMethodTypeIR-header-stack-push-front: p TC |- (typedExpressionIR_base '.' "push_front") `< [] `> `( [argumentIR] `) : % `< '#' % `> `( '#' % '#' % `)

                1. (Let typeIR_base be $type_of_typedExpressionIR(typedExpressionIR_base))

                2. (Let typeIR be $unroll_typeIR(typeIR_base))

                3. If ((typeIR has type headerStackTypeIR)), then

                  1. (Let methodTypeIR be ((BUILTIN_PUSH_FRONT) as methodTypeIR))

                  2. Result in: % % |- % `< % `> `( % `) : (methodTypeIR as callableTypeIR) `< '#' [] `> `( '#' [] '#' [] `)

                3. Else Dangling#8453

          1. Else Dangling#8447

        2. Case (% = "pop_front")

          1. If (((typeArgumentIR)*{typeArgumentIR <- typeArgumentIR*} matches pattern [])), then

            1. (Let [argumentIR] be (argumentIR')*{argumentIR' <- argumentIR'*}, (argumentIR')*{argumentIR' <- argumentIR'*} matches pattern [ _/1 ])

              1. Group builtinMethodTypeIR-header-stack-pop-front: p TC |- (typedExpressionIR_base '.' "pop_front") `< [] `> `( [argumentIR] `) : % `< '#' % `> `( '#' % '#' % `)

                1. (Let typeIR_base be $type_of_typedExpressionIR(typedExpressionIR_base))

                2. (Let typeIR be $unroll_typeIR(typeIR_base))

                3. If ((typeIR has type headerStackTypeIR)), then

                  1. (Let methodTypeIR be ((BUILTIN_POP_FRONT) as methodTypeIR))

                  2. Result in: % % |- % `< % `> `( % `) : (methodTypeIR as callableTypeIR) `< '#' [] `> `( '#' [] '#' [] `)

                3. Else Dangling#8462

          1. Else Dangling#8456

        3. Case (% = "isValid")

          1. If (((typeArgumentIR)*{typeArgumentIR <- typeArgumentIR*} matches pattern [])), then

            1. If (((argumentIR')*{argumentIR' <- argumentIR'*} matches pattern [])), then

              1. Group builtinMethodTypeIR-header-union: p TC |- (typedExpressionIR_base '.' "isValid") `< [] `> `( [] `) : % `< '#' % `> `( '#' % '#' % `)

                1. (Let typeIR_base be $type_of_typedExpressionIR(typedExpressionIR_base))

                2. (Let typeIR be $unroll_typeIR(typeIR_base))

                3. If ((typeIR has type headerUnionTypeIR)), then

                  1. (Let methodTypeIR be ((BUILTIN_IS_VALID) as methodTypeIR))

                  2. Result in: % % |- % `< % `> `( % `) : (methodTypeIR as callableTypeIR) `< '#' [] `> `( '#' [] '#' [] `)

                3. Else Dangling#8470

            1. Else Dangling#8466

          1. Else Dangling#8465

      1. Else Dangling#8446

    Arm 3:

      1. Group externMethodTypeIR: p TC |- (typedExpressionIR_base '.' nameIR) `< (typeArgumentIR)*{typeArgumentIR <- typeArgumentIR*} `> `( (argumentIR')*{argumentIR' <- argumentIR'*} `) : % `< '#' % `> `( '#' % '#' % `)

