  5. Case (let parserApplyMethodTypeDefIR be %, % has type parserApplyMethodTypeDefIR)

    1. Return (parserApplyMethodTypeDefIR as callableTypeIR)

  6. Case (let controlApplyMethodTypeDefIR be %, % has type controlApplyMethodTypeDefIR)

