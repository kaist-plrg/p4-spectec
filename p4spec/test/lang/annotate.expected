          2. Result in: % % |- % : EC_2 ARCH_2 parserStatementResult'

relation ParserBlock_eval: EC_0 ARCH_0 |- (annotationList `{ parserBlockElementStatementListIR `}) : % % %

1. Group : EC_0 ARCH_0 |- (annotationList `{ parserBlockElementStatementListIR `}) : % % %

  1. (ParserBlockElementStmtList_eval: EC_0 ARCH_0 |- parserBlockElementStatementListIR : EC_1 ARCH_1 parserStatementResult)

  2. Result in: % % |- % : EC_1 ARCH_1 parserStatementResult

syntax transitionResult = 
   | ACCEPT (from acceptTransitionResult) 
   | REJECT errorValue (from rejectTransitionResult) 
   | STATE id (from stateTransitionResult) 

relation ParserSelect_eval: EC_0 ARCH_0 |- selectExpressionIR : % % %

1. Group : EC_0 ARCH_0 |- selectExpressionIR : % % %

  1. (Let (SELECT `( (typedExpressionIR_key)*{typedExpressionIR_key <- typedExpressionIR_key*} `) `{ selectCaseListIR `}) be selectExpressionIR)

  2. (Exprs_eval: (LOCAL) EC_0 ARCH_0 |- (typedExpressionIR_key)*{typedExpressionIR_key <- typedExpressionIR_key*} : EC_1 ARCH_1 expressionListResult)

  3. Case analysis on expressionListResult

    1. Case (let rejectTransitionResult be %, % has type rejectTransitionResult)

      1. Result in: % % |- % : EC_1 ARCH_1 (rejectTransitionResult as transitionResult)

    2. Case (let (_CONT (value_key)*{value_key <- value_key*}) be %, % has type continueResult<value*>)

      1. (SelectCases_match: EC_1 ARCH_1 (value_key)*{value_key <- value_key*} |- selectCaseListIR : EC_2 ARCH_2 selectCaseMatchResult)

      2. Case analysis on selectCaseMatchResult

        1. Case (let rejectTransitionResult be %, % has type rejectTransitionResult)

          1. Result in: % % |- % : EC_2 ARCH_2 (rejectTransitionResult as transitionResult)

        2. Case (let (_CONT (nameIR_state)?{nameIR_state <- nameIR_state?}) be %, % has type continueResult<nameIR?>)

          1. Case analysis on (nameIR_state)?{nameIR_state <- nameIR_state?}

            1. Case (% matches pattern ())

              1. (Let rejectTransitionResult be (REJECT (ERROR '.' "NoMatch")))

              2. Result in: % % |- % : EC_2 ARCH_2 (rejectTransitionResult as transitionResult)

            2. Case (let ?(nameIR_state') be %, % matches pattern (_))

              1. (ParserTransition_eval: EC_2 ARCH_2 |- (TRANSITION (nameIR_state' ';')) : EC_3 ARCH_3 transitionResult)

              2. Result in: % % |- % : EC_3 ARCH_3 transitionResult

  3. Else Dangling#12353

relation ParserTransition_eval: EC ARCH |- (TRANSITION stateExpressionIR) : % % %

1. Group : EC ARCH |- (TRANSITION stateExpressionIR) : % % %

  1. Case analysis on stateExpressionIR

    1. Case (let (nameIR ';') be %, % matches pattern `% ;`)

      1. Block (2 arms)

      Arm 1:

        1. Case analysis on nameIR

          1. Case (% = "accept")

            1. Result in: % % |- % : EC ARCH ((ACCEPT) as transitionResult)

          2. Case (% = "reject")

            1. (Let errorValue be (ERROR '.' "NoError"))

            2. Result in: % % |- % : EC ARCH ((REJECT errorValue) as transitionResult)

        1. Else Dangling#12371

      Arm 2:

        1. If (((nameIR =/= "accept") /\ (nameIR =/= "reject"))), then

          1. Result in: % % |- % : EC ARCH ((STATE nameIR) as transitionResult)

        1. Else Dangling#12375

    2. Case (let selectExpressionIR be %, % has type selectExpressionIR)

      1. (ParserSelect_eval: EC ARCH |- selectExpressionIR : EC_1 ARCH_1 transitionResult)

      2. Result in: % % |- % : EC_1 ARCH_1 transitionResult

relation ParserState_eval: EC_0 ARCH_0 |- parserStateIR : % % %

1. Group : EC_0 ARCH_0 |- parserStateIR : % % %

  1. (Let (annotationList STATE nameIR `{ parserBlockElementStatementListIR transitionStatementIR `}) be parserStateIR)

  2. (Let EC_1 be $enter_e(EC_0))

  3. (ParserBlockElementStmtList_eval: EC_1 ARCH_0 |- parserBlockElementStatementListIR : EC_2 ARCH_1 parserStatementResult)

  4. Case analysis on parserStatementResult

    1. Case (let rejectTransitionResult be %, % has type rejectTransitionResult)

      1. (Let EC_3 be $exit_e(EC_2))

      2. Result in: % % |- % : EC_3 ARCH_1 (rejectTransitionResult as transitionResult)

    2. Case (let continueEmptyResult be %, % has type continueEmptyResult)

      1. (ParserTransition_eval: EC_2 ARCH_1 |- transitionStatementIR : EC_3 ARCH_2 transitionResult)

      2. (Let EC_4 be $exit_e(EC_3))

      3. Result in: % % |- % : EC_4 ARCH_2 transitionResult

relation ParserState_trans: EC_0 ARCH_0 |- TRANSITION nameIR : % % %

1. Group : EC_0 ARCH_0 |- TRANSITION nameIR : % % %

  1. (Let parserStateIR be ! $find_parserState_e(EC_0, nameIR))

    1. (ParserState_eval: EC_0 ARCH_0 |- parserStateIR : EC_1 ARCH_1 transitionResult')

    2. Case analysis on transitionResult'

      1. Case (let acceptTransitionResult be %, % has type acceptTransitionResult)

        1. Result in: % % |- TRANSITION % : EC_1 ARCH_1 ((ACCEPT) as transitionResult)

      2. Case (let rejectTransitionResult be %, % has type rejectTransitionResult)

        1. Result in: % % |- TRANSITION % : EC_1 ARCH_1 (rejectTransitionResult as transitionResult)

      3. Case (let (STATE nameIR_next) be %, % has type stateTransitionResult)

        1. (ParserState_trans: EC_1 ARCH_1 |- TRANSITION nameIR_next : EC_2 ARCH_2 transitionResult)

        2. Result in: % % |- TRANSITION % : EC_2 ARCH_2 transitionResult

syntax parserDeclarationResult = parserStatementResult

relation ParserLocalDecl_eval: EC_0 ARCH |- parserLocalDeclarationIR : % % %

1. Case analysis on parserLocalDeclarationIR

  1. Case (let constantDeclarationIR be %, % has type constantDeclarationIR)

    1. Group constantDeclarationIR: EC_0 ARCH |- (constantDeclarationIR as parserLocalDeclarationIR) : % % %

      1. (ConstDecl_eval: (BLOCK) EC_0 |- constantDeclarationIR : EC_1)

      2. Result in: % % |- % : EC_1 ARCH ((_EMPTY) as parserStatementResult)

  2. Case (let variableDeclarationIR be %, % has type variableDeclarationIR)

    1. Group variableDeclarationIR: EC_0 ARCH |- (variableDeclarationIR as parserLocalDeclarationIR) : % % %

      1. (VarDecl_eval: (BLOCK) EC_0 ARCH |- variableDeclarationIR : EC_1 ARCH_1 declarationResult)

      2. Case analysis on declarationResult

        1. Case (let rejectTransitionResult be %, % has type rejectTransitionResult)

          1. Result in: % % |- % : EC_1 ARCH_1 (rejectTransitionResult as parserDeclarationResult)

        2. Case (let continueEmptyResult be %, % has type continueEmptyResult)

          1. Result in: % % |- % : EC_1 ARCH_1 ((_EMPTY) as parserStatementResult)

      2. Else Dangling#12413

1. Else Dangling#12405

