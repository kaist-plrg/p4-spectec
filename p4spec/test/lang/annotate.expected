def $concat_text((t)*{t <- t*})

1. Case analysis on (t)*{t <- t*}

  1. Case (% matches pattern [])

    1. Return ""

  2. Case (let t_h :: (t_t)*{t_t <- t_t*} be %, % matches pattern _ :: _)

    1. (Let text be $concat_text((t_t)*{t_t <- t_t*}))

    2. Return t_h ++ text

def $join_text((t')*{t' <- t'*}, t_sep)

1. Case analysis on (t')*{t' <- t'*}

  1. Case (% matches pattern [])

    1. Return ""

  2. Case (let [t_h] be %, % matches pattern [ _/1 ])

    1. Return t_h

  3. Case (let t_h1 :: (t)*{t <- t*} be %, % matches pattern _ :: _)

    1. (Let t_h2 :: (t_t)*{t_t <- t_t*} be (t)*{t <- t*}, (t)*{t <- t*} matches pattern _ :: _)

      1. (Let text be $join_text(t_h2 :: (t_t)*{t_t <- t_t*}, t_sep))

      2. Return t_h1 ++ t_sep ++ text

1. Else Dangling#7

def $replace_text(t, t_old, t_new)

1. Return $replace_text'(0, |t|, t, t_old, t_new)

def $replace_text'(n_len, n_len', t, t_old, t_new)

1. Block (2 arms)

Arm 1:

  1. If ((n_len = n_len')), then

    1. Return t

  1. Else Dangling#16

Arm 2:

  1. If ((n_len < n_len')), then

    1. If ((n_len < |t|)), then

      1. (Let t_replaced be $ite<text>((t[n_len] = t_old), t[[n_len] = t_new], t))

      2. Return $replace_text'((n_len + 1), n_len', t_replaced, t_old, t_new)

    1. Else Dangling#19

  1. Else Dangling#18

def $replace_text_except(t, t_old, t_new)

1. Return $replace_text_except'(0, |t|, t, t_old, t_new)

def $replace_text_except'(n_len, n_len', t, t_old, t_new)

1. Block (2 arms)

Arm 1:

  1. If ((n_len = n_len')), then

    1. Return t

  1. Else Dangling#23

Arm 2:

  1. If ((n_len < n_len')), then

    1. If ((n_len < |t|)), then

      1. (Let t_replaced be $ite<text>((t[n_len] = t_old), t, t[[n_len] = t_new]))

      2. Return $replace_text_except'((n_len + 1), n_len', t_replaced, t_old, t_new)

    1. Else Dangling#26

  1. Else Dangling#25

builtin def $strip_prefix(t, t')

builtin def $strip_suffix(t, t')

builtin def $strip_all_whitespace(t)

def $starts_with(t, t_prefix)

1. If ((|t_prefix| <= |t|)), then

  1. If ((t[0 : |t_prefix|] = t_prefix)), then

    1. Return true

2. Otherwise,

  1. Return false

def $ends_with(t, t_suffix)

1. If ((|t_suffix| <= |t|)), then

  1. (Let i be (|t| - |t_suffix|))

  2. (Let n_start be i, i has type nat)

    1. If ((t[n_start : |t_suffix|] = t_suffix)), then

      1. Return true

2. Otherwise,

  1. Return false

def $strip_prefix_rec(t, t_prefix)

1. Case analysis on $starts_with(t, t_prefix)

  1. Case true

    1. (Let t_stripped be $strip_prefix(t, t_prefix))

    2. Return $strip_prefix_rec(t_stripped, t_prefix)

  2. Case false

    1. Return t

def $strip_suffix_rec(t, t_suffix)

1. Case analysis on $ends_with(t, t_suffix)

  1. Case true

    1. (Let t_stripped be $strip_suffix(t, t_suffix))

    2. Return $strip_suffix_rec(t_stripped, t_suffix)

  2. Case false

    1. Return t

def $contains(t, t_c)

1. Return $contains'(0, |t|, t, t_c)

def $contains'(n_len, n_len', t, t_c)

1. Block (2 arms)

Arm 1:

  1. If ((n_len = n_len')), then

    1. Return false

  1. Else Dangling#49

Arm 2:

  1. If ((n_len < n_len')), then

    1. If ((n_len < |t|)), then

      1. Case analysis on t[n_len]

        1. Case (% = t_c)

          1. Return true

        2. Case (% =/= t_c)

          1. Return $contains'((n_len + 1), n_len', t, t_c)

    1. Else Dangling#52

  1. Else Dangling#51

def $is_some_<X>((X)?{X <- X?})

1. Case analysis on (X)?{X <- X?}

  1. Case (% matches pattern ())

    1. Return false

  2. Case (% matches pattern (_))

    1. Return true

def $opt_as_seq_<X>((X')?{X' <- X'?})

1. Case analysis on (X')?{X' <- X'?}

  1. Case (% matches pattern ())

    1. Return []

  2. Case (let ?(X) be %, % matches pattern (_))

    1. Return [X]

def $exists_((b)*{b <- b*})

1. Case analysis on (b)*{b <- b*}

  1. Case (% matches pattern [])

    1. Return false

  2. Case (let b_h :: (b_t)*{b_t <- b_t*} be %, % matches pattern _ :: _)

    1. (Let bool be $exists_((b_t)*{b_t <- b_t*}))

    2. Return (b_h \/ bool)

def $forall_((b)*{b <- b*})

1. Case analysis on (b)*{b <- b*}

  1. Case (% matches pattern [])

    1. Return true

  2. Case (let b_h :: (b_t)*{b_t <- b_t*} be %, % matches pattern _ :: _)

    1. (Let bool be $forall_((b_t)*{b_t <- b_t*}))

    2. Return (b_h /\ bool)

def $init_(nat)

1. Case analysis on nat

  1. Case (% = 0)

    1. Return []

  2. Case (% =/= 0)

    1. (Let i be (nat - 1))

    2. (Let n be i, i has type nat)

      1. (Let (nat')*{nat' <- nat'*} be $init_(n))

      2. Return n :: (nat')*{nat' <- nat'*}

def $repeat_<X>(X, nat)

1. Case analysis on nat

  1. Case (% = 0)

    1. Return []

  2. Case (% =/= 0)

    1. (Let i be (nat - 1))

    2. (Let n be i, i has type nat)

      1. (Let (X')*{X' <- X'*} be $repeat_<X>(X, n))

      2. Return [X] ++ (X')*{X' <- X'*}

