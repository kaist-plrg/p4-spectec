      2. Case (% matches pattern `+:`)

        1. (Let expression_base be $lvalue_as_expression(lvalue_base))

        2. Return ((expression_base `[ expression_hi ('+:') expression_lo `]) as expression)

  5. Case (let (`( lvalue `)) be %, % matches pattern `(%)`)

    1. (Let expression be $lvalue_as_expression(lvalue))

    2. Return ((`( expression `)) as expression)

