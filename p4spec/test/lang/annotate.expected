def $filter_<X>((X)*{X <- X*}, (b)*{b <- b*})

1. Case analysis on (X)*{X <- X*}

  1. Case (% matches pattern [])

    1. If (((b)*{b <- b*} matches pattern [])), then

      1. Return []

    1. Else Dangling#84

  2. Case (let X_h :: (X_t)*{X_t <- X_t*} be %, % matches pattern _ :: _)

    1. (Let b_h :: (b_t)*{b_t <- b_t*} be (b)*{b <- b*}, (b)*{b <- b*} matches pattern _ :: _)

      1. Case analysis on b_h

        1. Case true

          1. (Let (X')*{X' <- X'*} be $filter_<X>((X_t)*{X_t <- X_t*}, (b_t)*{b_t <- b_t*}))

          2. Return X_h :: (X')*{X' <- X'*}

        2. Case false

          1. Return $filter_<X>((X_t)*{X_t <- X_t*}, (b_t)*{b_t <- b_t*})

