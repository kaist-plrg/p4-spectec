def $is_valid_bitslice(typeIR', n_lo, n_hi)

1. Case analysis on typeIR'

  1. Case (let intTypeIR be %, % has type intTypeIR)

    1. Return (n_lo <= n_hi)

  2. Case (let (INT `< w `>) be %, % has type fixedIntTypeIR)

    1. (Let i be ((n_hi - n_lo) + (1 as int)))

    2. (Let w_slice be i, i has type nat)

      1. Return (((n_lo <= n_hi) /\ (n_hi <= w)) /\ (w_slice <= w))

  3. Case (let (BIT `< w `>) be %, % has type fixedBitTypeIR)

    1. (Let i be ((n_hi - n_lo) + (1 as int)))

    2. (Let w_slice be i, i has type nat)

      1. Return (((n_lo <= n_hi) /\ (n_hi <= w)) /\ (w_slice <= w))

  4. Case (let (TYPEDEF _typeId typeIR) be %, % has type typedefTypeIR)

    1. Return $is_valid_bitslice(typeIR, n_lo, n_hi)

2. Otherwise,

  1. Return false

def $is_concrete_extern_object(typeIR)

1. (Let typeIR' be $unroll_typeIR(typeIR))

2. Return $is_concrete_extern_object'(typeIR')

def $is_concrete_extern_object'(typeIR)

1. Case analysis on (typeIR has type externObjectTypeIR)

  1. Case false

    1. Return true

  2. Case true

    1. (Let (EXTERN _typeId `< (_typeArgumentIR)*{_typeArgumentIR <- _typeArgumentIR*} `> (`{ ((_callableId ':' externMethodTypeDefIR))*{_callableId <- _callableId*, externMethodTypeDefIR <- externMethodTypeDefIR*} `})) be (typeIR as externObjectTypeIR))

    2. If ($is_concrete_extern_object''(externMethodTypeDefIR))*{externMethodTypeDefIR <- externMethodTypeDefIR*}, then

      1. Return true

2. Otherwise,

  1. Return false

def $is_concrete_extern_object''(externMethodTypeDefIR)

1. If ((externMethodTypeDefIR matches pattern `EXTERN_METHOD % <% , %> (%) : %`)), then

  1. Return true

2. Otherwise,

  1. Return false

relation Parameters_ok: p TC |- (parameter)*{parameter <- parameter*} : % '#' %

1. Group : p TC |- (parameter)*{parameter <- parameter*} : % '#' %

  1. Case analysis on (parameter)*{parameter <- parameter*}

    1. Case (% matches pattern [])

      1. Result in: % % |- % : [] '#' []

    2. Case (let parameter_h :: (parameter_t)*{parameter_t <- parameter_t*} be %, % matches pattern _ :: _)

      1. (Parameter_ok: p TC |- parameter_h : parameterIR_h '#' (typeId_fresh_h)*{typeId_fresh_h <- typeId_fresh_h*})

      2. (Parameters_ok: p TC |- (parameter_t)*{parameter_t <- parameter_t*} : (parameterIR_t)*{parameterIR_t <- parameterIR_t*} '#' (typeId_fresh_t)*{typeId_fresh_t <- typeId_fresh_t*})

      3. (Let (parameterIR)*{parameterIR <- parameterIR*} be parameterIR_h :: (parameterIR_t)*{parameterIR_t <- parameterIR_t*})

      4. (Let (typeId_fresh)*{typeId_fresh <- typeId_fresh*} be (typeId_fresh_h)*{typeId_fresh_h <- typeId_fresh_h*} ++ (typeId_fresh_t)*{typeId_fresh_t <- typeId_fresh_t*})

      5. Result in: % % |- % : (parameterIR)*{parameterIR <- parameterIR*} '#' (typeId_fresh)*{typeId_fresh <- typeId_fresh*}

relation ForUpdateStmt_ok: TC |- forUpdateStatement : %

1. Group : TC |- forUpdateStatement : %

  1. Case analysis on forUpdateStatement

    1. Case (let (lvalue_callable `( argumentList `)) be %, % matches pattern `% (%)`)

      1. (Stmt_ok: (LOCAL) TC |- ((lvalue_callable `( argumentList `) ';') as statement) : _TC statementIR)

      2. (Let (callableTargetIR `< (typeArgumentIR)*{typeArgumentIR <- typeArgumentIR*} `> `( (argumentIR)*{argumentIR <- argumentIR*} `) ';') be statementIR, statementIR has type callStatementIR)

        1. Result in: % |- % : (callableTargetIR `< (typeArgumentIR)*{typeArgumentIR <- typeArgumentIR*} `> `( (argumentIR)*{argumentIR <- argumentIR*} `))

    2. Case (let (lvalue_callable `< typeArgumentList `> `( argumentList `)) be %, % matches pattern `% <%> (%)`)

      1. (Stmt_ok: (LOCAL) TC |- ((lvalue_callable `< typeArgumentList `> `( argumentList `) ';') as statement) : _TC statementIR)

      2. (Let (callableTargetIR `< (typeArgumentIR)*{typeArgumentIR <- typeArgumentIR*} `> `( (argumentIR)*{argumentIR <- argumentIR*} `) ';') be statementIR, statementIR has type callStatementIR)

        1. Result in: % |- % : (callableTargetIR `< (typeArgumentIR)*{typeArgumentIR <- typeArgumentIR*} `> `( (argumentIR)*{argumentIR <- argumentIR*} `))

    3. Case (let (lvalue assignop expression) be %, % matches pattern `% % %`)

      1. (Stmt_ok: (LOCAL) TC |- ((lvalue assignop expression ';') as statement) : _TC statementIR)

      2. (Let (typedLvalueIR assignop' typedExpressionIR ';') be statementIR, statementIR has type assignmentStatementIR)

        1. If ((assignop' = assignop)), then

          1. Result in: % |- % : (typedLvalueIR assignop typedExpressionIR)

        1. Else Dangling#9087

relation ForUpdateStmtList_ok: TC |- forUpdateStatementList : %

1. Group : TC |- forUpdateStatementList : %

  1. (Let (forUpdateStatement)*{forUpdateStatement <- forUpdateStatement*} be $flatten_forUpdateStatementList(forUpdateStatementList))

  2. (ForUpdateStmt_ok: TC |- forUpdateStatement : forUpdateStatementIR)*

  3. Result in: % |- % : (forUpdateStatementIR)*{forUpdateStatementIR <- forUpdateStatementIR*}

relation ForInitStmt_ok: TC |- forInitStatement : % %

1. Group : TC |- forInitStatement : % %

  1. Case analysis on forInitStatement

    1. Case (let (annotationList type name initializerOpt) be %, % matches pattern `% % % %`)

      1. Case analysis on initializerOpt

        1. Case (% matches pattern `/* empty */`)

          1. (Type_ok: (LOCAL) TC |- (type as typeOrVoid) : typeIR '#' (typeId)*{typeId <- typeId*})

          2. If (((typeId)*{typeId <- typeId*} matches pattern [])), then

            1. (Let bound be $bound((LOCAL), TC))

            2. If (Type_wf: bound |- typeIR) holds, then

              1. If ($is_assignable_typeIR(typeIR)), then

                1. (Let nameIR be $name(name))

                2. (Let TC_1 be $add_var_t((LOCAL), TC, nameIR, ((INOUT) typeIR (DYN) ?())))

                3. Result in: % |- % : TC_1 (annotationList typeIR nameIR ?())

              1. Else Dangling#9100

            2. Else Dangling#9099

          2. Else Dangling#9098

        2. Case (let ('=' expression_init) be %, % has type initializer)

          1. (Type_ok: (LOCAL) TC |- (type as typeOrVoid) : typeIR '#' (typeId)*{typeId <- typeId*})

          2. If (((typeId)*{typeId <- typeId*} matches pattern [])), then

            1. (Let bound' be $bound((LOCAL), TC))

            2. If (Type_wf: bound' |- typeIR) holds, then

              1. If ($is_assignable_typeIR(typeIR)), then

                1. (Expr_ok: (LOCAL) TC |- expression_init : typedExpressionIR_init)

                2. (Let typedExpressionIR_init_cast be ! $cast_unary(typedExpressionIR_init, typeIR))

                  1. (Let nameIR be $name(name))

                  2. (Let TC_1 be $add_var_t((LOCAL), TC, nameIR, ((INOUT) typeIR (DYN) ?())))

                  3. Result in: % |- % : TC_1 (annotationList typeIR nameIR ?(('=' typedExpressionIR_init_cast)))

              1. Else Dangling#9108

            2. Else Dangling#9107

          2. Else Dangling#9106

    2. Case (let forUpdateStatement be %, % has type forUpdateStatement)

      1. (ForUpdateStmt_ok: TC |- forUpdateStatement : forUpdateStatementIR)

      2. Result in: % |- % : TC (forUpdateStatementIR as forInitStatementIR)

relation ForInitStmts_ok: TC |- (forInitStatement)*{forInitStatement <- forInitStatement*} : % %

1. Group : TC |- (forInitStatement)*{forInitStatement <- forInitStatement*} : % %

  1. Case analysis on (forInitStatement)*{forInitStatement <- forInitStatement*}

    1. Case (% matches pattern [])

      1. Result in: % |- % : TC []

    2. Case (let forInitStatement_h :: (forInitStatement_t)*{forInitStatement_t <- forInitStatement_t*} be %, % matches pattern _ :: _)

      1. (ForInitStmt_ok: TC |- forInitStatement_h : TC_1 forInitStatementIR_h)

      2. (ForInitStmts_ok: TC_1 |- (forInitStatement_t)*{forInitStatement_t <- forInitStatement_t*} : TC_2 (forInitStatementIR_t)*{forInitStatementIR_t <- forInitStatementIR_t*})

      3. Result in: % |- % : TC_2 forInitStatementIR_h :: (forInitStatementIR_t)*{forInitStatementIR_t <- forInitStatementIR_t*}

relation ForInitStmtList_ok: TC_0 |- forInitStatementList : % %

1. Group : TC_0 |- forInitStatementList : % %

  1. (Let (forInitStatement)*{forInitStatement <- forInitStatement*} be $flatten_forInitStatementList(forInitStatementList))

  2. (ForInitStmts_ok: TC_0 |- (forInitStatement)*{forInitStatement <- forInitStatement*} : TC_1 (forInitStatementIR)*{forInitStatementIR <- forInitStatementIR*})

  3. Result in: % |- % : TC_1 (forInitStatementIR)*{forInitStatementIR <- forInitStatementIR*}

relation ForCollectionExpr_ok: TC typeIR_var |- forCollectionExpression : %

1. Case analysis on forCollectionExpression

  1. Case (let expression be %, % has type expression)

    1. Group expression: TC typeIR_var |- (expression as forCollectionExpression) : %

      1. (Expr_ok: (LOCAL) TC |- expression : typedExpressionIR)

      2. (Let typeIR_expression be $type_of_typedExpressionIR(typedExpressionIR))

      3. (Let typeIR be $unroll_typeIR(typeIR_expression))

      4. Case analysis on typeIR

        1. Case (let (LIST `< typeIR_e `>) be %, % has type listTypeIR)

          1. (Cast_impl: typeIR_e -> typeIR_var : castResult)

          2. If ((castResult matches pattern `OK %`)), then

            1. Result in: % % |- % : (typedExpressionIR as forCollectionExpressionIR)

          2. Else Dangling#9139

        2. Case (let (ARRAY typeIR_e `[ _nat `]) be %, % has type arrayTypeIR)

          1. If (Type_alpha: typeIR_e ~~ typeIR_var) holds, then

            1. Result in: % % |- % : (typedExpressionIR as forCollectionExpressionIR)

          1. Else Dangling#9142

        3. Case (let (HEADER_STACK typeIR_e `[ _nat `]) be %, % has type headerStackTypeIR)

          1. If (Type_alpha: typeIR_e ~~ typeIR_var) holds, then

            1. Result in: % % |- % : (typedExpressionIR as forCollectionExpressionIR)

          1. Else Dangling#9145

      4. Else Dangling#9136

  2. Case (let (expression_l '..' expression_r) be %, % matches pattern `% .. %`)

    1. Group range: TC typeIR_var |- (expression_l '..' expression_r) : %

      1. (Expr_ok: (LOCAL) TC |- expression_l : typedExpressionIR_l)

      2. (Expr_ok: (LOCAL) TC |- expression_r : typedExpressionIR_r)

      3. (Let typedExpressionIR_l_casted be ! $cast_unary(typedExpressionIR_l, typeIR_var))

        1. (Let typedExpressionIR_r_casted be ! $cast_unary(typedExpressionIR_r, typeIR_var))

          1. (Let typeIR_l be $type_of_typedExpressionIR(typedExpressionIR_l_casted))

          2. (Let typeIR_r be $type_of_typedExpressionIR(typedExpressionIR_r_casted))

          3. If ($compat_range(typeIR_l, typeIR_r)), then

            1. Result in: % % |- % : (typedExpressionIR_l_casted '..' typedExpressionIR_r_casted)

          3. Else Dangling#9159

tbl def $compat_range(typeIR'', typeIR''')
=

  Row : ((INT) as typeIR), ((INT) as typeIR) -> true:

    1. (Let intTypeIR be typeIR'', typeIR'' has type intTypeIR)

      1. (Let intTypeIR' be typeIR''', typeIR''' has type intTypeIR)

        1. Return true

  Row : ((INT `< w_l `>) as typeIR), ((INT `< w_r `>) as typeIR) -> (w_l = w_r):

    1. (Let (INT `< w_l `>) be typeIR'', typeIR'' has type fixedIntTypeIR)

      1. (Let (INT `< w_r `>) be typeIR''', typeIR''' has type fixedIntTypeIR)

        1. Return (w_l = w_r)

  Row : ((BIT `< w_l `>) as typeIR), ((BIT `< w_r `>) as typeIR) -> (w_l = w_r):

    1. (Let (BIT `< w_l `>) be typeIR'', typeIR'' has type fixedBitTypeIR)

      1. (Let (BIT `< w_r `>) be typeIR''', typeIR''' has type fixedBitTypeIR)

        1. Return (w_l = w_r)

  Row : ((TYPEDEF _typeId typeIR_l) as typeIR), typeIR_r -> $compat_range(typeIR_l, typeIR_r):

    1. (Let (TYPEDEF _typeId typeIR_l) be typeIR'', typeIR'' has type typedefTypeIR)

      1. Return $compat_range(typeIR_l, typeIR''')

  Row : typeIR_l, ((TYPEDEF _typeId typeIR_r) as typeIR) -> $compat_range(typeIR_l, typeIR_r):

    1. (Let (TYPEDEF _typeId typeIR_r) be typeIR''', typeIR''' has type typedefTypeIR)

      1. Return $compat_range(typeIR'', typeIR_r)

  Row : _typeIR, _typeIR' -> false:

    1. Return false

def $check_switchLabelIR_default((switchLabelIR)*{switchLabelIR <- switchLabelIR*})

1. Case analysis on (switchLabelIR)*{switchLabelIR <- switchLabelIR*}

  1. Case (% matches pattern [])

    1. Return true

  2. Case (let switchLabelIR_h :: (switchLabelIR_t)*{switchLabelIR_t <- switchLabelIR_t*} be %, % matches pattern _ :: _)

    1. Case analysis on (switchLabelIR_h matches pattern `DEFAULT`)

      1. Case true

        1. Return ((switchLabelIR_t)*{switchLabelIR_t <- switchLabelIR_t*} = [])

      2. Case false

        1. Return $check_switchLabelIR_default((switchLabelIR_t)*{switchLabelIR_t <- switchLabelIR_t*})

relation SwitchLabel_table_ok: TC typeId_table |- switchLabel : %

1. Group : TC typeId_table |- switchLabel : %

  1. Case analysis on switchLabel

    1. Case (% matches pattern `DEFAULT`)

      1. Result in: % % |- % : (DEFAULT)

    2. Case (let prefixedNonTypeName be %, % has type prefixedNonTypeName)

      1. (Let prefixedNameIR be $prefixedNonTypeName(prefixedNonTypeName))

      2. (Let (_BARE nameIR_label) be prefixedNameIR, prefixedNameIR matches pattern `_BARE %`)

        1. (Let typeId_table_enum be $concat_text(["action_list(", typeId_table, ")"]))

        2. (Let id_label be $concat_text([typeId_table_enum, ".", nameIR_label]))

        3. (Let (_direction typeIR_label ctk_label (value)?{value <- value?}) be ! $find_var_t((_BARE id_label), (LOCAL), TC))

          1. (Let ?(value_label) be (value)?{value <- value?}, (value)?{value <- value?} matches pattern (_))

            1. If ((value_label = ((TABLE_ENUM typeId_table_enum '.' nameIR_label) as value))), then

              1. (Let typedExpressionIR_label be (((_BARE nameIR_label) as expressionIR) '#' (`( typeIR_label ctk_label `))))

              2. Result in: % % |- % : (typedExpressionIR_label as switchLabelIR)

            1. Else Dangling#9203

  1. Else Dangling#9190

