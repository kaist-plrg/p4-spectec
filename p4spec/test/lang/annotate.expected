      2. Case (let (RECORD `{ ((_annotationList typeIR _nameIR ';'))*{_annotationList <- _annotationList*, _nameIR <- _nameIR*, typeIR <- typeIR*} ',' '...' `}) be %, % matches pattern `RECORD {% , ...}`)

        1. (Let bound'''''''''''''''''' be $free_typeIR(typeIR))*

