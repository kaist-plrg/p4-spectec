syntax parameter = 
   | annotationList direction type name initializerOpt (from parameter) 

syntax nonEmptyParameterList = 
   | annotationList direction type name initializerOpt (from parameter) 
   | nonEmptyParameterList ',' parameter (from nonEmptyParameterList) 

syntax parameterList = 
   | _EMPTY (from parameterList) 
   | annotationList direction type name initializerOpt (from parameter) 
   | nonEmptyParameterList ',' parameter (from nonEmptyParameterList) 

def $flatten_parameterList(parameterList)

1. Block (2 arms)

Arm 1:

  1. Case analysis on parameterList

    1. Case (% matches pattern `/* empty */`)

      1. Return []

    2. Case (let parameter be %, % has type parameter)

      1. Return [parameter]

  1. Else Dangling#121

Arm 2:

  1. (Let nonEmptyParameterList' be parameterList, parameterList has type nonEmptyParameterList)

    1. (Let (nonEmptyParameterList ',' parameter) be nonEmptyParameterList', nonEmptyParameterList' matches pattern `% , %`)

      1. (Let (parameter')*{parameter' <- parameter'*} be $flatten_parameterList((nonEmptyParameterList as parameterList)))

      2. Return (parameter')*{parameter' <- parameter'*} ++ [parameter]

