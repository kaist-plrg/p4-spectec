  1. (Let typeIR_switch be $type_of_typedExpressionIR(typedExpressionIR_switch))

  2. If ($compat_switch(typeIR_switch)), then

    1. (SwitchCaseList_general_ok: TC_0 typeIR_switch |- switchCaseList : TC_1 (switchCaseIR)*{switchCaseIR <- switchCaseIR*})

    2. Result in: % |- SWITCH `( % `) `{ % `} : TC_1 (switchCaseIR)*{switchCaseIR <- switchCaseIR*}

  2. Else Dangling#9281

