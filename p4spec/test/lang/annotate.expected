          3. (Lvalue_write: p EC_0 ARCH |- storageReference := value_base_update : EC_1)

          4. Result in: % % % |- % := % : EC_1

syntax callResult = 
   | EXIT (from exitResult) 
   | REJECT errorValue (from rejectTransitionResult) 
   | RETURN value? (from returnResult) 

syntax forBreakResult = 
   | BREAK (from forBreakResult) 

syntax forContinueResult = 
   | CONTINUE (from forContinueResult) 

syntax forResult = 
   | BREAK (from forBreakResult) 
   | CONTINUE (from forContinueResult) 

syntax statementResult = 
   | _EMPTY (from continueEmptyResult) 
   | EXIT (from exitResult) 
   | REJECT errorValue (from rejectTransitionResult) 
   | RETURN value? (from returnResult) 
   | BREAK (from forBreakResult) 
   | CONTINUE (from forContinueResult) 

relation Stmt_eval: p EC ARCH |- statementIR' : % % %

1. Block (2 arms)

Arm 1:

  1. Case analysis on statementIR'

    1. Case (let emptyStatement be %, % has type emptyStatement)

      1. Group emptyStatementIR: p EC ARCH |- ((';') as statementIR) : % % %

        1. Result in: % % % |- % : EC ARCH ((_EMPTY) as statementResult)

    2. Case (let (typedLvalueIR assignop typedExpressionIR ';') be %, % has type assignmentStatementIR)

      1. Group assignmentStatementIR: p EC ARCH |- ((typedLvalueIR assignop typedExpressionIR ';') as statementIR) : % % %

        1. (Lvalue_eval: p EC ARCH |- typedLvalueIR : EC_1 ARCH_1 storageReferenceResult)

        2. Case analysis on storageReferenceResult

          1. Case (let abortResult be %, % has type abortResult)

            1. Result in: % % % |- % : EC_1 ARCH_1 (abortResult as statementResult)

          2. Case (let (_CONT (storageReference')?{storageReference' <- storageReference'?}) be %, % has type continueResult<storageReference?>)

            1. (Let ?(storageReference) be (storageReference')?{storageReference' <- storageReference'?}, (storageReference')?{storageReference' <- storageReference'?} matches pattern (_))

              1. Case analysis on (assignop matches pattern `=`)

                1. Case true

                  1. (Expr_eval: p EC_1 ARCH_1 |- typedExpressionIR : EC_2 ARCH_2 expressionResult)

                  2. Case analysis on expressionResult

                    1. Case (let abortResult be %, % has type abortResult)

                      1. Result in: % % % |- % : EC_2 ARCH_2 (abortResult as statementResult)

                    2. Case (let (_CONT value) be %, % has type continueResult<value>)

                      1. (Lvalue_write: p EC_2 ARCH_2 |- storageReference := value : EC_3)

                      2. Result in: % % % |- % : EC_3 ARCH_2 ((_EMPTY) as statementResult)

                2. Case false

                  1. (Expr_eval: p EC_1 ARCH_1 |- typedExpressionIR : EC_2 ARCH_2 expressionResult)

                  2. Case analysis on expressionResult

                    1. Case (let abortResult be %, % has type abortResult)

                      1. Result in: % % % |- % : EC_2 ARCH_2 (abortResult as statementResult)

                    2. Case (let (_CONT value) be %, % has type continueResult<value>)

                      1. (Lvalue_read: p EC_2 ARCH_2 |- storageReference : value_lvalue)

                      2. (Let binop be ! $assignop_as_binop(assignop))

                        1. (Let value_new be $bin_op(binop, value_lvalue, value))

                        2. (Lvalue_write: p EC_2 ARCH_2 |- storageReference := value_new : EC_3)

                        3. Result in: % % % |- % : EC_3 ARCH_2 ((_EMPTY) as statementResult)

    3. Case (let (callableTargetIR `< (typeArgumentIR)*{typeArgumentIR <- typeArgumentIR*} `> `( (argumentIR)*{argumentIR <- argumentIR*} `) ';') be %, % has type callStatementIR)

      1. Group callStatementIR: p EC ARCH |- ((callableTargetIR `< (typeArgumentIR)*{typeArgumentIR <- typeArgumentIR*} `> `( (argumentIR)*{argumentIR <- argumentIR*} `) ';') as statementIR) : % % %

