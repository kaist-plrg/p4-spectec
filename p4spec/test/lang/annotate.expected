def $merge_externMethodDefEnvs(externMethodDefEnv, set<pair<callableId, callableDef>>)

1. Block (2 arms)

Arm 1:

  1. If ((set<pair<callableId, callableDef>> = (`{ [] `}))), then

    1. Return externMethodDefEnv

  1. Else Dangling#11207

Arm 2:

  1. (Let (`{ (pair<callableId, callableDef>)*{pair<callableId, callableDef> <- pair<callableId, callableDef>*} `}) be set<pair<callableId, callableDef>>)

  2. (Let (callableId_h ':' callableDef_h) :: ((callableId_t ':' callableDef_t))*{callableDef_t <- callableDef_t*, callableId_t <- callableId_t*} be (pair<callableId, callableDef>)*{pair<callableId, callableDef> <- pair<callableId, callableDef>*}, (pair<callableId, callableDef>)*{pair<callableId, callableDef> <- pair<callableId, callableDef>*} matches pattern _ :: _)

    1. (Let (FUNCTION nameIR `< typeParameterListIR `> `( parameterListIR `) blockStatementIR) be callableDef_h, callableDef_h has type definedFunctionDef)

      1. (Let externMethodDef_h be (EXTERN_METHOD nameIR `< typeParameterListIR `> `( parameterListIR `) ?(blockStatementIR)))

      2. (Let externMethodDefEnv_post be $update_map<callableId, externMethodDef>(externMethodDefEnv, callableId_h, externMethodDef_h))

      3. Return $merge_externMethodDefEnvs(externMethodDefEnv_post, (`{ ((callableId_t ':' callableDef_t))*{callableDef_t <- callableDef_t*, callableId_t <- callableId_t*} `}))

