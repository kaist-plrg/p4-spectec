  3. Case (let (STRUCT _typeId `< (typeParameterIR)*{typeParameterIR <- typeParameterIR*} `> `{ (_fieldTypeIR)*{_fieldTypeIR <- _fieldTypeIR*} `}) be %, % has type structTypeDefIR)

