  1. (Let (parameter)*{parameter <- parameter*} be $flatten_parameterList(parameterList))

  2. (Parameters_ok: p TC_0 |- (parameter)*{parameter <- parameter*} : (parameterIR)*{parameterIR <- parameterIR*} '#' (typeId_fresh)*{typeId_fresh <- typeId_fresh*})

