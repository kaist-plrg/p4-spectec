def $extend_map<K, V>((`{ ((K_a ':' V_a))*{K_a <- K_a*, V_a <- V_a*} `}), (`{ ((K_b ':' V_b))*{K_b <- K_b*, V_b <- V_b*} `}))

1. (Let (`{ ((K_c ':' V_c))*{K_c <- K_c*, V_c <- V_c*} `}) be $adds_map<K, V>((`{ ((K_a ':' V_a))*{K_a <- K_a*, V_a <- V_a*} `}), (K_b)*{K_b <- K_b*}, (V_b)*{V_b <- V_b*}))

2. Return (`{ ((K_c ':' V_c))*{K_c <- K_c*, V_c <- V_c*} `})

