  22. Case (let recordTypeIR be %, % has type recordTypeIR)

    1. Case analysis on recordTypeIR

      1. Case (let (RECORD `{ ((_annotationList typeIR _nameIR ';'))*{_annotationList <- _annotationList*, _nameIR <- _nameIR*, typeIR <- typeIR*} `}) be %, % matches pattern `RECORD {%}`)

