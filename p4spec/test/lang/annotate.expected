def $insert_NoAction_tablePropertyIR(TBLC, (tablePropertyIR)*{tablePropertyIR <- tablePropertyIR*})

1. Case analysis on (tablePropertyIR)*{tablePropertyIR <- tablePropertyIR*}

  1. Case (% matches pattern [])

    1. Return (TBLC, [])

  2. Case (let tablePropertyIR_h :: (tablePropertyIR_t)*{tablePropertyIR_t <- tablePropertyIR_t*} be %, % matches pattern _ :: _)

    1. Case analysis on (tablePropertyIR_h has type tableActionsPropertyIR)

      1. Case true

        1. (Let (ACTIONS '=' `{ (tableActionIR)*{tableActionIR <- tableActionIR*} `}) be (tablePropertyIR_h as tableActionsPropertyIR))

        2. (Let (_annotationList tableActionReferenceIR '#' `( _parameterListIR ',' _parameterListIR' `) ';') be tableActionIR)*

        3. (Let tableActionReferenceIR_NoAction be (('.' "NoAction") ?() `( [] `)))

        4. Case analysis on tableActionReferenceIR_NoAction is in (tableActionReferenceIR)*{tableActionReferenceIR <- tableActionReferenceIR*}

          1. Case false

            1. (Let TBLC_1 be $add_action_tbl(TBLC, ('.' "NoAction"), [], []))

            2. (Let tableActionIR_NoAction be ((_EMPTY) tableActionReferenceIR_NoAction '#' `( [] ',' [] `) ';'))

            3. (Let tablePropertyIR_h_updated be ((ACTIONS '=' `{ (tableActionIR)*{tableActionIR <- tableActionIR*} ++ [tableActionIR_NoAction] `}) as tablePropertyIR))

            4. Return (TBLC_1, tablePropertyIR_h_updated :: (tablePropertyIR_t)*{tablePropertyIR_t <- tablePropertyIR_t*})

          2. Case true

            1. Return (TBLC, tablePropertyIR_h :: (tablePropertyIR_t)*{tablePropertyIR_t <- tablePropertyIR_t*})

      2. Case false

        1. (Let (TBLC_1, (tablePropertyIR_t_updated)*{tablePropertyIR_t_updated <- tablePropertyIR_t_updated*}) be $insert_NoAction_tablePropertyIR(TBLC, (tablePropertyIR_t)*{tablePropertyIR_t <- tablePropertyIR_t*}))

        2. Return (TBLC_1, tablePropertyIR_h :: (tablePropertyIR_t_updated)*{tablePropertyIR_t_updated <- tablePropertyIR_t_updated*})

