def $field_list_annotation_index(annotationList)

1. (Let (annotation)*{annotation <- annotation*} be $flatten_annotationList(annotationList))

2. (Let (integerLiteral)?{integerLiteral <- integerLiteral?} be $field_list_annotation_index'(annotation))*

3. (Let ((integerLiteral'')?{integerLiteral'' <- integerLiteral''?})*{integerLiteral''? <- integerLiteral''?*} be ((integerLiteral)?{integerLiteral <- integerLiteral?})*{integerLiteral? <- integerLiteral?*})

4. (Let [(integerLiteral')?{integerLiteral' <- integerLiteral'?}] be ((integerLiteral'')?{integerLiteral'' <- integerLiteral''?})*{integerLiteral''? <- integerLiteral''?*}, ((integerLiteral'')?{integerLiteral'' <- integerLiteral''?})*{integerLiteral''? <- integerLiteral''?*} matches pattern [ _/1 ])

  1. (Let ?(integerLiteral_found) be (integerLiteral')?{integerLiteral' <- integerLiteral'?}, (integerLiteral')?{integerLiteral' <- integerLiteral'?} matches pattern (_))

    1. (Let value be $cast_op(((BIT `< 8 `>) as typeIR), (integerLiteral_found as value)))

    2. (Let integerLiteral_fixbit be value, value has type integerLiteral)

      1. Return ?(integerLiteral_fixbit)

5. Otherwise,

  1. Return ?()

def $field_list_annotation_index'(annotation)

1. (Let ('@' name `( annotationBody `)) be annotation, annotation matches pattern `@ % (%)`)

  1. If (("field_list" = $name(name))), then

    1. (Let (annotationBody' annotationToken) be annotationBody, annotationBody matches pattern `% %`)

      1. If ((annotationBody' matches pattern `/* empty */`)), then

        1. (Let integerLiteral be annotationToken, annotationToken has type integerLiteral)

          1. Return ?(integerLiteral)

2. Otherwise,

  1. Return ?()

def $fields_with_field_list_index((fieldTypeIR')*{fieldTypeIR' <- fieldTypeIR'*}, integerLiteral)

1. Case analysis on (fieldTypeIR')*{fieldTypeIR' <- fieldTypeIR'*}

  1. Case (let fieldTypeIR_h :: (fieldTypeIR_t)*{fieldTypeIR_t <- fieldTypeIR_t*} be %, % matches pattern _ :: _)

    1. Case analysis on $field_has_field_list_index(fieldTypeIR_h, integerLiteral)

      1. Case true

        1. (Let (fieldTypeIR'')*{fieldTypeIR'' <- fieldTypeIR''*} be $fields_with_field_list_index((fieldTypeIR_t)*{fieldTypeIR_t <- fieldTypeIR_t*}, integerLiteral))

        2. (Let (fieldTypeIR)*{fieldTypeIR <- fieldTypeIR*} be fieldTypeIR_h :: (fieldTypeIR'')*{fieldTypeIR'' <- fieldTypeIR''*})

        3. Return (fieldTypeIR)*{fieldTypeIR <- fieldTypeIR*}

      2. Case false

        1. (Let (fieldTypeIR)*{fieldTypeIR <- fieldTypeIR*} be $fields_with_field_list_index((fieldTypeIR_t)*{fieldTypeIR_t <- fieldTypeIR_t*}, integerLiteral))

        2. Return (fieldTypeIR)*{fieldTypeIR <- fieldTypeIR*}

  2. Case (% matches pattern [])

    1. Return []

def $field_has_field_list_index(fieldTypeIR, integerLiteral)

1. (Let (annotationList typeIR nameIR ';') be fieldTypeIR)

2. (Let integerLiteral_found be ! $field_list_annotation_index(annotationList))

  1. Return $bin_eq((integerLiteral as value), (integerLiteral_found as value))

3. Otherwise,

  1. Return false

def $V1Model_meta_fields_of_index(ARCH, integerLiteral_index)

1. (Let object be ! $find_object_e(ARCH, ["main"]))

  1. (Let (PACKAGE `< theta `> `{ _frame `}) be object, object has type packageObject)

    1. (Let typeIR_meta be ! $find_map<typeId, typeIR>(theta, "M"))

      1. (Let (STRUCT _typeId `< (_typeArgumentIR)*{_typeArgumentIR <- _typeArgumentIR*} `> `{ (fieldTypeIR)*{fieldTypeIR <- fieldTypeIR*} `}) be typeIR_meta, typeIR_meta has type structTypeIR)

        1. (Let ((_annotationList _typeIR nameIR_field ';'))*{_annotationList <- _annotationList*, _typeIR <- _typeIR*, nameIR_field <- nameIR_field*} be $fields_with_field_list_index((fieldTypeIR)*{fieldTypeIR <- fieldTypeIR*}, integerLiteral_index))

        2. Return (nameIR_field)*{nameIR_field <- nameIR_field*}

relation V1Model_copy_meta_fields: EC_capture EC_0 ARCH |- (nameIR)*{nameIR <- nameIR*} : %

1. Group : EC_capture EC_0 ARCH |- (nameIR)*{nameIR <- nameIR*} : %

  1. Case analysis on (nameIR)*{nameIR <- nameIR*}

    1. Case (% matches pattern [])

