def $callable_tableApplyMethod(p, TC)

1. Case analysis on p

  1. Case (% matches pattern `GLOBAL`)

    1. Return false

  2. Case (% matches pattern `BLOCK`)

    1. Return false

  3. Case (% matches pattern `LOCAL`)

    1. (Let localKind be TC.LOCAL.KIND)

    2. Return ((localKind = ((CONTROL_APPLY_METHOD) as localKind)) \/ (localKind = ((TABLE_APPLY_METHOD) as localKind)))

def $callableId_IR(nameIR, (parameterIR)*{parameterIR <- parameterIR*})

1. (Let (_annotationList _direction _typeIR id _parameterInitializerOptIR) be parameterIR)*

2. Return (nameIR `( (id)*{id <- id*} `))

syntax storageReference = 
   | _BARE nameIR (from prefixedNameIR)  hint(print %0)
   | '.' nameIR (from prefixedNameIR) 
   | storageReference '.' nameIR (from storageReference) 
   | storageReference `[ value `] (from storageReference) 
   | storageReference `[ value sliceop value `] (from storageReference) 

syntax actionDef = 
   | annotationList ACTION nameIR `( parameterListIR `) blockStatementIR (from actionDef) 

syntax definedFunctionDef = 
   | FUNCTION nameIR `< typeParameterListIR `> `( parameterListIR `) blockStatementIR (from definedFunctionDef) 

syntax externFunctionDef = 
   | EXTERN_FUNCTION nameIR `< typeParameterListIR `> `( parameterListIR `) (from externFunctionDef) 

syntax functionDef = 
   | FUNCTION nameIR `< typeParameterListIR `> `( parameterListIR `) blockStatementIR (from definedFunctionDef) 
   | EXTERN_FUNCTION nameIR `< typeParameterListIR `> `( parameterListIR `) (from externFunctionDef) 

syntax externMethodDef = 
   | EXTERN_METHOD nameIR `< typeParameterListIR `> `( parameterListIR `) blockStatementIR? (from externMethodDef) 
   | EXTERN_METHOD ABSTRACT nameIR `< typeParameterListIR `> `( parameterListIR `) (from externMethodDef) 

syntax parserApplyMethodDef = 
   | PARSER_APPLY `( parameterListIR `) `{ parserLocalDeclarationListIR ';' stateEnv `} (from parserApplyMethodDef) 

syntax controlApplyMethodDef = 
   | CONTROL_APPLY `( parameterListIR `) `{ controlLocalDeclarationListIR ';' actionDefEnv ';' controlBodyIR `} (from controlApplyMethodDef) 

syntax tableApplyMethodDef = 
   | TABLE_APPLY `{ tablePropertyListIR `} (from tableApplyMethodDef) 

syntax methodDef = 
   | EXTERN_METHOD nameIR `< typeParameterListIR `> `( parameterListIR `) blockStatementIR? (from externMethodDef) 
   | EXTERN_METHOD ABSTRACT nameIR `< typeParameterListIR `> `( parameterListIR `) (from externMethodDef) 
   | PARSER_APPLY `( parameterListIR `) `{ parserLocalDeclarationListIR ';' stateEnv `} (from parserApplyMethodDef) 
   | CONTROL_APPLY `( parameterListIR `) `{ controlLocalDeclarationListIR ';' actionDefEnv ';' controlBodyIR `} (from controlApplyMethodDef) 
   | TABLE_APPLY `{ tablePropertyListIR `} (from tableApplyMethodDef) 

syntax callableDef = 
   | annotationList ACTION nameIR `( parameterListIR `) blockStatementIR (from actionDef) 
   | FUNCTION nameIR `< typeParameterListIR `> `( parameterListIR `) blockStatementIR (from definedFunctionDef) 
   | EXTERN_FUNCTION nameIR `< typeParameterListIR `> `( parameterListIR `) (from externFunctionDef) 
   | EXTERN_METHOD nameIR `< typeParameterListIR `> `( parameterListIR `) blockStatementIR? (from externMethodDef) 
   | EXTERN_METHOD ABSTRACT nameIR `< typeParameterListIR `> `( parameterListIR `) (from externMethodDef) 
   | PARSER_APPLY `( parameterListIR `) `{ parserLocalDeclarationListIR ';' stateEnv `} (from parserApplyMethodDef) 
   | CONTROL_APPLY `( parameterListIR `) `{ controlLocalDeclarationListIR ';' actionDefEnv ';' controlBodyIR `} (from controlApplyMethodDef) 
   | TABLE_APPLY `{ tablePropertyListIR `} (from tableApplyMethodDef) 

def $parameterListIR_of_callableDef(callableDef)

1. Case analysis on callableDef

  1. Case (let actionDef be %, % has type actionDef)

    1. Return $parameterListIR_of_actionDef(actionDef)

  2. Case (let functionDef be %, % has type functionDef)

    1. Return $parameterListIR_of_functionDef(functionDef)

  3. Case (let methodDef be %, % has type methodDef)

    1. Return $parameterListIR_of_methodDef(methodDef)

def $parameterListIR_of_actionDef((annotationList ACTION _nameIR `( parameterListIR `) _blockStatementIR))

1. Return parameterListIR

def $parameterListIR_of_functionDef(functionDef)

1. Case analysis on functionDef

  1. Case (let definedFunctionDef be %, % has type definedFunctionDef)

    1. Return $parameterListIR_of_definedFunctionDef(definedFunctionDef)

  2. Case (let externFunctionDef be %, % has type externFunctionDef)

    1. Return $parameterListIR_of_externFunctionDef(externFunctionDef)

def $parameterListIR_of_definedFunctionDef((FUNCTION _nameIR `< _typeParameterListIR `> `( parameterListIR `) _blockStatementIR))

1. Return parameterListIR

def $parameterListIR_of_externFunctionDef((EXTERN_FUNCTION _nameIR `< _typeParameterListIR `> `( parameterListIR `)))

1. Return parameterListIR

def $parameterListIR_of_methodDef(methodDef)

1. Case analysis on methodDef

  1. Case (let externMethodDef be %, % has type externMethodDef)

    1. Return $parameterListIR_of_externMethodDef(externMethodDef)

  2. Case (let parserApplyMethodDef be %, % has type parserApplyMethodDef)

    1. Return $parameterListIR_of_parserApplyMethodDef(parserApplyMethodDef)

  3. Case (let controlApplyMethodDef be %, % has type controlApplyMethodDef)

    1. Return $parameterListIR_of_controlApplyMethodDef(controlApplyMethodDef)

  4. Case (let tableApplyMethodDef be %, % has type tableApplyMethodDef)

    1. Return $parameterListIR_of_tableApplyMethodDef(tableApplyMethodDef)

def $parameterListIR_of_externMethodDef(externMethodDef)

1. (Let (EXTERN_METHOD _nameIR `< _typeParameterListIR `> `( parameterListIR `) (_blockStatementIR)?{_blockStatementIR <- _blockStatementIR?}) be externMethodDef, externMethodDef matches pattern `EXTERN_METHOD % <%> (%) %`)

  1. Return parameterListIR

def $parameterListIR_of_parserApplyMethodDef((PARSER_APPLY `( parameterListIR `) `{ _parserLocalDeclarationListIR ';' _stateEnv `}))

1. Return parameterListIR

def $parameterListIR_of_controlApplyMethodDef((CONTROL_APPLY `( parameterListIR `) `{ _controlLocalDeclarationListIR ';' _actionDefEnv ';' _controlBodyIR `}))

1. Return parameterListIR

def $parameterListIR_of_tableApplyMethodDef((TABLE_APPLY `{ _tablePropertyListIR `}))

1. Return []

syntax actionCallee = 
   | ACTION cursor '.' nameIR `( parameterListIR '#' id* `) blockStatementIR (from actionCallee) 

syntax definedFunctionCallee = 
   | FUNCTION nameIR `< typeParameterListIR `> `( parameterListIR '#' id* `) blockStatementIR (from definedFunctionCallee) 

syntax externFunctionCallee = 
   | EXTERN_FUNCTION nameIR `< typeParameterListIR `> `( parameterListIR '#' id* '#' id* `) (from externFunctionCallee) 

syntax functionCallee = 
   | FUNCTION nameIR `< typeParameterListIR `> `( parameterListIR '#' id* `) blockStatementIR (from definedFunctionCallee) 
   | EXTERN_FUNCTION nameIR `< typeParameterListIR `> `( parameterListIR '#' id* '#' id* `) (from externFunctionCallee) 

syntax builtinIsValidMethodCallee = 
   | BUILTIN_IS_VALID storageReference (from builtinIsValidMethodCallee) 

syntax builtinSetValidMethodCallee = 
   | BUILTIN_SET_VALID storageReference (from builtinSetValidMethodCallee) 

syntax builtinSetInvalidMethodCallee = 
   | BUILTIN_SET_INVALID storageReference (from builtinSetInvalidMethodCallee) 

syntax builtinPushFrontMethodCallee = 
   | BUILTIN_PUSH_FRONT storageReference (from builtinPushFrontMethodCallee) 

syntax builtinPopFrontMethodCallee = 
   | BUILTIN_POP_FRONT storageReference (from builtinPopFrontMethodCallee) 

syntax builtinSizeMethodCallee = 
   | BUILTIN_SIZE_OF nameIR typeIR (from builtinSizeMethodCallee) 

syntax builtinMethodCallee = 
   | BUILTIN_IS_VALID storageReference (from builtinIsValidMethodCallee) 
   | BUILTIN_SET_VALID storageReference (from builtinSetValidMethodCallee) 
   | BUILTIN_SET_INVALID storageReference (from builtinSetInvalidMethodCallee) 
   | BUILTIN_PUSH_FRONT storageReference (from builtinPushFrontMethodCallee) 
   | BUILTIN_POP_FRONT storageReference (from builtinPopFrontMethodCallee) 
   | BUILTIN_SIZE_OF nameIR typeIR (from builtinSizeMethodCallee) 

syntax externMethodCallee = 
   | EXTERN_METHOD objectId '.' nameIR `< typeParameterListIR `> `( parameterListIR '#' id* '#' id* `) `{ theta ';' frame ';' blockStatementIR? `} (from externMethodCallee) 

syntax parserApplyMethodCallee = 
   | PARSER objectId '.' APPLY `( parameterListIR '#' id* `) `{ theta ';' frame ';' parserLocalDeclarationListIR ';' stateEnv `} (from parserApplyMethodCallee) 

syntax controlApplyMethodCallee = 
   | CONTROL objectId '.' APPLY `( parameterListIR '#' id* `) `{ theta ';' frame ';' controlLocalDeclarationListIR ';' actionDefEnv ';' controlBodyIR `} (from controlApplyMethodCallee) 

syntax tableApplyMethodCallee = 
   | TABLE objectId '.' APPLY `{ frame ';' tableObjectProperty `} (from tableApplyMethodCallee) 

syntax methodCallee = 
   | BUILTIN_IS_VALID storageReference (from builtinIsValidMethodCallee) 
   | BUILTIN_SET_VALID storageReference (from builtinSetValidMethodCallee) 
   | BUILTIN_SET_INVALID storageReference (from builtinSetInvalidMethodCallee) 
   | BUILTIN_PUSH_FRONT storageReference (from builtinPushFrontMethodCallee) 
   | BUILTIN_POP_FRONT storageReference (from builtinPopFrontMethodCallee) 
   | BUILTIN_SIZE_OF nameIR typeIR (from builtinSizeMethodCallee) 
   | EXTERN_METHOD objectId '.' nameIR `< typeParameterListIR `> `( parameterListIR '#' id* '#' id* `) `{ theta ';' frame ';' blockStatementIR? `} (from externMethodCallee) 
   | PARSER objectId '.' APPLY `( parameterListIR '#' id* `) `{ theta ';' frame ';' parserLocalDeclarationListIR ';' stateEnv `} (from parserApplyMethodCallee) 
   | CONTROL objectId '.' APPLY `( parameterListIR '#' id* `) `{ theta ';' frame ';' controlLocalDeclarationListIR ';' actionDefEnv ';' controlBodyIR `} (from controlApplyMethodCallee) 
   | TABLE objectId '.' APPLY `{ frame ';' tableObjectProperty `} (from tableApplyMethodCallee) 

syntax callee = 
   | ACTION cursor '.' nameIR `( parameterListIR '#' id* `) blockStatementIR (from actionCallee) 
   | FUNCTION nameIR `< typeParameterListIR `> `( parameterListIR '#' id* `) blockStatementIR (from definedFunctionCallee) 
   | EXTERN_FUNCTION nameIR `< typeParameterListIR `> `( parameterListIR '#' id* '#' id* `) (from externFunctionCallee) 
   | BUILTIN_IS_VALID storageReference (from builtinIsValidMethodCallee) 
   | BUILTIN_SET_VALID storageReference (from builtinSetValidMethodCallee) 
   | BUILTIN_SET_INVALID storageReference (from builtinSetInvalidMethodCallee) 
   | BUILTIN_PUSH_FRONT storageReference (from builtinPushFrontMethodCallee) 
   | BUILTIN_POP_FRONT storageReference (from builtinPopFrontMethodCallee) 
   | BUILTIN_SIZE_OF nameIR typeIR (from builtinSizeMethodCallee) 
   | EXTERN_METHOD objectId '.' nameIR `< typeParameterListIR `> `( parameterListIR '#' id* '#' id* `) `{ theta ';' frame ';' blockStatementIR? `} (from externMethodCallee) 
   | PARSER objectId '.' APPLY `( parameterListIR '#' id* `) `{ theta ';' frame ';' parserLocalDeclarationListIR ';' stateEnv `} (from parserApplyMethodCallee) 
   | CONTROL objectId '.' APPLY `( parameterListIR '#' id* `) `{ theta ';' frame ';' controlLocalDeclarationListIR ';' actionDefEnv ';' controlBodyIR `} (from controlApplyMethodCallee) 
   | TABLE objectId '.' APPLY `{ frame ';' tableObjectProperty `} (from tableApplyMethodCallee) 

syntax externObjectConstructorDef = 
   | EXTERN nameIR `< typeParameterListIR `> `( constructorParameterListIR `) `{ externMethodPrototypeListIR `} (from externObjectConstructorDef) 

syntax parserObjectConstructorDef = 
   | PARSER `< typeParameterListIR `> `( parameterListIR `) `( constructorParameterListIR `) `{ parserLocalDeclarationListIR parserStateListIR `} (from parserObjectConstructorDef) 

syntax controlObjectConstructorDef = 
   | CONTROL `< typeParameterListIR `> `( parameterListIR `) `( constructorParameterListIR `) `{ controlLocalDeclarationListIR APPLY controlBodyIR `} (from controlObjectConstructorDef) 

syntax packageObjectConstructorDef = 
   | PACKAGE `< typeParameterListIR `> `( constructorParameterListIR `) (from packageObjectConstructorDef) 

syntax constructorDef = 
   | EXTERN nameIR `< typeParameterListIR `> `( constructorParameterListIR `) `{ externMethodPrototypeListIR `} (from externObjectConstructorDef) 
   | PARSER `< typeParameterListIR `> `( parameterListIR `) `( constructorParameterListIR `) `{ parserLocalDeclarationListIR parserStateListIR `} (from parserObjectConstructorDef) 
   | CONTROL `< typeParameterListIR `> `( parameterListIR `) `( constructorParameterListIR `) `{ controlLocalDeclarationListIR APPLY controlBodyIR `} (from controlObjectConstructorDef) 
   | PACKAGE `< typeParameterListIR `> `( constructorParameterListIR `) (from packageObjectConstructorDef) 

def $parameterListIR_of_constructorDef(constructorDef)

1. Case analysis on constructorDef

  1. Case (let (EXTERN _nameIR `< _typeParameterListIR `> `( constructorParameterListIR `) `{ _externMethodPrototypeListIR `}) be %, % has type externObjectConstructorDef)

    1. Return constructorParameterListIR

  2. Case (let (PARSER `< _typeParameterListIR `> `( _parameterListIR `) `( constructorParameterListIR `) `{ _parserLocalDeclarationListIR _parserStateListIR `}) be %, % has type parserObjectConstructorDef)

    1. Return constructorParameterListIR

  3. Case (let (CONTROL `< _typeParameterListIR `> `( _parameterListIR `) `( constructorParameterListIR `) `{ _controlLocalDeclarationListIR APPLY _controlBodyIR `}) be %, % has type controlObjectConstructorDef)

    1. Return constructorParameterListIR

  4. Case (let (PACKAGE `< _typeParameterListIR `> `( constructorParameterListIR `)) be %, % has type packageObjectConstructorDef)

    1. Return constructorParameterListIR

extern syntax objectState

syntax externMethodDefEnv = map<callableId, externMethodDef>

extern def $init_objectState(nameIR, (typeIR)*{typeIR <- typeIR*}, (id)*{id <- id*}, (value)*{value <- value*})

syntax externObject = 
   | EXTERN typeId `< theta `> `{ objectState frame externMethodDefEnv `} (from externObject) 

syntax parserObject = 
   | PARSER `< theta `> `( parameterListIR `) `{ frame parserLocalDeclarationListIR stateEnv `} (from parserObject) 

syntax actionDefEnv = map<callableId, actionDef>

syntax controlObject = 
   | CONTROL `< theta `> `( parameterListIR `) `{ frame controlLocalDeclarationListIR actionDefEnv controlBodyIR `} (from controlObject) 

syntax packageObject = 
   | PACKAGE `< theta `> `{ frame `} (from packageObject) 

syntax tableObjectProperty = {KEYS tableKeysPropertyIR, ACTIONS tableActionsPropertyIR, DEFAULT_ACTION tableDefaultActionPropertyIR, ENTRIES tableEntriesPropertyIR, CUSTOMS tableCustomPropertyIR*}

var TBL : tableObjectProperty

syntax tableObject = 
   | TABLE typeId `{ frame tableObjectProperty `} (from tableObject) 

syntax valueSetObject = 
   | VALUE_SET `{ value* `( nat `) `} (from valueSetObject) 

syntax object = 
   | EXTERN typeId `< theta `> `{ objectState frame externMethodDefEnv `} (from externObject) 
   | PARSER `< theta `> `( parameterListIR `) `{ frame parserLocalDeclarationListIR stateEnv `} (from parserObject) 
   | CONTROL `< theta `> `( parameterListIR `) `{ frame controlLocalDeclarationListIR actionDefEnv controlBodyIR `} (from controlObject) 
   | PACKAGE `< theta `> `{ frame `} (from packageObject) 
   | TABLE typeId `{ frame tableObjectProperty `} (from tableObject) 
   | VALUE_SET `{ value* `( nat `) `} (from valueSetObject) 

syntax frame = map<id, value>

def $empty_frame

1. Return $empty_map<id, value>

syntax stateEnv = map<id, parserStateIR>

def $empty_stateEnv

1. Return $empty_map<id, parserStateIR>

syntax callableDefEnv = map<callableId, callableDef>

def $empty_callableDefEnv

1. Return $empty_map<callableId, callableDef>

syntax constructorDefEnv = map<callableId, constructorDef>

def $empty_constructorDefEnv

1. Return $empty_map<callableId, constructorDef>

syntax store = map<objectId, object>

var STO : store

def $empty_store

1. (Let store be $empty_map<objectId, object>)

2. Return store

def $add_store(store, objectId, object)

1. (Let store' be $add_map<objectId, object>(store, objectId, object))

2. Return store'

def $find_store(store, objectId)

1. (Let object be ! $find_map<objectId, object>(store, objectId))

  1. Return object

syntax globalInstLayer = {CONSTRUCTOR constructorDefEnv, TYPE typeDefEnv, CALLABLE callableDefEnv, FRAME frame}

syntax blockInstLayer = {TYPE theta, CALLABLE callableDefEnv, STATE stateEnv, FRAME frame}

syntax localInstLayer = {TYPE theta, FRAMES frame*}

syntax instContext = {PATH objectId, GLOBAL globalInstLayer, BLOCK blockInstLayer, LOCAL localInstLayer}

var IC : instContext

def $empty_instContext

1. (Let globalInstLayer be {CONSTRUCTOR $empty_constructorDefEnv, TYPE $empty_typeDefEnv, CALLABLE $empty_callableDefEnv, FRAME $empty_frame})

2. (Let blockInstLayer be {TYPE $empty_theta, CALLABLE $empty_callableDefEnv, STATE $empty_stateEnv, FRAME $empty_frame})

3. (Let localInstLayer be {TYPE $empty_theta, FRAMES [$empty_frame]})

4. (Let IC be {PATH [], GLOBAL globalInstLayer, BLOCK blockInstLayer, LOCAL localInstLayer})

5. Return IC

def $enter_i(IC)

1. Return IC[LOCAL.FRAMES = $empty_frame :: IC.LOCAL.FRAMES]

def $exit_i(IC)

1. (Let (frame)*{frame <- frame*} be IC.LOCAL.FRAMES)

2. (Let frame_h :: (frame_t)*{frame_t <- frame_t*} be (frame)*{frame <- frame*}, (frame)*{frame <- frame*} matches pattern _ :: _)

  1. Return IC[LOCAL.FRAMES = (frame_t)*{frame_t <- frame_t*}]

def $enter_path_i(IC, id)

1. Return IC[PATH = IC.PATH ++ [id]]

def $inherit_i(p, IC)

1. Case analysis on p

  1. Case (% matches pattern `GLOBAL`)

    1. (Let blockInstLayer be {TYPE $empty_theta, CALLABLE $empty_callableDefEnv, STATE $empty_stateEnv, FRAME $empty_frame})

    2. (Let localInstLayer be {TYPE $empty_theta, FRAMES [$empty_frame]})

    3. Return IC[BLOCK = blockInstLayer][LOCAL = localInstLayer]

  2. Case (% matches pattern `BLOCK`)

    1. (Let localInstLayer be {TYPE $empty_theta, FRAMES [$empty_frame]})

    2. Return IC[LOCAL = localInstLayer]

  3. Case (% matches pattern `LOCAL`)

    1. Return IC

def $add_var_i(p, IC, id, value)

1. Case analysis on p

  1. Case (% matches pattern `GLOBAL`)

    1. If (~$in_set<id>(id, $dom_map<id, value>(IC.GLOBAL.FRAME))), then

      1. (Let frame be $add_map<id, value>(IC.GLOBAL.FRAME, id, value))

      2. Return IC[GLOBAL.FRAME = frame]

    1. Else Dangling#10136

  2. Case (% matches pattern `BLOCK`)

    1. If (~$in_set<id>(id, $dom_map<id, value>(IC.BLOCK.FRAME))), then

      1. (Let frame be $add_map<id, value>(IC.BLOCK.FRAME, id, value))

      2. Return IC[BLOCK.FRAME = frame]

    1. Else Dangling#10139

  3. Case (% matches pattern `LOCAL`)

    1. (Let (frame)*{frame <- frame*} be IC.LOCAL.FRAMES)

    2. (Let frame_h :: (frame_t)*{frame_t <- frame_t*} be (frame)*{frame <- frame*}, (frame)*{frame <- frame*} matches pattern _ :: _)

      1. If (~$in_set<id>(id, $dom_map<id, value>(frame_h))), then

        1. (Let frame_h' be $add_map<id, value>(frame_h, id, value))

        2. Return IC[LOCAL.FRAMES = frame_h' :: (frame_t)*{frame_t <- frame_t*}]

      1. Else Dangling#10145

def $add_vars_i(p, IC, (id)*{id <- id*}, (value)*{value <- value*})

1. Case analysis on (id)*{id <- id*}

  1. Case (% matches pattern [])

    1. If (((value)*{value <- value*} matches pattern [])), then

      1. Return IC

    1. Else Dangling#10149

  2. Case (let id_h :: (id_t)*{id_t <- id_t*} be %, % matches pattern _ :: _)

    1. (Let value_h :: (value_t)*{value_t <- value_t*} be (value)*{value <- value*}, (value)*{value <- value*} matches pattern _ :: _)

      1. (Let IC' be $add_var_i(p, IC, id_h, value_h))

      2. (Let IC'' be $add_vars_i(p, IC', (id_t)*{id_t <- id_t*}, (value_t)*{value_t <- value_t*}))

      3. Return IC''

def $add_typeDef_i(p, IC, typeId, typeDefIR)

1. If ((p matches pattern `GLOBAL`)), then

  1. (Let typeDefEnv be $add_map<typeId, typeDefIR>(IC.GLOBAL.TYPE, typeId, typeDefIR))

  2. Return IC[GLOBAL.TYPE = typeDefEnv]

1. Else Dangling#10157

def $add_parserState_i(IC, nameIR, parserStateIR)

1. If (~$in_set<nameIR>(nameIR, $dom_map<nameIR, parserStateIR>(IC.BLOCK.STATE))), then

  1. (Let stateEnv be $add_map<nameIR, parserStateIR>(IC.BLOCK.STATE, nameIR, parserStateIR))

  2. Return IC[BLOCK.STATE = stateEnv]

1. Else Dangling#10160

def $add_type_i(p, IC, typeId, typeIR)

1. Case analysis on p

  1. Case (% matches pattern `BLOCK`)

    1. (Let theta be $add_map<typeId, typeIR>(IC.BLOCK.TYPE, typeId, typeIR))

    2. Return IC[BLOCK.TYPE = theta]

  2. Case (% matches pattern `LOCAL`)

    1. (Let theta be $add_map<typeId, typeIR>(IC.LOCAL.TYPE, typeId, typeIR))

    2. Return IC[LOCAL.TYPE = theta]

1. Else Dangling#10163

def $add_types_i(p, IC, (typeId)*{typeId <- typeId*}, (typeIR)*{typeIR <- typeIR*})

1. Case analysis on (typeId)*{typeId <- typeId*}

  1. Case (% matches pattern [])

    1. If (((typeIR)*{typeIR <- typeIR*} matches pattern [])), then

      1. Return IC

    1. Else Dangling#10169

  2. Case (let typeId_h :: (typeId_t)*{typeId_t <- typeId_t*} be %, % matches pattern _ :: _)

    1. (Let typeIR_h :: (typeIR_t)*{typeIR_t <- typeIR_t*} be (typeIR)*{typeIR <- typeIR*}, (typeIR)*{typeIR <- typeIR*} matches pattern _ :: _)

      1. (Let IC' be $add_type_i(p, IC, typeId_h, typeIR_h))

      2. Return $add_types_i(p, IC', (typeId_t)*{typeId_t <- typeId_t*}, (typeIR_t)*{typeIR_t <- typeIR_t*})

def $add_callableDef_overload_i(p, IC, callableId, callableDef)

1. Case analysis on p

  1. Case (% matches pattern `GLOBAL`)

    1. If (~$in_set<callableId>(callableId, $dom_map<callableId, callableDef>(IC.GLOBAL.CALLABLE))), then

      1. (Let callableDefEnv be $add_map<callableId, callableDef>(IC.GLOBAL.CALLABLE, callableId, callableDef))

      2. Return IC[GLOBAL.CALLABLE = callableDefEnv]

    1. Else Dangling#10177

  2. Case (% matches pattern `BLOCK`)

    1. If (~$in_set<callableId>(callableId, $dom_map<callableId, callableDef>(IC.BLOCK.CALLABLE))), then

      1. (Let callableDefEnv be $add_map<callableId, callableDef>(IC.BLOCK.CALLABLE, callableId, callableDef))

      2. Return IC[BLOCK.CALLABLE = callableDefEnv]

    1. Else Dangling#10180

1. Else Dangling#10176

def $add_callableDef_non_overload_i(p, IC, callableId, callableDef)

1. Case analysis on p

  1. Case (% matches pattern `GLOBAL`)

    1. (Let (id `( (_id)*{_id <- _id*} `)) be callableId)

    2. (Let (`{ ((id_k `( (_id')*{_id' <- _id'*} `)))*{_id'* <- _id'**, id_k <- id_k*} `}) be $dom_map<callableId, callableDef>(IC.GLOBAL.CALLABLE))

    3. If (~$in_set<id>(id, (`{ (id_k)*{id_k <- id_k*} `}))), then

      1. (Let callableDefEnv be $add_map<callableId, callableDef>(IC.GLOBAL.CALLABLE, callableId, callableDef))

      2. Return IC[GLOBAL.CALLABLE = callableDefEnv]

    3. Else Dangling#10186

  2. Case (% matches pattern `BLOCK`)

    1. (Let (id `( (_id)*{_id <- _id*} `)) be callableId)

    2. (Let (`{ ((id_k `( (_id')*{_id' <- _id'*} `)))*{_id'* <- _id'**, id_k <- id_k*} `}) be $dom_map<callableId, callableDef>(IC.BLOCK.CALLABLE))

    3. If (~$in_set<id>(id, (`{ (id_k)*{id_k <- id_k*} `}))), then

      1. (Let callableDefEnv be $add_map<callableId, callableDef>(IC.BLOCK.CALLABLE, callableId, callableDef))

      2. Return IC[BLOCK.CALLABLE = callableDefEnv]

    3. Else Dangling#10191

1. Else Dangling#10183

def $find_callableDef_non_overload_i(p, IC, prefixedNameIR)

1. Block (2 arms)

Arm 1:

  1. (Let ('.' nameIR) be prefixedNameIR, prefixedNameIR matches pattern `. %`)

    1. Block (2 arms)

    Arm 1:

      1. If (($find_non_overloaded<callableDef>(IC.GLOBAL.CALLABLE, nameIR) matches pattern ())), then

        1. Return ?()

      1. Else Dangling#10196

    Arm 2:

      1. (Let (callableId, callableDef) be ! $find_non_overloaded<callableDef>(IC.GLOBAL.CALLABLE, nameIR))

        1. Return ?(((GLOBAL), callableId, callableDef))

Arm 2:

  1. Case analysis on p

    1. Case (% matches pattern `GLOBAL`)

      1. (Let (_BARE nameIR) be prefixedNameIR, prefixedNameIR matches pattern `_BARE %`)

        1. Return $find_callableDef_non_overload_i((GLOBAL), IC, ('.' nameIR))

    2. Case (% matches pattern `BLOCK`)

      1. (Let (_BARE nameIR) be prefixedNameIR, prefixedNameIR matches pattern `_BARE %`)

        1. Block (2 arms)

        Arm 1:

          1. (Let (callableId, callableDef) be ! $find_non_overloaded<callableDef>(IC.BLOCK.CALLABLE, nameIR))

            1. Return ?(((BLOCK), callableId, callableDef))

        Arm 2:

          1. If (($find_non_overloaded<callableDef>(IC.BLOCK.CALLABLE, nameIR) matches pattern ())), then

            1. Return $find_callableDef_non_overload_i((GLOBAL), IC, (_BARE nameIR))

          1. Else Dangling#10212

    3. Case (% matches pattern `LOCAL`)

      1. (Let (_BARE nameIR) be prefixedNameIR, prefixedNameIR matches pattern `_BARE %`)

        1. Return $find_callableDef_non_overload_i((BLOCK), IC, (_BARE nameIR))

def $add_constructorDef_i(IC, callableId, constructorDef)

1. (Let constructorDefEnv be $add_map<callableId, constructorDef>(IC.GLOBAL.CONSTRUCTOR, callableId, constructorDef))

2. Return IC[GLOBAL.CONSTRUCTOR = constructorDefEnv]

def $add_constructorDefs_i(IC, (callableId)*{callableId <- callableId*}, (constructorDef)*{constructorDef <- constructorDef*})

1. Case analysis on (callableId)*{callableId <- callableId*}

  1. Case (% matches pattern [])

    1. If (((constructorDef)*{constructorDef <- constructorDef*} matches pattern [])), then

      1. Return IC

    1. Else Dangling#10220

  2. Case (let callableId_h :: (callableId_t)*{callableId_t <- callableId_t*} be %, % matches pattern _ :: _)

    1. (Let constructorDef_h :: (constructorDef_t)*{constructorDef_t <- constructorDef_t*} be (constructorDef)*{constructorDef <- constructorDef*}, (constructorDef)*{constructorDef <- constructorDef*} matches pattern _ :: _)

      1. (Let IC' be $add_constructorDef_i(IC, callableId_h, constructorDef_h))

      2. (Let IC'' be $add_constructorDefs_i(IC', (callableId_t)*{callableId_t <- callableId_t*}, (constructorDef_t)*{constructorDef_t <- constructorDef_t*}))

      3. Return IC''

def $find_var_i(prefixedNameIR, p, IC)

1. Case analysis on prefixedNameIR

  1. Case (let ('.' id) be %, % matches pattern `. %`)

    1. (Let value be ! $find_map<id, value>(IC.GLOBAL.FRAME, id))

      1. Return value

  2. Case (let (_BARE id) be %, % matches pattern `_BARE %`)

    1. Case analysis on p

      1. Case (% matches pattern `GLOBAL`)

        1. (Let value be ! $find_map<id, value>(IC.GLOBAL.FRAME, id))

          1. Return value

      2. Case (% matches pattern `BLOCK`)

        1. Block (2 arms)

        Arm 1:

          1. (Let value be ! $find_map<id, value>(IC.BLOCK.FRAME, id))

            1. Return value

        Arm 2:

          1. If (($find_map<id, value>(IC.BLOCK.FRAME, id) matches pattern ())), then

            1. Return $find_var_i((_BARE id), (GLOBAL), IC)

          1. Else Dangling#10244

      3. Case (% matches pattern `LOCAL`)

        1. Block (2 arms)

        Arm 1:

          1. (Let value be ! $find_maps<id, value>(IC.LOCAL.FRAMES, id))

            1. Return value

        Arm 2:

          1. If (($find_maps<id, value>(IC.LOCAL.FRAMES, id) matches pattern ())), then

            1. Return $find_var_i((_BARE id), (BLOCK), IC)

          1. Else Dangling#10250

def $find_typeDef_i(_p, IC, prefixedNameIR)

1. Case analysis on prefixedNameIR

  1. Case (let (_BARE nameIR) be %, % matches pattern `_BARE %`)

    1. Return $find_map<typeId, typeDefIR>(IC.GLOBAL.TYPE, nameIR)

  2. Case (let ('.' nameIR) be %, % matches pattern `. %`)

    1. Return $find_map<typeId, typeDefIR>(IC.GLOBAL.TYPE, nameIR)

def $find_constructorDef_i(IC, prefixedNameIR, (argumentIR)*{argumentIR <- argumentIR*})

1. Case analysis on prefixedNameIR

  1. Case (let (_BARE nameIR) be %, % matches pattern `_BARE %`)

    1. (Let callTargetKey be $callTargetKey(nameIR, (argumentIR)*{argumentIR <- argumentIR*}))

    2. Return $find_overloaded<constructorDef>(IC.GLOBAL.CONSTRUCTOR, callTargetKey, $parameterListIR_of_constructorDef)

  2. Case (let ('.' nameIR) be %, % matches pattern `. %`)

    1. (Let callTargetKey be $callTargetKey(nameIR, (argumentIR)*{argumentIR <- argumentIR*}))

    2. Return $find_overloaded<constructorDef>(IC.GLOBAL.CONSTRUCTOR, callTargetKey, $parameterListIR_of_constructorDef)

def $subst_type_i(p, IC, typeIR)

1. Case analysis on p

  1. Case (% matches pattern `GLOBAL`)

    1. Return typeIR

  2. Case (% matches pattern `BLOCK`)

    1. (Let theta be IC.BLOCK.TYPE)

    2. (Let typeIR_subst be $subst_typeIR(theta, typeIR))

    3. Return typeIR_subst

  3. Case (% matches pattern `LOCAL`)

    1. (Let theta_block be IC.BLOCK.TYPE)

    2. (Let theta_local be IC.LOCAL.TYPE)

    3. (Let theta be $extend_map<typeId, typeIR>(theta_block, theta_local))

    4. (Let typeIR_subst be $subst_typeIR(theta, typeIR))

    5. Return typeIR_subst

relation Expr_inst: p IC STO |- (expressionIR '#' expressionNoteIR) : % %

1. Block (2 arms)

Arm 1:

  1. Group literalExpressionIR: p IC STO |- (expressionIR '#' expressionNoteIR) : % %

    1. Case analysis on expressionIR

      1. Case (let booleanLiteral be %, % has type booleanLiteral)

        1. (Let boolValue be $ite<boolValue>((booleanLiteral = (TRUE)), (_B true), (_B false)))

        2. Result in: % % % |- % : STO (boolValue as value)

      2. Case (let integerLiteral be %, % has type integerLiteral)

        1. Result in: % % % |- % : STO (integerLiteral as value)

      3. Case (let stringLiteral be %, % has type stringLiteral)

        1. Result in: % % % |- % : STO (stringLiteral as value)

    1. Else Dangling#10275

Arm 2:

  1. Case analysis on expressionIR

    1. Case (let prefixedNameIR be %, % has type prefixedNameIR)

      1. Group referenceExpressionIR: p IC STO |- ((prefixedNameIR as expressionIR) '#' expressionNoteIR) : % %

        1. (Let value be $find_var_i(prefixedNameIR, p, IC))

        2. Result in: % % % |- % : STO value

    2. Case (let defaultExpression be %, % has type defaultExpression)

      1. Group defaultExpressionIR: p IC STO |- ((('...') as expressionIR) '#' expressionNoteIR) : % %

        1. Result in: % % % |- % : STO ((DEFAULT) as value)

    3. Case (let (unop typedExpressionIR) be %, % has type unaryExpressionIR)

      1. Group unaryExpressionIR: p IC STO |- (((unop typedExpressionIR) as expressionIR) '#' expressionNoteIR) : % %

        1. (Expr_inst: p IC STO |- typedExpressionIR : STO_1 value)

        2. Result in: % % % |- % : STO_1 $un_op(unop, value)

    4. Case (let (typedExpressionIR_l binop typedExpressionIR_r) be %, % has type binaryExpressionIR)

      1. Group binaryExpressionIR: p IC STO |- (((typedExpressionIR_l binop typedExpressionIR_r) as expressionIR) '#' expressionNoteIR) : % %

        1. Block (2 arms)

        Arm 1:

          1. If (~binop is in [('&&'), ('||')]), then

            1. (Expr_inst: p IC STO |- typedExpressionIR_l : STO_1 value_l)

            2. (Expr_inst: p IC STO_1 |- typedExpressionIR_r : STO_2 value_r)

            3. Result in: % % % |- % : STO_2 $bin_op(binop, value_l, value_r)

          1. Else Dangling#10297

        Arm 2:

          1. Case analysis on binop

            1. Case (% matches pattern `&&`)

              1. (Expr_inst: p IC STO |- typedExpressionIR_l : STO_1 value)

              2. Case analysis on value

                1. Case (% = ((_B false) as value))

                  1. Result in: % % % |- % : STO_1 ((_B false) as value)

                2. Case (% = ((_B true) as value))

                  1. (Expr_inst: p IC STO_1 |- typedExpressionIR_r : STO_2 value_r)

                  2. Result in: % % % |- % : STO_2 value_r

              2. Else Dangling#10303

            2. Case (% matches pattern `||`)

              1. (Expr_inst: p IC STO |- typedExpressionIR_l : STO_1 value)

              2. Case analysis on value

                1. Case (% = ((_B true) as value))

                  1. Result in: % % % |- % : STO_1 ((_B true) as value)

                2. Case (% = ((_B false) as value))

                  1. (Expr_inst: p IC STO_1 |- typedExpressionIR_r : STO_2 value_r)

                  2. Result in: % % % |- % : STO_2 value_r

              2. Else Dangling#10308

          1. Else Dangling#10301

    5. Case (let (typedExpressionIR_cond '?' typedExpressionIR_true ':' typedExpressionIR_false) be %, % has type ternaryExpressionIR)

      1. Group ternaryExpressionIR: p IC STO |- (((typedExpressionIR_cond '?' typedExpressionIR_true ':' typedExpressionIR_false) as expressionIR) '#' expressionNoteIR) : % %

        1. (Expr_inst: p IC STO |- typedExpressionIR_cond : STO_1 value)

        2. Case analysis on value

          1. Case (% = ((_B true) as value))

            1. (Expr_inst: p IC STO_1 |- typedExpressionIR_true : STO_2 value_true)

            2. Result in: % % % |- % : STO_2 value_true

          2. Case (% = ((_B false) as value))

            1. (Expr_inst: p IC STO_1 |- typedExpressionIR_false : STO_2 value_false)

            2. Result in: % % % |- % : STO_2 value_false

        2. Else Dangling#10315

    6. Case (let (`( typeIR `) typedExpressionIR) be %, % has type castExpressionIR)

      1. Group castExpressionIR: p IC STO |- (((`( typeIR `) typedExpressionIR) as expressionIR) '#' expressionNoteIR) : % %

        1. (Expr_inst: p IC STO |- typedExpressionIR : STO_1 value)

        2. (Let value_cast be $cast_op(typeIR, value))

        3. Result in: % % % |- % : STO_1 value_cast

    7. Case (let invalidHeaderExpression be %, % has type invalidHeaderExpression)

      1. Group invalidHeaderExpressionIR: p IC STO |- ((('{#}') as expressionIR) '#' expressionNoteIR) : % %

        1. Result in: % % % |- % : STO (('{#}') as value)

    8. Case (let sequenceExpressionIR be %, % has type sequenceExpressionIR)

      1. Group sequenceExpressionIR: p IC STO |- ((sequenceExpressionIR as expressionIR) '#' expressionNoteIR) : % %

