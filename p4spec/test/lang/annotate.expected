def $free_typeDefIR(typeDefIR)

1. (Let ((typeParameterIR_expl)*{typeParameterIR_expl <- typeParameterIR_expl*}, (typeParameterIR_impl)*{typeParameterIR_impl <- typeParameterIR_impl*}) be $typeParameterListIR_of_typeDefIR(typeDefIR))

