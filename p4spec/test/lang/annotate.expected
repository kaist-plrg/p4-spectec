syntax theta = map<typeId, typeIR>

def $empty_theta

1. Return $empty_map<typeId, typeIR>

def $capture_avoiding_(theta, (typeParameterIR)*{typeParameterIR <- typeParameterIR*}, B)

1. (Let (`{ (typeId_free)*{typeId_free <- typeId_free*} `}) be $diff_set<typeId>(B, (`{ (typeParameterIR)*{typeParameterIR <- typeParameterIR*} `})))

2. (Let (typeIR)?{typeIR <- typeIR?} be $find_map<typeId, typeIR>(theta, typeId_free))*

3. If (((typeIR)?{typeIR <- typeIR?} matches pattern (_)))*{typeIR? <- typeIR?*}, then

  1. (Let ?(typeIR_free) be (typeIR)?{typeIR <- typeIR?})*

  2. (Let bound be $free_typeIR(typeIR_free))*

  3. (Let B_capture be $unions_set<typeId>((bound)*{bound <- bound*}))

  4. (Let (typeParameterIR_fresh)*{typeParameterIR_fresh <- typeParameterIR_fresh*} be $fresh_typeIds(|(typeParameterIR)*{typeParameterIR <- typeParameterIR*}|))

  5. If (~$in_set<typeId>(typeParameterIR_fresh, B_capture))*{typeParameterIR_fresh <- typeParameterIR_fresh*}, then

    1. (Let theta_fresh be $adds_map<typeId, typeIR>(theta, (typeParameterIR)*{typeParameterIR <- typeParameterIR*}, (((_NAME typeParameterIR_fresh) as typeIR))*{typeParameterIR_fresh <- typeParameterIR_fresh*}))

    2. Return (theta_fresh, (typeParameterIR_fresh)*{typeParameterIR_fresh <- typeParameterIR_fresh*})

  5. Else Dangling#1020

3. Else Dangling#1016

def $capture_avoiding(theta, (typeParameterIR_expl)*{typeParameterIR_expl <- typeParameterIR_expl*}, (typeParameterIR_impl)*{typeParameterIR_impl <- typeParameterIR_impl*}, B)

1. (Let (`{ (typeId_free)*{typeId_free <- typeId_free*} `}) be $diff_set<typeId>(B, (`{ (typeParameterIR_expl)*{typeParameterIR_expl <- typeParameterIR_expl*} ++ (typeParameterIR_impl)*{typeParameterIR_impl <- typeParameterIR_impl*} `})))

2. (Let (typeIR)?{typeIR <- typeIR?} be $find_map<typeId, typeIR>(theta, typeId_free))*

3. If (((typeIR)?{typeIR <- typeIR?} matches pattern (_)))*{typeIR? <- typeIR?*}, then

  1. (Let ?(typeIR_free) be (typeIR)?{typeIR <- typeIR?})*

  2. (Let bound be $free_typeIR(typeIR_free))*

  3. (Let B_capture be $unions_set<typeId>((bound)*{bound <- bound*}))

  4. (Let (typeId_fresh)*{typeId_fresh <- typeId_fresh*} be $fresh_typeIds(|(typeParameterIR_expl)*{typeParameterIR_expl <- typeParameterIR_expl*} ++ (typeParameterIR_impl)*{typeParameterIR_impl <- typeParameterIR_impl*}|))

  5. If (~$in_set<typeId>(typeId_fresh, B_capture))*{typeId_fresh <- typeId_fresh*}, then

    1. (Let (typeParameterIR_expl_fresh)*{typeParameterIR_expl_fresh <- typeParameterIR_expl_fresh*} be (typeId_fresh)*{typeId_fresh <- typeId_fresh*}[0 : |(typeParameterIR_expl)*{typeParameterIR_expl <- typeParameterIR_expl*}|])

    2. (Let (typeParameterIR_impl_fresh)*{typeParameterIR_impl_fresh <- typeParameterIR_impl_fresh*} be (typeId_fresh)*{typeId_fresh <- typeId_fresh*}[|(typeParameterIR_expl)*{typeParameterIR_expl <- typeParameterIR_expl*}| : |(typeParameterIR_impl)*{typeParameterIR_impl <- typeParameterIR_impl*}|])

    3. (Let theta_fresh be $adds_map<typeId, typeIR>(theta, (typeParameterIR_expl)*{typeParameterIR_expl <- typeParameterIR_expl*} ++ (typeParameterIR_impl)*{typeParameterIR_impl <- typeParameterIR_impl*}, (((_NAME typeParameterIR_expl_fresh) as typeIR))*{typeParameterIR_expl_fresh <- typeParameterIR_expl_fresh*} ++ (((_NAME typeParameterIR_impl_fresh) as typeIR))*{typeParameterIR_impl_fresh <- typeParameterIR_impl_fresh*}))

    4. Return (theta_fresh, (typeParameterIR_expl_fresh)*{typeParameterIR_expl_fresh <- typeParameterIR_expl_fresh*}, (typeParameterIR_impl_fresh)*{typeParameterIR_impl_fresh <- typeParameterIR_impl_fresh*})

  5. Else Dangling#1029

3. Else Dangling#1025

def $subst_typeIR(set<pair<typeId, typeIR>>, typeIR)

1. If ((set<pair<typeId, typeIR>> = (`{ [] `}))), then

  1. Return typeIR

2. Otherwise,

  1. Return $subst_typeIR'(set<pair<typeId, typeIR>>, typeIR)

def $subst_typeIR'(theta, typeIR')

1. Case analysis on typeIR'

  1. Case (let baseTypeIR be %, % has type baseTypeIR)

    1. Return (baseTypeIR as typeIR)

  2. Case (let (_NAME typeId) be %, % has type nameTypeIR)

    1. Block (2 arms)

    Arm 1:

      1. (Let typeIR be ! $find_map<typeId, typeIR>(theta, typeId))

        1. Return typeIR

    Arm 2:

      1. If (($find_map<typeId, typeIR>(theta, typeId) matches pattern ())), then

        1. Return ((_NAME typeId) as typeIR)

      1. Else Dangling#1045

  3. Case (let (TYPEDEF typeId typeIR) be %, % has type typedefTypeIR)

    1. (Let typeIR_subst be $subst_typeIR'(theta, typeIR))

    2. Return ((TYPEDEF typeId typeIR_subst) as typeIR)

  4. Case (let (TYPE typeId typeIR) be %, % has type newTypeIR)

    1. (Let typeIR_subst be $subst_typeIR'(theta, typeIR))

    2. Return ((TYPE typeId typeIR_subst) as typeIR)

  5. Case (let (LIST `< typeIR `>) be %, % has type listTypeIR)

    1. (Let typeIR_subst be $subst_typeIR'(theta, typeIR))

    2. Return ((LIST `< typeIR_subst `>) as typeIR)

  6. Case (let (TUPLE `< (typeIR)*{typeIR <- typeIR*} `>) be %, % has type tupleTypeIR)

    1. (Let typeIR_subst be $subst_typeIR'(theta, typeIR))*

    2. Return ((TUPLE `< (typeIR_subst)*{typeIR_subst <- typeIR_subst*} `>) as typeIR)

  7. Case (let (ARRAY typeIR `[ n_size `]) be %, % has type arrayTypeIR)

    1. (Let typeIR_subst be $subst_typeIR'(theta, typeIR))

    2. Return ((ARRAY typeIR_subst `[ n_size `]) as typeIR)

  8. Case (let (HEADER_STACK typeIR `[ n_size `]) be %, % has type headerStackTypeIR)

    1. (Let typeIR_subst be $subst_typeIR'(theta, typeIR))

    2. Return ((HEADER_STACK typeIR_subst `[ n_size `]) as typeIR)

  9. Case (let structTypeIR be %, % has type structTypeIR)

    1. (Let (STRUCT typeId `< (typeArgumentIR)*{typeArgumentIR <- typeArgumentIR*} `> `{ ((annotationList typeIR_field nameIR_field ';'))*{annotationList <- annotationList*, nameIR_field <- nameIR_field*, typeIR_field <- typeIR_field*} `}) be structTypeIR)

    2. (Let typeArgumentIR_subst be $subst_typeIR'(theta, typeArgumentIR))*

    3. (Let typeIR_field_subst be $subst_typeIR'(theta, typeIR_field))*

    4. (Let structTypeIR_subst be (STRUCT typeId `< (typeArgumentIR_subst)*{typeArgumentIR_subst <- typeArgumentIR_subst*} `> `{ ((annotationList typeIR_field_subst nameIR_field ';'))*{annotationList <- annotationList*, nameIR_field <- nameIR_field*, typeIR_field_subst <- typeIR_field_subst*} `}))

    5. Return (structTypeIR_subst as typeIR)

  10. Case (let headerTypeIR be %, % has type headerTypeIR)

    1. (Let (HEADER typeId `< (typeArgumentIR)*{typeArgumentIR <- typeArgumentIR*} `> `{ ((annotationList typeIR_field nameIR_field ';'))*{annotationList <- annotationList*, nameIR_field <- nameIR_field*, typeIR_field <- typeIR_field*} `}) be headerTypeIR)

    2. (Let typeArgumentIR_subst be $subst_typeIR'(theta, typeArgumentIR))*

    3. (Let typeIR_field_subst be $subst_typeIR'(theta, typeIR_field))*

    4. (Let headerTypeIR_subst be (HEADER typeId `< (typeArgumentIR_subst)*{typeArgumentIR_subst <- typeArgumentIR_subst*} `> `{ ((annotationList typeIR_field_subst nameIR_field ';'))*{annotationList <- annotationList*, nameIR_field <- nameIR_field*, typeIR_field_subst <- typeIR_field_subst*} `}))

    5. Return (headerTypeIR_subst as typeIR)

  11. Case (let headerUnionTypeIR be %, % has type headerUnionTypeIR)

    1. (Let (HEADER_UNION typeId `< (typeArgumentIR)*{typeArgumentIR <- typeArgumentIR*} `> `{ ((annotationList typeIR_field nameIR_field ';'))*{annotationList <- annotationList*, nameIR_field <- nameIR_field*, typeIR_field <- typeIR_field*} `}) be headerUnionTypeIR)

    2. (Let typeArgumentIR_subst be $subst_typeIR'(theta, typeArgumentIR))*

    3. (Let typeIR_field_subst be $subst_typeIR'(theta, typeIR_field))*

    4. (Let headerUnionTypeIR_subst be (HEADER_UNION typeId `< (typeArgumentIR_subst)*{typeArgumentIR_subst <- typeArgumentIR_subst*} `> `{ ((annotationList typeIR_field_subst nameIR_field ';'))*{annotationList <- annotationList*, nameIR_field <- nameIR_field*, typeIR_field_subst <- typeIR_field_subst*} `}))

    5. Return (headerUnionTypeIR_subst as typeIR)

  12. Case (let (ENUM typeId `{ (id_field)*{id_field <- id_field*} `}) be %, % has type simpleEnumTypeIR)

    1. Return ((ENUM typeId `{ (id_field)*{id_field <- id_field*} `}) as typeIR)

  13. Case (let (ENUM typeId `< typeIR `> `{ (valueFieldIR)*{valueFieldIR <- valueFieldIR*} `}) be %, % has type serializableEnumTypeIR)

    1. (Let typeIR_subst be $subst_typeIR'(theta, typeIR))

    2. Return ((ENUM typeId `< typeIR_subst `> `{ (valueFieldIR)*{valueFieldIR <- valueFieldIR*} `}) as typeIR)

  14. Case (let externObjectTypeIR be %, % has type externObjectTypeIR)

    1. (Let (EXTERN typeId `< (typeArgumentIR)*{typeArgumentIR <- typeArgumentIR*} `> (`{ ((callableId ':' externMethodTypeDefIR))*{callableId <- callableId*, externMethodTypeDefIR <- externMethodTypeDefIR*} `})) be externObjectTypeIR)

    2. (Let typeArgumentIR_subst be $subst_typeIR'(theta, typeArgumentIR))*

    3. (Let callableTypeDefIR be $subst_callableTypeDefIR(theta, (externMethodTypeDefIR as callableTypeDefIR)))*

    4. If ((callableTypeDefIR has type externMethodTypeDefIR))*{callableTypeDefIR <- callableTypeDefIR*}, then

      1. (Let externMethodTypeDefIR_subst be (callableTypeDefIR as externMethodTypeDefIR))*

      2. (Let externObjectTypeIR_subst be (EXTERN typeId `< (typeArgumentIR_subst)*{typeArgumentIR_subst <- typeArgumentIR_subst*} `> (`{ ((callableId ':' externMethodTypeDefIR_subst))*{callableId <- callableId*, externMethodTypeDefIR_subst <- externMethodTypeDefIR_subst*} `})))

      3. Return (externObjectTypeIR_subst as typeIR)

    4. Else Dangling#1092

  15. Case (let parserObjectTypeIR be %, % has type parserObjectTypeIR)

    1. (Let (PARSER typeId `< (typeArgumentIR)*{typeArgumentIR <- typeArgumentIR*} `> `( (parameterIR)*{parameterIR <- parameterIR*} `)) be parserObjectTypeIR)

    2. (Let typeArgumentIR_subst be $subst_typeIR'(theta, typeArgumentIR))*

    3. (Let parameterIR_subst be $subst_parameterIR'(theta, parameterIR))*

    4. (Let parserObjectTypeIR_subst be (PARSER typeId `< (typeArgumentIR_subst)*{typeArgumentIR_subst <- typeArgumentIR_subst*} `> `( (parameterIR_subst)*{parameterIR_subst <- parameterIR_subst*} `)))

    5. Return (parserObjectTypeIR_subst as typeIR)

  16. Case (let controlObjectTypeIR be %, % has type controlObjectTypeIR)

    1. (Let (CONTROL typeId `< (typeArgumentIR)*{typeArgumentIR <- typeArgumentIR*} `> `( (parameterIR)*{parameterIR <- parameterIR*} `)) be controlObjectTypeIR)

    2. (Let typeArgumentIR_subst be $subst_typeIR'(theta, typeArgumentIR))*

    3. (Let parameterIR_subst be $subst_parameterIR'(theta, parameterIR))*

    4. (Let controlObjectTypeIR_subst be (CONTROL typeId `< (typeArgumentIR_subst)*{typeArgumentIR_subst <- typeArgumentIR_subst*} `> `( (parameterIR_subst)*{parameterIR_subst <- parameterIR_subst*} `)))

    5. Return (controlObjectTypeIR_subst as typeIR)

  17. Case (let packageObjectTypeIR be %, % has type packageObjectTypeIR)

    1. (Let (PACKAGE typeId `< (typeArgumentIR)*{typeArgumentIR <- typeArgumentIR*} `> `{ (typeIR)*{typeIR <- typeIR*} `}) be packageObjectTypeIR)

    2. (Let typeArgumentIR_subst be $subst_typeIR'(theta, typeArgumentIR))*

    3. (Let typeIR_subst be $subst_typeIR'(theta, typeIR))*

    4. (Let packageObjectTypeIR_subst be (PACKAGE typeId `< (typeArgumentIR_subst)*{typeArgumentIR_subst <- typeArgumentIR_subst*} `> `{ (typeIR_subst)*{typeIR_subst <- typeIR_subst*} `}))

    5. Return (packageObjectTypeIR_subst as typeIR)

  18. Case (let tableObjectTypeIR be %, % has type tableObjectTypeIR)

    1. Return (tableObjectTypeIR as typeIR)

  19. Case (let defaultTypeIR be %, % has type defaultTypeIR)

    1. Return ((DEFAULT) as typeIR)

  20. Case (let invalidHeaderTypeIR be %, % has type invalidHeaderTypeIR)

    1. Return ((HEADER_INVALID) as typeIR)

  21. Case (let sequenceTypeIR be %, % has type sequenceTypeIR)

    1. Case analysis on sequenceTypeIR

      1. Case (let (SEQ `< (typeIR)*{typeIR <- typeIR*} `>) be %, % matches pattern `SEQ <%>`)

        1. (Let typeIR_subst be $subst_typeIR'(theta, typeIR))*

        2. Return ((SEQ `< (typeIR_subst)*{typeIR_subst <- typeIR_subst*} `>) as typeIR)

      2. Case (let (SEQ `< (typeIR)*{typeIR <- typeIR*} ',' '...' `>) be %, % matches pattern `SEQ <% , ...>`)

        1. (Let typeIR_subst be $subst_typeIR'(theta, typeIR))*

        2. Return ((SEQ `< (typeIR_subst)*{typeIR_subst <- typeIR_subst*} ',' '...' `>) as typeIR)

  22. Case (let recordTypeIR be %, % has type recordTypeIR)

    1. Case analysis on recordTypeIR

      1. Case (let (RECORD `{ ((annotationList typeIR_field id_field ';'))*{annotationList <- annotationList*, id_field <- id_field*, typeIR_field <- typeIR_field*} `}) be %, % matches pattern `RECORD {%}`)

        1. (Let typeIR_field_subst be $subst_typeIR'(theta, typeIR_field))*

        2. Return ((RECORD `{ ((annotationList typeIR_field_subst id_field ';'))*{annotationList <- annotationList*, id_field <- id_field*, typeIR_field_subst <- typeIR_field_subst*} `}) as typeIR)

      2. Case (let (RECORD `{ ((annotationList typeIR_field id_field ';'))*{annotationList <- annotationList*, id_field <- id_field*, typeIR_field <- typeIR_field*} ',' '...' `}) be %, % matches pattern `RECORD {% , ...}`)

        1. (Let typeIR_field_subst be $subst_typeIR'(theta, typeIR_field))*

        2. Return ((RECORD `{ ((annotationList typeIR_field_subst id_field ';'))*{annotationList <- annotationList*, id_field <- id_field*, typeIR_field_subst <- typeIR_field_subst*} ',' '...' `}) as typeIR)

  23. Case (let (SET `< typeIR `>) be %, % has type setTypeIR)

    1. (Let typeIR_subst be $subst_typeIR'(theta, typeIR))

    2. Return ((SET `< typeIR_subst `>) as typeIR)

  24. Case (let tableMetadataTypeIR be %, % has type tableMetadataTypeIR)

    1. Return (tableMetadataTypeIR as typeIR)

