                      2. Else Dangling#11638

                    2. Case (let structValue_base be %, % has type structValue)

                      1. (Let (STRUCT _typeId `{ ((value_field id_field ';'))*{id_field <- id_field*, value_field <- value_field*} `}) be structValue_base)

                      2. (Let value_member be ! $assoc_<nameIR, value>(nameIR, ((id_field, value_field))*{id_field <- id_field*, value_field <- value_field*}))

