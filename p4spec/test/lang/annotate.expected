  11. Case (let (HEADER_UNION _typeId `< (typeArgumentIR)*{typeArgumentIR <- typeArgumentIR*} `> `{ ((_annotationList typeIR_field _nameIR ';'))*{_annotationList <- _annotationList*, _nameIR <- _nameIR*, typeIR_field <- typeIR_field*} `}) be %, % has type headerUnionTypeIR)

