relation PSA_ingress_parser: EC_0 ARCH_0 |- % % %

1. Group : EC_0 ARCH_0 |- % % %

  1. (Let argumentIR_packet_in be $PSA_setup_ingress_packet_in_argument(EC_0))

  2. (Let argumentIR_hdr be $PSA_setup_ingress_hdr_argument(ARCH_0))

  3. (Let argumentIR_user_meta be $PSA_setup_ingress_user_meta_argument(ARCH_0))

  4. (Let argumentIR_parser_input_metadata be $PSA_setup_ingress_parser_input_metadata_argument(EC_0))

  5. (Let argumentIR_resubmit_meta be $PSA_setup_resubmit_meta_argument(ARCH_0))

  6. (Let argumentIR_recirculate_meta be $PSA_setup_recirculate_meta_argument(ARCH_0))

  7. (Let (argumentIR)*{argumentIR <- argumentIR*} be [argumentIR_packet_in, argumentIR_hdr, argumentIR_user_meta, argumentIR_parser_input_metadata, argumentIR_resubmit_meta, argumentIR_recirculate_meta])

  8. (Let typedExpressionIR_main be $PSA_setup_main_callee(EC_0, ARCH_0))

  9. (Let typedExpressionIR_ingress_pipeline be $PSA_setup_ingress_pipeline_callee(EC_0, ARCH_0, typedExpressionIR_main))

  10. (Let typedExpressionIR_ip be $PSA_setup_ingress_parser_callee(EC_0, ARCH_0, typedExpressionIR_ingress_pipeline))

  11. (Let callableTargetIR be (typedExpressionIR_ip '.' "apply"))

  12. (Stmt_eval: (GLOBAL) EC_0 ARCH_0 |- ((callableTargetIR `< [] `> `( (argumentIR)*{argumentIR <- argumentIR*} `) ';') as statementIR) : EC_1 ARCH_1 statementResult)

  13. Case analysis on statementResult

    1. Case (let continueEmptyResult be %, % has type continueEmptyResult)

      1. Result in: % % |- EC_1 ARCH_1 ((ACCEPT) as transitionResult)

    2. Case (let rejectTransitionResult be %, % has type rejectTransitionResult)

      1. Result in: % % |- EC_1 ARCH_1 (rejectTransitionResult as transitionResult)

  13. Else Dangling#14800

relation PSA_ingress: EC_0 ARCH_0 |- % % %

1. Group : EC_0 ARCH_0 |- % % %

  1. (Let argumentIR_hdr be $PSA_setup_ingress_hdr_argument(ARCH_0))

