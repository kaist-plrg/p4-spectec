  18. Case (let (annotationList PACKAGE nameIR `< typeParameterListIR ',' typeParameterListIR_inferred `> `( (parameterIR)*{parameterIR <- parameterIR*} `) ';') be %, % has type packageTypeDeclarationIR)

    1. Group packageTypeDeclarationIR: IC_0 STO |- ((annotationList PACKAGE nameIR `< typeParameterListIR ',' typeParameterListIR_inferred `> `( (parameterIR)*{parameterIR <- parameterIR*} `) ';') as declarationIR) : % %

