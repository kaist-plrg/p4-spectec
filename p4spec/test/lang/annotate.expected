def $cast_op(typeIR, value)

1. Case analysis on value

  1. Case (let boolValue be %, % has type boolValue)

    1. (Let typeIR_unroll be $unroll_typeIR(typeIR))

    2. Return $cast_bool(typeIR_unroll, boolValue)

  2. Case (let integerValue be %, % has type integerValue)

    1. (Let typeIR_unroll be $unroll_typeIR(typeIR))

    2. Return $cast_int(typeIR_unroll, integerValue)

  3. Case (let errorValue be %, % has type errorValue)

    1. (Let typeIR_unroll be $unroll_typeIR(typeIR))

    2. Return $cast_error(typeIR_unroll, errorValue)

  4. Case (let stringValue be %, % has type stringValue)

    1. (Let typeIR_unroll be $unroll_typeIR(typeIR))

    2. Return $cast_string(typeIR_unroll, stringValue)

  5. Case (let listValue be %, % has type listValue)

    1. (Let typeIR_unroll be $unroll_typeIR(typeIR))

    2. Return $cast_list(typeIR_unroll, listValue)

  6. Case (let tupleValue be %, % has type tupleValue)

    1. (Let typeIR_unroll be $unroll_typeIR(typeIR))

    2. Return $cast_tuple(typeIR_unroll, tupleValue)

  7. Case (let arrayValue be %, % has type arrayValue)

    1. (Let typeIR_unroll be $unroll_typeIR(typeIR))

    2. Return $cast_array(typeIR_unroll, arrayValue)

  8. Case (let headerStackValue be %, % has type headerStackValue)

    1. (Let typeIR_unroll be $unroll_typeIR(typeIR))

    2. Return $cast_header_stack(typeIR_unroll, headerStackValue)

  9. Case (let structValue be %, % has type structValue)

    1. (Let typeIR_unroll be $unroll_typeIR(typeIR))

    2. Return $cast_struct(typeIR_unroll, structValue)

  10. Case (let headerValue be %, % has type headerValue)

    1. (Let typeIR_unroll be $unroll_typeIR(typeIR))

    2. Return $cast_header(typeIR_unroll, headerValue)

  11. Case (let enumValue be %, % has type enumValue)

    1. (Let typeIR_unroll be $unroll_typeIR(typeIR))

    2. Return $cast_enum(typeIR_unroll, enumValue)

  12. Case (let sequenceValue be %, % has type sequenceValue)

    1. (Let typeIR_unroll be $unroll_typeIR(typeIR))

    2. Return $cast_sequence(typeIR_unroll, sequenceValue)

  13. Case (let recordValue be %, % has type recordValue)

    1. (Let typeIR_unroll be $unroll_typeIR(typeIR))

    2. Return $cast_record(typeIR_unroll, recordValue)

  14. Case (let defaultValue be %, % has type defaultValue)

    1. (Let typeIR_unroll be $unroll_typeIR(typeIR))

    2. Return $cast_default(typeIR_unroll, (DEFAULT))

  15. Case (% has type invalidHeaderValue)

    1. (Let typeIR_unroll be $unroll_typeIR(typeIR))

    2. Return $cast_invalid_header(typeIR_unroll)

  16. Case (let setValue be %, % has type setValue)

    1. (Let typeIR_unroll be $unroll_typeIR(typeIR))

    2. Return $cast_set(typeIR_unroll, setValue)

1. Else Dangling#2215

def $default(typeIR')

1. Case analysis on typeIR'

  1. Case (let boolTypeIR be %, % has type boolTypeIR)

    1. Return ((_B false) as value)

  2. Case (let errorTypeIR be %, % has type errorTypeIR)

    1. Return ((ERROR '.' "NoError") as value)

  3. Case (let stringTypeIR be %, % has type stringTypeIR)

    1. (Let text_empty be "")

    2. Return (('"' text_empty '"') as value)

  4. Case (let intTypeIR be %, % has type intTypeIR)

    1. Return ((D (0 as int)) as value)

  5. Case (let (BIT `< w `>) be %, % has type fixedBitTypeIR)

    1. Return ((w W (0 as int)) as value)

  6. Case (let (INT `< w `>) be %, % has type fixedIntTypeIR)

    1. Return ((w S (0 as int)) as value)

  7. Case (let (VARBIT `< w `>) be %, % has type varBitTypeIR)

    1. Return ((w '.' 0 V (0 as int)) as value)

  8. Case (let (TYPEDEF _typeId typeIR) be %, % has type typedefTypeIR)

    1. Return $default(typeIR)

  9. Case (let (TYPE _typeId typeIR) be %, % has type newTypeIR)

    1. Return $default(typeIR)

  10. Case (let (TUPLE `< (typeIR)*{typeIR <- typeIR*} `>) be %, % has type tupleTypeIR)

    1. (Let value' be $default(typeIR))*

    2. Return ((TUPLE `( (value')*{value' <- value'*} `)) as value)

  11. Case (let (ARRAY typeIR `[ n_s `]) be %, % has type arrayTypeIR)

    1. (Let value'' be $default(typeIR))

    2. (Let (value)*{value <- value*} be $repeat_<value>(value'', n_s))

    3. Return ((ARRAY `[ (value)*{value <- value*} `]) as value)

  12. Case (let (HEADER_STACK typeIR `[ n_s `]) be %, % has type headerStackTypeIR)

    1. (Let value''' be $default(typeIR))

    2. (Let (value)*{value <- value*} be $repeat_<value>(value''', n_s))

    3. Return ((HEADER_STACK `[ (value)*{value <- value*} `( 0 `) `]) as value)

  13. Case (let (STRUCT typeId `< (_typeArgumentIR)*{_typeArgumentIR <- _typeArgumentIR*} `> `{ ((_annotationList typeIR_f id_f ';'))*{_annotationList <- _annotationList*, id_f <- id_f*, typeIR_f <- typeIR_f*} `}) be %, % has type structTypeIR)

    1. (Let value'''' be $default(typeIR_f))*

    2. Return ((STRUCT typeId `{ ((value'''' id_f ';'))*{value'''' <- value''''*, id_f <- id_f*} `}) as value)

  14. Case (let (HEADER typeId `< (_typeArgumentIR)*{_typeArgumentIR <- _typeArgumentIR*} `> `{ ((_annotationList typeIR_f id_f ';'))*{_annotationList <- _annotationList*, id_f <- id_f*, typeIR_f <- typeIR_f*} `}) be %, % has type headerTypeIR)

    1. (Let value''''' be $default(typeIR_f))*

    2. Return ((HEADER typeId `{ false ';' ((value''''' id_f ';'))*{value''''' <- value'''''*, id_f <- id_f*} `}) as value)

  15. Case (let (HEADER_UNION typeId `< (_typeArgumentIR)*{_typeArgumentIR <- _typeArgumentIR*} `> `{ ((_annotationList typeIR_f id_f ';'))*{_annotationList <- _annotationList*, id_f <- id_f*, typeIR_f <- typeIR_f*} `}) be %, % has type headerUnionTypeIR)

    1. (Let value'''''' be $default(typeIR_f))*

    2. Return ((HEADER_UNION typeId `{ ((value'''''' id_f ';'))*{value'''''' <- value''''''*, id_f <- id_f*} `}) as value)

  16. Case (let (ENUM typeId `{ (id)*{id <- id*} `}) be %, % has type simpleEnumTypeIR)

    1. (Let id_f_h :: (_id)*{_id <- _id*} be (id)*{id <- id*}, (id)*{id <- id*} matches pattern _ :: _)

      1. Return ((typeId '.' id_f_h) as value)

  17. Case (let (ENUM typeId `< typeIR `> `{ ((nameIR_field '=' value_field ';'))*{nameIR_field <- nameIR_field*, value_field <- value_field*} `}) be %, % has type serializableEnumTypeIR)

    1. (Let value_zero be $cast_int(typeIR, ((D (0 as int)) as integerValue)))

    2. Block (2 arms)

    Arm 1:

      1. (Let id_zero be ! $assoc_<value, id>(value_zero, ((value_field, nameIR_field))*{nameIR_field <- nameIR_field*, value_field <- value_field*}))

        1. Return ((typeId '.' id_zero '.' value_zero) as value)

    Arm 2:

      1. If (($assoc_<value, id>(value_zero, ((value_field, nameIR_field))*{nameIR_field <- nameIR_field*, value_field <- value_field*}) matches pattern ())), then

        1. (Let id_zero be "__UNSPECIFIED")

        2. Return ((typeId '.' id_zero '.' value_zero) as value)

      1. Else Dangling#2307

1. Else Dangling#2263

def $cast_to_enum(enumTypeIR, value)

1. (Let (ENUM typeId `< typeIR `> `{ (valueFieldIR)*{valueFieldIR <- valueFieldIR*} `}) be enumTypeIR, enumTypeIR has type serializableEnumTypeIR)

  1. Return $cast_to_enum'(typeId, typeIR, (valueFieldIR)*{valueFieldIR <- valueFieldIR*}, value)

def $cast_to_enum'(typeId, typeIR, (valueFieldIR)*{valueFieldIR <- valueFieldIR*}, value_target)

1. Case analysis on (valueFieldIR)*{valueFieldIR <- valueFieldIR*}

  1. Case (% matches pattern [])

    1. (Let value_idx be $cast_op(typeIR, value_target))

    2. (Let id_unnamed be "__UNSPECIFIED")

    3. Return ((typeId '.' id_unnamed '.' value_idx) as value)

  2. Case (let valueFieldIR_h :: (valueFieldIR_t)*{valueFieldIR_t <- valueFieldIR_t*} be %, % matches pattern _ :: _)

    1. (Let (nameIR '=' value ';') be valueFieldIR_h)

    2. Case analysis on $bin_eq(value, value_target)

      1. Case true

        1. Return ((typeId '.' nameIR '.' value) as value)

      2. Case false

        1. Return $cast_to_enum'(typeId, typeIR, (valueFieldIR_t)*{valueFieldIR_t <- valueFieldIR_t*}, value_target)

def $cast_bool(typeIR', boolValue)

1. Block (2 arms)

Arm 1:

  1. (Let (_B b) be boolValue)

  2. (Let boolTypeIR be typeIR', typeIR' has type boolTypeIR)

    1. Return ((_B b) as value)

Arm 2:

  1. Case analysis on typeIR'

    1. Case (let (BIT `< w `>) be %, % has type fixedBitTypeIR)

      1. Case analysis on boolValue

        1. Case (% = (_B true))

          1. Return ((w W (1 as int)) as value)

        2. Case (% = (_B false))

          1. Return ((w W (0 as int)) as value)

      1. Else Dangling#2328

    2. Case (let (TYPE _typeId typeIR) be %, % has type newTypeIR)

      1. Return $cast_bool(typeIR, boolValue)

    3. Case (let (SET `< typeIR `>) be %, % has type setTypeIR)

      1. (Let value be $cast_bool(typeIR, boolValue))

      2. Return ((SET `{ value `}) as value)

  1. Else Dangling#2326

def $cast_int(typeIR', integerValue)

1. Case analysis on typeIR'

  1. Case (let boolTypeIR be %, % has type boolTypeIR)

    1. (Let integerLiteral be integerValue, integerValue has type integerLiteral)

      1. Case analysis on integerLiteral

        1. Case (let (D i) be %, % matches pattern `D %`)

          1. Return ((_B (i =/= (0 as int))) as value)

        2. Case (let (w W i) be %, % matches pattern `% W %`)

          1. Return ((_B (i =/= (0 as int))) as value)

      1. Else Dangling#2339

  2. Case (let intTypeIR be %, % has type intTypeIR)

    1. (Let integerLiteral be integerValue, integerValue has type integerLiteral)

      1. Case analysis on integerLiteral

        1. Case (let (D i) be %, % matches pattern `D %`)

          1. Return ((D i) as value)

        2. Case (let (_nat W i) be %, % matches pattern `% W %`)

          1. Return ((D i) as value)

        3. Case (let (w S i) be %, % matches pattern `% S %`)

          1. (Let int be $bitstr_to_int((w as int), i))

          2. Return ((D int) as value)

  3. Case (let (BIT `< w_to `>) be %, % has type fixedBitTypeIR)

    1. (Let integerLiteral be integerValue, integerValue has type integerLiteral)

      1. Case analysis on integerLiteral

        1. Case (let (D i) be %, % matches pattern `D %`)

          1. (Let i_cast be $int_to_bitstr((w_to as int), i))

          2. Return ((w_to W i_cast) as value)

        2. Case (let (_nat W i) be %, % matches pattern `% W %`)

          1. (Let i_cast be $int_to_bitstr((w_to as int), i))

          2. Return ((w_to W i_cast) as value)

        3. Case (let (w_from S i) be %, % matches pattern `% S %`)

          1. (Let i_from be $bitstr_to_int((w_from as int), i))

          2. (Let i_cast be $int_to_bitstr((w_to as int), i_from))

          3. Return ((w_to W i_cast) as value)

  4. Case (let (INT `< w_to `>) be %, % has type fixedIntTypeIR)

    1. (Let integerLiteral be integerValue, integerValue has type integerLiteral)

      1. Case analysis on integerLiteral

        1. Case (let (D i) be %, % matches pattern `D %`)

          1. (Let i_cast be $int_to_bitstr((w_to as int), i))

          2. Return ((w_to S i_cast) as value)

        2. Case (let (_nat W i) be %, % matches pattern `% W %`)

          1. (Let i_cast be $int_to_bitstr((w_to as int), i))

          2. Return ((w_to S i_cast) as value)

        3. Case (let (w_from S i) be %, % matches pattern `% S %`)

          1. (Let i_from be $bitstr_to_int((w_from as int), i))

          2. (Let i_cast be $int_to_bitstr((w_to as int), i_from))

          3. Return ((w_to S i_cast) as value)

  5. Case (let (VARBIT `< w_max `>) be %, % has type varBitTypeIR)

    1. (Let (w_max' '.' w V i) be integerValue, integerValue matches pattern `% . % V %`)

      1. If ((w_max = w_max')), then

        1. Return ((w_max '.' w V i) as value)

      1. Else Dangling#2385

  6. Case (let (TYPE _typeId typeIR) be %, % has type newTypeIR)

    1. (Let integerLiteral be integerValue, integerValue has type integerLiteral)

      1. Case analysis on integerLiteral

        1. Case (let (D i) be %, % matches pattern `D %`)

          1. Return $cast_op(typeIR, ((D i) as value))

        2. Case (let (w W i) be %, % matches pattern `% W %`)

          1. Return $cast_op(typeIR, ((w W i) as value))

        3. Case (let (w S i) be %, % matches pattern `% S %`)

          1. Return $cast_op(typeIR, ((w S i) as value))

  7. Case (let enumTypeIR be %, % has type enumTypeIR)

    1. (Let integerLiteral be integerValue, integerValue has type integerLiteral)

      1. Case analysis on integerLiteral

        1. Case (let (w W i) be %, % matches pattern `% W %`)

          1. Return $cast_to_enum(enumTypeIR, ((w W i) as value))

        2. Case (let (w S i) be %, % matches pattern `% S %`)

          1. Return $cast_to_enum(enumTypeIR, ((w S i) as value))

      1. Else Dangling#2400

  8. Case (let (SET `< typeIR `>) be %, % has type setTypeIR)

    1. (Let integerLiteral be integerValue, integerValue has type integerLiteral)

      1. Case analysis on integerLiteral

        1. Case (let (D i) be %, % matches pattern `D %`)

          1. (Let value be $cast_op(typeIR, ((D i) as value)))

          2. Return ((SET `{ value `}) as value)

        2. Case (let (w W i) be %, % matches pattern `% W %`)

          1. (Let value' be $cast_op(typeIR, ((w W i) as value)))

          2. Return ((SET `{ value' `}) as value)

        3. Case (let (w S i) be %, % matches pattern `% S %`)

          1. (Let value'' be $cast_op(typeIR, ((w S i) as value)))

          2. Return ((SET `{ value'' `}) as value)

1. Else Dangling#2335

