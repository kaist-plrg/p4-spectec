extern relation ExternFunctionCall_eval_lctk: TC |- nameIR `( (nameIR')*{nameIR' <- nameIR'*} `) ~> %

relation Expr_eval_lctk: p TC |- (expressionIR '#' expressionNoteIR) ~> %

1. Block (4 arms)

Arm 1:

  1. Group literalExpressionIR: p TC |- (expressionIR '#' expressionNoteIR) ~> %

    1. Case analysis on expressionIR

      1. Case (let booleanLiteral be %, % has type booleanLiteral)

        1. (Let boolValue be $ite<boolValue>((booleanLiteral = (TRUE)), (_B true), (_B false)))

        2. Result in: % % |- % ~> (boolValue as value)

      2. Case (let integerLiteral be %, % has type integerLiteral)

        1. Result in: % % |- % ~> (integerLiteral as value)

      3. Case (let stringLiteral be %, % has type stringLiteral)

        1. Result in: % % |- % ~> (stringLiteral as value)

    1. Else Dangling#5404

Arm 2:

  1. Case analysis on expressionIR

    1. Case (let prefixedNameIR be %, % has type prefixedNameIR)

      1. Group referenceExpressionIR: p TC |- ((prefixedNameIR as expressionIR) '#' expressionNoteIR) ~> %

        1. (Let value be $find_var_value_t(prefixedNameIR, p, TC))

        2. Result in: % % |- % ~> value

    2. Case (let defaultExpression be %, % has type defaultExpression)

      1. Group defaultExpressionIR: p TC |- ((('...') as expressionIR) '#' expressionNoteIR) ~> %

        1. Result in: % % |- % ~> ((DEFAULT) as value)

    3. Case (let (unop typedExpressionIR) be %, % has type unaryExpressionIR)

      1. Group unaryExpressionIR: p TC |- (((unop typedExpressionIR) as expressionIR) '#' expressionNoteIR) ~> %

        1. (Expr_eval_lctk: p TC |- typedExpressionIR ~> value)

        2. Result in: % % |- % ~> $un_op(unop, value)

    4. Case (let (typedExpressionIR_l binop typedExpressionIR_r) be %, % has type binaryExpressionIR)

      1. Group binaryExpressionIR: p TC |- (((typedExpressionIR_l binop typedExpressionIR_r) as expressionIR) '#' expressionNoteIR) ~> %

        1. Block (2 arms)

        Arm 1:

          1. If (~binop is in [('&&'), ('||')]), then

            1. (Expr_eval_lctk: p TC |- typedExpressionIR_l ~> value_l)

            2. (Expr_eval_lctk: p TC |- typedExpressionIR_r ~> value_r)

            3. Result in: % % |- % ~> $bin_op(binop, value_l, value_r)

          1. Else Dangling#5426

        Arm 2:

          1. Case analysis on binop

            1. Case (% matches pattern `&&`)

              1. (Expr_eval_lctk: p TC |- typedExpressionIR_l ~> value)

              2. Case analysis on value

                1. Case (% = ((_B false) as value))

                  1. Result in: % % |- % ~> ((_B false) as value)

                2. Case (% = ((_B true) as value))

                  1. (Expr_eval_lctk: p TC |- typedExpressionIR_r ~> value_r)

                  2. Result in: % % |- % ~> value_r

              2. Else Dangling#5432

            2. Case (% matches pattern `||`)

              1. (Expr_eval_lctk: p TC |- typedExpressionIR_l ~> value)

              2. Case analysis on value

                1. Case (% = ((_B true) as value))

                  1. Result in: % % |- % ~> ((_B true) as value)

                2. Case (% = ((_B false) as value))

                  1. (Expr_eval_lctk: p TC |- typedExpressionIR_r ~> value_r)

                  2. Result in: % % |- % ~> value_r

              2. Else Dangling#5437

          1. Else Dangling#5430

    5. Case (let (typedExpressionIR_cond '?' typedExpressionIR_true ':' typedExpressionIR_false) be %, % has type ternaryExpressionIR)

      1. Group ternaryExpressionIR: p TC |- (((typedExpressionIR_cond '?' typedExpressionIR_true ':' typedExpressionIR_false) as expressionIR) '#' expressionNoteIR) ~> %

        1. (Expr_eval_lctk: p TC |- typedExpressionIR_cond ~> value)

        2. Case analysis on value

          1. Case (% = ((_B true) as value))

            1. (Expr_eval_lctk: p TC |- typedExpressionIR_true ~> value_true)

            2. Result in: % % |- % ~> value_true

          2. Case (% = ((_B false) as value))

            1. (Expr_eval_lctk: p TC |- typedExpressionIR_false ~> value_false)

            2. Result in: % % |- % ~> value_false

        2. Else Dangling#5444

    6. Case (let (`( typeIR `) typedExpressionIR) be %, % has type castExpressionIR)

      1. Group castExpressionIR: p TC |- (((`( typeIR `) typedExpressionIR) as expressionIR) '#' expressionNoteIR) ~> %

        1. (Expr_eval_lctk: p TC |- typedExpressionIR ~> value)

        2. (Let value_cast be $cast_op(typeIR, value))

        3. Result in: % % |- % ~> value_cast

    7. Case (let invalidHeaderExpression be %, % has type invalidHeaderExpression)

      1. Group invalidHeaderExpressionIR: p TC |- ((('{#}') as expressionIR) '#' expressionNoteIR) ~> %

        1. Result in: % % |- % ~> (('{#}') as value)

    8. Case (let sequenceExpressionIR be %, % has type sequenceExpressionIR)

      1. Group sequenceExpressionIR: p TC |- ((sequenceExpressionIR as expressionIR) '#' expressionNoteIR) ~> %

        1. Case analysis on sequenceExpressionIR

          1. Case (let (SEQ `{ (typedExpressionIR)*{typedExpressionIR <- typedExpressionIR*} `}) be %, % matches pattern `SEQ {%}`)

            1. (Expr_eval_lctk: p TC |- typedExpressionIR ~> value)*

            2. Result in: % % |- % ~> ((SEQ `( (value)*{value <- value*} `)) as value)

          2. Case (let (SEQ `{ (typedExpressionIR)*{typedExpressionIR <- typedExpressionIR*} ',' '...' `}) be %, % matches pattern `SEQ {% , ...}`)

            1. (Expr_eval_lctk: p TC |- typedExpressionIR ~> value)*

            2. Result in: % % |- % ~> ((SEQ `( (value)*{value <- value*} ',' '...' `)) as value)

    9. Case (let recordExpressionIR be %, % has type recordExpressionIR)

      1. Group recordExpressionIR: p TC |- ((recordExpressionIR as expressionIR) '#' expressionNoteIR) ~> %

        1. Case analysis on recordExpressionIR

          1. Case (let (RECORD `{ ((nameIR '=' typedExpressionIR))*{nameIR <- nameIR*, typedExpressionIR <- typedExpressionIR*} `}) be %, % matches pattern `RECORD {%}`)

            1. (Expr_eval_lctk: p TC |- typedExpressionIR ~> value)*

            2. Result in: % % |- % ~> ((RECORD `{ ((value nameIR ';'))*{nameIR <- nameIR*, value <- value*} `}) as value)

          2. Case (let (RECORD `{ ((nameIR '=' typedExpressionIR))*{nameIR <- nameIR*, typedExpressionIR <- typedExpressionIR*} ',' '...' `}) be %, % matches pattern `RECORD {% , ...}`)

            1. (Expr_eval_lctk: p TC |- typedExpressionIR ~> value)*

            2. Result in: % % |- % ~> ((RECORD `{ ((value nameIR ';'))*{nameIR <- nameIR*, value <- value*} ',' '...' `}) as value)

  1. Else Dangling#5412

Arm 3:

  1. (Destruct (typeIR, ctk) = expressionNoteIR)

  2. (Let (ERROR '.' nameIR) be expressionIR, expressionIR has type errorAccessExpressionIR)

    1. Group errorAccessExpressionIR: p TC |- (((ERROR '.' nameIR) as expressionIR) '#' (`( typeIR ctk `))) ~> %

      1. (Let nameIR_error be "error." ++ nameIR)

      2. (Let value_error be $find_var_value_t((_BARE nameIR_error), p, TC))

      3. Result in: % % |- % ~> value_error

Arm 4:

  1. Case analysis on expressionIR

    1. Case (let (memberAccessBaseIR '.' nameIR) be %, % has type memberAccessExpressionIR)

      1. Case analysis on memberAccessBaseIR

        1. Case (let (TYPE prefixedNameIR_base) be %, % matches pattern `TYPE %`)

          1. Group memberAccessExpressionIR-type: p TC |- ((((TYPE prefixedNameIR_base) '.' nameIR) as expressionIR) '#' expressionNoteIR) ~> %

            1. (Let typeDefIR_base be ! $find_typeDef_t(p, TC, prefixedNameIR_base))

              1. If ($is_monomorphic_typeDefIR(typeDefIR_base)), then

                1. (Let typeIR_base be $typeIR_of_typeDefIR(typeDefIR_base))

                2. (Let typeIR' be $unroll_typeIR(typeIR_base))

                3. Case analysis on typeIR'

                  1. Case (let (ENUM typeId `{ (nameIR_field)*{nameIR_field <- nameIR_field*} `}) be %, % has type simpleEnumTypeIR)

                    1. If (nameIR is in (nameIR_field)*{nameIR_field <- nameIR_field*}), then

                      1. Result in: % % |- % ~> ((typeId '.' nameIR) as value)

                    1. Else Dangling#5495

                  2. Case (let (ENUM typeId `< typeIR `> `{ ((nameIR_field '=' value_field ';'))*{nameIR_field <- nameIR_field*, value_field <- value_field*} `}) be %, % has type serializableEnumTypeIR)

                    1. (Let value be ! $assoc_<nameIR, value>(nameIR, ((nameIR_field, value_field))*{nameIR_field <- nameIR_field*, value_field <- value_field*}))

                      1. Result in: % % |- % ~> ((typeId '.' nameIR '.' value) as value)

                3. Else Dangling#5493

              1. Else Dangling#5490

        2. Case (let typedExpressionIR_base be %, % has type typedExpressionIR)

          1. Group memberAccessExpressionIR-typedExpressionIR: p TC |- ((((typedExpressionIR_base as memberAccessBaseIR) '.' nameIR) as expressionIR) '#' expressionNoteIR) ~> %

            1. Block (2 arms)

            Arm 1:

              1. (Let typeIR_base be $type_of_typedExpressionIR(typedExpressionIR_base))

              2. (Let typeIR be $unroll_typeIR(typeIR_base))

              3. (Let (HEADER_STACK _typeIR `[ n_size `]) be typeIR, typeIR has type headerStackTypeIR)

                1. If ((nameIR = "size")), then

                  1. Result in: % % |- % ~> ((32 W (n_size as int)) as value)

                1. Else Dangling#5508

            Arm 2:

              1. (Expr_eval_lctk: p TC |- typedExpressionIR_base ~> value')

              2. Case analysis on value'

                1. Case (let structValue be %, % has type structValue)

                  1. (Let (STRUCT _typeId `{ ((value_field nameIR_field ';'))*{nameIR_field <- nameIR_field*, value_field <- value_field*} `}) be structValue)

                  2. (Let value be ! $assoc_<nameIR, value>(nameIR, ((nameIR_field, value_field))*{nameIR_field <- nameIR_field*, value_field <- value_field*}))

                    1. Result in: % % |- % ~> value

                2. Case (let headerValue be %, % has type headerValue)

                  1. (Let (HEADER _typeId `{ _b ';' ((value_field nameIR_field ';'))*{nameIR_field <- nameIR_field*, value_field <- value_field*} `}) be headerValue)

                  2. (Let value be ! $assoc_<nameIR, value>(nameIR, ((nameIR_field, value_field))*{nameIR_field <- nameIR_field*, value_field <- value_field*}))

                    1. Result in: % % |- % ~> value

                3. Case (let headerUnionValue be %, % has type headerUnionValue)

                  1. (Let (HEADER_UNION _typeId `{ ((value_field nameIR_field ';'))*{nameIR_field <- nameIR_field*, value_field <- value_field*} `}) be headerUnionValue)

                  2. (Let value be ! $assoc_<nameIR, value>(nameIR, ((nameIR_field, value_field))*{nameIR_field <- nameIR_field*, value_field <- value_field*}))

                    1. Result in: % % |- % ~> value

              2. Else Dangling#5511

    2. Case (let (typedExpressionIR_base `[ typedExpressionIR_index `]) be %, % has type indexAccessExpressionIR)

      1. Group indexAccessExpressionIR: p TC |- (((typedExpressionIR_base `[ typedExpressionIR_index `]) as expressionIR) '#' expressionNoteIR) ~> %

        1. (Expr_eval_lctk: p TC |- typedExpressionIR_base ~> value_base)

        2. (Expr_eval_lctk: p TC |- typedExpressionIR_index ~> value')

        3. (Let integerValue_index be value', value' has type integerValue)

          1. Case analysis on value_base

            1. Case (let (TUPLE `( (value_e)*{value_e <- value_e*} `)) be %, % has type tupleValue)

              1. (Let n_index be ! $nat_of_integerValue(integerValue_index))

                1. If ((n_index < |(value_e)*{value_e <- value_e*}|)), then

                  1. If ((n_index < |(value_e)*{value_e <- value_e*}|)), then

                    1. (Let value be (value_e)*{value_e <- value_e*}[n_index])

                    2. Result in: % % |- % ~> value

                  1. Else Dangling#5542

                1. Else Dangling#5541

            2. Case (let (ARRAY `[ (value_e)*{value_e <- value_e*} `]) be %, % has type arrayValue)

              1. (Let n_index be ! $nat_of_integerValue(integerValue_index))

                1. If ((n_index < |(value_e)*{value_e <- value_e*}|)), then

                  1. If ((n_index < |(value_e)*{value_e <- value_e*}|)), then

                    1. (Let value be (value_e)*{value_e <- value_e*}[n_index])

                    2. Result in: % % |- % ~> value

                  1. Else Dangling#5550

                1. Else Dangling#5549

            3. Case (let (HEADER_STACK `[ (value_e)*{value_e <- value_e*} `( _nat `) `]) be %, % has type headerStackValue)

              1. (Let n_index be ! $nat_of_integerValue(integerValue_index))

                1. If ((n_index < |(value_e)*{value_e <- value_e*}|)), then

                  1. If ((n_index < |(value_e)*{value_e <- value_e*}|)), then

                    1. (Let value be (value_e)*{value_e <- value_e*}[n_index])

                    2. Result in: % % |- % ~> value

                  1. Else Dangling#5558

                1. Else Dangling#5557

          1. Else Dangling#5536

    3. Case (let (typedExpressionIR_base `[ typedExpressionIR sliceop typedExpressionIR' `]) be %, % has type sliceAccessExpressionIR)

      1. Group sliceAccessExpressionIR: p TC |- (((typedExpressionIR_base `[ typedExpressionIR sliceop typedExpressionIR' `]) as expressionIR) '#' expressionNoteIR) ~> %

        1. Case analysis on sliceop

          1. Case (% matches pattern `:`)

            1. (Expr_eval_lctk: p TC |- typedExpressionIR_base ~> value_base)

            2. (Expr_eval_lctk: p TC |- typedExpressionIR ~> value_hi)

            3. (Expr_eval_lctk: p TC |- typedExpressionIR' ~> value_lo)

            4. Result in: % % |- % ~> $bitacc_range_op(value_base, value_hi, value_lo)

          2. Case (% matches pattern `+:`)

            1. (Expr_eval_lctk: p TC |- typedExpressionIR_base ~> value_base)

            2. (Expr_eval_lctk: p TC |- typedExpressionIR ~> value_l)

            3. (Expr_eval_lctk: p TC |- typedExpressionIR' ~> value_w)

            4. Result in: % % |- % ~> $bitacc_offset_op(value_base, value_l, value_w)

    4. Case (let callExpressionIR be %, % has type callExpressionIR)

      1. (Let (callableTargetIR' `< (typeArgumentIR)*{typeArgumentIR <- typeArgumentIR*} `> `( (argumentIR)*{argumentIR <- argumentIR*} `)) be callExpressionIR, callExpressionIR matches pattern `% <%> (%)`)

        1. Group callExpressionIR: p TC |- (((callableTargetIR' `< (typeArgumentIR)*{typeArgumentIR <- typeArgumentIR*} `> `( (argumentIR)*{argumentIR <- argumentIR*} `)) as expressionIR) '#' expressionNoteIR) ~> %

          1. Case analysis on callableTargetIR'

            1. Case (let prefixedNameIR be %, % has type prefixedNameIR)

              1. (CallableType_ok: p TC |- (prefixedNameIR as callableTargetIR) `< (typeArgumentIR)*{typeArgumentIR <- typeArgumentIR*} `> `( (argumentIR)*{argumentIR <- argumentIR*} `) : callableTypeIR `< '#' (_typeId)*{_typeId <- _typeId*} `> `( '#' (id_default)*{id_default <- id_default*} '#' (id_optional)*{id_optional <- id_optional*} `))

              2. (Let externFunctionTypeIR be callableTypeIR, callableTypeIR has type externFunctionTypeIR)

                1. (Let (EXTERN_FUNCTION t `( (parameterIR)*{parameterIR <- parameterIR*} `) ':' typeIR) be externFunctionTypeIR)

                2. If ((t = "static_assert")), then

                  1. (Let boolTypeIR be typeIR, typeIR has type boolTypeIR)

                    1. (Let (_annotationList _direction _typeIR nameIR_param _parameterInitializerOptIR) be parameterIR)*

                    2. (Let TC_callee_0 be $empty_typingContext)

                    3. (Let (GIVEN (parameterIR_aligned)*{parameterIR_aligned <- parameterIR_aligned*} DEFAULT (parameterIR')*{parameterIR' <- parameterIR'*} OPTIONAL (_parameterIR)*{_parameterIR <- _parameterIR*}) be $align_parameterListIR((parameterIR)*{parameterIR <- parameterIR*}, (argumentIR)*{argumentIR <- argumentIR*}, (id_default)*{id_default <- id_default*}, (id_optional)*{id_optional <- id_optional*}))

                    4. If (((parameterIR')*{parameterIR' <- parameterIR'*} matches pattern [])), then

                      1. (Argument_eval_lctk: p TC |- argumentIR ~> value_argument)*

                      2. (Let (_annotationList' direction_param_aligned typeIR_param_aligned nameIR_param_aligned _parameterInitializerOptIR') be parameterIR_aligned)*

                      3. If (((|(direction_param_aligned)*{direction_param_aligned <- direction_param_aligned*}| = |(typeIR_param_aligned)*{typeIR_param_aligned <- typeIR_param_aligned*}|) /\ (|(typeIR_param_aligned)*{typeIR_param_aligned <- typeIR_param_aligned*}| = |(value_argument)*{value_argument <- value_argument*}|))), then

                        1. (Let varTypeIR be (direction_param_aligned typeIR_param_aligned (LCTK) ?(value_argument)))*

                        2. (Let TC_callee_1 be $add_vars_t((LOCAL), TC_callee_0, (nameIR_param_aligned)*{nameIR_param_aligned <- nameIR_param_aligned*}, (varTypeIR)*{varTypeIR <- varTypeIR*}))

                        3. (ExternFunctionCall_eval_lctk: TC_callee_1 |- "static_assert" `( (nameIR_param)*{nameIR_param <- nameIR_param*} `) ~> value)

                        4. (Let boolValue be value, value has type boolValue)

                          1. If (((_B true) = boolValue)), then

                            1. Result in: % % |- % ~> (boolValue as value)

                          1. Else Dangling#5597

                      3. Else Dangling#5591

                    4. Else Dangling#5588

                2. Else Dangling#5582

            2. Case (let (typedExpressionIR_base '.' nameIR) be %, % matches pattern `% . %`)

              1. (Destruct (_expressionIR, (`( typeIR_base _ctk `))) = typedExpressionIR_base)

              2. If (nameIR is in ["minSizeInBits", "minSizeInBytes", "maxSizeInBits", "maxSizeInBytes"]), then

                1. Result in: % % |- % ~> $sizeof(typeIR_base, nameIR)

              2. Else Dangling#5601

            3. Case (let (TYPE prefixedNameIR '.' nameIR) be %, % matches pattern `TYPE % . %`)

              1. (Let typeDefIR_base be ! $find_typeDef_t(p, TC, prefixedNameIR))

                1. Case analysis on $is_monomorphic_typeDefIR(typeDefIR_base)

                  1. Case true

                    1. (Let typeIR_base be $typeIR_of_typeDefIR(typeDefIR_base))

                    2. If (nameIR is in ["minSizeInBits", "minSizeInBytes", "maxSizeInBits", "maxSizeInBytes"]), then

                      1. Result in: % % |- % ~> $sizeof(typeIR_base, nameIR)

                    2. Else Dangling#5609

                  2. Case false

                    1. If ((([], []) = $typeParameterListIR_of_typeDefIR(typeDefIR_base))), then

                      1. (Let typeIR_base be $typeIR_of_typeDefIR(typeDefIR_base))

                      2. If (nameIR is in ["minSizeInBits", "minSizeInBytes", "maxSizeInBits", "maxSizeInBytes"]), then

                        1. Result in: % % |- % ~> $sizeof(typeIR_base, nameIR)

                      2. Else Dangling#5613

                    1. Else Dangling#5611

            4. Case (let (`( callableTargetIR `)) be %, % matches pattern `(%)`)

              1. (Destruct (typeIR, ctk) = expressionNoteIR)

              2. (Expr_eval_lctk: p TC |- (((callableTargetIR `< (typeArgumentIR)*{typeArgumentIR <- typeArgumentIR*} `> `( (argumentIR)*{argumentIR <- argumentIR*} `)) as expressionIR) '#' (`( typeIR ctk `))) ~> value)

              3. Result in: % % |- % ~> value

    5. Case (let (`( typedExpressionIR `)) be %, % has type parenthesizedExpressionIR)

      1. Group parenthesizedExpressionIR: p TC |- (((`( typedExpressionIR `)) as expressionIR) '#' expressionNoteIR) ~> %

        1. (Expr_eval_lctk: p TC |- typedExpressionIR ~> value)

        2. Result in: % % |- % ~> value

  1. Else Dangling#5482

relation Argument_eval_lctk: p TC |- argumentIR ~> %

1. Group : p TC |- argumentIR ~> %

  1. Case analysis on argumentIR

    1. Case (let typedExpressionIR be %, % has type typedExpressionIR)

      1. (Expr_eval_lctk: p TC |- typedExpressionIR ~> value)

      2. Result in: % % |- % ~> value

    2. Case (let (nameIR '=' typedExpressionIR) be %, % matches pattern `% = %`)

      1. (Expr_eval_lctk: p TC |- typedExpressionIR ~> value)

      2. Result in: % % |- % ~> value

  1. Else Dangling#5624

relation Type_ok: p TC |- typeOrVoid : % '#' %

1. Block (3 arms)

Arm 1:

  1. Case analysis on typeOrVoid

    1. Case (% matches pattern `VOID`)

      1. Group void: p TC |- (VOID) : % '#' %

        1. Result in: % % |- % : ((VOID) as typeIR) '#' []

    2. Case (let baseType be %, % has type baseType)

      1. Block (4 arms)

      Arm 1:

        1. Case analysis on baseType

          1. Case (% matches pattern `BOOL`)

            1. Group boolean: p TC |- ((BOOL) as typeOrVoid) : % '#' %

              1. Result in: % % |- % : ((BOOL) as typeIR) '#' []

          2. Case (% matches pattern `ERROR`)

            1. Group error: p TC |- ((ERROR) as typeOrVoid) : % '#' %

              1. Result in: % % |- % : ((ERROR) as typeIR) '#' []

          3. Case (% matches pattern `MATCH_KIND`)

            1. Group matchKind: p TC |- ((MATCH_KIND) as typeOrVoid) : % '#' %

              1. Result in: % % |- % : ((MATCH_KIND) as typeIR) '#' []

          4. Case (% matches pattern `STRING`)

            1. Group string: p TC |- ((STRING) as typeOrVoid) : % '#' %

              1. Result in: % % |- % : ((STRING) as typeIR) '#' []

          5. Case (% matches pattern `INT`)

            1. Group arbitraryInt: p TC |- ((INT) as typeOrVoid) : % '#' %

              1. Result in: % % |- % : ((INT) as typeIR) '#' []

        1. Else Dangling#5635

      Arm 2:

        1. Group fixedInt: p TC |- (baseType as typeOrVoid) : % '#' %

          1. Case analysis on baseType

            1. Case (let (INT `< i `>) be %, % matches pattern `INT <%>`)

              1. (Let n be i, i has type nat)

                1. If ((n > 0)), then

                  1. Result in: % % |- % : ((INT `< n `>) as typeIR) '#' []

                1. Else Dangling#5651

            2. Case (let (INT `< `( expression `) `>) be %, % matches pattern `INT <(%)>`)

              1. (Expr_ok: p TC |- expression : typedExpressionIR)

              2. If (($ctk_of_typedExpressionIR(typedExpressionIR) matches pattern `LCTK`)), then

                1. (Expr_eval_lctk: p TC |- typedExpressionIR ~> value)

                2. (Let integerValue be value, value has type integerValue)

                  1. (Let n be ! $nat_of_integerValue(integerValue))

                    1. If ((n > 0)), then

                      1. Result in: % % |- % : ((INT `< n `>) as typeIR) '#' []

                    1. Else Dangling#5662

              2. Else Dangling#5655

          1. Else Dangling#5647

      Arm 3:

        1. Group fixedBit: p TC |- (baseType as typeOrVoid) : % '#' %

          1. Case analysis on baseType

            1. Case (% matches pattern `BIT`)

              1. Result in: % % |- % : ((BIT `< 1 `>) as typeIR) '#' []

            2. Case (let (BIT `< i `>) be %, % matches pattern `BIT <%>`)

              1. (Let n be i, i has type nat)

                1. Result in: % % |- % : ((BIT `< n `>) as typeIR) '#' []

            3. Case (let (BIT `< `( expression `) `>) be %, % matches pattern `BIT <(%)>`)

              1. (Expr_ok: p TC |- expression : typedExpressionIR)

              2. If (($ctk_of_typedExpressionIR(typedExpressionIR) matches pattern `LCTK`)), then

                1. (Expr_eval_lctk: p TC |- typedExpressionIR ~> value)

                2. (Let integerValue be value, value has type integerValue)

                  1. (Let n be ! $nat_of_integerValue(integerValue))

                    1. Result in: % % |- % : ((BIT `< n `>) as typeIR) '#' []

              2. Else Dangling#5673

          1. Else Dangling#5665

      Arm 4:

        1. Group variableBit: p TC |- (baseType as typeOrVoid) : % '#' %

          1. Case analysis on baseType

            1. Case (let (VARBIT `< i `>) be %, % matches pattern `VARBIT <%>`)

              1. (Let n be i, i has type nat)

                1. Result in: % % |- % : ((VARBIT `< n `>) as typeIR) '#' []

            2. Case (let (VARBIT `< `( expression `) `>) be %, % matches pattern `VARBIT <(%)>`)

              1. (Expr_ok: p TC |- expression : typedExpressionIR)

              2. If (($ctk_of_typedExpressionIR(typedExpressionIR) matches pattern `LCTK`)), then

                1. (Expr_eval_lctk: p TC |- typedExpressionIR ~> value)

                2. (Let integerValue be value, value has type integerValue)

                  1. (Let n be ! $nat_of_integerValue(integerValue))

                    1. Result in: % % |- % : ((VARBIT `< n `>) as typeIR) '#' []

              2. Else Dangling#5689

          1. Else Dangling#5682

  1. Else Dangling#5631

Arm 2:

  1. Group prefixedTypeName-identifier: p TC |- typeOrVoid : % '#' %

    1. Case analysis on typeOrVoid

      1. Case (let (_ID typeId) be %, % has type identifier)

        1. (Type_ok: p TC |- ((_TID typeId) as typeOrVoid) : typeIR '#' (typeId_fresh)*{typeId_fresh <- typeId_fresh*})

        2. Result in: % % |- % : typeIR '#' (typeId_fresh)*{typeId_fresh <- typeId_fresh*}

      2. Case (let prefixedTypeName be %, % has type prefixedTypeName)

        1. (Let prefixedNameIR be $prefixedTypeName(prefixedTypeName))

        2. (Let typeDefIR be ! $find_typeDef_t(p, TC, prefixedNameIR))

          1. Case analysis on $is_monomorphic_typeDefIR(typeDefIR)

            1. Case true

              1. (Let typeIR be $typeIR_of_typeDefIR(typeDefIR))

              2. Result in: % % |- % : typeIR '#' []

            2. Case false

              1. (Let typeIR be $specialize_typeDefIR(typeDefIR, []))

              2. Result in: % % |- % : typeIR '#' []

    1. Else Dangling#5698

Arm 3:

  1. Case analysis on typeOrVoid

    1. Case (let (prefixedTypeName `< typeArgumentList `>) be %, % has type specializedType)

      1. Group specializedType: p TC |- ((prefixedTypeName `< typeArgumentList `>) as typeOrVoid) : % '#' %

        1. (Let prefixedNameIR be $prefixedTypeName(prefixedTypeName))

        2. (Let typeDefIR be ! $find_typeDef_t(p, TC, prefixedNameIR))

          1. If ($is_polymorphic_typeDefIR(typeDefIR)), then

            1. (TypeArgumentList_ok: p TC |- typeArgumentList : (typeIR_arg)*{typeIR_arg <- typeIR_arg*} '#' (typeId_fresh)*{typeId_fresh <- typeId_fresh*})

            2. (Let typeIR be $specialize_typeDefIR(typeDefIR, (typeIR_arg)*{typeIR_arg <- typeIR_arg*}))

            3. Result in: % % |- % : typeIR '#' (typeId_fresh)*{typeId_fresh <- typeId_fresh*}

          1. Else Dangling#5719

    2. Case (let (type `[ expression_size `]) be %, % has type arrayType)

      1. Block (2 arms)

      Arm 1:

        1. Group headerStackType: p TC |- ((type `[ expression_size `]) as typeOrVoid) : % '#' %

          1. (Type_ok: p TC |- (type as typeOrVoid) : typeIR_base '#' (typeId_fresh)*{typeId_fresh <- typeId_fresh*})

          2. (Let typeIR_base' be $unroll_typeIR(typeIR_base))

          3. If (((typeIR_base' has type headerTypeIR) \/ (typeIR_base' has type headerUnionTypeIR))), then

            1. (Expr_ok: p TC |- expression_size : typedExpressionIR_size)

            2. If (($ctk_of_typedExpressionIR(typedExpressionIR_size) matches pattern `LCTK`)), then

              1. (Expr_eval_lctk: p TC |- typedExpressionIR_size ~> value)

              2. (Let integerValue_size be value, value has type integerValue)

                1. (Let n_size be ! $nat_of_integerValue(integerValue_size))

                  1. If ((n_size > 0)), then

                    1. Result in: % % |- % : ((HEADER_STACK typeIR_base `[ n_size `]) as typeIR) '#' (typeId_fresh)*{typeId_fresh <- typeId_fresh*}

                  1. Else Dangling#5736

            2. Else Dangling#5729

          3. Else Dangling#5727

      Arm 2:

        1. Group arrayType: p TC |- ((type `[ expression_size `]) as typeOrVoid) : % '#' %

          1. (Type_ok: p TC |- (type as typeOrVoid) : typeIR_base '#' (typeId_fresh)*{typeId_fresh <- typeId_fresh*})

          2. (Let typeIR_base' be $unroll_typeIR(typeIR_base))

          3. If (~((typeIR_base' has type headerTypeIR) \/ (typeIR_base' has type headerUnionTypeIR))), then

            1. (Expr_ok: p TC |- expression_size : typedExpressionIR_size)

            2. If (($ctk_of_typedExpressionIR(typedExpressionIR_size) matches pattern `LCTK`)), then

              1. (Expr_eval_lctk: p TC |- typedExpressionIR_size ~> value)

              2. (Let integerValue_size be value, value has type integerValue)

                1. (Let n_size be ! $nat_of_integerValue(integerValue_size))

                  1. If ((n_size > 0)), then

                    1. Result in: % % |- % : ((ARRAY typeIR_base `[ n_size `]) as typeIR) '#' (typeId_fresh)*{typeId_fresh <- typeId_fresh*}

                  1. Else Dangling#5750

            2. Else Dangling#5743

          3. Else Dangling#5741

    3. Case (let (LIST `< typeArgument `>) be %, % has type listType)

      1. Group listType: p TC |- ((LIST `< typeArgument `>) as typeOrVoid) : % '#' %

        1. (TypeArgument_ok: p TC |- typeArgument : typeIR_arg '#' (typeId_fresh)*{typeId_fresh <- typeId_fresh*})

        2. Result in: % % |- % : ((LIST `< typeIR_arg `>) as typeIR) '#' (typeId_fresh)*{typeId_fresh <- typeId_fresh*}

    4. Case (let (TUPLE `< typeArgumentList `>) be %, % has type tupleType)

      1. Group tupleType: p TC |- ((TUPLE `< typeArgumentList `>) as typeOrVoid) : % '#' %

        1. (TypeArgumentList_ok: p TC |- typeArgumentList : (typeIR_arg)*{typeIR_arg <- typeIR_arg*} '#' (typeId_fresh)*{typeId_fresh <- typeId_fresh*})

        2. Result in: % % |- % : ((TUPLE `< (typeIR_arg)*{typeIR_arg <- typeIR_arg*} `>) as typeIR) '#' (typeId_fresh)*{typeId_fresh <- typeId_fresh*}

  1. Else Dangling#5712

relation TypeParameterListOpt_ok: p TC_0 |- typeParameterListOpt : % %

1. Group : p TC_0 |- typeParameterListOpt : % %

  1. (Let (typeParameter)*{typeParameter <- typeParameter*} be $flatten_typeParameterListOpt(typeParameterListOpt))

  2. (Let typeId be $name(typeParameter))*

  3. (Let TC_1 be $add_typeParameters_t(p, TC_0, (typeId)*{typeId <- typeId*}))

  4. Result in: % % |- % : TC_1 (typeId)*{typeId <- typeId*}

relation TypeArgument_ok: p TC |- typeArgument : % '#' %

1. Group : p TC |- typeArgument : % '#' %

  1. Block (2 arms)

  Arm 1:

    1. Case analysis on typeArgument

      1. Case (let type be %, % has type type)

        1. (Type_ok: p TC |- (type as typeOrVoid) : typeIR '#' (typeId_impl)*{typeId_impl <- typeId_impl*})

        2. Result in: % % |- % : typeIR '#' (typeId_impl)*{typeId_impl <- typeId_impl*}

      2. Case (let nonTypeName be %, % has type nonTypeName)

        1. (Let typeId be $name((nonTypeName as name)))

        2. (Let bound be $bound(p, TC))

        3. If (Type_wf: bound |- ((_NAME typeId) as typeIR)) holds, then

          1. Result in: % % |- % : ((_NAME typeId) as typeIR) '#' []

        3. Else Dangling#5772

    1. Else Dangling#5766

  Arm 2:

    1. Case analysis on typeArgument

      1. Case (% = ((VOID) as typeArgument))

        1. Result in: % % |- % : ((VOID) as typeIR) '#' []

      2. Case (% = (('_') as typeArgument))

        1. (Let typeId_impl be $fresh_typeId)

        2. Result in: % % |- % : ((_NAME typeId_impl) as typeIR) '#' [typeId_impl]

    1. Else Dangling#5774

relation TypeArguments_ok: p TC |- (typeArgument)*{typeArgument <- typeArgument*} : % '#' %

1. Group : p TC |- (typeArgument)*{typeArgument <- typeArgument*} : % '#' %

  1. Case analysis on (typeArgument)*{typeArgument <- typeArgument*}

    1. Case (% matches pattern [])

      1. Result in: % % |- % : [] '#' []

    2. Case (let typeArgument_h :: (typeArgument_t)*{typeArgument_t <- typeArgument_t*} be %, % matches pattern _ :: _)

      1. (TypeArgument_ok: p TC |- typeArgument_h : typeArgumentIR_h '#' (typeId_impl_h)*{typeId_impl_h <- typeId_impl_h*})

      2. (TypeArguments_ok: p TC |- (typeArgument_t)*{typeArgument_t <- typeArgument_t*} : (typeArgumentIR_t)*{typeArgumentIR_t <- typeArgumentIR_t*} '#' (typeId_impl_t)*{typeId_impl_t <- typeId_impl_t*})

      3. (Let (typeId_impl)*{typeId_impl <- typeId_impl*} be (typeId_impl_h)*{typeId_impl_h <- typeId_impl_h*} ++ (typeId_impl_t)*{typeId_impl_t <- typeId_impl_t*})

      4. Result in: % % |- % : typeArgumentIR_h :: (typeArgumentIR_t)*{typeArgumentIR_t <- typeArgumentIR_t*} '#' (typeId_impl)*{typeId_impl <- typeId_impl*}

relation TypeArgumentList_ok: p TC |- typeArgumentList : % '#' %

1. Group : p TC |- typeArgumentList : % '#' %

  1. (Let (typeArgument)*{typeArgument <- typeArgument*} be $flatten_typeArgumentList(typeArgumentList))

  2. (TypeArguments_ok: p TC |- (typeArgument)*{typeArgument <- typeArgument*} : (typeArgumentIR)*{typeArgumentIR <- typeArgumentIR*} '#' (typeId_impl)*{typeId_impl <- typeId_impl*})

  3. Result in: % % |- % : (typeArgumentIR)*{typeArgumentIR <- typeArgumentIR*} '#' (typeId_impl)*{typeId_impl <- typeId_impl*}

syntax castResult = 
   | OK typeIR* (from castResult) 
   | FAIL (from castResult) 

relation Cast_expl: typeIR_a -> typeIR_b : %

1. Group : typeIR_a -> typeIR_b : %

  1. (Let typeIR_a_unroll be $unroll_typeIR(typeIR_a))

  2. (Let typeIR_b_unroll be $unroll_typeIR(typeIR_b))

  3. If (Type_alpha: typeIR_a_unroll ~~ typeIR_b_unroll) holds, then

    1. Result in: % -> % : (OK [typeIR_b])

  3. Else,

    1. (Cast_expl_neq: typeIR_a_unroll -> typeIR_b_unroll : castResult)

    2. Result in: % -> % : castResult

relation Cast_expl_neq: typeIR -> typeIR' : %

1. Block (4 arms)

Arm 1:

  1. Case analysis on typeIR

    1. Case (let boolTypeIR be %, % has type boolTypeIR)

      1. If ((typeIR' = ((BIT `< 1 `>) as typeIR))), then

        1. Group boolean-fixBit: ((BOOL) as typeIR) -> ((BIT `< 1 `>) as typeIR) : %

          1. Result in: % -> % : (OK [((BIT `< 1 `>) as typeIR)])

    2. Case (let intTypeIR be %, % has type intTypeIR)

      1. Group arbitraryInt: ((INT) as typeIR) -> typeIR' : %

        1. Block (2 arms)

        Arm 1:

          1. If ((typeIR' = ((BOOL) as typeIR))), then

            1. Result in: % -> % : (OK [((BOOL) as typeIR)])

        Arm 2:

          1. Case analysis on typeIR'

            1. Case (let (INT `< w `>) be %, % has type fixedIntTypeIR)

              1. Result in: % -> % : (OK [((INT `< w `>) as typeIR)])

            2. Case (let (BIT `< w `>) be %, % has type fixedBitTypeIR)

              1. Result in: % -> % : (OK [((BIT `< w `>) as typeIR)])

    3. Case (let (INT `< nat `>) be %, % has type fixedIntTypeIR)

      1. Group fixInt: ((INT `< nat `>) as typeIR) -> typeIR' : %

        1. Block (2 arms)

        Arm 1:

          1. Case analysis on typeIR'

            1. Case (% = ((INT) as typeIR))

              1. Result in: % -> % : (OK [((INT) as typeIR)])

            2. Case (% = ((BIT `< nat `>) as typeIR))

              1. Result in: % -> % : (OK [((BIT `< nat `>) as typeIR)])

        Arm 2:

          1. (Let (INT `< w_b `>) be typeIR', typeIR' has type fixedIntTypeIR)

            1. Result in: % -> % : (OK [((INT `< w_b `>) as typeIR)])

    4. Case (let (BIT `< nat `>) be %, % has type fixedBitTypeIR)

      1. Group fixBit: ((BIT `< nat `>) as typeIR) -> typeIR' : %

        1. Block (3 arms)

        Arm 1:

          1. If ((nat = 1)), then

            1. If ((typeIR' = ((BOOL) as typeIR))), then

              1. Result in: % -> % : (OK [((BOOL) as typeIR)])

        Arm 2:

          1. Case analysis on typeIR'

            1. Case (% = ((INT) as typeIR))

              1. Result in: % -> % : (OK [((INT) as typeIR)])

            2. Case (% = ((INT `< nat `>) as typeIR))

              1. Result in: % -> % : (OK [((INT `< nat `>) as typeIR)])

        Arm 3:

          1. (Let (BIT `< w_b `>) be typeIR', typeIR' has type fixedBitTypeIR)

            1. Result in: % -> % : (OK [((BIT `< w_b `>) as typeIR)])

Arm 2:

  1. Group newTypeIR: typeIR -> typeIR' : %

    1. Block (2 arms)

    Arm 1:

      1. (Let (TYPE _typeId typeIR_a) be typeIR, typeIR has type newTypeIR)

        1. (Cast_impl: typeIR_a -> typeIR' : castResult)

        2. (Let (OK (typeIR_cast)*{typeIR_cast <- typeIR_cast*}) be castResult, castResult matches pattern `OK %`)

          1. Result in: % -> % : (OK typeIR_a :: (typeIR_cast)*{typeIR_cast <- typeIR_cast*})

    Arm 2:

      1. (Let newTypeIR be typeIR', typeIR' has type newTypeIR)

        1. (Let (TYPE _typeId typeIR_b) be newTypeIR)

        2. (Cast_impl: typeIR -> typeIR_b : castResult)

        3. (Let (OK (typeIR_cast)*{typeIR_cast <- typeIR_cast*}) be castResult, castResult matches pattern `OK %`)

          1. Result in: % -> % : (OK (typeIR_cast)*{typeIR_cast <- typeIR_cast*} ++ ([newTypeIR] as typeIR*))

Arm 3:

  1. Group enumTypeIR-serializable: typeIR -> typeIR' : %

    1. Block (2 arms)

    Arm 1:

      1. (Let (ENUM _typeId `< typeIR_a `> `{ (_valueFieldIR)*{_valueFieldIR <- _valueFieldIR*} `}) be typeIR, typeIR has type serializableEnumTypeIR)

        1. (Cast_impl: typeIR_a -> typeIR' : castResult)

        2. (Let (OK (typeIR_cast)*{typeIR_cast <- typeIR_cast*}) be castResult, castResult matches pattern `OK %`)

          1. Result in: % -> % : (OK typeIR_a :: (typeIR_cast)*{typeIR_cast <- typeIR_cast*})

    Arm 2:

      1. (Let serializableEnumTypeIR be typeIR', typeIR' has type serializableEnumTypeIR)

        1. (Let (ENUM _typeId `< typeIR_b `> `{ (_valueFieldIR)*{_valueFieldIR <- _valueFieldIR*} `}) be serializableEnumTypeIR)

        2. (Cast_impl: typeIR -> typeIR_b : castResult)

        3. (Let (OK (typeIR_cast)*{typeIR_cast <- typeIR_cast*}) be castResult, castResult matches pattern `OK %`)

          1. Result in: % -> % : (OK (typeIR_cast)*{typeIR_cast <- typeIR_cast*} ++ ([serializableEnumTypeIR] as typeIR*))

Arm 4:

  1. Case analysis on typeIR

    1. Case (let defaultTypeIR be %, % has type defaultTypeIR)

      1. Group defaultTypeIR: ((DEFAULT) as typeIR) -> typeIR' : %

        1. If ($is_defaultable_typeIR(typeIR')), then

