                      2. Case false

                        1. If ((([], []) = $typeParameterListIR_of_typeDefIR(typeDefIR))), then

                          1. (Let nameIR be $name(name))

                          2. (Let typeIR be $specialize_typeDefIR(typeDefIR, []))

                          3. (Let typedefTypeIR be (TYPEDEF nameIR typeIR))

                          4. (Let bound'''''''''' be $bound((GLOBAL), TC_0))

                          5. If (TypeDef_wf: bound'''''''''' |- (typedefTypeIR as typeDefIR)) holds, then

                            1. (Let TC_2 be $add_typeDef_t((GLOBAL), TC_1, nameIR, (typedefTypeIR as typeDefIR)))

                            2. (Let typedefDeclarationIR be (annotationList TYPEDEF (derivedTypeDeclarationIR as typedefIR) nameIR ';'))

                            3. Result in: % |- % : TC_2 (typedefDeclarationIR as declarationIR)

                          5. Else Dangling#8244

                        1. Else Dangling#8240

      2. Case (let (annotationList TYPE type name ';') be %, % matches pattern `% TYPE % % ;`)

        1. Group typedefDeclaration-newtype: TC_0 |- ((annotationList TYPE type name ';') as declaration) : % %

          1. (Let B be $bound((GLOBAL), TC_0))

          2. (Type_ok: (GLOBAL) TC_0 |- (type as typeOrVoid) : typeIR '#' (typeId)*{typeId <- typeId*})

          3. If (((typeId)*{typeId <- typeId*} matches pattern [])), then

            1. If (Type_wf: B |- typeIR) holds, then

              1. (Let nameIR be $name(name))

              2. (Let newTypeIR be (TYPE nameIR typeIR))

              3. If (TypeDef_wf: B |- (newTypeIR as typeDefIR)) holds, then

                1. (Let TC_1 be $add_typeDef_t((GLOBAL), TC_0, nameIR, (newTypeIR as typeDefIR)))

                2. (Let typedefDeclarationIR be (annotationList TYPE typeIR nameIR ';'))

                3. Result in: % |- % : TC_1 (typedefDeclarationIR as declarationIR)

              3. Else Dangling#8256

            1. Else Dangling#8253

          3. Else Dangling#8252

  16. Case (let (annotationList PARSER name typeParameterListOpt `( parameterList `) ';') be %, % has type parserTypeDeclaration)

    1. Group parserTypeDeclaration: TC_0 |- ((annotationList PARSER name typeParameterListOpt `( parameterList `) ';') as declaration) : % %

      1. (Let TC_1 be TC_0[BLOCK.KIND = (PARSER)])

      2. (TypeParameterListOpt_ok: (BLOCK) TC_1 |- typeParameterListOpt : TC_2 (typeId_expl)*{typeId_expl <- typeId_expl*})

      3. (ParameterList_ok: (BLOCK) TC_2 |- parameterList : TC_3 (parameterIR)*{parameterIR <- parameterIR*} '#' (typeId_impl)*{typeId_impl <- typeId_impl*})

      4. (Let nameIR be $name(name))

      5. (Let parserObjectTypeDefIR be (PARSER nameIR `< (typeId_expl)*{typeId_expl <- typeId_expl*} ',' (typeId_impl)*{typeId_impl <- typeId_impl*} `> `( (parameterIR)*{parameterIR <- parameterIR*} `)))

      6. (Let bound''''''''''' be $bound((GLOBAL), TC_0))

      7. If (TypeDef_wf: bound''''''''''' |- (parserObjectTypeDefIR as typeDefIR)) holds, then

        1. (Let TC_4 be $add_typeDef_t((GLOBAL), TC_0, nameIR, (parserObjectTypeDefIR as typeDefIR)))

        2. (Let parserTypeDeclarationIR be (annotationList PARSER nameIR `< (typeId_expl)*{typeId_expl <- typeId_expl*} ',' (typeId_impl)*{typeId_impl <- typeId_impl*} `> `( (parameterIR)*{parameterIR <- parameterIR*} `) ';'))

        3. Result in: % |- % : TC_4 (parserTypeDeclarationIR as declarationIR)

      7. Else Dangling#8267

  17. Case (let (annotationList CONTROL name typeParameterListOpt `( parameterList `) ';') be %, % has type controlTypeDeclaration)

    1. Group controlTypeDeclaration: TC_0 |- ((annotationList CONTROL name typeParameterListOpt `( parameterList `) ';') as declaration) : % %

      1. (Let TC_1 be TC_0[BLOCK.KIND = (CONTROL)])

      2. (TypeParameterListOpt_ok: (BLOCK) TC_1 |- typeParameterListOpt : TC_2 (typeId_expl)*{typeId_expl <- typeId_expl*})

      3. (ParameterList_ok: (BLOCK) TC_2 |- parameterList : TC_3 (parameterIR)*{parameterIR <- parameterIR*} '#' (typeId_impl)*{typeId_impl <- typeId_impl*})

      4. (Let nameIR be $name(name))

      5. (Let controlObjectTypeDefIR be (CONTROL nameIR `< (typeId_expl)*{typeId_expl <- typeId_expl*} ',' (typeId_impl)*{typeId_impl <- typeId_impl*} `> `( (parameterIR)*{parameterIR <- parameterIR*} `)))

      6. (Let bound'''''''''''' be $bound((GLOBAL), TC_0))

