def $tableObject_create_entry_key(EC, (nameIR_key, t, typeIR), (tableKeyInterface)*{tableKeyInterface <- tableKeyInterface*})

1. Case analysis on t

  1. Case (% = "exact")

    1. (Let tableKeyValueInterface be ! $assoc_<nameIR, tableKeyValueInterface>(nameIR_key, (tableKeyInterface)*{tableKeyInterface <- tableKeyInterface*}))

      1. (Let text_key_value be ! $text_of_number_tableKeyValueInterface(tableKeyValueInterface))

        1. (Let i_key_value be $text_to_int(text_key_value))

        2. (Let typedExpressionIR be (((D i_key_value) as expressionIR) '#' (`( ((INT) as typeIR) (DYN) `))))

        3. (Let typedExpressionIR_cast be ! $cast_control_plane(EC, typedExpressionIR, typeIR))

          1. (Let typeIR_set be ((SET `< typeIR `>) as typeIR))

          2. (Let simpleKeysetExpressionIR be ((((`( typeIR_set `) typedExpressionIR_cast) as expressionIR) '#' (`( typeIR_set (DYN) `))) as simpleKeysetExpressionIR))

          3. Return simpleKeysetExpressionIR

  2. Case (% = "ternary")

    1. (Let tableKeyValueInterface be ! $assoc_<nameIR, tableKeyValueInterface>(nameIR_key, (tableKeyInterface)*{tableKeyInterface <- tableKeyInterface*}))

      1. Case analysis on tableKeyValueInterface

        1. Case (let (_HEX text_key_value) be %, % matches pattern `_HEX %`)

          1. (Let text_key_base_value be $replace_text(text_key_value, "*", "0"))

          2. (Let i_key_base_value be $text_to_int("0x" ++ text_key_base_value))

          3. (Let typedExpressionIR_base be (((D i_key_base_value) as expressionIR) '#' (`( ((INT) as typeIR) (DYN) `))))

          4. (Let typedExpressionIR_base_cast be ! $cast_control_plane(EC, typedExpressionIR_base, typeIR))

            1. (Let text_key_mask_value be $replace_text_except(text_key_value, "*", "F"))

            2. (Let text_key_mask_value' be $replace_text(text_key_mask_value, "*", "0"))

            3. (Let i_key_mask_value be $text_to_int("0x" ++ text_key_mask_value'))

            4. (Let typedExpressionIR_mask_cast be ! $cast_control_plane(EC, typedExpressionIR_base, typeIR))

              1. (Let simpleKeysetExpressionIR be (typedExpressionIR_base_cast '&&&' typedExpressionIR_mask_cast))

              2. Return simpleKeysetExpressionIR

        2. Case (let (_BIN text_key_value) be %, % matches pattern `_BIN %`)

          1. (Let text_key_base_value be $replace_text(text_key_value, "*", "0"))

          2. (Let i_key_base_value be $text_to_int("0b" ++ text_key_base_value))

          3. (Let typedExpressionIR_base be (((D i_key_base_value) as expressionIR) '#' (`( ((INT) as typeIR) (DYN) `))))

          4. (Let typedExpressionIR_base_cast be ! $cast_control_plane(EC, typedExpressionIR_base, typeIR))

            1. (Let text_key_mask_value be $replace_text_except(text_key_value, "*", "1"))

            2. (Let text_key_mask_value' be $replace_text(text_key_mask_value, "*", "0"))

            3. (Let i_key_mask_value be $text_to_int("0b" ++ text_key_mask_value'))

            4. (Let typedExpressionIR_mask_cast be ! $cast_control_plane(EC, typedExpressionIR_base, typeIR))

              1. (Let simpleKeysetExpressionIR be (typedExpressionIR_base_cast '&&&' typedExpressionIR_mask_cast))

              2. Return simpleKeysetExpressionIR

      1. Else Dangling#13735

  3. Case (% = "lpm")

    1. (Let tableKeyValueInterface be ! $assoc_<nameIR, tableKeyValueInterface>(nameIR_key, (tableKeyInterface)*{tableKeyInterface <- tableKeyInterface*}))

      1. Case analysis on tableKeyValueInterface

        1. Case (let (_HEX text_key_value) be %, % matches pattern `_HEX %`)

          1. (Let text_key_value_prefix be $strip_suffix_rec(text_key_value, "*"))

