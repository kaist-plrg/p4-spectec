syntax continueEmptyResult = 
   | _EMPTY (from continueEmptyResult) 

syntax continueResult<X> = 
   | _CONT X (from continueResult<X>) 

syntax exitResult = 
   | EXIT (from exitResult) 

syntax returnResult = 
   | RETURN value? (from returnResult) 

syntax acceptTransitionResult = 
   | ACCEPT (from acceptTransitionResult) 

syntax rejectTransitionResult = 
   | REJECT errorValue (from rejectTransitionResult) 

syntax stateTransitionResult = 
   | STATE id (from stateTransitionResult) 

syntax abortResult = 
   | EXIT (from exitResult) 
   | REJECT errorValue (from rejectTransitionResult) 

syntax expressionResult = 
   | _CONT value (from continueResult<value>) 
   | EXIT (from exitResult) 
   | REJECT errorValue (from rejectTransitionResult) 

relation Expr_eval: p EC ARCH |- (expressionIR '#' _expressionNoteIR) : % % %

1. Case analysis on expressionIR

  1. Case (% has type booleanLiteral)

    1. (Let booleanLiteral be (expressionIR as booleanLiteral))

      1. (Let boolValue be $ite<boolValue>((booleanLiteral = (TRUE)), (_B true), (_B false)))

        1. (Let expressionResult be ((_CONT (boolValue as value)) as expressionResult))

          1. Result in: % % % |- % : EC ARCH expressionResult

  2. Case (% has type integerLiteral)

    1. (Let integerLiteral be (expressionIR as integerLiteral))

      1. (Let expressionResult be ((_CONT (integerLiteral as value)) as expressionResult))

        1. Result in: % % % |- % : EC ARCH expressionResult

  3. Case (% has type stringLiteral)

    1. (Let stringLiteral be (expressionIR as stringLiteral))

      1. (Let expressionResult be ((_CONT (stringLiteral as value)) as expressionResult))

        1. Result in: % % % |- % : EC ARCH expressionResult

  4. Case (% has type prefixedNameIR)

    1. (Let prefixedNameIR be (expressionIR as prefixedNameIR))

      1. (Let value be $find_var_e(prefixedNameIR, p, EC))

        1. (Let expressionResult be ((_CONT value) as expressionResult))

          1. Result in: % % % |- % : EC ARCH expressionResult

  5. Case (% has type defaultExpression)

    1. (Let defaultExpression be (expressionIR as defaultExpression))

      1. (Let expressionResult be ((_CONT ((DEFAULT) as value)) as expressionResult))

        1. Result in: % % % |- % : EC ARCH expressionResult

  6. Case (% has type unaryExpressionIR)

    1. (Let (unop typedExpressionIR) be (expressionIR as unaryExpressionIR))

      1. (Expr_eval: p EC ARCH |- typedExpressionIR : EC_1 ARCH_1 expressionResult')

        1. Case analysis on expressionResult'

          1. Case (% has type abortResult)

            1. (Let abortResult be (expressionResult' as abortResult))

              1. Result in: % % % |- % : EC_1 ARCH_1 (abortResult as expressionResult)

          2. Case (% has type continueResult<value>)

            1. (Let (_CONT value) be (expressionResult' as continueResult<value>))

              1. (Let expressionResult be ((_CONT $un_op(unop, value)) as expressionResult))

                1. Result in: % % % |- % : EC_1 ARCH_1 expressionResult

  7. Case (% has type binaryExpressionIR)

    1. (Let (typedExpressionIR_l binop typedExpressionIR_r) be (expressionIR as binaryExpressionIR))

      1. If (~binop is in [('&&'), ('||')]), then

        1. (Exprs_eval: p EC ARCH |- [typedExpressionIR_l, typedExpressionIR_r] : EC_1 ARCH_1 expressionListResult)

          1. Case analysis on expressionListResult

            1. Case (% has type abortResult)

              1. (Let abortResult be (expressionListResult as abortResult))

                1. Result in: % % % |- % : EC_1 ARCH_1 (abortResult as expressionResult)

            2. Case (% has type continueResult<value*>)

              1. (Let (_CONT (value)*{value <- value*}) be (expressionListResult as continueResult<value*>))

                1. If (((value)*{value <- value*} matches pattern [ _/2 ])), then

                  1. (Let [value_l, value_r] be (value)*{value <- value*})

                    1. (Let expressionResult be ((_CONT $bin_op(binop, value_l, value_r)) as expressionResult))

                      1. Result in: % % % |- % : EC_1 ARCH_1 expressionResult

                1. Else Dangling#10739

      1. Else Dangling#10733

      2. Case analysis on binop

        1. Case (% matches pattern `&&`)

          1. (Expr_eval: p EC ARCH |- typedExpressionIR_l : EC_1 ARCH_1 expressionResult')

            1. If ((expressionResult' has type abortResult)), then

              1. (Let abortResult be (expressionResult' as abortResult))

                1. Result in: % % % |- % : EC_1 ARCH_1 (abortResult as expressionResult)

            1. Else Dangling#10745

            2. Case analysis on expressionResult'

              1. Case (% = ((_CONT ((_B false) as value)) as expressionResult))

                1. (Let expressionResult be ((_CONT ((_B false) as value)) as expressionResult))

                  1. Result in: % % % |- % : EC_1 ARCH_1 expressionResult

              2. Case (% = ((_CONT ((_B true) as value)) as expressionResult))

                1. (Expr_eval: p EC_1 ARCH_1 |- typedExpressionIR_r : EC_2 ARCH_2 expressionResult_r)

                  1. Result in: % % % |- % : EC_2 ARCH_2 expressionResult_r

            2. Else Dangling#10748

        2. Case (% matches pattern `||`)

          1. (Expr_eval: p EC ARCH |- typedExpressionIR_l : EC_1 ARCH_1 expressionResult')

            1. If ((expressionResult' has type abortResult)), then

              1. (Let abortResult be (expressionResult' as abortResult))

                1. Result in: % % % |- % : EC_1 ARCH_1 (abortResult as expressionResult)

            1. Else Dangling#10754

            2. Case analysis on expressionResult'

              1. Case (% = ((_CONT ((_B true) as value)) as expressionResult))

                1. (Let expressionResult be ((_CONT ((_B true) as value)) as expressionResult))

                  1. Result in: % % % |- % : EC_1 ARCH_1 expressionResult

