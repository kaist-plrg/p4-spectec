    1. (Let typeParameterListOpt be $lift_typeParameterListIR((typeParameterIR)*{typeParameterIR <- typeParameterIR*}))

      1. (Let parameterList be $lift_parameterListIR((parameterIR)*{parameterIR <- parameterIR*}))

        1. Return (annotationList PACKAGE name typeParameterListOpt `( parameterList `) ';')

def $lift_typeDeclarationIR(typeDeclarationIR)

1. Case analysis on typeDeclarationIR

  1. Case (% has type derivedTypeDeclarationIR)

    1. (Let derivedTypeDeclarationIR be (typeDeclarationIR as derivedTypeDeclarationIR))

      1. Return ($lift_derivedTypeDeclarationIR(derivedTypeDeclarationIR) as typeDeclaration)

  2. Case (% has type typedefDeclarationIR)

    1. (Let typedefDeclarationIR be (typeDeclarationIR as typedefDeclarationIR))

      1. Return ($lift_typedefDeclarationIR(typedefDeclarationIR) as typeDeclaration)

  3. Case (% has type parserTypeDeclarationIR)

    1. (Let parserTypeDeclarationIR be (typeDeclarationIR as parserTypeDeclarationIR))

      1. Return ($lift_parserTypeDeclarationIR(parserTypeDeclarationIR) as typeDeclaration)

  4. Case (% has type controlTypeDeclarationIR)

    1. (Let controlTypeDeclarationIR be (typeDeclarationIR as controlTypeDeclarationIR))

      1. Return ($lift_controlTypeDeclarationIR(controlTypeDeclarationIR) as typeDeclaration)

  5. Case (% has type packageTypeDeclarationIR)

    1. (Let packageTypeDeclarationIR be (typeDeclarationIR as packageTypeDeclarationIR))

      1. Return ($lift_packageTypeDeclarationIR(packageTypeDeclarationIR) as typeDeclaration)

def $lift_declarationIR(declarationIR)

1. Case analysis on declarationIR

  1. Case (% has type constantDeclarationIR)

    1. (Let constantDeclarationIR be (declarationIR as constantDeclarationIR))

      1. Return ($lift_constantDeclarationIR(constantDeclarationIR) as declaration)

  2. Case (% has type instantiationIR)

    1. (Let instantiationIR be (declarationIR as instantiationIR))

      1. Return ($lift_instantiationIR(instantiationIR) as declaration)

  3. Case (% has type functionDeclarationIR)

    1. (Let functionDeclarationIR be (declarationIR as functionDeclarationIR))

      1. Return ($lift_functionDeclarationIR(functionDeclarationIR) as declaration)

  4. Case (% has type actionDeclarationIR)

    1. (Let actionDeclarationIR be (declarationIR as actionDeclarationIR))

      1. Return ($lift_actionDeclarationIR(actionDeclarationIR) as declaration)

  5. Case (% has type errorDeclarationIR)

    1. (Let errorDeclarationIR be (declarationIR as errorDeclarationIR))

