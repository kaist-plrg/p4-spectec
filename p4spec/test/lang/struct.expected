   | `B bool (from boolValue) 
   | ERROR . nameIR (from errorValue) 
   | MATCH_KIND . nameIR (from matchKindValue) 
   | " text " (from stringLiteral)  hint(print "#%#")
   | D int (from integerLiteral)  hint(print %)
   | nat W int (from integerLiteral)  hint(print %#W#%)
   | nat S int (from integerLiteral)  hint(print %#S#%)
   | nat . nat V int (from integerValue) 
   | LIST [ value* ] (from listValue) 
   | TUPLE ( value* ) (from tupleValue) 
   | HEADER_STACK [ value* ( nat ; nat ) ] (from headerStackValue) 
   | STRUCT typeId { fieldValue* } (from structValue) 
   | HEADER typeId { bool ; fieldValue* } (from headerValue) 
   | HEADER_UNION typeId { fieldValue* } (from headerUnionValue) 
   | typeId . nameIR (from enumValue) 
   | typeId . nameIR . value (from enumValue) 
   | REF objectId (from objectReferenceValue) 
   | DEFAULT (from defaultValue) 
   | {#} (from invalidHeaderValue) 
   | SEQ ( value* ) (from sequenceValue) 
   | SEQ ( value* , ... ) (from sequenceValue) 
   | RECORD { fieldValue* } (from recordValue) 
   | RECORD { fieldValue* , ... } (from recordValue) 
   | SET { value } (from setValue) 
   | SET { value* ( nat ) } (from setValue) 
   | SET { value &&& value } (from setValue) 
   | SET { value .. value } (from setValue) 
   | SET { ... } (from setValue) 
   | TABLE_ENUM typeId . nameIR (from tableMetadataEnumValue) 
   | TABLE_STRUCT typeId { HIT boolValue ; MISS boolValue ; ACTION_RUN tableMetadataEnumValue ; } (from tableMetadataStructValue) 

builtin def $bitstr_to_int(int, int')

builtin def $int_to_bitstr(int, int')

syntax bit = bool

syntax bits = bit*

builtin def $bits_to_int_unsigned(bits)

builtin def $bits_to_int_signed(bits)

builtin def $int_to_bits_unsigned(nat, int)

builtin def $int_to_bits_signed(nat, int)

def $int_of_integerValue(integerValue)

1. Case analysis on integerValue

  1. Case (% has type integerLiteral)

    1. (Let integerLiteral be (integerValue as integerLiteral))

      1. Case analysis on integerLiteral

        1. Case (% matches pattern `D %`)

          1. (Let (D i) be integerLiteral)

            1. Return i

        2. Case (% matches pattern `% S %`)

          1. (Let (w S i) be integerLiteral)

            1. Return $bitstr_to_int((w as int), i)

        3. Case (% matches pattern `% W %`)

          1. (Let (w W i) be integerLiteral)

            1. Return i

  2. Case (% matches pattern `% . % V %`)

    1. (Let (_nat . _nat' V i) be integerValue)

      1. Return i

def $nat_of_integerValue(integerValue)

1. (Let int be $int_of_integerValue(integerValue))

  1. If ((int has type nat)), then

    1. (Let n be (int as nat))

      1. Return ?(n)

2. Otherwise,

  1. Return ?()

def $update_fieldValue((fieldValue)*, nameIR, value)

1. Case analysis on (fieldValue)*

  1. Case (% matches pattern [])

    1. Return []

  2. Case (% matches pattern _ :: _)

    1. (Let (value_field_h nameIR_field_h ;) :: (fieldValue_t)* be (fieldValue)*)

      1. Case analysis on nameIR_field_h

        1. Case (% = nameIR)

          1. Return (value nameIR ;) :: (fieldValue_t)*

        2. Case (% =/= nameIR)

          1. Return (value_field_h nameIR_field_h ;) :: $update_fieldValue((fieldValue_t)*, nameIR, value)

def $update_headerUnion((fieldValue)*, nameIR)

1. Case analysis on (fieldValue)*

  1. Case (% matches pattern [])

    1. Return []

  2. Case (% matches pattern _ :: _)

    1. (Let (value_field_h nameIR_field_h ;) :: (fieldValue_t)* be (fieldValue)*)

      1. Case analysis on nameIR_field_h

        1. Case (% = nameIR)

          1. Return (value_field_h nameIR_field_h ;) :: $update_headerUnion((fieldValue_t)*, nameIR)

        2. Case (% =/= nameIR)

          1. If ((value_field_h has type headerValue)), then

            1. (Let (HEADER typeId { _bool ; (fieldValue')* }) be (value_field_h as headerValue))

              1. (Let value_field_h_update be ((HEADER typeId { false ; (fieldValue')* }) as value))

                1. Return (value_field_h_update nameIR_field_h ;) :: $update_headerUnion((fieldValue_t)*, nameIR)

          1. Else Dangling#436

def $isValid_header(value)

1. If ((value has type headerValue)), then

  1. (Let headerValue be (value as headerValue))

    1. (Let (HEADER _typeId { b_valid ; (_fieldValue)* }) be headerValue)

      1. Return b_valid

1. Else Dangling#440

def $invalidate_value(value)

1. Case analysis on value

  1. Case (% has type headerValue)

    1. (Let headerValue be (value as headerValue))

      1. Return ($invalidate_header(headerValue) as value)

  2. Case (% has type headerUnionValue)

    1. (Let headerUnionValue be (value as headerUnionValue))

      1. Return ($invalidate_headerUnion(headerUnionValue) as value)

1. Else Dangling#444

def $invalidate_header((HEADER typeId { _bool ; (fieldValue)* }))

1. Return (HEADER typeId { false ; (fieldValue)* })

def $invalidate_headerUnion((HEADER_UNION typeId { ((value_field nameIR_field ;))* }))

1. (Let value_field_invalidated be $invalidate_value(value_field))*

  1. If ((|(nameIR_field)*| = |(value_field_invalidated)*|)), then

    1. Return (HEADER_UNION typeId { ((value_field_invalidated nameIR_field ;))* })

  1. Else Dangling#451

def $write_value_from_bits(value, n_var, (b)*)

1. (Let (value_updated, (bool)*) be $write_value_from_bits'(value, n_var, (b)*))

  1. If (((bool)* matches pattern [])), then

    1. Return value_updated

  1. Else Dangling#454

def $write_value_from_bits'(value, n_var, (bool)*)

1. Case analysis on value

  1. Case (% has type boolValue)

    1. If (((bool)* matches pattern _ :: _)), then

      1. (Let b_h :: (b_t)* be (bool)*)

        1. Return (((`B b_h) as value), (b_t)*)

    1. Else Dangling#457

  2. Case (% has type integerLiteral)

    1. (Let integerLiteral be (value as integerLiteral))

      1. Case analysis on integerLiteral

        1. Case (% matches pattern `% W %`)

          1. (Let (w W _int) be integerLiteral)

            1. If ((|(bool)*| >= w)), then

              1. (Let (b_h)* be (bool)*[0 : w])

                1. (Let int be (|(bool)*| - w))

                  1. If ((int has type nat)), then

                    1. (Let n_t be (int as nat))

                      1. (Let (b_t)* be (bool)*[w : n_t])

                        1. (Let i be $int_to_bitstr((w as int), $bits_to_int_unsigned((b_h)*)))

                          1. Return (((w W i) as value), (b_t)*)

                  1. Else Dangling#466

            1. Else Dangling#463

        2. Case (% matches pattern `% S %`)

          1. (Let (w S _int) be integerLiteral)

            1. If ((|(bool)*| >= w)), then

              1. (Let (b_h)* be (bool)*[0 : w])

                1. (Let int be (|(bool)*| - w))

                  1. If ((int has type nat)), then

                    1. (Let n_t be (int as nat))

                      1. (Let (b_t)* be (bool)*[w : n_t])

                        1. (Let i be $int_to_bitstr((w as int), $bits_to_int_signed((b_h)*)))

                          1. Return (((w S i) as value), (b_t)*)

                  1. Else Dangling#475

            1. Else Dangling#472

      1. Else Dangling#461

  3. Case (% has type structValue)

    1. (Let (STRUCT typeId { (fieldValue)* }) be (value as structValue))

      1. (Let ((fieldValue_updated)*, (b_rest)*) be $write_value_fields_from_bits'((fieldValue)*, n_var, (bool)*))

        1. Return (((STRUCT typeId { (fieldValue_updated)* }) as value), (b_rest)*)

  4. Case (% has type headerValue)

    1. (Let (HEADER typeId { _bool ; (fieldValue)* }) be (value as headerValue))

      1. (Let ((fieldValue_updated)*, (b_rest)*) be $write_value_fields_from_bits'((fieldValue)*, n_var, (bool)*))

        1. Return (((HEADER typeId { true ; (fieldValue_updated)* }) as value), (b_rest)*)

  5. Case (% has type enumValue)

    1. (Let enumValue be (value as enumValue))

      1. If ((enumValue matches pattern `% . % . %`)), then

        1. (Let (typeId . nameIR . value') be enumValue)

          1. (Let (value_updated, (b_rest)*) be $write_value_from_bits'(value', n_var, (bool)*))

            1. Return (((typeId . "__UNSPECIFIED" . value_updated) as value), (b_rest)*)

      1. Else Dangling#487

  6. Case (% has type headerStackValue)

    1. (Let (HEADER_STACK [ (value')* ( n_idx ; n_size ) ]) be (value as headerStackValue))

      1. (Let ((value_updated)*, (b_rest)*) be $write_values_from_bits'((value')*, n_var, (bool)*))

        1. Return (((HEADER_STACK [ (value_updated)* ( n_idx ; n_size ) ]) as value), (b_rest)*)

1. Else Dangling#456

2. If ((value has type integerValue)), then

  1. (Let integerValue be (value as integerValue))

    1. If ((integerValue matches pattern `% . % V %`)), then

      1. (Let (n_max . _nat V i) be integerValue)

        1. If ((n_var = 0)), then

          1. Return (((n_max . 0 V i) as value), (bool)*)

        1. Else Dangling#498

        2. If ((|(bool)*| >= n_var)), then

          1. (Let (b_h)* be (bool)*[0 : n_var])

            1. (Let int be (|(bool)*| - n_var))

              1. If ((int has type nat)), then

                1. (Let n_t be (int as nat))

                  1. (Let (b_t)* be (bool)*[n_var : n_t])

                    1. (Let i' be $int_to_bitstr((n_var as int), $bits_to_int_signed((b_h)*)))

                      1. Return (((n_max . n_var V i') as value), (b_t)*)

              1. Else Dangling#503

        2. Else Dangling#500

    1. Else Dangling#496

2. Else Dangling#494

def $write_values_from_bits'((value)*, n_var, (b)*)

1. Case analysis on (value)*

  1. Case (% matches pattern [])

    1. Return ([], (b)*)

  2. Case (% matches pattern _ :: _)

    1. (Let value_h :: (value_t)* be (value)*)

      1. (Let (value_h_updated, (b_t)*) be $write_value_from_bits'(value_h, n_var, (b)*))

        1. (Let ((value_t_updated)*, (b_rest)*) be $write_values_from_bits'((value_t)*, n_var, (b_t)*))

          1. Return (value_h_updated :: (value_t_updated)*, (b_rest)*)

def $write_value_fields_from_bits'((fieldValue)*, n_var, (b)*)

1. Case analysis on (fieldValue)*

  1. Case (% matches pattern [])

    1. Return ([], (b)*)

  2. Case (% matches pattern _ :: _)

    1. (Let fieldValue_h :: (fieldValue_t)* be (fieldValue)*)

      1. (Let (fieldValue_h_updated, (b_t)*) be $write_value_field_from_bits'(fieldValue_h, n_var, (b)*))

        1. (Let ((fieldValue_t_updated)*, (b_rest)*) be $write_value_fields_from_bits'((fieldValue_t)*, n_var, (b_t)*))

          1. Return (fieldValue_h_updated :: (fieldValue_t_updated)*, (b_rest)*)

def $write_value_field_from_bits'((value id ;), n_var, (b)*)

1. (Let (value_updated, (b_rest)*) be $write_value_from_bits'(value, n_var, (b)*))

  1. Return ((value_updated id ;), (b_rest)*)

def $write_bits_from_value(value)

1. Case analysis on value

  1. Case (% has type boolValue)

    1. (Let (`B b) be (value as boolValue))

      1. Return [b]

  2. Case (% has type integerLiteral)

    1. (Let integerLiteral be (value as integerLiteral))

      1. Case analysis on integerLiteral

        1. Case (% matches pattern `% S %`)

          1. (Let (w S i) be integerLiteral)

            1. Return $int_to_bits_signed(w, i)

        2. Case (% matches pattern `% W %`)

          1. (Let (w W i) be integerLiteral)

            1. Return $int_to_bits_unsigned(w, i)

      1. Else Dangling#526

  3. Case (% has type headerStackValue)

    1. (Let (HEADER_STACK [ (value_element)* ( _nat ; _nat' ) ]) be (value as headerStackValue))

      1. Return $concat_<bool>(($write_bits_from_value(value_element))*)

  4. Case (% has type structValue)

    1. (Let (STRUCT _typeId { ((value_field id_field ;))* }) be (value as structValue))

      1. Return $concat_<bool>(($write_bits_from_value(value_field))*)

  5. Case (% has type headerValue)

    1. (Let (HEADER _typeId { bool ; ((value_field id_field ;))* }) be (value as headerValue))

      1. If ((bool = true)), then

        1. Return $concat_<bool>(($write_bits_from_value(value_field))*)

      1. Else Dangling#536

    2. (Let (HEADER _typeId { bool ; (_fieldValue)* }) be (value as headerValue))

      1. If ((bool = false)), then

        1. Return []

      1. Else Dangling#539

  6. Case (% has type headerUnionValue)

    1. (Let (HEADER_UNION _typeId { ((value' id ;))* }) be (value as headerUnionValue))

      1. Return $concat_<bool>(($write_bits_from_value(value'))*)

  7. Case (% has type enumValue)

    1. (Let enumValue be (value as enumValue))

      1. If ((enumValue matches pattern `% . % . %`)), then

        1. (Let (typeId . id . value') be enumValue)

          1. Return $write_bits_from_value(value')

      1. Else Dangling#544

1. Else Dangling#522

2. If ((value has type integerValue)), then

  1. (Let integerValue be (value as integerValue))

    1. If ((integerValue matches pattern `% . % V %`)), then

      1. (Let (_nat . w V i) be integerValue)

        1. Return $int_to_bits_unsigned(w, i)

    1. Else Dangling#549

2. Else Dangling#547

syntax voidTypeIR = 
   | VOID (from voidTypeIR) 

syntax boolTypeIR = 
   | BOOL (from boolTypeIR) 

syntax errorTypeIR = 
   | ERROR (from errorTypeIR) 

syntax matchKindTypeIR = 
   | MATCH_KIND (from matchKindTypeIR) 

syntax stringTypeIR = 
   | STRING (from stringTypeIR) 

syntax intTypeIR = 
   | INT (from intTypeIR) 

syntax fixedIntTypeIR = 
   | INT < nat > (from fixedIntTypeIR) 

syntax fixedBitTypeIR = 
   | BIT < nat > (from fixedBitTypeIR) 

syntax varBitTypeIR = 
   | VARBIT < nat > (from varBitTypeIR) 

syntax integerTypeIR = 
   | INT (from intTypeIR) 
   | INT < nat > (from fixedIntTypeIR) 
   | BIT < nat > (from fixedBitTypeIR) 
   | VARBIT < nat > (from varBitTypeIR) 

syntax baseTypeIR = 
   | VOID (from voidTypeIR) 
   | BOOL (from boolTypeIR) 
   | ERROR (from errorTypeIR) 
   | MATCH_KIND (from matchKindTypeIR) 
   | STRING (from stringTypeIR) 
   | INT (from intTypeIR) 
   | INT < nat > (from fixedIntTypeIR) 
   | BIT < nat > (from fixedBitTypeIR) 
   | VARBIT < nat > (from varBitTypeIR) 

syntax nameTypeIR = 
   | ` typeId (from nameTypeIR)  hint(print %0)

syntax typedefTypeIR = 
   | TYPEDEF typeId typeIR (from typedefTypeIR)  hint(print %0)

syntax newTypeIR = 
   | TYPE typeId typeIR (from newTypeIR)  hint(print %0)

syntax aliasTypeIR = 
   | TYPEDEF typeId typeIR (from typedefTypeIR)  hint(print %0)
   | TYPE typeId typeIR (from newTypeIR)  hint(print %0)

syntax listTypeIR = 
   | LIST < typeIR > (from listTypeIR) 

syntax tupleTypeIR = 
   | TUPLE < typeIR* > (from tupleTypeIR) 

syntax headerStackTypeIR = 
   | typeIR [ nat ] (from headerStackTypeIR) 

syntax fieldTypeIR = 
   | annotationList typeIR nameIR ; (from fieldTypeIR) 

syntax structTypeIR = 
   | STRUCT typeId < typeArgumentIR* > { fieldTypeIR* } (from structTypeIR)  hint(print %0#"<"#%1#">")

syntax headerTypeIR = 
   | HEADER typeId < typeArgumentIR* > { fieldTypeIR* } (from headerTypeIR)  hint(print %0#"<"#%1#">")

syntax headerUnionTypeIR = 
   | HEADER_UNION typeId < typeArgumentIR* > { fieldTypeIR* } (from headerUnionTypeIR)  hint(print %0#"<"#%1#">")

syntax valueFieldIR = 
   | nameIR = value ; (from valueFieldIR) 

syntax simpleEnumTypeIR = 
   | ENUM typeId { nameIR* } (from simpleEnumTypeIR)  hint(print %0)

syntax serializableEnumTypeIR = 
   | ENUM typeId < typeIR > { valueFieldIR* } (from serializableEnumTypeIR)  hint(print %0)

syntax enumTypeIR = 
   | ENUM typeId { nameIR* } (from simpleEnumTypeIR)  hint(print %0)
   | ENUM typeId < typeIR > { valueFieldIR* } (from serializableEnumTypeIR)  hint(print %0)

syntax dataTypeIR = 
   | LIST < typeIR > (from listTypeIR) 
   | TUPLE < typeIR* > (from tupleTypeIR) 
   | typeIR [ nat ] (from headerStackTypeIR) 
   | STRUCT typeId < typeArgumentIR* > { fieldTypeIR* } (from structTypeIR)  hint(print %0#"<"#%1#">")
   | HEADER typeId < typeArgumentIR* > { fieldTypeIR* } (from headerTypeIR)  hint(print %0#"<"#%1#">")
   | HEADER_UNION typeId < typeArgumentIR* > { fieldTypeIR* } (from headerUnionTypeIR)  hint(print %0#"<"#%1#">")
   | ENUM typeId { nameIR* } (from simpleEnumTypeIR)  hint(print %0)
   | ENUM typeId < typeIR > { valueFieldIR* } (from serializableEnumTypeIR)  hint(print %0)

syntax externMethodTypeDefEnv = map<callableId, externMethodTypeDefIR>

syntax externObjectTypeIR = 
   | EXTERN typeId < typeArgumentIR* > externMethodTypeDefEnv (from externObjectTypeIR)  hint(print %0#"<"#%1#">")

syntax parserObjectTypeIR = 
   | PARSER typeId < typeArgumentIR* > ( parameterIR* ) (from parserObjectTypeIR)  hint(print %0#"<"#%1#">")

syntax controlObjectTypeIR = 
   | CONTROL typeId < typeArgumentIR* > ( parameterIR* ) (from controlObjectTypeIR)  hint(print %0#"<"#%1#">")

syntax packageObjectTypeIR = 
   | PACKAGE typeId < typeArgumentIR* > { typeIR* } (from packageObjectTypeIR)  hint(print %0#"<"#%1#">")

syntax tableObjectTypeIR = 
   | TABLE typeId { tableMetadataStructTypeIR } (from tableObjectTypeIR)  hint(print %0)

syntax objectTypeIR = 
   | EXTERN typeId < typeArgumentIR* > externMethodTypeDefEnv (from externObjectTypeIR)  hint(print %0#"<"#%1#">")
   | PARSER typeId < typeArgumentIR* > ( parameterIR* ) (from parserObjectTypeIR)  hint(print %0#"<"#%1#">")
   | CONTROL typeId < typeArgumentIR* > ( parameterIR* ) (from controlObjectTypeIR)  hint(print %0#"<"#%1#">")
   | PACKAGE typeId < typeArgumentIR* > { typeIR* } (from packageObjectTypeIR)  hint(print %0#"<"#%1#">")
   | TABLE typeId { tableMetadataStructTypeIR } (from tableObjectTypeIR)  hint(print %0)

syntax defaultTypeIR = 
   | DEFAULT (from defaultTypeIR) 

syntax invalidHeaderTypeIR = 
   | HEADER_INVALID (from invalidHeaderTypeIR) 

syntax sequenceTypeIR = 
   | SEQ < typeIR* > (from sequenceTypeIR) 
   | SEQ < typeIR* , ... > (from sequenceTypeIR) 

syntax recordTypeIR = 
   | RECORD { fieldTypeIR* } (from recordTypeIR) 
   | RECORD { fieldTypeIR* , ... } (from recordTypeIR) 

syntax setTypeIR = 
   | SET < typeIR > (from setTypeIR) 

syntax tableMetadataEnumTypeIR = 
   | TABLE_ENUM typeId { nameIR* } (from tableMetadataEnumTypeIR)  hint(print %0)

syntax tableMetadataStructTypeIR = 
   | TABLE_STRUCT typeId { HIT boolTypeIR ; MISS boolTypeIR ; ACTION_RUN tableMetadataEnumTypeIR ; } (from tableMetadataStructTypeIR)  hint(print %0)

syntax tableMetadataTypeIR = 
   | TABLE_ENUM typeId { nameIR* } (from tableMetadataEnumTypeIR)  hint(print %0)
   | TABLE_STRUCT typeId { HIT boolTypeIR ; MISS boolTypeIR ; ACTION_RUN tableMetadataEnumTypeIR ; } (from tableMetadataStructTypeIR)  hint(print %0)

syntax synthesizedTypeIR = 
   | DEFAULT (from defaultTypeIR) 
   | HEADER_INVALID (from invalidHeaderTypeIR) 
   | SEQ < typeIR* > (from sequenceTypeIR) 
   | SEQ < typeIR* , ... > (from sequenceTypeIR) 
   | RECORD { fieldTypeIR* } (from recordTypeIR) 
   | RECORD { fieldTypeIR* , ... } (from recordTypeIR) 
   | SET < typeIR > (from setTypeIR) 
   | TABLE_ENUM typeId { nameIR* } (from tableMetadataEnumTypeIR)  hint(print %0)
   | TABLE_STRUCT typeId { HIT boolTypeIR ; MISS boolTypeIR ; ACTION_RUN tableMetadataEnumTypeIR ; } (from tableMetadataStructTypeIR)  hint(print %0)

syntax typeIR = 
   | VOID (from voidTypeIR) 
   | BOOL (from boolTypeIR) 
   | ERROR (from errorTypeIR) 
   | MATCH_KIND (from matchKindTypeIR) 
   | STRING (from stringTypeIR) 
   | INT (from intTypeIR) 
   | INT < nat > (from fixedIntTypeIR) 
   | BIT < nat > (from fixedBitTypeIR) 
   | VARBIT < nat > (from varBitTypeIR) 
   | ` typeId (from nameTypeIR)  hint(print %0)
   | TYPEDEF typeId typeIR (from typedefTypeIR)  hint(print %0)
   | TYPE typeId typeIR (from newTypeIR)  hint(print %0)
   | LIST < typeIR > (from listTypeIR) 
   | TUPLE < typeIR* > (from tupleTypeIR) 
   | typeIR [ nat ] (from headerStackTypeIR) 
   | STRUCT typeId < typeArgumentIR* > { fieldTypeIR* } (from structTypeIR)  hint(print %0#"<"#%1#">")
   | HEADER typeId < typeArgumentIR* > { fieldTypeIR* } (from headerTypeIR)  hint(print %0#"<"#%1#">")
   | HEADER_UNION typeId < typeArgumentIR* > { fieldTypeIR* } (from headerUnionTypeIR)  hint(print %0#"<"#%1#">")
   | ENUM typeId { nameIR* } (from simpleEnumTypeIR)  hint(print %0)
   | ENUM typeId < typeIR > { valueFieldIR* } (from serializableEnumTypeIR)  hint(print %0)
   | EXTERN typeId < typeArgumentIR* > externMethodTypeDefEnv (from externObjectTypeIR)  hint(print %0#"<"#%1#">")
   | PARSER typeId < typeArgumentIR* > ( parameterIR* ) (from parserObjectTypeIR)  hint(print %0#"<"#%1#">")
   | CONTROL typeId < typeArgumentIR* > ( parameterIR* ) (from controlObjectTypeIR)  hint(print %0#"<"#%1#">")
   | PACKAGE typeId < typeArgumentIR* > { typeIR* } (from packageObjectTypeIR)  hint(print %0#"<"#%1#">")
   | TABLE typeId { tableMetadataStructTypeIR } (from tableObjectTypeIR)  hint(print %0)
   | DEFAULT (from defaultTypeIR) 
   | HEADER_INVALID (from invalidHeaderTypeIR) 
   | SEQ < typeIR* > (from sequenceTypeIR) 
   | SEQ < typeIR* , ... > (from sequenceTypeIR) 
   | RECORD { fieldTypeIR* } (from recordTypeIR) 
   | RECORD { fieldTypeIR* , ... } (from recordTypeIR) 
   | SET < typeIR > (from setTypeIR) 
   | TABLE_ENUM typeId { nameIR* } (from tableMetadataEnumTypeIR)  hint(print %0)
   | TABLE_STRUCT typeId { HIT boolTypeIR ; MISS boolTypeIR ; ACTION_RUN tableMetadataEnumTypeIR ; } (from tableMetadataStructTypeIR)  hint(print %0)

syntax typeArgumentIR = typeIR

syntax typeParameterIR = typeId

syntax nameTypeDefIR = nameTypeIR

syntax aliasTypeDefIR = aliasTypeIR

syntax structTypeDefIR = 
   | STRUCT typeId < typeParameterIR* > { fieldTypeIR* } (from structTypeDefIR) 

syntax headerTypeDefIR = 
   | HEADER typeId < typeParameterIR* > { fieldTypeIR* } (from headerTypeDefIR) 

syntax headerUnionTypeDefIR = 
   | HEADER_UNION typeId < typeParameterIR* > { fieldTypeIR* } (from headerUnionTypeDefIR) 

syntax enumTypeDefIR = enumTypeIR

syntax dataTypeDefIR = 
   | STRUCT typeId < typeParameterIR* > { fieldTypeIR* } (from structTypeDefIR) 
   | HEADER typeId < typeParameterIR* > { fieldTypeIR* } (from headerTypeDefIR) 
   | HEADER_UNION typeId < typeParameterIR* > { fieldTypeIR* } (from headerUnionTypeDefIR) 
   | ENUM typeId { nameIR* } (from simpleEnumTypeIR)  hint(print %0)
   | ENUM typeId < typeIR > { valueFieldIR* } (from serializableEnumTypeIR)  hint(print %0)

syntax externObjectTypeDefIR = 
   | EXTERN typeId < typeParameterIR* , typeParameterIR* > externMethodTypeDefEnv (from externObjectTypeDefIR) 

syntax parserObjectTypeDefIR = 
   | PARSER typeId < typeParameterIR* , typeParameterIR* > ( parameterIR* ) (from parserObjectTypeDefIR) 

syntax controlObjectTypeDefIR = 
   | CONTROL typeId < typeParameterIR* , typeParameterIR* > ( parameterIR* ) (from controlObjectTypeDefIR) 

syntax packageObjectTypeDefIR = 
   | PACKAGE typeId < typeParameterIR* , typeParameterIR* > { typeIR* } (from packageObjectTypeDefIR) 

syntax tableObjectTypeDefIR = tableObjectTypeIR

syntax objectTypeDefIR = 
   | EXTERN typeId < typeParameterIR* , typeParameterIR* > externMethodTypeDefEnv (from externObjectTypeDefIR) 
   | PARSER typeId < typeParameterIR* , typeParameterIR* > ( parameterIR* ) (from parserObjectTypeDefIR) 
   | CONTROL typeId < typeParameterIR* , typeParameterIR* > ( parameterIR* ) (from controlObjectTypeDefIR) 
   | PACKAGE typeId < typeParameterIR* , typeParameterIR* > { typeIR* } (from packageObjectTypeDefIR) 
   | TABLE typeId { tableMetadataStructTypeIR } (from tableObjectTypeIR)  hint(print %0)

syntax typeDefIR = 
   | ` typeId (from nameTypeIR)  hint(print %0)
   | TYPEDEF typeId typeIR (from typedefTypeIR)  hint(print %0)
   | TYPE typeId typeIR (from newTypeIR)  hint(print %0)
   | STRUCT typeId < typeParameterIR* > { fieldTypeIR* } (from structTypeDefIR) 
   | HEADER typeId < typeParameterIR* > { fieldTypeIR* } (from headerTypeDefIR) 
   | HEADER_UNION typeId < typeParameterIR* > { fieldTypeIR* } (from headerUnionTypeDefIR) 
   | ENUM typeId { nameIR* } (from simpleEnumTypeIR)  hint(print %0)
   | ENUM typeId < typeIR > { valueFieldIR* } (from serializableEnumTypeIR)  hint(print %0)
   | EXTERN typeId < typeParameterIR* , typeParameterIR* > externMethodTypeDefEnv (from externObjectTypeDefIR) 
   | PARSER typeId < typeParameterIR* , typeParameterIR* > ( parameterIR* ) (from parserObjectTypeDefIR) 
   | CONTROL typeId < typeParameterIR* , typeParameterIR* > ( parameterIR* ) (from controlObjectTypeDefIR) 
   | PACKAGE typeId < typeParameterIR* , typeParameterIR* > { typeIR* } (from packageObjectTypeDefIR) 
   | TABLE typeId { tableMetadataStructTypeIR } (from tableObjectTypeIR)  hint(print %0)

def $unroll_typeIR(typeIR)

1. If ((typeIR has type typedefTypeIR)), then

  1. (Let (TYPEDEF _typeId typeIR') be (typeIR as typedefTypeIR))

    1. Return $unroll_typeIR(typeIR')

2. Otherwise,

  1. Return typeIR

def $unroll_aliasType(typeIR)

1. Case analysis on typeIR

  1. Case (% has type newTypeIR)

    1. (Let (TYPE _typeId typeIR') be (typeIR as newTypeIR))

      1. Return $unroll_aliasType(typeIR')

  2. Case (% has type typedefTypeIR)

    1. (Let (TYPEDEF _typeId typeIR') be (typeIR as typedefTypeIR))

      1. Return $unroll_aliasType(typeIR')

2. Otherwise,

  1. Return typeIR

def $width_of_integerTypeIR(integerTypeIR)

1. Case analysis on integerTypeIR

  1. Case (% has type intTypeIR)

    1. (Let intTypeIR be (integerTypeIR as intTypeIR))

      1. Return ?()

  2. Case (% has type fixedIntTypeIR)

    1. (Let (INT < n >) be (integerTypeIR as fixedIntTypeIR))

      1. Return ?(n)

  3. Case (% has type fixedBitTypeIR)

    1. (Let (BIT < n >) be (integerTypeIR as fixedBitTypeIR))

      1. Return ?(n)

  4. Case (% has type varBitTypeIR)

    1. (Let (VARBIT < n >) be (integerTypeIR as varBitTypeIR))

      1. Return ?(n)

tbl def $is_defaultable_typeIR(typeIR'')
=

  Row : ((BOOL) as typeIR) -> true:

    1. If ((typeIR'' has type boolTypeIR)), then

      1. (Let boolTypeIR be (typeIR'' as boolTypeIR))

        1. Return true

  Row : ((ERROR) as typeIR) -> true:

    1. If ((typeIR'' has type errorTypeIR)), then

      1. (Let errorTypeIR be (typeIR'' as errorTypeIR))

        1. Return true

  Row : ((STRING) as typeIR) -> true:

    1. If ((typeIR'' has type stringTypeIR)), then

      1. (Let stringTypeIR be (typeIR'' as stringTypeIR))

        1. Return true

  Row : (integerTypeIR as typeIR) -> true:

    1. If ((typeIR'' has type integerTypeIR)), then

      1. Return true

  Row : ((TYPEDEF _typeId typeIR) as typeIR) -> $is_defaultable_typeIR(typeIR):

    1. If ((typeIR'' has type typedefTypeIR)), then

      1. (Let (TYPEDEF _typeId typeIR) be (typeIR'' as typedefTypeIR))

        1. Return $is_defaultable_typeIR(typeIR)

  Row : ((TYPE _typeId typeIR) as typeIR) -> $is_defaultable_typeIR(typeIR):

    1. If ((typeIR'' has type newTypeIR)), then

      1. (Let (TYPE _typeId typeIR) be (typeIR'' as newTypeIR))

        1. Return $is_defaultable_typeIR(typeIR)

  Row : ((TUPLE < (typeIR)* >) as typeIR) -> $forall_(($is_defaultable_typeIR(typeIR))*):

    1. If ((typeIR'' has type tupleTypeIR)), then

      1. (Let (TUPLE < (typeIR)* >) be (typeIR'' as tupleTypeIR))

        1. Return $forall_(($is_defaultable_typeIR(typeIR))*)

  Row : ((typeIR [ _nat ]) as typeIR) -> $is_defaultable_typeIR(typeIR):

    1. If ((typeIR'' has type headerStackTypeIR)), then

      1. (Let (typeIR [ _nat ]) be (typeIR'' as headerStackTypeIR))

        1. Return $is_defaultable_typeIR(typeIR)

  Row : ((STRUCT _typeId < (_typeArgumentIR)* > { ((_annotationList typeIR _nameIR ;))* }) as typeIR) -> $forall_(($is_defaultable_typeIR(typeIR))*):

    1. If ((typeIR'' has type structTypeIR)), then

      1. (Let (STRUCT _typeId < (_typeArgumentIR)* > { ((_annotationList typeIR _nameIR ;))* }) be (typeIR'' as structTypeIR))

        1. Return $forall_(($is_defaultable_typeIR(typeIR))*)

  Row : ((HEADER _typeId < (_typeArgumentIR)* > { ((_annotationList typeIR _nameIR ;))* }) as typeIR) -> $forall_(($is_defaultable_typeIR(typeIR))*):

    1. If ((typeIR'' has type headerTypeIR)), then

      1. (Let (HEADER _typeId < (_typeArgumentIR)* > { ((_annotationList typeIR _nameIR ;))* }) be (typeIR'' as headerTypeIR))

        1. Return $forall_(($is_defaultable_typeIR(typeIR))*)

  Row : ((HEADER_UNION _typeId < (_typeArgumentIR)* > { ((_annotationList typeIR _nameIR ;))* }) as typeIR) -> $forall_(($is_defaultable_typeIR(typeIR))*):

    1. If ((typeIR'' has type headerUnionTypeIR)), then

      1. (Let (HEADER_UNION _typeId < (_typeArgumentIR)* > { ((_annotationList typeIR _nameIR ;))* }) be (typeIR'' as headerUnionTypeIR))

        1. Return $forall_(($is_defaultable_typeIR(typeIR))*)

  Row : ((ENUM _typeId { (_nameIR)* }) as typeIR) -> true:

    1. If ((typeIR'' has type simpleEnumTypeIR)), then

      1. Return true

  Row : ((ENUM _typeId < typeIR > { (_valueFieldIR)* }) as typeIR) -> $is_defaultable_typeIR(typeIR):

    1. If ((typeIR'' has type serializableEnumTypeIR)), then

      1. (Let (ENUM _typeId < typeIR > { (_valueFieldIR)* }) be (typeIR'' as serializableEnumTypeIR))

        1. Return $is_defaultable_typeIR(typeIR)

  Row : _typeIR -> false:

    1. Return false

tbl def $is_equalable_typeIR(typeIR'')
=

  Row : ((VOID) as typeIR) -> false:

    1. If ((typeIR'' has type voidTypeIR)), then

      1. (Let voidTypeIR be (typeIR'' as voidTypeIR))

        1. Return false

  Row : ((` typeId) as typeIR) -> false:

    1. If ((typeIR'' has type nameTypeIR)), then

      1. Return false

  Row : ((TYPEDEF _typeId typeIR) as typeIR) -> $is_equalable_typeIR(typeIR):

    1. If ((typeIR'' has type typedefTypeIR)), then

      1. (Let (TYPEDEF _typeId typeIR) be (typeIR'' as typedefTypeIR))

        1. Return $is_equalable_typeIR(typeIR)

  Row : (externObjectTypeIR as typeIR) -> false:

    1. If ((typeIR'' has type externObjectTypeIR)), then

      1. Return false

  Row : (parserObjectTypeIR as typeIR) -> false:

    1. If ((typeIR'' has type parserObjectTypeIR)), then

      1. Return false

  Row : (controlObjectTypeIR as typeIR) -> false:

    1. If ((typeIR'' has type controlObjectTypeIR)), then

      1. Return false

  Row : (packageObjectTypeIR as typeIR) -> false:

    1. If ((typeIR'' has type packageObjectTypeIR)), then

      1. Return false

  Row : (tableObjectTypeIR as typeIR) -> false:

    1. If ((typeIR'' has type tableObjectTypeIR)), then

      1. Return false

  Row : ((DEFAULT) as typeIR) -> false:

    1. If ((typeIR'' has type defaultTypeIR)), then

      1. (Let defaultTypeIR be (typeIR'' as defaultTypeIR))

        1. Return false

  Row : (sequenceTypeIR as typeIR) -> false:

    1. If ((typeIR'' has type sequenceTypeIR)), then

      1. Return false

  Row : (recordTypeIR as typeIR) -> false:

    1. If ((typeIR'' has type recordTypeIR)), then

      1. Return false

  Row : ((HEADER_INVALID) as typeIR) -> false:

    1. If ((typeIR'' has type invalidHeaderTypeIR)), then

      1. (Let invalidHeaderTypeIR be (typeIR'' as invalidHeaderTypeIR))

        1. Return false

  Row : (setTypeIR as typeIR) -> false:

    1. If ((typeIR'' has type setTypeIR)), then

      1. Return false

  Row : (tableMetadataTypeIR as typeIR) -> false:

    1. If ((typeIR'' has type tableMetadataTypeIR)), then

      1. Return false

  Row : _typeIR -> true:

    1. Return true

tbl def $is_assignable_typeIR(typeIR'')
=

  Row : ((VOID) as typeIR) -> false:

    1. If ((typeIR'' has type voidTypeIR)), then

      1. (Let voidTypeIR be (typeIR'' as voidTypeIR))

        1. Return false

  Row : ((STRING) as typeIR) -> false:

    1. If ((typeIR'' has type stringTypeIR)), then

      1. (Let stringTypeIR be (typeIR'' as stringTypeIR))

        1. Return false

  Row : ((INT) as typeIR) -> false:

    1. If ((typeIR'' has type intTypeIR)), then

      1. (Let intTypeIR be (typeIR'' as intTypeIR))

        1. Return false

  Row : ((TYPEDEF _typeId typeIR) as typeIR) -> $is_assignable_typeIR(typeIR):

    1. If ((typeIR'' has type typedefTypeIR)), then

      1. (Let (TYPEDEF _typeId typeIR) be (typeIR'' as typedefTypeIR))

        1. Return $is_assignable_typeIR(typeIR)

  Row : (objectTypeIR as typeIR) -> false:

    1. If ((typeIR'' has type objectTypeIR)), then

      1. Return false

  Row : (synthesizedTypeIR as typeIR) -> false:

    1. If ((typeIR'' has type synthesizedTypeIR)), then

      1. Return false

  Row : _typeIR -> true:

    1. Return true

def $typeId_of_typeDefIR(typeDefIR)

1. Case analysis on typeDefIR

  1. Case (% has type nameTypeIR)

    1. (Let (` typeId) be (typeDefIR as nameTypeIR))

      1. Return typeId

  2. Case (% has type typedefTypeIR)

    1. (Let (TYPEDEF typeId _typeIR) be (typeDefIR as typedefTypeIR))

      1. Return typeId

  3. Case (% has type newTypeIR)

    1. (Let (TYPE typeId _typeIR) be (typeDefIR as newTypeIR))

      1. Return typeId

  4. Case (% has type structTypeDefIR)

    1. (Let (STRUCT typeId < (_typeParameterIR)* > { (_fieldTypeIR)* }) be (typeDefIR as structTypeDefIR))

      1. Return typeId

  5. Case (% has type headerTypeDefIR)

    1. (Let (HEADER typeId < (_typeParameterIR)* > { (_fieldTypeIR)* }) be (typeDefIR as headerTypeDefIR))

      1. Return typeId

  6. Case (% has type headerUnionTypeDefIR)

    1. (Let (HEADER_UNION typeId < (_typeParameterIR)* > { (_fieldTypeIR)* }) be (typeDefIR as headerUnionTypeDefIR))

      1. Return typeId

  7. Case (% has type simpleEnumTypeIR)

    1. (Let (ENUM typeId { (_nameIR)* }) be (typeDefIR as simpleEnumTypeIR))

      1. Return typeId

  8. Case (% has type serializableEnumTypeIR)

    1. (Let (ENUM typeId < _typeIR > { (_valueFieldIR)* }) be (typeDefIR as serializableEnumTypeIR))

      1. Return typeId

  9. Case (% has type externObjectTypeDefIR)

    1. (Let (EXTERN typeId < (_typeParameterIR)* , (_typeParameterIR')* > ({ (_pair<callableId, externMethodTypeDefIR>)* })) be (typeDefIR as externObjectTypeDefIR))

      1. Return typeId

  10. Case (% has type parserObjectTypeDefIR)

    1. (Let (PARSER typeId < (_typeParameterIR)* , (_typeParameterIR')* > ( (_parameterIR)* )) be (typeDefIR as parserObjectTypeDefIR))

      1. Return typeId

  11. Case (% has type controlObjectTypeDefIR)

    1. (Let (CONTROL typeId < (_typeParameterIR)* , (_typeParameterIR')* > ( (_parameterIR)* )) be (typeDefIR as controlObjectTypeDefIR))

      1. Return typeId

  12. Case (% has type packageObjectTypeDefIR)

    1. (Let (PACKAGE typeId < (_typeParameterIR)* , (_typeParameterIR')* > { (_typeIR)* }) be (typeDefIR as packageObjectTypeDefIR))

      1. Return typeId

  13. Case (% has type tableObjectTypeIR)

    1. (Let (TABLE typeId { _tableMetadataStructTypeIR }) be (typeDefIR as tableObjectTypeIR))

      1. Return typeId

def $typeIR_of_typeDefIR(typeDefIR)

1. Case analysis on typeDefIR

  1. Case (% has type nameTypeDefIR)

    1. (Let nameTypeDefIR be (typeDefIR as nameTypeDefIR))

      1. Return (nameTypeDefIR as typeIR)

  2. Case (% has type aliasTypeDefIR)

    1. (Let aliasTypeDefIR be (typeDefIR as aliasTypeDefIR))

      1. Return (aliasTypeDefIR as typeIR)

  3. Case (% has type structTypeDefIR)

    1. (Let (STRUCT typeId < (typeParameterIR)* > { (fieldTypeIR)* }) be (typeDefIR as structTypeDefIR))

      1. Return ((STRUCT typeId < (((` typeParameterIR) as typeIR))* > { (fieldTypeIR)* }) as typeIR)

  4. Case (% has type headerTypeDefIR)

    1. (Let (HEADER typeId < (typeParameterIR)* > { (fieldTypeIR)* }) be (typeDefIR as headerTypeDefIR))

      1. Return ((HEADER typeId < (((` typeParameterIR) as typeIR))* > { (fieldTypeIR)* }) as typeIR)

  5. Case (% has type headerUnionTypeDefIR)

    1. (Let (HEADER_UNION typeId < (typeParameterIR)* > { (fieldTypeIR)* }) be (typeDefIR as headerUnionTypeDefIR))

      1. Return ((HEADER_UNION typeId < (((` typeParameterIR) as typeIR))* > { (fieldTypeIR)* }) as typeIR)

  6. Case (% has type enumTypeDefIR)

    1. (Let enumTypeDefIR be (typeDefIR as enumTypeDefIR))

      1. Return (enumTypeDefIR as typeIR)

  7. Case (% has type externObjectTypeDefIR)

    1. (Let (EXTERN typeId < (typeParameterIR_expl)* , (typeParameterIR_impl)* > ({ ((callableId : externMethodTypeDefIR))* })) be (typeDefIR as externObjectTypeDefIR))

      1. (Let (typeParameterIR)* be (typeParameterIR_expl)* ++ (typeParameterIR_impl)*)

        1. Return ((EXTERN typeId < (((` typeParameterIR) as typeIR))* > ({ ((callableId : externMethodTypeDefIR))* })) as typeIR)

  8. Case (% has type parserObjectTypeDefIR)

    1. (Let (PARSER typeId < (typeParameterIR_expl)* , (typeParameterIR_impl)* > ( (parameterIR)* )) be (typeDefIR as parserObjectTypeDefIR))

      1. (Let (typeParameterIR)* be (typeParameterIR_expl)* ++ (typeParameterIR_impl)*)

        1. Return ((PARSER typeId < (((` typeParameterIR) as typeIR))* > ( (parameterIR)* )) as typeIR)

  9. Case (% has type controlObjectTypeDefIR)

    1. (Let (CONTROL typeId < (typeParameterIR_expl)* , (typeParameterIR_impl)* > ( (parameterIR)* )) be (typeDefIR as controlObjectTypeDefIR))

      1. (Let (typeParameterIR)* be (typeParameterIR_expl)* ++ (typeParameterIR_impl)*)

        1. Return ((CONTROL typeId < (((` typeParameterIR) as typeIR))* > ( (parameterIR)* )) as typeIR)

  10. Case (% has type packageObjectTypeDefIR)

    1. (Let (PACKAGE typeId < (typeParameterIR_expl)* , (typeParameterIR_impl)* > { (typeIR)* }) be (typeDefIR as packageObjectTypeDefIR))

      1. (Let (typeParameterIR)* be (typeParameterIR_expl)* ++ (typeParameterIR_impl)*)

        1. Return ((PACKAGE typeId < (((` typeParameterIR) as typeIR))* > { (typeIR)* }) as typeIR)

  11. Case (% has type tableObjectTypeDefIR)

    1. (Let tableObjectTypeDefIR be (typeDefIR as tableObjectTypeDefIR))

      1. Return (tableObjectTypeDefIR as typeIR)

def $typeParameterListIR_of_typeDefIR(typeDefIR)

1. Case analysis on typeDefIR

  1. Case (% has type nameTypeDefIR)

    1. Return ([], [])

  2. Case (% has type aliasTypeDefIR)

    1. Return ([], [])

  3. Case (% has type structTypeDefIR)

    1. (Let (STRUCT _typeId < (typeParameterIR)* > { (_fieldTypeIR)* }) be (typeDefIR as structTypeDefIR))

      1. Return ((typeParameterIR)*, [])

  4. Case (% has type headerTypeDefIR)

    1. (Let (HEADER _typeId < (typeParameterIR)* > { (_fieldTypeIR)* }) be (typeDefIR as headerTypeDefIR))

      1. Return ((typeParameterIR)*, [])

  5. Case (% has type headerUnionTypeDefIR)

    1. (Let (HEADER_UNION _typeId < (typeParameterIR)* > { (_fieldTypeIR)* }) be (typeDefIR as headerUnionTypeDefIR))

      1. Return ((typeParameterIR)*, [])

  6. Case (% has type enumTypeDefIR)

    1. Return ([], [])

  7. Case (% has type externObjectTypeDefIR)

    1. (Let (EXTERN _typeId < (typeParameterIR_expl)* , (typeParameterIR_impl)* > ({ (_pair<callableId, externMethodTypeDefIR>)* })) be (typeDefIR as externObjectTypeDefIR))

      1. Return ((typeParameterIR_expl)*, (typeParameterIR_impl)*)

  8. Case (% has type parserObjectTypeDefIR)

    1. (Let (PARSER _typeId < (typeParameterIR_expl)* , (typeParameterIR_impl)* > ( (_parameterIR)* )) be (typeDefIR as parserObjectTypeDefIR))

      1. Return ((typeParameterIR_expl)*, (typeParameterIR_impl)*)

  9. Case (% has type controlObjectTypeDefIR)

    1. (Let (CONTROL _typeId < (typeParameterIR_expl)* , (typeParameterIR_impl)* > ( (_parameterIR)* )) be (typeDefIR as controlObjectTypeDefIR))

      1. Return ((typeParameterIR_expl)*, (typeParameterIR_impl)*)

  10. Case (% has type packageObjectTypeDefIR)

    1. (Let (PACKAGE _typeId < (typeParameterIR_expl)* , (typeParameterIR_impl)* > { (_typeIR)* }) be (typeDefIR as packageObjectTypeDefIR))

      1. Return ((typeParameterIR_expl)*, (typeParameterIR_impl)*)

  11. Case (% has type tableObjectTypeDefIR)

