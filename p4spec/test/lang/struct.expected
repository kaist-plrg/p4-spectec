      2. Case (% matches pattern `% W %`)

        1. (Let (w W i) be integerLiteral)

          1. (Let i' be ($pow2(w) - i))

            1. Return ((w W i') as value)

      3. Case (% matches pattern `% S %`)

        1. (Let (w S i) be integerLiteral)

          1. (Let i' be $int_to_bitstr((w as int), $bitstr_to_int((w as int), -i)))

            1. Return ((w S i') as value)

