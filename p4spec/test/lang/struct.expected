def $find_local_return_type_t(TC)

1. (Let localKind be TC.LOCAL.KIND)

  1. Case analysis on localKind

    1. Case (% has type definedFunctionLocalKind)

      1. (Let (FUNCTION ':' typeIR_ret) be (localKind as definedFunctionLocalKind))

        1. Return ?(typeIR_ret)

    2. Case (% has type externFunctionLocalKind)

      1. (Let (EXTERN_FUNCTION ':' typeIR_ret) be (localKind as externFunctionLocalKind))

        1. Return ?(typeIR_ret)

2. If ((((ACTION) as localKind) = TC.LOCAL.KIND)), then

  1. Return ?(((VOID) as typeIR))

3. (Let localKind be TC.LOCAL.KIND)

  1. If ((localKind has type externMethodLocalKind)), then

    1. (Let externMethodLocalKind be (localKind as externMethodLocalKind))

      1. Case analysis on externMethodLocalKind

        1. Case (% matches pattern `EXTERN_METHOD : %`)

          1. (Let (EXTERN_METHOD ':' typeIR_ret) be externMethodLocalKind)

            1. Return ?(typeIR_ret)

        2. Case (% matches pattern `EXTERN_METHOD ABSTRACT : %`)

          1. (Let (EXTERN_METHOD ABSTRACT ':' typeIR_ret) be externMethodLocalKind)

            1. Return ?(typeIR_ret)

4. If ((((CONTROL_APPLY_METHOD) as localKind) = TC.LOCAL.KIND)), then

  1. Return ?(((VOID) as typeIR))

5. Otherwise,

  1. Return ?()

syntax matchKey = 
   | typeIR ':' nameIR (from matchKey) 

syntax matchAction = 
   | prefixedNameIR `( parameterIR* '@' argumentListIR `) (from matchAction) 

syntax matchPriority = {DELTA nat, LARGEST_WINS bool}

syntax matchEntries = {SIZE nat, CONST bool}

syntax matchMode = 
   | NONE (from matchMode) 
   | LPM nat (from matchMode) 
   | PRI (from matchMode) 

syntax tableContext = {KEYS matchKey*, ACTIONS matchAction*, PRIORITIES matchPriority, ENTRIES matchEntries, MODE matchMode}

var TBLC : tableContext

syntax tableEntryState = 
   | LPM nat (from tableEntryState) 
   | NON_LPM (from tableEntryState) 

var TBLS : tableEntryState

def $empty_tableContext

1. (Let matchPriority be {DELTA 1, LARGEST_WINS true})

  1. (Let matchEntries be {SIZE 0, CONST true})

    1. Return {KEYS [], ACTIONS [], PRIORITIES matchPriority, ENTRIES matchEntries, MODE (NONE)}

def $add_key_tbl(TBLC, id, typeIR)

1. (Let matchKey be (typeIR ':' id))

  1. Return TBLC[KEYS = TBLC.KEYS ++ [matchKey]]

def $add_action_tbl(TBLC, prefixedNameIR, (parameterIR)*{parameterIR <- parameterIR*}, argumentListIR)

1. (Let matchAction be (prefixedNameIR `( (parameterIR)*{parameterIR <- parameterIR*} '@' argumentListIR `)))

  1. Return TBLC[ACTIONS = TBLC.ACTIONS ++ [matchAction]]

def $is_lpm_key((_typedExpressionIR '#' _nameIR ':' nameIR _annotationList ';'))

1. Return $is_lpm_key'(nameIR)

def $is_lpm_key'(t)

1. If ((t = "lpm")), then

  1. Return true

2. Otherwise,

  1. Return false

def $requires_priority((_typedExpressionIR '#' _nameIR ':' nameIR _annotationList ';'))

1. Return $requires_priority'(nameIR)

def $requires_priority'(t)

1. Case analysis on t

  1. Case (% = "range")

    1. Return true

  2. Case (% = "ternary")

    1. Return true

  3. Case (% = "optional")

    1. Return true

2. Otherwise,

  1. Return false

def $update_mode_tbl(TBLC, (tableKeyIR)*{tableKeyIR <- tableKeyIR*})

1. (Let b_pri be $requires_priority(tableKeyIR))*{tableKeyIR <- tableKeyIR*, b_pri -> b_pri*}

  1. Case analysis on $exists_((b_pri)*{b_pri <- b_pri*})

    1. Case true

