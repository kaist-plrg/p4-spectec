def $concat_text((t)*{t <- t*})

1. Case analysis on (t)*{t <- t*}

  1. Case (% matches pattern [])

    1. Return ""

  2. Case (% matches pattern _ :: _)

    1. (Let t_h :: (t_t)*{t_t <- t_t*} be (t)*{t <- t*})

      1. Return t_h ++ $concat_text((t_t)*{t_t <- t_t*})

def $join_text((t')*{t' <- t'*}, t_sep)

1. Case analysis on (t')*{t' <- t'*}

  1. Case (% matches pattern [])

    1. Return ""

  2. Case (% matches pattern [ _/1 ])

    1. (Let [t_h] be (t')*{t' <- t'*})

      1. Return t_h

  3. Case (% matches pattern _ :: _)

    1. (Let t_h1 :: (t)*{t <- t*} be (t')*{t' <- t'*})

      1. If (((t)*{t <- t*} matches pattern _ :: _)), then

        1. (Let t_h2 :: (t_t)*{t_t <- t_t*} be (t)*{t <- t*})

          1. Return t_h1 ++ t_sep ++ $join_text(t_h2 :: (t_t)*{t_t <- t_t*}, t_sep)

      1. Else Dangling#12

1. Else Dangling#7

def $replace_text(t, t_old, t_new)

1. Return $replace_text'(0, |t|, t, t_old, t_new)

def $replace_text'(n_len, n_len', t, t_old, t_new)

1. If ((n_len = n_len')), then

  1. Return t

1. Else Dangling#16

2. If ((n_len < n_len')), then

  1. If ((n_len < |t|)), then

    1. (Let t_replaced be $ite<text>((t[n_len] = t_old), t[[n_len] = t_new], t))

      1. Return $replace_text'((n_len + 1), n_len', t_replaced, t_old, t_new)

  1. Else Dangling#19

2. Else Dangling#18

