tbl def $compat_range(typeIR'', typeIR''')
=

  Row : ((INT) as typeIR), ((INT) as typeIR) -> true:

    1. If ((typeIR'' has type intTypeIR)), then

      1. (Let intTypeIR be (typeIR'' as intTypeIR))

        1. If ((typeIR''' has type intTypeIR)), then

          1. (Let intTypeIR' be (typeIR''' as intTypeIR))

            1. Return true

  Row : ((INT `< w_l `>) as typeIR), ((INT `< w_r `>) as typeIR) -> (w_l = w_r):

    1. If ((typeIR'' has type fixedIntTypeIR)), then

      1. (Let (INT `< w_l `>) be (typeIR'' as fixedIntTypeIR))

        1. If ((typeIR''' has type fixedIntTypeIR)), then

          1. (Let (INT `< w_r `>) be (typeIR''' as fixedIntTypeIR))

            1. Return (w_l = w_r)

  Row : ((BIT `< w_l `>) as typeIR), ((BIT `< w_r `>) as typeIR) -> (w_l = w_r):

    1. If ((typeIR'' has type fixedBitTypeIR)), then

      1. (Let (BIT `< w_l `>) be (typeIR'' as fixedBitTypeIR))

        1. If ((typeIR''' has type fixedBitTypeIR)), then

          1. (Let (BIT `< w_r `>) be (typeIR''' as fixedBitTypeIR))

            1. Return (w_l = w_r)

  Row : ((TYPEDEF _typeId typeIR_l) as typeIR), typeIR_r -> $compat_range(typeIR_l, typeIR_r):

    1. If ((typeIR'' has type typedefTypeIR)), then

      1. (Let (TYPEDEF _typeId typeIR_l) be (typeIR'' as typedefTypeIR))

        1. Return $compat_range(typeIR_l, typeIR''')

  Row : typeIR_l, ((TYPEDEF _typeId typeIR_r) as typeIR) -> $compat_range(typeIR_l, typeIR_r):

    1. If ((typeIR''' has type typedefTypeIR)), then

      1. (Let (TYPEDEF _typeId typeIR_r) be (typeIR''' as typedefTypeIR))

        1. Return $compat_range(typeIR'', typeIR_r)

  Row : _typeIR, _typeIR' -> false:

    1. Return false

