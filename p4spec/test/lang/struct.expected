        1. Return ((EXTERN typeId `< (((_NAME typeParameterIR) as typeIR))*{typeParameterIR <- typeParameterIR*} `> (`{ ((callableId ':' externMethodTypeDefIR))*{callableId <- callableId*, externMethodTypeDefIR <- externMethodTypeDefIR*} `})) as typeIR)

  8. Case (% has type parserObjectTypeDefIR)

    1. (Let (PARSER typeId `< (typeParameterIR_expl)*{typeParameterIR_expl <- typeParameterIR_expl*} ',' (typeParameterIR_impl)*{typeParameterIR_impl <- typeParameterIR_impl*} `> `( (parameterIR)*{parameterIR <- parameterIR*} `)) be (typeDefIR as parserObjectTypeDefIR))

      1. (Let (typeParameterIR)*{typeParameterIR <- typeParameterIR*} be (typeParameterIR_expl)*{typeParameterIR_expl <- typeParameterIR_expl*} ++ (typeParameterIR_impl)*{typeParameterIR_impl <- typeParameterIR_impl*})

        1. Return ((PARSER typeId `< (((_NAME typeParameterIR) as typeIR))*{typeParameterIR <- typeParameterIR*} `> `( (parameterIR)*{parameterIR <- parameterIR*} `)) as typeIR)

  9. Case (% has type controlObjectTypeDefIR)

    1. (Let (CONTROL typeId `< (typeParameterIR_expl)*{typeParameterIR_expl <- typeParameterIR_expl*} ',' (typeParameterIR_impl)*{typeParameterIR_impl <- typeParameterIR_impl*} `> `( (parameterIR)*{parameterIR <- parameterIR*} `)) be (typeDefIR as controlObjectTypeDefIR))

      1. (Let (typeParameterIR)*{typeParameterIR <- typeParameterIR*} be (typeParameterIR_expl)*{typeParameterIR_expl <- typeParameterIR_expl*} ++ (typeParameterIR_impl)*{typeParameterIR_impl <- typeParameterIR_impl*})

        1. Return ((CONTROL typeId `< (((_NAME typeParameterIR) as typeIR))*{typeParameterIR <- typeParameterIR*} `> `( (parameterIR)*{parameterIR <- parameterIR*} `)) as typeIR)

  10. Case (% has type packageObjectTypeDefIR)

    1. (Let (PACKAGE typeId `< (typeParameterIR_expl)*{typeParameterIR_expl <- typeParameterIR_expl*} ',' (typeParameterIR_impl)*{typeParameterIR_impl <- typeParameterIR_impl*} `> `{ (typeIR)*{typeIR <- typeIR*} `}) be (typeDefIR as packageObjectTypeDefIR))

      1. (Let (typeParameterIR)*{typeParameterIR <- typeParameterIR*} be (typeParameterIR_expl)*{typeParameterIR_expl <- typeParameterIR_expl*} ++ (typeParameterIR_impl)*{typeParameterIR_impl <- typeParameterIR_impl*})

        1. Return ((PACKAGE typeId `< (((_NAME typeParameterIR) as typeIR))*{typeParameterIR <- typeParameterIR*} `> `{ (typeIR)*{typeIR <- typeIR*} `}) as typeIR)

  11. Case (% has type tableObjectTypeDefIR)

    1. (Let tableObjectTypeDefIR be (typeDefIR as tableObjectTypeDefIR))

      1. Return (tableObjectTypeDefIR as typeIR)

