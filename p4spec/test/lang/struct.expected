  11. Case (% has type structTypeIR)

    1. (Let (STRUCT _typeId `< (_typeArgumentIR)*{_typeArgumentIR <- _typeArgumentIR*} `> `{ ((_annotationList typeIR _nameIR ';'))*{_annotationList <- _annotationList*, _nameIR <- _nameIR*, typeIR <- typeIR*} `}) be (typeIR' as structTypeIR))

      1. Return $sum_nat(($sizeof_minSizeInBits'(typeIR))*{typeIR <- typeIR*})

  12. Case (% has type headerTypeIR)

