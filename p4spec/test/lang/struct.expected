def $update_object_unqualified_e(ARCH_0, id, object)

1. (Let ({ ((objectId : _object))* }) be ARCH_0.STORE)

  1. (Let (objectId_id)? be $ite<objectId?>($objectId_ends_with(objectId, id), ?(objectId), ?()))*

    1. (Let ((objectId')?)* be $filter_<objectId?>(((objectId_id)?)*, (((objectId_id)? =/= ?()))*))

      1. If ((((objectId')?)* matches pattern [ _/1 ])), then

        1. (Let [(objectId'')?] be ((objectId')?)*)

          1. If (((objectId'')? matches pattern (_))), then

