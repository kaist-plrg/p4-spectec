        1. Return $forall_(($is_defaultable_typeIR(typeIR))*)

  Row : ((enum _typeId { (_nameIR)* }) as typeIR) -> true:

    1. If ((typeIR'' has type simpleEnumTypeIR)), then

      1. Return true

  Row : ((enum _typeId < typeIR >{ (_valueFieldIR)* }) as typeIR) -> $is_defaultable_typeIR(typeIR):

    1. If ((typeIR'' has type serializableEnumTypeIR)), then

      1. (Let (enum _typeId < typeIR >{ (_valueFieldIR)* }) be (typeIR'' as serializableEnumTypeIR))

        1. Return $is_defaultable_typeIR(typeIR)

  Row : _typeIR -> false:

    1. Return false

