syntax callableTypeDefIR = 
   | annotationList ACTION nameIR `( parameterIR* `) (from actionTypeIR) 
   | FUNCTION nameIR `< typeParameterIR* ',' typeParameterIR* `> `( parameterIR* `) ':' typeIR (from definedFunctionTypeDefIR) 
   | EXTERN_FUNCTION nameIR `< typeParameterIR* ',' typeParameterIR* `> `( parameterIR* `) ':' typeIR (from externFunctionTypeDefIR) 
   | EXTERN_METHOD nameIR `< typeParameterIR* ',' typeParameterIR* `> `( parameterIR* `) ':' typeIR (from externMethodTypeDefIR) 
   | EXTERN_METHOD ABSTRACT nameIR `< typeParameterIR* ',' typeParameterIR* `> `( parameterIR* `) ':' typeIR (from externMethodTypeDefIR) 
   | PARSER_APPLY `( parameterIR* `) (from parserApplyMethodTypeIR) 
   | CONTROL_APPLY `( parameterIR* `) (from controlApplyMethodTypeIR) 
   | TABLE_APPLY ':' tableMetadataStructTypeIR (from tableApplyMethodTypeIR) 

def $callableTypeIR_of_callableTypeDefIR(callableTypeDefIR)

1. Case analysis on callableTypeDefIR

  1. Case (% has type actionTypeDefIR)

    1. (Let actionTypeDefIR be (callableTypeDefIR as actionTypeDefIR))

      1. Return (actionTypeDefIR as callableTypeIR)

  2. Case (% has type definedFunctionTypeDefIR)

    1. (Let (FUNCTION nameIR `< (_typeParameterIR)*{_typeParameterIR <- _typeParameterIR*} ',' (_typeParameterIR')*{_typeParameterIR' <- _typeParameterIR'*} `> `( (parameterIR)*{parameterIR <- parameterIR*} `) ':' typeIR) be (callableTypeDefIR as definedFunctionTypeDefIR))

      1. Return ((FUNCTION nameIR `( (parameterIR)*{parameterIR <- parameterIR*} `) ':' typeIR) as callableTypeIR)

  3. Case (% has type externFunctionTypeDefIR)

    1. (Let (EXTERN_FUNCTION nameIR `< (_typeParameterIR)*{_typeParameterIR <- _typeParameterIR*} ',' (_typeParameterIR')*{_typeParameterIR' <- _typeParameterIR'*} `> `( (parameterIR)*{parameterIR <- parameterIR*} `) ':' typeIR) be (callableTypeDefIR as externFunctionTypeDefIR))

      1. Return ((EXTERN_FUNCTION nameIR `( (parameterIR)*{parameterIR <- parameterIR*} `) ':' typeIR) as callableTypeIR)

  4. Case (% has type externMethodTypeDefIR)

    1. (Let externMethodTypeDefIR be (callableTypeDefIR as externMethodTypeDefIR))

      1. Case analysis on externMethodTypeDefIR

        1. Case (% matches pattern `EXTERN_METHOD % <% , %> (%) : %`)

          1. (Let (EXTERN_METHOD nameIR `< (_typeParameterIR)*{_typeParameterIR <- _typeParameterIR*} ',' (_typeParameterIR')*{_typeParameterIR' <- _typeParameterIR'*} `> `( (parameterIR)*{parameterIR <- parameterIR*} `) ':' typeIR) be externMethodTypeDefIR)

            1. Return ((EXTERN_METHOD nameIR `( (parameterIR)*{parameterIR <- parameterIR*} `) ':' typeIR) as callableTypeIR)

        2. Case (% matches pattern `EXTERN_METHOD ABSTRACT % <% , %> (%) : %`)

          1. (Let (EXTERN_METHOD ABSTRACT nameIR `< (_typeParameterIR)*{_typeParameterIR <- _typeParameterIR*} ',' (_typeParameterIR')*{_typeParameterIR' <- _typeParameterIR'*} `> `( (parameterIR)*{parameterIR <- parameterIR*} `) ':' typeIR) be externMethodTypeDefIR)

            1. Return ((EXTERN_METHOD ABSTRACT nameIR `( (parameterIR)*{parameterIR <- parameterIR*} `) ':' typeIR) as callableTypeIR)

  5. Case (% has type parserApplyMethodTypeDefIR)

    1. (Let parserApplyMethodTypeDefIR be (callableTypeDefIR as parserApplyMethodTypeDefIR))

      1. Return (parserApplyMethodTypeDefIR as callableTypeIR)

  6. Case (% has type controlApplyMethodTypeDefIR)

    1. (Let controlApplyMethodTypeDefIR be (callableTypeDefIR as controlApplyMethodTypeDefIR))

      1. Return (controlApplyMethodTypeDefIR as callableTypeIR)

1. Else Dangling#841

