def $is_valid_bitslice(typeIR, n_lo, n_hi)

1. Case analysis on typeIR

  1. Case (% has type intTypeIR)

    1. (Let intTypeIR be (typeIR as intTypeIR))

      1. Return (n_lo <= n_hi)

  2. Case (% has type fixedIntTypeIR)

    1. (Let (int< w >) be (typeIR as fixedIntTypeIR))

      1. (Let int be ((n_hi - n_lo) + (1 as int)))

        1. If ((int has type nat)), then

          1. (Let w_slice be (int as nat))

            1. Return (((n_lo <= n_hi) /\ (n_hi <= w)) /\ (w_slice <= w))

  3. Case (% has type fixedBitTypeIR)

    1. (Let (bit< w >) be (typeIR as fixedBitTypeIR))

      1. (Let int be ((n_hi - n_lo) + (1 as int)))

        1. If ((int has type nat)), then

          1. (Let w_slice be (int as nat))

            1. Return (((n_lo <= n_hi) /\ (n_hi <= w)) /\ (w_slice <= w))

  4. Case (% has type typedefTypeIR)

    1. (Let (typedef _typeId typeIR') be (typeIR as typedefTypeIR))

      1. Return $is_valid_bitslice(typeIR', n_lo, n_hi)

2. Otherwise,

  1. Return false

def $is_concrete_extern_object(typeIR)

1. Return $is_concrete_extern_object'($unroll_typeIR(typeIR))

def $is_concrete_extern_object'(typeIR)

1. Case analysis on (typeIR has type externObjectTypeIR)

  1. Case false

    1. Return true

  2. Case true

    1. (Let (extern _typeId < (_typeArgumentIR)* > ({ ((_callableId : externMethodTypeDefIR))* })) be (typeIR as externObjectTypeIR))

      1. If ($is_concrete_extern_object''(externMethodTypeDefIR))*, then

        1. Return true

2. Otherwise,

  1. Return false

def $is_concrete_extern_object''(externMethodTypeDefIR)

1. If ((externMethodTypeDefIR matches pattern `EXTERN_METHOD%<%,%>(%):%`)), then

  1. Return true

2. Otherwise,

  1. Return false

relation ParameterList_ok_inner: p typingContext |- (parameter)* : % % # %

1. Group : p typingContext |- (parameter)* : % % # %

  1. If (((parameter)* = [])), then

    1. Result in: % % |- % : typingContext [] # []

  1. Else Phantom#1318

  2. If (((parameter)* matches pattern _ :: _)), then

    1. (Let parameter_h :: (parameter_t)* be (parameter)*)

      1. (Parameter_ok: p typingContext |- parameter_h : TC_1 parameterIR_h # (typeId_fresh_h)*)

        1. (ParameterList_ok_inner: p TC_1 |- (parameter_t)* : TC_2 (parameterIR_t)* # (typeId_fresh_t)*)

          1. (Let (parameterIR)* be parameterIR_h :: (parameterIR_t)*)

            1. (Let (typeId_fresh)* be (typeId_fresh_h)* ++ (typeId_fresh_t)*)

              1. Result in: % % |- % : TC_2 (parameterIR)* # (typeId_fresh)*

  2. Else Phantom#1319

relation ForUpdateStmt_ok: TC |- forUpdateStatement : %

1. Group : TC |- forUpdateStatement : %

  1. Case analysis on forUpdateStatement

    1. Case (% matches pattern `%(%)`)

      1. (Let (lvalue_callable ( argumentList )) be forUpdateStatement)

        1. (Stmt_ok: (local) TC (cont) (noloop) |- ((lvalue_callable ( argumentList );) as statement) : _typingContext _flow statementIR)

          1. If ((statementIR has type callStatementIR)), then

            1. (Let (callableTargetIR < (typeArgumentIR)* >( (argumentIR)* );) be (statementIR as callStatementIR))

              1. Result in: % |- % : (callableTargetIR < (typeArgumentIR)* >( (argumentIR)* ))

          1. Else Phantom#1320

    2. Case (% matches pattern `%<%>(%)`)

      1. (Let (lvalue_callable < typeArgumentList >( argumentList )) be forUpdateStatement)

        1. (Stmt_ok: (local) TC (cont) (noloop) |- ((lvalue_callable < typeArgumentList >( argumentList );) as statement) : _typingContext _flow statementIR)

          1. If ((statementIR has type callStatementIR)), then

            1. (Let (callableTargetIR < (typeArgumentIR)* >( (argumentIR)* );) be (statementIR as callStatementIR))

              1. Result in: % |- % : (callableTargetIR < (typeArgumentIR)* >( (argumentIR)* ))

          1. Else Phantom#1321

    3. Case (% matches pattern `%%%`)

      1. (Let (lvalue assignop expression) be forUpdateStatement)

        1. (Stmt_ok: (local) TC (cont) (noloop) |- ((lvalue assignop expression ;) as statement) : _typingContext _flow statementIR)

          1. If ((statementIR has type assignmentStatementIR)), then

            1. (Let (typedLvalueIR assignop' typedExpressionIR ;) be (statementIR as assignmentStatementIR))

              1. If ((assignop' = assignop)), then

                1. Result in: % |- % : (typedLvalueIR assignop typedExpressionIR)

              1. Else Phantom#1322

          1. Else Phantom#1323

relation ForUpdateStmtList_ok: TC |- forUpdateStatementList : %

1. Group : TC |- forUpdateStatementList : %

  1. (Let (forUpdateStatement)* be $flatten_forUpdateStatementList(forUpdateStatementList))

    1. (ForUpdateStmt_ok: TC |- forUpdateStatement : forUpdateStatementIR)*

      1. Result in: % |- % : (forUpdateStatementIR)*

relation ForInitStmt_ok: typingContext |- forInitStatement : % %

1. Group : typingContext |- forInitStatement : % %

  1. Case analysis on forInitStatement

    1. Case (% matches pattern `%%%%`)

