syntax callTargetValue = callTargetParameter*

syntax callTargetMatch = 
   | MATCH id* id* (from callTargetMatch)  hint(prose MATCH "with defaults" %0 and "optionals" %1)
   | NOMATCH (from callTargetMatch) 

syntax callResolution<V> = 
   | callableId : V # nameIR* # nameIR* (from callResolution<V>)  hint(prose_fields "call target id" "call target" "defaults" "optionals")

def $callTargetKey(nameIR_f, (argumentIR)*)

1. (Let (id_arg)? be $callTargetKey'(argumentIR))*

  1. Return (nameIR_f ( ((id_arg)?)* ))

def $callTargetKey'(argumentIR)

1. Case analysis on argumentIR

  1. Case (% has type typedExpressionIR)

    1. Return ?()

  2. Case (% matches pattern `% = %`)

    1. (Let (id_arg = _typedExpressionIR) be argumentIR)

      1. Return ?(id_arg)

  3. Case (% matches pattern `% = _`)

    1. (Let (id_arg = _) be argumentIR)

      1. Return ?(id_arg)

  4. Case (% matches pattern `_`)

    1. Return ?()

def $match_overloaded_named<V>((callTargetId : V), (nameIR_f ( (id_arg)* )), $get_parameterListIR)

1. (Let (nameIR ( (id_param)* )) be callTargetId)

  1. If ((nameIR = nameIR_f)), then

    1. (Let (parameterIR)* be $get_parameterListIR(V))

      1. If ((|(id_param)*| = |(parameterIR)*|)), then

        1. If ((id_param = $id_of_parameterIR(parameterIR)))*, then

          1. If ((|(id_param)*| = |(id_arg)*|)), then

            1. Return $ite<callTargetMatch>($eq_set<id>(({ (id_param)* }), ({ (id_arg)* })), (MATCH [] []), (NOMATCH))

          2. (Let b_default be $is_default_parameterIR(parameterIR))*

            1. (Let b_optional be $is_optional_parameterIR(parameterIR))*

              1. If ((|(id_param)*| > |(id_arg)*|)), then

                1. (Let ({ (id_param_omitted)* }) be $diff_set<id>(({ (id_param)* }), ({ (id_arg)* })))

                  1. (Let (id_default_param)* be $filter_<id>((id_param)*, ($is_default_parameterIR(parameterIR))*))

                    1. (Let (id_default)* be $filter_<id>((id_param_omitted)*, (id_param_omitted is in (id_default_param)*)*))

                      1. (Let (id_optional_param)* be $filter_<id>((id_param)*, ($is_optional_parameterIR(parameterIR))*))

                        1. (Let (id_optional)* be $filter_<id>((id_param_omitted)*, (id_param_omitted is in (id_optional_param)*)*))

                          1. If ($eq_set<id>(({ (id_default)* ++ (id_optional)* }), ({ (id_param_omitted)* }))), then

                            1. Return (MATCH (id_default)* (id_optional)*)

2. Otherwise,

  1. Return (NOMATCH)

def $match_overloaded_unnamed<V>((callTargetId : V), (nameIR_f ( n_arg )), $get_parameterListIR)

1. (Let (nameIR ( (id_param)* )) be callTargetId)

  1. If ((nameIR = nameIR_f)), then

    1. (Let (parameterIR)* be $get_parameterListIR(V))

      1. (Let b_default be $is_default_parameterIR(parameterIR))*

        1. (Let b_optional be $is_optional_parameterIR(parameterIR))*

          1. If (~($exists_((b_default)*) /\ $exists_((b_optional)*))), then

            1. If ((|(id_param)*| = n_arg)), then

              1. Return (MATCH [] [])

            2. If ((|(id_param)*| > n_arg)), then

              1. (Let ((parameterIR_given)*, (parameterIR_omitted)*) be $partition_<parameterIR>((parameterIR)*, n_arg))

                1. If (~$is_optional_parameterIR(parameterIR_omitted))*, then

                  1. If ($is_default_parameterIR(parameterIR_omitted))*, then

                    1. (Let id_default be $id_of_parameterIR(parameterIR_omitted))*

                      1. Return (MATCH (id_default)* [])

                2. If (~$is_default_parameterIR(parameterIR_given))*, then

                  1. If ($is_optional_parameterIR(parameterIR_omitted))*, then

                    1. (Let id_optional be $id_of_parameterIR(parameterIR_omitted))*

                      1. Return (MATCH [] (id_optional)*)

2. Otherwise,

  1. Return (NOMATCH)

def $find_overloadeds_named<V>(set<pair<callableId, V>>, (nameIR_f ( (id_arg)* )), $get_parameterListIR)

1. If ((set<pair<callableId, V>> = ({ [] }))), then

  1. Return []

1. Else Dangling#2698

2. (Let ({ (pair<callableId, V>)* }) be set<pair<callableId, V>>)

  1. If (((pair<callableId, V>)* matches pattern _ :: _)), then

    1. (Let (callTargetId_h : V_h) :: ((callTargetId_t : V_t))* be (pair<callableId, V>)*)

      1. If (($match_overloaded_named<V>((callTargetId_h : V_h), (nameIR_f ( (id_arg)* )), $get_parameterListIR) matches pattern `NOMATCH`)), then

        1. Return $find_overloadeds_named<V>(({ ((callTargetId_t : V_t))* }), (nameIR_f ( (id_arg)* )), $get_parameterListIR)

      1. Else Dangling#2703

      2. (Let callTargetMatch be $match_overloaded_named<V>((callTargetId_h : V_h), (nameIR_f ( (id_arg)* )), $get_parameterListIR))

        1. If ((callTargetMatch matches pattern `MATCH % %`)), then

          1. (Let (MATCH (id_default)* (id_optional)*) be callTargetMatch)

            1. Return (callTargetId_h : V_h # (id_default)* # (id_optional)*) :: $find_overloadeds_named<V>(({ ((callTargetId_t : V_t))* }), (nameIR_f ( (id_arg)* )), $get_parameterListIR)

        1. Else Dangling#2706

  1. Else Dangling#2701

def $find_overloadeds_unnamed<V>(set<pair<callableId, V>>, (nameIR_f ( nat )), $get_parameterListIR)

1. If ((set<pair<callableId, V>> = ({ [] }))), then

  1. Return []

1. Else Dangling#2709

2. (Let ({ (pair<callableId, V>)* }) be set<pair<callableId, V>>)

  1. If (((pair<callableId, V>)* matches pattern _ :: _)), then

    1. (Let (callTargetId_h : V_h) :: ((callTargetId_t : V_t))* be (pair<callableId, V>)*)

