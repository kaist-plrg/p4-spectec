  8. Case (% has type structTypeIR)

    1. (Let structTypeIR be (typeIR as structTypeIR))

      1. (Let (struct typeId < (typeArgumentIR)* >{ ((annotationList typeIR_field nameIR_field ;))* }) be structTypeIR)

        1. (Let typeArgumentIR_subst be $subst_typeIR'(theta, typeArgumentIR))*

