        1. (Let blockKind be TC.BLOCK.KIND)

          1. Return ((blockKind = (PARSER)) \/ (blockKind = (CONTROL)))

  3. Case (% matches pattern `LOCAL`)

    1. Case analysis on nameIR

      1. Case (% = "verify")

        1. (Let localKind be TC.LOCAL.KIND)

          1. Return (localKind = ((PARSER_STATE) as localKind))

      2. Case (% =/= "verify")

        1. Return true

