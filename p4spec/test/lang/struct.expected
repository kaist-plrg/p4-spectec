          1. If (((typedExpressionIR)?{typedExpressionIR <- typedExpressionIR?} matches pattern (_))), then

            1. (Let ?(typedExpressionIR_arg_cast) be (typedExpressionIR)?{typedExpressionIR <- typedExpressionIR?})

