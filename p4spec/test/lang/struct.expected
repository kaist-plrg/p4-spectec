          2. Case (% =/= nameIR_f)

            1. (Let ((callableId_t_found, V_t_found))* be $find_non_overloadeds<V>(({ ((callableId_t : V_t))* }), nameIR_f))

              1. Return ((callableId_t_found, V_t_found))*

  1. Else Dangling#2744

def $name_annotation(annotationList)

1. (Let (annotation)* be $flatten_annotationList(annotationList))

  1. (Let (nameIR_opt)? be $name_annotation_opt(annotation))*

    1. (Let ((nameIR_found)*)* be ($opt_as_seq_<nameIR>((nameIR_opt)?))*)

      1. Return $concat_<nameIR>(((nameIR_found)*)*)

def $name_annotation_opt(annotation)

1. If ((annotation matches pattern `@ % (%)`)), then

  1. (Let (@ name ( annotationBody )) be annotation)

    1. If (("name" = $name(name))), then

      1. If ((annotationBody matches pattern `% %`)), then

        1. (Let (annotationBody' annotationToken) be annotationBody)

          1. If ((annotationBody' matches pattern `/* empty */`)), then

            1. (Let nameIR be $print_<annotationToken>(annotationToken))

              1. Return ?($strip_prefix($strip_suffix(nameIR, "\""), "\""))

2. Otherwise,

  1. Return ?()

def $name_annotation_default(annotationList, nameIR)

1. (Let (nameIR')* be $name_annotation(annotationList))

