def $find_non_overloadeds<V>(set<pair<callableId, V>>, nameIR_f)

1. If ((set<pair<callableId, V>> = ({ [] }))), then

  1. Return []

1. Else Dangling#2741

2. (Let ({ (pair<callableId, V>)* }) be set<pair<callableId, V>>)

  1. If (((pair<callableId, V>)* matches pattern _ :: _)), then

    1. (Let (callableId_h : V_h) :: ((callableId_t : V_t))* be (pair<callableId, V>)*)

      1. (Let (nameIR ( (_id)* )) be callableId_h)

