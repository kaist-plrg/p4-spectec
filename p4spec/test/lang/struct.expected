    1. (Decls_ok: TC_0 |- (declaration)*{declaration <- declaration*} : TC_1 (declarationIR)*{declarationIR <- declarationIR*})

      1. Result in: |- % : ((declarationIR)*{declarationIR <- declarationIR*} ';')

syntax actctxt = 
   | ACTION (from actctxt) 
   | NOACTION (from actctxt) 

relation Call_convention_expr_ok: p TC actctxt |- (_annotationList direction typeIR_param _id _parameterInitializerOptIR) '@' typedExpressionIR_arg : %

1. Case analysis on direction

  1. Case (% matches pattern `IN`)

    1. (Let (typedExpressionIR)?{typedExpressionIR <- typedExpressionIR?} be $cast_unary(typedExpressionIR_arg, typeIR_param))

