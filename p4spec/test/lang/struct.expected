syntax theta = map<typeId, typeIR>

def $empty_theta

1. Return $empty_map<typeId, typeIR>

def $capture_avoiding_(theta, (typeParameterIR)*, B)

1. (Let ({ (typeId_free)* }) be $diff_set<typeId>(B, ({ (typeParameterIR)* })))

  1. (Let (typeIR)? be $find_map<typeId, typeIR>(theta, typeId_free))*

    1. If (((typeIR)? matches pattern (_)))*, then

      1. (Let ?(typeIR_free) be (typeIR)?)*

        1. (Let B_capture be $unions_set<typeId>(($free_typeIR(typeIR_free))*))

          1. (Let (typeParameterIR_fresh)* be $fresh_typeIds(|(typeParameterIR)*|))

            1. If (~$in_set<typeId>(typeParameterIR_fresh, B_capture))*, then

              1. (Let theta_fresh be $adds_map<typeId, typeIR>(theta, (typeParameterIR)*, (((` typeParameterIR_fresh) as typeIR))*))

                1. Return (theta_fresh, (typeParameterIR_fresh)*)

            1. Else Phantom#67

    1. Else Phantom#68

def $capture_avoiding(theta, (typeParameterIR_expl)*, (typeParameterIR_impl)*, B)

1. (Let ({ (typeId_free)* }) be $diff_set<typeId>(B, ({ (typeParameterIR_expl)* ++ (typeParameterIR_impl)* })))

  1. (Let (typeIR)? be $find_map<typeId, typeIR>(theta, typeId_free))*

    1. If (((typeIR)? matches pattern (_)))*, then

      1. (Let ?(typeIR_free) be (typeIR)?)*

        1. (Let B_capture be $unions_set<typeId>(($free_typeIR(typeIR_free))*))

          1. (Let (typeId_fresh)* be $fresh_typeIds(|(typeParameterIR_expl)* ++ (typeParameterIR_impl)*|))

            1. If (~$in_set<typeId>(typeId_fresh, B_capture))*, then

              1. (Let (typeParameterIR_expl_fresh)* be (typeId_fresh)*[0 : |(typeParameterIR_expl)*|])

                1. (Let (typeParameterIR_impl_fresh)* be (typeId_fresh)*[|(typeParameterIR_expl)*| : |(typeParameterIR_impl)*|])

                  1. (Let theta_fresh be $adds_map<typeId, typeIR>(theta, (typeParameterIR_expl)* ++ (typeParameterIR_impl)*, (((` typeParameterIR_expl_fresh) as typeIR))* ++ (((` typeParameterIR_impl_fresh) as typeIR))*))

                    1. Return (theta_fresh, (typeParameterIR_expl_fresh)*, (typeParameterIR_impl_fresh)*)

            1. Else Phantom#69

    1. Else Phantom#70

def $subst_typeIR(set<pair<typeId, typeIR>>, typeIR)

1. If ((set<pair<typeId, typeIR>> = ({ [] }))), then

  1. Return typeIR

2. Otherwise,

  1. Return $subst_typeIR'(set<pair<typeId, typeIR>>, typeIR)

def $subst_typeIR'(theta, typeIR)

1. Case analysis on typeIR

  1. Case (% has type baseTypeIR)

    1. (Let baseTypeIR be (typeIR as baseTypeIR))

      1. Return (baseTypeIR as typeIR)

  2. Case (% has type nameTypeIR)

    1. (Let (` typeId) be (typeIR as nameTypeIR))

      1. (Let (typeIR')? be $find_map<typeId, typeIR>(theta, typeId))

        1. If (((typeIR')? matches pattern (_))), then

          1. (Let ?(typeIR'') be (typeIR')?)

            1. Return typeIR''

        1. Else Phantom#71

      2. If ((?() = $find_map<typeId, typeIR>(theta, typeId))), then

        1. Return ((` typeId) as typeIR)

      2. Else Phantom#72

  3. Case (% has type typedefTypeIR)

    1. (Let (typedef typeId typeIR') be (typeIR as typedefTypeIR))

      1. (Let typeIR_subst be $subst_typeIR'(theta, typeIR'))

        1. Return ((typedef typeId typeIR_subst) as typeIR)

  4. Case (% has type newTypeIR)

    1. (Let (type typeId typeIR') be (typeIR as newTypeIR))

      1. (Let typeIR_subst be $subst_typeIR'(theta, typeIR'))

