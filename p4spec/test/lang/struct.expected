syntax trailingCommaOpt = 
   | _EMPTY (from trailingCommaOpt) 
   | ',' (from trailingCommaOpt) 

syntax booleanLiteral = 
   | TRUE (from booleanLiteral) 
   | FALSE (from booleanLiteral) 

syntax integerLiteral = 
