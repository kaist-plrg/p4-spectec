              1. (Let ?(typedLvalueIR) be (typedLvalueIR')?{typedLvalueIR' <- typedLvalueIR'?})

                1. Return ?(((typedLvalueIR '.' nameIR) '#' (`( typeIR `))))

            1. Else Dangling#2755

      1. Else Dangling#2752

  3. Case (% has type indexAccessExpressionIR)

    1. (Let (typedExpressionIR_base `[ typedExpressionIR_index `]) be (expressionIR as indexAccessExpressionIR))

      1. (Let (typedLvalueIR)?{typedLvalueIR <- typedLvalueIR?} be $typedExpressionIR_as_typedLvalueIR(typedExpressionIR_base))

