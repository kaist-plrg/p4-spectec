def $callable_externMethod(cursor, TC)

1. Case analysis on cursor

  1. Case (% matches pattern `GLOBAL`)

    1. Return false

  2. Case (% matches pattern `BLOCK`)

    1. (Let blockKind be TC.BLOCK.KIND)

      1. Return ((blockKind = (PARSER)) \/ (blockKind = (CONTROL)))

  3. Case (% matches pattern `LOCAL`)

    1. Return true

def $callable_externAbstractMethod(cursor, TC)

1. Case analysis on cursor

  1. Case (% matches pattern `GLOBAL`)

    1. Return false

  2. Case (% matches pattern `BLOCK`)

    1. (Let blockKind be TC.BLOCK.KIND)

      1. Return ((blockKind = (PARSER)) \/ (blockKind = (CONTROL)))

  3. Case (% matches pattern `LOCAL`)

    1. Return true

def $callable_parserApplyMethod(cursor, TC)

1. Case analysis on cursor

  1. Case (% matches pattern `GLOBAL`)

    1. Return false

  2. Case (% matches pattern `BLOCK`)

    1. Return false

  3. Case (% matches pattern `LOCAL`)

    1. (Let localKind be TC.LOCAL.KIND)

      1. Return (localKind = ((PARSER_STATE) as localKind))

def $callable_controlApplyMethod(cursor, TC)

1. Case analysis on cursor

  1. Case (% matches pattern `GLOBAL`)

    1. Return false

  2. Case (% matches pattern `BLOCK`)

    1. Return false

  3. Case (% matches pattern `LOCAL`)

    1. (Let localKind be TC.LOCAL.KIND)

      1. Return (localKind = ((CONTROL_APPLY_METHOD) as localKind))

def $callable_tableApplyMethod(cursor, TC)

1. Case analysis on cursor

  1. Case (% matches pattern `GLOBAL`)

    1. Return false

  2. Case (% matches pattern `BLOCK`)

    1. Return false

  3. Case (% matches pattern `LOCAL`)

    1. (Let localKind be TC.LOCAL.KIND)

      1. Return ((localKind = ((CONTROL_APPLY_METHOD) as localKind)) \/ (localKind = ((TABLE_APPLY_METHOD) as localKind)))

def $callableId_IR(nameIR, (parameterIR)*)

1. (Let (_annotationList _direction _typeIR id _parameterInitializerOptIR) be parameterIR)*

  1. Return (nameIR ( (id)* ))

syntax storageReference = 
   | ` nameIR (from prefixedNameIR)  hint(print %0)
   | . nameIR (from prefixedNameIR) 
   | storageReference . nameIR (from storageReference) 
   | storageReference [ value ] (from storageReference) 
   | storageReference [ value : value ] (from storageReference) 
   | storageReference [ value +: value ] (from storageReference) 

syntax actionDef = 
   | annotationList ACTION nameIR ( parameterListIR ) blockStatementIR (from actionDef) 

syntax definedFunctionDef = 
   | FUNCTION nameIR < typeParameterListIR > ( parameterListIR ) blockStatementIR (from definedFunctionDef) 

syntax externFunctionDef = 
   | EXTERN_FUNCTION nameIR < typeParameterListIR > ( parameterListIR ) (from externFunctionDef) 

syntax functionDef = 
   | FUNCTION nameIR < typeParameterListIR > ( parameterListIR ) blockStatementIR (from definedFunctionDef) 
   | EXTERN_FUNCTION nameIR < typeParameterListIR > ( parameterListIR ) (from externFunctionDef) 

syntax externMethodDef = 
   | EXTERN_METHOD nameIR < typeParameterListIR > ( parameterListIR ) blockStatementIR? (from externMethodDef) 
   | EXTERN_METHOD ABSTRACT nameIR < typeParameterListIR > ( parameterListIR ) (from externMethodDef) 

syntax parserApplyMethodDef = 
   | PARSER_APPLY ( parameterListIR ) { parserLocalDeclarationListIR ; stateEnv } (from parserApplyMethodDef) 

syntax controlApplyMethodDef = 
   | CONTROL_APPLY ( parameterListIR ) { controlLocalDeclarationListIR ; actionDefEnv ; controlBodyIR } (from controlApplyMethodDef) 

syntax tableApplyMethodDef = 
   | TABLE_APPLY { tablePropertyListIR } (from tableApplyMethodDef) 

syntax methodDef = 
   | EXTERN_METHOD nameIR < typeParameterListIR > ( parameterListIR ) blockStatementIR? (from externMethodDef) 
   | EXTERN_METHOD ABSTRACT nameIR < typeParameterListIR > ( parameterListIR ) (from externMethodDef) 
   | PARSER_APPLY ( parameterListIR ) { parserLocalDeclarationListIR ; stateEnv } (from parserApplyMethodDef) 
   | CONTROL_APPLY ( parameterListIR ) { controlLocalDeclarationListIR ; actionDefEnv ; controlBodyIR } (from controlApplyMethodDef) 
   | TABLE_APPLY { tablePropertyListIR } (from tableApplyMethodDef) 

syntax callableDef = 
   | annotationList ACTION nameIR ( parameterListIR ) blockStatementIR (from actionDef) 
   | FUNCTION nameIR < typeParameterListIR > ( parameterListIR ) blockStatementIR (from definedFunctionDef) 
   | EXTERN_FUNCTION nameIR < typeParameterListIR > ( parameterListIR ) (from externFunctionDef) 
   | EXTERN_METHOD nameIR < typeParameterListIR > ( parameterListIR ) blockStatementIR? (from externMethodDef) 
   | EXTERN_METHOD ABSTRACT nameIR < typeParameterListIR > ( parameterListIR ) (from externMethodDef) 
   | PARSER_APPLY ( parameterListIR ) { parserLocalDeclarationListIR ; stateEnv } (from parserApplyMethodDef) 
   | CONTROL_APPLY ( parameterListIR ) { controlLocalDeclarationListIR ; actionDefEnv ; controlBodyIR } (from controlApplyMethodDef) 
   | TABLE_APPLY { tablePropertyListIR } (from tableApplyMethodDef) 

def $parameterListIR_of_callableDef(callableDef)

1. Case analysis on callableDef

  1. Case (% has type actionDef)

    1. (Let actionDef be (callableDef as actionDef))

      1. Return $parameterListIR_of_actionDef(actionDef)

  2. Case (% has type functionDef)

    1. (Let functionDef be (callableDef as functionDef))

      1. Return $parameterListIR_of_functionDef(functionDef)

  3. Case (% has type methodDef)

    1. (Let methodDef be (callableDef as methodDef))

      1. Return $parameterListIR_of_methodDef(methodDef)

def $parameterListIR_of_actionDef((annotationList ACTION _nameIR ( parameterListIR ) _blockStatementIR))

1. Return parameterListIR

def $parameterListIR_of_functionDef(functionDef)

1. Case analysis on functionDef

  1. Case (% has type definedFunctionDef)

    1. (Let definedFunctionDef be (functionDef as definedFunctionDef))

      1. Return $parameterListIR_of_definedFunctionDef(definedFunctionDef)

  2. Case (% has type externFunctionDef)

    1. (Let externFunctionDef be (functionDef as externFunctionDef))

      1. Return $parameterListIR_of_externFunctionDef(externFunctionDef)

def $parameterListIR_of_definedFunctionDef((FUNCTION _nameIR < _typeParameterListIR > ( parameterListIR ) _blockStatementIR))

1. Return parameterListIR

def $parameterListIR_of_externFunctionDef((EXTERN_FUNCTION _nameIR < _typeParameterListIR > ( parameterListIR )))

1. Return parameterListIR

def $parameterListIR_of_methodDef(methodDef)

1. Case analysis on methodDef

  1. Case (% has type externMethodDef)

    1. (Let externMethodDef be (methodDef as externMethodDef))

      1. Return $parameterListIR_of_externMethodDef(externMethodDef)

  2. Case (% has type parserApplyMethodDef)

    1. (Let parserApplyMethodDef be (methodDef as parserApplyMethodDef))

      1. Return $parameterListIR_of_parserApplyMethodDef(parserApplyMethodDef)

  3. Case (% has type controlApplyMethodDef)

    1. (Let controlApplyMethodDef be (methodDef as controlApplyMethodDef))

      1. Return $parameterListIR_of_controlApplyMethodDef(controlApplyMethodDef)

  4. Case (% has type tableApplyMethodDef)

    1. (Let tableApplyMethodDef be (methodDef as tableApplyMethodDef))

      1. Return $parameterListIR_of_tableApplyMethodDef(tableApplyMethodDef)

def $parameterListIR_of_externMethodDef(externMethodDef)

1. If ((externMethodDef matches pattern `EXTERN_METHOD % <%> (%) %`)), then

  1. (Let (EXTERN_METHOD _nameIR < _typeParameterListIR > ( parameterListIR ) (_blockStatementIR)?) be externMethodDef)

    1. Return parameterListIR

1. Else Dangling#8379

def $parameterListIR_of_parserApplyMethodDef((PARSER_APPLY ( parameterListIR ) { _parserLocalDeclarationListIR ; _stateEnv }))

1. Return parameterListIR

def $parameterListIR_of_controlApplyMethodDef((CONTROL_APPLY ( parameterListIR ) { _controlLocalDeclarationListIR ; _actionDefEnv ; _controlBodyIR }))

1. Return parameterListIR

def $parameterListIR_of_tableApplyMethodDef((TABLE_APPLY { _tablePropertyListIR }))

1. Return []

syntax actionCallee = 
   | ACTION cursor . nameIR ( parameterListIR # id* ) blockStatementIR (from actionCallee) 

syntax definedFunctionCallee = 
   | FUNCTION nameIR < typeParameterListIR > ( parameterListIR # id* ) blockStatementIR (from definedFunctionCallee) 

syntax externFunctionCallee = 
   | EXTERN_FUNCTION nameIR < typeParameterListIR > ( parameterListIR # id* # id* ) (from externFunctionCallee) 

syntax functionCallee = 
   | FUNCTION nameIR < typeParameterListIR > ( parameterListIR # id* ) blockStatementIR (from definedFunctionCallee) 
   | EXTERN_FUNCTION nameIR < typeParameterListIR > ( parameterListIR # id* # id* ) (from externFunctionCallee) 

syntax builtinMethodCallee = 
   | BUILTIN_METHOD storageReference . nameIR < typeArgumentListIR > ( parameterListIR ) (from builtinMethodCallee) 

syntax externMethodCallee = 
   | EXTERN_METHOD objectId . nameIR < typeParameterListIR > ( parameterListIR # id* # id* ) { theta ; frame ; blockStatementIR? } (from externMethodCallee) 

syntax parserApplyMethodCallee = 
   | PARSER objectId . APPLY ( parameterListIR # id* ) { theta ; frame ; parserLocalDeclarationListIR ; stateEnv } (from parserApplyMethodCallee) 

syntax controlApplyMethodCallee = 
   | CONTROL objectId . APPLY ( parameterListIR # id* ) { theta ; frame ; controlLocalDeclarationListIR ; actionDefEnv ; controlBodyIR } (from controlApplyMethodCallee) 

syntax tableApplyMethodCallee = 
   | TABLE objectId . APPLY { frame ; tableObjectProperty } (from tableApplyMethodCallee) 

syntax methodCallee = 
   | BUILTIN_METHOD storageReference . nameIR < typeArgumentListIR > ( parameterListIR ) (from builtinMethodCallee) 
   | EXTERN_METHOD objectId . nameIR < typeParameterListIR > ( parameterListIR # id* # id* ) { theta ; frame ; blockStatementIR? } (from externMethodCallee) 
   | PARSER objectId . APPLY ( parameterListIR # id* ) { theta ; frame ; parserLocalDeclarationListIR ; stateEnv } (from parserApplyMethodCallee) 
   | CONTROL objectId . APPLY ( parameterListIR # id* ) { theta ; frame ; controlLocalDeclarationListIR ; actionDefEnv ; controlBodyIR } (from controlApplyMethodCallee) 
   | TABLE objectId . APPLY { frame ; tableObjectProperty } (from tableApplyMethodCallee) 

syntax callee = 
   | ACTION cursor . nameIR ( parameterListIR # id* ) blockStatementIR (from actionCallee) 
   | FUNCTION nameIR < typeParameterListIR > ( parameterListIR # id* ) blockStatementIR (from definedFunctionCallee) 
   | EXTERN_FUNCTION nameIR < typeParameterListIR > ( parameterListIR # id* # id* ) (from externFunctionCallee) 
   | BUILTIN_METHOD storageReference . nameIR < typeArgumentListIR > ( parameterListIR ) (from builtinMethodCallee) 
   | EXTERN_METHOD objectId . nameIR < typeParameterListIR > ( parameterListIR # id* # id* ) { theta ; frame ; blockStatementIR? } (from externMethodCallee) 
   | PARSER objectId . APPLY ( parameterListIR # id* ) { theta ; frame ; parserLocalDeclarationListIR ; stateEnv } (from parserApplyMethodCallee) 
   | CONTROL objectId . APPLY ( parameterListIR # id* ) { theta ; frame ; controlLocalDeclarationListIR ; actionDefEnv ; controlBodyIR } (from controlApplyMethodCallee) 
   | TABLE objectId . APPLY { frame ; tableObjectProperty } (from tableApplyMethodCallee) 

syntax externObjectConstructorDef = 
   | EXTERN nameIR < typeParameterListIR > ( constructorParameterListIR ) { externMethodPrototypeListIR } (from externObjectConstructorDef) 

syntax parserObjectConstructorDef = 
   | PARSER < typeParameterListIR > ( parameterListIR ) ( constructorParameterListIR ) { parserLocalDeclarationListIR parserStateListIR } (from parserObjectConstructorDef) 

syntax controlObjectConstructorDef = 
   | CONTROL < typeParameterListIR > ( parameterListIR ) ( constructorParameterListIR ) { controlLocalDeclarationListIR APPLY controlBodyIR } (from controlObjectConstructorDef) 

syntax packageObjectConstructorDef = 
   | PACKAGE < typeParameterListIR > ( constructorParameterListIR ) (from packageObjectConstructorDef) 

syntax constructorDef = 
   | EXTERN nameIR < typeParameterListIR > ( constructorParameterListIR ) { externMethodPrototypeListIR } (from externObjectConstructorDef) 
   | PARSER < typeParameterListIR > ( parameterListIR ) ( constructorParameterListIR ) { parserLocalDeclarationListIR parserStateListIR } (from parserObjectConstructorDef) 
   | CONTROL < typeParameterListIR > ( parameterListIR ) ( constructorParameterListIR ) { controlLocalDeclarationListIR APPLY controlBodyIR } (from controlObjectConstructorDef) 
   | PACKAGE < typeParameterListIR > ( constructorParameterListIR ) (from packageObjectConstructorDef) 

def $parameterListIR_of_constructorDef(constructorDef)

1. Case analysis on constructorDef

  1. Case (% has type externObjectConstructorDef)

    1. (Let (EXTERN _nameIR < _typeParameterListIR > ( constructorParameterListIR ) { _externMethodPrototypeListIR }) be (constructorDef as externObjectConstructorDef))

      1. Return constructorParameterListIR

  2. Case (% has type parserObjectConstructorDef)

    1. (Let (PARSER < _typeParameterListIR > ( _parameterListIR ) ( constructorParameterListIR ) { _parserLocalDeclarationListIR _parserStateListIR }) be (constructorDef as parserObjectConstructorDef))

      1. Return constructorParameterListIR

  3. Case (% has type controlObjectConstructorDef)

    1. (Let (CONTROL < _typeParameterListIR > ( _parameterListIR ) ( constructorParameterListIR ) { _controlLocalDeclarationListIR APPLY _controlBodyIR }) be (constructorDef as controlObjectConstructorDef))

      1. Return constructorParameterListIR

  4. Case (% has type packageObjectConstructorDef)

    1. (Let (PACKAGE < _typeParameterListIR > ( constructorParameterListIR )) be (constructorDef as packageObjectConstructorDef))

      1. Return constructorParameterListIR

extern syntax objectState

syntax externMethodDefEnv = map<callableId, externMethodDef>

extern def $init_objectState(nameIR, (typeIR)*, (value)*)

syntax externObject = 
   | EXTERN typeId < theta > { objectState frame externMethodDefEnv } (from externObject) 

syntax parserObject = 
   | PARSER < theta > ( parameterListIR ) { frame parserLocalDeclarationListIR stateEnv } (from parserObject) 

syntax actionDefEnv = map<callableId, actionDef>

syntax controlObject = 
   | CONTROL < theta > ( parameterListIR ) { frame controlLocalDeclarationListIR actionDefEnv controlBodyIR } (from controlObject) 

syntax packageObject = 
   | PACKAGE < theta > { frame } (from packageObject) 

syntax tableObjectProperty = {KEYS tableKeysPropertyIR, ACTIONS tableActionsPropertyIR, DEFAULT_ACTION tableDefaultActionPropertyIR, ENTRIES tableEntriesPropertyIR, CUSTOMS tableCustomPropertyIR*}

syntax tableObject = 
   | TABLE typeId { frame tableObjectProperty } (from tableObject) 

syntax valueSetObject = 
   | VALUE_SET { value* ( nat ) } (from valueSetObject) 

syntax object = 
   | EXTERN typeId < theta > { objectState frame externMethodDefEnv } (from externObject) 
   | PARSER < theta > ( parameterListIR ) { frame parserLocalDeclarationListIR stateEnv } (from parserObject) 
   | CONTROL < theta > ( parameterListIR ) { frame controlLocalDeclarationListIR actionDefEnv controlBodyIR } (from controlObject) 
   | PACKAGE < theta > { frame } (from packageObject) 
   | TABLE typeId { frame tableObjectProperty } (from tableObject) 
   | VALUE_SET { value* ( nat ) } (from valueSetObject) 

syntax frame = map<id, value>

def $empty_frame

1. Return $empty_map<id, value>

syntax stateEnv = map<id, parserStateIR>

def $empty_stateEnv

1. Return $empty_map<id, parserStateIR>

syntax callableDefEnv = map<callableId, callableDef>

def $empty_callableDefEnv

1. Return $empty_map<callableId, callableDef>

syntax constructorDefEnv = map<callableId, constructorDef>

def $empty_constructorDefEnv

1. Return $empty_map<callableId, constructorDef>

syntax store = map<objectId, object>

def $empty_store

1. (Let store be $empty_map<objectId, object>)

  1. Return store

def $add_store(store, objectId, object)

1. (Let store' be $add_map<objectId, object>(store, objectId, object))

  1. Return store'

def $find_store(store, objectId)

1. (Let (object)? be $find_map<objectId, object>(store, objectId))

  1. If (((object)? matches pattern (_))), then

    1. (Let ?(object') be (object)?)

      1. Return object'

  1. Else Dangling#8403

syntax globalInstLayer = {CONSTRUCTOR constructorDefEnv, TYPE typeDefEnv, CALLABLE callableDefEnv, FRAME frame}

syntax blockInstLayer = {TYPE theta, CALLABLE callableDefEnv, STATE stateEnv, FRAME frame}

syntax localInstLayer = {TYPE theta, FRAMES frame*}

syntax instContext = {PATH objectId, GLOBAL globalInstLayer, BLOCK blockInstLayer, LOCAL localInstLayer}

def $empty_instContext

1. (Let globalInstLayer be {CONSTRUCTOR $empty_constructorDefEnv, TYPE $empty_typeDefEnv, CALLABLE $empty_callableDefEnv, FRAME $empty_frame})

  1. (Let blockInstLayer be {TYPE $empty_theta, CALLABLE $empty_callableDefEnv, STATE $empty_stateEnv, FRAME $empty_frame})

    1. (Let localInstLayer be {TYPE $empty_theta, FRAMES [$empty_frame]})

      1. (Let IC be {PATH [], GLOBAL globalInstLayer, BLOCK blockInstLayer, LOCAL localInstLayer})

        1. Return IC

def $enter_i(IC)

1. Return IC[LOCAL.FRAMES = $empty_frame :: IC.LOCAL.FRAMES]

def $exit_i(IC)

1. (Let (frame)* be IC.LOCAL.FRAMES)

  1. If (((frame)* matches pattern _ :: _)), then

    1. (Let frame_h :: (frame_t)* be (frame)*)

      1. Return IC[LOCAL.FRAMES = (frame_t)*]

  1. Else Dangling#8413

def $enter_path_i(IC, id)

1. Return IC[PATH = IC.PATH ++ [id]]

def $inherit_i(cursor, IC)

1. Case analysis on cursor

  1. Case (% matches pattern `GLOBAL`)

    1. (Let blockInstLayer be {TYPE $empty_theta, CALLABLE $empty_callableDefEnv, STATE $empty_stateEnv, FRAME $empty_frame})

      1. (Let localInstLayer be {TYPE $empty_theta, FRAMES [$empty_frame]})

        1. Return IC[BLOCK = blockInstLayer][LOCAL = localInstLayer]

  2. Case (% matches pattern `BLOCK`)

    1. (Let localInstLayer be {TYPE $empty_theta, FRAMES [$empty_frame]})

      1. Return IC[LOCAL = localInstLayer]

  3. Case (% matches pattern `LOCAL`)

    1. Return IC

def $add_var_i(cursor, IC, id, value)

1. Case analysis on cursor

  1. Case (% matches pattern `GLOBAL`)

    1. If (~$in_set<id>(id, $dom_map<id, value>(IC.GLOBAL.FRAME))), then

      1. (Let frame be $add_map<id, value>(IC.GLOBAL.FRAME, id, value))

        1. Return IC[GLOBAL.FRAME = frame]

    1. Else Dangling#8425

  2. Case (% matches pattern `BLOCK`)

    1. If (~$in_set<id>(id, $dom_map<id, value>(IC.BLOCK.FRAME))), then

      1. (Let frame be $add_map<id, value>(IC.BLOCK.FRAME, id, value))

        1. Return IC[BLOCK.FRAME = frame]

    1. Else Dangling#8428

  3. Case (% matches pattern `LOCAL`)

    1. (Let (frame)* be IC.LOCAL.FRAMES)

      1. If (((frame)* matches pattern _ :: _)), then

        1. (Let frame_h :: (frame_t)* be (frame)*)

          1. If (~$in_set<id>(id, $dom_map<id, value>(frame_h))), then

            1. (Let frame_h' be $add_map<id, value>(frame_h, id, value))

              1. Return IC[LOCAL.FRAMES = frame_h' :: (frame_t)*]

          1. Else Dangling#8434

      1. Else Dangling#8432

def $add_vars_i(p, IC, (id)*, (value)*)

1. Case analysis on (id)*

  1. Case (% matches pattern [])

    1. If (((value)* matches pattern [])), then

      1. Return IC

    1. Else Dangling#8438

  2. Case (% matches pattern _ :: _)

    1. (Let id_h :: (id_t)* be (id)*)

      1. If (((value)* matches pattern _ :: _)), then

        1. (Let value_h :: (value_t)* be (value)*)

          1. (Let IC' be $add_var_i(p, IC, id_h, value_h))

            1. (Let IC'' be $add_vars_i(p, IC', (id_t)*, (value_t)*))

              1. Return IC''

      1. Else Dangling#8441

def $add_typeDef_i(cursor, IC, typeId, typeDefIR)

1. If ((cursor matches pattern `GLOBAL`)), then

  1. (Let typeDefEnv be $add_map<typeId, typeDefIR>(IC.GLOBAL.TYPE, typeId, typeDefIR))

    1. Return IC[GLOBAL.TYPE = typeDefEnv]

1. Else Dangling#8446

def $add_parserState_i(IC, nameIR, parserStateIR)

1. If (~$in_set<nameIR>(nameIR, $dom_map<nameIR, parserStateIR>(IC.BLOCK.STATE))), then

  1. (Let stateEnv be $add_map<nameIR, parserStateIR>(IC.BLOCK.STATE, nameIR, parserStateIR))

    1. Return IC[BLOCK.STATE = stateEnv]

1. Else Dangling#8449

def $add_type_i(cursor, IC, typeId, typeIR)

1. Case analysis on cursor

  1. Case (% matches pattern `BLOCK`)

    1. (Let theta be $add_map<typeId, typeIR>(IC.BLOCK.TYPE, typeId, typeIR))

      1. Return IC[BLOCK.TYPE = theta]

  2. Case (% matches pattern `LOCAL`)

    1. (Let theta be $add_map<typeId, typeIR>(IC.LOCAL.TYPE, typeId, typeIR))

      1. Return IC[LOCAL.TYPE = theta]

1. Else Dangling#8452

def $add_types_i(p, IC, (typeId)*, (typeIR)*)

1. Case analysis on (typeId)*

  1. Case (% matches pattern [])

    1. If (((typeIR)* matches pattern [])), then

      1. Return IC

    1. Else Dangling#8458

  2. Case (% matches pattern _ :: _)

    1. (Let typeId_h :: (typeId_t)* be (typeId)*)

      1. If (((typeIR)* matches pattern _ :: _)), then

        1. (Let typeIR_h :: (typeIR_t)* be (typeIR)*)

          1. (Let IC' be $add_type_i(p, IC, typeId_h, typeIR_h))

            1. Return $add_types_i(p, IC', (typeId_t)*, (typeIR_t)*)

      1. Else Dangling#8461

def $add_callableDef_overload_i(cursor, IC, callableId, callableDef)

1. Case analysis on cursor

  1. Case (% matches pattern `GLOBAL`)

    1. If (~$in_set<callableId>(callableId, $dom_map<callableId, callableDef>(IC.GLOBAL.CALLABLE))), then

      1. (Let callableDefEnv be $add_map<callableId, callableDef>(IC.GLOBAL.CALLABLE, callableId, callableDef))

        1. Return IC[GLOBAL.CALLABLE = callableDefEnv]

    1. Else Dangling#8466

  2. Case (% matches pattern `BLOCK`)

    1. If (~$in_set<callableId>(callableId, $dom_map<callableId, callableDef>(IC.BLOCK.CALLABLE))), then

      1. (Let callableDefEnv be $add_map<callableId, callableDef>(IC.BLOCK.CALLABLE, callableId, callableDef))

        1. Return IC[BLOCK.CALLABLE = callableDefEnv]

    1. Else Dangling#8469

1. Else Dangling#8465

def $add_callableDef_non_overload_i(cursor, IC, callableId, callableDef)

1. Case analysis on cursor

  1. Case (% matches pattern `GLOBAL`)

    1. (Let (id ( (_id)* )) be callableId)

      1. (Let ({ ((id_k ( (_id')* )))* }) be $dom_map<callableId, callableDef>(IC.GLOBAL.CALLABLE))

        1. If (~$in_set<id>(id, ({ (id_k)* }))), then

          1. (Let callableDefEnv be $add_map<callableId, callableDef>(IC.GLOBAL.CALLABLE, callableId, callableDef))

            1. Return IC[GLOBAL.CALLABLE = callableDefEnv]

        1. Else Dangling#8475

  2. Case (% matches pattern `BLOCK`)

    1. (Let (id ( (_id)* )) be callableId)

      1. (Let ({ ((id_k ( (_id')* )))* }) be $dom_map<callableId, callableDef>(IC.BLOCK.CALLABLE))

        1. If (~$in_set<id>(id, ({ (id_k)* }))), then

          1. (Let callableDefEnv be $add_map<callableId, callableDef>(IC.BLOCK.CALLABLE, callableId, callableDef))

            1. Return IC[BLOCK.CALLABLE = callableDefEnv]

        1. Else Dangling#8480

1. Else Dangling#8472

def $find_callableDef_non_overload_i(p, IC, prefixedNameIR)

1. If ((prefixedNameIR matches pattern `. %`)), then

  1. (Let (. nameIR) be prefixedNameIR)

    1. If ((?() = $find_non_overloaded<callableDef>(IC.GLOBAL.CALLABLE, nameIR))), then

      1. Return ?()

    1. Else Dangling#8485

    2. (Let ((callableId, callableDef))? be $find_non_overloaded<callableDef>(IC.GLOBAL.CALLABLE, nameIR))

      1. If ((((callableId, callableDef))? matches pattern (_))), then

        1. (Let ?((callableId, callableDef)) be ((callableId, callableDef))?)

          1. Return ?(((GLOBAL), callableId, callableDef))

      1. Else Dangling#8488

1. Else Dangling#8483

2. Case analysis on p

  1. Case (% matches pattern `GLOBAL`)

    1. If ((prefixedNameIR matches pattern `` %`)), then

      1. (Let (` nameIR) be prefixedNameIR)

        1. Return $find_callableDef_non_overload_i((GLOBAL), IC, (. nameIR))

    1. Else Dangling#8492

  2. Case (% matches pattern `BLOCK`)

    1. If ((prefixedNameIR matches pattern `` %`)), then

      1. (Let (` nameIR) be prefixedNameIR)

        1. (Let ((callableId, callableDef))? be $find_non_overloaded<callableDef>(IC.BLOCK.CALLABLE, nameIR))

          1. If ((((callableId, callableDef))? matches pattern (_))), then

            1. (Let ?((callableId, callableDef)) be ((callableId, callableDef))?)

              1. Return ?(((BLOCK), callableId, callableDef))

          1. Else Dangling#8498

        2. If ((?() = $find_non_overloaded<callableDef>(IC.BLOCK.CALLABLE, nameIR))), then

          1. Return $find_callableDef_non_overload_i((GLOBAL), IC, (` nameIR))

        2. Else Dangling#8501

    1. Else Dangling#8495

  3. Case (% matches pattern `LOCAL`)

    1. If ((prefixedNameIR matches pattern `` %`)), then

      1. (Let (` nameIR) be prefixedNameIR)

        1. Return $find_callableDef_non_overload_i((BLOCK), IC, (` nameIR))

    1. Else Dangling#8503

def $add_constructorDef_i(IC, callableId, constructorDef)

1. (Let constructorDefEnv be $add_map<callableId, constructorDef>(IC.GLOBAL.CONSTRUCTOR, callableId, constructorDef))

  1. Return IC[GLOBAL.CONSTRUCTOR = constructorDefEnv]

def $add_constructorDefs_i(IC, (callableId)*, (constructorDef)*)

1. Case analysis on (callableId)*

  1. Case (% matches pattern [])

    1. If (((constructorDef)* matches pattern [])), then

      1. Return IC

    1. Else Dangling#8509

  2. Case (% matches pattern _ :: _)

    1. (Let callableId_h :: (callableId_t)* be (callableId)*)

