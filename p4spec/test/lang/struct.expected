def $align_parameterListIR((parameterIR)*{parameterIR <- parameterIR*}, (argumentIR)*{argumentIR <- argumentIR*}, (nameIR_default)*{nameIR_default <- nameIR_default*}, (nameIR_optional)*{nameIR_optional <- nameIR_optional*})

1. (Let ((parameterIR_given)*{parameterIR_given <- parameterIR_given*}, (parameterIR_default)*{parameterIR_default <- parameterIR_default*}, (parameterIR_optional)*{parameterIR_optional <- parameterIR_optional*}) be $partition_parameterListIR((parameterIR)*{parameterIR <- parameterIR*}, (nameIR_default)*{nameIR_default <- nameIR_default*}, (nameIR_optional)*{nameIR_optional <- nameIR_optional*}))

  1. (Let (_annotationList _direction _typeIR nameIR_given _parameterInitializerOptIR) be parameterIR_given)*{parameterIR_given <- parameterIR_given*, _annotationList -> _annotationList*, _direction -> _direction*, _parameterInitializerOptIR -> _parameterInitializerOptIR*, _typeIR -> _typeIR*, nameIR_given -> nameIR_given*}

    1. (Let (parameterIR_given_aligned)*{parameterIR_given_aligned <- parameterIR_given_aligned*} be $align_parameterListIR_given((`{ ((nameIR_given ':' parameterIR_given))*{nameIR_given <- nameIR_given*, parameterIR_given <- parameterIR_given*} `}), (parameterIR_given)*{parameterIR_given <- parameterIR_given*}, (argumentIR)*{argumentIR <- argumentIR*}))

      1. Return (GIVEN (parameterIR_given_aligned)*{parameterIR_given_aligned <- parameterIR_given_aligned*} DEFAULT (parameterIR_default)*{parameterIR_default <- parameterIR_default*})

def $align_parameterListIR_given((`{ ((id ':' parameterIR))*{id <- id*, parameterIR <- parameterIR*} `}), (parameterIR')*{parameterIR' <- parameterIR'*}, (argumentIR)*{argumentIR <- argumentIR*})

1. Case analysis on (parameterIR')*{parameterIR' <- parameterIR'*}

  1. Case (% matches pattern [])

    1. If (((argumentIR)*{argumentIR <- argumentIR*} matches pattern [])), then

      1. Return []

    1. Else Dangling#2807

  2. Case (% matches pattern _ :: _)

    1. (Let parameterIR_h :: (parameterIR_t)*{parameterIR_t <- parameterIR_t*} be (parameterIR')*{parameterIR' <- parameterIR'*})

      1. If (((argumentIR)*{argumentIR <- argumentIR*} matches pattern _ :: _)), then

        1. (Let argumentIR_h :: (argumentIR_t)*{argumentIR_t <- argumentIR_t*} be (argumentIR)*{argumentIR <- argumentIR*})

          1. Case analysis on argumentIR_h

            1. Case (% has type typedExpressionIR)

              1. (Let (parameterIR_aligned)*{parameterIR_aligned <- parameterIR_aligned*} be $align_parameterListIR_given((`{ ((id ':' parameterIR))*{id <- id*, parameterIR <- parameterIR*} `}), (parameterIR_t)*{parameterIR_t <- parameterIR_t*}, (argumentIR_t)*{argumentIR_t <- argumentIR_t*}))

                1. Return parameterIR_h :: (parameterIR_aligned)*{parameterIR_aligned <- parameterIR_aligned*}

            2. Case (% matches pattern `_`)

              1. (Let (parameterIR_aligned)*{parameterIR_aligned <- parameterIR_aligned*} be $align_parameterListIR_given((`{ ((id ':' parameterIR))*{id <- id*, parameterIR <- parameterIR*} `}), (parameterIR_t)*{parameterIR_t <- parameterIR_t*}, (argumentIR_t)*{argumentIR_t <- argumentIR_t*}))

                1. Return parameterIR_h :: (parameterIR_aligned)*{parameterIR_aligned <- parameterIR_aligned*}

            3. Case (% matches pattern `% = %`)

              1. (Let (nameIR '=' _typedExpressionIR) be argumentIR_h)

                1. (Let (parameterIR'')?{parameterIR'' <- parameterIR''?} be $find_map<id, parameterIR>((`{ ((id ':' parameterIR))*{id <- id*, parameterIR <- parameterIR*} `}), nameIR))

                  1. If (((parameterIR'')?{parameterIR'' <- parameterIR''?} matches pattern (_))), then

                    1. (Let ?(parameterIR_match) be (parameterIR'')?{parameterIR'' <- parameterIR''?})

                      1. (Let (parameterIR_aligned)*{parameterIR_aligned <- parameterIR_aligned*} be $align_parameterListIR_given((`{ ((id ':' parameterIR))*{id <- id*, parameterIR <- parameterIR*} `}), (parameterIR_t)*{parameterIR_t <- parameterIR_t*}, (argumentIR_t)*{argumentIR_t <- argumentIR_t*}))

                        1. Return parameterIR_match :: (parameterIR_aligned)*{parameterIR_aligned <- parameterIR_aligned*}

                  1. Else Dangling#2819

            4. Case (% matches pattern `% = _`)

              1. (Let (nameIR '=' '_') be argumentIR_h)

                1. (Let (parameterIR'')?{parameterIR'' <- parameterIR''?} be $find_map<id, parameterIR>((`{ ((id ':' parameterIR))*{id <- id*, parameterIR <- parameterIR*} `}), nameIR))

                  1. If (((parameterIR'')?{parameterIR'' <- parameterIR''?} matches pattern (_))), then

                    1. (Let ?(parameterIR_match) be (parameterIR'')?{parameterIR'' <- parameterIR''?})

                      1. (Let (parameterIR_aligned)*{parameterIR_aligned <- parameterIR_aligned*} be $align_parameterListIR_given((`{ ((id ':' parameterIR))*{id <- id*, parameterIR <- parameterIR*} `}), (parameterIR_t)*{parameterIR_t <- parameterIR_t*}, (argumentIR_t)*{argumentIR_t <- argumentIR_t*}))

                        1. Return parameterIR_match :: (parameterIR_aligned)*{parameterIR_aligned <- parameterIR_aligned*}

                  1. Else Dangling#2825

      1. Else Dangling#2810

syntax callTargetKey = 
   | nameIR `( id?* `) (from callTargetKey) 

syntax namedCallTargetKey = 
   | nameIR `( id* `) (from namedCallTargetKey) 

syntax unnamedCallTargetKey = 
   | nameIR `( nat `) (from unnamedCallTargetKey) 

syntax callTargetParameter = 
   | nameIR '#' bool '#' bool (from callTargetParameter) 

syntax callTargetValue = callTargetParameter*

syntax callTargetMatch = 
   | MATCH id* id* (from callTargetMatch)  hint(prose MATCH "with defaults" %0 and "optionals" %1)
   | NOMATCH (from callTargetMatch) 

syntax callResolution<V> = 
   | callableId ':' V '#' nameIR* '#' nameIR* (from callResolution<V>)  hint(prose_fields "call target id" "call target" "defaults" "optionals")

def $callTargetKey(nameIR_f, (argumentIR)*{argumentIR <- argumentIR*})

1. (Let (id_arg)?{id_arg <- id_arg?} be $callTargetKey'(argumentIR))*{argumentIR <- argumentIR*, id_arg? -> id_arg?*}

  1. Return (nameIR_f `( ((id_arg)?{id_arg <- id_arg?})*{id_arg? <- id_arg?*} `))

def $callTargetKey'(argumentIR)

1. Case analysis on argumentIR

  1. Case (% has type typedExpressionIR)

    1. Return ?()

  2. Case (% matches pattern `% = %`)

    1. (Let (id_arg '=' _typedExpressionIR) be argumentIR)

      1. Return ?(id_arg)

  3. Case (% matches pattern `% = _`)

    1. (Let (id_arg '=' '_') be argumentIR)

      1. Return ?(id_arg)

  4. Case (% matches pattern `_`)

    1. Return ?()

def $match_overloaded_named<V>((callTargetId ':' V), (nameIR_f `( (id_arg)*{id_arg <- id_arg*} `)), $get_parameterListIR(V) : parameterListIR)

1. (Let (nameIR `( (id_param)*{id_param <- id_param*} `)) be callTargetId)

  1. If ((nameIR = nameIR_f)), then

    1. (Let (parameterIR)*{parameterIR <- parameterIR*} be $get_parameterListIR(V))

      1. If ((|(id_param)*{id_param <- id_param*}| = |(parameterIR)*{parameterIR <- parameterIR*}|)), then

        1. If ((id_param = $id_of_parameterIR(parameterIR)))*{id_param <- id_param*, parameterIR <- parameterIR*}, then

          1. If ((|(id_param)*{id_param <- id_param*}| = |(id_arg)*{id_arg <- id_arg*}|)), then

            1. Return $ite<callTargetMatch>($eq_set<id>((`{ (id_param)*{id_param <- id_param*} `}), (`{ (id_arg)*{id_arg <- id_arg*} `})), (MATCH [] []), (NOMATCH))

          2. (Let b_default be $is_default_parameterIR(parameterIR))*{parameterIR <- parameterIR*, b_default -> b_default*}

            1. (Let b_optional be $is_optional_parameterIR(parameterIR))*{parameterIR <- parameterIR*, b_optional -> b_optional*}

              1. If ((|(id_param)*{id_param <- id_param*}| > |(id_arg)*{id_arg <- id_arg*}|)), then

                1. (Let (`{ (id_param_omitted)*{id_param_omitted <- id_param_omitted*} `}) be $diff_set<id>((`{ (id_param)*{id_param <- id_param*} `}), (`{ (id_arg)*{id_arg <- id_arg*} `})))

                  1. (Let (id_default_param)*{id_default_param <- id_default_param*} be $filter_<id>((id_param)*{id_param <- id_param*}, ($is_default_parameterIR(parameterIR))*{parameterIR <- parameterIR*}))

                    1. (Let (id_default)*{id_default <- id_default*} be $filter_<id>((id_param_omitted)*{id_param_omitted <- id_param_omitted*}, (id_param_omitted is in (id_default_param)*{id_default_param <- id_default_param*})*{id_param_omitted <- id_param_omitted*}))

                      1. (Let (id_optional_param)*{id_optional_param <- id_optional_param*} be $filter_<id>((id_param)*{id_param <- id_param*}, ($is_optional_parameterIR(parameterIR))*{parameterIR <- parameterIR*}))

                        1. (Let (id_optional)*{id_optional <- id_optional*} be $filter_<id>((id_param_omitted)*{id_param_omitted <- id_param_omitted*}, (id_param_omitted is in (id_optional_param)*{id_optional_param <- id_optional_param*})*{id_param_omitted <- id_param_omitted*}))

                          1. If ($eq_set<id>((`{ (id_default)*{id_default <- id_default*} ++ (id_optional)*{id_optional <- id_optional*} `}), (`{ (id_param_omitted)*{id_param_omitted <- id_param_omitted*} `}))), then

                            1. Return (MATCH (id_default)*{id_default <- id_default*} (id_optional)*{id_optional <- id_optional*})

2. Otherwise,

  1. Return (NOMATCH)

def $match_overloaded_unnamed<V>((callTargetId ':' V), (nameIR_f `( n_arg `)), $get_parameterListIR(V) : parameterListIR)

1. (Let (nameIR `( (id_param)*{id_param <- id_param*} `)) be callTargetId)

  1. If ((nameIR = nameIR_f)), then

    1. (Let (parameterIR)*{parameterIR <- parameterIR*} be $get_parameterListIR(V))

      1. (Let b_default be $is_default_parameterIR(parameterIR))*{parameterIR <- parameterIR*, b_default -> b_default*}

        1. (Let b_optional be $is_optional_parameterIR(parameterIR))*{parameterIR <- parameterIR*, b_optional -> b_optional*}

          1. If (~($exists_((b_default)*{b_default <- b_default*}) /\ $exists_((b_optional)*{b_optional <- b_optional*}))), then

            1. If ((|(id_param)*{id_param <- id_param*}| = n_arg)), then

              1. Return (MATCH [] [])

            2. If ((|(id_param)*{id_param <- id_param*}| > n_arg)), then

              1. (Let ((parameterIR_given)*{parameterIR_given <- parameterIR_given*}, (parameterIR_omitted)*{parameterIR_omitted <- parameterIR_omitted*}) be $partition_<parameterIR>((parameterIR)*{parameterIR <- parameterIR*}, n_arg))

                1. If (~$is_optional_parameterIR(parameterIR_omitted))*{parameterIR_omitted <- parameterIR_omitted*}, then

                  1. If ($is_default_parameterIR(parameterIR_omitted))*{parameterIR_omitted <- parameterIR_omitted*}, then

                    1. (Let id_default be $id_of_parameterIR(parameterIR_omitted))*{parameterIR_omitted <- parameterIR_omitted*, id_default -> id_default*}

                      1. Return (MATCH (id_default)*{id_default <- id_default*} [])

                2. If (~$is_default_parameterIR(parameterIR_given))*{parameterIR_given <- parameterIR_given*}, then

                  1. If ($is_optional_parameterIR(parameterIR_omitted))*{parameterIR_omitted <- parameterIR_omitted*}, then

                    1. (Let id_optional be $id_of_parameterIR(parameterIR_omitted))*{parameterIR_omitted <- parameterIR_omitted*, id_optional -> id_optional*}

                      1. Return (MATCH [] (id_optional)*{id_optional <- id_optional*})

2. Otherwise,

  1. Return (NOMATCH)

def $find_overloadeds_named<V>(set<pair<callableId, V>>, (nameIR_f `( (id_arg)*{id_arg <- id_arg*} `)), $get_parameterListIR(V) : parameterListIR)

1. If ((set<pair<callableId, V>> = (`{ [] `}))), then

  1. Return []

