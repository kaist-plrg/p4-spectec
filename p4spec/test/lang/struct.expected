syntax ctk = 
   | LCTK (from ctk) 
   | CTK (from ctk) 
   | DYN (from ctk) 

def $join_ctk(ctk, ctk')

1. Case analysis on ctk

  1. Case (% matches pattern `LCTK`)

    1. Case analysis on ctk'

      1. Case (% matches pattern `LCTK`)

        1. Return (LCTK)

      2. Case (% matches pattern `CTK`)

        1. Return (CTK)

  2. Case (% matches pattern `CTK`)

    1. Case analysis on ctk'

      1. Case (% matches pattern `LCTK`)

        1. Return (CTK)

      2. Case (% matches pattern `CTK`)

        1. Return (CTK)

2. Otherwise,

  1. Return (DYN)

def $joins_ctk((ctk)*)

1. Case analysis on (ctk)*

  1. Case (% matches pattern [])

    1. Return (LCTK)

  2. Case (% matches pattern [ _/1 ])

    1. (Let [ctk'] be (ctk)*)

      1. Return ctk'

  3. Case (% matches pattern _ :: _)

    1. (Let ctk_a :: (ctk')* be (ctk)*)

      1. Case analysis on (ctk')*

        1. Case (% matches pattern [ _/1 ])

          1. (Let [ctk_b] be (ctk')*)

            1. Return $join_ctk(ctk_a, ctk_b)

        2. Case (% matches pattern _ :: _)

          1. (Let ctk_b :: (ctk_c)* be (ctk')*)

            1. If (((ctk_c)* =/= [])), then

              1. (Let ctk_d be $join_ctk(ctk_a, ctk_b))

                1. Return $joins_ctk(ctk_d :: (ctk_c)*)

            1. Else Dangling#1434

      1. Else Dangling#1430

1. Else Dangling#1425

builtin def $pow2(nat)

builtin def $shl(int, int')

builtin def $shr(int, int')

builtin def $shr_arith(int, int', int'')

builtin def $bneg(int)

builtin def $band(int, int')

builtin def $bxor(int, int')

builtin def $bor(int, int')

builtin def $bitacc(int, int', int'')

builtin def $bitacc_replace(int, int', int'', int''')

def $un_op(unop, value)

1. Case analysis on unop

  1. Case (% matches pattern `~`)

    1. Return $un_bnot(value)

  2. Case (% matches pattern `!`)

    1. Return $un_lnot(value)

  3. Case (% matches pattern `+`)

    1. Return $un_plus(value)

  4. Case (% matches pattern `-`)

    1. Return $un_minus(value)

def $un_bnot(value)

1. If ((value has type integerLiteral)), then

  1. (Let integerLiteral be (value as integerLiteral))

    1. If ((integerLiteral matches pattern `% W %`)), then

      1. (Let (w W i) be integerLiteral)

        1. (Let i' be $bneg(i))

          1. (Let i'' be $ite<int>((i' >= (0 as int)), i', ($pow2(w) + i')))

            1. Return ((w W i'') as value)

    1. Else Dangling#1444

1. Else Dangling#1442

def $un_lnot(value)

1. If ((value has type boolValue)), then

  1. (Let (`B b) be (value as boolValue))

    1. Return ((`B ~b) as value)

1. Else Dangling#1449

def $un_plus(value)

1. If ((value has type integerLiteral)), then

