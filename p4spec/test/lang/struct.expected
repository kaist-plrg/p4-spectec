                          1. If (((tablePropertyIR''')* has type tableCustomPropertyIR*)), then

                            1. (Let (tableCustomPropertyIR)* be ((tablePropertyIR''')* as tableCustomPropertyIR*))

                              1. (Let TBL be {keys tableKeysPropertyIR, actions tableActionsPropertyIR', default_action tableDefaultActionPropertyIR', entries tableEntriesPropertyIR, customs (tableCustomPropertyIR)*})

