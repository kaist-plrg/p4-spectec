    1. (Let inference be $infer((typeId_infer)*{typeId_infer <- typeId_infer*}, (parameterIR_aligned)*{parameterIR_aligned <- parameterIR_aligned*}, (argumentIR)*{argumentIR <- argumentIR*}))

      1. (Let typeArgumentIR_inferred be $subst_typeIR(inference, typeArgumentIR))*{typeArgumentIR <- typeArgumentIR*, typeArgumentIR_inferred -> typeArgumentIR_inferred*}

        1. (Let parameterIR_aligned_inferred be $subst_parameterIR(inference, parameterIR_aligned))*{parameterIR_aligned <- parameterIR_aligned*, parameterIR_aligned_inferred -> parameterIR_aligned_inferred*}

          1. (Let typeIR_object_inferred be $subst_typeIR(inference, typeIR_object))

            1. (Let constructorTypeIR_inferred be (CONSTRUCTOR `( (parameterIR_aligned_inferred)*{parameterIR_aligned_inferred <- parameterIR_aligned_inferred*} `) ':' typeIR_object_inferred))

              1. If (ConstructorType_wf: $bound(p, TC) |- constructorTypeIR_inferred) holds, then

                1. If ($instantiable(p, TC, instctxt, typeIR_object_inferred)), then

                  1. (Let typeIR_object_unroll be $unroll_typeIR(typeIR_object))

