def $starts_with(t, t_prefix)

1. If ((|t_prefix| <= |t|)), then

  1. If ((t[0 : |t_prefix|] = t_prefix)), then

    1. Return true

2. Otherwise,

  1. Return false

def $ends_with(t, t_suffix)

1. If ((|t_suffix| <= |t|)), then

  1. (Let i be (|t| - |t_suffix|))

    1. If ((i has type nat)), then

      1. (Let n_start be (i as nat))

        1. If ((t[n_start : |t_suffix|] = t_suffix)), then

          1. Return true

2. Otherwise,

  1. Return false

def $strip_prefix_rec(t, t_prefix)

1. Case analysis on $starts_with(t, t_prefix)

  1. Case true

    1. (Let t_stripped be $strip_prefix(t, t_prefix))

      1. Return $strip_prefix_rec(t_stripped, t_prefix)

  2. Case false

    1. Return t

def $strip_suffix_rec(t, t_suffix)

1. Case analysis on $ends_with(t, t_suffix)

  1. Case true

    1. (Let t_stripped be $strip_suffix(t, t_suffix))

      1. Return $strip_suffix_rec(t_stripped, t_suffix)

  2. Case false

    1. Return t

