                          1. (Call_convention_ok: (BLOCK) TC (NOACTION) |- (parameterIR_aligned_inferred)*{parameterIR_aligned_inferred <- parameterIR_aligned_inferred*} '@' (argumentIR)*{argumentIR <- argumentIR*} : (argumentIR_cast)*{argumentIR_cast <- argumentIR_cast*})

                            1. Result in: % % % |- % `< % '#' % `> `( % '#' % '#' % `) : typeIR_object_inferred `< (typeArgumentIR_inferred)*{typeArgumentIR_inferred <- typeArgumentIR_inferred*} `> `( (argumentIR_cast)*{argumentIR_cast <- argumentIR_cast*} `)

