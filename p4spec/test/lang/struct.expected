   | parser typeId < typeParameterIR* , typeParameterIR* >( parameterIR* )
   | control typeId < typeParameterIR* , typeParameterIR* >( parameterIR* )
   | package typeId < typeParameterIR* , typeParameterIR* >{ typeIR* }
   | table typeId { tableMetadataStructTypeIR } hint(print %0)

syntax typeDefIR = 
   | ` typeId hint(print %0)
   | typedef typeId typeIR hint(print %0)
   | type typeId typeIR hint(print %0)
   | struct typeId < typeParameterIR* >{ fieldTypeIR* }
   | header typeId < typeParameterIR* >{ fieldTypeIR* }
   | header_union typeId < typeParameterIR* >{ fieldTypeIR* }
   | enum typeId { nameIR* } hint(print %0)
   | enum typeId < typeIR >{ valueFieldIR* } hint(print %0)
   | extern typeId < typeParameterIR* , typeParameterIR* > externMethodTypeDefEnv
   | parser typeId < typeParameterIR* , typeParameterIR* >( parameterIR* )
   | control typeId < typeParameterIR* , typeParameterIR* >( parameterIR* )
   | package typeId < typeParameterIR* , typeParameterIR* >{ typeIR* }
   | table typeId { tableMetadataStructTypeIR } hint(print %0)

def $unroll_typeIR(typeIR)

1. If ((typeIR has type typedefTypeIR)), then

  1. (Let (typedef _typeId typeIR') be (typeIR as typedefTypeIR))

    1. Return $unroll_typeIR(typeIR')

2. Otherwise,

  1. Return typeIR

def $unroll_aliasType(typeIR)

1. Case analysis on typeIR

  1. Case (% has type newTypeIR)

    1. (Let (type _typeId typeIR') be (typeIR as newTypeIR))

      1. Return $unroll_aliasType(typeIR')

  2. Case (% has type typedefTypeIR)

    1. (Let (typedef _typeId typeIR') be (typeIR as typedefTypeIR))

      1. Return $unroll_aliasType(typeIR')

2. Otherwise,

  1. Return typeIR

def $width_of_integerTypeIR(integerTypeIR)

1. Case analysis on integerTypeIR

  1. Case (% has type intTypeIR)

    1. (Let intTypeIR be (integerTypeIR as intTypeIR))

      1. Return ?()

  2. Case (% has type fixedIntTypeIR)

    1. (Let (int< n >) be (integerTypeIR as fixedIntTypeIR))

      1. Return ?(n)

  3. Case (% has type fixedBitTypeIR)

    1. (Let (bit< n >) be (integerTypeIR as fixedBitTypeIR))

      1. Return ?(n)

  4. Case (% has type varBitTypeIR)

    1. (Let (varbit< n >) be (integerTypeIR as varBitTypeIR))

      1. Return ?(n)

tbl def $is_defaultable_typeIR(typeIR'')
=

  Row : ((bool) as typeIR) -> true:

    1. If ((typeIR'' has type boolTypeIR)), then

      1. (Let boolTypeIR be (typeIR'' as boolTypeIR))

        1. Return true

  Row : ((error) as typeIR) -> true:

    1. If ((typeIR'' has type errorTypeIR)), then

      1. (Let errorTypeIR be (typeIR'' as errorTypeIR))

        1. Return true

  Row : ((string) as typeIR) -> true:

    1. If ((typeIR'' has type stringTypeIR)), then

      1. (Let stringTypeIR be (typeIR'' as stringTypeIR))

        1. Return true

  Row : (integerTypeIR as typeIR) -> true:

    1. If ((typeIR'' has type integerTypeIR)), then

      1. Return true

  Row : ((typedef _typeId typeIR) as typeIR) -> $is_defaultable_typeIR(typeIR):

    1. If ((typeIR'' has type typedefTypeIR)), then

      1. (Let (typedef _typeId typeIR) be (typeIR'' as typedefTypeIR))

        1. Return $is_defaultable_typeIR(typeIR)

  Row : ((type _typeId typeIR) as typeIR) -> $is_defaultable_typeIR(typeIR):

    1. If ((typeIR'' has type newTypeIR)), then

      1. (Let (type _typeId typeIR) be (typeIR'' as newTypeIR))

        1. Return $is_defaultable_typeIR(typeIR)

  Row : ((tuple< (typeIR)* >) as typeIR) -> $forall_(($is_defaultable_typeIR(typeIR))*):

    1. If ((typeIR'' has type tupleTypeIR)), then

      1. (Let (tuple< (typeIR)* >) be (typeIR'' as tupleTypeIR))

        1. Return $forall_(($is_defaultable_typeIR(typeIR))*)

  Row : ((typeIR [ _nat ]) as typeIR) -> $is_defaultable_typeIR(typeIR):

    1. If ((typeIR'' has type headerStackTypeIR)), then

      1. (Let (typeIR [ _nat ]) be (typeIR'' as headerStackTypeIR))

        1. Return $is_defaultable_typeIR(typeIR)

  Row : ((struct _typeId < (_typeArgumentIR)* >{ ((_annotationList typeIR _nameIR ;))* }) as typeIR) -> $forall_(($is_defaultable_typeIR(typeIR))*):

    1. If ((typeIR'' has type structTypeIR)), then

      1. (Let (struct _typeId < (_typeArgumentIR)* >{ ((_annotationList typeIR _nameIR ;))* }) be (typeIR'' as structTypeIR))

        1. Return $forall_(($is_defaultable_typeIR(typeIR))*)

  Row : ((header _typeId < (_typeArgumentIR)* >{ ((_annotationList typeIR _nameIR ;))* }) as typeIR) -> $forall_(($is_defaultable_typeIR(typeIR))*):

    1. If ((typeIR'' has type headerTypeIR)), then

      1. (Let (header _typeId < (_typeArgumentIR)* >{ ((_annotationList typeIR _nameIR ;))* }) be (typeIR'' as headerTypeIR))

        1. Return $forall_(($is_defaultable_typeIR(typeIR))*)

  Row : ((header_union _typeId < (_typeArgumentIR)* >{ ((_annotationList typeIR _nameIR ;))* }) as typeIR) -> $forall_(($is_defaultable_typeIR(typeIR))*):

    1. If ((typeIR'' has type headerUnionTypeIR)), then

