tbl def $is_serializable_typeIR(typeIR'')
=

  Row : ((BOOL) as typeIR) -> true:

    1. If ((typeIR'' has type boolTypeIR)), then

      1. (Let boolTypeIR be (typeIR'' as boolTypeIR))

        1. Return true

  Row : ((INT `< _nat `>) as typeIR) -> true:

    1. If ((typeIR'' has type fixedIntTypeIR)), then

      1. Return true

  Row : ((BIT `< _nat `>) as typeIR) -> true:

    1. If ((typeIR'' has type fixedBitTypeIR)), then

      1. Return true

  Row : ((VARBIT `< _nat `>) as typeIR) -> true:

    1. If ((typeIR'' has type varBitTypeIR)), then

      1. Return true

  Row : ((TYPEDEF _typeId typeIR) as typeIR) -> $is_serializable_typeIR(typeIR):

    1. If ((typeIR'' has type typedefTypeIR)), then

      1. (Let (TYPEDEF _typeId typeIR) be (typeIR'' as typedefTypeIR))

        1. Return $is_serializable_typeIR(typeIR)

  Row : ((TYPE _typeId typeIR) as typeIR) -> $is_serializable_typeIR(typeIR):

    1. If ((typeIR'' has type newTypeIR)), then

      1. (Let (TYPE _typeId typeIR) be (typeIR'' as newTypeIR))

        1. Return $is_serializable_typeIR(typeIR)

  Row : ((ENUM _typeId `< typeIR `> `{ (_valueFieldIR)*{_valueFieldIR <- _valueFieldIR*} `}) as typeIR) -> $is_serializable_typeIR(typeIR):

    1. If ((typeIR'' has type serializableEnumTypeIR)), then

      1. (Let (ENUM _typeId `< typeIR `> `{ (_valueFieldIR)*{_valueFieldIR <- _valueFieldIR*} `}) be (typeIR'' as serializableEnumTypeIR))

        1. Return $is_serializable_typeIR(typeIR)

  Row : ((TUPLE `< (typeIR)*{typeIR <- typeIR*} `>) as typeIR) -> $forall_(($is_serializable_typeIR(typeIR))*{typeIR <- typeIR*}):

    1. If ((typeIR'' has type tupleTypeIR)), then

      1. (Let (TUPLE `< (typeIR)*{typeIR <- typeIR*} `>) be (typeIR'' as tupleTypeIR))

        1. Return $forall_(($is_serializable_typeIR(typeIR))*{typeIR <- typeIR*})

  Row : ((ARRAY typeIR `[ _nat `]) as typeIR) -> $is_serializable_typeIR(typeIR):

    1. If ((typeIR'' has type arrayTypeIR)), then

      1. (Let (ARRAY typeIR `[ _nat `]) be (typeIR'' as arrayTypeIR))

        1. Return $is_serializable_typeIR(typeIR)

  Row : ((HEADER_STACK typeIR `[ _nat `]) as typeIR) -> $is_serializable_typeIR(typeIR):

    1. If ((typeIR'' has type headerStackTypeIR)), then

      1. (Let (HEADER_STACK typeIR `[ _nat `]) be (typeIR'' as headerStackTypeIR))

        1. Return $is_serializable_typeIR(typeIR)

  Row : ((STRUCT _typeId `< (_typeArgumentIR)*{_typeArgumentIR <- _typeArgumentIR*} `> `{ ((_annotationList typeIR _nameIR ';'))*{_annotationList <- _annotationList*, _nameIR <- _nameIR*, typeIR <- typeIR*} `}) as typeIR) -> $forall_(($is_serializable_typeIR(typeIR))*{typeIR <- typeIR*}):

    1. If ((typeIR'' has type structTypeIR)), then

      1. (Let (STRUCT _typeId `< (_typeArgumentIR)*{_typeArgumentIR <- _typeArgumentIR*} `> `{ ((_annotationList typeIR _nameIR ';'))*{_annotationList <- _annotationList*, _nameIR <- _nameIR*, typeIR <- typeIR*} `}) be (typeIR'' as structTypeIR))

        1. Return $forall_(($is_serializable_typeIR(typeIR))*{typeIR <- typeIR*})

  Row : ((HEADER _typeId `< (_typeArgumentIR)*{_typeArgumentIR <- _typeArgumentIR*} `> `{ ((_annotationList typeIR _nameIR ';'))*{_annotationList <- _annotationList*, _nameIR <- _nameIR*, typeIR <- typeIR*} `}) as typeIR) -> $forall_(($is_serializable_typeIR(typeIR))*{typeIR <- typeIR*}):

    1. If ((typeIR'' has type headerTypeIR)), then

      1. (Let (HEADER _typeId `< (_typeArgumentIR)*{_typeArgumentIR <- _typeArgumentIR*} `> `{ ((_annotationList typeIR _nameIR ';'))*{_annotationList <- _annotationList*, _nameIR <- _nameIR*, typeIR <- typeIR*} `}) be (typeIR'' as headerTypeIR))

        1. Return $forall_(($is_serializable_typeIR(typeIR))*{typeIR <- typeIR*})

  Row : ((HEADER_UNION _typeId `< (_typeArgumentIR)*{_typeArgumentIR <- _typeArgumentIR*} `> `{ ((_annotationList typeIR _nameIR ';'))*{_annotationList <- _annotationList*, _nameIR <- _nameIR*, typeIR <- typeIR*} `}) as typeIR) -> $forall_(($is_serializable_typeIR(typeIR))*{typeIR <- typeIR*}):

    1. If ((typeIR'' has type headerUnionTypeIR)), then

      1. (Let (HEADER_UNION _typeId `< (_typeArgumentIR)*{_typeArgumentIR <- _typeArgumentIR*} `> `{ ((_annotationList typeIR _nameIR ';'))*{_annotationList <- _annotationList*, _nameIR <- _nameIR*, typeIR <- typeIR*} `}) be (typeIR'' as headerUnionTypeIR))

        1. Return $forall_(($is_serializable_typeIR(typeIR))*{typeIR <- typeIR*})

  Row : _typeIR -> false:

    1. Return false

def $typeId_of_typeDefIR(typeDefIR)

1. Case analysis on typeDefIR

  1. Case (% has type nameTypeIR)

    1. (Let (_NAME typeId) be (typeDefIR as nameTypeIR))

      1. Return typeId

  2. Case (% has type typedefTypeIR)

    1. (Let (TYPEDEF typeId _typeIR) be (typeDefIR as typedefTypeIR))

      1. Return typeId

  3. Case (% has type newTypeIR)

    1. (Let (TYPE typeId _typeIR) be (typeDefIR as newTypeIR))

      1. Return typeId

  4. Case (% has type structTypeDefIR)

    1. (Let (STRUCT typeId `< (_typeParameterIR)*{_typeParameterIR <- _typeParameterIR*} `> `{ (_fieldTypeIR)*{_fieldTypeIR <- _fieldTypeIR*} `}) be (typeDefIR as structTypeDefIR))

      1. Return typeId

  5. Case (% has type headerTypeDefIR)

    1. (Let (HEADER typeId `< (_typeParameterIR)*{_typeParameterIR <- _typeParameterIR*} `> `{ (_fieldTypeIR)*{_fieldTypeIR <- _fieldTypeIR*} `}) be (typeDefIR as headerTypeDefIR))

      1. Return typeId

  6. Case (% has type headerUnionTypeDefIR)

    1. (Let (HEADER_UNION typeId `< (_typeParameterIR)*{_typeParameterIR <- _typeParameterIR*} `> `{ (_fieldTypeIR)*{_fieldTypeIR <- _fieldTypeIR*} `}) be (typeDefIR as headerUnionTypeDefIR))

      1. Return typeId

  7. Case (% has type simpleEnumTypeIR)

    1. (Let (ENUM typeId `{ (_nameIR)*{_nameIR <- _nameIR*} `}) be (typeDefIR as simpleEnumTypeIR))

      1. Return typeId

  8. Case (% has type serializableEnumTypeIR)

    1. (Let (ENUM typeId `< _typeIR `> `{ (_valueFieldIR)*{_valueFieldIR <- _valueFieldIR*} `}) be (typeDefIR as serializableEnumTypeIR))

      1. Return typeId

  9. Case (% has type externObjectTypeDefIR)

    1. (Let (EXTERN typeId `< (_typeParameterIR)*{_typeParameterIR <- _typeParameterIR*} ',' (_typeParameterIR')*{_typeParameterIR' <- _typeParameterIR'*} `> (`{ (_pair<callableId, externMethodTypeDefIR>)*{_pair<callableId, externMethodTypeDefIR> <- _pair<callableId, externMethodTypeDefIR>*} `})) be (typeDefIR as externObjectTypeDefIR))

      1. Return typeId

  10. Case (% has type parserObjectTypeDefIR)

    1. (Let (PARSER typeId `< (_typeParameterIR)*{_typeParameterIR <- _typeParameterIR*} ',' (_typeParameterIR')*{_typeParameterIR' <- _typeParameterIR'*} `> `( (_parameterIR)*{_parameterIR <- _parameterIR*} `)) be (typeDefIR as parserObjectTypeDefIR))

      1. Return typeId

  11. Case (% has type controlObjectTypeDefIR)

    1. (Let (CONTROL typeId `< (_typeParameterIR)*{_typeParameterIR <- _typeParameterIR*} ',' (_typeParameterIR')*{_typeParameterIR' <- _typeParameterIR'*} `> `( (_parameterIR)*{_parameterIR <- _parameterIR*} `)) be (typeDefIR as controlObjectTypeDefIR))

      1. Return typeId

  12. Case (% has type packageObjectTypeDefIR)

    1. (Let (PACKAGE typeId `< (_typeParameterIR)*{_typeParameterIR <- _typeParameterIR*} ',' (_typeParameterIR')*{_typeParameterIR' <- _typeParameterIR'*} `> `{ (_typeIR)*{_typeIR <- _typeIR*} `}) be (typeDefIR as packageObjectTypeDefIR))

      1. Return typeId

  13. Case (% has type tableObjectTypeIR)

    1. (Let (TABLE typeId `{ _tableMetadataStructTypeIR `}) be (typeDefIR as tableObjectTypeIR))

      1. Return typeId

def $typeIR_of_typeDefIR(typeDefIR)

1. Case analysis on typeDefIR

  1. Case (% has type nameTypeDefIR)

    1. (Let nameTypeDefIR be (typeDefIR as nameTypeDefIR))

      1. Return (nameTypeDefIR as typeIR)

  2. Case (% has type aliasTypeDefIR)

    1. (Let aliasTypeDefIR be (typeDefIR as aliasTypeDefIR))

