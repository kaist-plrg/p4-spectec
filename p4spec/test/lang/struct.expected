def $partition_parameterListIR((parameterIR)*, (nameIR)*, (nameIR')*)

1. Case analysis on (parameterIR)*

  1. Case (% matches pattern [])

    1. Return ([], [], [])

  2. Case (% matches pattern _ :: _)

    1. (Let parameterIR_h :: (parameterIR_t)* be (parameterIR)*)

      1. (Let ((parameterIR_given)*, (parameterIR_default)*, (parameterIR_optional)*) be $partition_parameterListIR((parameterIR_t)*, (nameIR)*, (nameIR')*))

        1. (Let (_annotationList _direction _typeIR nameIR_h _parameterInitializerOptIR) be parameterIR_h)

          1. Case analysis on nameIR_h is in (nameIR)*

            1. Case true

              1. Return ((parameterIR_given)*, parameterIR_h :: (parameterIR_default)*, (parameterIR_optional)*)

            2. Case false

              1. If (~nameIR_h is in (nameIR')*), then

                1. Return (parameterIR_h :: (parameterIR_given)*, (parameterIR_default)*, (parameterIR_optional)*)

              1. Else Dangling#2620

          2. If (nameIR_h is in (nameIR')*), then

            1. Return ((parameterIR_given)*, (parameterIR_default)*, parameterIR_h :: (parameterIR_optional)*)

          2. Else Dangling#2622

syntax callAlign = 
   | GIVEN parameterIR* DEFAULT parameterIR* (from callAlign) 

def $align_parameterListIR((parameterIR)*, (argumentIR)*, (nameIR_default)*, (nameIR_optional)*)

1. (Let ((parameterIR_given)*, (parameterIR_default)*, (parameterIR_optional)*) be $partition_parameterListIR((parameterIR)*, (nameIR_default)*, (nameIR_optional)*))

  1. (Let (_annotationList _direction _typeIR nameIR_given _parameterInitializerOptIR) be parameterIR_given)*

    1. If ((|(nameIR_given)*| = |(parameterIR_given)*|)), then

      1. (Let (parameterIR_given_aligned)* be $align_parameterListIR_given(({ ((nameIR_given : parameterIR_given))* }), (parameterIR_given)*, (argumentIR)*))

        1. Return (GIVEN (parameterIR_given_aligned)* DEFAULT (parameterIR_default)*)

    1. Else Dangling#2626

def $align_parameterListIR_given(({ ((id : parameterIR))* }), (parameterIR')*, (argumentIR)*)

1. Case analysis on (parameterIR')*

  1. Case (% matches pattern [])

    1. If (((argumentIR)* matches pattern [])), then

      1. Return []

    1. Else Dangling#2630

  2. Case (% matches pattern _ :: _)

    1. (Let parameterIR_h :: (parameterIR_t)* be (parameterIR')*)

      1. If (((argumentIR)* matches pattern _ :: _)), then

        1. (Let argumentIR_h :: (argumentIR_t)* be (argumentIR)*)

          1. Case analysis on argumentIR_h

            1. Case (% has type typedExpressionIR)

              1. (Let (parameterIR_aligned)* be $align_parameterListIR_given(({ ((id : parameterIR))* }), (parameterIR_t)*, (argumentIR_t)*))

                1. Return parameterIR_h :: (parameterIR_aligned)*

            2. Case (% matches pattern `_`)

              1. (Let (parameterIR_aligned)* be $align_parameterListIR_given(({ ((id : parameterIR))* }), (parameterIR_t)*, (argumentIR_t)*))

                1. Return parameterIR_h :: (parameterIR_aligned)*

            3. Case (% matches pattern `% = %`)

              1. (Let (nameIR = _typedExpressionIR) be argumentIR_h)

                1. (Let (parameterIR'')? be $find_map<id, parameterIR>(({ ((id : parameterIR))* }), nameIR))

                  1. If (((parameterIR'')? matches pattern (_))), then

                    1. (Let ?(parameterIR_match) be (parameterIR'')?)

                      1. (Let (parameterIR_aligned)* be $align_parameterListIR_given(({ ((id : parameterIR))* }), (parameterIR_t)*, (argumentIR_t)*))

                        1. Return parameterIR_match :: (parameterIR_aligned)*

                  1. Else Dangling#2642

            4. Case (% matches pattern `% = _`)

              1. (Let (nameIR = _) be argumentIR_h)

                1. (Let (parameterIR'')? be $find_map<id, parameterIR>(({ ((id : parameterIR))* }), nameIR))

                  1. If (((parameterIR'')? matches pattern (_))), then

                    1. (Let ?(parameterIR_match) be (parameterIR'')?)

                      1. (Let (parameterIR_aligned)* be $align_parameterListIR_given(({ ((id : parameterIR))* }), (parameterIR_t)*, (argumentIR_t)*))

                        1. Return parameterIR_match :: (parameterIR_aligned)*

                  1. Else Dangling#2648

      1. Else Dangling#2633

syntax callTargetKey = 
