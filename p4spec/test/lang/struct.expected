def $starts_with(t, t_prefix)

1. If ((|t_prefix| <= |t|)), then

  1. If ((t[0 : |t_prefix|] = t_prefix)), then

    1. Return true

2. Otherwise,

  1. Return false

def $ends_with(t, t_suffix)

1. If ((|t_suffix| <= |t|)), then

  1. (Let int be (|t| - |t_suffix|))

    1. If ((int has type nat)), then

      1. (Let n_start be (int as nat))

        1. If ((t[n_start : |t_suffix|] = t_suffix)), then

          1. Return true

2. Otherwise,

  1. Return false

def $strip_prefix_rec(t, t_prefix)

1. Case analysis on $starts_with(t, t_prefix)

  1. Case true

    1. (Let t_stripped be $strip_prefix(t, t_prefix))

      1. Return $strip_prefix_rec(t_stripped, t_prefix)

  2. Case false

    1. Return t

def $strip_suffix_rec(t, t_suffix)

1. Case analysis on $ends_with(t, t_suffix)

  1. Case true

    1. (Let t_stripped be $strip_suffix(t, t_suffix))

      1. Return $strip_suffix_rec(t_stripped, t_suffix)

  2. Case false

    1. Return t

def $contains(t, t_c)

1. Return $contains'(0, |t|, t, t_c)

def $contains'(n_len, n_len', t, t_c)

1. If ((n_len = n_len')), then

  1. Return false

1. Else Dangling#49

2. If ((n_len < n_len')), then

  1. If ((n_len < |t|)), then

    1. Case analysis on t[n_len]

      1. Case (% = t_c)

        1. Return true

      2. Case (% =/= t_c)

        1. Return $contains'((n_len + 1), n_len', t, t_c)

  1. Else Dangling#52

2. Else Dangling#51

