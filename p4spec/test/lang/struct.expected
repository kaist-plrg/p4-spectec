            1. Return ?(((typedLvalueIR_base `[ typedExpressionIR_index `]) '#' (`( typeIR `))))

        1. Else Dangling#2760

  4. Case (% has type sliceAccessExpressionIR)

    1. (Let (typedExpressionIR_base `[ typedExpressionIR_hi sliceop typedExpressionIR_lo `]) be (expressionIR as sliceAccessExpressionIR))

      1. Case analysis on sliceop

        1. Case (% matches pattern `:`)

          1. (Let (typedLvalueIR)?{typedLvalueIR <- typedLvalueIR?} be $typedExpressionIR_as_typedLvalueIR(typedExpressionIR_base))

            1. If (((typedLvalueIR)?{typedLvalueIR <- typedLvalueIR?} matches pattern (_))), then

              1. (Let ?(typedLvalueIR_base) be (typedLvalueIR)?{typedLvalueIR <- typedLvalueIR?})

                1. Return ?(((typedLvalueIR_base `[ typedExpressionIR_hi (':') typedExpressionIR_lo `]) '#' (`( typeIR `))))

            1. Else Dangling#2766

        2. Case (% matches pattern `+:`)

          1. (Let (typedLvalueIR)?{typedLvalueIR <- typedLvalueIR?} be $typedExpressionIR_as_typedLvalueIR(typedExpressionIR_base))

            1. If (((typedLvalueIR)?{typedLvalueIR <- typedLvalueIR?} matches pattern (_))), then

