def $lift_controlDeclarationIR((annotationList CONTROL nameIR `< (typeParameterIR_expl)*{typeParameterIR_expl <- typeParameterIR_expl*} ',' (typeParameterIR_impl)*{typeParameterIR_impl <- typeParameterIR_impl*} `> `( (parameterIR)*{parameterIR <- parameterIR*} `) `( (constructorParameterIR)*{constructorParameterIR <- constructorParameterIR*} `) `{ (controlLocalDeclarationIR)*{controlLocalDeclarationIR <- controlLocalDeclarationIR*} APPLY controlBodyIR `}))

1. (Let name be ($lift_nameIR_as_nonTypeName(nameIR) as name))

  1. (Let (typeParameterIR)*{typeParameterIR <- typeParameterIR*} be (typeParameterIR_expl)*{typeParameterIR_expl <- typeParameterIR_expl*} ++ (typeParameterIR_impl)*{typeParameterIR_impl <- typeParameterIR_impl*})

    1. (Let typeParameterListOpt be $lift_typeParameterListIR((typeParameterIR)*{typeParameterIR <- typeParameterIR*}))

      1. (Let parameterList be $lift_parameterListIR((parameterIR)*{parameterIR <- parameterIR*}))

        1. (Let constructorParameterListOpt be $lift_constructorParameterListIR((constructorParameterIR)*{constructorParameterIR <- constructorParameterIR*}))

          1. (Let controlLocalDeclarationList be $lift_controlLocalDeclarationListIR((controlLocalDeclarationIR)*{controlLocalDeclarationIR <- controlLocalDeclarationIR*}))

            1. (Let controlBody be $lift_controlBodyIR(controlBodyIR))

              1. Return (annotationList CONTROL name typeParameterListOpt `( parameterList `) constructorParameterListOpt `{ controlLocalDeclarationList APPLY controlBody `})

