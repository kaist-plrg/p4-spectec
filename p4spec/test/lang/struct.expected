def $capture_avoiding_(theta, (typeParameterIR)*{typeParameterIR <- typeParameterIR*}, B)

1. (Let (`{ (typeId_free)*{typeId_free <- typeId_free*} `}) be $diff_set<typeId>(B, (`{ (typeParameterIR)*{typeParameterIR <- typeParameterIR*} `})))

  1. (Let (typeIR)?{typeIR <- typeIR?} be $find_map<typeId, typeIR>(theta, typeId_free))*{typeId_free <- typeId_free*, typeIR? -> typeIR?*}

    1. If (((typeIR)?{typeIR <- typeIR?} matches pattern (_)))*{typeIR? <- typeIR?*}, then

      1. (Let ?(typeIR_free) be (typeIR)?{typeIR <- typeIR?})*{typeIR? <- typeIR?*, typeIR_free -> typeIR_free*}

        1. (Let B_capture be $unions_set<typeId>(($free_typeIR(typeIR_free))*{typeIR_free <- typeIR_free*}))

          1. (Let (typeParameterIR_fresh)*{typeParameterIR_fresh <- typeParameterIR_fresh*} be $fresh_typeIds(|(typeParameterIR)*{typeParameterIR <- typeParameterIR*}|))

            1. If (~$in_set<typeId>(typeParameterIR_fresh, B_capture))*{typeParameterIR_fresh <- typeParameterIR_fresh*}, then

              1. (Let theta_fresh be $adds_map<typeId, typeIR>(theta, (typeParameterIR)*{typeParameterIR <- typeParameterIR*}, (((_NAME typeParameterIR_fresh) as typeIR))*{typeParameterIR_fresh <- typeParameterIR_fresh*}))

                1. Return (theta_fresh, (typeParameterIR_fresh)*{typeParameterIR_fresh <- typeParameterIR_fresh*})

            1. Else Dangling#1009

    1. Else Dangling#1005

