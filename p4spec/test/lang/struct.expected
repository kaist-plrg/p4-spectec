def $constructor_of_externConstructorPrototypeIR(typeParameterListIR_expl, externMethodPrototypeListIR, (_annotationList nameIR < , typeParameterListIR_impl > ( (parameterIR)* ) ;))

1. (Let typeParameterListIR be typeParameterListIR_expl ++ typeParameterListIR_impl)

  1. (Let constructorDef be ((EXTERN nameIR < typeParameterListIR > ( (parameterIR)* ) { externMethodPrototypeListIR }) as constructorDef))

    1. Return constructorDef

def $init_table((tablePropertyIR)*)

1. (Let tableKeysPropertyIR be $init_tableKeys((tablePropertyIR)*))

  1. (Let (tablePropertyIR')* be $filter_<tablePropertyIR>((tablePropertyIR)*, ((tablePropertyIR has type tableActionsPropertyIR))*))

    1. If (((tablePropertyIR')* has type tableActionsPropertyIR*)), then

      1. (Let (tableActionsPropertyIR)* be ((tablePropertyIR')* as tableActionsPropertyIR*))

        1. If (((tableActionsPropertyIR)* matches pattern [ _/1 ])), then

          1. (Let [tableActionsPropertyIR'] be (tableActionsPropertyIR)*)

            1. (Let (tablePropertyIR'')* be $filter_<tablePropertyIR>((tablePropertyIR)*, ((tablePropertyIR has type tableDefaultActionPropertyIR))*))

              1. If (((tablePropertyIR'')* has type tableDefaultActionPropertyIR*)), then

                1. (Let (tableDefaultActionPropertyIR)* be ((tablePropertyIR'')* as tableDefaultActionPropertyIR*))

                  1. If (((tableDefaultActionPropertyIR)* matches pattern [ _/1 ])), then

                    1. (Let [tableDefaultActionPropertyIR'] be (tableDefaultActionPropertyIR)*)

                      1. (Let tableEntriesPropertyIR be $init_tableEntries((tablePropertyIR)*))

                        1. (Let (tablePropertyIR''')* be $filter_<tablePropertyIR>((tablePropertyIR)*, ((tablePropertyIR has type tableCustomPropertyIR))*))

                          1. If (((tablePropertyIR''')* has type tableCustomPropertyIR*)), then

                            1. (Let (tableCustomPropertyIR)* be ((tablePropertyIR''')* as tableCustomPropertyIR*))

                              1. (Let TBL be {KEYS tableKeysPropertyIR, ACTIONS tableActionsPropertyIR', DEFAULT_ACTION tableDefaultActionPropertyIR', ENTRIES tableEntriesPropertyIR, CUSTOMS (tableCustomPropertyIR)*})

                                1. Return TBL

                          1. Else Dangling#9544

                  1. Else Dangling#9540

              1. Else Dangling#9538

        1. Else Dangling#9535

    1. Else Dangling#9533

