  1. If (((declaration)* = [])), then

    1. Result in: % |- % : typingContext []

  1. Else Phantom#1210

  2. If (((declaration)* matches pattern _ :: _)), then

    1. (Let declaration_h :: (declaration_t)* be (declaration)*)

      1. (Decl_ok: typingContext |- declaration_h : TC_1 declarationIR_h)

        1. (Decls_ok: TC_1 |- (declaration_t)* : TC_2 (declarationIR_t)*)

          1. Result in: % |- % : TC_2 declarationIR_h :: (declarationIR_t)*

  2. Else Phantom#1211

relation Program_ok: |- p4program : %

1. Group : |- p4program : %

  1. (Let (declaration)* be $flatten_p4program(p4program))

    1. (Let TC_0 be $empty_typingContext)

      1. (Decls_ok: TC_0 |- (declaration)* : TC_1 (declarationIR)*)

        1. Result in: |- % : ((declarationIR)* ;)

syntax actctxt = 
   | action
   | noaction

relation Call_convention_expr_ok: p TC actctxt |- (annotationList direction typeIR_param id parameterInitializerOptIR) @ typedExpressionIR_arg : %

1. If ((direction matches pattern `IN`)), then

  1. Group in: p TC actctxt |- (annotationList (in) typeIR_param id parameterInitializerOptIR) @ typedExpressionIR_arg : %

    1. (Let (typedExpressionIR)? be $cast_unary(typedExpressionIR_arg, typeIR_param))

      1. If (((typedExpressionIR)? matches pattern (_))), then

        1. (Let ?(typedExpressionIR_arg_cast) be (typedExpressionIR)?)

          1. Result in: % % % |- % @ % : typedExpressionIR_arg_cast

      1. Else Phantom#1212

1. Else Phantom#1213

2. Group out-inout: p TC actctxt |- (annotationList direction typeIR_param id parameterInitializerOptIR) @ typedExpressionIR_arg : %

  1. If (((direction = (out)) \/ (direction = (inout)))), then

    1. (Let typeIR_arg be $type_of_typedExpressionIR(typedExpressionIR_arg))

      1. If (Type_alpha: typeIR_param ~~ typeIR_arg) holds, then

        1. If (Expr_lvalue_ok: p TC |- typedExpressionIR_arg) holds, then

          1. Result in: % % % |- % @ % : typedExpressionIR_arg

        1. Else Phantom#1214

      1. Else Phantom#1215

  1. Else Phantom#1216

3. If ((direction matches pattern ``EMPTY`)), then

  1. Group empty: p TC actctxt |- (annotationList (`empty) typeIR_param id parameterInitializerOptIR) @ typedExpressionIR_arg : %

    1. Case analysis on actctxt

      1. Case (% matches pattern `ACTION`)

        1. (Let (typedExpressionIR)? be $cast_unary(typedExpressionIR_arg, typeIR_param))

          1. If (((typedExpressionIR)? matches pattern (_))), then

            1. (Let ?(typedExpressionIR_arg_cast) be (typedExpressionIR)?)

              1. Result in: % % % |- % @ % : typedExpressionIR_arg_cast

          1. Else Phantom#1217

      2. Case (% matches pattern `NOACTION`)

        1. (Let (typedExpressionIR)? be $cast_unary(typedExpressionIR_arg, typeIR_param))

          1. If (((typedExpressionIR)? matches pattern (_))), then

            1. (Let ?(typedExpressionIR_arg_cast) be (typedExpressionIR)?)

              1. If (~($ctk_of_typedExpressionIR(typedExpressionIR_arg) matches pattern `DYN`)), then

                1. Result in: % % % |- % @ % : typedExpressionIR_arg_cast

              1. Else Phantom#1218

          1. Else Phantom#1219

3. Else Phantom#1220

relation Call_convention_argument_ok: p TC actctxt |- parameterIR @ argumentIR : %

1. Case analysis on argumentIR

  1. Case (% has type typedExpressionIR)

    1. (Let typedExpressionIR be (argumentIR as typedExpressionIR))

      1. Group typedExpression: p TC actctxt |- parameterIR @ (typedExpressionIR as argumentIR) : %

        1. (Call_convention_expr_ok: p TC actctxt |- parameterIR @ typedExpressionIR : typedExpressionIR_cast)

          1. Result in: % % % |- % @ % : (typedExpressionIR_cast as argumentIR)

  2. Case (% matches pattern `%=%`)

    1. (Let (nameIR = typedExpressionIR) be argumentIR)

      1. Group nameIR-typedExpression: p TC actctxt |- parameterIR @ (nameIR = typedExpressionIR) : %

        1. (Call_convention_expr_ok: p TC actctxt |- parameterIR @ typedExpressionIR : typedExpressionIR_cast)

          1. Result in: % % % |- % @ % : (nameIR = typedExpressionIR_cast)

  3. Case (% matches pattern `%=_`)

    1. (Let (nameIR =_) be argumentIR)

      1. Group nameIR-dontcare: p TC actctxt |- parameterIR @ (nameIR =_) : %

        1. (Let (_annotationList direction _typeIR _id _parameterInitializerOptIR) be parameterIR)

          1. If ((direction matches pattern `OUT`)), then

            1. Result in: % % % |- % @ % : (nameIR =_)

          1. Else Phantom#1221

  4. Case (% matches pattern `_`)

    1. Group dontcare: p TC actctxt |- parameterIR @ (_) : %

      1. (Let (_annotationList direction _typeIR _id _parameterInitializerOptIR) be parameterIR)

        1. If ((direction matches pattern `OUT`)), then

          1. Result in: % % % |- % @ % : (_)

        1. Else Phantom#1222

relation Call_convention_ok: p TC actctxt |- (parameterIR)* @ (argumentIR)* : %

1. Group : p TC actctxt |- (parameterIR)* @ (argumentIR)* : %

  1. If (((parameterIR)* = [])), then

    1. If (((argumentIR)* = [])), then

      1. Result in: % % % |- % @ % : []

    1. Else Phantom#1223

  1. Else Phantom#1224

  2. If (((parameterIR)* matches pattern _ :: _)), then

    1. (Let parameterIR_h :: (parameterIR_t)* be (parameterIR)*)

      1. If (((argumentIR)* matches pattern _ :: _)), then

        1. (Let argumentIR_h :: (argumentIR_t)* be (argumentIR)*)

          1. (Call_convention_argument_ok: p TC actctxt |- parameterIR_h @ argumentIR_h : argumentIR_h_cast)

            1. (Call_convention_ok: p TC actctxt |- (parameterIR_t)* @ (argumentIR_t)* : (argumentIR_t_cast)*)

              1. Result in: % % % |- % @ % : argumentIR_h_cast :: (argumentIR_t_cast)*

      1. Else Phantom#1225

  2. Else Phantom#1226

def $is_static_callableTypeIR(callableTypeIR)

1. Case analysis on callableTypeIR

  1. Case (% has type externFunctionTypeIR)

    1. (Let (extern_function text ( (_parameterIR)* ): _typeIR) be (callableTypeIR as externFunctionTypeIR))

      1. If ((text = "static_assert")), then

        1. Return (lctk)

  2. Case (% has type builtinMethodTypeIR)

    1. (Let (builtin_method nameIR ( (_parameterIR)* ): _typeIR) be (callableTypeIR as builtinMethodTypeIR))

      1. If (nameIR is in ["minSizeInBits", "minSizeInBytes", "maxSizeInBits", "maxSizeInBytes"]), then

        1. Return (lctk)

2. Otherwise,

  1. Return (dyn)

def $is_static_assert_callableTypeIR(callableTypeIR)

1. If ((callableTypeIR has type externFunctionTypeIR)), then

  1. (Let (extern_function text ( (_parameterIR)* ): _typeIR) be (callableTypeIR as externFunctionTypeIR))

    1. If ((text = "static_assert")), then

      1. Return true

2. Otherwise,

  1. Return false

relation CallableTarget_ok: p TC |- callableTarget : %

1. Group : p TC |- callableTarget : %

  1. Case analysis on callableTarget

    1. Case (% has type prefixedNonTypeName)

      1. (Let prefixedNonTypeName be (callableTarget as prefixedNonTypeName))

        1. (Let prefixedNameIR be $prefixedNonTypeName(prefixedNonTypeName))

          1. Result in: % % |- % : (prefixedNameIR as callableTargetIR)

    2. Case (% has type memberAccessExpression)

      1. (Let (memberAccessBase . member) be (callableTarget as memberAccessExpression))

        1. Case analysis on memberAccessBase

          1. Case (% has type prefixedTypeName)

            1. (Let prefixedTypeName be (memberAccessBase as prefixedTypeName))

              1. (Let prefixedNameIR be $prefixedTypeName(prefixedTypeName))

                1. (Let nameIR be $name(member))

                  1. Result in: % % |- % : (type prefixedNameIR . nameIR)

          2. Case (% has type expression)

            1. (Let expression_base be (memberAccessBase as expression))

              1. (Let nameIR be $name(member))

                1. (Expr_ok: p TC |- expression_base : typedExpressionIR_base)

                  1. Result in: % % |- % : (typedExpressionIR_base . nameIR)

    3. Case (% has type parenthesizedExpression)

      1. (Let (( expression )) be (callableTarget as parenthesizedExpression))

        1. (CallableTarget_ok: p TC |- expression : callableTargetIR)

          1. Result in: % % |- % : (( callableTargetIR ))

  1. Else Phantom#1227

  2. If ((callableTarget = ((this) as callableTarget))), then

    1. Result in: % % |- % : ((` "this") as callableTargetIR)

  2. Else Phantom#1228

