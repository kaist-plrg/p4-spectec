    1. If ((nonEmptyParameterList' matches pattern `% , %`)), then

      1. (Let (nonEmptyParameterList ',' parameter) be nonEmptyParameterList')

        1. Return $flatten_parameterList((nonEmptyParameterList as parameterList)) ++ [parameter]

