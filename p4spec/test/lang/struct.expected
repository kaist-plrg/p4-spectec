syntax globalEvalLayer = globalInstLayer

syntax blockEvalLayer = blockInstLayer

syntax localEvalLayer = localInstLayer

syntax evalContext = {GLOBAL globalEvalLayer, BLOCK blockEvalLayer, LOCAL localEvalLayer}

var EC : evalContext

def $enter_e(EC)

1. Return EC[LOCAL.FRAMES = $empty_frame :: EC.LOCAL.FRAMES]

def $exit_e(EC)

1. (Let (frame)*{frame <- frame*} be EC.LOCAL.FRAMES)

  1. If (((frame)*{frame <- frame*} matches pattern _ :: _)), then

    1. (Let frame_h :: (frame_t)*{frame_t <- frame_t*} be (frame)*{frame <- frame*})

      1. Return EC[LOCAL.FRAMES = (frame_t)*{frame_t <- frame_t*}]

  1. Else Dangling#10503

def $inherit_e(p, EC)

1. Case analysis on p

  1. Case (% matches pattern `GLOBAL`)

    1. (Let blockEvalLayer be {TYPE $empty_theta, CALLABLE $empty_callableDefEnv, STATE $empty_stateEnv, FRAME $empty_frame})

      1. (Let localEvalLayer be {TYPE $empty_theta, FRAMES [$empty_frame]})

        1. Return EC[BLOCK = blockEvalLayer][LOCAL = localEvalLayer]

  2. Case (% matches pattern `BLOCK`)

    1. (Let localEvalLayer be {TYPE $empty_theta, FRAMES [$empty_frame]})

      1. Return EC[LOCAL = localEvalLayer]

  3. Case (% matches pattern `LOCAL`)

    1. Return EC

