def $flatten_argumentList(argumentList)

1. Case analysis on argumentList

  1. Case (% matches pattern `/* empty */`)

    1. Return []

  2. Case (% has type argument)

    1. (Let argument be (argumentList as argument))

      1. Return [argument]

1. Else Dangling#253

2. If ((argumentList has type argumentListNonEmpty)), then

  1. (Let argumentListNonEmpty' be (argumentList as argumentListNonEmpty))

    1. If ((argumentListNonEmpty' matches pattern `% , %`)), then

      1. (Let (argumentListNonEmpty ',' argument) be argumentListNonEmpty')

        1. Return $flatten_argumentList((argumentListNonEmpty as argumentList)) ++ [argument]

    1. Else Dangling#259

2. Else Dangling#257

syntax lvalue = 
   | _ID text (from identifier) 
   | APPLY (from nonTypeName) 
   | KEY (from nonTypeName) 
   | ACTIONS (from nonTypeName) 
   | STATE (from nonTypeName) 
   | ENTRIES (from nonTypeName) 
   | TYPE (from nonTypeName) 
   | PRIORITY (from nonTypeName) 
   | _ID '.' nonTypeName (from prefixedNonTypeName) 
   | THIS (from referenceExpression) 
   | lvalue '.' member (from lvalue) 
   | lvalue `[ expression `] (from lvalue) 
   | lvalue `[ expression sliceop expression `] (from lvalue) 
   | `( lvalue `) (from lvalue) 

def $lvalue_as_expression(lvalue')

1. Case analysis on lvalue'

  1. Case (% has type referenceExpression)

    1. (Let referenceExpression be (lvalue' as referenceExpression))

      1. Return (referenceExpression as expression)

  2. Case (% matches pattern `% . %`)

    1. (Let (lvalue_base '.' member) be lvalue')

      1. (Let expression_base be $lvalue_as_expression(lvalue_base))

        1. Return (((expression_base as memberAccessBase) '.' member) as expression)

  3. Case (% matches pattern `% [%]`)

    1. (Let (lvalue_base `[ expression_index `]) be lvalue')

      1. (Let expression_base be $lvalue_as_expression(lvalue_base))

        1. Return ((expression_base `[ expression_index `]) as expression)

  4. Case (% matches pattern `% [% % %]`)

    1. (Let (lvalue_base `[ expression_hi sliceop expression_lo `]) be lvalue')

      1. Case analysis on sliceop

        1. Case (% matches pattern `:`)

          1. (Let expression_base be $lvalue_as_expression(lvalue_base))

            1. Return ((expression_base `[ expression_hi (':') expression_lo `]) as expression)

        2. Case (% matches pattern `+:`)

          1. (Let expression_base be $lvalue_as_expression(lvalue_base))

            1. Return ((expression_base `[ expression_hi ('+:') expression_lo `]) as expression)

  5. Case (% matches pattern `(%)`)

    1. (Let (`( lvalue `)) be lvalue')

      1. (Let expression be $lvalue_as_expression(lvalue))

        1. Return ((`( expression `)) as expression)

def $expression_as_lvalue(expression')

1. Case analysis on expression'

  1. Case (% has type referenceExpression)

    1. (Let referenceExpression be (expression' as referenceExpression))

      1. Return ?((referenceExpression as lvalue))

  2. Case (% has type memberAccessExpression)

    1. (Let (memberAccessBase '.' member) be (expression' as memberAccessExpression))

      1. If ((memberAccessBase has type expression)), then

        1. (Let expression be (memberAccessBase as expression))

          1. (Let (lvalue')?{lvalue' <- lvalue'?} be $expression_as_lvalue(expression))

            1. If (((lvalue')?{lvalue' <- lvalue'?} matches pattern (_))), then

              1. (Let ?(lvalue) be (lvalue')?{lvalue' <- lvalue'?})

                1. Return ?((lvalue '.' member))

            1. Else Dangling#287

      1. Else Dangling#284

  3. Case (% has type indexAccessExpression)

    1. (Let (expression_base `[ expression_index `]) be (expression' as indexAccessExpression))

      1. (Let (lvalue)?{lvalue <- lvalue?} be $expression_as_lvalue(expression_base))

        1. If (((lvalue)?{lvalue <- lvalue?} matches pattern (_))), then

          1. (Let ?(lvalue_base) be (lvalue)?{lvalue <- lvalue?})

            1. Return ?((lvalue_base `[ expression_index `]))

        1. Else Dangling#292

  4. Case (% has type sliceAccessExpression)

    1. (Let (expression_base `[ expression_hi sliceop expression_lo `]) be (expression' as sliceAccessExpression))

      1. Case analysis on sliceop

        1. Case (% matches pattern `:`)

          1. (Let (lvalue)?{lvalue <- lvalue?} be $expression_as_lvalue(expression_base))

            1. If (((lvalue)?{lvalue <- lvalue?} matches pattern (_))), then

              1. (Let ?(lvalue_base) be (lvalue)?{lvalue <- lvalue?})

                1. Return ?((lvalue_base `[ expression_hi (':') expression_lo `]))

            1. Else Dangling#298

        2. Case (% matches pattern `+:`)

          1. (Let (lvalue)?{lvalue <- lvalue?} be $expression_as_lvalue(expression_base))

            1. If (((lvalue)?{lvalue <- lvalue?} matches pattern (_))), then

              1. (Let ?(lvalue_base) be (lvalue)?{lvalue <- lvalue?})

                1. Return ?((lvalue_base `[ expression_hi ('+:') expression_lo `]))

            1. Else Dangling#302

  5. Case (% has type parenthesizedExpression)

    1. (Let (`( expression `)) be (expression' as parenthesizedExpression))

      1. (Let (lvalue')?{lvalue' <- lvalue'?} be $expression_as_lvalue(expression))

        1. If (((lvalue')?{lvalue' <- lvalue'?} matches pattern (_))), then

          1. (Let ?(lvalue) be (lvalue')?{lvalue' <- lvalue'?})

            1. Return ?((`( lvalue `)))

        1. Else Dangling#307

1. Else Dangling#280

syntax emptyStatement = 
   | ';' (from emptyStatement) 

syntax assignop = 
   | '=' (from assignop) 
   | '+=' (from assignop) 
   | '-=' (from assignop) 
   | '|+|=' (from assignop) 
   | '|-|=' (from assignop) 
   | '*=' (from assignop) 
   | '/=' (from assignop) 
   | '%=' (from assignop) 
   | '<<=' (from assignop) 
   | '>>=' (from assignop) 
   | '&=' (from assignop) 
   | '^=' (from assignop) 
   | '|=' (from assignop) 

syntax assignmentStatement = 
   | lvalue assignop expression ';' (from assignmentStatement) 

def $assignop_as_binop(assignop)

1. Case analysis on assignop

  1. Case (% matches pattern `+=`)

    1. Return ?(('+'))

  2. Case (% matches pattern `-=`)

    1. Return ?(('-'))

  3. Case (% matches pattern `|+|=`)

    1. Return ?(('|+|'))

  4. Case (% matches pattern `|-|=`)

    1. Return ?(('|-|'))

  5. Case (% matches pattern `*=`)

    1. Return ?(('*'))

  6. Case (% matches pattern `/=`)

    1. Return ?(('/'))

  7. Case (% matches pattern `%=`)

    1. Return ?(('%'))

  8. Case (% matches pattern `<<=`)

    1. Return ?(('<<'))

  9. Case (% matches pattern `>>=`)

    1. Return ?(('>>'))

  10. Case (% matches pattern `&=`)

    1. Return ?(('&'))

  11. Case (% matches pattern `^=`)

    1. Return ?(('^'))

  12. Case (% matches pattern `|=`)

    1. Return ?(('|'))

2. Otherwise,

  1. Return ?()

syntax callStatement = 
   | lvalue `( argumentList `) ';' (from callStatement) 
   | lvalue `< typeArgumentList `> `( argumentList `) ';' (from callStatement) 

syntax directApplicationStatement = 
   | namedType '.' APPLY `( argumentList `) ';' (from directApplicationStatement) 

syntax returnStatement = 
   | RETURN ';' (from returnStatement) 
   | RETURN expression ';' (from returnStatement) 

syntax exitStatement = 
   | EXIT ';' (from exitStatement) 

syntax blockStatement = 
   | annotationList `{ blockElementStatementList `} (from blockStatement) 

syntax conditionalStatement = 
   | IF `( expression `) statement (from conditionalStatement) 
   | IF `( expression `) statement ELSE statement (from conditionalStatement) 

syntax forUpdateStatement = 
   | lvalue `( argumentList `) (from forUpdateStatement) 
   | lvalue `< typeArgumentList `> `( argumentList `) (from forUpdateStatement) 
   | lvalue assignop expression (from forUpdateStatement) 

syntax forUpdateStatementListNonEmpty = 
   | lvalue `( argumentList `) (from forUpdateStatement) 
   | lvalue `< typeArgumentList `> `( argumentList `) (from forUpdateStatement) 
   | lvalue assignop expression (from forUpdateStatement) 
   | forUpdateStatementListNonEmpty ',' forUpdateStatement (from forUpdateStatementListNonEmpty) 

syntax forUpdateStatementList = 
   | _EMPTY (from forUpdateStatementList) 
   | lvalue `( argumentList `) (from forUpdateStatement) 
   | lvalue `< typeArgumentList `> `( argumentList `) (from forUpdateStatement) 
   | lvalue assignop expression (from forUpdateStatement) 
   | forUpdateStatementListNonEmpty ',' forUpdateStatement (from forUpdateStatementListNonEmpty) 

def $flatten_forUpdateStatementList(forUpdateStatementList)

1. Case analysis on forUpdateStatementList

  1. Case (% matches pattern `/* empty */`)

    1. Return []

  2. Case (% has type forUpdateStatement)

    1. (Let forUpdateStatement be (forUpdateStatementList as forUpdateStatement))

      1. Return [forUpdateStatement]

1. Else Dangling#324

2. If ((forUpdateStatementList has type forUpdateStatementListNonEmpty)), then

  1. (Let forUpdateStatementListNonEmpty' be (forUpdateStatementList as forUpdateStatementListNonEmpty))

    1. If ((forUpdateStatementListNonEmpty' matches pattern `% , %`)), then

      1. (Let (forUpdateStatementListNonEmpty ',' forUpdateStatement) be forUpdateStatementListNonEmpty')

        1. Return $flatten_forUpdateStatementList((forUpdateStatementListNonEmpty as forUpdateStatementList)) ++ [forUpdateStatement]

    1. Else Dangling#330

2. Else Dangling#328

