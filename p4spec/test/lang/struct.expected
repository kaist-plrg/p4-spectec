def $is_valid_bitslice(typeIR', n_lo, n_hi)

1. Case analysis on typeIR'

  1. Case (% has type intTypeIR)

    1. (Let intTypeIR be (typeIR' as intTypeIR))

      1. Return (n_lo <= n_hi)

  2. Case (% has type fixedIntTypeIR)

    1. (Let (INT `< w `>) be (typeIR' as fixedIntTypeIR))

      1. (Let i be ((n_hi - n_lo) + (1 as int)))

        1. If ((i has type nat)), then

          1. (Let w_slice be (i as nat))

            1. Return (((n_lo <= n_hi) /\ (n_hi <= w)) /\ (w_slice <= w))

  3. Case (% has type fixedBitTypeIR)

    1. (Let (BIT `< w `>) be (typeIR' as fixedBitTypeIR))

      1. (Let i be ((n_hi - n_lo) + (1 as int)))

        1. If ((i has type nat)), then

          1. (Let w_slice be (i as nat))

            1. Return (((n_lo <= n_hi) /\ (n_hi <= w)) /\ (w_slice <= w))

  4. Case (% has type typedefTypeIR)

    1. (Let (TYPEDEF _typeId typeIR) be (typeIR' as typedefTypeIR))

      1. Return $is_valid_bitslice(typeIR, n_lo, n_hi)

2. Otherwise,

  1. Return false

def $is_concrete_extern_object(typeIR)

1. Return $is_concrete_extern_object'($unroll_typeIR(typeIR))

def $is_concrete_extern_object'(typeIR)

1. Case analysis on (typeIR has type externObjectTypeIR)

  1. Case false

    1. Return true

  2. Case true

    1. (Let (EXTERN _typeId `< (_typeArgumentIR)*{_typeArgumentIR <- _typeArgumentIR*} `> (`{ ((_callableId ':' externMethodTypeDefIR))*{_callableId <- _callableId*, externMethodTypeDefIR <- externMethodTypeDefIR*} `})) be (typeIR as externObjectTypeIR))

      1. If ($is_concrete_extern_object''(externMethodTypeDefIR))*{externMethodTypeDefIR <- externMethodTypeDefIR*}, then

        1. Return true

2. Otherwise,

  1. Return false

def $is_concrete_extern_object''(externMethodTypeDefIR)

1. If ((externMethodTypeDefIR matches pattern `EXTERN_METHOD % <% , %> (%) : %`)), then

  1. Return true

2. Otherwise,

  1. Return false

relation Parameters_ok: p TC_pre TC |- (parameter)*{parameter <- parameter*} : % % '#' %

1. Case analysis on (parameter)*{parameter <- parameter*}

  1. Case (% matches pattern [])

    1. Result in: % % % |- % : TC [] '#' []

  2. Case (% matches pattern _ :: _)

    1. (Let parameter_h :: (parameter_t)*{parameter_t <- parameter_t*} be (parameter)*{parameter <- parameter*})

      1. (Parameter_ok: p TC_pre |- parameter_h : parameterIR_h '#' (typeId_fresh_h)*{typeId_fresh_h <- typeId_fresh_h*})

        1. (Let TC_1 be $add_parameter_t(p, TC, parameterIR_h))

          1. (Parameters_ok: p TC_pre TC_1 |- (parameter_t)*{parameter_t <- parameter_t*} : TC_2 (parameterIR_t)*{parameterIR_t <- parameterIR_t*} '#' (typeId_fresh_t)*{typeId_fresh_t <- typeId_fresh_t*})

            1. (Let (parameterIR)*{parameterIR <- parameterIR*} be parameterIR_h :: (parameterIR_t)*{parameterIR_t <- parameterIR_t*})

              1. (Let (typeId_fresh)*{typeId_fresh <- typeId_fresh*} be (typeId_fresh_h)*{typeId_fresh_h <- typeId_fresh_h*} ++ (typeId_fresh_t)*{typeId_fresh_t <- typeId_fresh_t*})

                1. Result in: % % % |- % : TC_2 (parameterIR)*{parameterIR <- parameterIR*} '#' (typeId_fresh)*{typeId_fresh <- typeId_fresh*}

relation ForUpdateStmt_ok: TC |- forUpdateStatement : %

1. Case analysis on forUpdateStatement

  1. Case (% matches pattern `% (%)`)

    1. (Let (lvalue_callable `( argumentList `)) be forUpdateStatement)

      1. (Stmt_ok: (LOCAL) TC |- ((lvalue_callable `( argumentList `) ';') as statement) : _TC statementIR)

        1. If ((statementIR has type callStatementIR)), then

          1. (Let (callableTargetIR `< (typeArgumentIR)*{typeArgumentIR <- typeArgumentIR*} `> `( (argumentIR)*{argumentIR <- argumentIR*} `) ';') be (statementIR as callStatementIR))

