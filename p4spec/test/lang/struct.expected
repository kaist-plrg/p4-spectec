                1. Case true

                  1. (Let frame_h' be $update_map<id, value>(frame_h, id, value))

                    1. Return EC[LOCAL.FRAMES = frame_h' :: (frame_t)*]

                2. Case false

                  1. (Let EC_pop be EC[LOCAL.FRAMES = (frame_t)*])

                    1. (Let EC_pop' be $update_var_e((LOCAL), EC_pop, (` id), value))

                      1. Return EC_pop'[LOCAL.FRAMES = frame_h :: EC_pop'.LOCAL.FRAMES]

          1. Else Dangling#9631

    1. Else Dangling#9626

