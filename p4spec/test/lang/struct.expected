    2. Case false

      1. (Let b_lpm be $is_lpm_key(tableKeyIR))*{tableKeyIR <- tableKeyIR*, b_lpm -> b_lpm*}

        1. (Let (tableKeyIR')*{tableKeyIR' <- tableKeyIR'*} be $filter_<tableKeyIR>((tableKeyIR)*{tableKeyIR <- tableKeyIR*}, (b_lpm)*{b_lpm <- b_lpm*}))

          1. If (((tableKeyIR')*{tableKeyIR' <- tableKeyIR'*} matches pattern [ _/1 ])), then

            1. (Let [tableKeyIR_lpm] be (tableKeyIR')*{tableKeyIR' <- tableKeyIR'*})

              1. (Let (typedExpressionIR '#' _nameIR ':' t _annotationList ';') be tableKeyIR_lpm)

                1. If ((t = "lpm")), then

                  1. (Let typeIR be $type_of_typedExpressionIR(typedExpressionIR))

                    1. (Let typeIR' be $unroll_aliasType(typeIR))

                      1. If ((typeIR' has type integerTypeIR)), then

                        1. (Let integerTypeIR be (typeIR' as integerTypeIR))

                          1. (Let (nat)?{nat <- nat?} be $width_of_integerTypeIR(integerTypeIR))

                            1. If (((nat)?{nat <- nat?} matches pattern (_))), then

                              1. (Let ?(n) be (nat)?{nat <- nat?})

                                1. Return TBLC[MODE = (LPM n)]

                            1. Else Dangling#4463

                      1. Else Dangling#4460

                1. Else Dangling#4457

          1. Else Dangling#4454

        2. If (~$exists_((b_lpm)*{b_lpm <- b_lpm*})), then

          1. Return TBLC[MODE = (NONE)]

        2. Else Dangling#4466

def $find_action(TBLC, prefixedNameIR)

1. Return $find_action'(TBLC.ACTIONS, prefixedNameIR)

def $find_action'((matchAction)*{matchAction <- matchAction*}, prefixedNameIR)

1. Case analysis on (matchAction)*{matchAction <- matchAction*}

  1. Case (% matches pattern [])

