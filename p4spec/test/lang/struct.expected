      1. (Let (header typeId < (typeArgumentIR)* >{ ((annotationList typeIR_field nameIR_field ;))* }) be headerTypeIR)

        1. (Let typeArgumentIR_subst be $subst_typeIR'(theta, typeArgumentIR))*

          1. (Let typeIR_field_subst be $subst_typeIR'(theta, typeIR_field))*

            1. (Let headerTypeIR_subst be (header typeId < (typeArgumentIR_subst)* >{ ((annotationList typeIR_field_subst nameIR_field ;))* }))

              1. Return (headerTypeIR_subst as typeIR)

  10. Case (% has type headerUnionTypeIR)

    1. (Let headerUnionTypeIR be (typeIR as headerUnionTypeIR))

      1. (Let (header_union typeId < (typeArgumentIR)* >{ ((annotationList typeIR_field nameIR_field ;))* }) be headerUnionTypeIR)

        1. (Let typeArgumentIR_subst be $subst_typeIR'(theta, typeArgumentIR))*

          1. (Let typeIR_field_subst be $subst_typeIR'(theta, typeIR_field))*

            1. (Let headerUnionTypeIR_subst be (header_union typeId < (typeArgumentIR_subst)* >{ ((annotationList typeIR_field_subst nameIR_field ;))* }))

              1. Return (headerUnionTypeIR_subst as typeIR)

  11. Case (% has type simpleEnumTypeIR)

    1. (Let (enum typeId { (id_field)* }) be (typeIR as simpleEnumTypeIR))

      1. Return ((enum typeId { (id_field)* }) as typeIR)

  12. Case (% has type serializableEnumTypeIR)

    1. (Let (enum typeId < typeIR' >{ (valueFieldIR)* }) be (typeIR as serializableEnumTypeIR))

      1. (Let typeIR_subst be $subst_typeIR'(theta, typeIR'))

        1. Return ((enum typeId < typeIR_subst >{ (valueFieldIR)* }) as typeIR)

  13. Case (% has type externObjectTypeIR)

    1. (Let externObjectTypeIR be (typeIR as externObjectTypeIR))

      1. (Let (extern typeId < (typeArgumentIR)* > ({ ((callableId : externMethodTypeDefIR))* })) be externObjectTypeIR)

        1. (Let typeArgumentIR_subst be $subst_typeIR'(theta, typeArgumentIR))*

          1. (Let callableTypeDefIR be $subst_callableTypeDefIR(theta, (externMethodTypeDefIR as callableTypeDefIR)))*

            1. If ((callableTypeDefIR has type externMethodTypeDefIR))*, then

              1. (Let externMethodTypeDefIR_subst be (callableTypeDefIR as externMethodTypeDefIR))*

                1. (Let externObjectTypeIR_subst be (extern typeId < (typeArgumentIR_subst)* > ({ ((callableId : externMethodTypeDefIR_subst))* })))

