  5. Case (% has type headerUnionTypeDefIR)

    1. (Let (HEADER_UNION typeId `< (typeParameterIR)*{typeParameterIR <- typeParameterIR*} `> `{ (fieldTypeIR)*{fieldTypeIR <- fieldTypeIR*} `}) be (typeDefIR as headerUnionTypeDefIR))

