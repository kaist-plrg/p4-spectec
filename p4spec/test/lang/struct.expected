              1. Else Dangling#8092

def $reduce_serenum(typedExpressionIR)

1. (Let typeIR be $type_of_typedExpressionIR(typedExpressionIR))

  1. (Let ctk be $ctk_of_typedExpressionIR(typedExpressionIR))

    1. (Let typeIR' be $unroll_typeIR(typeIR))

      1. If ((typeIR' has type serializableEnumTypeIR)), then

        1. (Let (ENUM _typeId `< typeIR_underlying `> `{ (_valueFieldIR)*{_valueFieldIR <- _valueFieldIR*} `}) be (typeIR' as serializableEnumTypeIR))

          1. (Let typedExpressionIR_reduced be (((`( typeIR_underlying `) typedExpressionIR) as expressionIR) '#' (`( typeIR_underlying ctk `))))

            1. Return typedExpressionIR_reduced

2. Otherwise,

  1. Return typedExpressionIR

def $reduce_serenum_unary(typedExpressionIR, $check(typeIR) : bool)

1. (Let (_expressionIR '#' (`( typeIR ctk `))) be typedExpressionIR)

  1. Case analysis on $check(typeIR)

    1. Case true

      1. Return ?(typedExpressionIR)

    2. Case false

      1. (Let typeIR' be $unroll_typeIR(typeIR))

        1. If ((typeIR' has type serializableEnumTypeIR)), then

          1. (Let (ENUM _typeId `< typeIR_underlying `> `{ (_valueFieldIR)*{_valueFieldIR <- _valueFieldIR*} `}) be (typeIR' as serializableEnumTypeIR))

            1. (Let typedExpressionIR_cast be (((`( typeIR_underlying `) typedExpressionIR) as expressionIR) '#' (`( typeIR_underlying ctk `))))

              1. Return $reduce_serenum_unary(typedExpressionIR_cast, $check)

2. Otherwise,

  1. Return ?()

def $reduce_serenum_binary(typedExpressionIR_l, typedExpressionIR_r, $check(typeIR, typeIR') : bool)

1. (Let (_expressionIR '#' (`( typeIR_l ctk `))) be typedExpressionIR_l)

  1. (Let (_expressionIR' '#' (`( typeIR_r _ctk `))) be typedExpressionIR_r)

    1. Case analysis on $check(typeIR_l, typeIR_r)

      1. Case true

        1. Return ?((typedExpressionIR_l, typedExpressionIR_r))

      2. Case false

        1. (Let typeIR be $unroll_typeIR(typeIR_l))

          1. If ((typeIR has type serializableEnumTypeIR)), then

            1. (Let (ENUM _typeId `< typeIR_l_underlying `> `{ (_valueFieldIR)*{_valueFieldIR <- _valueFieldIR*} `}) be (typeIR as serializableEnumTypeIR))

              1. (Let typedExpressionIR_l_cast be (((`( typeIR_l_underlying `) typedExpressionIR_l) as expressionIR) '#' (`( typeIR_l_underlying ctk `))))

                1. Return $reduce_serenum_binary(typedExpressionIR_l_cast, typedExpressionIR_r, $check)

        2. If (~($unroll_typeIR(typeIR_l) has type serializableEnumTypeIR)), then

          1. (Let typeIR be $unroll_typeIR(typeIR_r))

            1. If ((typeIR has type serializableEnumTypeIR)), then

              1. (Let (ENUM _typeId `< typeIR_r_underlying `> `{ (_valueFieldIR)*{_valueFieldIR <- _valueFieldIR*} `}) be (typeIR as serializableEnumTypeIR))

                1. (Let typedExpressionIR_r_cast be (((`( typeIR_r_underlying `) typedExpressionIR_r) as expressionIR) '#' (`( typeIR_r_underlying _ctk `))))

                  1. Return $reduce_serenum_binary(typedExpressionIR_l, typedExpressionIR_r_cast, $check)

2. Otherwise,

  1. Return ?()

def $cast_unary(typedExpressionIR, typeIR_to)

1. (Let (_expressionIR '#' (`( typeIR ctk `))) be typedExpressionIR)

  1. If (Type_alpha: typeIR ~~ typeIR_to) holds, then

    1. Return ?(typedExpressionIR)

  1. Else,

    1. If (Cast_impl: typeIR -> typeIR_to) holds, then

      1. (Let typedExpressionIR_cast be (((`( typeIR_to `) typedExpressionIR) as expressionIR) '#' (`( typeIR_to ctk `))))

        1. Return ?(typedExpressionIR_cast)

2. Otherwise,

  1. Return ?()

def $cast_binary(typedExpressionIR_l, typedExpressionIR_r)

1. (Let (_expressionIR '#' (`( typeIR_l ctk `))) be typedExpressionIR_l)

  1. (Let (_expressionIR' '#' (`( typeIR_r _ctk `))) be typedExpressionIR_r)

    1. If (Type_alpha: typeIR_l ~~ typeIR_r) holds, then

      1. Return ?((typedExpressionIR_l, typedExpressionIR_r))

    1. Else,

      1. If (Cast_impl: typeIR_l -> typeIR_r) holds, then

        1. (Let typedExpressionIR_l_cast be (((`( typeIR_r `) typedExpressionIR_l) as expressionIR) '#' (`( typeIR_r ctk `))))

          1. Return ?((typedExpressionIR_l_cast, typedExpressionIR_r))

      1. Else,

        1. If (Cast_impl: typeIR_r -> typeIR_l) holds, then

          1. (Let typedExpressionIR_r_cast be (((`( typeIR_l `) typedExpressionIR_r) as expressionIR) '#' (`( typeIR_l _ctk `))))

            1. Return ?((typedExpressionIR_l, typedExpressionIR_r_cast))

        1. Else,

          1. (Let typedExpressionIR_l_cast be $reduce_serenum(typedExpressionIR_l))

            1. If ((typedExpressionIR_l =/= typedExpressionIR_l_cast)), then

              1. Return $cast_binary(typedExpressionIR_l_cast, typedExpressionIR_r)

            2. If ((typedExpressionIR_l = typedExpressionIR_l_cast)), then

              1. (Let typedExpressionIR_r_cast be $reduce_serenum(typedExpressionIR_r))

                1. If ((typedExpressionIR_r =/= typedExpressionIR_r_cast)), then

                  1. Return $cast_binary(typedExpressionIR_l, typedExpressionIR_r_cast)

2. Otherwise,

  1. Return ?()

tbl def $compat_lnot(typeIR'')
=

  Row : ((BOOL) as typeIR) -> true:

    1. If ((typeIR'' has type boolTypeIR)), then

      1. (Let boolTypeIR be (typeIR'' as boolTypeIR))

        1. Return true

  Row : ((TYPEDEF _typeId typeIR) as typeIR) -> $compat_lnot(typeIR):

    1. If ((typeIR'' has type typedefTypeIR)), then

      1. (Let (TYPEDEF _typeId typeIR) be (typeIR'' as typedefTypeIR))

        1. Return $compat_lnot(typeIR)

  Row : _typeIR -> false:

    1. Return false

tbl def $compat_bnot(typeIR'')
