def $is_lpm_key((_typedExpressionIR # _nameIR : nameIR _annotationList ;))

1. Return $is_lpm_key'(nameIR)

def $is_lpm_key'(text)

1. If ((text = "lpm")), then

  1. Return true

2. Otherwise,

  1. Return false

def $requires_priority((_typedExpressionIR # _nameIR : nameIR _annotationList ;))

1. Return $requires_priority'(nameIR)

def $requires_priority'(text)

1. Case analysis on text

  1. Case (% = "range")

    1. Return true

  2. Case (% = "ternary")

    1. Return true

  3. Case (% = "optional")

    1. Return true

2. Otherwise,

  1. Return false

def $update_mode_tbl(TBLC, (tableKeyIR)*)

1. (Let b_pri be $requires_priority(tableKeyIR))*

  1. Case analysis on $exists_((b_pri)*)

    1. Case true

      1. Return TBLC[mode = (pri)]

    2. Case false

      1. (Let b_lpm be $is_lpm_key(tableKeyIR))*

        1. (Let (tableKeyIR')* be $filter_<tableKeyIR>((tableKeyIR)*, (b_lpm)*))

          1. If (((tableKeyIR')* matches pattern [ _/1 ])), then

            1. (Let [tableKeyIR_lpm] be (tableKeyIR')*)

              1. (Let (typedExpressionIR # _nameIR : text _annotationList ;) be tableKeyIR_lpm)

                1. If ((text = "lpm")), then

                  1. (Let typeIR be $type_of_typedExpressionIR(typedExpressionIR))

                    1. (Let typeIR' be $unroll_aliasType(typeIR))

                      1. If ((typeIR' has type integerTypeIR)), then

                        1. (Let integerTypeIR be (typeIR' as integerTypeIR))

                          1. (Let (nat)? be $width_of_integerTypeIR(integerTypeIR))

                            1. If (((nat)? matches pattern (_))), then

                              1. (Let ?(n) be (nat)?)

                                1. Return TBLC[mode = (lpm n)]

                            1. Else Phantom#516

                      1. Else Phantom#517

                1. Else Phantom#518

          1. Else Phantom#519

        2. If (~$exists_((b_lpm)*)), then

          1. Return TBLC[mode = (none)]

        2. Else Phantom#520

