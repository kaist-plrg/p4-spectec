relation Inst_ok: p TC instctxt |- constructorTypeIR `< (typeArgumentIR)*{typeArgumentIR <- typeArgumentIR*} '#' (typeId_infer)*{typeId_infer <- typeId_infer*} `> `( (argumentIR)*{argumentIR <- argumentIR*} '#' (id_default)*{id_default <- id_default*} '#' (id_optional)*{id_optional <- id_optional*} `) : % `< % `> `( % `)

1. (Let (CONSTRUCTOR `( (parameterIR)*{parameterIR <- parameterIR*} `) ':' typeIR_object) be constructorTypeIR)

