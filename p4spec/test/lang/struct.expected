  3. Case (% has type structTypeDefIR)

    1. (Let (STRUCT typeId `< (typeParameterIR)*{typeParameterIR <- typeParameterIR*} `> `{ (fieldTypeIR)*{fieldTypeIR <- fieldTypeIR*} `}) be (typeDefIR as structTypeDefIR))

      1. Return ((STRUCT typeId `< (((_NAME typeParameterIR) as typeIR))*{typeParameterIR <- typeParameterIR*} `> `{ (fieldTypeIR)*{fieldTypeIR <- fieldTypeIR*} `}) as typeIR)

  4. Case (% has type headerTypeDefIR)

    1. (Let (HEADER typeId `< (typeParameterIR)*{typeParameterIR <- typeParameterIR*} `> `{ (fieldTypeIR)*{fieldTypeIR <- fieldTypeIR*} `}) be (typeDefIR as headerTypeDefIR))

