    1. If ((prefixedNameIR matches pattern `` %`)), then

      1. (Let (` id) be prefixedNameIR)

        1. (Let frame be EC.GLOBAL.FRAME)

          1. If ($in_set<id>(id, $dom_map<id, value>(frame))), then

            1. (Let frame' be $update_map<id, value>(frame, id, value))

