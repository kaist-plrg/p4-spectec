      1. Return object'

  1. Else Phantom#1468

syntax globalInstLayer = {constructor constructorDefEnv, type typeDefEnv, callable callableDefEnv, frame frame}

syntax blockInstLayer = {type theta, callable callableDefEnv, state stateEnv, frame frame}

syntax localInstLayer = {type theta, frames frame*}

syntax instContext = {path objectId, global globalInstLayer, block blockInstLayer, local localInstLayer}

def $empty_instContext

1. (Let globalInstLayer be {constructor $empty_constructorDefEnv, type $empty_typeDefEnv, callable $empty_callableDefEnv, frame $empty_frame})

  1. (Let blockInstLayer be {type $empty_theta, callable $empty_callableDefEnv, state $empty_stateEnv, frame $empty_frame})

    1. (Let localInstLayer be {type $empty_theta, frames [$empty_frame]})

      1. (Let IC be {path [], global globalInstLayer, block blockInstLayer, local localInstLayer})

        1. Return IC

def $enter_i(IC)

1. Return IC[local.frames = $empty_frame :: IC.local.frames]

def $exit_i(IC)

1. (Let (frame)* be IC.local.frames)

  1. If (((frame)* matches pattern _ :: _)), then

    1. (Let frame_h :: (frame_t)* be (frame)*)

      1. Return IC[local.frames = (frame_t)*]

  1. Else Phantom#1469

def $enter_path_i(IC, id)

1. Return IC[path = IC.path ++ [id]]

def $inherit_i(cursor, IC)

1. Case analysis on cursor

  1. Case (% matches pattern `GLOBAL`)

    1. (Let blockInstLayer be {type $empty_theta, callable $empty_callableDefEnv, state $empty_stateEnv, frame $empty_frame})

      1. (Let localInstLayer be {type $empty_theta, frames [$empty_frame]})

        1. Return IC[block = blockInstLayer][local = localInstLayer]

  2. Case (% matches pattern `BLOCK`)

    1. (Let localInstLayer be {type $empty_theta, frames [$empty_frame]})

      1. Return IC[local = localInstLayer]

  3. Case (% matches pattern `LOCAL`)

    1. Return IC

def $add_var_i(cursor, IC, id, value)

1. Case analysis on cursor

  1. Case (% matches pattern `GLOBAL`)

    1. If (~$in_set<id>(id, $dom_map<id, value>(IC.global.frame))), then

      1. (Let frame be $add_map<id, value>(IC.global.frame, id, value))

        1. Return IC[global.frame = frame]

    1. Else Phantom#1470

  2. Case (% matches pattern `BLOCK`)

    1. If (~$in_set<id>(id, $dom_map<id, value>(IC.block.frame))), then

      1. (Let frame be $add_map<id, value>(IC.block.frame, id, value))

        1. Return IC[block.frame = frame]

    1. Else Phantom#1471

  3. Case (% matches pattern `LOCAL`)

    1. (Let (frame)* be IC.local.frames)

      1. If (((frame)* matches pattern _ :: _)), then

        1. (Let frame_h :: (frame_t)* be (frame)*)

          1. If (~$in_set<id>(id, $dom_map<id, value>(frame_h))), then

            1. (Let frame_h' be $add_map<id, value>(frame_h, id, value))

              1. Return IC[local.frames = frame_h' :: (frame_t)*]

          1. Else Phantom#1472

      1. Else Phantom#1473

def $add_vars_i(p, IC, (id)*, (value)*)

1. Case analysis on (id)*

  1. Case (% matches pattern [])

    1. If (((value)* matches pattern [])), then

      1. Return IC

    1. Else Phantom#1474

  2. Case (% matches pattern _ :: _)

    1. (Let id_h :: (id_t)* be (id)*)

      1. If (((value)* matches pattern _ :: _)), then

        1. (Let value_h :: (value_t)* be (value)*)

          1. (Let IC' be $add_var_i(p, IC, id_h, value_h))

            1. (Let IC'' be $add_vars_i(p, IC', (id_t)*, (value_t)*))

              1. Return IC''

      1. Else Phantom#1475

def $add_typeDef_i(cursor, IC, typeId, typeDefIR)

1. If ((cursor matches pattern `GLOBAL`)), then

  1. (Let typeDefEnv be $add_map<typeId, typeDefIR>(IC.global.type, typeId, typeDefIR))

    1. Return IC[global.type = typeDefEnv]

1. Else Phantom#1476

def $add_parserState_i(IC, nameIR, parserStateIR)

1. If (~$in_set<nameIR>(nameIR, $dom_map<nameIR, parserStateIR>(IC.block.state))), then

  1. (Let stateEnv be $add_map<nameIR, parserStateIR>(IC.block.state, nameIR, parserStateIR))

    1. Return IC[block.state = stateEnv]

1. Else Phantom#1477

def $add_type_i(cursor, IC, typeId, typeIR)

1. Case analysis on cursor

  1. Case (% matches pattern `BLOCK`)

    1. (Let theta be $add_map<typeId, typeIR>(IC.block.type, typeId, typeIR))

      1. Return IC[block.type = theta]

  2. Case (% matches pattern `LOCAL`)

    1. (Let theta be $add_map<typeId, typeIR>(IC.local.type, typeId, typeIR))

      1. Return IC[local.type = theta]

1. Else Phantom#1478

def $add_types_i(p, IC, (typeId)*, (typeIR)*)

1. Case analysis on (typeId)*

  1. Case (% matches pattern [])

    1. If (((typeIR)* matches pattern [])), then

      1. Return IC

    1. Else Phantom#1479

  2. Case (% matches pattern _ :: _)

    1. (Let typeId_h :: (typeId_t)* be (typeId)*)

      1. If (((typeIR)* matches pattern _ :: _)), then

        1. (Let typeIR_h :: (typeIR_t)* be (typeIR)*)

          1. (Let IC' be $add_type_i(p, IC, typeId_h, typeIR_h))

            1. Return $add_types_i(p, IC', (typeId_t)*, (typeIR_t)*)

      1. Else Phantom#1480

def $add_callableDef_overload_i(cursor, IC, callableId, callableDef)

1. Case analysis on cursor

  1. Case (% matches pattern `GLOBAL`)

    1. If (~$in_set<callableId>(callableId, $dom_map<callableId, callableDef>(IC.global.callable))), then

      1. (Let callableDefEnv be $add_map<callableId, callableDef>(IC.global.callable, callableId, callableDef))

        1. Return IC[global.callable = callableDefEnv]

    1. Else Phantom#1481

  2. Case (% matches pattern `BLOCK`)

    1. If (~$in_set<callableId>(callableId, $dom_map<callableId, callableDef>(IC.block.callable))), then

      1. (Let callableDefEnv be $add_map<callableId, callableDef>(IC.block.callable, callableId, callableDef))

        1. Return IC[block.callable = callableDefEnv]

    1. Else Phantom#1482

1. Else Phantom#1483

def $add_callableDef_non_overload_i(cursor, IC, callableId, callableDef)

1. Case analysis on cursor

  1. Case (% matches pattern `GLOBAL`)

    1. (Let (id ( (_id)* )) be callableId)

      1. (Let ({ ((id_k ( (_id')* )))* }) be $dom_map<callableId, callableDef>(IC.global.callable))

        1. If (~$in_set<id>(id, ({ (id_k)* }))), then

          1. (Let callableDefEnv be $add_map<callableId, callableDef>(IC.global.callable, callableId, callableDef))

            1. Return IC[global.callable = callableDefEnv]

        1. Else Phantom#1484

  2. Case (% matches pattern `BLOCK`)

    1. (Let (id ( (_id)* )) be callableId)

      1. (Let ({ ((id_k ( (_id')* )))* }) be $dom_map<callableId, callableDef>(IC.block.callable))

        1. If (~$in_set<id>(id, ({ (id_k)* }))), then

          1. (Let callableDefEnv be $add_map<callableId, callableDef>(IC.block.callable, callableId, callableDef))

            1. Return IC[block.callable = callableDefEnv]

        1. Else Phantom#1485

1. Else Phantom#1486

def $find_callableDef_non_overload_i(p, IC, prefixedNameIR)

1. If ((prefixedNameIR matches pattern `.%`)), then

  1. (Let (. nameIR) be prefixedNameIR)

    1. If ((?() = $find_non_overloaded<callableDef>(IC.global.callable, nameIR))), then

      1. Return ?()

    1. Else Phantom#1487

    2. (Let ((callableId, callableDef))? be $find_non_overloaded<callableDef>(IC.global.callable, nameIR))

      1. If ((((callableId, callableDef))? matches pattern (_))), then

        1. (Let ?((callableId, callableDef)) be ((callableId, callableDef))?)

          1. Return ?(((global), callableId, callableDef))

      1. Else Phantom#1488

1. Else Phantom#1489

2. Case analysis on p

  1. Case (% matches pattern `GLOBAL`)

    1. If ((prefixedNameIR matches pattern ``%`)), then

      1. (Let (` nameIR) be prefixedNameIR)

        1. Return $find_callableDef_non_overload_i((global), IC, (. nameIR))

    1. Else Phantom#1490

  2. Case (% matches pattern `BLOCK`)

    1. If ((prefixedNameIR matches pattern ``%`)), then

      1. (Let (` nameIR) be prefixedNameIR)

        1. (Let ((callableId, callableDef))? be $find_non_overloaded<callableDef>(IC.block.callable, nameIR))

          1. If ((((callableId, callableDef))? matches pattern (_))), then

            1. (Let ?((callableId, callableDef)) be ((callableId, callableDef))?)

              1. Return ?(((block), callableId, callableDef))

          1. Else Phantom#1491

        2. If ((?() = $find_non_overloaded<callableDef>(IC.block.callable, nameIR))), then

          1. Return $find_callableDef_non_overload_i((global), IC, (` nameIR))

        2. Else Phantom#1492

    1. Else Phantom#1493

  3. Case (% matches pattern `LOCAL`)

    1. If ((prefixedNameIR matches pattern ``%`)), then

      1. (Let (` nameIR) be prefixedNameIR)

        1. Return $find_callableDef_non_overload_i((block), IC, (` nameIR))

    1. Else Phantom#1494

def $add_constructorDef_i(IC, callableId, constructorDef)

1. (Let constructorDefEnv be $add_map<callableId, constructorDef>(IC.global.constructor, callableId, constructorDef))

  1. Return IC[global.constructor = constructorDefEnv]

def $add_constructorDefs_i(IC, (callableId)*, (constructorDef)*)

1. Case analysis on (callableId)*

  1. Case (% matches pattern [])

    1. If (((constructorDef)* matches pattern [])), then

      1. Return IC

    1. Else Phantom#1495

  2. Case (% matches pattern _ :: _)

    1. (Let callableId_h :: (callableId_t)* be (callableId)*)

      1. If (((constructorDef)* matches pattern _ :: _)), then

        1. (Let constructorDef_h :: (constructorDef_t)* be (constructorDef)*)

          1. (Let IC' be $add_constructorDef_i(IC, callableId_h, constructorDef_h))

            1. (Let IC'' be $add_constructorDefs_i(IC', (callableId_t)*, (constructorDef_t)*))

              1. Return IC''

      1. Else Phantom#1496

def $find_var_i(prefixedNameIR, p, IC)

1. Case analysis on prefixedNameIR

  1. Case (% matches pattern `.%`)

    1. (Let (. id) be prefixedNameIR)

      1. (Let (value)? be $find_map<id, value>(IC.global.frame, id))

        1. If (((value)? matches pattern (_))), then

          1. (Let ?(value') be (value)?)

            1. Return value'

        1. Else Phantom#1497

  2. Case (% matches pattern ``%`)

    1. (Let (` id) be prefixedNameIR)

      1. Case analysis on p

        1. Case (% matches pattern `GLOBAL`)

          1. (Let (value)? be $find_map<id, value>(IC.global.frame, id))

            1. If (((value)? matches pattern (_))), then

              1. (Let ?(value') be (value)?)

                1. Return value'

            1. Else Phantom#1498

        2. Case (% matches pattern `BLOCK`)

          1. (Let (value)? be $find_map<id, value>(IC.block.frame, id))

            1. If (((value)? matches pattern (_))), then

              1. (Let ?(value') be (value)?)

                1. Return value'

            1. Else Phantom#1499

          2. If ((?() = $find_map<id, value>(IC.block.frame, id))), then

            1. Return $find_var_i((` id), (global), IC)

          2. Else Phantom#1500

        3. Case (% matches pattern `LOCAL`)

          1. (Let (value)? be $find_maps<id, value>(IC.local.frames, id))

            1. If (((value)? matches pattern (_))), then

              1. (Let ?(value') be (value)?)

                1. Return value'

            1. Else Phantom#1501

          2. If ((?() = $find_maps<id, value>(IC.local.frames, id))), then

            1. Return $find_var_i((` id), (block), IC)

          2. Else Phantom#1502

def $find_typeDef_i(_cursor, IC, prefixedNameIR)

1. Case analysis on prefixedNameIR

  1. Case (% matches pattern ``%`)

    1. (Let (` nameIR) be prefixedNameIR)

      1. Return $find_map<typeId, typeDefIR>(IC.global.type, nameIR)

  2. Case (% matches pattern `.%`)

    1. (Let (. nameIR) be prefixedNameIR)

      1. Return $find_map<typeId, typeDefIR>(IC.global.type, nameIR)

def $find_constructorDef_i(IC, prefixedNameIR, (argumentIR)*)

1. Case analysis on prefixedNameIR

  1. Case (% matches pattern ``%`)

    1. (Let (` nameIR) be prefixedNameIR)

      1. (Let callTargetKey be $callTargetKey(nameIR, (argumentIR)*))

        1. Return $find_overloaded<constructorDef>(IC.global.constructor, callTargetKey, $parameterListIR_of_constructorDef)

  2. Case (% matches pattern `.%`)

    1. (Let (. nameIR) be prefixedNameIR)

      1. (Let callTargetKey be $callTargetKey(nameIR, (argumentIR)*))

        1. Return $find_overloaded<constructorDef>(IC.global.constructor, callTargetKey, $parameterListIR_of_constructorDef)

def $subst_type_i(cursor, IC, typeIR)

1. Case analysis on cursor

  1. Case (% matches pattern `GLOBAL`)

    1. Return typeIR

  2. Case (% matches pattern `BLOCK`)

    1. (Let theta be IC.block.type)

      1. (Let typeIR_subst be $subst_typeIR(theta, typeIR))

        1. Return typeIR_subst

  3. Case (% matches pattern `LOCAL`)

    1. (Let theta_block be IC.block.type)

      1. (Let theta_local be IC.local.type)

        1. (Let theta be $extend_map<typeId, typeIR>(theta_block, theta_local))

          1. (Let typeIR_subst be $subst_typeIR(theta, typeIR))

            1. Return typeIR_subst

relation Expr_inst: p IC STO |- (expressionIR # expressionNoteIR) : % %

1. Group literalExpressionIR: p IC STO |- (expressionIR # expressionNoteIR) : % %

  1. Case analysis on expressionIR

    1. Case (% has type booleanLiteral)

      1. (Let booleanLiteral be (expressionIR as booleanLiteral))

        1. (Let boolValue be $ite<boolValue>((booleanLiteral = (true)), (`b true), (`b false)))

          1. Result in: % % % |- % : STO (boolValue as value)

    2. Case (% has type integerLiteral)

      1. (Let integerLiteral be (expressionIR as integerLiteral))

        1. Result in: % % % |- % : STO (integerLiteral as value)

    3. Case (% has type stringLiteral)

      1. (Let stringLiteral be (expressionIR as stringLiteral))

        1. Result in: % % % |- % : STO (stringLiteral as value)

  1. Else Phantom#1503

2. Case analysis on expressionIR

  1. Case (% has type prefixedNameIR)

    1. (Let prefixedNameIR be (expressionIR as prefixedNameIR))

      1. Group referenceExpressionIR: p IC STO |- ((prefixedNameIR as expressionIR) # expressionNoteIR) : % %

        1. (Let value be $find_var_i(prefixedNameIR, p, IC))

          1. Result in: % % % |- % : STO value

  2. Case (% has type defaultExpression)

    1. (Let defaultExpression be (expressionIR as defaultExpression))

      1. Group defaultExpressionIR: p IC STO |- (((...) as expressionIR) # expressionNoteIR) : % %

        1. Result in: % % % |- % : STO ((default) as value)

  3. Case (% has type unaryExpressionIR)

    1. (Let (unop typedExpressionIR) be (expressionIR as unaryExpressionIR))

      1. Group unaryExpressionIR: p IC STO |- (((unop typedExpressionIR) as expressionIR) # expressionNoteIR) : % %

        1. (Expr_inst: p IC STO |- typedExpressionIR : STO_1 value)

          1. Result in: % % % |- % : STO_1 $un_op(unop, value)

  4. Case (% has type binaryExpressionIR)

    1. (Let (typedExpressionIR_l binop typedExpressionIR_r) be (expressionIR as binaryExpressionIR))

      1. Group binaryExpressionIR: p IC STO |- (((typedExpressionIR_l binop typedExpressionIR_r) as expressionIR) # expressionNoteIR) : % %

        1. If (~binop is in [(&&), (||)]), then

          1. (Expr_inst: p IC STO |- typedExpressionIR_l : STO_1 value_l)

            1. (Expr_inst: p IC STO_1 |- typedExpressionIR_r : STO_2 value_r)

              1. Result in: % % % |- % : STO_2 $bin_op(binop, value_l, value_r)

        1. Else Phantom#1504

        2. Case analysis on binop

          1. Case (% matches pattern `&&`)

            1. (Expr_inst: p IC STO |- typedExpressionIR_l : STO_1 value)

              1. Case analysis on value

                1. Case (% = ((`b false) as value))

                  1. Result in: % % % |- % : STO_1 ((`b false) as value)

                2. Case (% = ((`b true) as value))

                  1. (Expr_inst: p IC STO_1 |- typedExpressionIR_r : STO_2 value_r)

                    1. Result in: % % % |- % : STO_2 value_r

              1. Else Phantom#1505

          2. Case (% matches pattern `||`)

            1. (Expr_inst: p IC STO |- typedExpressionIR_l : STO_1 value)

              1. Case analysis on value

                1. Case (% = ((`b true) as value))

                  1. Result in: % % % |- % : STO_1 ((`b true) as value)

                2. Case (% = ((`b false) as value))

                  1. (Expr_inst: p IC STO_1 |- typedExpressionIR_r : STO_2 value_r)

                    1. Result in: % % % |- % : STO_2 value_r

              1. Else Phantom#1506

        2. Else Phantom#1507

  5. Case (% has type ternaryExpressionIR)

    1. (Let (typedExpressionIR_cond ? typedExpressionIR_true : typedExpressionIR_false) be (expressionIR as ternaryExpressionIR))

      1. Group ternaryExpressionIR: p IC STO |- (((typedExpressionIR_cond ? typedExpressionIR_true : typedExpressionIR_false) as expressionIR) # expressionNoteIR) : % %

        1. (Expr_inst: p IC STO |- typedExpressionIR_cond : STO_1 value)

          1. Case analysis on value

            1. Case (% = ((`b true) as value))

              1. (Expr_inst: p IC STO_1 |- typedExpressionIR_true : STO_2 value_true)

                1. Result in: % % % |- % : STO_2 value_true

            2. Case (% = ((`b false) as value))

              1. (Expr_inst: p IC STO_1 |- typedExpressionIR_false : STO_2 value_false)

                1. Result in: % % % |- % : STO_2 value_false

          1. Else Phantom#1508

  6. Case (% has type castExpressionIR)

    1. (Let (( typeIR ) typedExpressionIR) be (expressionIR as castExpressionIR))

      1. Group castExpressionIR: p IC STO |- (((( typeIR ) typedExpressionIR) as expressionIR) # expressionNoteIR) : % %

        1. (Expr_inst: p IC STO |- typedExpressionIR : STO_1 value)

          1. (Let value_cast be $cast_op(typeIR, value))

            1. Result in: % % % |- % : STO_1 value_cast

  7. Case (% has type invalidHeaderExpression)

    1. (Let invalidHeaderExpression be (expressionIR as invalidHeaderExpression))

      1. Group invalidHeaderExpressionIR: p IC STO |- ((({#}) as expressionIR) # expressionNoteIR) : % %

        1. Result in: % % % |- % : STO (({#}) as value)

  8. Case (% has type sequenceExpressionIR)

    1. (Let sequenceExpressionIR be (expressionIR as sequenceExpressionIR))

      1. Group sequenceExpressionIR: p IC STO |- ((sequenceExpressionIR as expressionIR) # expressionNoteIR) : % %

        1. Case analysis on sequenceExpressionIR

          1. Case (% matches pattern `SEQ{%}`)

            1. (Let (seq{ typedExpressionListIR }) be sequenceExpressionIR)

              1. (Exprs_inst: p IC STO |- typedExpressionListIR : STO_1 (value)*)

                1. Result in: % % % |- % : STO_1 ((seq( (value)* )) as value)

          2. Case (% matches pattern `SEQ{%,...}`)

            1. (Let (seq{ typedExpressionListIR ,...}) be sequenceExpressionIR)

              1. (Exprs_inst: p IC STO |- typedExpressionListIR : STO_1 (value)*)

                1. Result in: % % % |- % : STO_1 ((seq( (value)* ,...)) as value)

  9. Case (% has type recordExpressionIR)

    1. (Let recordExpressionIR be (expressionIR as recordExpressionIR))

      1. Group recordExpressionIR: p IC STO |- ((recordExpressionIR as expressionIR) # expressionNoteIR) : % %

        1. Case analysis on recordExpressionIR

          1. Case (% matches pattern `RECORD{%}`)

            1. (Let (record{ ((nameIR = typedExpressionIR))* }) be recordExpressionIR)

              1. (Exprs_inst: p IC STO |- (typedExpressionIR)* : STO_1 (value)*)

                1. Result in: % % % |- % : STO_1 ((record{ ((value nameIR ;))* }) as value)

          2. Case (% matches pattern `RECORD{%,...}`)

            1. (Let (record{ ((nameIR = typedExpressionIR))* ,...}) be recordExpressionIR)

              1. (Exprs_inst: p IC STO |- (typedExpressionIR)* : STO_1 (value)*)

                1. Result in: % % % |- % : STO_1 ((record{ ((value nameIR ;))* ,...}) as value)

  10. Case (% has type errorAccessExpressionIR)

    1. (Let (error. nameIR) be (expressionIR as errorAccessExpressionIR))

      1. Group errorAccessExpressionIR: p IC STO |- (((error. nameIR) as expressionIR) # expressionNoteIR) : % %

        1. (Let nameIR_error be "error." ++ nameIR)

          1. (Let value_error be $find_var_i((` nameIR_error), p, IC))

            1. Result in: % % % |- % : STO value_error

  11. Case (% has type memberAccessExpressionIR)

    1. (Let (memberAccessBaseIR . nameIR) be (expressionIR as memberAccessExpressionIR))

      1. Case analysis on memberAccessBaseIR

        1. Case (% matches pattern `TYPE%`)

          1. (Let (type prefixedNameIR) be memberAccessBaseIR)

            1. Group memberAccessExpressionIR-type: p IC STO |- ((((type prefixedNameIR) . nameIR) as expressionIR) # expressionNoteIR) : % %

              1. (Let (typeDefIR)? be $find_typeDef_i(p, IC, prefixedNameIR))

                1. If (((typeDefIR)? matches pattern (_))), then

                  1. (Let ?(typeDefIR') be (typeDefIR)?)

                    1. Case analysis on typeDefIR'

                      1. Case (% has type simpleEnumTypeIR)

                        1. (Let (enum typeId { (_nameIR)* }) be (typeDefIR' as simpleEnumTypeIR))

                          1. Result in: % % % |- % : STO ((typeId . nameIR) as value)

                      2. Case (% has type serializableEnumTypeIR)

                        1. (Let (enum typeId < _typeIR >{ ((id_member = value_member ;))* }) be (typeDefIR' as serializableEnumTypeIR))

                          1. (Let (value)? be $assoc_<nameIR, value>(nameIR, ((id_member, value_member))*))

                            1. If (((value)? matches pattern (_))), then

                              1. (Let ?(value') be (value)?)

                                1. Result in: % % % |- % : STO ((typeId . nameIR . value') as value)

                            1. Else Phantom#1509

                    1. Else Phantom#1510

                1. Else Phantom#1511

        2. Case (% has type typedExpressionIR)

          1. (Let typedExpressionIR_base be (memberAccessBaseIR as typedExpressionIR))

            1. Group memberAccessExpressionIR-typedExpressionIR: p IC STO |- ((((typedExpressionIR_base as memberAccessBaseIR) . nameIR) as expressionIR) # expressionNoteIR) : % %

              1. (Let typeIR_base be $type_of_typedExpressionIR(typedExpressionIR_base))

                1. (Let typeIR be $unroll_typeIR(typeIR_base))

                  1. If ((typeIR has type headerStackTypeIR)), then

                    1. (Let (_typeIR [ n_size ]) be (typeIR as headerStackTypeIR))

                      1. If ((nameIR = "size")), then

                        1. Result in: % % % |- % : STO ((d (n_size as int)) as value)

                      1. Else Phantom#1512

                  1. Else Phantom#1513

              2. (Expr_inst: p IC STO |- typedExpressionIR_base : STO_1 value)

                1. Case analysis on value

                  1. Case (% has type structValue)

                    1. (Let structValue be (value as structValue))

                      1. (Let (struct _typeId { ((value_field id_field ;))* }) be structValue)

                        1. (Let (value')? be $assoc_<id, value>(nameIR, ((id_field, value_field))*))

                          1. If (((value')? matches pattern (_))), then

                            1. (Let ?(value'') be (value')?)

                              1. Result in: % % % |- % : STO_1 value''

                          1. Else Phantom#1514

                  2. Case (% has type headerValue)

                    1. (Let headerValue be (value as headerValue))

                      1. (Let (header _typeId { _bool ; ((value_field id_field ;))* }) be headerValue)

                        1. (Let (value')? be $assoc_<id, value>(nameIR, ((id_field, value_field))*))

                          1. If (((value')? matches pattern (_))), then

                            1. (Let ?(value'') be (value')?)

                              1. Result in: % % % |- % : STO_1 value''

                          1. Else Phantom#1515

                  3. Case (% has type headerUnionValue)

                    1. (Let headerUnionValue be (value as headerUnionValue))

                      1. (Let (header_union _typeId { ((value_field id_field ;))* }) be headerUnionValue)

                        1. (Let (value')? be $assoc_<id, value>(nameIR, ((id_field, value_field))*))

