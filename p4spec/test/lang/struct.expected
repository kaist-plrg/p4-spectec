  1. (Let argumentIR_packet_in be $PSA_setup_egress_packet_in_argument(EC_0))

    1. (Let argumentIR_hdr be $PSA_setup_egress_hdr_argument(ARCH_0))

      1. (Let argumentIR_user_meta be $PSA_setup_egress_user_meta_argument(ARCH_0))

