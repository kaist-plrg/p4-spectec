syntax infer = 
   | KNOWN AS typeIR (from infer) 
   | UNKNOWN (from infer) 

syntax constraint = map<typeId, infer>

def $empty_constraint((typeId)*)

1. Return ({ ((typeId : (UNKNOWN)))* })

syntax inference = map<typeId, typeIR>

def $infer((typeId)*, (parameterIR)*, (argumentIR)*)

1. If (((typeId)* matches pattern [])), then

  1. Return $empty_map<typeId, typeIR>

1. Else Dangling#8108

2. If (((typeId)* =/= [])), then

  1. (Let constraint_init be $empty_constraint((typeId)*))

    1. If ((|(argumentIR)*| = |(parameterIR)*|)), then

      1. (Let constraint_pair be $infer'(constraint_init, parameterIR, argumentIR))*

        1. (Let constraint_inferred be $merge_constraints(constraint_init, (constraint_pair)*))

          1. (Let inference be $resolve_constraint(constraint_inferred))

            1. (Let inference_resolved be $resolve_inference(inference))

              1. Return inference_resolved

    1. Else Dangling#8112

2. Else Dangling#8110

def $infer'(constraint, parameterIR, argumentIR)

1. Case analysis on argumentIR

  1. Case (% has type typedExpressionIR)

    1. (Let typedExpressionIR be (argumentIR as typedExpressionIR))

      1. (Let (_annotationList _direction typeIR_param _id _parameterInitializerOptIR) be parameterIR)

        1. (Let typeIR_arg be $type_of_typedExpressionIR(typedExpressionIR))

          1. Return $gen_constraint(constraint, typeIR_param, typeIR_arg)

  2. Case (% matches pattern `% = %`)

    1. (Let (nameIR = typedExpressionIR) be argumentIR)

      1. (Let (_annotationList _direction typeIR_param _id _parameterInitializerOptIR) be parameterIR)

        1. (Let typeIR_arg be $type_of_typedExpressionIR(typedExpressionIR))

          1. Return $gen_constraint(constraint, typeIR_param, typeIR_arg)

  3. Case (% matches pattern `% = _`)

    1. Return constraint

  4. Case (% matches pattern `_`)

    1. Return constraint

def $resolve_inference(({ ((typeId : typeIR))* }))

1. (Let typeIR_resolved be $resolve_inference'(typeIR))*

  1. If ((|(typeIR_resolved)*| = |(typeId)*|)), then

    1. Return ({ ((typeId : typeIR_resolved))* })

  1. Else Dangling#8130

def $resolve_inference'(typeIR)

1. (Let typeIR' be $unroll_typeIR(typeIR))

  1. If ((typeIR' has type sequenceTypeIR)), then

    1. (Let sequenceTypeIR be (typeIR' as sequenceTypeIR))

      1. If ((sequenceTypeIR matches pattern `SEQ <%>`)), then

        1. (Let (SEQ < (typeIR_arg)* >) be sequenceTypeIR)

          1. (Let typeIR_resolved be ((TUPLE < (typeIR_arg)* >) as typeIR))

            1. Return typeIR_resolved

2. Otherwise,

  1. Return typeIR

def $gen_constraint(constraint, typeIR, typeIR_arg)

1. Case analysis on typeIR

  1. Case (% has type nameTypeIR)

    1. (Let (` typeId_param) be (typeIR as nameTypeIR))

      1. If ($in_set<typeId>(typeId_param, $dom_map<typeId, infer>(constraint))), then

        1. Return $update_map<typeId, infer>(constraint, typeId_param, (KNOWN AS typeIR_arg))

  2. Case (% has type typedefTypeIR)

    1. (Let (TYPEDEF _typeId typeIR_param) be (typeIR as typedefTypeIR))

      1. Return $gen_constraint(constraint, typeIR_param, typeIR_arg)

  3. Case (% has type newTypeIR)

    1. (Let (TYPE typeId typeIR_param) be (typeIR as newTypeIR))

      1. If ((typeIR_arg has type newTypeIR)), then

        1. (Let (TYPE typeId' typeIR_arg') be (typeIR_arg as newTypeIR))

