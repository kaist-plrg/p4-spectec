  1. (Eval_keysets_simple: EC_0 ARCH_0 |- simpleKeysetExpressionListIR : EC_1 ARCH_1 keysetExpressionResult)

    1. Result in: % % |- % : EC_1 ARCH_1 keysetExpressionResult

relation Argument_eval: p EC_0 ARCH_0 |- argumentIR : % % %

1. Case analysis on argumentIR

  1. Case (% has type typedExpressionIR)

    1. (Let typedExpressionIR be (argumentIR as typedExpressionIR))

      1. (Expr_eval: p EC_0 ARCH_0 |- typedExpressionIR : EC_1 ARCH_1 expressionResult)

        1. Result in: % % % |- % : EC_1 ARCH_1 expressionResult

  2. Case (% matches pattern `% = %`)

    1. (Let (nameIR '=' typedExpressionIR) be argumentIR)

      1. (Expr_eval: p EC_0 ARCH_0 |- typedExpressionIR : EC_1 ARCH_1 expressionResult)

        1. Result in: % % % |- % : EC_1 ARCH_1 expressionResult

1. Else Dangling#11008

syntax storageReferenceResult = 
   | _CONT storageReference? (from continueResult<storageReference?>) 
   | EXIT (from exitResult) 
   | REJECT errorValue (from rejectTransitionResult) 

relation Argument_eval_lvalue: p EC ARCH |- argumentIR : % % %

1. Case analysis on argumentIR

  1. Case (% has type typedExpressionIR)

    1. (Let typedExpressionIR be (argumentIR as typedExpressionIR))

      1. (Let (typedLvalueIR')?{typedLvalueIR' <- typedLvalueIR'?} be $typedExpressionIR_as_typedLvalueIR(typedExpressionIR))

        1. If (((typedLvalueIR')?{typedLvalueIR' <- typedLvalueIR'?} matches pattern (_))), then

          1. (Let ?(typedLvalueIR) be (typedLvalueIR')?{typedLvalueIR' <- typedLvalueIR'?})

            1. (Lvalue_eval: p EC ARCH |- typedLvalueIR : EC_1 ARCH_1 storageReferenceResult)

              1. Result in: % % % |- % : EC_1 ARCH_1 storageReferenceResult

        1. Else Dangling#11018

  2. Case (% matches pattern `% = %`)

    1. (Let (nameIR '=' typedExpressionIR) be argumentIR)

      1. (Let (typedLvalueIR')?{typedLvalueIR' <- typedLvalueIR'?} be $typedExpressionIR_as_typedLvalueIR(typedExpressionIR))

        1. If (((typedLvalueIR')?{typedLvalueIR' <- typedLvalueIR'?} matches pattern (_))), then

          1. (Let ?(typedLvalueIR) be (typedLvalueIR')?{typedLvalueIR' <- typedLvalueIR'?})

            1. (Lvalue_eval: p EC ARCH |- typedLvalueIR : EC_1 ARCH_1 storageReferenceResult)

              1. Result in: % % % |- % : EC_1 ARCH_1 storageReferenceResult

        1. Else Dangling#11024

  3. Case (% matches pattern `% = _`)

    1. Result in: % % % |- % : EC ARCH ((_CONT ?()) as storageReferenceResult)

  4. Case (% matches pattern `_`)

    1. Result in: % % % |- % : EC ARCH ((_CONT ?()) as storageReferenceResult)

relation Lvalue_eval: p EC ARCH |- (lvalueIR '#' _lvalueNoteIR) : % % %

1. Case analysis on lvalueIR

  1. Case (% has type referenceExpressionIR)

    1. (Let referenceExpressionIR be (lvalueIR as referenceExpressionIR))

      1. Result in: % % % |- % : EC ARCH ((_CONT ?((referenceExpressionIR as storageReference))) as storageReferenceResult)

  2. Case (% matches pattern `% . %`)

    1. (Let (typedLvalueIR '.' nameIR) be lvalueIR)

      1. (Lvalue_eval: p EC ARCH |- typedLvalueIR : EC_1 ARCH_1 storageReferenceResult')

        1. Case analysis on storageReferenceResult'

          1. Case (% has type abortResult)

            1. (Let abortResult be (storageReferenceResult' as abortResult))

              1. Result in: % % % |- % : EC_1 ARCH_1 (abortResult as storageReferenceResult)

          2. Case (% has type continueResult<storageReference?>)

            1. (Let (_CONT (storageReference')?{storageReference' <- storageReference'?}) be (storageReferenceResult' as continueResult<storageReference?>))

              1. If (((storageReference')?{storageReference' <- storageReference'?} matches pattern (_))), then

                1. (Let ?(storageReference) be (storageReference')?{storageReference' <- storageReference'?})

                  1. (Lvalue_read: p EC_1 ARCH_1 |- storageReference : value)

                    1. Case analysis on (value has type headerStackValue)

                      1. Case true

                        1. (Let headerStackValue be (value as headerStackValue))

                          1. (Let (HEADER_STACK `[ (value_element)*{value_element <- value_element*} `( n_idx `) `]) be headerStackValue)

                            1. If ((nameIR = "next")), then

                              1. (Let n_size be |(value_element)*{value_element <- value_element*}|)

                                1. If ((n_idx >= n_size)), then

                                  1. (Let rejectTransitionResult be (REJECT (ERROR '.' "StackOutOfBounds")))

                                    1. Result in: % % % |- % : EC_1 ARCH_1 (rejectTransitionResult as storageReferenceResult)

                                1. Else Dangling#11047

                            1. Else Dangling#11045

                            2. (Let n_size be |(value_element)*{value_element <- value_element*}|)

                              1. If ((nameIR = "next")), then

                                1. If ((n_idx < n_size)), then

                                  1. (Let storageReferenceResult be ((_CONT ?((storageReference '.' nameIR))) as storageReferenceResult))

                                    1. Result in: % % % |- % : EC_1 ARCH_1 storageReferenceResult

                                1. Else Dangling#11052

                              1. Else Dangling#11051

                            3. If ((nameIR = "last")), then

                              1. (Let n_size be |(value_element)*{value_element <- value_element*}|)

                                1. If (((n_idx < 1) \/ (n_idx > n_size))), then

                                  1. (Let rejectTransitionResult be (REJECT (ERROR '.' "StackOutOfBounds")))

                                    1. Result in: % % % |- % : EC_1 ARCH_1 (rejectTransitionResult as storageReferenceResult)

                                1. Else Dangling#11057

                            3. Else Dangling#11055

                            4. (Let n_size be |(value_element)*{value_element <- value_element*}|)

                              1. If ((nameIR = "last")), then

                                1. If (~((n_idx < 1) \/ (n_idx > n_size))), then

                                  1. (Let storageReferenceResult be ((_CONT ?((storageReference '.' nameIR))) as storageReferenceResult))

                                    1. Result in: % % % |- % : EC_1 ARCH_1 storageReferenceResult

                                1. Else Dangling#11062

                              1. Else Dangling#11061

                      2. Case false

                        1. (Let storageReferenceResult be ((_CONT ?((storageReference '.' nameIR))) as storageReferenceResult))

                          1. Result in: % % % |- % : EC_1 ARCH_1 storageReferenceResult

              1. Else Dangling#11039

  3. Case (% matches pattern `% [%]`)

    1. (Let (typedLvalueIR `[ typedExpressionIR `]) be lvalueIR)

      1. (Lvalue_eval: p EC ARCH |- typedLvalueIR : EC_1 ARCH_1 storageReferenceResult')

        1. Case analysis on storageReferenceResult'

          1. Case (% has type abortResult)

            1. (Let abortResult be (storageReferenceResult' as abortResult))

              1. Result in: % % % |- % : EC_1 ARCH_1 (abortResult as storageReferenceResult)

          2. Case (% has type continueResult<storageReference?>)

            1. (Let (_CONT (storageReference')?{storageReference' <- storageReference'?}) be (storageReferenceResult' as continueResult<storageReference?>))

              1. If (((storageReference')?{storageReference' <- storageReference'?} matches pattern (_))), then

                1. (Let ?(storageReference) be (storageReference')?{storageReference' <- storageReference'?})

                  1. (Expr_eval: p EC_1 ARCH_1 |- typedExpressionIR : EC_2 ARCH_2 expressionResult)

                    1. Case analysis on expressionResult

                      1. Case (% has type abortResult)

                        1. (Let abortResult be (expressionResult as abortResult))

                          1. Result in: % % % |- % : EC_2 ARCH_2 (abortResult as storageReferenceResult)

                      2. Case (% has type continueResult<value>)

                        1. (Let (_CONT value) be (expressionResult as continueResult<value>))

                          1. If ((value has type integerValue)), then

                            1. (Let integerValue_index be (value as integerValue))

                              1. (Let storageReferenceResult be ((_CONT ?((storageReference `[ (integerValue_index as value) `]))) as storageReferenceResult))

                                1. Result in: % % % |- % : EC_2 ARCH_2 storageReferenceResult

                          1. Else Dangling#11080

              1. Else Dangling#11073

  4. Case (% matches pattern `% [% % %]`)

    1. (Let (typedLvalueIR `[ typedExpressionIR_l sliceop typedExpressionIR_r `]) be lvalueIR)

      1. (Lvalue_eval: p EC ARCH |- typedLvalueIR : EC_1 ARCH_1 storageReferenceResult')

        1. Case analysis on storageReferenceResult'

          1. Case (% has type abortResult)

            1. (Let abortResult be (storageReferenceResult' as abortResult))

              1. Result in: % % % |- % : EC_1 ARCH_1 (abortResult as storageReferenceResult)

          2. Case (% has type continueResult<storageReference?>)

            1. (Let (_CONT (storageReference')?{storageReference' <- storageReference'?}) be (storageReferenceResult' as continueResult<storageReference?>))

              1. If (((storageReference')?{storageReference' <- storageReference'?} matches pattern (_))), then

                1. (Let ?(storageReference) be (storageReference')?{storageReference' <- storageReference'?})

                  1. (Exprs_eval: p EC_1 ARCH_1 |- [typedExpressionIR_l, typedExpressionIR_r] : EC_2 ARCH_2 expressionListResult)

                    1. Case analysis on expressionListResult

                      1. Case (% has type abortResult)

                        1. (Let abortResult be (expressionListResult as abortResult))

                          1. Result in: % % % |- % : EC_2 ARCH_2 (abortResult as storageReferenceResult)

                      2. Case (% has type continueResult<value*>)

                        1. (Let (_CONT (value)*{value <- value*}) be (expressionListResult as continueResult<value*>))

                          1. If (((value)*{value <- value*} matches pattern [ _/2 ])), then

                            1. (Let [value_l, value_r] be (value)*{value <- value*})

                              1. (Let storageReferenceResult be ((_CONT ?((storageReference `[ value_l sliceop value_r `]))) as storageReferenceResult))

                                1. Result in: % % % |- % : EC_1 ARCH_1 storageReferenceResult

                          1. Else Dangling#11097

              1. Else Dangling#11090

  5. Case (% matches pattern `(%)`)

    1. (Let (`( typedLvalueIR `)) be lvalueIR)

      1. (Lvalue_eval: p EC ARCH |- typedLvalueIR : EC_1 ARCH_1 storageReferenceResult)

        1. Result in: % % % |- % : EC_1 ARCH_1 storageReferenceResult

relation Lvalue_read: p EC ARCH |- storageReference' : %

1. Case analysis on storageReference'

  1. Case (% has type prefixedNameIR)

    1. (Let prefixedNameIR be (storageReference' as prefixedNameIR))

      1. (Let value be $find_var_e(prefixedNameIR, p, EC))

        1. Result in: % % % |- % : value

  2. Case (% matches pattern `% . %`)

    1. (Let (storageReference '.' nameIR) be storageReference')

      1. (Lvalue_read: p EC ARCH |- storageReference : value_base)

        1. Case analysis on value_base

          1. Case (% has type objectReferenceValue)

            1. (Let (REF objectId) be (value_base as objectReferenceValue))

              1. (Let (object')?{object' <- object'?} be $find_object_e(ARCH, objectId))

                1. If (((object')?{object' <- object'?} matches pattern (_))), then

                  1. (Let ?(object) be (object')?{object' <- object'?})

                    1. If ((object has type packageObject)), then

                      1. (Let (PACKAGE `< _theta `> `{ frame `}) be (object as packageObject))

                        1. (Let (value')?{value' <- value'?} be $find_map<nameIR, value>(frame, nameIR))

                          1. If (((value')?{value' <- value'?} matches pattern (_))), then

                            1. (Let ?(value) be (value')?{value' <- value'?})

                              1. Result in: % % % |- % : value

                          1. Else Dangling#11118

                    1. Else Dangling#11115

                1. Else Dangling#11113

          2. Case (% has type headerStackValue)

            1. (Let headerStackValue_base be (value_base as headerStackValue))

              1. (Let (HEADER_STACK `[ (value_element)*{value_element <- value_element*} `( n_idx `) `]) be headerStackValue_base)

                1. Case analysis on nameIR

                  1. Case (% = "next")

                    1. (Let n_size be |(value_element)*{value_element <- value_element*}|)

                      1. If ((n_idx < n_size)), then

                        1. If ((n_idx < |(value_element)*{value_element <- value_element*}|)), then

                          1. (Let value be (value_element)*{value_element <- value_element*}[n_idx])

                            1. Result in: % % % |- % : value

                        1. Else Dangling#11126

                      1. Else Dangling#11125

                  2. Case (% = "last")

                    1. (Let n_size be |(value_element)*{value_element <- value_element*}|)

                      1. If (~((n_idx < 1) \/ (n_idx > n_size))), then

                        1. (Let i be (n_idx - 1))

                          1. If ((i has type nat)), then

                            1. (Let n_idx_last be (i as nat))

                              1. If ((n_idx_last < |(value_element)*{value_element <- value_element*}|)), then

                                1. (Let value be (value_element)*{value_element <- value_element*}[n_idx_last])

                                  1. Result in: % % % |- % : value

                              1. Else Dangling#11134

                          1. Else Dangling#11132

                      1. Else Dangling#11130

                1. Else Dangling#11123

          3. Case (% has type structValue)

            1. (Let structValue_base be (value_base as structValue))

              1. (Let (STRUCT _typeId `{ ((value_field nameIR_field ';'))*{nameIR_field <- nameIR_field*, value_field <- value_field*} `}) be structValue_base)

                1. (Let (value')?{value' <- value'?} be $assoc_<id, value>(nameIR, ((nameIR_field, value_field))*{nameIR_field <- nameIR_field*, value_field <- value_field*}))

                  1. If (((value')?{value' <- value'?} matches pattern (_))), then

                    1. (Let ?(value) be (value')?{value' <- value'?})

                      1. Result in: % % % |- % : value

                  1. Else Dangling#11140

          4. Case (% has type headerValue)

            1. (Let headerValue_base be (value_base as headerValue))

              1. (Let (HEADER _typeId `{ _b ';' ((value_field nameIR_field ';'))*{nameIR_field <- nameIR_field*, value_field <- value_field*} `}) be headerValue_base)

                1. (Let (value')?{value' <- value'?} be $assoc_<id, value>(nameIR, ((nameIR_field, value_field))*{nameIR_field <- nameIR_field*, value_field <- value_field*}))

                  1. If (((value')?{value' <- value'?} matches pattern (_))), then

                    1. (Let ?(value) be (value')?{value' <- value'?})

                      1. Result in: % % % |- % : value

                  1. Else Dangling#11146

          5. Case (% has type headerUnionValue)

            1. (Let headerUnionValue_base be (value_base as headerUnionValue))

              1. (Let (HEADER_UNION _typeId `{ ((value_field nameIR_field ';'))*{nameIR_field <- nameIR_field*, value_field <- value_field*} `}) be headerUnionValue_base)

                1. (Let (value')?{value' <- value'?} be $assoc_<id, value>(nameIR, ((nameIR_field, value_field))*{nameIR_field <- nameIR_field*, value_field <- value_field*}))

                  1. If (((value')?{value' <- value'?} matches pattern (_))), then

                    1. (Let ?(value) be (value')?{value' <- value'?})

                      1. Result in: % % % |- % : value

                  1. Else Dangling#11152

        1. Else Dangling#11110

  3. Case (% matches pattern `% [%]`)

    1. (Let (storageReference `[ value' `]) be storageReference')

      1. If ((value' has type integerValue)), then

        1. (Let integerValue_index be (value' as integerValue))

          1. (Lvalue_read: p EC ARCH |- storageReference : value'')

            1. Case analysis on value''

              1. Case (% has type arrayValue)

                1. (Let arrayValue_base be (value'' as arrayValue))

                  1. (Let (ARRAY `[ (value_element)*{value_element <- value_element*} `]) be arrayValue_base)

                    1. (Let n_size be |(value_element)*{value_element <- value_element*}|)

                      1. (Let i_idx be $int_of_integerValue(integerValue_index))

                        1. (Let b_in_bounds be ((i_idx < (n_size as int)) /\ (i_idx >= (0 as int))))

                          1. Case analysis on b_in_bounds

                            1. Case true

                              1. If ((i_idx has type nat)), then

                                1. (Let n_idx be (i_idx as nat))

                                  1. If ((n_idx < |(value_element)*{value_element <- value_element*}|)), then

                                    1. (Let value be (value_element)*{value_element <- value_element*}[n_idx])

                                      1. Result in: % % % |- % : value

                                  1. Else Dangling#11168

                              1. Else Dangling#11166

                            2. Case false

                              1. If ((0 < |(value_element)*{value_element <- value_element*}|)), then

                                1. (Let value''' be (value_element)*{value_element <- value_element*}[0])

                                  1. If ((value''' has type headerValue)), then

                                    1. (Let (HEADER typeId `{ b_valid ';' (fieldValue)*{fieldValue <- fieldValue*} `}) be (value''' as headerValue))

                                      1. (Let value be ((HEADER typeId `{ false ';' (fieldValue)*{fieldValue <- fieldValue*} `}) as value))

                                        1. Result in: % % % |- % : value

                                  1. Else Dangling#11173

                              1. Else Dangling#11171

              2. Case (% has type headerStackValue)

                1. (Let headerStackValue_base be (value'' as headerStackValue))

                  1. (Let (HEADER_STACK `[ (value_element)*{value_element <- value_element*} `( _nat `) `]) be headerStackValue_base)

                    1. (Let n_size be |(value_element)*{value_element <- value_element*}|)

                      1. (Let i_idx be $int_of_integerValue(integerValue_index))

                        1. (Let b_in_bounds be ((i_idx < (n_size as int)) /\ (i_idx >= (0 as int))))

                          1. Case analysis on b_in_bounds

                            1. Case true

                              1. If ((i_idx has type nat)), then

                                1. (Let n_idx be (i_idx as nat))

                                  1. If ((n_idx < |(value_element)*{value_element <- value_element*}|)), then

                                    1. (Let value be (value_element)*{value_element <- value_element*}[n_idx])

                                      1. Result in: % % % |- % : value

                                  1. Else Dangling#11185

                              1. Else Dangling#11183

                            2. Case false

                              1. If ((0 < |(value_element)*{value_element <- value_element*}|)), then

                                1. (Let value''' be (value_element)*{value_element <- value_element*}[0])

                                  1. If ((value''' has type headerValue)), then

                                    1. (Let (HEADER typeId `{ b_valid ';' (fieldValue)*{fieldValue <- fieldValue*} `}) be (value''' as headerValue))

                                      1. (Let value be ((HEADER typeId `{ false ';' (fieldValue)*{fieldValue <- fieldValue*} `}) as value))

                                        1. Result in: % % % |- % : value

                                  1. Else Dangling#11190

                              1. Else Dangling#11188

            1. Else Dangling#11159

      1. Else Dangling#11156

  4. Case (% matches pattern `% [% % %]`)

    1. (Let (storageReference `[ value' sliceop value'' `]) be storageReference')

      1. Case analysis on sliceop

        1. Case (% matches pattern `:`)

          1. (Lvalue_read: p EC ARCH |- storageReference : value_base)

            1. (Let value be $bitacc_range_op(value_base, value', value''))

              1. Result in: % % % |- % : value

        2. Case (% matches pattern `+:`)

          1. (Lvalue_read: p EC ARCH |- storageReference : value_base)

            1. (Let value be $bitacc_offset_op(value_base, value', value''))

              1. Result in: % % % |- % : value

relation Lvalue_write: p EC_0 ARCH |- storageReference' := value : %

1. Case analysis on storageReference'

  1. Case (% has type prefixedNameIR)

    1. (Let prefixedNameIR be (storageReference' as prefixedNameIR))

      1. (Let EC_1 be $update_var_e(p, EC_0, prefixedNameIR, value))

        1. Result in: % % % |- % := % : EC_1

  2. Case (% matches pattern `% . %`)

    1. (Let (storageReference '.' nameIR) be storageReference')

      1. (Lvalue_read: p EC_0 ARCH |- storageReference : value')

        1. Case analysis on value'

          1. Case (% has type headerStackValue)

            1. (Let headerStackValue_base be (value' as headerStackValue))

              1. (Let (HEADER_STACK `[ (value_element)*{value_element <- value_element*} `( n_idx `) `]) be headerStackValue_base)

                1. Case analysis on nameIR

                  1. Case (% = "next")

                    1. (Let (value_element_update)*{value_element_update <- value_element_update*} be (value_element)*{value_element <- value_element*}[[n_idx] = value])

                      1. (Let headerStackValue_base_update be (HEADER_STACK `[ (value_element_update)*{value_element_update <- value_element_update*} `( (n_idx + 1) `) `]))

                        1. (Lvalue_write: p EC_0 ARCH |- storageReference := (headerStackValue_base_update as value) : EC_1)

                          1. Result in: % % % |- % := % : EC_1

                  2. Case (% = "last")

                    1. (Let i be (n_idx - 1))

                      1. If ((i has type nat)), then

                        1. (Let n_idx_last be (i as nat))

                          1. (Let (value_element_update)*{value_element_update <- value_element_update*} be (value_element)*{value_element <- value_element*}[[n_idx_last] = value])

                            1. (Let headerStackValue_base_update be (HEADER_STACK `[ (value_element_update)*{value_element_update <- value_element_update*} `( n_idx `) `]))

                              1. (Lvalue_write: p EC_0 ARCH |- storageReference := (headerStackValue_base_update as value) : EC_1)

                                1. Result in: % % % |- % := % : EC_1

                      1. Else Dangling#11217

                1. Else Dangling#11211

          2. Case (% has type structValue)

            1. (Let structValue_base be (value' as structValue))

              1. (Let (STRUCT typeId `{ (fieldValue)*{fieldValue <- fieldValue*} `}) be structValue_base)

                1. (Let (fieldValue_update)*{fieldValue_update <- fieldValue_update*} be $update_fieldValue((fieldValue)*{fieldValue <- fieldValue*}, nameIR, value))

                  1. (Let structValue_base_update be (STRUCT typeId `{ (fieldValue_update)*{fieldValue_update <- fieldValue_update*} `}))

                    1. (Lvalue_write: p EC_0 ARCH |- storageReference := (structValue_base_update as value) : EC_1)

                      1. Result in: % % % |- % := % : EC_1

          3. Case (% has type headerValue)

            1. (Let headerValue_base be (value' as headerValue))

              1. (Let (HEADER typeId `{ b_valid ';' (fieldValue)*{fieldValue <- fieldValue*} `}) be headerValue_base)

                1. (Let (fieldValue_update)*{fieldValue_update <- fieldValue_update*} be $update_fieldValue((fieldValue)*{fieldValue <- fieldValue*}, nameIR, value))

                  1. (Let headerValue_base_update be (HEADER typeId `{ b_valid ';' (fieldValue_update)*{fieldValue_update <- fieldValue_update*} `}))

                    1. (Lvalue_write: p EC_0 ARCH |- storageReference := (headerValue_base_update as value) : EC_1)

                      1. Result in: % % % |- % := % : EC_1

          4. Case (% has type headerUnionValue)

            1. (Let headerUnionValue_base be (value' as headerUnionValue))

              1. (Let (HEADER_UNION typeId `{ (fieldValue)*{fieldValue <- fieldValue*} `}) be headerUnionValue_base)

                1. (Let ((value_field nameIR_field ';'))*{nameIR_field <- nameIR_field*, value_field <- value_field*} be (fieldValue)*{fieldValue <- fieldValue*})

                  1. (Let (value'')?{value'' <- value''?} be $assoc_<nameIR, value>(nameIR, ((nameIR_field, value_field))*{nameIR_field <- nameIR_field*, value_field <- value_field*}))

                    1. If (((value'')?{value'' <- value''?} matches pattern (_))), then

                      1. (Let ?(value_old) be (value'')?{value'' <- value''?})

                        1. If ((value_old has type headerValue)), then

                          1. (Let (HEADER _typeId `{ b_valid_old ';' (_fieldValue)*{_fieldValue <- _fieldValue*} `}) be (value_old as headerValue))

                            1. (Let (fieldValue_update)*{fieldValue_update <- fieldValue_update*} be $update_fieldValue((fieldValue)*{fieldValue <- fieldValue*}, nameIR, value))

                              1. If ((value has type headerValue)), then

                                1. (Let (HEADER _typeId' `{ b_valid_new ';' (_fieldValue')*{_fieldValue' <- _fieldValue'*} `}) be (value as headerValue))

                                  1. (Let b_toggled be ((~b_valid_old /\ b_valid_new) \/ (b_valid_old /\ ~b_valid_new)))

                                    1. Case analysis on b_toggled

                                      1. Case false

                                        1. (Let headerUnionValue_base_update be (HEADER_UNION typeId `{ (fieldValue_update)*{fieldValue_update <- fieldValue_update*} `}))

                                          1. (Lvalue_write: p EC_0 ARCH |- storageReference := (headerUnionValue_base_update as value) : EC_1)

                                            1. Result in: % % % |- % := % : EC_1

                                      2. Case true

                                        1. (Let (fieldValue_update')*{fieldValue_update' <- fieldValue_update'*} be $update_headerUnion((fieldValue_update)*{fieldValue_update <- fieldValue_update*}, nameIR))

                                          1. (Let headerUnionValue_base_update be (HEADER_UNION typeId `{ (fieldValue_update')*{fieldValue_update' <- fieldValue_update'*} `}))

                                            1. (Lvalue_write: p EC_0 ARCH |- storageReference := (headerUnionValue_base_update as value) : EC_1)

                                              1. Result in: % % % |- % := % : EC_1

                              1. Else Dangling#11244

                        1. Else Dangling#11241

                    1. Else Dangling#11239

        1. Else Dangling#11208

