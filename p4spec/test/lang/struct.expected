  7. Case (% has type externDeclarationIR)

    1. (Let externDeclarationIR be (declarationIR as externDeclarationIR))

      1. Return ($lift_externDeclarationIR(externDeclarationIR) as declaration)

  8. Case (% has type parserDeclarationIR)

    1. (Let parserDeclarationIR be (declarationIR as parserDeclarationIR))

      1. Return ($lift_parserDeclarationIR(parserDeclarationIR) as declaration)

  9. Case (% has type controlDeclarationIR)

    1. (Let controlDeclarationIR be (declarationIR as controlDeclarationIR))

      1. Return ($lift_controlDeclarationIR(controlDeclarationIR) as declaration)

  10. Case (% has type typeDeclarationIR)

    1. (Let typeDeclarationIR be (declarationIR as typeDeclarationIR))

      1. Return ($lift_typeDeclarationIR(typeDeclarationIR) as declaration)

2. Otherwise,

  1. Debug: declarationIR

  2. Return $sink<declaration>

def $lift_p4programIR(((declarationIR)*{declarationIR <- declarationIR*} ';'))

1. (Let declaration be $lift_declarationIR(declarationIR))*{declarationIR <- declarationIR*, declaration -> declaration*}

