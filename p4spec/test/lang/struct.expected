def $reverse_bytes_of_hex(t)

1. If ((t[0 : 2] = "0x")), then

  1. (Let n_len be |t|)

    1. (Let int be (n_len - 2))

      1. If ((int has type nat)), then

        1. (Let n_len_bytes be (int as nat))

          1. Return "0x" ++ $reverse_bytes_of_hex'(t[2 : n_len_bytes])

      1. Else Phantom#1962

1. Else Phantom#1963

def $reverse_bytes_of_hex'(t)

1. If ((|t| <= 2)), then

  1. Return t

1. Else Phantom#1964

2. (Let n_len be |t|)

  1. If ((n_len > 2)), then

    1. (Let t_byte be t[0 : 2])

      1. (Let int be (n_len - 2))

        1. If ((int has type nat)), then

          1. (Let n_len_bytes be (int as nat))

            1. (Let t_bytes be t[2 : n_len_bytes])

              1. (Let t_bytes_rev be $reverse_bytes_of_hex'(t_bytes))

                1. Return t_bytes_rev ++ t_byte

        1. Else Phantom#1965

  1. Else Phantom#1966

