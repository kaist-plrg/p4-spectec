def $tableEntry_lpm_prefix(value)

1. Return $tableEntry_lpm_prefix'(value, 0)

def $tableEntry_lpm_prefix'(value, n_prefix)

1. If ((value has type integerLiteral)), then

  1. (Let integerLiteral be (value as integerLiteral))

    1. If ((integerLiteral matches pattern `%W%`)), then

      1. (Let (nat w _int) be integerLiteral)

        1. If ((nat = 0)), then

          1. Return n_prefix

        1. Else Phantom#539

        2. If ((_int has type nat)), then

          1. (Let n be (_int as nat))

            1. If ((nat > 0)), then

              1. (Let int be (nat - 1))

                1. If ((int has type nat)), then

                  1. (Let w be (int as nat))

                    1. If (((n \ 2) =/= 0)), then

                      1. (Let int' be ((n - 1) / (2 as int)))

                        1. If ((int' has type nat)), then

                          1. (Let n' be (int' as nat))

                            1. (Let value' be ((w w (n' as int)) as value))

                              1. Return $tableEntry_lpm_prefix'(value', (n_prefix + 1))

                        1. Else Phantom#540

                    1. Else Phantom#541

                1. Else Phantom#542

            1. Else Phantom#543

            2. If ((n_prefix = 0)), then

              1. If ((nat > 0)), then

