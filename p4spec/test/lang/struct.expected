tbl def $compat_switch(typeIR'')
=

  Row : ((ERROR) as typeIR) -> true:

    1. If ((typeIR'' has type errorTypeIR)), then

      1. (Let errorTypeIR be (typeIR'' as errorTypeIR))

        1. Return true

  Row : ((INT < _nat >) as typeIR) -> true:

    1. If ((typeIR'' has type fixedIntTypeIR)), then

      1. Return true

  Row : ((BIT < _nat >) as typeIR) -> true:

    1. If ((typeIR'' has type fixedBitTypeIR)), then

      1. Return true

  Row : ((TYPEDEF _typeId typeIR) as typeIR) -> $compat_switch(typeIR):

    1. If ((typeIR'' has type typedefTypeIR)), then

      1. (Let (TYPEDEF _typeId typeIR) be (typeIR'' as typedefTypeIR))

        1. Return $compat_switch(typeIR)

  Row : (enumTypeIR as typeIR) -> true:

    1. If ((typeIR'' has type enumTypeIR)), then

      1. Return true

  Row : _typeIR -> false:

    1. Return false

