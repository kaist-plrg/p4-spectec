def $expressionNonBrace_as_expression(expressionNonBrace)

1. Case analysis on expressionNonBrace

  1. Case (% has type literalExpression)

    1. (Let literalExpression be (expressionNonBrace as literalExpression))

      1. Return (literalExpression as expression)

  2. Case (% has type referenceExpression)

    1. (Let referenceExpression be (expressionNonBrace as referenceExpression))

      1. Return (referenceExpression as expression)

  3. Case (% has type unaryExpression)

    1. (Let unaryExpression be (expressionNonBrace as unaryExpression))

      1. Return (unaryExpression as expression)

  4. Case (% has type binaryExpressionNonBrace)

    1. (Let (expressionNonBrace_l binop expression_r) be (expressionNonBrace as binaryExpressionNonBrace))

      1. (Let expression_l be $expressionNonBrace_as_expression(expressionNonBrace_l))

        1. Return ((expression_l binop expression_r) as expression)

  5. Case (% has type ternaryExpressionNonBrace)

    1. (Let (expressionNonBrace_cond ? expression_true : expression_false) be (expressionNonBrace as ternaryExpressionNonBrace))

      1. (Let expression_cond be $expressionNonBrace_as_expression(expressionNonBrace_cond))

        1. Return ((expression_cond ? expression_true : expression_false) as expression)

  6. Case (% has type castExpression)

    1. (Let castExpression be (expressionNonBrace as castExpression))

      1. Return (castExpression as expression)

  7. Case (% has type errorAccessExpression)

    1. (Let errorAccessExpression be (expressionNonBrace as errorAccessExpression))

      1. Return (errorAccessExpression as expression)

  8. Case (% has type memberAccessExpressionNonBrace)

    1. (Let (memberAccessBaseNonBrace . member) be (expressionNonBrace as memberAccessExpressionNonBrace))

      1. Case analysis on memberAccessBaseNonBrace

        1. Case (% has type prefixedTypeName)

          1. (Let prefixedTypeName be (memberAccessBaseNonBrace as prefixedTypeName))

            1. Return (((prefixedTypeName as memberAccessBase) . member) as expression)

        2. Case (% has type expressionNonBrace)

          1. (Let expressionNonBrace_base be (memberAccessBaseNonBrace as expressionNonBrace))

            1. (Let expression_base be $expressionNonBrace_as_expression(expressionNonBrace_base))

              1. Return (((expression_base as memberAccessBase) . member) as expression)

  9. Case (% has type indexAccessExpressionNonBrace)

    1. (Let (expressionNonBrace_base [ expression_index ]) be (expressionNonBrace as indexAccessExpressionNonBrace))

      1. (Let expression_base be $expressionNonBrace_as_expression(expressionNonBrace_base))

        1. Return ((expression_base [ expression_index ]) as expression)

  10. Case (% has type sliceAccessExpressionNonBrace)

    1. (Let sliceAccessExpressionNonBrace be (expressionNonBrace as sliceAccessExpressionNonBrace))

      1. Case analysis on sliceAccessExpressionNonBrace

        1. Case (% matches pattern `%[%:%]`)

          1. (Let (expressionNonBrace_base [ expression_hi : expression_lo ]) be sliceAccessExpressionNonBrace)

            1. (Let expression_base be $expressionNonBrace_as_expression(expressionNonBrace_base))

              1. Return ((expression_base [ expression_hi : expression_lo ]) as expression)

        2. Case (% matches pattern `%[%+:%]`)

          1. (Let (expressionNonBrace_base [ expression_l +: expression_w ]) be sliceAccessExpressionNonBrace)

            1. (Let expression_base be $expressionNonBrace_as_expression(expressionNonBrace_base))

              1. Return ((expression_base [ expression_l +: expression_w ]) as expression)

  11. Case (% has type callExpressionNonBrace)

    1. (Let callExpressionNonBrace be (expressionNonBrace as callExpressionNonBrace))

      1. Case analysis on callExpressionNonBrace

        1. Case (% matches pattern `%(%)`)

          1. (Let (callTargetNonBrace ( argumentList )) be callExpressionNonBrace)

            1. Case analysis on callTargetNonBrace

              1. Case (% has type expressionNonBrace)

                1. (Let expressionNonBrace' be (callTargetNonBrace as expressionNonBrace))

                  1. (Let expression be $expressionNonBrace_as_expression(expressionNonBrace'))

                    1. Return (((expression as callTarget) ( argumentList )) as expression)

              2. Case (% has type constructorTarget)

                1. (Let constructorTarget be (callTargetNonBrace as constructorTarget))

                  1. Return (((constructorTarget as callTarget) ( argumentList )) as expression)

        2. Case (% matches pattern `%<%>(%)`)

          1. (Let (expressionNonBrace' < realTypeArgumentList >( argumentList )) be callExpressionNonBrace)

            1. (Let expression be $expressionNonBrace_as_expression(expressionNonBrace'))

              1. Return ((expression < realTypeArgumentList >( argumentList )) as expression)

  12. Case (% has type parenthesizedExpression)

    1. (Let parenthesizedExpression be (expressionNonBrace as parenthesizedExpression))

      1. Return (parenthesizedExpression as expression)

