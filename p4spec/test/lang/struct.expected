syntax matchKey = 
   | typeIR : nameIR

syntax matchAction = 
   | prefixedNameIR ( parameterIR* @ argumentListIR )

syntax matchPriority = {delta nat, largest_wins bool}

syntax matchEntries = {size nat, const bool}

syntax matchMode = 
   | none
   | lpm nat
   | pri

syntax tableContext = {keys matchKey*, actions matchAction*, priorities matchPriority, entries matchEntries, mode matchMode}

syntax tableEntryState = 
   | lpm nat
   | non_lpm

def $empty_tableContext

1. (Let matchPriority be {delta 1, largest_wins true})

  1. (Let matchEntries be {size 0, const true})

    1. Return {keys [], actions [], priorities matchPriority, entries matchEntries, mode (none)}

