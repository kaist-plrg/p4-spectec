def $tableEntry_lpm_prefix(value)

1. Return $tableEntry_lpm_prefix'(value, 0)

def $tableEntry_lpm_prefix'(value, n_prefix)

1. If ((value has type integerLiteral)), then

  1. (Let integerLiteral be (value as integerLiteral))

    1. If ((integerLiteral matches pattern `% W %`)), then

      1. (Let (nat W _i) be integerLiteral)

        1. If ((nat = 0)), then

          1. Return n_prefix

        1. Else Dangling#4551

        2. If ((_i has type nat)), then

          1. (Let n be (_i as nat))

            1. If ((nat > 0)), then

              1. (Let i be (nat - 1))

                1. If ((i has type nat)), then

                  1. (Let w be (i as nat))

                    1. If (((n \ 2) =/= 0)), then

                      1. (Let i' be ((n - 1) / (2 as int)))

                        1. If ((i' has type nat)), then

                          1. (Let n' be (i' as nat))

                            1. (Let value' be ((w W (n' as int)) as value))

                              1. Return $tableEntry_lpm_prefix'(value', (n_prefix + 1))

                        1. Else Dangling#4561

                    1. Else Dangling#4559

                1. Else Dangling#4557

            1. Else Dangling#4555

