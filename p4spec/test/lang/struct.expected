      1. Return (unaryExpression as expressionNonBrace)

  4. Case (% has type binaryExpression)

    1. (Let (expression_l binop expression_r) be (expression' as binaryExpression))

      1. (Let expressionNonBrace_l be $expression_as_expressionNonBrace(expression_l))

        1. Return ((expressionNonBrace_l binop expression_r) as expressionNonBrace)

  5. Case (% has type ternaryExpression)

    1. (Let (expression_cond '?' expression_true ':' expression_false) be (expression' as ternaryExpression))

      1. (Let expressionNonBrace_cond be $expression_as_expressionNonBrace(expression_cond))

        1. Return ((expressionNonBrace_cond '?' expression_true ':' expression_false) as expressionNonBrace)

  6. Case (% has type castExpression)

    1. (Let castExpression be (expression' as castExpression))

      1. Return (castExpression as expressionNonBrace)

  7. Case (% has type errorAccessExpression)

