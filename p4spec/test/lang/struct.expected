def $is_monomorphic_typeDefIR(typeDefIR)

1. Case analysis on typeDefIR

  1. Case (% has type nameTypeDefIR)

    1. Return true

  2. Case (% has type aliasTypeDefIR)

    1. Return true

  3. Case (% has type enumTypeDefIR)

    1. Return true

  4. Case (% has type tableObjectTypeDefIR)

    1. Return true

2. Otherwise,

  1. Return false

def $is_polymorphic_typeDefIR(typeDefIR)

1. Return ~$is_monomorphic_typeDefIR(typeDefIR)

syntax initializerIR = 
   | = typedExpressionIR (from initializerIR) 

syntax constantInitializerIR = 
   | = `VALUE value (from constantInitializerIR) 

syntax parameterInitializerIR = 
   | = typedExpressionIR (from initializerIR) 
   | = `VALUE value (from constantInitializerIR) 

syntax parameterInitializerOptIR = parameterInitializerIR?

syntax parameterIR = 
   | annotationList direction typeIR id parameterInitializerOptIR (from parameterIR)  hint(prose_fields "annotations" "direction" "type" "name" "default initializer")

syntax actionTypeIR = 
   | annotationList ACTION nameIR ( parameterIR* ) (from actionTypeIR) 

syntax definedFunctionTypeIR = 
   | FUNCTION nameIR ( parameterIR* ) : typeIR (from definedFunctionTypeIR) 

syntax externFunctionTypeIR = 
   | EXTERN_FUNCTION nameIR ( parameterIR* ) : typeIR (from externFunctionTypeIR) 

syntax functionTypeIR = 
   | FUNCTION nameIR ( parameterIR* ) : typeIR (from definedFunctionTypeIR) 
   | EXTERN_FUNCTION nameIR ( parameterIR* ) : typeIR (from externFunctionTypeIR) 

syntax builtinMethodTypeIR = 
   | BUILTIN_METHOD nameIR ( parameterIR* ) : typeIR (from builtinMethodTypeIR) 

syntax externMethodTypeIR = 
   | EXTERN_METHOD nameIR ( parameterIR* ) : typeIR (from externMethodTypeIR) 
   | EXTERN_METHOD ABSTRACT nameIR ( parameterIR* ) : typeIR (from externMethodTypeIR) 

syntax parserApplyMethodTypeIR = 
   | PARSER_APPLY ( parameterIR* ) (from parserApplyMethodTypeIR) 

syntax controlApplyMethodTypeIR = 
   | CONTROL_APPLY ( parameterIR* ) (from controlApplyMethodTypeIR) 

syntax tableApplyMethodTypeIR = 
   | TABLE_APPLY : tableMetadataStructTypeIR (from tableApplyMethodTypeIR) 

syntax methodTypeIR = 
   | BUILTIN_METHOD nameIR ( parameterIR* ) : typeIR (from builtinMethodTypeIR) 
   | EXTERN_METHOD nameIR ( parameterIR* ) : typeIR (from externMethodTypeIR) 
   | EXTERN_METHOD ABSTRACT nameIR ( parameterIR* ) : typeIR (from externMethodTypeIR) 
   | PARSER_APPLY ( parameterIR* ) (from parserApplyMethodTypeIR) 
   | CONTROL_APPLY ( parameterIR* ) (from controlApplyMethodTypeIR) 
   | TABLE_APPLY : tableMetadataStructTypeIR (from tableApplyMethodTypeIR) 

syntax callableTypeIR = 
   | annotationList ACTION nameIR ( parameterIR* ) (from actionTypeIR) 
   | FUNCTION nameIR ( parameterIR* ) : typeIR (from definedFunctionTypeIR) 
   | EXTERN_FUNCTION nameIR ( parameterIR* ) : typeIR (from externFunctionTypeIR) 
   | BUILTIN_METHOD nameIR ( parameterIR* ) : typeIR (from builtinMethodTypeIR) 
   | EXTERN_METHOD nameIR ( parameterIR* ) : typeIR (from externMethodTypeIR) 
   | EXTERN_METHOD ABSTRACT nameIR ( parameterIR* ) : typeIR (from externMethodTypeIR) 
   | PARSER_APPLY ( parameterIR* ) (from parserApplyMethodTypeIR) 
   | CONTROL_APPLY ( parameterIR* ) (from controlApplyMethodTypeIR) 
   | TABLE_APPLY : tableMetadataStructTypeIR (from tableApplyMethodTypeIR) 

def $id_of_parameterIR((_annotationList _direction _typeIR id _parameterInitializerOptIR))

1. Return id

def $is_default_parameterIR((_annotationList _direction _typeIR _id parameterInitializerOptIR))

1. (Let (parameterInitializerIR)? be parameterInitializerOptIR)

  1. If (((parameterInitializerIR)? matches pattern ())), then

    1. Return false

2. Otherwise,

  1. Return true

def $annotationList_of_parameterIR((annotationList _direction _typeIR _id _parameterInitializerOptIR))

1. Return annotationList

def $optional_annotation_of_parameterIR(parameterIR)

1. (Let annotationList be $annotationList_of_parameterIR(parameterIR))

  1. Return $optional_annotation_of_parameterIR'(annotationList)

def $optional_annotation_of_parameterIR'(annotationList)

1. (Let (annotation)* be $flatten_annotationList(annotationList))

  1. (Let b be $optional_annotation_of_parameterIR''(annotation))*

    1. Return $exists_((b)*)

def $optional_annotation_of_parameterIR''(annotation)

1. If ((annotation matches pattern `@ %`)), then

  1. (Let (@ name) be annotation)

    1. If (("optional" = $name(name))), then

      1. Return true

2. Otherwise,

  1. Return false

def $is_optional_parameterIR(parameterIR)

1. Return $optional_annotation_of_parameterIR(parameterIR)

syntax actionTypeDefIR = actionTypeIR

syntax definedFunctionTypeDefIR = 
   | FUNCTION nameIR < typeParameterIR* , typeParameterIR* > ( parameterIR* ) : typeIR (from definedFunctionTypeDefIR) 

syntax externFunctionTypeDefIR = 
   | EXTERN_FUNCTION nameIR < typeParameterIR* , typeParameterIR* > ( parameterIR* ) : typeIR (from externFunctionTypeDefIR) 

syntax functionTypeDefIR = 
   | FUNCTION nameIR < typeParameterIR* , typeParameterIR* > ( parameterIR* ) : typeIR (from definedFunctionTypeDefIR) 
   | EXTERN_FUNCTION nameIR < typeParameterIR* , typeParameterIR* > ( parameterIR* ) : typeIR (from externFunctionTypeDefIR) 

syntax externMethodTypeDefIR = 
   | EXTERN_METHOD nameIR < typeParameterIR* , typeParameterIR* > ( parameterIR* ) : typeIR (from externMethodTypeDefIR) 
   | EXTERN_METHOD ABSTRACT nameIR < typeParameterIR* , typeParameterIR* > ( parameterIR* ) : typeIR (from externMethodTypeDefIR) 

syntax parserApplyMethodTypeDefIR = parserApplyMethodTypeIR

syntax controlApplyMethodTypeDefIR = controlApplyMethodTypeIR

syntax tableApplyMethodTypeDefIR = tableApplyMethodTypeIR

syntax methodTypeDefIR = 
   | EXTERN_METHOD nameIR < typeParameterIR* , typeParameterIR* > ( parameterIR* ) : typeIR (from externMethodTypeDefIR) 
   | EXTERN_METHOD ABSTRACT nameIR < typeParameterIR* , typeParameterIR* > ( parameterIR* ) : typeIR (from externMethodTypeDefIR) 
   | PARSER_APPLY ( parameterIR* ) (from parserApplyMethodTypeIR) 
   | CONTROL_APPLY ( parameterIR* ) (from controlApplyMethodTypeIR) 
   | TABLE_APPLY : tableMetadataStructTypeIR (from tableApplyMethodTypeIR) 

syntax callableTypeDefIR = 
   | annotationList ACTION nameIR ( parameterIR* ) (from actionTypeIR) 
   | FUNCTION nameIR < typeParameterIR* , typeParameterIR* > ( parameterIR* ) : typeIR (from definedFunctionTypeDefIR) 
   | EXTERN_FUNCTION nameIR < typeParameterIR* , typeParameterIR* > ( parameterIR* ) : typeIR (from externFunctionTypeDefIR) 
   | EXTERN_METHOD nameIR < typeParameterIR* , typeParameterIR* > ( parameterIR* ) : typeIR (from externMethodTypeDefIR) 
   | EXTERN_METHOD ABSTRACT nameIR < typeParameterIR* , typeParameterIR* > ( parameterIR* ) : typeIR (from externMethodTypeDefIR) 
   | PARSER_APPLY ( parameterIR* ) (from parserApplyMethodTypeIR) 
   | CONTROL_APPLY ( parameterIR* ) (from controlApplyMethodTypeIR) 
   | TABLE_APPLY : tableMetadataStructTypeIR (from tableApplyMethodTypeIR) 

def $callableTypeIR_of_callableTypeDefIR(callableTypeDefIR)

1. Case analysis on callableTypeDefIR

  1. Case (% has type actionTypeDefIR)

    1. (Let actionTypeDefIR be (callableTypeDefIR as actionTypeDefIR))

      1. Return (actionTypeDefIR as callableTypeIR)

  2. Case (% has type definedFunctionTypeDefIR)

    1. (Let (FUNCTION nameIR < (_typeParameterIR)* , (_typeParameterIR')* > ( (parameterIR)* ) : typeIR) be (callableTypeDefIR as definedFunctionTypeDefIR))

      1. Return ((FUNCTION nameIR ( (parameterIR)* ) : typeIR) as callableTypeIR)

  3. Case (% has type externFunctionTypeDefIR)

    1. (Let (EXTERN_FUNCTION nameIR < (_typeParameterIR)* , (_typeParameterIR')* > ( (parameterIR)* ) : typeIR) be (callableTypeDefIR as externFunctionTypeDefIR))

      1. Return ((EXTERN_FUNCTION nameIR ( (parameterIR)* ) : typeIR) as callableTypeIR)

  4. Case (% has type externMethodTypeDefIR)

    1. (Let externMethodTypeDefIR be (callableTypeDefIR as externMethodTypeDefIR))

      1. Case analysis on externMethodTypeDefIR

        1. Case (% matches pattern `EXTERN_METHOD % <% , %> (%) : %`)

          1. (Let (EXTERN_METHOD nameIR < (_typeParameterIR)* , (_typeParameterIR')* > ( (parameterIR)* ) : typeIR) be externMethodTypeDefIR)

            1. Return ((EXTERN_METHOD nameIR ( (parameterIR)* ) : typeIR) as callableTypeIR)

