      1. Return ((extern_function nameIR ( (parameterIR)* ): typeIR) as callableTypeIR)

  4. Case (% has type externMethodTypeDefIR)

    1. (Let externMethodTypeDefIR be (callableTypeDefIR as externMethodTypeDefIR))

      1. Case analysis on externMethodTypeDefIR

        1. Case (% matches pattern `EXTERN_METHOD%<%,%>(%):%`)

          1. (Let (extern_method nameIR < (_typeParameterIR)* , (_typeParameterIR')* >( (parameterIR)* ): typeIR) be externMethodTypeDefIR)

            1. Return ((extern_method nameIR ( (parameterIR)* ): typeIR) as callableTypeIR)

        2. Case (% matches pattern `EXTERN_METHODABSTRACT%<%,%>(%):%`)

          1. (Let (extern_methodabstract nameIR < (_typeParameterIR)* , (_typeParameterIR')* >( (parameterIR)* ): typeIR) be externMethodTypeDefIR)

            1. Return ((extern_methodabstract nameIR ( (parameterIR)* ): typeIR) as callableTypeIR)

  5. Case (% has type parserApplyMethodTypeDefIR)

    1. (Let parserApplyMethodTypeDefIR be (callableTypeDefIR as parserApplyMethodTypeDefIR))

      1. Return (parserApplyMethodTypeDefIR as callableTypeIR)

  6. Case (% has type controlApplyMethodTypeDefIR)

    1. (Let controlApplyMethodTypeDefIR be (callableTypeDefIR as controlApplyMethodTypeDefIR))

      1. Return (controlApplyMethodTypeDefIR as callableTypeIR)

1. Else Phantom#65

