syntax nameIR = text

def $name(name)

1. Return $print_<name>(name)

def $tableCustomName(tableCustomName)

1. Return $print_<tableCustomName>(tableCustomName)

syntax id = nameIR

syntax typeId = nameIR

builtin def $fresh_typeId

def $fresh_typeIds(nat)

1. Case analysis on nat

  1. Case (% = 0)

    1. Return []

  2. Case (% =/= 0)

    1. (Let int be (nat - 1))

      1. If ((int has type nat)), then

        1. (Let n be (int as nat))

          1. Return $fresh_typeId :: $fresh_typeIds(n)

      1. Else Phantom#37

syntax callTargetId = 
   | nameIR ( id* )

syntax callableId = callTargetId

syntax constructorId = callTargetId

def $callableId(name, parameterList)

1. Return ($name(name) ( $callableId'(parameterList) ))

def $callableId'(parameterList)

1. Case analysis on parameterList

  1. Case (% matches pattern ``EMPTY`)

    1. Return []

  2. Case (% has type parameter)

    1. (Let (_annotationList _direction _type name _initializerOpt) be (parameterList as parameter))

      1. Return [$name(name)]

1. Else Phantom#38

2. If ((parameterList has type nonEmptyParameterList)), then

  1. (Let nonEmptyParameterList be (parameterList as nonEmptyParameterList))

    1. If ((nonEmptyParameterList matches pattern `%,%`)), then

      1. (Let (nonEmptyParameterList' , (_annotationList _direction _type name _initializerOpt)) be nonEmptyParameterList)

        1. Return $callableId'((nonEmptyParameterList' as parameterList)) ++ [$name(name)]

    1. Else Phantom#39

2. Else Phantom#40

def $constructorId(name, constructorParameterListOpt)

1. Case analysis on constructorParameterListOpt

  1. Case (% matches pattern ``EMPTY`)

    1. Return ($name(name) ( [] ))

  2. Case (% matches pattern `(%)`)

    1. (Let (( parameterList )) be constructorParameterListOpt)

      1. Return $callableId(name, parameterList)

syntax objectId = nameIR*

def $objectId_ends_with(objectId, nameIR)

1. (Let (nameIR')* be $rev_<id>(objectId))

  1. If (((nameIR')* matches pattern _ :: _)), then

    1. (Let nameIR'' :: (_nameIR)* be (nameIR')*)

      1. If ((nameIR'' = nameIR)), then

        1. Return true

2. Otherwise,

  1. Return false

