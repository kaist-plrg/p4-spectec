  1. If (((object)? matches pattern (_))), then

    1. (Let ?(object') be (object)?)

      1. If ((object' has type externObject)), then

        1. (Let externObject be (object' as externObject))

          1. (Let (EXTERN typeId < theta > { _objectState frame externMethodDefEnv }) be externObject)

            1. (Let externObject_update be (EXTERN typeId < theta > { objectState frame externMethodDefEnv }))

              1. (Let ARCH_1 be $add_object_e(ARCH_0, objectId, (externObject_update as object)))

                1. Return ?(ARCH_1)

2. Otherwise,

  1. Return ?()

syntax continueEmptyResult = 
   | `EMPTY (from continueEmptyResult) 

syntax continueResult<X> = 
   | ` X (from continueResult<X>) 

syntax exitResult = 
   | EXIT (from exitResult) 

syntax returnResult = 
   | RETURN value? (from returnResult) 

syntax acceptTransitionResult = 
   | ACCEPT (from acceptTransitionResult) 

syntax rejectTransitionResult = 
   | REJECT errorValue (from rejectTransitionResult) 

syntax stateTransitionResult = 
   | STATE id (from stateTransitionResult) 

syntax abortResult = 
   | EXIT (from exitResult) 
   | REJECT errorValue (from rejectTransitionResult) 

syntax expressionResult = 
   | ` value (from continueResult<value>) 
   | EXIT (from exitResult) 
   | REJECT errorValue (from rejectTransitionResult) 

relation Expr_eval: p EC ARCH |- (expressionIR # expressionNoteIR) : % % %

1. Group literalExpressionIR: p EC ARCH |- (expressionIR # expressionNoteIR) : % % %

  1. Case analysis on expressionIR

    1. Case (% has type booleanLiteral)

      1. (Let booleanLiteral be (expressionIR as booleanLiteral))

        1. (Let boolValue be $ite<boolValue>((booleanLiteral = (TRUE)), (`B true), (`B false)))

          1. (Let expressionResult be ((` (boolValue as value)) as expressionResult))

            1. Result in: % % % |- % : EC ARCH expressionResult

    2. Case (% has type integerLiteral)

      1. (Let integerLiteral be (expressionIR as integerLiteral))

        1. (Let expressionResult be ((` (integerLiteral as value)) as expressionResult))

          1. Result in: % % % |- % : EC ARCH expressionResult

    3. Case (% has type stringLiteral)

      1. (Let stringLiteral be (expressionIR as stringLiteral))

        1. (Let expressionResult be ((` (stringLiteral as value)) as expressionResult))

          1. Result in: % % % |- % : EC ARCH expressionResult

  1. Else Dangling#9770

2. Case analysis on expressionIR

  1. Case (% has type prefixedNameIR)

    1. (Let prefixedNameIR be (expressionIR as prefixedNameIR))

      1. Group referenceExpressionIR: p EC ARCH |- ((prefixedNameIR as expressionIR) # expressionNoteIR) : % % %

        1. (Let value be $find_var_e(prefixedNameIR, p, EC))

          1. (Let expressionResult be ((` value) as expressionResult))

            1. Result in: % % % |- % : EC ARCH expressionResult

  2. Case (% has type defaultExpression)

    1. (Let defaultExpression be (expressionIR as defaultExpression))

      1. Group defaultExpressionIR: p EC ARCH |- (((...) as expressionIR) # expressionNoteIR) : % % %

        1. (Let expressionResult be ((` ((DEFAULT) as value)) as expressionResult))

          1. Result in: % % % |- % : EC ARCH expressionResult

  3. Case (% has type unaryExpressionIR)

    1. (Let (unop typedExpressionIR) be (expressionIR as unaryExpressionIR))

