              1. (Let argumentIR_clone_e2e_meta be $PSA_setup_clone_e2e_meta_argument(ARCH_0))

                1. (Let (argumentIR)* be [argumentIR_packet_in, argumentIR_hdr, argumentIR_user_meta, argumentIR_parser_input_metadata, argumentIR_normal_meta, argumentIR_clone_i2e_meta, argumentIR_clone_e2e_meta])

                  1. (Let typedExpressionIR_main be $PSA_setup_main_callee(EC_0, ARCH_0))

                    1. (Let typedExpressionIR_egress_pipeline be $PSA_setup_egress_pipeline_callee(EC_0, ARCH_0, typedExpressionIR_main))

                      1. (Let typedExpressionIR_ep be $PSA_setup_egress_parser_callee(EC_0, ARCH_0, typedExpressionIR_egress_pipeline))

                        1. (Let callableTargetIR be (typedExpressionIR_ep . "apply"))

                          1. (Stmt_eval: (GLOBAL) EC_0 ARCH_0 |- ((callableTargetIR < [] > ( (argumentIR)* ) ;) as statementIR) : EC_1 ARCH_1 statementResult)

                            1. Case analysis on statementResult

                              1. Case (% has type continueEmptyResult)

                                1. (Let continueEmptyResult be (statementResult as continueEmptyResult))

                                  1. Result in: % % |- EC_1 ARCH_1 ((ACCEPT) as transitionResult)

                              2. Case (% has type rejectTransitionResult)

                                1. (Let rejectTransitionResult be (statementResult as rejectTransitionResult))

                                  1. Result in: % % |- EC_1 ARCH_1 (rejectTransitionResult as transitionResult)

                            1. Else Dangling#13277

