syntax identifier = 
   | _ID text (from identifier) 

syntax typeIdentifier = 
   | _TID text (from typeIdentifier) 

syntax nonTypeName = 
   | _ID text (from identifier) 
   | APPLY (from nonTypeName) 
   | KEY (from nonTypeName) 
