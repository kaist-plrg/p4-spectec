tbl def $compat_table_exact_optional_key(typeIR'')
=

  Row : ((BOOL) as typeIR) -> true:

    1. If ((typeIR'' has type boolTypeIR)), then

      1. (Let boolTypeIR be (typeIR'' as boolTypeIR))

        1. Return true

  Row : ((ERROR) as typeIR) -> true:

    1. If ((typeIR'' has type errorTypeIR)), then

      1. (Let errorTypeIR be (typeIR'' as errorTypeIR))

        1. Return true

  Row : (integerTypeIR as typeIR) -> true:

    1. If ((typeIR'' has type integerTypeIR)), then

      1. Return true

  Row : ((TYPEDEF _typeId typeIR) as typeIR) -> $compat_table_exact_optional_key(typeIR):

    1. If ((typeIR'' has type typedefTypeIR)), then

      1. (Let (TYPEDEF _typeId typeIR) be (typeIR'' as typedefTypeIR))

        1. Return $compat_table_exact_optional_key(typeIR)

  Row : ((TYPE _typeId typeIR) as typeIR) -> $compat_table_exact_optional_key(typeIR):

    1. If ((typeIR'' has type newTypeIR)), then

      1. (Let (TYPE _typeId typeIR) be (typeIR'' as newTypeIR))

        1. Return $compat_table_exact_optional_key(typeIR)

  Row : ((ENUM _typeId `{ (_nameIR)*{_nameIR <- _nameIR*} `}) as typeIR) -> true:

    1. If ((typeIR'' has type simpleEnumTypeIR)), then

      1. Return true

  Row : ((ENUM _typeId `< typeIR `> `{ (_valueFieldIR)*{_valueFieldIR <- _valueFieldIR*} `}) as typeIR) -> $compat_table_exact_optional_key(typeIR):

    1. If ((typeIR'' has type serializableEnumTypeIR)), then

      1. (Let (ENUM _typeId `< typeIR `> `{ (_valueFieldIR)*{_valueFieldIR <- _valueFieldIR*} `}) be (typeIR'' as serializableEnumTypeIR))

        1. Return $compat_table_exact_optional_key(typeIR)

  Row : _typeIR -> false:

    1. Return false

