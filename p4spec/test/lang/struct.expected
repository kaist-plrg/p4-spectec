  2. Case (% matches pattern _ :: _)

    1. (Let declaration_h :: (declaration_t)*{declaration_t <- declaration_t*} be (declaration)*{declaration <- declaration*})

      1. (Decl_ok: TC |- declaration_h : TC_1 declarationIR_h)

        1. (Decls_ok: TC_1 |- (declaration_t)*{declaration_t <- declaration_t*} : TC_2 (declarationIR_t)*{declarationIR_t <- declarationIR_t*})

          1. Result in: % |- % : TC_2 declarationIR_h :: (declarationIR_t)*{declarationIR_t <- declarationIR_t*}

relation Program_ok: |- p4program : %

1. (Let (declaration)*{declaration <- declaration*} be $flatten_p4program(p4program))

