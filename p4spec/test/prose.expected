              1. Let `oid` be IC_0.path ++ [nameIR]
              2. Let `STO_2` be `$add_map<oid, object>(STO_1, oid, object)`
              3. Let `IC_1` be `$add_value_inst((global), IC_0, nameIR, `(! oid)` as `value`)`
