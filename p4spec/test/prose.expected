;; ../../../../spec-concrete/2.0-domain.watsup:50.1-50.28
def $fresh_tids(nat')

1. Case analysis on `nat'`
  1. Case nat' = 0
    1. Return []

  2. Case nat' =/= 0
    1. Let `int` be nat' - 1
    2. Assert that `int` has type `nat`.
      1. Let `n'` be `int` as `nat`
      2. Return `$fresh_tid` :: `$fresh_tids(n')`

