;; ../../../../spec-concrete/7.03-instantiation-relation.watsup:142.1-145.26
relation Decls_inst: p, IC', STO', declarationIR*

1. Case analysis on `declarationIR*`
  1. Case `declarationIR*` matches pattern []
    1. Group nil: p, IC, STO, []

      1. Result in `IC'`, `STO'`, `[]`

  2. Case `declarationIR*` matches pattern _ :: _
    1. Let `declarationIR_h :: declarationIR_t*` be declarationIR*
    2. Group cons-none: p, IC_0, STO_0, declarationIR_h :: declarationIR_t*

      1. (Decl_inst: p IC' STO' |- declarationIR_h ==> IC_1 STO_1 declarationIR'?)
      2. Assert that declarationIR'? matches pattern ().
        1. (Decls_inst: p IC_1 STO_1 |- declarationIR_t* ==> IC_2 STO_2 declarationIR_t_inst*)
        2. Result in `IC_2`, `STO_2`, `declarationIR_t_inst*`
    3. Group cons-some: p, IC_0, STO_0, declarationIR_h :: declarationIR_t*

      1. (Decl_inst: p IC' STO' |- declarationIR_h ==> IC_1 STO_1 declarationIR'?)
      2. Assert that declarationIR'? matches pattern (_).
        1. Let `?(declarationIR_h_inst)` be declarationIR'?
        2. (Decls_inst: p IC_1 STO_1 |- declarationIR_t* ==> IC_2 STO_2 declarationIR_t_inst*)
        3. Result in `IC_2`, `STO_2`, `declarationIR_h_inst :: declarationIR_t_inst*`

;; ../../../../spec-concrete/7.03-instantiation-relation.watsup:147.1-149.17
relation Program_inst: p4program

1. Group : p4program

  1. (Program_ok: |- p4program : _typingContext (declarationIR* ;))
  2. Let `IC_0` be `$empty_instantiationContext`
  3. Let `STO_0` be `$empty_store`
  4. (Decls_inst: (global) IC_0 STO_0 |- declarationIR* ==> IC_1 STO_1 declarationIR'*)
  5. Assert that declarationIR'* matches pattern [].
    1. Result in `IC_1.global.cenv`, `IC_1.global.tdenv`, `IC_1.global.renv`, `IC_1.global.venv`, `STO_1`

;; ../../../../spec-concrete/7.03-instantiation-relation.watsup:157.1-161.35
relation Bind_arg: p_caller, IC_caller, p_callee, IC_callee_0, STO_0, id, argumentIR

1. Group : p_caller, IC_caller, p_callee, IC_callee_0, STO_0, id, argumentIR

  1. Let `IC_caller_inner` be `$enter_path(IC_caller, id)`
  2. (Argument_inst: p_caller IC_caller_inner STO_0 |- argumentIR ==> STO_1 value)
  3. Let `IC_callee_1` be `$add_value_inst(p_callee, IC_callee_0, id, value)`
  4. Result in `IC_callee_1`, `STO_1`

;; ../../../../spec-concrete/7.03-instantiation-relation.watsup:163.1-167.35
relation Bind_args: p_caller, IC_caller, p_callee, IC_callee', STO', id*, argumentIR*

1. Case analysis on `id*`
  1. Case `id*` matches pattern []
    1. Assert that argumentIR* matches pattern [].
      1. Group nil: p_caller, IC_caller, p_callee, IC_callee, STO, [], []

        1. Result in `IC_callee'`, `STO'`

  2. Case `id*` matches pattern _ :: _
    1. Let `id_h :: id_t*` be id*
    2. Assert that argumentIR* matches pattern _ :: _.
      1. Let `argumentIR_h :: argumentIR_t*` be argumentIR*
      2. Group cons: p_caller, IC_caller, p_callee, IC_callee_0, STO_0, id_h :: id_t*, argumentIR_h :: argumentIR_t*

        1. (Bind_arg: p_caller IC_caller | p_callee IC_callee' STO' |- id_h argumentIR_h ==> IC_callee_1 STO_1)
        2. (Bind_args: p_caller IC_caller | p_callee IC_callee_1 STO_1 |- id_t* argumentIR_t* ==> IC_callee_2 STO_2)
        3. Result in `IC_callee_2`, `STO_2`

;; ../../../../spec-concrete/7.03-instantiation-relation.watsup:174.1-179.35
relation Constructor_inst: p, IC, STO_0, constructor, typeArgumentIR*, argumentIR*, id_default'*

1. Case analysis on `constructor`
  1. Case `constructor` matches pattern `EXTERN%<%>(%){%}`
    1. Let `(extern nameIR < typeParameterIR* >( constructorParameterIR* ){ methodPrototypeIR* })` be constructor
