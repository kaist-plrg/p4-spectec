      1. Return ([], [])

  2. Case `constructorParameterIR'*` matches pattern _ :: _
    1. Let `constructorParameterIR_h :: constructorParameterIR_t*` be constructorParameterIR'*
    2. Assert that argumentIR* matches pattern _ :: _.
      1. Let `argumentIR_h :: argumentIR_t*` be argumentIR*
      2. Assert that `argumentIR_h` has type `typedExpressionIR`.
        1. Let `typedExpressionIR` be `argumentIR_h` as `typedExpressionIR`
        2. Let `(constructorParameterIR_aligned*, argumentIR_aligned*)` be `$align_cparams_with_args'(({ (id : constructorParameterIR)* }), constructorParameterIR_t*, argumentIR_t*)`
