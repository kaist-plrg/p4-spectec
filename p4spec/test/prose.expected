;; ../../../../spec-concrete/2.2.5-type-alpha.watsup:20.1-23.46
relation RoutineTypeDef_alpha: routineTypeDefIR, routineTypeDefIR'

1. Case analysis on `routineTypeDefIR`
  1. Case `routineTypeDefIR` has type `routineTypeIR`
    1. Let `routineTypeIR_a` be `routineTypeDefIR` as `routineTypeIR`
    2. Assert that `routineTypeDefIR'` has type `routineTypeIR`.
      1. Let `routineTypeIR_b` be `routineTypeDefIR'` as `routineTypeIR`
      2. Group mono: `routineTypeIR_a` as `routineTypeDefIR`, `routineTypeIR_b` as `routineTypeDefIR`

        1.  If [`routineTypeIR_a` and `routineTypeIR_b` are the same type](RoutineType_alpha), then:
            1. The relation holds

  2. Case `routineTypeDefIR` has type `polyRoutineTypeDefIR`
    1. Let `(routineTypeIR_a < tid_a* , tid_hidden_a* >)` be `routineTypeDefIR` as `polyRoutineTypeDefIR`
    2. Assert that `routineTypeDefIR'` has type `polyRoutineTypeDefIR`.
      1. Let `(routineTypeIR_b < tid_b* , tid_hidden_b* >)` be `routineTypeDefIR'` as `polyRoutineTypeDefIR`
      2. Group poly: `(routineTypeIR_a < tid_a* , tid_hidden_a* >)` as `routineTypeDefIR`, `(routineTypeIR_b < tid_b* , tid_hidden_b* >)` as `routineTypeDefIR`

        1. Assert that (|tid_a*| = |tid_b*|).
          1. Assert that (|tid_hidden_a*| = |tid_hidden_b*|).
            1. Let `tid_fresh*` be `$fresh_tids(|tid_a*| + |tid_hidden_a*|)`
            2. Let `tid_a'*` be tid_a* ++ tid_hidden_a*
            3. Let `theta_a` be ({ (tid_a' : `(tid tid_fresh)` as `typeIR`)* })
            4. Let `routineTypeIR_a_subst` be `$subst_routineType(theta_a, routineTypeIR_a)`
            5. Let `tid_b'*` be tid_b* ++ tid_hidden_b*
            6. Let `theta_b` be ({ (tid_b' : `(tid tid_fresh)` as `typeIR`)* })
            7. Let `routineTypeIR_b_subst` be `$subst_routineType(theta_b, routineTypeIR_b)`
            8.  If [`routineTypeIR_a_subst` and `routineTypeIR_b_subst` are the same type](RoutineType_alpha), then:
                1. The relation holds

;; ../../../../spec-concrete/2.3-compile-time-known.watsup:5.14-5.30
syntax ctk = 
   | lctk
   | ctk
   | dyn

;; ../../../../spec-concrete/2.3-compile-time-known.watsup:7.1-7.30
def $join_ctk(ctk'', ctk''')

1. Case analysis on `ctk''`
  1. Case `ctk''` matches pattern `LCTK`
    1. Case analysis on `ctk'''`
      1. Case `ctk'''` matches pattern `LCTK`
        1. Return (lctk)

      2. Case `ctk'''` matches pattern `CTK`
        1. Return (ctk)

  2. Case `ctk''` matches pattern `CTK`
    1. Case analysis on `ctk'''`
      1. Case `ctk'''` matches pattern `LCTK`
        1. Return (ctk)

      2. Case `ctk'''` matches pattern `CTK`
        1. Return (ctk)
2. Otherwise
  1. Return (dyn)

;; ../../../../spec-concrete/2.3-compile-time-known.watsup:16.1-16.27
def $joins_ctk(ctk''*)

1. Case analysis on `ctk''*`
  1. Case `ctk''*` matches pattern []
    1. Return (dyn)

  2. Case `ctk''*` matches pattern [ _/1 ]
    1. Let `[ctk]` be ctk''*
    2. Return ctk

  3. Case `ctk''*` matches pattern _ :: _
    1. Let `ctk_a :: ctk*` be ctk''*
    2. Case analysis on `ctk*`
      1. Case `ctk*` matches pattern [ _/1 ]
        1. Let `[ctk_b]` be ctk*
        2. Return `$join_ctk(ctk_a, ctk_b)`

      2. Case `ctk*` matches pattern _ :: _
        1. Let `ctk_b :: ctk_c*` be ctk*
        2. Let `ctk_d` be `$join_ctk(ctk_a, ctk_b)`
        3. Return `$joins_ctk(ctk_d :: ctk_c*)`

