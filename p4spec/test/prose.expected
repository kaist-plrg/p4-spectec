            2. Let `callExpressionIR` be (routineTargetIR < typeArgumentIR_inferred* >( argumentIR_cast* ))
            3. Let `expressionNoteIR` be (( typeIR_ret ctk ))
            4. Result in `(`callExpressionIR` as `expressionIR` # expressionNoteIR)`
    3. Assert that callExpression matches pattern `%(%)`.
      1. Let `(callTarget ( argumentList ))` be callExpression
      2. Group callExpression-constructorTarget: p, TC, `(callTarget ( argumentList ))` as `expression`

        1. Case analysis on `callTarget`
          1. Case `callTarget` has type `prefixedTypeName`
            1. Let `prefixedTypeName` be `callTarget` as `prefixedTypeName`
            2. Let `argument*` be `$flatten_argumentList(argumentList)`
            3. Let [`argumentIR` be the result of typing `argument`, under cursor `p` and typing context `TC`](Argument_ok), for each `argument` in `argument*` and `argumentIR` in `argumentIR*`
            4. Let `prefixedNameIR` be `$prefixedTypeName(prefixedTypeName)`
            5. (ConstructorType_ok: p TC |- prefixedNameIR < [] >( argumentIR* ): constructorTypeIR <# tid_impl* >(# id_default* ))
            6. (Inst_ok: p TC (anon) |- constructorTypeIR < [] # tid_impl* >( argumentIR* # id_default* ): typeIR_object < typeArgumentIR_inferred* >( argumentIR_cast* ))
            7. Assert that `$is_concrete_extern_object(typeIR_object)`.
              1. Let `callExpressionIR` be ((prefixedNameIR < typeArgumentIR_inferred* >) ( argumentIR_cast* ))
              2. Let `expressionNoteIR` be (( typeIR_object (ctk) ))
              3. Result in `(`callExpressionIR` as `expressionIR` # expressionNoteIR)`

          2. Case `callTarget` has type `specializedType`
            1. Let `(prefixedTypeName < typeArgumentList >)` be `callTarget` as `specializedType`
            2. Let `typeArgument*` be `$flatten_typeArgumentList(typeArgumentList)`
            3. (TypeArguments_ok: p TC |- typeArgument* : typeArgumentIR* # tid_impl*)
            4. Let `argument*` be `$flatten_argumentList(argumentList)`
            5. Let [`argumentIR` be the result of typing `argument`, under cursor `p` and typing context `TC`](Argument_ok), for each `argument` in `argument*` and `argumentIR` in `argumentIR*`
            6. Let `prefixedNameIR` be `$prefixedTypeName(prefixedTypeName)`
            7. (ConstructorType_ok: p TC |- prefixedNameIR < typeArgumentIR* >( argumentIR* ): constructorTypeIR <# tid_inserted* >(# id_default* ))
            8. Let `tid_infer*` be tid_impl* ++ tid_inserted*
            9. (Inst_ok: p TC (anon) |- constructorTypeIR < typeArgumentIR* # tid_infer* >( argumentIR* # id_default* ): typeIR_object < typeArgumentIR_inferred* >( argumentIR_cast* ))
            10. Assert that `$is_concrete_extern_object(typeIR_object)`.
              1. Let `callExpressionIR` be ((prefixedNameIR < typeArgumentIR_inferred* >) ( argumentIR_cast* ))
              2. Let `expressionNoteIR` be (( typeIR_object (ctk) ))
              3. Result in `(`callExpressionIR` as `expressionIR` # expressionNoteIR)`

  11. Case `expression'''` has type `parenthesizedExpression`
    1. Let `(( expression ))` be `expression'''` as `parenthesizedExpression`
    2. Group parenthesizedExpression: p, TC, `(( expression ))` as `expression`

      1. Let [`typedExpressionIR` be the result of typing `expression`, under cursor `p` and typing context `TC`](Expr_ok)
      2. Let `(_expressionIR # expressionNoteIR)` be typedExpressionIR
      3. Result in `(`(( typedExpressionIR ))` as `expressionIR` # expressionNoteIR)`

;; ../../../../spec-concrete/5.04-typing-relation.watsup:67.1-70.90
relation Argument_ok: p, TC, argument

1. Assert that `argument` has type `expression`.
  1. Let `expression` be `argument` as `expression`
  2. Group expression: p, TC, `expression` as `argument`

    1. Let [`typedExpressionIR` be the result of typing `expression`, under cursor `p` and typing context `TC`](Expr_ok)
    2. Result in ``typedExpressionIR` as `argumentIR``
2. Case analysis on `argument`
  1. Case `argument` matches pattern `%=%`
    1. Let `(name = expression)` be argument
    2. Group name-expression: p, TC, (name = expression)

      1. Let `nameIR` be `$name(name)`
      2. Let [`typedExpressionIR` be the result of typing `expression`, under cursor `p` and typing context `TC`](Expr_ok)
      3. Result in `(nameIR = typedExpressionIR)`

  2. Case `argument` matches pattern `%=_`
    1. Let `(name =_)` be argument
    2. Group name-dontcare: p, TC, (name =_)

      1. Let `nameIR` be `$name(name)`
      2. Result in `(nameIR =_)`

  3. Case `argument` matches pattern `_`
    1. Group dontcare: p, TC, (_)

      1. Result in `(_)`

;; ../../../../spec-concrete/5.04-typing-relation.watsup:76.1-79.90
relation Lvalue_ok: p, TC, lvalue

1. Assert that `lvalue` has type `prefixedNonTypeName`.
  1. Let `prefixedNonTypeName` be `lvalue` as `prefixedNonTypeName`
  2. Group referenceExpression-prefixedNonTypeName: p, TC, `prefixedNonTypeName` as `lvalue`

    1. Let `prefixedNameIR` be `$prefixedNonTypeName(prefixedNonTypeName)`
    2. Let `varTypeIR?` be `$find_var(p, TC, prefixedNameIR)`
    3. Assert that varTypeIR? matches pattern (_).
      1. Let `?((direction typeIR ctk value?))` be varTypeIR?
      2. Assert that ctk matches pattern `DYN`.
        1. Assert that value? matches pattern ().
          1. Case analysis on `direction`
            1. Case `direction` matches pattern `OUT`
              1. Result in `(`prefixedNameIR` as `lvalueIR` #( typeIR ))`

            2. Case `direction` matches pattern `INOUT`
              1. Result in `(`prefixedNameIR` as `lvalueIR` #( typeIR ))`
2. Case analysis on `lvalue`
  1. Case `lvalue` matches pattern `%.%`
    1. Let `(lvalue_base . member)` be lvalue
    2. Group lvalue-member: p, TC, (lvalue_base . member)

      1. Let [`typedLvalueIR_base` be the result of typing `lvalue_base`, under cursor `p` and typing context `TC`](Lvalue_ok)
      2. Let `(_lvalueIR #( typeIR_base ))` be typedLvalueIR_base
      3. Let `typeIR'` be `$canon(typeIR_base)`
      4. Case analysis on `typeIR'`
        1. Case `typeIR'` has type `headerStackTypeIR`
          1. Let `(typeIR [ _nat ])` be `typeIR'` as `headerStackTypeIR`
          2. Let `nameIR` be `$name(member)`
          3. Case analysis on `nameIR`
            1. Case nameIR = "next"
              1. Assert that (p = (block)) /\ `$is_parser_blockKind(TC.block.kind)`.
                1. Let `typedLvalueIR` be ((typedLvalueIR_base . nameIR) #( typeIR ))
                2. Result in `typedLvalueIR`
              2. Assert that (p = (local)) /\ `$is_parser_state_localKind(TC.local.kind)`.
                1. Let `typedLvalueIR` be ((typedLvalueIR_base . nameIR) #( typeIR ))
                2. Result in `typedLvalueIR`

            2. Case nameIR = "last"
              1. Assert that (p = (block)) /\ `$is_parser_blockKind(TC.block.kind)`.
                1. Let `typedLvalueIR` be ((typedLvalueIR_base . nameIR) #( typeIR ))
                2. Result in `typedLvalueIR`
              2. Assert that (p = (local)) /\ `$is_parser_state_localKind(TC.local.kind)`.
                1. Let `typedLvalueIR` be ((typedLvalueIR_base . nameIR) #( typeIR ))
                2. Result in `typedLvalueIR`

        2. Case `typeIR'` has type `structTypeIR`
          1. Let `(struct _tid { (typeIR_f nameIR_f ;)* })` be `typeIR'` as `structTypeIR`
          2. Let `nameIR` be `$name(member)`
          3. Let `typeIR''?` be `$assoc_<nameIR, typeIR>(nameIR, (nameIR_f, typeIR_f)*)`
          4. Assert that typeIR''? matches pattern (_).
            1. Let `?(typeIR)` be typeIR''?
            2. Let `typedLvalueIR` be ((typedLvalueIR_base . nameIR) #( typeIR ))
            3. Result in `typedLvalueIR`

        3. Case `typeIR'` has type `headerTypeIR`
          1. Let `(header _tid { (typeIR_f nameIR_f ;)* })` be `typeIR'` as `headerTypeIR`
          2. Let `nameIR` be `$name(member)`
          3. Let `typeIR''?` be `$assoc_<nameIR, typeIR>(nameIR, (nameIR_f, typeIR_f)*)`
          4. Assert that typeIR''? matches pattern (_).
            1. Let `?(typeIR)` be typeIR''?
            2. Let `typedLvalueIR` be ((typedLvalueIR_base . nameIR) #( typeIR ))
            3. Result in `typedLvalueIR`

        4. Case `typeIR'` has type `headerUnionTypeIR`
          1. Let `(header_union _tid { (typeIR_f nameIR_f ;)* })` be `typeIR'` as `headerUnionTypeIR`
          2. Let `nameIR` be `$name(member)`
          3. Let `typeIR''?` be `$assoc_<nameIR, typeIR>(nameIR, (nameIR_f, typeIR_f)*)`
          4. Assert that typeIR''? matches pattern (_).
            1. Let `?(typeIR)` be typeIR''?
            2. Let `typedLvalueIR` be ((typedLvalueIR_base . nameIR) #( typeIR ))
            3. Result in `typedLvalueIR`

  2. Case `lvalue` matches pattern `%[%]`
    1. Let `(lvalue_base [ expression_index ])` be lvalue
    2. Group lvalue-expression: p, TC, (lvalue_base [ expression_index ])

      1. Let [`typedLvalueIR_base` be the result of typing `lvalue_base`, under cursor `p` and typing context `TC`](Lvalue_ok)
      2. Let `(_lvalueIR #( typeIR_base ))` be typedLvalueIR_base
      3. Let `typeIR'` be `$canon(typeIR_base)`
      4. Assert that `typeIR'` has type `headerStackTypeIR`.
        1. Let `(typeIR [ n_size ])` be `typeIR'` as `headerStackTypeIR`
        2. Let [`typedExpressionIR_index` be the result of typing `expression_index`, under cursor `p` and typing context `TC`](Expr_ok)
        3. Let `(_expressionIR # (( typeIR_index ctk_index )))` be typedExpressionIR_index
        4. Let `typedExpressionIR?` be `$reduce_serenum_unary(typedExpressionIR_index, $compat_array_index)`
        5. Assert that typedExpressionIR? matches pattern (_).
          1. Let `?(typedExpressionIR_index_reduced)` be typedExpressionIR?
          2. Case analysis on `ctk_index matches pattern `LCTK``
            1. Case true
              1. Let [`value_index` be the static evaluation of `typedExpressionIR_index_reduced`, under cursor `p` and typing context `TC`](Eval_static)
              2. Let `int` be `$to_number(value_index)`
              3. Assert that `int` has type `nat`.
                1. Let `n_index` be `int` as `nat`
                2. Assert that (n_index < n_size).
                  1. Let `typedLvalueIR` be ((typedLvalueIR_base [ typedExpressionIR_index_reduced ]) #( typeIR ))
                  2. Result in `typedLvalueIR`

            2. Case false
              1. Let `typedLvalueIR` be ((typedLvalueIR_base [ typedExpressionIR_index_reduced ]) #( typeIR ))
              2. Result in `typedLvalueIR`

  3. Case `lvalue` matches pattern `%[%:%]`
    1. Let `(lvalue_base [ expression_hi : expression_lo ])` be lvalue
    2. Group lvalue-expression-expression: p, TC, (lvalue_base [ expression_hi : expression_lo ])

      1. Let [`typedLvalueIR_base` be the result of typing `lvalue_base`, under cursor `p` and typing context `TC`](Lvalue_ok)
      2. Let `(_lvalueIR #( typeIR_base ))` be typedLvalueIR_base
      3. Assert that `$compat_bitslice_base(typeIR_base)`.
        1. Let [`typedExpressionIR_hi` be the result of typing `expression_hi`, under cursor `p` and typing context `TC`](Expr_ok)
        2. Let [`typedExpressionIR_lo` be the result of typing `expression_lo`, under cursor `p` and typing context `TC`](Expr_ok)
        3. Let `typedExpressionIR?` be `$reduce_serenum_unary(typedExpressionIR_hi, $compat_bitslice_index)`
        4. Assert that typedExpressionIR? matches pattern (_).
          1. Let `?(typedExpressionIR_hi_reduced)` be typedExpressionIR?
          2. Let `typedExpressionIR'?` be `$reduce_serenum_unary(typedExpressionIR_lo, $compat_bitslice_index)`
          3. Assert that typedExpressionIR'? matches pattern (_).
            1. Let `?(typedExpressionIR_lo_reduced)` be typedExpressionIR'?
            2. Let `(_expressionIR # (( typeIR_hi_reduced ctk_hi_reduced )))` be typedExpressionIR_hi_reduced
            3. Let `(_expressionIR' # (( typeIR_lo_reduced ctk_lo_reduced )))` be typedExpressionIR_lo_reduced
            4. Assert that ctk_hi_reduced matches pattern `LCTK`.
              1. Let [`value_hi` be the static evaluation of `typedExpressionIR_hi_reduced`, under cursor `p` and typing context `TC`](Eval_static)
              2. Let `int` be `$to_number(value_hi)`
              3. Assert that `int` has type `nat`.
                1. Let `n_hi` be `int` as `nat`
                2. Assert that ctk_lo_reduced matches pattern `LCTK`.
                  1. Let [`value_lo` be the static evaluation of `typedExpressionIR_lo_reduced`, under cursor `p` and typing context `TC`](Eval_static)
                  2. Let `int'` be `$to_number(value_lo)`
                  3. Assert that `int'` has type `nat`.
                    1. Let `n_lo` be `int'` as `nat`
                    2. Assert that `$is_valid_bitslice(typeIR_base, n_lo, n_hi)`.
                      1. Let `int''` be n_hi - n_lo + `1` as `int`
                      2. Assert that `int''` has type `nat`.
                        1. Let `n_slice` be `int''` as `nat`
                        2. Let `typeIR` be `(bit< n_slice >)` as `typeIR`
                        3. Let `typedLvalueIR` be ((typedLvalueIR_base [ typedExpressionIR_hi_reduced : typedExpressionIR_lo_reduced ]) #( typeIR ))
                        4. Result in `typedLvalueIR`

  4. Case `lvalue` matches pattern `(%)`
    1. Let `(( lvalue_base ))` be lvalue
    2. Group parenthesized: p, TC, (( lvalue_base ))

      1. Let [`typedLvalueIR_base` be the result of typing `lvalue_base`, under cursor `p` and typing context `TC`](Lvalue_ok)
      2. Let `(_lvalueIR #( typeIR_base ))` be typedLvalueIR_base
      3. Let `typedLvalueIR` be ((( typedLvalueIR_base )) #( typeIR_base ))
      4. Result in `typedLvalueIR`

;; ../../../../spec-concrete/5.04-typing-relation.watsup:85.1-87.26
relation Stmt_ok: p', TC', f', statement

1. Case analysis on `statement`
  1. Case `statement` has type `emptyStatement`
    1. Let `emptyStatement` be `statement` as `emptyStatement`
    2. Group emptyStatement: p, TC, f, `(;)` as `statement`

      1. Result in `TC'`, `f'`, ``(;)` as `statementIR``

  2. Case `statement` has type `assignmentStatement`
    1. Let `(lvalue assignop expression ;)` be `statement` as `assignmentStatement`
    2. Assert that assignop matches pattern `=`.
      1. Group assignmentStatement-eq: p, TC, f, `(lvalue (=) expression ;)` as `statement`

        1. Let [`typedLvalueIR` be the result of typing `lvalue`, under cursor `p'` and typing context `TC'`](Lvalue_ok)
        2. Let [`typedExpressionIR` be the result of typing `expression`, under cursor `p'` and typing context `TC'`](Expr_ok)
        3. Let `(_lvalueIR #( typeIR_l ))` be typedLvalueIR
        4. Let `(_expressionIR # (( typeIR_r _ctk )))` be typedExpressionIR
        5. Let `typedExpressionIR'?` be `$coerce_unary(typedExpressionIR, typeIR_l)`
        6. Assert that typedExpressionIR'? matches pattern (_).
          1. Let `?(typedExpressionIR_cast)` be typedExpressionIR'?
          2. Result in `TC'`, `f'`, ``(typedLvalueIR (=) typedExpressionIR_cast ;)` as `statementIR``

  3. Case `statement` has type `callStatement`
    1. Let `callStatement` be `statement` as `callStatement`
    2. Group callStatement: p, TC, f, `callStatement` as `statement`

      1. Case analysis on `callStatement`
        1. Case `callStatement` matches pattern `%(%);`
          1. Let `(lvalue_routine ( argumentList );)` be callStatement
          2. Let [`routineTargetIR` be the result of typing `lvalue_routine`, under cursor `p'` and typing context `TC'`](RoutineTarget_lvalue_ok)
          3. Let `argument*` be `$flatten_argumentList(argumentList)`
          4. Let [`argumentIR` be the result of typing `argument`, under cursor `p'` and typing context `TC'`](Argument_ok), for each `argument` in `argument*` and `argumentIR` in `argumentIR*`
          5. (RoutineType_ok: p' TC' |- routineTargetIR < [] >( argumentIR* ): routineTypeIR <# tid_impl* >(# id_default* ))
          6. (Call_ok: p' TC' |- routineTypeIR < [] # tid_impl* >( argumentIR* # id_default* ): typeIR_ret < typeArgumentIR_inferred* >( argumentIR_cast* ))
          7. Let `callStatementIR` be (routineTargetIR < typeArgumentIR_inferred* >( argumentIR_cast* );)
          8. Result in `TC'`, `f'`, ``callStatementIR` as `statementIR``

        2. Case `callStatement` matches pattern `%<%>(%);`
          1. Let `(lvalue_routine < typeArgumentList >( argumentList );)` be callStatement
          2. Let [`routineTargetIR` be the result of typing `lvalue_routine`, under cursor `p'` and typing context `TC'`](RoutineTarget_lvalue_ok)
          3. Let `typeArgument*` be `$flatten_typeArgumentList(typeArgumentList)`
          4. (TypeArguments_ok: p' TC' |- typeArgument* : typeArgumentIR* # tid_impl*)
          5. Let `argument*` be `$flatten_argumentList(argumentList)`
          6. Let [`argumentIR` be the result of typing `argument`, under cursor `p'` and typing context `TC'`](Argument_ok), for each `argument` in `argument*` and `argumentIR` in `argumentIR*`
          7. (RoutineType_ok: p' TC' |- routineTargetIR < typeArgumentIR* >( argumentIR* ): routineTypeIR <# tid_inserted* >(# id_default* ))
          8. Let `tid_infer*` be tid_impl* ++ tid_inserted*
          9. (Call_ok: p' TC' |- routineTypeIR < [] # tid_infer* >( argumentIR* # id_default* ): typeIR_ret < typeArgumentIR_inferred* >( argumentIR_cast* ))
          10. Let `callStatementIR` be (routineTargetIR < typeArgumentIR_inferred* >( argumentIR_cast* );)
          11. Result in `TC'`, `f'`, ``callStatementIR` as `statementIR``

  4. Case `statement` has type `directApplicationStatement`
    1. Let `(namedType .apply( argumentList );)` be `statement` as `directApplicationStatement`
    2. Group directApplicationStatement-prefixedTypeName: p, TC_0, f, `(namedType .apply( argumentList );)` as `statement`

      1. Let [`(expressionIR # (( typeIR_object _ctk )))` be the result of typing ``(`namedType` as `callTarget` ( () ))` as `expression``, under cursor `p'` and typing context `TC'`](Expr_ok)
      2. Assert that `expressionIR` has type `callExpressionIR`.
        1. Let `callExpressionIR` be `expressionIR` as `callExpressionIR`
        2. Assert that callExpressionIR matches pattern `%(%)`.
          1. Let `((prefixedNameIR < typeArgumentIR* >) ( argumentIR* ))` be callExpressionIR
          2. Assert that typeArgumentIR* matches pattern [].
            1. Assert that argumentIR* matches pattern [].
              1. Assert that `$compat_direct_application(typeIR_object)`.
                1. Let `nameIR_object` be "__direct_application"
                2. Let `TC_1` be `$add_var(p', TC', nameIR_object, (() typeIR_object (ctk) ?()))`
                3. Let `lvalue` be (`(nameIR_object)` as `lvalue` . `("apply")` as `member`)
                4. (Stmt_ok: p' TC_1 f' |- `(lvalue ( argumentList );)` as `statement` : _typingContext _flow statementIR)
                5. Assert that `statementIR` has type `callStatementIR`.
                  1. Let `callStatementIR` be `statementIR` as `callStatementIR`
                  2. Let `(routineTargetIR < typeArgumentIR'* >( argumentIR_cast* );)` be callStatementIR
                  3. Assert that (routineTargetIR = ((`(` nameIR_object)` as `expressionIR` # (( typeIR_object (ctk) ))) . "apply")).
                    1. Assert that typeArgumentIR'* matches pattern [].
                      1. Let `directApplicationStatementIR` be (prefixedNameIR .apply( argumentIR_cast* );)
                      2. Result in `TC'`, `f'`, ``directApplicationStatementIR` as `statementIR``

  5. Case `statement` has type `exitStatement`
    1. Let `exitStatement` be `statement` as `exitStatement`
    2. Group exitStatement: p, TC, f, `(exit;)` as `statement`

      1. Result in `TC'`, `f'`, ``(exit;)` as `statementIR``

  6. Case `statement` has type `conditionalStatement`
    1. Let `conditionalStatement` be `statement` as `conditionalStatement`
    2. Group conditionalStatement: p, TC, f, `conditionalStatement` as `statement`

      1. Case analysis on `conditionalStatement`
        1. Case `conditionalStatement` matches pattern `IF(%)%`
          1. Let `(if( expression_cond ) statement_then)` be conditionalStatement
          2. Let [`typedExpressionIR_cond` be the result of typing `expression_cond`, under cursor `p'` and typing context `TC'`](Expr_ok)
          3. Let `(_expressionIR # (( typeIR _ctk )))` be typedExpressionIR_cond
          4. Assert that `typeIR` has type `primitiveTypeIR`.
            1. Let `primitiveTypeIR` be `typeIR` as `primitiveTypeIR`
            2. Assert that primitiveTypeIR matches pattern `BOOL`.
              1. (Stmt_ok: p' TC' f' |- statement_then : TC_then f_then statementIR_then)
              2. Result in `TC'`, `f'`, ``(if( typedExpressionIR_cond ) statementIR_then)` as `statementIR``

        2. Case `conditionalStatement` matches pattern `IF(%)%ELSE%`
          1. Let `(if( expression_cond ) statement_then else statement_else)` be conditionalStatement
          2. Let [`typedExpressionIR_cond` be the result of typing `expression_cond`, under cursor `p'` and typing context `TC'`](Expr_ok)
          3. Let `(_expressionIR # (( typeIR _ctk )))` be typedExpressionIR_cond
          4. Assert that `typeIR` has type `primitiveTypeIR`.
            1. Let `primitiveTypeIR` be `typeIR` as `primitiveTypeIR`
            2. Assert that primitiveTypeIR matches pattern `BOOL`.
              1. (Stmt_ok: p' TC' f' |- statement_then : TC_then f_then statementIR_then)
              2. (Stmt_ok: p' TC' f' |- statement_else : TC_else f_else statementIR_else)
              3. Let `f_post` be `$join_flow(f_then, f_else)`
              4. Result in `TC'`, `f_post`, ``(if( typedExpressionIR_cond ) statementIR_then else statementIR_else)` as `statementIR``
2. Assert that p' matches pattern `LOCAL`.
  1. Case analysis on `statement`
    1. Case `statement` has type `returnStatement`
      1. Let `returnStatement` be `statement` as `returnStatement`
      2. Group returnStatement: (local), TC, f, `returnStatement` as `statement`

        1. Case analysis on `returnStatement`
          1. Case `returnStatement` matches pattern `RETURN;`
            1. Assert that (?(`(void)` as `typeIR`) = `$find_return_type(TC')`).
              1. Result in `TC'`, `(ret)`, ``(return;)` as `statementIR``

          2. Case `returnStatement` matches pattern `RETURN%;`
            1. Let `(return expression ;)` be returnStatement
            2. Let [`typedExpressionIR` be the result of typing `expression`, under cursor `(local)` and typing context `TC'`](Expr_ok)
            3. Let `(_expressionIR # (( typeIR _ctk )))` be typedExpressionIR
            4. Let `typeIR'?` be `$find_return_type(TC')`
            5. Assert that typeIR'? matches pattern (_).
              1. Let `?(typeIR_ret)` be typeIR'?
              2. Let `typedExpressionIR'?` be `$coerce_unary(typedExpressionIR, typeIR_ret)`
              3. Assert that typedExpressionIR'? matches pattern (_).
                1. Let `?(typedExpressionIR_cast)` be typedExpressionIR'?
                2. Result in `TC'`, `(ret)`, ``(return typedExpressionIR_cast ;)` as `statementIR``

    2. Case `statement` has type `blockStatement`
      1. Let `blockStatement` be `statement` as `blockStatement`
      2. Group blockStatement: (local), TC_0, f_0, `blockStatement` as `statement`

        1. (Block_ok: TC' f' |- blockStatement : TC_1 f_1 blockStatementIR)
        2. Result in `TC_1`, `f_1`, ``blockStatementIR` as `statementIR``

    3. Case `statement` has type `switchStatement`
      1. Let `(switch( expression_switch ){ switchCaseList })` be `statement` as `switchStatement`
      2. Group switch-table-apply: (local), TC, f, `(switch( expression_switch ){ switchCaseList })` as `statement`

        1. Let [`typedExpressionIR_switch` be the result of typing `expression_switch`, under cursor `(local)` and typing context `TC'`](Expr_ok)
        2. Let `(_expressionIR # (( typeIR_switch _ctk )))` be typedExpressionIR_switch
        3. Let `typeIR` be `$canon(typeIR_switch)`
        4. Assert that `typeIR` has type `tableTypeIR`.
          1. Let `tableTypeIR` be `typeIR` as `tableTypeIR`
          2. Assert that tableTypeIR matches pattern `TABLE_ENUM%{%}`.
            1. Let `(table_enum tid_table_enum { _id* })` be tableTypeIR
            2. Let `tid_table` be `$strip_prefix(`$strip_suffix(tid_table_enum, ")")`, "action_list(")`
            3. Let `switchCase*` be `$flatten_switchCaseList(switchCaseList)`
            4. (SwitchCases_table_ok: TC' f' tid_table |- switchCase* : f_post switchCaseIR* # switchLabel*)
            5. Assert that [the elements of `switchLabel*` are distinct]($distinct_).
              1. Let `switchStatementIR` be (switch( typedExpressionIR_switch ){ switchCaseIR* })
              2. Result in `TC'`, `f_post`, ``switchStatementIR` as `statementIR``
      3. Group switch-general: (local), TC, f, `(switch( expression_switch ){ switchCaseList })` as `statement`

        1. Let [`typedExpressionIR_switch` be the result of typing `expression_switch`, under cursor `(local)` and typing context `TC'`](Expr_ok)
        2. Let `(_expressionIR # (( typeIR_switch _ctk )))` be typedExpressionIR_switch
        3. Assert that `$compat_switch(typeIR_switch)`.
          1. Let `switchCase*` be `$flatten_switchCaseList(switchCaseList)`
          2. (SwitchCases_general_ok: TC' f' typeIR_switch |- switchCase* : f_post switchCaseIR* # switchLabel*)
          3. Assert that [the elements of `switchLabel*` are distinct]($distinct_).
            1. Let `switchStatementIR` be (switch( typedExpressionIR_switch ){ switchCaseIR* })
            2. Result in `TC'`, `f_post`, ``switchStatementIR` as `statementIR``

;; ../../../../spec-concrete/5.04-typing-relation.watsup:89.1-92.23
relation BlockElementStmt_ok: TC_0, f, blockElementStatement

1. Case analysis on `blockElementStatement`
  1. Case `blockElementStatement` has type `constantDeclaration`
    1. Let `constantDeclaration` be `blockElementStatement` as `constantDeclaration`
    2. Group constantDeclaration: TC_0, f, `constantDeclaration` as `blockElementStatement`

      1. Let [`declarationIR` be the result of typing ``constantDeclaration` as `declaration``, under cursor `(local)` and typing context `TC_0`,
         and `TC_1` be the modified typing context](Decl_ok)
      2. Assert that `declarationIR` has type `constantDeclarationIR`.
        1. Let `constantDeclarationIR` be `declarationIR` as `constantDeclarationIR`
        2. Result in `TC_1`, `f`, ``constantDeclarationIR` as `blockElementStatementIR``

  2. Case `blockElementStatement` has type `variableDeclaration`
    1. Let `(annotationList type name initializerOpt ;)` be `blockElementStatement` as `variableDeclaration`
    2. Group variableDeclaration: TC_0, f, `(annotationList type name initializerOpt ;)` as `blockElementStatement`

      1. Assert that initializerOpt matches pattern ``EMPTY`.
        1. Let [`typeIR` be the result of typing ``type` as `typeOrVoid``, under cursor `(local)` and typing context `TC_0`,
           and `tid*` be the set of inserted type variables](Type_ok)
        2. Assert that tid* matches pattern [].
          1.  If [`typeIR` is a well-formed type, assuming bound type ids ``$bound((local), TC_0)``](Type_wf), then:
              1. Assert that `$is_assignable_typeIR(typeIR)`.
                1. Let `nameIR` be `$name(name)`
                2. Let `TC_1` be `$add_var((local), TC_0, nameIR, ((inout) typeIR (dyn) ?()))`
                3. Let `variableDeclarationIR` be (annotationList typeIR nameIR ?() ;)
                4. Result in `TC_1`, `f`, ``variableDeclarationIR` as `blockElementStatementIR``
      2. Assert that `initializerOpt` has type `initializer`.
        1. Let `(= expression_init)` be `initializerOpt` as `initializer`
        2. Let [`typeIR` be the result of typing ``type` as `typeOrVoid``, under cursor `(local)` and typing context `TC_0`,
           and `tid*` be the set of inserted type variables](Type_ok)
        3. Assert that tid* matches pattern [].
          1.  If [`typeIR` is a well-formed type, assuming bound type ids ``$bound((local), TC_0)``](Type_wf), then:
              1. Assert that `$is_assignable_typeIR(typeIR)`.
                1. Let [`typedExpressionIR_init` be the result of typing `expression_init`, under cursor `(local)` and typing context `TC_0`](Expr_ok)
                2. Let `typedExpressionIR?` be `$coerce_unary(typedExpressionIR_init, typeIR)`
                3. Assert that typedExpressionIR? matches pattern (_).
                  1. Let `?(typedExpressionIR_init_cast)` be typedExpressionIR?
                  2. Let `nameIR` be `$name(name)`
                  3. Let `TC_1` be `$add_var((local), TC_0, nameIR, ((inout) typeIR (dyn) ?()))`
                  4. Let `variableDeclarationIR` be (annotationList typeIR nameIR ?((= typedExpressionIR_init_cast)) ;)
                  5. Result in `TC_1`, `f`, ``variableDeclarationIR` as `blockElementStatementIR``

  3. Case `blockElementStatement` has type `statement`
    1. Let `statement` be `blockElementStatement` as `statement`
    2. Group statement: TC_0, f, `statement` as `blockElementStatement`

      1. (Stmt_ok: (local) TC_0 f |- statement : TC_1 f_post statementIR)
      2. Result in `TC_1`, `f_post`, ``statementIR` as `blockElementStatementIR``

;; ../../../../spec-concrete/5.04-typing-relation.watsup:94.1-97.23
relation BlockElementStmts_ok: TC', f', blockElementStatement*

1. Case analysis on `blockElementStatement*`
  1. Case `blockElementStatement*` matches pattern []
    1. Group nil: TC, f, []

      1. Result in `TC'`, `f'`, `[]`

  2. Case `blockElementStatement*` matches pattern _ :: _
    1. Let `blockElementStatement_h :: blockElementStatement_t*` be blockElementStatement*
    2. Group cons: TC_0, f_0, blockElementStatement_h :: blockElementStatement_t*

      1. (BlockElementStmt_ok: TC' f' |- blockElementStatement_h : TC_1 f_1 blockElementStatementIR_h)
      2. (BlockElementStmts_ok: TC_1 f_1 |- blockElementStatement_t* : TC_2 f_2 blockElementStatementIR_t*)
      3. Result in `TC_2`, `f_2`, `blockElementStatementIR_h :: blockElementStatementIR_t*`

;; ../../../../spec-concrete/5.04-typing-relation.watsup:99.1-102.23
relation Block_ok: TC_0, f, (annotationList { blockElementStatementList })

1. Group : TC_0, f, (annotationList { blockElementStatementList })

  1. Let `blockElementStatement*` be `$flatten_blockElementStatementList(blockElementStatementList)`
  2. Let `TC_1` be `$enter(TC_0)`
  3. (BlockElementStmts_ok: TC_1 f |- blockElementStatement* : TC_2 f_post blockElementStatementIR*)
  4. Let `TC_3` be `$exit(TC_2)`
  5. Let `blockStatementIR` be (annotationList { blockElementStatementIR* })
  6. Result in `TC_3`, `f_post`, `blockStatementIR`

;; ../../../../spec-concrete/5.04-typing-relation.watsup:109.1-112.90
relation Parameter_ok: p, TC, (annotationList direction type name initializerOpt)

1. Assert that initializerOpt matches pattern ``EMPTY`.
  1. Group empty: p, TC, (annotationList direction type name ())

    1. Let [`typeIR` be the result of typing ``type` as `typeOrVoid``, under cursor `p` and typing context `TC`,
       and `tid_fresh*` be the set of inserted type variables](Type_ok)
    2. Let `bound` be `$union_set<tid>(`$bound(p, TC)`, ({ tid_fresh* }))`
    3.  If [`typeIR` is a well-formed type, assuming bound type ids `bound`](Type_wf), then:
        1. Let `nameIR` be `$name(name)`
        2. Result in `(annotationList direction typeIR nameIR ?())`, `tid_fresh*`
2. Assert that `initializerOpt` has type `initializer`.
  1. Let `(= expression_init)` be `initializerOpt` as `initializer`
  2. Group initializer: p, TC, (annotationList direction type name `(= expression_init)` as `initializerOpt`)

    1. Let [`typeIR` be the result of typing ``type` as `typeOrVoid``, under cursor `p` and typing context `TC`,
       and `tid_fresh*` be the set of inserted type variables](Type_ok)
    2. Let `bound` be `$union_set<tid>(`$bound(p, TC)`, ({ tid_fresh* }))`
    3.  If [`typeIR` is a well-formed type, assuming bound type ids `bound`](Type_wf), then:
        1. Let [`typedExpressionIR_init` be the result of typing `expression_init`, under cursor `p` and typing context `TC`](Expr_ok)
        2. Let `(_expressionIR # (( typeIR_init ctk )))` be typedExpressionIR_init
        3. Assert that ctk matches pattern `LCTK`.
          1. Let `typedExpressionIR?` be `$coerce_unary(typedExpressionIR_init, typeIR)`
          2. Assert that typedExpressionIR? matches pattern (_).
            1. Let `?(typedExpressionIR_init_cast)` be typedExpressionIR?
            2. Let `nameIR` be `$name(name)`
            3. Let [`value_init` be the static evaluation of `typedExpressionIR_init_cast`, under cursor `p` and typing context `TC`](Eval_static)
            4. Result in `(annotationList direction typeIR nameIR ?((= value_init)))`, `tid_fresh*`

;; ../../../../spec-concrete/5.04-typing-relation.watsup:114.1-117.90
relation Parameters_ok: p, TC, parameter*

1. Case analysis on `parameter*`
  1. Case `parameter*` matches pattern []
    1. Group nil: p, TC, []

      1. Result in `[]`, `[]`

  2. Case `parameter*` matches pattern _ :: _
    1. Let `parameter_h :: parameter_t*` be parameter*
    2. Group cons: p, TC, parameter_h :: parameter_t*

      1. Let [`parameterIR_h` be the result of typing `parameter_h`, under cursor `p` and typing context `TC`](Parameter_ok)
      2. Let [`parameterIR_t*` be the result of typing `parameter_t*`, under cursor `p` and typing context `TC`](Parameters_ok)
      3. Result in `parameterIR_h :: parameterIR_t*`, `tid_fresh_h* ++ tid_fresh_t*`

;; ../../../../spec-concrete/5.04-typing-relation.watsup:119.1-119.48
def $parameterIR((_annotationList direction typeIR nameIR constantInitializerOptIR'))

1. Let `constantInitializerIR?` be constantInitializerOptIR'
2. Assert that constantInitializerIR? matches pattern ().
  1. Return (direction typeIR nameIR ?())
3. Assert that constantInitializerOptIR' matches pattern (_).
  1. Let `?((= value))` be constantInitializerOptIR'
  2. Return (direction typeIR nameIR ?(value))

;; ../../../../spec-concrete/5.04-typing-relation.watsup:125.1-128.23
relation ConstructorParameter_ok: p, TC, constructorParameter

1. Group : p, TC, constructorParameter

  1. Let [`constructorParameterIR` be the result of typing `constructorParameter`, under cursor `p` and typing context `TC`](Parameter_ok)
  2. Result in `constructorParameterIR`, `tid_fresh*`

;; ../../../../spec-concrete/5.04-typing-relation.watsup:130.1-133.23
relation ConstructorParameters_ok: p, TC, constructorParameter*

1. Group : p, TC, constructorParameter*

  1. Let [`constructorParameterIR*` be the result of typing `constructorParameter*`, under cursor `p` and typing context `TC`](Parameters_ok)
  2. Result in `constructorParameterIR*`, `tid_fresh*`

;; ../../../../spec-concrete/5.04-typing-relation.watsup:135.1-135.81
def $constructorParameterIR(constructorParameterIR)

1. Return `$parameterIR(constructorParameterIR)`

;; ../../../../spec-concrete/5.04-typing-relation.watsup:143.1-145.23
relation ExternMethod_ok: TC_0, tid_extern, methodPrototype

1. Case analysis on `methodPrototype`
  1. Case `methodPrototype` matches pattern `%%;`
    1. Let `(annotationList (typeOrVoid name typeParameterListOpt ( parameterList )) ;)` be methodPrototype
    2. Group non-abstract: TC_0, tid_extern, (annotationList (typeOrVoid name typeParameterListOpt ( parameterList )) ;)

      1. Let `nameIR` be `$name(name)`
      2. Assert that (nameIR =/= tid_extern).
        1. Let `typeParameter*` be `$flatten_typeParameterListOpt(typeParameterListOpt)`
        2. Let `tid_expl` be `$name(typeParameter)`, for each `tid_expl` in `tid_expl*` and `typeParameter` in `typeParameter*`
        3. Let `TC_1` be `$add_types((local), TC_0, tid_expl*, `(tid tid_expl)` as `typeDefIR`*)`
        4. Let [`typeIR_ret` be the result of typing `typeOrVoid`, under cursor `(local)` and typing context `TC_1`,
           and `tid*` be the set of inserted type variables](Type_ok)
        5. Assert that tid* matches pattern [].
          1. Let `TC_2` be TC_1[local.kind = (extern_method-> typeIR_ret)]
          2. Let `parameter*` be `$flatten_parameterList(parameterList)`
          3. Let [`parameterIR*` be the result of typing `parameter*`, under cursor `(local)` and typing context `TC_2`](Parameters_ok)
          4. Let `parameterTypeIR` be `$parameterIR(parameterIR)`, for each `parameterIR` in `parameterIR*` and `parameterTypeIR` in `parameterTypeIR*`
          5. Let `TC_3` be `$add_parameters((local), TC_2, parameterTypeIR*)`
          6. Let `rid` be `$rid(name, parameterList)`
          7. Let `methodTypeIR` be (extern_method( parameterTypeIR* )-> typeIR_ret)
          8. Let `routineTypeDefIR` be `(`methodTypeIR` as `routineTypeIR` < tid_expl* , tid_impl* >)` as `routineTypeDefIR`
          9.  If [`routineTypeDefIR` is a well-formed type, assuming bound type ids ``$bound((block), TC_0)``](RoutineTypeDef_wf), then:
              1. Let `TC_4` be `$add_routine_overload((block), TC_0, rid, routineTypeDefIR)`
              2. Let `methodPrototypeIR` be (annotationList (typeIR_ret nameIR < tid_expl* , tid_impl* >( parameterIR* )) ;)
              3. Result in `TC_4`, `methodPrototypeIR`

  2. Case `methodPrototype` matches pattern `%ABSTRACT%;`
    1. Let `(annotationList abstract (typeOrVoid name typeParameterListOpt ( parameterList )) ;)` be methodPrototype
    2. Group abstract: TC_0, tid_extern, (annotationList abstract (typeOrVoid name typeParameterListOpt ( parameterList )) ;)

      1. Let `nameIR` be `$name(name)`
      2. Assert that (nameIR =/= tid_extern).
        1. Let `typeParameter*` be `$flatten_typeParameterListOpt(typeParameterListOpt)`
        2. Let `tid_expl` be `$name(typeParameter)`, for each `tid_expl` in `tid_expl*` and `typeParameter` in `typeParameter*`
        3. Let `TC_1` be `$add_types((local), TC_0, tid_expl*, `(tid tid_expl)` as `typeDefIR`*)`
        4. Let [`typeIR_ret` be the result of typing `typeOrVoid`, under cursor `(local)` and typing context `TC_1`,
           and `tid*` be the set of inserted type variables](Type_ok)
        5. Assert that tid* matches pattern [].
          1. Let `TC_2` be TC_1[local.kind = (extern_methodabstract-> typeIR_ret)]
          2. Let `parameter*` be `$flatten_parameterList(parameterList)`
          3. Let [`parameterIR*` be the result of typing `parameter*`, under cursor `(local)` and typing context `TC_2`](Parameters_ok)
          4. Let `parameterTypeIR` be `$parameterIR(parameterIR)`, for each `parameterIR` in `parameterIR*` and `parameterTypeIR` in `parameterTypeIR*`
          5. Let `TC_3` be `$add_parameters((local), TC_2, parameterTypeIR*)`
          6. Let `rid` be `$rid(name, parameterList)`
          7. Let `methodTypeIR` be (extern_methodabstract( parameterTypeIR* )-> typeIR_ret)
          8. Let `routineTypeDefIR` be `(`methodTypeIR` as `routineTypeIR` < tid_expl* , tid_impl* >)` as `routineTypeDefIR`
          9.  If [`routineTypeDefIR` is a well-formed type, assuming bound type ids ``$bound((block), TC_0)``](RoutineTypeDef_wf), then:
              1. Let `TC_4` be `$add_routine_overload((block), TC_0, rid, routineTypeDefIR)`
              2. Let `methodPrototypeIR` be (annotationList abstract (typeIR_ret nameIR < tid_expl* , tid_impl* >( parameterIR* )) ;)
              3. Result in `TC_4`, `methodPrototypeIR`

;; ../../../../spec-concrete/5.04-typing-relation.watsup:147.1-149.23
relation ExternMethods_ok: TC', tid_extern, methodPrototype*

1. Case analysis on `methodPrototype*`
  1. Case `methodPrototype*` matches pattern []
    1. Group nil: TC, tid_extern, []

      1. Result in `TC'`, `[]`

  2. Case `methodPrototype*` matches pattern _ :: _
    1. Let `methodPrototype_h :: methodPrototype_t*` be methodPrototype*
    2. Group cons: TC_0, tid_extern, methodPrototype_h :: methodPrototype_t*

      1. (ExternMethod_ok: TC' tid_extern |- methodPrototype_h : TC_1 methodPrototypeIR_h)
      2. (ExternMethods_ok: TC_1 tid_extern |- methodPrototype_t* : TC_2 methodPrototypeIR_t*)
      3. Result in `TC_2`, `methodPrototypeIR_h :: methodPrototypeIR_t*`

;; ../../../../spec-concrete/5.04-typing-relation.watsup:151.1-153.23
relation ExternConstructor_ok: TC_0, tid_extern, methodPrototype

1. Assert that methodPrototype matches pattern `%%(%);`.
  1. Let `(annotationList typeIdentifier ( parameterList );)` be methodPrototype
  2. Group : TC_0, tid_extern, (annotationList typeIdentifier ( parameterList );)

    1. Let `nameIR` be `$name(`typeIdentifier` as `name`)`
    2. Assert that (nameIR = tid_extern).
      1. Let `constructorParameter*` be `$flatten_parameterList(parameterList)`
      2. (ConstructorParameters_ok: (block) TC_0 |- constructorParameter* : constructorParameterIR* # tid_impl*)
      3. Let `constructorParameterTypeIR` be `$constructorParameterIR(constructorParameterIR)`, for each `constructorParameterIR` in `constructorParameterIR*` and `constructorParameterTypeIR` in `constructorParameterTypeIR*`
      4. Let `typeDefIR'?` be `$find_type((global), TC_0, (` nameIR))`
      5. Assert that typeDefIR'? matches pattern (_).
        1. Let `?(typeDefIR)` be typeDefIR'?
        2. Assert that `typeDefIR` has type `polyTypeDefIR`.
          1. Let `(typeIR_extern < tid_expl* , tid* >)` be `typeDefIR` as `polyTypeDefIR`
          2. Assert that tid* matches pattern [].
            1. Let `cid` be `$cid(`typeIdentifier` as `name`, (( parameterList )))`
            2. Let `typeIR_extern_spec` be `((typeIR_extern < tid_expl* , [] >) < `(tid tid_expl)` as `typeIR`* >)` as `typeIR`
            3. Let `constructorTypeIR` be (constructor( constructorParameterTypeIR* )-> typeIR_extern_spec)
            4. Let `constructorTypeDefIR` be (constructorTypeIR < tid_expl* , tid_impl* >)
            5.  If [`constructorTypeDefIR` is a well-formed type, assuming bound type ids ``$bound((block), TC_0)``](ConstructorTypeDef_wf), then:
                1. Let `TC_1` be `$add_constructor(TC_0, cid, constructorTypeDefIR)`
                2. Let `methodPrototypeIR` be (annotationList nameIR <, tid_impl* >( constructorParameterIR* );)
                3. Result in `TC_1`, `methodPrototypeIR`

;; ../../../../spec-concrete/5.04-typing-relation.watsup:155.1-157.23
relation ExternConstructors_ok: TC', tid_extern, methodPrototype*

1. Case analysis on `methodPrototype*`
  1. Case `methodPrototype*` matches pattern []
    1. Group nil: TC, tid_extern, []

      1. Result in `TC'`, `[]`

  2. Case `methodPrototype*` matches pattern _ :: _
    1. Let `methodPrototype_h :: methodPrototype_t*` be methodPrototype*
    2. Group cons: TC_0, tid_extern, methodPrototype_h :: methodPrototype_t*

      1. (ExternConstructor_ok: TC' tid_extern |- methodPrototype_h : TC_1 methodPrototypeIR_h)
      2. (ExternConstructors_ok: TC_1 tid_extern |- methodPrototype_t* : TC_2 methodPrototypeIR_t*)
      3. Result in `TC_2`, `methodPrototypeIR_h :: methodPrototypeIR_t*`

;; ../../../../spec-concrete/5.04-typing-relation.watsup:163.1-165.23
relation ParserTransition_ok: TC_0, nameIR_state*, transitionStatement

1. Case analysis on `transitionStatement`
  1. Case `transitionStatement` matches pattern ``EMPTY`
    1. Group empty: TC_0, nameIR_state*, ()

      1. Result in `(transition ("reject" ;))`

  2. Case `transitionStatement` matches pattern `TRANSITION%`
    1. Let `(transition stateExpression)` be transitionStatement
    2. Assert that stateExpression matches pattern `%;`.
      1. Let `(name ;)` be stateExpression
      2. Group name: TC_0, nameIR_state*, (transition (name ;))

        1. Let `nameIR` be `$name(name)`
        2. Assert that nameIR is in nameIR_state*.
          1. Let `transitionStatementIR` be (transition (nameIR ;))
          2. Result in `transitionStatementIR`
    3. Assert that `stateExpression` has type `selectExpression`.
      1. Let `(select( expressionList_key ){ selectCaseList })` be `stateExpression` as `selectExpression`
      2. Group switch: TC_0, nameIR_state*, (transition `(select( expressionList_key ){ selectCaseList })` as `stateExpression`)

        1. Let `expression_key*` be `$flatten_expressionList(expressionList_key)`
        2. Let [`typedExpressionIR_key` be the result of typing `expression_key`, under cursor `(local)` and typing context `TC_0`](Expr_ok), for each `expression_key` in `expression_key*` and `typedExpressionIR_key` in `typedExpressionIR_key*`
        3. Let `(_expressionIR # (( typeIR_key _ctk )))` be typedExpressionIR_key, for each `_ctk` in `_ctk*` and `_expressionIR` in `_expressionIR*` and `typeIR_key` in `typeIR_key*` and `typedExpressionIR_key` in `typedExpressionIR_key*`
        4.  If [``(set< [typeIR_key] >)` as `typeIR`` is a well-formed type, assuming bound type ids ``$bound((local), TC_0)``](Type_wf), for each `typeIR_key` in `typeIR_key*`, then:
            1. Let `selectCase*` be `$flatten_selectCaseList(selectCaseList)`
            2. (SelectCase_ok: TC_0 nameIR_state* typeIR_key* |- selectCase : selectCaseIR), for each `selectCase` in `selectCase*` and `selectCaseIR` in `selectCaseIR*`
            3. Let `transitionStatementIR` be (transition `(select( typedExpressionIR_key* ){ selectCaseIR* })` as `stateExpressionIR`)
            4. Result in `transitionStatementIR`

;; ../../../../spec-concrete/5.04-typing-relation.watsup:167.1-169.20
relation ParserStmt_ok: TC_0', parserStatement''

1. Case analysis on `parserStatement''`
  1. Case `parserStatement''` has type `constantDeclaration`
    1. Let `constantDeclaration` be `parserStatement''` as `constantDeclaration`
    2. Group constantDeclaration: TC_0, `constantDeclaration` as `parserStatement`

      1. Let [`declarationIR` be the result of typing ``constantDeclaration` as `declaration``, under cursor `(local)` and typing context `TC_0'`,
         and `TC_1` be the modified typing context](Decl_ok)
      2. Assert that `declarationIR` has type `constantDeclarationIR`.
        1. Let `constantDeclarationIR` be `declarationIR` as `constantDeclarationIR`
        2. Result in `TC_1`, ``constantDeclarationIR` as `parserStatementIR``

  2. Case `parserStatement''` has type `variableDeclaration`
    1. Let `(annotationList type name initializerOpt ;)` be `parserStatement''` as `variableDeclaration`
    2. Group variableDeclaration: TC_0, `(annotationList type name initializerOpt ;)` as `parserStatement`

      1. Assert that initializerOpt matches pattern ``EMPTY`.
        1. Let [`typeIR` be the result of typing ``type` as `typeOrVoid``, under cursor `(local)` and typing context `TC_0'`,
           and `tid*` be the set of inserted type variables](Type_ok)
        2. Assert that tid* matches pattern [].
          1.  If [`typeIR` is a well-formed type, assuming bound type ids ``$bound((local), TC_0')``](Type_wf), then:
              1. Assert that `$is_assignable_typeIR(typeIR)`.
                1. Let `nameIR` be `$name(name)`
                2. Let `TC_1` be `$add_var((local), TC_0', nameIR, ((inout) typeIR (dyn) ?()))`
                3. Let `variableDeclarationIR` be (annotationList typeIR nameIR ?() ;)
                4. Result in `TC_1`, ``variableDeclarationIR` as `parserStatementIR``
      2. Assert that `initializerOpt` has type `initializer`.
        1. Let `(= expression_init)` be `initializerOpt` as `initializer`
        2. Let [`typeIR` be the result of typing ``type` as `typeOrVoid``, under cursor `(local)` and typing context `TC_0'`,
           and `tid*` be the set of inserted type variables](Type_ok)
        3. Assert that tid* matches pattern [].
          1.  If [`typeIR` is a well-formed type, assuming bound type ids ``$bound((local), TC_0')``](Type_wf), then:
              1. Assert that `$is_assignable_typeIR(typeIR)`.
                1. Let [`typedExpressionIR_init` be the result of typing `expression_init`, under cursor `(local)` and typing context `TC_0'`](Expr_ok)
                2. Let `typedExpressionIR?` be `$coerce_unary(typedExpressionIR_init, typeIR)`
                3. Assert that typedExpressionIR? matches pattern (_).
                  1. Let `?(typedExpressionIR_init_cast)` be typedExpressionIR?
                  2. Let `nameIR` be `$name(name)`
                  3. Let `TC_1` be `$add_var((local), TC_0', nameIR, ((inout) typeIR (dyn) ?()))`
                  4. Let `variableDeclarationIR` be (annotationList typeIR nameIR ?((= typedExpressionIR_init_cast)) ;)
                  5. Result in `TC_1`, ``variableDeclarationIR` as `parserStatementIR``

  3. Case `parserStatement''` has type `emptyStatement`
    1. Let `emptyStatement` be `parserStatement''` as `emptyStatement`
    2. Group emptyStatement: TC, `emptyStatement` as `parserStatement`

      1. (Stmt_ok: (local) TC_0' (cont) |- `emptyStatement` as `statement` : typingContext flow statementIR)
      2. Assert that (typingContext = TC_0').
        1. Assert that flow matches pattern `CONT`.
          1. Assert that `statementIR` has type `emptyStatementIR`.
            1. Let `emptyStatementIR` be `statementIR` as `emptyStatementIR`
            2. Result in `TC_0'`, ``emptyStatementIR` as `parserStatementIR``

  4. Case `parserStatement''` has type `assignmentStatement`
    1. Let `assignmentStatement` be `parserStatement''` as `assignmentStatement`
    2. Group assignmentStatement: TC_0, `assignmentStatement` as `parserStatement`

      1. (Stmt_ok: (local) TC_0' (cont) |- `assignmentStatement` as `statement` : TC_1 flow statementIR)
      2. Assert that flow matches pattern `CONT`.
        1. Assert that `statementIR` has type `assignmentStatementIR`.
          1. Let `assignmentStatementIR` be `statementIR` as `assignmentStatementIR`
          2. Result in `TC_1`, ``assignmentStatementIR` as `parserStatementIR``

  5. Case `parserStatement''` has type `callStatement`
    1. Let `callStatement` be `parserStatement''` as `callStatement`
    2. Group callStatement: TC_0, `callStatement` as `parserStatement`

      1. (Stmt_ok: (local) TC_0' (cont) |- `callStatement` as `statement` : TC_1 flow statementIR)
      2. Assert that flow matches pattern `CONT`.
        1. Assert that `statementIR` has type `callStatementIR`.
          1. Let `callStatementIR` be `statementIR` as `callStatementIR`
          2. Result in `TC_1`, ``callStatementIR` as `parserStatementIR``

  6. Case `parserStatement''` has type `directApplicationStatement`
    1. Let `directApplicationStatement` be `parserStatement''` as `directApplicationStatement`
    2. Group directApplicationStatement: TC_0, `directApplicationStatement` as `parserStatement`

      1. (Stmt_ok: (local) TC_0' (cont) |- `directApplicationStatement` as `statement` : TC_1 flow statementIR)
      2. Assert that flow matches pattern `CONT`.
        1. Assert that `statementIR` has type `directApplicationStatementIR`.
          1. Let `directApplicationStatementIR` be `statementIR` as `directApplicationStatementIR`
          2. Result in `TC_1`, ``directApplicationStatementIR` as `parserStatementIR``

  7. Case `parserStatement''` has type `parserBlockStatement`
    1. Let `(annotationList { parserStatementList })` be `parserStatement''` as `parserBlockStatement`
    2. Group parserBlockStatement: TC_0, `(annotationList { parserStatementList })` as `parserStatement`

      1. Let `parserStatement*` be `$flatten_parserStatementList(parserStatementList)`
      2. Let `TC_1` be `$enter(TC_0')`
      3. (ParserStmts_ok: TC_1 |- parserStatement* : TC_2 parserStatementIR*)
      4. Let `TC_3` be `$exit(TC_2)`
      5. Let `parserBlockStatementIR` be (annotationList { parserStatementIR* })
      6. Result in `TC_1`, ``parserBlockStatementIR` as `parserStatementIR``

  8. Case `parserStatement''` has type `conditionalStatement`
    1. Let `conditionalStatement` be `parserStatement''` as `conditionalStatement`
    2. Group conditionalStatement: TC_0, `conditionalStatement` as `parserStatement`

      1. (Stmt_ok: (local) TC_0' (cont) |- `conditionalStatement` as `statement` : TC_1 flow statementIR)
      2. Assert that flow matches pattern `CONT`.
        1. Assert that `statementIR` has type `conditionalStatementIR`.
          1. Let `conditionalStatementIR` be `statementIR` as `conditionalStatementIR`
          2. Result in `TC_1`, ``conditionalStatementIR` as `parserStatementIR``

