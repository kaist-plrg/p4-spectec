          2. (Expr_inst: p IC STO_1 |- typedExpressionIR_r ==> STO_2 value_r)
          3. Result in `STO_2`, ``$bin_shl(value_l, value_r)``

        9. Case `binop` matches pattern `>>`
          1. (Expr_inst: p IC STO' |- typedExpressionIR_l ==> STO_1 value_l)
          2. (Expr_inst: p IC STO_1 |- typedExpressionIR_r ==> STO_2 value_r)
          3. Result in `STO_2`, ``$bin_shr(value_l, value_r)``

        10. Case `binop` matches pattern `<=`
          1. (Expr_inst: p IC STO' |- typedExpressionIR_l ==> STO_1 value_l)
          2. (Expr_inst: p IC STO_1 |- typedExpressionIR_r ==> STO_2 value_r)
          3. Result in `STO_2`, ``(b `$bin_le(value_l, value_r)`)` as `value``

        11. Case `binop` matches pattern `>=`
          1. (Expr_inst: p IC STO' |- typedExpressionIR_l ==> STO_1 value_l)
          2. (Expr_inst: p IC STO_1 |- typedExpressionIR_r ==> STO_2 value_r)
          3. Result in `STO_2`, ``(b `$bin_ge(value_l, value_r)`)` as `value``

        12. Case `binop` matches pattern `<`
          1. (Expr_inst: p IC STO' |- typedExpressionIR_l ==> STO_1 value_l)
          2. (Expr_inst: p IC STO_1 |- typedExpressionIR_r ==> STO_2 value_r)
          3. Result in `STO_2`, ``(b `$bin_lt(value_l, value_r)`)` as `value``

        13. Case `binop` matches pattern `>`
          1. (Expr_inst: p IC STO' |- typedExpressionIR_l ==> STO_1 value_l)
          2. (Expr_inst: p IC STO_1 |- typedExpressionIR_r ==> STO_2 value_r)
          3. Result in `STO_2`, ``(b `$bin_gt(value_l, value_r)`)` as `value``

        14. Case `binop` matches pattern `==`
          1. (Expr_inst: p IC STO' |- typedExpressionIR_l ==> STO_1 value_l)
          2. (Expr_inst: p IC STO_1 |- typedExpressionIR_r ==> STO_2 value_r)
          3. Result in `STO_2`, ``(b `$bin_eq(value_l, value_r)`)` as `value``

        15. Case `binop` matches pattern `!=`
          1. (Expr_inst: p IC STO' |- typedExpressionIR_l ==> STO_1 value_l)
          2. (Expr_inst: p IC STO_1 |- typedExpressionIR_r ==> STO_2 value_r)
          3. Result in `STO_2`, ``(b `$bin_ne(value_l, value_r)`)` as `value``

        16. Case `binop` matches pattern `&`
          1. (Expr_inst: p IC STO' |- typedExpressionIR_l ==> STO_1 value_l)
          2. (Expr_inst: p IC STO_1 |- typedExpressionIR_r ==> STO_2 value_r)
          3. Result in `STO_2`, ``$bin_band(value_l, value_r)``

        17. Case `binop` matches pattern `^`
          1. (Expr_inst: p IC STO' |- typedExpressionIR_l ==> STO_1 value_l)
          2. (Expr_inst: p IC STO_1 |- typedExpressionIR_r ==> STO_2 value_r)
          3. Result in `STO_2`, ``$bin_bxor(value_l, value_r)``

        18. Case `binop` matches pattern `|`
          1. (Expr_inst: p IC STO' |- typedExpressionIR_l ==> STO_1 value_l)
          2. (Expr_inst: p IC STO_1 |- typedExpressionIR_r ==> STO_2 value_r)
          3. Result in `STO_2`, ``$bin_bor(value_l, value_r)``

        19. Case `binop` matches pattern `++`
          1. (Expr_inst: p IC STO' |- typedExpressionIR_l ==> STO_1 value_l)
          2. (Expr_inst: p IC STO_1 |- typedExpressionIR_r ==> STO_2 value_r)
          3. Result in `STO_2`, ``$bin_concat(value_l, value_r)``

        20. Case `binop` matches pattern `&&`
          1. (Expr_inst: p IC STO' |- typedExpressionIR_l ==> STO_1 value_l)
          2. (Expr_inst: p IC STO_1 |- typedExpressionIR_r ==> STO_2 value_r)
          3. Result in `STO_2`, ``$bin_land(value_l, value_r)``

        21. Case `binop` matches pattern `||`
          1. (Expr_inst: p IC STO' |- typedExpressionIR_l ==> STO_1 value_l)
          2. (Expr_inst: p IC STO_1 |- typedExpressionIR_r ==> STO_2 value_r)
          3. Result in `STO_2`, ``$bin_lor(value_l, value_r)``

  8. Case `expressionIR` has type `ternaryExpressionIR`
    1. Let `(typedExpressionIR_cond ? typedExpressionIR_true : typedExpressionIR_false)` be `expressionIR` as `ternaryExpressionIR`
    2. Group ternaryExpressionIR: p, IC, STO_0, (`(typedExpressionIR_cond ? typedExpressionIR_true : typedExpressionIR_false)` as `expressionIR` # _expressionNoteIR)

      1. (Expr_inst: p IC STO' |- typedExpressionIR_cond ==> STO_1 value)
      2. Assert that (value = `(b true)` as `value`).
        1. (Expr_inst: p IC STO_1 |- typedExpressionIR_true ==> STO_2 value_true)
        2. Result in `STO_2`, `value_true`
      3. Assert that (value = `(b false)` as `value`).
        1. (Expr_inst: p IC STO_1 |- typedExpressionIR_false ==> STO_2 value_false)
        2. Result in `STO_2`, `value_false`

  9. Case `expressionIR` has type `castExpressionIR`
    1. Let `(( typeIR ) typedExpressionIR)` be `expressionIR` as `castExpressionIR`
    2. Group castExpressionIR: p, IC, STO_0, (`(( typeIR ) typedExpressionIR)` as `expressionIR` # _expressionNoteIR)

      1. (Expr_inst: p IC STO' |- typedExpressionIR ==> STO_1 value)
      2. Let `value_cast` be `$cast_op(typeIR, value)`
      3. Result in `STO_1`, `value_cast`

  10. Case `expressionIR` has type `dataExpressionIR`
    1. Let `dataExpressionIR` be `expressionIR` as `dataExpressionIR`
    2. Assert that dataExpressionIR matches pattern `{#}`.
      1. Group dataExpressionIR-invalid: p, IC, STO, (`({#})` as `expressionIR` # _expressionNoteIR)

        1. Result in `STO'`, ``({#})` as `value``
    3. Group dataExpressionIR-sequence: p, IC, STO_0, (`dataExpressionIR` as `expressionIR` # _expressionNoteIR)

      1. Case analysis on `dataExpressionIR`
        1. Case `dataExpressionIR` matches pattern `SEQ{%}`
          1. Let `(seq{ typedExpressionListIR })` be dataExpressionIR
          2. (Exprs_inst: p IC STO' |- typedExpressionListIR ==> STO_1 value*)
          3. Result in `STO_1`, ``(seq( value* ))` as `value``

        2. Case `dataExpressionIR` matches pattern `SEQ{%,...}`
          1. Let `(seq{ typedExpressionListIR ,...})` be dataExpressionIR
          2. (Exprs_inst: p IC STO' |- typedExpressionListIR ==> STO_1 value*)
          3. Result in `STO_1`, ``(seq( value* ,...))` as `value``
    4. Group dataExpressionIR-record: p, IC, STO_0, (`dataExpressionIR` as `expressionIR` # _expressionNoteIR)

      1. Case analysis on `dataExpressionIR`
        1. Case `dataExpressionIR` matches pattern `RECORD{%}`
          1. Let `(record{ (nameIR = typedExpressionIR)* })` be dataExpressionIR
          2. (Exprs_inst: p IC STO' |- typedExpressionIR* ==> STO_1 value*)
          3. Result in `STO_1`, ``(record{ (value nameIR ;)* })` as `value``

        2. Case `dataExpressionIR` matches pattern `RECORD{%,...}`
          1. Let `(record{ (nameIR = typedExpressionIR)* ,...})` be dataExpressionIR
          2. (Exprs_inst: p IC STO' |- typedExpressionIR* ==> STO_1 value*)
          3. Result in `STO_1`, ``(record{ (value nameIR ;)* ,...})` as `value``

  11. Case `expressionIR` has type `errorAccessExpressionIR`
    1. Let `(error. nameIR)` be `expressionIR` as `errorAccessExpressionIR`
    2. Group accessExpressionIR-errorAccessExpressionIR: p, IC, STO, (`(error. nameIR)` as `expressionIR` # _expressionNoteIR)

      1. Let `nameIR_error` be "error." ++ nameIR
      2. Let `value_error` be `$find_value_inst(p, IC, (` nameIR_error))`
      3. Result in `STO'`, `value_error`

  12. Case `expressionIR` has type `memberAccessExpressionIR`
    1. Let `(memberAccessBaseIR . nameIR)` be `expressionIR` as `memberAccessExpressionIR`
    2. Assert that memberAccessBaseIR matches pattern `TYPE%`.
      1. Let `(type prefixedNameIR)` be memberAccessBaseIR
      2. Group accessExpressionIR-memberAccessExpressionIR-type: p, IC, STO, (`((type prefixedNameIR) . nameIR)` as `expressionIR` # _expressionNoteIR)

        1. Let `typeDefIR'?` be `$find_typedef_inst(p, IC, prefixedNameIR)`
        2. Assert that typeDefIR'? matches pattern (_).
          1. Let `?(typeDefIR)` be typeDefIR'?
          2. Assert that `typeDefIR` has type `enumTypeIR`.
            1. Let `enumTypeIR` be `typeDefIR` as `enumTypeIR`
            2. Case analysis on `enumTypeIR`
              1. Case `enumTypeIR` matches pattern `ENUM%{%}`
                1. Let `(enum tid { _id* })` be enumTypeIR
                2. Result in `STO'`, ``(tid . nameIR)` as `value``

              2. Case `enumTypeIR` matches pattern `ENUM%#%{%}`
                1. Let `(enum tid # _typeIR { (id_member = value_member ;)* })` be enumTypeIR
                2. Let `value'?` be `$assoc_<nameIR, value>(nameIR, (id_member, value_member)*)`
                3. Assert that value'? matches pattern (_).
                  1. Let `?(value)` be value'?
                  2. Result in `STO'`, ``(tid . nameIR # value)` as `value``
2. Let `(( typeIR_base _ctk ))` be _expressionNoteIR'
3. Case analysis on `expressionIR`
  1. Case `expressionIR` has type `memberAccessExpressionIR`
    1. Let `(memberAccessBaseIR . text)` be `expressionIR` as `memberAccessExpressionIR`
    2. Assert that `memberAccessBaseIR` has type `typedExpressionIR`.
      1. Let `typedExpressionIR_base` be `memberAccessBaseIR` as `typedExpressionIR`
      2. Assert that (text = "size").
        1. Group accessExpressionIR-memberAccessExpressionIR-typedExpressionIR-stack-size: p, IC, STO, (`(`typedExpressionIR_base` as `memberAccessBaseIR` . "size")` as `expressionIR` # (( typeIR_base _ctk )))

          1. Let `(_expressionIR # (( typeIR _ctk' )))` be typedExpressionIR_base
          2. Assert that (typeIR = typeIR_base).
            1. Let `typeIR'` be `$canon(typeIR_base)`
            2. Assert that `typeIR'` has type `headerStackTypeIR`.
              1. Let `(_typeIR [ n_size ])` be `typeIR'` as `headerStackTypeIR`
              2. Result in `STO'`, ``(d `n_size` as `int`)` as `value``

  2. Case `expressionIR` has type `indexAccessExpressionIR`
    1. Let `indexAccessExpressionIR` be `expressionIR` as `indexAccessExpressionIR`
    2. Assert that indexAccessExpressionIR matches pattern `%[%:%]`.
      1. Let `(typedExpressionIR_base [ typedExpressionIR_hi : typedExpressionIR_lo ])` be indexAccessExpressionIR
      2. Group indexAccessExpressionIR-bitslice: p, IC, STO_0, (`(typedExpressionIR_base [ typedExpressionIR_hi : typedExpressionIR_lo ])` as `expressionIR` # _expressionNoteIR)

        1. (Expr_inst: p IC STO' |- typedExpressionIR_base ==> STO_1 value_base)
        2. (Expr_inst: p IC STO_1 |- typedExpressionIR_hi ==> STO_2 value_hi)
        3. (Expr_inst: p IC STO_2 |- typedExpressionIR_lo ==> STO_3 value_lo)
        4. Result in `STO_3`, ``$bitacc_op(value_base, value_hi, value_lo)``

  3. Case `expressionIR` has type `callExpressionIR`
    1. Let `callExpressionIR` be `expressionIR` as `callExpressionIR`
    2. Case analysis on `callExpressionIR`
      1. Case `callExpressionIR` matches pattern `%(%)`
        1. Let `((prefixedNameIR < typeArgumentListIR >) ( argumentListIR ))` be callExpressionIR
        2. Group callExpressionIR-instantiation: p, IC, STO_0, (`((prefixedNameIR < typeArgumentListIR >) ( argumentListIR ))` as `expressionIR` # _expressionNoteIR)

          1. Let `(cid, constructor, id*)?` be `$find_constructor_inst(IC, prefixedNameIR, argumentListIR)`
          2. Assert that (cid, constructor, id*)? matches pattern (_).
            1. Let `?((_cid, constructor, id_default*))` be (cid, constructor, id*)?
            2. (Constructor_inst: p IC STO' |- constructor < typeArgumentListIR >( argumentListIR # id_default* )==> STO_1 object)
            3. Let `STO_2` be `$add_map<oid, object>(STO_1, IC.path, object)`
            4. Let `value_ref` be `(! IC.path)` as `value`
            5. Result in `STO_2`, `value_ref`

      2. Case `callExpressionIR` matches pattern `%<%>(%)`
        1. Let `(routineTargetIR < typeArgumentIR* >( argumentIR* ))` be callExpressionIR
        2. Case analysis on `routineTargetIR`
          1. Case `routineTargetIR` matches pattern `%.%`
            1. Let `(typedExpressionIR_base . nameIR)` be routineTargetIR
            2. Assert that typeArgumentIR* matches pattern [].
              1. Assert that argumentIR* matches pattern [].
                1. Group callExpressionIR-typedeExpressionIR-size: p, IC, STO, (`((typedExpressionIR_base . nameIR) < [] >( [] ))` as `expressionIR` # _expressionNoteIR)

                  1. Let `(_expressionIR # (( typeIR_base _ctk )))` be typedExpressionIR_base
                  2. Assert that nameIR is in ["minSizeInBits", "minSizeInBytes", "maxSizeInBits", "maxSizeInBytes"].
                    1. Result in `STO'`, ``$sizeof(typeIR_base, nameIR)``

          2. Case `routineTargetIR` matches pattern `TYPE%.%`
            1. Let `(type prefixedNameIR . nameIR)` be routineTargetIR
            2. Assert that typeArgumentIR* matches pattern [].
              1. Assert that argumentIR* matches pattern [].
                1. Group callExpressionIR-type: p, IC, STO, (`((type prefixedNameIR . nameIR) < [] >( [] ))` as `expressionIR` # _expressionNoteIR)

                  1. Let `typeDefIR'?` be `$find_typedef_inst(p, IC, prefixedNameIR)`
                  2. Assert that typeDefIR'? matches pattern (_).
                    1. Let `?(typeDefIR)` be typeDefIR'?
                    2. Case analysis on `typeDefIR`
                      1. Case `typeDefIR` has type `typeIR`
                        1. Let `typeIR_base` be `typeDefIR` as `typeIR`
                        2. Assert that nameIR is in ["minSizeInBits", "minSizeInBytes", "maxSizeInBits", "maxSizeInBytes"].
                          1. Result in `STO'`, ``$sizeof(typeIR_base, nameIR)``

                      2. Case `typeDefIR` has type `polyTypeDefIR`
                        1. Let `(typeIR_base < tid* , tid'* >)` be `typeDefIR` as `polyTypeDefIR`
                        2. Assert that tid* matches pattern [].
                          1. Assert that tid'* matches pattern [].
                            1. Assert that nameIR is in ["minSizeInBits", "minSizeInBytes", "maxSizeInBits", "maxSizeInBytes"].
                              1. Result in `STO'`, ``$sizeof(typeIR_base, nameIR)``
        3. Let `(routineTargetIR' < typeArgumentListIR >( argumentListIR ))` be callExpressionIR
        4. Assert that routineTargetIR' matches pattern `(%)`.
          1. Let `(( routineTargetIR ))` be routineTargetIR'
          2. Group callExpressionIR-parenthesized: p, IC, STO_0, (`((( routineTargetIR )) < typeArgumentListIR >( argumentListIR ))` as `expressionIR` # expressionNoteIR)

            1. (Expr_inst: p IC STO' |- (`(routineTargetIR < typeArgumentListIR >( argumentListIR ))` as `expressionIR` # _expressionNoteIR') ==> STO_1 value)
            2. Result in `STO_1`, `value`

  4. Case `expressionIR` has type `parenthesizedExpressionIR`
    1. Let `(( typedExpressionIR ))` be `expressionIR` as `parenthesizedExpressionIR`
    2. Group parenthesizedExpressionIR: p, IC, STO_0, (`(( typedExpressionIR ))` as `expressionIR` # _expressionNoteIR)

      1. (Expr_inst: p IC STO' |- typedExpressionIR ==> STO_1 value)
      2. Result in `STO_1`, `value`

;; ../../../../spec-concrete/7.03-instantiation-relation.watsup:9.1-11.26
relation Exprs_inst: p, IC, STO', typedExpressionIR*

1. Case analysis on `typedExpressionIR*`
  1. Case `typedExpressionIR*` matches pattern []
    1. Group nil: p, IC, STO, []

      1. Result in `STO'`, `[]`

  2. Case `typedExpressionIR*` matches pattern _ :: _
    1. Let `typedExpressionIR_h :: typedExpressionIR_t*` be typedExpressionIR*
    2. Group cons: p, IC, STO_0, typedExpressionIR_h :: typedExpressionIR_t*

      1. (Expr_inst: p IC STO' |- typedExpressionIR_h ==> STO_1 value_h)
      2. (Exprs_inst: p IC STO_1 |- typedExpressionIR_t* ==> STO_2 value_t*)
      3. Result in `STO_2`, `value_h :: value_t*`

;; ../../../../spec-concrete/7.03-instantiation-relation.watsup:17.1-19.26
relation Argument_inst: p, IC, STO_0, argumentIR

1. Assert that `argumentIR` has type `typedExpressionIR`.
  1. Let `typedExpressionIR` be `argumentIR` as `typedExpressionIR`
  2. Group typedExpressionIR: p, IC, STO_0, `typedExpressionIR` as `argumentIR`

    1. (Expr_inst: p IC STO_0 |- typedExpressionIR ==> STO_1 value)
    2. Result in `STO_1`, `value`
2. Assert that argumentIR matches pattern `%=%`.
  1. Let `(nameIR = typedExpressionIR)` be argumentIR
  2. Group nameIR-typedExpressionIR: p, IC, STO_0, (nameIR = typedExpressionIR)

    1. (Expr_inst: p IC STO_0 |- typedExpressionIR ==> STO_1 value)
    2. Result in `STO_1`, `value`

;; ../../../../spec-concrete/7.03-instantiation-relation.watsup:25.1-28.26
relation Stmt_inst: p', IC', STO', statementIR

1. Case analysis on `statementIR`
  1. Case `statementIR` has type `emptyStatementIR`
    1. Let `emptyStatementIR` be `statementIR` as `emptyStatementIR`
    2. Group emptyStatementIR: p, IC, STO, `emptyStatementIR` as `statementIR`

      1. Result in `IC'`, `STO'`, ``emptyStatementIR` as `statementIR``

  2. Case `statementIR` has type `assignmentStatementIR`
    1. Let `assignmentStatementIR` be `statementIR` as `assignmentStatementIR`
    2. Group assignmentStatementIR: p, IC, STO, `assignmentStatementIR` as `statementIR`

      1. Result in `IC'`, `STO'`, ``assignmentStatementIR` as `statementIR``

  3. Case `statementIR` has type `callStatementIR`
    1. Let `callStatementIR` be `statementIR` as `callStatementIR`
    2. Group callStatementIR: p, IC, STO, `callStatementIR` as `statementIR`

      1. Result in `IC'`, `STO'`, ``callStatementIR` as `statementIR``

  4. Case `statementIR` has type `directApplicationStatementIR`
    1. Let `(prefixedNameIR .apply( argumentListIR );)` be `statementIR` as `directApplicationStatementIR`
    2. Group directApplicationStatementIR: p, IC, STO_0, `(prefixedNameIR .apply( argumentListIR );)` as `statementIR`

      1. Let `(cid, constructor, id*)?` be `$find_constructor_inst(IC', prefixedNameIR, [])`
      2. Assert that (cid, constructor, id*)? matches pattern (_).
        1. Let `?((_cid, constructor, _id*))` be (cid, constructor, id*)?
        2. (Constructor_inst: p' IC' STO' |- constructor < [] >( [] # [] )==> STO_1 object)
        3. Let `tid_fresh` be `$fresh_tid`
        4. Let `tid` be `$flatten_prefixedNameIR(prefixedNameIR)`
        5. Let `typeIR` be `(tid tid)` as `typeIR`
        6. Let `nameIR` be `$concat_text([tid, "_", tid_fresh])`
        7. Let `oid` be IC'.path ++ [nameIR]
        8. Let `STO_2` be `$add_map<oid, object>(STO_1, oid, object)`
        9. Let `constantDeclarationIR` be (() const typeIR nameIR (= `(! oid)` as `value`) ;)
        10. Let `routineTargetIR` be ((`(` tid)` as `expressionIR` # (( typeIR (ctk) ))) . "apply")
        11. Let `callStatementIR` be (routineTargetIR < [] >( argumentListIR );)
        12. Let `blockStatementIR` be (() { [`constantDeclarationIR` as `blockElementStatementIR`, `callStatementIR` as `blockElementStatementIR`] })
        13. Result in `IC'`, `STO_2`, ``blockStatementIR` as `statementIR``

  5. Case `statementIR` has type `exitStatementIR`
    1. Let `exitStatementIR` be `statementIR` as `exitStatementIR`
    2. Group exitStatementIR: p, IC, STO, `exitStatementIR` as `statementIR`

      1. Result in `IC'`, `STO'`, ``exitStatementIR` as `statementIR``

  6. Case `statementIR` has type `conditionalStatementIR`
    1. Let `conditionalStatementIR` be `statementIR` as `conditionalStatementIR`
    2. Group conditionalStatementIR: p, IC_0, STO_0, `conditionalStatementIR` as `statementIR`

      1. Case analysis on `conditionalStatementIR`
        1. Case `conditionalStatementIR` matches pattern `IF(%)%`
          1. Let `(if( typedExpressionIR_cond ) statementIR_then)` be conditionalStatementIR
          2. (Stmt_inst: p' IC' STO' |- statementIR_then ==> IC_1 STO_1 statementIR_then_inst)
          3. Result in `IC_1`, `STO_1`, ``(if( typedExpressionIR_cond ) statementIR_then_inst)` as `statementIR``

        2. Case `conditionalStatementIR` matches pattern `IF(%)%ELSE%`
          1. Let `(if( typedExpressionIR_cond ) statementIR_then else statementIR_else)` be conditionalStatementIR
          2. (Stmt_inst: p' IC' STO' |- statementIR_then ==> IC_1 STO_1 statementIR_then_inst)
          3. (Stmt_inst: p' IC_1 STO_1 |- statementIR_else ==> IC_2 STO_2 statementIR_else_inst)
          4. Result in `IC_2`, `STO_2`, ``(if( typedExpressionIR_cond ) statementIR_then_inst else statementIR_else_inst)` as `statementIR``

  7. Case `statementIR` has type `switchStatementIR`
    1. Let `(switch( typedExpressionIR ){ switchCaseListIR })` be `statementIR` as `switchStatementIR`
    2. Group switchStatementIR: p, IC_0, STO_0, `(switch( typedExpressionIR ){ switchCaseListIR })` as `statementIR`

      1. (SwitchCases_inst: p' IC' STO' |- switchCaseListIR ==> IC_1 STO_1 switchCaseListIR_inst)
      2. Result in `IC_1`, `STO_1`, ``(switch( typedExpressionIR ){ switchCaseListIR_inst })` as `statementIR``
2. Assert that p' matches pattern `LOCAL`.
  1. Case analysis on `statementIR`
    1. Case `statementIR` has type `returnStatementIR`
      1. Let `returnStatementIR` be `statementIR` as `returnStatementIR`
      2. Group returnStatementIR: (local), IC, STO, `returnStatementIR` as `statementIR`

        1. Result in `IC'`, `STO'`, ``returnStatementIR` as `statementIR``

    2. Case `statementIR` has type `blockStatementIR`
      1. Let `(annotationList { blockElementStatementListIR })` be `statementIR` as `blockStatementIR`
      2. Group blockStatementIR: (local), IC_0, STO_0, `(annotationList { blockElementStatementListIR })` as `statementIR`

        1. (Block_inst: IC' STO' |- (annotationList { blockElementStatementListIR }) ==> IC_1 STO_1 (_annotationList { blockElementStatementListIR_inst }))
        2. Result in `IC_1`, `STO_1`, ``(annotationList { blockElementStatementListIR_inst })` as `statementIR``

;; ../../../../spec-concrete/7.03-instantiation-relation.watsup:30.1-33.23
relation BlockElementStmt_inst: IC_0', STO_0', blockElementStatementIR

1. Case analysis on `blockElementStatementIR`
  1. Case `blockElementStatementIR` has type `constantDeclarationIR`
    1. Let `constantDeclarationIR` be `blockElementStatementIR` as `constantDeclarationIR`
    2. Group constantDeclarationIR: IC_0, STO_0, `constantDeclarationIR` as `blockElementStatementIR`

      1. (Decl_inst: (local) IC_0' STO_0' |- `constantDeclarationIR` as `declarationIR` ==> IC_1 STO_1 declarationIR'?)
      2. Assert that declarationIR'? matches pattern (_).
