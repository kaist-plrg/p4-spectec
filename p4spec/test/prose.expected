;; ../../../../spec-concrete/7.06-instantiation-statement.watsup:103.1-106.26
relation SwitchCase_inst: p, IC_0', STO_0', switchCaseIR

1. Case analysis on `switchCaseIR`
  1. Case `switchCaseIR` matches pattern `%:%`
    1. Let `(switchLabelIR : blockStatementIR)` be switchCaseIR
    2. Group match: p, IC_0, STO_0, (switchLabelIR : blockStatementIR)

      1. (Stmt_inst: p IC_0' STO_0' |- `blockStatementIR` as `statementIR` ==> IC_1 STO_1 statementIR)
      2. Assert that `statementIR` has type `blockStatementIR`.
        1. Let `blockStatementIR_inst` be `statementIR` as `blockStatementIR`
        2. Result in `IC_1`, `STO_1`, `(switchLabelIR : blockStatementIR_inst)`

  2. Case `switchCaseIR` matches pattern `%:`
    1. Let `(switchLabelIR :)` be switchCaseIR
    2. Group fallthrough: p, IC, STO, (switchLabelIR :)

      1. Result in `IC_0'`, `STO_0'`, `(switchLabelIR :)`

;; ../../../../spec-concrete/7.06-instantiation-statement.watsup:123.1-126.26
relation SwitchCases_inst: p, IC', STO', switchCaseIR*

1. Case analysis on `switchCaseIR*`
  1. Case `switchCaseIR*` matches pattern []
    1. Group nil: p, IC, STO, []

      1. Result in `IC'`, `STO'`, `[]`

  2. Case `switchCaseIR*` matches pattern _ :: _
    1. Let `switchCaseIR_h :: switchCaseIR_t*` be switchCaseIR*
    2. Group cons: p, IC_0, STO_0, switchCaseIR_h :: switchCaseIR_t*

      1. (SwitchCase_inst: p IC' STO' |- switchCaseIR_h ==> IC_1 STO_1 switchCaseIR_h')
      2. (SwitchCases_inst: p IC_1 STO_1 |- switchCaseIR_t* ==> IC_2 STO_2 switchCaseIR_t'*)
      3. Result in `IC_2`, `STO_2`, `switchCaseIR_h' :: switchCaseIR_t'*`

;; ../../../../spec-concrete/7.07-instantiation-declaration.watsup:35.1-35.36
def $merge_venvs(venv, ({ (id : value)* }))

1. Return `$adds_map<id, value>(venv, id*, value*)`

;; ../../../../spec-concrete/7.07-instantiation-declaration.watsup:41.1-41.47
def $merge_renv_with_extern(renv, set<pair<rid, routine>>')

1. Assert that (set<pair<rid, routine>>' = ({ [] })).
  1. Return renv
2. Let `({ pair<rid, routine>* })` be set<pair<rid, routine>>'
3. Assert that pair<rid, routine>* matches pattern _ :: _.
  1. Let `(rid_h : routine_h) :: (rid_t : routine_t)*` be pair<rid, routine>*
  2. Assert that `routine_h` has type `function`.
    1. Let `function` be `routine_h` as `function`
    2. Assert that function matches pattern `FUNCTION<%>(%)%`.
      1. Let `(function< typeParameterListIR >( parameterListIR ) blockStatementIR)` be function
      2. Let `routine_h_post` be `(extern_method< typeParameterListIR >( parameterListIR ) ?(blockStatementIR))` as `routine`
      3. Let `renv_post` be `$update_map<rid, routine>(renv, rid_h, routine_h_post)`
      4. Return `$merge_renv_with_extern(renv_post, ({ (rid_t : routine_t)* }))`

;; ../../../../spec-concrete/7.07-instantiation-declaration.watsup:242.1-242.90
def $split_constructors_IR(methodPrototypeIR*)

1. Case analysis on `methodPrototypeIR*`
  1. Case `methodPrototypeIR*` matches pattern []
    1. Return ([], [])

  2. Case `methodPrototypeIR*` matches pattern _ :: _
    1. Let `methodPrototypeIR_h :: methodPrototypeIR_t*` be methodPrototypeIR*
    2. Case analysis on `methodPrototypeIR_h`
      1. Case `methodPrototypeIR_h` matches pattern `%%<,%>(%);`
        1. Let `(_annotationList _nameIR <, _typeParameterListIR >( _parameterListIR );)` be methodPrototypeIR_h
        2. Let `(methodPrototypeIR_t_constructor*, methodPrototypeIR_t_method*)` be `$split_constructors_IR(methodPrototypeIR_t*)`
        3. Return (methodPrototypeIR_h :: methodPrototypeIR_t_constructor*, methodPrototypeIR_t_method*)

      2. Case `methodPrototypeIR_h` matches pattern `%%;`
        1. Let `(_annotationList _functionPrototypeIR ;)` be methodPrototypeIR_h
        2. Let `(methodPrototypeIR_t_constructor*, methodPrototypeIR_t_method*)` be `$split_constructors_IR(methodPrototypeIR_t*)`
        3. Return (methodPrototypeIR_t_constructor*, methodPrototypeIR_h :: methodPrototypeIR_t_method*)

      3. Case `methodPrototypeIR_h` matches pattern `%ABSTRACT%;`
        1. Let `(_annotationList abstract _functionPrototypeIR ;)` be methodPrototypeIR_h
        2. Let `(methodPrototypeIR_t_constructor*, methodPrototypeIR_t_method*)` be `$split_constructors_IR(methodPrototypeIR_t*)`
        3. Return (methodPrototypeIR_t_constructor*, methodPrototypeIR_h :: methodPrototypeIR_t_method*)

;; ../../../../spec-concrete/7.11-instantiation-constructor-call.watsup:7.1-8.33
def $partition_default_parameters(parameterIR*, id_default*)

1. Case analysis on `parameterIR*`
  1. Case `parameterIR*` matches pattern []
    1. Return ([], [])

  2. Case `parameterIR*` matches pattern _ :: _
    1. Let `parameterIR_h :: parameterIR_t*` be parameterIR*
    2. Let `(_annotationList _direction _typeIR id_h _constantInitializerOptIR)` be parameterIR_h
    3. Let `(parameterIR_nondefault*, parameterIR_default*)` be `$partition_default_parameters(parameterIR_t*, id_default*)`
    4. Case analysis on `id_h is in id_default*`
      1. Case true
        1. Return (parameterIR_nondefault*, parameterIR_h :: parameterIR_default*)

      2. Case false
        1. Return (parameterIR_h :: parameterIR_nondefault*, parameterIR_default*)

;; ../../../../spec-concrete/7.11-instantiation-constructor-call.watsup:33.1-34.76
def $align_cparams_with_args(constructorParameterIR*, argumentIR*, id_default*)

1. Let `(constructorParameterIR_non_default*, constructorParameterIR_default*)` be `$partition_default_parameters(constructorParameterIR*, id_default*)`
2. Let `(_annotationList _direction _typeIR id _constantInitializerOptIR)` be constructorParameterIR_non_default, for each `_annotationList` in `_annotationList*` and `_constantInitializerOptIR` in `_constantInitializerOptIR*` and `_direction` in `_direction*` and `_typeIR` in `_typeIR*` and `constructorParameterIR_non_default` in `constructorParameterIR_non_default*` and `id` in `id*`
3. Let `(constructorParameterIR_aligned*, argumentIR_aligned*)` be `$align_cparams_with_args'(({ (id : constructorParameterIR_non_default)* }), constructorParameterIR_non_default*, argumentIR*)`
4. Let `(_annotationList' _direction' _typeIR' _nameIR constantInitializerOptIR)` be constructorParameterIR_default, for each `_annotationList'` in `_annotationList'*` and `_direction'` in `_direction'*` and `_nameIR` in `_nameIR*` and `_typeIR'` in `_typeIR'*` and `constantInitializerOptIR` in `constantInitializerOptIR*` and `constructorParameterIR_default` in `constructorParameterIR_default*`
5. Assert that constantInitializerOptIR matches pattern (_), for each `constantInitializerOptIR` in `constantInitializerOptIR*`.
  1. Let `?((= value_default))` be constantInitializerOptIR, for each `constantInitializerOptIR` in `constantInitializerOptIR*` and `value_default` in `value_default*`
  2. Return (constructorParameterIR_aligned*, argumentIR_aligned*, constructorParameterIR_default*, value_default*)

;; ../../../../spec-concrete/7.11-instantiation-constructor-call.watsup:35.1-36.43
def $align_cparams_with_args'(({ (id : constructorParameterIR)* }), constructorParameterIR'*, argumentIR*)

