    3. Group dataExpressionIR-sequence: p, TC, (`dataExpressionIR` as `expressionIR` # (( _typeIR _ctk )))

      1. Case analysis on `dataExpressionIR`
        1. Case `dataExpressionIR` matches pattern `SEQ{%}`
          1. Let `(seq{ typedExpressionIR* })` be dataExpressionIR
          2. Let [`value` be the static evaluation of `typedExpressionIR`, under cursor `p` and typing context `TC`](Eval_static), for each `typedExpressionIR` in `typedExpressionIR*` and `value` in `value*`
          3. Result in ``(seq( value* ))` as `value``

        2. Case `dataExpressionIR` matches pattern `SEQ{%,...}`
          1. Let `(seq{ typedExpressionIR* ,...})` be dataExpressionIR
          2. Let [`value` be the static evaluation of `typedExpressionIR`, under cursor `p` and typing context `TC`](Eval_static), for each `typedExpressionIR` in `typedExpressionIR*` and `value` in `value*`
          3. Result in ``(seq( value* ,...))` as `value``
    4. Group dataExpressionIR-record: p, TC, (`dataExpressionIR` as `expressionIR` # (( _typeIR _ctk )))

      1. Case analysis on `dataExpressionIR`
        1. Case `dataExpressionIR` matches pattern `RECORD{%}`
          1. Let `(record{ (nameIR = typedExpressionIR)* })` be dataExpressionIR
          2. Let [`value` be the static evaluation of `typedExpressionIR`, under cursor `p` and typing context `TC`](Eval_static), for each `typedExpressionIR` in `typedExpressionIR*` and `value` in `value*`
          3. Result in ``(record{ (value nameIR ;)* })` as `value``

        2. Case `dataExpressionIR` matches pattern `RECORD{%,...}`
          1. Let `(record{ (nameIR = typedExpressionIR)* ,...})` be dataExpressionIR
          2. Let [`value` be the static evaluation of `typedExpressionIR`, under cursor `p` and typing context `TC`](Eval_static), for each `typedExpressionIR` in `typedExpressionIR*` and `value` in `value*`
          3. Result in ``(record{ (value nameIR ;)* ,...})` as `value``

  11. Case `expressionIR` has type `errorAccessExpressionIR`
    1. Let `(error. nameIR)` be `expressionIR` as `errorAccessExpressionIR`
    2. Group accessExpressionIR-errorAccessExpressionIR: p, TC, (`(error. nameIR)` as `expressionIR` # (( _typeIR _ctk )))

      1. Let `nameIR_error` be "error." ++ nameIR
      2. Let `value_error` be `$find_value(p, TC, (` nameIR_error))`
      3. Result in `value_error`

  12. Case `expressionIR` has type `memberAccessExpressionIR`
    1. Let `(memberAccessBaseIR . nameIR)` be `expressionIR` as `memberAccessExpressionIR`
    2. Assert that memberAccessBaseIR matches pattern `TYPE%`.
      1. Let `(type prefixedNameIR)` be memberAccessBaseIR
      2. Group accessExpressionIR-memberAccessExpressionIR-type: p, TC, (`((type prefixedNameIR) . nameIR)` as `expressionIR` # (( typeIR_base _ctk )))

        1. Let `typeDefIR'?` be `$find_type(p, TC, prefixedNameIR)`
        2. Assert that typeDefIR'? matches pattern (_).
          1. Let `?(typeDefIR)` be typeDefIR'?
          2. Assert that `typeDefIR` has type `enumTypeIR`.
            1. Let `enumTypeIR` be `typeDefIR` as `enumTypeIR`
            2. Case analysis on `enumTypeIR`
              1. Case `enumTypeIR` matches pattern `ENUM%{%}`
                1. Let `(enum tid { id_member* })` be enumTypeIR
                2. Assert that nameIR is in id_member*.
                  1. Result in ``(tid . nameIR)` as `value``

              2. Case `enumTypeIR` matches pattern `ENUM%#%{%}`
                1. Let `(enum tid # typeIR { (id_member = value_member ;)* })` be enumTypeIR
                2. Let `value'?` be `$assoc_<id, value>(nameIR, (id_member, value_member)*)`
                3. Assert that value'? matches pattern (_).
                  1. Let `?(value)` be value'?
                  2. Result in ``(tid . nameIR # value)` as `value``
    3. Assert that `memberAccessBaseIR` has type `typedExpressionIR`.
      1. Let `typedExpressionIR_base` be `memberAccessBaseIR` as `typedExpressionIR`
      2. Assert that (nameIR = "size").
        1. Group accessExpressionIR-memberAccessExpressionIR-typedExpressionIR-stack-size: p, TC, (`(`typedExpressionIR_base` as `memberAccessBaseIR` . "size")` as `expressionIR` # (( _typeIR _ctk )))

          1. Let `(_expressionIR # (( typeIR_base _ctk' )))` be typedExpressionIR_base
          2. Let `typeIR` be `$canon(typeIR_base)`
          3. Assert that `typeIR` has type `headerStackTypeIR`.
            1. Let `(_typeIR' [ n_size ])` be `typeIR` as `headerStackTypeIR`
            2. Result in ``(d `n_size` as `int`)` as `value``

  13. Case `expressionIR` has type `indexAccessExpressionIR`
    1. Let `indexAccessExpressionIR` be `expressionIR` as `indexAccessExpressionIR`
    2. Assert that indexAccessExpressionIR matches pattern `%[%:%]`.
      1. Let `(typedExpressionIR_base [ typedExpressionIR_hi : typedExpressionIR_lo ])` be indexAccessExpressionIR
      2. Group indexAccessExpressionIR-bitslice: p, TC, (`(typedExpressionIR_base [ typedExpressionIR_hi : typedExpressionIR_lo ])` as `expressionIR` # (( _typeIR _ctk )))

        1. Let [`value_base` be the static evaluation of `typedExpressionIR_base`, under cursor `p` and typing context `TC`](Eval_static)
        2. Let [`value_hi` be the static evaluation of `typedExpressionIR_hi`, under cursor `p` and typing context `TC`](Eval_static)
        3. Let [`value_lo` be the static evaluation of `typedExpressionIR_lo`, under cursor `p` and typing context `TC`](Eval_static)
        4. Result in ``$bitacc_op(value_base, value_hi, value_lo)``

  14. Case `expressionIR` has type `callExpressionIR`
    1. Let `callExpressionIR` be `expressionIR` as `callExpressionIR`
    2. Assert that callExpressionIR matches pattern `%<%>(%)`.
      1. Let `(routineTargetIR < typeArgumentIR* >( argumentIR* ))` be callExpressionIR
      2. Case analysis on `routineTargetIR`
        1. Case `routineTargetIR` matches pattern `%.%`
          1. Let `(typedExpressionIR_base . nameIR)` be routineTargetIR
          2. Assert that typeArgumentIR* matches pattern [].
            1. Assert that argumentIR* matches pattern [].
              1. Group callExpressionIR-typedExpressionIR-size: p, TC, (`((typedExpressionIR_base . nameIR) < [] >( [] ))` as `expressionIR` # (( _typeIR _ctk )))

                1. Let `(_expressionIR # (( typeIR_base _ctk' )))` be typedExpressionIR_base
                2. Assert that nameIR is in ["minSizeInBits", "minSizeInBytes", "maxSizeInBits", "maxSizeInBytes"].
                  1. Result in ``$sizeof(typeIR_base, nameIR)``

        2. Case `routineTargetIR` matches pattern `TYPE%.%`
          1. Let `(type prefixedNameIR . nameIR)` be routineTargetIR
          2. Assert that typeArgumentIR* matches pattern [].
            1. Assert that argumentIR* matches pattern [].
              1. Group callExpressionIR-type: p, TC, (`((type prefixedNameIR . nameIR) < [] >( [] ))` as `expressionIR` # (( _typeIR _ctk )))

                1. Let `typeDefIR'?` be `$find_type(p, TC, prefixedNameIR)`
                2. Assert that typeDefIR'? matches pattern (_).
                  1. Let `?(typeDefIR)` be typeDefIR'?
                  2. Case analysis on `typeDefIR`
                    1. Case `typeDefIR` has type `typeIR`
                      1. Let `typeIR_base` be `typeDefIR` as `typeIR`
                      2. Assert that nameIR is in ["minSizeInBits", "minSizeInBytes", "maxSizeInBits", "maxSizeInBytes"].
                        1. Result in ``$sizeof(typeIR_base, nameIR)``

                    2. Case `typeDefIR` has type `polyTypeDefIR`
                      1. Let `(typeIR_base < tid* , tid'* >)` be `typeDefIR` as `polyTypeDefIR`
                      2. Assert that tid* matches pattern [].
                        1. Assert that tid'* matches pattern [].
                          1. Assert that nameIR is in ["minSizeInBits", "minSizeInBytes", "maxSizeInBits", "maxSizeInBytes"].
                            1. Result in ``$sizeof(typeIR_base, nameIR)``

        3. Case `routineTargetIR` matches pattern `(%)`
          1. Let `(( routineTargetIR ))` be routineTargetIR
          2. Group callExpressionIR-parenthesized: p, TC, (`((( routineTargetIR )) < typeArgumentIR* >( argumentIR* ))` as `expressionIR` # (( typeIR ctk )))

            1. Let [`value` be the static evaluation of `(`(routineTargetIR < typeArgumentIR* >( argumentIR* ))` as `expressionIR` # (( _typeIR'' _ctk'' )))`, under cursor `p` and typing context `TC`](Eval_static)
            2. Result in `value`

  15. Case `expressionIR` has type `parenthesizedExpressionIR`
    1. Let `(( typedExpressionIR ))` be `expressionIR` as `parenthesizedExpressionIR`
    2. Group parenthesizedExpressionIR: p, TC, (`(( typedExpressionIR ))` as `expressionIR` # (( _typeIR _ctk )))

      1. Let [`value` be the static evaluation of `typedExpressionIR`, under cursor `p` and typing context `TC`](Eval_static)
      2. Result in `value`

;; ../../../../spec-concrete/5.04-typing-relation.watsup:16.1-20.67
relation Type_ok: p, TC, typeOrVoid

1. Case analysis on `typeOrVoid`
  1. Case `typeOrVoid` has type `baseType`
    1. Let `baseType` be `typeOrVoid` as `baseType`
    2. Case analysis on `baseType`
      1. Case `baseType` matches pattern `BOOL`
        1. Group boolean: p, TC, `(bool)` as `typeOrVoid`

          1. Result in ``(bool)` as `typeIR``, `[]`

      2. Case `baseType` matches pattern `ERROR`
        1. Group error: p, TC, `(error)` as `typeOrVoid`

          1. Result in ``(error)` as `typeIR``, `[]`

      3. Case `baseType` matches pattern `MATCH_KIND`
        1. Group matchkind: p, TC, `(match_kind)` as `typeOrVoid`

          1. Result in ``(match_kind)` as `typeIR``, `[]`

      4. Case `baseType` matches pattern `STRING`
        1. Group string: p, TC, `(string)` as `typeOrVoid`

          1. Result in ``(string)` as `typeIR``, `[]`

      5. Case `baseType` matches pattern `INT`
        1. Group arbint: p, TC, `(int)` as `typeOrVoid`

          1. Result in ``(int)` as `typeIR``, `[]`
    3. Group fixint: p, TC, `baseType` as `typeOrVoid`

      1. Case analysis on `baseType`
        1. Case `baseType` matches pattern `INT<%>`
          1. Let `(int< int >)` be baseType
          2. Assert that `int` has type `nat`.
            1. Let `n` be `int` as `nat`
            2. Result in ``(int< n >)` as `typeIR``, `[]`

        2. Case `baseType` matches pattern `INT<(%)>`
          1. Let `(int<( expression )>)` be baseType
          2. Let [`typedExpressionIR` be the result of typing `expression`, under cursor `p` and typing context `TC`](Expr_ok)
          3. Let [`value` be the static evaluation of `typedExpressionIR`, under cursor `p` and typing context `TC`](Eval_static)
          4. Let `int` be `$to_number(value)`
          5. Assert that `int` has type `nat`.
            1. Let `n` be `int` as `nat`
            2. Result in ``(int< n >)` as `typeIR``, `[]`
    4. Group fixbit: p, TC, `baseType` as `typeOrVoid`

      1. Case analysis on `baseType`
        1. Case `baseType` matches pattern `BIT`
          1. Result in ``(bit< 1 >)` as `typeIR``, `[]`

        2. Case `baseType` matches pattern `BIT<%>`
          1. Let `(bit< int >)` be baseType
          2. Assert that `int` has type `nat`.
            1. Let `n` be `int` as `nat`
            2. Result in ``(bit< n >)` as `typeIR``, `[]`

        3. Case `baseType` matches pattern `BIT<(%)>`
          1. Let `(bit<( expression )>)` be baseType
          2. Let [`typedExpressionIR` be the result of typing `expression`, under cursor `p` and typing context `TC`](Expr_ok)
          3. Let [`value` be the static evaluation of `typedExpressionIR`, under cursor `p` and typing context `TC`](Eval_static)
          4. Let `int` be `$to_number(value)`
          5. Assert that `int` has type `nat`.
            1. Let `n` be `int` as `nat`
            2. Result in ``(bit< n >)` as `typeIR``, `[]`
    5. Group varbit: p, TC, `baseType` as `typeOrVoid`

      1. Case analysis on `baseType`
        1. Case `baseType` matches pattern `VARBIT<%>`
          1. Let `(varbit< int >)` be baseType
          2. Assert that `int` has type `nat`.
            1. Let `n` be `int` as `nat`
            2. Result in ``(varbit< n >)` as `typeIR``, `[]`

        2. Case `baseType` matches pattern `VARBIT<(%)>`
          1. Let `(varbit<( expression )>)` be baseType
          2. Let [`typedExpressionIR` be the result of typing `expression`, under cursor `p` and typing context `TC`](Expr_ok)
          3. Let [`value` be the static evaluation of `typedExpressionIR`, under cursor `p` and typing context `TC`](Eval_static)
          4. Let `int` be `$to_number(value)`
          5. Assert that `int` has type `nat`.
            1. Let `n` be `int` as `nat`
            2. Result in ``(varbit< n >)` as `typeIR``, `[]`

  2. Case `typeOrVoid` has type `prefixedTypeName`
    1. Let `prefixedTypeName` be `typeOrVoid` as `prefixedTypeName`
    2. Group prefixedTypeName: p, TC, `prefixedTypeName` as `typeOrVoid`

      1. Let `prefixedNameIR` be `$prefixedTypeName(prefixedTypeName)`
      2. Let `typeDefIR'?` be `$find_type(p, TC, prefixedNameIR)`
      3. Assert that typeDefIR'? matches pattern (_).
        1. Let `?(typeDefIR)` be typeDefIR'?
        2. Case analysis on `typeDefIR`
          1. Case `typeDefIR` has type `typeIR`
            1. Let `typeIR` be `typeDefIR` as `typeIR`
            2. Result in `typeIR`, `[]`

          2. Case `typeDefIR` has type `polyTypeDefIR`
            1. Let `polyTypeDefIR` be `typeDefIR` as `polyTypeDefIR`
            2. Result in ``(polyTypeDefIR < [] >)` as `typeIR``, `[]`

  3. Case `typeOrVoid` has type `specializedType`
    1. Let `(prefixedTypeName < typeArgumentList' >)` be `typeOrVoid` as `specializedType`
    2. Group specializedType: p, TC, `(prefixedTypeName < typeArgumentList' >)` as `typeOrVoid`

      1. Assert that typeArgumentList' matches pattern ``EMPTY`.
        1. Let `prefixedNameIR` be `$prefixedTypeName(prefixedTypeName)`
        2. Let `typeDefIR'?` be `$find_type(p, TC, prefixedNameIR)`
        3. Assert that typeDefIR'? matches pattern (_).
          1. Let `?(typeDefIR)` be typeDefIR'?
          2. Assert that `typeDefIR` has type `typeIR`.
            1. Let `typeIR` be `typeDefIR` as `typeIR`
            2. Result in `typeIR`, `[]`
      2. Let `prefixedNameIR` be `$prefixedTypeName(prefixedTypeName)`
      3. Let `typeDefIR'?` be `$find_type(p, TC, prefixedNameIR)`
      4. Assert that typeDefIR'? matches pattern (_).
        1. Let `?(typeDefIR)` be typeDefIR'?
        2. Assert that `typeDefIR` has type `polyTypeDefIR`.
          1. Let `polyTypeDefIR` be `typeDefIR` as `polyTypeDefIR`
          2. Let `(typeIR < tid_expl* , tid_impl* >)` be polyTypeDefIR
          3. Let `typeArgument*` be `$flatten_typeArgumentList(typeArgumentList')`
          4. (TypeArguments_ok: p TC |- typeArgument* : typeIR_arg* # tid_fresh*)
          5. Result in ``(polyTypeDefIR < typeIR_arg* >)` as `typeIR``, `tid_fresh*`

  4. Case `typeOrVoid` has type `headerStackType`
    1. Let `(namedType [ expression_size ])` be `typeOrVoid` as `headerStackType`
    2. Group headerStackType: p, TC, `(namedType [ expression_size ])` as `typeOrVoid`

      1. Case analysis on `namedType`
        1. Case `namedType` has type `prefixedTypeName`
          1. Let `prefixedTypeName` be `namedType` as `prefixedTypeName`
          2. Let [`typeIR_base` be the result of typing ``prefixedTypeName` as `typeOrVoid``, under cursor `p` and typing context `TC`,
             and `tid*` be the set of inserted type variables](Type_ok)
          3. Assert that tid* matches pattern [].
            1. Let [`typedExpressionIR_size` be the result of typing `expression_size`, under cursor `p` and typing context `TC`](Expr_ok)
            2. Let [`value_size` be the static evaluation of `typedExpressionIR_size`, under cursor `p` and typing context `TC`](Eval_static)
            3. Let `int` be `$to_number(value_size)`
            4. Assert that `int` has type `nat`.
              1. Let `n_size` be `int` as `nat`
              2. Let `typeIR_stack` be `(`(tid "T")` as `typeIR` [ n_size ])` as `typeIR`
              3. Let `polyTypeDefIR_stack` be (typeIR_stack < ["T"] , [] >)
              4. Result in ``(polyTypeDefIR_stack < [typeIR_base] >)` as `typeIR``, `[]`

        2. Case `namedType` has type `specializedType`
          1. Let `specializedType` be `namedType` as `specializedType`
          2. Let [`typeIR_base` be the result of typing ``specializedType` as `typeOrVoid``, under cursor `p` and typing context `TC`,
             and `tid_fresh*` be the set of inserted type variables](Type_ok)
          3. Let [`typedExpressionIR_size` be the result of typing `expression_size`, under cursor `p` and typing context `TC`](Expr_ok)
          4. Let [`value_size` be the static evaluation of `typedExpressionIR_size`, under cursor `p` and typing context `TC`](Eval_static)
          5. Let `int` be `$to_number(value_size)`
          6. Assert that `int` has type `nat`.
            1. Let `n_size` be `int` as `nat`
            2. Let `typeIR_stack` be `(`(tid "T")` as `typeIR` [ n_size ])` as `typeIR`
            3. Let `polyTypeDefIR_stack` be (typeIR_stack < ["T"] , [] >)
            4. Result in ``(polyTypeDefIR_stack < [typeIR_base] >)` as `typeIR``, `tid_fresh*`

  5. Case `typeOrVoid` has type `listType`
    1. Let `(list< typeArgument >)` be `typeOrVoid` as `listType`
    2. Group listType: p, TC, `(list< typeArgument >)` as `typeOrVoid`

      1. (TypeArgument_ok: p TC |- typeArgument : typeIR_arg # tid_fresh*)
      2. Let `typeIR_list` be `(list< `(tid "T")` as `typeIR` >)` as `typeIR`
      3. Let `polyTypeDefIR_list` be (typeIR_list < ["T"] , [] >)
      4. Result in ``(polyTypeDefIR_list < [typeIR_arg] >)` as `typeIR``, `tid_fresh*`

  6. Case `typeOrVoid` has type `tupleType`
    1. Let `(tuple< typeArgumentList >)` be `typeOrVoid` as `tupleType`
    2. Group tupleType: p, TC, `(tuple< typeArgumentList >)` as `typeOrVoid`

      1. Let `typeArgument*` be `$flatten_typeArgumentList(typeArgumentList)`
      2. (TypeArguments_ok: p TC |- typeArgument* : typeIR_arg* # tid_fresh*)
      3. Let `i_idx*` be ``$init_(|typeIR_arg*|)`` as `int*`
      4. Let `tid_tparam` be "T" ++ `$int_to_text(i_idx)`, for each `i_idx` in `i_idx*` and `tid_tparam` in `tid_tparam*`
      5. Let `typeIR_tuple` be `(tuple< `(tid tid_tparam)` as `typeIR`* >)` as `typeIR`
      6. Let `polyTypeDefIR_tuple` be (typeIR_tuple < tid_tparam* , [] >)
      7. Result in ``(polyTypeDefIR_tuple < typeIR_arg* >)` as `typeIR``, `tid_fresh*`
2. Assert that typeOrVoid matches pattern `VOID`.
  1. Group void: p, TC, (void)

    1. Result in ``(void)` as `typeIR``, `[]`

;; ../../../../spec-concrete/5.04-typing-relation.watsup:22.1-24.23
relation TypeArgument_ok: p, TC, typeArgument

1. Case analysis on `typeArgument`
  1. Case `typeArgument` has type `type`
    1. Let `type` be `typeArgument` as `type`
    2. Group type: p, TC, `type` as `typeArgument`

      1. Let [`typeIR` be the result of typing ``type` as `typeOrVoid``, under cursor `p` and typing context `TC`,
         and `tid_impl*` be the set of inserted type variables](Type_ok)
      2. Result in `typeIR`, `tid_impl*`

  2. Case `typeArgument` has type `nonTypeName`
    1. Let `nonTypeName` be `typeArgument` as `nonTypeName`
    2. Group nonTypeName: p, TC, `nonTypeName` as `typeArgument`

      1. Let `tid` be `$name(`nonTypeName` as `name`)`
      2. Result in ``(tid tid)` as `typeArgumentIR``, `[]`
2. Assert that `typeArgument` has type `realTypeArgument`.
  1. Let `realTypeArgument` be `typeArgument` as `realTypeArgument`
  2. Case analysis on `realTypeArgument`
    1. Case `realTypeArgument` matches pattern `VOID`
      1. Group void: p, TC, `(void)` as `typeArgument`

        1. Result in ``(void)` as `typeArgumentIR``, `[]`

    2. Case `realTypeArgument` matches pattern `_`
      1. Group dontcare: p, TC, `(_)` as `typeArgument`

        1. Let `tid_impl` be `$fresh_tid`
        2. Result in ``(tid tid_impl)` as `typeArgumentIR``, `[tid_impl]`

;; ../../../../spec-concrete/5.04-typing-relation.watsup:26.1-28.23
relation TypeArguments_ok: p, TC, typeArgument*

1. Case analysis on `typeArgument*`
  1. Case `typeArgument*` matches pattern []
    1. Group nil: p, TC, []

      1. Result in `[]`, `[]`

  2. Case `typeArgument*` matches pattern _ :: _
    1. Let `typeArgument_h :: typeArgument_t*` be typeArgument*
    2. Group cons: p, TC, typeArgument_h :: typeArgument_t*

      1. (TypeArgument_ok: p TC |- typeArgument_h : typeArgumentIR_h # tid_impl_h*)
      2. (TypeArguments_ok: p TC |- typeArgument_t* : typeArgumentIR_t* # tid_impl_t*)
      3. Let `tid_impl*` be tid_impl_h* ++ tid_impl_t*
      4. Result in `typeArgumentIR_h :: typeArgumentIR_t*`, `tid_impl*`

;; ../../../../spec-concrete/5.04-typing-relation.watsup:34.1-36.48
relation Sub_expl: typeIR_a, typeIR_b

1. Group : typeIR_a, typeIR_b

  1. Let `typeIR_a_canon` be `$canon(typeIR_a)`
  2. Let `typeIR_b_canon` be `$canon(typeIR_b)`
  3.  If [`typeIR_a_canon` can be explicitly cast to `typeIR_b_canon` after canonicalization](Sub_expl_canon), then:
      1. The relation holds

;; ../../../../spec-concrete/5.04-typing-relation.watsup:37.1-39.73
relation Sub_expl_canon: typeIR_a, typeIR_b

1. Group equals: typeIR_a, typeIR_b

  1.  If [`typeIR_a` and `typeIR_b` are the same type](Type_alpha), then:
      1. The relation holds
2. Group not-equals: typeIR_a, typeIR_b

  1.  If [`typeIR_a` and `typeIR_b` are the same type](Type_alpha)    Does not hold:

      1.  If [`typeIR_a` can be explicitly cast to `typeIR_b` when they are not the same type after canonicalization](Sub_expl_canon_neq), then:
          1. The relation holds

