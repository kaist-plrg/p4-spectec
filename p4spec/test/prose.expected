;; ../../../../spec-concrete/0-aux.watsup:41.1-41.23
def $init_(nat')

1. Case analysis on `nat'`
  1. Case nat' = 0
    1. Return []

  2. Case nat' =/= 0
    1. Let `int` be nat' - 1
    2. Assert that `int` has type `nat`.
      1. Let `n'` be `int` as `nat`
      2. Return n' :: `$init_(n')`

;; ../../../../spec-concrete/0-aux.watsup:47.1-47.29
def $repeat_<X>(X, nat')

1. Case analysis on `nat'`
  1. Case nat' = 0
    1. Return []

  2. Case nat' =/= 0
    1. Let `int` be nat' - 1
    2. Assert that `int` has type `nat`.
      1. Let `n'` be `int` as `nat`
      2. Return [X] ++ `$repeat_<X>(X, n')`

