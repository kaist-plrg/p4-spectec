+               2. (Let b_hit be ~((tableMatch)* = []))

+               3. (Let b_miss be ~b_hit)

+               4. (Let tableMetadataEnumValue be (table_enum "action_list(" ++ typeId ++ ")" . $flatten_prefixedNameIR(prefixedNameIR)))

+               5. (Let tableMetadataStructValue be (table_struct "apply_result(" ++ typeId ++ ")" {hit (`b b_hit) ;miss (`b b_miss) ;action_run tableMetadataEnumValue ;}))

+               6. Result in: % % |- % % : EC_3 STO_3 ((return ?((tableMetadataStructValue as value))) as tableResult)

