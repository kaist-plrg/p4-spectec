;; P4 parsing tests

(executable
 (name test)
 (preprocess
  (pps ppx_let))
 (modules test)
 (libraries
  test_common
  p4spectec
  core
  core_kernel
  core_unix
  core_unix.command_unix))

(rule
 (alias p4parse)
 (action
  (progn
   (ignore-outputs
    (diff parser_pos.expected parser_pos.actual))
   (ignore-outputs
    (diff parser_neg.expected parser_neg.actual)))))

;; Rules to generate outputs

(rule
 (target parser_pos.actual)
 (deps
  (source_tree ../../../spec)
  (source_tree ../../../p4c/p4include)
  (source_tree ../../../p4c/testdata/p4_16_samples)
  (source_tree ../../../p4c/testdata/p4_16_errors)
  (source_tree ../../../excludes)
  (source_tree ../../../patches)
  (source_tree ../../../testdata))
 (action
  (with-stdout-to
   parser_pos.actual
   (with-stderr-to
    parser_pos.err
    (run
     ./test.exe
     parser
     -s
     ../../../spec
     -i
     ../../../p4c/p4include
     -p4-dir
     ../../../p4c/testdata/p4_16_samples
     -p4-dir
     ../../../testdata/custom)))))

(rule
 (target parser_neg.actual)
 (deps
  (source_tree ../../../spec)
  (source_tree ../../../p4c/p4include)
  (source_tree ../../../p4c/testdata/p4_16_samples)
  (source_tree ../../../p4c/testdata/p4_16_errors)
  (source_tree ../../../excludes)
  (source_tree ../../../patches)
  (source_tree ../../../testdata))
 (action
  (with-stdout-to
   parser_neg.actual
   (with-stderr-to
    parser_neg.err
    (run
     ./test.exe
     parser
     -i
     ../../../p4c/p4include
     -p4-dir
     ../../../p4c/testdata/p4_16_errors
     -s
     ../../../spec)))))
