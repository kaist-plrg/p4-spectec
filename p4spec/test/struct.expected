;; ../../../../spec-concrete/3-numerics.watsup:297.1-298.23
def $bin_eq(value, value')

1. Case analysis on value

  1. Case (% has type primitiveValue)

    1. (Let primitiveValue_a be (value as primitiveValue))

    2. If ((value' has type primitiveValue)), then

      1. (Let primitiveValue_b be (value' as primitiveValue))

      2. Return (primitiveValue_a = primitiveValue_b)

  2. Case (% has type numberLiteral)

    1. (Let numberLiteral be (value as numberLiteral))

    2. Case analysis on numberLiteral

      1. Case (% matches pattern `D%`)

        1. (Let (d i_a) be numberLiteral)

        2. If ((value' has type numberLiteral)), then

          1. (Let numberLiteral' be (value' as numberLiteral))

          2. If ((numberLiteral' matches pattern `D%`)), then

            1. (Let (d i_b) be numberLiteral')

            2. Return (i_a = i_b)

      2. Case (% matches pattern `%W%`)

        1. (Let (w_a w i_a) be numberLiteral)

        2. If ((value' has type numberLiteral)), then

          1. (Let numberLiteral' be (value' as numberLiteral))

          2. If ((numberLiteral' matches pattern `%W%`)), then

            1. (Let (w_b w i_b) be numberLiteral')

            2. Return ((w_a = w_b) /\ (i_a = i_b))

      3. Case (% matches pattern `%S%`)

        1. (Let (w_a s i_a) be numberLiteral)

        2. If ((value' has type numberLiteral)), then

          1. (Let numberLiteral' be (value' as numberLiteral))

          2. If ((numberLiteral' matches pattern `%S%`)), then

            1. (Let (w_b s i_b) be numberLiteral')

            2. Return ((w_a = w_b) /\ (i_a = i_b))

  3. Case (% has type listValue)

    1. (Let (list[ value_a*{value_a <- value_a*} ]) be (value as listValue))

    2. If ((value' has type listValue)), then

      1. (Let (list[ value_b*{value_b <- value_b*} ]) be (value' as listValue))

      2. Return $bin_eqs(value_a*{value_a <- value_a*}, value_b*{value_b <- value_b*})

  4. Case (% has type tupleValue)

    1. (Let (tuple( value_a*{value_a <- value_a*} )) be (value as tupleValue))

    2. If ((value' has type tupleValue)), then

      1. (Let (tuple( value_b*{value_b <- value_b*} )) be (value' as tupleValue))

      2. Return $bin_eqs(value_a*{value_a <- value_a*}, value_b*{value_b <- value_b*})

  5. Case (% has type headerStackValue)

    1. (Let (header_stack[ value_a*{value_a <- value_a*} ( _nat ; n_size_a )]) be (value as headerStackValue))

    2. If ((value' has type headerStackValue)), then

      1. (Let (header_stack[ value_b*{value_b <- value_b*} ( _nat' ; n_size_b )]) be (value' as headerStackValue))

      2. Return ($bin_eqs(value_a*{value_a <- value_a*}, value_b*{value_b <- value_b*}) /\ (n_size_a = n_size_b))

  6. Case (% has type structValue)

    1. (Let (struct tid_a { (value_field_a id_field_a ;)*{id_field_a <- id_field_a*, value_field_a <- value_field_a*} }) be (value as structValue))

    2. If ((value' has type structValue)), then

      1. (Let (struct tid_b { (value_field_b id_field_b ;)*{id_field_b <- id_field_b*, value_field_b <- value_field_b*} }) be (value' as structValue))

      2. Return ((tid_a = tid_b) /\ $bin_eqs_fields((value_field_a, id_field_a)*{id_field_a <- id_field_a*, value_field_a <- value_field_a*}, (value_field_b, id_field_b)*{id_field_b <- id_field_b*, value_field_b <- value_field_b*}))

  7. Case (% has type headerValue)

    1. (Let (header tid_a { _bool ; (value_field_a id_field_a ;)*{id_field_a <- id_field_a*, value_field_a <- value_field_a*} }) be (value as headerValue))

    2. If ((value' has type headerValue)), then

      1. (Let (header tid_b { _bool' ; (value_field_b id_field_b ;)*{id_field_b <- id_field_b*, value_field_b <- value_field_b*} }) be (value' as headerValue))

      2. Return ((tid_a = tid_b) /\ $bin_eqs_fields((value_field_a, id_field_a)*{id_field_a <- id_field_a*, value_field_a <- value_field_a*}, (value_field_b, id_field_b)*{id_field_b <- id_field_b*, value_field_b <- value_field_b*}))

  8. Case (% has type headerUnionValue)

    1. (Let (header_union tid_a { (value_field_a id_field_a ;)*{id_field_a <- id_field_a*, value_field_a <- value_field_a*} }) be (value as headerUnionValue))

    2. If ((value' has type headerUnionValue)), then

      1. (Let (header_union tid_b { (value_field_b id_field_b ;)*{id_field_b <- id_field_b*, value_field_b <- value_field_b*} }) be (value' as headerUnionValue))

      2. Return ((tid_a = tid_b) /\ $bin_eqs_fields((value_field_a, id_field_a)*{id_field_a <- id_field_a*, value_field_a <- value_field_a*}, (value_field_b, id_field_b)*{id_field_b <- id_field_b*, value_field_b <- value_field_b*}))

  9. Case (% has type enumValue)

    1. (Let enumValue be (value as enumValue))

    2. Case analysis on enumValue

      1. Case (% matches pattern `%.%`)

        1. (Let (tid_a . id_field_a) be enumValue)

        2. If ((value' has type enumValue)), then

          1. (Let enumValue' be (value' as enumValue))

          2. If ((enumValue' matches pattern `%.%`)), then

            1. (Let (tid_b . id_field_b) be enumValue')

            2. Return ((tid_a = tid_b) /\ (id_field_a = id_field_b))

      2. Case (% matches pattern `%.%.%`)

        1. (Let (tid_a . id_field_a . value_field_a) be enumValue)

        2. If ((value' has type enumValue)), then

          1. (Let enumValue' be (value' as enumValue))

          2. If ((enumValue' matches pattern `%.%.%`)), then

            1. (Let (tid_b . id_field_b . value_field_b) be enumValue')

            2. Return (((tid_a = tid_b) /\ (id_field_a = id_field_b)) /\ $bin_eq(value_field_a, value_field_b))

  10. Case (% has type invalidHeaderValue)

    1. (Let invalidHeaderValue be (value as invalidHeaderValue))

    2. If ((value' has type invalidHeaderValue)), then

      1. (Let invalidHeaderValue' be (value' as invalidHeaderValue))

      2. Return true

2. If ((value has type numberValue)), then

  1. (Let numberValue be (value as numberValue))

  2. If ((numberValue matches pattern `%.%V%`)), then

    1. (Let (w_max_a . _nat v i_a) be numberValue)

    2. If ((value' has type numberValue)), then

      1. (Let numberValue' be (value' as numberValue))

      2. If ((numberValue' matches pattern `%.%V%`)), then

        1. (Let (w_max_b . _nat' v i_b) be numberValue')

        2. Return ((w_max_a = w_max_b) /\ (i_a = i_b))

