def $callableId_IR(nameIR, (parameterIR)*)

1. (Let (_annotationList _direction _typeIR id _parameterInitializerOptIR) be parameterIR)*

2. Return (nameIR ( (id)* ))

;; ../../../../spec-concrete/6-dynamic-runtime/6.1-storage-reference.watsup:6.1-9.41
syntax storageReference = 
   | ` nameIR hint(print %0)
   | . nameIR
   | storageReference . nameIR
   | storageReference [ value ]
   | storageReference [ value : value ]

;; ../../../../spec-concrete/6-dynamic-runtime/6.2.1-callable-def.watsup:12.3-12.54
syntax actionDef = 
   | action nameIR ( parameterListIR ) blockStatementIR

;; ../../../../spec-concrete/6-dynamic-runtime/6.2.1-callable-def.watsup:19.3-20.42
syntax definedFunctionDef = 
   | function nameIR < typeParameterListIR >( parameterListIR ) blockStatementIR

;; ../../../../spec-concrete/6-dynamic-runtime/6.2.1-callable-def.watsup:23.3-24.50
syntax externFunctionDef = 
   | extern_function nameIR < typeParameterListIR >( parameterListIR )

;; ../../../../spec-concrete/6-dynamic-runtime/6.2.1-callable-def.watsup:27.1-28.22
syntax functionDef = 
   | function nameIR < typeParameterListIR >( parameterListIR ) blockStatementIR
   | extern_function nameIR < typeParameterListIR >( parameterListIR )

;; ../../../../spec-concrete/6-dynamic-runtime/6.2.1-callable-def.watsup:35.1-38.52
syntax externMethodDef = 
   | extern_method nameIR < typeParameterListIR >( parameterListIR ) blockStatementIR?
   | extern_methodabstract nameIR < typeParameterListIR >( parameterListIR )

;; ../../../../spec-concrete/6-dynamic-runtime/6.2.1-callable-def.watsup:41.3-42.50
syntax parserApplyMethodDef = 
   | parser_apply( parameterListIR ){ parserLocalDeclarationListIR ; stateEnv }

;; ../../../../spec-concrete/6-dynamic-runtime/6.2.1-callable-def.watsup:45.3-46.72
syntax controlApplyMethodDef = 
   | control_apply( parameterListIR ){ controlLocalDeclarationListIR ; actionDefEnv ; controlBodyIR }

;; ../../../../spec-concrete/6-dynamic-runtime/6.2.1-callable-def.watsup:49.3-49.39
syntax tableApplyMethodDef = 
   | table_apply{ tablePropertyListIR }

;; ../../../../spec-concrete/6-dynamic-runtime/6.2.1-callable-def.watsup:52.1-55.24
syntax methodDef = 
   | extern_method nameIR < typeParameterListIR >( parameterListIR ) blockStatementIR?
   | extern_methodabstract nameIR < typeParameterListIR >( parameterListIR )
   | parser_apply( parameterListIR ){ parserLocalDeclarationListIR ; stateEnv }
   | control_apply( parameterListIR ){ controlLocalDeclarationListIR ; actionDefEnv ; controlBodyIR }
   | table_apply{ tablePropertyListIR }

;; ../../../../spec-concrete/6-dynamic-runtime/6.2.1-callable-def.watsup:57.22-57.57
syntax callableDef = 
   | action nameIR ( parameterListIR ) blockStatementIR
   | function nameIR < typeParameterListIR >( parameterListIR ) blockStatementIR
   | extern_function nameIR < typeParameterListIR >( parameterListIR )
   | extern_method nameIR < typeParameterListIR >( parameterListIR ) blockStatementIR?
   | extern_methodabstract nameIR < typeParameterListIR >( parameterListIR )
   | parser_apply( parameterListIR ){ parserLocalDeclarationListIR ; stateEnv }
   | control_apply( parameterListIR ){ controlLocalDeclarationListIR ; actionDefEnv ; controlBodyIR }
   | table_apply{ tablePropertyListIR }

;; ../../../../spec-concrete/6-dynamic-runtime/6.2.2-callable-def-aux.watsup:5.1-6.17
def $parameterListIR_of_callableDef(callableDef)

1. Case analysis on callableDef

  1. Case (% has type actionDef)

    1. (Let actionDef be (callableDef as actionDef))

    2. Return $parameterListIR_of_actionDef(actionDef)

  2. Case (% has type functionDef)

    1. (Let functionDef be (callableDef as functionDef))

    2. Return $parameterListIR_of_functionDef(functionDef)

  3. Case (% has type methodDef)

    1. (Let methodDef be (callableDef as methodDef))

    2. Return $parameterListIR_of_methodDef(methodDef)

