   | seq< typeIR* >
   | seq< typeIR* ,...>

;; ../../../../spec-concrete/2-static-runtime/2.2.1-type.watsup:145.1-146.37
syntax recordTypeIR = 
   | record{ fieldTypeIR* }
   | record{ fieldTypeIR* ,...}

;; ../../../../spec-concrete/2-static-runtime/2.2.1-type.watsup:148.20-148.35
syntax setTypeIR = 
   | set< typeIR >

;; ../../../../spec-concrete/2-static-runtime/2.2.1-type.watsup:151.3-152.17
syntax tableMetadataEnumTypeIR = 
