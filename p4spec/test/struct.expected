        1. If ((id =/= "main")), then

          1. (Let frame_h_update be $add_map<id, varTypeIR>(frame_h, id, varTypeIR))

          2. (Let frame*{frame <- frame*} be frame_h_update :: frame_t*{frame_t <- frame_t*})

