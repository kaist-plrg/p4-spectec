4. If ($is_packageObjectTypeIR($canon_typeIR(typeIR))), then

  1. Return $instantiable_package(p, TC, instctxt)

5. If ($is_tableObjectTypeIR($canon_typeIR(typeIR))), then

  1. Return $instantiable_table(p, TC, instctxt)

