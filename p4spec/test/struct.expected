        2. (Lvalue_eval: p EC_0 ARCH_0 |- typedLvalueIR' : EC_1 ARCH_1 storageReferenceResult)

        3. Result in: % % % |- % : EC_1 ARCH_1 storageReferenceResult

      2. Else Phantom#1970

  2. Case (% matches pattern `%=%`)

    1. (Let (nameIR = typedExpressionIR) be argumentIR)

    2. Group nameIR-typedExpressionIR: p EC_0 ARCH_0 |- (nameIR = typedExpressionIR) : % % %

      1. (Let (typedLvalueIR)? be $typedExpressionIR_as_typedLvalueIR(typedExpressionIR))

      2. If (((typedLvalueIR)? matches pattern (_))), then

        1. (Let ?(typedLvalueIR') be (typedLvalueIR)?)

        2. (Lvalue_eval: p EC_0 ARCH_0 |- typedLvalueIR' : EC_1 ARCH_1 storageReferenceResult)

        3. Result in: % % % |- % : EC_1 ARCH_1 storageReferenceResult

      2. Else Phantom#1971

  3. Case (% matches pattern `%=_`)

    1. (Let (nameIR =_) be argumentIR)

    2. Group nameIR-dontcare: p EC_0 ARCH_0 |- (nameIR =_) : % % %

      1. Result in: % % % |- % : EC_0 ARCH_0 ((` ?()) as storageReferenceResult)

  4. Case (% matches pattern `_`)

    1. Group dontcare: p EC_0 ARCH_0 |- (_) : % % %

      1. Result in: % % % |- % : EC_0 ARCH_0 ((` ?()) as storageReferenceResult)

;; ../../../../spec-concrete/8-dynamic/8.02-evaluation-relation.watsup:86.1-92.34
relation Lvalue_eval: p EC ARCH |- (lvalueIR # lvalueNoteIR) : % % %

1. Case analysis on lvalueIR

  1. Case (% has type referenceExpressionIR)

    1. (Let referenceExpressionIR be (lvalueIR as referenceExpressionIR))

    2. Group referenceExpressionIR: p EC ARCH |- ((referenceExpressionIR as lvalueIR) # lvalueNoteIR) : % % %

      1. Result in: % % % |- % : EC ARCH ((` ?((referenceExpressionIR as storageReference))) as storageReferenceResult)

  2. Case (% matches pattern `%.%`)

    1. (Let (typedLvalueIR . nameIR) be lvalueIR)

    2. Group memberAccess: p EC ARCH |- ((typedLvalueIR . nameIR) # lvalueNoteIR) : % % %

      1. (Lvalue_eval: p EC ARCH |- typedLvalueIR : EC_1 ARCH_1 storageReferenceResult)

      2. Case analysis on storageReferenceResult

        1. Case (% has type abortResult)

          1. (Let abortResult be (storageReferenceResult as abortResult))

          2. Result in: % % % |- % : EC_1 ARCH_1 (abortResult as storageReferenceResult)

        2. Case (% has type continueResult<storageReference?>)

          1. (Let (` (storageReference)?) be (storageReferenceResult as continueResult<storageReference?>))

          2. If (((storageReference)? matches pattern (_))), then

            1. (Let ?(storageReference') be (storageReference)?)

            2. (Lvalue_read: p EC_1 ARCH_1 |- storageReference' : value)

            3. Case analysis on (value has type headerStackValue)

              1. Case true

                1. (Let headerStackValue be (value as headerStackValue))

                2. (Let (header_stack[ (value_element)* ( n_idx ; n_size )]) be headerStackValue)

                3. If ((nameIR = "next")), then

                  1. If ((n_idx >= n_size)), then

                    1. (Let rejectTransitionResult be (reject (error. "StackOutOfBounds")))

                    2. Result in: % % % |- % : EC_1 ARCH_1 (rejectTransitionResult as storageReferenceResult)

                  1. Else Phantom#1972

                  2. If ((n_idx < n_size)), then

                    1. (Let storageReferenceResult' be ((` ?((storageReference' . nameIR))) as storageReferenceResult))

                    2. Result in: % % % |- % : EC_1 ARCH_1 storageReferenceResult'

                  2. Else Phantom#1973

                3. Else Phantom#1974

              2. Case false

                1. (Let storageReferenceResult' be ((` ?((storageReference' . nameIR))) as storageReferenceResult))

                2. Result in: % % % |- % : EC_1 ARCH_1 storageReferenceResult'

          2. Else Phantom#1975

  3. Case (% matches pattern `%[%]`)

    1. (Let (typedLvalueIR [ typedExpressionIR ]) be lvalueIR)

    2. Group indexAccess: p EC ARCH |- ((typedLvalueIR [ typedExpressionIR ]) # lvalueNoteIR) : % % %

      1. (Lvalue_eval: p EC ARCH |- typedLvalueIR : EC_1 ARCH_1 storageReferenceResult)

      2. Case analysis on storageReferenceResult

        1. Case (% has type abortResult)

          1. (Let abortResult be (storageReferenceResult as abortResult))

          2. Result in: % % % |- % : EC_1 ARCH_1 (abortResult as storageReferenceResult)

        2. Case (% has type continueResult<storageReference?>)

          1. (Let (` (storageReference)?) be (storageReferenceResult as continueResult<storageReference?>))

          2. If (((storageReference)? matches pattern (_))), then

            1. (Let ?(storageReference') be (storageReference)?)

            2. (Expr_eval: p EC_1 ARCH_1 |- typedExpressionIR : EC_2 ARCH_2 expressionResult)

            3. Case analysis on expressionResult

              1. Case (% has type abortResult)

                1. (Let abortResult be (expressionResult as abortResult))

                2. Result in: % % % |- % : EC_2 ARCH_2 (abortResult as storageReferenceResult)

              2. Case (% has type continueResult<value>)

                1. (Let (` value) be (expressionResult as continueResult<value>))

                2. If ((value has type integerValue)), then

                  1. (Let integerValue_index be (value as integerValue))

                  2. (Let storageReferenceResult' be ((` ?((storageReference' [ (integerValue_index as value) ]))) as storageReferenceResult))

                  3. Result in: % % % |- % : EC_2 ARCH_2 storageReferenceResult'

                2. Else Phantom#1976

          2. Else Phantom#1977

  4. Case (% matches pattern `%[%:%]`)

    1. (Let (typedLvalueIR [ typedExpressionIR_hi : typedExpressionIR_lo ]) be lvalueIR)

    2. Group sliceAccess: p EC ARCH |- ((typedLvalueIR [ typedExpressionIR_hi : typedExpressionIR_lo ]) # lvalueNoteIR) : % % %

      1. (Lvalue_eval: p EC ARCH |- typedLvalueIR : EC_1 ARCH_1 storageReferenceResult)

      2. Case analysis on storageReferenceResult

        1. Case (% has type abortResult)

          1. (Let abortResult be (storageReferenceResult as abortResult))

          2. Result in: % % % |- % : EC_1 ARCH_1 (abortResult as storageReferenceResult)

        2. Case (% has type continueResult<storageReference?>)

          1. (Let (` (storageReference)?) be (storageReferenceResult as continueResult<storageReference?>))

          2. If (((storageReference)? matches pattern (_))), then

            1. (Let ?(storageReference') be (storageReference)?)

            2. (Exprs_eval: p EC_1 ARCH_1 |- [typedExpressionIR_hi, typedExpressionIR_lo] : EC_2 ARCH_2 expressionListResult)

            3. Case analysis on expressionListResult

              1. Case (% has type abortResult)

                1. (Let abortResult be (expressionListResult as abortResult))

                2. Result in: % % % |- % : EC_2 ARCH_2 (abortResult as storageReferenceResult)

              2. Case (% has type continueResult<value*>)

                1. (Let (` (value)*) be (expressionListResult as continueResult<value*>))

                2. If (((value)* matches pattern [ _/2 ])), then

                  1. (Let [value_hi, value_lo] be (value)*)

                  2. (Let storageReferenceResult' be ((` ?((storageReference' [ value_hi : value_lo ]))) as storageReferenceResult))

                  3. Result in: % % % |- % : EC_1 ARCH_1 storageReferenceResult'

                2. Else Phantom#1978

          2. Else Phantom#1979

  5. Case (% matches pattern `(%)`)

    1. (Let (( typedLvalueIR )) be lvalueIR)

    2. Group parenthesized: p EC ARCH |- ((( typedLvalueIR )) # lvalueNoteIR) : % % %

      1. (Lvalue_eval: p EC ARCH |- typedLvalueIR : EC_1 ARCH_1 storageReferenceResult)

      2. Result in: % % % |- % : EC_1 ARCH_1 storageReferenceResult

;; ../../../../spec-concrete/8-dynamic/8.02-evaluation-relation.watsup:94.1-98.33
relation Lvalue_read: p EC ARCH |- storageReference : %

1. Case analysis on storageReference

  1. Case (% has type prefixedNameIR)

    1. (Let prefixedNameIR be (storageReference as prefixedNameIR))

    2. Group referenceExpressionIR: p EC ARCH |- (prefixedNameIR as storageReference) : %

      1. (Let value be $find_var_e(prefixedNameIR, p, EC))

      2. Result in: % % % |- % : value

  2. Case (% matches pattern `%.%`)

    1. (Let (storageReference' . nameIR) be storageReference)

    2. Group memberAccess: p EC ARCH |- (storageReference' . nameIR) : %

      1. (Lvalue_read: p EC ARCH |- storageReference' : value_base)

      2. Case analysis on value_base

        1. Case (% has type objectReferenceValue)

          1. (Let (ref objectId) be (value_base as objectReferenceValue))

          2. (Let (object)? be $find_object_e(ARCH, objectId))

          3. If (((object)? matches pattern (_))), then

            1. (Let ?(object') be (object)?)

            2. If ((object' has type packageObject)), then

              1. (Let (package< _theta >{ frame }) be (object' as packageObject))

              2. (Let (value)? be $find_map<nameIR, value>(frame, nameIR))

              3. If (((value)? matches pattern (_))), then

                1. (Let ?(value') be (value)?)

                2. Result in: % % % |- % : value'

              3. Else Phantom#1980

            2. Else Phantom#1981

          3. Else Phantom#1982

        2. Case (% has type headerStackValue)

          1. (Let headerStackValue_base be (value_base as headerStackValue))

          2. (Let (header_stack[ (value_element)* ( n_idx ; n_size )]) be headerStackValue_base)

          3. If ((nameIR = "next")), then

            1. If ((n_idx < n_size)), then

              1. (Let value be (value_element)*[n_idx])

              2. Result in: % % % |- % : value

            1. Else Phantom#1983

          3. Else Phantom#1984

        3. Case (% has type structValue)

          1. (Let structValue_base be (value_base as structValue))

          2. (Let (struct _typeId { ((value_field nameIR_field ;))* }) be structValue_base)

          3. (Let (value)? be $assoc_<id, value>(nameIR, ((nameIR_field, value_field))*))

          4. If (((value)? matches pattern (_))), then

            1. (Let ?(value') be (value)?)

            2. Result in: % % % |- % : value'

          4. Else Phantom#1985

        4. Case (% has type headerValue)

          1. (Let headerValue_base be (value_base as headerValue))

          2. (Let (header _typeId { _bool ; ((value_field nameIR_field ;))* }) be headerValue_base)

          3. (Let (value)? be $assoc_<id, value>(nameIR, ((nameIR_field, value_field))*))

          4. If (((value)? matches pattern (_))), then

            1. (Let ?(value') be (value)?)

            2. Result in: % % % |- % : value'

          4. Else Phantom#1986

        5. Case (% has type headerUnionValue)

          1. (Let headerUnionValue_base be (value_base as headerUnionValue))

          2. (Let (header_union _typeId { ((value_field nameIR_field ;))* }) be headerUnionValue_base)

          3. (Let (value)? be $assoc_<id, value>(nameIR, ((nameIR_field, value_field))*))

          4. If (((value)? matches pattern (_))), then

            1. (Let ?(value') be (value)?)

            2. Result in: % % % |- % : value'

          4. Else Phantom#1987

      2. Else Phantom#1988

  3. Case (% matches pattern `%[%]`)

    1. (Let (storageReference' [ value ]) be storageReference)

    2. If ((value has type integerValue)), then

      1. (Let integerValue_index be (value as integerValue))

      2. Group indexAccess: p EC ARCH |- (storageReference' [ (integerValue_index as value) ]) : %

        1. (Lvalue_read: p EC ARCH |- storageReference' : value')

        2. If ((value' has type headerStackValue)), then

          1. (Let headerStackValue_base be (value' as headerStackValue))

          2. (Let (header_stack[ (value_element)* ( _nat ; n_size )]) be headerStackValue_base)

          3. (Let (nat)? be $nat_of_integerValue(integerValue_index))

          4. If (((nat)? matches pattern (_))), then

            1. (Let ?(n_idx) be (nat)?)

            2. If ((n_idx < n_size)), then

              1. (Let value'' be (value_element)*[n_idx])

              2. Result in: % % % |- % : value''

            2. Else Phantom#1989

            3. If ((n_idx >= n_size)), then

              1. (Let value'' be (value_element)*[0])

              2. If ((value'' has type headerValue)), then

                1. (Let (header typeId { b_valid ; (fieldValue)* }) be (value'' as headerValue))

                2. (Let value''' be ((header typeId { false ; (fieldValue)* }) as value))

                3. Result in: % % % |- % : value'''

              2. Else Phantom#1990

            3. Else Phantom#1991

          4. Else Phantom#1992

        2. Else Phantom#1993

    2. Else Phantom#1994

  4. Case (% matches pattern `%[%:%]`)

    1. (Let (storageReference' [ value_hi : value_lo ]) be storageReference)

    2. Group sliceAccess: p EC ARCH |- (storageReference' [ value_hi : value_lo ]) : %

      1. (Lvalue_read: p EC ARCH |- storageReference' : value_base)

      2. (Let value be $bitacc_op(value_base, value_hi, value_lo))

      3. Result in: % % % |- % : value

;; ../../../../spec-concrete/8-dynamic/8.02-evaluation-relation.watsup:100.1-105.54
relation Lvalue_write: p EC_0 ARCH |- storageReference -> value : %

1. Case analysis on storageReference

  1. Case (% has type prefixedNameIR)

    1. (Let prefixedNameIR be (storageReference as prefixedNameIR))

    2. Group referenceExpressionIR: p EC_0 ARCH |- (prefixedNameIR as storageReference) -> value : %

      1. (Let EC_1 be $update_var_e(p, EC_0, prefixedNameIR, value))

      2. Result in: % % % |- % -> % : EC_1

  2. Case (% matches pattern `%.%`)

    1. (Let (storageReference' . nameIR) be storageReference)

    2. Group memberAccess: p EC_0 ARCH |- (storageReference' . nameIR) -> value : %

      1. (Lvalue_read: p EC_0 ARCH |- storageReference' : value')

      2. Case analysis on value'

        1. Case (% has type headerStackValue)

          1. (Let headerStackValue_base be (value' as headerStackValue))

          2. (Let (header_stack[ (value_element)* ( n_idx ; n_size )]) be headerStackValue_base)

          3. If ((nameIR = "next")), then

            1. (Let (value_element_update)* be (value_element)*[[n_idx] = value])

            2. (Let headerStackValue_base_update be (header_stack[ (value_element_update)* ( (n_idx + 1) ; n_size )]))

            3. (Lvalue_write: p EC_0 ARCH |- storageReference' -> (headerStackValue_base_update as value) : EC_1)

            4. Result in: % % % |- % -> % : EC_1

          3. Else Phantom#1995

        2. Case (% has type structValue)

          1. (Let structValue_base be (value' as structValue))

          2. (Let (struct typeId { (fieldValue)* }) be structValue_base)

          3. (Let (fieldValue_update)* be $update_fieldValue((fieldValue)*, nameIR, value))

          4. (Let structValue_base_update be (struct typeId { (fieldValue_update)* }))

          5. (Lvalue_write: p EC_0 ARCH |- storageReference' -> (structValue_base_update as value) : EC_1)

          6. Result in: % % % |- % -> % : EC_1

        3. Case (% has type headerValue)

          1. (Let headerValue_base be (value' as headerValue))

          2. (Let (header typeId { b_valid ; (fieldValue)* }) be headerValue_base)

          3. (Let (fieldValue_update)* be $update_fieldValue((fieldValue)*, nameIR, value))

          4. (Let headerValue_base_update be (header typeId { b_valid ; (fieldValue_update)* }))

          5. (Lvalue_write: p EC_0 ARCH |- storageReference' -> (headerValue_base_update as value) : EC_1)

          6. Result in: % % % |- % -> % : EC_1

        4. Case (% has type headerUnionValue)

          1. (Let headerUnionValue_base be (value' as headerUnionValue))

          2. (Let (header_union typeId { (fieldValue)* }) be headerUnionValue_base)

          3. (Let ((value_field nameIR_field ;))* be (fieldValue)*)

          4. (Let (value'')? be $assoc_<nameIR, value>(nameIR, ((nameIR_field, value_field))*))

          5. If (((value'')? matches pattern (_))), then

            1. (Let ?(value_old) be (value'')?)

            2. If ((value_old has type headerValue)), then

              1. (Let (header _typeId { b_valid_old ; (_fieldValue)* }) be (value_old as headerValue))

              2. (Let (fieldValue_update)* be $update_fieldValue((fieldValue)*, nameIR, value))

              3. If ((value has type headerValue)), then

                1. (Let (header _typeId' { b_valid_new ; (_fieldValue')* }) be (value as headerValue))

                2. (Let b_toggled be ((~b_valid_old /\ b_valid_new) \/ (b_valid_old /\ ~b_valid_new)))

                3. Case analysis on b_toggled

                  1. Case false

                    1. (Let headerUnionValue_base_update be (header_union typeId { (fieldValue_update)* }))

                    2. (Lvalue_write: p EC_0 ARCH |- storageReference' -> (headerUnionValue_base_update as value) : EC_1)

                    3. Result in: % % % |- % -> % : EC_1

                  2. Case true

                    1. (Let (fieldValue_update')* be $update_headerUnion((fieldValue_update)*, nameIR))

                    2. (Let headerUnionValue_base_update be (header_union typeId { (fieldValue_update')* }))

                    3. (Lvalue_write: p EC_0 ARCH |- storageReference' -> (headerUnionValue_base_update as value) : EC_1)

                    4. Result in: % % % |- % -> % : EC_1

              3. Else Phantom#1996

            2. Else Phantom#1997

          5. Else Phantom#1998

      2. Else Phantom#1999

  3. Case (% matches pattern `%[%]`)

    1. (Let (storageReference' [ value' ]) be storageReference)

    2. If ((value' has type integerValue)), then

      1. (Let integerValue_index be (value' as integerValue))

      2. Group indexAccess: p EC_0 ARCH |- (storageReference' [ (integerValue_index as value) ]) -> value : %

        1. (Lvalue_read: p EC_0 ARCH |- storageReference' : value'')

        2. If ((value'' has type headerStackValue)), then

          1. (Let headerStackValue_base be (value'' as headerStackValue))

          2. (Let (header_stack[ (value_element)* ( n_base_idx ; n_size )]) be headerStackValue_base)

          3. (Let (nat)? be $nat_of_integerValue(integerValue_index))

          4. If (((nat)? matches pattern (_))), then

            1. (Let ?(n_idx) be (nat)?)

            2. If ((n_idx < n_size)), then

              1. (Let (value_element_update)* be (value_element)*[[n_idx] = value])

              2. (Let headerStackValue_base_update be (header_stack[ (value_element_update)* ( n_base_idx ; n_size )]))

              3. (Lvalue_write: p EC_0 ARCH |- storageReference' -> (headerStackValue_base_update as value) : EC_1)

              4. Result in: % % % |- % -> % : EC_1

            2. Else Phantom#2000

            3. If ((n_idx >= n_size)), then

              1. Result in: % % % |- % -> % : EC_0

            3. Else Phantom#2001

          4. Else Phantom#2002

        2. Else Phantom#2003

    2. Else Phantom#2004

  4. Case (% matches pattern `%[%:%]`)

    1. (Let (storageReference' [ value_hi : value_lo ]) be storageReference)

    2. Group sliceAccess: p EC_0 ARCH |- (storageReference' [ value_hi : value_lo ]) -> value : %

      1. (Lvalue_read: p EC_0 ARCH |- storageReference' : value_base)

      2. (Let value_base_update be $bitacc_replace_op(value_base, value_hi, value_lo, value))

      3. (Lvalue_write: p EC_0 ARCH |- storageReference' -> value_base_update : EC_1)

      4. Result in: % % % |- % -> % : EC_1

;; ../../../../spec-concrete/8-dynamic/8.02-evaluation-relation.watsup:112.1-113.17
syntax callResult = 
   | exit
   | reject errorValue
   | return value?

;; ../../../../spec-concrete/8-dynamic/8.02-evaluation-relation.watsup:115.25-115.30
syntax forBreakResult = 
   | break

;; ../../../../spec-concrete/8-dynamic/8.02-evaluation-relation.watsup:116.28-116.36
syntax forContinueResult = 
   | continue

;; ../../../../spec-concrete/8-dynamic/8.02-evaluation-relation.watsup:119.1-120.22
syntax forResult = 
   | break
   | continue

;; ../../../../spec-concrete/8-dynamic/8.02-evaluation-relation.watsup:123.1-125.14
syntax statementResult = 
   | `empty
   | exit
   | reject errorValue
   | return value?
   | break
   | continue

;; ../../../../spec-concrete/8-dynamic/8.02-evaluation-relation.watsup:127.1-134.42
relation Stmt_eval: p EC ARCH |- statementIR : % % %

1. Case analysis on statementIR

  1. Case (% has type emptyStatement)

    1. (Let emptyStatement be (statementIR as emptyStatement))

    2. Group emptyStatementIR: p EC ARCH |- ((;) as statementIR) : % % %

      1. Result in: % % % |- % : EC ARCH ((`empty) as statementResult)

  2. Case (% has type assignmentStatementIR)

    1. (Let (typedLvalueIR assignop typedExpressionIR ;) be (statementIR as assignmentStatementIR))

    2. Group assignmentStatementIR: p EC ARCH |- ((typedLvalueIR assignop typedExpressionIR ;) as statementIR) : % % %

      1. (Lvalue_eval: p EC ARCH |- typedLvalueIR : EC_1 ARCH_1 storageReferenceResult)

      2. Case analysis on storageReferenceResult

        1. Case (% has type abortResult)

          1. (Let abortResult be (storageReferenceResult as abortResult))

          2. Result in: % % % |- % : EC_1 ARCH_1 (abortResult as statementResult)

        2. Case (% has type continueResult<storageReference?>)

          1. (Let (` (storageReference)?) be (storageReferenceResult as continueResult<storageReference?>))

          2. If (((storageReference)? matches pattern (_))), then

            1. (Let ?(storageReference') be (storageReference)?)

            2. If (~(assignop matches pattern `=`)), then

              1. (Lvalue_read: p EC_1 ARCH_1 |- storageReference' : value_l)

              2. (Expr_eval: p EC_1 ARCH_1 |- typedExpressionIR : EC_2 ARCH_2 expressionResult)

              3. Case analysis on expressionResult

                1. Case (% has type abortResult)

                  1. (Let abortResult be (expressionResult as abortResult))

                  2. Result in: % % % |- % : EC_2 ARCH_2 (abortResult as statementResult)

                2. Case (% has type continueResult<value>)

                  1. (Let (` value_r) be (expressionResult as continueResult<value>))

                  2. (Let (binop)? be $assignop_as_binop(assignop))

                  3. If (((binop)? matches pattern (_))), then

                    1. (Let ?(binop') be (binop)?)

                    2. (Let value_update be $bin_op(binop', value_l, value_r))

                    3. (Lvalue_write: p EC_2 ARCH_2 |- storageReference' -> value_update : EC_3)

                    4. Result in: % % % |- % : EC_3 ARCH_2 ((`empty) as statementResult)

                  3. Else Phantom#2005

            2. Else Phantom#2006

          2. Else Phantom#2007

      3. If ((assignop matches pattern `=`)), then

        1. If ((storageReferenceResult has type continueResult<storageReference?>)), then

          1. (Let (` (storageReference)?) be (storageReferenceResult as continueResult<storageReference?>))

          2. If (((storageReference)? matches pattern (_))), then

            1. (Let ?(storageReference') be (storageReference)?)

            2. (Expr_eval: p EC_1 ARCH_1 |- typedExpressionIR : EC_2 ARCH_2 expressionResult)

            3. Case analysis on expressionResult

              1. Case (% has type abortResult)

                1. (Let abortResult be (expressionResult as abortResult))

                2. Result in: % % % |- % : EC_2 ARCH_2 (abortResult as statementResult)

              2. Case (% has type continueResult<value>)

                1. (Let (` value) be (expressionResult as continueResult<value>))

                2. (Lvalue_write: p EC_2 ARCH_2 |- storageReference' -> value : EC_3)

                3. Result in: % % % |- % : EC_3 ARCH_2 ((`empty) as statementResult)

          2. Else Phantom#2008

        1. Else Phantom#2009

      3. Else Phantom#2010

  3. Case (% has type callStatementIR)

    1. (Let (callableTargetIR < (typeArgumentIR)* >( (argumentIR)* );) be (statementIR as callStatementIR))

    2. Group callStatementIR: p EC ARCH |- ((callableTargetIR < (typeArgumentIR)* >( (argumentIR)* );) as statementIR) : % % %

      1. (Callee_eval: p EC ARCH |- callableTargetIR <_>( (argumentIR)* ): EC_1 ARCH_1 calleeResult)

      2. Case analysis on calleeResult

        1. Case (% has type abortResult)

          1. (Let abortResult be (calleeResult as abortResult))

          2. Result in: % % % |- % : EC_1 ARCH_1 (abortResult as statementResult)

        2. Case (% has type continueResult<callee>)

          1. (Let (` callee) be (calleeResult as continueResult<callee>))

          2. (Call_eval: p EC_1 ARCH_1 |- callee @< (typeArgumentIR)* >( (argumentIR)* ): EC_2 ARCH_2 callResult)

          3. Case analysis on callResult

            1. Case (% has type abortResult)

              1. (Let abortResult be (callResult as abortResult))

              2. Result in: % % % |- % : EC_2 ARCH_2 (abortResult as statementResult)

            2. Case (% has type returnResult)

              1. Result in: % % % |- % : EC_2 ARCH_2 ((`empty) as statementResult)

  4. Case (% has type exitStatement)

    1. (Let exitStatement be (statementIR as exitStatement))

    2. Group exitStatementIR: p EC ARCH |- ((exit;) as statementIR) : % % %

