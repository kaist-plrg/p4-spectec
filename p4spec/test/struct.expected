            2. (Let IC_inner be $enter_path(IC_0, nameIR))

            3. (Constructor_inst: (global) IC_inner STO' |- constructor < typeArgumentListIR >( argumentListIR # id_default*{id_default <- id_default*} )==> STO_1 object)

