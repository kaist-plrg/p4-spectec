   | table_struct typeId {hit boolValue ;miss boolValue ;action_run tableMetadataEnumValue ;}

;; ../../../../spec-concrete/2-static-runtime/2.1.1-value.watsup:95.1-100.23
syntax synthesizedValue = 
   | default
   | {#}
   | seq( value* )
   | seq( value* ,...)
