   | seq{ typedExpressionListIR ,...}
   | record{ namedExpressionListIR }
   | record{ namedExpressionListIR ,...}

;; ../../../../spec-concrete/4-p4-ir/4.0-ir-syntax.watsup:128.3-128.18
syntax errorAccessExpressionIR = 
   | error. nameIR

;; ../../../../spec-concrete/4-p4-ir/4.0-ir-syntax.watsup:131.3-131.31
syntax memberAccessExpressionIR = 
   | memberAccessBaseIR . nameIR

;; ../../../../spec-concrete/4-p4-ir/4.0-ir-syntax.watsup:134.3-134.43
syntax indexAccessExpressionIR = 
   | typedExpressionIR [ typedExpressionIR ]

;; ../../../../spec-concrete/4-p4-ir/4.0-ir-syntax.watsup:137.3-137.64
syntax sliceAccessExpressionIR = 
   | typedExpressionIR [ typedExpressionIR : typedExpressionIR ]

;; ../../../../spec-concrete/4-p4-ir/4.0-ir-syntax.watsup:140.1-143.28
syntax accessExpressionIR = 
   | error. nameIR
   | memberAccessBaseIR . nameIR
   | typedExpressionIR [ typedExpressionIR ]
   | typedExpressionIR [ typedExpressionIR : typedExpressionIR ]

;; ../../../../spec-concrete/4-p4-ir/4.0-ir-syntax.watsup:154.1-157.26
syntax callableTargetIR = 
   | ` nameIR hint(print %0)
   | . nameIR
   | typedExpressionIR . nameIR
   | type prefixedNameIR . nameIR
   | ( callableTargetIR )

;; ../../../../spec-concrete/4-p4-ir/4.0-ir-syntax.watsup:159.30-159.68
syntax constructorTargetIR = 
   | prefixedNameIR < typeArgumentListIR >

;; ../../../../spec-concrete/4-p4-ir/4.0-ir-syntax.watsup:162.1-163.65
syntax callExpressionIR = 
   | constructorTargetIR ( argumentListIR )
   | callableTargetIR < typeArgumentListIR >( argumentListIR )

;; ../../../../spec-concrete/4-p4-ir/4.0-ir-syntax.watsup:169.36-169.58
syntax parenthesizedExpressionIR = 
   | ( typedExpressionIR )

;; ../../../../spec-concrete/4-p4-ir/4.0-ir-syntax.watsup:176.1-186.30
syntax expressionIR = 
   | true
   | false
   | d int hint(print %)
   | nat w int hint(print %#W#%)
   | nat s int hint(print %#S#%)
   | " text " hint(print "#%#")
   | ` nameIR hint(print %0)
   | . nameIR
   | ...
   | unop typedExpressionIR
   | typedExpressionIR binop typedExpressionIR
   | typedExpressionIR ? typedExpressionIR : typedExpressionIR
   | ( typeIR ) typedExpressionIR
   | {#}
   | seq{ typedExpressionListIR }
   | seq{ typedExpressionListIR ,...}
   | record{ namedExpressionListIR }
   | record{ namedExpressionListIR ,...}
   | error. nameIR
   | memberAccessBaseIR . nameIR
   | typedExpressionIR [ typedExpressionIR ]
   | typedExpressionIR [ typedExpressionIR : typedExpressionIR ]
   | constructorTargetIR ( argumentListIR )
   | callableTargetIR < typeArgumentListIR >( argumentListIR )
   | ( typedExpressionIR )

;; ../../../../spec-concrete/4-p4-ir/4.0-ir-syntax.watsup:188.27-190.54
syntax expressionNoteIR = 
   | ( typeIR ctk ) hint(prose "type" %0 "and compile-time known-ness" %1) hint(prose_fields "type" "compile-time known-ness")

;; ../../../../spec-concrete/4-p4-ir/4.0-ir-syntax.watsup:193.3-196.41
syntax typedExpressionIR = 
   | expressionIR # expressionNoteIR hint(print %0) hint(prose %0 "annotated with" %1) hint(prose_fields "expression" "note")

