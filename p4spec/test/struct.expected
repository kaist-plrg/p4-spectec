  2. Case (% matches pattern [ _/1 ])

    1. (Let [ctk] be ctk''*{ctk'' <- ctk''*})

    2. Return ctk

  3. Case (% matches pattern _ :: _)

    1. (Let ctk_a :: ctk*{ctk <- ctk*} be ctk''*{ctk'' <- ctk''*})

