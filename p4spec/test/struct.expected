    1. (Let typedExpressionIR_h :: typedExpressionIR_t*{typedExpressionIR_t <- typedExpressionIR_t*} be typedExpressionIR'''*{typedExpressionIR''' <- typedExpressionIR'''*})

    2. (Expr_eval: p evalContext store |- typedExpressionIR_h : EC_1 STO_1 expressionResult)

    3. Case analysis on expressionResult

