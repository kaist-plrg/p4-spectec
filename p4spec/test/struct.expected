;; ../../../../spec-concrete/5.04-typing-relation.watsup:287.1-289.23
relation Decls_ok: p TC' |- declaration*{declaration <- declaration*} : % %

1. Case analysis on declaration*{declaration <- declaration*}

  1. Case (% matches pattern [])

    1. Group nil: p TC |- [] : % %

      1. Result in : % % |- % : TC' []

  2. Case (% matches pattern _ :: _)

    1. (Let declaration_h :: declaration_t*{declaration_t <- declaration_t*} be declaration*{declaration <- declaration*})

    2. Group cons: p TC_0 |- declaration_h :: declaration_t*{} : % %

      1. (Decl_ok: p TC' |- declaration_h : TC_1 declarationIR_h)

      2. (Decls_ok: p TC_1 |- declaration_t*{declaration_t <- declaration_t*} : TC_2 declarationIR_t*{declarationIR_t <- declarationIR_t*})

      3. Result in : % % |- % : TC_2 declarationIR_h :: declarationIR_t*{declarationIR_t <- declarationIR_t*}

