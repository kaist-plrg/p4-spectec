    1. (Let typeDefEnv be TC.block.type)

    2. If (~$in_set<tid>(tid, $dom_map<tid, typeDefIR>(typeDefEnv))), then

      1. (Let typeDefEnv_update be $add_map<tid, typeDefIR>(TC.global.type, tid, typeDefIR))

      2. (Let TC' be TC[global.type = typeDefEnv_update])

