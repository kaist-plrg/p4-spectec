;; ../../../../spec-concrete/2-static-runtime/2.1.2-value-aux.watsup:106.1-106.50
def $invalidate_header((header typeId { _bool ; (fieldValue)* }))

1. Return (header typeId { false ; (fieldValue)* })

;; ../../../../spec-concrete/2-static-runtime/2.1.2-value-aux.watsup:107.1-107.65
