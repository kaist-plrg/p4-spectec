      1. Return ?()

    3. (Let (rid, V, id*)*{(rid, V, id*) <- (rid, V, id*)*} be $find_matchings<V>(id_r, id_arg?{id_arg <- id_arg?}*{id_arg? <- id_arg?*}, id_arg'*{id_arg' <- id_arg'*}, rid*{rid <- rid*}, V*{V <- V*}))

