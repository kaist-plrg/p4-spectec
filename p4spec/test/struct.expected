   | default

;; ../../../../spec-concrete/2-static-runtime/2.1.1-value.watsup:66.29-66.33
syntax invalidHeaderValue = 
   | {#}

;; ../../../../spec-concrete/2-static-runtime/2.1.1-value.watsup:69.1-70.28
syntax sequenceValue = 
   | seq( value* )
   | seq( value* ,...)

;; ../../../../spec-concrete/2-static-runtime/2.1.1-value.watsup:73.1-74.36
syntax recordValue = 
   | record{ fieldValue* }
   | record{ fieldValue* ,...}

;; ../../../../spec-concrete/2-static-runtime/2.1.1-value.watsup:77.1-81.18
syntax setValue = 
   | set{ value }
