relation Decls_inst: p IC' STO' |- declarationIR*{declarationIR <- declarationIR*} ==> % % %

1. Case analysis on declarationIR*{declarationIR <- declarationIR*}

  1. Case (% matches pattern [])

    1. Group nil: p IC STO |- [] ==> % % %

      1. Result in : % % % |- % ==> IC' STO' []

  2. Case (% matches pattern _ :: _)

    1. (Let declarationIR_h :: declarationIR_t*{declarationIR_t <- declarationIR_t*} be declarationIR*{declarationIR <- declarationIR*})

    2. Group cons-none: p IC_0 STO_0 |- declarationIR_h :: declarationIR_t*{} ==> % % %

      1. (Decl_inst: p IC' STO' |- declarationIR_h ==> IC_1 STO_1 declarationIR'?{declarationIR' <- declarationIR'?})

      2. If ((declarationIR'?{declarationIR' <- declarationIR'?} matches pattern ())), then

        1. (Decls_inst: p IC_1 STO_1 |- declarationIR_t*{declarationIR_t <- declarationIR_t*} ==> IC_2 STO_2 declarationIR_t_inst*{declarationIR_t_inst <- declarationIR_t_inst*})

        2. Result in : % % % |- % ==> IC_2 STO_2 declarationIR_t_inst*{declarationIR_t_inst <- declarationIR_t_inst*}

    3. Group cons-some: p IC_0 STO_0 |- declarationIR_h :: declarationIR_t*{} ==> % % %

      1. (Decl_inst: p IC' STO' |- declarationIR_h ==> IC_1 STO_1 declarationIR'?{declarationIR' <- declarationIR'?})

      2. If ((declarationIR'?{declarationIR' <- declarationIR'?} matches pattern (_))), then

        1. (Let ?(declarationIR_h_inst) be declarationIR'?{declarationIR' <- declarationIR'?})

        2. (Decls_inst: p IC_1 STO_1 |- declarationIR_t*{declarationIR_t <- declarationIR_t*} ==> IC_2 STO_2 declarationIR_t_inst*{declarationIR_t_inst <- declarationIR_t_inst*})

        3. Result in : % % % |- % ==> IC_2 STO_2 declarationIR_h_inst :: declarationIR_t_inst*{declarationIR_t_inst <- declarationIR_t_inst*}

