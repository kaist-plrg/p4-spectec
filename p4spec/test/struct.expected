;; ../../../../spec-concrete/6.2.2-callable-callee.watsup:38.3-39.50
syntax externMethodCallee = 
   | extern_method oid . nameIR < typeParameterListIR >( parameterListIR # id* ) blockStatementIR?

;; ../../../../spec-concrete/6.2.2-callable-callee.watsup:42.3-43.59
syntax parserApplyMethodCallee = 
