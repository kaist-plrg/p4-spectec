;; ../../../../spec-concrete/5.02.1-typing-context.watsup:323.1-323.68
def $find_var_t(p', TC, prefixedNameIR)

1. If ((prefixedNameIR matches pattern `.%`)), then

  1. (Let (. id) be prefixedNameIR)

  2. (Let typeFrame be TC.global.frame)

  3. Return $find_map<id, varTypeIR>(typeFrame, id)

2. Case analysis on p'

  1. Case (% matches pattern `GLOBAL`)

    1. If ((prefixedNameIR matches pattern ``%`)), then

      1. (Let (` id) be prefixedNameIR)

      2. (Let typeFrame be TC.global.frame)

      3. Return $find_map<id, varTypeIR>(typeFrame, id)

  2. Case (% matches pattern `BLOCK`)

    1. If ((prefixedNameIR matches pattern ``%`)), then

      1. (Let (` id) be prefixedNameIR)

      2. (Let typeFrame be TC.block.frame)

      3. (Let varTypeIR'?{varTypeIR' <- varTypeIR'?} be $find_map<id, varTypeIR>(typeFrame, id))

      4. If ((varTypeIR'?{varTypeIR' <- varTypeIR'?} matches pattern (_))), then

        1. (Let ?(varTypeIR) be varTypeIR'?{varTypeIR' <- varTypeIR'?})

        2. Return ?(varTypeIR)

      5. If ((?() = $find_map<id, varTypeIR>(typeFrame, id))), then

        1. Return $find_var_t((global), TC, (` id))

  3. Case (% matches pattern `LOCAL`)

    1. If ((prefixedNameIR matches pattern ``%`)), then

      1. (Let (` id) be prefixedNameIR)

      2. (Let typeFrame*{typeFrame <- typeFrame*} be TC.local.frames)

      3. (Let varTypeIR'?{varTypeIR' <- varTypeIR'?} be $find_maps<id, varTypeIR>(typeFrame*{typeFrame <- typeFrame*}, id))

      4. If ((varTypeIR'?{varTypeIR' <- varTypeIR'?} matches pattern (_))), then

        1. (Let ?(varTypeIR) be varTypeIR'?{varTypeIR' <- varTypeIR'?})

        2. Return ?(varTypeIR)

      5. If ((?() = $find_maps<id, varTypeIR>(typeFrame*{typeFrame <- typeFrame*}, id))), then

        1. Return $find_var_t((block), TC, (` id))

;; ../../../../spec-concrete/5.02.1-typing-context.watsup:344.1-344.69
def $find_var_value_t(p, TC, prefixedNameIR)

1. (Let varTypeIR?{varTypeIR <- varTypeIR?} be $find_var_t(p, TC, prefixedNameIR))

2. If ((varTypeIR?{varTypeIR <- varTypeIR?} matches pattern (_))), then

  1. (Let ?((_direction _typeIR _ctk value'?{value' <- value'?})) be varTypeIR?{varTypeIR <- varTypeIR?})

  2. If ((value'?{value' <- value'?} matches pattern (_))), then

