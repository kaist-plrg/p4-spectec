        1. Return $directionless_trailing'(true, (direction_t)*)

      2. Else Phantom#761

    1. Else Phantom#762

  2. Case (% = false)

    1. If (((direction)* matches pattern _ :: _)), then

      1. (Let direction' :: (direction_t)* be (direction)*)

      2. If ((direction' matches pattern ``EMPTY`)), then

        1. Return false

      2. Else Phantom#763

    1. Else Phantom#764

