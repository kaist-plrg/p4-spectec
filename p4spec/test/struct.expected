   | header_union typeId { fieldValue* }

;; ../../../../spec-concrete/2-static-runtime/2.1.1-value.watsup:42.1-43.30
syntax enumValue = 
   | typeId . nameIR
   | typeId . nameIR . value

;; ../../../../spec-concrete/2-static-runtime/2.1.1-value.watsup:46.1-52.14
syntax dataValue = 
   | list[ value* ]
   | tuple( value* )
   | header_stack[ value* ( nat ; nat )]
   | struct typeId { fieldValue* }
   | header typeId { bool ; fieldValue* }
   | header_union typeId { fieldValue* }
   | typeId . nameIR
   | typeId . nameIR . value

;; ../../../../spec-concrete/2-static-runtime/2.1.1-value.watsup:58.31-58.43
