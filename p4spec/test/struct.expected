              2. (Let typedExpressionIR?{typedExpressionIR <- typedExpressionIR?} be $coerce_unary(typedExpressionIR_init, typeIR))

              3. If ((typedExpressionIR?{typedExpressionIR <- typedExpressionIR?} matches pattern (_))), then

