;; ../../../../spec-concrete/4-p4-ir/4.0-ir-syntax.watsup:6.1-7.14
syntax prefixedNameIR = 
   | ` nameIR hint(print %0)
   | . nameIR

;; ../../../../spec-concrete/4-p4-ir/4.0-ir-syntax.watsup:9.1-10.44
def $prefixedNonTypeName(prefixedNonTypeName)

1. Case analysis on prefixedNonTypeName

  1. Case (% has type nonTypeName)

    1. (Let nonTypeName be (prefixedNonTypeName as nonTypeName))

    2. Return (` $name((nonTypeName as name)))

  2. Case (% matches pattern ``ID.%`)

    1. (Let (`id. nonTypeName) be prefixedNonTypeName)

    2. Return (. $name((nonTypeName as name)))

;; ../../../../spec-concrete/4-p4-ir/4.0-ir-syntax.watsup:14.1-15.44
def $prefixedTypeName(prefixedTypeName)

1. Case analysis on prefixedTypeName

  1. Case (% has type typeName)

    1. (Let typeName be (prefixedTypeName as typeName))

    2. Return (` $name((typeName as name)))

  2. Case (% matches pattern ``TID.%`)

    1. (Let (`tid. typeName) be prefixedTypeName)

    2. Return (. $name((typeName as name)))

;; ../../../../spec-concrete/4-p4-ir/4.0-ir-syntax.watsup:19.1-20.42
def $flatten_prefixedNameIR(prefixedNameIR)

1. Case analysis on prefixedNameIR

  1. Case (% matches pattern ``%`)

    1. (Let (` nameIR) be prefixedNameIR)

    2. Return nameIR

  2. Case (% matches pattern `.%`)

    1. (Let (. nameIR) be prefixedNameIR)

    2. Return "." ++ nameIR

