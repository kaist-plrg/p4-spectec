  1. Return ?((cid, V, []))

3. Otherwise

  1. Return ?()

;; ../../../../spec-concrete/5.01-static-env.watsup:79.1-79.69
def $find_match_named_default<V>(cid, V, id_arg*{id_arg <- id_arg*}, pid'*{pid' <- pid'*})

