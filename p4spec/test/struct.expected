def $find_matching<V>(id_r, id_arg?{id_arg <- id_arg?}*{id_arg? <- id_arg?*}, id_arg''*{id_arg'' <- id_arg''*}, (id_r' ( pid_r''*{pid_r'' <- pid_r''*} )), V)

1. If (~$check_routine_name(id_r, id_r')), then

  1. Return ?()

2. (Let (id_param' # bool_param') be pid_r'')*{pid_r'' <- pid_r''*, bool_param' <- bool_param'*, id_param' <- id_param'*}

3. If ($check_routine_name(id_r, id_r')), then

