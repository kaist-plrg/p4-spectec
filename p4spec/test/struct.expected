    2. If ($check_arity_less(id_arg?{id_arg <- id_arg?}*{id_arg? <- id_arg?*}, id_param'*{id_param' <- id_param'*})), then

      1. Return $find_match_named_default<V>((id_r' ( (id_param' # bool_param')*{bool_param' <- bool_param'*, id_param' <- id_param'*} )), V, id_arg''*{id_arg'' <- id_arg''*}, (id_param' # bool_param')*{bool_param' <- bool_param'*, id_param' <- id_param'*})

5. If ((id_arg''*{id_arg'' <- id_arg''*} matches pattern [])), then

  1. If ($check_callable_name(id_r, id_r')), then

    1. If ($check_arity(id_arg?{id_arg <- id_arg?}*{id_arg? <- id_arg?*}, id_param'*{id_param' <- id_param'*})), then

      1. Return ?(((id_r' ( (id_param' # bool_param')*{bool_param' <- bool_param'*, id_param' <- id_param'*} )), V, []))

    2. If ($check_arity_less(id_arg?{id_arg <- id_arg?}*{id_arg? <- id_arg?*}, id_param'*{id_param' <- id_param'*})), then

      1. Return $find_match_unnamed_default<V>((id_r' ( (id_param' # bool_param')*{bool_param' <- bool_param'*, id_param' <- id_param'*} )), V, id_arg?{id_arg <- id_arg?}*{id_arg? <- id_arg?*}, (id_param' # bool_param')*{bool_param' <- bool_param'*, id_param' <- id_param'*})

;; ../../../../spec-concrete/5.01-static-env.watsup:175.1-175.69
def $find_overloadeds<V>(id_r, id_arg?{id_arg <- id_arg?}*{id_arg? <- id_arg?*}, id_arg'*{id_arg' <- id_arg'*}, cid''*{cid'' <- cid''*}, V''*{V'' <- V''*})

1. Case analysis on cid''*{cid'' <- cid''*}

  1. Case (% matches pattern [])

    1. If ((V''*{V'' <- V''*} matches pattern [])), then

      1. Return []

  2. Case (% matches pattern _ :: _)

    1. (Let cid_h :: cid_t*{cid_t <- cid_t*} be cid''*{cid'' <- cid''*})

    2. If ((V''*{V'' <- V''*} matches pattern _ :: _)), then

      1. (Let V_h :: V_t*{V_t <- V_t*} be V''*{V'' <- V''*})

      2. If (($check_overloaded<V>(id_r, id_arg?{id_arg <- id_arg?}*{id_arg? <- id_arg?*}, id_arg'*{id_arg' <- id_arg'*}, cid_h, V_h) = ?())), then

        1. Return $find_overloadeds<V>(id_r, id_arg?{id_arg <- id_arg?}*{id_arg? <- id_arg?*}, id_arg'*{id_arg' <- id_arg'*}, cid_t*{cid_t <- cid_t*}, V_t*{V_t <- V_t*})

      3. (Let (cid, V, id*)?{(cid, V, id*) <- (cid, V, id*)?} be $check_overloaded<V>(id_r, id_arg?{id_arg <- id_arg?}*{id_arg? <- id_arg?*}, id_arg'*{id_arg' <- id_arg'*}, cid_h, V_h))

      4. If (((cid, V, id*)?{(cid, V, id*) <- (cid, V, id*)?} matches pattern (_))), then

        1. (Let ?((cid, V, id_default*{id_default <- id_default*})) be (cid, V, id*)?{(cid, V, id*) <- (cid, V, id*)?})

        2. Return (cid, V, id_default*{id_default <- id_default*}) :: $find_overloadeds<V>(id_r, id_arg?{id_arg <- id_arg?}*{id_arg? <- id_arg?*}, id_arg'*{id_arg' <- id_arg'*}, cid_t*{cid_t <- cid_t*}, V_t*{V_t <- V_t*})

;; ../../../../spec-concrete/5.01-static-env.watsup:198.1-198.66
def $find_overloaded<V>(({ (cid : V)*{V <- V*, cid <- cid*} }), id_r, id_arg?{id_arg <- id_arg?}*{id_arg? <- id_arg?*})

1. If ((|id_arg?{id_arg <- id_arg?}*{id_arg? <- id_arg?*}| > 0)), then

  1. (Let id?{id <- id?} be id_arg?{id_arg <- id_arg?})*{id? <- id?*, id_arg? <- id_arg?*}

  2. If ((id?{id <- id?} matches pattern (_)))*{id? <- id?*}, then

    1. (Let ?(id_arg') be id?{id <- id?})*{id? <- id?*, id_arg' <- id_arg'*}

    2. If (($find_overloadeds<V>(id_r, id_arg?{id_arg <- id_arg?}*{id_arg? <- id_arg?*}, id_arg'*{id_arg' <- id_arg'*}, cid*{cid <- cid*}, V*{V <- V*}) = [])), then

      1. Return ?()

    3. (Let (cid, V, id*)*{(cid, V, id*) <- (cid, V, id*)*} be $find_overloadeds<V>(id_r, id_arg?{id_arg <- id_arg?}*{id_arg? <- id_arg?*}, id_arg'*{id_arg' <- id_arg'*}, cid*{cid <- cid*}, V*{V <- V*}))

    4. If (((cid, V, id*)*{(cid, V, id*) <- (cid, V, id*)*} matches pattern [ _/1 ])), then

      1. (Let [(cid', V', id_default*{id_default <- id_default*})] be (cid, V, id*)*{(cid, V, id*) <- (cid, V, id*)*})

      2. Return ?((cid', V', id_default*{id_default <- id_default*}))

2. If ((id_arg?{id_arg <- id_arg?} = ?()))*{id_arg? <- id_arg?*}, then

  1. If (($find_overloadeds<V>(id_r, id_arg?{id_arg <- id_arg?}*{id_arg? <- id_arg?*}, [], cid*{cid <- cid*}, V*{V <- V*}) = [])), then

    1. Return ?()

  2. (Let (cid, V, id*)*{(cid, V, id*) <- (cid, V, id*)*} be $find_overloadeds<V>(id_r, id_arg?{id_arg <- id_arg?}*{id_arg? <- id_arg?*}, [], cid*{cid <- cid*}, V*{V <- V*}))

  3. If (((cid, V, id*)*{(cid, V, id*) <- (cid, V, id*)*} matches pattern [ _/1 ])), then

    1. (Let [(cid', V', id_default*{id_default <- id_default*})] be (cid, V, id*)*{(cid, V, id*) <- (cid, V, id*)*})

    2. Return ?((cid', V', id_default*{id_default <- id_default*}))

;; ../../../../spec-concrete/5.01-static-env.watsup:238.1-238.50
def $find_non_overloaded<V>(({ (cid : V)*{V <- V*, cid <- cid*} }), id)

1. (Let V''*{V'' <- V''*} be $find_non_overloaded'<V>(({ (cid : V)*{V <- V*, cid <- cid*} }), id))

2. If ((V''*{V'' <- V''*} matches pattern [ _/1 ])), then

  1. (Let [V'] be V''*{V'' <- V''*})

  2. Return ?(V')

3. Otherwise

  1. Return ?()

;; ../../../../spec-concrete/5.01-static-env.watsup:239.1-239.51
def $find_non_overloaded'<V>(set<pair<cid, V>>', id)

1. If ((set<pair<cid, V>>' = ({ [] }))), then

  1. Return []

2. (Let ({ pair<cid, V>*{pair<cid, V> <- pair<cid, V>*} }) be set<pair<cid, V>>')

3. If ((pair<cid, V>*{pair<cid, V> <- pair<cid, V>*} matches pattern _ :: _)), then

  1. (Let (cid_h : V_h) :: (cid_t : V_t)*{V_t <- V_t*, cid_t <- cid_t*} be pair<cid, V>*{pair<cid, V> <- pair<cid, V>*})

  2. (Let (id' ( _pid*{_pid <- _pid*} )) be cid_h)

  3. Case analysis on id'

    1. Case (% = id)

      1. (Let V_t_found*{V_t_found <- V_t_found*} be $find_non_overloaded'<V>(({ (cid_t : V_t)*{V_t <- V_t*, cid_t <- cid_t*} }), id))

      2. Return V_h :: V_t_found*{V_t_found <- V_t_found*}

    2. Case (% =/= id)

      1. (Let V_t_found*{V_t_found <- V_t_found*} be $find_non_overloaded'<V>(({ (cid_t : V_t)*{V_t <- V_t*, cid_t <- cid_t*} }), id))

      2. Return V_t_found*{V_t_found <- V_t_found*}

