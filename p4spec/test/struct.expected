syntax localTypingLayer = {kind localKind, type typeDefEnv, frames typeFrame*}

;; ../../../../spec-concrete/5.02.1-typing-context.watsup:105.3-107.29
syntax typingContext = {global globalTypingLayer, block blockTypingLayer, local localTypingLayer}

;; ../../../../spec-concrete/5.02.1-typing-context.watsup:115.1-115.41
def $empty_typingContext

1. (Let globalTypingLayer be {constructor $empty_constructorTypeDefEnv, type $empty_typeDefEnv, callable $empty_callableTypeDefEnv, frame $empty_typeFrame})

2. (Let blockTypingLayer be {kind (), type $empty_typeDefEnv, callable $empty_callableTypeDefEnv, frame $empty_typeFrame})

3. (Let localTypingLayer be {kind (), type $empty_typeDefEnv, frames [$empty_typeFrame]})

4. (Let TC be {global globalTypingLayer, block blockTypingLayer, local localTypingLayer})

5. Return TC

;; ../../../../spec-concrete/5.02.1-typing-context.watsup:141.1-141.42
def $bound(cursor, TC)

1. Case analysis on cursor

  1. Case (% matches pattern `GLOBAL`)

    1. Return ({ [] })

  2. Case (% matches pattern `BLOCK`)

    1. Return $dom_map<tid, typeDefIR>(TC.block.type)

  3. Case (% matches pattern `LOCAL`)

    1. (Let bound_block be $bound((block), TC))

    2. (Let bound_local be $dom_map<tid, typeDefIR>(TC.local.type))

    3. Return $union_set<tid>(bound_block, bound_local)

;; ../../../../spec-concrete/5.02.1-typing-context.watsup:153.1-153.44
def $enter_t(TC)

1. Return TC[local.frames = $empty_typeFrame :: TC.local.frames]

;; ../../../../spec-concrete/5.02.1-typing-context.watsup:158.1-158.43
def $exit_t(TC)

1. (Let typeFrame*{typeFrame <- typeFrame*} be TC.local.frames)

2. If ((typeFrame*{typeFrame <- typeFrame*} matches pattern _ :: _)), then

  1. (Let typeFrame_h :: typeFrame_t*{typeFrame_t <- typeFrame_t*} be typeFrame*{typeFrame <- typeFrame*})

  2. Return TC[local.frames = typeFrame_t*{typeFrame_t <- typeFrame_t*}]

;; ../../../../spec-concrete/5.02.1-typing-context.watsup:169.1-169.69
def $add_var_t(cursor, TC, id, varTypeIR)

1. Case analysis on cursor

  1. Case (% matches pattern `GLOBAL`)

    1. (Let typeFrame be TC.global.frame)

    2. If (~$in_set<id>(id, $dom_map<id, varTypeIR>(typeFrame))), then

      1. (Let (_direction typeIR _ctk _value?{_value <- _value?}) be varTypeIR)

      2. If (((id = "main") => $is_packageObjectTypeIR($canon_typeIR(typeIR)))), then

        1. (Let typeFrame_update be $add_map<id, varTypeIR>(typeFrame, id, varTypeIR))

        2. (Let TC' be TC[global.frame = typeFrame_update])

        3. Return TC'

  2. Case (% matches pattern `BLOCK`)

    1. (Let typeFrame be TC.block.frame)

    2. If (~$in_set<id>(id, $dom_map<id, varTypeIR>(typeFrame))), then

      1. If ((id =/= "main")), then

        1. (Let typeFrame_update be $add_map<id, varTypeIR>(TC.block.frame, id, varTypeIR))

        2. (Let TC' be TC[block.frame = typeFrame_update])

        3. Return TC'

  3. Case (% matches pattern `LOCAL`)

    1. (Let typeFrame'*{typeFrame' <- typeFrame'*} be TC.local.frames)

    2. If ((typeFrame'*{typeFrame' <- typeFrame'*} matches pattern _ :: _)), then

      1. (Let typeFrame_h :: typeFrame_t*{typeFrame_t <- typeFrame_t*} be typeFrame'*{typeFrame' <- typeFrame'*})

      2. If (~$in_set<id>(id, $dom_map<id, varTypeIR>(typeFrame_h))), then

        1. If ((id =/= "main")), then

          1. (Let typeFrame_h_update be $add_map<id, varTypeIR>(typeFrame_h, id, varTypeIR))

          2. (Let typeFrame*{typeFrame <- typeFrame*} be typeFrame_h_update :: typeFrame_t*{typeFrame_t <- typeFrame_t*})

          3. (Let TC' be TC[local.frames = typeFrame*{typeFrame <- typeFrame*}])

          4. Return TC'

;; ../../../../spec-concrete/5.02.1-typing-context.watsup:170.1-170.72
def $add_vars_t(p, TC, id*{id <- id*}, varTypeIR*{varTypeIR <- varTypeIR*})

1. Case analysis on id*{id <- id*}

  1. Case (% matches pattern [])

    1. If ((varTypeIR*{varTypeIR <- varTypeIR*} matches pattern [])), then

      1. Return TC

  2. Case (% matches pattern _ :: _)

    1. (Let id_h :: id_t*{id_t <- id_t*} be id*{id <- id*})

    2. If ((varTypeIR*{varTypeIR <- varTypeIR*} matches pattern _ :: _)), then

      1. (Let varTypeIR_h :: varTypeIR_t*{varTypeIR_t <- varTypeIR_t*} be varTypeIR*{varTypeIR <- varTypeIR*})

      2. (Let TC' be $add_var_t(p, TC, id_h, varTypeIR_h))

      3. (Let TC'' be $add_vars_t(p, TC', id_t*{id_t <- id_t*}, varTypeIR_t*{varTypeIR_t <- varTypeIR_t*}))

      4. Return TC''

;; ../../../../spec-concrete/5.02.1-typing-context.watsup:203.1-203.77
def $add_parameter_t(cursor, TC, (direction typeIR id value?{value <- value?}))

1. Case analysis on (direction matches pattern ``EMPTY`)

  1. Case true

    1. (Let varTypeIR be (() typeIR (ctk) value?{value <- value?}))

    2. (Let TC' be $add_var_t(cursor, TC, id, varTypeIR))

    3. Return TC'

  2. Case false

    1. (Let varTypeIR be (direction typeIR (dyn) value?{value <- value?}))

    2. (Let TC' be $add_var_t(cursor, TC, id, varTypeIR))

    3. Return TC'

;; ../../../../spec-concrete/5.02.1-typing-context.watsup:204.1-204.79
def $add_parameters_t(cursor, TC, parameterTypeIR*{parameterTypeIR <- parameterTypeIR*})

1. Case analysis on parameterTypeIR*{parameterTypeIR <- parameterTypeIR*}

  1. Case (% matches pattern [])

    1. Return TC

  2. Case (% matches pattern _ :: _)

    1. (Let parameterTypeIR_h :: parameterTypeIR_t*{parameterTypeIR_t <- parameterTypeIR_t*} be parameterTypeIR*{parameterTypeIR <- parameterTypeIR*})

    2. (Let TC' be $add_parameter_t(cursor, TC, parameterTypeIR_h))

    3. (Let TC'' be $add_parameters_t(cursor, TC', parameterTypeIR_t*{parameterTypeIR_t <- parameterTypeIR_t*}))

    4. Return TC''

;; ../../../../spec-concrete/5.02.1-typing-context.watsup:221.1-221.80
def $add_constructorParameter_t(TC, (direction typeIR id value''?{value'' <- value''?}))

1. Case analysis on value''?{value'' <- value''?}

  1. Case (% matches pattern ())

    1. (Let varTypeIR be (direction typeIR (ctk) ?()))

    2. (Let TC' be $add_var_t((block), TC, id, varTypeIR))

    3. Return TC'

  2. Case (% matches pattern (_))

    1. (Let ?(value) be value''?{value'' <- value''?})

    2. (Let varTypeIR be (direction typeIR (ctk) ?(value)))

    3. (Let TC' be $add_var_t((block), TC, id, varTypeIR))

    4. Return TC'

;; ../../../../spec-concrete/5.02.1-typing-context.watsup:222.1-222.82
def $add_constructorParameters_t(TC, parameterTypeIR*{parameterTypeIR <- parameterTypeIR*})

1. Case analysis on parameterTypeIR*{parameterTypeIR <- parameterTypeIR*}

  1. Case (% matches pattern [])

    1. Return TC

  2. Case (% matches pattern _ :: _)

    1. (Let parameterTypeIR_h :: parameterTypeIR_t*{parameterTypeIR_t <- parameterTypeIR_t*} be parameterTypeIR*{parameterTypeIR <- parameterTypeIR*})

    2. (Let TC' be $add_constructorParameter_t(TC, parameterTypeIR_h))

    3. (Let TC'' be $add_constructorParameters_t(TC', parameterTypeIR_t*{parameterTypeIR_t <- parameterTypeIR_t*}))

