    2. If ((routineTypeDefIR' has type polyRoutineTypeDefIR)), then

      1. (Let (routineTypeIR_b < tid_b*{tid_b <- tid_b*} , tid_hidden_b*{tid_hidden_b <- tid_hidden_b*} >) be (routineTypeDefIR' as polyRoutineTypeDefIR))

      2. Group poly: ((routineTypeIR_a < tid_a*{} , tid_hidden_a*{} >) as routineTypeDefIR) ~~ ((routineTypeIR_b < tid_b*{} , tid_hidden_b*{} >) as routineTypeDefIR)

        1. If ((|tid_a*{tid_a <- tid_a*}| = |tid_b*{tid_b <- tid_b*}|)), then

          1. If ((|tid_hidden_a*{tid_hidden_a <- tid_hidden_a*}| = |tid_hidden_b*{tid_hidden_b <- tid_hidden_b*}|)), then

