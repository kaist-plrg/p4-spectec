def $get_missing_parameters(id*{id <- id*}, id_arg*{id_arg <- id_arg*})

1. Case analysis on id*{id <- id*}

  1. Case (% matches pattern [])

    1. Return []

  2. Case (% matches pattern _ :: _)

    1. (Let id_param_h :: id_param_t*{id_param_t <- id_param_t*} be id*{id <- id*})

    2. If (~$in_set<id>(id_param_h, ({ id_arg*{id_arg <- id_arg*} }))), then

      1. Return id_param_h :: $get_missing_parameters(id_param_t*{id_param_t <- id_param_t*}, id_arg*{id_arg <- id_arg*})

    3. Otherwise

