        2. Return $join_ctk(ctk_a, ctk_b)

      2. Case (% matches pattern _ :: _)

        1. (Let ctk_b :: ctk_c*{ctk_c <- ctk_c*} be ctk*{ctk <- ctk*})

        2. (Let ctk_d be $join_ctk(ctk_a, ctk_b))

        3. Return $joins_ctk(ctk_d :: ctk_c*{ctk_c <- ctk_c*})

