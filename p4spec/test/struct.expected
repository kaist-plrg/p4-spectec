;; ../../../../spec-concrete/5.04-typing-relation.watsup:17.1-21.69
relation Type_ok: p TC |- typeOrVoid : % # %

1. Group primitiveType: p TC |- typeOrVoid : % # %

  1. If ((typeOrVoid matches pattern `VOID`)), then

    1. Result in : % % |- % : ((void) as typeIR) # []

  2. If ((typeOrVoid = ((bool) as typeOrVoid))), then

    1. Result in : % % |- % : ((bool) as typeIR) # []

  3. If ((typeOrVoid = ((error) as typeOrVoid))), then

    1. Result in : % % |- % : ((error) as typeIR) # []

  4. If ((typeOrVoid = ((match_kind) as typeOrVoid))), then

    1. Result in : % % |- % : ((match_kind) as typeIR) # []

  5. If ((typeOrVoid = ((string) as typeOrVoid))), then

    1. Result in : % % |- % : ((string) as typeIR) # []

2. Case analysis on typeOrVoid

  1. Case (% has type baseType)

    1. (Let baseType be (typeOrVoid as baseType))

    2. If ((baseType matches pattern `INT`)), then

      1. Group arbitraryInt: p TC |- ((int) as typeOrVoid) : % # %

        1. Result in : % % |- % : ((int) as typeIR) # []

    3. Group fixedInt: p TC |- (baseType as typeOrVoid) : % # %

      1. Case analysis on baseType

        1. Case (% matches pattern `INT<%>`)

          1. (Let (int< int >) be baseType)

          2. If ((int has type nat)), then

            1. (Let n be (int as nat))

            2. Result in : % % |- % : ((int< n >) as typeIR) # []

        2. Case (% matches pattern `INT<(%)>`)

          1. (Let (int<( expression )>) be baseType)

          2. (Expr_ok: p TC |- expression : typedExpressionIR)

          3. If (($ctk_of_typedExpressionIR(typedExpressionIR) matches pattern `LCTK`)), then

            1. (Expr_eval_lctk: p TC |- typedExpressionIR ~> value)

            2. (Let int be $to_int(value))

            3. If ((int has type nat)), then

              1. (Let n be (int as nat))

              2. Result in : % % |- % : ((int< n >) as typeIR) # []

    4. Group fixedBit: p TC |- (baseType as typeOrVoid) : % # %

      1. Case analysis on baseType

        1. Case (% matches pattern `BIT`)

          1. Result in : % % |- % : ((bit< 1 >) as typeIR) # []

        2. Case (% matches pattern `BIT<%>`)

          1. (Let (bit< int >) be baseType)

          2. If ((int has type nat)), then

            1. (Let n be (int as nat))

            2. Result in : % % |- % : ((bit< n >) as typeIR) # []

        3. Case (% matches pattern `BIT<(%)>`)

          1. (Let (bit<( expression )>) be baseType)

          2. (Expr_ok: p TC |- expression : typedExpressionIR)

          3. If (($ctk_of_typedExpressionIR(typedExpressionIR) matches pattern `LCTK`)), then

            1. (Expr_eval_lctk: p TC |- typedExpressionIR ~> value)

            2. (Let int be $to_int(value))

            3. If ((int has type nat)), then

              1. (Let n be (int as nat))

              2. Result in : % % |- % : ((bit< n >) as typeIR) # []

    5. Group variableBit: p TC |- (baseType as typeOrVoid) : % # %

      1. Case analysis on baseType

        1. Case (% matches pattern `VARBIT<%>`)

          1. (Let (varbit< int >) be baseType)

          2. If ((int has type nat)), then

            1. (Let n be (int as nat))

            2. Result in : % % |- % : ((varbit< n >) as typeIR) # []

        2. Case (% matches pattern `VARBIT<(%)>`)

          1. (Let (varbit<( expression )>) be baseType)

          2. (Expr_ok: p TC |- expression : typedExpressionIR)

          3. If (($ctk_of_typedExpressionIR(typedExpressionIR) matches pattern `LCTK`)), then

            1. (Expr_eval_lctk: p TC |- typedExpressionIR ~> value)

            2. (Let int be $to_int(value))

            3. If ((int has type nat)), then

              1. (Let n be (int as nat))

              2. Result in : % % |- % : ((varbit< n >) as typeIR) # []

  2. Case (% has type prefixedTypeName)

    1. (Let prefixedTypeName be (typeOrVoid as prefixedTypeName))

    2. Group prefixedTypeName: p TC |- (prefixedTypeName as typeOrVoid) : % # %

      1. (Let prefixedNameIR be $prefixedTypeName(prefixedTypeName))

      2. (Let typeDefIR'?{typeDefIR' <- typeDefIR'?} be $find_typeDef_t(p, TC, prefixedNameIR))

      3. If ((typeDefIR'?{typeDefIR' <- typeDefIR'?} matches pattern (_))), then

        1. (Let ?(typeDefIR) be typeDefIR'?{typeDefIR' <- typeDefIR'?})

        2. Case analysis on $is_monomorphic_typeDefIR(typeDefIR)

          1. Case true

            1. (Let typeIR be $type_of_typeDefIR(typeDefIR))

            2. Result in : % % |- % : typeIR # []

          2. Case false

            1. Result in : % % |- % : ((typeDefIR < [] >) as typeIR) # []

  3. Case (% has type specializedType)

    1. (Let (prefixedTypeName < typeArgumentList >) be (typeOrVoid as specializedType))

    2. Group specializedType: p TC |- ((prefixedTypeName < typeArgumentList >) as typeOrVoid) : % # %

      1. (Let prefixedNameIR be $prefixedTypeName(prefixedTypeName))

      2. (Let typeDefIR'?{typeDefIR' <- typeDefIR'?} be $find_typeDef_t(p, TC, prefixedNameIR))

      3. If ((typeDefIR'?{typeDefIR' <- typeDefIR'?} matches pattern (_))), then

        1. (Let ?(typeDefIR) be typeDefIR'?{typeDefIR' <- typeDefIR'?})

        2. If ($is_polymorphic_typeDefIR(typeDefIR)), then

          1. (Let typeArgument*{typeArgument <- typeArgument*} be $flatten_typeArgumentList(typeArgumentList))

          2. (TypeArguments_ok: p TC |- typeArgument*{typeArgument <- typeArgument*} : typeIR_arg*{typeIR_arg <- typeIR_arg*} # tid_fresh*{tid_fresh <- tid_fresh*})

          3. Result in : % % |- % : ((typeDefIR < typeIR_arg*{typeIR_arg <- typeIR_arg*} >) as typeIR) # tid_fresh*{tid_fresh <- tid_fresh*}

  4. Case (% has type headerStackType)

    1. (Let (namedType [ expression_size ]) be (typeOrVoid as headerStackType))

    2. Group headerStackType: p TC |- ((namedType [ expression_size ]) as typeOrVoid) : % # %

      1. Case analysis on namedType

        1. Case (% has type prefixedTypeName)

          1. (Let prefixedTypeName be (namedType as prefixedTypeName))

          2. (Type_ok: p TC |- (prefixedTypeName as typeOrVoid) : typeIR_base # tid*{tid <- tid*})

          3. If ((tid*{tid <- tid*} matches pattern [])), then

            1. (Expr_ok: p TC |- expression_size : typedExpressionIR_size)

            2. If (($ctk_of_typedExpressionIR(typedExpressionIR_size) matches pattern `LCTK`)), then

              1. (Expr_eval_lctk: p TC |- typedExpressionIR_size ~> value_size)

              2. (Let int be $to_int(value_size))

              3. If ((int has type nat)), then

                1. (Let n_size be (int as nat))

                2. Result in : % % |- % : ((typeIR_base [ n_size ]) as typeIR) # []

        2. Case (% has type specializedType)

          1. (Let specializedType be (namedType as specializedType))

          2. (Type_ok: p TC |- (specializedType as typeOrVoid) : typeIR_base # tid_fresh*{tid_fresh <- tid_fresh*})

          3. (Expr_ok: p TC |- expression_size : typedExpressionIR_size)

