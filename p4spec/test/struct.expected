;; ../../../../spec-concrete/4-p4-ir/4.3-annotation.watsup:7.1-7.58
def $name_annotation_nameIR_opt(annotationList)

1. (Let (annotation)* be $flatten_annotationList(annotationList))

2. (Let (nameIR_name)? be $name_annotation_nameIR_opt'(annotation))*

3. (Let ((nameIR)?)* be $filter_<nameIR?>(((nameIR_name)?)*, ($is_some_nameIR((nameIR_name)?))*))

4. If ((((nameIR)?)* matches pattern [ _/1 ])), then

  1. (Let [(nameIR')?] be ((nameIR)?)*)

  2. If (((nameIR')? matches pattern (_))), then

    1. (Let ?(nameIR_name_found) be (nameIR')?)

    2. Return ?(nameIR_name_found)

5. Otherwise

  1. Return ?()

;; ../../../../spec-concrete/4-p4-ir/4.3-annotation.watsup:8.1-8.55
def $name_annotation_nameIR_opt'(annotation)

1. If ((annotation matches pattern `@%(%)`)), then

  1. (Let (@ name ( annotationBody )) be annotation)

  2. If (("name" = $name(name))), then

    1. If ((annotationBody matches pattern `%%`)), then

      1. (Let (annotationBody' annotationToken) be annotationBody)

      2. If ((annotationBody' matches pattern ``EMPTY`)), then

        1. (Let nameIR_name be $print_<annotationToken>(annotationToken))

        2. Return ?($strip_prefix($strip_suffix(nameIR_name, "\""), "\""))

2. Otherwise

  1. Return ?()

