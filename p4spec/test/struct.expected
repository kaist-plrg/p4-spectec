            3. (Let constructorTypeIR be (constructor( constructorParameterTypeIR*{constructorParameterTypeIR <- constructorParameterTypeIR*} )-> typeIR_extern_spec))

            4. (Let constructorTypeDefIR be (constructorTypeIR < tid_expl*{tid_expl <- tid_expl*} , tid_impl*{tid_impl <- tid_impl*} >))

            5. If (ConstructorTypeDef_wf: $bound((block), TC_0) |- constructorTypeDefIR) holds, then

              1. (Let TC_1 be $add_constructor(TC_0, cid, constructorTypeDefIR))

