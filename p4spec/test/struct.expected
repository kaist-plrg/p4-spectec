;; ../../../../spec-concrete/7-instantiation/7.03-inst-relation.watsup:5.1-10.50
relation Expr_inst: p IC STO |- (expressionIR # expressionNoteIR) : % %

1. Group literalExpressionIR: p IC STO |- (expressionIR # expressionNoteIR) : % %

  1. Case analysis on expressionIR

    1. Case (% has type booleanLiteral)

      1. (Let booleanLiteral be (expressionIR as booleanLiteral))

      2. (Let boolValue be $ite<boolValue>((booleanLiteral = (true)), (`b true), (`b false)))

      3. Result in: % % % |- % : STO (boolValue as value)

    2. Case (% has type integerLiteral)

      1. (Let integerLiteral be (expressionIR as integerLiteral))

      2. Result in: % % % |- % : STO (integerLiteral as value)

    3. Case (% has type stringLiteral)

      1. (Let stringLiteral be (expressionIR as stringLiteral))

      2. Result in: % % % |- % : STO (stringLiteral as value)

  1. Else Phantom#1795

2. Case analysis on expressionIR

  1. Case (% has type prefixedNameIR)

    1. (Let prefixedNameIR be (expressionIR as prefixedNameIR))

    2. Group referenceExpressionIR: p IC STO |- ((prefixedNameIR as expressionIR) # expressionNoteIR) : % %

      1. (Let value be $find_var_i(prefixedNameIR, p, IC))

      2. Result in: % % % |- % : STO value

  2. Case (% has type defaultExpression)

    1. (Let defaultExpression be (expressionIR as defaultExpression))

    2. Group defaultExpressionIR: p IC STO |- (((...) as expressionIR) # expressionNoteIR) : % %

