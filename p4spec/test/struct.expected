  1. (Let [(integerLiteral'')?] be ((integerLiteral')?)*)

  2. If (((integerLiteral'')? matches pattern (_))), then

    1. (Let ?(integerLiteral_found) be (integerLiteral'')?)

    2. (Let value be $cast_op(((bit< 8 >) as typeIR), (integerLiteral_found as value)))

    3. If ((value has type integerLiteral)), then

      1. (Let integerLiteral_fixbit be (value as integerLiteral))

      2. Return ?(integerLiteral_fixbit)

5. Otherwise

  1. Return ?()

