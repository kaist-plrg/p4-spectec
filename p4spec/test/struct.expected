;; ../../../../spec-concrete/5-typing/5.02.1-typing-context.watsup:449.1-450.50
def $find_local_return_type_t(TC)

1. (Let localKind be TC.local.kind)

2. Case analysis on localKind

  1. Case (% has type definedFunctionLocalKind)

    1. (Let (function: typeIR_ret) be (localKind as definedFunctionLocalKind))

    2. Return ?(typeIR_ret)

  2. Case (% has type externFunctionLocalKind)

    1. (Let (extern_function: typeIR_ret) be (localKind as externFunctionLocalKind))

    2. Return ?(typeIR_ret)

  3. Case (% has type externMethodLocalKind)

    1. (Let externMethodLocalKind be (localKind as externMethodLocalKind))

    2. Case analysis on externMethodLocalKind

      1. Case (% matches pattern `EXTERN_METHOD:%`)

        1. (Let (extern_method: typeIR_ret) be externMethodLocalKind)

        2. Return ?(typeIR_ret)

      2. Case (% matches pattern `EXTERN_METHODABSTRACT:%`)

        1. (Let (extern_methodabstract: typeIR_ret) be externMethodLocalKind)

        2. Return ?(typeIR_ret)

3. If ((((action) as localKind) = TC.local.kind)), then

  1. Return ?(((void) as typeIR))

4. If ((((control_apply_method) as localKind) = TC.local.kind)), then

  1. Return ?(((void) as typeIR))

5. Otherwise

  1. Return ?()

;; ../../../../spec-concrete/5-typing/5.02.2-typing-table-context.watsup:5.19-5.31
syntax matchKey = (typeIR, id)

;; ../../../../spec-concrete/5-typing/5.02.2-typing-table-context.watsup:7.22-7.68
syntax matchAction = (prefixedNameIR, parameterIR*, argumentListIR)

;; ../../../../spec-concrete/5-typing/5.02.2-typing-table-context.watsup:10.3-13.24
syntax matchPriority = {values nat*, init bool, delta nat, largest_wins bool}

;; ../../../../spec-concrete/5-typing/5.02.2-typing-table-context.watsup:16.3-17.17
syntax matchEntry = {size nat, const bool}

;; ../../../../spec-concrete/5-typing/5.02.2-typing-table-context.watsup:21.1-27.11
syntax matchMode = 
   | nopri
   | noprilpm nat
   | pri
   | prilpm

;; ../../../../spec-concrete/5-typing/5.02.2-typing-table-context.watsup:30.3-34.21
syntax tableContext = {keys matchKey*, actions matchAction*, priorities matchPriority, entries matchEntry, mode matchMode}

;; ../../../../spec-concrete/5-typing/5.02.2-typing-table-context.watsup:44.1-46.10
syntax tableEntryState = 
   | lpm nat
   | nolpm

;; ../../../../spec-concrete/5-typing/5.02.2-typing-table-context.watsup:54.1-54.38
def $empty_tableContext

1. (Let matchPriority be {values [], init false, delta 1, largest_wins true})

2. (Let matchEntry be {size 0, const true})

3. Return {keys [], actions [], priorities matchPriority, entries matchEntry, mode (nopri)}

;; ../../../../spec-concrete/5-typing/5.02.2-typing-table-context.watsup:76.1-76.54
def $add_key(TBLC, id, typeIR)

1. (Let matchKey be (typeIR, id))

2. Return TBLC[keys = TBLC.keys ++ [matchKey]]

;; ../../../../spec-concrete/5-typing/5.02.2-typing-table-context.watsup:84.1-84.91
def $add_action(TBLC, prefixedNameIR, (parameterIR)*, argumentListIR)

1. (Let matchAction be (prefixedNameIR, (parameterIR)*, argumentListIR))

2. Return TBLC[actions = TBLC.actions ++ [matchAction]]

;; ../../../../spec-concrete/5-typing/5.02.2-typing-table-context.watsup:92.1-92.58
def $add_table_priority(TBLC, n)

1. Return TBLC[priorities.values = TBLC.priorities.values ++ [n]]

;; ../../../../spec-concrete/5-typing/5.02.2-typing-table-context.watsup:103.1-103.58
def $update_mode(TBLC, text, typeIR)

1. Case analysis on text

  1. Case (% = "lpm")

    1. Case analysis on typeIR

      1. Case (% has type fixedIntTypeIR)

        1. (Let (int< n >) be (typeIR as fixedIntTypeIR))

        2. If ((TBLC.mode matches pattern `NOPRI`)), then

          1. Return TBLC[mode = (noprilpm n)]

      2. Case (% has type fixedBitTypeIR)

        1. (Let (bit< n >) be (typeIR as fixedBitTypeIR))

        2. If ((TBLC.mode matches pattern `NOPRI`)), then

          1. Return TBLC[mode = (noprilpm n)]

      3. Case (% has type varBitTypeIR)

        1. (Let (varbit< n >) be (typeIR as varBitTypeIR))

        2. If ((TBLC.mode matches pattern `NOPRI`)), then

          1. Return TBLC[mode = (noprilpm n)]

      4. Case (% has type typedefTypeIR)

        1. (Let (typedef _typeId typeIR') be (typeIR as typedefTypeIR))

        2. Return $update_mode(TBLC, "lpm", typeIR')

      5. Case (% has type newTypeIR)

        1. (Let (type _typeId typeIR') be (typeIR as newTypeIR))

        2. Return $update_mode(TBLC, "lpm", typeIR')

    2. If ((TBLC.mode matches pattern `PRI`)), then

      1. Return TBLC[mode = (prilpm)]

  2. Case (% = "range")

    1. If ((TBLC.mode matches pattern `NOPRI`)), then

      1. Return TBLC[mode = (pri)]

    2. (Let matchMode be TBLC.mode)

    3. If ((matchMode matches pattern `NOPRILPM%`)), then

      1. Return TBLC[mode = (prilpm)]

  3. Case (% = "ternary")

    1. If ((TBLC.mode matches pattern `NOPRI`)), then

      1. Return TBLC[mode = (pri)]

    2. (Let matchMode be TBLC.mode)

    3. If ((matchMode matches pattern `NOPRILPM%`)), then

      1. Return TBLC[mode = (prilpm)]

  4. Case (% = "optional")

    1. If ((TBLC.mode matches pattern `NOPRI`)), then

      1. Return TBLC[mode = (pri)]

    2. (Let matchMode be TBLC.mode)

    3. If ((matchMode matches pattern `NOPRILPM%`)), then

      1. Return TBLC[mode = (prilpm)]

2. Otherwise

  1. Return TBLC

;; ../../../../spec-concrete/5-typing/5.02.2-typing-table-context.watsup:153.1-153.81
def $find_action(TBLC, prefixedNameIR)

1. Return $find_action'(TBLC.actions, prefixedNameIR)

;; ../../../../spec-concrete/5-typing/5.02.2-typing-table-context.watsup:154.1-154.82
def $find_action'((matchAction)*, prefixedNameIR)

1. Case analysis on (matchAction)*

  1. Case (% matches pattern [])

    1. Return ?()

  2. Case (% matches pattern _ :: _)

    1. (Let matchAction_h :: (matchAction_t)* be (matchAction)*)

    2. (Let (prefixedNameIR', (parameterIR)*, argumentListIR) be matchAction_h)

    3. Case analysis on prefixedNameIR'

      1. Case (% = prefixedNameIR)

        1. Return ?(((parameterIR)*, argumentListIR))

      2. Case (% =/= prefixedNameIR)

        1. Return $find_action'((matchAction_t)*, prefixedNameIR)

;; ../../../../spec-concrete/5-typing/5.02.2-typing-table-context.watsup:171.1-171.50
def $find_table_priority_last(TBLC)

1. (Let (n)* be TBLC.priorities.values)

2. (Let int be (|(n)*| - 1))

3. If ((int has type nat)), then

  1. (Let n_last be (int as nat))

  2. Return (n)*[n_last]

3. Else Phantom#531

