    1. Else Phantom#1584

  Row : (enumTypeIR as typeIR) -> true:

    1. If ((typeIR'' has type enumTypeIR)), then

      1. Return true

    1. Else Phantom#1585

  Row : _typeIR -> false:

    1. Return false

