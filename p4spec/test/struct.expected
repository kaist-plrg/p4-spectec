            3. (Let ctk_l_reduced be $ctkof_expression(typedExpressionIR_l_reduced))

            4. (Let ctk_r_reduced be $ctkof_expression(typedExpressionIR_r_reduced))

            5. (Let ctk_reduced be $join_ctk(ctk_l_reduced, ctk_r_reduced))

            6. (Let expressionNoteIR be (( typeIR_reduced ctk_reduced )))

            7. Result in : % % |- % : (((typedExpressionIR_l_reduced binop typedExpressionIR_r_reduced) as expressionIR) # expressionNoteIR)

    3. Group binaryExpression-satplusminus: p TC |- ((expression_l binop expression_r) as expression) : %

