def $type_of_callableTypeDefIR(callableTypeDefIR)

1. Case analysis on callableTypeDefIR

  1. Case (% has type actionTypeDefIR)

    1. (Let actionTypeDefIR be (callableTypeDefIR as actionTypeDefIR))

    2. Return (actionTypeDefIR as callableTypeIR)

  2. Case (% has type definedFunctionTypeDefIR)

    1. (Let (function< _tid*{_tid <- _tid*} , _tid'*{_tid' <- _tid'*} >( parameterTypeIR*{parameterTypeIR <- parameterTypeIR*} ): typeIR) be (callableTypeDefIR as definedFunctionTypeDefIR))

    2. Return ((function( parameterTypeIR*{parameterTypeIR <- parameterTypeIR*} ): typeIR) as callableTypeIR)

  3. Case (% has type externFunctionTypeDefIR)

    1. (Let (extern_function< _tid*{_tid <- _tid*} , _tid'*{_tid' <- _tid'*} >( parameterTypeIR*{parameterTypeIR <- parameterTypeIR*} ): typeIR) be (callableTypeDefIR as externFunctionTypeDefIR))

    2. Return ((extern_function( parameterTypeIR*{parameterTypeIR <- parameterTypeIR*} ): typeIR) as callableTypeIR)

  4. Case (% has type externMethodTypeDefIR)

    1. (Let externMethodTypeDefIR be (callableTypeDefIR as externMethodTypeDefIR))

    2. Case analysis on externMethodTypeDefIR

      1. Case (% matches pattern `EXTERN_METHOD<%,%>(%):%`)

        1. (Let (extern_method< _tid*{_tid <- _tid*} , _tid'*{_tid' <- _tid'*} >( parameterTypeIR*{parameterTypeIR <- parameterTypeIR*} ): typeIR) be externMethodTypeDefIR)

        2. Return ((extern_method( parameterTypeIR*{parameterTypeIR <- parameterTypeIR*} ): typeIR) as callableTypeIR)

      2. Case (% matches pattern `EXTERN_METHODABSTRACT<%,%>(%):%`)

        1. (Let (extern_methodabstract< _tid*{_tid <- _tid*} , _tid'*{_tid' <- _tid'*} >( parameterTypeIR*{parameterTypeIR <- parameterTypeIR*} ): typeIR) be externMethodTypeDefIR)

        2. Return ((extern_methodabstract( parameterTypeIR*{parameterTypeIR <- parameterTypeIR*} ): typeIR) as callableTypeIR)

  5. Case (% has type parserApplyMethodTypeDefIR)

    1. (Let parserApplyMethodTypeDefIR be (callableTypeDefIR as parserApplyMethodTypeDefIR))

    2. Return (parserApplyMethodTypeDefIR as callableTypeIR)

  6. Case (% has type controlApplyMethodTypeDefIR)

    1. (Let controlApplyMethodTypeDefIR be (callableTypeDefIR as controlApplyMethodTypeDefIR))

    2. Return (controlApplyMethodTypeDefIR as callableTypeIR)

;; ../../../../spec-concrete/2.3.3-type-callable-aux.watsup:51.1-51.76
def $type_parameters_of_callableTypeDefIR(callableTypeDefIR)

1. Case analysis on callableTypeDefIR

  1. Case (% has type actionTypeDefIR)

    1. (Let actionTypeDefIR be (callableTypeDefIR as actionTypeDefIR))

    2. Return ([], [])

  2. Case (% has type definedFunctionTypeDefIR)

    1. (Let (function< tid_expl*{tid_expl <- tid_expl*} , tid_impl*{tid_impl <- tid_impl*} >( _parameterTypeIR*{_parameterTypeIR <- _parameterTypeIR*} ): _typeIR) be (callableTypeDefIR as definedFunctionTypeDefIR))

    2. Return (tid_expl*{tid_expl <- tid_expl*}, tid_impl*{tid_impl <- tid_impl*})

  3. Case (% has type externFunctionTypeDefIR)

    1. (Let (extern_function< tid_expl*{tid_expl <- tid_expl*} , tid_impl*{tid_impl <- tid_impl*} >( _parameterTypeIR*{_parameterTypeIR <- _parameterTypeIR*} ): _typeIR) be (callableTypeDefIR as externFunctionTypeDefIR))

    2. Return (tid_expl*{tid_expl <- tid_expl*}, tid_impl*{tid_impl <- tid_impl*})

  4. Case (% has type externMethodTypeDefIR)

    1. (Let externMethodTypeDefIR be (callableTypeDefIR as externMethodTypeDefIR))

    2. Case analysis on externMethodTypeDefIR

      1. Case (% matches pattern `EXTERN_METHOD<%,%>(%):%`)

        1. (Let (extern_method< tid_expl*{tid_expl <- tid_expl*} , tid_impl*{tid_impl <- tid_impl*} >( _parameterTypeIR*{_parameterTypeIR <- _parameterTypeIR*} ): _typeIR) be externMethodTypeDefIR)

        2. Return (tid_expl*{tid_expl <- tid_expl*}, tid_impl*{tid_impl <- tid_impl*})

      2. Case (% matches pattern `EXTERN_METHODABSTRACT<%,%>(%):%`)

        1. (Let (extern_methodabstract< tid_expl*{tid_expl <- tid_expl*} , tid_impl*{tid_impl <- tid_impl*} >( _parameterTypeIR*{_parameterTypeIR <- _parameterTypeIR*} ): _typeIR) be externMethodTypeDefIR)

        2. Return (tid_expl*{tid_expl <- tid_expl*}, tid_impl*{tid_impl <- tid_impl*})

  5. Case (% has type parserApplyMethodTypeDefIR)

    1. (Let parserApplyMethodTypeDefIR be (callableTypeDefIR as parserApplyMethodTypeDefIR))

    2. Return ([], [])

  6. Case (% has type controlApplyMethodTypeDefIR)

    1. (Let controlApplyMethodTypeDefIR be (callableTypeDefIR as controlApplyMethodTypeDefIR))

    2. Return ([], [])

;; ../../../../spec-concrete/2.4.1-type-constructor.watsup:5.37-5.52
syntax constructorParameterTypeIR = parameterTypeIR

;; ../../../../spec-concrete/2.4.1-type-constructor.watsup:12.3-12.57
syntax constructorTypeIR = 
   | constructor( constructorParameterTypeIR* ): typeIR

;; ../../../../spec-concrete/2.4.2-type-constructor-def.watsup:6.3-6.75
syntax constructorTypeDefIR = 
   | constructor< tid* , tid* >( constructorParameterTypeIR* ): typeIR

