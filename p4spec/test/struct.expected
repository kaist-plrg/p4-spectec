        2. If ((typeDefIR has type polyTypeDefIR)), then

          1. (Let (typeIR_extern < tid_expl*{tid_expl <- tid_expl*} , tid*{tid <- tid*} >) be (typeDefIR as polyTypeDefIR))

          2. If ((tid*{tid <- tid*} matches pattern [])), then

            1. (Let cid be $cid((typeIdentifier as name), (( parameterList ))))

