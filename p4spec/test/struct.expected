3. Otherwise

  1. Return ?()

;; ../../../../spec-concrete/5.01-static-env.watsup:104.1-104.67
def $check_overloaded<V>(id_r, id_arg?{id_arg <- id_arg?}*{id_arg? <- id_arg?*}, id_arg''*{id_arg'' <- id_arg''*}, (id_r' ( pid_r''*{pid_r'' <- pid_r''*} )), V)

1. If (~$check_callable_name(id_r, id_r')), then

  1. Return ?()

2. (Let (id_param' # bool_param') be pid_r'')*{pid_r'' <- pid_r''*, bool_param' <- bool_param'*, id_param' <- id_param'*}

3. If ($check_callable_name(id_r, id_r')), then

  1. If ($check_arity_more(id_arg?{id_arg <- id_arg?}*{id_arg? <- id_arg?*}, id_param'*{id_param' <- id_param'*})), then

    1. Return ?()

4. If ((|id_arg''*{id_arg'' <- id_arg''*}| > 0)), then

  1. If ($check_callable_name(id_r, id_r')), then

    1. If ($check_arity(id_arg?{id_arg <- id_arg?}*{id_arg? <- id_arg?*}, id_param'*{id_param' <- id_param'*})), then

