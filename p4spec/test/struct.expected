;; ../../../../spec-concrete/4-p4-ir/4.2-ir-call-overload.watsup:17.1-18.54
def $callTargetKey(nameIR_f, (argumentIR)*)

1. (Let (id_arg)? be $callTargetKey'(argumentIR))*

2. Return (nameIR_f ( ((id_arg)?)* ))

;; ../../../../spec-concrete/4-p4-ir/4.2-ir-call-overload.watsup:19.1-19.38
def $callTargetKey'(argumentIR)

1. Case analysis on argumentIR

  1. Case (% has type typedExpressionIR)

    1. Return ?()

  2. Case (% matches pattern `%=%`)

    1. (Let (id_arg = _typedExpressionIR) be argumentIR)

    2. Return ?(id_arg)

  3. Case (% matches pattern `%=_`)

    1. (Let (id_arg =_) be argumentIR)

    2. Return ?(id_arg)

  4. Case (% matches pattern `_`)

    1. Return ?()

;; ../../../../spec-concrete/4-p4-ir/4.2-ir-call-overload.watsup:34.1-39.82
def $match_overloaded_named<V>((callTargetId : V), (nameIR_f ( (id_arg)* )), $get_parameterListIR)

1. (Let (nameIR ( (id_param)* )) be callTargetId)

2. If ((nameIR = nameIR_f)), then

  1. If ((|(id_param)*| = |(id_arg)*|)), then

    1. (Let (parameterIR)* be $get_parameterListIR(V))

    2. If ((id_param = $id_of_parameterIR(parameterIR)))*, then

      1. Return $ite<callTargetMatch>($eq_set<id>(({ (id_param)* }), ({ (id_arg)* })), (match [] []), (nomatch))

  2. If ((|(id_param)*| > |(id_arg)*|)), then

    1. (Let (parameterIR)* be $get_parameterListIR(V))

    2. If ((id_param = $id_of_parameterIR(parameterIR)))*, then

      1. (Let b_default be $is_default_parameterIR(parameterIR))*

      2. (Let b_optional be $is_optional_parameterIR(parameterIR))*

      3. (Let ({ (id_param_omitted)* }) be $diff_set<id>(({ (id_param)* }), ({ (id_arg)* })))

      4. (Let (id_default_param)* be $filter_<id>((id_param)*, ($is_default_parameterIR(parameterIR))*))

      5. (Let (id_default)* be $filter_<id>((id_param_omitted)*, (id_param_omitted is in (id_default_param)*)*))

      6. (Let (id_optional_param)* be $filter_<id>((id_param)*, ($is_optional_parameterIR(parameterIR))*))

      7. (Let (id_optional)* be $filter_<id>((id_param_omitted)*, (id_param_omitted is in (id_optional_param)*)*))

      8. If ($eq_set<id>(({ (id_default)* ++ (id_optional)* }), ({ (id_param_omitted)* }))), then

        1. Return (match (id_default)* (id_optional)*)

3. Otherwise

  1. Return (nomatch)

;; ../../../../spec-concrete/4-p4-ir/4.2-ir-call-overload.watsup:97.1-102.84
def $match_overloaded_unnamed<V>((callTargetId : V), (nameIR_f ( n_arg )), $get_parameterListIR)

1. (Let (parameterIR)* be $get_parameterListIR(V))

2. (Let b_default be $is_default_parameterIR(parameterIR))*

3. (Let b_optional be $is_optional_parameterIR(parameterIR))*

4. If (~($exists_((b_default)*) /\ $exists_((b_optional)*))), then

  1. (Let (nameIR ( (id_param)* )) be callTargetId)

  2. If ((nameIR = nameIR_f)), then

    1. If ((|(id_param)*| = n_arg)), then

      1. Return (match [] [])

    2. If ((|(id_param)*| > n_arg)), then

      1. (Let ((parameterIR_given)*, (parameterIR_omitted)*) be $partition_<parameterIR>((parameterIR)*, n_arg))

      2. If (~$is_optional_parameterIR(parameterIR_omitted))*, then

        1. If ($is_default_parameterIR(parameterIR_omitted))*, then

          1. (Let id_default be $id_of_parameterIR(parameterIR_omitted))*

          2. Return (match (id_default)* [])

      3. If (~$is_default_parameterIR(parameterIR_given))*, then

        1. If ($is_optional_parameterIR(parameterIR_omitted))*, then

          1. (Let id_optional be $id_of_parameterIR(parameterIR_omitted))*

          2. Return (match [] (id_optional)*)

5. Otherwise

  1. Return (nomatch)

