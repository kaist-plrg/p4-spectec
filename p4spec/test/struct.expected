  3. Case (% matches pattern `LOCAL`)

    1. (Let bound_block be $bound((block), TC))

    2. (Let bound_local be $dom_map<tid, typeDefIR>(TC.local.tdenv))

    3. Return $union_set<tid>(bound_block, bound_local)

