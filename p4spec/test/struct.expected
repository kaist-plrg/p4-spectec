;; ../../../../spec-concrete/5.04-typing-relation.watsup:112.1-115.73
relation Parameter_ok: p TC |- (annotationList direction type name initializerOpt) : % # %

1. If ((initializerOpt matches pattern ``EMPTY`)), then

  1. Group empty: p TC |- (annotationList direction type name ()) : % # %

    1. (Type_ok: p TC |- (type as typeOrVoid) : typeIR # tid_fresh*{tid_fresh <- tid_fresh*})

    2. (Let bound be $union_set<tid>($bound(p, TC), ({ tid_fresh*{tid_fresh <- tid_fresh*} })))

    3. If (Type_wf: bound |- typeIR) holds, then

      1. (Let nameIR be $name(name))

      2. Result in : % % |- % : (annotationList direction typeIR nameIR ?()) # tid_fresh*{tid_fresh <- tid_fresh*}

2. If ((initializerOpt has type initializer)), then

  1. (Let (= expression_init) be (initializerOpt as initializer))

  2. Group initializer: p TC |- (annotationList direction type name ((= expression_init) as initializerOpt)) : % # %

    1. (Type_ok: p TC |- (type as typeOrVoid) : typeIR # tid_fresh*{tid_fresh <- tid_fresh*})

    2. (Let bound be $union_set<tid>($bound(p, TC), ({ tid_fresh*{tid_fresh <- tid_fresh*} })))

    3. If (Type_wf: bound |- typeIR) holds, then

      1. (Expr_ok: p TC |- expression_init : typedExpressionIR_init)

      2. (Let typeIR_init be $typeof_expression(typedExpressionIR_init))

      3. If (($ctkof_expression(typedExpressionIR_init) matches pattern `LCTK`)), then

        1. (Let typedExpressionIR?{typedExpressionIR <- typedExpressionIR?} be $coerce_unary(typedExpressionIR_init, typeIR))

        2. If ((typedExpressionIR?{typedExpressionIR <- typedExpressionIR?} matches pattern (_))), then

          1. (Let ?(typedExpressionIR_init_cast) be typedExpressionIR?{typedExpressionIR <- typedExpressionIR?})

          2. (Let nameIR be $name(name))

          3. (Eval_static: p TC |- typedExpressionIR_init_cast ~> value_init)

          4. Result in : % % |- % : (annotationList direction typeIR nameIR ?((= value_init))) # tid_fresh*{tid_fresh <- tid_fresh*}

;; ../../../../spec-concrete/5.04-typing-relation.watsup:117.1-120.73
relation Parameters_ok: p TC |- parameter*{parameter <- parameter*} : % # %

1. Case analysis on parameter*{parameter <- parameter*}

  1. Case (% matches pattern [])

    1. Group nil: p TC |- [] : % # %

      1. Result in : % % |- % : [] # []

  2. Case (% matches pattern _ :: _)

    1. (Let parameter_h :: parameter_t*{parameter_t <- parameter_t*} be parameter*{parameter <- parameter*})

    2. Group cons: p TC |- parameter_h :: parameter_t*{} : % # %

      1. (Parameter_ok: p TC |- parameter_h : parameterIR_h # tid_fresh_h*{tid_fresh_h <- tid_fresh_h*})

      2. (Parameters_ok: p TC |- parameter_t*{parameter_t <- parameter_t*} : parameterIR_t*{parameterIR_t <- parameterIR_t*} # tid_fresh_t*{tid_fresh_t <- tid_fresh_t*})

      3. Result in : % % |- % : parameterIR_h :: parameterIR_t*{parameterIR_t <- parameterIR_t*} # tid_fresh_h*{tid_fresh_h <- tid_fresh_h*} ++ tid_fresh_t*{tid_fresh_t <- tid_fresh_t*}

;; ../../../../spec-concrete/5.04-typing-relation.watsup:122.1-122.48
def $parameterIR((_annotationList direction typeIR nameIR constantInitializerOptIR'))

1. (Let constantInitializerIR?{constantInitializerIR <- constantInitializerIR?} be constantInitializerOptIR')

2. If ((constantInitializerIR?{constantInitializerIR <- constantInitializerIR?} matches pattern ())), then

  1. Return (direction typeIR nameIR ?())

3. If ((constantInitializerOptIR' matches pattern (_))), then

  1. (Let ?((= value)) be constantInitializerOptIR')

  2. Return (direction typeIR nameIR ?(value))

