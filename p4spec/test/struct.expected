      3. Return TC'

  3. Case (% matches pattern `LOCAL`)

    1. (Let typeDefEnv be TC.local.type)

    2. If (~$in_set<tid>(tid, $dom_map<tid, typeDefIR>(typeDefEnv))), then

      1. (Let typeDefEnv_update be $add_map<tid, typeDefIR>(typeDefEnv, tid, typeDefIR))

