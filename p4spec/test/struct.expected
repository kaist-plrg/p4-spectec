2. If ((id_arg?{id_arg <- id_arg?} = ?()))*{id_arg? <- id_arg?*}, then

  1. If (($find_matchings<V>(id_r, id_arg?{id_arg <- id_arg?}*{id_arg? <- id_arg?*}, [], rid*{rid <- rid*}, V*{V <- V*}) = [])), then

