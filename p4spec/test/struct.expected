;; ../../../../spec-concrete/4-p4-ir/4.0-ir-syntax.watsup:48.23-48.38
syntax namedValueIR = 
   | nameIR = value

;; ../../../../spec-concrete/4-p4-ir/4.0-ir-syntax.watsup:50.27-50.40
syntax namedValueListIR = namedValueIR*

;; ../../../../spec-concrete/4-p4-ir/4.0-ir-syntax.watsup:56.28-56.55
syntax namedExpressionIR = 
