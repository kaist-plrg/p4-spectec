;; ../../../../spec-concrete/2-static-runtime/2.1.2-value-aux.watsup:32.1-33.53
def $int_of_integerValue(integerValue)

1. Case analysis on integerValue

  1. Case (% has type integerLiteral)

    1. (Let integerLiteral be (integerValue as integerLiteral))

    2. Case analysis on integerLiteral

      1. Case (% matches pattern `D%`)

        1. (Let (d i) be integerLiteral)

        2. Return i

      2. Case (% matches pattern `%S%`)

        1. (Let (w s i) be integerLiteral)

        2. Return $bitstr_to_int((w as int), i)

      3. Case (% matches pattern `%W%`)

        1. (Let (w w i) be integerLiteral)

        2. Return i

  2. Case (% matches pattern `%.%V%`)

    1. (Let (_nat . _nat' v i) be integerValue)

    2. Return i

;; ../../../../spec-concrete/2-static-runtime/2.1.2-value-aux.watsup:40.1-41.60
def $nat_of_integerValue(integerValue)

1. (Let int be $int_of_integerValue(integerValue))

2. If ((int has type nat)), then

  1. (Let n be (int as nat))

  2. Return ?(n)

3. Otherwise

  1. Return ?()

;; ../../../../spec-concrete/2-static-runtime/2.1.2-value-aux.watsup:52.1-52.65
def $update_fieldValue((fieldValue)*, nameIR, value)

1. Case analysis on (fieldValue)*

  1. Case (% matches pattern [])

    1. Return []

