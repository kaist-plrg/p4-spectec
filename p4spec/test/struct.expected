   | table nameIR { tablePropertyListIR }

;; ../../../../spec-concrete/6.4-parser-state.watsup:6.3-7.53
syntax state = 
   | annotationList state{ parserStatementListIR transitionStatementIR }

;; ../../../../spec-concrete/6.5.1-object.watsup:11.29-11.54
syntax externMethodDefEnv = map<cid, externMethodDef>

;; ../../../../spec-concrete/6.5.1-object.watsup:13.23-13.74
syntax externObject = 
   | extern tid < theta >{ frame externMethodDefEnv }

;; ../../../../spec-concrete/6.5.1-object.watsup:22.3-25.18
syntax parserObject = 
   | parser( parameterListIR ){ frame parserLocalDeclarationListIR stateEnv }

;; ../../../../spec-concrete/6.5.1-object.watsup:34.23-34.42
syntax actionDefEnv = map<cid, actionDef>

;; ../../../../spec-concrete/6.5.1-object.watsup:37.3-41.23
syntax controlObject = 
   | control( parameterListIR ){ frame controlLocalDeclarationListIR actionDefEnv controlBodyIR }

;; ../../../../spec-concrete/6.5.1-object.watsup:49.24-49.53
syntax packageObject = 
   | package< theta >{ frame }

;; ../../../../spec-concrete/6.5.1-object.watsup:57.3-61.37
syntax tableObjectProperty = {keys tableKeysPropertyIR, actions tableActionsPropertyIR, default_action tableDefaultActionPropertyIR, entries tableEntriesPropertyIR, customs tableCustomPropertyIR*}

;; ../../../../spec-concrete/6.5.1-object.watsup:66.3-66.43
syntax tableObject = 
   | table tid { frame tableObjectProperty }

;; ../../../../spec-concrete/6.5.1-object.watsup:69.1-73.16
syntax object = 
   | extern tid < theta >{ frame externMethodDefEnv }
   | parser( parameterListIR ){ frame parserLocalDeclarationListIR stateEnv }
   | control( parameterListIR ){ frame controlLocalDeclarationListIR actionDefEnv controlBodyIR }
   | package< theta >{ frame }
   | table tid { frame tableObjectProperty }

;; ../../../../spec-concrete/6.5.2-object-aux.watsup:9.1-9.36
def $is_externObject(object')

1. If ((object' has type externObject)), then

  1. (Let externObject be (object' as externObject))

  2. Return true

2. Otherwise

  1. Return false

