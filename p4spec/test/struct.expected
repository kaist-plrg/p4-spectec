    2. Group sliceAccessExpressionIR: p IC STO_0 |- (((typedExpressionIR_base [ typedExpressionIR_hi : typedExpressionIR_lo ]) as expressionIR) # _expressionNoteIR) ==> % %

      1. (Expr_inst: p IC STO' |- typedExpressionIR_base ==> STO_1 value_base)

