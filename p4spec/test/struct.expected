syntax bound = set<tid>

;; ../../../../spec-concrete/2.5.1-type-free.watsup:7.1-7.33
def $free_typeIR(typeIR'')

1. Case analysis on typeIR''

  1. Case (% has type baseTypeIR)

    1. (Let baseTypeIR be (typeIR'' as baseTypeIR))

    2. Return ({ [] })

  2. Case (% has type nameTypeIR)

    1. (Let (` tid) be (typeIR'' as nameTypeIR))

    2. Return ({ [tid] })

  3. Case (% has type specializedTypeIR)

    1. (Let (typeDefIR < typeIR*{typeIR <- typeIR*} >) be (typeIR'' as specializedTypeIR))

    2. (Let bound_base be $free_typeDefIR(typeDefIR))

    3. (Let bound_args be $unions_set<tid>($free_typeIR(typeIR)*{typeIR <- typeIR*}))

    4. Return $union_set<tid>(bound_base, bound_args)

  4. Case (% has type typedefTypeIR)

    1. (Let (typedef _tid typeIR) be (typeIR'' as typedefTypeIR))

    2. Return $free_typeIR(typeIR)

  5. Case (% has type newTypeIR)

    1. (Let (type _tid typeIR) be (typeIR'' as newTypeIR))

    2. Return $free_typeIR(typeIR)

  6. Case (% has type listTypeIR)

    1. (Let (list< typeIR >) be (typeIR'' as listTypeIR))

    2. Return $free_typeIR(typeIR)

  7. Case (% has type tupleTypeIR)

    1. (Let (tuple< typeIR*{typeIR <- typeIR*} >) be (typeIR'' as tupleTypeIR))

    2. Return $unions_set<tid>($free_typeIR(typeIR)*{typeIR <- typeIR*})

  8. Case (% has type headerStackTypeIR)

    1. (Let (typeIR [ _nat ]) be (typeIR'' as headerStackTypeIR))

    2. Return $free_typeIR(typeIR)

  9. Case (% has type structTypeIR)

    1. (Let (struct _tid { (typeIR _id ;)*{_id <- _id*, typeIR <- typeIR*} }) be (typeIR'' as structTypeIR))

    2. Return $unions_set<tid>($free_typeIR(typeIR)*{typeIR <- typeIR*})

  10. Case (% has type headerTypeIR)

    1. (Let (header _tid { (typeIR _id ;)*{_id <- _id*, typeIR <- typeIR*} }) be (typeIR'' as headerTypeIR))

    2. Return $unions_set<tid>($free_typeIR(typeIR)*{typeIR <- typeIR*})

  11. Case (% has type headerUnionTypeIR)

    1. (Let (header_union _tid { (typeIR _id ;)*{_id <- _id*, typeIR <- typeIR*} }) be (typeIR'' as headerUnionTypeIR))

    2. Return $unions_set<tid>($free_typeIR(typeIR)*{typeIR <- typeIR*})

  12. Case (% has type enumTypeIR)

    1. (Let enumTypeIR be (typeIR'' as enumTypeIR))

    2. Case analysis on enumTypeIR

      1. Case (% matches pattern `ENUM%{%}`)

        1. (Let (enum _tid { _id*{_id <- _id*} }) be enumTypeIR)

        2. Return ({ [] })

      2. Case (% matches pattern `ENUM%<%>{%}`)

        1. (Let (enum _tid < typeIR >{ _valueFieldIR*{_valueFieldIR <- _valueFieldIR*} }) be enumTypeIR)

        2. Return $free_typeIR(typeIR)

  13. Case (% has type externObjectTypeIR)

    1. (Let (extern _tid ({ (_cid : externMethodTypeDefIR)*{_cid <- _cid*, externMethodTypeDefIR <- externMethodTypeDefIR*} })) be (typeIR'' as externObjectTypeIR))

    2. Return $unions_set<tid>($free_callableTypeDefIR((externMethodTypeDefIR as callableTypeDefIR))*{externMethodTypeDefIR <- externMethodTypeDefIR*})

  14. Case (% has type parserObjectTypeIR)

    1. (Let (parser( parameterTypeIR*{parameterTypeIR <- parameterTypeIR*} )) be (typeIR'' as parserObjectTypeIR))

    2. (Let bound_params be $unions_set<tid>($free_parameterTypeIR(parameterTypeIR)*{parameterTypeIR <- parameterTypeIR*}))

    3. Return bound_params

  15. Case (% has type controlObjectTypeIR)

    1. (Let (control( parameterTypeIR*{parameterTypeIR <- parameterTypeIR*} )) be (typeIR'' as controlObjectTypeIR))

    2. (Let bound_params be $unions_set<tid>($free_parameterTypeIR(parameterTypeIR)*{parameterTypeIR <- parameterTypeIR*}))

    3. Return bound_params

  16. Case (% has type packageObjectTypeIR)

    1. (Let (package{ typeIR*{typeIR <- typeIR*} }) be (typeIR'' as packageObjectTypeIR))

    2. Return $unions_set<tid>($free_typeIR(typeIR)*{typeIR <- typeIR*})

  17. Case (% has type tableObjectTypeIR)

    1. (Let (table _tid { typeIR }) be (typeIR'' as tableObjectTypeIR))

    2. Return $free_typeIR(typeIR)

  18. Case (% has type defaultTypeIR)

    1. (Let defaultTypeIR be (typeIR'' as defaultTypeIR))

    2. Return ({ [] })

  19. Case (% has type invalidHeaderTypeIR)

    1. (Let invalidHeaderTypeIR be (typeIR'' as invalidHeaderTypeIR))

    2. Return ({ [] })

  20. Case (% has type sequenceTypeIR)

    1. (Let sequenceTypeIR be (typeIR'' as sequenceTypeIR))

    2. Case analysis on sequenceTypeIR

      1. Case (% matches pattern `SEQ<%>`)

        1. (Let (seq< typeIR*{typeIR <- typeIR*} >) be sequenceTypeIR)

        2. Return $unions_set<tid>($free_typeIR(typeIR)*{typeIR <- typeIR*})

      2. Case (% matches pattern `SEQ<%,...>`)

        1. (Let (seq< typeIR*{typeIR <- typeIR*} ,...>) be sequenceTypeIR)

        2. Return $unions_set<tid>($free_typeIR(typeIR)*{typeIR <- typeIR*})

  21. Case (% has type recordTypeIR)

    1. (Let recordTypeIR be (typeIR'' as recordTypeIR))

    2. Case analysis on recordTypeIR

      1. Case (% matches pattern `RECORD{%}`)

        1. (Let (record{ (typeIR _id ;)*{_id <- _id*, typeIR <- typeIR*} }) be recordTypeIR)

        2. Return $unions_set<tid>($free_typeIR(typeIR)*{typeIR <- typeIR*})

      2. Case (% matches pattern `RECORD{%,...}`)

        1. (Let (record{ (typeIR _id ;)*{_id <- _id*, typeIR <- typeIR*} ,...}) be recordTypeIR)

        2. Return $unions_set<tid>($free_typeIR(typeIR)*{typeIR <- typeIR*})

  22. Case (% has type setTypeIR)

    1. (Let (set< typeIR*{typeIR <- typeIR*} >) be (typeIR'' as setTypeIR))

    2. Return $unions_set<tid>($free_typeIR(typeIR)*{typeIR <- typeIR*})

  23. Case (% has type tableMetadataTypeIR)

    1. (Let tableMetadataTypeIR be (typeIR'' as tableMetadataTypeIR))

    2. Case analysis on tableMetadataTypeIR

      1. Case (% matches pattern `TABLE_ENUM%{%}`)

        1. (Let (table_enum _tid { _id*{_id <- _id*} }) be tableMetadataTypeIR)

        2. Return ({ [] })

      2. Case (% matches pattern `TABLE_STRUCT%{%}`)

        1. (Let (table_struct _tid { _fieldTypeIR*{_fieldTypeIR <- _fieldTypeIR*} }) be tableMetadataTypeIR)

        2. Return ({ [] })

;; ../../../../spec-concrete/2.5.1-type-free.watsup:8.1-8.39
def $free_typeDefIR(typeDefIR)

1. (Let (tid_tparam_expl*{tid_tparam_expl <- tid_tparam_expl*}, tid_tparam_impl*{tid_tparam_impl <- tid_tparam_impl*}) be $type_parameters_of_typeDefIR(typeDefIR))

2. (Let bound_tparams be ({ tid_tparam_expl*{tid_tparam_expl <- tid_tparam_expl*} ++ tid_tparam_impl*{tid_tparam_impl <- tid_tparam_impl*} }))

3. (Let typeIR be $type_of_typeDefIR(typeDefIR))

4. (Let bound_base be $free_typeIR(typeIR))

5. Return $diff_set<tid>(bound_base, bound_tparams)

;; ../../../../spec-concrete/2.5.1-type-free.watsup:10.1-10.51
def $free_parameterTypeIR((_direction typeIR _id _value?{_value <- _value?}))

1. Return $free_typeIR(typeIR)

;; ../../../../spec-concrete/2.5.1-type-free.watsup:12.1-12.49
def $free_callableTypeIR(callableTypeIR)

1. Case analysis on callableTypeIR

  1. Case (% has type actionTypeIR)

    1. (Let (action( parameterTypeIR*{parameterTypeIR <- parameterTypeIR*} )) be (callableTypeIR as actionTypeIR))

    2. (Let bound_params be $unions_set<tid>($free_parameterTypeIR(parameterTypeIR)*{parameterTypeIR <- parameterTypeIR*}))

    3. Return bound_params

  2. Case (% has type definedFunctionTypeIR)

    1. (Let (function( parameterTypeIR*{parameterTypeIR <- parameterTypeIR*} ): typeIR) be (callableTypeIR as definedFunctionTypeIR))

    2. (Let bound_params be $unions_set<tid>($free_parameterTypeIR(parameterTypeIR)*{parameterTypeIR <- parameterTypeIR*}))

    3. (Let bound_ret be $free_typeIR(typeIR))

    4. Return $union_set<tid>(bound_params, bound_ret)

  3. Case (% has type externFunctionTypeIR)

    1. (Let (extern_function( parameterTypeIR*{parameterTypeIR <- parameterTypeIR*} ): typeIR) be (callableTypeIR as externFunctionTypeIR))

    2. (Let bound_params be $unions_set<tid>($free_parameterTypeIR(parameterTypeIR)*{parameterTypeIR <- parameterTypeIR*}))

    3. (Let bound_ret be $free_typeIR(typeIR))

    4. Return $union_set<tid>(bound_params, bound_ret)

  4. Case (% has type builtinMethodTypeIR)

    1. (Let (builtin_method( parameterTypeIR*{parameterTypeIR <- parameterTypeIR*} ): typeIR) be (callableTypeIR as builtinMethodTypeIR))

    2. (Let bound_params be $unions_set<tid>($free_parameterTypeIR(parameterTypeIR)*{parameterTypeIR <- parameterTypeIR*}))

    3. (Let bound_ret be $free_typeIR(typeIR))

    4. Return $union_set<tid>(bound_params, bound_ret)

  5. Case (% has type externMethodTypeIR)

    1. (Let externMethodTypeIR be (callableTypeIR as externMethodTypeIR))

    2. Case analysis on externMethodTypeIR

      1. Case (% matches pattern `EXTERN_METHOD(%):%`)

        1. (Let (extern_method( parameterTypeIR*{parameterTypeIR <- parameterTypeIR*} ): typeIR) be externMethodTypeIR)

        2. (Let bound_params be $unions_set<tid>($free_parameterTypeIR(parameterTypeIR)*{parameterTypeIR <- parameterTypeIR*}))

        3. (Let bound_ret be $free_typeIR(typeIR))

        4. Return $union_set<tid>(bound_params, bound_ret)

      2. Case (% matches pattern `EXTERN_METHODABSTRACT(%):%`)

        1. (Let (extern_methodabstract( parameterTypeIR*{parameterTypeIR <- parameterTypeIR*} ): typeIR) be externMethodTypeIR)

        2. (Let bound_params be $unions_set<tid>($free_parameterTypeIR(parameterTypeIR)*{parameterTypeIR <- parameterTypeIR*}))

        3. (Let bound_ret be $free_typeIR(typeIR))

        4. Return $union_set<tid>(bound_params, bound_ret)

  6. Case (% has type parserApplyMethodTypeIR)

    1. (Let (parser_apply( parameterTypeIR*{parameterTypeIR <- parameterTypeIR*} )) be (callableTypeIR as parserApplyMethodTypeIR))

    2. (Let bound_params be $unions_set<tid>($free_parameterTypeIR(parameterTypeIR)*{parameterTypeIR <- parameterTypeIR*}))

    3. Return bound_params

  7. Case (% has type controlApplyMethodTypeIR)

    1. (Let (control_apply( parameterTypeIR*{parameterTypeIR <- parameterTypeIR*} )) be (callableTypeIR as controlApplyMethodTypeIR))

    2. (Let bound_params be $unions_set<tid>($free_parameterTypeIR(parameterTypeIR)*{parameterTypeIR <- parameterTypeIR*}))

    3. Return bound_params

  8. Case (% has type tableApplyMethodTypeIR)

    1. (Let (table_apply: typeIR) be (callableTypeIR as tableApplyMethodTypeIR))

    2. Return $free_typeIR(typeIR)

;; ../../../../spec-concrete/2.5.1-type-free.watsup:13.1-13.55
def $free_callableTypeDefIR(callableTypeDefIR)

1. (Let (tid_tparam_expl*{tid_tparam_expl <- tid_tparam_expl*}, tid_tparam_impl*{tid_tparam_impl <- tid_tparam_impl*}) be $type_parameters_of_callableTypeDefIR(callableTypeDefIR))

2. (Let bound_tparams be ({ tid_tparam_expl*{tid_tparam_expl <- tid_tparam_expl*} ++ tid_tparam_impl*{tid_tparam_impl <- tid_tparam_impl*} }))

3. (Let callableTypeIR be $type_of_callableTypeDefIR(callableTypeDefIR))

4. (Let bound_base be $free_callableTypeIR(callableTypeIR))

5. Return $diff_set<tid>(bound_base, bound_tparams)

;; ../../../../spec-concrete/2.5.2-type-subst.watsup:5.16-5.32
syntax theta = map<tid, typeIR>

;; ../../../../spec-concrete/2.5.2-type-subst.watsup:7.1-7.25
def $empty_theta

1. Return $empty_map<tid, typeIR>

;; ../../../../spec-concrete/2.5.2-type-subst.watsup:10.1-10.70
def $capture_avoiding(theta, tid_expl*{tid_expl <- tid_expl*}, tid_impl*{tid_impl <- tid_impl*}, bound)

1. (Let ({ tid_free*{tid_free <- tid_free*} }) be $diff_set<tid>(bound, ({ tid_expl*{tid_expl <- tid_expl*} ++ tid_impl*{tid_impl <- tid_impl*} })))

2. (Let typeIR?{typeIR <- typeIR?} be $find_map<tid, typeIR>(theta, tid_free))*{tid_free <- tid_free*, typeIR? <- typeIR?*}

3. If ((typeIR?{typeIR <- typeIR?} matches pattern (_)))*{typeIR? <- typeIR?*}, then

  1. (Let ?(typeIR_free) be typeIR?{typeIR <- typeIR?})*{typeIR? <- typeIR?*, typeIR_free <- typeIR_free*}

  2. (Let bound_capture be $unions_set<tid>($free_typeIR(typeIR_free)*{typeIR_free <- typeIR_free*}))

  3. (Let tid_fresh*{tid_fresh <- tid_fresh*} be $fresh_tids(|tid_expl*{tid_expl <- tid_expl*} ++ tid_impl*{tid_impl <- tid_impl*}|))

  4. If (~$in_set<tid>(tid_fresh, bound_capture))*{tid_fresh <- tid_fresh*}, then

    1. (Let tid_expl_fresh*{tid_expl_fresh <- tid_expl_fresh*} be tid_fresh*{tid_fresh <- tid_fresh*}[0 : |tid_expl*{tid_expl <- tid_expl*}|])

    2. (Let tid_impl_fresh*{tid_impl_fresh <- tid_impl_fresh*} be tid_fresh*{tid_fresh <- tid_fresh*}[|tid_expl*{tid_expl <- tid_expl*}| : |tid_impl*{tid_impl <- tid_impl*}|])

    3. (Let theta_fresh be $adds_map<tid, typeIR>(theta, tid_expl*{tid_expl <- tid_expl*} ++ tid_impl*{tid_impl <- tid_impl*}, ((` tid_expl_fresh) as typeIR)*{tid_expl_fresh <- tid_expl_fresh*} ++ ((` tid_impl_fresh) as typeIR)*{tid_impl_fresh <- tid_impl_fresh*}))

    4. Return (theta_fresh, tid_expl_fresh*{tid_expl_fresh <- tid_expl_fresh*}, tid_impl_fresh*{tid_impl_fresh <- tid_impl_fresh*})

;; ../../../../spec-concrete/2.5.2-type-subst.watsup:12.1-12.42
def $subst_typeIR(set<pair<tid, typeIR>>', typeIR)

1. If ((set<pair<tid, typeIR>>' = ({ [] }))), then

  1. Return typeIR

2. Otherwise

  1. Return $subst_typeIR'(set<pair<tid, typeIR>>', typeIR)

;; ../../../../spec-concrete/2.5.2-type-subst.watsup:13.1-13.43
def $subst_typeIR'(theta, typeIR''')

1. Case analysis on typeIR'''

  1. Case (% has type baseTypeIR)

    1. (Let baseTypeIR be (typeIR''' as baseTypeIR))

    2. Return (baseTypeIR as typeIR)

  2. Case (% has type nameTypeIR)

    1. (Let (` tid) be (typeIR''' as nameTypeIR))

    2. (Let typeIR''?{typeIR'' <- typeIR''?} be $find_map<tid, typeIR>(theta, tid))

    3. If ((typeIR''?{typeIR'' <- typeIR''?} matches pattern (_))), then

      1. (Let ?(typeIR) be typeIR''?{typeIR'' <- typeIR''?})

      2. Return typeIR

  3. Case (% has type specializedTypeIR)

    1. (Let (typeDefIR < typeIR*{typeIR <- typeIR*} >) be (typeIR''' as specializedTypeIR))

    2. (Let typeDefIR_subst be $subst_typeDefIR'(theta, typeDefIR))

    3. (Let typeIR_subst be $subst_typeIR'(theta, typeIR))*{typeIR <- typeIR*, typeIR_subst <- typeIR_subst*}

    4. Return ((typeDefIR_subst < typeIR_subst*{typeIR_subst <- typeIR_subst*} >) as typeIR)

  4. Case (% has type typedefTypeIR)

    1. (Let (typedef tid typeIR) be (typeIR''' as typedefTypeIR))

    2. (Let typeIR_subst be $subst_typeIR'(theta, typeIR))

    3. Return ((typedef tid typeIR_subst) as typeIR)

  5. Case (% has type newTypeIR)

    1. (Let (type tid typeIR) be (typeIR''' as newTypeIR))

    2. (Let typeIR_subst be $subst_typeIR'(theta, typeIR))

    3. Return ((type tid typeIR_subst) as typeIR)

  6. Case (% has type listTypeIR)

    1. (Let (list< typeIR >) be (typeIR''' as listTypeIR))

    2. (Let typeIR_subst be $subst_typeIR'(theta, typeIR))

    3. Return ((list< typeIR_subst >) as typeIR)

  7. Case (% has type tupleTypeIR)

    1. (Let (tuple< typeIR*{typeIR <- typeIR*} >) be (typeIR''' as tupleTypeIR))

    2. (Let typeIR_subst be $subst_typeIR'(theta, typeIR))*{typeIR <- typeIR*, typeIR_subst <- typeIR_subst*}

    3. Return ((tuple< typeIR_subst*{typeIR_subst <- typeIR_subst*} >) as typeIR)

  8. Case (% has type headerStackTypeIR)

    1. (Let (typeIR [ n_size ]) be (typeIR''' as headerStackTypeIR))

    2. (Let typeIR_subst be $subst_typeIR'(theta, typeIR))

    3. Return ((typeIR_subst [ n_size ]) as typeIR)

  9. Case (% has type structTypeIR)

    1. (Let (struct tid { (typeIR_field id_field ;)*{id_field <- id_field*, typeIR_field <- typeIR_field*} }) be (typeIR''' as structTypeIR))

    2. (Let typeIR_field_subst be $subst_typeIR'(theta, typeIR_field))*{typeIR_field <- typeIR_field*, typeIR_field_subst <- typeIR_field_subst*}

    3. Return ((struct tid { (typeIR_field_subst id_field ;)*{id_field <- id_field*, typeIR_field_subst <- typeIR_field_subst*} }) as typeIR)

  10. Case (% has type headerTypeIR)

    1. (Let (header tid { (typeIR_field id_field ;)*{id_field <- id_field*, typeIR_field <- typeIR_field*} }) be (typeIR''' as headerTypeIR))

    2. (Let typeIR_field_subst be $subst_typeIR'(theta, typeIR_field))*{typeIR_field <- typeIR_field*, typeIR_field_subst <- typeIR_field_subst*}

    3. Return ((header tid { (typeIR_field_subst id_field ;)*{id_field <- id_field*, typeIR_field_subst <- typeIR_field_subst*} }) as typeIR)

  11. Case (% has type headerUnionTypeIR)

    1. (Let (header_union tid { (typeIR_field id_field ;)*{id_field <- id_field*, typeIR_field <- typeIR_field*} }) be (typeIR''' as headerUnionTypeIR))

    2. (Let typeIR_field_subst be $subst_typeIR'(theta, typeIR_field))*{typeIR_field <- typeIR_field*, typeIR_field_subst <- typeIR_field_subst*}

    3. Return ((header_union tid { (typeIR_field_subst id_field ;)*{id_field <- id_field*, typeIR_field_subst <- typeIR_field_subst*} }) as typeIR)

  12. Case (% has type enumTypeIR)

    1. (Let enumTypeIR be (typeIR''' as enumTypeIR))

    2. Case analysis on enumTypeIR

      1. Case (% matches pattern `ENUM%{%}`)

        1. (Let (enum tid { id_field*{id_field <- id_field*} }) be enumTypeIR)

        2. Return ((enum tid { id_field*{id_field <- id_field*} }) as typeIR)

      2. Case (% matches pattern `ENUM%<%>{%}`)

        1. (Let (enum tid < typeIR >{ valueFieldIR*{valueFieldIR <- valueFieldIR*} }) be enumTypeIR)

        2. (Let typeIR_subst be $subst_typeIR'(theta, typeIR))

        3. Return ((enum tid < typeIR_subst >{ valueFieldIR*{valueFieldIR <- valueFieldIR*} }) as typeIR)

  13. Case (% has type externObjectTypeIR)

    1. (Let (extern tid ({ (cid : externMethodTypeDefIR)*{cid <- cid*, externMethodTypeDefIR <- externMethodTypeDefIR*} })) be (typeIR''' as externObjectTypeIR))

    2. (Let callableTypeDefIR be $subst_callableTypeDefIR'(theta, (externMethodTypeDefIR as callableTypeDefIR)))*{callableTypeDefIR <- callableTypeDefIR*, externMethodTypeDefIR <- externMethodTypeDefIR*}

    3. If ((callableTypeDefIR has type externMethodTypeDefIR))*{callableTypeDefIR <- callableTypeDefIR*}, then

