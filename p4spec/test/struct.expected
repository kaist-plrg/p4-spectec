;; ../../../../spec-concrete/7.02-inst-context.watsup:8.3-11.18
syntax globalInstLayer = {constructor constructorDefEnv, type typeDefEnv, callable callableDefEnv, frame frame}

;; ../../../../spec-concrete/7.02-inst-context.watsup:16.3-19.18
syntax blockInstLayer = {type theta, callable callableDefEnv, state stateEnv, frame frame}

;; ../../../../spec-concrete/7.02-inst-context.watsup:24.3-25.20
syntax localInstLayer = {type theta, frames frame*}

;; ../../../../spec-concrete/7.02-inst-context.watsup:32.3-35.27
syntax instContext = {path oid, global globalInstLayer, block blockInstLayer, local localInstLayer}

;; ../../../../spec-concrete/7.02-inst-context.watsup:43.1-43.37
def $empty_instContext

1. (Let globalInstLayer be {constructor $empty_constructorDefEnv, type $empty_typeDefEnv, callable $empty_callableDefEnv, frame $empty_frame})

2. (Let blockInstLayer be {type $empty_theta, callable $empty_callableDefEnv, state $empty_stateEnv, frame $empty_frame})

3. (Let localInstLayer be {type $empty_theta, frames [$empty_frame]})

4. (Let IC be {path [], global globalInstLayer, block blockInstLayer, local localInstLayer})

5. Return IC

;; ../../../../spec-concrete/7.02-inst-context.watsup:69.1-69.40
def $enter_i(IC)

1. Return IC[local.frames = $empty_frame :: IC.local.frames]

;; ../../../../spec-concrete/7.02-inst-context.watsup:73.1-73.39
def $exit_i(IC)

1. (Let frame*{frame <- frame*} be IC.local.frames)

2. If ((frame*{frame <- frame*} matches pattern _ :: _)), then

  1. (Let frame_h :: frame_t*{frame_t <- frame_t*} be frame*{frame <- frame*})

  2. Return IC[local.frames = frame_t*{frame_t <- frame_t*}]

;; ../../../../spec-concrete/7.02-inst-context.watsup:82.1-82.49
def $enter_path_i(IC, id)

1. Return IC[path = IC.path ++ [id]]

;; ../../../../spec-concrete/7.02-inst-context.watsup:90.1-90.50
def $inherit_i(cursor, IC)

1. Case analysis on cursor

  1. Case (% matches pattern `GLOBAL`)

    1. (Let blockInstLayer be {type $empty_theta, callable $empty_callableDefEnv, state $empty_stateEnv, frame $empty_frame})

    2. (Let localInstLayer be {type $empty_theta, frames [$empty_frame]})

    3. Return IC[block = blockInstLayer][local = localInstLayer]

  2. Case (% matches pattern `BLOCK`)

    1. (Let localInstLayer be {type $empty_theta, frames [$empty_frame]})

    2. Return IC[local = localInstLayer]

  3. Case (% matches pattern `LOCAL`)

    1. Return IC

;; ../../../../spec-concrete/7.02-inst-context.watsup:111.1-111.60
def $add_var_i(cursor, IC, id, value)

1. Case analysis on cursor

  1. Case (% matches pattern `GLOBAL`)

    1. If (~$in_set<id>(id, $dom_map<id, value>(IC.global.frame))), then

      1. (Let frame be $add_map<id, value>(IC.global.frame, id, value))

      2. Return IC[global.frame = frame]

  2. Case (% matches pattern `BLOCK`)

    1. If (~$in_set<id>(id, $dom_map<id, value>(IC.block.frame))), then

      1. (Let frame be $add_map<id, value>(IC.block.frame, id, value))

      2. Return IC[block.frame = frame]

  3. Case (% matches pattern `LOCAL`)

    1. (Let frame*{frame <- frame*} be IC.local.frames)

    2. If ((frame*{frame <- frame*} matches pattern _ :: _)), then

      1. (Let frame_h :: frame_t*{frame_t <- frame_t*} be frame*{frame <- frame*})

      2. If (~$in_set<id>(id, $dom_map<id, value>(frame_h))), then

        1. (Let frame_h' be $add_map<id, value>(frame_h, id, value))

        2. Return IC[local.frames = frame_h' :: frame_t*{frame_t <- frame_t*}]

;; ../../../../spec-concrete/7.02-inst-context.watsup:112.1-112.63
def $add_vars_i(p, IC, id*{id <- id*}, value*{value <- value*})

1. Case analysis on id*{id <- id*}

  1. Case (% matches pattern [])

    1. If ((value*{value <- value*} matches pattern [])), then

      1. Return IC

  2. Case (% matches pattern _ :: _)

    1. (Let id_h :: id_t*{id_t <- id_t*} be id*{id <- id*})

    2. If ((value*{value <- value*} matches pattern _ :: _)), then

      1. (Let value_h :: value_t*{value_t <- value_t*} be value*{value <- value*})

      2. (Let IC' be $add_var_i(p, IC, id_h, value_h))

      3. (Let IC'' be $add_vars_i(p, IC', id_t*{id_t <- id_t*}, value_t*{value_t <- value_t*}))

      4. Return IC''

;; ../../../../spec-concrete/7.02-inst-context.watsup:132.1-132.70
def $add_typeDef_i(cursor, IC, tid, typeDefIR)

1. If ((cursor matches pattern `GLOBAL`)), then

  1. (Let typeDefEnv be $add_map<tid, typeDefIR>(IC.global.type, tid, typeDefIR))

  2. Return IC[global.type = typeDefEnv]

;; ../../../../spec-concrete/7.02-inst-context.watsup:141.1-141.67
def $add_state_i(cursor, IC, nameIR, state)

1. If ((cursor matches pattern `BLOCK`)), then

  1. If (~$in_set<nameIR>(nameIR, $dom_map<nameIR, state>(IC.block.state))), then

    1. (Let stateEnv be $add_map<nameIR, state>(IC.block.state, nameIR, state))

    2. Return IC[block.state = stateEnv]

;; ../../../../spec-concrete/7.02-inst-context.watsup:151.1-151.64
def $add_type_i(cursor, IC, tid, typeIR)

1. Case analysis on cursor

  1. Case (% matches pattern `BLOCK`)

    1. (Let theta be $add_map<tid, typeIR>(IC.block.type, tid, typeIR))

    2. Return IC[block.type = theta]

  2. Case (% matches pattern `LOCAL`)

    1. (Let theta be $add_map<tid, typeIR>(IC.local.type, tid, typeIR))

    2. Return IC[local.type = theta]

;; ../../../../spec-concrete/7.02-inst-context.watsup:152.1-152.67
def $add_types_i(p, IC, tid*{tid <- tid*}, typeIR*{typeIR <- typeIR*})

1. Case analysis on tid*{tid <- tid*}

  1. Case (% matches pattern [])

    1. If ((typeIR*{typeIR <- typeIR*} matches pattern [])), then

      1. Return IC

  2. Case (% matches pattern _ :: _)

    1. (Let tid_h :: tid_t*{tid_t <- tid_t*} be tid*{tid <- tid*})

    2. If ((typeIR*{typeIR <- typeIR*} matches pattern _ :: _)), then

      1. (Let typeIR_h :: typeIR_t*{typeIR_t <- typeIR_t*} be typeIR*{typeIR <- typeIR*})

      2. (Let IC' be $add_type_i(p, IC, tid_h, typeIR_h))

      3. Return $add_types_i(p, IC', tid_t*{tid_t <- tid_t*}, typeIR_t*{typeIR_t <- typeIR_t*})

;; ../../../../spec-concrete/7.02-inst-context.watsup:166.1-167.16
def $add_callableDef_overload_i(cursor, IC, cid, callableDef)

1. Case analysis on cursor

  1. Case (% matches pattern `GLOBAL`)

    1. If (~$in_set<cid>(cid, $dom_map<cid, callableDef>(IC.global.callable))), then

      1. (Let callableDefEnv be $add_map<cid, callableDef>(IC.global.callable, cid, callableDef))

      2. Return IC[global.callable = callableDefEnv]

  2. Case (% matches pattern `BLOCK`)

    1. If (~$in_set<cid>(cid, $dom_map<cid, callableDef>(IC.block.callable))), then

      1. (Let callableDefEnv be $add_map<cid, callableDef>(IC.block.callable, cid, callableDef))

