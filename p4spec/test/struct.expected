   | set{ value .. value }
   | set{...}

;; ../../../../spec-concrete/2-static-runtime/2.1.1-value.watsup:83.33-83.60
syntax tableMetadataEnumValue = 
   | table_enum typeId . nameIR

;; ../../../../spec-concrete/2-static-runtime/2.1.1-value.watsup:86.3-88.64
syntax tableMetadataStructValue = 
