      2. Case (% matches pattern `BIT<%>`)

        1. (Let (bit< w >) be numberTypeIR)

        2. Return w

      3. Case (% matches pattern `VARBIT<%>`)

        1. (Let (varbit< w >) be numberTypeIR)

