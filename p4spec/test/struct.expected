        1. (Let (struct tid { (value_field id_field ;)*{id_field <- id_field*, value_field <- value_field*} }) be (value_base as structValue))

        2. (Let value''?{value'' <- value''?} be $assoc_<id, value>(nameIR, (id_field, value_field)*{id_field <- id_field*, value_field <- value_field*}))

        3. If ((value''?{value'' <- value''?} matches pattern (_))), then

          1. (Let ?(value) be value''?{value'' <- value''?})

          2. Result in : % % % |- % : value

      3. Case (% has type headerValue)

        1. (Let (header tid { _bool ; (value_field id_field ;)*{id_field <- id_field*, value_field <- value_field*} }) be (value_base as headerValue))

        2. (Let value''?{value'' <- value''?} be $assoc_<id, value>(nameIR, (id_field, value_field)*{id_field <- id_field*, value_field <- value_field*}))

        3. If ((value''?{value'' <- value''?} matches pattern (_))), then

