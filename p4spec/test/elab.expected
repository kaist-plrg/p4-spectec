;; ../../../../spec-concrete/5-typing/5.02.2-typing-table-context.watsup:5.19-5.31
syntax matchKey = 
   | typeIR : id

;; ../../../../spec-concrete/5-typing/5.02.2-typing-table-context.watsup:7.22-7.72
syntax matchAction = 
   | prefixedNameIR ( parameterIR* @ argumentListIR )

;; ../../../../spec-concrete/5-typing/5.02.2-typing-table-context.watsup:10.3-13.24
syntax matchPriority = {values nat*, init bool, delta nat, largest_wins bool}

;; ../../../../spec-concrete/5-typing/5.02.2-typing-table-context.watsup:16.3-17.17
syntax matchEntry = {size nat, const bool}

;; ../../../../spec-concrete/5-typing/5.02.2-typing-table-context.watsup:21.1-27.11
syntax matchMode = 
   | nopri
   | noprilpm nat
   | pri
   | prilpm

;; ../../../../spec-concrete/5-typing/5.02.2-typing-table-context.watsup:30.3-34.21
syntax tableContext = {keys matchKey*, actions matchAction*, priorities matchPriority, entries matchEntry, mode matchMode}

;; ../../../../spec-concrete/5-typing/5.02.2-typing-table-context.watsup:44.1-46.10
syntax tableEntryState = 
   | lpm nat
   | nolpm

;; ../../../../spec-concrete/5-typing/5.02.2-typing-table-context.watsup:54.1-54.38
def $empty_tableContext : tableContext =

  ;; ../../../../spec-concrete/5-typing/5.02.2-typing-table-context.watsup:55.1-68.25
  clause 0 :  = {keys [], actions [], priorities matchPriority, entries matchEntry, mode nopri}
  -- let matchPriority = {values [], init false, delta 1, largest_wins true}
  -- let matchEntry = {size 0, const true}

;; ../../../../spec-concrete/5-typing/5.02.2-typing-table-context.watsup:76.1-77.61
def $add_key_tbl(tableContext, id, typeIR) : tableContext =

  ;; ../../../../spec-concrete/5-typing/5.02.2-typing-table-context.watsup:79.1-81.32
  clause 0 : (TBLC, id, typeIR) = TBLC[keys = TBLC.keys ++ [matchKey]]
  -- let matchKey = typeIR : id

;; ../../../../spec-concrete/5-typing/5.02.2-typing-table-context.watsup:85.1-87.78
def $add_action_tbl(tableContext, prefixedNameIR, parameterIR*, argumentListIR) : tableContext =

  ;; ../../../../spec-concrete/5-typing/5.02.2-typing-table-context.watsup:89.1-91.73
  clause 0 : (TBLC, prefixedNameIR, parameterIR*{parameterIR <- parameterIR*}, argumentListIR) = TBLC[actions = TBLC.actions ++ [matchAction]]
  -- let matchAction = prefixedNameIR ( parameterIR*{parameterIR <- parameterIR*} @ argumentListIR )

;; ../../../../spec-concrete/5-typing/5.02.2-typing-table-context.watsup:95.1-95.58
