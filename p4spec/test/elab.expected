;; ../../../../spec-concrete/2-static-runtime/2.2.1-type.watsup:58.21-58.37
syntax listTypeIR = 
   | list< typeIR >

;; ../../../../spec-concrete/2-static-runtime/2.2.1-type.watsup:59.22-59.40
syntax tupleTypeIR = 
   | tuple< typeIR* >

;; ../../../../spec-concrete/2-static-runtime/2.2.1-type.watsup:60.28-60.43
syntax headerStackTypeIR = 
   | typeIR [ nat ]

;; ../../../../spec-concrete/2-static-runtime/2.2.1-type.watsup:62.22-62.38
syntax fieldTypeIR = 
   | typeIR nameIR ;

;; ../../../../spec-concrete/2-static-runtime/2.2.1-type.watsup:65.3-66.28
syntax structTypeIR = 
   | struct typeId < typeArgumentIR* >{ fieldTypeIR* } hint(print %0#"<"#%1#">")

;; ../../../../spec-concrete/2-static-runtime/2.2.1-type.watsup:68.3-69.28
syntax headerTypeIR = 
   | header typeId < typeArgumentIR* >{ fieldTypeIR* } hint(print %0#"<"#%1#">")

;; ../../../../spec-concrete/2-static-runtime/2.2.1-type.watsup:71.3-72.28
