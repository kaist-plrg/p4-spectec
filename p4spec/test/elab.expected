;; ../../../../spec-concrete/2-static-runtime/2.3.1-type-callable.watsup:9.32-9.40
syntax constantInitializerIR = 
   | = value

;; ../../../../spec-concrete/2-static-runtime/2.3.1-type-callable.watsup:10.35-10.57
syntax constantInitializerOptIR = constantInitializerIR?

;; ../../../../spec-concrete/2-static-runtime/2.3.1-type-callable.watsup:13.3-14.83
syntax parameterIR = 
   | annotationList direction typeIR id constantInitializerOptIR hint(prose_fields "annotations" "direction" "type" "name" "default initializer")

;; ../../../../spec-concrete/2-static-runtime/2.3.1-type-callable.watsup:20.23-20.47
syntax actionTypeIR = 
   | action( parameterIR* )

;; ../../../../spec-concrete/2-static-runtime/2.3.1-type-callable.watsup:26.32-26.68
syntax definedFunctionTypeIR = 
   | function( parameterIR* ): typeIR

;; ../../../../spec-concrete/2-static-runtime/2.3.1-type-callable.watsup:28.31-28.74
syntax externFunctionTypeIR = 
   | extern_function( parameterIR* ): typeIR

;; ../../../../spec-concrete/2-static-runtime/2.3.1-type-callable.watsup:31.1-32.25
syntax functionTypeIR = 
   | function( parameterIR* ): typeIR
   | extern_function( parameterIR* ): typeIR

;; ../../../../spec-concrete/2-static-runtime/2.3.1-type-callable.watsup:38.30-38.72
syntax builtinMethodTypeIR = 
   | builtin_method( parameterIR* ): typeIR

;; ../../../../spec-concrete/2-static-runtime/2.3.1-type-callable.watsup:41.1-42.55
syntax externMethodTypeIR = 
   | extern_method( parameterIR* ): typeIR
   | extern_methodabstract( parameterIR* ): typeIR

;; ../../../../spec-concrete/2-static-runtime/2.3.1-type-callable.watsup:44.34-44.64
syntax parserApplyMethodTypeIR = 
   | parser_apply( parameterIR* )

;; ../../../../spec-concrete/2-static-runtime/2.3.1-type-callable.watsup:46.35-46.66
syntax controlApplyMethodTypeIR = 
   | control_apply( parameterIR* )

;; ../../../../spec-concrete/2-static-runtime/2.3.1-type-callable.watsup:48.33-48.73
syntax tableApplyMethodTypeIR = 
   | table_apply: tableMetadataStructTypeIR

;; ../../../../spec-concrete/2-static-runtime/2.3.1-type-callable.watsup:51.1-55.27
syntax methodTypeIR = 
   | builtin_method( parameterIR* ): typeIR
   | extern_method( parameterIR* ): typeIR
   | extern_methodabstract( parameterIR* ): typeIR
   | parser_apply( parameterIR* )
   | control_apply( parameterIR* )
   | table_apply: tableMetadataStructTypeIR

;; ../../../../spec-concrete/2-static-runtime/2.3.1-type-callable.watsup:62.1-64.17
syntax callableTypeIR = 
   | action( parameterIR* )
   | function( parameterIR* ): typeIR
   | extern_function( parameterIR* ): typeIR
   | builtin_method( parameterIR* ): typeIR
   | extern_method( parameterIR* ): typeIR
   | extern_methodabstract( parameterIR* ): typeIR
   | parser_apply( parameterIR* )
   | control_apply( parameterIR* )
   | table_apply: tableMetadataStructTypeIR

;; ../../../../spec-concrete/2-static-runtime/2.3.2-type-callable-aux.watsup:5.1-6.40
def $id_of_parameterIR(parameterIR) : id =

  ;; ../../../../spec-concrete/2-static-runtime/2.3.2-type-callable-aux.watsup:7.1-7.40
  clause 0 : (_annotationList _direction _typeIR id _constantInitializerOptIR) = id

;; ../../../../spec-concrete/2-static-runtime/2.3.2-type-callable-aux.watsup:9.1-10.52
def $default_of_parameterIR(parameterIR) : bool =

  ;; ../../../../spec-concrete/2-static-runtime/2.3.2-type-callable-aux.watsup:11.1-11.49
  clause 0 : (_annotationList _direction _typeIR _id constantInitializerIR?{constantInitializerIR <- constantInitializerIR?}) = false
  -- if constantInitializerIR?{constantInitializerIR <- constantInitializerIR?} matches ()

  ;; ../../../../spec-concrete/2-static-runtime/2.3.2-type-callable-aux.watsup:12.1-13.15
  clause 1 : (_annotationList _direction _typeIR _id _constantInitializerOptIR) = true
  -- otherwise

;; ../../../../spec-concrete/2-static-runtime/2.3.3-type-callable-def.watsup:9.26-9.38
syntax actionTypeDefIR = actionTypeIR

