;; ../../../../spec-concrete/8.02-evaluation-relation.watsup:7.30-7.32
syntax continueEmptyResult = 
   | `

;; ../../../../spec-concrete/8.02-evaluation-relation.watsup:8.28-8.32
syntax continueResult<X> = 
   | ` X

;; ../../../../spec-concrete/8.02-evaluation-relation.watsup:12.21-12.25
syntax exitResult = 
   | exit

;; ../../../../spec-concrete/8.02-evaluation-relation.watsup:16.23-16.36
syntax returnResult = 
   | return value?

;; ../../../../spec-concrete/8.02-evaluation-relation.watsup:20.33-20.39
syntax acceptTransitionResult = 
   | accept

;; ../../../../spec-concrete/8.02-evaluation-relation.watsup:21.33-21.50
syntax rejectTransitionResult = 
   | reject errorValue

;; ../../../../spec-concrete/8.02-evaluation-relation.watsup:22.32-22.40
syntax stateTransitionResult = 
   | state id

;; ../../../../spec-concrete/8.02-evaluation-relation.watsup:29.1-30.15
syntax expressionResult = 
   | ` value
   | exit

;; ../../../../spec-concrete/8.02-evaluation-relation.watsup:32.1-37.97
