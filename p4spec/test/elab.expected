   | package< tid* , tid* >{ typeIR* }

;; ../../../../spec-concrete/2.2.2-type-def.watsup:56.31-56.48
syntax tableObjectTypeDefIR = tableObjectTypeIR

;; ../../../../spec-concrete/2.2.2-type-def.watsup:59.1-63.25
syntax objectTypeDefIR = 
   | extern tid < tid* , tid* > externMethodTypeDefEnv hint(print %1)
   | parser< tid* , tid* >( parameterTypeIR* )
   | control< tid* , tid* >( parameterTypeIR* )
   | package< tid* , tid* >{ typeIR* }
   | table tid { tableMetadataStructTypeIR } hint(print %1)

;; ../../../../spec-concrete/2.2.2-type-def.watsup:70.1-73.20
syntax typeDefIR = 
   | ` tid hint(print %0)
   | typedef tid typeIR hint(print %1)
   | type tid typeIR hint(print %1)
   | struct tid < tid* , tid* >{ fieldTypeIR* } hint(print %1)
   | header tid < tid* , tid* >{ fieldTypeIR* } hint(print %1)
   | header_union tid < tid* , tid* >{ fieldTypeIR* } hint(print %1)
   | enum tid { id* } hint(print %1)
   | enum tid < typeIR >{ valueFieldIR* } hint(print %1)
   | extern tid < tid* , tid* > externMethodTypeDefEnv hint(print %1)
   | parser< tid* , tid* >( parameterTypeIR* )
   | control< tid* , tid* >( parameterTypeIR* )
   | package< tid* , tid* >{ typeIR* }
   | table tid { tableMetadataStructTypeIR } hint(print %1)

