syntax continueEmptyResult = 
   | `empty

;; ../../../../spec-concrete/8-dynamic/8.02-evaluation-relation.watsup:8.28-8.32
syntax continueResult<X> = 
   | ` X

;; ../../../../spec-concrete/8-dynamic/8.02-evaluation-relation.watsup:12.21-12.25
syntax exitResult = 
   | exit

;; ../../../../spec-concrete/8-dynamic/8.02-evaluation-relation.watsup:16.23-16.36
syntax returnResult = 
   | return value?

;; ../../../../spec-concrete/8-dynamic/8.02-evaluation-relation.watsup:20.33-20.39
syntax acceptTransitionResult = 
   | accept

;; ../../../../spec-concrete/8-dynamic/8.02-evaluation-relation.watsup:21.33-21.50
syntax rejectTransitionResult = 
   | reject errorValue

;; ../../../../spec-concrete/8-dynamic/8.02-evaluation-relation.watsup:22.32-22.40
syntax stateTransitionResult = 
   | state id

;; ../../../../spec-concrete/8-dynamic/8.02-evaluation-relation.watsup:25.1-26.27
syntax abortResult = 
   | exit
   | reject errorValue

;; ../../../../spec-concrete/8-dynamic/8.02-evaluation-relation.watsup:33.1-34.16
syntax expressionResult = 
   | ` value
   | exit
   | reject errorValue

