def $cid_IR(nameIR, constructorParameterListIR) : cid =

  ;; ../../../../spec-concrete/6.0-domain.watsup:20.1-21.48
  clause 0 : (nameIR, constructorParameterListIR) = $rid_IR(nameIR, constructorParameterListIR)

;; ../../../../spec-concrete/6.1-storage-reference.watsup:6.1-9.41
syntax storageReference = 
   | ` nameIR
   | . nameIR
   | storageReference . nameIR
   | storageReference [ value ]
   | storageReference [ value : value ]

;; ../../../../spec-concrete/6.2.1-routine.watsup:7.17-7.68
syntax action = 
   | action nameIR ( parameterListIR ) blockStatementIR

;; ../../../../spec-concrete/6.2.1-routine.watsup:10.3-10.81
syntax definedFunction = 
   | function nameIR < typeParameterListIR >( parameterListIR ) blockStatementIR

;; ../../../../spec-concrete/6.2.1-routine.watsup:13.3-13.71
syntax externFunction = 
   | extern_function nameIR < typeParameterListIR >( parameterListIR )

;; ../../../../spec-concrete/6.2.1-routine.watsup:16.1-17.19
syntax function = 
   | function nameIR < typeParameterListIR >( parameterListIR ) blockStatementIR
   | extern_function nameIR < typeParameterListIR >( parameterListIR )

;; ../../../../spec-concrete/6.2.1-routine.watsup:20.3-20.45
syntax builtinMethod = 
   | builtin_method nameIR ( parameterListIR )

;; ../../../../spec-concrete/6.2.1-routine.watsup:23.1-24.80
syntax externMethod = 
   | extern_method nameIR < typeParameterListIR >( parameterListIR ) blockStatementIR?
   | extern_methodabstract nameIR < typeParameterListIR >( parameterListIR )

;; ../../../../spec-concrete/6.2.1-routine.watsup:27.3-28.46
syntax parserApplyMethod = 
   | parser_apply( parameterListIR ){ parserLocalDeclarationListIR ; senv }

;; ../../../../spec-concrete/6.2.1-routine.watsup:31.3-32.64
syntax controlApplyMethod = 
   | control_apply( parameterListIR ){ controlLocalDeclarationListIR ; renv ; controlBodyIR }

;; ../../../../spec-concrete/6.2.1-routine.watsup:35.3-35.39
syntax tableApplyMethod = 
   | table_apply{ tablePropertyListIR }

;; ../../../../spec-concrete/6.2.1-routine.watsup:38.1-42.21
syntax method = 
   | builtin_method nameIR ( parameterListIR )
   | extern_method nameIR < typeParameterListIR >( parameterListIR ) blockStatementIR?
   | extern_methodabstract nameIR < typeParameterListIR >( parameterListIR )
   | parser_apply( parameterListIR ){ parserLocalDeclarationListIR ; senv }
   | control_apply( parameterListIR ){ controlLocalDeclarationListIR ; renv ; controlBodyIR }
   | table_apply{ tablePropertyListIR }

;; ../../../../spec-concrete/6.2.1-routine.watsup:44.18-44.44
syntax routine = 
   | action nameIR ( parameterListIR ) blockStatementIR
   | function nameIR < typeParameterListIR >( parameterListIR ) blockStatementIR
   | extern_function nameIR < typeParameterListIR >( parameterListIR )
   | builtin_method nameIR ( parameterListIR )
   | extern_method nameIR < typeParameterListIR >( parameterListIR ) blockStatementIR?
   | extern_methodabstract nameIR < typeParameterListIR >( parameterListIR )
   | parser_apply( parameterListIR ){ parserLocalDeclarationListIR ; senv }
   | control_apply( parameterListIR ){ controlLocalDeclarationListIR ; renv ; controlBodyIR }
   | table_apply{ tablePropertyListIR }

;; ../../../../spec-concrete/6.2.1-routine.watsup:51.3-51.71
syntax actionCallee = 
   | action cursor . nameIR ( parameterListIR # id* ) blockStatementIR

;; ../../../../spec-concrete/6.2.1-routine.watsup:54.3-55.49
syntax definedFunctionCallee = 
   | function nameIR < typeParameterListIR >( parameterListIR # id* ) blockStatementIR

;; ../../../../spec-concrete/6.2.1-routine.watsup:58.3-58.78
