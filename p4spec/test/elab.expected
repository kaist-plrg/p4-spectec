;; ../../../../spec-concrete/6.2.2-callable-callee.watsup:51.3-51.55
syntax tableApplyMethodCallee = 
   | table oid .apply{ frame ; tableObjectProperty }

;; ../../../../spec-concrete/6.2.2-callable-callee.watsup:54.1-58.27
syntax methodCallee = 
   | builtin_method storageReference . nameIR < typeArgumentListIR >( parameterListIR )
