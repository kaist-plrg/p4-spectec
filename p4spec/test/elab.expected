;; ../../../../spec-concrete/5-typing/5.00-flow.watsup:5.15-5.25
syntax flow = 
   | cont
   | ret

;; ../../../../spec-concrete/5-typing/5.00-flow.watsup:9.1-10.58
def $join_flow(flow, flow) : flow =

  ;; ../../../../spec-concrete/5-typing/5.00-flow.watsup:11.1-11.31
  clause 0 : (flow, flow') = ret
  -- if flow matches `RET`
  -- if flow' matches `RET`

  ;; ../../../../spec-concrete/5-typing/5.00-flow.watsup:12.1-13.15
  clause 1 : (f_a, f_b) = cont
  -- otherwise

