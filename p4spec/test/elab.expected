   | extern_function nameIR < typeParameterListIR >( parameterListIR # id* )

;; ../../../../spec-concrete/6.2.1-routine.watsup:60.25-60.69
syntax functionCallee = 
   | function nameIR < typeParameterListIR >( parameterListIR # id* ) blockStatementIR
