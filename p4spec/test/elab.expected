;; ../../../../spec-concrete/8.03.2-eval-keyset-expression.watsup:5.1-5.45
def $match_keysets(setValue*, value*) : bool =

  ;; ../../../../spec-concrete/8.03.2-eval-keyset-expression.watsup:8.1-8.36
  clause 0 : (setValue*{setValue <- setValue*}, value*{value <- value*}) = true
  -- if setValue*{setValue <- setValue*} matches []
  -- if value*{value <- value*} matches []

  ;; ../../../../spec-concrete/8.03.2-eval-keyset-expression.watsup:9.1-9.53
  clause 1 : (setValue*{setValue <- setValue*}, value_key*{value_key <- value_key*}) = true
  -- if (setValue*{setValue <- setValue*} = [set{...}])

  ;; ../../../../spec-concrete/8.03.2-eval-keyset-expression.watsup:10.1-12.47
  clause 2 : (setValue*{setValue <- setValue*}, value*{value <- value*}) = $match_keysets(setValue_t*{setValue_t <- setValue_t*}, value_key_t*{value_key_t <- value_key_t*})
  -- if setValue*{setValue <- setValue*} matches _ :: _
  -- let setValue_h :: setValue_t*{setValue_t <- setValue_t*} = setValue*{setValue <- setValue*}
  -- if value*{value <- value*} matches _ :: _
  -- let value_key_h :: value_key_t*{value_key_t <- value_key_t*} = value*{value <- value*}
  -- if $match_keyset(setValue_h, value_key_h)

  ;; ../../../../spec-concrete/8.03.2-eval-keyset-expression.watsup:13.1-15.48
  clause 3 : (setValue*{setValue <- setValue*}, value*{value <- value*}) = false
  -- if setValue*{setValue <- setValue*} matches _ :: _
  -- let setValue_h :: setValue_t*{setValue_t <- setValue_t*} = setValue*{setValue <- setValue*}
  -- if value*{value <- value*} matches _ :: _
  -- let value_key_h :: value_key_t*{value_key_t <- value_key_t*} = value*{value <- value*}
  -- if ~$match_keyset(setValue_h, value_key_h)

;; ../../../../spec-concrete/8.03.2-eval-keyset-expression.watsup:6.1-6.42
def $match_keyset(setValue, value) : bool =

  ;; ../../../../spec-concrete/8.03.2-eval-keyset-expression.watsup:17.1-17.51
  clause 0 : (setValue, value_key) = true
  -- if setValue matches `SET{...}`

  ;; ../../../../spec-concrete/8.03.2-eval-keyset-expression.watsup:18.1-18.73
  clause 1 : (setValue, value_key) = $bin_eq(value, value_key)
  -- if setValue matches `SET{%}`
  -- let set{ value } = setValue

  ;; ../../../../spec-concrete/8.03.2-eval-keyset-expression.watsup:19.1-23.6
  clause 2 : (setValue, value_key) = $bin_eq($bin_band(value_base, value_mask), $bin_band(value_key, value_mask))
  -- if setValue matches `SET{%&&&%}`
  -- let set{ value_base &&& value_mask } = setValue

  ;; ../../../../spec-concrete/8.03.2-eval-keyset-expression.watsup:24.1-26.39
  clause 3 : (setValue, value_key) = ($bin_le(value_base, value_key) /\ $bin_le(value_key, value_limit))
  -- if setValue matches `SET{%..%}`
  -- let set{ value_base .. value_limit } = setValue

