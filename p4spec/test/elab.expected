  ;; ../../../../spec-concrete/5-typing/5.04-typing-relation.watsup:546.1-547.9
  clause 0 : (callableTypeIR) = true
  -- if callableTypeIR <: externFunctionTypeIR
  -- let extern_function text ( _parameterIR*{_parameterIR <- _parameterIR*} ): _typeIR = callableTypeIR as externFunctionTypeIR
  -- if (text = "static_assert")

  ;; ../../../../spec-concrete/5-typing/5.04-typing-relation.watsup:548.1-549.15
  clause 1 : (_callableTypeIR) = false
  -- otherwise

