;; ../../../../spec-concrete/2.3.1-type-callable.watsup:9.26-10.68
syntax parameterTypeIR = 
   | direction typeIR id value? hint(prose_fields ["direction", "type", "name", "default value"])

;; ../../../../spec-concrete/2.3.1-type-callable.watsup:16.23-16.51
syntax actionTypeIR = 
   | action( parameterTypeIR* )

;; ../../../../spec-concrete/2.3.1-type-callable.watsup:22.32-22.72
syntax definedFunctionTypeIR = 
   | function( parameterTypeIR* ): typeIR

;; ../../../../spec-concrete/2.3.1-type-callable.watsup:24.31-24.78
syntax externFunctionTypeIR = 
   | extern_function( parameterTypeIR* ): typeIR

;; ../../../../spec-concrete/2.3.1-type-callable.watsup:27.1-28.25
syntax functionTypeIR = 
   | function( parameterTypeIR* ): typeIR
   | extern_function( parameterTypeIR* ): typeIR

;; ../../../../spec-concrete/2.3.1-type-callable.watsup:34.30-34.76
syntax builtinMethodTypeIR = 
   | builtin_method( parameterTypeIR* ): typeIR

;; ../../../../spec-concrete/2.3.1-type-callable.watsup:37.1-38.59
syntax externMethodTypeIR = 
   | extern_method( parameterTypeIR* ): typeIR
   | extern_methodabstract( parameterTypeIR* ): typeIR

;; ../../../../spec-concrete/2.3.1-type-callable.watsup:40.34-40.68
syntax parserApplyMethodTypeIR = 
   | parser_apply( parameterTypeIR* )

;; ../../../../spec-concrete/2.3.1-type-callable.watsup:42.35-42.70
syntax controlApplyMethodTypeIR = 
   | control_apply( parameterTypeIR* )

;; ../../../../spec-concrete/2.3.1-type-callable.watsup:44.33-44.73
syntax tableApplyMethodTypeIR = 
   | table_apply: tableMetadataStructTypeIR

;; ../../../../spec-concrete/2.3.1-type-callable.watsup:47.1-51.27
syntax methodTypeIR = 
   | builtin_method( parameterTypeIR* ): typeIR
   | extern_method( parameterTypeIR* ): typeIR
   | extern_methodabstract( parameterTypeIR* ): typeIR
   | parser_apply( parameterTypeIR* )
   | control_apply( parameterTypeIR* )
   | table_apply: tableMetadataStructTypeIR

;; ../../../../spec-concrete/2.3.1-type-callable.watsup:58.1-60.17
syntax callableTypeIR = 
   | action( parameterTypeIR* )
   | function( parameterTypeIR* ): typeIR
   | extern_function( parameterTypeIR* ): typeIR
   | builtin_method( parameterTypeIR* ): typeIR
