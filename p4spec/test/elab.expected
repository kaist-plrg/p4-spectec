;; ../../../../spec-concrete/4-p4-ir/4.0-ir-syntax.watsup:50.27-50.40
syntax namedValueListIR = namedValueIR*

;; ../../../../spec-concrete/4-p4-ir/4.0-ir-syntax.watsup:56.28-56.55
syntax namedExpressionIR = 
   | nameIR = typedExpressionIR

;; ../../../../spec-concrete/4-p4-ir/4.0-ir-syntax.watsup:58.32-58.50
syntax namedExpressionListIR = namedExpressionIR*

;; ../../../../spec-concrete/4-p4-ir/4.0-ir-syntax.watsup:68.30-68.47
syntax literalExpressionIR = literalExpression

;; ../../../../spec-concrete/4-p4-ir/4.0-ir-syntax.watsup:74.32-74.46
syntax referenceExpressionIR = prefixedNameIR

;; ../../../../spec-concrete/4-p4-ir/4.0-ir-syntax.watsup:80.30-80.47
syntax defaultExpressionIR = defaultExpression

;; ../../../../spec-concrete/4-p4-ir/4.0-ir-syntax.watsup:86.28-86.50
syntax unaryExpressionIR = 
   | unop typedExpressionIR

;; ../../../../spec-concrete/4-p4-ir/4.0-ir-syntax.watsup:89.3-89.44
syntax binaryExpressionIR = 
   | typedExpressionIR binop typedExpressionIR

;; ../../../../spec-concrete/4-p4-ir/4.0-ir-syntax.watsup:92.3-92.62
syntax ternaryExpressionIR = 
   | typedExpressionIR ? typedExpressionIR : typedExpressionIR

;; ../../../../spec-concrete/4-p4-ir/4.0-ir-syntax.watsup:98.27-98.56
syntax castExpressionIR = 
   | ( typeIR ) typedExpressionIR

;; ../../../../spec-concrete/4-p4-ir/4.0-ir-syntax.watsup:106.36-106.59
syntax invalidHeaderExpressionIR = invalidHeaderExpression

;; ../../../../spec-concrete/4-p4-ir/4.0-ir-syntax.watsup:109.1-110.43
syntax sequenceExpressionIR = 
   | seq{ typedExpressionListIR }
   | seq{ typedExpressionListIR ,...}

;; ../../../../spec-concrete/4-p4-ir/4.0-ir-syntax.watsup:113.1-114.46
syntax recordExpressionIR = 
   | record{ namedExpressionListIR }
   | record{ namedExpressionListIR ,...}

;; ../../../../spec-concrete/4-p4-ir/4.0-ir-syntax.watsup:117.1-119.23
syntax dataExpressionIR = 
   | {#}
   | seq{ typedExpressionListIR }
   | seq{ typedExpressionListIR ,...}
   | record{ namedExpressionListIR }
   | record{ namedExpressionListIR ,...}

;; ../../../../spec-concrete/4-p4-ir/4.0-ir-syntax.watsup:128.3-128.18
syntax errorAccessExpressionIR = 
   | error. nameIR

;; ../../../../spec-concrete/4-p4-ir/4.0-ir-syntax.watsup:131.3-131.31
syntax memberAccessExpressionIR = 
   | memberAccessBaseIR . nameIR

;; ../../../../spec-concrete/4-p4-ir/4.0-ir-syntax.watsup:134.3-134.43
syntax indexAccessExpressionIR = 
   | typedExpressionIR [ typedExpressionIR ]

;; ../../../../spec-concrete/4-p4-ir/4.0-ir-syntax.watsup:137.3-137.64
syntax sliceAccessExpressionIR = 
   | typedExpressionIR [ typedExpressionIR : typedExpressionIR ]

;; ../../../../spec-concrete/4-p4-ir/4.0-ir-syntax.watsup:140.1-143.28
syntax accessExpressionIR = 
   | error. nameIR
   | memberAccessBaseIR . nameIR
