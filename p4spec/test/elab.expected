def $join_flow(flow, flow) : flow =

  ;; ../../../../spec-concrete/5.0-flow.watsup:11.1-11.31
  clause 0 : (flow, flow') = ret
  -- if flow matches `RET`
  -- if flow' matches `RET`

  ;; ../../../../spec-concrete/5.0-flow.watsup:12.1-13.15
  clause 1 : (f_a, f_b) = cont
  -- otherwise

