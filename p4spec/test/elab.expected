   | parser oid .apply( parameterListIR # id* ){ frame ; parserLocalDeclarationListIR ; stateEnv }
   | control oid .apply( parameterListIR # id* ){ frame ; controlLocalDeclarationListIR ; actionDefEnv ; controlBodyIR }
   | table oid .apply{ frame ; tableObjectProperty }

;; ../../../../spec-concrete/6.2.2-callable-callee.watsup:60.17-60.61
syntax callee = 
   | action cursor . nameIR ( parameterListIR # id* ) blockStatementIR
   | function nameIR < typeParameterListIR >( parameterListIR # id* ) blockStatementIR
   | extern_function nameIR < typeParameterListIR >( parameterListIR # id* )
   | builtin_method storageReference . nameIR < typeArgumentListIR >( parameterListIR )
   | extern_method oid . nameIR < typeParameterListIR >( parameterListIR # id* ){ frame ; blockStatementIR? }
   | parser oid .apply( parameterListIR # id* ){ frame ; parserLocalDeclarationListIR ; stateEnv }
   | control oid .apply( parameterListIR # id* ){ frame ; controlLocalDeclarationListIR ; actionDefEnv ; controlBodyIR }
   | table oid .apply{ frame ; tableObjectProperty }

;; ../../../../spec-concrete/6.3-constructor-def.watsup:6.3-8.37
