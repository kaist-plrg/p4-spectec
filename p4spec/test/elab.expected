;; ../../../../spec-concrete/4-p4-ir/4.0-ir-syntax.watsup:608.3-608.47
syntax externFunctionDeclarationIR = 
   | annotationList extern functionPrototypeIR ;

;; ../../../../spec-concrete/4-p4-ir/4.0-ir-syntax.watsup:611.3-611.76
syntax externConstructorPrototypeIR = 
