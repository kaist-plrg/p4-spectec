def $is_static_callableTypeIR(callableTypeIR) : ctk =

  ;; ../../../../spec-concrete/5-typing/5.04-typing-relation.watsup:535.1-536.9
  clause 0 : (callableTypeIR) = lctk
  -- if callableTypeIR <: externFunctionTypeIR
  -- let extern_function text ( _parameterIR*{_parameterIR <- _parameterIR*} ): _typeIR = callableTypeIR as externFunctionTypeIR
  -- if (text = "static_assert")

  ;; ../../../../spec-concrete/5-typing/5.04-typing-relation.watsup:537.1-539.56
  clause 1 : (callableTypeIR) = lctk
  -- if callableTypeIR <: builtinMethodTypeIR
  -- let builtin_method nameIR ( _parameterIR*{_parameterIR <- _parameterIR*} ): _typeIR = callableTypeIR as builtinMethodTypeIR
  -- if nameIR <- ["minSizeInBits", "minSizeInBytes", "maxSizeInBits", "maxSizeInBytes"]

  ;; ../../../../spec-concrete/5-typing/5.04-typing-relation.watsup:540.1-541.15
  clause 2 : (_callableTypeIR) = dyn
  -- otherwise

;; ../../../../spec-concrete/5-typing/5.04-typing-relation.watsup:543.1-545.53
