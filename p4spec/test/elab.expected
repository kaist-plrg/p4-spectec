    rulepath true
    -- if (booleanLiteral = true)
    -- let expressionResult = ` b true as value as expressionResult
    -- output: % % % |- % : EC STO expressionResult

    rulepath false
    -- if (booleanLiteral = false)
    -- let expressionResult = ` b false as value as expressionResult
    -- output: % % % |- % : EC STO expressionResult

  ;; ../../../../spec-concrete/8.03.1-eval-expression.watsup:29.1-43.2
  rulegroup literalExpressionIR-number

   match

    (explicit) p EC STO |- integerLiteral as expressionIR # _expressionNoteIR : % % %
    (implicit) p EC STO |- expressionIR # _expressionNoteIR : % % %
    -- if expressionIR <: integerLiteral
    -- let integerLiteral = expressionIR as integerLiteral

