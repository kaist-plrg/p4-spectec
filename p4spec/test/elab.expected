;; ../../../../spec-concrete/2.8-compile-time-known.watsup:5.14-5.30
syntax ctk = 
   | lctk
   | ctk
   | dyn

;; ../../../../spec-concrete/2.8-compile-time-known.watsup:7.1-7.30
def $join_ctk(ctk, ctk) : ctk =

  ;; ../../../../spec-concrete/2.8-compile-time-known.watsup:9.1-9.33
  clause 0 : (ctk, ctk') = lctk
  -- if ctk matches `LCTK`
  -- if ctk' matches `LCTK`

  ;; ../../../../spec-concrete/2.8-compile-time-known.watsup:10.1-10.31
  clause 1 : (ctk, ctk') = ctk
