;; ../../../../spec-concrete/6.3-constructor-def.watsup:11.3-14.27
syntax parserObjectConstructorDef = 
   | parser( parameterListIR )( constructorParameterListIR ){ parserLocalDeclarationListIR parserStateListIR }

;; ../../../../spec-concrete/6.3-constructor-def.watsup:17.3-20.29
