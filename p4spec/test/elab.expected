;; ../../../../spec-concrete/5-typing/5.03-typing-wellformed.watsup:474.1-474.54
def $directionless_trailing'(bool, direction*) : bool =

  ;; ../../../../spec-concrete/5-typing/5.03-typing-wellformed.watsup:479.1-479.44
