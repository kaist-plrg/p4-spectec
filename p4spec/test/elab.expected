  -- let id_arg =_ = argumentIR

  ;; ../../../../spec-concrete/4-p4-ir/4.2-ir-call-overload.watsup:28.1-28.30
  clause 3 : (argumentIR) = ?()
  -- if argumentIR matches `_`

