   | error
   | match_kind
   | string
   | int
   | int< nat >
   | bit< nat >
   | varbit< nat >

;; ../../../../spec-concrete/2-static-runtime/2.2.1-type.watsup:36.21-36.45
syntax nameTypeIR = 
   | ` typeId hint(print %0)

;; ../../../../spec-concrete/2-static-runtime/2.2.1-type.watsup:43.3-44.17
syntax typedefTypeIR = 
   | typedef typeId typeIR hint(print %0)

;; ../../../../spec-concrete/2-static-runtime/2.2.1-type.watsup:47.3-48.17
syntax newTypeIR = 
   | type typeId typeIR hint(print %0)

