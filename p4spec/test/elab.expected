;; ../../../../spec-concrete/2-static-runtime/2.2.1-type.watsup:74.23-74.41
syntax valueFieldIR = 
   | nameIR = value ;

;; ../../../../spec-concrete/2-static-runtime/2.2.1-type.watsup:77.1-78.64
syntax enumTypeIR = 
   | enum typeId { nameIR* } hint(print %0)
