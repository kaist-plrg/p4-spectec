;; ../../../../spec-concrete/8.02-evaluation-result.watsup:1.30-1.34
syntax continueEmptyResult = 
   | cont

;; ../../../../spec-concrete/8.02-evaluation-result.watsup:2.28-2.34
syntax continueResult<X> = 
   | cont X

;; ../../../../spec-concrete/8.03-evaluation-relation.watsup:5.21-5.25
syntax exitResult = 
   | exit

;; ../../../../spec-concrete/8.03-evaluation-relation.watsup:8.1-9.15
syntax expressionResult = 
   | cont value
   | exit

;; ../../../../spec-concrete/8.03-evaluation-relation.watsup:11.1-16.97
relation Expr_eval: cursor evaluationContext store |- typedExpressionIR : evaluationContext store expressionResult

  ;; ../../../../spec-concrete/8.04-evaluation-expression.watsup:15.1-25.2
