  ---- ;; get parser type definition
  -- if polyTypeDefIR_ingress
      = $find_typeDef_eval(GLOBAL, EC, `` "Ingress")
  ---- ;; get package type arguments
  -- if PACKAGE `< tenv > `{ _ }
      = $find_map<oid, object>(STO, [ "main" ])
  -- if typeIR_hdr = $find_map<tid, typeIR>(tenv, "H")
  -- if typeIR_meta = $find_map<tid, typeIR>(tenv, "M")
  ---- ;; create callee
  -- if typeIR_ingress = polyTypeDefIR_ingress `< [ typeIR_hdr, typeIR_meta ] >
  -- if typedExpressionIR_ingress
      = (typedExpressionIR_main `. "ig") `# `( typeIR_ingress CTK )

dec $V1Model_setup_egress_callee(
    evaluationContext, store, typedExpressionIR
  )
  : typedExpressionIR
def $V1Model_setup_egress_callee(
    EC, STO, typedExpressionIR_main
  )
  = typedExpressionIR_egress
  ---- ;; get parser type definition
  -- if polyTypeDefIR_egress
      = $find_typeDef_eval(GLOBAL, EC, `` "Egress")
  ---- ;; get package type arguments
  -- if PACKAGE `< tenv > `{ _ }
      = $find_map<oid, object>(STO, [ "main" ])
  -- if typeIR_hdr = $find_map<tid, typeIR>(tenv, "H")
  -- if typeIR_meta = $find_map<tid, typeIR>(tenv, "M")
  ---- ;; create callee
  -- if typeIR_egress = polyTypeDefIR_egress `< [ typeIR_hdr, typeIR_meta ] >
  -- if typedExpressionIR_egress
      = (typedExpressionIR_main `. "eg") `# `( typeIR_egress CTK )

dec $V1Model_setup_check_callee(
    evaluationContext, store, typedExpressionIR
  )
  : typedExpressionIR
def $V1Model_setup_check_callee(
    EC, STO, typedExpressionIR_main
  )
  = typedExpressionIR_check
  ---- ;; get parser type definition
  -- if polyTypeDefIR_check
      = $find_typeDef_eval(GLOBAL, EC, `` "ComputeChecksum")
  ---- ;; get package type arguments
  -- if PACKAGE `< tenv > `{ _ }
      = $find_map<oid, object>(STO, [ "main" ])
  -- if typeIR_hdr = $find_map<tid, typeIR>(tenv, "H")
  -- if typeIR_meta = $find_map<tid, typeIR>(tenv, "M")
  ---- ;; create callee
  -- if typeIR_check = polyTypeDefIR_check `< [ typeIR_hdr, typeIR_meta ] >
  -- if typedExpressionIR_check
      = (typedExpressionIR_main `. "ck") `# `( typeIR_check CTK )

dec $V1Model_setup_deparse_callee(
    evaluationContext, store, typedExpressionIR
  )
  : typedExpressionIR
def $V1Model_setup_deparse_callee(
    EC, STO, typedExpressionIR_main
  )
  = typedExpressionIR_deparse
  ---- ;; get parser type definition
  -- if polyTypeDefIR_deparse
      = $find_typeDef_eval(GLOBAL, EC, `` "Deparser")
  ---- ;; get package type arguments
  -- if PACKAGE `< tenv > `{ _ }
      = $find_map<oid, object>(STO, [ "main" ])
  -- if typeIR_hdr = $find_map<tid, typeIR>(tenv, "H")
  ---- ;; create callee
  -- if typeIR_deparse = polyTypeDefIR_deparse `< [ typeIR_hdr ] >
  -- if typedExpressionIR_deparse
      = (typedExpressionIR_main `. "dep") `# `( typeIR_deparse CTK )

;;
;; V1Model parser invocation
;;

relation V1Model_parser:
  evaluationContext store |- evaluationContext store transitionResult
  hint(input %0 %1)

rule V1Model_parser:
  EC_0 STO_0 |- EC_1 STO_1 ACCEPT
  ---- ;; prepare the arguments
  -- if argumentIR_packet_in
      = $V1Model_setup_packet_in_argument(EC_0)
  -- if argumentIR_hdr
      = $V1Model_setup_hdr_argument(STO_0)
  -- if argumentIR_meta
      = $V1Model_setup_meta_argument(STO_0)
  -- if argumentIR_standard_metadata
      = $V1Model_setup_standard_metadata_argument(EC_0)
  -- if argumentIR*
      = [ argumentIR_packet_in, argumentIR_hdr,
          argumentIR_meta, argumentIR_standard_metadata ]
  ---- ;; invoke the parser object (main.p)
  -- if typedExpressionIR_main
      = $V1Model_setup_main_callee(EC_0, STO_0)
  -- if typedExpressionIR_p
      = $V1Model_setup_parser_callee(EC_0, STO_0, typedExpressionIR_main)
  -- if routineTargetIR = typedExpressionIR_p `. "apply"
  -- Stmt_eval:
      GLOBAL EC_0 STO_0 |- routineTargetIR `< eps > `( argumentIR* ) `;
                         : EC_1 STO_1 CONT

;;
;; V1Model verify invocation
;;

relation V1Model_verify:
  evaluationContext store |- evaluationContext store callResult
  hint(input %0 %1)

rule V1Model_verify:
  EC_0 STO_0 |- EC_1 STO_1 (RETURN eps)
  ---- ;; prepare the arguments
  -- if argumentIR_hdr
      = $V1Model_setup_hdr_argument(STO_0)
  -- if argumentIR_meta
      = $V1Model_setup_meta_argument(STO_0)
  -- if argumentIR* = [ argumentIR_hdr, argumentIR_meta ]
  ---- ;; invoke the verify object (main.vr)
  -- if typedExpressionIR_main
      = $V1Model_setup_main_callee(EC_0, STO_0)
  -- if typedExpressionIR_vr
      = $V1Model_setup_verify_callee(EC_0, STO_0, typedExpressionIR_main)
  -- if routineTargetIR = typedExpressionIR_vr `. "apply"
  -- Stmt_eval:
      GLOBAL EC_0 STO_0 |- routineTargetIR `< eps > `( argumentIR* ) `;
                         : EC_1 STO_1 CONT

