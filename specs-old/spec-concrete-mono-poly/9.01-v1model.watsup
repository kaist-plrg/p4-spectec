  hint(input %0 %1)

rule V1Model_deparse:
  EC_0 STO_0 |- EC_1 STO_1 (RETURN eps)
  ---- ;; prepare the arguments
  -- if argumentIR_packet_out
      = $V1Model_setup_packet_out_argument(EC_0)
  -- if argumentIR_hdr
      = $V1Model_setup_hdr_argument(STO_0)
  -- if argumentIR* = [ argumentIR_packet_out, argumentIR_hdr ]
  ---- ;; invoke the deparse object (main.dep)
  -- if typedExpressionIR_main
