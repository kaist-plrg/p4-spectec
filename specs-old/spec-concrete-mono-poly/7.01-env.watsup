;;
;; Environments
;;

;; Map from type identifiers to types
syntax tenv = map<tid, typeIR>

dec $empty_tenv : tenv
def $empty_tenv = $empty_map<tid, typeIR>

;; Map from variable identifiers to values
syntax frame = map<id, value>

dec $empty_frame : frame
def $empty_frame = $empty_map<id, value>

;; Map from parser state names to parser states
syntax senv = map<id, state>

dec $empty_senv() : senv
def $empty_senv() = $empty_map<nameIR, state>

;; Map from routine identifiers to routines
syntax renv = map<rid, routine>

dec $empty_renv() : renv
def $empty_renv() = $empty_map<rid, routine>

;; Map from constructor identifiers to constructors
syntax cenv = map<cid, constructor>

dec $empty_cenv() : cenv
def $empty_cenv() = $empty_map<cid, constructor>

;; Map from object identifiers to objects
syntax store = map<oid, object>

var STO : store

dec $empty_store : store
def $empty_store = $empty_map<oid, object>
