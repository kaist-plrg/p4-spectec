;;
;; Copy-out (single argument)
;;

;;; IN | `EMPTY

rule Copy_out_argument/in-directionless:
  STO p_caller EC_caller_0 (_ direction typeIR nameIR _)
   `@ p_callee EC_callee eps
  ~> EC_caller_0
  ---- ;; check parameter direction
  -- if direction = IN \/ direction = `EMPTY

;;; OUT | INOUT

rulegroup Copy_out_argument/out-inout {

  rule Copy_out_argument/dontcare:
    STO p_caller EC_caller (_ direction typeIR nameIR _)
     `@ p_callee EC_callee eps
    ~> EC_caller
    ---- ;; check parameter direction
    -- if direction = OUT \/ direction = INOUT

  rule Copy_out_argument/non-dontcare:
    STO p_caller EC_caller_0 (_ direction typeIR nameIR _)
     `@ p_callee EC_callee storageReference
    ~> EC_caller_1
    ---- ;; check parameter direction
    -- if direction = OUT \/ direction = INOUT
    ---- ;; find value and write it to storage reference
    ---- ;; (TODO) support := without backticks
    -- if value = $find_value_eval(p_callee, EC_callee, `` nameIR)
    -- Lvalue_write:
        p_caller EC_caller_0 STO |- storageReference -> value
                                  : EC_caller_1

}

;;
;; Copy-out (multiple arguments)
;;

rulegroup Copy_out {

  rule Copy_out/nil:
    STO p_caller EC_caller eps `@ p_callee EC_callee eps
    ~> EC_caller

  rule Copy_out/cons:
    STO p_caller EC_caller_0 (parameterIR_h :: parameterIR_t*)
     `@ p_callee EC_callee (storageReference_h? :: storageReference_t?*)
    ~> EC_caller_2
    ----
    -- Copy_out_argument:
        STO p_caller EC_caller_0 parameterIR_h
         `@ p_callee EC_callee storageReference_h?
        ~> EC_caller_1
    ----
    -- Copy_out:
        STO p_caller EC_caller_1 parameterIR_t*
         `@ p_callee EC_callee storageReference_t?*
        ~> EC_caller_2

}
