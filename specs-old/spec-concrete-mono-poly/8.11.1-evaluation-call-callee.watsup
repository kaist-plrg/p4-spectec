;;
;; Callee evaluation
;;
;; syntax routineTargetIR
;;

;;; referenceExpressionIR

rule Callee_eval/referenceExpressionIR-action:
  p EC STO |- referenceExpressionIR `< `_ > `( argumentListIR )
            : EC STO (CONT actionCallee)
  ---- ;; find the action being called
  -- if (p_ref, _, action, id_default*)
      = $find_routine_overloaded_eval(p, EC, referenceExpressionIR, argumentListIR)
  ---- ;; prepare the callee
  -- if ACTION nameIR `( parameterListIR ) blockStatementIR = action
  -- if actionCallee
      = ACTION p_ref `. nameIR `( parameterListIR `# id_default* ) blockStatementIR

;;; typedExpressionIR `. nameIR

;;;; Extern method call

rulegroup Callee_eval/typedExpressionIR-nameIR-extern-method {

  rule Callee_eval/exit:
    p EC_0 STO_0 |- (typedExpressionIR `. nameIR) `< `_ > `( argumentListIR )
                  : EC_1 STO_1 EXIT
    ---- ;; get storage reference of expression base
    -- if typedLvalueIR
        = $typedExpressionIR_as_typedLvalueIR(typedExpressionIR)
    -- Lvalue_eval:
        p EC_0 STO_0 |- typedLvalueIR : EC_1 STO_1 EXIT

  rule Callee_eval/cont:
    p EC_0 STO_0 |- (typedExpressionIR `. nameIR) `< `_ > `( argumentListIR )
                  : EC_1 STO_1 (CONT externMethodCallee)
    ---- ;; get storage reference of expression base
    -- if typedLvalueIR
        = $typedExpressionIR_as_typedLvalueIR(typedExpressionIR)
    -- Lvalue_eval:
        p EC_0 STO_0 |- typedLvalueIR
                      : EC_1 STO_1 (CONT storageReference)
    ---- ;; read value of storage reference
    ---- ;; if the value is an object reference to an extern
    -- Lvalue_read:
        p EC_1 STO_1 |- storageReference : (`! oid)
    -- if EXTERN _ `< _ > `{ _ renv } 
        = $find_map<oid, object>(STO_1, oid)
    ---- ;; find the method being called
    -- if (id_arg?)* = $ids_arguments(argumentListIR)
    -- if (_, externMethod, id_default*)
        = $find_overloaded<routine>(renv, nameIR, (id_arg?)*)
    ---- ;; prepare the callee
    -- if EXTERN_METHOD nameIR `< typeParameterListIR >
            `( parameterListIR ) blockStatementIR?
        = externMethod
    -- if externMethodCallee
        = EXTERN_METHOD oid `. nameIR `< typeParameterListIR >
            `( parameterListIR `# id_default* ) blockStatementIR?

}

;;;; Parser apply method call

rulegroup Callee_eval/typedExpressionIR-nameIR-parser-apply-method {

  rule Callee_eval/exit:
    p EC_0 STO_0 |- (typedExpressionIR `. "apply") `< `_ > `( argumentListIR )
                  : EC_1 STO_1 EXIT
    ---- ;; get storage reference of expression base
    -- if typedLvalueIR
        = $typedExpressionIR_as_typedLvalueIR(typedExpressionIR)
    -- Lvalue_eval:
        p EC_0 STO_0 |- typedLvalueIR : EC_1 STO_1 EXIT

  rule Callee_eval/cont:
    p EC_0 STO_0 |- (typedExpressionIR `. "apply") `< `_ > `( argumentListIR )
                  : EC_1 STO_1 (CONT parserApplyMethodCallee)
    ---- ;; get storage reference of expression base
    -- if typedLvalueIR
        = $typedExpressionIR_as_typedLvalueIR(typedExpressionIR)
    -- Lvalue_eval:
        p EC_0 STO_0 |- typedLvalueIR
                      : EC_1 STO_1 (CONT storageReference)
    ---- ;; read value of storage reference
    ---- ;; if the value is an object reference to a parser
    -- Lvalue_read:
        p EC_1 STO_1 |- storageReference : (`! oid)
    -- if PARSER `( parameterListIR )
            `{ frame parserLocalDeclarationListIR senv }
        = $find_map<oid, object>(STO_1, oid)
    ---- ;; perform default resolution
    -- if rid = $rid_IR("apply", parameterListIR)
    -- if parserApplyMethod
        = PARSER_APPLY `( parameterListIR )
            `{ parserLocalDeclarationListIR `; senv }
    -- if renv_lookup = `{ (rid `: parserApplyMethod) }
    -- if (id_arg?)* = $ids_arguments(argumentListIR)
    -- if (_, _, id_default*)
        = $find_overloaded<routine>(renv_lookup, "apply", (id_arg?)*)
    ---- ;; prepare the callee
    -- if parserApplyMethodCallee
        = PARSER oid `. APPLY `( parameterListIR `# id_default* )
            `{ frame `; parserLocalDeclarationListIR `; senv }

}

;;;; Control apply method call

rulegroup Callee_eval/typedExpressionIR-nameIR-control-apply-method {

  rule Callee_eval/exit:
    p EC_0 STO_0 |- (typedExpressionIR `. "apply") `< `_ > `( argumentListIR )
                  : EC_1 STO_1 EXIT
    ---- ;; get storage reference of expression base
    -- if typedLvalueIR
        = $typedExpressionIR_as_typedLvalueIR(typedExpressionIR)
    -- Lvalue_eval:
        p EC_0 STO_0 |- typedLvalueIR : EC_1 STO_1 EXIT

  rule Callee_eval/cont:
    p EC_0 STO_0 |- (typedExpressionIR `. "apply") `< `_ > `( argumentListIR )
                  : EC_1 STO_1 (CONT controlApplyMethodCallee)
    ---- ;; get storage reference of expression base
    -- if typedLvalueIR
        = $typedExpressionIR_as_typedLvalueIR(typedExpressionIR)
    -- Lvalue_eval:
        p EC_0 STO_0 |- typedLvalueIR
                      : EC_1 STO_1 (CONT storageReference)
    ---- ;; read value of storage reference
    ---- ;; if the value is an object reference to a control
    -- Lvalue_read:
        p EC_1 STO_1 |- storageReference : (`! oid)
    -- if CONTROL `( parameterListIR )
            `{ frame controlLocalDeclarationListIR renv controlBodyIR }
        = $find_map<oid, object>(STO_1, oid)
    ---- ;; perform default resolution
    -- if rid = $rid_IR("apply", parameterListIR)
    -- if controlApplyMethod
        = CONTROL_APPLY `( parameterListIR )
            `{ controlLocalDeclarationListIR `; renv `; controlBodyIR }
    -- if renv_lookup = `{ (rid `: controlApplyMethod) }
    -- if (id_arg?)* = $ids_arguments(argumentListIR)
    -- if (_, _, id_default*)
        = $find_overloaded<routine>(renv_lookup, "apply", (id_arg?)*)
    ---- ;; prepare the callee
    -- if controlApplyMethodCallee
        = CONTROL oid `. APPLY `( parameterListIR `# id_default* )
            `{ frame `; controlLocalDeclarationListIR `; renv `; controlBodyIR }

}

;;;; Table apply method call

rulegroup Callee_eval/typedExpressionIR-nameIR-table-apply-method {

  rule Callee_eval/exit:
    p EC_0 STO_0 |- (typedExpressionIR `. "apply") `< `_ > `( argumentListIR )
                  : EC_1 STO_1 EXIT
    ---- ;; get storage reference of expression base
    -- if typedLvalueIR
        = $typedExpressionIR_as_typedLvalueIR(typedExpressionIR)
    -- Lvalue_eval:
        p EC_0 STO_0 |- typedLvalueIR : EC_1 STO_1 EXIT

  rule Callee_eval/cont:
    p EC_0 STO_0 |- (typedExpressionIR `. "apply") `< `_ > `( eps )
                  : EC_1 STO_1 (CONT tableApplyMethodCallee)
    ---- ;; get storage reference of expression base
    -- if typedLvalueIR
        = $typedExpressionIR_as_typedLvalueIR(typedExpressionIR)
    -- Lvalue_eval:
        p EC_0 STO_0 |- typedLvalueIR
                      : EC_1 STO_1 (CONT storageReference)
    ---- ;; read value of storage reference
    ---- ;; if the value is an object reference to a table
    -- Lvalue_read:
        p EC_1 STO_1 |- storageReference : (`! oid)
    -- if TABLE tid `{ frame TBL }
        = $find_map<oid, object>(STO_1, oid)
    ---- ;; prepare the callee
    -- if tableApplyMethodCallee
        = TABLE oid `. APPLY `{ frame `; TBL }

}

;;; TYPE prefixedNameIR `. nameIR

;;; `( routineTargetIR )
