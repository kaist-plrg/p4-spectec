;;
;; Layered context
;;

;; Global layer

syntax globalInstantiationLayer =
  { CONSTRUCTOR cenv,
    TYPE tdenv,
    ROUTINE renv,
    FRAME frame }

;; Block Layer

syntax blockInstantiationLayer =
  { TYPE tenv,
    ROUTINE renv,
    STATE senv,
    FRAME frame }

;; Local layer

syntax localInstantiationLayer =
  { TYPE tenv,
    FRAMES frame* }

;;
;; Instantiation context
;;

syntax instantiationContext =
  { PATH oid,
    GLOBAL globalInstantiationLayer,
    BLOCK blockInstantiationLayer,
    LOCAL localInstantiationLayer }

var IC : instantiationContext

;;
;; Constructors
;;

dec $empty_instantiationContext : instantiationContext

def $empty_instantiationContext = IC
  -- if globalInstantiationLayer
      = { CONSTRUCTOR $empty_cenv,
          TYPE $empty_tdenv,
          ROUTINE $empty_renv,
          FRAME $empty_frame }
  -- if blockInstantiationLayer
      = { TYPE $empty_tenv,
          ROUTINE $empty_renv,
          STATE $empty_senv,
          FRAME $empty_frame }
  -- if localInstantiationLayer
      = { TYPE $empty_tenv,
          FRAMES ([ $empty_frame ]) }
  -- if IC
      = { PATH ([]), 
          GLOBAL globalInstantiationLayer,
          BLOCK blockInstantiationLayer,
          LOCAL localInstantiationLayer }

;;
;; Frame entry and exit
;;

dec $enter_inst(instantiationContext) : instantiationContext

def $enter_inst(IC) = IC[ .LOCAL.FRAMES = $empty_frame :: IC.LOCAL.FRAMES ]

dec $exit_inst(instantiationContext) : instantiationContext

def $exit_inst(IC) = IC[ .LOCAL.FRAMES = frame_t* ]
  -- if IC.LOCAL.FRAMES = frame_h :: frame_t*

;;
;; Path entry
;;

dec $enter_path(instantiationContext, id) : instantiationContext

def $enter_path(IC, id) = IC[ .PATH = IC.PATH ++ id ]

;;
;; Context inheritance
;;

dec $inherit_instantiationContext(cursor, instantiationContext)
  : instantiationContext

def $inherit_instantiationContext(GLOBAL, IC)
  = IC[ .BLOCK = blockInstantiationLayer ][ .LOCAL = localInstantiationLayer ]
  -- if blockInstantiationLayer
      = { TYPE $empty_tenv,
          ROUTINE $empty_renv,
          STATE $empty_senv,
          FRAME $empty_frame }
  -- if localInstantiationLayer
      = { TYPE $empty_tenv,
          FRAMES ([ $empty_frame ]) }
def $inherit_instantiationContext(BLOCK, IC)
  = IC[ .LOCAL = localInstantiationLayer ]
  -- if localInstantiationLayer
      = { TYPE $empty_tenv,
          FRAMES ([ $empty_frame ]) }
def $inherit_instantiationContext(LOCAL, IC) = IC

;;
;; Adders
;;

;;; Adder for values

dec $add_value_inst(cursor, instantiationContext, id, value): instantiationContext
dec $add_values_inst(cursor, instantiationContext, id*, value*): instantiationContext

def $add_value_inst(GLOBAL, IC, id, value) = IC[ .GLOBAL.FRAME = frame ]
  -- if ~$in_set<id>(id, $dom_map<id, value>(IC.GLOBAL.FRAME))
  -- if frame = $add_map<id, value>(IC.GLOBAL.FRAME, id, value)
def $add_value_inst(BLOCK, IC, id, value) = IC[ .BLOCK.FRAME = frame ]
  -- if ~$in_set<id>(id, $dom_map<id, value>(IC.BLOCK.FRAME))
  -- if frame = $add_map<id, value>(IC.BLOCK.FRAME, id, value)
def $add_value_inst(LOCAL, IC, id, value) = IC[ .LOCAL.FRAMES = frame_h' :: frame_t* ]
  -- if IC.LOCAL.FRAMES = frame_h :: frame_t*
  -- if ~$in_set<id>(id, $dom_map<id, value>(frame_h))
  -- if frame_h' = $add_map<id, value>(frame_h, id, value)

def $add_values_inst(p, IC, eps, eps) = IC
def $add_values_inst(p, IC, id_h :: id_t*, value_h :: value_t*) = IC''
  -- if IC' = $add_value_inst(p, IC, id_h, value_h)
  -- if IC'' = $add_values_inst(p, IC', id_t*, value_t*)

;;; Adder for type definitions

dec $add_typedef_inst(cursor, instantiationContext, tid, typeDefIR) : instantiationContext

def $add_typedef_inst(GLOBAL, IC, tid, typeDefIR) = IC[ .GLOBAL.TYPE = tdenv ]
  -- if $add_map<tid, typeDefIR>(IC.GLOBAL.TYPE, tid, typeDefIR) = tdenv

;;; Adder for parser states

dec $add_state_inst(cursor, instantiationContext, nameIR, state) : instantiationContext

def $add_state_inst(BLOCK, IC, nameIR, state) = IC[ .BLOCK.STATE = senv ]
  -- if ~$in_set<nameIR>(nameIR, $dom_map<nameIR, state>(IC.BLOCK.STATE))
  -- if senv = $add_map<nameIR, state>(IC.BLOCK.STATE, nameIR, state)

;;; Adder for type variables

dec $add_types_inst(cursor, instantiationContext, tid*, typeIR*) : instantiationContext
dec $add_type_inst(cursor, instantiationContext, tid, typeIR) : instantiationContext

def $add_types_inst(p, IC, eps, eps) = IC
def $add_types_inst(p, IC, tid_h :: tid_t*, typeIR_h :: typeIR_t*) =
    $add_types_inst(p, IC', tid_t*, typeIR_t*)
  -- if IC' = $add_type_inst(p, IC, tid_h, typeIR_h)

def $add_type_inst(BLOCK, IC, tid, typeIR) = IC[ .BLOCK.TYPE = tenv ]
  -- if tenv = $add_map<tid, typeIR>(IC.BLOCK.TYPE, tid, typeIR)
def $add_type_inst(LOCAL, IC, tid, typeIR) = IC[ .LOCAL.TYPE = tenv ]
  -- if tenv = $add_map<tid, typeIR>(IC.LOCAL.TYPE, tid, typeIR)

;;; Adder for routines

dec $add_routine_overload_inst(cursor, instantiationContext, rid, routine)
  : instantiationContext

def $add_routine_overload_inst(GLOBAL, IC, rid, routine) = IC[ .GLOBAL.ROUTINE = renv ]
  -- if ~$in_set<rid>(rid, $dom_map<rid, routine>(IC.GLOBAL.ROUTINE))
  -- if renv = $add_map<rid, routine>(IC.GLOBAL.ROUTINE, rid, routine)
def $add_routine_overload_inst(BLOCK, IC, rid, routine) = IC[ .BLOCK.ROUTINE = renv ]
  -- if ~$in_set<rid>(rid, $dom_map<rid, routine>(IC.BLOCK.ROUTINE))
  -- if renv = $add_map<rid, routine>(IC.BLOCK.ROUTINE, rid, routine)

dec $add_routine_non_overload_inst(cursor, instantiationContext, rid, routine)
  : instantiationContext

def $add_routine_non_overload_inst(GLOBAL, IC, rid, routine) = IC[ .GLOBAL.ROUTINE = renv ]
  -- if id `( _ ) = rid
  -- if `{ (id_k `( _ ))* } = $dom_map<rid, routine>(IC.GLOBAL.ROUTINE)
  -- if ~$in_set<id>(id, `{ id_k* })
  -- if renv = $add_map<rid, routine>(IC.GLOBAL.ROUTINE, rid, routine)
def $add_routine_non_overload_inst(BLOCK, IC, rid, routine) = IC[ .BLOCK.ROUTINE = renv ]
  -- if id `( _ ) = rid
  -- if `{ (id_k `( _ ))* } = $dom_map<rid, routine>(IC.BLOCK.ROUTINE)
  -- if ~$in_set<id>(id, `{ id_k* })
  -- if renv = $add_map<rid, routine>(IC.BLOCK.ROUTINE, rid, routine)

;;; Adder for constructors

dec $add_constructor_inst(instantiationContext, cid, constructor)
  : instantiationContext

def $add_constructor_inst(IC, cid, constructor)
  = IC[ .GLOBAL.CONSTRUCTOR = cenv ]
  -- if cenv
      = $add_map<cid, constructor>(IC.GLOBAL.CONSTRUCTOR, cid, constructor)

dec $add_constructors_inst(instantiationContext, cid*, constructor*)
  : instantiationContext

def $add_constructors_inst(IC, eps, eps) = IC
def $add_constructors_inst(IC, cid_h :: cid_t*, constructor_h :: constructor_t*)
  = $add_constructors_inst(IC', cid_t*, constructor_t*)
  -- if IC' = $add_constructor_inst(IC, cid_h, constructor_h)

;;
;; Finders
;;

;;; Finder for values

dec $find_value_inst(cursor, instantiationContext, prefixedNameIR) : value

def $find_value_inst(p, IC, `. id) = value
  -- if value = $find_map<id, value>(IC.GLOBAL.FRAME, id)
def $find_value_inst(GLOBAL, IC, `` id) = value
  -- if value = $find_map<id, value>(IC.GLOBAL.FRAME, id)
def $find_value_inst(BLOCK, IC, `` id) = value
  -- if value = $find_map<id, value>(IC.BLOCK.FRAME, id)
def $find_value_inst(BLOCK, IC, `` id)
  = $find_value_inst(GLOBAL, IC, `` id)
  -- if eps = $find_map<id, value>(IC.BLOCK.FRAME, id)
def $find_value_inst(LOCAL, IC, `` id) = value
  -- if value = $find_maps<id, value>(IC.LOCAL.FRAMES, id)
def $find_value_inst(LOCAL, IC, `` id)
  = $find_value_inst(BLOCK, IC, `` id)
  -- if eps = $find_maps<id, value>(IC.LOCAL.FRAMES, id)

;;; Finder for typedefs

dec $find_typedef_inst(cursor, instantiationContext, prefixedNameIR) : typeDefIR?

def $find_typedef_inst(_, IC, `` nameIR)
  = $find_map<tid, typeDefIR>(IC.GLOBAL.TYPE, nameIR)
def $find_typedef_inst(_, IC, `. nameIR)
  = $find_map<tid, typeDefIR>(IC.GLOBAL.TYPE, nameIR)

;;; Finder for constructors 

dec $find_constructor_inst(instantiationContext, prefixedNameIR, argumentIR*)
  : (cid, constructor, id*)?

def $find_constructor_inst(IC, `` id, argumentIR*)
  = $find_overloaded<constructor>(IC.GLOBAL.CONSTRUCTOR, id, (id_arg?)*)
  -- if (id_arg?)* = $ids_arguments(argumentIR*)
def $find_constructor_inst(IC, `. id, argumentIR*)
  = $find_overloaded<constructor>(IC.GLOBAL.CONSTRUCTOR, id, (id_arg?)*)
  -- if (id_arg?)* = $ids_arguments(argumentIR*)
