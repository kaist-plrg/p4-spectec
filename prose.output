..... Let `typeIR_a_spec` be `$specialize_typeDef(`polyTypeDefIR_a` as typeDefIR, typeIR_a*{typeIR_a <- typeIR_a*})`

..... Let `typeIR_b_spec` be `$specialize_typeDef(`polyTypeDefIR_b` as typeDefIR, typeIR_b*{typeIR_b <- typeIR_b*})`

..... If (Type_alpha: typeIR_a_spec ~~ typeIR_b_spec) holds, then

...... If (`$is_nominal_typeIR(typeIR_a_spec)` /\ `$is_nominal_typeIR(typeIR_b_spec)`), then

....... If (Type_alpha: typeIR_a ~~ typeIR_b)*{typeIR_a <- typeIR_a*, typeIR_b <- typeIR_b*} holds, then

........ The relation holds

...... If (~`$is_nominal_typeIR(typeIR_a_spec)` /\ ~`$is_nominal_typeIR(typeIR_b_spec)`), then

....... The relation holds

