relation Expr_ok: p, TC, expression'''

. Case analysis on expression'''
.. Case `expression'''` has type booleanLiteral
... Let `booleanLiteral` be `expression'''` as booleanLiteral

... Group literalExpression-boolean: p, TC, `booleanLiteral` as expression

.... Case analysis on booleanLiteral
..... Case `booleanLiteral` matches pattern `TRUE`
...... Let `expressionNoteIR` be (( `(bool)` as typeIR (lctk) ))

...... Result in (`(true)` as expressionIR # expressionNoteIR)

..... Case `booleanLiteral` matches pattern `FALSE`
...... Let `expressionNoteIR` be (( `(bool)` as typeIR (lctk) ))

...... Result in (`(false)` as expressionIR # expressionNoteIR)

.. Case `expression'''` has type numberLiteral
... Let `numberLiteral` be `expression'''` as numberLiteral

... Group literalExpression-number: p, TC, `numberLiteral` as expression

.... Case analysis on numberLiteral
..... Case `numberLiteral` matches pattern `D%`
...... Let `(d i)` be numberLiteral

...... Let `expressionNoteIR` be (( `(int)` as typeIR (lctk) ))

...... Result in (`(d i)` as expressionIR # expressionNoteIR)

..... Case `numberLiteral` matches pattern `%S%`
...... Let `(n s i)` be numberLiteral

...... Let `expressionNoteIR` be (( `(int< n >)` as typeIR (lctk) ))

...... Result in (`(n s i)` as expressionIR # expressionNoteIR)

..... Case `numberLiteral` matches pattern `%W%`
...... Let `(n w i)` be numberLiteral

...... Let `expressionNoteIR` be (( `(bit< n >)` as typeIR (lctk) ))

...... Result in (`(n w i)` as expressionIR # expressionNoteIR)

.. Case `expression'''` has type stringLiteral
... Let `(" text ")` be `expression'''` as stringLiteral

... Group literalExpression-stringliteral: p, TC, `(" text ")` as expression

.... Let `expressionNoteIR` be (( `(string)` as typeIR (lctk) ))

.... Result in (`(" text ")` as expressionIR # expressionNoteIR)

. Group referenceExpression: p, TC, expression

.. If (`expression'''` has type prefixedNonTypeName), then

... Let `prefixedNonTypeName` be `expression'''` as prefixedNonTypeName

... Let `prefixedNameIR` be `$prefixedNonTypeName(prefixedNonTypeName)`

... Let `varTypeIR?{varTypeIR <- varTypeIR?}` be `$find_var(p, TC, prefixedNameIR)`

... If (varTypeIR?{varTypeIR <- varTypeIR?} matches pattern (_)), then

.... Let `?((_direction typeIR ctk _value?{_value <- _value?}))` be varTypeIR?{varTypeIR <- varTypeIR?}

.... Let `expressionNoteIR` be (( typeIR ctk ))

.... Result in (`prefixedNameIR` as expressionIR # expressionNoteIR)

.. If ((`(this)` as expression = expression''')), then

... Let `prefixedNameIR` be (` "this")

... Let `varTypeIR?{varTypeIR <- varTypeIR?}` be `$find_var(p, TC, prefixedNameIR)`

... If (varTypeIR?{varTypeIR <- varTypeIR?} matches pattern (_)), then

.... Let `?((_direction typeIR ctk _value?{_value <- _value?}))` be varTypeIR?{varTypeIR <- varTypeIR?}

.... Let `expressionNoteIR` be (( typeIR ctk ))

.... Result in (`prefixedNameIR` as expressionIR # expressionNoteIR)

. Case analysis on expression'''
.. Case `expression'''` has type defaultExpression
... Let `defaultExpression` be `expression'''` as defaultExpression

... Group defaultExpression: p, TC, `(...)` as expression

.... Let `expressionNoteIR` be (( `(default)` as typeIR (lctk) ))

.... Result in (`(...)` as expressionIR # expressionNoteIR)

.. Case `expression'''` has type unaryExpression
... Let `(unop expression)` be `expression'''` as unaryExpression

... Case analysis on unop
.... Case `unop` matches pattern `!`
..... Group unaryExpression-lnot: p, TC, `((!) expression)` as expression

...... Let [`typedExpressionIR` be the result of typing `expression`, under cursor `p` and typing context `TC`](Expr_ok)

...... Let `typedExpressionIR'?{typedExpressionIR' <- typedExpressionIR'?}` be `$reduce_serenum_unary(typedExpressionIR, $compat_lnot)`

...... If (typedExpressionIR'?{typedExpressionIR' <- typedExpressionIR'?} matches pattern (_)), then

....... Let `?(typedExpressionIR_reduced)` be typedExpressionIR'?{typedExpressionIR' <- typedExpressionIR'?}

....... Let `(_expressionIR # expressionNoteIR)` be typedExpressionIR_reduced

....... Result in (`((!) typedExpressionIR_reduced)` as expressionIR # expressionNoteIR)

.... Case `unop` matches pattern `~`
..... Group unaryExpression-bnot: p, TC, `((~) expression)` as expression

...... Let [`typedExpressionIR` be the result of typing `expression`, under cursor `p` and typing context `TC`](Expr_ok)

...... Let `typedExpressionIR'?{typedExpressionIR' <- typedExpressionIR'?}` be `$reduce_serenum_unary(typedExpressionIR, $compat_bnot)`

...... If (typedExpressionIR'?{typedExpressionIR' <- typedExpressionIR'?} matches pattern (_)), then

....... Let `?(typedExpressionIR_reduced)` be typedExpressionIR'?{typedExpressionIR' <- typedExpressionIR'?}

....... Let `(_expressionIR # expressionNoteIR)` be typedExpressionIR_reduced

....... Result in (`((~) typedExpressionIR_reduced)` as expressionIR # expressionNoteIR)

... Group unaryExpression-uplusminus: p, TC, `(unop expression)` as expression

.... Case analysis on unop
..... Case `unop` matches pattern `+`
...... Let [`typedExpressionIR` be the result of typing `expression`, under cursor `p` and typing context `TC`](Expr_ok)

...... Let `typedExpressionIR'?{typedExpressionIR' <- typedExpressionIR'?}` be `$reduce_serenum_unary(typedExpressionIR, $compat_uplusminus)`

...... If (typedExpressionIR'?{typedExpressionIR' <- typedExpressionIR'?} matches pattern (_)), then

....... Let `?(typedExpressionIR_reduced)` be typedExpressionIR'?{typedExpressionIR' <- typedExpressionIR'?}

....... Let `(_expressionIR # expressionNoteIR)` be typedExpressionIR_reduced

....... Result in (`(unop typedExpressionIR_reduced)` as expressionIR # expressionNoteIR)

..... Case `unop` matches pattern `-`
...... Let [`typedExpressionIR` be the result of typing `expression`, under cursor `p` and typing context `TC`](Expr_ok)

...... Let `typedExpressionIR'?{typedExpressionIR' <- typedExpressionIR'?}` be `$reduce_serenum_unary(typedExpressionIR, $compat_uplusminus)`

...... If (typedExpressionIR'?{typedExpressionIR' <- typedExpressionIR'?} matches pattern (_)), then

....... Let `?(typedExpressionIR_reduced)` be typedExpressionIR'?{typedExpressionIR' <- typedExpressionIR'?}

....... Let `(_expressionIR # expressionNoteIR)` be typedExpressionIR_reduced

....... Result in (`(unop typedExpressionIR_reduced)` as expressionIR # expressionNoteIR)

.. Case `expression'''` has type binaryExpression
... Let `(expression_l binop expression_r)` be `expression'''` as binaryExpression

... Group binaryExpression-plusminusmult: p, TC, `(expression_l binop expression_r)` as expression

.... If (binop is in [(+), (-), (*)]), then

..... Let [`typedExpressionIR_l` be the result of typing `expression_l`, under cursor `p` and typing context `TC`](Expr_ok)

..... Let [`typedExpressionIR_r` be the result of typing `expression_r`, under cursor `p` and typing context `TC`](Expr_ok)

..... Let `(typedExpressionIR, typedExpressionIR)?{(typedExpressionIR, typedExpressionIR) <- (typedExpressionIR, typedExpressionIR)?}` be `$coerce_binary(typedExpressionIR_l, typedExpressionIR_r)`

..... If ((typedExpressionIR, typedExpressionIR)?{(typedExpressionIR, typedExpressionIR) <- (typedExpressionIR, typedExpressionIR)?} matches pattern (_)), then

...... Let `?((typedExpressionIR_l_cast, typedExpressionIR_r_cast))` be (typedExpressionIR, typedExpressionIR)?{(typedExpressionIR, typedExpressionIR) <- (typedExpressionIR, typedExpressionIR)?}

...... Let `(typedExpressionIR, typedExpressionIR)'?{(typedExpressionIR, typedExpressionIR)' <- (typedExpressionIR, typedExpressionIR)'?}` be `$reduce_serenum_binary(typedExpressionIR_l_cast, typedExpressionIR_r_cast, $compat_plusminusmult)`

...... If ((typedExpressionIR, typedExpressionIR)'?{(typedExpressionIR, typedExpressionIR)' <- (typedExpressionIR, typedExpressionIR)'?} matches pattern (_)), then

....... Let `?((typedExpressionIR_l_reduced, typedExpressionIR_r_reduced))` be (typedExpressionIR, typedExpressionIR)'?{(typedExpressionIR, typedExpressionIR)' <- (typedExpressionIR, typedExpressionIR)'?}

....... Let `(_expressionIR # (( typeIR_reduced ctk_l_reduced )))` be typedExpressionIR_l_reduced

....... Let `(_expressionIR' # (( _typeIR ctk_r_reduced )))` be typedExpressionIR_r_reduced

....... Let `ctk_reduced` be `$join_ctk(ctk_l_reduced, ctk_r_reduced)`

....... Let `expressionNoteIR` be (( typeIR_reduced ctk_reduced ))

....... Result in (`(typedExpressionIR_l_reduced binop typedExpressionIR_r_reduced)` as expressionIR # expressionNoteIR)

... Group binaryExpression-satplusminus: p, TC, `(expression_l binop expression_r)` as expression

.... If (binop is in [(|+|), (|-|)]), then

..... Let [`typedExpressionIR_l` be the result of typing `expression_l`, under cursor `p` and typing context `TC`](Expr_ok)

..... Let [`typedExpressionIR_r` be the result of typing `expression_r`, under cursor `p` and typing context `TC`](Expr_ok)

..... Let `(typedExpressionIR, typedExpressionIR)?{(typedExpressionIR, typedExpressionIR) <- (typedExpressionIR, typedExpressionIR)?}` be `$coerce_binary(typedExpressionIR_l, typedExpressionIR_r)`

..... If ((typedExpressionIR, typedExpressionIR)?{(typedExpressionIR, typedExpressionIR) <- (typedExpressionIR, typedExpressionIR)?} matches pattern (_)), then

...... Let `?((typedExpressionIR_l_cast, typedExpressionIR_r_cast))` be (typedExpressionIR, typedExpressionIR)?{(typedExpressionIR, typedExpressionIR) <- (typedExpressionIR, typedExpressionIR)?}

...... Let `(typedExpressionIR, typedExpressionIR)'?{(typedExpressionIR, typedExpressionIR)' <- (typedExpressionIR, typedExpressionIR)'?}` be `$reduce_serenum_binary(typedExpressionIR_l_cast, typedExpressionIR_r_cast, $compat_satplusminus)`

...... If ((typedExpressionIR, typedExpressionIR)'?{(typedExpressionIR, typedExpressionIR)' <- (typedExpressionIR, typedExpressionIR)'?} matches pattern (_)), then

....... Let `?((typedExpressionIR_l_reduced, typedExpressionIR_r_reduced))` be (typedExpressionIR, typedExpressionIR)'?{(typedExpressionIR, typedExpressionIR)' <- (typedExpressionIR, typedExpressionIR)'?}

....... Let `(_expressionIR # (( typeIR_reduced ctk_l_reduced )))` be typedExpressionIR_l_reduced

....... Let `(_expressionIR' # (( _typeIR ctk_r_reduced )))` be typedExpressionIR_r_reduced

....... Let `ctk_reduced` be `$join_ctk(ctk_l_reduced, ctk_r_reduced)`

....... Let `expressionNoteIR` be (( typeIR_reduced ctk_reduced ))

....... Result in (`(typedExpressionIR_l_reduced binop typedExpressionIR_r_reduced)` as expressionIR # expressionNoteIR)

... Group binaryExpression-divmod: p, TC, `(expression_l binop expression_r)` as expression

.... If (binop is in [(/), (%)]), then

..... Let [`typedExpressionIR_l` be the result of typing `expression_l`, under cursor `p` and typing context `TC`](Expr_ok)

..... Let [`typedExpressionIR_r` be the result of typing `expression_r`, under cursor `p` and typing context `TC`](Expr_ok)

..... Let `(typedExpressionIR, typedExpressionIR)?{(typedExpressionIR, typedExpressionIR) <- (typedExpressionIR, typedExpressionIR)?}` be `$coerce_binary(typedExpressionIR_l, typedExpressionIR_r)`

..... If ((typedExpressionIR, typedExpressionIR)?{(typedExpressionIR, typedExpressionIR) <- (typedExpressionIR, typedExpressionIR)?} matches pattern (_)), then

...... Let `?((typedExpressionIR_l_cast, typedExpressionIR_r_cast))` be (typedExpressionIR, typedExpressionIR)?{(typedExpressionIR, typedExpressionIR) <- (typedExpressionIR, typedExpressionIR)?}

...... Let `(typedExpressionIR, typedExpressionIR)'?{(typedExpressionIR, typedExpressionIR)' <- (typedExpressionIR, typedExpressionIR)'?}` be `$reduce_serenum_binary(typedExpressionIR_l_cast, typedExpressionIR_r_cast, $compat_divmod)`

...... If ((typedExpressionIR, typedExpressionIR)'?{(typedExpressionIR, typedExpressionIR)' <- (typedExpressionIR, typedExpressionIR)'?} matches pattern (_)), then

....... Let `?((typedExpressionIR_l_reduced, typedExpressionIR_r_reduced))` be (typedExpressionIR, typedExpressionIR)'?{(typedExpressionIR, typedExpressionIR)' <- (typedExpressionIR, typedExpressionIR)'?}

....... Let `(_expressionIR # (( typeIR_reduced ctk_l_reduced )))` be typedExpressionIR_l_reduced

....... Let `(_expressionIR' # (( _typeIR ctk_r_reduced )))` be typedExpressionIR_r_reduced

....... Case analysis on ctk_r_reduced matches pattern `LCTK`
........ Case true
......... Let [`value_r` be the static evaluation of `typedExpressionIR_r_reduced`, under cursor `p` and typing context `TC`](Eval_static)

......... Let `int` be `$to_number(value_r)`

......... If (`int` has type nat), then

.......... Let `n_r` be `int` as nat

.......... If ((n_r > 0)), then

........... Let `ctk_reduced` be `$join_ctk(ctk_l_reduced, ctk_r_reduced)`

........... Let `expressionNoteIR` be (( typeIR_reduced ctk_reduced ))

........... Result in (`(typedExpressionIR_l_reduced binop typedExpressionIR_r_reduced)` as expressionIR # expressionNoteIR)

........ Case false
......... Let `ctk_reduced` be `$join_ctk(ctk_l_reduced, ctk_r_reduced)`

......... Let `expressionNoteIR` be (( typeIR_reduced ctk_reduced ))

