;; Relation invocation

;;; Rule path evaluation

relation Eval_rul:
  ctx |- rulmatch -> rulpath '@' `( val* `) : res<val*>
  hint(input %0 %1 %2 %3)

rule Eval_rul/succ:
  C |- rulmatch -> rulpath '@' `( val* `) : OK val_out*
  -- if id '=' exp_out* '-' prem_path* = rulpath
  -- if exp* '-' prem_match* = rulmatch
  -- Assign_exps: C |- exp* := val* : C'
  -- if prem* = prem_match* ++ prem_path*
  -- Eval_prems: C' |- prem* : OK C''
  -- (Eval_exp: C'' |- exp_out : OK val_out)*

rule Eval_rul/fail:
  C |- rulmatch -> rulpath '@' `( val* `) : FAIL
  -- otherwise

;;; Rule path sequence evaluation

relation Eval_ruls:
  ctx |- rulmatch -> rulpath* '@' `( val* `) : res<val*>
  hint(input %0 %1 %2 %3)

rule Eval_ruls:
  C |- rulmatch -> rulpath* '@' `( val* `) : valsres_path
  -- (Eval_rul: C |- rulmatch -> rulpath '@' `( val* `) : valsres)*
  -- if valsres_path = $det_valsres(valsres*)

;;; Rule group evaluation

relation Eval_rulgroup:
  ctx |- rulgroup '@' `( val* `) : res<val*>
  hint(input %0 %1 %2)

rule Eval_rulgroup:
  C |- rulgroup '@' `( val* `) : valsres
  -- if id ':' rulmatch '=' rulpath* = rulgroup
  -- Eval_ruls:
      C |- rulmatch -> rulpath* '@' `( val* `) : valsres

;;; Rule group sequence evaluation

relation Eval_rulgroups:
  ctx |- rulgroup* '@' `( val* `) : res<val*>
  hint(input %0 %1 %2)

rule Eval_rulgroups:
  C |- rulgroup* '@' `( val* `) : valsres_group
  -- (Eval_rulgroup: C |- rulgroup '@' `( val* `) : valsres)*
  -- if valsres_group = $det_valsres(valsres*)

;;; Defined relations

relation Call_defined_rel:
  ctx |- definedRelDef '@' `( val* `) : res<val*>
  hint(input %0 %1 %2)
  hint(prose_in "evaluating" %1 "with inputs" %2 "under" %0)
  hint(prose_out %3)

dec $elsgroup_as_rulgroup(elsgroup) : rulgroup
def $elsgroup_as_rulgroup(id ':' rulmatch '=' rulpath)
  = id ':' rulmatch '=' rulpath

rulegroup Call_defined_rel {

  rule Call_defined_rel/succ:
    C |- definedRelDef '@' `( val* `) : OK val_rel*
    -- if DEF rulgroup* elsgroup? = definedRelDef
    -- if C_local = C[ .LOCAL = $empty_layer ]
    -- Eval_rulgroups:
        C_local |- rulgroup* '@' `( val* `) : OK val_rel*

  rule Call_defined_rel/fail:
    C |- definedRelDef '@' `( val* `) : valsres_rel
    -- if DEF rulgroup* elsgroup? = definedRelDef
    -- if C_local = C[ .LOCAL = $empty_layer ]
    -- Eval_rulgroups:
        C_local |- rulgroup* '@' `( val* `) : FAIL
    -- if (rulgroup_els = $elsgroup_as_rulgroup(elsgroup))?
    -- (Eval_rulgroup:
        C_local |- rulgroup_els '@' `( val* `) : valsres)?
    -- if valsres_rel = $deopt_<valsres>(valsres?, FAIL)

}

;; Relation dispatch

rulegroup Call_rel_dispatch {

    rule Call_rel_dispatch/defined:
      C |- definedRelDef val* : valsres
      -- Call_defined_rel:
          C |- definedRelDef '@' `( val* `) : valsres

    rule Call_rel_dispatch/ext:
      C |- (EXT id) val* : valsres
      -- Call_extern_rel:
          |- id val* : valsres

}

;; Relation call

rule Call_rel:
  C |- id val* : valsres
  -- if reldef = $find_rel(C, id)
  -- Call_rel_dispatch: C |- reldef val* : valsres
