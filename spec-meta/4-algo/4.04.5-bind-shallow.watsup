;;
;; Irrefutable patterns
;;
;; syntax typedExp
;;

;; A pattern is irrefutable when it matches every value of its type;
;; a case is, only as the single case of its type

dec $is_irrefutable_exp(tdenv, typedExp) : bool
  hint(prose_true %1 "matches every value of its type under" %0)
  hint(prose_false %1 "does not match every value of its type under" %0)

;;; varExp
;;; syntax varExp = VAR id

def $is_irrefutable_exp(_, varExp '#' _) = true

;;; tupExp
;;; syntax tupExp = TUP typedExp*

def $is_irrefutable_exp(tdenv, (TUP typedExp*) '#' _)
  = $forall_($is_irrefutable_exp(tdenv, typedExp)*)

;;; injExp
;;; syntax injExp = INJ expCase

dec $is_singleton_typ(tdenv, typ) : bool
  hint(prose_true "type" %1 "has a single constructor under" %0)
  hint(prose_false "type" %1 "does not have a single constructor under" %0)

def $is_singleton_typ(tdenv, typ) = (|typCase*| = 1)
  -- if OK (VAR id _) = $expand_typ(tdenv, typ)
  -- if TYP _ _ '=' (VARIANT typCase*) = $find_map<id, typDef>(tdenv, id)

def $is_irrefutable_exp(tdenv, (INJ (_ typedExp*)) '#' typ)
  = $is_singleton_typ(tdenv, typ) /\ $forall_($is_irrefutable_exp(tdenv, typedExp)*)

;;; strExp
;;; syntax strExp = STR expField*

def $is_irrefutable_exp(tdenv, (STR expField*) '#' _)
  = $forall_($is_irrefutable_exp(tdenv, typedExp)*)
  -- (if _ typedExp = expField)*

;;; iterExp
;;; syntax iterExp = ITER typedExp expIter

def $is_irrefutable_exp(tdenv, (ITER typedExp _) '#' _)
  = $is_irrefutable_exp(tdenv, typedExp)

;;; literalExp | opExp | castExp | subExp | matchExp | optExp | listExp
;;; consExp | catExp | memExp | lenExp | accExp | updExp | callExp

def $is_irrefutable_exp(_, exp '#' _) = false
  -- if ~(exp <: varExp) /\ ~(exp <: tupExp) /\ ~(exp <: injExp)
        /\ ~(exp <: strExp) /\ ~(exp <: iterExp)

;;
;; Shallow patterns
;;
;; syntax typedExp
;;

;; A table row argument is shallow: a variable, or a case whose arguments are
;; irrefutable, possibly under an upcast

;;; varExp
;;; syntax varExp = VAR id

rule Shallowbind_exp/variable:
  AC |- varExp '#' _

;;; upCastExp
;;; syntax upCastExp = UPCAST typ typedExp

rule Shallowbind_exp/upcast:
  AC |- (UPCAST _ typedExp) '#' _
  ---- ;; the upcast holds a variable or a case
  -- if exp '#' _ = typedExp
  -- if (exp <: varExp) \/ (exp <: injExp)
  -- Shallowbind_exp: AC |- typedExp

;;; injExp
;;; syntax injExp = INJ expCase

rule Shallowbind_exp/case:
  AC |- (INJ (_ typedExp*)) '#' _
  -- if $forall_($is_irrefutable_exp(AC.TYP, typedExp)*)

;;
;; Shallow argument patterns
;;
;; syntax arg
;;

;;; expArg
;;; syntax expArg = EXP typedExp

rule Shallowbind_arg/exp:
  AC |- EXP typedExp
  -- Shallowbind_exp: AC |- typedExp

;;
;; Shallow argument pattern sequences
;;
;; syntax arg*
;;

rule Shallowbind_args:
  AC |- arg*
  ---- ;; every argument is shallow
  -- (Shallowbind_arg: AC |- arg)*
  ---- ;; and no binder repeats across the arguments
  -- Multibind_args: AC |- arg* : _ _ eps
