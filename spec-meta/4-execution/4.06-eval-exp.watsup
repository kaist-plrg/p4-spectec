;;
;; Expression evaluation
;;
;; syntax typedExp
;;

;;; literalExp
;;; syntax literalExp = BOOL bool | num | TEXT text

rulegroup Eval_exp/literal {

  rule Eval_exp/boolean:
    C |- (BOOL b) '#' _ : OK (BOOL b)

  rule Eval_exp/number:
    C |- num '#' _ : OK num

  rule Eval_exp/string:
    C |- (TEXT t) '#' _ : OK (TEXT t)

}

;;; varExp
;;; syntax varExp = VAR id

rule Eval_exp/variable:
  C |- (VAR id) '#' _ : OK val
  -- if val = $find_varr(C, id eps)

;;; unOpExp
;;; syntax unOpExp = UN unOp typedExp

rulegroup Eval_exp/unary {

  rule Eval_exp/boolean-operand-failure:
    C |- (UN NOT typedExp) '#' _ : failure
    -- Eval_exp: C |- typedExp : failure

  rule Eval_exp/boolean-succ:
    C |- (UN NOT typedExp) '#' _ : OK (BOOL b_res)
    -- Eval_exp: C |- typedExp : OK (BOOL b)
    -- if b_res = ~b

  rule Eval_exp/number-operand-failure:
    C |- (UN numUnOp typedExp) '#' _ : failure
    -- Eval_exp: C |- typedExp : failure

  rule Eval_exp/number-succ:
    C |- (UN numUnOp typedExp) '#' _ : OK val_res
    -- Eval_exp: C |- typedExp : OK num
    -- if val_res = $numUnOp(numUnOp, num)

}

;;; binOpExp
;;; syntax binOpExp = BIN binOp typedExp typedExp

rulegroup Eval_exp/binary {

  rule Eval_exp/boolean-left-failure:
    C |- (BIN boolBinOp typedExp_l typedExp_r) '#' _ : failure
    -- Eval_exp: C |- typedExp_l : failure

  rule Eval_exp/boolean-right-failure:
    C |- (BIN boolBinOp typedExp_l typedExp_r) '#' _ : failure
    -- Eval_exp: C |- typedExp_l : OK (BOOL b_l)
    -- Eval_exp: C |- typedExp_r : failure

  rule Eval_exp/boolean-succ:
    C |- (BIN boolBinOp typedExp_l typedExp_r) '#' _ : OK (BOOL b_res)
    -- Eval_exp: C |- typedExp_l : OK (BOOL b_l)
    -- Eval_exp: C |- typedExp_r : OK (BOOL b_r)
    -- if b_res = $boolBinOp(boolBinOp, b_l, b_r)

  rule Eval_exp/number-left-failure:
    C |- (BIN numBinOp typedExp_l typedExp_r) '#' _ : failure
    -- Eval_exp: C |- typedExp_l : failure

  rule Eval_exp/number-right-failure:
    C |- (BIN numBinOp typedExp_l typedExp_r) '#' _ : failure
    -- Eval_exp: C |- typedExp_l : OK num_l
    -- Eval_exp: C |- typedExp_r : failure

  rule Eval_exp/number-succ:
    C |- (BIN numBinOp typedExp_l typedExp_r) '#' _ : numBinOpRes
    -- Eval_exp: C |- typedExp_l : OK num_l
    -- Eval_exp: C |- typedExp_r : OK num_r
    -- if numBinOpRes = $numBinOp(numBinOp, num_l, num_r)

}

;;; cmpOpExp
;;; syntax cmpOpExp = CMP cmpOp typedExp typedExp

rulegroup Eval_exp/compare {

  rule Eval_exp/poly-left-failure:
    C |- (CMP polyCmpOp typedExp_l typedExp_r) '#' _ : failure
    -- Eval_exp: C |- typedExp_l : failure

  rule Eval_exp/poly-right-failure:
    C |- (CMP polyCmpOp typedExp_l typedExp_r) '#' _ : failure
    -- Eval_exp: C |- typedExp_l : OK val_l
    -- Eval_exp: C |- typedExp_r : failure

  rule Eval_exp/poly-succ:
    C |- (CMP polyCmpOp typedExp_l typedExp_r) '#' _ : OK (BOOL b_res)
    -- Eval_exp: C |- typedExp_l : OK val_l
    -- Eval_exp: C |- typedExp_r : OK val_r
    -- if b_res = $polyCmpOp(polyCmpOp, val_l, val_r)

  rule Eval_exp/number-left-failure:
    C |- (CMP numCmpOp typedExp_l typedExp_r) '#' _ : failure
    -- Eval_exp: C |- typedExp_l : failure

  rule Eval_exp/number-right-failure:
    C |- (CMP numCmpOp typedExp_l typedExp_r) '#' _ : failure
    -- Eval_exp: C |- typedExp_l : OK num_l
    -- Eval_exp: C |- typedExp_r : failure

  rule Eval_exp/number-succ:
    C |- (CMP numCmpOp typedExp_l typedExp_r) '#' _ : OK (BOOL b_res)
    -- Eval_exp: C |- typedExp_l : OK num_l
    -- Eval_exp: C |- typedExp_r : OK num_r
    -- if OK b_res = $numCmpOp(numCmpOp, num_l, num_r)

}

;;; upCastExp
;;; syntax upCastExp = UPCAST typ typedExp

rulegroup Eval_exp/upcast {

  rule Eval_exp/operand-failure:
    C |- (UPCAST typ typedExp) '#' _ : failure
    -- Eval_exp: C |- typedExp : failure

  rule Eval_exp/succ:
    C |- (UPCAST typ typedExp) '#' _ : castRes
    -- Eval_exp: C |- typedExp : OK val
    -- if castRes = $upcast(C, typ, val)

}

;;; downCastExp
;;; syntax downCastExp = DOWNCAST typ typedExp

rulegroup Eval_exp/downcast {

  rule Eval_exp/operand-failure:
    C |- (DOWNCAST typ typedExp) '#' _ : failure
    -- Eval_exp: C |- typedExp : failure

  rule Eval_exp/succ:
    C |- (DOWNCAST typ typedExp) '#' _ : castRes
    -- Eval_exp: C |- typedExp : OK val
    -- if castRes = $downcast(C, typ, val)

}

;;; subExp
;;; syntax subExp = SUB typedExp typ

rulegroup Eval_exp/subtype {

  rule Eval_exp/operand-failure:
    C |- (SUB typedExp typ) '#' _ : failure
    -- Eval_exp: C |- typedExp : failure

  rule Eval_exp/succ:
    C |- (SUB typedExp typ) '#' _ : OK (BOOL b)
    -- Eval_exp: C |- typedExp : OK val
    -- if `{ (id_local ':' typDef_local)* `} = C.LOCAL.TYP
    -- if tdenv = $adds_map<id, typDef>(C.GLOBAL.TYP, id_local*, typDef_local*)
    -- if OK b = $subtyp(C.GLOBAL.FUNC, tdenv, typ, val)

}

;;; matchExp
;;; syntax matchExp = MATCH typedExp pat

rulegroup Eval_exp/match {

  rule Eval_exp/operand-failure:
    C |- (MATCH typedExp pat) '#' _ : failure
    -- Eval_exp: C |- typedExp : failure

  rule Eval_exp/succ:
    C |- (MATCH typedExp pat) '#' _ : OK (BOOL b_matches)
    -- Eval_exp: C |- typedExp : OK val
    -- if b_matches = $matches(val, pat)

}

;;; tupExp
;;; syntax tupExp = TUP typedExp*

rulegroup Eval_exp/tuple {

  rule Eval_exp/expressions-failure:
    C |- (TUP typedExp*) '#' _ : failure
    -- Eval_exps: C |- typedExp* : failure

  rule Eval_exp/succ:
    C |- (TUP typedExp*) '#' _ : OK (TUP val*)
    -- Eval_exps: C |- typedExp* : OK val*

}

;;; injExp
;;; syntax injExp = INJ expCase

rulegroup Eval_exp/case {

  rule Eval_exp/expressions-failure:
    C |- (INJ (mixop typedExp*)) '#' _ : failure
    -- Eval_exps: C |- typedExp* : failure

  rule Eval_exp/succ:
    C |- (INJ (mixop typedExp*)) '#' _ : OK (INJ (mixop val*))
    -- Eval_exps: C |- typedExp* : OK val*

}

;;; strExp
;;; syntax strExp = STR expField*

rulegroup Eval_exp/struct {

  rule Eval_exp/expressions-failure:
    C |- (STR expField*) '#' _ : failure
    -- (if atom typedExp = expField)*
    -- Eval_exps: C |- typedExp* : failure

  rule Eval_exp/succ:
    C |- (STR expField*) '#' _ : OK (STR valField*)
    -- (if atom typedExp = expField)*
    -- Eval_exps: C |- typedExp* : OK val*
    -- (if valField = atom val)*

}

;;; optExp
;;; syntax optExp = OPT typedExp?

rulegroup Eval_exp/opt {

  rule Eval_exp/succ-none:
    C |- (OPT eps) '#' _ : OK (OPT eps)

  rule Eval_exp/operand-failure:
    C |- (OPT typedExp) '#' _ : failure
    -- Eval_exp : C |- typedExp : failure

  rule Eval_exp/succ-some:
    C |- (OPT typedExp) '#' _ : OK (OPT val)
    -- Eval_exp : C |- typedExp : OK val

}

;;; listExp
;;; syntax listExp = LIST typedExp*

rulegroup Eval_exp/list {

  rule Eval_exp/expressions-failure:
    C |- (LIST typedExp*) '#' _ : failure
    -- Eval_exps: C |- typedExp* : failure

  rule Eval_exp/succ:
    C |- (LIST typedExp*) '#' _ : OK (LIST val*)
    -- Eval_exps: C |- typedExp* : OK val*

}

;;; consExp
;;; syntax consExp = CONS typedExp typedExp

rulegroup Eval_exp/cons {

  rule Eval_exp/head-failure:
    C |- (CONS typedExp_h typedExp_t) '#' _ : failure
    -- Eval_exp: C |- typedExp_h : failure

  rule Eval_exp/tail-failure:
    C |- (CONS typedExp_h typedExp_t) '#' _ : failure
    -- Eval_exp: C |- typedExp_h : OK val_h
    -- Eval_exp: C |- typedExp_t : failure

  rule Eval_exp/succ:
    C |- (CONS typedExp_h typedExp_t) '#' _ : OK (LIST (val_h :: val_t*))
    -- Eval_exp: C |- typedExp_h : OK val_h
    -- Eval_exp: C |- typedExp_t : OK (LIST val_t*)

}

;;; catExp
;;; syntax catExp = CAT typedExp typedExp

rulegroup Eval_exp/concat {

  rule Eval_exp/left-failure:
    C |- (CAT typedExp_l typedExp_r) '#' _ : failure
    -- Eval_exp: C |- typedExp_l : failure

  rule Eval_exp/list-right-failure:
    C |- (CAT typedExp_l typedExp_r) '#' _ : failure
    -- Eval_exp: C |- typedExp_l : OK (LIST val_l*)
    -- Eval_exp: C |- typedExp_r : failure

  rule Eval_exp/list-succ:
    C |- (CAT typedExp_l typedExp_r) '#' _ : OK (LIST val_res*)
    -- Eval_exp: C |- typedExp_l : OK (LIST val_l*)
    -- Eval_exp: C |- typedExp_r : OK (LIST val_r*)
    -- if val_res* = val_l* ++ val_r*

  rule Eval_exp/text-right-failure:
    C |- (CAT typedExp_l typedExp_r) '#' _ : failure
    -- Eval_exp: C |- typedExp_l : OK (TEXT text_l)
    -- Eval_exp: C |- typedExp_r : failure

  rule Eval_exp/text-succ:
    C |- (CAT typedExp_l typedExp_r) '#' _ : OK (TEXT t_res)
    -- Eval_exp: C |- typedExp_l : OK (TEXT t_l)
    -- Eval_exp: C |- typedExp_r : OK (TEXT t_r)
    -- if t_res = t_l ++ t_r

}

;;; memExp
;;; syntax memExp = MEM typedExp typedExp

rulegroup Eval_exp/mem {

  rule Eval_exp/elem-failure:
    C |- (MEM typedExp_e typedExp_s) '#' _ : failure
    -- Eval_exp: C |- typedExp_e : failure

  rule Eval_exp/list-failure:
    C |- (MEM typedExp_e typedExp_s) '#' _ : failure
    -- Eval_exp: C |- typedExp_e : OK val_e
    -- Eval_exp: C |- typedExp_s : failure

  rule Eval_exp/succ:
    C |- (MEM typedExp_e typedExp_s) '#' _ : OK (BOOL b_mem)
    -- Eval_exp: C |- typedExp_e : OK val_e
    -- Eval_exp: C |- typedExp_s : OK (LIST val*)
    -- if b_mem = $exists_((val_e = val)*)

}

;;; lenExp
;;; syntax lenExp = LEN typedExp

rulegroup Eval_exp/len {

  rule Eval_exp/operand-failure:
    C |- (LEN typedExp) '#' _ : failure
    -- Eval_exp: C |- typedExp : failure

  rule Eval_exp/text:
    C |- (LEN typedExp) '#' _ : OK (NAT n)
    -- Eval_exp: C |- typedExp : OK (TEXT t)
    -- if n = |t|

  rule Eval_exp/list:
    C |- (LEN typedExp) '#' _ : OK (NAT n)
    -- Eval_exp: C |- typedExp : OK (LIST val*)
    -- if n = |val*|

}

;;; dotAccExp
;;; syntax dotAccExp = DOT typedExp atom

rulegroup Eval_exp/dot {

  rule Eval_exp/operand-failure:
    C |- (DOT typedExp atom) '#' _ : failure
    -- Eval_exp: C |- typedExp : failure

  rule Eval_exp/succ:
    C |- (DOT typedExp atom) '#' typ : pathRes
    -- Eval_exp: C |- typedExp : OK val
    -- if _ '#' typ_b = typedExp
    -- if typedPath = (DOT (ROOT '#' typ_b) atom) '#' typ
    -- Eval_path_acc: C |- val typedPath : pathRes

}

;;; idxAccExp
;;; syntax idxAccExp = IDX typedExp typedExp

rulegroup Eval_exp/idx {

  rule Eval_exp/base-failure:
    C |- (IDX typedExp_b typedExp_i) '#' _ : failure
    -- Eval_exp: C |- typedExp_b : failure

  rule Eval_exp/succ:
    C |- (IDX typedExp_b typedExp_i) '#' typ : pathRes
    -- Eval_exp: C |- typedExp_b : OK val_b
    -- if _ '#' typ_b = typedExp_b
    -- if typedPath = (IDX (ROOT '#' typ_b) typedExp_i) '#' typ
    -- Eval_path_acc: C |- val_b typedPath : pathRes

}

;;; sliceAccExp
;;; syntax sliceAccExp = SLICE typedExp typedExp typedExp

rulegroup Eval_exp/slice {

  rule Eval_exp/base-failure:
    C |- (SLICE typedExp_b typedExp_i typedExp_n) '#' _ : failure
    -- Eval_exp: C |- typedExp_b : failure

  rule Eval_exp/succ:
    C |- (SLICE typedExp_b typedExp_i typedExp_n) '#' typ : pathRes
    -- Eval_exp: C |- typedExp_b : OK val_b
    -- if _ '#' typ_b = typedExp_b
    -- if typedPath = (SLICE (ROOT '#' typ_b) typedExp_i typedExp_n) '#' typ
    -- Eval_path_acc: C |- val_b typedPath : pathRes

}

;;; updExp
;;; syntax updExp = UPD typedExp typedPath typedExp

rulegroup Eval_exp/upd {

  rule Eval_exp/base-failure:
    C |- (UPD typedExp_b typedPath typedExp_f) '#' _ : failure
    -- Eval_exp: C |- typedExp_b : failure

  rule Eval_exp/value-failure:
    C |- (UPD typedExp_b typedPath typedExp_f) '#' _ : failure
    -- Eval_exp: C |- typedExp_b : OK val_b
    -- Eval_exp: C |- typedExp_f : failure

  rule Eval_exp/succ:
    C |- (UPD typedExp_b typedPath typedExp_f) '#' _ : pathRes
    -- Eval_exp: C |- typedExp_b : OK val_b
    -- Eval_exp: C |- typedExp_f : OK val_f
    -- Eval_path_upd: C |- val_b typedPath := val_f : pathRes

}

;;; callExp
;;; syntax callExp = CALL id targ* arg*

rulegroup Eval_exp/call {

  rule Eval_exp/arguments-failure:
    C |- (CALL id targ* arg*) '#' _ : failure
    -- Eval_targs: C |- targ* : OK typ_input*
    -- Eval_args: C |- arg* : failure

  rule Eval_exp/succ:
    C |- (CALL id targ* arg*) '#' _ : callFuncRes
    -- Eval_targs: C |- targ* : OK typ_input*
    -- Eval_args: C |- arg* : OK val_input*
    -- Call_func:
        C |- id `< typ_input* `> `( val_input* `) : callFuncRes

}

;;; iterExp
;;; syntax iterExp = ITER typedExp expIter

rulegroup Eval_exp/iter {

  rule Eval_exp/simple:
    C |- iterExp '#' typ : OK val
    -- if varr = $is_iter_on_var(iterExp '#' typ)
    -- if val = $find_varr(C, varr)

  rule Eval_exp/opt-body-failure:
    C |- iterExp '#' typ : failure
    -- if eps = $is_iter_on_var(iterExp '#' typ)
    -- if ITER typedExp (QUEST vari*) = iterExp
    -- if OK C_sub? = $sub_opt(C, vari*)
    -- Eval_exp_maybe: C_sub? |- typedExp : failure

  rule Eval_exp/opt-succ:
    C |- iterExp '#' typ : OK (OPT val?)
    -- if eps = $is_iter_on_var(iterExp '#' typ)
    -- if ITER typedExp (QUEST vari*) = iterExp
    -- if OK C_sub? = $sub_opt(C, vari*)
    -- Eval_exp_maybe: C_sub? |- typedExp : OK val?

  rule Eval_exp/list-body-failure:
    C |- iterExp '#' typ : failure
    -- if eps = $is_iter_on_var(iterExp '#' typ)
    -- if ITER typedExp (STAR vari*) = iterExp
    -- if OK C_sub* = $sub_list(C, vari*)
    -- Eval_exp_each: C_sub* |- typedExp : failure

  rule Eval_exp/list-succ:
    C |- iterExp '#' typ : OK (LIST val*)
    -- if eps = $is_iter_on_var(iterExp '#' typ)
    -- if ITER typedExp (STAR vari*) = iterExp
    -- if OK C_sub* = $sub_list(C, vari*)
    -- Eval_exp_each: C_sub* |- typedExp : OK val*

}

;; Any other expression is an error

rule Eval_exp/error:
  C |- typedExp : ERROR
  -- otherwise

;;
;; Expression sequence evaluation
;;
;; syntax typedExp*
;;

rulegroup Eval_exps {

  rule Eval_exps/nil:
    C |- eps : OK eps

  rule Eval_exps/head-failure:
    C |- typedExp_h :: typedExp_t* : failure
    -- Eval_exp: C |- typedExp_h : failure

  rule Eval_exps/tail-failure:
    C |- typedExp_h :: typedExp_t* : failure
    -- Eval_exp: C |- typedExp_h : OK val_h
    -- Eval_exps: C |- typedExp_t* : failure

  rule Eval_exps/cons-succ:
    C |- typedExp_h :: typedExp_t* : OK (val_h :: val_t*)
    -- Eval_exp: C |- typedExp_h : OK val_h
    -- Eval_exps: C |- typedExp_t* : OK val_t*

}

;;
;; Expression evaluation in optional contexts
;;
;; syntax typedExp
;;

rulegroup Eval_exp_maybe {

  rule Eval_exp_maybe/none:
    eps |- typedExp : OK eps

  rule Eval_exp_maybe/failure:
    C |- typedExp : failure
    -- Eval_exp: C |- typedExp : failure

  rule Eval_exp_maybe/some:
    C |- typedExp : OK val
    -- Eval_exp: C |- typedExp : OK val

}

;;
;; Expression evaluation in list contexts
;;
;; syntax typedExp
;;

rulegroup Eval_exp_each {

  rule Eval_exp_each/nil:
    eps |- typedExp : OK eps

  rule Eval_exp_each/head-failure:
    (C_h :: C_t*) |- typedExp : failure
    -- Eval_exp: C_h |- typedExp : failure

  rule Eval_exp_each/tail-failure:
    (C_h :: C_t*) |- typedExp : failure
    -- Eval_exp: C_h |- typedExp : OK val_h
    -- Eval_exp_each: C_t* |- typedExp : failure

  rule Eval_exp_each/cons-succ:
    (C_h :: C_t*) |- typedExp : OK (val_h :: val_t*)
    -- Eval_exp: C_h |- typedExp : OK val_h
    -- Eval_exp_each: C_t* |- typedExp : OK val_t*

}
