    -- if (vari_iter = $iterate_vari(vari, [ QUEST ]))*
    -- if val_bind* = $repeat_<val>(OPT eps, |vari_iter*|)
    -- if C_assign = $add_varis(C, vari_iter*, val_bind*)

  rule Assign_exp/opt-some:
    C |- iterExp '#' typ := OPT val : OK C_assign
    -- if eps = $is_iter_on_var(iterExp '#' typ)
    -- if ITER typedExp (QUEST vari*) = iterExp
    -- Assign_exp: C |- typedExp := val : OK C_body
    -- if (vari_iter = $iterate_vari(vari, [ QUEST ]))*
    -- if (val_sub = $find_vari(C_body, vari))*
    -- if C_assign = $add_varis(C_body, vari_iter*, (OPT val_sub)*)

  rule Assign_exp/list:
    C |- iterExp '#' typ := LIST val* : OK C_assign
    -- if eps = $is_iter_on_var(iterExp '#' typ)
    -- if ITER typedExp (STAR vari*) = iterExp
    -- if C_local = C[ .LOCAL.VAL = $empty_map<varr, val> ]
    -- (Assign_exp: C_local |- typedExp := val : OK C_sub)*
    -- if (vari_iter = $iterate_vari(vari, [ STAR ]))*
    -- if (val_sub* = $finds_vari(C_sub*, vari))*
    -- if (val_bind = LIST val_sub*)*
    -- if C_assign = $add_varis(C, vari_iter*, val_bind*)

}

;; Any other assignment is an error

rule Assign_exp/error:
  C |- typedExp := val : ERROR
  -- otherwise

;;
;; Assignment to expression sequences
;;
;; syntax typedExp*
;;

rulegroup Assign_exps {

  rule Assign_exps/nil:
    C |- eps := eps : OK C

  rule Assign_exps/cons:
    C |- typedExp_h :: typedExp_t* := val_h :: val_t* : OK C_t
    -- Assign_exp: C |- typedExp_h := val_h : OK C_h
    -- Assign_exps: C_h |- typedExp_t* := val_t* : OK C_t

}

;; Any other assignment is an error

rule Assign_exps/error:
  C |- typedExp* := val* : ERROR
  -- otherwise

;;
;; Assignment to arguments
;;
;; syntax arg
;;

;;; expArg
;;; syntax expArg = EXP typedExp

rule Assign_arg/exp:
  C |- EXP typedExp := val : OK C_assign
  -- Assign_exp: C |- typedExp := val : OK C_assign

;;; funArg
;;; syntax funArg = FUN id

rule Assign_arg/fun:
  C |- FUN id := FUNC id_global : OK C_assign
  -- if C_assign = $add_func(C, id, id_global)

;; Any other assignment is an error

rule Assign_arg/error:
  C |- arg := val : ERROR
  -- otherwise

;;
;; Assignment to argument sequences
;;
;; syntax arg*
;;

rulegroup Assign_args {

  rule Assign_args/nil:
    C |- eps := eps : OK C

  rule Assign_args/cons:
    C |- arg_h :: arg_t* := val_h :: val_t* : OK C_t
    -- Assign_arg: C |- arg_h := val_h : OK C_h
    -- Assign_args: C_h |- arg_t* := val_t* : OK C_t

}

;; Any other assignment is an error

rule Assign_args/error:
  C |- arg* := val* : ERROR
  -- otherwise
