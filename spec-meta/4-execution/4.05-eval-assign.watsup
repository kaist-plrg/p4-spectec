;;
;; Assignments
;;

syntax assignRes = ok<ctx> | error

relation Assign_exp:
  ctx |- typedExp := val : assignRes
  hint(input %0 %1 %2)
  hint(prose_in "assigning value" %2 "to expression" %1 "under context" %0)
  hint(prose_out %3)

relation Assign_exps:
  ctx |- typedExp* := val* : assignRes
  hint(input %0 %1 %2)
  hint(prose_in "assigning values" %2 "to expressions" %1 "in order under context" %0)
  hint(prose_out %3)

relation Assign_arg:
  ctx |- arg := val : assignRes
  hint(input %0 %1 %2)
  hint(prose_in "assigning value" %2 "to argument" %1 "under context" %0)
  hint(prose_out %3)

relation Assign_args:
  ctx |- arg* := val* : assignRes
  hint(input %0 %1 %2)
  hint(prose_in "assigning values" %2 "to arguments" %1 "in order under context" %0)
  hint(prose_out %3)

;;
;; Assignment to expressions
;;
;; syntax typedExp
;;

;;; varExp
;;; syntax varExp = VAR id

rule Assign_exp/variable:
  C |- (VAR id) '#' _ := val : OK C_assign
  -- if C_assign = $add_varr(C, id eps, val)

;;; tupExp
;;; syntax tupExp = TUP typedExp*

rule Assign_exp/tup:
  C |- (TUP typedExp*) '#' _ := TUP val* : OK C_assign
  -- Assign_exps: C |- typedExp* := val* : OK C_assign

;;; injExp
;;; syntax injExp = INJ expCase

rule Assign_exp/inj:
  C |- (INJ (mixop typedExp*)) '#' _ := INJ (mixop val*) : OK C_assign
  -- Assign_exps: C |- typedExp* := val* : OK C_assign

;;; strExp
;;; syntax strExp = STR expField*

rule Assign_exp/str:
  C |- (STR expField*) '#' _ := STR valField* : OK C_assign
  -- (if atom val = valField)*
  -- (if atom typedExp = expField)*
  -- Assign_exps: C |- typedExp* := val* : OK C_assign

;;; optExp
;;; syntax optExp = OPT typedExp?

rulegroup Assign_exp/opt {

  rule Assign_exp/opt-some:
    C |- (OPT typedExp) '#' _ := OPT val : OK C_assign
    -- Assign_exp: C |- typedExp := val : OK C_assign

  rule Assign_exp/opt-none:
    C |- (OPT eps) '#' _ := OPT eps : OK C

}

;;; listExp
;;; syntax listExp = LIST typedExp*

rule Assign_exp/list:
  C |- (LIST typedExp*) '#' _ := LIST val* : OK C_assign
  -- Assign_exps: C |- typedExp* := val* : OK C_assign

;;; consExp
;;; syntax consExp = CONS typedExp typedExp

rule Assign_exp/cons:
  C |- (CONS typedExp_h typedExp_t) '#' _ := LIST (val_h :: val_t*) : OK C_t
  -- Assign_exp: C |- typedExp_h := val_h : OK C_h
  -- Assign_exp: C_h |- typedExp_t := LIST val_t* : OK C_t

;;; iterExp
;;; syntax iterExp = ITER typedExp expIter

rulegroup Assign_exp/iter {

  rule Assign_exp/simple:
    C |- iterExp '#' typ := val : OK C_assign
    -- if varr = $is_iter_on_var(iterExp '#' typ)
    -- if C_assign = $add_varr(C, varr, val)

  rule Assign_exp/opt-none:
