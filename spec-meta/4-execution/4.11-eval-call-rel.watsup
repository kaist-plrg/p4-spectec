;; Relation invocation

;;; Rule evaluation

relation Eval_rul:
  ctx |- rulAL `( val* `) : relRes
  hint(input %0 %1 %2)
  hint(prose_in "evaluating rule" %1 "with inputs" %2 "under context" %0)
  hint(prose_out %3)

rulegroup Eval_rul {

  rule Eval_rul/premises-failure:
    C |- (_ ':' exp* '->' _ '-' prem*) `( val* `) : failure
    -- Assign_exps: C |- exp* := val* : OK C'
    -- Eval_prems: C' |- prem* : failure

  rule Eval_rul/succ:
    C |- (_ ':' exp* '->' exp_out* '-' prem*) `( val* `) : relRes
    -- Assign_exps: C |- exp* := val* : OK C'
    -- Eval_prems: C' |- prem* : OK C''
    -- Eval_exps: C'' |- exp_out* : relRes

}

rule Eval_rul/error:
  C |- rulAL `( val* `) : ERROR
  -- otherwise

;;; Rule sequence evaluation

relation Eval_ruls:
  ctx |- rulAL* `( val* `) : relRes
  hint(input %0 %1 %2)
  hint(prose_in "evaluating rules" %1 "with inputs" %2 "under context" %0
                "with determinism checks")
  hint(prose_out %3)

relation Eval_ruls_on_ok:
  ctx |- rulAL* `( val* `) : unitRes
  hint(input %0 %1 %2)
  hint(prose_in "checking that all remaining rules" %1
                "are unmatched with inputs" %2 "under context" %0)
  hint(prose_out %3)

rulegroup Eval_ruls {

  rule Eval_ruls/nil:
    C |- eps `( val* `) : UNMATCH

  rule Eval_ruls/unmatch:
    C |- (rulAL_h :: rulAL_t*) `( val* `) : relRes
    -- Eval_rul: C |- rulAL_h `( val* `) : UNMATCH
    -- Eval_ruls: C |- rulAL_t* `( val* `) : relRes

  rule Eval_ruls/succ:
    C |- (rulAL_h :: rulAL_t*) `( val* `) : OK val_out*
    -- Eval_rul: C |- rulAL_h `( val* `) : OK val_out*
    -- Eval_ruls_on_ok: C |- rulAL_t* `( val* `) : OK

}

rule Eval_ruls/error:
  C |- rulAL* `( val* `) : ERROR
  -- otherwise

rulegroup Eval_ruls_on_ok {

  rule Eval_ruls_on_ok/nil:
    C |- eps `( val* `) : OK

  rule Eval_ruls_on_ok/unmatch:
    C |- (rulAL_h :: rulAL_t*) `( val* `) : unitRes
    -- Eval_rul: C |- rulAL_h `( val* `) : UNMATCH
    -- Eval_ruls_on_ok: C |- rulAL_t* `( val* `) : unitRes

  rule Eval_ruls_on_ok/error:
    C |- (rulAL_h :: rulAL_t*) `( val* `) : ERROR
    -- Eval_rul: C |- rulAL_h `( val* `) : relRes
    -- if relRes =/= UNMATCH

}

;;; Defined relations

relation Call_defined_rel:
  ctx |- definedRelDefnAL `( val* `) : relRes
  hint(input %0 %1 %2)
  hint(prose_in "calling defined relation" %1 "with inputs" %2 "under context" %0)
  hint(prose_out %3)

dec $ruls_of_rulgroup(rulGroupAL) : rulAL*
  hint(prose_in "the rules of rule group" %0)
def $ruls_of_rulgroup(id ':' rulAL*) = rulAL*

dec $ruls_of_rulgroups(rulGroupAL*) : rulAL*
  hint(prose_in "the rules of rule groups" %0 "in order")
def $ruls_of_rulgroups(eps) = eps
def $ruls_of_rulgroups(rulGroup_h :: rulGroup_t*)
  = $ruls_of_rulgroup(rulGroup_h) ++ $ruls_of_rulgroups(rulGroup_t*)

dec $rul_of_elsgroup(elsGroupAL) : rulAL
  hint(prose_in "the rule of otherwise group" %0)
def $rul_of_elsgroup(id ':' rulAL) = rulAL

rulegroup Call_defined_rel {

  rule Call_defined_rel/unmatch:
    C |- definedRelDefn `( val* `) : relRes
    -- if REL _ ':' _ '->' _ '=' rulGroup* elsGroup? = definedRelDefn
    -- if C_local = C[ .LOCAL = $empty_localLayer ]
    -- if rulAL* = $ruls_of_rulgroups(rulGroup*)
    -- Eval_ruls:
        C_local |- rulAL* `( val* `) : UNMATCH
    -- if (rulAL_els = $rul_of_elsgroup(elsGroup))?
    -- (Eval_rul:
        C_local |- rulAL_els `( val* `) : relRes_els)?
    -- if relRes = $deopt_<relRes>(relRes_els?, UNMATCH)

  rule Call_defined_rel/result:
    C |- definedRelDefn `( val* `) : relRes
    -- if REL _ ':' _ '->' _ '=' rulGroup* elsGroup? = definedRelDefn
    -- if C_local = C[ .LOCAL = $empty_localLayer ]
    -- if rulAL* = $ruls_of_rulgroups(rulGroup*)
    -- Eval_ruls:
        C_local |- rulAL* `( val* `) : relRes
    -- if relRes =/= UNMATCH

}

rule Call_defined_rel/error:
  C |- definedRelDefn `( val* `) : ERROR
  -- otherwise

;; Relation call

rulegroup Call_rel {

  rule Call_rel/extern:
    C |- id `( val* `) : relRes
    -- if EXTREL id_rel ':' _ '->' _ = $find_rel(C, id)
    -- Call_extern_rel:
        |- id_rel `( val* `) : relRes

  rule Call_rel/defined:
    C |- id `( val* `) : relRes
    -- if definedRelDefn = $find_rel(C, id)
    -- Call_defined_rel:
        C |- definedRelDefn `( val* `) : relRes

}

rule Call_rel/error:
  C |- id `( val* `) : ERROR
  -- otherwise
