;;
;; Meta-function invocation
;;

;;; Clause invocation

syntax clauseRes = ok<val> | failure

relation Eval_clause:
  ctx |- clauseAL `( val* `) : clauseRes
  hint(input %0 %1 %2)
  hint(prose_in "evaluating clause" %1 "with inputs" %2 "under context" %0)
  hint(prose_out %3)

rulegroup Eval_clause {

  rule Eval_clause/premises-failure:
    C |- clauseAL `( val* `) : failure
    -- if arg* '=' typedExp_out '-' premAL* = clauseAL
    -- Assign_args: C |- arg* := val* : OK C_assign
    -- Eval_prems: C_assign |- premAL* : failure

  rule Eval_clause/succ:
    C |- clauseAL `( val* `) : clauseRes
    -- if arg* '=' typedExp_out '-' premAL* = clauseAL
    -- Assign_args: C |- arg* := val* : OK C_assign
    -- Eval_prems: C_assign |- premAL* : OK C_prem
    -- Eval_exp : C_prem |- typedExp_out : clauseRes

}

rule Eval_clause/error:
  C |- clauseAL `( val* `) : ERROR
  -- otherwise

relation Eval_clauses:
  ctx |- clauseAL* `( val* `) : clauseRes
  hint(input %0 %1 %2)
  hint(prose_in "evaluating clauses" %1 "with inputs" %2 "under context" %0
                "with determinism checks")
  hint(prose_out %3)

relation Eval_clauses_on_ok:
  ctx |- clauseAL* `( val* `) : unitRes
  hint(input %0 %1 %2)
  hint(prose_in "checking that all remaining clauses" %1
                "are unmatched with inputs" %2 "under context" %0)
  hint(prose_out %3)

rulegroup Eval_clauses {

  rule Eval_clauses/nil:
    C |- eps `( val* `) : UNMATCH

  rule Eval_clauses/unmatch:
    C |- (clauseAL_h :: clauseAL_t*) `( val* `) : clauseRes
    -- Eval_clause: C |- clauseAL_h `( val* `) : UNMATCH
    -- Eval_clauses: C |- clauseAL_t* `( val* `) : clauseRes

  rule Eval_clauses/succ:
    C |- (clauseAL_h :: clauseAL_t*) `( val* `) : OK val_out
    -- Eval_clause: C |- clauseAL_h `( val* `) : OK val_out
    -- Eval_clauses_on_ok: C |- clauseAL_t* `( val* `) : OK

}

rule Eval_clauses/error:
  C |- clauseAL* `( val* `) : ERROR
  -- otherwise

rulegroup Eval_clauses_on_ok {

  rule Eval_clauses_on_ok/nil:
    C |- eps `( val* `) : OK

  rule Eval_clauses_on_ok/unmatch:
    C |- (clauseAL_h :: clauseAL_t*) `( val* `) : unitRes
    -- Eval_clause: C |- clauseAL_h `( val* `) : UNMATCH
    -- Eval_clauses_on_ok: C |- clauseAL_t* `( val* `) : unitRes

  rule Eval_clauses_on_ok/error:
    C |- (clauseAL_h :: clauseAL_t*) `( val* `) : ERROR
    -- Eval_clause: C |- clauseAL_h `( val* `) : clauseRes
    -- if clauseRes =/= UNMATCH

}

;;; Table meta-function invocation

;;;; Table row evaluation

syntax tblRowRes = ok<val> | failure

relation Eval_tblrow:
  ctx |- tblRowAL `( val* `) : tblRowRes
  hint(input %0 %1 %2)
  hint(prose_in "evaluating table row" %1 "with inputs" %2 "under context" %0)
  hint(prose_out %3)

rulegroup Eval_tblrow {

  rule Eval_tblrow/premises-failure:
    C |- tblRowAL `( val* `) : failure
    -- if arg* '=' typedExp_out '-' premAL* = tblRowAL
    -- if C_callee = C[ .LOCAL = $empty_localLayer ]
    -- Assign_args: C_callee |- arg* := val* : OK C_callee_assign
    -- Eval_prems: C_callee_assign |- premAL* : failure

  rule Eval_tblrow/succ:
    C |- tblRowAL `( val* `) : tblRowRes
    -- if arg* '=' typedExp_out '-' premAL* = tblRowAL
    -- if C_callee = C[ .LOCAL = $empty_localLayer ]
    -- Assign_args: C_callee |- arg* := val* : OK C_callee_assign
    -- Eval_prems: C_callee_assign |- premAL* : OK C_callee_prem
    -- Eval_exp: C_callee_prem |- typedExp_out : tblRowRes

}

rule Eval_tblrow/error:
  C |- tblRowAL `( val* `) : ERROR
  -- otherwise

;;;; Table row sequence evaluation

relation Eval_tblrows:
  ctx |- tblRowAL* `( val* `) : tblRowRes
  hint(input %0 %1 %2)
  hint(prose_in "evaluating table rows" %1 "with inputs" %2 "under context" %0
                "in order until a row succeeds or errors")
  hint(prose_out %3)

rulegroup Eval_tblrows {

  rule Eval_tblrows/nil:
    C |- eps `( val* `) : UNMATCH

  rule Eval_tblrows/unmatch:
    C |- (tblRowAL_h :: tblRowAL_t*) `( val* `) : tblRowRes
    -- Eval_tblrow: C |- tblRowAL_h `( val* `) : UNMATCH
    -- Eval_tblrows: C |- tblRowAL_t* `( val* `) : tblRowRes

  rule Eval_tblrows/cons-result:
    C |- (tblRowAL_h :: tblRowAL_t*) `( val* `) : tblRowRes
    -- Eval_tblrow: C |- tblRowAL_h `( val* `) : tblRowRes
    -- if tblRowRes =/= UNMATCH

}

;;;; Table meta-function evaluation

relation Call_table_func:
  ctx |- tableFuncDefnAL `( val* `) : callFuncRes
  hint(input %0 %1 %2)
  hint(prose_in "calling table function" %1 "with inputs" %2 "under context" %0)
  hint(prose_out %3)

rule Call_table_func:
  C |- tableFuncDefnAL `( val* `) : callFuncRes
  -- if TABLEFUNC _ _ ':' _ '=' tblRowAL* = tableFuncDefnAL
  -- Eval_tblrows: C |- tblRowAL* `( val* `) : callFuncRes

;;; Defined meta-function invocation

relation Call_defined_func:
  ctx |- definedFuncDefnAL `< typ* `> `( val* `) : callFuncRes
  hint(input %0 %1 %2 %3)
  hint(prose_in "calling defined function" %1 "with types" %2 "and inputs" %3
                "under context" %0)
  hint(prose_out %4)

rulegroup Call_defined_func {

  rule Call_defined_func/unmatch-partial:
    C |- definedFuncDefnAL `< typ* `> `( val* `) : ERROR
    -- if FUNC _ tparam* _ ':' _ '=' clauseAL* elsClauseAL? = definedFuncDefnAL
    -- if tdenv = `{ (tparam ':' (TYP tparam eps '=' (ALIAS typ)))* `}
    -- if C_callee = C[ .LOCAL = $empty_localLayer[ .TYP = tdenv ] ]
    -- Eval_clauses: C_callee |- clauseAL* `( val* `) : UNMATCH
    -- (Eval_clause: C_callee |- elsClauseAL `( val* `) : clauseRes_els)?
    -- if UNMATCH = $deopt_<clauseRes>(clauseRes_els?, UNMATCH)

  rule Call_defined_func/unmatch-result:
    C |- definedFuncDefnAL `< typ* `> `( val* `) : callFuncRes
    -- if FUNC _ tparam* _ ':' _ '=' clauseAL* elsClauseAL? = definedFuncDefnAL
    -- if tdenv = `{ (tparam ':' (TYP tparam eps '=' (ALIAS typ)))* `}
    -- if C_callee = C[ .LOCAL = $empty_localLayer[ .TYP = tdenv ] ]
    -- Eval_clauses: C_callee |- clauseAL* `( val* `) : UNMATCH
    -- (Eval_clause: C_callee |- elsClauseAL `( val* `) : clauseRes_els)?
    -- if callFuncRes = $deopt_<clauseRes>(clauseRes_els?, UNMATCH)

  rule Call_defined_func/result:
    C |- definedFuncDefnAL `< typ* `> `( val* `) : callFuncRes
    -- if FUNC _ tparam* _ ':' _ '=' clauseAL* elsClauseAL? = definedFuncDefnAL
    -- if tdenv = `{ (tparam ':' (TYP tparam eps '=' (ALIAS typ)))* `}
    -- if C_callee = C[ .LOCAL = $empty_localLayer[ .TYP = tdenv ] ]
    -- Eval_clauses: C_callee |- clauseAL* `( val* `) : callFuncRes

}

rule Call_defined_func/error:
  C |- definedFuncDefnAL `< typ* `> `( val* `) : ERROR
  -- otherwise

;;
;; Meta-function call
;;

rulegroup Call_func {

  rule Call_func/extern:
    C |- id `< typ* `> `( val* `) : OK val_out
    -- if id_global = $resolve_func_param(C, id)
    -- if EXTFUNC id_func _ _ ':' _ = $find_func(C, id_global)
    -- Call_extern_func:
        |- id_func `< typ* `> `( val* `) : OK val_out

  rule Call_func/builtin:
    C |- id `< typ* `> `( val* `) : OK val_out
    -- if id_global = $resolve_func_param(C, id)
    -- if BUILTINFUNC id_func _ _ ':' _ = $find_func(C, id_global)
    -- Call_builtin_func:
        |- id_func `< typ* `> `( val* `) : OK val_out

  rule Call_func/table:
    C |- id `< eps `> `( val* `) : callFuncRes
    -- if id_global = $resolve_func_param(C, id)
    -- if tableFuncDefnAL = $find_func(C, id_global)
    -- Call_table_func:
        C |- tableFuncDefnAL `( val* `) : callFuncRes

  rule Call_func/defined:
    C |- id `< typ* `> `( val* `) : callFuncRes
    -- if id_global = $resolve_func_param(C, id)
    -- if definedFuncDefnAL = $find_func(C, id_global)
    -- Call_defined_func:
        C |- definedFuncDefnAL `< typ* `> `( val* `) : callFuncRes

}

rule Call_func/error:
  C |- id `< typ* `> `( val* `) : ERROR
  -- otherwise
