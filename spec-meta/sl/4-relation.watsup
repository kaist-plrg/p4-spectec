;; Result to represent instruction sequence evaluation

syntax flow =
  | OK
  | RES val*
  | RET val
  | FAIL

syntax blockres = res<block>
syntax ctxres = res<ctx>

;; Evaluation relations

relation Eval_exp:
  ctx |- exp : res<val>
  hint(input %0 %1)

relation Eval_targs:
  ctx |- targ* : typ*
  hint(input %0 %1)

relation Eval_arg:
  ctx |- arg : res<val>
  hint(input %0 %1)

relation Eval_instr:
  ctx |- instr : flow
  hint(input %0 %1)

relation Eval_instrs:
  ctx |- instr* : flow
  hint(input %0 %1)

relation Eval_block:
  ctx |- block : flow
  hint(input %0 %1)

relation Call_func:
  ctx |- funcdef targ* val* : res<val>
  hint(input %0 %1 %2 %3)

relation Call_func_cached:
  ctx |- id targ* val* : res<val>
  hint(input %0 %1 %2 %3)

relation Call_rel:
  ctx |- reldef val* : res<val*>
  hint(input %0 %1 %2)

relation Call_rel_cached:
  ctx |- id val* : res<val*>
  hint(input %0 %1 %2)

relation Call_func_dispatch:
  ctx |- id typ* val* funccache : res<val>
  hint(input %0 %1 %2 %3 %4)

relation Call_rel_dispatch:
  ctx |- id val* relcache : res<val*>
  hint(input %0 %1 %2 %3)
