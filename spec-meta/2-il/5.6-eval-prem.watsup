;;; Debug premises

rule Eval_prem/dbg:
  CIL |- DEBUG exp : OK CIL
  -- EvalIL_exp: CIL |- exp : OK val
  -- debug val

rule Eval_prem/fail:
  CIL |- prem : FAIL
  -- otherwise

;; Premise sequence evaluation rules

rulegroup Eval_prems {

  rule Eval_prems/empty:
    CIL |- eps : OK CIL

  rule Eval_prems/head-fail:
    CIL |- prem_h :: prem_t* : FAIL
    -- Eval_prem: CIL |- prem_h : FAIL

  rule Eval_prems/head-succ:
    CIL |- prem_h :: prem_t* : ctxILres
    -- Eval_prem: CIL |- prem_h : OK CIL'
    -- Eval_prems: CIL' |- prem_t* : ctxILres

}
