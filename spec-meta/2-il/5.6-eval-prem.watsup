;; Premise evaluation rules

;;; Relation premises

rule Eval_prem/relpr:
  CIL |- REL id `: exp* `-> exp_out* : OK CIL'
  -- (EvalIL_exp: CIL |- exp : OK val)*
  -- CallIL_rel_cached: CIL |- id val* : OK val_out*
  -- AssignIL_exps : CIL |- exp_out* := val_out* : CIL'

;;; If premises

rulegroup Eval_prem/ifpr {

  rule Eval_prem/true:
    CIL |- IF exp : OK CIL
    -- EvalIL_exp: CIL |- exp : OK (BOOL true)

  rule Eval_prem/false:
    CIL |- IF exp : FAIL
    -- EvalIL_exp: CIL |- exp : OK (BOOL false)

}

;;; If-hold and if-not-hold premises

rulegroup Eval_prem/ifholdpr {

  rule Eval_prem/hold:
    CIL |- IFHOLD id `: exp* : OK CIL
    -- (EvalIL_exp: CIL |- exp : OK val_input)*
    -- CallIL_rel_cached: CIL |- id val_input* : OK eps

  rule Eval_prem/nothold:
    CIL |- IFNOTHOLD id `: exp* : OK CIL
    -- (EvalIL_exp: CIL |- exp : OK val_input)*
    -- CallIL_rel_cached: CIL |- id val_input* : FAIL

}

;;; Let premises

rule Eval_prem/letpr:
  CIL |- LET exp_l `= exp_r : OK CIL'
  -- EvalIL_exp: CIL |- exp_r : OK val_r
  -- AssignIL_exp: CIL |- exp_l := val_r : CIL'

