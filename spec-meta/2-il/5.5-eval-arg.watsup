;; Argument evaluation rules

rule EvalIL_arg/exp:
  CIL |- EXP exp : OK val
  -- EvalIL_exp: CIL |- exp : OK val

rule EvalIL_arg/fun:
  CIL |- FUN id : OK (FUNC id)

rule EvalIL_arg/fail:
  CIL |- arg : FAIL
  -- otherwise

;; Type argument evaluation rules

rule EvalIL_targs:
  CIL |- targ* : targ_subst*
  -- if theta = $theta_of_tdenv(CIL.LOCAL.TYP)
  -- if (targ_subst = $subst_typ(theta, targ))*
