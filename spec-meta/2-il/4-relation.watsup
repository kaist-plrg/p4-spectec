;; Result to represent backtracking in evaluation

syntax ctxILres = res<ctxIL>

;; Evaluation relations

relation EvalIL_exp:
  ctxIL |- exp : res<val>
  hint(input %0 %1)

relation EvalIL_targs:
  ctxIL |- targ* : typ*
  hint(input %0 %1)

relation EvalIL_arg:
  ctxIL |- arg : res<val>
  hint(input %0 %1)

relation Eval_prem:
  ctxIL |- prem : res<ctxIL>
  hint(input %0 %1)

relation Eval_prems:
  ctxIL |- prem* : res<ctxIL>
  hint(input %0 %1)

relation CallIL_func:
  ctxIL |- funcdefIL targ* val* : res<val>
  hint(input %0 %1 %2 %3)

relation CallIL_func_cached:
  ctxIL |- id targ* val* : res<val>
  hint(input %0 %1 %2 %3)

relation CallIL_rel:
  ctxIL |- reldefIL val* : res<val*>
  hint(input %0 %1 %2)

relation CallIL_rel_cached:
  ctxIL |- id val* : res<val*>
  hint(input %0 %1 %2)

relation CallIL_func_dispatch:
  ctxIL |- id typ* val* funccache : res<val>
  hint(input %0 %1 %2 %3 %4)

relation CallIL_rel_dispatch:
  ctxIL |- id val* relcache : res<val*>
  hint(input %0 %1 %2 %3)
