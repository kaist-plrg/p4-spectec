;; Assignments

relation AssignIL_exp:
  ctxIL |- exp := val : ctxIL
  hint(input %0 %1 %2)

relation AssignIL_exps:
  ctxIL |- exp* := val* : ctxIL
  hint(input %0 %1 %2)

relation AssignIL_arg:
  ctxIL `/ ctxIL |- arg := val : ctxIL
  hint(input %0 %1 %2 %3)

relation AssignIL_args:
  ctxIL `/ ctxIL  |- arg* := val* : ctxIL
  hint(input %0 %1 %2 %3)

;;; Assigning to an expression

rule AssignIL_exp/variable:
  CIL |- VAR id := val : CIL'
  -- if CIL' = $addIL_varr(CIL, id eps, val)

rule AssignIL_exp/tup:
  CIL |- TUP exp* := TUP val* : CIL'
  -- AssignIL_exps: CIL |- exp* := val* : CIL'

rule AssignIL_exp/inj:
  CIL |- INJ (mixop exp*) := INJ (mixop val*) : CIL'
  -- AssignIL_exps: CIL |- exp* := val* : CIL'

rule AssignIL_exp/str:
  CIL |- STR expfield* := STR valfield* : CIL'
  -- (if atom val = valfield)*
  -- (if atom exp = expfield)*
  -- AssignIL_exps: CIL |- exp* := val* : CIL'

rulegroup AssignIL_exp/opt {

  rule AssignIL_exp/opt-some:
    CIL |- OPT exp := OPT val : CIL'
    -- AssignIL_exp: CIL |- exp := val : CIL'

  rule AssignIL_exp/opt-none:
    CIL |- OPT eps := OPT eps : CIL

}

rule AssignIL_exp/list:
  CIL |- LIST exp* := LIST val* : CIL'
  -- AssignIL_exps: CIL |- exp* := val* : CIL'

rule AssignIL_exp/cons:
  CIL |- CONS exp_h exp_t := LIST (val_h :: val_t*) : CIL''
  -- AssignIL_exp: CIL |- exp_h := val_h : CIL'
  -- AssignIL_exp: CIL' |- exp_t := LIST val_t* : CIL''

rulegroup AssignIL_exp/iter {

  rule AssignIL_exp/simple:
    CIL |- ITER exp iterexp := val : CIL'
    -- if varr = $is_iter_on_var(ITER exp iterexp)
    -- if CIL' = $addIL_varr(CIL, varr, val)

  rule AssignIL_exp/opt-none:
    CIL |- ITER exp iterexp := OPT eps : CIL'
    -- if eps = $is_iter_on_var(ITER exp iterexp)
    -- if QUEST vari* = iterexp
    -- if (vari_iter = $iter_vari(vari, QUEST))*
    -- if val_bind* = $repeat_<val>(OPT eps, |vari_iter*|)
    -- if CIL' = $addIL_varis(CIL, vari_iter*, val_bind*)

  rule AssignIL_exp/opt-some:
    CIL |- ITER exp iterexp := OPT val : CIL''
    -- if eps = $is_iter_on_var(ITER exp iterexp)
    -- if QUEST vari* = iterexp
    -- AssignIL_exp: CIL |- exp := val : CIL'
    -- if (vari_iter = $iter_vari(vari, QUEST))*
    -- if (val_sub = $findIL_vari(CIL', vari))*
    -- if CIL'' = $addIL_varis(CIL', vari_iter*, OPT val_sub)*

  rule AssignIL_exp/list:
    CIL |- ITER exp iterexp := LIST val* : CIL'
    -- if eps = $is_iter_on_var(ITER exp iterexp)
    -- if STAR vari* = iterexp
    -- if CIL_local = CIL[ .LOCAL.VAL = $empty_map<varr, val> ]
    -- (AssignIL_exp: CIL_local |- exp := val : CIL_sub)*
    -- if (vari_iter = $iter_vari(vari, STAR))*
    -- if (val_sub* = $findsIL_vari(CIL_sub*, vari))*
    -- if (val_bind = LIST val_sub*)*
    -- if CIL' = $addIL_varis(CIL, vari_iter*, val_bind*)

}

;;; Assigning to a sequence of expressions

rule AssignIL_exps/nil:
  CIL |- eps := eps : CIL 

rule AssignIL_exps/cons:
  CIL |- exp_h :: exp_t* := val_h :: val_t* : CIL''
  -- AssignIL_exp: CIL |- exp_h := val_h : CIL'
  -- AssignIL_exps: CIL' |- exp_t* := val_t* : CIL''

;;; Assigning to an argument

rule AssignIL_arg/exp:
  CIL_callee `/ _ |- EXP exp := val : CIL_callee'
  -- AssignIL_exp: CIL_callee |- exp := val : CIL_callee'

rule AssignIL_arg/fun:
  CIL_callee `/ CIL_caller |- FUN id_callee := FUNC id_caller : CIL_callee'
  -- if (_, funcdefIL) = $findIL_func(CIL_caller, id_caller)
  -- if CIL_callee' = $addIL_func(CIL_callee, id_callee, funcdefIL)

;;; Assigning to a sequence of arguments

rule AssignIL_args/nil:
  CIL_callee `/ _ |- eps := eps : CIL_callee

rule AssignIL_args/cons:
  CIL_callee `/ CIL_caller |- arg_h :: arg_t* := val_h :: val_t* : CIL_callee''
  -- AssignIL_arg: CIL_callee `/ CIL_caller |- arg_h := val_h : CIL_callee'
  -- AssignIL_args: CIL_callee' `/ CIL_caller |- arg_t* := val_t* : CIL_callee''
