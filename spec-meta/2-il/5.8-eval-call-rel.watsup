;; Relation invocation

;;; Rule path evaluation

relation Eval_rul:
  ctxIL |- rulmatch -> rulpath `@ `( val* ) : res<val*>
  hint(input %0 %1 %2 %3)

rule Eval_rul/succ:
  CIL |- rulmatch -> rulpath `@ `( val* ) : OK val_out*
  -- if id `= exp_out* `- prem_path* = rulpath
  -- if exp* `- prem_match* = rulmatch
  -- AssignIL_exps: CIL |- exp* := val* : CIL'
  -- if prem* = prem_match* ++ prem_path*
  -- Eval_prems: CIL' |- prem* : OK CIL''
  -- (EvalIL_exp: CIL'' |- exp_out : OK val_out)*

rule Eval_rul/fail:
  CIL |- rulmatch -> rulpath `@ `( val* ) : FAIL
  -- otherwise

;;; Rule path sequence evaluation

relation Eval_ruls:
  ctxIL |- rulmatch -> rulpath* `@ `( val* ) : res<val*>
  hint(input %0 %1 %2 %3)

rulegroup Eval_ruls {

  rule Eval_ruls/nil:
    CIL |- rulmatch -> eps `@ `( val* ) : FAIL

  rule Eval_ruls/cons-succ:
    CIL |- rulmatch -> (rulpath_h :: rulpath_t*) `@ `( val* ) : OK val_out*
    -- Eval_rul: CIL |- rulmatch -> rulpath_h `@ `( val* ) : OK val_out*

  rule Eval_ruls/cons-fail:
    CIL |- rulmatch -> (rulpath_h :: rulpath_t*) `@ `( val* ) : valsres
    -- Eval_rul: CIL |- rulmatch -> rulpath_h `@ `( val* ) : FAIL
    -- Eval_ruls: CIL |- rulmatch -> rulpath_t* `@ `( val* ) : valsres

}

;;; Rule group evaluation

relation Eval_rulgroup:
  ctxIL |- rulgroup `@ `( val* ) : res<val*>
  hint(input %0 %1 %2)

rule Eval_rulgroup/succ:
  CIL |- rulgroup `@ `( val* ) : OK val_out*
  -- if id `: rulmatch `= rulpath* = rulgroup
  -- Eval_ruls: CIL |- rulmatch -> rulpath* `@ `( val* ) : OK val_out*

rule Eval_rulgroup/fail:
  CIL |- rulgroup `@ `( val* ) : FAIL
  -- otherwise

;;; Rule group sequence evaluation

relation Eval_rulgroups:
  ctxIL |- rulgroup* `@ `( val* ) : res<val*>
  hint(input %0 %1 %2)

rulegroup Eval_rulgroups {

  rule Eval_rulgroups/nil:
    CIL |- eps `@ `( val* ) : FAIL

  rule Eval_rulgroups/cons-succ:
    CIL |- (rulgroup_h :: rulgroup_t*) `@ `( val* ) : OK val_out*
    -- Eval_rulgroup: CIL |- rulgroup_h `@ `( val* ) : OK val_out*

  rule Eval_rulgroups/cons-fail:
    CIL |- (rulgroup_h :: rulgroup_t*) `@ `( val* ) : valsres
    -- Eval_rulgroup: CIL |- rulgroup_h `@ `( val* ) : FAIL
    -- Eval_rulgroups: CIL |- rulgroup_t* `@ `( val* ) : valsres

}

;;; Defined relations

relation CallIL_defined_rel:
  ctxIL |- definedRelDefIL `@ `( val* ) : res<val*>
  hint(input %0 %1 %2)

dec $elsgroup_as_rulgroup(elsgroup) : rulgroup
def $elsgroup_as_rulgroup(id `: rulmatch `= rulpath)
  = id `: rulmatch `= rulpath

rule CallIL_defined_rel:
  CIL |- definedRelDefIL `@ `( val* ) : valsres
  -- if DEF rulgroup* elsgroup? = definedRelDefIL
  -- if (rulgroup_els = $elsgroup_as_rulgroup(elsgroup))?
  -- if rulgroup_all* = rulgroup* ++ $opt_as_seq_<rulgroup>(rulgroup_els?)
  -- if CIL_local = CIL[ .LOCAL = $emptyIL_layer ]
  -- Eval_rulgroups:
      CIL_local |- rulgroup_all* `@ `( val* ) : valsres

;; Relation dispatch

rulegroup CallIL_rel {

    rule CallIL_rel/defined:
      CIL |- definedRelDefIL val* : valsres
      -- CallIL_defined_rel:
          CIL |- definedRelDefIL `@ `( val* ) : valsres

    rule CallIL_rel/ext:
      CIL |- (EXT id) val* : valsres
      -- Call_extern_rel:
          |- id val* : valsres

}

;; Relation call wrapper with cache

rule CallIL_rel_cached:
  CIL |- id val* : valsres
  -- if relcache = $cache_find_rel(id, val*)
  -- CallIL_rel_dispatch: CIL |- id val* relcache : valsres

rule CallIL_rel_dispatch/hit:
  CIL |- id val_input* (OK val_cached*) : OK val_cached*

rule CallIL_rel_dispatch/miss:
  CIL |- id val_input* NONE : valsres
  -- if reldefIL = $findIL_rel(CIL, id)
  -- if cp_before = $cache_checkpoint()
  -- CallIL_rel: CIL |- reldefIL val_input* : valsres
  -- if cp_after = $cache_checkpoint()
  -- if b_ext = (reldefIL <: externRelDefIL)
  -- if b_seff = $cache_seff(cp_before, cp_after)
  -- if $cache_add_rel_maybe(
          b_ext \/ b_seff,
          ;; true,
          id, val_input*, valsres)
