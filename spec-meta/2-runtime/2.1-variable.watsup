;; Runtime variables

syntax varr = id iter*

;; Iteration helpers

dec $is_iter_on_var(typedExp) : varr?
  hint(prose_in "the runtime variable represented by" %0 "if any")
def $is_iter_on_var((VAR id) '#' _) = id eps
def $is_iter_on_var((ITER typedExp iterExp) '#' _)
  = id (iter* ++ [ iter_outer ])
  -- if id iter* = $is_iter_on_var(typedExp)
  -- if iter_outer (id _ iter*) = iterExp
def $is_iter_on_var(_) = eps
  -- otherwise

dec $iter_vari(vari, iter) : vari
  hint(prose_in %0 "iterated by" %1)
def $iter_vari(id typ iter*, iter_add)
  = id typ (iter* ++ [ iter_add ])
