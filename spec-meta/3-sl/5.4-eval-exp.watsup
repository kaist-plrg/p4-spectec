;; Expression evaluation rules

;;; Boolean, number, and text evaluation rules

rule EvalSL_exp/boolean:
  CSL |- BOOL b : OK (BOOL b)

rule EvalSL_exp/number:
  CSL |- num : OK num

rule EvalSL_exp/string:
  CSL |- TEXT t : OK (TEXT t)

;;; Variable evaluation rules

rule EvalSL_exp/variable:
  CSL |- VAR id : OK val
  -- if val = $findSL_varr(CSL, id eps)

;;; Unary, binary, and comparison evaluation rules

rule EvalSL_exp/unary-boolean:
  CSL |- UN NOT exp : OK (BOOL (~b))
  -- EvalSL_exp: CSL |- exp : OK (BOOL b)

rule EvalSL_exp/unary-number:
  CSL |- UN numunop exp : OK val_res
  -- EvalSL_exp: CSL |- exp : OK num
  -- if val_res = $unop_number(numunop, num)

rulegroup EvalSL_exp/binary-boolean {

  rule EvalSL_exp/and:
    CSL |- BIN AND exp_l exp_r : OK (BOOL (b_l /\ b_r))
    -- EvalSL_exp: CSL |- exp_l : OK (BOOL b_l)
    -- EvalSL_exp: CSL |- exp_r : OK (BOOL b_r)

  rule EvalSL_exp/or:
    CSL |- BIN OR exp_l exp_r : OK (BOOL (b_l \/ b_r))
    -- EvalSL_exp: CSL |- exp_l : OK (BOOL b_l)
    -- EvalSL_exp: CSL |- exp_r : OK (BOOL b_r)
  
  rule EvalSL_exp/impl:
    CSL |- BIN IMPL exp_l exp_r : OK (BOOL (b_l => b_r))
    -- EvalSL_exp: CSL |- exp_l : OK (BOOL b_l)
    -- EvalSL_exp: CSL |- exp_r : OK (BOOL b_r)

  rule EvalSL_exp/equiv:
    CSL |- BIN EQUIV exp_l exp_r : OK (BOOL (b_l <=> b_r))
    -- EvalSL_exp: CSL |- exp_l : OK (BOOL b_l)
    -- EvalSL_exp: CSL |- exp_r : OK (BOOL b_r)

}

rule EvalSL_exp/binary-number:
  CSL |- BIN numbinop exp_l exp_r : OK val_res
  -- EvalSL_exp: CSL |- exp_l : OK num_l
  -- EvalSL_exp: CSL |- exp_r : OK num_r
  -- if val_res = $binop_number(numbinop, num_l, num_r)

rulegroup EvalSL_exp/compare-poly {

  rule EvalSL_exp/eq:
    CSL |- CMP EQ exp_l exp_r : OK (BOOL (val_l = val_r))
    -- EvalSL_exp: CSL |- exp_l : OK val_l 
    -- EvalSL_exp: CSL |- exp_r : OK val_r 
  
  rule EvalSL_exp/neq:
    CSL |- CMP NE exp_l exp_r : OK (BOOL (val_l =/= val_r))
    -- EvalSL_exp: CSL |- exp_l : OK val_l 
    -- EvalSL_exp: CSL |- exp_r : OK val_r 
}

rule EvalSL_exp/compare-number:
  CSL |- CMP cmpop exp_l exp_r : OK val_res
  -- EvalSL_exp: CSL |- exp_l : OK num_l
  -- EvalSL_exp: CSL |- exp_r : OK num_r
  -- if val_res = BOOL $cmpop_number(cmpop, num_l, num_r)

;;; Upcasting, downcasting, and subtyping evaluation rules

rule EvalSL_exp/upcast:
  CSL |- UPCAST typ exp : $upcastSL(CSL, typ, val)
  -- EvalSL_exp: CSL |- exp : OK val

rule EvalSL_exp/downcast:
  CSL |- DOWNCAST typ exp : $downcastSL(CSL, typ, val)
  -- EvalSL_exp: CSL |- exp : OK val

rule EvalSL_exp/subtype:
  CSL |- SUB exp typ : OK (BOOL b)
  -- EvalSL_exp: CSL |- exp : OK val
  -- if b = $subtypSL(CSL, typ, val)

;;; Match evaluation rules

rulegroup EvalSL_exp/match {

  rule EvalSL_exp/inj:
    CSL |- MATCH exp (INJ mixop_p) : OK (BOOL (mixop_p = mixop_v))
    -- EvalSL_exp: CSL |- exp : OK (INJ (mixop_v _))

  rule EvalSL_exp/list-cons:
    CSL |- MATCH exp CONS : OK (BOOL $(|val*| > 0))
    -- EvalSL_exp: CSL |- exp : OK (LIST val*)

  rule EvalSL_exp/list-fixed:
    CSL |- MATCH exp (FIXED n) : OK (BOOL (|val*| = n))
    -- EvalSL_exp: CSL |- exp : OK (LIST val*)

  rule EvalSL_exp/list-nil:
    CSL |- MATCH exp NIL : OK (BOOL (|val*| = 0))
    -- EvalSL_exp: CSL |- exp : OK (LIST val*)

  rule EvalSL_exp/opt-some:
    CSL |- MATCH exp SOME : OK (BOOL (val? =/= eps))
    -- EvalSL_exp: CSL |- exp : OK (OPT val?)

  rule EvalSL_exp/opt-none:
    CSL |- MATCH exp NONE : OK (BOOL (val? = eps))
    -- EvalSL_exp: CSL |- exp : OK (OPT val?)
  
}

;;; Tuple evaluation rules

rule EvalSL_exp/tuple:
  CSL |- TUP exp* : OK (TUP val*)
  -- (EvalSL_exp: CSL |- exp : OK val)*

;;; Case evaluation rules

rule EvalSL_exp/case:
  CSL |- INJ (mixop exp*) : OK (INJ (mixop val*))
  -- (EvalSL_exp: CSL |- exp : OK val)*

;;; Struct evaluation rules

rule EvalSL_exp/struct:
  CSL |- STR expfield* : OK (STR valfield*)
  -- (if atom exp = expfield)*
  -- (EvalSL_exp: CSL |- exp : OK val)*
  -- (if valfield = atom val)*

;;; Option evaluation rules

rulegroup EvalSL_exp/opt {

  rule EvalSL_exp/some:
    CSL |- OPT exp : OK (OPT val)
    -- EvalSL_exp : CSL |- exp : OK val

  rule EvalSL_exp/none:
    CSL |- OPT eps : OK (OPT eps)
}

;;; List evaluation rules

rule EvalSL_exp/list:
  CSL |- LIST exp* : OK (LIST val*)
  -- (EvalSL_exp: CSL |- exp : OK val)*

;;; Cons-list evaluation rules

rule EvalSL_exp/cons:
  CSL |- CONS exp_h exp_t : OK (LIST (val_h :: val_t*))
  -- EvalSL_exp: CSL |- exp_h : OK val_h
  -- EvalSL_exp: CSL |- exp_t : OK (LIST val_t*)

;;; Concatentation evaluation rules

rulegroup EvalSL_exp/concat {

  rule EvalSL_exp/text:
  CSL |- CAT exp_l exp_r : OK (TEXT (text_l ++ text_r))
  -- EvalSL_exp: CSL |- exp_l : OK (TEXT text_l)
  -- EvalSL_exp: CSL |- exp_r : OK (TEXT text_r)

  rule EvalSL_exp/list: 
  CSL |- CAT exp_l exp_r : OK (LIST (val_l* ++ val_r*))
  -- EvalSL_exp: CSL |- exp_l : OK (LIST val_l*)
  -- EvalSL_exp: CSL |- exp_r : OK (LIST val_r*)

}

;;; Membership evaluation rules

rule EvalSL_exp/mem:
  CSL |- MEM exp_e exp_s : OK (BOOL $exists_((val_e = val)*))
  -- EvalSL_exp: CSL |- exp_e : OK val_e
  -- EvalSL_exp: CSL |- exp_s : OK (LIST val*)

;;; Length evaluation rules

rulegroup EvalSL_exp/len {

  rule EvalSL_exp/text:
    CSL |- LEN exp : OK (NAT (|text|))
    -- EvalSL_exp: CSL |- exp : OK (TEXT text)

  rule EvalSL_exp/list:
    CSL |- LEN exp : OK (NAT (|val*|))
    -- EvalSL_exp: CSL |- exp : OK (LIST val*)

}

;;; Dot, indexing, and slicing evaluation rules

rule EvalSL_exp/dot:
  CSL |- DOT exp atom : OK val_res
  -- EvalSL_exp: CSL |- exp : OK (STR valfield*)
  -- (if atom_field val_field = valfield)*
  -- if val_res = $assoc_<atom, val>(atom, (atom_field, val_field)*)

rulegroup EvalSL_exp/idx { 

  rule EvalSL_exp/text:
    CSL |- IDX exp_b exp_i : OK (TEXT t[n])
    -- EvalSL_exp: CSL |- exp_b : OK (TEXT t)
    -- EvalSL_exp: CSL |- exp_i : OK (NAT n)

  rule EvalSL_exp/list:
    CSL |- IDX exp_b exp_i : OK (val*[n])
    -- EvalSL_exp: CSL |- exp_b : OK (LIST val*)
    -- EvalSL_exp: CSL |- exp_i : OK (NAT n)
}

rulegroup EvalSL_exp/slice {

  rule EvalSL_exp/text:
  CSL |- SLICE exp_b exp_i exp_n : OK (TEXT t[n_i : n_n])
    -- EvalSL_exp: CSL |- exp_b : OK (TEXT t)
    -- EvalSL_exp: CSL |- exp_i : OK (NAT n_i)
    -- EvalSL_exp: CSL |- exp_n : OK (NAT n_n)

  rule EvalSL_exp/list:
    CSL |- SLICE exp_b exp_i exp_n : OK (LIST val*[n_i : n_n])
    -- EvalSL_exp: CSL |- exp_b : OK (LIST val*)
    -- EvalSL_exp: CSL |- exp_i : OK (NAT n_i)
    -- EvalSL_exp: CSL |- exp_n : OK (NAT n_n)

}

;;; Update evaluation rules

rule EvalSL_exp/upd:
  CSL |- UPD exp_b path exp_f : $update_pathSL(CSL, val_b, path, val_f)
  -- EvalSL_exp: CSL |- exp_b : OK val_b
  -- EvalSL_exp: CSL |- exp_f : OK val_f

;;; Meta-function call evaluation rules

rule EvalSL_exp/call:
  CSL |- CALL id targ* arg* : valres
  -- EvalSL_targs: CSL |- targ* : typ_input*
  -- (EvalSL_arg: CSL |- arg : OK val_input)*
  -- CallSL_func_cached: CSL |- id targ* val_input* : valres

;;; Iterated expression evaluation rules

rulegroup EvalSL_exp/iter {

  rule EvalSL_exp/simple:
    CSL |- ITER exp iterexp : OK val
    -- if varr = $is_iter_on_var(ITER exp iterexp)
    -- if val = $findSL_varr(CSL, varr)

  rule EvalSL_exp/opt:
    CSL |- ITER exp iterexp : OK (OPT val?)
    -- if eps = $is_iter_on_var(ITER exp iterexp)
    -- if QUEST vari* = iterexp
    -- if CSL_sub? = $subSL_opt(CSL, vari*)
    -- (EvalSL_exp: CSL_sub |- exp : OK val)?
   
  rule EvalSL_exp/list:
    CSL |- ITER exp iterexp : OK (LIST val*)
    -- if eps = $is_iter_on_var(ITER exp iterexp)
    -- if STAR vari* = iterexp
    -- if CSL_sub* = $subSL_list(CSL, vari*)
    -- (EvalSL_exp: CSL_sub |- exp : OK val)*

}

rule EvalSL_exp/fail:
  CSL |- exp : FAIL
  -- otherwise
