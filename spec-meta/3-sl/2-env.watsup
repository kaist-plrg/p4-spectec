;; Relation environment

syntax externRelDefSL =
  | EXT id

syntax definedRelDefSL =
  | DEF exp* block block?

syntax reldefSL =
  | externRelDefSL
  | definedRelDefSL

syntax renvSL = map<id, reldefSL>

;; Function environment

syntax externFuncDefSL =
  | EXT id

syntax builtinFuncDefSL =
  | BUILTIN id tparam* paramSL*

syntax tableFuncDefSL =
  | TABLE paramSL* `-> tblrowSL*

syntax definedFuncDefSL =
  | DEF tparam* `-> block block?

syntax funcdefSL =
  | externFuncDefSL
  | builtinFuncDefSL
  | tableFuncDefSL
  | definedFuncDefSL

syntax fenvSL = map<id, funcdefSL>
