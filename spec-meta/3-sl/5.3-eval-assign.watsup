;; Assignments

relation AssignSL_exp:
  ctxSL |- exp := val : ctxSL
  hint(input %0 %1 %2)

relation AssignSL_exps:
  ctxSL |- exp* := val* : ctxSL
  hint(input %0 %1 %2)

relation AssignSL_param:
  ctxSL `/ ctxSL |- paramSL := val : ctxSL
  hint(input %0 %1 %2 %3)

relation AssignSL_params:
  ctxSL `/ ctxSL  |- paramSL* := val* : ctxSL
  hint(input %0 %1 %2 %3)

;;; Assigning to an expression

rule AssignSL_exp/variable:
  CSL |- VAR id := val : CSL'
  -- if CSL' = $addSL_varr(CSL, id eps, val)

rule AssignSL_exp/tup:
  CSL |- TUP exp* := TUP val* : CSL'
  -- AssignSL_exps: CSL |- exp* := val* : CSL'

rule AssignSL_exp/inj:
  CSL |- INJ (mixop exp*) := INJ (mixop val*) : CSL'
  -- AssignSL_exps: CSL |- exp* := val* : CSL'

rule AssignSL_exp/str:
  CSL |- STR expfield* := STR valfield* : CSL'
  -- (if atom val = valfield)*
  -- (if atom exp = expfield)*
  -- AssignSL_exps: CSL |- exp* := val* : CSL'

rulegroup AssignSL_exp/opt {

  rule AssignSL_exp/opt-some:
    CSL |- OPT exp := OPT val : CSL'
    -- AssignSL_exp: CSL |- exp := val : CSL'

  rule AssignSL_exp/opt-none:
    CSL |- OPT eps := OPT eps : CSL

}

rule AssignSL_exp/list:
  CSL |- LIST exp* := LIST val* : CSL'
  -- AssignSL_exps: CSL |- exp* := val* : CSL'

rule AssignSL_exp/cons:
  CSL |- CONS exp_h exp_t := LIST (val_h :: val_t*) : CSL''
  -- AssignSL_exp: CSL |- exp_h := val_h : CSL'
  -- AssignSL_exp: CSL' |- exp_t := LIST val_t* : CSL''

rulegroup AssignSL_exp/iter {

  rule AssignSL_exp/simple:
    CSL |- ITER exp iterexp := val : CSL'
    -- if varr = $is_iter_on_var(ITER exp iterexp)
    -- if CSL' = $addSL_varr(CSL, varr, val)

  rule AssignSL_exp/opt-none:
    CSL |- ITER exp iterexp := OPT eps : CSL'
