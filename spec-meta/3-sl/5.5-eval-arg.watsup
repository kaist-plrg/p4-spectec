;; Argument evaluation rules

rule EvalSL_arg/exp:
  CSL |- EXP exp : OK val
  -- EvalSL_exp: CSL |- exp : OK val

rule EvalSL_arg/fun:
  CSL |- FUN id : OK (FUNC id)

rule EvalSL_arg/fail:
  CSL |- arg : FAIL
  -- otherwise

;; Type argument evaluation rules

rule EvalSL_targs:
  CSL |- targ* : targ_subst*
  -- if theta = $theta_of_tdenv(CSL.LOCAL.TYP)
  -- if (targ_subst = $subst_typ(theta, targ))*
