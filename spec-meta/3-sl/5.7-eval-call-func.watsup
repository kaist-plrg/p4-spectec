;; Meta-function invocation

;;; Table meta-function invocation

;;;; Table row evaluation

relation EvalSL_tblrow:
  ctxSL |- tblrowSL `@ `( val* ) : res<val>
  hint(input %0 %1 %2)

rule EvalSL_tblrow/succ:
  CSL |- tblrowSL `@ `( val* ) : OK val_out
  -- if _ `= exp_out `- block = tblrowSL
  -- Eval_block: CSL |- block : RET val_out

rule EvalSL_tblrow/fail:
  CSL |- tblrowSL `@ `( val* ) : FAIL
  -- otherwise

;;;; Table row sequence evaluation

relation EvalSL_tblrows:
  ctxSL |- tblrowSL* `@ `( val* ) : res<val>
  hint(input %0 %1 %2)

rulegroup EvalSL_tblrows {

  rule EvalSL_tblrows/nil:
    CSL |- eps `@ `( val* ) : FAIL

  rule EvalSL_tblrows/cons-succ:
    CSL |- (tblrowSL_h :: tblrowSL_t*) `@ `( val* ) : OK val_out
    -- EvalSL_tblrow: CSL |- tblrowSL_h `@ `( val* ) : OK val_out

  rule EvalSL_tblrows/cons-fail:
    CSL |- (tblrowSL_h :: tblrowSL_t*) `@ `( val* ) : valres
    -- EvalSL_tblrow: CSL |- tblrowSL_h `@ `( val* ) : FAIL
    -- EvalSL_tblrows: CSL |- tblrowSL_t* `@ `( val* ) : valres

}

;;;; Table meta-function evaluation

relation CallSL_table_func:
  ctxSL |- tableFuncDefSL `@ `( val* ) : res<val>
  hint(input %0 %1 %2)

rule CallSL_table_func:
  CSL |- tableFuncDefSL `@ `( val* ) : valres
  -- if TABLE paramSL* `-> tblrowSL* = tableFuncDefSL
  -- EvalSL_tblrows: CSL |- tblrowSL* `@ `( val* ) : valres

;;; Defined meta-function invocation

relation CallSL_defined_func:
  ctxSL |- definedFuncDefSL `@ `< typ* > `( val* ) : res<val>
  hint(input %0 %1 %2 %3)

dec $elsblock_as_block(block?) : block
def $elsblock_as_block(eps) = eps
def $elsblock_as_block(block) = block

rule CallSL_defined_func/succ:
  CSL |- definedFuncDefSL `@ `< typ* > `( val* ) : OK val_ret
  -- if DEF tparam* paramSL* `-> block block_els? = definedFuncDefSL
  -- if tdenv = `{ (tparam `: (DEF eps `-> (ALIAS typ)))* }
  -- if CSL_callee = CSL[ .LOCAL = $emptySL_layer[ .TYP = tdenv ] ]
  -- AssignSL_params: CSL_callee `/ CSL |- paramSL* := val* : CSL_callee'
  -- if block_all = block ++ $elsblock_as_block(block_els?)
  -- Eval_block: CSL_callee' |- block_all : RET val_ret

rule CallSL_defined_func/fail:
  CSL |- definedFuncDefSL `@ `< typ* > `( val* ) : FAIL
  -- otherwise

;;; Meta-function dispatch

rulegroup CallSL_func {

    rule CallSL_func/extern:
      CSL |- (EXT id) typ* val* : valres
      -- Call_extern_func:
          |- id `< typ* > `( val* ) : valres

    rule CallSL_func/builtin:
      CSL |- builtinFuncDefSL typ* val* : valres
      -- if BUILTIN id _ _ = builtinFuncDefSL
      -- Call_builtin_func:
          |- id `@ `< typ* > `( val* ) : valres

    rule CallSL_func/table:
      CSL |- tableFuncDefSL eps val* : valres
      -- CallSL_table_func:
          CSL |- tableFuncDefSL `@ `( val* ) : valres

    rule CallSL_func/defined:
      CSL |- definedFuncDefSL typ* val* : valres
      -- CallSL_defined_func:
          CSL |- definedFuncDefSL `@ `< typ* > `( val* ) : valres

}

;; Meta-function call wrapper with cache

rule CallSL_func_cached:
  CSL |- id typ* val* : valres
  -- if funccache = $cache_find_func(id, val*)
  -- CallSL_func_dispatch:
      CSL |- id typ* val* funccache : valres

rule CallSL_func_dispatch/hit:
  CSL |- id typ* val* (OK val_cached) : OK val_cached

rule CallSL_func_dispatch/miss:
  CSL |- id typ* val* NONE : valres
  -- if (cursor, funcdefSL) = $findSL_func(CSL, id)
  -- if cp_before = $cache_checkpoint()
  -- CallSL_func: CSL |- funcdefSL typ* val* : valres
  -- if cp_after = $cache_checkpoint()
  -- if b_ext = (funcdefSL <: externFuncDefSL)
  -- if b_seff = $cache_seff(cp_before, cp_after)
  -- if b_anon = (cursor = LOCAL)
  -- if b_hoff = $exists_($is_fun(val)*)
  -- if $cache_add_func_maybe(
          b_ext \/ b_seff \/ b_anon \/ b_hoff,
          ;; true,
          id, val*, valres)
