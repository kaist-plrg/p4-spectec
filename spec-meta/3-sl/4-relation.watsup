;; Result to represent instruction sequence evaluation

syntax flow =
  | OK
  | RES val*
  | RET val
  | FAIL

syntax blockres = res<block>
syntax ctxSLres = res<ctxSL>

;; Evaluation relations

relation EvalSL_exp:
  ctxSL |- exp : res<val>
  hint(input %0 %1)

relation EvalSL_targs:
  ctxSL |- targ* : typ*
  hint(input %0 %1)

relation EvalSL_arg:
  ctxSL |- arg : res<val>
  hint(input %0 %1)

relation Eval_instr:
  ctxSL |- instr : flow
  hint(input %0 %1)

relation Eval_instrs:
  ctxSL |- instr* : flow
  hint(input %0 %1)

relation Eval_block:
  ctxSL |- block : flow
  hint(input %0 %1)

relation CallSL_func:
  ctxSL |- funcdefSL targ* val* : res<val>
  hint(input %0 %1 %2 %3)

relation CallSL_func_cached:
  ctxSL |- id targ* val* : res<val>
  hint(input %0 %1 %2 %3)

relation CallSL_rel:
  ctxSL |- reldefSL val* : res<val*>
  hint(input %0 %1 %2)

relation CallSL_rel_cached:
  ctxSL |- id val* : res<val*>
  hint(input %0 %1 %2)

relation CallSL_func_dispatch:
  ctxSL |- id typ* val* funccache : res<val>
  hint(input %0 %1 %2 %3 %4)

relation CallSL_rel_dispatch:
  ctxSL |- id val* relcache : res<val*>
  hint(input %0 %1 %2 %3)
