;; Context

syntax layerSL =
  { TYP tdenv,
    REL renvSL,
    FUNC fenvSL,
    VAL venv }

dec $emptySL_layer : layerSL
def $emptySL_layer =
  { TYP $empty_map<id, typdef>,
    REL $empty_map<id, reldefSL>,
    FUNC $empty_map<id, funcdefSL>,
    VAL $empty_map<varr, val> }

syntax ctxSL = { GLOBAL layerSL, LOCAL layerSL }

dec $emptySL_ctx : ctxSL
def $emptySL_ctx = { GLOBAL $emptySL_layer, LOCAL $emptySL_layer }

var CSL : ctxSL

;; Loading context from a script

dec $loadSL_typdef(ctxSL, id, typdef) : ctxSL
def $loadSL_typdef(CSL, id, typdef)
  = CSL[ .GLOBAL.TYP = tdenv_update ]
  -- debug ("load type " ++ id)
  -- if tdenv_update = $add_map<id, typdef>(CSL.GLOBAL.TYP, id, typdef)

dec $loadSL_reldef(ctxSL, id, reldefSL) : ctxSL
def $loadSL_reldef(CSL, id, reldefSL)
  = CSL[ .GLOBAL.REL = renvSL_update ]
  -- debug ("load rel " ++ id)
  -- if renvSL_update = $add_map<id, reldefSL>(CSL.GLOBAL.REL, id, reldefSL)

dec $loadSL_funcdef(ctxSL, id, funcdefSL) : ctxSL
def $loadSL_funcdef(CSL, id, funcdefSL)
  = CSL[ .GLOBAL.FUNC = fenvSL_update ]
  -- debug ("load func " ++ id)
  -- if fenvSL_update = $add_map<id, funcdefSL>(CSL.GLOBAL.FUNC, id, funcdefSL)

dec $loadSL(ctxSL, scriptSL) : ctxSL

def $loadSL(CSL, defnSL_h :: defnSL_t*)
  = $loadSL(CSL', defnSL_t*)
  -- if EXTTYP id = defnSL_h
  -- if CSL' = $loadSL_typdef(CSL, id, EXT)
def $loadSL(CSL, defnSL_h :: defnSL_t*)
  = $loadSL(CSL', defnSL_t*)
  -- if TYP id tparam* `= deftyp = defnSL_h
  -- if CSL' = $loadSL_typdef(CSL, id, DEF tparam* `-> deftyp)

def $loadSL(CSL, defnSL_h :: defnSL_t*)
  = $loadSL(CSL', defnSL_t*)
  -- if EXTREL id exp* `: typ_input* `-> typ_output* = defnSL_h
  -- if CSL' = $loadSL_reldef(CSL, id, EXT id)
def $loadSL(CSL, defnSL_h :: defnSL_t*)
  = $loadSL(CSL', defnSL_t*)
  -- if REL id exp* `: typ_input* `-> typ_output* `= block block_els? = defnSL_h
  -- if CSL' = $loadSL_reldef(CSL, id, DEF exp* block block_els?)

def $loadSL(CSL, defnSL_h :: defnSL_t*)
  = $loadSL(CSL', defnSL_t*)
  -- if EXTFUNC id tparam* paramSL* `: typ = defnSL_h
  -- if CSL' = $loadSL_funcdef(CSL, id, EXT id)

def $loadSL(CSL, defnSL_h :: defnSL_t*)
  = $loadSL(CSL', defnSL_t*)
  -- if BUILTINFUNC id tparam* paramSL* `: typ = defnSL_h
  -- if CSL' = $loadSL_funcdef(CSL, id, BUILTIN id tparam* paramSL*)

def $loadSL(CSL, defnSL_h :: defnSL_t*)
  = $loadSL(CSL', defnSL_t*)
  -- if TABLEFUNC id paramSL* `: typ `= tblrowSL* = defnSL_h
  -- if CSL' = $loadSL_funcdef(CSL, id, TABLE paramSL* `-> tblrowSL*)

def $loadSL(CSL, defnSL_h :: defnSL_t*)
  = $loadSL(CSL', defnSL_t*)
  -- if FUNC id tparam* paramSL* `: typ `= block block_els? = defnSL_h
  -- if CSL' = $loadSL_funcdef(CSL, id, DEF tparam* paramSL* `-> block block_els?)

def $loadSL(CSL, eps) = CSL

;; Adders

;;; Value adders

dec $addSL_vari(ctxSL, vari, val) : ctxSL
def $addSL_vari(CSL, vari, val)
  = CSL[ .LOCAL.VAL = venv_update ]
  -- if id _ iter* = vari
  -- if venv_update = $add_map<varr, val>(CSL.LOCAL.VAL, id iter*, val)

dec $addSL_varr(ctxSL, varr, val) : ctxSL
def $addSL_varr(CSL, varr, val)
  = CSL[ .LOCAL.VAL = venv_update ]
  -- if venv_update = $add_map<varr, val>(CSL.LOCAL.VAL, varr, val)

dec $addSL_varis(ctxSL, vari*, val*) : ctxSL
def $addSL_varis(CSL, vari*, val*)
  = CSL[ .LOCAL.VAL = venv_update ]
  -- if (id _ iter* = vari)*
  -- if venv_update = $adds_map<varr, val>(CSL.LOCAL.VAL, (id iter*)*, val*)

dec $addSL_varrs(ctxSL, varr*, val*) : ctxSL
def $addSL_varrs(CSL, varr*, val*)
  = CSL[ .LOCAL.VAL = venv_update ]
  -- if venv_update = $adds_map<varr, val>(CSL.LOCAL.VAL, varr*, val*)

;;; Typedef adders

dec $addSL_typ(ctxSL, id, typdef) : ctxSL

def $addSL_typ(CSL, id, typdef)
  = CSL[ .LOCAL.TYP = tdenv_update ]
  -- if tdenv_update = $add_map<id, typdef>(CSL.LOCAL.TYP, id, typdef)

;;; Function adders

dec $addSL_func(ctxSL, id, funcdefSL) : ctxSL

def $addSL_func(CSL, id, funcdefSL)
  = CSL[ .LOCAL.FUNC = fenvSL_update ]
  -- if fenvSL_update = $add_map<id, funcdefSL>(CSL.LOCAL.FUNC, id, funcdefSL)

;;; Relation adders

dec $addSL_rel(ctxSL, id, reldefSL) : ctxSL

def $addSL_rel(CSL, id, reldefSL)
  = CSL[ .LOCAL.REL = renvSL_update ]
  -- if renvSL_update = $add_map<id, reldefSL>(CSL.LOCAL.REL, id, reldefSL)

;; Finders

;;; Value finders

dec $findSL_vari(ctxSL, vari) : val?
def $findSL_vari(CSL, vari) = val
  -- if id _ iter* = vari
  -- if val = $find_map<varr, val>(CSL.LOCAL.VAL, id iter*)

dec $findSL_varr(ctxSL, varr) : val?
def $findSL_varr(CSL, varr) = $find_map<varr, val>(CSL.LOCAL.VAL, varr)

dec $findSL_varis(ctxSL, vari*) : val*?
def $findSL_varis(CSL, vari*) = val*
  -- if (val = $findSL_vari(CSL, vari))*
def $findSL_varis(CSL, vari*) = eps
  -- otherwise

dec $findSL_varrs(ctxSL, varr*) : val*?
def $findSL_varrs(CSL, varr*) = val*
  -- if (val = $find_map<varr, val>(CSL.LOCAL.VAL, varr))*
def $findSL_varrs(CSL, varr*) = eps
  -- otherwise

dec $findsSL_vari(ctxSL*, vari) : val*?
def $findsSL_vari(CSL*, vari) = val*
  -- if id _ iter* = vari
  -- if (val = $find_map<varr, val>(CSL.LOCAL.VAL, id iter*))*
def $findsSL_vari(CSL*, vari) = eps
  -- otherwise

;;; Typedef finders

dec $findSL_typ(ctxSL, id) : typdef?

def $findSL_typ(CSL, id) = typdef
  -- if typdef = $find_map<id, typdef>(CSL.LOCAL.TYP, id)
def $findSL_typ(CSL, id) = $find_map<id, typdef>(CSL.GLOBAL.TYP, id)
  -- if eps = $find_map<id, typdef>(CSL.LOCAL.TYP, id)

;;; Function finders

dec $findSL_func(ctxSL, id) : (cursor, funcdefSL)?

def $findSL_func(CSL, id) = (LOCAL, funcdefSL)
  -- if funcdefSL = $find_map<id, funcdefSL>(CSL.LOCAL.FUNC, id)
def $findSL_func(CSL, id) = (GLOBAL, funcdefSL)
  -- if eps = $find_map<id, funcdefSL>(CSL.LOCAL.FUNC, id)
  -- if funcdefSL = $find_map<id, funcdefSL>(CSL.GLOBAL.FUNC, id)
def $findSL_func(CSL, id) = eps
  -- otherwise

;;; Relation finders

dec $findSL_rel(ctxSL, id) : reldefSL?

def $findSL_rel(CSL, id) = $find_map<id, reldefSL>(CSL.GLOBAL.REL, id)

;; Sub-context construction for iteration

dec $subSL_opt(ctxSL, vari*) : ctxSL?
dec $subSL_list(ctxSL, vari*) : ctxSL*

def $subSL_opt(CSL, vari*) = $addSL_varis(CSL, vari*, val*)
  -- if (vari_iter = $iter_vari(vari, QUEST))*
  -- if (OPT val = $findSL_vari(CSL, vari_iter))*
def $subSL_opt(CSL, vari*) = eps
  -- if (vari_iter = $iter_vari(vari, QUEST))*
  -- if (OPT eps = $findSL_vari(CSL, vari_iter))*

dec $subSL_list'(ctxSL, vari*, val*) : ctxSL
def $subSL_list'(CSL, eps, eps) = CSL
def $subSL_list'(CSL, vari_h :: vari_t*, val_h :: val_t*)
  = $subSL_list'(CSL', vari_t*, val_t*)
  -- if CSL' = $addSL_vari(CSL, vari_h, val_h)

def $subSL_list(CSL, vari*) = CSL'*
  -- if (vari_iter = $iter_vari(vari, STAR))*
  -- if (LIST val* = $findSL_vari(CSL, vari_iter))*
  -- if val_trans** = $transpose_<val>(val**)
  -- if (CSL' = $subSL_list'(CSL, vari*, val_trans*))*
