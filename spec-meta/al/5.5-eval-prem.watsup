;;; Debug premises

rule Eval_prem/dbg:
  C |- DEBUG exp : OK C
  -- Eval_exp: C |- exp : OK val
  -- debug val

rule Eval_prem/fail:
  C |- prem : FAIL
  -- otherwise

;; Premise sequence evaluation rules

rulegroup Eval_prems {

  rule Eval_prems/empty:
    C |- eps : OK C

  rule Eval_prems/head-fail:
    C |- prem_h :: prem_t* : FAIL
    -- Eval_prem: C |- prem_h : FAIL

  rule Eval_prems/head-succ:
    C |- prem_h :: prem_t* : ctxres
    -- Eval_prem: C |- prem_h : OK C'
    -- Eval_prems: C' |- prem_t* : ctxres

}
