;; Premise evaluation rules

;;; Relation premises

rule Eval_prem/relpr:
  C |- REL id ':' exp* '->' exp_out* : OK C'
  -- (Eval_exp: C |- exp : OK val)*
  -- Call_rel: C |- id val* : OK val_out*
  -- Assign_exps : C |- exp_out* := val_out* : C'

;;; If premises

rulegroup Eval_prem/ifpr {

  rule Eval_prem/true:
    C |- IF exp : OK C
    -- Eval_exp: C |- exp : OK (BOOL true)

  rule Eval_prem/false:
    C |- IF exp : FAIL
    -- Eval_exp: C |- exp : OK (BOOL false)

}

;;; If-hold and if-not-hold premises

rulegroup Eval_prem/ifholdpr {

  rule Eval_prem/hold:
    C |- IFHOLD id ':' exp* : OK C
    -- (Eval_exp: C |- exp : OK val_input)*
    -- Call_rel: C |- id val_input* : OK eps

  rule Eval_prem/nothold:
    C |- IFNOTHOLD id ':' exp* : OK C
    -- (Eval_exp: C |- exp : OK val_input)*
    -- Call_rel: C |- id val_input* : FAIL

}

;;; Let premises

rule Eval_prem/letpr:
  C |- LET exp_l '=' exp_r : OK C'
  -- Eval_exp: C |- exp_r : OK val_r
  -- Assign_exp: C |- exp_l := val_r : C'

