;; Execution entry point for specifications in IL and AL

relation Eval_AL:
  |- specAL : val
  hint(input %0)
  hint(prose_in "executing the main function of specification" %0)
  hint(prose_out "value" %1)

rule Eval_AL:
  |- specAL : val
  -- debug "entry-al"
