;;
;; Elaboration results
;;

;; An elaboration either succeeds or rejects its input

syntax fail = FAIL

;;
;; Notation types
;;
;; syntax notTyp
;;

;; A notation skeleton with the type of each argument position

syntax notTyp = mixop typ*

;;
;; Elaboration context
;;
;; syntax elabCtx
;;

;; A relation keeps its notation tree, which IL relations drop

syntax relKind = EXTERN | DEFINED
syntax relSig = relKind notTyp `( inputHint `)

syntax funcKind = EXTERN | BUILTIN | TABLE | DEFINED
syntax funcSig = funcKind tparam* param* ':' typ

;; Meta-variable types, relation signatures, and function signatures

syntax menv = map<id, typ>
syntax rsigenv = map<id, relSig>
syntax fsigenv = map<id, funcSig>

;; Type definitions, meta-variables, relations, and functions declared so far

syntax elabCtx =
  { TYP tdenv,
    VAR menv,
    REL rsigenv,
    FUNC fsigenv }

var EC : elabCtx

;; The primitive types are predeclared meta-variables

dec $empty_elabCtx : elabCtx
  hint(prose_in "empty elaboration context")
def $empty_elabCtx =
  { TYP $empty_map<id, typDef>,
    VAR menv_prim,
    REL $empty_map<id, relSig>,
    FUNC $empty_map<id, funcSig> }
  -- if id_prim* = [ "bool", "nat", "int", "text" ]
  -- if typ_prim* = [ BOOL, NAT, INT, TEXT ]
  -- if menv_prim = $adds_map<id, typ>($empty_map<id, typ>, id_prim*, typ_prim*)

;;; Identifiers

;; The meta-variable of `n_x` and `n'` is `n`

builtin dec $metavar_id(id) : id
  hint(prose_in "the meta-variable name of" %0)

dec $is_tid(id) : bool
  hint(prose_in %0 "carries no suffix")
def $is_tid(id) = (id = id_meta)
  -- if id_meta = $metavar_id(id)

;;; Type definitions

dec $tparams_of_typDef(typDef) : tparam*
  hint(prose_in "the type parameters of" %0)
def $tparams_of_typDef(EXTTYP _) = eps
def $tparams_of_typDef(TYP _ tparam* '=' _) = tparam*
def $tparams_of_typDef(PARAM) = eps
def $tparams_of_typDef(DEFINING tparam*) = tparam*

dec $add_typDef(elabCtx, id, typDef) : elabCtx
  hint(prose_in %0 "with type" %1 "defined as" %2)
def $add_typDef(EC, id, typDef) = EC[ .TYP = tdenv ]
  -- if tdenv = $add_map<id, typDef>(EC.TYP, id, typDef)

;;; Meta-variables

dec $add_metavar(elabCtx, id, typ) : elabCtx
  hint(prose_in %0 "with meta-variable" %1 "of type" %2)
def $add_metavar(EC, id, typ) = EC[ .VAR = menv ]
  -- if menv = $add_map<id, typ>(EC.VAR, id, typ)

;; A type parameter is both a type and a meta-variable of that type,
;; and must not shadow either

dec $bind_tparams(elabCtx, tparam*) : elabCtx?
  hint(prose_in %0 "with type parameters" %1)
def $bind_tparams(EC, tparam*) = EC[ .TYP = tdenv ][ .VAR = menv ]
  -- if $distinct_<id>(tparam*)
  -- if (eps = $find_map<id, typDef>(EC.TYP, tparam))*
  -- if (eps = $find_map<id, typ>(EC.VAR, tparam))*
  -- if typDef* = $repeat_<typDef>(PARAM, |tparam*|)
  -- if tdenv = $adds_map<id, typDef>(EC.TYP, tparam*, typDef*)
  -- if menv = $adds_map<id, typ>(EC.VAR, tparam*, (VAR tparam eps)*)
def $bind_tparams(EC, tparam*) = eps
  -- otherwise

;;; Relations and functions

dec $add_relSig(elabCtx, id, relSig) : elabCtx
  hint(prose_in %0 "with relation" %1 "of signature" %2)
def $add_relSig(EC, id, relSig) = EC[ .REL = rsigenv ]
  -- if rsigenv = $add_map<id, relSig>(EC.REL, id, relSig)

dec $add_funcSig(elabCtx, id, funcSig) : elabCtx
  hint(prose_in %0 "with function" %1 "of signature" %2)
def $add_funcSig(EC, id, funcSig) = EC[ .FUNC = fsigenv ]
  -- if fsigenv = $add_map<id, funcSig>(EC.FUNC, id, funcSig)
