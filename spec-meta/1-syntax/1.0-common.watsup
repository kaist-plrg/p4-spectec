;; Identifiers

syntax id = text
syntax atom = text

;; Numbers

syntax num =
  | NAT nat
  | INT int

syntax numtyp =
  | NAT
  | INT

;; Iterators

syntax iter = QUEST | STAR

;; Type parameters

syntax tparam = id

;; Operators

syntax boolUnOp =
  | NOT

syntax numUnOp =
  | PLUS | MINUS

syntax unOp = boolUnOp | numUnOp

syntax boolBinOp =
  | AND | OR | IMPL | EQUIV

syntax numBinOp =
  | ADD | SUB | MUL | DIV | MOD | POW

syntax binOp = boolBinOp | numBinOp

syntax numCmpOp =
  | LT | GT | LE | GE

syntax polyCmpOp =
  | EQ | NE

syntax cmpOp = polyCmpOp | numCmpOp
