;; Identifiers

syntax id = text
syntax atom = text
syntax mixop = atom**

;; Numbers

syntax num =
  | NAT nat
  | INT int

;; Types

syntax iter, targ, typField, typCase, tparam

syntax numtyp =
  | NAT
  | INT

syntax optyp =
  | BOOL
  | numtyp
  | TEXT

syntax typ =
  | optyp
  | VAR id targ*
  | TUP typ*
  | ITER typ iter
  | FUNC tparam* typ* typ

syntax deftyp =
  | ALIAS typ
  | STRUCT typField*
  | VARIANT typCase*

syntax typField = atom typ
syntax typCase = mixop typ*

;; Iterators

syntax iter = QUEST | STAR

;; Variables

syntax vari = id typ iter*

;; Operators

syntax boolUnop =
  | NOT

syntax numUnop =
  | PLUS | MINUS

syntax unop = boolUnop | numUnop

syntax boolBinop =
  | AND | OR | IMPL | EQUIV

syntax numBinop =
  | ADD | SUB | MUL | DIV | MOD | POW

syntax binop = boolBinop | numBinop

syntax numCmpop =
  | LT | GT | LE | GE

syntax polyCmpop =
  | EQ | NE

syntax cmpop = polyCmpop | numCmpop

;; Patterns

syntax listPat =
  | CONS
  | FIXED nat
  | NIL

syntax optPat =
  | SOME
  | NONE

syntax pat =
  | INJ mixop
  | listPat
  | optPat

;; Expressions

syntax expKind, expField, expCase, path, pathKind, arg, iterExp

syntax exp = expKind '#' typ

syntax expKind =
  | BOOL bool
  | num
  | TEXT text
  | VAR id
  | UN unop exp
  | BIN binop exp exp
  | CMP cmpop exp exp
  | UPCAST typ exp
  | DOWNCAST typ exp
  | SUB exp typ
  | MATCH exp pat
  | TUP exp*
  | INJ expCase
  | STR expField*
  | OPT exp?
  | LIST exp*
  | CONS exp exp
  | CAT exp exp
  | MEM exp exp
  | LEN exp
  | DOT exp atom
  | IDX exp exp
  | SLICE exp exp exp
  | UPD exp path exp
  | CALL id targ* arg*
  | ITER exp iterExp

syntax expCase = mixop exp*
syntax expField = atom exp

syntax iterExp = iter vari*

;; Paths

syntax path = pathKind '#' typ

syntax pathKind =
  | ROOT
  | IDX path exp
  | SLICE path exp exp
  | DOT path atom

;; Arguments

syntax targ = typ

syntax arg =
  | EXP exp
  | FUN id

;; Type parameters

syntax tparam = id

;; Parameters

syntax param =
  | EXP typ
  | FUN id ':' tparam* param* '->' typ

;; Premises

syntax iterPrem

syntax prem =
  | REL id ':' exp* '->' exp*
  | IF exp
  | IFHOLD id ':' exp*
  | IFNOTHOLD id ':' exp*
  | LET exp '=' exp
  | ITER prem iterPrem
  | DEBUG exp

syntax iterPrem = iter vari* vari*

;; Type definitions

syntax externTypDefn =
  EXTTYP id

syntax definedTypDefn =
  TYP id tparam* '=' deftyp

syntax typDefn =
  | externTypDefn
  | definedTypDefn

;; Relation definitions

syntax externRelDefn =
  EXTREL id ':' typ* '->' typ*

syntax rulMatch = exp* '-' prem*
syntax rulPath = id '=' exp* '-' prem*
syntax rulGroup = id ':' rulMatch '=' rulPath*
syntax elsGroup = id ':' rulMatch '=' rulPath

syntax definedRelDefn =
  REL id ':' typ* '->' typ* '=' rulGroup* elsGroup?

syntax relDefn =
  | externRelDefn
  | definedRelDefn

;; Meta-functions

syntax externFuncDefn =
  EXTFUNC id tparam* param* ':' typ

syntax builtinFuncDefn =
  BUILTINFUNC id tparam* param* ':' typ

syntax tblRow = arg* '=' exp '-' prem*

syntax tableFuncDefn =
  TABLEFUNC id param* ':' typ '=' tblRow*

syntax clause = arg* '=' exp '-' prem*
syntax elsClause = clause

syntax definedFuncDefn =
  FUNC id tparam* param* ':' typ '=' clause* elsClause?

syntax funcDefn =
  | externFuncDefn
  | builtinFuncDefn
  | tableFuncDefn
  | definedFuncDefn

;; Definitions

syntax defn =
  | typDefn
  | relDefn
  | funcDefn

;; Spec

syntax spec = defn*
