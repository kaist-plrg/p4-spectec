;; Iteration premises

syntax iterPremAL = iter '<-' vari* '->' vari*

;; Premises

syntax premAL =
  | REL id ':' exp* '->' exp*
  | IF exp
  | IFHOLD id ':' exp*
  | IFNOTHOLD id ':' exp*
  | LET exp '=' exp
  | ITER premAL iterPremAL
  | DEBUG exp

;; Relation definitions

syntax externRelDefnAL =
  EXTREL id ':' typ* '->' typ*

syntax rulAL = id ':' exp* '->' exp* '-' premAL*
syntax rulGroupAL = id ':' rulAL*
syntax elsGroupAL = id ':' rulAL

syntax definedRelDefnAL =
  REL id ':' typ* '->' typ* '=' rulGroupAL* elsGroupAL?

syntax relDefnAL =
  | externRelDefnAL
  | definedRelDefnAL

;; Meta-functions

syntax tblRowAL = arg* '=' exp '-' premAL*

syntax tableFuncDefnAL =
  TABLEFUNC id param* ':' typ '=' tblRowAL*

syntax clauseAL = arg* '=' exp '-' premAL*
syntax elsClauseAL = clauseAL

syntax definedFuncDefnAL =
  FUNC id tparam* param* ':' typ '=' clauseAL* elsClauseAL?

syntax funcDefnAL =
  | externFuncDefn
  | builtinFuncDefn
  | tableFuncDefnAL
  | definedFuncDefnAL

;; Definitions

syntax defnAL =
  | typDefn
  | relDefnAL
  | funcDefnAL

;; Specifications

syntax specAL = defnAL*
