;; Argument evaluation rules

rule Eval_arg/exp:
  C |- EXP exp : argRes
  -- Eval_exp: C |- exp : argRes

rule Eval_arg/fun:
  C |- FUN id : OK (FUNC id_global)
  -- if id_global = $resolve_func_param(C, id)

rule Eval_arg/error:
  C |- arg : ERROR
  -- otherwise

;; Argument sequence evaluation rules

rulegroup Eval_args {

  rule Eval_args/nil:
    C |- eps : OK eps

  rule Eval_args/head-failure:
    C |- arg_h :: arg_t* : failure
    -- Eval_arg: C |- arg_h : failure

  rule Eval_args/tail-failure:
    C |- arg_h :: arg_t* : failure
    -- Eval_arg: C |- arg_h : OK val_h
    -- Eval_args: C |- arg_t* : failure

  rule Eval_args/cons-succ:
    C |- arg_h :: arg_t* : OK (val_h :: val_t*)
    -- Eval_arg: C |- arg_h : OK val_h
    -- Eval_args: C |- arg_t* : OK val_t*

}

;; Type argument evaluation rules

rule Eval_targs:
  C |- targ* : typsRes
  -- if theta = $theta_of_tdenv(C.LOCAL.TYP)
  -- if typsRes = $subst_typs(theta, targ*)

rule Eval_targs/error:
  C |- targ* : ERROR
  -- otherwise
