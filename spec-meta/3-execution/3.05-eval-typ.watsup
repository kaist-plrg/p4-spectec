;; Type substitution

syntax theta = map<id, typ>

dec $theta_of_tdenv(tdenv) : theta
  hint(prose_in "the type substitution environment of" %0)
def $theta_of_tdenv(`{ eps `}) = $empty_map<id, typ>
def $theta_of_tdenv(`{ (id_h ':' typDef_h) :: (id_t ':' typDef_t)* `})
  = $add_map<id, typ>(theta_t, id_h, typ_h)
  -- if typDef_h = TYP _ eps '=' (ALIAS typ_h)
  -- if theta_t = $theta_of_tdenv(`{ (id_t ':' typDef_t)* `})
def $theta_of_tdenv(`{ (id_h ':' typDef_h) :: (id_t ':' typDef_t)* `})
  = $theta_of_tdenv(`{ (id_t ':' typDef_t)* `})
  -- if typDef_h = PARAM
def $theta_of_tdenv(`{ (id_h ':' (EXTTYP _)) :: (id_t ':' typDef_t)* `})
  = $theta_of_tdenv(`{ (id_t ':' typDef_t)* `})
def $theta_of_tdenv(`{ (id_h ':' (TYP _ tparam* '=' (ALIAS typ))) :: (id_t ':' typDef_t)* `})
  = $theta_of_tdenv(`{ (id_t ':' typDef_t)* `})
  -- if tparam* =/= eps
def $theta_of_tdenv(`{ (id_h ':' (TYP _ tparam* '=' (STRUCT typField*))) :: (id_t ':' typDef_t)* `})
  = $theta_of_tdenv(`{ (id_t ':' typDef_t)* `})
def $theta_of_tdenv(`{ (id_h ':' (TYP _ tparam* '=' (VARIANT typCase*))) :: (id_t ':' typDef_t)* `})
  = $theta_of_tdenv(`{ (id_t ':' typDef_t)* `})

;; Fresh binders avoid every name in the type and substitution

dec $ids_typ(typ) : id*
  hint(prose_in "the type names and binders in" %0)
dec $ids_typs(typ*) : id*
  hint(prose_in "the type names and binders in" %0)
def $ids_typ(VAR id typ*) = id ++ $ids_typs(typ*)
def $ids_typ(TUP typ*) = $ids_typs(typ*)
def $ids_typ(ITER typ iter) = $ids_typ(typ)
def $ids_typ(FUNC tparam* typ* typ_ret)
  = tparam* ++ $ids_typs(typ*) ++ $ids_typ(typ_ret)
def $ids_typ(typ) = eps
  -- otherwise
def $ids_typs(eps) = eps
def $ids_typs(typ_h :: typ_t*) = $ids_typ(typ_h) ++ $ids_typs(typ_t*)

dec $fresh_id(id, id*) : id
  hint(prose_in "a fresh name based on" %0 "avoiding" %1)
def $fresh_id(id, id_used*) = id
  -- if ~(id <- id_used*)
def $fresh_id(id, id_used*) = $fresh_id(id ++ "'", id_used*)
  -- if id <- id_used*

dec $fresh_ids(id*, id*) : id*
  hint(prose_in "distinct fresh names based on" %0 "avoiding" %1)
def $fresh_ids(eps, id_used*) = eps
def $fresh_ids(id_h :: id_t*, id_used*)
  = id_fresh ++ $fresh_ids(id_t*, id_fresh ++ id_used*)
  -- if id_fresh = $fresh_id(id_h, id_used*)

syntax typRes = ok<typ> | error

dec $subst_typ(theta, typ) : typRes
  hint(prose_in "the result of substituting" %0 "into type" %1)
dec $subst_typs(theta, typ*) : typsRes
  hint(prose_in "the result of substituting" %0 "into types" %1)

def $subst_typ(theta, NAT) = OK NAT
def $subst_typ(theta, INT) = OK INT
def $subst_typ(theta, TEXT) = OK TEXT
def $subst_typ(theta, BOOL) = OK BOOL
def $subst_typ(theta, VAR id eps) = OK typ
  -- if typ = $find_map<id, typ>(theta, id)
def $subst_typ(theta, VAR id targ*) = OK (VAR id targ_subst*)
  -- if eps = $find_map<id, typ>(theta, id)
  -- if OK targ_subst* = $subst_typs(theta, targ*)
def $subst_typ(theta, TUP typ*) = OK (TUP typ_subst*)
  -- if OK typ_subst* = $subst_typs(theta, typ*)
def $subst_typ(theta, ITER typ iter) = OK (ITER typ_subst iter)
  -- if OK typ_subst = $subst_typ(theta, typ)
def $subst_typ(theta, FUNC tparam* typ* typ_ret)
  = OK (FUNC tparam_fresh* typ_subst* typ_ret_subst)
  -- if `{ (id ':' typ_arg)* `} = theta
  -- if id_used* = id* ++ $ids_typs(typ_arg*) ++ $ids_typ(FUNC tparam* typ* typ_ret)
  -- if tparam_fresh* = $fresh_ids(tparam*, id_used*)
  -- if theta_fresh = `{ (tparam ':' (VAR tparam_fresh eps))* `}
  -- if OK typ_fresh* = $subst_typs(theta_fresh, typ*)
  -- if OK typ_subst* = $subst_typs(theta, typ_fresh*)
  -- if OK typ_ret_fresh = $subst_typ(theta_fresh, typ_ret)
  -- if OK typ_ret_subst = $subst_typ(theta, typ_ret_fresh)
def $subst_typ(theta, typ) = ERROR
  -- otherwise

def $subst_typs(theta, eps) = OK eps
def $subst_typs(theta, typ_h :: typ_t*) = OK (typ_subst :: typ_t_subst*)
  -- if OK typ_subst = $subst_typ(theta, typ_h)
  -- if OK typ_t_subst* = $subst_typs(theta, typ_t*)
def $subst_typs(theta, typ*) = ERROR
  -- otherwise

;; Function signatures include higher-order parameters

dec $param_typ(param) : typ
  hint(prose_in "the type of parameter" %0)
def $param_typ(EXP typ) = typ
def $param_typ(FUN id ':' tparam* param* '->' typ)
  = FUNC tparam* $param_typ(param)* typ

dec $func_typ(funcDefn) : typ
  hint(prose_in "the signature of function" %0)
def $func_typ(EXTFUNC id tparam* param* ':' typ)
  = FUNC tparam* $param_typ(param)* typ
def $func_typ(BUILTINFUNC id tparam* param* ':' typ)
  = FUNC tparam* $param_typ(param)* typ
def $func_typ(TABLEFUNC _ param* ':' typ '=' tblRow*)
  = FUNC eps $param_typ(param)* typ
def $func_typ(FUNC _ tparam* param* ':' typ '=' clause* elsClause?)
  = FUNC tparam* $param_typ(param)* typ

;; Type equivalence expands aliases before structural comparison

syntax equivRes = ok<bool> | error

dec $expand_typ(tdenv, typ) : typRes
  hint(prose_in "the result of expanding outer type aliases of" %1
                "under type environment" %0)
def $expand_typ(tdenv, VAR id targ*) = $expand_typ(tdenv, typ_subst)
  -- if TYP _ tparam* '=' (ALIAS typ) = $find_map<id, typDef>(tdenv, id)
  -- if |tparam*| = |targ*|
  -- if theta = `{ (tparam ':' targ)* `}
  -- if OK typ_subst = $subst_typ(theta, typ)
def $expand_typ(tdenv, VAR id targ*) = OK (VAR id targ*)
  -- if typDef = $find_map<id, typDef>(tdenv, id)
  -- if typDef = PARAM
  -- if targ* = eps
def $expand_typ(tdenv, VAR id eps) = OK (VAR id eps)
  -- if EXTTYP _ = $find_map<id, typDef>(tdenv, id)
def $expand_typ(tdenv, VAR id targ*) = OK (VAR id targ*)
  -- if TYP _ tparam* '=' (STRUCT typField*) = $find_map<id, typDef>(tdenv, id)
  -- if |tparam*| = |targ*|
def $expand_typ(tdenv, VAR id targ*) = OK (VAR id targ*)
  -- if TYP _ tparam* '=' (VARIANT typCase*) = $find_map<id, typDef>(tdenv, id)
  -- if |tparam*| = |targ*|
def $expand_typ(tdenv, BOOL) = OK BOOL
def $expand_typ(tdenv, NAT) = OK NAT
def $expand_typ(tdenv, INT) = OK INT
def $expand_typ(tdenv, TEXT) = OK TEXT
def $expand_typ(tdenv, TUP typ*) = OK (TUP typ*)
def $expand_typ(tdenv, ITER typ iter) = OK (ITER typ iter)
def $expand_typ(tdenv, FUNC tparam* typ* typ_ret) = OK (FUNC tparam* typ* typ_ret)
def $expand_typ(tdenv, typ) = ERROR
  -- otherwise

dec $equiv_typ(tdenv, typ, typ) : equivRes
  hint(prose_in "the result of checking equivalence of" %1 "and" %2
                "under type environment" %0)
dec $equiv_typs(tdenv, typ*, typ*) : equivRes
  hint(prose_in "the result of checking pairwise equivalence of" %1 "and" %2
                "under type environment" %0)
dec $equiv_typ'(tdenv, typ, typ) : equivRes
  hint(prose_in "the result of comparing expanded types" %1 "and" %2
                "under type environment" %0)
def $equiv_typ(tdenv, typ_l, typ_r) = $equiv_typ'(tdenv, typ_l_expand, typ_r_expand)
  -- if OK typ_l_expand = $expand_typ(tdenv, typ_l)
  -- if OK typ_r_expand = $expand_typ(tdenv, typ_r)
def $equiv_typ(tdenv, typ_l, typ_r) = ERROR
  -- otherwise

def $equiv_typs(tdenv, eps, eps) = OK true
def $equiv_typs(tdenv, typ_l :: typ_l_t*, typ_r :: typ_r_t*)
  = $equiv_typs(tdenv, typ_l_t*, typ_r_t*)
  -- if OK true = $equiv_typ(tdenv, typ_l, typ_r)
def $equiv_typs(tdenv, typ_l :: typ_l_t*, typ_r :: typ_r_t*) = equivRes
  -- if equivRes = $equiv_typ(tdenv, typ_l, typ_r)
  -- if equivRes =/= OK true
def $equiv_typs(tdenv, eps, typ_r :: typ_r_t*) = OK false
def $equiv_typs(tdenv, typ_l :: typ_l_t*, eps) = OK false

def $equiv_typ'(tdenv, BOOL, BOOL) = OK true
def $equiv_typ'(tdenv, NAT, NAT) = OK true
def $equiv_typ'(tdenv, INT, INT) = OK true
def $equiv_typ'(tdenv, TEXT, TEXT) = OK true
def $equiv_typ'(tdenv, VAR id_l targ_l*, VAR id_r targ_r*)
  = $equiv_typs(tdenv, targ_l*, targ_r*)
  -- if id_l = id_r
def $equiv_typ'(tdenv, TUP typ_l*, TUP typ_r*) = $equiv_typs(tdenv, typ_l*, typ_r*)
def $equiv_typ'(tdenv, ITER typ_l iter_l, ITER typ_r iter_r) = $equiv_typ(tdenv, typ_l, typ_r)
  -- if iter_l = iter_r
;; Native structural equivalence excludes nested function types
;; Only function-value membership invokes signature alpha-equivalence

def $equiv_typ'(tdenv, typ_l, typ_r) = OK false
  -- otherwise

dec $equiv_func_typ(tdenv, typ, typ) : equivRes
  hint(prose_in "the result of checking alpha-equivalence of function types" %1
                "and" %2 "under type environment" %0)
def $equiv_func_typ(tdenv, FUNC tparam_l* typ_l* typ_ret_l, FUNC tparam_r* typ_r* typ_ret_r)
  = $equiv_typs(tdenv_fresh, typ_l_subst* ++ [ typ_ret_l_subst ], typ_r_subst* ++ [ typ_ret_r_subst ])
  -- if |tparam_l*| = |tparam_r*|
  -- if |typ_l*| = |typ_r*|
  -- if `{ (id ':' typDef)* `} = tdenv
  -- if id_used* = id*
    ++ $ids_typ(FUNC tparam_l* typ_l* typ_ret_l)
    ++ $ids_typ(FUNC tparam_r* typ_r* typ_ret_r)
  -- if tparam_fresh* = $fresh_ids(tparam_l*, id_used*)
  -- if theta_l = `{ (tparam_l ':' (VAR tparam_fresh eps))* `}
  -- if theta_r = `{ (tparam_r ':' (VAR tparam_fresh eps))* `}
  -- if OK typ_l_subst* = $subst_typs(theta_l, typ_l*)
  -- if OK typ_r_subst* = $subst_typs(theta_r, typ_r*)
  -- if OK typ_ret_l_subst = $subst_typ(theta_l, typ_ret_l)
  -- if OK typ_ret_r_subst = $subst_typ(theta_r, typ_ret_r)
  -- if tdenv_fresh = $adds_map<id, typDef>(tdenv, tparam_fresh*, $repeat_<typDef>(PARAM, |tparam_fresh*|))
def $equiv_func_typ(tdenv, FUNC tparam_l* typ_l* typ_ret_l, FUNC tparam_r* typ_r* typ_ret_r) = OK false
  -- if |tparam_l*| =/= |tparam_r*| \/ |typ_l*| =/= |typ_r*|
def $equiv_func_typ(tdenv, typ_l, typ_r) = ERROR
  -- otherwise

;;; Value-type matching

syntax subtypRes = ok<bool> | error

dec $subtyp(fenv, tdenv, typ, val) : subtypRes
  hint(prose_in "the result of checking value" %3 "against type" %2
                "under function environment" %0 "and type environment" %1)
dec $subtyps(fenv, tdenv, typ*, val*) : subtypRes
  hint(prose_in "the result of checking values" %3 "against types" %2
                "under function environment" %0 "and type environment" %1)
dec $subtyp_list(fenv, tdenv, typ, val*) : subtypRes
  hint(prose_in "the result of checking each value in" %3 "against type" %2
                "under function environment" %0 "and type environment" %1)
dec $subtyp_var(fenv, tdenv, id, typ*, val) : subtypRes
  hint(prose_in "the result of checking value" %4 "against type name" %2
                "with arguments" %3 "under function environment" %0
                "and type environment" %1)
dec $subtyp_def(fenv, tdenv, typDef, typ*, val) : subtypRes
  hint(prose_in "the result of checking value" %4 "against type definition" %2
                "with arguments" %3 "under function environment" %0
                "and type environment" %1)
dec $subtyp_extern(val) : subtypRes
  hint(prose_in "the result of checking whether" %0 "is an extern value")
dec $subtyp_variant(fenv, tdenv, theta, typCase*, val) : subtypRes
  hint(prose_in "the result of checking value" %4 "against variant cases" %3
                "with substitution" %2 "under function environment" %0
                "and type environment" %1)
dec $subtyp_struct(fenv, tdenv, theta, typField*, val) : subtypRes
  hint(prose_in "the result of checking value" %4 "against struct fields" %3
                "with substitution" %2 "under function environment" %0
                "and type environment" %1)
dec $subtyp_case(fenv, tdenv, theta, typ*, val*) : subtypRes
  hint(prose_in "the result of checking values" %4 "against types" %3
                "with substitution" %2 "under function environment" %0
                "and type environment" %1)
dec $subtyp_func(fenv, tdenv, typ, id) : subtypRes
  hint(prose_in "the result of checking function" %3 "against type" %2
                "under function environment" %0 "and type environment" %1)

def $subtyp(fenv, tdenv, BOOL, BOOL b) = OK true
def $subtyp(fenv, tdenv, NAT, NAT n) = OK true
def $subtyp(fenv, tdenv, NAT, INT i) = OK $(i >= 0)
def $subtyp(fenv, tdenv, INT, num) = OK true
def $subtyp(fenv, tdenv, TEXT, TEXT t) = OK true
def $subtyp(fenv, tdenv, VAR id targ*, val) = $subtyp_var(fenv, tdenv, id, targ*, val)
def $subtyp(fenv, tdenv, TUP typ*, TUP val*) = $subtyps(fenv, tdenv, typ*, val*)
def $subtyp(fenv, tdenv, ITER typ QUEST, OPT val) = $subtyp(fenv, tdenv, typ, val)
def $subtyp(fenv, tdenv, ITER typ QUEST, OPT eps) = OK true
def $subtyp(fenv, tdenv, ITER typ STAR, LIST val*) = $subtyp_list(fenv, tdenv, typ, val*)
def $subtyp(fenv, tdenv, FUNC tparam* typ* typ_ret, FUNC id)
  = $subtyp_func(fenv, tdenv, FUNC tparam* typ* typ_ret, id)
def $subtyp(fenv, tdenv, typ, val) = OK false
  -- otherwise

def $subtyp_var(fenv, tdenv, id, targ*, val) = $subtyp_def(fenv, tdenv, typDef, targ*, val)
  -- if typDef = $find_map<id, typDef>(tdenv, id)
def $subtyp_var(fenv, tdenv, id, targ*, val) = ERROR
  -- otherwise

def $subtyp_extern(EXT json) = OK true
def $subtyp_extern(val) = OK false
  -- otherwise

def $subtyp_def(fenv, tdenv, EXTTYP _, eps, val) = $subtyp_extern(val)

def $subtyp_def(fenv, tdenv, TYP _ tparam* '=' (ALIAS typ), targ*, val)
  = $subtyp(fenv, tdenv, typ_subst, val)
  -- if |tparam*| = |targ*|
  -- if theta = `{ (tparam ':' targ)* `}
  -- if OK typ_subst = $subst_typ(theta, typ)
def $subtyp_def(fenv, tdenv, TYP _ tparam* '=' (VARIANT typCase*), targ*, val)
  = $subtyp_variant(fenv, tdenv, theta, typCase*, val)
  -- if |tparam*| = |targ*|
  -- if theta = `{ (tparam ':' targ)* `}
def $subtyp_def(fenv, tdenv, TYP _ tparam* '=' (STRUCT typField*), targ*, val)
  = $subtyp_struct(fenv, tdenv, theta, typField*, val)
  -- if |tparam*| = |targ*|
  -- if theta = `{ (tparam ':' targ)* `}
def $subtyp_def(fenv, tdenv, typDef, targ*, val) = ERROR
  -- otherwise

def $subtyp_variant(fenv, tdenv, theta, typCase*, INJ (mixop val*))
  = $subtyp_case(fenv, tdenv, theta, typ_case_found*, val*)
  -- if (mixop_case typ_case* = typCase)*
  -- if typ_case_found* = $assoc_<mixop, typ*>(mixop, (mixop_case, typ_case*)*)
def $subtyp_variant(fenv, tdenv, theta, typCase*, val) = OK false
  -- otherwise

def $subtyp_struct(fenv, tdenv, theta, typField*, STR valField*)
  = $subtyp_case(fenv, tdenv, theta, typ_field*, val_field*)
  -- if (atom typ_field = typField)*
  -- if (atom val_field = valField)*
def $subtyp_struct(fenv, tdenv, theta, typField*, val) = OK false
  -- otherwise

def $subtyp_case(fenv, tdenv, theta, typ*, val*) = $subtyps(fenv, tdenv, typ_subst*, val*)
  -- if OK typ_subst* = $subst_typs(theta, typ*)
def $subtyp_case(fenv, tdenv, theta, typ*, val*) = ERROR
  -- otherwise

def $subtyp_func(fenv, tdenv, typ, id) = $equiv_func_typ(tdenv, typ, $func_typ(funcDefn))
  -- if funcDefn = $find_map<id, funcDefn>(fenv, id)
def $subtyp_func(fenv, tdenv, typ, id) = ERROR
  -- otherwise

def $subtyps(fenv, tdenv, eps, eps) = OK true
def $subtyps(fenv, tdenv, typ_h :: typ_t*, val_h :: val_t*) = $subtyps(fenv, tdenv, typ_t*, val_t*)
  -- if OK true = $subtyp(fenv, tdenv, typ_h, val_h)
def $subtyps(fenv, tdenv, typ_h :: typ_t*, val_h :: val_t*) = subtypRes
  -- if subtypRes = $subtyp(fenv, tdenv, typ_h, val_h)
  -- if subtypRes =/= OK true
def $subtyps(fenv, tdenv, eps, val_h :: val_t*) = OK false
def $subtyps(fenv, tdenv, typ_h :: typ_t*, eps) = OK false

def $subtyp_list(fenv, tdenv, typ, eps) = OK true
def $subtyp_list(fenv, tdenv, typ, val_h :: val_t*) = $subtyp_list(fenv, tdenv, typ, val_t*)
  -- if OK true = $subtyp(fenv, tdenv, typ, val_h)
def $subtyp_list(fenv, tdenv, typ, val_h :: val_t*) = subtypRes
  -- if subtypRes = $subtyp(fenv, tdenv, typ, val_h)
  -- if subtypRes =/= OK true

;; Type casts

syntax castRes = ok<val> | error
syntax castsRes = ok<val*> | error

;;; Upcasts

dec $upcast(ctx, typ, val) : castRes
  hint(prose_in "the result of upcasting" %2 "to" %1 "under context" %0)
dec $upcasts(ctx, typ*, val*) : castsRes
  hint(prose_in "the result of upcasting values" %2 "to types" %1 "under context" %0)

def $upcast(C, INT, INT i) = OK (INT i)
def $upcast(C, INT, NAT n) = OK (INT n)
def $upcast(C, VAR id targ*, val) = $upcast(C, typ_subst, val)
  -- if TYP _ tparam* '=' (ALIAS typ) = $find_typ(C, id)
  -- if |tparam*| = |targ*|
  -- if theta = `{ (tparam ':' targ)* `}
  -- if OK typ_subst = $subst_typ(theta, typ)
def $upcast(C, VAR id targ*, val) = OK val
  -- if TYP _ tparam* '=' (VARIANT typCase*) = $find_typ(C, id)
  -- if `{ (id_local ':' typDef_local)* `} = C.LOCAL.TYP
  -- if tdenv = $adds_map<id, typDef>(C.GLOBAL.TYP, id_local*, typDef_local*)
  -- if OK true = $subtyp(C.GLOBAL.FUNC, tdenv, VAR id targ*, val)
def $upcast(C, VAR id targ*, val) = OK val
  -- if TYP _ tparam* '=' (STRUCT typField*) = $find_typ(C, id)
  -- if `{ (id_local ':' typDef_local)* `} = C.LOCAL.TYP
  -- if tdenv = $adds_map<id, typDef>(C.GLOBAL.TYP, id_local*, typDef_local*)
  -- if OK true = $subtyp(C.GLOBAL.FUNC, tdenv, VAR id targ*, val)
def $upcast(C, VAR id eps, EXT json) = OK (EXT json)
  -- if EXTTYP _ = $find_typ(C, id)
def $upcast(C, TUP typ*, TUP val*) = OK (TUP val_cast*)
  -- if OK val_cast* = $upcasts(C, typ*, val*)
def $upcast(C, ITER typ QUEST, OPT eps) = OK (OPT eps)
def $upcast(C, ITER typ QUEST, OPT val) = OK (OPT val_cast)
  -- if OK val_cast = $upcast(C, typ, val)
def $upcast(C, ITER typ STAR, LIST val*) = OK (LIST val_cast*)
  -- if OK val_cast* = $upcasts(C, $repeat_<typ>(typ, |val*|), val*)
def $upcast(C, BOOL, BOOL b) = OK (BOOL b)
def $upcast(C, TEXT, TEXT t) = OK (TEXT t)
def $upcast(C, NAT, NAT n) = OK (NAT n)
def $upcast(C, FUNC tparam* typ* typ_ret, FUNC id) = OK (FUNC id)
  -- if `{ (id_local ':' typDef_local)* `} = C.LOCAL.TYP
  -- if tdenv = $adds_map<id, typDef>(C.GLOBAL.TYP, id_local*, typDef_local*)
  -- if OK true = $subtyp(C.GLOBAL.FUNC, tdenv, FUNC tparam* typ* typ_ret, FUNC id)
def $upcast(C, typ, val) = ERROR
  -- otherwise

def $upcasts(C, eps, eps) = OK eps
def $upcasts(C, typ_h :: typ_t*, val_h :: val_t*) = OK (val_cast :: val_t_cast*)
  -- if OK val_cast = $upcast(C, typ_h, val_h)
  -- if OK val_t_cast* = $upcasts(C, typ_t*, val_t*)
def $upcasts(C, typ*, val*) = ERROR
  -- otherwise

;;; Downcasts

dec $downcast(ctx, typ, val) : castRes
  hint(prose_in "the result of downcasting" %2 "to" %1 "under context" %0)
dec $downcasts(ctx, typ*, val*) : castsRes
  hint(prose_in "the result of downcasting values" %2 "to types" %1 "under context" %0)

def $downcast(C, NAT, NAT n) = OK (NAT n)
def $downcast(C, NAT, INT i) = OK (NAT n)
  -- if n = i
def $downcast(C, VAR id targ*, val) = $downcast(C, typ_subst, val)
  -- if TYP _ tparam* '=' (ALIAS typ) = $find_typ(C, id)
  -- if |tparam*| = |targ*|
  -- if theta = `{ (tparam ':' targ)* `}
  -- if OK typ_subst = $subst_typ(theta, typ)
def $downcast(C, VAR id targ*, val) = OK val
  -- if TYP _ tparam* '=' (VARIANT typCase*) = $find_typ(C, id)
  -- if `{ (id_local ':' typDef_local)* `} = C.LOCAL.TYP
  -- if tdenv = $adds_map<id, typDef>(C.GLOBAL.TYP, id_local*, typDef_local*)
  -- if OK true = $subtyp(C.GLOBAL.FUNC, tdenv, VAR id targ*, val)
def $downcast(C, VAR id targ*, val) = OK val
  -- if TYP _ tparam* '=' (STRUCT typField*) = $find_typ(C, id)
  -- if `{ (id_local ':' typDef_local)* `} = C.LOCAL.TYP
  -- if tdenv = $adds_map<id, typDef>(C.GLOBAL.TYP, id_local*, typDef_local*)
  -- if OK true = $subtyp(C.GLOBAL.FUNC, tdenv, VAR id targ*, val)
def $downcast(C, VAR id eps, EXT json) = OK (EXT json)
  -- if EXTTYP _ = $find_typ(C, id)
def $downcast(C, TUP typ*, TUP val*) = OK (TUP val_cast*)
  -- if OK val_cast* = $downcasts(C, typ*, val*)
def $downcast(C, ITER typ QUEST, OPT eps) = OK (OPT eps)
def $downcast(C, ITER typ QUEST, OPT val) = OK (OPT val_cast)
  -- if OK val_cast = $downcast(C, typ, val)
def $downcast(C, ITER typ STAR, LIST val*) = OK (LIST val_cast*)
  -- if OK val_cast* = $downcasts(C, $repeat_<typ>(typ, |val*|), val*)
def $downcast(C, BOOL, BOOL b) = OK (BOOL b)
def $downcast(C, TEXT, TEXT t) = OK (TEXT t)
def $downcast(C, INT, num) = OK num
def $downcast(C, FUNC tparam* typ* typ_ret, FUNC id) = OK (FUNC id)
  -- if `{ (id_local ':' typDef_local)* `} = C.LOCAL.TYP
  -- if tdenv = $adds_map<id, typDef>(C.GLOBAL.TYP, id_local*, typDef_local*)
  -- if OK true = $subtyp(C.GLOBAL.FUNC, tdenv, FUNC tparam* typ* typ_ret, FUNC id)
def $downcast(C, typ, val) = ERROR
  -- otherwise

def $downcasts(C, eps, eps) = OK eps
def $downcasts(C, typ_h :: typ_t*, val_h :: val_t*) = OK (val_cast :: val_t_cast*)
  -- if OK val_cast = $downcast(C, typ_h, val_h)
  -- if OK val_t_cast* = $downcasts(C, typ_t*, val_t*)
def $downcasts(C, typ*, val*) = ERROR
  -- otherwise
