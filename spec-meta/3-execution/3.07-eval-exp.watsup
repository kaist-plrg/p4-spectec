;; Expression evaluation rules

;;; Boolean, number, and text evaluation rules

rulegroup Eval_exp/literal {

  rule Eval_exp/boolean:
    C |- BOOL b : OK (BOOL b)

  rule Eval_exp/number:
    C |- num : OK num

  rule Eval_exp/string:
    C |- TEXT t : OK (TEXT t)

}

;;; Variable evaluation rules

rule Eval_exp/variable:
  C |- VAR id : OK val
  -- if val = $find_varr(C, id eps)

;;; Unary, binary, and comparison evaluation rules

rulegroup Eval_exp/unary {

  rule Eval_exp/boolean-operand-failure:
    C |- UN NOT exp : failure
    -- Eval_exp: C |- exp : failure

  rule Eval_exp/boolean-succ:
    C |- UN NOT exp : OK (BOOL b_res)
    -- Eval_exp: C |- exp : OK (BOOL b)
    -- if b_res = ~b

  rule Eval_exp/number-operand-failure:
    C |- UN numUnop exp : failure
    -- Eval_exp: C |- exp : failure

  rule Eval_exp/number-succ:
    C |- UN numUnop exp : OK val_res
    -- Eval_exp: C |- exp : OK num
    -- if val_res = $numUnop(numUnop, num)

}

rulegroup Eval_exp/binary {

  rule Eval_exp/boolean-left-failure:
    C |- BIN boolBinop exp_l exp_r : failure
    -- Eval_exp: C |- exp_l : failure

  rule Eval_exp/boolean-right-failure:
    C |- BIN boolBinop exp_l exp_r : failure
    -- Eval_exp: C |- exp_l : OK (BOOL b_l)
    -- Eval_exp: C |- exp_r : failure

  rule Eval_exp/boolean-succ:
    C |- BIN boolBinop exp_l exp_r : OK (BOOL b_res)
    -- Eval_exp: C |- exp_l : OK (BOOL b_l)
    -- Eval_exp: C |- exp_r : OK (BOOL b_r)
    -- if b_res = $boolBinop(boolBinop, b_l, b_r)

  rule Eval_exp/number-left-failure:
    C |- BIN numBinop exp_l exp_r : failure
    -- Eval_exp: C |- exp_l : failure

  rule Eval_exp/number-right-failure:
    C |- BIN numBinop exp_l exp_r : failure
    -- Eval_exp: C |- exp_l : OK num_l
    -- Eval_exp: C |- exp_r : failure

  rule Eval_exp/number-succ:
    C |- BIN numBinop exp_l exp_r : numBinopRes
    -- Eval_exp: C |- exp_l : OK num_l
    -- Eval_exp: C |- exp_r : OK num_r
    -- if numBinopRes = $numBinop(numBinop, num_l, num_r)

}

rulegroup Eval_exp/compare {

  rule Eval_exp/poly-left-failure:
    C |- CMP polyCmpop exp_l exp_r : failure
    -- Eval_exp: C |- exp_l : failure

  rule Eval_exp/poly-right-failure:
    C |- CMP polyCmpop exp_l exp_r : failure
    -- Eval_exp: C |- exp_l : OK val_l
    -- Eval_exp: C |- exp_r : failure

  rule Eval_exp/poly-succ:
    C |- CMP polyCmpop exp_l exp_r : OK (BOOL b_res)
    -- Eval_exp: C |- exp_l : OK val_l
    -- Eval_exp: C |- exp_r : OK val_r
    -- if b_res = $polyCmpop(polyCmpop, val_l, val_r)

  rule Eval_exp/number-left-failure:
    C |- CMP numCmpop exp_l exp_r : failure
    -- Eval_exp: C |- exp_l : failure

  rule Eval_exp/number-right-failure:
    C |- CMP numCmpop exp_l exp_r : failure
    -- Eval_exp: C |- exp_l : OK num_l
    -- Eval_exp: C |- exp_r : failure

  rule Eval_exp/number-succ:
    C |- CMP numCmpop exp_l exp_r : OK (BOOL b_res)
    -- Eval_exp: C |- exp_l : OK num_l
    -- Eval_exp: C |- exp_r : OK num_r
    -- if OK b_res = $numCmpop(numCmpop, num_l, num_r)

}

;;; Upcasting, downcasting, and subtyping evaluation rules

rulegroup Eval_exp/upcast {

  rule Eval_exp/operand-failure:
    C |- UPCAST typ exp : failure
    -- Eval_exp: C |- exp : failure

  rule Eval_exp/succ:
    C |- UPCAST typ exp : castRes
    -- Eval_exp: C |- exp : OK val
    -- if castRes = $upcast(C, typ, val)

}

rulegroup Eval_exp/downcast {

  rule Eval_exp/operand-failure:
    C |- DOWNCAST typ exp : failure
    -- Eval_exp: C |- exp : failure

  rule Eval_exp/succ:
    C |- DOWNCAST typ exp : castRes
    -- Eval_exp: C |- exp : OK val
    -- if castRes = $downcast(C, typ, val)

}

rulegroup Eval_exp/subtype {

  rule Eval_exp/operand-failure:
    C |- SUB exp typ : failure
    -- Eval_exp: C |- exp : failure

  rule Eval_exp/succ:
    C |- SUB exp typ : OK (BOOL b)
    -- Eval_exp: C |- exp : OK val
    -- if `{ (id_local ':' typDef_local)* `} = C.LOCAL.TYP
    -- if tdenv = $adds_map<id, typDef>(C.GLOBAL.TYP, id_local*, typDef_local*)
    -- if OK b = $subtyp(C.GLOBAL.FUNC, tdenv, typ, val)

}

;;; Match evaluation rules

rulegroup Eval_exp/match {

  rule Eval_exp/operand-failure:
    C |- MATCH exp pat : failure
    -- Eval_exp: C |- exp : failure

  rule Eval_exp/succ:
    C |- MATCH exp pat : OK (BOOL b_matches)
    -- Eval_exp: C |- exp : OK val
    -- if b_matches = $matches(val, pat)

}

;;; Tuple evaluation rules

rulegroup Eval_exp/tuple {

  rule Eval_exp/expressions-failure:
    C |- TUP exp* : failure
    -- Eval_exps: C |- exp* : failure

  rule Eval_exp/succ:
    C |- TUP exp* : OK (TUP val*)
    -- Eval_exps: C |- exp* : OK val*

}

;;; Case evaluation rules

rulegroup Eval_exp/case {

  rule Eval_exp/expressions-failure:
    C |- INJ (mixop exp*) : failure
    -- Eval_exps: C |- exp* : failure

  rule Eval_exp/succ:
    C |- INJ (mixop exp*) : OK (INJ (mixop val*))
    -- Eval_exps: C |- exp* : OK val*

}

;;; Struct evaluation rules

rulegroup Eval_exp/struct {

  rule Eval_exp/expressions-failure:
    C |- STR expField* : failure
    -- (if atom exp = expField)*
    -- Eval_exps: C |- exp* : failure

  rule Eval_exp/succ:
    C |- STR expField* : OK (STR valField*)
    -- (if atom exp = expField)*
    -- Eval_exps: C |- exp* : OK val*
    -- (if valField = atom val)*

}

;;; Option evaluation rules

rulegroup Eval_exp/opt {

  rule Eval_exp/succ-none:
    C |- OPT eps : OK (OPT eps)

  rule Eval_exp/operand-failure:
    C |- OPT exp : failure
    -- Eval_exp : C |- exp : failure

  rule Eval_exp/succ-some:
    C |- OPT exp : OK (OPT val)
    -- Eval_exp : C |- exp : OK val

}

;;; List evaluation rules

rulegroup Eval_exp/list {

  rule Eval_exp/expressions-failure:
    C |- LIST exp* : failure
    -- Eval_exps: C |- exp* : failure

  rule Eval_exp/succ:
    C |- LIST exp* : OK (LIST val*)
    -- Eval_exps: C |- exp* : OK val*

}

;;; Cons-list evaluation rules

rulegroup Eval_exp/cons {

  rule Eval_exp/head-failure:
    C |- CONS exp_h exp_t : failure
    -- Eval_exp: C |- exp_h : failure

  rule Eval_exp/tail-failure:
    C |- CONS exp_h exp_t : failure
    -- Eval_exp: C |- exp_h : OK val_h
    -- Eval_exp: C |- exp_t : failure

  rule Eval_exp/succ:
    C |- CONS exp_h exp_t : OK (LIST (val_h :: val_t*))
    -- Eval_exp: C |- exp_h : OK val_h
    -- Eval_exp: C |- exp_t : OK (LIST val_t*)

}

;;; Concatentation evaluation rules

rulegroup Eval_exp/concat {

  rule Eval_exp/left-failure:
    C |- CAT exp_l exp_r : failure
    -- Eval_exp: C |- exp_l : failure

  rule Eval_exp/list-right-failure:
    C |- CAT exp_l exp_r : failure
    -- Eval_exp: C |- exp_l : OK (LIST val_l*)
    -- Eval_exp: C |- exp_r : failure

  rule Eval_exp/list-succ:
    C |- CAT exp_l exp_r : OK (LIST val_res*)
    -- Eval_exp: C |- exp_l : OK (LIST val_l*)
    -- Eval_exp: C |- exp_r : OK (LIST val_r*)
    -- if val_res* = val_l* ++ val_r*

  rule Eval_exp/text-right-failure:
    C |- CAT exp_l exp_r : failure
    -- Eval_exp: C |- exp_l : OK (TEXT text_l)
    -- Eval_exp: C |- exp_r : failure

  rule Eval_exp/text-succ:
    C |- CAT exp_l exp_r : OK (TEXT t_res)
    -- Eval_exp: C |- exp_l : OK (TEXT t_l)
    -- Eval_exp: C |- exp_r : OK (TEXT t_r)
    -- if t_res = t_l ++ t_r

}

;;; Membership evaluation rules

rulegroup Eval_exp/mem {

  rule Eval_exp/elem-failure:
    C |- MEM exp_e exp_s : failure
    -- Eval_exp: C |- exp_e : failure

  rule Eval_exp/list-failure:
    C |- MEM exp_e exp_s : failure
    -- Eval_exp: C |- exp_e : OK val_e
    -- Eval_exp: C |- exp_s : failure

  rule Eval_exp/succ:
    C |- MEM exp_e exp_s : OK (BOOL b_mem)
    -- Eval_exp: C |- exp_e : OK val_e
    -- Eval_exp: C |- exp_s : OK (LIST val*)
    -- if b_mem = $exists_((val_e = val)*)

}

;;; Length evaluation rules

rulegroup Eval_exp/len {

  rule Eval_exp/operand-failure:
    C |- LEN exp : failure
    -- Eval_exp: C |- exp : failure

  rule Eval_exp/text:
    C |- LEN exp : OK (NAT n)
    -- Eval_exp: C |- exp : OK (TEXT t)
    -- if n = |t|

  rule Eval_exp/list:
    C |- LEN exp : OK (NAT n)
    -- Eval_exp: C |- exp : OK (LIST val*)
    -- if n = |val*|

}

;;; Dot, indexing, and slicing evaluation rules

rulegroup Eval_exp/dot {

  rule Eval_exp/operand-failure:
    C |- DOT exp atom : failure
    -- Eval_exp: C |- exp : failure

  rule Eval_exp/succ:
    C |- DOT exp atom : pathRes
    -- Eval_exp: C |- exp : OK val
    -- if path = DOT ROOT atom
    -- Eval_path_acc: C |- val path : pathRes

}

rulegroup Eval_exp/idx {

  rule Eval_exp/base-failure:
    C |- IDX exp_b exp_i : failure
    -- Eval_exp: C |- exp_b : failure

  rule Eval_exp/succ:
    C |- IDX exp_b exp_i : pathRes
    -- Eval_exp: C |- exp_b : OK val_b
    -- if path = IDX ROOT exp_i
    -- Eval_path_acc: C |- val_b path : pathRes

}

rulegroup Eval_exp/slice {

  rule Eval_exp/base-failure:
    C |- SLICE exp_b exp_i exp_n : failure
    -- Eval_exp: C |- exp_b : failure

  rule Eval_exp/succ:
    C |- SLICE exp_b exp_i exp_n : pathRes
    -- Eval_exp: C |- exp_b : OK val_b
    -- if path = SLICE ROOT exp_i exp_n
    -- Eval_path_acc: C |- val_b path : pathRes

}

rulegroup Eval_exp/upd {

  rule Eval_exp/base-failure:
    C |- UPD exp_b path exp_f : failure
    -- Eval_exp: C |- exp_b : failure

  rule Eval_exp/value-failure:
    C |- UPD exp_b path exp_f : failure
    -- Eval_exp: C |- exp_b : OK val_b
    -- Eval_exp: C |- exp_f : failure

  rule Eval_exp/succ:
    C |- UPD exp_b path exp_f : pathRes
    -- Eval_exp: C |- exp_b : OK val_b
    -- Eval_exp: C |- exp_f : OK val_f
    -- Eval_path_upd: C |- val_b path := val_f : pathRes

}

;;; Meta-function call evaluation rules

rulegroup Eval_exp/call {

  rule Eval_exp/arguments-failure:
    C |- CALL id targ* arg* : failure
    -- Eval_targs: C |- targ* : OK typ_input*
    -- Eval_args: C |- arg* : failure

  rule Eval_exp/succ:
    C |- CALL id targ* arg* : funcRes
    -- Eval_targs: C |- targ* : OK typ_input*
    -- Eval_args: C |- arg* : OK val_input*
    -- Call_func:
        C |- id `< typ_input* `> `( val_input* `) : funcRes

}

;;; Iterated expression evaluation rules

rulegroup Eval_exp/iter {

  rule Eval_exp/simple:
    C |- ITER exp iterExp : OK val
    -- if varr = $is_iter_on_var(ITER exp iterExp)
    -- if val = $find_varr(C, varr)

  rule Eval_exp/opt-body-failure:
    C |- ITER exp iterExp : failure
    -- if eps = $is_iter_on_var(ITER exp iterExp)
    -- if QUEST vari* = iterExp
    -- if OK C_sub? = $sub_opt(C, vari*)
    -- Eval_exp_maybe: C_sub? |- exp : failure

  rule Eval_exp/opt-succ:
    C |- ITER exp iterExp : OK (OPT val?)
    -- if eps = $is_iter_on_var(ITER exp iterExp)
    -- if QUEST vari* = iterExp
    -- if OK C_sub? = $sub_opt(C, vari*)
    -- Eval_exp_maybe: C_sub? |- exp : OK val?

  rule Eval_exp/list-body-failure:
    C |- ITER exp iterExp : failure
    -- if eps = $is_iter_on_var(ITER exp iterExp)
    -- if STAR vari* = iterExp
    -- if OK C_sub* = $sub_list(C, vari*)
    -- Eval_exp_each: C_sub* |- exp : failure

  rule Eval_exp/list-succ:
    C |- ITER exp iterExp : OK (LIST val*)
    -- if eps = $is_iter_on_var(ITER exp iterExp)
    -- if STAR vari* = iterExp
    -- if OK C_sub* = $sub_list(C, vari*)
    -- Eval_exp_each: C_sub* |- exp : OK val*

}

rule Eval_exp/error:
  C |- exp : ERROR
  -- otherwise

;; Expression sequence evaluation rules

rulegroup Eval_exps {

  rule Eval_exps/nil:
    C |- eps : OK eps

  rule Eval_exps/head-failure:
    C |- exp_h :: exp_t* : failure
    -- Eval_exp: C |- exp_h : failure

  rule Eval_exps/tail-failure:
    C |- exp_h :: exp_t* : failure
    -- Eval_exp: C |- exp_h : OK val_h
    -- Eval_exps: C |- exp_t* : failure

  rule Eval_exps/cons-succ:
    C |- exp_h :: exp_t* : OK (val_h :: val_t*)
    -- Eval_exp: C |- exp_h : OK val_h
    -- Eval_exps: C |- exp_t* : OK val_t*

}

;; Expression iteration evaluation rules

;;; Optional contexts

rulegroup Eval_exp_maybe {

  rule Eval_exp_maybe/none:
    eps |- exp : OK eps

  rule Eval_exp_maybe/failure:
    C |- exp : failure
    -- Eval_exp: C |- exp : failure

  rule Eval_exp_maybe/some:
    C |- exp : OK val
    -- Eval_exp: C |- exp : OK val

}

;;; List contexts

rulegroup Eval_exp_each {

  rule Eval_exp_each/nil:
    eps |- exp : OK eps

  rule Eval_exp_each/head-failure:
    (C_h :: C_t*) |- exp : failure
    -- Eval_exp: C_h |- exp : failure

  rule Eval_exp_each/tail-failure:
    (C_h :: C_t*) |- exp : failure
    -- Eval_exp: C_h |- exp : OK val_h
    -- Eval_exp_each: C_t* |- exp : failure

  rule Eval_exp_each/cons-succ:
    (C_h :: C_t*) |- exp : OK (val_h :: val_t*)
    -- Eval_exp: C_h |- exp : OK val_h
    -- Eval_exp_each: C_t* |- exp : OK val_t*

}
