;; Meta-function invocation

;;; Clause invocation

relation Eval_clause:
  ctx |- clause `( val* `) : funcRes
  hint(input %0 %1 %2)
  hint(prose_in "evaluating clause" %1 "with inputs" %2 "under context" %0)
  hint(prose_out %3)

rulegroup Eval_clause {

  rule Eval_clause/premises-failure:
    C |- clause `( val* `) : failure
    -- if arg* '=' exp_out '-' prem* = clause
    -- Assign_args: C |- arg* := val* : OK C'
    -- Eval_prems: C' |- prem* : failure

  rule Eval_clause/succ:
    C |- clause `( val* `) : funcRes
    -- if arg* '=' exp_out '-' prem* = clause
    -- Assign_args: C |- arg* := val* : OK C'
    -- Eval_prems: C' |- prem* : OK C''
    -- Eval_exp : C'' |- exp_out : funcRes

}

rule Eval_clause/error:
  C |- clause `( val* `) : ERROR
  -- otherwise

relation Eval_clauses:
  ctx |- clause* `( val* `) : funcRes
  hint(input %0 %1 %2)
  hint(prose_in "evaluating clauses" %1 "with inputs" %2 "under context" %0
                "with determinism checks")
  hint(prose_out %3)

relation Eval_clauses_on_ok:
  ctx |- clause* `( val* `) : unitRes
  hint(input %0 %1 %2)
  hint(prose_in "checking that all remaining clauses" %1
                "are unmatched with inputs" %2 "under context" %0)
  hint(prose_out %3)

rulegroup Eval_clauses {

  rule Eval_clauses/nil:
    C |- eps `( val* `) : UNMATCH

  rule Eval_clauses/unmatch:
    C |- (clause_h :: clause_t*) `( val* `) : funcRes
    -- Eval_clause: C |- clause_h `( val* `) : UNMATCH
    -- Eval_clauses: C |- clause_t* `( val* `) : funcRes

  rule Eval_clauses/succ:
    C |- (clause_h :: clause_t*) `( val* `) : OK val_out
    -- Eval_clause: C |- clause_h `( val* `) : OK val_out
    -- Eval_clauses_on_ok: C |- clause_t* `( val* `) : OK

}

rule Eval_clauses/error:
  C |- clause* `( val* `) : ERROR
  -- otherwise

rulegroup Eval_clauses_on_ok {

  rule Eval_clauses_on_ok/nil:
    C |- eps `( val* `) : OK

  rule Eval_clauses_on_ok/unmatch:
    C |- (clause_h :: clause_t*) `( val* `) : unitRes
    -- Eval_clause: C |- clause_h `( val* `) : UNMATCH
    -- Eval_clauses_on_ok: C |- clause_t* `( val* `) : unitRes

  rule Eval_clauses_on_ok/error:
    C |- (clause_h :: clause_t*) `( val* `) : ERROR
    -- Eval_clause: C |- clause_h `( val* `) : funcRes
    -- if funcRes =/= UNMATCH

}

;;; Table meta-function invocation

;;;; Table row evaluation

relation Eval_tblrow:
  ctx |- tblRow `( val* `) : funcRes
  hint(input %0 %1 %2)
  hint(prose_in "evaluating table row" %1 "with inputs" %2 "under context" %0)
  hint(prose_out %3)

rulegroup Eval_tblrow {

  rule Eval_tblrow/premises-failure:
    C |- tblRow `( val* `) : failure
    -- if arg* '=' exp_out '-' prem* = tblRow
    -- if C_callee = C[ .LOCAL = $empty_localLayer ]
    -- Assign_args: C_callee |- arg* := val* : OK C_callee'
    -- Eval_prems: C_callee' |- prem* : failure

  rule Eval_tblrow/succ:
    C |- tblRow `( val* `) : funcRes
    -- if arg* '=' exp_out '-' prem* = tblRow
    -- if C_callee = C[ .LOCAL = $empty_localLayer ]
    -- Assign_args: C_callee |- arg* := val* : OK C_callee'
    -- Eval_prems: C_callee' |- prem* : OK C_callee''
    -- Eval_exp: C_callee'' |- exp_out : funcRes

}

rule Eval_tblrow/error:
  C |- tblRow `( val* `) : ERROR
  -- otherwise

;;;; Table row sequence evaluation

relation Eval_tblrows:
  ctx |- tblRow* `( val* `) : funcRes
  hint(input %0 %1 %2)
  hint(prose_in "evaluating table rows" %1 "with inputs" %2 "under context" %0
                "in order until a row succeeds or errors")
  hint(prose_out %3)

rulegroup Eval_tblrows {

  rule Eval_tblrows/nil:
    C |- eps `( val* `) : UNMATCH

  rule Eval_tblrows/unmatch:
    C |- (tblRow_h :: tblRow_t*) `( val* `) : funcRes
    -- Eval_tblrow: C |- tblRow_h `( val* `) : UNMATCH
    -- Eval_tblrows: C |- tblRow_t* `( val* `) : funcRes

  rule Eval_tblrows/cons-result:
    C |- (tblRow_h :: tblRow_t*) `( val* `) : funcRes
    -- Eval_tblrow: C |- tblRow_h `( val* `) : funcRes
    -- if funcRes =/= UNMATCH

}

;;;; Table meta-function evaluation

relation Call_table_func:
  ctx |- tableFuncDefn `( val* `) : funcRes
  hint(input %0 %1 %2)
  hint(prose_in "calling table function" %1 "with inputs" %2 "under context" %0)
  hint(prose_out %3)

rule Call_table_func:
  C |- tableFuncDefn `( val* `) : funcRes
  -- if TABLEFUNC _ _ ':' _ '=' tblRow* = tableFuncDefn
  -- Eval_tblrows: C |- tblRow* `( val* `) : funcRes

;;; Defined meta-function invocation

relation Call_defined_func:
  ctx |- definedFuncDefn `< typ* `> `( val* `) : funcRes
  hint(input %0 %1 %2 %3)
  hint(prose_in "calling defined function" %1 "with types" %2 "and inputs" %3
                "under context" %0)
  hint(prose_out %4)

rulegroup Call_defined_func {

  rule Call_defined_func/unmatch:
    C |- definedFuncDefn `< typ* `> `( val* `) : funcRes
    -- if FUNC _ tparam* _ ':' _ '=' clause* elsClause? = definedFuncDefn
    -- if |tparam*| = |typ*|
    -- if tdenv = `{ (tparam ':' (TYP tparam eps '=' (ALIAS typ)))* `}
    -- if C_callee = C[ .LOCAL = $empty_localLayer[ .TYP = tdenv ] ]
    -- Eval_clauses: C_callee |- clause* `( val* `) : UNMATCH
    -- (Eval_clause: C_callee |- elsClause `( val* `) : funcRes_els)?
    -- if funcRes = $deopt_<funcRes>(funcRes_els?, UNMATCH)

  rule Call_defined_func/result:
    C |- definedFuncDefn `< typ* `> `( val* `) : funcRes
    -- if FUNC _ tparam* _ ':' _ '=' clause* elsClause? = definedFuncDefn
    -- if |tparam*| = |typ*|
    -- if tdenv = `{ (tparam ':' (TYP tparam eps '=' (ALIAS typ)))* `}
    -- if C_callee = C[ .LOCAL = $empty_localLayer[ .TYP = tdenv ] ]
    -- Eval_clauses: C_callee |- clause* `( val* `) : funcRes
    -- if funcRes =/= UNMATCH

}

rule Call_defined_func/error:
  C |- definedFuncDefn `< typ* `> `( val* `) : ERROR
  -- otherwise

;;; Meta-function dispatch

rulegroup Call_func_dispatch {

    rule Call_func_dispatch/extern:
      C |- (EXTFUNC id _ _ ':' _) `< typ* `> `( val* `) : funcRes
      -- Call_extern_func:
          |- id `< typ* `> `( val* `) : funcRes

    rule Call_func_dispatch/builtin:
      C |- builtinFuncDefn `< typ* `> `( val* `) : funcRes
      -- if BUILTINFUNC id _ _ ':' _ = builtinFuncDefn
      -- Call_builtin_func:
          |- id `< typ* `> `( val* `) : funcRes

    rule Call_func_dispatch/table:
      C |- tableFuncDefn `< eps `> `( val* `) : funcRes
      -- Call_table_func:
          C |- tableFuncDefn `( val* `) : funcRes

    rule Call_func_dispatch/defined:
      C |- definedFuncDefn `< typ* `> `( val* `) : funcRes
      -- Call_defined_func:
          C |- definedFuncDefn `< typ* `> `( val* `) : funcRes

}

;; Meta-function call

rule Call_func:
  C |- id `< typ* `> `( val* `) : funcRes
  -- if id_global = $resolve_func_param(C, id)
  -- if funcDefn = $find_func(C, id_global)
  -- Call_func_dispatch:
      C |- funcDefn `< typ* `> `( val* `) : funcRes

rule Call_func/error:
  C |- id `< typ* `> `( val* `) : ERROR
  -- otherwise
