;; Binary operations

dec $unop_number(numunop, num) : val
  hint(print %0 %1)
def $unop_number(PLUS, NAT n) = NAT n
def $unop_number(PLUS, INT i) = INT i
def $unop_number(MINUS, NAT n) = INT $(-n)
def $unop_number(MINUS, INT i) = INT $(-i)

dec $binop_bool(boolbinop, bool, bool) : bool
  hint(print %1 %0 %2)
def $binop_bool(AND, b_l, b_r) = (b_l /\ b_r)
def $binop_bool(OR, b_l, b_r) = (b_l \/ b_r)
def $binop_bool(IMPL, b_l, b_r) = (b_l => b_r)
def $binop_bool(EQUIV, b_l, b_r) = (b_l <=> b_r)

syntax numOpRes = ok<val> | error

dec $binop_number(numbinop, num, num) : numOpRes
  hint(print %1 %0 %2)
def $binop_number(ADD, NAT n_l, NAT n_r) = OK (NAT $(n_l + n_r))
def $binop_number(ADD, INT i_l, INT i_r) = OK (INT $(i_l + i_r))
def $binop_number(SUB, NAT n_l, NAT n_r) = OK (INT $(n_l - n_r))
def $binop_number(SUB, INT i_l, INT i_r) = OK (INT $(i_l - i_r))
def $binop_number(MUL, NAT n_l, NAT n_r) = OK (NAT $(n_l * n_r))
def $binop_number(MUL, INT i_l, INT i_r) = OK (INT $(i_l * i_r))
def $binop_number(DIV, NAT n_l, NAT n_r) = OK (NAT $(n_l / n_r))
  -- if n_r =/= 0
def $binop_number(DIV, INT i_l, INT i_r) = OK (INT $(i_l / i_r))
  -- if i_r =/= 0
def $binop_number(MOD, NAT n_l, NAT n_r) = OK (NAT $(n_l \ n_r))
  -- if n_r =/= 0
def $binop_number(MOD, INT i_l, INT i_r) = OK (INT $(i_l \ i_r))
  -- if i_r =/= 0

def $binop_number(numbinop, num_l, num_r) = ERROR
  -- otherwise

dec $cmpop_poly(polycmpop, val, val) : bool
  hint(print %1 %0 %2)
def $cmpop_poly(EQ, val_l, val_r) = (val_l = val_r)
def $cmpop_poly(NE, val_l, val_r) = (val_l =/= val_r)

syntax numCmpRes = ok<bool> | error

dec $cmpop_number(numcmpop, num, num) : numCmpRes
  hint(print %1 %0 %2)
def $cmpop_number(LT, NAT n_l, NAT n_r) = OK ($(n_l < n_r))
def $cmpop_number(LT, INT i_l, INT i_r) = OK ($(i_l < i_r))
def $cmpop_number(GT, NAT n_l, NAT n_r) = OK ($(n_l > n_r))
def $cmpop_number(GT, INT i_l, INT i_r) = OK ($(i_l > i_r))
def $cmpop_number(LE, NAT n_l, NAT n_r) = OK ($(n_l <= n_r))
def $cmpop_number(LE, INT i_l, INT i_r) = OK ($(i_l <= i_r))
def $cmpop_number(GE, NAT n_l, NAT n_r) = OK ($(n_l >= n_r))
def $cmpop_number(GE, INT i_l, INT i_r) = OK ($(i_l >= i_r))

def $cmpop_number(numcmpop, num_l, num_r) = ERROR
  -- otherwise

;; Constructor checks

dec $is_tup(val) : bool
  hint(prose_true %0 "is a tuple")
  hint(prose_false %0 "is not a tuple")
def $is_tup(TUP val*) = true
def $is_tup(val) = false
    -- otherwise

dec $is_fun(val) : bool
  hint(prose_true %0 "is a function")
  hint(prose_false %0 "is not a function")
def $is_fun(FUNC id) = true
def $is_fun(val) = false
    -- otherwise

;; Pattern tests

dec $match(val, pattern) : bool
def $match(INJ (mixop_v val*), INJ mixop_p) = (mixop_v = mixop_p)
def $match(LIST val*, CONS) = $(|val*| > 0)
def $match(LIST val*, FIXED n) = (|val*| = n)
def $match(LIST val*, NIL) = (|val*| = 0)
def $match(OPT val?, SOME) = (val? =/= eps)
def $match(OPT val?, NONE) = (val? = eps)
def $match(val, pattern) = false
  -- otherwise
