;; Unary numeric operations

dec $numUnop(numUnop, num) : val
  hint(print %0 %1)
def $numUnop(PLUS, NAT n) = NAT n
def $numUnop(PLUS, INT i) = INT i
def $numUnop(MINUS, NAT n) = INT $(-n)
def $numUnop(MINUS, INT i) = INT $(-i)

;; Binary boolean operations

dec $boolBinop(boolBinop, bool, bool) : bool
  hint(print %1 %0 %2)
def $boolBinop(AND, b_l, b_r) = (b_l /\ b_r)
def $boolBinop(OR, b_l, b_r) = (b_l \/ b_r)
def $boolBinop(IMPL, b_l, b_r) = (b_l => b_r)
def $boolBinop(EQUIV, b_l, b_r) = (b_l <=> b_r)

;; Binary numeric operations

syntax numBinopRes = ok<val> | error

dec $numBinop(numBinop, num, num) : numBinopRes
  hint(print %1 %0 %2)
def $numBinop(ADD, NAT n_l, NAT n_r) = OK (NAT $(n_l + n_r))
def $numBinop(ADD, INT i_l, INT i_r) = OK (INT $(i_l + i_r))
def $numBinop(SUB, NAT n_l, NAT n_r) = OK (INT $(n_l - n_r))
def $numBinop(SUB, INT i_l, INT i_r) = OK (INT $(i_l - i_r))
def $numBinop(MUL, NAT n_l, NAT n_r) = OK (NAT $(n_l * n_r))
def $numBinop(MUL, INT i_l, INT i_r) = OK (INT $(i_l * i_r))
def $numBinop(DIV, NAT n_l, NAT n_r) = OK (NAT $(n_l / n_r))
def $numBinop(DIV, INT i_l, INT i_r) = OK (INT $(i_l / i_r))
def $numBinop(MOD, NAT n_l, NAT n_r) = OK (NAT $(n_l \ n_r))
def $numBinop(MOD, INT i_l, INT i_r) = OK (INT $(i_l \ i_r))
def $numBinop(numBinop, num_l, num_r) = ERROR
  -- otherwise

;; Polymorphic comparison operations

dec $polyCmpop(polyCmpop, val, val) : bool
  hint(print %1 %0 %2)
def $polyCmpop(EQ, val_l, val_r) = (val_l = val_r)
def $polyCmpop(NE, val_l, val_r) = (val_l =/= val_r)

;; Numeric comparison operations

syntax numCmpRes = ok<bool> | error

dec $numCmpop(numCmpop, num, num) : numCmpRes
  hint(print %1 %0 %2)
def $numCmpop(LT, NAT n_l, NAT n_r) = OK ($(n_l < n_r))
def $numCmpop(LT, INT i_l, INT i_r) = OK ($(i_l < i_r))
def $numCmpop(GT, NAT n_l, NAT n_r) = OK ($(n_l > n_r))
def $numCmpop(GT, INT i_l, INT i_r) = OK ($(i_l > i_r))
def $numCmpop(LE, NAT n_l, NAT n_r) = OK ($(n_l <= n_r))
def $numCmpop(LE, INT i_l, INT i_r) = OK ($(i_l <= i_r))
def $numCmpop(GE, NAT n_l, NAT n_r) = OK ($(n_l >= n_r))
def $numCmpop(GE, INT i_l, INT i_r) = OK ($(i_l >= i_r))
def $numCmpop(numCmpop, num_l, num_r) = ERROR
  -- otherwise

;; Pattern tests

dec $matches(val, pat) : bool
def $matches(INJ (mixop_v val*), INJ mixop_p) = (mixop_v = mixop_p)
def $matches(LIST val*, CONS) = $(|val*| > 0)
def $matches(LIST val*, FIXED n) = (|val*| = n)
def $matches(LIST val*, NIL) = (|val*| = 0)
def $matches(OPT val?, SOME) = (val? =/= eps)
def $matches(OPT val?, NONE) = (val? = eps)
def $matches(val, pat) = false
  -- otherwise
