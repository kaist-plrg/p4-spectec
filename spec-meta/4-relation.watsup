;; Result to represent backtracking in evaluation

syntax unitres = OK | FAIL
syntax res<X> = OK X | FAIL

syntax valres = res<val>
syntax valsres = res<val*>

dec $det_valres(valres*) : valres

def $det_valres(valres*) = OK val
  -- if (b_ok = (valres =/= FAIL))*
  -- if OK val = $filter_<valres>(valres*, b_ok*)
def $det_valres(valres*) = FAIL
  -- otherwise

dec $det_valsres(valsres*) : valsres

def $det_valsres(valsres*) = valsres_ok*[0]
  -- if (b_ok = (valsres =/= FAIL))*
  -- if valsres_ok* = $filter_<valsres>(valsres*, b_ok*)
  -- if $(|valsres_ok*| = 1)
def $det_valsres(valsres*) = FAIL
  -- if (b_ok = (valsres =/= FAIL))*
  -- if valsres_ok* = $filter_<valsres>(valsres*, b_ok*)
  -- if $(|valsres_ok*| > 1)
def $det_valsres(valsres*) = FAIL
  -- if (b_ok = (valsres =/= FAIL))*
  -- if valsres_ok* = $filter_<valsres>(valsres*, b_ok*)
  -- if $(|valsres_ok*| < 1)

;;; Extern meta-function invocation

extern relation Call_extern_func:
  |- id `< typ* `> `( val* `) : res<val>
  hint(input %0 %1 %2)
  hint(prose_in "evaluating extern function"
                %0 "with types" %1 "and inputs" %2)
  hint(prose_out %3)

;;; Builtin meta-function invocation

extern relation Call_builtin_func:
  |- id '@' `< typ* `> `( val* `) : res<val>
  hint(input %0 %1 %2)

;;; Extern relations

extern relation Call_extern_rel:
  |- id val* : res<val*>
  hint(input %0 %1)
  hint(prose_in "evaluating extern relation" %0 "with inputs" %1)
  hint(prose_out %2)

;; Result to represent backtracking in evaluation

syntax ctxres = res<ctx>

;; Evaluation relations

relation Eval_exp:
  ctx |- exp : res<val>
  hint(input %0 %1)
  hint(prose_in "evaluating" %1 "under" %0)
  hint(prose_out %2)

relation Eval_targs:
  ctx |- targ* : typ*
  hint(input %0 %1)
  hint(prose_in "evaluating" %1 "under" %0)
  hint(prose_out %2)

relation Eval_arg:
  ctx |- arg : res<val>
  hint(input %0 %1)
  hint(prose_in "evaluating" %1 "under" %0)
  hint(prose_out %2)

relation Eval_prem:
  ctx |- prem : res<ctx>
  hint(input %0 %1)
  hint(prose_in "evaluating" %1 "under" %0)
  hint(prose_out %2)

relation Eval_prems:
  ctx |- prem* : res<ctx>
  hint(input %0 %1)
  hint(prose_in "evaluating" %1 "under" %0)
  hint(prose_out %2)

relation Call_func_dispatch:
  ctx |- funcdef targ* val* : res<val>
  hint(input %0 %1 %2 %3)

relation Call_func:
  ctx |- id targ* val* : res<val>
  hint(input %0 %1 %2 %3)
  hint(prose_in "calling" %1 "with types" %2 "and arguments" %3 "under" %0)
  hint(prose_out %4)

relation Call_rel_dispatch:
  ctx |- reldef val* : res<val*>
  hint(input %0 %1 %2)

relation Call_rel:
  ctx |- id val* : res<val*>
  hint(input %0 %1 %2)
  hint(prose_in "calling" %1 "with arguments" %2 "under" %0)
  hint(prose_out %3)
