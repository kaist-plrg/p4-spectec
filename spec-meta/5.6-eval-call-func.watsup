;; Meta-function invocation

;;; Clause invocation

relation Eval_clause:
  ctx '/' ctx |- clause '@' `( val* `) : res<val>
  hint(input %0 %1 %2 %3)

rule Eval_clause/succ:
  C '/' C_caller |- clause '@' `( val* `) : OK val_out
  -- if arg* '=' exp_out '-' prem* = clause
  -- Assign_args: C '/' C_caller |- arg* := val* : C'
  -- Eval_prems: C' |- prem* : OK C''
  -- Eval_exp : C'' |- exp_out : OK val_out

rule Eval_clause/fail:
  C '/' C_caller |- clause '@' `( val* `) : FAIL
  -- otherwise

relation Eval_clauses:
  ctx '/' ctx |- clause* '@' `( val* `) : res<val>
  hint(input %0 %1 %2 %3)

rule Eval_clauses:
  C '/' C_caller |- clause* '@' `( val* `) : valres_clauses
  -- (Eval_clause: C '/' C_caller |- clause '@' `( val* `) : valres)*
  -- if valres_clauses = $det_valres(valres*)

;;; Table meta-function invocation

;;;; Table row evaluation

relation Eval_tblrow:
  ctx |- tblrow '@' `( val* `) : res<val>
  hint(input %0 %1 %2)
  hint(prose_in "evaluating" %1 "with inputs" %2 "under" %0)
  hint(prose_out %3)

rule Eval_tblrow/succ:
  C |- tblrow '@' `( val* `) : OK val_out
  -- if arg* '=' exp_out '-' prem* = tblrow
  -- if C_callee = C[ .LOCAL = $empty_layer ]
  -- Assign_args: C_callee '/' C |- arg* := val* : C_callee'
  -- Eval_prems: C_callee' |- prem* : OK C_callee''
  -- Eval_exp: C_callee'' |- exp_out : OK val_out

rule Eval_tblrow/fail:
  C |- tblrow '@' `( val* `) : FAIL
  -- otherwise

;;;; Table row sequence evaluation

relation Eval_tblrows:
  ctx |- tblrow* '@' `( val* `) : res<val>
  hint(input %0 %1 %2)
  hint(prose_in "evaluating" %1 "with inputs" %2 "under" %0)
  hint(prose_out %3)

rulegroup Eval_tblrows {

  rule Eval_tblrows/nil:
    C |- eps '@' `( val* `) : FAIL

  rule Eval_tblrows/cons-succ:
    C |- (tblrow_h :: tblrow_t*) '@' `( val* `) : OK val_out
    -- Eval_tblrow: C |- tblrow_h '@' `( val* `) : OK val_out

  rule Eval_tblrows/cons-fail:
    C |- (tblrow_h :: tblrow_t*) '@' `( val* `) : valres
    -- Eval_tblrow: C |- tblrow_h '@' `( val* `) : FAIL
    -- Eval_tblrows: C |- tblrow_t* '@' `( val* `) : valres

}

;;;; Table meta-function evaluation

relation Call_table_func:
  ctx |- tableFuncDef '@' `( val* `) : res<val>
  hint(input %0 %1 %2)
  hint(prose_in "evaluating" %1 "with inputs" %2 "under" %0)
  hint(prose_out %3)

rule Call_table_func:
  C |- tableFuncDef '@' `( val* `) : valres
  -- if TABLE _ _ '->' tblrow* = tableFuncDef
  -- Eval_tblrows: C |- tblrow* '@' `( val* `) : valres

;;; Defined meta-function invocation

relation Call_defined_func:
  ctx |- definedFuncDef '@' `< typ* `> `( val* `) : res<val>
  hint(input %0 %1 %2 %3)
  hint(prose_in "evaluating" %1 "with types" %2
                "and inputs" %3 "under" %0)
  hint(prose_out %4)

rulegroup Call_defined_func {

  rule Call_defined_func/succ:
    C |- definedFuncDef '@' `< typ* `> `( val* `) : OK val_func
    -- if DEF tparam* _ _ '->' clause* elsclause? = definedFuncDef
    -- if tdenv = `{ (tparam ':' (DEF eps '->' (ALIAS typ)))* `}
    -- if C_callee = C[ .LOCAL = $empty_layer[ .TYP = tdenv ] ]
    -- Eval_clauses: C_callee '/' C |- clause* '@' `( val* `) : OK val_func

  rule Call_defined_func/fail:
    C |- definedFuncDef '@' `< typ* `> `( val* `) : valres_func
    -- if DEF tparam* _ _ '->' clause* elsclause? = definedFuncDef
    -- if tdenv = `{ (tparam ':' (DEF eps '->' (ALIAS typ)))* `}
    -- if C_callee = C[ .LOCAL = $empty_layer[ .TYP = tdenv ] ]
    -- Eval_clauses: C_callee '/' C |- clause* '@' `( val* `) : FAIL
    -- (Eval_clause: C_callee '/' C |- elsclause '@' `( val* `) : valres)?
    -- if valres_func = $deopt_<valres>(valres?, FAIL)

}

;;; Meta-function dispatch

rulegroup Call_func_dispatch {

    rule Call_func_dispatch/extern:
      C |- (EXT id _ _ _) typ* val* : valres
      -- Call_extern_func:
          |- id `< typ* `> `( val* `) : valres

    rule Call_func_dispatch/builtin:
      C |- builtinFuncDef typ* val* : valres
      -- if BUILTIN id _ _ _ = builtinFuncDef
      -- Call_builtin_func:
          |- id '@' `< typ* `> `( val* `) : valres

    rule Call_func_dispatch/table:
      C |- tableFuncDef eps val* : valres
      -- Call_table_func:
          C |- tableFuncDef '@' `( val* `) : valres

    rule Call_func_dispatch/defined:
      C |- definedFuncDef typ* val* : valres
      -- Call_defined_func:
          C |- definedFuncDef '@' `< typ* `> `( val* `) : valres

}

;; Meta-function call

rule Call_func:
  C |- id typ* val* : valres
  -- if funcdef = $find_func(C, id)
  -- Call_func_dispatch: C |- funcdef typ* val* : valres
