;; Meta-function invocation

;;; Clause invocation

relation Eval_clause:
  ctx '/' ctx |- clause '@' `( val* `) : funcRes
  hint(input %0 %1 %2 %3)

rulegroup Eval_clause {

  rule Eval_clause/premises-failure:
    C '/' C_caller |- clause '@' `( val* `) : failure
    -- if arg* '=' exp_out '-' prem* = clause
    -- Assign_args: C '/' C_caller |- arg* := val* : OK C'
    -- Eval_prems: C' |- prem* : failure

  rule Eval_clause/succ:
    C '/' C_caller |- clause '@' `( val* `) : funcRes
    -- if arg* '=' exp_out '-' prem* = clause
    -- Assign_args: C '/' C_caller |- arg* := val* : OK C'
    -- Eval_prems: C' |- prem* : OK C''
    -- Eval_exp : C'' |- exp_out : funcRes

}

rule Eval_clause/error:
  C '/' C_caller |- clause '@' `( val* `) : ERROR
  -- otherwise

relation Eval_clauses:
  ctx '/' ctx |- clause* '@' `( val* `) : funcRes
  hint(input %0 %1 %2 %3)

relation Eval_clauses_on_ok:
  ctx '/' ctx |- clause* '@' `( val* `) : unitRes
  hint(input %0 %1 %2 %3)

rulegroup Eval_clauses {

  rule Eval_clauses/nil:
    C '/' C_caller |- eps '@' `( val* `) : UNMATCH

  rule Eval_clauses/unmatch:
    C '/' C_caller |- (clause_h :: clause_t*) '@' `( val* `) : funcRes
    -- Eval_clause: C '/' C_caller |- clause_h '@' `( val* `) : UNMATCH
    -- Eval_clauses: C '/' C_caller |- clause_t* '@' `( val* `) : funcRes

  rule Eval_clauses/success:
    C '/' C_caller |- (clause_h :: clause_t*) '@' `( val* `) : OK val_out
    -- Eval_clause: C '/' C_caller |- clause_h '@' `( val* `) : OK val_out
    -- Eval_clauses_on_ok: C '/' C_caller |- clause_t* '@' `( val* `) : OK

}

rule Eval_clauses/error:
  C '/' C_caller |- clause* '@' `( val* `) : ERROR
  -- otherwise

rulegroup Eval_clauses_on_ok {

  rule Eval_clauses_on_ok/unmatch:
    C '/' C_caller |- (clause_h :: clause_t*) '@' `( val* `) : unitRes
    -- Eval_clause: C '/' C_caller |- clause_h '@' `( val* `) : UNMATCH
    -- Eval_clauses_on_ok: C '/' C_caller |- clause_t* '@' `( val* `) : unitRes

  rule Eval_clauses_on_ok/error:
    C '/' C_caller |- (clause_h :: clause_t*) '@' `( val* `) : ERROR
    -- Eval_clause: C '/' C_caller |- clause_h '@' `( val* `) : funcRes
    -- if funcRes =/= UNMATCH

  rule Eval_clauses_on_ok/nil:
    C '/' C_caller |- eps '@' `( val* `) : OK

}

;;; Table meta-function invocation

;;;; Table row evaluation

relation Eval_tblrow:
  ctx |- tblRow '@' `( val* `) : funcRes
  hint(input %0 %1 %2)
  hint(prose_in "evaluating" %1 "with inputs" %2 "under" %0)
  hint(prose_out %3)

rulegroup Eval_tblrow {

  rule Eval_tblrow/premises-failure:
    C |- tblRow '@' `( val* `) : failure
    -- if arg* '=' exp_out '-' prem* = tblRow
    -- if C_callee = C[ .LOCAL = $empty_layer ]
    -- Assign_args: C_callee '/' C |- arg* := val* : OK C_callee'
    -- Eval_prems: C_callee' |- prem* : failure

  rule Eval_tblrow/succ:
    C |- tblRow '@' `( val* `) : funcRes
    -- if arg* '=' exp_out '-' prem* = tblRow
    -- if C_callee = C[ .LOCAL = $empty_layer ]
    -- Assign_args: C_callee '/' C |- arg* := val* : OK C_callee'
    -- Eval_prems: C_callee' |- prem* : OK C_callee''
    -- Eval_exp: C_callee'' |- exp_out : funcRes

}

rule Eval_tblrow/error:
  C |- tblRow '@' `( val* `) : ERROR
  -- otherwise

;;;; Table row sequence evaluation

relation Eval_tblrows:
  ctx |- tblRow* '@' `( val* `) : funcRes
  hint(input %0 %1 %2)
  hint(prose_in "evaluating" %1 "with inputs" %2 "under" %0)
  hint(prose_out %3)

rulegroup Eval_tblrows {

  rule Eval_tblrows/nil:
    C |- eps '@' `( val* `) : UNMATCH

  rule Eval_tblrows/unmatch:
    C |- (tblRow_h :: tblRow_t*) '@' `( val* `) : funcRes
    -- Eval_tblrow: C |- tblRow_h '@' `( val* `) : UNMATCH
    -- Eval_tblrows: C |- tblRow_t* '@' `( val* `) : funcRes

  rule Eval_tblrows/cons-result:
    C |- (tblRow_h :: tblRow_t*) '@' `( val* `) : funcRes
    -- Eval_tblrow: C |- tblRow_h '@' `( val* `) : funcRes
    -- if funcRes =/= UNMATCH

}

;;;; Table meta-function evaluation

relation Call_table_func:
  ctx |- tableFuncDef '@' `( val* `) : funcRes
  hint(input %0 %1 %2)
  hint(prose_in "evaluating" %1 "with inputs" %2 "under" %0)
  hint(prose_out %3)

rule Call_table_func:
  C |- tableFuncDef '@' `( val* `) : funcRes
  -- if TABLE _ _ '->' tblRow* = tableFuncDef
  -- Eval_tblrows: C |- tblRow* '@' `( val* `) : funcRes

;;; Defined meta-function invocation

relation Call_defined_func:
  ctx |- definedFuncDef '@' `< typ* `> `( val* `) : funcRes
  hint(input %0 %1 %2 %3)
  hint(prose_in "evaluating" %1 "with types" %2
                "and inputs" %3 "under" %0)
  hint(prose_out %4)

rulegroup Call_defined_func {

  rule Call_defined_func/unmatch:
    C |- definedFuncDef '@' `< typ* `> `( val* `) : funcRes
    -- if DEF tparam* _ _ '->' clause* elsClause? = definedFuncDef
    -- if |tparam*| = |typ*|
    -- if tdenv = `{ (tparam ':' (DEF eps '->' (ALIAS typ)))* `}
    -- if C_callee = C[ .LOCAL = $empty_layer[ .TYP = tdenv ] ]
    -- Eval_clauses: C_callee '/' C |- clause* '@' `( val* `) : UNMATCH
    -- (Eval_clause: C_callee '/' C |- elsClause '@' `( val* `) : funcRes_els)?
    -- if funcRes = $deopt_<funcRes>(funcRes_els?, UNMATCH)

  rule Call_defined_func/result:
    C |- definedFuncDef '@' `< typ* `> `( val* `) : funcRes
    -- if DEF tparam* _ _ '->' clause* elsClause? = definedFuncDef
    -- if |tparam*| = |typ*|
    -- if tdenv = `{ (tparam ':' (DEF eps '->' (ALIAS typ)))* `}
    -- if C_callee = C[ .LOCAL = $empty_layer[ .TYP = tdenv ] ]
    -- Eval_clauses: C_callee '/' C |- clause* '@' `( val* `) : funcRes
    -- if funcRes =/= UNMATCH

}

rule Call_defined_func/error:
  C |- definedFuncDef '@' `< typ* `> `( val* `) : ERROR
  -- otherwise

;;; Meta-function dispatch

rulegroup Call_func_dispatch {

    rule Call_func_dispatch/extern:
      C |- (EXT id _ _ _) typ* val* : funcRes
      -- Call_extern_func:
          |- id `< typ* `> `( val* `) : funcRes

    rule Call_func_dispatch/builtin:
      C |- builtinFuncDef typ* val* : funcRes
      -- if BUILTIN id _ _ _ = builtinFuncDef
      -- Call_builtin_func:
          |- id '@' `< typ* `> `( val* `) : funcRes

    rule Call_func_dispatch/table:
      C |- tableFuncDef eps val* : funcRes
      -- Call_table_func:
          C |- tableFuncDef '@' `( val* `) : funcRes

    rule Call_func_dispatch/defined:
      C |- definedFuncDef typ* val* : funcRes
      -- Call_defined_func:
          C |- definedFuncDef '@' `< typ* `> `( val* `) : funcRes

}

;; Meta-function call

rule Call_func:
  C |- id typ* val* : funcRes
  -- if funcDef = $find_func(C, id)
  -- Call_func_dispatch: C |- funcDef typ* val* : funcRes

rule Call_func/error:
  C |- id typ* val* : ERROR
  -- otherwise
