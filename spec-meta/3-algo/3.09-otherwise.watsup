;;
;; Otherwise purity
;;

;; An otherwise rule or clause runs
;; only after every other alternative is unmatched,
;; so it must not fail itself.

;;
;; Pure expressions
;;
;; syntax typedExp
;;

;; Evaluating an expression fails only by calling a function

;;; BOOL bool
;;; num
;;; TEXT text

rulegroup Exp_pure/literal {

  rule Exp_pure/boolean:
    |- (BOOL _) '#' _

  rule Exp_pure/number:
    |- num '#' _

  rule Exp_pure/text:
    |- (TEXT _) '#' _

}

;;; VAR id

rule Exp_pure/variable:
  |- (VAR _) '#' _

;;; UN unop typedExp

rule Exp_pure/unary:
  |- (UN _ typedExp) '#' _
  -- Exp_pure: |- typedExp

;;; BIN binop typedExp typedExp

rule Exp_pure/binary:
  |- (BIN _ typedExp_l typedExp_r) '#' _
  -- Exp_pure: |- typedExp_l
  -- Exp_pure: |- typedExp_r

;;; CMP cmpop typedExp typedExp

rule Exp_pure/compare:
  |- (CMP _ typedExp_l typedExp_r) '#' _
  -- Exp_pure: |- typedExp_l
  -- Exp_pure: |- typedExp_r

;;; UPCAST typ typedExp

rule Exp_pure/upcast:
  |- (UPCAST _ typedExp) '#' _
  -- Exp_pure: |- typedExp

;;; DOWNCAST typ typedExp

rule Exp_pure/downcast:
  |- (DOWNCAST _ typedExp) '#' _
  -- Exp_pure: |- typedExp

;;; SUB typedExp typ

rule Exp_pure/subtype:
  |- (SUB typedExp _) '#' _
  -- Exp_pure: |- typedExp

;;; MATCH typedExp pat

rule Exp_pure/match:
  |- (MATCH typedExp _) '#' _
  -- Exp_pure: |- typedExp

;;; TUP typedExp*

rule Exp_pure/tuple:
  |- (TUP typedExp*) '#' _
  -- (Exp_pure: |- typedExp)*

;;; INJ expCase

rule Exp_pure/case:
  |- (INJ (_ typedExp*)) '#' _
  -- (Exp_pure: |- typedExp)*

;;; STR expField*

rule Exp_pure/struct:
  |- (STR expField*) '#' _
  -- (if _ typedExp = expField)*
  -- (Exp_pure: |- typedExp)*

;;; OPT typedExp?

rule Exp_pure/opt:
  |- (OPT typedExp?) '#' _
  -- (Exp_pure: |- typedExp)?

;;; LIST typedExp*

rule Exp_pure/list:
  |- (LIST typedExp*) '#' _
  -- (Exp_pure: |- typedExp)*

;;; CONS typedExp typedExp

rule Exp_pure/cons:
  |- (CONS typedExp_h typedExp_t) '#' _
  -- Exp_pure: |- typedExp_h
  -- Exp_pure: |- typedExp_t

;;; CAT typedExp typedExp

rule Exp_pure/concat:
  |- (CAT typedExp_l typedExp_r) '#' _
  -- Exp_pure: |- typedExp_l
  -- Exp_pure: |- typedExp_r

;;; MEM typedExp typedExp

rule Exp_pure/mem:
  |- (MEM typedExp_l typedExp_r) '#' _
  -- Exp_pure: |- typedExp_l
  -- Exp_pure: |- typedExp_r

;;; LEN typedExp

rule Exp_pure/len:
  |- (LEN typedExp) '#' _
  -- Exp_pure: |- typedExp

;;; DOT typedExp atom

rule Exp_pure/dot:
  |- (DOT typedExp _) '#' _
  -- Exp_pure: |- typedExp

;;; IDX typedExp typedExp

rule Exp_pure/idx:
  |- (IDX typedExp_b typedExp_i) '#' _
  -- Exp_pure: |- typedExp_b
  -- Exp_pure: |- typedExp_i

;;; SLICE typedExp typedExp typedExp

rule Exp_pure/slice:
  |- (SLICE typedExp_b typedExp_i typedExp_n) '#' _
  -- Exp_pure: |- typedExp_b
  -- Exp_pure: |- typedExp_i
  -- Exp_pure: |- typedExp_n

;;; UPD typedExp typedPath typedExp

rule Exp_pure/upd:
  |- (UPD typedExp_b typedPath typedExp_f) '#' _
  -- Exp_pure: |- typedExp_b
  -- Path_pure: |- typedPath
  -- Exp_pure: |- typedExp_f

;;; ITER typedExp expIter

rule Exp_pure/iter:
  |- (ITER typedExp _) '#' _
  -- Exp_pure: |- typedExp

;;
;; Pure paths
;;
;; syntax typedPath
;;

;;; ROOT

rule Path_pure/root:
  |- ROOT '#' _

;;; IDX typedPath typedExp

rule Path_pure/idx:
  |- (IDX typedPath typedExp_i) '#' _
  -- Path_pure: |- typedPath
  -- Exp_pure: |- typedExp_i

;;; SLICE typedPath typedExp typedExp

rule Path_pure/slice:
  |- (SLICE typedPath typedExp_i typedExp_n) '#' _
  -- Path_pure: |- typedPath
  -- Exp_pure: |- typedExp_i
  -- Exp_pure: |- typedExp_n

;;; DOT typedPath atom

rule Path_pure/dot:
  |- (DOT typedPath _) '#' _
  -- Path_pure: |- typedPath

;;
;; Pure premises
;;
;; syntax premAL
;;

;; Relation premises and conditions may fail, so only these premises are pure

;;; letPremAL
;;; syntax letPremAL = LET typedExp '=' typedExp

rule Prem_pure/let:
  |- LET _ '=' typedExp_r
  -- Exp_pure: |- typedExp_r

;;; iterPremAL
;;; syntax iterPremAL = ITER premAL premIterAL

rule Prem_pure/iter:
  |- ITER premAL _
  -- Prem_pure: |- premAL

;;; debugPrem
;;; syntax debugPrem = DEBUG typedExp

rule Prem_pure/dbg:
  |- DEBUG typedExp
  -- Exp_pure: |- typedExp

;;
;; Otherwise rules and clauses
;;
;; syntax defnAL
;;

;; Definitions without an otherwise rule or clause are trivially accepted

;;; typDefn

rule Otherwise_pure/typ:
  |- typDefn

;;; relDefnAL

rulegroup Otherwise_pure/rel {

  ;;;; externRelDefnAL

  rule Otherwise_pure/extern:
    |- externRelDefnAL

  ;;;; definedRelDefnAL

  rule Otherwise_pure/none:
    |- REL _ ':' _ '->' _ '=' _ eps

  rule Otherwise_pure/else:
    |- REL _ ':' _ '->' _ '=' _ elsGroupAL
    -- if _ ':' rulAL = elsGroupAL
    -- if _ ':' _ '->' typedExp_out* '-' premAL* = rulAL
    ---- ;; its premises, guards included, cannot fail
    -- (Prem_pure: |- premAL)*
    ---- ;; nor can evaluating its outputs
    -- (Exp_pure: |- typedExp_out)*

}

;;; funcDefnAL

rulegroup Otherwise_pure/func {

  ;;;; externFuncDefn

  rule Otherwise_pure/extern:
    |- externFuncDefn

  ;;;; builtinFuncDefn

  rule Otherwise_pure/builtin:
    |- builtinFuncDefn

  ;;;; tableFuncDefnAL

  rule Otherwise_pure/table:
    |- tableFuncDefnAL

  ;;;; definedFuncDefnAL

  rule Otherwise_pure/none:
    |- FUNC _ _ _ ':' _ '=' _ eps

  rule Otherwise_pure/else:
    |- FUNC _ _ _ ':' _ '=' _ elsClauseAL
    -- if _ '=' typedExp '-' premAL* = elsClauseAL
    ---- ;; its premises, guards included, cannot fail
    -- (Prem_pure: |- premAL)*
    ---- ;; nor can evaluating its result
    -- Exp_pure: |- typedExp

}
