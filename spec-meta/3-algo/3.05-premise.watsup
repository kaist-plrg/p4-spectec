;; Input positions

;; Relation arguments in notation order, separated into the arguments at
;; the input positions and the remaining outputs, each in source order

dec $split_inputs<X>(inputHint, X*) : (X*, X*)
  hint(prose_in "the arguments" %1
                "split into inputs at positions" %0 "and outputs")
dec $split_inputs_from<X>(inputHint, nat, X*) : (X*, X*)
  hint(prose_in "the arguments" %2 "from position" %1
                "split into inputs at positions" %0 "and outputs")

def $split_inputs<X>(n*, X*) = $split_inputs_from<X>(n*, 0, X*)
  -- if $forall_($(n < |X*|)*)

def $split_inputs_from<X>(_, _, eps) = (eps, eps)
def $split_inputs_from<X>(n*, n_pos, X_h :: X_t*)
  = (X_h :: X_in*, X_out*)
  -- if n_pos <- n*
  -- if (X_in*, X_out*)
      = $split_inputs_from<X>(n*, $(n_pos + 1), X_t*)
def $split_inputs_from<X>(n*, n_pos, X_h :: X_t*)
  = (X_in*, X_h :: X_out*)
  -- if ~(n_pos <- n*)
  -- if (X_in*, X_out*)
      = $split_inputs_from<X>(n*, $(n_pos + 1), X_t*)

;; Premises

;; Each premise reads bound variables and binds the variables of its patterns.
;; Under an iteration, the variables a premise reads become its sources
;; and the variables it binds become its binders:
;;
;;   -- (let x = z + 1)*{x <- x*, z <- z*}
;;
;; becomes
;;
;;   -- (let x = z + 1)*{z <- z*, x -> x*}

;;; Relation premises

;; Inputs must be bound; outputs bind

rule Algo_prem/rel:
  AC IC |- relPremIL : AC' premAL*
  -- if REL id ':' typedExp* `( inputHint `) = relPremIL
  -- if (typedExp_in*, typedExp_out*)
      = $split_inputs<typedExp>(inputHint, typedExp*)
  -- if id_in* = $free_ids_exps(typedExp_in*)
  -- if $is_bound(AC, id_in*)
  -- Bind_exps:
      AC IC |- typedExp_out* : AC' typedExp_out'* premAL_bind*
  -- if vari_in* = $free_vars_exps(typedExp_in*)
  -- if vari_read* = $shallowest_vars(vari_in*)
  -- if vari_out* = $free_vars_exps(typedExp_out'*)
  -- if vari_bind* = $shallowest_vars(vari_out*)
  -- if IC_read = $restrict_iterCtx(IC, vari_read*)
  -- if IC_rel = $add_binders_iterCtx(IC_read, vari_bind*)
  -- Iter_sourced: |- IC_rel
  -- if relPremAL = REL id ':' typedExp_in* '->' typedExp_out'*
  -- if premAL_rel = $iterate_prem(IC_rel, relPremAL)
  -- if premAL* = premAL_rel :: premAL_bind*

;;; Conditions

;; An equality with binders on one side binds that side

rulegroup Algo_prem/cond {

  rule Algo_prem/test:
    AC IC |- ifPrem : AC ([ premAL_if ])
    -- if IF typedExp = ifPrem
    -- if id* = $free_ids_exp(typedExp)
    -- if $is_bound(AC, id*)
    -- if premAL_if = $iterate_prem(IC, ifPrem)

  rule Algo_prem/let-left:
    AC IC |- ifPrem : AC' premAL*
    -- if IF typedExp = ifPrem
    -- if (CMP EQ typedExp_l typedExp_r) '#' _ = typedExp
    -- Collect_exp: AC |- typedExp_l : vari_l*
    -- if vari_l* =/= eps
    -- Collect_exp: AC |- typedExp_r : eps
    -- Algo_let:
        AC IC |- typedExp_l '=' typedExp_r : AC' premAL*

  rule Algo_prem/let-right:
    AC IC |- ifPrem : AC' premAL*
    -- if IF typedExp = ifPrem
    -- if (CMP EQ typedExp_l typedExp_r) '#' _ = typedExp
    -- Collect_exp: AC |- typedExp_l : eps
    -- Collect_exp: AC |- typedExp_r : vari_r*
    -- if vari_r* =/= eps
    -- Algo_let:
        AC IC |- typedExp_r '=' typedExp_l : AC' premAL*

}

rule Algo_let:
  AC IC |- typedExp_l '=' typedExp_r
         : AC' (premAL_let :: premAL_bind*)
  -- Bind_exps:
      AC IC |- [ typedExp_l ] : AC' ([ typedExp_l' ]) premAL_bind*
  -- if vari_r* = $free_vars_exp(typedExp_r)
  -- if vari_read* = $shallowest_vars(vari_r*)
  -- if vari_l* = $free_vars_exp(typedExp_l')
  -- if vari_bind* = $shallowest_vars(vari_l*)
  -- if IC_read = $restrict_iterCtx(IC, vari_read*)
  -- if IC_let = $add_binders_iterCtx(IC_read, vari_bind*)
  -- Iter_sourced: |- IC_let
  -- if premAL_let
      = $iterate_prem(IC_let, LET typedExp_l' '=' typedExp_r)

;;; Holding and non-holding relations

rule Algo_prem/ifhold:
  AC IC |- ifHoldPrem : AC ([ premAL_hold ])
  -- if IFHOLD id ':' typedExp* = ifHoldPrem
  -- if id_read* = $free_ids_exps(typedExp*)
  -- if $is_bound(AC, id_read*)
  -- if premAL_hold = $iterate_prem(IC, ifHoldPrem)

rule Algo_prem/ifnothold:
  AC IC |- ifNotHoldPrem : AC ([ premAL_hold ])
  -- if IFNOTHOLD id ':' typedExp* = ifNotHoldPrem
  -- if id_read* = $free_ids_exps(typedExp*)
  -- if $is_bound(AC, id_read*)
  -- if premAL_hold = $iterate_prem(IC, ifNotHoldPrem)

;;; Iterations

;; Binders of an iteration are decided by its premise; the elaborated
;; iteration lists every iterated variable as a source

rule Algo_prem/iter:
  AC IC |- ITER premIL (iter vari*) : AC' premAL*
  -- if premIterAL = iter '<-' vari* '->' eps
  -- if IC' = premIterAL :: IC
  -- Algo_prem: AC IC' |- premIL : AC' premAL*

;;; Debugging

rule Algo_prem/dbg:
  AC IC |- debugPrem : AC ([ premAL_debug ])
  -- if DEBUG typedExp = debugPrem
  -- if id* = $free_ids_exp(typedExp)
  -- if $is_bound(AC, id*)
  -- if premAL_debug = $iterate_prem(IC, debugPrem)

;; Premise sequences

;; Variables bound by a premise are bound for the following premises

rulegroup Algo_prems {

  rule Algo_prems/nil:
    AC |- eps : AC eps

  rule Algo_prems/cons:
    AC |- premIL_h :: premIL_t* : AC'' (premAL_h* ++ premAL_t*)
    -- if IC = eps
    -- Algo_prem: AC IC |- premIL_h : AC' premAL_h*
    -- Algo_prems: AC' |- premIL_t* : AC'' premAL_t*

}
