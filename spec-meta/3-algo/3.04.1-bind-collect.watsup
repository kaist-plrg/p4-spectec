;;
;; Binder collection in expressions
;;
;; syntax typedExp
;;

;; Unbound variables in a pattern are its binders.
;; Binders may appear only through invertible constructs:
;; upcasts, tuples, constructors, structs, options, lists, conses, and iterations.
;; Any other construct binds nothing, so all of its variables must be bound;
;; `-- if (x, y + 1) = e` with `y` unbound has no AL.

dec $is_invertible(typedExp) : bool
  hint(prose_true %0 "is an invertible construct")
  hint(prose_false %0 "is not an invertible construct")
def $is_invertible((VAR _) '#' _) = true
def $is_invertible((UPCAST _ _) '#' _) = true
def $is_invertible((TUP _) '#' _) = true
def $is_invertible((INJ _) '#' _) = true
def $is_invertible((STR _) '#' _) = true
def $is_invertible((OPT _) '#' _) = true
def $is_invertible((LIST _) '#' _) = true
def $is_invertible((CONS _ _) '#' _) = true
def $is_invertible((ITER _ _) '#' _) = true
def $is_invertible(_) = false
  -- otherwise

;;; VAR id

rulegroup Collectbind_exp/variable {

  rule Collectbind_exp/bound:
    AC |- (VAR id) '#' _ : eps
    -- if id <- $ids_of_varis(AC.BOUND)

  rule Collectbind_exp/binder:
    AC |- (VAR id) '#' typ : [ id typ eps ]
    -- if ~(id <- $ids_of_varis(AC.BOUND))

}

;;; UPCAST typ typedExp

rule Collectbind_exp/upcast:
  AC |- (UPCAST _ typedExp) '#' _ : vari*
  -- Collectbind_exp: AC |- typedExp : vari*

;;; TUP typedExp*

rule Collectbind_exp/tuple:
  AC |- (TUP typedExp*) '#' _ : vari*
  -- Collectbind_exps: AC |- typedExp* : vari*

;;; INJ expCase

rule Collectbind_exp/case:
  AC |- (INJ (_ typedExp*)) '#' _ : vari*
  -- Collectbind_exps: AC |- typedExp* : vari*

;;; STR expField*

rule Collectbind_exp/struct:
  AC |- (STR expField*) '#' _ : vari*
  -- (if _ typedExp = expField)*
  -- Collectbind_exps: AC |- typedExp* : vari*

;;; OPT typedExp?

rulegroup Collectbind_exp/opt {

  rule Collectbind_exp/none:
    AC |- (OPT eps) '#' _ : eps

  rule Collectbind_exp/some:
    AC |- (OPT typedExp) '#' _ : vari*
    -- Collectbind_exp: AC |- typedExp : vari*

}

;;; LIST typedExp*

rule Collectbind_exp/list:
  AC |- (LIST typedExp*) '#' _ : vari*
  -- Collectbind_exps: AC |- typedExp* : vari*

;;; CONS typedExp typedExp

rule Collectbind_exp/cons:
  AC |- (CONS typedExp_h typedExp_t) '#' _ : vari*
  -- Collectbind_exps:
      AC |- [ typedExp_h, typedExp_t ] : vari*

;;; ITER typedExp expIter

rule Collectbind_exp/iter:
  AC |- (ITER typedExp (iter _)) '#' _ : vari_iter*
  -- Collectbind_exp: AC |- typedExp : vari*
  -- if (vari_iter = $iterate_vari(vari, [ iter ]))*

;;; BOOL bool | num | TEXT text | UN unOp typedExp | BIN binOp typedExp typedExp
;;; CMP cmpOp typedExp typedExp | DOWNCAST typ typedExp | SUB typedExp typ
;;; MATCH typedExp pat | CAT typedExp typedExp | MEM typedExp typedExp | LEN typedExp
;;; DOT typedExp atom | IDX typedExp typedExp | SLICE typedExp typedExp typedExp
;;; UPD typedExp typedPath typedExp | CALL id targ* arg*

rule Collectbind_exp/noninvertible:
  AC |- typedExp : eps
  -- if ~$is_invertible(typedExp)
  -- if id* = $ids_of_varis($free_varis_exp(typedExp))
  -- if $forall_((id <- $ids_of_varis(AC.BOUND))*)

;;
;; Binder collection in expression sequences
;;
;; syntax typedExp*
;;

rulegroup Collectbind_exps {

  rule Collectbind_exps/nil:
    AC |- eps : eps

  rule Collectbind_exps/cons:
    AC |- typedExp_h :: typedExp_t* : vari_h* ++ vari_t*
    -- Collectbind_exp: AC |- typedExp_h : vari_h*
    -- Collectbind_exps: AC |- typedExp_t* : vari_t*

}

;;
;; Binder collection in arguments
;;
;; syntax arg
;;

;;; EXP typedExp

rule Collectbind_arg/exp:
  AC |- EXP typedExp : vari*
  -- Collectbind_exp: AC |- typedExp : vari*

;;; FUN id

rule Collectbind_arg/fun:
  AC |- FUN _ : eps

;;
;; Binder collection in argument sequences
;;
;; syntax arg*
;;

rulegroup Collectbind_args {

  rule Collectbind_args/nil:
    AC |- eps : eps

  rule Collectbind_args/cons:
    AC |- arg_h :: arg_t* : vari_h* ++ vari_t*
    -- Collectbind_arg: AC |- arg_h : vari_h*
    -- Collectbind_args: AC |- arg_t* : vari_t*

}
