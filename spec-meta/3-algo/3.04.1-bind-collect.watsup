;; Binder collection

;; Unbound variables in a pattern are its binders.
;; Binders may appear only through invertible constructs;
;; a binder under any other construct has no derivation,
;; so `-- if (x, y + 1) = e` with `y` unbound has no AL.

;; Expressions

rulegroup Collect_exp/variable {

  rule Collect_exp/bound:
    AC |- (VAR id) '#' _ : eps
    -- if id <- AC.BOUND

  rule Collect_exp/binder:
    AC |- (VAR id) '#' typ : [ id typ eps ]
    -- if ~(id <- AC.BOUND)

}

;;; Invertible constructs

rule Collect_exp/upcast:
  AC |- (UPCAST _ typedExp) '#' _ : vari*
  -- Collect_exp: AC |- typedExp : vari*

rule Collect_exp/tuple:
  AC |- (TUP typedExp*) '#' _ : vari*
  -- Collect_exps: AC |- typedExp* : vari*

rule Collect_exp/case:
  AC |- (INJ (_ typedExp*)) '#' _ : vari*
  -- Collect_exps: AC |- typedExp* : vari*

rule Collect_exp/struct:
  AC |- (STR expField*) '#' _ : vari*
  -- (if _ typedExp = expField)*
  -- Collect_exps: AC |- typedExp* : vari*

rulegroup Collect_exp/opt {

  rule Collect_exp/none:
    AC |- (OPT eps) '#' _ : eps

  rule Collect_exp/some:
    AC |- (OPT typedExp) '#' _ : vari*
    -- Collect_exp: AC |- typedExp : vari*

}

rule Collect_exp/list:
  AC |- (LIST typedExp*) '#' _ : vari*
  -- Collect_exps: AC |- typedExp* : vari*

rule Collect_exp/cons:
  AC |- (CONS typedExp_h typedExp_t) '#' _ : vari*
  -- Collect_exps:
      AC |- [ typedExp_h, typedExp_t ] : vari*

rule Collect_exp/iter:
  AC |- (ITER typedExp (iter _)) '#' _ : vari_iter*
  -- Collect_exp: AC |- typedExp : vari*
  -- if (vari_iter = $iter_vari(vari, iter))*

;;; Non-invertible constructs bind nothing

rulegroup Collect_exp/literal {

  rule Collect_exp/boolean:
    AC |- (BOOL _) '#' _ : eps

  rule Collect_exp/number:
    AC |- num '#' _ : eps

  rule Collect_exp/text:
    AC |- (TEXT _) '#' _ : eps

}

rule Collect_exp/unary:
  AC |- (UN _ typedExp) '#' _ : eps
  -- Collect_exp: AC |- typedExp : eps

rule Collect_exp/binary:
  AC |- (BIN _ typedExp_l typedExp_r) '#' _ : eps
  -- Collect_exps:
      AC |- [ typedExp_l, typedExp_r ] : eps

rule Collect_exp/compare:
  AC |- (CMP _ typedExp_l typedExp_r) '#' _ : eps
  -- Collect_exps:
      AC |- [ typedExp_l, typedExp_r ] : eps

rule Collect_exp/downcast:
  AC |- (DOWNCAST _ typedExp) '#' _ : eps
  -- Collect_exp: AC |- typedExp : eps

rule Collect_exp/subtype:
  AC |- (SUB typedExp _) '#' _ : eps
  -- Collect_exp: AC |- typedExp : eps

rule Collect_exp/match:
  AC |- (MATCH typedExp _) '#' _ : eps
  -- Collect_exp: AC |- typedExp : eps

rule Collect_exp/concat:
  AC |- (CAT typedExp_l typedExp_r) '#' _ : eps
  -- Collect_exps:
      AC |- [ typedExp_l, typedExp_r ] : eps

rule Collect_exp/mem:
  AC |- (MEM typedExp_l typedExp_r) '#' _ : eps
  -- Collect_exps:
      AC |- [ typedExp_l, typedExp_r ] : eps

rule Collect_exp/len:
  AC |- (LEN typedExp) '#' _ : eps
  -- Collect_exp: AC |- typedExp : eps

rule Collect_exp/dot:
  AC |- (DOT typedExp _) '#' _ : eps
  -- Collect_exp: AC |- typedExp : eps

rule Collect_exp/idx:
  AC |- (IDX typedExp_b typedExp_i) '#' _ : eps
  -- Collect_exps:
      AC |- [ typedExp_b, typedExp_i ] : eps

rule Collect_exp/slice:
  AC |- (SLICE typedExp_b typedExp_i typedExp_n) '#' _ : eps
  -- Collect_exps:
      AC |- [ typedExp_b, typedExp_i, typedExp_n ] : eps

rule Collect_exp/upd:
  AC |- (UPD typedExp_b typedPath typedExp_f) '#' _ : eps
  -- Collect_exps:
      AC |- [ typedExp_b, typedExp_f ] : eps
  -- Collect_path: AC |- typedPath : eps

rule Collect_exp/call:
  AC |- (CALL _ _ arg*) '#' _ : eps
  -- Collect_args: AC |- arg* : eps

;;; Sequences

rulegroup Collect_exps {

  rule Collect_exps/nil:
    AC |- eps : eps

  rule Collect_exps/cons:
    AC |- typedExp_h :: typedExp_t* : vari_h* ++ vari_t*
    -- Collect_exp: AC |- typedExp_h : vari_h*
    -- Collect_exps: AC |- typedExp_t* : vari_t*

}

;; Paths

rule Collect_path/root:
  AC |- ROOT '#' _ : eps

rule Collect_path/idx:
  AC |- (IDX typedPath typedExp_i) '#' _
      : vari_p* ++ vari_i*
  -- Collect_path: AC |- typedPath : vari_p*
  -- Collect_exp: AC |- typedExp_i : vari_i*

rule Collect_path/slice:
  AC |- (SLICE typedPath typedExp_i typedExp_n) '#' _
      : vari_p* ++ vari_e*
  -- Collect_path: AC |- typedPath : vari_p*
  -- Collect_exps:
      AC |- [ typedExp_i, typedExp_n ] : vari_e*

rule Collect_path/dot:
  AC |- (DOT typedPath _) '#' _ : vari*
  -- Collect_path: AC |- typedPath : vari*

;; Arguments

rule Collect_arg/exp:
  AC |- EXP typedExp : vari*
  -- Collect_exp: AC |- typedExp : vari*

rule Collect_arg/fun:
  AC |- FUN _ : eps

;;; Sequences

rulegroup Collect_args {

  rule Collect_args/nil:
    AC |- eps : eps

  rule Collect_args/cons:
    AC |- arg_h :: arg_t* : vari_h* ++ vari_t*
    -- Collect_arg: AC |- arg_h : vari_h*
    -- Collect_args: AC |- arg_t* : vari_t*

}
