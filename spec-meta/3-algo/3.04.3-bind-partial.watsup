;;; consExp
;;; syntax consExp = CONS typedExp typedExp

rule Partialbind_binder_exp/cons:
  AC IC |- consExp '#' typ
         : AC_fresh IC_fresh typedExp_d premAL_part*
  -- if CONS typedExp_h typedExp_t = consExp
