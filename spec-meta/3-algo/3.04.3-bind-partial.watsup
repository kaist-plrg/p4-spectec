;;; strExp
;;; syntax strExp = STR expField*

rule Partialbind_binder_exp/struct:
  AC IC |- strExp '#' typ
         : AC_sub IC_sub (strExp_part '#' typ) premAL*
  -- if STR expField* = strExp
  -- (if atom typedExp = expField)*
