;;; iterExp
;;; syntax iterExp = ITER typedExp expIter

;; An iterated pattern is decomposed under one more iteration,
;; which then iterates the variables left in the decomposed pattern

rule Partialbind_binder_exp/iter:
  AC IC |- iterExp '#' typ
         : AC_sub IC_sub (iterExp_part '#' typ) premAL*
  -- if ITER typedExp (iter vari*) = iterExp
  ---- ;; decompose the body under one more iteration
  -- if IC' = (iter vari*) :: IC
  -- Partialbind_exp:
      AC IC' |- typedExp : AC_sub IC'' typedExp_part premAL*
  -- if (iter vari_iter*) :: IC_sub = IC''
  ---- ;; iterate the variables the decomposed body still reads
  -- if vari_part* = $select_varis(vari_iter*, $ids_of_varis($free_varis_exp(typedExp_part)))
  -- if iterExp_part = ITER typedExp_part (iter vari_part*)

;;
;; Decomposing pattern sequences
;;
;; syntax typedExp*
;;

rulegroup Partialbind_exps {

  rule Partialbind_exps/nil:
    AC IC |- eps : AC IC eps eps

  rule Partialbind_exps/cons:
    AC IC |- (typedExp_h :: typedExp_t*)
           : AC_t IC_t typedExp* premAL*
    -- Partialbind_exp:
        AC IC |- typedExp_h : AC_h IC_h typedExp_h_part premAL_h*
    -- Partialbind_exps:
        AC_h IC_h |- typedExp_t* : AC_t IC_t typedExp_t_part* premAL_t*
    -- if typedExp* = typedExp_h_part :: typedExp_t_part*
    -- if premAL* = premAL_h* ++ premAL_t*

}

;;
;; Decomposing argument patterns
;;
;; syntax arg
;;

;; An argument is bound outside any iteration

;;; expArg
;;; syntax expArg = EXP typedExp

rule Partialbind_arg/exp:
  AC |- expArg : AC_part expArg_part premAL*
  -- if EXP typedExp = expArg
  -- Partialbind_exp:
      AC eps |- typedExp : AC_part _ typedExp_part premAL*
  -- if expArg_part = EXP typedExp_part

;;; funArg
;;; syntax funArg = FUN id

rule Partialbind_arg/fun:
  AC |- funArg : AC funArg eps

;;
;; Decomposing argument pattern sequences
;;
;; syntax arg*
;;

rulegroup Partialbind_args {

  rule Partialbind_args/nil:
    AC |- eps : AC eps eps

  rule Partialbind_args/cons:
    AC |- arg_h :: arg_t* : AC_t arg* premAL*
    -- Partialbind_arg: AC |- arg_h : AC_h arg_h_part premAL_h*
    -- Partialbind_args: AC_h |- arg_t* : AC_t arg_t_part* premAL_t*
    -- if arg* = arg_h_part :: arg_t_part*
    -- if premAL* = premAL_h* ++ premAL_t*

}
