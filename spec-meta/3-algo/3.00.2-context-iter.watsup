;; Iteration context

;; Enclosing iterations, innermost first, each with the variables it
;; iterates at the dimension inside it: the variables the elaboration lists,
;; and the fresh variables that binding introduces under it

syntax iterCtx = premIterIL*

var IC : iterCtx

;;; Iterated variables

dec $add_iterated(iterCtx, vari) : iterCtx
  hint(prose_in %0 "with" %1 "iterated at every level")
def $add_iterated(eps, _) = eps
def $add_iterated((iter vari*) :: IC, vari_new)
  = (iter (vari* ++ [ vari_new ])) :: $add_iterated(IC, vari_lift)
  -- if vari_lift = $iterate_vari(iter, vari_new)

dec $lift_vari(iterCtx, vari) : vari
  hint(prose_in %1 "lifted out of" %0)
def $lift_vari(eps, vari) = vari
def $lift_vari((iter _) :: IC, vari) = $lift_vari(IC, $iterate_vari(iter, vari))

dec $varis_in(vari*, id*) : vari*
  hint(prose_in "the variables in" %0 "named in" %1)
def $varis_in(eps, _) = eps
def $varis_in(vari_h :: vari_t*, id*) = vari_h :: $varis_in(vari_t*, id*)
  -- if id_h _ _ = vari_h
  -- if id_h <- id*
def $varis_in(vari_h :: vari_t*, id*) = $varis_in(vari_t*, id*)
  -- if id_h _ _ = vari_h
  -- if ~(id_h <- id*)

;;; Annotating iterations

;; A premise iterates over the iterated variables it reads,
;; and binds the variables of its patterns at every level:
;;
;;   -- (let x = z + 1)*{x <- x*, z <- z*}
;;
;; becomes
;;
;;   -- (let x = z + 1)*{z <- z*, x -> x*}

dec $annotate(iterCtx, id*, vari*) : premIterAL*
  hint(prose_in "the iterations of" %0 "reading" %1 "and binding" %2)
def $annotate(eps, _, _) = eps
def $annotate((iter vari*) :: IC, id_read*, vari_bind*)
  = (iter '<-' vari_src* '->' vari_bind*) :: $annotate(IC, id_read*, vari_lift*)
  -- if vari_src* = $varis_in(vari*, id_read*)
  -- if (vari_lift = $iterate_vari(iter, vari_bind))*

;; An iteration without a source has no length to follow

relation Iter_sourced:
  |- premIterAL*
  hint(input %0)
  hint(prose_in "every iteration in" %0 "has a source")

rule Iter_sourced:
  |- premIterAL*
  -- if (_ '<-' vari_src* '->' _)* = premIterAL*
  -- if (vari_src* =/= eps)*

dec $iterate_prem(premIterAL*, premAL) : premAL
  hint(prose_in "the iteration of" %1 "over" %0)
def $iterate_prem(eps, premAL) = premAL
def $iterate_prem(premIterAL :: premIterAL_t*, premAL)
  = $iterate_prem(premIterAL_t*, ITER premAL premIterAL)

;;; Bound variables

;; A variable read under iterations is bound when a bound variable of its name
;; has a dimension that the read, lifted out of the iterations, extends:
;; a scalar may be read inside an iteration, but an iterated variable
;; may not be read as a scalar

dec $is_bound_vari(vari*, vari) : bool
  hint(prose_true %1 "is bound by some variable in" %0)
  hint(prose_false %1 "is bound by no variable in" %0)
def $is_bound_vari(eps, _) = false
def $is_bound_vari(vari_h :: _, vari) = true
  -- if id _ _ = vari
  -- if id _ _ = vari_h
  -- if $is_prefix_dim(vari_h, vari)
def $is_bound_vari(vari_h :: vari_t*, vari) = $is_bound_vari(vari_t*, vari)
  -- if id _ _ = vari
  -- if id_h _ _ = vari_h
  -- if id_h =/= id \/ ~$is_prefix_dim(vari_h, vari)

dec $is_bound(algoCtx, iterCtx, vari*) : bool
  hint(prose_true "variables" %2 "read under" %1 "are all bound in" %0)
  hint(prose_false "some variable in" %2 "read under" %1 "is not bound in" %0)
def $is_bound(AC, IC, vari*) = $forall_($is_bound_vari(AC.BOUND, $lift_vari(IC, vari))*)
