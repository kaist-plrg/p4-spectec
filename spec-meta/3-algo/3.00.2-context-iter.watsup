;;
;; Iteration context
;;

;; Enclosing iterations, innermost first,
;; each with the variables it iterates at the dimension inside it

syntax iterCtx = premIterIL*

var IC : iterCtx

;;; Adding iterated variables

;; A variable bound inside the iterations is iterated at every level,
;; at its dimension inside that level, unless the level already lists it.
;; Adding `x` to the context of `((-- let x = z + 1)*{z})?{z*}`
;;
;;   [ *{z}, ?{z*} ]
;;
;; gives
;;
;;   [ *{z, x}, ?{z*, x*} ]

dec $add_iterated(iterCtx, vari*) : iterCtx
  hint(prose_in %0 "with" %1 "iterated at every level")

def $add_iterated(eps, _) = eps
def $add_iterated((iter vari*) :: IC, vari_new*)
  = (iter (vari* ++ vari_add*)) :: IC'
  ---- ;; a variable the level already iterates is not added again
  -- if vari_add* = $drop_varis(vari_new*, $ids_of_varis(vari*))
  -- (if vari_lift = $iterate_vari(vari_new, [ iter ]))*
  -- if IC' = $add_iterated(IC, vari_lift*)

;;; Premise iterations

;; Once its binders are added to the context,
;; each level's variables split into those a premise reads and those it binds:
;;
;;   -- (let x = z + 1)*{x <- x*, z <- z*}
;;
;; becomes
;;
;;   -- (let x = z + 1)*{z <- z*, x -> x*}

dec $prem_iters(iterCtx, id*, id*) : premIterAL*
  hint(prose_in "the iterations of" %0 "reading" %1 "and binding" %2)

def $prem_iters(eps, _, _) = eps
def $prem_iters((iter vari*) :: IC, id_read*, id_bind*)
  = premIterAL_inner :: premIterAL_outer*
  -- if vari_read* = $select_varis(vari*, id_read*)
  -- if vari_bind* = $select_varis(vari*, id_bind*)
  -- if premIterAL_inner = iter '<-' vari_read* '->' vari_bind*
  -- if premIterAL_outer* = $prem_iters(IC, id_read*, id_bind*)

;; An iteration without a source has no length to follow

relation Iter_sourced:
  |- premIterAL*
  hint(input %0)
  hint(prose_in "every iteration in" %0 "has a source")

rule Iter_sourced:
  |- premIterAL*
  -- if (_ '<-' vari_src* '->' _)* = premIterAL*
  -- if (vari_src* =/= eps)*

dec $iterate_prem(premAL, premIterAL*) : premAL
  hint(prose_in "the iteration of" %0 "over" %1)
def $iterate_prem(premAL, eps) = premAL
def $iterate_prem(premAL, premIterAL :: premIterAL_t*)
  = $iterate_prem(ITER premAL premIterAL, premIterAL_t*)

;;; Bound variables

;; A variable read under iterations is bound when a bound variable of its name
;; has a dimension that the read, iterated by the enclosing iterations, extends:
;; a scalar may be read inside an iteration, but an iterated variable
;; may not be read as a scalar

dec $is_bound_vari(vari*, vari) : bool
  hint(prose_true %1 "is bound by some variable in" %0)
  hint(prose_false %1 "is bound by no variable in" %0)
def $is_bound_vari(eps, _) = false
def $is_bound_vari(vari_h :: _, vari) = true
  ---- ;; a variable of the same name has a dimension the read extends
  -- if id _ _ = vari
  -- if id _ _ = vari_h
  -- if $is_prefix_dim(vari_h, vari)
def $is_bound_vari(vari_h :: vari_t*, vari) = $is_bound_vari(vari_t*, vari)
  ---- ;; the head has another name or a dimension the read does not extend
  -- if id _ _ = vari
  -- if id_h _ _ = vari_h
  -- if id_h =/= id \/ ~$is_prefix_dim(vari_h, vari)

dec $is_bound(algoCtx, iterCtx, vari*) : bool
  hint(prose_true "variables" %2 "read under" %1 "are all bound in" %0)
  hint(prose_false "some variable in" %2 "read under" %1 "is not bound in" %0)
def $is_bound(AC, IC, vari*) = $forall_($is_bound_vari(AC.BOUND, $iterate_vari(vari, iter*))*)
  -- if (iter _)* = IC
