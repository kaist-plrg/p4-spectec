;; Rules

;; A rule binds its inputs, then runs its premises and returns its outputs

rule Algo_rul:
  AC inputHint |- rulIL : rulAL
  -- if id ':' typedExp* '-' premIL* = rulIL
  -- if id_used* = $free_ids_rulIL(rulIL)
  -- if AC_rul = $add_used(AC, id_used*)
  -- if (typedExp_in*, typedExp_out*)
      = $split_inputs<typedExp>(inputHint, typedExp*)
  -- Bind_exps:
      AC_rul eps |- typedExp_in* : AC_in typedExp_in'* premAL_bind*
  -- Algo_prems: AC_in |- premIL* : AC_body premAL*
  -- if id_out* = $free_ids_exps(typedExp_out*)
  -- if $is_bound(AC_body, id_out*)
  -- if rulAL
      = id ':' typedExp_in'* '->' typedExp_out*
        '-' (premAL_bind* ++ premAL*)

rule Algo_rulGroup:
  AC inputHint |- rulGroupIL : rulGroupAL
  -- if id ':' rulIL* = rulGroupIL
  -- (Algo_rul: AC inputHint |- rulIL : rulAL)*
  -- if rulGroupAL = id ':' rulAL*

rule Algo_elsGroup:
  AC inputHint |- elsGroupIL : elsGroupAL
  -- if id ':' rulIL = elsGroupIL
  -- Algo_rul: AC inputHint |- rulIL : rulAL
  -- if elsGroupAL = id ':' rulAL

;; Clauses

;; A clause binds its arguments, runs its premises, and returns its result

rule Algo_clause:
  AC |- clauseIL : clauseAL
  -- if arg* '=' typedExp '-' premIL* = clauseIL
  -- if id_used* = $free_ids_clauseIL(clauseIL)
  -- if AC_clause = $add_used(AC, id_used*)
  -- Bind_args: AC_clause |- arg* : AC_arg arg'* premAL_arg*
  -- Algo_prems: AC_arg |- premIL* : AC_body premAL*
  -- if id_body* = $free_ids_exp(typedExp)
  -- if $is_bound(AC_body, id_body*)
  -- if clauseAL
      = arg'* '=' typedExp '-' (premAL_arg* ++ premAL*)

;; Definitions

rule Algo_def/typ:
  AC |- typDefn : typDefn

rulegroup Algo_def/rel {

  rule Algo_def/extern:
    AC |- externRelDefnIL : externRelDefnAL
    -- if EXTREL id ':' typ* `( inputHint `) = externRelDefnIL
    -- if (typ_in*, typ_out*) = $split_inputs<typ>(inputHint, typ*)
    -- if externRelDefnAL = EXTREL id ':' typ_in* '->' typ_out*

  rule Algo_def/defined:
    AC |- definedRelDefnIL : definedRelDefnAL
    -- if REL id ':' typ* `( inputHint `) '=' rulGroupIL* elsGroupIL?
        = definedRelDefnIL
    -- if (typ_in*, typ_out*) = $split_inputs<typ>(inputHint, typ*)
    -- (Algo_rulGroup: AC inputHint |- rulGroupIL : rulGroupAL)*
    -- (Algo_elsGroup: AC inputHint |- elsGroupIL : elsGroupAL)?
    -- if definedRelDefnAL
        = REL id ':' typ_in* '->' typ_out* '=' rulGroupAL* elsGroupAL?

}

rulegroup Algo_def/func {

  rule Algo_def/extern:
    AC |- externFuncDefn : externFuncDefn

  rule Algo_def/builtin:
    AC |- builtinFuncDefn : builtinFuncDefn

  rule Algo_def/table:
    AC |- tableFuncDefnIL : tableFuncDefnAL
    -- if TABLEFUNC id param* ':' typ '=' tblRowIL* = tableFuncDefnIL
    -- if (EXP typ_param)* = param*
    -- (if arg* '=' _ = tblRowIL)*
    -- (if |arg*| = |param*|)*
    -- (Algo_tblRow: AC |- tblRowIL : tblRowAL)*
    -- TblRows_cover: AC typ_param* |- tblRowIL*
    -- if tableFuncDefnAL = TABLEFUNC id param* ':' typ '=' tblRowAL*

  rule Algo_def/defined:
    AC |- definedFuncDefnIL : definedFuncDefnAL
    -- if FUNC id tparam* param* ':' typ '=' clauseIL* elsClauseIL?
        = definedFuncDefnIL
    -- if AC_func = $add_tparams(AC, tparam*)
    -- (Algo_clause: AC_func |- clauseIL : clauseAL)*
    -- (Algo_clause: AC_func |- elsClauseIL : elsClauseAL)?
    -- if definedFuncDefnAL
        = FUNC id tparam* param* ':' typ '=' clauseAL* elsClauseAL?

}
