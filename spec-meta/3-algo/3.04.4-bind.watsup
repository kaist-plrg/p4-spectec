;;
;; Binding patterns
;;
;; syntax typedExp*
;;

;; Repeated binders are renamed with equalities of their occurrences,
;; and partially bound patterns decomposed.
;; Repeated binders are renamed first, so each occurrence is bound once.
;; The equalities follow the decomposition premises,
;; which bind the occurrences inside decomposed sub-patterns.

rule Bind_exps:
  AC IC |- typedExp* : AC_bound typedExp_part* (premAL_part* ++ premAL_eq*)
  ---- ;; rename repeated binders, requiring their occurrences to be equal
  -- Multibind_exps: AC IC |- typedExp* : AC_multi typedExp_multi* premAL_eq*
  ---- ;; decompose partially bound sub-patterns into fresh variables
  -- Partialbind_exps:
      AC_multi IC |- typedExp_multi* : AC_part _ typedExp_part* premAL_part*
  ---- ;; bind every occurrence, now distinct, outside the iterations
  -- Collectbind_exps: AC_multi |- typedExp_multi* : vari_bind*
  -- if (iter _)* = IC
  -- if AC_bound = $add_bound(AC_part, $iterate_vari(vari_bind, iter*)*)

;;
;; Binding argument patterns
;;
;; syntax arg*
;;

rule Bind_args:
  AC |- arg* : AC_bound arg_part* (premAL_part* ++ premAL_eq*)
  ---- ;; rename repeated binders, requiring their occurrences to be equal
  -- Multibind_args: AC |- arg* : AC_multi arg_multi* premAL_eq*
  ---- ;; decompose partially bound sub-patterns into fresh variables
  -- Partialbind_args: AC_multi |- arg_multi* : AC_part arg_part* premAL_part*
  ---- ;; bind every occurrence, now distinct
  -- Collectbind_args: AC_multi |- arg_multi* : vari_bind*
  -- if AC_bound = $add_bound(AC_part, vari_bind*)
