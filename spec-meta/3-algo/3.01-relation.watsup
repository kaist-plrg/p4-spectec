;; Binder collection

relation Collect_exp:
  algoCtx |- typedExp : vari*
  hint(input %0 %1)
  hint(prose_in "collecting the binders of" %1 "under" %0)
  hint(prose_out %2)

relation Collect_exps:
  algoCtx |- typedExp* : vari*
  hint(input %0 %1)
  hint(prose_in "collecting the binders of" %1 "under" %0)
  hint(prose_out %2)

relation Collect_path:
  algoCtx |- typedPath : vari*
  hint(input %0 %1)
  hint(prose_in "collecting the binders of" %1 "under" %0)
  hint(prose_out %2)

relation Collect_arg:
  algoCtx |- arg : vari*
  hint(input %0 %1)
  hint(prose_in "collecting the binders of" %1 "under" %0)
  hint(prose_out %2)

relation Collect_args:
  algoCtx |- arg* : vari*
  hint(input %0 %1)
  hint(prose_in "collecting the binders of" %1 "under" %0)
  hint(prose_out %2)

;; Multibind

relation Multibind_renamer:
  |- vari* : renamer
  hint(input %0)
  hint(prose_in "the renamer for the repeated binders in" %0)
  hint(prose_out %1)

relation Multibind_exp:
  algoCtx renamer |- typedExp : algoCtx renamer typedExp
  hint(input %0 %1 %2)
  hint(prose_in "renaming the repeated binders of" %2 "with" %1 "under" %0)
  hint(prose_out %3 %4 %5)

relation Multibind_exp_repeated:
  algoCtx renamer |- typedExp : algoCtx renamer typedExp
  hint(input %0 %1 %2)
  hint(prose_in "renaming the repeated binders inside pattern" %2 "with" %1 "under" %0)
  hint(prose_out %3 %4 %5)

relation Multibind_exps:
  algoCtx renamer |- typedExp* : algoCtx renamer typedExp*
  hint(input %0 %1 %2)
  hint(prose_in "renaming the repeated binders of" %2 "with" %1 "under" %0)
  hint(prose_out %3 %4 %5)

relation Multibind_args:
  algoCtx renamer |- arg* : algoCtx renamer arg*
  hint(input %0 %1 %2)
  hint(prose_in "renaming the repeated binders of" %2 "with" %1 "under" %0)
  hint(prose_out %3 %4 %5)

relation Multibind_eqs:
  iterCtx |- renamer : premAL*
  hint(input %0 %1)
  hint(prose_in "the equalities of the renamed binders in" %1 "under" %0)
  hint(prose_out %2)

;; Partialbind

relation Partialbind_exp:
  algoCtx iterCtx |- iterCtx typedExp : algoCtx iterCtx typedExp premAL*
  hint(input %0 %1 %2 %3)
  hint(prose_in "decomposing pattern" %3 "inside iterations" %2
                "of a premise iterated over" %1 "under" %0)
  hint(prose_out %4 %5 %6 %7)

relation Partialbind_exp_decomposed:
  algoCtx iterCtx |- iterCtx typedExp : algoCtx iterCtx typedExp premAL*
  hint(input %0 %1 %2 %3)
  hint(prose_in "decomposing binding pattern" %3 "inside iterations" %2
                "of a premise iterated over" %1 "under" %0)
  hint(prose_out %4 %5 %6 %7)

relation Partialbind_exps:
  algoCtx iterCtx |- iterCtx typedExp* : algoCtx iterCtx typedExp* premAL*
  hint(input %0 %1 %2 %3)
  hint(prose_in "decomposing patterns" %3 "inside iterations" %2
                "of a premise iterated over" %1 "under" %0)
  hint(prose_out %4 %5 %6 %7)

relation Partialbind_args:
  algoCtx |- arg* : algoCtx arg* premAL*
  hint(input %0 %1)
  hint(prose_in "decomposing argument patterns" %1 "under" %0)
  hint(prose_out %2 %3 %4)

relation Partialbind_check:
  iterCtx vari |- typedExp : premAL
  hint(input %0 %1 %2)
  hint(prose_in "checking" %2 "on the fresh variable" %1 "over" %0)
  hint(prose_out %3)

relation Partialbind_destructure:
  iterCtx vari |- typedExp '=' typedExp : premAL
  hint(input %0 %1 %2 %3)
  hint(prose_in "binding pattern" %2 "to" %3 "from the fresh variable" %1 "over" %0)
  hint(prose_out %4)

;; Binding

relation Bind_exps:
  algoCtx iterCtx |- typedExp* : algoCtx typedExp* premAL*
  hint(input %0 %1 %2)
  hint(prose_in "binding patterns" %2 "of a premise iterated over" %1 "under" %0)
  hint(prose_out %3 %4 %5)

relation Bind_args:
  algoCtx |- arg* : algoCtx arg* premAL*
  hint(input %0 %1)
  hint(prose_in "binding argument patterns" %1 "under" %0)
  hint(prose_out %2 %3 %4)

;; Premises

relation Algo_prem:
  algoCtx iterCtx |- premIL : algoCtx premAL*
  hint(input %0 %1 %2)
  hint(prose_in "converting premise" %2 "iterated over" %1 "under" %0)
  hint(prose_out %3 %4)

relation Algo_let:
  algoCtx iterCtx |- typedExp '=' typedExp : algoCtx premAL*
  hint(input %0 %1 %2 %3)
  hint(prose_in "converting the binding of" %2 "to" %3 "iterated over" %1 "under" %0)
  hint(prose_out %4 %5)

relation Algo_prems:
  algoCtx |- premIL* : algoCtx premAL*
  hint(input %0 %1)
  hint(prose_in "converting premises" %1 "in order under" %0)
  hint(prose_out %2 %3)

;; Tables

relation Exp_shallow:
  algoCtx |- typedExp
  hint(input %0 %1)
  hint(prose_in %1 "is a shallow table pattern under" %0)

relation Exp_irrefutable:
  algoCtx |- typedExp
  hint(input %0 %1)
  hint(prose_in %1 "matches every value of its type under" %0)

relation Algo_tblRow:
  algoCtx |- tblRowIL : tblRowAL
  hint(input %0 %1)
  hint(prose_in "converting table row" %1 "under" %0)
  hint(prose_out %2)

relation TblRows_cover:
  algoCtx typ* |- tblRowIL*
  hint(input %0 %1 %2)
  hint(prose_in "the rows" %2 "are exclusive and complete for parameter types" %1
                "under" %0)

;; Definitions

relation Algo_rul:
  algoCtx inputHint |- rulIL : rulAL
  hint(input %0 %1 %2)
  hint(prose_in "converting rule" %2 "with input positions" %1 "under" %0)
  hint(prose_out %3)

relation Algo_rulGroup:
  algoCtx inputHint |- rulGroupIL : rulGroupAL
  hint(input %0 %1 %2)
  hint(prose_in "converting rule group" %2 "with input positions" %1 "under" %0)
  hint(prose_out %3)

relation Algo_elsGroup:
  algoCtx inputHint |- elsGroupIL : elsGroupAL
  hint(input %0 %1 %2)
  hint(prose_in "converting otherwise group" %2 "with input positions" %1 "under" %0)
  hint(prose_out %3)

relation Algo_clause:
  algoCtx |- clauseIL : clauseAL
  hint(input %0 %1)
  hint(prose_in "converting clause" %1 "under" %0)
  hint(prose_out %2)

relation Algo_def:
  algoCtx |- defnIL : defnAL
  hint(input %0 %1)
  hint(prose_in "converting definition" %1 "under" %0)
  hint(prose_out %2)

;; Guards

relation Guard_exp:
  algoCtx |- typedExp : premAL*
  hint(input %0 %1)
  hint(prose_in "the guards for evaluating" %1 "under" %0)
  hint(prose_out %2)

relation Guard_exps:
  algoCtx |- typedExp* : premAL*
  hint(input %0 %1)
  hint(prose_in "the guards for evaluating" %1 "in order under" %0)
  hint(prose_out %2)

relation Guard_path:
  algoCtx |- typedExp typedPath typedExp : premAL*
  hint(input %0 %1 %2 %3)
  hint(prose_in "the guards for updating path" %2 "of" %1 "with" %3 "under" %0)
  hint(prose_out %4)

relation Guard_args:
  algoCtx |- arg* : premAL*
  hint(input %0 %1)
  hint(prose_in "the guards for evaluating arguments" %1 "under" %0)
  hint(prose_out %2)

relation Guard_prem:
  algoCtx |- premAL : premAL*
  hint(input %0 %1)
  hint(prose_in "the guards to check before premise" %1 "under" %0)
  hint(prose_out %2)

relation Guard_prems:
  algoCtx |- premAL* : premAL*
  hint(input %0 %1)
  hint(prose_in "premises" %1 "each preceded by its guards under" %0)
  hint(prose_out %2)

relation Guard_rul:
  algoCtx |- rulAL : rulAL
  hint(input %0 %1)
  hint(prose_in "guarding rule" %1 "under" %0)
  hint(prose_out %2)

relation Guard_clause:
  algoCtx |- clauseAL : clauseAL
  hint(input %0 %1)
  hint(prose_in "guarding clause" %1 "under" %0)
  hint(prose_out %2)

relation Guard_tblRow:
  algoCtx |- tblRowAL : tblRowAL
  hint(input %0 %1)
  hint(prose_in "guarding table row" %1 "under" %0)
  hint(prose_out %2)

relation Guard_def:
  algoCtx |- defnAL : defnAL
  hint(input %0 %1)
  hint(prose_in "guarding definition" %1 "under" %0)
  hint(prose_out %2)

;; Otherwise purity

relation Exp_pure:
  |- typedExp
  hint(input %0)
  hint(prose_in "evaluating" %0 "calls no function")

relation Arg_pure:
  |- arg
  hint(input %0)
  hint(prose_in "evaluating" %0 "calls no function")

relation Path_pure:
  |- typedPath
  hint(input %0)
  hint(prose_in "evaluating" %0 "calls no function")

relation Prem_pure:
  |- premAL
  hint(input %0)
  hint(prose_in "premise" %0 "cannot fail")

relation Otherwise_pure:
  |- defnAL
  hint(input %0)
  hint(prose_in "the otherwise rule or clause of" %0 "cannot fail")

;; Specifications

relation Algo_IL:
  |- specIL : specAL
  hint(input %0)
  hint(prose_in "converting specification" %0 "to the algorithmic language")
  hint(prose_out %1)
