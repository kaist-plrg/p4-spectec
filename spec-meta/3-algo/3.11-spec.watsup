;; Specifications

;; A specification is converted to AL definition by definition, every
;; definition seeing all type definitions. Guards are then inserted into the
;; converted definitions, and finally the otherwise rules and clauses are checked.

dec $load_typdefs(algoCtx, defnIL*) : algoCtx
  hint(prose_in %0 "with the type definitions of" %1 "loaded")

def $load_typdefs(AC, externTypDefn :: defnIL*)
  = $load_typdefs(AC', defnIL*)
  -- if EXTTYP id = externTypDefn
  -- if AC' = $add_typdef(AC, id, externTypDefn)

def $load_typdefs(AC, definedTypDefn :: defnIL*)
  = $load_typdefs(AC', defnIL*)
  -- if TYP id _ '=' _ = definedTypDefn
  -- if AC' = $add_typdef(AC, id, definedTypDefn)

def $load_typdefs(AC, relDefnIL :: defnIL*) = $load_typdefs(AC, defnIL*)
def $load_typdefs(AC, funcDefnIL :: defnIL*) = $load_typdefs(AC, defnIL*)
def $load_typdefs(AC, eps) = AC

rule Algo_spec:
  |- defnIL* : defnAL''*
  -- if AC = $load_typdefs($empty_algoCtx, defnIL*)
  -- (Algo_def: AC |- defnIL : defnAL)*
  -- (Guard_def: AC |- defnAL : defnAL'')*
  -- (Otherwise_pure: AC |- defnAL'')*
