;;
;; Renamer
;;

;; Identifiers that fresh identifiers must avoid,
;; and each binder mapped to the identifiers given to its occurrences so far;
;; the first occurrence keeps the binder's own identifier

syntax occ = map<id, id*>

syntax renamer =
  { USED id*,
    NAMES occ }

var R : renamer

;;
;; Renamer construction
;;
;; syntax vari*
;;

;; Every binder starts with no occurrence named;
;; every occurrence of a binder has the same type and dimension

dec $init_renamer(id*, vari*) : renamer
  hint(prose_in "the renamer for binders" %1 "avoiding identifiers" %0)

def $init_renamer(id_used*, eps) = { USED id_used*, NAMES $empty_map<id, id*> }

def $init_renamer(id_used*, vari_h :: vari_t*)
  = R[ .NAMES = $add_map<id, id*>(R.NAMES, id_h, eps) ]
  -- if id_h _ _ = vari_h
  -- if ~(id_h <- $ids_of_varis(vari_t*))
  -- if R = $init_renamer(id_used*, vari_t*)

def $init_renamer(id_used*, vari_h :: vari_t*)
  = $init_renamer(id_used*, vari_t*)
  -- if vari_h <- vari_t*

dec $vari_of(id, vari*) : vari
  hint(prose_in "the variable named" %0 "in" %1)

def $vari_of(id, vari_h :: _) = vari_h
  -- if id _ _ = vari_h
def $vari_of(id, vari_h :: vari_t*) = $vari_of(id, vari_t*)
  -- if id_h _ _ = vari_h
  -- if id_h =/= id

;;
;; Renaming repeated binders in patterns
;;
;; syntax typedExp
;;

;; The first occurrence keeps its identifier; later ones take fresh identifiers:
;; `(x, x, (y, y)*)` becomes `(x, x', (y, y')*)`.
;; Binders occur only under invertible constructs;
;; any other construct, and a bound variable, is unchanged.

dec $rename_exp(renamer, typedExp) : (renamer, typedExp)
  hint(prose_in "renaming the repeated binders of" %1 "with" %0)
dec $rename_exps(renamer, typedExp*) : (renamer, typedExp*)
  hint(prose_in "renaming the repeated binders of" %1 "with" %0)

;; An iteration lists the renamed occurrences it now contains

dec $ids_within(id*, id*) : id*
  hint(prose_in "the identifiers in" %0 "that are also in" %1)

def $ids_within(eps, _) = eps
def $ids_within(id_h :: id_t*, id_in*) = id_h :: $ids_within(id_t*, id_in*)
  -- if id_h <- id_in*
def $ids_within(id_h :: id_t*, id_in*) = $ids_within(id_t*, id_in*)
  -- if ~(id_h <- id_in*)

dec $rename_iter_vari(renamer, vari, id*) : vari*
  hint(prose_in "the variables replacing iteration variable" %1
                "by its renamed occurrences among" %2 "under" %0)

def $rename_iter_vari(R, id typ iter*, id_free*) = (id_occ typ iter*)*
  -- if id_name* = $find_map<id, id*>(R.NAMES, id)
  -- if id_occ* = $ids_within(id_name*, id_free*)
def $rename_iter_vari(R, vari, _) = [ vari ]
  -- otherwise

;;; VAR id

def $rename_exp(R, (VAR id) '#' typ) = (R_multi, (VAR id) '#' typ)
  -- if id_name* = $find_map<id, id*>(R.NAMES, id)
  -- if id_name* = eps
  -- if R_multi = R[ .NAMES = $add_map<id, id*>(R.NAMES, id, [ id ]) ]

def $rename_exp(R, (VAR id) '#' typ) = (R_multi, (VAR id_fresh) '#' typ)
  -- if id_name* = $find_map<id, id*>(R.NAMES, id)
  -- if id_name* =/= eps
  -- if (id_used*, id_fresh) = $fresh_id(R.USED)
  -- if R_multi = { USED id_used*,
               NAMES $add_map<id, id*>(R.NAMES, id, id_name* ++ [ id_fresh ]) }

;;; UPCAST typ typedExp

def $rename_exp(R, (UPCAST typ_sup typedExp) '#' typ)
  = (R_multi, (UPCAST typ_sup typedExp_multi) '#' typ)
  -- if (R_multi, typedExp_multi) = $rename_exp(R, typedExp)

;;; TUP typedExp*

def $rename_exp(R, (TUP typedExp*) '#' typ) = (R_multi, (TUP typedExp_multi*) '#' typ)
  -- if (R_multi, typedExp_multi*) = $rename_exps(R, typedExp*)

;;; INJ expCase

def $rename_exp(R, (INJ (mixop typedExp*)) '#' typ)
  = (R_multi, (INJ (mixop typedExp_multi*)) '#' typ)
  -- if (R_multi, typedExp_multi*) = $rename_exps(R, typedExp*)

;;; STR expField*

def $rename_exp(R, (STR expField*) '#' typ) = (R_multi, (STR expField_multi*) '#' typ)
  -- (if atom typedExp = expField)*
  -- if (R_multi, typedExp_multi*) = $rename_exps(R, typedExp*)
  -- (if expField_multi = atom typedExp_multi)*

;;; OPT typedExp?

def $rename_exp(R, (OPT typedExp) '#' typ) = (R_multi, (OPT typedExp_multi) '#' typ)
  -- if (R_multi, typedExp_multi) = $rename_exp(R, typedExp)

;;; LIST typedExp*

def $rename_exp(R, (LIST typedExp*) '#' typ) = (R_multi, (LIST typedExp_multi*) '#' typ)
  -- if (R_multi, typedExp_multi*) = $rename_exps(R, typedExp*)

;;; CONS typedExp typedExp

def $rename_exp(R, (CONS typedExp_h typedExp_t) '#' typ)
  = (R_t, (CONS typedExp_h_multi typedExp_t_multi) '#' typ)
  -- if (R_h, typedExp_h_multi) = $rename_exp(R, typedExp_h)
  -- if (R_t, typedExp_t_multi) = $rename_exp(R_h, typedExp_t)

;;; ITER typedExp expIter

def $rename_exp(R, (ITER typedExp (iter vari*)) '#' typ)
  = (R_multi, (ITER typedExp_multi (iter vari_occ*)) '#' typ)
  -- if (R_multi, typedExp_multi) = $rename_exp(R, typedExp)
  -- if id_free* = $ids_of_varis($free_varis_exp(typedExp_multi))
  -- if (vari_rename* = $rename_iter_vari(R_multi, vari, id_free*))*
  -- if vari_occ* = $concat_<vari>(vari_rename**)

;;; other constructs

def $rename_exp(R, typedExp) = (R, typedExp)
  -- otherwise

;;
;; Renaming repeated binders in pattern sequences
;;
;; syntax typedExp*
;;

def $rename_exps(R, eps) = (R, eps)
def $rename_exps(R, typedExp_h :: typedExp_t*)
  = (R_t, typedExp_h_multi :: typedExp_t_multi*)
  -- if (R_h, typedExp_h_multi) = $rename_exp(R, typedExp_h)
  -- if (R_t, typedExp_t_multi*) = $rename_exps(R_h, typedExp_t*)

;;
;; Renaming repeated binders in arguments
;;
;; syntax arg
;;

dec $rename_arg(renamer, arg) : (renamer, arg)
  hint(prose_in "renaming the repeated binders of" %1 "with" %0)

;;; EXP typedExp

def $rename_arg(R, EXP typedExp) = (R_multi, EXP typedExp_multi)
  -- if (R_multi, typedExp_multi) = $rename_exp(R, typedExp)

;;; FUN id

def $rename_arg(R, FUN id) = (R, FUN id)

;;
;; Renaming repeated binders in argument sequences
;;
;; syntax arg*
;;

dec $rename_args(renamer, arg*) : (renamer, arg*)
  hint(prose_in "renaming the repeated binders of" %1 "with" %0)

def $rename_args(R, eps) = (R, eps)
def $rename_args(R, arg_h :: arg_t*) = (R_t, arg_h_multi :: arg_t_multi*)
  -- if (R_h, arg_h_multi) = $rename_arg(R, arg_h)
  -- if (R_t, arg_t_multi*) = $rename_args(R_h, arg_t*)
