;;
;; Constructor types
;;
;; syntax typ
;;

;; A variant with exactly one case, after expanding aliases

dec $is_singleton_typ(tdenv, typ) : bool
  hint(prose_true "type" %1 "has a single constructor under" %0)
  hint(prose_false "type" %1 "does not have a single constructor under" %0)
def $is_singleton_typ(tdenv, typ) = true
  ---- ;; expand aliases to a variant type
  -- if OK (VAR id targ*) = $expand_typ(tdenv, typ)
  -- if TYP _ tparam* '=' (VARIANT typCase*) = $find_map<id, typDef>(tdenv, id)
  ---- ;; the variant has exactly one case
  -- if |typCase*| = 1
  -- if |tparam*| = |targ*|
def $is_singleton_typ(_, _) = false
  -- otherwise

;;
;; Irrefutable patterns
;;
;; syntax typedExp
;;

;; Variables, tuples, structs, and iterations match every value;
;; a case matches every value only if it is the single case of its type

dec $is_irrefutable(tdenv, typedExp) : bool
  hint(prose_true %1 "matches every value of its type under" %0)
  hint(prose_false %1 "does not match every value of its type under" %0)

;;; VAR id

def $is_irrefutable(tdenv, (VAR _) '#' _) = true

;;; TUP typedExp*

def $is_irrefutable(tdenv, (TUP typedExp*) '#' _) = $forall_($is_irrefutable(tdenv, typedExp)*)

;;; INJ expCase

def $is_irrefutable(tdenv, (INJ (_ typedExp*)) '#' typ)
  = $is_singleton_typ(tdenv, typ) /\ $forall_($is_irrefutable(tdenv, typedExp)*)

;;; STR expField*

def $is_irrefutable(tdenv, (STR expField*) '#' _) = $forall_($is_irrefutable(tdenv, typedExp)*)
  -- (if _ typedExp = expField)*

;;; ITER typedExp expIter

def $is_irrefutable(tdenv, (ITER typedExp _) '#' _) = $is_irrefutable(tdenv, typedExp)

def $is_irrefutable(_, _) = false
  -- otherwise

;;
;; Table rows
;;
;; syntax tblRowIL
;;

;; Row arguments bind each variable once;
;; their decomposition premises precede the row's result

rule Algo_tblRow:
  AC |- tblRowIL : arg_part* '=' typedExp '-' premAL*
  -- if arg* '=' typedExp = tblRowIL
  ---- ;; fresh identifiers avoid those of the row
  -- if id_used* = $ids_of_varis($free_varis_tblRowIL(tblRowIL))
  -- if AC_row = $add_used(AC, id_used*)
  ---- ;; no binder repeats across the arguments
  -- Collectbind_args: AC_row |- arg* : vari_bind*
  -- if `{ (id_bind ':' _)* `} = $init_renamer(eps, vari_bind*).OCC
  -- if |id_bind*| = |vari_bind*|
  ---- ;; the arguments bind, decomposing their cases
  -- Bind_args: AC_row |- arg* : AC_body arg_part* premAL*
  ---- ;; the result reads only bound variables
  -- if vari_body* = $free_varis_exp(typedExp)
  -- if $is_bound(AC_body, eps, vari_body*)

;;
;; Table coverage
;;
;; syntax tblRowIL*
;;

;; A row argument covers a set of cases of its variant type.
;; No input may be covered by two rows, and unless the last row consists of
;; wildcard variables, every combination of cases must be covered by a row.

;; A row argument is shallow: a variable, or a case whose arguments are
;; irrefutable, possibly under an upcast; it covers a set of cases

dec $variant_cases(tdenv, typ) : typCase*
  hint(prose_in "the cases of variant type" %1 "under" %0)
def $variant_cases(tdenv, VAR id _) = typCase*
  -- if TYP _ _ '=' (VARIANT typCase*) = $find_map<id, typDef>(tdenv, id)

dec $covered_cases(tdenv, typedExp) : typCase*
  hint(prose_in "the cases covered by row argument" %1 "under" %0)
def $covered_cases(tdenv, (VAR _) '#' typ) = $variant_cases(tdenv, typ)
def $covered_cases(tdenv, (UPCAST _ typedExp) '#' _) = $covered_cases(tdenv, typedExp)
def $covered_cases(tdenv, (INJ (mixop typedExp*)) '#' _) = [ mixop typ* ]
  -- if $forall_($is_irrefutable(tdenv, typedExp)*)
  -- (if _ '#' typ = typedExp)*

dec $is_wildcard_exp(typedExp) : bool
  hint(prose_true %0 "is a wildcard variable")
  hint(prose_false %0 "is not a wildcard variable")
def $is_wildcard_exp((VAR id) '#' _) = true
  -- if $(|id| > 0)
  -- if id[0 : 1] = "_"
def $is_wildcard_exp(_) = false
  -- otherwise

;; Two rows overlap when every argument position shares a case

dec $shares_case(typCase*, typCase*) : bool
  hint(prose_true %0 "and" %1 "share a case")
  hint(prose_false %0 "and" %1 "share no case")
def $shares_case(typCase_a*, typCase_b*) = $exists_((typCase_a <- typCase_b*)*)

dec $overlaps(typCase**, typCase**) : bool
  hint(prose_true "rows covering" %0 "and" %1 "accept a common input")
  hint(prose_false "rows covering" %0 "and" %1 "accept no common input")
def $overlaps(typCase_a**, typCase_b**) = $forall_(b_share*)
  -- (if b_share = $shares_case(typCase_a*, typCase_b*))*

dec $is_exclusive(typCase***) : bool
  hint(prose_true "the rows covering" %0 "accept disjoint inputs")
  hint(prose_false "two rows covering" %0 "accept a common input")
def $is_exclusive(eps) = true
def $is_exclusive(typCase_h** :: typCase_t***) = ~$exists_(b_overlap*) /\ $is_exclusive(typCase_t***)
  -- (if b_overlap = $overlaps(typCase_h**, typCase_t**))*

dec $prepend_each(typCase, typCase**) : typCase**
  hint(prose_in "the choices" %1 "each preceded by" %0)
def $prepend_each(typCase, typCase_rest**) = (typCase :: typCase_rest*)*

dec $combinations(typCase**) : typCase**
  hint(prose_in "every choice of one case from each of" %0)
def $combinations(eps) = [ eps ]
def $combinations(typCase_h* :: typCase_t**) = $concat_<typCase*>(typCase_comb***)
  -- if typCase_rest** = $combinations(typCase_t**)
  -- (if typCase_comb** = $prepend_each(typCase_h, typCase_rest**))*

;; A combination is covered when some row accepts its case at every position

dec $is_covered(typCase***, typCase*) : bool
  hint(prose_true "some row covering" %0 "accepts the cases" %1)
  hint(prose_false "no row covering" %0 "accepts the cases" %1)
def $is_covered(typCase_row***, typCase*) = $exists_(b_cover*)
  -- (if b_cover = $forall_((typCase <- typCase_row*)*))*

rulegroup TblRows_cover {

  rule TblRows_cover/default:
    AC typ* |- tblRowIL*
    ---- ;; every key has a variant type
    -- (if _ = $variant_cases(AC.TYP, typ))*
    ---- ;; the last row consists of wildcard variables
    -- if $(|tblRowIL*| > 0)
    -- if n_init = $(|tblRowIL*| - 1)
    -- if (EXP typedExp_last)* '=' _ = tblRowIL*[n_init]
    -- if $forall_($is_wildcard_exp(typedExp_last)*)
    ---- ;; the rows before it accept disjoint inputs
    -- if ((EXP typedExp)* '=' _)* = tblRowIL*[0 : n_init]
    -- (if (typCase_row* = $covered_cases(AC.TYP, typedExp))*)*
    -- if $is_exclusive(typCase_row***)

  rule TblRows_cover/exhaustive:
    AC typ* |- tblRowIL*
    ---- ;; every key has a variant type
    -- (if typCase_total* = $variant_cases(AC.TYP, typ))*
    ---- ;; the last row does not consist of wildcard variables
    -- if $(|tblRowIL*| > 0)
    -- if n_init = $(|tblRowIL*| - 1)
    -- if (EXP typedExp_last)* '=' _ = tblRowIL*[n_init]
    -- if ~$forall_($is_wildcard_exp(typedExp_last)*)
    ---- ;; the rows accept disjoint inputs
    -- if ((EXP typedExp)* '=' _)* = tblRowIL*
    -- (if (typCase_row* = $covered_cases(AC.TYP, typedExp))*)*
    -- if $is_exclusive(typCase_row***)
    ---- ;; and together cover every combination of cases
    -- if typCase_comb** = $combinations(typCase_total**)
    -- if $forall_($is_covered(typCase_row***, typCase_comb*)*)

}
